////////////////////////////////////////////////////////
// Terrain cache texture - Fragment Shader
//
//
////////////////////////////////////////////////////////
@ifdef ContainsNormalMaps
	@include helper_normal_packing.hpsl
@endif

////////////////////
// Blend map
uniform cTexture2D aBlendMap : 0;

////////////////////
// Uniform variables
uniform cVector4f avTextureCoordScale;
uniform cVector4f avOneMinusFadeStart;

////////////////////
// Material Textures
@ifdef UseDetailAmount
	uniform cVector3f avDetailTextureAmount[4];
@else
	uniform cTexture2D aDiffuseMap0 : 1;
	uniform cTexture2D aDiffuseMap1 : 2;
	uniform cTexture2D aDiffuseMap2 : 3;
	uniform cTexture2D aDiffuseMap3 : 4;
@endif

@ifdef UseBaseTexture
	uniform float afBaseTextureCoordScale;
	
	@ifdef UseDetailAmount
		uniform cVector3f avBaseDetailTextureAmount;
	@else
		uniform cTexture2D aDiffuseBase : 5;
	@endif

@endif

@ifdef UseBump
	uniform cVector4f avMul;
	uniform float afBaseMul;
@endif

/////////////////////////
// Alph textures
uniform cTexture2D aAlphaMap0 : 6;
uniform cTexture2D aAlphaMap1 : 7;
uniform cTexture2D aAlphaMap2 : 8;
uniform cTexture2D aAlphaMap3 : 9;

//------------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	//////////////////////////////////
	// Get UV coords
	cVector2f vTexCoord = px_vTexCoord0.xy;
	
	//////////////////////////////////
	//Blend
	cVector4f vBlendValues = sample(aBlendMap, vTexCoord);
	
	cVector4f vTexAlpha0 = sample(aAlphaMap0, vTexCoord * avTextureCoordScale.x);
	cVector4f vTexAlpha1 = sample(aAlphaMap1, vTexCoord * avTextureCoordScale.y);
	cVector4f vTexAlpha2 = sample(aAlphaMap2, vTexCoord * avTextureCoordScale.z);
	cVector4f vTexAlpha3 = sample(aAlphaMap3, vTexCoord * avTextureCoordScale.w);
	
	
	//avOneMinusFadeStart is added in a way that is the same as dividing final blend by 1-fadestart. This makes parts of the texture opaque even if other parts ahve faded.
	cVector4f vDissolveBlend = cVector4f(vTexAlpha0.w, vTexAlpha1.w, vTexAlpha2.w, vTexAlpha3.w);
	vDissolveBlend = clamp( (vDissolveBlend - (cVector4f(1.0) - vBlendValues) ) / (vDissolveBlend * avOneMinusFadeStart), 0.0, 1.0);
	
	//////////////////////////////////
	//Diffuse color
	@ifdef UseDetailAmount
		cVector3f vTexColor0 = avDetailTextureAmount[0];
		cVector3f vTexColor1 = avDetailTextureAmount[1];
		cVector3f vTexColor2 = avDetailTextureAmount[2];
		cVector3f vTexColor3 = avDetailTextureAmount[3];
	@elseif ContainsNormalMaps
		cVector3f vTexColor0 = UnpackNormalmapYW( sample(aDiffuseMap0, vTexCoord * avTextureCoordScale.x) );
		cVector3f vTexColor1 = UnpackNormalmapYW( sample(aDiffuseMap1, vTexCoord * avTextureCoordScale.y) );
		cVector3f vTexColor2 = UnpackNormalmapYW( sample(aDiffuseMap2, vTexCoord * avTextureCoordScale.z) );
		cVector3f vTexColor3 = UnpackNormalmapYW( sample(aDiffuseMap3, vTexCoord * avTextureCoordScale.w) );
	@elseif UseBump
		cVector3f vTexColor0 = (cVector3f(1.0) - sample(aDiffuseMap0, vTexCoord * avTextureCoordScale.x).aaa) * avMul.x;
		cVector3f vTexColor1 = (cVector3f(1.0) - sample(aDiffuseMap1, vTexCoord * avTextureCoordScale.y).aaa) * avMul.y;
		cVector3f vTexColor2 = (cVector3f(1.0) - sample(aDiffuseMap2, vTexCoord * avTextureCoordScale.z).aaa) * avMul.z;
		cVector3f vTexColor3 = (cVector3f(1.0) - sample(aDiffuseMap3, vTexCoord * avTextureCoordScale.w).aaa) * avMul.w;
	@else
		cVector3f vTexColor0 = sample(aDiffuseMap0, vTexCoord * avTextureCoordScale.x).xyz;
		cVector3f vTexColor1 = sample(aDiffuseMap1, vTexCoord * avTextureCoordScale.y).xyz;
		cVector3f vTexColor2 = sample(aDiffuseMap2, vTexCoord * avTextureCoordScale.z).xyz;
		cVector3f vTexColor3 = sample(aDiffuseMap3, vTexCoord * avTextureCoordScale.w).xyz;
	@endif	
	
	
	@ifdef UseBaseTexture
		@ifdef UseDetailAmount
			cVector3f vDiffuseColor = avBaseDetailTextureAmount;
		@elseif ContainsNormalMaps
			cVector3f vDiffuseColor = UnpackNormalmapYW( sample(aDiffuseBase, vTexCoord * afBaseTextureCoordScale) );
		@elseif UseBump
			cVector3f vDiffuseColor = (cVector3f(1.0) - sample(aDiffuseBase, vTexCoord * afBaseTextureCoordScale).aaa) * afBaseMul;
		@else 
			cVector3f vDiffuseColor = sample(aDiffuseBase, vTexCoord * afBaseTextureCoordScale).xyz;
		@endif
	@else
		@ifdef ContainsNormalMaps
			cVector3f vDiffuseColor = cVector3f(0,0,1);
		@else
			cVector3f vDiffuseColor = cVector3f(0);
		@endif
	@endif
	
	vDiffuseColor = mix(vDiffuseColor, vTexColor0.xyz, vDissolveBlend.x);
	vDiffuseColor = mix(vDiffuseColor, vTexColor1.xyz, vDissolveBlend.y);
	vDiffuseColor = mix(vDiffuseColor, vTexColor2.xyz, vDissolveBlend.z);
	vDiffuseColor = mix(vDiffuseColor, vTexColor3.xyz, vDissolveBlend.w);
	
	//////////////////////////////////
	//Final Diffuse Output
	@ifdef ContainsNormalMaps
		vDiffuseColor.xyz = normalize(vDiffuseColor.xyz)*0.5 + 0.5;
	@endif
	
	out_vColor.xyz =  vDiffuseColor.xyz;

	//////////////////////////////////
	//Set the combine alpha as output if this is not the base layer
	@ifdef UseBaseTexture
		out_vColor.w =  1.0;
	@else
		out_vColor.w = min(dot(vDissolveBlend, cVector4f(1)), 1.0);
	@endif
}		