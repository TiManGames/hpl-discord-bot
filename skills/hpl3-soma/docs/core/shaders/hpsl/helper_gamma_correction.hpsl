////////////////////////////////////////////////////////
// Gamma Correction Helper
//

//---------------------------------------------

cVector3f GammaToLinearCorrection(in cVector3f avsRGB)
{
	////////////////
	// Convert a color from sRGB to RGB space
	@ifdef UseLinearColorSpaceCorrection
		@ifdef LinearColorSpaceCorrectionType_Standard
			return pow(avsRGB.rgb, cVector3f(2.2));
		@else 
			//LinearColorSpaceCorrectionType_Fast
			return avsRGB.rgb * avsRGB.rgb;
		@endif
	@else
		return avsRGB;
	@endif
}

//---------------------------------------------

cVector4f GammaToLinearCorrection(in cVector4f avsRGB)
{
	////////////////
	// Convert a color from sRGB to RGB space
	@ifdef UseLinearColorSpaceCorrection
		@ifdef LinearColorSpaceCorrectionType_Standard
			return pow(avsRGB.rgba, cVector4f(2.2));
		@else 
			//LinearColorSpaceCorrectionType_Fast
			return avsRGB.rgba * avsRGB.rgba;
		@endif
	@else
		return avsRGB;
	@endif
}

//---------------------------------------------