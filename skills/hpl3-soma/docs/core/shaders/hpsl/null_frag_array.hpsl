////////////////////////////////////////////////////////
// Null shader, bound when no other shader is bound - Pixel shader
////////////////////////////////////////////////////////

cVector4f UnpackYCoCg(cVector4f avYCoCg)
{
@ifdef Lang_PS4
	return avYCoCg.xyz;
@else
	const float kfOffset = 128.0 / 255.0;

	float fScale = 1.0 / ((255.0 / 8.0) * avYCoCg.b + 1);
	avYCoCg.rg = (avYCoCg.rg - kfOffset) * fScale;

	cVector3f vRGB;
	vRGB.r = dot(avYCoCg, cVector4f(1, -1, 0, 1));
	vRGB.g = dot(avYCoCg, cVector4f(0,  1, 0, 1));
	vRGB.b = dot(avYCoCg, cVector4f(-1,-1, 0, 1));
	
	return vRGB.rgbb;
@endif
}

uniform cTexture2DArray aColorMap : 0;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vColor,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor0 : 0,
		  out cVector4f out_vColor1 : 1,
		  out cVector4f out_vColor2 : 2,
		  out cVector4f out_vColor3 : 3)
{
	cVector4f vColor = px_vColor;


	vColor *= UnpackYCoCg(sample(aColorMap, px_vTexCoord0.xyz));


	out_vColor0 = out_vColor1 = out_vColor2 = out_vColor3 = vColor * vColor * 8.0;
}