///////////////////////////////
// Relief mapping helpers

//Optimize by getting 4 depths at once somehow?
void RayLinearIntersectionSM2(cTexture2D aHeightMap, in int alChannel, inout cVector3f avPosition, inout cVector3f avEyeVec)
{
	const int lSearchSteps = 8; 

	avEyeVec /= lSearchSteps; 	//Split up the eye vector into the number of steps 

	for(int i=0; i<lSearchSteps-1; i++) 
	{ 
		float fDepth = sample(aHeightMap, avPosition.xy)[alChannel]; 
		if(avPosition.z < fDepth) avPosition += avEyeVec; 
	} 	
}

void RayLinearIntersectionSM3(cTexture2D aHeightMap, in int alChannel, float afSearchSteps, inout cVector3f avPosition, inout cVector3f avEyeVec)
{
	avEyeVec /= afSearchSteps; 	//Split up the eye vector into the number of steps 

	for(int i=0; i<afSearchSteps-1; i++) 
	{ 
		float fDepth = sample(aHeightMap, avPosition.xy)[alChannel]; 
		if(avPosition.z < fDepth) avPosition += avEyeVec; 
	} 
}


void RayBinaryIntersection(cTexture2D aHeightMap, in int alChannel, inout cVector3f avPosition, inout cVector3f avEyeVec)
{ 
	const int lSearchSteps = 6; 
	for(int i=0; i<lSearchSteps; i++) 
	{ 
		float fDepth = sample(aHeightMap, avPosition.xy)[alChannel];
		if(avPosition.z < fDepth) 
			avPosition += avEyeVec; 
		
		avEyeVec *= 0.5; 
		avPosition -= avEyeVec; 
	} 
}

//-----------------------------------------

cVector2f GetParallaxUV_Relief(cTexture2D aHeightMap, in int alChannel, in cVector2f aUV, in cVector3f avTangentEyePos, in cVector2f avHeightMapScaleAndBias)
{
	cVector3f vEyeVec = normalize(avTangentEyePos);
			
	//Get give eyevec the length so it reaches bottom.
	vEyeVec *= cVector3f(1.0 / vEyeVec.z);	
	
	//Apply scale and bias
	vEyeVec.xy *= avHeightMapScaleAndBias.x;
	//cVector2f vBiasPosOffset = vEyeVec.xy * avHeightMapScaleAndBias.y; <- not working! because the ray casting buggers out when u are really close!
	
	//Get the postion to start the search from. 0 since we start at the top.
	cVector3f vHeightMapPos = cVector3f(aUV, 0.0); 
	
	//Determine number of steps based on angle between normal and eye
	//float fSteps = floor(( 1 - dot(vEyeVec, normalize(avNormal)) ) * 18.0) + 2.0; 
	//Do a linear search to find the first intersection.
	//RayLinearIntersectionSM3(aHeightMap,fSteps, vHeightMapPos,  vEyeVec);
	RayLinearIntersectionSM2(aHeightMap, alChannel, vHeightMapPos,  vEyeVec);
	
	//Do a binary search between start and first intersection to pinpoint the postion.		
	RayBinaryIntersection(aHeightMap, alChannel,vHeightMapPos,  vEyeVec);
	
	return vHeightMapPos.xy;	
}

cVector2f GetParallaxUV_Simple(cTexture2D aHeightMap, in int alChannel, in cVector2f aUV, in cVector3f avTangentEyePos, in cVector2f avHeightMapScaleAndBias)
{
	cVector3f vEyeVec = normalize(avTangentEyePos);
	float fHeight = sample(aHeightMap, aUV)[alChannel];	
			
	float fDisplacement = fHeight * avHeightMapScaleAndBias.x;// + avHeightMapScaleAndBias.y; <- skip bias, since relief does not support it!
	
	return vEyeVec.xy * fDisplacement + aUV;
}
