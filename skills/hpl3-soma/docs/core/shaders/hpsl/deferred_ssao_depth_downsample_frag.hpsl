////////////////////////////////////////////////////////
// Deferred Depth unpack - Fragment Shader
//
// Unpacks the depth map of the gbuffer into the red channel.
////////////////////////////////////////////////////////

uniform cTexture2D depthTexture : 0;

uniform cVector2f avInvScreenSize;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f px_vColor : 0)
{
	cVector2f vScreenPos = px_vTexCoord0.xy;

	@ifdef UseRotatedGrid
		/////////////////
		// Rotated grid subsampling to avoid XY directional bias or Z precision bias while downsampling
		cVector2f vOffset = cVector2f(fract((px_vPosition.xy + cVector2f(1.0)) / 2.0) * 2.0).yx * avInvScreenSize;

		//////////////////
		// Get new screen color
		px_vColor = sample(depthTexture, vScreenPos + vOffset).xxxx;
	@else
		px_vColor = sample(depthTexture, vScreenPos).xxxx;
	@endif
}

