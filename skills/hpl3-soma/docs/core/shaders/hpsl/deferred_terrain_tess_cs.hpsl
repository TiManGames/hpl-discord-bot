////////////////////////////////////////////////////////
// Deferred Base - Control Shader
//
//
////////////////////////////////////////////////////////
	
//---------------------------------------------
	
@include helper_type_arguments.hpsl

float GetTesselationFactor(cVector3f avPos0, cVector3f avPos1)
{
	float fDist = distance(avPos0, avPos1);
	cVector3f vCenter = (avPos0 + avPos1) * 0.5;

	cVector4f vClipPos = mul(a_mtxViewProjection, cVector4f(vCenter, 1.0)); 
	float fScreenSize = abs(fDist / vClipPos.w);

	return clamp(fScreenSize * avTesselationMulAndLimit.x, 1.0, avTesselationMulAndLimit.y);
}

///////////////////////////////
// Main program
[domain = triangle]
void main(in cVector4f px_vTexCoord0[],
		  out cVector4f es_vTexCoord0[],
@ifdef UseVertexNormalMapping
	      in cVector3f px_vNormal[],
	      in cVector3f px_vTangent[],
	      in cVector3f px_vBinormal[],
	      out cVector3f es_vNormal[],
	      out cVector3f es_vTangent[],
	      out cVector3f es_vBinormal[],
@else
		  in cVector2f px_vHeightCoord[],
		  out cVector2f es_vHeightCoord[],
@endif
@ifdef UseLinearDepth
		  in float px_fLinearDepth[],
		  out float es_fLinearDepth[],
@endif
@ifdef TerrainDebug	
		  in cVector4f px_vColor[],
		  out cVector4f es_vColor[],
@endif
@ifdef UseTextureArray
		  in cVector4f px_vDiffuseSizeAndOffset[],
		  in cVector4f px_vNormalSizeAndOffset[],
		  in cVector4f px_vSpecularSizeAndOffset[],
		  in cVector4f px_vDetailSizeAndOffset[],
		  in cVector4f px_vArraySlice[],
		  out cVector4f es_vDiffuseSizeAndOffset[],
		  out cVector4f es_vNormalSizeAndOffset[],
		  out cVector4f es_vSpecularSizeAndOffset[],
		  out cVector4f es_vDetailSizeAndOffset[],
		  out cVector4f es_vArraySlice[],
@endif
@ifdef  UseTesselation
	      in cVector4f px_vBumpSizeAndOffset[],
	      in float px_fBumpSlice[],
	      out cVector4f es_vBumpSizeAndOffset[],
	      out float es_fBumpSlice[],
@endif
		  in cVector4f px_vWorldPos[]
		  out cVector4f es_vWorldPos[])
{	
	//////////////
	// Transfer data
	@ifdef UseVertexNormalMapping
		es_vNormal[cs_lInvocationID] = px_vNormal[cs_lInvocationID];
		es_vTangent[cs_lInvocationID] = px_vTangent[cs_lInvocationID];
		es_vBinormal[cs_lInvocationID] = px_vBinormal[cs_lInvocationID];
	@else
		es_vHeightCoord[cs_lInvocationID] = px_vHeightCoord[cs_lInvocationID];
	@endif
	@ifdef UseLinearDepth
		es_fLinearDepth[cs_lInvocationID] = px_fLinearDepth[cs_lInvocationID];
	@endif
	@ifdef TerrainDetailMaps
		es_vWorldPos[cs_lInvocationID] = px_vWorldPos[cs_lInvocationID];
	@endif
	@ifdef TerrainDebug	
		es_vColor[cs_lInvocationID] = px_vColor[cs_lInvocationID];
	@endif
	@ifdef UseTextureArray
		es_vDiffuseSizeAndOffset[cs_lInvocationID] = px_vDiffuseSizeAndOffset[cs_lInvocationID];
		es_vNormalSizeAndOffset[cs_lInvocationID] = px_vNormalSizeAndOffset[cs_lInvocationID];
		es_vSpecularSizeAndOffset[cs_lInvocationID] = px_vSpecularSizeAndOffset[cs_lInvocationID];
		es_vDetailSizeAndOffset[cs_lInvocationID] = px_vDetailSizeAndOffset[cs_lInvocationID];
		es_vArraySlice[cs_lInvocationID] = px_vArraySlice[cs_lInvocationID];
	@endif
	@ifdef  UseTesselation
		es_vBumpSizeAndOffset[cs_lInvocationID] = px_vBumpSizeAndOffset[cs_lInvocationID];
		es_fBumpSlice[cs_lInvocationID] = px_fBumpSlice[cs_lInvocationID];
	@endif

	es_vTexCoord0[cs_lInvocationID] = px_vTexCoord0[cs_lInvocationID];

	/////////////
	// Copy position and setup tessleation factor
	es_vWorldPos[cs_lInvocationID] = px_vWorldPos[cs_lInvocationID];
                    
	// Todo: how to handle this on ps4                   
    cs_fTessLevelOuter[0] = GetTesselationFactor(px_vWorldPos[1].xyz, px_vWorldPos[2].xyz);            
    cs_fTessLevelOuter[1] = GetTesselationFactor(px_vWorldPos[2].xyz, px_vWorldPos[0].xyz);            
    cs_fTessLevelOuter[2] = GetTesselationFactor(px_vWorldPos[0].xyz, px_vWorldPos[1].xyz);            
    cs_fTessLevelInner[0] = (cs_fTessLevelOuter[0] + cs_fTessLevelOuter[1] + cs_fTessLevelOuter[2]) / 3.0;   
}