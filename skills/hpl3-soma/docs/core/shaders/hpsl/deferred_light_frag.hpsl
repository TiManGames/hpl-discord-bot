////////////////////////////////////////////////////////
// Deferred G-Buffer Light - Fragment Shader
//
// A shader applied to the accumlation buffer, using the
// G-buffer targets as input.
//
// Postion retrival from depth:
// The position gvFarPlanePos is at the far plane and the far x,y and z postions can be thought of as a "trinagle"
// The wanted position can also be thought of as a "triangle" with the same ratio as the far one. The ratio is expressed as
// the stored depth value since it is wanted_pos.z/farplane.
//	
////////////////////////////////////////////////////////

@ifdef UseTextureBuffer


//--------------------------------------------------------------

///////////////////////////////
// Shadow helper functions

float ShadowOffsetLookup(cTexture2DCmp aShadowMap, cVector4f avLocation, cVector2f avOffset)
{
	return sampleCmp(aShadowMap, avLocation.xy + avOffset, avLocation.z);
}

//--------------------------------------------------------------

@ifdef UseLinearColorSpaceCorrection
	@include helper_gamma_correction.hpsl
@endif

/////////////////////
//Uniform varaibles

cBuffer cLightArguments : 0
{
	cMatrixf a_mtxViewProjection;
	cMatrixf a_mtxProjection;
	cMatrixf a_mtxView;
	cMatrixf a_mtxInvViewProjection;
	cMatrixf a_mtxInvProjection;
	cMatrixf a_mtxInvView;
		
	float afFarPlane;
	float afNearPlane;
	float afNearByFarPlane;
	float afInvFarPlane;

	cVector4f avScreenToFarPlane;
	cVector2f avInvScreenSize;

	cVector2f avFogStartAndLength;
	cVector4f avFogColor;

	cVector3f avViewSpaceUp;
	float afFogFalloffExp;

	int alInstanceOffset;
	int alInstanceStride;
	cVector2f avPadding;

	@ifdef LightType_Directional
		// Dir light specific
		cMatrixf a_mtxDirectionLightGobo;
		cMatrixf a_mtxLightViewProj0;
		cMatrixf a_mtxLightViewProj1;
		cMatrixf a_mtxLightViewProj2;
		cMatrixf a_mtxLightViewProj3;
		
		cVector4f avSplitsNear;
		cVector4f avSplitsFar;
		cVector4f avSplitOffsetMul;
	
		cVector3f avLightDirection;
		cVector3f avAmbientColorSky;
		cVector3f avAmbientColorGround;
	@endif
};

////////////////////
//Textures
uniform cTexture2D aDiffuseMap : 0;
uniform cTexture2D aNormalDepthMap : 1;

@ifdef UseSpecular
	uniform cTexture2D  aSpecMap : 2;
@endif
	
////////////////////////////
//Additional textures

//Spot light
@ifdef LightType_Spot || LightType_Directional
	@ifdef UseGobo
		uniform cTexture2D aGoboMap : 5;
	@endif
//Point light
@else
	@ifdef UseGobo
		uniform cTextureCube aGoboMap : 5;
	@endif
@endif

//Shadow map
@ifdef UseShadowMap
	uniform cTexture2DCmp aShadowMap : 6;	
	@ifdef ShadowMapQuality_Low
	@else
		uniform cTexture2D aShadowOffsetMap : 7;
	@endif
@endif

cVector3f GetPos(in cVector2f avUV, float afDepth)
{
	return cVector3f(avUV.xy * avScreenToFarPlane.xy + avScreenToFarPlane.zw, -afFarPlane) * afDepth;
}

@ifdef GoboType_Specular
	cVector3f ReflectRayPlane(in cVector3f avPos, in cVector3f avNormal, in cVector3f avLightPos, in cVector3f avLightDir, in float afLightSourceRadius, out float afT)
	{			
		cVector3f vRayDir = -reflect(normalize(avPos), avNormal);
			
		@ifdef LightType_Spot
			afT = -(dot(avPos, avLightDir) - dot(avLightDir, avLightPos) + afLightSourceRadius) / dot(vRayDir, avLightDir);
		@else
			afT = -(dot(avPos, avLightDir) - dot(avLightDir, avLightPos)) / dot(vRayDir, avLightDir);
		@endif

		return avPos + vRayDir * afT;
	}
@endif

//--------------------------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f px_vPosition,
@ifdef LightType_Spot || LightType_Point || LightType_Directional
@ifdef LightType_Directional
@else
		  in cVector4f px_vLightPosScale,
		  in float px_fFalloff,
@endif
		  in cVector4f px_vLightColor,
		  in float px_fTranslucenyMul,
@ifdef UseSpecular && UseGobo && GoboType_Specular
		  in float px_fLightSourceRadius,
@endif
@endif
@ifdef UseShadowMap
		  in cVector2f px_vShadowOffsetMul,
@ifdef UseShadowFade
		  in float px_fShadowFadeRange,
@endif
@endif
@ifdef LightType_Spot
		  in cMatrixf px_mtxLightViewProj,
	@ifdef UseSpecular && UseGobo && GoboType_Specular
		  in cVector3f px_vLightForward,
		  in cVector3f px_vLightUp,
		  in cVector3f px_vLightRight,
	@elseif UseGobo
	@else
		  in float px_fSpotFalloffPow,
	@endif
@endif
@ifdef DebugComplexity
		  in float px_fComplexity,
@endif

@ifdef BoxMask
		  in cVector3f px_vMaskCenter,
		  in cVector3f px_vMaskExtent,
@endif
		  out cVector4f out_vColor : 0)
{
	/////////////////////////////////
	//Get values from samplers
	cVector2l vMapCoords = cVector2l(px_vPosition.xy);
	cVector4f vColorVal =  sample(aDiffuseMap, px_vPosition.xy * avInvScreenSize);
	cVector4f vNormalDepthVal = load(aNormalDepthMap, vMapCoords, 0);
	
	@ifdef UseLinearColorSpaceCorrection
		//Convert color to linear space	if needed, convert a aswell
		vColorVal = GammaToLinearCorrection(vColorVal);
	@endif
	
	/////////////////////////////////
	// Get postion
	float fDepth = vNormalDepthVal.w;
	cVector3f vPos = GetPos(px_vPosition.xy, fDepth);
		
	/////////////////////////////////
	// Light direction and attenuation
	@ifdef LightType_Directional
		cVector3f vLightDir = avLightDirection;
		float fAttenuatuion = 1.0;
	@else
		cVector3f vLightDir = px_vLightPosScale.xyz - vPos;
		float fDistance = sqrt(dot(vLightDir,vLightDir));
		float fAttenuatuion =  pow(1.0 - min(fDistance * px_vLightPosScale.w, 1.0), px_fFalloff);	
		vLightDir = normalize( vLightDir );
	
		@ifdef BoxMask
			////////////
			// Check if position is outside of box mask
			cVector3f vMaskDelta = mul(a_mtxInvView, cVector4f(vPos, 1)).xyz - px_vMaskCenter;
			vMaskDelta = abs(vMaskDelta * 2.0 / px_vMaskExtent);

			fAttenuatuion *= step(max(max(vMaskDelta.x, vMaskDelta.y), vMaskDelta.z), 1.0);
		@endif
	
		@ifdef LightType_Point
			if(fAttenuatuion <= 0.0) discard;
		@endif
	@endif

	/////////////////////////////////
	//Unpack normal and normalize (if needed)
	cVector3f vNormal = vNormalDepthVal.xyz;
	
	@ifdef UseSpecular || UseTranslucency
		vNormal = normalize(vNormal);
		cVector3f vEye = -normalize(vPos);
	@endif
	
	
	//////////////////////////////
	// Spot attentuation / gobo
	@ifdef LightType_Directional
		// Apply shadow bias in the normals direction
		vPos += vNormal * (1 - dot(vNormal, vLightDir)) * 0.5;

		@ifdef UseGobo
			cVector4f vGoboUv = mul(a_mtxDirectionLightGobo, cVector4f(vPos,1.0));
			cVector4f vGoboVal = sample(aGoboMap, vGoboUv.xy);
			@ifdef UseLinearColorSpaceCorrection
				vGoboVal = GammaToLinearCorrection(vGoboVal);
			@elseif GammaCorrectCubeMaps
				vGoboVal.rgb = pow(vGoboVal.rgb, cVector3f(2.2));
			@endif
		@endif

			
	@elseif LightType_Spot
		// Apply normal based bias
		vPos += vNormal * (1 - dot(vNormal, vLightDir)) * 0.05;

		@ifdef UseGobo
			cVector4f vProjectedUv = mul(px_mtxLightViewProj, cVector4f(vPos,1.0)); 
			vProjectedUv = cVector4f(vProjectedUv.xyz, 1.0) / vProjectedUv.w;
			vProjectedUv.xy = clamp(vProjectedUv.xy, cVector2f(0.0), cVector2f(1.0));
			
			//////////
			// Apply near clip and outside of bounds
			cVector2f fBounds = min(vProjectedUv.xy, cVector2f(1.0) - vProjectedUv.xy);
			fAttenuatuion *= max(0, vProjectedUv.z) * 
							 clamp((1.0 - vProjectedUv.z) * 128.0, 0.0, 1.0) * 
							 float(min(fBounds.x, fBounds.y) > 0.0);

			if(fAttenuatuion <= 0.0) discard;

			cVector4f vGoboVal = sample(aGoboMap, cVector2f(1.0) - vProjectedUv.xy);
			@ifdef UseLinearColorSpaceCorrection
				vGoboVal = GammaToLinearCorrection(vGoboVal);
			@endif	

			@ifdef GoboType_Diffuse 
			@else
				if(vGoboVal.w <= 0.5f / 255.0f) discard;
			@endif
		@else
			cVector4f vProjectedUv = mul(px_mtxLightViewProj, cVector4f(vPos,1.0));
			vProjectedUv = cVector4f(vProjectedUv.xyz, 1.0) / vProjectedUv.w;
			fAttenuatuion *= pow(max(0.0, 1.0 - distance(vProjectedUv.xy, cVector2f(0.5)) * 2.0), px_fSpotFalloffPow);

			//////////
			// Apply near clip
			fAttenuatuion *= max(0, vProjectedUv.z) * 
							 clamp((1.0 - vProjectedUv.z) * 128.0, 0.0, 1.0);

			if(fAttenuatuion <= 0.0) discard;
		@endif
	//////////////////////////////
	//Point gobo
	@else
		@ifdef UseGobo
			cVector4f vWorldLightDir = mul(a_mtxInvView, cVector4f(vLightDir,0.0));
			cVector4f vGoboVal = sample(aGoboMap, vWorldLightDir.xyz);
			@ifdef UseLinearColorSpaceCorrection
				vGoboVal = GammaToLinearCorrection(vGoboVal);
			@endif
		@endif
	@endif
	
	/////////////////////////////////
	//Calculate specular amount
	@ifdef UseSpecular
		cVector4f vSpecVal = sample(aSpecMap, px_vPosition.xy * avInvScreenSize);
		
		//Convert color to linear space	if needed
		@ifdef UseLinearColorSpaceCorrection
			vSpecVal.rgb = GammaToLinearCorrection(vSpecVal.rgb);
		@endif
				
		@ifdef GoboType_Specular
			@ifdef LightType_Spot
				cVector3f vRayHit[5];
				cVector2f vSourceUV[5];		
				cVector3f vSpecular = cVector3f(0);
				float fT = 0;

				///////////////
				// Get the main ray
				vRayHit[0] = ReflectRayPlane(vPos, vNormal, px_vLightPosScale.xyz, px_vLightForward, px_fLightSourceRadius, fT);

				vSpecVal.w = vSpecVal.w * 0.5;
				float fGradient = mix(0.5, 0.5 / (vSpecVal.w * vSpecVal.w + 1e-5f), clamp(-0.25 - fT, 0.0, 1.0));

				cVector3f vDelta = (px_vLightPosScale.xyz - vRayHit[0]);
				vSourceUV[0].x = dot(vDelta, px_vLightRight) * 0.5 + 0.5;
				vSourceUV[0].y = dot(vDelta, px_vLightUp) * 0.5 + 0.5;
				
				float fBorder = max(abs(vSourceUV[0].x - 0.5), abs(vSourceUV[0].y - 0.5));
				float fBorderLimit = 0.6f;

				if(fBorder < fBorderLimit && fT < 0.0f)
				{
					@ifdef Gobo_Derivate
						/////////////
						// Get dx and dy of the ray
						cVector4f vND[4];
						vND[0] = vNormalDepthVal + dFdx(vNormalDepthVal); 
						vND[1] = vNormalDepthVal - dFdx(vNormalDepthVal); 
						vND[2] = vNormalDepthVal + dFdy(vNormalDepthVal); 
						vND[3] = vNormalDepthVal - dFdy(vNormalDepthVal); 
					@else
						/////////////
						// Get dx and dy of the ray, using the backbuffer, slower but higher quality
						cVector4f vND[4];
						vND[0] = load(aNormalDepthMap, vMapCoords + cVector2l(1, 0), 0);
						vND[1] = load(aNormalDepthMap, vMapCoords - cVector2l(1, 0), 0);
						vND[2] = load(aNormalDepthMap, vMapCoords + cVector2l(0, 1), 0);
						vND[3] = load(aNormalDepthMap, vMapCoords - cVector2l(0, 1), 0);
					@endif

					float fTO;
					vRayHit[1] = ReflectRayPlane(GetPos(px_vPosition.xy + cVector2f(1, 0), vND[0].w), vND[0].xyz, px_vLightPosScale.xyz, px_vLightForward, px_fLightSourceRadius, fTO);
					vRayHit[2] = ReflectRayPlane(GetPos(px_vPosition.xy - cVector2f(1, 0), vND[1].w), vND[1].xyz, px_vLightPosScale.xyz, px_vLightForward, px_fLightSourceRadius, fTO);
					vRayHit[3] = ReflectRayPlane(GetPos(px_vPosition.xy + cVector2f(0, 1), vND[2].w), vND[2].xyz, px_vLightPosScale.xyz, px_vLightForward, px_fLightSourceRadius, fTO);
					vRayHit[4] = ReflectRayPlane(GetPos(px_vPosition.xy - cVector2f(0, 1), vND[3].w), vND[3].xyz, px_vLightPosScale.xyz, px_vLightForward, px_fLightSourceRadius, fTO);

					for(int i= 1; i < 5; ++i)
					{
						vDelta = (px_vLightPosScale.xyz - vRayHit[i]);
						vSourceUV[i].x = dot(vDelta, px_vLightRight) * 0.5 + 0.5;
						vSourceUV[i].y = dot(vDelta, px_vLightUp) * 0.5 + 0.5;
					}

					vSpecular = sampleGrad(aGoboMap, vSourceUV[0], 
													 (vSourceUV[1] - vSourceUV[2]) * fGradient, 
													 (vSourceUV[3] - vSourceUV[4]) * fGradient).xyz;

					////////////
					// Apply geometry edge anti-aliasing
					cVector4f vDiff = (cVector4f(vND[0].w, vND[1].w, vND[2].w, vND[3].w) - cVector4f(fDepth)) * afFarPlane;
					vSpecular *= inversesqrt(1.0 + dot(vDiff, vDiff) * 128.0);
					vSpecular *= min(1.0, (fBorderLimit - fBorder) * 10.0);
				}
				@ifdef GoboType_Diffuse 
				@else
				else
				{
					discard;
				}
				@endif

				@ifdef UseLinearColorSpaceCorrection
					vSpecular = GammaToLinearCorrection(vSpecular);
				@endif

				vSpecular *= vSpecVal.xyz * px_vLightColor.w * px_vLightColor.xyz;
				vSpecular *= (1.0 + px_fTranslucenyMul * 1e-5f);
			@else
				float fT;
				cVector3f vRayHit = ReflectRayPlane(vPos, vNormal, px_vLightPosScale.xyz, vLightDir, px_fLightSourceRadius, fT);
				float fGradient = mix(1.0, 1.0 / vSpecVal.w, clamp(-fT, 0.0, 1.0));

				cVector4f vSpecGoboDir = mul(a_mtxInvViewRotation, cVector4f(vRayHit - px_vLightPosScale.xyz,1.0));

				cVector3f vSpecular = smoothstep(px_fLightSourceRadius * 1.2 * fGradient, px_fLightSourceRadius * 0.8 * fGradient, distance(vRayHit, px_vLightPosScale.xyz)) *
									  sample(aGoboMap, vSpecGoboDir.xyz).xyz;

				@ifdef UseLinearColorSpaceCorrection
					vSpecular = GammaToLinearCorrection(vSpecular);
				@endif

				vSpecular *= vSpecVal.xyz * px_vLightColor.w * px_vLightColor.xyz * step(fT, 0.0);
				vSpecular *= (1.0 + px_fTranslucenyMul * 1e-5f);
			@endif
		@else
			cVector3f vSpecIntensity = vSpecVal.xyz;
			float fSpecPower = vSpecVal.w;
		
			cVector3f vHalfVec = normalize(vLightDir + vEye);
			fSpecPower = exp2(fSpecPower * 10.0) + 1.0;//Range 0 - 1024

			// Calculate the enegry conservation value, this will make sure that the intergral of the specular is 1.0
			float fEngeryConservation = (fSpecPower + 8.0) * (1.0 / (8.0 * 3.141592));
			cVector3f vSpecular = px_vLightColor.w * vSpecIntensity * min(fEngeryConservation * pow(max(dot(vHalfVec, vNormal.xyz), 0.0) ,fSpecPower ), 1.0);
			vSpecular *= px_vLightColor.xyz;
		@endif
	@endif
	
		
	////////////////////////////////////////////
	// Ambient light
	@ifdef LightType_Directional
		float fUpAmount = dot( avViewSpaceUp, vNormal.xyz)*0.5 + 0.5;
		cVector3f vAmbColor = vColorVal.xyz * mix(avAmbientColorGround, avAmbientColorSky, fUpAmount);
	@endif
	
	/////////////////////////////////
	//Calculate diffuse color
	float fLDotN = dot( vLightDir, vNormal.xyz);
	float fLightAmount = max(fLDotN, 0.0);
	float fLightScatterAmount = max(-fLDotN, 0.0);

	@ifdef UseTranslucency
		///////////
		// A cheaper version of Dice Translucency
		// Refract the incoming light with the normal
		float fLightTransport = clamp(dot(vEye, vLightDir + vNormal.xyz * 0.2),-1.0, 0.0);
		fLightTransport = pow(fLightTransport, 16.0);

		////////
		// Apply energy conservation and ambient scattering
		float fLightScatter = (min(2.0, fLightTransport * 16.0) + fLightScatterAmount) * vColorVal.w;
	@else
		////////
		// Translucency without light transporation
		float fLightScatter = vColorVal.w * fLightScatterAmount; // Translucency (crappy Sub-surface scattering)
	@endif

	cVector3f vDiffuse = vColorVal.xyz * px_vLightColor.xyz * (fLightAmount+fLightScatter * px_fTranslucenyMul);
	
	/////////////////////////////////
	// Caclulate shadow (if any)
	@ifdef UseShadowMap
		
		float fShadowAmount=0;
		@ifdef LightType_Directional

			cVector4f vNearMul = cVector4f(step( vPos.zzzz, avSplitsNear ));
			cVector4f vFarMul = cVector4f(step( avSplitsFar, vPos.zzzz ));
			cVector4f vShadowWeights = vNearMul * vFarMul;
			cMatrixf mtxFinalLigtViewProj =	a_mtxLightViewProj0 * vShadowWeights[0] +
										a_mtxLightViewProj1 * vShadowWeights[1] +
										a_mtxLightViewProj2 * vShadowWeights[2] +
										a_mtxLightViewProj3 * vShadowWeights[3];
			cVector4f vProjectedUv = mul(mtxFinalLigtViewProj, cVector4f(vPos,1.0));
			vProjectedUv = cVector4f(vProjectedUv.xyz, 1.0) / vProjectedUv.w;
				
			@ifdef ShadowMapQuality_Low
			@else				
				float fScatterMul = dot( vShadowWeights * avSplitOffsetMul, vProjectedUv.wwww );
				cVector2f vFinalScattterMul = px_vShadowOffsetMul * fScatterMul;
			@endif
		@else			
			@ifdef ShadowMapQuality_Low
			@else
				cVector2f vFinalScattterMul = px_vShadowOffsetMul * vProjectedUv.w;
			@endif
		@endif
			
		////////////////////////
		// No Smoothing
		@ifdef ShadowMapQuality_Low
		
			fShadowAmount = sampleCmp(aShadowMap, vProjectedUv.xy, vProjectedUv.z);
					
		///////////////////////
		// Smoothing
		@else	
			//Set up variables
			float fShadowSum = 0;
			float fJitterZ =0;
			cVector2f vScreenJitterCoord = px_vPosition.xy * $ShadowJitterLookupMul;
			
			vScreenJitterCoord.y = fract(vScreenJitterCoord.y);	 //Make sure the coord is in 0 - 1 range
			vScreenJitterCoord.y *= 1.0 / $ShadowJitterSamplesDiv2;	 //Access only first texture piece
						
				
			////////////////
			// Shader Model 3, Dynamic Branching available
			@ifdef ShaderModel_4
				////////////////
				// Cheap pre-test
				//  Note1: division must occur when getting samples else gfx card gets angry.)
				//  Note2: It _must_ be division! doing sample * 1/8 will fail!!
				for(int i=0; i<2.0; i++)
				{
					cVector2f vJitterLookupCoord = cVector2f(vScreenJitterCoord.x, vScreenJitterCoord.y + fJitterZ);
					
					cVector4f vOffset = sample(aShadowOffsetMap, vJitterLookupCoord) *2.0-1.0;
									
					fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.xy) * vFinalScattterMul ) / 4.0;
					fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.zw) * vFinalScattterMul ) / 4.0;
								
					fJitterZ += 1.0 / $ShadowJitterSamplesDiv2;
				}
				
				////////////////
				// Check if in penumbra
				if( (fShadowSum-1.0) * fShadowSum * fLightAmount != 0)
				{ 	
					//Multiply, so the X presamples only affect their part (X/all_samples) of samples taken.
					fShadowSum *= 4.0 / $ShadowJitterSamples; 
								
					////////////////
					// Fullscale filtering
					for(int i=0; i<$ShadowJitterSamplesDiv2-2.0; i++)
					{
						cVector2f vJitterLookupCoord = cVector2f(vScreenJitterCoord.x, vScreenJitterCoord.y + fJitterZ); //Not that coords are 0-1!
					
						cVector4f vOffset = sample(aShadowOffsetMap, vJitterLookupCoord) *2.0 - 1.0;
															
						fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.xy) * vFinalScattterMul ) / $ShadowJitterSamples;
						fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.zw) * vFinalScattterMul ) / $ShadowJitterSamples;
						
						fJitterZ += 1.0 / $ShadowJitterSamplesDiv2;
					}
					
					//vDiffuse.xyz = cVector3f(0,0,1);
				}
				/*else
				{
					if(fShadowSum>0.5) 	vDiffuse.xyz = cVector3f(1,0,0);	
					else		 	vDiffuse.xyz = cVector3f(0,1,0);
					
					//fAttenuatuion *= fShadowSum;	
				}*/
			/////////////////////
			// No Dynamic Branching
			@else
				for(int i=0; i<$ShadowJitterSamplesDiv2; i++)
				{
					cVector2f vJitterLookupCoord = cVector2f(vScreenJitterCoord.x, vScreenJitterCoord.y + fJitterZ);
					
					cVector4f vOffset = sample(aShadowOffsetMap, vJitterLookupCoord) *2.0 - 1.0;
					
					fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.xy) * vFinalScattterMul );
					fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.zw) * vFinalScattterMul );
								
					fJitterZ += 1.0 / $ShadowJitterSamplesDiv2;
				}
				
				fShadowSum /= $ShadowJitterSamples;
			@endif
			
			
			/////////////////////
			// Add shadow sum to attenuation
			fShadowAmount = fShadowSum;
		@endif
		
		@ifdef UseShadowFade
			fShadowAmount = mix(fShadowAmount, 1.0, px_fShadowFadeRange);
		@endif
		
		fAttenuatuion *= fShadowAmount;
	@endif

	@ifdef UseUnderwaterFog
		///////////
		// Calcualte the amount the fog should affect the light
		@ifdef LightType_Directional
			cVector3f vFogColor = avFogColor.xyz;
		@else
			float fFogAmount = clamp((fDistance - avFogStartAndLength.x) / avFogStartAndLength.y, 0.0, 1.0);
			fFogAmount = pow(fFogAmount, afFogFalloffExp);

			cVector3f vFogColor = pow(avFogColor.xyz, cVector3f(fFogAmount * 1.2));
		@endif
	@endif

	/////////////////////////////////
	//Calculate Final color
	@ifdef UseGobo
		@ifdef GoboSpecFlag 
			//GoboSpecFlag is only here to support backward compatability for now
			@ifdef GoboType_Diffuse 
				vDiffuse *= vGoboVal.xyz;
			@else
				vDiffuse = cVector3f(0.0);
			@endif
		@else
			vDiffuse *= vGoboVal.xyz;
		@endif

		@ifdef UseSpecular
			vSpecular *= vGoboVal.w;
		@endif
	@endif

	
	@ifdef UseSpecular
		vDiffuse += vSpecular;
	@endif
	
	vDiffuse *= fAttenuatuion;
	
	@ifdef LightType_Directional
		vDiffuse += vAmbColor;
	@endif
		
	@ifdef UseUnderwaterFog
		vDiffuse *= vFogColor;
	@endif

	@ifdef DebugComplexity
		vDiffuse = cVector3f(px_fComplexity / 8.0f);
	@endif

	// Multiply with 8.0 to increase precision
	out_vColor.xyz =vDiffuse * 8.0;
	out_vColor.w = 0;

}

@else

// BACKWARD COMPATABILITY






















































//--------------------------------------------------------------

///////////////////////////////
// Shadow helper functions

float ShadowOffsetLookup(cTexture2DCmp aShadowMap, cVector4f avLocation, cVector2f avOffset)
{
	return sampleCmp(aShadowMap, avLocation.xy + avOffset, avLocation.z);
}

//--------------------------------------------------------------

@ifdef UseLinearColorSpaceCorrection
	@include helper_gamma_correction.hpsl
@endif

/////////////////////
//Uniform varaibles
@ifdef UseBatching
	//Do nothing
@else
	uniform cVector3f avLightPos;
	uniform float afInvLightRadius;
	uniform cVector4f avLightColor;
	uniform float afFalloffPow;
@endif

//Used to retrieve postion!
uniform float afNegFarPlane;
uniform cVector4f avScreenToFarPlane;
uniform cVector2f avInvScreenSize;

//General Shadow settings
@ifdef UseShadowMap
	@ifdef ShadowMapQuality_Low
	@else
		uniform cVector2f avShadowMapOffsetMul;
	@endif
@endif

//Directional  specfic
@ifdef LightType_Directional
	
	uniform cVector3f avLightDirection;
	
	uniform cVector3f avAmbientColorSky;
	uniform cVector3f avAmbientColorGround;
	
	uniform cVector3f avViewSpaceUp;
	
	@ifdef UseShadowMap
		uniform cMatrixf a_mtxLightViewProj0;
		uniform cMatrixf a_mtxLightViewProj1;
		uniform cMatrixf a_mtxLightViewProj2;
		uniform cMatrixf a_mtxLightViewProj3;
		
		uniform cVector4f avSplitsNear; //Only needed when using the non-dyn branching version!
		uniform cVector4f avSplitsFar;
		uniform cVector4f avSplitOffsetMul;
	@endif

	@ifdef UseGobo
		uniform cMatrixf a_mtxDirectionLightGobo;
	@endif

//Spotlight specfics
@elseif LightType_Spot
	uniform cMatrixf a_mtxLightViewProj;
	uniform cVector3f avLightForward;
	@ifdef UseGobo
	@else
		uniform float afSpotFalloffPow;
		uniform float afOneMinusCosHalfSpotFOV;
	@endif
//Point specfics
@else
	@ifdef UseGobo
		uniform cMatrixf a_mtxInvViewRotation;
	@endif
@endif

@ifdef UseUnderwaterFog
	uniform float afFogFalloffExp;
	uniform cVector2f avFogStartAndLength;
	uniform cVector4f avFogColor;
@endif

@ifdef GoboType_Specular
	@ifdef LightType_Spot
		uniform cVector3f avLightUp;
		uniform cVector3f avLightRight;
	@endif
	uniform float afLightSourceRadius;
@endif

@ifdef DebugComplexity
	uniform float afComplexity;
@endif

//Translucency
uniform float afTranslucencyScale;

@ifdef UseShadowFade
	uniform float afShadowFade;
@endif

////////////////////
//Textures
uniform cTexture2D aDiffuseMap : 0;
uniform cTexture2D aNormalDepthMap : 1;

@ifdef UseSpecular
	uniform cTexture2D  aSpecMap : 2;
@endif
	
////////////////////////////
//Additional textures

//Spot light
@ifdef LightType_Spot || LightType_Directional
	@ifdef UseGobo
		uniform cTexture2D aGoboMap : 5;
	@endif
//Point light
@else
	@ifdef UseGobo
		uniform cTextureCube aGoboMap : 5;
	@endif
@endif

//Shadow map
@ifdef UseShadowMap
	uniform cTexture2DCmp aShadowMap : 6;	
	@ifdef ShadowMapQuality_Low
	@else
		uniform cTexture2D aShadowOffsetMap : 7;
	@endif
@endif

cVector3f GetPos(in cVector2f avUV, float afDepth)
{
	return cVector3f(avUV.xy * avScreenToFarPlane.xy + avScreenToFarPlane.zw, afNegFarPlane) * afDepth;
}

@ifdef GoboType_Specular
	cVector3f ReflectRayPlane(in cVector3f avPos, in cVector3f avNormal, in cVector3f avLightPos, in cVector3f avLightDir, out float afT)
	{			
		cVector3f vRayDir = -reflect(normalize(avPos), avNormal);
			
		@ifdef LightType_Spot
			afT = -(dot(avPos, avLightDir) - dot(avLightDir, avLightPos) + afLightSourceRadius) / dot(vRayDir, avLightDir);
		@else
			afT = -(dot(avPos, avLightDir) - dot(avLightDir, avLightPos)) / dot(vRayDir, avLightDir);
		@endif

		return avPos + vRayDir * afT;
	}
@endif

//--------------------------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
@ifdef UseBatching
		  in cVector3f px_vLightPosition,		
		  in cVector4f px_vLightColor,
		  in float px_fLightRadius,
@endif
		  out cVector4f out_vColor : 0)
{
	/////////////////////////////////
	//Get values from samplers
	cVector2l vMapCoords = cVector2l(px_vPosition.xy);
	cVector4f vColorVal =  sample(aDiffuseMap, px_vPosition.xy * avInvScreenSize);
	cVector4f vNormalDepthVal = load(aNormalDepthMap, vMapCoords, 0);
	
	@ifdef UseLinearColorSpaceCorrection
		//Convert color to linear space	if needed, convert a aswell
		vColorVal.rgba = GammaToLinearCorrection(vColorVal.rgba);
	@endif

	/////////////////////////////////
	//When using batching, set up variables differently
	@ifdef UseBatching
		cVector3f avLightPos = px_vLightPosition;
		float afInvLightRadius = px_fLightRadius;
		cVector4f avLightColor = px_vLightColor;
	@endif
	
	/////////////////////////////////
	// Get postion
	float fDepth = vNormalDepthVal.w;
	cVector3f vPos = GetPos(px_vPosition.xy, fDepth);
		
	/////////////////////////////////
	// Light direction and attenuation
	@ifdef LightType_Directional
		cVector3f vLightDir = avLightDirection;
		float fAttenuatuion = 1.0;
	@else
		cVector3f vLightDir = avLightPos - vPos;
		float fDistance = sqrt(dot(vLightDir,vLightDir));
		float fAttenuatuion =  pow(1.0 - min(fDistance * afInvLightRadius, 1.0), afFalloffPow);	
		vLightDir = normalize( vLightDir );
	@endif
	
	/////////////////////////////////
	//Unpack normal and normalize (if needed)
	cVector3f vNormal = vNormalDepthVal.xyz;
	
	@ifdef UseSpecular || UseTranslucency
		vNormal = normalize(vNormal);
		cVector3f vEye = -normalize(vPos);
	@endif
	
	
	//////////////////////////////
	// Spot attentuation / gobo
	@ifdef LightType_Directional
		// Apply shadow bias in the normals direction
		vPos += vNormal * (1 - dot(vNormal, vLightDir)) * 0.5;

		@ifdef UseGobo
			cVector4f vGoboUv = mul(a_mtxDirectionLightGobo, cVector4f(vPos,1.0));
			cVector4f vGoboVal = sample(aGoboMap, vGoboUv.xy);
			@ifdef UseLinearColorSpaceCorrection
				vGoboVal = GammaToLinearCorrection(vGoboVal);
			@endif
		@endif

			
	@elseif LightType_Spot
		// Apply normal based bias
		vPos += vNormal * (1 - dot(vNormal, vLightDir)) * 0.05;

		@ifdef UseGobo
			cVector4f vProjectedUv = mul(a_mtxLightViewProj, cVector4f(vPos,1.0)); 
			vProjectedUv = cVector4f(vProjectedUv.xyz, 1.0) / vProjectedUv.w;
			cVector4f vGoboVal = sample(aGoboMap, cVector2f(1.0) - vProjectedUv.xy);
			@ifdef UseLinearColorSpaceCorrection
				vGoboVal = GammaToLinearCorrection(vGoboVal);
			@endif
		@else
			cVector4f vProjectedUv = mul(a_mtxLightViewProj, cVector4f(vPos,1.0));
			vProjectedUv = cVector4f(vProjectedUv.xyz, 1.0) / vProjectedUv.w;
			float fOneMinusCos = max(0.0, 1.0 - dot( vLightDir,  avLightForward));
			fAttenuatuion *= pow(1.0 - sqrt(min(fOneMinusCos / afOneMinusCosHalfSpotFOV,1)), afSpotFalloffPow);
		@endif

		//////////
		// Apply near clip
		fAttenuatuion *= max(0, vProjectedUv.z);

	//////////////////////////////
	//Point gobo
	@else
		@ifdef UseGobo
			cVector4f vWorldLightDir = mul(a_mtxInvViewRotation, cVector4f(vLightDir,1.0));
			cVector4f vGoboVal = sample(aGoboMap, vWorldLightDir.xyz);
			@ifdef UseLinearColorSpaceCorrection
				vGoboVal = GammaToLinearCorrection(vGoboVal);
			@endif
		@endif
	@endif
	
	/////////////////////////////////
	//Calculate specular amount
	@ifdef UseSpecular
		cVector4f vSpecVal = sample(aSpecMap, px_vPosition.xy * avInvScreenSize);
		
		//Convert color to linear space	if needed
		@ifdef UseLinearColorSpaceCorrection
			vSpecVal.rgb = GammaToLinearCorrection(vSpecVal.rgb);
		@endif
				
		@ifdef GoboType_Specular
			@ifdef LightType_Spot
				cVector3f vRayHit[3];
				
				///////////////
				// Get the main ray
				float fT;
				vRayHit[0] = ReflectRayPlane(vPos, vNormal, avLightPos, avLightForward, fT);
				float fGradient = mix(0.5, 1.0 / (vSpecVal.w * vSpecVal.w), clamp(-0.25 - fT, 0.0, 1.0));

				/////////////
				// Get dx and dy of the ray
				vRayHit[1] = ReflectRayPlane(GetPos(px_vPosition.xy + cVector2f(1, 0), fDepth), 
											 vNormal, avLightPos, avLightForward, fT);
				vRayHit[2] = ReflectRayPlane(GetPos(px_vPosition.xy + cVector2f(0, 1), fDepth), 
											 vNormal, avLightPos, avLightForward, fT);

				cVector2f vSourceUV[3];
				for(int i= 0; i < 3; ++i)
				{
					cVector3f vDelta = (avLightPos - vRayHit[i]);
					vSourceUV[i].x = dot(vDelta, avLightRight) * 0.5 + 0.5;
					vSourceUV[i].y = dot(vDelta, avLightUp) * 0.5 + 0.5;
				}

				cVector3f vSpecular = sampleGrad(aGoboMap, vSourceUV[0], 
												 (vSourceUV[1] - vSourceUV[0]) * fGradient, 
												 (vSourceUV[2] - vSourceUV[0]) * fGradient).xyz;
			@else
				float fT;
				cVector3f vRayHit = ReflectRayPlane(vPos, vNormal, avLightPos, vLightDir, fT);
				float fGradient = mix(1.0, 1.0 / vSpecVal.w, clamp(-fT, 0.0, 1.0));

				cVector4f vSpecGoboDir = mul(a_mtxInvViewRotation, cVector4f(vRayHit - avLightPos,1.0));

				cVector3f vSpecular = smoothstep(afLightSourceRadius * 1.2 * fGradient, afLightSourceRadius * 0.8 * fGradient, distance(vRayHit, avLightPos)) *
									  sample(aGoboMap, vSpecGoboDir.xyz).xyz;
			@endif

			@ifdef UseLinearColorSpaceCorrection
				vSpecular = GammaToLinearCorrection(vSpecular);
			@endif

			vSpecular *= vSpecVal.xyz * avLightColor.w * avLightColor.xyz * step(fT, 0.0);
		@else
			cVector3f vSpecIntensity = vSpecVal.xyz;
			float fSpecPower = vSpecVal.w;
		
			cVector3f vHalfVec = normalize(vLightDir + vEye);
			fSpecPower = exp2(fSpecPower * 10.0) + 1.0;//Range 0 - 1024

			// Calculate the enegry conservation value, this will make sure that the intergral of the specular is 1.0
			float fEngeryConservation = (fSpecPower + 8.0) * (1.0 / (8.0 * 3.141592));
			cVector3f vSpecular = avLightColor.w * vSpecIntensity * min(fEngeryConservation * pow(max(dot(vHalfVec, vNormal.xyz), 0.0) ,fSpecPower ), 1.0);
			vSpecular *= avLightColor.xyz;
		@endif
	@endif
	
		
	////////////////////////////////////////////
	// Ambient light
	@ifdef LightType_Directional
		float fUpAmount = dot( avViewSpaceUp, vNormal.xyz)*0.5 + 0.5;
		cVector3f vAmbColor = vColorVal.xyz * mix(avAmbientColorGround, avAmbientColorSky, fUpAmount);
	@endif
	
	/////////////////////////////////
	//Calculate diffuse color
	float fLDotN = dot( vLightDir, vNormal.xyz);
	float fLightAmount = max(fLDotN, 0.0);
	float fLightScatterAmount = max(-fLDotN, 0.0);

	@ifdef UseTranslucency
		///////////
		// A cheaper version of Dice Translucency
		// Refract the incoming light with the normal
		float fLightTransport = clamp(dot(vEye, vLightDir + vNormal.xyz * 0.2),-1.0, 0.0);
		fLightTransport = fLightTransport * fLightTransport; // pow(fLightTransport, 8.0)
		fLightTransport = fLightTransport * fLightTransport;
		fLightTransport = fLightTransport * fLightTransport;
		fLightTransport = fLightTransport * fLightTransport;

		////////
		// Apply energy conservation and ambient scattering
		float fLightScatter = (min(2.0, fLightTransport * 16.0) + fLightScatterAmount) * vColorVal.w;
	@else
		////////
		// Translucency without light transporation
		float fLightScatter = vColorVal.w * fLightScatterAmount; // Translucency (crappy Sub-surface scattering)
	@endif

	cVector3f vDiffuse = vColorVal.xyz * avLightColor.xyz * (fLightAmount+fLightScatter * afTranslucencyScale);
	
	/////////////////////////////////
	// Caclulate shadow (if any)
	@ifdef UseShadowMap
		
		float fShadowAmount=0;
		@ifdef LightType_Directional

			cVector4f vNearMul = cVector4f(step( vPos.zzzz, avSplitsNear ));
			cVector4f vFarMul = cVector4f(step( avSplitsFar, vPos.zzzz ));
			cVector4f vShadowWeights = vNearMul * vFarMul;
			cMatrixf mtxFinalLigtViewProj =	a_mtxLightViewProj0 * vShadowWeights[0] +
										a_mtxLightViewProj1 * vShadowWeights[1] +
										a_mtxLightViewProj2 * vShadowWeights[2] +
										a_mtxLightViewProj3 * vShadowWeights[3];
			cVector4f vProjectedUv = mul(mtxFinalLigtViewProj, cVector4f(vPos,1.0));
			vProjectedUv = cVector4f(vProjectedUv.xyz, 1.0) / vProjectedUv.w;
				
			@ifdef ShadowMapQuality_Low
			@else				
				float fScatterMul = dot( vShadowWeights * avSplitOffsetMul, vProjectedUv.wwww );
				cVector2f vFinalScattterMul = avShadowMapOffsetMul * fScatterMul;
			@endif
		@else			
			@ifdef ShadowMapQuality_Low
			@else
				cVector2f vFinalScattterMul = avShadowMapOffsetMul * vProjectedUv.w;
			@endif
		@endif
			
		////////////////////////
		// No Smoothing
		@ifdef ShadowMapQuality_Low
		
			fShadowAmount = sampleCmp(aShadowMap, vProjectedUv.xy, vProjectedUv.z);
					
		///////////////////////
		// Smoothing
		@else	
			//Set up variables
			float fShadowSum = 0;
			float fJitterZ =0;
			cVector2f vScreenJitterCoord = px_vPosition.xy * $ShadowJitterLookupMul;
			
			vScreenJitterCoord.y = fract(vScreenJitterCoord.y);	 //Make sure the coord is in 0 - 1 range
			vScreenJitterCoord.y *= 1.0 / $ShadowJitterSamplesDiv2;	 //Access only first texture piece
						
				
			////////////////
			// Shader Model 3, Dynamic Branching available
			@ifdef ShaderModel_4
				////////////////
				// Cheap pre-test
				//  Note1: division must occur when getting samples else gfx card gets angry.)
				//  Note2: It _must_ be division! doing sample * 1/8 will fail!!
				for(int i=0; i<2.0; i++)
				{
					cVector2f vJitterLookupCoord = cVector2f(vScreenJitterCoord.x, vScreenJitterCoord.y + fJitterZ);
					
					cVector4f vOffset = sample(aShadowOffsetMap, vJitterLookupCoord) *2.0-1.0;
									
					fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.xy) * vFinalScattterMul ) / 4.0;
					fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.zw) * vFinalScattterMul ) / 4.0;
								
					fJitterZ += 1.0 / $ShadowJitterSamplesDiv2;
				}
				
				////////////////
				// Check if in penumbra
				if( (fShadowSum-1.0) * fShadowSum * fLightAmount != 0)
				{ 	
					//Multiply, so the X presamples only affect their part (X/all_samples) of samples taken.
					fShadowSum *= 4.0 / $ShadowJitterSamples; 
								
					////////////////
					// Fullscale filtering
					for(int i=0; i<$ShadowJitterSamplesDiv2-2.0; i++)
					{
						cVector2f vJitterLookupCoord = cVector2f(vScreenJitterCoord.x, vScreenJitterCoord.y + fJitterZ); //Not that coords are 0-1!
					
						cVector4f vOffset = sample(aShadowOffsetMap, vJitterLookupCoord) *2.0 - 1.0;
															
						fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.xy) * vFinalScattterMul ) / $ShadowJitterSamples;
						fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.zw) * vFinalScattterMul ) / $ShadowJitterSamples;
						
						fJitterZ += 1.0 / $ShadowJitterSamplesDiv2;
					}
					
					//vDiffuse.xyz = cVector3f(0,0,1);
				}
				/*else
				{
					if(fShadowSum>0.5) 	vDiffuse.xyz = cVector3f(1,0,0);	
					else		 	vDiffuse.xyz = cVector3f(0,1,0);
					
					//fAttenuatuion *= fShadowSum;	
				}*/
			/////////////////////
			// No Dynamic Branching
			@else
				for(int i=0; i<$ShadowJitterSamplesDiv2; i++)
				{
					cVector2f vJitterLookupCoord = cVector2f(vScreenJitterCoord.x, vScreenJitterCoord.y + fJitterZ);
					
					cVector4f vOffset = sample(aShadowOffsetMap, vJitterLookupCoord) *2.0 - 1.0;
					
					fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.xy) * vFinalScattterMul );
					fShadowSum += ShadowOffsetLookup(aShadowMap, vProjectedUv, cVector2f(vOffset.zw) * vFinalScattterMul );
								
					fJitterZ += 1.0 / $ShadowJitterSamplesDiv2;
				}
				
				fShadowSum /= $ShadowJitterSamples;
			@endif
			
			
			/////////////////////
			// Add shadow sum to attenuation
			fShadowAmount = fShadowSum;
		@endif
		
		@ifdef UseShadowFade
			fShadowAmount = mix(fShadowAmount, 1.0, afShadowFade);
		@endif
		
		fAttenuatuion *= fShadowAmount;
	@endif

	@ifdef UseUnderwaterFog
		///////////
		// Calcualte the amount the fog should affect the light
		@ifdef LightType_Directional
			cVector3f vFogColor = avFogColor.xyz;
		@else
			float fFogAmount = clamp((fDistance - avFogStartAndLength.x) / avFogStartAndLength.y, 0.0, 1.0);
			fFogAmount = pow(fFogAmount, afFogFalloffExp);

			cVector3f vFogColor = pow(avFogColor.xyz, cVector3f(fFogAmount * 1.2));
		@endif
	@endif
	
	/////////////////////////////////
	//Calculate Final color
	@ifdef UseGobo
		@ifdef GoboSpecFlag 
			//GoboSpecFlag is only here to support backward compatability for now
			@ifdef GoboType_Diffuse 
				vDiffuse *= vGoboVal.xyz;
			@else
				vDiffuse = cVector3f(0.0);
			@endif
		@else
			vDiffuse *= vGoboVal.xyz;
		@endif

		@ifdef UseSpecular
			vSpecular *= vGoboVal.w;
		@endif
	@endif

	
	@ifdef UseSpecular
		vDiffuse += vSpecular;
	@endif
	
	vDiffuse *= fAttenuatuion;
	
	@ifdef LightType_Directional
		vDiffuse += vAmbColor;
	@endif
		
	@ifdef UseUnderwaterFog
		vDiffuse *= vFogColor;
	@endif
	
	@ifdef DebugComplexity
		vDiffuse = cVector3f(afComplexity / 8.0f);
	@endif

	@ifdef GoboType_Specular
		vDiffuse = cVector3f(fGradLen / 8.0f);
	@endif

	// Multiply with 8.0 to increase precision
	out_vColor.xyz = vDiffuse * 8.0;
	out_vColor.w = 0;

}

@endif