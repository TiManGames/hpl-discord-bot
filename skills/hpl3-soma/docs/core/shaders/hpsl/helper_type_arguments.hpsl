///////////////
// This needs to match the c++ implementation in RendererDeferredTypes.h

@ifdef MaterialType_SolidDiffuse || MaterialType_Decal || MaterialType_ProjectedUV || MaterialType_Translucent

	cBuffer cInstanceArguments : 2
	{
		int alInstanceOffset;
		int alInstanceStride;
	};

@endif

@ifdef MaterialType_SolidDiffuse

	cBuffer cSolidTypeArguments : 0
	{
		cMatrixf a_mtxViewProjection;
		cMatrixf a_mtxProjection;
		cMatrixf a_mtxView;
		cMatrixf a_mtxInvViewProjection;
		cMatrixf a_mtxInvProjection;
		cMatrixf a_mtxInvView;
		
		float afFarPlane;
		float afNearPlane;
		float afNearByFarPlane;
		float afInvFarPlane;

		float afT;
	};

	cBuffer cSolidMaterialArguments : 1
	{
		cVector3f avSwayProperties;
		cVector3f avSwayOctavesMul; 
		cVector3f avSwaySingleDirection; 
		cVector3f avSwaySingleSampleDirection;
		float afSwayYFreqMul;

		cVector2f avHeightMapScaleAndBias;
		cVector2f avFrenselBiasPow;
		
		cVector4f avDetailProperties;
		cVector3f avDetailWeights;

		float afLiquidInvTextureSize;
		cVector4f avLiquidColor;
		cVector4f avLiquidSpecular;

		float afIlluminationMul;
		float afDissolveLayer;
	};

@endif

@ifdef MaterialType_Decal

	cBuffer cDecalTypeArguments : 0
	{
		cMatrixf a_mtxViewProjection;
		cMatrixf a_mtxProjection;
		cMatrixf a_mtxView;
		
		float afFarPlane;
		float afNearPlane;
		float afNearByFarPlane;
		float afInvFarPlane;
	};

	
	cBuffer cDecalMaterialArguments : 1
	{
		cVector4f avDetailProperties;
		cVector4f avClearColor;
		cVector2f avHeightMapScaleAndBias;
		float afDetailWeight;
	};

@endif

@ifdef MaterialType_ProjectedUV

	cBuffer cProjectedUVTypeArguments : 0
	{
		cMatrixf a_mtxViewProjection;
		cMatrixf a_mtxProjection;
		cMatrixf a_mtxView;
		cMatrixf a_mtxInvViewProjection;
		cMatrixf a_mtxInvProjection;
		cMatrixf a_mtxInvView;
		
		float afFarPlane;
		float afNearPlane;
		float afNearByFarPlane;
		float afInvFarPlane;

		float afT;
	};

	cBuffer cProjectedUVMaterialArguments : 1
	{
		float afBlendHardness;
		float afNormalMapBlendImpact;
		float afDetailAlpha;
		float afDetailTextureScale;

		cVector3f avTextureScale;
	};


@endif

@ifdef MaterialType_Terrain

	cBuffer cTerrainVertexArguments : 0
	{
		cMatrixf a_mtxViewProjection;
		cMatrixf a_mtxProjection;
		cMatrixf a_mtxView;
		cMatrixf a_mtxInvViewProjection;
		cMatrixf a_mtxInvProjection;
		cMatrixf a_mtxInvView;
	
		float afFarPlane;
		float afNearPlane;
		float afNearByFarPlane;
		float afInvFarPlane;

		cVector4f avDebugColor;

		cVector4f avLodProperties; // xyz = position of lod eye, w lod scale

		cVector4f avPatchPositionScale;
	
		cVector3f avDetailMapScale;
		float afSpecularPower;
		cMatrixf a_mtxNormal;
		cVector3f avHeightMapProperties;
		cVector3f avHeightMapProperties0;
		cVector3f avWallTextureParams;

		cVector2f avDetailFade;
		float afTerrainTextureBorderDiv;

		float afTesselationScale;
		cVector2f avTesselationMulAndLimit;

		int alInstanceOffset;
		int alInstanceStride;
	};

@endif

@ifdef MaterialType_Translucent
	cBuffer cTranslucentTypeArguments : 0
	{
		cMatrixf a_mtxViewProjection;
		cMatrixf a_mtxProjection;
		cMatrixf a_mtxView;
		cMatrixf a_mtxInvViewProjection;
		cMatrixf a_mtxInvProjection;
		cMatrixf a_mtxInvView;
		
		float afFarPlane;
		float afNearPlane;
		float afNearByFarPlane;
		float afInvFarPlane;

		float afT;

		float afFalloffExp;
		float afSecondFalloffExp;
		
		cVector4f avFogColor;
		cVector4f avSecondFogColor;
		cVector2f avInvScreenSize;
	};

	cBuffer cTranslucentMaterialArguments : 1
	{
		cVector3f avSwayProperties; 
		float afRefractionScale;
		cVector3f avSwayOctavesMul;
		float afLiquidInvTextureSize;
		cVector3f avSwaySingleDirection; 
		float afSwayYFreqMul;
		cVector3f avSwaySingleSampleDirection;
		float afScrollingNoiseSpeed;
		
		cVector4f avLiquidColor;

		float afScrollingNoiseScale;
		float afSoftParticleDepthBias;
		float afSoftParticleAlphaBasedThickness;
		float afSoftParticleThickness;

		cVector4f avDepthOfFieldParams;
		
		cVector2f avFogStartAndLength;
		cVector2f avSecondFogStartAndLength;
		cVector2f avRimLightMulPow;
		cVector2f avFrenselBiasPow;
	};
@endif

@ifdef MaterialType_EdgeGlow

	cBuffer cEdgeGlowArguments : 0
	{
		cMatrixf a_mtxViewProjection;
		cMatrixf a_mtxView;
		
		cVector4f aColor;	
				
		float afInvFarPlane;
		float afT;

		float afAlpha;
		float afLightLevel;
		float afLightLimit;
		float afEdgeThickness;

		int alInstanceOffset;
		int alInstanceStride;
	};

@endif