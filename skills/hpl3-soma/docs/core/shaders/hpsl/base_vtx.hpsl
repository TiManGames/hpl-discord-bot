////////////////////////////////////////////////////////
// Base - Vertex Shader
//
//
////////////////////////////////////////////////////////

//---------------------------------------------

uniform cMatrixf a_mtxModelViewProjection;
uniform cMatrixf a_mtxModelNormal;

@ifdef UseColorMul
	uniform cVector4f avColorMul;
@endif

//////////////////////////////////////
// UV Animation variables
@ifdef UseUvAnimation
	uniform cMatrixf a_mtxUV;
@endif

//---------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f vtx_vPosition,
		  in cVector4f vtx_vTexCoord0,
		  in cVector4f vtx_vTexCoord1,
		  in cVector3f vtx_vNormal,
		  in cVector4f vtx_vTangent,
		  in cVector4f vtx_vColor,
		  out cVector4f px_vTexCoord0,
@ifdef UseUvCoord1
		  out cVector4f px_vTexCoord1,
@endif
@ifdef UseNormals
		  out cVector3f px_vNormal,
@endif
@ifdef UseNormalMapping || UseLiquid
		  out cVector3f px_vTangent,
		  out cVector3f px_vBinormal,
@endif
@ifdef UseColor || UseAngleFade
		  out cVector4f px_vColor,
@endif
		  out cVector4f px_vPosition)
{	
	cVector4f vLocalVertexPos = vtx_vPosition;
	px_vPosition = mul(a_mtxModelViewProjection, vLocalVertexPos);
	
	//////////////////////
	// Uv
	@ifdef UseUv
		@ifdef UseUvAnimation
			px_vTexCoord0 = mul(a_mtxUV, vtx_vTexCoord0);
		@else
			px_vTexCoord0 = vtx_vTexCoord0;
		@endif
		@ifdef UseUvCoord1
			px_vTexCoord1 = vtx_vTexCoord1;
		@endif
	@endif

	//////////////////////
	// Color
	@ifdef UseColor
		px_vColor = vtx_vColor;
	@elseif UseAngleFade
		px_vColor = cVector4f(1.0);
	@endif
	
	@ifdef UseColorMul
		px_vColor *= avColorMul;
	@endif

	@ifdef UseMeshInstancing
		px_vColor *= vInstanceColor;
	@endif


	//////////////////////
	// Normals
	@ifdef UseNormals || UseLiquid
		@ifdef UseSkeleton || UseMeshInstancing
			px_vNormal = normalize(mul(a_mtxModelNormal, qmul(qRotation, vtx_vNormal)));
		@else
			px_vNormal = normalize(mul(a_mtxModelNormal, * vtx_vNormal));
		@endif
	@endif

	//////////////////////
	// Normalmapping
	@ifdef UseNormalMapping || UseLiquid
		@ifdef UseSkeleton || UseMeshInstancing
			px_vTangent =  normalize(mul(a_mtxModelNormal, qmul(qRotation, vtx_vTangent.xyz)));
			
			///NOTE: normal are and tan are reveresed, because of OpenGL texture coord system
			px_vBinormal = normalize(mul(a_mtxModelNormal, qmul(qRotation, cross(vtx_vTangent.xyz, vtx_vNormal) * vtx_vTangent.w)));
		@else
			px_vTangent = normalize(mul(a_mtxModelNormal, vtx_vTangent.xyz));
		
			//Need to do it in model space (and not view) because reflection normal mapping will fail otherwise!
			//NOTE: normal are and tan are reveresed, because of OpenGL texture coord system
			px_vBinormal = normalize(mul(a_mtxModelNormal, cross(vtx_vTangent.xyz, vtx_vNormal) * vtx_vTangent.w)); 
		@endif
	@endif
}