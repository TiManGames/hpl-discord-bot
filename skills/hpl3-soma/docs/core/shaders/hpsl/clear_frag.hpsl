////////////////////////////////////////////////////////
// Clear depth and or color - Pixel shader
////////////////////////////////////////////////////////

void main(in cVector4f px_vPosition,
		  in cVector4f px_vColor,
		  out cVector4f out_vColor0 : 0,
		  out cVector4f out_vColor1 : 1,
		  out cVector4f out_vColor2 : 2,
		  out cVector4f out_vColor3 : 3)
{
	// Clear all 4 channels
	out_vColor0 = out_vColor1 = out_vColor2 = out_vColor3 = px_vColor;
}