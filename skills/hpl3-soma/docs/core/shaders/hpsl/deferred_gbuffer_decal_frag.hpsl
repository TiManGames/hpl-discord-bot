////////////////////////////////////////////////////////
// Deferred Diffuse Decal - Fragment Shader
//
// A decal shader where light is applied
////////////////////////////////////////////////////////

@ifdef UseTextureBuffer

@ifdef UseNormalMapping
	@include helper_normal_packing.hpsl
@endif

@ifdef UseParallax
	@include helper_parallax.hpsl
@endif

///////////////////////
// Variables
///////////////////////

//--------------------------------------------


// This contains all constant buffers and chooses the correct one based on MaterialType
@include helper_type_arguments.hpsl

//--------------------------------------------


///////////////////////
// samplers
///////////////////////

uniform cTexture2D aDiffuseMap : 0;

@ifdef UseNormalMapping
	uniform cTexture2D aNormalMap : 1;
@endif

@ifdef UseSpecular
	uniform cTexture2D aSpecularMap : 2;
@endif

@ifdef UseParallax
	uniform cTexture2D aHeightMap : 3;
@endif

@ifdef UseDetailMap
	uniform cTexture2D aDetailMap : 4;
@endif

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
@ifdef UseNormalMapping
		  in cVector3f px_vNormal,
		  in cVector3f px_vTangent,
		  in cVector3f px_vBinormal,
@endif
		  in cVector4f px_vColor,
@ifdef UseDetailMap
		  in float px_fLinearDepth,
@endif
@ifdef UseParallax
		  in cVector3f px_vTangentEyePos,
@endif
		  out cVector4f out_vNormal : 1,			//normal xyz, depth w
		  out cVector4f out_vSpecular : 2,			//spec color rgb, spec power a
		  out cVector4f out_vDiffuse : 0)	//diffuse rgb, translucency a	
{
	//////////////////////////////////
	// Get UV coords
	@ifdef UseParallax
		@ifdef ParallaxMethod_Relief
			cVector2f vTexCoord = GetParallaxUV_Relief(aHeightMap,3, px_vTexCoord0.xy, px_vTangentEyePos, avHeightMapScaleAndBias);
		@else				
			cVector2f vTexCoord = GetParallaxUV_Simple(aHeightMap,3, px_vTexCoord0.xy, px_vTangentEyePos, avHeightMapScaleAndBias);
		@endif
		
		//The height should drop off at the edges!
		//Not totally accurate, but it works!
		float fHeightAlpha = sample(aDiffuseMap, vTexCoord).w;
		vTexCoord = mix(px_vTexCoord0.xy,vTexCoord,fHeightAlpha); 
		
	@else
		cVector2f vTexCoord = px_vTexCoord0.xy;
	@endif
	
	////////////////////
	//Diffuse 
	cVector4f vDiffuse = sample(aDiffuseMap, vTexCoord);
	
	////////////////////
	//Detail
	@ifdef UseDetailMap
		float afDetailMul = afDetailWeight * clamp(1 - (px_fLinearDepth * afFarPlane-avDetailProperties.x) / avDetailProperties.y, 0.0, 1.0);
		
		cVector4f vDetailColor = sample(aDetailMap, vTexCoord*avDetailProperties.zw);
		vDiffuse.xyz *= mix(cVector3f(1.0), vDetailColor.xyz*2, afDetailMul);
	@endif
		
	float fAlpha = vDiffuse.w * px_vColor.w;

	if(fAlpha <= 0.01) 	discard;
	
	out_vDiffuse = vDiffuse * px_vColor;

	
	@ifdef UseFullBuffer
	
		//////////////////////////////////
		//Normal
		@ifdef UseNormalMapping
			cVector3f vNormal = UnpackNormalmapYW(sample(aNormalMap,vTexCoord));
					
			cVector3f vScreenNormal = normalize(vNormal.x * px_vTangent + vNormal.y * px_vBinormal + vNormal.z * px_vNormal);
			out_vNormal.xyz = vScreenNormal * fAlpha;
			out_vNormal.w = fAlpha;
		@else
			out_vNormal = avClearColor;
		@endif
		
		/////////////////////////////////
		//Specular
		@ifdef UseSpecular
			out_vSpecular.xyz = sample(aSpecularMap, vTexCoord).xyz;
			out_vSpecular.w = fAlpha;
		@else
			out_vSpecular = avClearColor;
		@endif
		
	@else
		out_vNormal = avClearColor;
		out_vSpecular = avClearColor;
	@endif
}

@else

////////////////////////////
// BACKWARD COMBATABILITY BELOW




































@ifdef UseNormalMapping
	@include helper_normal_packing.hpsl
@endif

@ifdef UseParallax
	@include helper_parallax.hpsl
@endif

///////////////////////
// Variables
///////////////////////

//--------------------------------------------

@ifdef UseDetailMap
	cBuffer cDecalFragArguments
	{
		////////////
		// Detail textures
		cVector4f avDetailProperties;	//x=fadestart, y=fadelength, zw=uvmul
		float afDetailWeight;
	};
@endif

//--------------------------------------------


///////////////////////
// samplers
///////////////////////

uniform cTexture2D aDiffuseMap : 0;

@ifdef UseNormalMapping
	uniform cTexture2D aNormalMap : 1;
@endif

@ifdef UseSpecular
	uniform cTexture2D aSpecularMap : 2;
@endif

@ifdef UseParallax
	uniform cTexture2D aHeightMap : 3;
	uniform cVector2f avHeightMapScaleAndBias;
@endif

@ifdef UseDetailMap
	uniform cTexture2D aDetailMap : 4;
@endif

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
@ifdef UseNormalMapping
		  in cVector3f px_vNormal,
		  in cVector3f px_vTangent,
		  in cVector3f px_vBinormal,
@endif
		  in cVector4f px_vColor,
@ifdef UseDetailMap
		  in float px_fLinearDepth,
@endif
@ifdef UseParallax
		  in cVector3f px_vTangentEyePos,
@endif
		  out cVector4f out_vDiffuse : 0,		//diffuse rgb, translucency a
		  out cVector4f out_vNormal : 1,			//normal xyz, depth w
		  out cVector4f out_vSpecular : 2)		//spec color rgb, spec power a
{
	//////////////////////////////////
	// Get UV coords
	@ifdef UseParallax
		@ifdef ParallaxMethod_Relief
			cVector2f vTexCoord = GetParallaxUV_Relief(aHeightMap,3, px_vTexCoord0.xy, px_vTangentEyePos, avHeightMapScaleAndBias);
		@else				
			cVector2f vTexCoord = GetParallaxUV_Simple(aHeightMap,3, px_vTexCoord0.xy, px_vTangentEyePos, avHeightMapScaleAndBias);
		@endif
		
		//The height should drop off at the edges!
		//Not totally accurate, but it works!
		float fHeightAlpha = sample(aDiffuseMap, vTexCoord).w;
		vTexCoord = mix(px_vTexCoord0.xy,vTexCoord,fHeightAlpha); 
		
	@else
		cVector2f vTexCoord = px_vTexCoord0.xy;
	@endif
	
	////////////////////
	//Diffuse 
	cVector4f vDiffuse = sample(aDiffuseMap, vTexCoord);
	
	////////////////////
	//Detail
	@ifdef UseDetailMap
		float afDetailMul = afDetailWeight * clamp(1 - (px_fLinearDepth-avDetailProperties.x) / avDetailProperties.y, 0.0, 1.0);
		
		cVector4f vDetailColor = sample(aDetailMap, vTexCoord*avDetailProperties.zw);
		vDiffuse.xyz *= mix(cVector3f(1.0), vDetailColor.xyz*2, afDetailMul);
	@endif
		
	float fAlpha = vDiffuse.w * px_vColor.w;

	if(fAlpha <= 0.01) 	discard;
	
	out_vDiffuse = vDiffuse * px_vColor;

	
	@ifdef UseFullBuffer
	
		//////////////////////////////////
		//Normal
		@ifdef UseNormalMapping
			cVector3f vNormal = UnpackNormalmapYW(sample(aNormalMap,vTexCoord));
					
			cVector3f vScreenNormal = normalize(vNormal.x * px_vTangent + vNormal.y * px_vBinormal + vNormal.z * px_vNormal);
			out_vNormal.xyz = vScreenNormal * fAlpha;
			out_vNormal.w = fAlpha;
		@else
			out_vNormal = cVector4f(0);
		@endif
		
		/////////////////////////////////
		//Specular
		@ifdef UseSpecular
			out_vSpecular.xyz = sample(aSpecularMap, vTexCoord).xyz;
			out_vSpecular.w = fAlpha;
		@else
			out_vSpecular = cVector4f(0.0);
		@endif
		
	
	@endif
}

@endif