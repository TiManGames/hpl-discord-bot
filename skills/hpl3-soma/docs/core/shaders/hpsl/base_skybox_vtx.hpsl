////////////////////////////////////////////////////////
// Skybox frag
//
//
////////////////////////////////////////////////////////

//---------------------------------------------

uniform cMatrix4f a_mtxInvViewProjection;

//---------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f vtx_vPosition,
		  in cVector4f vtx_vColor,
		  out cVector4f px_vTexCoord0,
		  out cVector4f px_vColor,
		  out cVector4f px_vPosition)
{	
	///////////
	// Fullscreen quad that does not clip geometry
	px_vPosition = cVector4f(vtx_vPosition.xy, 1.0f, 1.0f);

	//////////////////////
	// Transform the projected position to world space
	px_vTexCoord0 = mul(a_mtxInvViewProjection, vtx_vPosition) * cVector4f(-1,1,1,1);
	px_vTexCoord0 /= px_vTexCoord0.w;

	//////////////////////
	// Color
	px_vColor = vtx_vColor;
}