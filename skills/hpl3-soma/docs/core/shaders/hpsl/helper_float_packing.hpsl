// Pack a float in a 2d vector
cVector2f PackFloatInVec2(float afX)
{
	cVector2f vRet;
	afX *= 255.0;
	vRet.x = floor(afX);
	vRet.y = (afX - vRet.x);
	vRet.x *= (1.0 / 255.0);
	return vRet;	
}

//------------------------------------

// Pack a float in a 3d vector
cVector3f PackFloatInVec3(float afX)
{
	cVector3f vRet;
	afX *= 255.0;
	vRet.x = floor(afX);
	afX = (afX - vRet.x) * 255.0;
	vRet.y = floor(afX);
	vRet.z = afX - vRet.y;
	vRet.xy *= (1.0 / 255.0);
	
	return vRet;	
}

//------------------------------------

// Unpack a 2d vector to a float
float UnpackVec2ToFloat(cVector2f avVal)
{
	return dot(avVal, cVector2f(1.0, 1.0/255.0) ); 	
} 

//------------------------------------

// Unpack a 3d vector to a float
float UnpackVec3ToFloat(cVector3f avVal)
{
	return dot(avVal, cVector3f(1.0, 1.0/255.0, 1.0 / (255.0*255.0 )) ); 	
}
