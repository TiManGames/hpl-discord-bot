////////////////////////////////////////////////////////
// Deferred Skybox - Fragment Shader
//
// samples a cubemap skybox
////////////////////////////////////////////////////////

@ifdef UseLinearColorSpaceCorrection
	@include helper_gamma_correction.hpsl
@endif

uniform cTextureCube aSkyMap : 0;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  in cVector4f px_vColor,
		  out cVector4f out_vColor : 0)
{
	cVector4f vFinalColor;
	
	////////////////////
	//Diffuse 
	vFinalColor = sample(aSkyMap, px_vTexCoord0.xyz);

	//Convert color to linear space	if needed
	@ifdef UseLinearColorSpaceCorrection
		vFinalColor.rgb = GammaToLinearCorrection(vFinalColor.rgb);
	@elseif GammaCorrectCubeMaps
		vFinalColor.rgb = pow(vFinalColor.rgb, cVector3f(2.2));
	@endif
	
	// Multiply with 8.0 to increase precision
	out_vColor = vFinalColor * px_vColor * cVector4f(8.0, 8.0, 8.0, 1.0);
}