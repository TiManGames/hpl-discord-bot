////////////////////////////////////////////////////////
// PostEffect Video Distortion - Fragment Shader
//
// Adds bad video like noise.
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;

uniform cVector2f avScreenSize;
uniform float afAmount;
uniform float afSeed;
uniform float afLineDensity;
uniform float afOffsetMul;
uniform cVector2f avScreenOffset;
uniform cVector2f avScreenBendAmount;

float Hash1D( float p )
{
	return fract(sin(127.1*p)*43758.5453123);
}

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	///////////////////////////////////
	// Set up coordinates
	cVector2f vCoords = px_vTexCoord0.xy;
	
	vCoords += avScreenOffset;
	
	cVector2f vNormalCoords = vCoords;
	vNormalCoords = vNormalCoords*2-1;
	cVector2f vCoordBendAdd = cVector2f(	cos( (3.142/2.0) * vNormalCoords.y) *vNormalCoords.x - vNormalCoords.x*1.5,
								cos( (3.142/2.0) * vNormalCoords.x) *vNormalCoords.y - vNormalCoords.y*1.5);
	vCoords += vCoordBendAdd * avScreenBendAmount; 
	
	cVector4f vColor = sample(diffuseMap, vCoords);
	
	cVector2f vVirtualCoords = vCoords*100;
			
	
	///////////////////////////////////
	// Calculate the rows
	float fRowRand = Hash1D(afSeed+floor(vVirtualCoords.y*0.1));
	float fYMul = mix(0.05, 0.8, fRowRand*fRowRand);
	float fRandStrength = Hash1D(floor(vVirtualCoords.y*fYMul)+100+fRowRand);
	
	///////////////////////////////////
	// If this is a row, then calculate the distortion
	float fFinalAmount = 0; 
		
	float fCoordAdd=0;
	if(fRandStrength>(1.0-afLineDensity))
	{
		float fDistortAmount = 0.15;
		
		fFinalAmount = afAmount*(0.5f + (Hash1D(floor(vVirtualCoords.y*fYMul) +1273+floor(afAmount*4) )*2-1)*0.5f);
			
		float fRA = Hash1D(floor(vVirtualCoords.y))*2-1;
		fCoordAdd = fRA*fDistortAmount*fFinalAmount*1.0;
		fCoordAdd += (Hash1D(floor(vVirtualCoords.x*0.25))*2-1) * fDistortAmount*0.4f;
		fCoordAdd *= afOffsetMul;
	}
	
	///////////////////////////////////
	// Intensity
	float fIntensity = dot( vColor.xyz, cVector3f(0.3f, 0.58f, 0.12f));
	fIntensity = clamp(fIntensity, 0, 1);
	
	float fDualIntensity = abs(fIntensity*2-1);
	fDualIntensity *= fDualIntensity;
	
	///////////////////////////////////
	// Distortion color
	cVector4f vSamp1 = sample(diffuseMap, vCoords+cVector2f(fCoordAdd*-0.65*fDualIntensity, 0));
	cVector4f vSamp2 = sample(diffuseMap, vCoords+cVector2f(fCoordAdd*1*fDualIntensity, 0));
	cVector4f vDistortColor = vSamp1*0.5+vSamp2*0.5;
	
	///////////////////////////////////
	// Final Color
	float fMixAmount = fDualIntensity*fFinalAmount;
	out_vColor = mix(vColor,vDistortColor,fMixAmount) + cVector4f(cVector3f(fIntensity*fFinalAmount*0.05),1);


}