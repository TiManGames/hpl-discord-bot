////////////////////////////////////////////////////////
// Deferred Light Box - Fragment Shader
//
// Fragment program to draw a light box. 
////////////////////////////////////////////////////////

@ifdef UseLinearColorSpaceCorrection
	@include helper_gamma_correction.hpsl
@endif

////////////////////
//Textures
uniform cTexture2D  aWeightedColorMap : 0;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	cVector4f vColorVal =  sample(aWeightedColorMap, px_vTexCoord0.xy);

	out_vColor = vColorVal / vColorVal.wwww;
}