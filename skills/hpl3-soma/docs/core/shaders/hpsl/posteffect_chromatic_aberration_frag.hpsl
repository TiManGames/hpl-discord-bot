////////////////////////////////////////////////////////
// PostEffect Chromatic Aberration - Fragment Shader
//
// Splits the texture into 3 colors
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;

uniform cVector2f avOffsetA;
uniform cVector2f avOffsetB;
uniform cVector2f avOffsetC;

uniform cVector4f avColorA;
uniform cVector4f avColorB;
uniform cVector4f avColorC;



void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	// Split the texture into 3 colors
	cVector2f vCoordsA = px_vTexCoord0.xy + avOffsetA;
	cVector2f vCoordsB = px_vTexCoord0.xy + avOffsetB;
	cVector2f vCoordsC = px_vTexCoord0.xy + avOffsetC;

	// Limit the coords so it doesnt sample outside of the texture bounds 
	cVector2f vLimitA = abs(2.0 * vCoordsA - cVector2f(1.0)) / cVector2f(1.0);
	cVector2f vLimitB = abs(2.0 * vCoordsB - cVector2f(1.0)) / cVector2f(1.0);
	cVector2f vLimitC = abs(2.0 * vCoordsC - cVector2f(1.0)) / cVector2f(1.0);

	vCoordsA = px_vTexCoord0.xy + avOffsetA * clamp((1.0 - dot(vLimitA, vLimitA) * 0.707), 0.0, 1.0);
	vCoordsB = px_vTexCoord0.xy + avOffsetB * clamp((1.0 - dot(vLimitB, vLimitB) * 0.707), 0.0, 1.0);
	vCoordsC = px_vTexCoord0.xy + avOffsetC * clamp((1.0 - dot(vLimitC, vLimitC) * 0.707), 0.0, 1.0);

	cVector4f vDiffuseColor = sample(diffuseMap, vCoordsA) * avColorA + 
							  sample(diffuseMap, vCoordsB) * avColorB + 
							  sample(diffuseMap, vCoordsC) * avColorC;
	
	out_vColor = vDiffuseColor;
}