////////////////////////////////////////////////////////
// Null shader, bound when no other shader is bound - Pixel shader
////////////////////////////////////////////////////////


uniform cTexture2D aColorMap : 0;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vColor,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor0 : 0,
		  out cVector4f out_vColor1 : 1,
		  out cVector4f out_vColor2 : 2,
		  out cVector4f out_vColor3 : 3)
{
	cVector4f vColor = px_vColor;


	vColor *= sample(aColorMap, px_vTexCoord0.xy);


	out_vColor0 = out_vColor1 = out_vColor2 = out_vColor3 = vColor;
}