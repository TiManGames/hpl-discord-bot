////////////////////////////////////////////////////////
// PostEffect Image Trail - Fragment Shader
//
// Just set up the texture for a dest blend
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;
uniform cTexture2D fadeMap : 1;
uniform cTexture2D colorMap : 2;
uniform cTexture2D offsetMap : 3;

uniform cVector2f avScreenSize;
uniform float afAmount;
uniform float afT;

float Hash1D( float p )
{
	return fract(sin(127.1*p)*43758.5453123);
}

float Hash2D( cVector2f p )
{
	float h = dot(p,cVector2f(127.1,311.7));
	
    return fract(sin(h)*43758.5453123)*2-1;
}

float Noise2D( in cVector2f p )
{
    cVector2f i = floor( p );
    cVector2f f = fract( p );
	
	cVector2f u = f*f*(3.0-2.0*f);

    return mix( mix( Hash2D( i + cVector2f(0.0,0.0) ), 
                     Hash2D( i + cVector2f(1.0,0.0) ), u.x),
                mix( Hash2D( i + cVector2f(0.0,1.0) ), 
                     Hash2D( i + cVector2f(1.0,1.0) ), u.x), u.y);
}

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	cVector2f vScreenPos = px_vTexCoord0.xy;
	cVector3f vScreenColor = sample(diffuseMap, px_vTexCoord0.xy).xyz;
	
	cVector2f vImagePos = cVector2f(vScreenPos.x, 1-vScreenPos.y);
	cVector3f vCol = sample(fadeMap, vImagePos).xyz;
	cVector3f vFadeColor = sample(fadeMap, vImagePos).xyz;
	
	//float fAlpha = 	min(vFadeColor.x * 3.0, 1.0);// +
					//clamp((vFadeColor.y-(1.0/3.0f - 0.05))*3, 0.0, 1.0) +
					//clamp((vFadeColor.z-(2.0/3.0f - 0.05))*3, 0.0, 1.0);
	//fAlpha /= 3.0;
	float fDist = vFadeColor.x*0.333+vFadeColor.y*0.333+vFadeColor.z*0.333;
	float fAlpha = clamp( (fDist - (1-afAmount))/0.3, 0.0, 1.0);
	
	//float fDist = min(vCol.r*4 + vCol.g*2+ vCol.b*0.5, 1);
	fAlpha *= 0.7 + sin(afT*4+fDist*35)*0.15;
	
	//float fRatio = avScreenSize.x / avScreenSize.y;
	
	out_vColor.xyz = vScreenColor*(1-fAlpha) + cVector3f(0)*fAlpha;
	out_vColor.a = 1.0;
	//out_vColor.xyz = cVector3f(1)*(1-fAlpha) + cVector3f(0)*fAlpha;
		
	float test=1.0;
}
