	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cMatrixf GetHudObjectMatrix()
	{
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		
		cMatrixf mtxTrans = cMath_MatrixRotateXYZ(cVector3f(pCam.GetPitch(), pCam.GetYaw(), pCam.GetRoll()));
		
		cVector3f vPosAddTotat = cLux_GetPlayer().GetCameraPosAdd(eCameraAddType_Bob);
		vPosAddTotat += cLux_GetPlayer().GetCameraPosAdd(eCameraAddType_Shake);
		
		cVector3f vPosNeg = cMath_MatrixMul(mtxTrans, vPosAddTotat*0.1);
		
		mtxTrans.SetTranslation(pCam.GetPosition() - vPosNeg);
		
		return mtxTrans;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		//apSet.DrawFont(tWString("Something:"+mBaseObj.mpPlayer.GetCamera().GetPitch()), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) );
		//afStartY += 14;
						
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tID mHudObjectID;
	
	//------------------------------------------------------------
	
	cScrPlayerState_PickBasics mPickBasics;
	
	//------------------------------------------------------------
	
	tID mlPickedEntityId;
	int mlPreviousState;
	
	tString msUseCallback;
	tString msDropCallback;
	tString msCanBeUsedCallback;
			
	//------------------------------------------------------------
		
