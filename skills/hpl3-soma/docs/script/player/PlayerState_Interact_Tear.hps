	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupTear()
	{
		////////////////////////////////
		// Get basic params & setup
		SetupInteractVars();
		
		////////////////////////////////
		// Get the parameters
		mfMoveSpeedFactor = cScript_GetGlobalArgFloat(3);
		mfMoveSlowDownSpeed = cScript_GetGlobalArgFloat(4);
		mfHealthLossFactor = cScript_GetGlobalArgFloat(5);
		mlJointIndex = cScript_GetGlobalArgInt(6);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{
		EnterInteractState(alPrevStateId);
	
		////////////////////////////////
		// Player setup
		cScript_SetGlobalVarBool("Climb_Allowed", false);
		
		/////////////////////////////////
		//Reset data
		mfTearSpeed = 0;
		mvMoveAdd = cVector2f(0);
		mfHealth = 1.f;

		/////////////////////////////////
		//Setup body
		iPhysicsBody@ pBody = cLux_ID_Body(mBodyID);
		mbHasGravity = pBody.GetGravity();
		pBody.SetGravity(false);
		
		/////////////////////////////////
		//Get Max distance
		iPhysicsJoint@ pJoint = cLux_ID_Prop(mPropID).GetJoint(mlJointIndex);
		iCharacterBody @pCharBody = cLux_GetPlayer().GetCharacterBody();
		mfMaxDistance = cMath_Vector3Dist(pCharBody.GetFeetPosition(), pJoint.GetPivotPoint());
		mfMaxDistance = mfMaxDistance * 1.2f + 0.5f;
		
		if (cPhysics_ToJointSlider(pJoint) !is null)
		{
			mbHinge = false;
		}
		else
		{
			mbHinge = true;
		}
	}
	
	//------------------------------------------------------------
	
	void OnLeaveState(int alNextStateId)
	{					
		if(cLux_ID_Prop(mPropID) is null) return;
	
		cLux_ID_Body(mBodyID).SetGravity(mbHasGravity);

		/////////////////////////////
		//Resets some general stuff
		ResetPropInteractVars();
		
		////////////////////////////////
		// Player set back to normal
		cScript_SetGlobalVarBool("Climb_Allowed", true);
	}
	
	//------------------------------------------------------------
	
	void Reset()
	{
	
	}
		
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{		
		if(CheckShouldUpdate()==false) return;
	
		////////////////////////////
		// Check so interact is still pressed.
		if(cInput_IsTriggered(eAction_Interact)==false)
		{
			//////////////////////
			//Change state
			cLux_GetPlayer().ChangeState(mlPreviousState);
			
			return;
		}
	
		//////////////////////////////
		//Set up variables
		cLuxProp@ pProp = cLux_ID_Prop(mPropID);
		iCharacterBody @pCharBody = cLux_GetPlayer().GetCharacterBody();
		iPhysicsJoint@ pJoint = pProp.GetJoint(mlJointIndex);
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		iPhysicsBody@ pBody = cLux_ID_Body(mBodyID);
		
		//////////////////////////////
		//Check if out of range
		float fDistance = cMath_Vector3Dist(pCharBody.GetFeetPosition(), pJoint.GetPivotPoint());
		if(fDistance > mfMaxDistance)
		{
			cLux_GetPlayer().ChangeState(mlPreviousState);
			return;
		}
		
		//////////////////////////////
		// Check if successfully torn			
		float fFract = GetJointFraction(pJoint);
		if((fFract >= 0.95 || mfHealth <= 0) && mfTearSpeed > 0)
		{	
			cLux_GetPlayer().ChangeState(mlPreviousState);
			Player_SetLookSpeedMul(0.1);
			Player_FadeLookSpeedMulTo(1, 1.f);
			Effect_Shake_Start(0.008, 0, 0, 0.2);
			
			cScript_SetGlobalArgInt(0, pBody.GetUniqueID());
			cScript_SetGlobalArgVector3f(1, mvFocusPos);
			cScript_RunGlobalFunc(pProp.GetName(), "cScrPropTear", "_Global_Tear");
			
			return;
		}
		
		///////////////////////////
		//Show no crosshair!
		Player_SetCrossHairState(eCrossHairState_None);
		
		///////////////////////////////////
		//Get vectors and get move speed
		float fSpeedAdd = GetSpeedAdd(pCam, pJoint);
				
		///////////////////////////////////////////////////////////////////////
		//Slow down the speed based on the current speed and distance torn
		float fPrevSpeed = mfTearSpeed;
		if(fSpeedAdd == 0) 
		{
			mfTearSpeed = 0;
			mfHealth = cMath_Max(mfHealth, 0.2f); //restore health to avoid tearing instantly next time a movement is made
		}
		else if(mfTearSpeed > 0) 
		{
			mfTearSpeed -= mfMoveSlowDownSpeed * afTimeStep;
			mfTearSpeed *= cMath_Max(1.f-fFract, 0.5);
			if(mfTearSpeed < 0) mfTearSpeed = 0;
		}
		else if(mfTearSpeed < 0) 
		{
			mfTearSpeed += mfMoveSlowDownSpeed * afTimeStep;
			if(mfTearSpeed > 0) mfTearSpeed = 0;
		}

		///////////////////////////////////
		//Change the speed and cap it o max if needed
		mfTearSpeed += fSpeedAdd * mfMoveSpeedFactor * afTimeStep;	
		mfTearSpeed = cMath_Clamp(mfTearSpeed, -1.f, 1.f);

		// Set speed on tear prop
		pProp.SetVarFloat("TearSpeed", mfTearSpeed);
		if (fSpeedAdd > 0)
			mfHealth -= mfTearSpeed*afTimeStep*mfHealthLossFactor;

		// Reset
		mvMoveAdd = cVector2f(0);
		
		/////////////////////////////
		//Check if focus position is outside of screen.
		CheckOutsideAtScreenEdgeAndMove(afTimeStep);
	}
		
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
	}
		
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		///////////////////////////////////
		// Looking
		if(alAnalogId == eAnalogType_Look)
		{
			if (avAmount.SqrLength() < 0.0001) return false;
			
			cVector2f vAmount(avAmount.x, avAmount.y);
			if(cLux_GetInputHandler().IsYAxisInverted()) vAmount.y = -vAmount.y;	
			mvMoveAdd += vAmount * mfInputLookMul;
			
			return false;
		}
		///////////////////////////////////
		// Moving
		else if(alAnalogId == eAnalogType_Move || alAnalogId == eAnalogType_GamepadMove)
		{
			if (avAmount.SqrLength() < 0.01) return true;
			
			cVector2f vAmount(avAmount.x, -avAmount.y);
			mvMoveAdd += vAmount * mfInputWalkMul;
			
			return true;
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool AllowBuoyancy(iPhysicsBody @apBody)
	{
		if(apBody is cLux_ID_Body(mBodyID)) return false;
		
		return true;
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// Helpers
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float GetJointFraction(iPhysicsJoint@ apJoint)
	{				
		if (mbHinge)
			return apJoint.GetAngle()/cPhysics_ToJointHinge(apJoint).GetMaxAngle();
		else 
			return apJoint.GetDistance()/cPhysics_ToJointSlider(apJoint).GetMaxDistance();
	}
	
	//------------------------------------------------------------
	
	float GetSpeedAdd(cCamera @apCam, iPhysicsJoint@ apJoint)
	{			
		cVector3f vUp = apCam.GetUp();
		cVector3f vRight = apCam.GetRight();
		cVector3f vForward = apCam.GetForward();
		
		///////////////////////
		// Hinge joint
		if (mbHinge)
		{
			iPhysicsBody@ pBody = cLux_ID_Body(mBodyID);

			cVector3f vBodyCenter = cMath_MatrixMul(pBody.GetLocalMatrix(), pBody.GetMassCenter());
			cVector3f vJointToBody =  cMath_Vector3Normalize(vBodyCenter - apJoint.GetPivotPoint());

			cVector3f vPushAmount = (vUp + vForward) * -mvMoveAdd.y + vRight * mvMoveAdd.x;
			cVector3f vPushRotateDir = cMath_Vector3Cross(vJointToBody, vPushAmount);

			float fSpeedAdd = -cMath_Vector3Dot(vPushRotateDir, apJoint.GetPinDir());
			
			////////////////
			// Call a function in swingdoor to play an effect
			cScript_SetGlobalArgFloat(0, fSpeedAdd);
			cScript_RunGlobalFunc(cLux_ID_Prop(mPropID).GetName(), "cScrPropTear", "_Global_OnAddSpeed");
			
			return fSpeedAdd;
		}
		
		///////////////////////
		// Slide joint
		else
		{
			cVector3f vMouseCamDir = vUp * -mvMoveAdd.y + vRight * mvMoveAdd.x;
			return cMath_Vector3Dot(vMouseCamDir, apJoint.GetPinDir());
		}
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
