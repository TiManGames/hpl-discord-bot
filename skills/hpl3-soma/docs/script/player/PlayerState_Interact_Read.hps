	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// MEMBER VARIABLES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tID mOpenPropID;
	
	bool mbEnteringState;
	bool mbLeavingState;
	bool mbTextActivated;
	
	int mlDepthOfFieldID = -1;
	
	cUtility_Readable mReadable;
	
	//////////////////////////////////////
	// Prop movement
	cMatrixf m_mtxOriginOrientation;
	float mfDistanceFromCamera;
	float mfYStartOffset;
	float mfStateTimer;
	cVector3f mvStartMovePos;
	cVector3f mvCamRelativeStart;
	
	//////////////////////////////////////
	// Sounds
	tString msCloseSound;
		
	//////////////////////////////////////
	// Rotation
	float mfRotX = 0.0f;
	float mfRotInputX = 0.0f;
	float mfRotY = 0.0f;
	float mfRotInputY = 0.0f;
	float mfSaveHeadBob = 1.0f;
	
	//////////////////////////////////////
	// Camera control
	cMatrixf m_mtxCameraCenteredRotation;
	
	//////////////////////////////////////
	// Callbacks
	tString msCloseCallback;
	
	//------------------------------------------------------------
		
}