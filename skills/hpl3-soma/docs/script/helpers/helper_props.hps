//-------------------------------------------------

/////////////////////////////////////////
// SWING DOOR
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Pushes a door open using one or many impulses
 * 
 * @param asName name of the door.
 * @param afImpulseAmount Amount of impulse that will be applied to the door.
 * @param alNumOfTimes Number of times the impulse will be applied.
 * @param afTimeBetweenPushes Pause interval between two impulses.
 **/
void SwingDoor_PushOpen(const tString& in asName, float afImpulseAmount, int alNumOfTimes=1, 
						float afTimeBetweenPushes=0.1)
{
	SwingDoor_SetDisableAutoClose(asName, true);
	SwingDoor_SetClosed(asName, false, true);
	
	if(alNumOfTimes>2)
	{
		cLux_GetCurrentMap().AddTimer(asName+"_HelperPushOpenImpulse", afTimeBetweenPushes, "$_Timer_HelperPushOpen_Impulse");
		cLux_GetCurrentMap().SetTimerUserVarString(asName+"_HelperPushOpenImpulse", asName);
		cLux_GetCurrentMap().SetTimerUserVarInt(asName+"_HelperPushOpenImpulse", alNumOfTimes-1);
		cLux_GetCurrentMap().SetTimerUserVarFloat(asName+"_HelperPushOpenImpulse", afImpulseAmount);
	}
	else
	{
		cLux_GetCurrentMap().AddTimer(asName+"_HelperPushOpenAutoClose", 1.0f, "$_Timer_HelperPushOpen_AutoClose");
		cLux_GetCurrentMap().SetTimerUserVarString(asName+"_HelperPushOpenAutoClose", asName);
	}
	
	SwingDoor_AddDoorBodyImpulse(asName, afImpulseAmount);
}

void _Timer_HelperPushOpen_Impulse(const tString&in asTimer)
{
	tString sName = cLux_GetCurrentMap().GetTimerUserVarString(asTimer);
	float fAmount = cLux_GetCurrentMap().GetTimerUserVarFloat(asTimer);
	int lCount  = cLux_GetCurrentMap().IncTimerUserVarInt(asTimer, -1);
	
	
	SwingDoor_AddDoorBodyImpulse(sName, fAmount);
	
	if(lCount>0)
		cLux_GetCurrentMap().RestartCurrentTimer();
	else
	{
		cLux_GetCurrentMap().AddTimer(sName+"_HelperPushOpenAutoClose", 1.0f, "$_Timer_HelperPushOpen_AutoClose");
		cLux_GetCurrentMap().SetTimerUserVarString(sName+"_HelperPushOpenAutoClose", sName);
	}
}

void _Timer_HelperPushOpen_AutoClose(const tString&in asTimer)
{
	tString sName = cLux_GetCurrentMap().GetTimerUserVarString(asTimer);
	
	SwingDoor_SetDisableAutoClose(sName, false);
}

//-------------------------------------------------

/////////////////////////////////////////
// GRAB
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Returns the currently grabbed prop, or null if there isn't one.
 * 
 * @return a pointer to the currently grabbed prop
 **/
cLuxProp@ Grab_GetGrabbedProp()
{
	if(cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Grab)
		return null;
		
	cScript_RunGlobalFunc("State_Interact_Grab", "", "_Global_GetPropID");
	tID idProp = cScript_GetGlobalReturnID();
	if (idProp == tID_Invalid)
		return null;
	return cLux_ID_Prop(idProp);
}

//-------------------------------------------------

/////////////////////////////////////////
// ENTITY
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets the interaction icon for an entity. Currently only works for MoveBody, 
 * MoveableButton, Lever, Rigid and Triggers.
 * 
 * @param asName name of the entity.
 * @param aIcon The interaction icon.
 **/
void Entity_SetCustomInteractIcon(const tString &in asName, eCrossHairState aIcon)
{
	cScript_SetGlobalArgInt(0, aIcon);
	if(cScript_RunGlobalFunc(asName, "", "_Global_SetCustomInteractIcon")==false)
	{
		Error("Could not find entity with name '"+asName+"' for Prop_SetCustomInteractIcon");
	}
}

