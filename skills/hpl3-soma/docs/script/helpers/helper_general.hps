

/////////////////////////////////////////
// STRING
/////////////////////////////////////////

//-------------------------------------------------

tString String_SecondsToClockDisplay(float afSeconds, bool abShowHours, bool abShowMinutes, bool abShowSeconds, bool abShowHundredths)
{
	float fTime = afSeconds;
	int lHours = int(fTime/3600.f);
	fTime -= lHours*3600;
	int lMinutes = int(fTime/60.f);
	fTime -= lMinutes*60;
	int lSeconds = int(fTime);
	fTime -= lSeconds;
	int lHundredths = int(fTime*100.f);
	
	array<int> vUnits;
	if (abShowHours) vUnits.push_back(lHours);
	if (abShowMinutes) vUnits.push_back(lMinutes);
	if (abShowSeconds) vUnits.push_back(lSeconds);
	if (abShowHundredths) vUnits.push_back(lHundredths);
	
	tString sReturn;
	for(uint i = 0; i < vUnits.length(); i++)
	{
		if (i != 0) sReturn+= ":";
		if (vUnits[i] < 10) sReturn+= "0";
		sReturn += vUnits[i];
	}
	return sReturn;
}
