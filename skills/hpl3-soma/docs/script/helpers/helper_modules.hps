//-----------------------------------------------------

/**
 * Sets the extended view multiplier
 * @param afMul, 1.0f default, extended view will move more if >1.0f and less if <1.0f
  **/
void EyeTracking_SetExtendedViewMul(float afMul)
{
	iScrEyeTrackingHandler_Interface@ pEyeTrackingHandler = cast<iScrEyeTrackingHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_EyeTrackingHandler));
	pEyeTrackingHandler.SetExtendedViewMul(afMul);
}

