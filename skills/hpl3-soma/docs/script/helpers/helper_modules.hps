//-------------------------------------------------------

/**
 * Puts the player instantly to sleep (or awake)
 * 
 * @param abAsleep if true then the player is asleep, if false then awake
 **/
void Wake_SetAsleep(bool abAsleep)
{
	cScript_SetGlobalArgBool(0, abAsleep);
	cScript_RunGlobalFunc("WakeHandler", "", "_Global_SetAsleep");
}

//-------------------------------------------------------

/**
 * Wakes up the player.
 *
 * @param afTime time to take to wake up.
 **/
void Wake_StartWakeup(float afTime)
{
	cScript_SetGlobalArgFloat(0, afTime);
	cScript_RunGlobalFunc("WakeHandler", "", "_Global_StartWakeup");
}

