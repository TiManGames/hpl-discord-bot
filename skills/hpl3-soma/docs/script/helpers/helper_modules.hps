/////////////////////////////////////////
// ATTACK METER HANDLER
/////////////////////////////////////////

//-------------------------------------------------------

/**
 * Adds an entity as something that is about to damage the player.
 * 
 * @param a_idEntity ID for the entity
 * @param afStartDistance How close entity needs to be before the attack meter starts.
 * @param afEndDistance How close the entity needs to be for the player to take damange
 * @param afDamage How much damage will the attack take?
 * @param abFatal If true then this death is instantly fatal rather than allowing you to die 3 times.
 * @param abFastNonLookKill If true, the entity will damage quickly even if the player isn't looking at it.
 * @param abInstantKnockOut if true, the player will be knocked out on the first attack
 **/
void AttackMeter_AddInstance(tID a_idEntity, float afStartDistance, float afEndDistance, float afDamage, bool abFatal = false, bool abFastNonLookKill = false, bool abInstantKnockOut=false)
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.AddInstance(a_idEntity, afStartDistance, afEndDistance,afDamage, abFatal, abFastNonLookKill,abInstantKnockOut);
}


//-------------------------------------------------------

/**
 * Removes an entity as something that is about to damage the player.
 * 
 * @param a_idEntity ID for the entity
 **/
void AttackMeter_RemoveInstance(tID a_idEntity)
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.RemoveInstance(a_idEntity);
}

//-------------------------------------------------------


/**
 * This starts a timer that will damage the player when it is over.
 * 
 * @param afTime ID for the entity
 * @param afDamage Amount of damage dealt to the player
 * @param abFatal If true, the damage can kill the player
 **/
void AttackMeter_AutoDamage(float afTime, float afDamage, bool abFatal)
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.AutoDamage(afTime, afDamage, abFatal);
}

//-------------------------------------------------------

/**
 * Checks if any effects are active
 **/
bool AttackMeter_IsActive()
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	return pDMHandler.IsActive();
}

//-------------------------------------------------------

/**
 * Manually set that the player is in recovery mode as if he has just been attacked. 
 * While true, most Agents refrain from attacking and player cannot get knocked down.
 **/
void AttackMeter_SetPlayerIsRecovering(bool abX)
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.SetPlayerIsRecovering(abX);
}

//-------------------------------------------------------

/**
 * Check if the attack meter has just damaged the player and the player currently have the effects caused by that.
 **/
bool AttackMeter_GetPlayerIsRecovering()
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	return pDMHandler.GetPlayerIsRecovering();
}


//-------------------------------------------------------

/**
 * This lets you do your own damage event. Nothing is done in the AttackHandler when damage is to occurs except calling this.
 * 
 * @param asCallback The callback function to be used. Syntax: void f(const tString &in asSource)
 **/
void AttackMeter_SetCustomDamageCallback(const tString& in asCallback)
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.SetCustomDamageCallback(asCallback);
}

//-------------------------------------------------------

/**
 * This sets a callback that is called after taken daming. 
 * 
 * @param asCallback The callback function to be used. Syntax: void f(const tString& in asSource)
 **/
void AttackMeter_SetAfterDamageCallback(const tString& in asCallback)
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.SetAfterDamageCallback(asCallback);
}

//-------------------------------------------------------
/**
 * If the player blacks out when damaged the agent that hurt him will be telported to one of these postions.
 * @param asPosition To randomize between many, use wildcards in the name.
 **/ 
void AttackMeter_SetAttackerTeleportPosition(const tString& in asPosition)
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.SetAttackerTeleportPosition(asPosition);
}

//-------------------------------------------------------

/**
 * Gets the base name (with wildcards) that was set with AttackMeter_SetAttackerTeleportPosition
 **/ 
tString AttackMeter_GetAttackerTeleportPosition()
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	return pDMHandler.GetAttackerTeleportPosition();
}

//-------------------------------------------------------

/**
 * Only to be called in _Global_PlayerAfterDamageCallback of an Agent or in an AfterDamageCallback.
 * It breaks the sequence to continue. 
 * The following things will be changed WorldAll volume to 0, player move & look speed, effect fade out, and PlayerIsRecovering is true.
 **/
void AttackMeter_BreakAttackDamageSequence()
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.BreakAttackDamageSequence();
}

//-------------------------------------------------------

/**
 * Only to be called after _Global_PlayerAfterDamageCallback of an Agent or in an AfterDamageCallback if AttackMeter_BreakAttackDamageSequence has been called.
 * This simple continue this 
 **/
void AttackMeter_ContinueAttackDamageSequence()
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	pDMHandler.ContinueAttackDamageSequence();
}

//-------------------------------------------------------

/**
 * Time since player was last knocked down.
 **/
float AttackMeter_GetTimeSinceLastKnockDown()
{
	iScrAttackMeterHandler_Interface @pDMHandler = cast<iScrAttackMeterHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DeathMeterHandler) );
	return pDMHandler.GetTimeSinceLastKnockDown();
}


