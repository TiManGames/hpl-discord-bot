	iScrEyeTrackingHandler_Interface@ pEyeTrackingHandler = cast<iScrEyeTrackingHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_EyeTrackingHandler));
	return pEyeTrackingHandler.GetExtendedViewRotation();
}

