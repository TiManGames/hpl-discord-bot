//-------------------------------------------------

shared enum eLuxFontType
{
	eLuxFontType_Default_Small,
	eLuxFontType_Default_Medium_Outline,

	eLuxFontType_Sansation_Medium,
	eLuxFontType_Sansation_Medium_Bold,

	eLuxFontType_Sansation_Large,
	eLuxFontType_Sansation_Large_Bold,
	eLuxFontType_Sansation_Large_Additive,

	eLuxFontType_Sansation_XLarge,
	eLuxFontType_Sansation_XLarge_Bold,

	eLuxFontType_Vera,

	eLuxFontType_Sansation_Last_Enum,
}

//-------------------------------------------------

tString Helper_Font_GetFontName(eLuxFontType aType)
{
	tString sLang = cLux_GetCurrentLanguage();
	
	if(sLang == "simplified_chinese" || sLang == "simplified_chinese.lang")
	{
		switch(aType)
		{
		case eLuxFontType_Vera:
		case eLuxFontType_Default_Small:
		case eLuxFontType_Default_Medium_Outline:
		// todo: use noto sans here and perhaps ZCOOL for the other stuff?
		case eLuxFontType_Sansation_Medium:
		case eLuxFontType_Sansation_Medium_Bold:
		case eLuxFontType_Sansation_Large:
		case eLuxFontType_Sansation_Large_Bold:
		case eLuxFontType_Sansation_XLarge:
		case eLuxFontType_Sansation_XLarge_Bold:
		case eLuxFontType_Sansation_Large_Additive:
			return "noto_sans_sc_additive_72.fnt";
		}
	}
	else
	{
		switch(aType)
		{
		case eLuxFontType_Default_Small:				return "default_small.fnt";
		case eLuxFontType_Default_Medium_Outline:		return "default_medium_outline.fnt";
		case eLuxFontType_Sansation_Medium:				return "sansation_medium.fnt";
		case eLuxFontType_Sansation_Medium_Bold:		return "sansation_medium_bold.fnt";
		case eLuxFontType_Sansation_Large:				return "sansation_large.fnt";
		case eLuxFontType_Sansation_Large_Bold:			return "sansation_large_bold.fnt";
		case eLuxFontType_Sansation_Large_Additive:		return "sansation_large_additive.fnt";
		case eLuxFontType_Sansation_XLarge:				return "sansation_xlarge.fnt";
		case eLuxFontType_Sansation_XLarge_Bold:		return "sansation_xlarge_bold.fnt";
		case eLuxFontType_Vera:							return "vera.fnt";
		}
	}
	return "";
}

