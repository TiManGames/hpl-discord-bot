//-------------------------------------------------

/**
 * Sets the direction used by a character
 * 
 * @param asEntityName name of the entity with the CharMover.
 * @param aDir direction that the character will face when walking
 **/
void CharMover_SetDirection(const tString&in asEntityName, eLuxCharMoveDirection aDir)
{
	cLuxCharMover @pCharMover = cast<cLuxCharMover@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_CharMover, asEntityName));
	if(pCharMover is null)
	{
		Error("Could not find char mover in entity '"+asEntityName+"' for CharMover_SetDirection");
		return;
	}
	
	pCharMover.SetDirection(aDir);
}

//-------------------------------------------------

/**
 * Turns the character to a specifc entity. Broadcasts the entity message eLuxEntityMessage_TurningDone when done.
 * 
 * @param asEntityName name of the entity with the CharMover.
 * @param asTurnToEntityName the entity which center will be turn towards
 * @param asTurnedToGoalCallbackFunc function called when it has turned to the goal. Syntax: void Func(const tString& in asEntityName)
 **/
void CharMover_TurnToEntity(const tString&in asEntityName, const tString&in asTurnToEntityName, const tString&in asTurnedToGoalCallbackFunc="")
{
	cLuxCharMover @pCharMover = cast<cLuxCharMover@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_CharMover, asEntityName));
	if(pCharMover is null)
	{
		Error("Could not find char mover in entity '"+asEntityName+"' for CharMover_TurnToEntity");
		return;
	}
	
	iLuxEntity @pTurnToEntity = cLux_GetCurrentMap().GetEntityByName(asTurnToEntityName, eLuxEntityType_LastEnum, "");
	if(pTurnToEntity is null)
	{
		Error("Could not find turn to entity '"+asTurnToEntityName+"' for CharMover_TurnToEntity");
		return;
	}
	
	pCharMover.TurnToPos(pTurnToEntity.GetPosition());
	pCharMover.SetTurnedToGoalCallbackFunc(asTurnedToGoalCallbackFunc);
}

//-------------------------------------------------


/**
 * Turns the character directly to a specifc entity. Broadcasts the entity message eLuxEntityMessage_TurningDone when done.
 * 
 * @param asEntityName name of the entity with the CharMover.
 * @param asTurnToEntityName the entity which center will be turn towards
 **/
void CharMover_TurnInstantlyToEntity(const tString&in asEntityName, const tString&in asTurnToEntityName)
{
	cLuxCharMover @pCharMover = cast<cLuxCharMover@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_CharMover, asEntityName));
	if(pCharMover is null)
	{
		Error("Could not find char mover in entity '"+asEntityName+"' for CharMover_TurnToEntity");
		return;
	}
	
	iLuxEntity @pTurnToEntity = cLux_GetCurrentMap().GetEntityByName(asTurnToEntityName, eLuxEntityType_LastEnum, "");
	if(pTurnToEntity is null)
	{
		Error("Could not find turn to entity '"+asTurnToEntityName+"' for CharMover_TurnToEntity");
		return;
	}
	
	pCharMover.TurnInstantlyToPos(pTurnToEntity.GetPosition());
}

//-------------------------------------------------

/**
 * Moves the character to a entity. Note that for non-flying characters, goal position should be the feet postion.
 * 
 * @param asEntityName name of the entity with the CharMover.
 * @param asMoveToEntityName the entity which center will be turn towards
 * @param avOffset an offset for the move postion.
 **/
void CharMover_MoveToEntity(const tString&in asEntityName, const tString&in asMoveToEntityName,
							const cVector3f& in avOffset=cVector3f(0))
{
	cLuxCharMover @pCharMover = cast<cLuxCharMover@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_CharMover, asEntityName));
	if(pCharMover is null)
	{
		Error("Could not find char mover in entity '"+asEntityName+"' for CharMover_TurnToEntity");
		return;
	}
	
	iLuxEntity @pMoveToEntity = cLux_GetCurrentMap().GetEntityByName(asMoveToEntityName, eLuxEntityType_LastEnum, "");
	if(pMoveToEntity is null)
	{
		Error("Could not find turn to entity '"+asMoveToEntityName+"' for CharMover_MoveToEntity");
		return;
	}
	
	pCharMover.MoveToPos(pMoveToEntity.GetPosition()+avOffset);
}

//-------------------------------------------------

/**
 * Moves the character to a position. Note that for non-flying characters, goal position should be the feet postion.
 * 
 * @param asEntityName name of the entity with the CharMover.
 * @param avPosition position to move to
 **/
void CharMover_MoveToPos(const tString&in asEntityName, const cVector3f& in avPosition)
