/////////////////////////////////////////
// HEAD TRACKER
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Turns on and off head tracking.
 * 
 * @param asEntityName name of the entity with the HeadTracker.
 * @param abX if headtracking is enabled or not
 **/
void HeadTracker_SetActive(const tString&in asEntityName, bool abX)
{
	cLuxHeadTracker @pHeadTracker = cast<cLuxHeadTracker@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_HeadTracker, asEntityName));
	if(pHeadTracker is null)
	{
		Error("Could not find head tracker component in entity '"+asEntityName+"' for HeadTracker_SetActive");
		return;
	}
	
	pHeadTracker.SetActive(abX);
}

//-------------------------------------------------

/**
 * If head tracking is active or not
 * 
 * @param asEntityName name of the entity with the HeadTracker.
 **/
bool HeadTracker_IsActive(const tString&in asEntityName)
{
	cLuxHeadTracker @pHeadTracker = cast<cLuxHeadTracker@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_HeadTracker, asEntityName));
	if(pHeadTracker is null)
	{
		Error("Could not find head tracker component in entity '"+asEntityName+"' for HeadTracker_IsActive");
		return false;
	}
	
	return pHeadTracker.IsActive();
}

//-------------------------------------------------

/**
 * Sets the offset of the headtracker angle useful if the character is not facing in the direction of the meshentity forward vector.
 * 
 * @param asEntityName name of the entity with the HeadTracker.
 * @param afX The angle offset, in degrees
 **/
void HeadTracker_SetAngleOffset(const tString&in asEntityName, float afX)
{
	cLuxHeadTracker @pHeadTracker = cast<cLuxHeadTracker@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_HeadTracker, asEntityName));
	if(pHeadTracker is null)
	{
		Error("Could not find head tracker component in entity '"+asEntityName+"' for HeadTracker_SetAngleOffset");
		return;
	}
	
	pHeadTracker.SetAngleOffset(cMath_ToRad(afX));
}

//-------------------------------------------------

/**
 * Sets the target of the head tracking
 * 
 * @param asEntityName name of the entity with the HeadTracker.
 * @param asTargetEntityName The target of the tracking
 **/
void HeadTracker_SetTargetEntity(const tString&in asEntityName, const tString&in asTargetEntityName)
{
	cLuxHeadTracker @pHeadTracker = cast<cLuxHeadTracker@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_HeadTracker, asEntityName));
	if(pHeadTracker is null)
	{
		Error("Could not find head tracker component in entity '"+asEntityName+"' for HeadTracker_SetTargetEntity");
		return;
	}
	
	iLuxEntity @pTargetEntity = cLux_GetCurrentMap().GetEntityByName(asTargetEntityName, eLuxEntityType_LastEnum, "");
	if(pTargetEntity is null)
	{
		Error("Could not find head tracker target entity '"+asTargetEntityName+"' for HeadTracker_SetTargetEntity");
		return;
	}
	
	pHeadTracker.SetTrackEntity(pTargetEntity);
}

