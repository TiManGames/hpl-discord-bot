//-------------------------------------------------

/////////////////////////////////////////
// AGENT BASIC
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Set if the agent will collide with the environment (objects and stuff will still collide with it!)
 * 
 * @param asAgentName name of the agent. Wildcard supported.
 * @param abX If the character should be static and NOT move about.
 **/
void Agent_SetStaticCollider(const tString &in asAgentName, bool abX)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_SetStaticCollider");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		cLux_ToAgent(vEntities[i]).SetStaticCollider(abX);
	}
}

//-------------------------------------------------

/**
 * Set if the agent should have its senses (hearing/vision/etc) enabled. Usually implemented on a specific basis.
 * 
 * @param asAgentName name of the agent. Wildcard supported.
 * @param abX If the senses should be active.
 **/
void Agent_SetSensesActive(const tString &in asAgentName, bool abX)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_SetSensesActive");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		cLux_ToAgent(vEntities[i]).SetSensesActive(abX);
	}
}

//-------------------------------------------------

/**
 * Reveals the player's current position to the agent.
 * 
 * @param asAgentName name of the agent. Wildcard supported.
 * @param bForceRedetect true = forces the agent to detect the player again.
 **/
void Agent_RevealPlayerPosition(const tString &in asAgentName, bool bForceRedetect=false)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_RevealPlayerPosition");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		if (bForceRedetect)
			cLux_ToAgent(vEntities[i]).ResetPlayerDetectionState();
		cLux_ToAgent(vEntities[i]).RevealPlayerPos();
	}
}

//-------------------------------------------------

/**
 * Sets the view range multiplier of the specified agent
 * 
 * @param asAgentName name of the agent. Wildcard supported.
 * @param afRangeMul the range multiplier to set.
 **/
void Agent_SetViewRangeMul(const tString &in asAgentName, float afRangeMul)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_SetSensesActive");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		cLux_ToAgent(vEntities[i]).SetSightRangeMul(afRangeMul);
	}
}

//-------------------------------------------------

/**
 * Instantly sets the yaw of the agent to make it look at the specified entity.
 * 
 * @param asAgentName name of the agent. Wildcard supported.
 * @param asLookAtTarget name of entity to look at.
 **/
void Agent_FaceEntity(const tString &in asAgentName, const tString &in asLookAtTarget)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_SetSensesActive");
		return;
	}
	
	iLuxEntity@ pLookAtEntity = cLux_GetCurrentMap().GetEntityByName(asLookAtTarget);
	if (pLookAtEntity is null)
	{
		Error("Couldn't find entity '" + asLookAtTarget+"' for '" + asAgentName+"' to be rotated towards in Agent_SetForwardDirection");
		return;
	}
	cVector3f vLookAtTargetPos = pLookAtEntity.GetPosition();
	
	for (uint i = 0; i < vEntities.length(); i++)
	{
		cLuxAgent@ pAgent = cLux_ToAgent(vEntities[i]);
		
		cVector3f vForward = vLookAtTargetPos - pAgent.GetPosition();
		float fYaw = cMath_GetAngleFromPoints3D(cVector3f_Zero, vForward).y;
		pAgent.GetCharBody().SetYaw(fYaw);
	}
	
}

//-------------------------------------------------

/**
 * Teleport the agent's foot position to a specific other entity.
 * 
 * @param asAgentName name of the entity to teleport.
 * @param asTargetName name of the entity to teleport to.
 **/
void Agent_TeleportFeetToEntity(const tString &in asAgentName, const tString &in asTargetName)
{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asAgentName, eLuxEntityType_Agent);
	cLuxAgent@ pAgent = cLux_ToAgent(pEntity);
	if(pAgent is null) 
	{
		Error("Could not find agent " + asAgentName + " for Agent_TeleportFeetToEntity");
	}
	
	iLuxEntity@ pTarget = cLux_GetCurrentMap().GetEntityByName(asTargetName);
	if(pTarget is null) 
	{
		Error("Could not find target entity " + asTargetName + " for Agent_TeleportFeetToEntity");
	}
	
	pAgent.GetCharBody().SetFeetPosition(pTarget.GetPosition(), false);
}

//-------------------------------------------------

/**
 * When active, the agent will be a disabled (SetActive(false)) when a certain distance away from the player and no longer seen.
 * 
 * @param asAgentName name of the agent.Wildcard supported.
 * @param abActive if the disabling is active
 * @param afMinDistance The minimum distance from the player for this to happen.
 **/
void Agent_SetAutoDisableWhenOutOfSightActive(const tString &in asAgentName, bool abActive, float afMinDistance)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_SetAutoDisableWhenOutOfSightActive");
		return;
	}
	
	for(int i=0; i<vEntities.size(); ++i)
	{
		cLuxAgent@ pAgent = cLux_ToAgent(vEntities[i]);
		pAgent.SetAutoDisableWhenOutOfSightActive(abActive,afMinDistance);	
	}
}

//-------------------------------------------------

/**
 * Sets the function that is called when the disabling made by Agent_SetAutoDisableWhenOutOfSightActive happens
 * 
 * @param asAgentName name of the agent.Wildcard supported.
 * @param asCallbackFunc Function called when the disabling happens. syntax: void f(const tString&in asEntityName)
 **/
void Agent_SetAutoDisableCallback(const tString &in asAgentName, const tString &in asCallbackFunc)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_SetAutoDisableCallback");
		return;
	}
	
	for(int i=0; i<vEntities.size(); ++i)
	{
		cLuxAgent@ pAgent = cLux_ToAgent(vEntities[i]);
		pAgent.SetAutoDisableCallback(asCallbackFunc);	
	}
		
}

//-------------------------------------------------


/**
 * Checks if the agent has dected the player
 * 
 * @param asAgentName name of the agent.
 **/
bool Agent_PlayerDetected(const tString &in asAgentName)
{
	cLuxAgent@ pAgent = cLux_ToAgent(cLux_GetCurrentMap().GetEntityByName(asAgentName,eLuxEntityType_Agent,""));
	if(pAgent is null)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_PlayerDetected");
		return false;
	}
	
	return pAgent.PlayerIsDetected();	
}


