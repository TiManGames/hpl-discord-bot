	cLuxCharMover @pCharMover = cast<cLuxCharMover@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_CharMover, asEntityName));
	if(pCharMover is null)
	{
		Error("Could not find char mover in entity '"+asEntityName+"' for CharMover_TurnToEntity");
		return;
	}
	
	pCharMover.MoveToPos(avPosition);
}

