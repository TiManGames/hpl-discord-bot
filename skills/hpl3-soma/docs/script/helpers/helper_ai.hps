/////////////////////////////////////////
// CRITTER
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets the entity the critter should flock around
 * 
 * @param asCritter name of the Critter. Wildcard supported.
 * @param asGroupEntity The name of the group entity.
 **/
void Critter_SetGroupEntity(const tString &in asCritter, const tString &in asGroupEntity)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asCritter, eLuxEntityType_Critter, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find critter '" + asCritter+"' for Critter_SetGroupEntity");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		cLux_ToCritter(vEntities[i]).SetGroup(asGroupEntity);
	}
}

//-------------------------------------------------

/**
 * Adds an entity that the critter should try to avoid the same way it does with the player.
 * (Only implemented in FishSmall right now)
 * 
 * @param asCritter name of the Critter. Wildcard supported.
 * @param asEscapeEntity The name of the entity to escape from
 **/
void Critter_AddExtraEscapeEntity(const tString &in asCritter, const tString &in asEscapeEntity)
{
	tID idEscapeID = cLux_GetCurrentMap().GetEntityIDByName(asEscapeEntity, eLuxEntityType_LastEnum, "");
	if (idEscapeID == tID_Invalid)
	{
		Error("Could not find escape entity with name '"+asEscapeEntity+"' for Critter_AddExtraEscapeEntity");
		return;
	}
	
	cScript_SetGlobalArgID(0, idEscapeID);
	if(cScript_RunGlobalFunc(asCritter, "", "_Global_AddExtraEscapeEntity")==false)
	{
		Error("Could not find critter with name '"+asCritter+"' for Critter_AddExtraEscapeEntity");
	}
}

