	//------------------------------------------------------------
	
	tString msCategory;
	tString msFront;
	tString msBack;
	tString msTitle;
	eTextSide mState;
	eTextSide mAvailable;
	
	tString msGuiFunction;
	
	tString msAdditionalHintEntry;
	tString msHintEntry = "ReadableTextHint";
	
	float mfMaxHintIconHeight;
	
	cLuxScreenTextFormatParameters mFormatParams;
	
	array<tWString>						mvCurrentHintLines;
	[nosave] array<cLuxScreenTextIcon@>	mvCurrentHintIcons;
	[nosave] array<array<int>> 			mvCurrentHintIconsPerLine;
	
	array<tWString>						mvCurrentAdditionalHintLines;
	[nosave] array<cLuxScreenTextIcon@>	mvCurrentAdditionalHintIcons;
	[nosave] array<array<int>>			mvCurrentAdditionalHintIconsPerLine;
	
	/////////////////////////////
	// Fading
	float mfTextAlpha;
	float mfTextFadeTimer;
	int mlTextFade;
	
	//////////////////////////////////////
	// Scrolling
	int mlPageNum = 0;
	int mlPage = 0;
	float mfScrollOffset = 0;
	
	/////////////////////////////////////
	// Display
	float mfCalculatedHeight = 0.0f;
	
	////////////////////////////////////
	// Hint Fading
	float mfHintFadeTimer=0.0f;
	float mfAdditionalHintFadeTimer=0.0f;
}

