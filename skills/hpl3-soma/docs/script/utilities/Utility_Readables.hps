// Set to false to allow zoom areas and readables to work
// without holding interact
const bool gbReadablesHoldInteract = false;

const float gfReadableFontSize = 23;
const float gfReadableTitleSize = 30;
const float gfReadableHintSize = 23;

const float gReadableBorderSize = 0.05f;

const float gfReadableScrollingInputTick = 0.1f;

const float gfReadableFadeTime = 0.5f;
const float gfHintFadeTime = 0.5;

//------------------------------------------------------------

enum eTextSide
{
	eTextSide_None,
	eTextSide_Front,
	eTextSide_Back
}

//------------------------------------------------------------

class cUtility_Readable
{
	//------------------------------------------------------------
	
	void Reset()
	{
		mState = eTextSide_None;
		mfTextAlpha = 0;
		mfTextFadeTimer=0.0f;
		mlTextFade=0;
		mfCalculatedHeight = 0.0f;
	}
	
	//------------------------------------------------------------
	
	void SetupReading(const tString& in asCategory, const tString& in asFront, const tString& in asBack, const tString& in asTitle = "")
	{
		Reset();

		msCategory = asCategory;
		msFront = asFront;
		msBack = asBack;
		msTitle = asTitle;		
		mAvailable = eTextSide_None;
		mfHintFadeTimer = 0.0f;
		mfAdditionalHintFadeTimer = 0.0f;
		
		if(msAdditionalHintEntry.length()>0)
			Hint_ShowHint("Hints", msAdditionalHintEntry, true);
		
		//ReparseHints();
	}
	
	//------------------------------------------------------------
	
	void SetGuiFunction(const tString& in asFunction)
	{
		msGuiFunction = asFunction;
	}
	
	//------------------------------------------------------------
	
	void SetMainHint(const tString& in asHintEntry)
	{
		msHintEntry = asHintEntry;
	}
	
	//------------------------------------------------------------
	
	void SetAdditionalHint(const tString& in asHintEntry)
	{
		msAdditionalHintEntry = asHintEntry;
	}
	
