#include "interface/RichPresenceHandler_Interface.hps"
#include "base/RichPresenceHandler_Types.hps"

class cScrRichPresenceHandler : iScrRichPresenceHandlerBase, iScrRichPresenceHandler_Interface
{
    //------------------------------------------------------------
    
    /////////////////////////////////////////
    // CREATE RICHPRESENCE
    /////////////////////////////////////////
    
    //------------------------------------------------------------
    
    void CreateRichPresences()
    {
        /////////////
        // Create the RichPresence
        CreateRichPresence(eRichPresence_Menu                  , "Menu"                  );
        CreateRichPresence(eRichPresence_Prologue              , "Prologue"              );
        CreateRichPresence(eRichPresence_SimonsApartment       , "SimonsApartment"       );
        CreateRichPresence(eRichPresence_Subway                , "Subway"                );
        CreateRichPresence(eRichPresence_MunshisLab            , "MunshisLab"            );
        CreateRichPresence(eRichPresence_Awakening             , "Awakening"             );
        CreateRichPresence(eRichPresence_SiteUpsilon           , "SiteUpsilon"           );
        CreateRichPresence(eRichPresence_OutsideUpsilon        , "OutsideUpsilon"        );
        CreateRichPresence(eRichPresence_UpsilonShuttleStation , "UpsilonShuttleStation" );
        CreateRichPresence(eRichPresence_SiteLambda            , "SiteLambda"            );
        CreateRichPresence(eRichPresence_TheCURIE              , "TheCURIE"              );
        CreateRichPresence(eRichPresence_SiteDelta             , "SiteDelta"             );
        CreateRichPresence(eRichPresence_OutsideTheta          , "OutsideTheta"          );
        CreateRichPresence(eRichPresence_ThetaEntrance         , "ThetaEntrance"         );
        CreateRichPresence(eRichPresence_ThetaLabs             , "ThetaLabs"             );
        CreateRichPresence(eRichPresence_ThetaMaintenance      , "ThetaMaintenance"      );
        CreateRichPresence(eRichPresence_OutsideOmicron        , "OutsideOmicron"        );
        CreateRichPresence(eRichPresence_SiteOmicron           , "SiteOmicron"           );
        CreateRichPresence(eRichPresence_TheDescent            , "TheDescent"            );
        CreateRichPresence(eRichPresence_PathtoTau             , "PathtoTau"             );
        CreateRichPresence(eRichPresence_SiteTau               , "SiteTau"               );
        CreateRichPresence(eRichPresence_SiteAlpha             , "SiteAlpha"             );
        CreateRichPresence(eRichPresence_SitePhi               , "SitePhi"               );
        CreateRichPresence(eRichPresence_TheARK                , "TheARK"                );
        CreateRichPresence(eRichPresence_Space                 , "Space"                 );
        CreateRichPresence(eRichPresence_Credits               , "Credits"               );

        /////////////
        // Register all RichPresence on Steam/PS4
        RegisterRichPresences();
    }
    
    //------------------------------------------------------------
}    


























