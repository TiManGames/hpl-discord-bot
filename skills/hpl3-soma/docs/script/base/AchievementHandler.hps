#include "interfaces/AchievementHandler_Interface.hps"
#include "base/AchievementHandler_Types.hps"

class cScrAchievementHandler : iScrAchievementHandlerBase, iScrAchievementHandler_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CREATE ACHIEVEMENTS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CreateAchievements()
	{
		/////////////
		// Create the achievements
		CreateAchievement(eAchievement_CathCall, "CathCall");
		CreateAchievement(eAchievement_ChasedCath, "ChasedCath");
		CreateAchievement(eAchievement_Stranded, "Stranded");
		CreateAchievement(eAchievement_Dunbat, "Dunbat");
		CreateAchievement(eAchievement_PlanB, "PlanB");
		CreateAchievement(eAchievement_Dream, "Dream");
		CreateAchievement(eAchievement_NewYou, "NewYou");
		CreateAchievement(eAchievement_LastHuman, "LastHuman");
		CreateAchievement(eAchievement_Expressway, "Expressway");
		CreateAchievement(eAchievement_TheEnd, "TheEnd");

		/////////////
		// Register all achievements on Steam/PS4
		RegisterAchievements();
	}
	
	//------------------------------------------------------------
}	