#include "interfaces/HeroStatsHandler_Interface.hps"
#include "base/HeroStatsHandler_Types.hps"

class cScrHeroStatsHandler : iScrHeroStatsHandlerBase, iScrHeroStatsHandler_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CREATE HEROSTATS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CreateHeroStats()
	{
		/////////////
		// Create the HeroStats
		CreateHeroStat(eHeroStats_UsedWauDevices           , "UsedWauDevices"           );
		CreateHeroStat(eHeroStats_RetrievedVoiceFiles      , "RetrievedVoiceFiles"      );
		CreateHeroStat(eHeroStats_ReadDocuments            , "ReadDocuments"            );

		/////////////
		// Register all HeroStats on XBoxOne
		RegisterHeroStats();
	}
	
	//------------------------------------------------------------
}	