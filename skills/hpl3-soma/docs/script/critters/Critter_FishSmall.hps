#include "interfaces/Critter_Interface.hps"

class cScrCritterFishSmall : iScrCritter, iScrCritter_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		/////////////////////////////////////////
		// Backbone Tail
		@mpBackboneTail = cLux_CreateEntityComponent_BackboneTail(mBaseObj);
		mpBackboneTail.LoadFromVariables(apVars);
		
		/////////////////////////////////////////
		// Varialbes
		mfNormalSpeed = apVars.GetVarFloat("NormalSpeed",2);
		mfEscapeSpeed = apVars.GetVarFloat("EscapeSpeed",8);
		mfEscapeDistance = apVars.GetVarFloat("EscapeDistance",4);
		mfWanderMul = apVars.GetVarFloat("WanderMul",1);
		mfFlockSeparation = apVars.GetVarFloat("FlockSeparation",0.7f);
		mfFlockAlignment = apVars.GetVarFloat("FlockAlignment",1);
		mfFlockCohesion = apVars.GetVarFloat("FlockCohesion",1);
		mlMaxFlockMemberChecks = apVars.GetVarInt("MaxFlockMemberChecks",6);
		
		mfTowardsCenterMul = apInstanceVars.GetVarFloat("TowardsCenterMul",1);
		mfExtraEscapeMul = apInstanceVars.GetVarFloat("ExtraEscapeMul",1);
		msExtraEscapeEntities = apInstanceVars.GetVarString("ExtraEscapeEntities","");
		
		mBaseObj.mlAnimState = 1; //Moving
		mBaseObj.SetIsFlying(true);
		mBaseObj.SetTestCollision(false);
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad()
	{
		if (msExtraEscapeEntities == "") return;
		
		/////////////////////////////////
		// Add extra escape entities
		array<tString> vEscapeEntities;
		cString_GetStringVec(msExtraEscapeEntities, vEscapeEntities, " ");
		
		for (int i = 0; i < vEscapeEntities.length(); i++)
		{
			tID id = mBaseObj.GetMap().GetEntityIDByName(vEscapeEntities[i]);
			if (id == tID_Invalid) continue;
				
			mvExtraEscapeEntities.push_back(id);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep) 
	{
		{
			float fSpeed = mBaseObj.mvWantedVel.Length();
			
			cVector3f vAdd = mBaseObj.Move_GetWallAvoidAdd(fSpeed*0.3f, afTimeStep);
			if(vAdd.y<0) vAdd.y=0;
			else		 vAdd.y*=0.1f;
				
			//vAdd.Normalize();
			mBaseObj.mvWantedVel += vAdd*4.85;
		}
		 
		mBaseObj.mvWantedVel += mBaseObj.Move_GetWanderAdd3D(1,2, afTimeStep)*cVector3f(2,0.5f,2)*mfWanderMul;
		
		mBaseObj.mvWantedVel += mBaseObj.Move_GetFlockingAdd(	mfTowardsCenterMul*0.1f,0.5f, //Center and CenterYMul
													mfFlockSeparation, //Separation
													mfFlockAlignment, //Alignment
													mfFlockCohesion, //Cohesion
													mlMaxFlockMemberChecks, //Max group member checks
													afTimeStep);
		
		mBaseObj.mvWantedVel += mBaseObj.Move_Normalize(mBaseObj.Move_GetTowardsGroundAdd(0.4f, afTimeStep))*-0.1f;
		
		bool bEscape = false;
		if(mBaseObj.GetDistanceToPlayer()<mfEscapeDistance)
		{
			bEscape = true;
			mBaseObj.mvWantedVel += mBaseObj.Move_Normalize(mBaseObj.Move_GetTowardPlayerAdd(false, afTimeStep))*-10*cVector3f(1,0.5f,1);
		}
		
		cVector3f vPos;
		iLuxEntity@ pEntity = null;
		for (int i = 0; i < mvExtraEscapeEntities.length(); i++)
		{
			@pEntity = cLux_ID_Entity(mvExtraEscapeEntities[i]);
			
			// Check if entity has been destroyed
			if (pEntity is null)
			{
				mvExtraEscapeEntities.removeAt(i);
				i--;
				continue;
			}
			
			vPos = pEntity.GetPosition();
			if(mBaseObj.GetDistanceToPos(vPos)<mfEscapeDistance*0.75)
			{
				bEscape = true;
				mBaseObj.mvWantedVel += mBaseObj.Move_Normalize(mBaseObj.Move_GetTowardPosAdd(vPos, false, afTimeStep))*-mfExtraEscapeMul*cVector3f(1,0.5f,1);
			}
		}
		
		
		
		if (bEscape)
		{
			mBaseObj.Move_ChangeMaxSpeed(mfEscapeSpeed, 8, afTimeStep);
		}
		else
		{
			mBaseObj.Move_ChangeMaxSpeed(mfNormalSpeed, 3, afTimeStep);
		}
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
		
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(float afAmount, int alStrength, const tString&in asType, const tString&in asSource)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_AddExtraEscapeEntity()
	{
		mvExtraEscapeEntities.push_back(cScript_GetGlobalArgID(0));
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		//afStartY = cLux_DrawDebugText("Dist: "+mBaseObj.GetDistanceToPlayer()+" RenderCount"+mBaseObj.GetNotRenderedCount(), afStartY);
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cLuxBackboneTail @mpBackboneTail;
	
	//------------------------------------------------------------
	
	float mfTowardsCenterMul;
	float mfExtraEscapeMul;
	array<tID> mvExtraEscapeEntities;
	
	//------------------------------------------------------------
	
	[nosave] float mfNormalSpeed;
	[nosave] float mfEscapeSpeed;
	[nosave] float mfEscapeDistance;
	[nosave] float mfWanderMul;
	[nosave] float mfFlockSeparation;
	[nosave] float mfFlockAlignment;
	[nosave] float mfFlockCohesion;
	[nosave] int mlMaxFlockMemberChecks;
	[nosave] tString msExtraEscapeEntities;
	
	//------------------------------------------------------------
		
}	