

//---------------------------------------------------------

class iScrHeroStatsHandlerBase
{
	/////////////////////////////////
	//Basic Init
	iLuxHeroStatsHandler@ mBaseObj;
	void SetupBaseInterface(iLuxHeroStatsHandler @aObj){@mBaseObj = aObj;}
	iLuxHeroStatsHandler@ GetBase(){ return mBaseObj;}
	
	/////////////////////////////////
	//Functions
	void CreateHeroStat(int alID, const tString&in asName)
	{
		mBaseObj.CreateHeroStat(alID, asName);
	}

	void RegisterHeroStats()
	{
		mBaseObj.RegisterHeroStats();
	}
	
	void IncreaseHeroStatAmount(int alID,int alAmount)
	{
		mBaseObj.IncreaseHeroStatAmount(alID,alAmount);
	}
	
	void SetHeroStatAmount(int alID,int alAmount)
	{
		mBaseObj.SetHeroStatAmount(alID,alAmount);
	}
	
	int GetHeroStatAmount(int alID)
	{
		return mBaseObj.GetHeroStatAmount(alID);
	}
	
	tString GetHeroStatName(int alID)
	{
		return mBaseObj.GetHeroStatName(alID);
	}
	
	tString GetHeroStatDescription(int alID)
	{
		return mBaseObj.GetHeroStatDescription(alID);
	}
}

//---------------------------------------------------------