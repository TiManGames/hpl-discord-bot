#include "props/Prop_Rigid.hps"
#include "helpers/helper_audio.hps"

class cScrPropInfectedRobotArm : cScrPropRigid
{
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropRigid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		mBaseObj.SetAutoSleep(false);
	}
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		if (mbFollowPlayer == false)
			return;

		cVector3f vToTarget = cMath_Vector3Normalize(cLux_GetPlayer().GetCharacterBody().GetPosition() - mBaseObj.GetPosition());
		vToTarget.y = 0;
		vToTarget = cMath_Vector3Normalize(vToTarget);
		
		float fFwdDot = cMath_Vector3Dot(vToTarget, cMath_MatrixInverse(mBaseObj.GetMatrix()).GetForward());
		float fRightDot = cMath_Vector3Dot(vToTarget, cMath_MatrixInverse(mBaseObj.GetMatrix()).GetRight());
		
		if (fFwdDot < 0.925)
		{
			if (mBaseObj.IsMoving()==false)
			{
				cLux_AddTodoMessage("Sound: Robot arm moving");
				mBaseObj.PlaySound("RobotArmMoveSound", "Entities_Station/doors/vertical_door/open", true, true);
				mBaseObj.PlaySound("RobotArmStartMoveSound", "Entities_Station/doors/vertical_door/open_start", true, true);
			}
			mBaseObj.RotateAtSpeed(5, 3.75f*(1.f-fFwdDot), cVector3f_Up*cMath_Sign(fRightDot), false, false, cVector3f_Zero, cVector3f_Zero);
		}
		else if (fFwdDot > 0.999 && mBaseObj.IsMoving())
		{
			Sound_Stop(mBaseObj.GetName()+"_RobotArmMoveSound", 0.25);
			mBaseObj.StopMove();
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_SetFollowPlayer()
	{
		mbFollowPlayer = cScript_GetGlobalArgBool(0);
		
		if (mBaseObj.IsMoving())
		{
			Sound_Stop(mBaseObj.GetName()+"_RobotArmMoveSound", 0.25);
			mBaseObj.StopMove();
		}
	}
	
	//------------------------------------------------------------
	
	bool mbFollowPlayer = false;
}