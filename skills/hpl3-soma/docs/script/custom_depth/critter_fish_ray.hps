#include "critters/Critter_FishSmall.hps"

//------------------------------------------------------------

const float gfRayTargetGroundDist = 0.475f;
const float gfRayGroundDistMul = 8;

//------------------------------------------------------------

class cScrCritterFishRay : cScrCritterFishSmall
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
/*	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
	}*/
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep)
	{	
		mBaseObj.mvWantedVel += mBaseObj.Move_GetWanderAdd3D(1,2, afTimeStep)*cVector3f(2,0,2)*mfWanderMul;
		
		mBaseObj.mvWantedVel += mBaseObj.Move_GetTowardCenterAdd(afTimeStep)*mfTowardsCenterMul;
		
		cVector3f vToGround = mBaseObj.Move_GetTowardsGroundAdd(5.f, afTimeStep);
		float fGroundTarget = -gfRayTargetGroundDist;
		float fGroundMul = (fGroundTarget-vToGround.y)*gfRayGroundDistMul*0.01f;
		mBaseObj.mvWantedVel += cVector3f_Down*fGroundMul;
		
		bool bEscape = false;
		if(mBaseObj.GetDistanceToPlayer()<mfEscapeDistance)
		{
			bEscape = true;
			mBaseObj.mvWantedVel += mBaseObj.Move_Normalize(mBaseObj.Move_GetTowardPlayerAdd(false, afTimeStep))*-10*cVector3f(1,0,1);
		}
		
		cVector3f vPos;
		for (int i = 0; i < mvExtraEscapeEntities.length(); i++)
		{
			vPos = cLux_ID_Agent(mvExtraEscapeEntities[i]).GetPosition();
			if(mBaseObj.GetDistanceToPos(vPos)<mfEscapeDistance*0.75)
			{
				bEscape = true;
				mBaseObj.mvWantedVel += mBaseObj.Move_Normalize(mBaseObj.Move_GetTowardPosAdd(vPos, false, afTimeStep))*-mfExtraEscapeMul*cVector3f(1,0.5f,1);
			}
		}
		
		if (bEscape)
		{
			mBaseObj.Move_ChangeMaxSpeed(mfEscapeSpeed, 8, afTimeStep);
		}
		else
		{
			mBaseObj.Move_ChangeMaxSpeed(mfNormalSpeed, 3, afTimeStep);
		}
	}
		
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
		
}	