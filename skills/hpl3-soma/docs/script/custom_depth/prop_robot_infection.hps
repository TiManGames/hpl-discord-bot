#include "script/Prop_Rigid.hps"
#include "helpers/helper_map.hps"

class cScrPropInfection : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{		
		msGrowthSound = apVars.GetVarString("GrowthSound", "");
		
		///////////////////////////////
		// Instance variables
		
		if (apInstanceVars.GetVarBool("DisablePlayerCollision", false))
		{
			for (int i = 0; i < mBaseObj.GetBodyNum(); i++)
			{
				iPhysicsBody@ pBody = mBaseObj.GetBody(i);
				pBody.SetCollideCharacter(false);
			}
		}
		
		mbParticlesDisabled = apInstanceVars.GetVarBool("DisableParticles", false);
		mbGrowthSoundDisabled = apInstanceVars.GetVarBool("DisableGrowthSound", false);
	
		mfDelay = apInstanceVars.GetVarFloat("GrowthDelay", 0.2f);
		mfGrowthSpeed = apInstanceVars.GetVarFloat("GrowthSpeed", 5.f);
		msCallback = apInstanceVars.GetVarString("GrowthCallback", "");
		msChildren = apInstanceVars.GetVarString("ExtraChildren", "");
		
		mfGrowth = mfGrowthSpeed > 0 ? 1 : 0;
	}
	
	//------------------------------------------------------------
		
	void OnUpdate(float afTimeStep)
	{
		// Check if done growing
		if ((mfGrowthSpeed >= 0 && mfGrowth >= 1.0f) || (mfGrowthSpeed < 0 && mfGrowth <= 0.0f)) return;
		
		if (mfDelay > 0)
		{			
			mfDelay -= afTimeStep;
			
			// Initialize growth
			if (mfDelay <= 0)
			{	
				if (mfGrowthSpeed >= 0)
				{
					mBaseObj.SetMeshScaleMul(cVector3f(0.001f));
					mBaseObj.GetMeshEntity().SetVisible(true);	
				}				
				mBaseObj.SetEffectsActive(true, true);		
				
				// Disable all particle systems
				if (mbParticlesDisabled)
				{
					array<cParticleSystem@> vParticles;
					Map_GetParticleSystemArray(mBaseObj.GetName() + "_*", vParticles);
					for (int i = 0; i < vParticles.length(); i++)
					{
						vParticles[i].SetVisible(false);
						vParticles[i].SetActive(false);
					}
				}
				
				// Play growth sound
				if (!mbGrowthSoundDisabled && msGrowthSound != "")
				{
					cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().CreateSoundEntity(mBaseObj.GetName() + "_GrowthSound", msGrowthSound, true);
					if (pSound is null)
					{
						Error("Could not create growth sound " + msGrowthSound + " for " + mBaseObj.GetName());
					}
					else
					{
						mBaseObj.GetAttachEntity().AddChild(pSound);
					}
				}
				
				// Activate children
				array<tString> vChildren;
				cString_GetStringVec(msChildren, vChildren, " ");
				for (int i = 0; i < vChildren.length(); i++)
				{
					cScript_RunGlobalFunc(vChildren[i], "cScrPropInfection", "_Global_StartGrowth");
				}
				
				// Callback
				cLuxMap@ pMap = cLux_GetCurrentMap();
				if(msCallback != "" && pMap.ScriptPrepare("void " + msCallback + "(const tString &in asEntity, bool abStartOfGrowth)"))
				{
					tString sName = mBaseObj.GetName();
					pMap.SetArgString(0, sName);
					pMap.SetArgBool(1, true);
					pMap.ScriptExecute();
				}
			}
			
			return;
		}
 
		mfGrowth = cMath_Clamp(mfGrowth + mfGrowthSpeed*afTimeStep, 0, 1.0f);
		bool bDone = (mfGrowthSpeed >= 0 && mfGrowth == 1.0f) || (mfGrowthSpeed < 0 && mfGrowth == 0.0f);
		
		// Finalize growth
		if (bDone && msCallback != "")
		{
			cLuxMap@ pMap = cLux_GetCurrentMap();
			if(pMap.ScriptPrepare("void " + msCallback + "(const tString &in asEntity, bool abStartOfGrowth)"))
			{
				tString sName = mBaseObj.GetName();
				pMap.SetArgString(0, sName);
				pMap.SetArgBool(1, false);
				pMap.ScriptExecute();
			}
		}
		
		// This gives a less smooth feel to the scaling
		float fLength = int(mfGrowth*4)/4.f; // Round down to quarter
		fLength += cMath_Min((mfGrowth-(fLength))*4, 0.25f); // Increase value fast until it hits the next quarter
		fLength = cMath_Max(fLength, 0.001f); // Scale should never be 0
				
		mBaseObj.SetMeshScaleMul(cVector3f(fLength));
		
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(float afAmount, int alStrength, const tString&in asType, const tString&in asSource)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
	
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in apContactData)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Default;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// SPECIFIC ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_StartGrowth()
	{
		if (mfGrowthSpeed > 0)
		{
			mBaseObj.SetActive(true);
			mBaseObj.SetEffectsActive(false, false);
			mBaseObj.GetMeshEntity().SetVisible(false);
			mfGrowth = 0;
		}
		else
		{
			mfGrowth = 1;
		}
	}
	
	//-------------------------------------------------------
	
	void _Global_AddChild()
	{
		tString sChild = cScript_GetGlobalArgString(0);
		msChildren += " " + sChild;
	}
	
	//-------------------------------------------------------
	
	void _Global_SetGrowthTime()
	{
		mfGrowthSpeed = 1.f / cMath_Max(cScript_GetGlobalArgFloat(0), 0.001f);
	}
	
	//-------------------------------------------------------
	
	void _Global_SetDelay()
	{
		mfDelay = cScript_GetGlobalArgFloat(0);
	}
	
	//-------------------------------------------------------
	
	void _Global_SetCallback()
	{
		msCallback = cScript_GetGlobalArgString(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_DisableInfection()
	{
		mBaseObj.SetActive(false);
		mBaseObj.SetEffectsActive(false, false);
		mBaseObj.GetMeshEntity().SetVisible(false);
		mBaseObj.SetStaticPhysics(true);
	}
			
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] tString msGrowthSound;
	
	//-------------------------------------------------------
	
	bool mbGrowthSoundDisabled = false;
	bool mbParticlesDisabled = false;
	
	float mfDelay = 0.2f;
	float mfGrowthSpeed = 5.f;
	tString msCallback;
	tString msChildren;
	
	float mfGrowth = 1;
}