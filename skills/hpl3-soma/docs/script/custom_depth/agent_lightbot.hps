#include "interfaces/Agent_SwimBot.hps"
//#include "helpers/helper_map.hps"
//#include "helpers/helper_audio.hps"

enum eLightBotState
{
	eLightBotState_Normal
}

enum eLightBotSpeed
{
	eLightBotSpeed_Normal
}

//-------------------------------------------------------

const tString gsMoveLoopSound = "NPC_Creatures/Foley/Underwater/Construct_Worker/loop";
const tString gsIdleLoopSound = "NPC_Creatures/Foley/Underwater/Construct_Worker/idle";
const tString gsMoveLoopStartSound = "NPC_Creatures/Foley/Underwater/Construct_Worker/start";
const tString gsMoveLoopStopSound = "NPC_Creatures/Foley/Underwater/Construct_Worker/stop";
const float gfMoveLoopSoundMinSpeed =0.1;
	
//-------------------------------------------------------

class cScrAgentLightBot : cScrAgentSwimBot
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		cScrAgentSwimBot::Init();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupCharBody()
	{
		cScrAgentSwimBot::SetupCharBody();
		
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		pCharBody.SetMass(80);
		
		pCharBody.SetMaxPositiveMoveSpeed(eCharDir_Forward,4.0f);
		pCharBody.SetMoveAcc(eCharDir_Forward,3);
		pCharBody.SetMoveDeacc(eCharDir_Forward,3);
		pCharBody.SetMoveOppositeDirAccMul(eCharDir_Forward,1);
	}
		
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld,  cResourceVarsObject@ apVars,  cResourceVarsObject@ apInstanceVars)
	{
		cScrAgentSwimBot::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		/////////////////////////////////
		// Genral Setup
		
		msLoopSound_Move = gsMoveLoopSound;
		msLoopSound_Idle = gsIdleLoopSound;
		mfLoopSoundMinMoveSpeed = gfMoveLoopSoundMinSpeed;
		
		mbBubbleEffectsActive = true;
		
		mpForceEmitter.SetActive(true);
		mpForceEmitter.SetRadius(1.8f);
		
		/////////////////////////////////
		// Mover
		mpMover.SetMaxForwardSpeed(2.25f);
		
		mpMover.SetBackwardAnimName("Idle");
		mpMover.SetWalkAnimName("Drive_fwd");
		mpMover.SetRunAnimName("Drive_fwd");
		mpMover.SetIdleAnimName("Idle");
		
		mpMover.SetStoppedToWalkSpeed(0.8);
		mpMover.SetWalkToRunSpeed(4);
		mpMover.SetWalkToStoppedSpeed(0.6);
		//mpMover.SetTurnStoppedToWalkSpeed(99.90f); //Meaning that we do not it!
		//mpMover.SetTurnWalkToStoppedSpeed(99.0f); //Meaning that we do not it!
		
		mpMover.SetupWallAvoidance(3.0f, 8.0f, 4);
		
		/////////////////////////////////
		// Speed States
		mpMover.AddSpeedState(eLightBotSpeed_Normal);
		mpMover.SetSpeedState_Forward(2.4f);
		mpMover.SetSpeedState_TurnSpeedMul(1.0f);
		mpMover.SetSpeedState_TurnMaxSpeed(2.4f);
		
		/////////////////////////////////
		// States
		mpStateMachine.AddState("Normal", eLightBotState_Normal);
				
		mpMover.SetUseMoveStateAnimations(true);
					
		/////////////////////////////////
		// Misc
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		cScrAgentSwimBot::OnUpdate(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
		cScrAgentSwimBot::BeforeEntityDestruction();
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// STATES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
		///////////////////////////////////
		// STATE: Default
		///////////////////////////////////
	
		//------------------------------------------------------------
		
		
		//------------------------------------------------------------
	
		///////////////////////////////////
		// STATE: Normal
		///////////////////////////////////
	
		//------------------------------------------------------------
	
		void State_Normal_Enter()
		{
			mpMover.SetSpeedState(eLightBotSpeed_Normal);
		}
		
		void State_Normal_Leave()
		{
		}
		
		//------------------------------------------------------------
		
		void State_Normal_Update(float afTimeStep)
		{
		}
		
		//----------------------------------------------
		
		bool State_Normal_Message(int alMessageId)
		{
			return true;
		}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
		
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		cScrAgentSwimBot::OnSetActive(abX);
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(float afAmount, int alStrength, const tString&in asType, const tString&in asSource)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
		
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// INPUT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
		
	//------------------------------------------------------------
	
}