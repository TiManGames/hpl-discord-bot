#include "interfaces/Area_Interface.hps"

class cScrDatamineAnimNode : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int ToEasingFunc(const tString&in asType)
	{
		if(asType=="Linear") return eEasing_Linear; 
		if(asType=="SineIn") return eEasing_SineIn;
		if(asType=="SineOut") return eEasing_SineOut;
		if(asType=="SineInOut") return eEasing_SineInOut;
		if(asType=="QuadIn") return eEasing_QuadIn;
		if(asType=="QuadOut") return eEasing_QuadOut;
		if(asType=="QuadInOut") return eEasing_QuadInOut;
		if(asType=="CubicIn") return eEasing_CubicIn;
		if(asType=="CubicOut") return eEasing_CubicOut;
		if(asType=="CubicInOut") return eEasing_CubicInOut;
		if(asType=="QuartIn") return eEasing_QuartIn;
		if(asType=="QuartOut") return eEasing_QuartOut;
		if(asType=="QuartInOut") return eEasing_QuartInOut;
		if(asType=="QuintIn") return eEasing_QuintIn;
		if(asType=="QuintOut") return eEasing_QuintOut;
		if(asType=="QuintInOut") return eEasing_QuintInOut;
		if(asType=="ExpoIn") return eEasing_ExpoIn;
		if(asType=="ExpoOut") return eEasing_ExpoOut;
		if(asType=="ExpoInOut") return eEasing_ExpoInOut;
		if(asType=="CircIn") return eEasing_CircIn;
		if(asType=="CircOut") return eEasing_CircOut;
		if(asType=="CircInOut") return eEasing_CircInOut;
		if(asType=="BackIn") return eEasing_BackIn;
		if(asType=="BackOut") return eEasing_BackOut;
		if(asType=="BackInOut") return eEasing_BackInOut;
		if(asType=="ElasticIn") return eEasing_ElasticIn;
		if(asType=="ElasticOut") return eEasing_ElasticOut;
		if(asType=="ElasticInOut") return eEasing_ElasticInOut;
		if(asType=="BounceIn") return eEasing_BounceIn;
		if(asType=="BounceOut") return eEasing_BounceOut;
		if(asType=="BounceInOut") return eEasing_BounceInOut;
		return eEasing_Linear;
	}
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		mfTimeToNode = apVars.GetVarFloat("TimeToNode",0);
		mlEasingFunc = ToEasingFunc(apVars.GetVarString("EasingFunc",""));
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return 0;
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void _Global_GetTimeToNode()
	{
		cScript_SetGlobalReturnFloat(mfTimeToNode);
	}
	
	void _Global_GetEasingFunc()
	{
		cScript_SetGlobalReturnInt(mlEasingFunc);
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimteStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfTimeToNode;
	int mlEasingFunc;
	
	//------------------------------------------------------------
		
}	