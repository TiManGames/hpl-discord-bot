#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"
#include "helpers/helper_imgui.hps"
#include "helpers/helper_props.hps"
#include "custom_depth/util_datamine.hps"
#include "helpers/helper_modules.hps"

class cScrPropDatamine : iScrProp, iScrProp_Interface
{		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{	
		bool bIsBlackbox = apVars.GetVarBool("IsBlackbox", false);
		bool bStopAllVoices = apVars.GetVarBool("StopAllVoices", false);
		
		mDatamine.Init(mBaseObj, mBaseObj, apInstanceVars, bIsBlackbox, bStopAllVoices);
		
		EyeTracking_RegisterEntity(mBaseObj.GetID());
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad()
	{
		mDatamine.AddToHandler();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
		mDatamine.BeforeEntityDestruction();
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
		
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(float afAmount, int alStrength, const tString&in asType, const tString&in asSource)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in apContactData)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return mDatamine.OnInteract(alType, apBody, avFocusPos, asData);
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return mDatamine.GetInteractIconId(alType, apBody);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_AfterScan()
	{
		mDatamine.AfterScan();
	}
	
	//------------------------------------------------------------
	
	void _Global_HasBeenMined()
	{
		cScript_SetGlobalReturnBool(mDatamine.mbInteractionDone);
	}
			
	//------------------------------------------------------------
	
	void _Global_SetGlowActive()
	{
		mDatamine.SetGlowActive(cScript_GetGlobalArgBool(0));
	}
			
	//------------------------------------------------------------
	
	void _Global_SetFinalSubjectCallback()
	{
		mDatamine.msFinalSubjectCallback = cScript_GetGlobalArgString(0);
	}
	
	
	//------------------------------------------------------------
	
	void _Global_CanBeHighlighted()
	{
		cScript_SetGlobalReturnBool(mDatamine.mbInteractionDone==false);
		cScript_SetGlobalArgID(0,mBaseObj.GetID());
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cUtility_Datamine mDatamine;
	
	//------------------------------------------------------------
}