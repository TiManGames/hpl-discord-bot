#include "props/prop_rigid.hps"
#include "custom_depth/util_construct_tentacle.hps"
#include "interfaces/Prop_Interface.hps"
#include "custom_depth/Prop_Datamine.hps"
#include "helpers/helper_modules.hps"
#include "helpers/helper_effects.hps"
#include "helpers/helper_player.hps"

//-------------------------------------------------------

float gTentacleAttackRange = 4.0f;
float gTentacleEmergeRange = 6.0f;

enum eTentacleState
{
	eTentacleState_Hidden,
	eTentacleState_Idling,
	eTentacleState_Attacking
}

class cScrCarlConstruct : cScrPropRigid
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		mTentacles.Init(mBaseObj);
		mTentacles.PreloadMaterial();
	}
	
	void OnAfterWorldLoad()
	{
		mTentacles.Add("Tentacle_1", 1, 1.0f);
		mTentacles.Add("Tentacle_2", 1, 1.0f);
		mTentacles.Add("Tentacle_3", 1, 1.0f);
		mTentacles.Add("Tentacle_4", 1, 1.0f);
		mTentacles.Add("Tentacle_5", 1, 1.0f);
		mTentacles.Add("Tentacle_6", 1, 1.0f);
		mTentacles.Add("Tentacle_7", 1, 1.0f);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// UPDATE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		return;
		mTentacles.Update(afTimeStep);
			
		if (mbHostile)
		{
			cVector3f vHeadPosition = cLux_GetPlayer().GetCamera().GetPosition();
			cVector3f vCentrePosition = mBaseObj.GetPosition();
			float fDist = (vHeadPosition - vCentrePosition).SqrLength();
			
			if (fDist>gTentacleEmergeRange*gTentacleEmergeRange)
			{
				if (mTentacleState!=eTentacleState_Hidden)
				{
					if (mTentacleState==eTentacleState_Attacking)
					{
						AttackMeter_RemoveInstance(mBaseObj.GetID());
					}
					
					mTentacles.SetActiveAll(false);
					mTentacleState=eTentacleState_Hidden;
				}
			} 
			else if (fDist>gTentacleAttackRange*gTentacleAttackRange)
			{
				if (mTentacleState==eTentacleState_Hidden)
				{
					mTentacles.SetActiveAll(true);
					mTentacleState=eTentacleState_Idling;
				}
				else if (mTentacleState==eTentacleState_Attacking)
				{
					mTentacles.SetIdleAll();
					AttackMeter_RemoveInstance(mBaseObj.GetID());
					mTentacleState=eTentacleState_Idling;
				}
			}
			else
			{
				if (mTentacleState==eTentacleState_Hidden)
					mTentacles.SetActiveAll(true);
				if (mTentacleState!=eTentacleState_Attacking)
				{
					mTentacleState=eTentacleState_Attacking;
					AttackMeter_AddInstance(mBaseObj.GetID(),1.0f,0.25f, 0.3f);
				}
				mTentacles.SetTargetAll(vHeadPosition);
			}
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PLAYER DEATH
	/////////////////////////////////////////
		
	//------------------------------------------------------------
	
	void _Global_PlayerStartDamageCallback()
	{
		AttackMeter_RemoveInstance(mBaseObj.GetID());	
	}
	
	//------------------------------------------------------------
	
	void _Global_PlayerAfterDamageCallback()
	{
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
		
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(float afAmount, int alStrength, const tString&in asType, const tString&in asSource)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBALS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_StartAttackingPlayer()
	{
		if (mbHostile)
			return;
			
		mTentacles.SetActiveAll(true);
		mTentacleState = eTentacleState_Idling;
		
		mBaseObj.Timer_Remove(0);
		mBaseObj.Timer_Add(0,3.0f,"OnAttackStage2");
	}
	
	void OnAttackStage2(uint64 aTimerID)
	{
		mbHostile=true;
	}
	
	//------------------------------------------------------------
	
	void _Global_StopAttackingPlayer()
	{
		mTentacles.SetActiveAll(false);
		mBaseObj.Timer_Remove(0);
		mbHostile=false;
		mTentacleState = eTentacleState_Hidden;
	}

	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cConstructTentacleContainer mTentacles;
	bool mbHostile = false;
	eTentacleState mTentacleState = eTentacleState_Hidden;
	
	//------------------------------------------------------------
	
	
	//------------------------------------------------------------
		
}	