//-------------------------------------------------------

/**
 * Makes Kate start to weld
 * 
 * @param asEntityName, Name of Kate robot
 * @param asWeldFlareEntity, Name of the weld flare entity
 * @param asTargetPrefix, Prefix of the entities used as targets for the welding. Named as "PrefixName_1", "PrefixName_2" etc.
 * @param asExitNode, Node that Kate will go back to after finishing welding.
 * @param asCallback, Syntax: void Func(int alState). Called with alState 0 when welding is done and 1 when reaching the exit node.
 * @param afSpeedMul, speed multiplier. Going between each weld target takes 1/afSpeedMul seconds.
 **/
void Kate_Weld(const tString &in asEntityName, const tString &in asWeldFlareEntity, const tString &in asTargetPrefix, 
			   const tString &in asExitNode, const tString &in asCallback, float afSpeedMul=1.0f)
{
	cScript_SetGlobalArgString(0, asWeldFlareEntity);
	cScript_SetGlobalArgString(1, asTargetPrefix);
	cScript_SetGlobalArgString(2, asExitNode);
	cScript_SetGlobalArgString(3, asCallback);
	cScript_SetGlobalArgFloat(4, afSpeedMul);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_Weld");
}