/**
 * Makes the kate robot chase a specific entity until she's told to do something else.
 * 
 * @param asEntityName, Name of Kate robot
 * @param asChaseEntity, Name of the entity to chase
 **/
void Kate_ChaseEntity(const tString &in asEntityName, const tString &in asChaseEntity)
{
	cScript_SetGlobalArgString(0, asChaseEntity);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_ChaseEntity");
