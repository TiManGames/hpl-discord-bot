//-------------------------------------------------------

/**
 * Crashes Kate
 * 
 * @param asEntityName, Name of Kate robot
 * @param asCrashTarget, entity to crash towards.
 * @param asCallback, callback when the robot has reached its target. Syntax: void Func(const tString& in asEntityName, bool abReachedEnd)
 **/
void Kate_Crash(const tString &in asEntityName, const tString &in asCrashTarget, const tString &in asCallback)
{
	cScript_SetGlobalArgString(0, asCrashTarget);
	cScript_SetGlobalArgString(1, asCallback);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_Crash");
}

