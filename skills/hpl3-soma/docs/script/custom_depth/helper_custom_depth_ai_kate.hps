//-------------------------------------------------------


/////////////////////////////////////////
// SWIMBOT KATE
/////////////////////////////////////////


//-------------------------------------------------------

void Kate_LookAt(const tString &in asEntityName, const tString &in asLookAtEntity, bool abLookWithFlashlight=false)
{
	iLuxEntity@ pLookAtEntity = cLux_GetCurrentMap().GetEntityByName(asLookAtEntity, eLuxEntityType_LastEnum, "");
	if(pLookAtEntity !is null)
		Kate_LookAt(asEntityName, pLookAtEntity.GetPosition(), abLookWithFlashlight);
	else
		Error("Could not find entity '"+asLookAtEntity+"' for Kate_LookAt");
}

//-------------------------------------------------------

void Kate_LookAt(const tString &in asEntityName, const cVector3f &in avLookAt, bool abLookWithFlashlight=false)
{
	cScript_SetGlobalArgVector3f(0, avLookAt);
	cScript_SetGlobalArgBool(1, abLookWithFlashlight);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_LookAt");
}

//-------------------------------------------------------


/**
 * Makes Kate investage a certain object
 * 
 * @param asEntityName, Name of Kate robot
 * @param asPathNodeName, The pathnode to move to
 * @param asLookAtEntityName, entity to shine flashlight on.
 * @param afTimeToReturn, time after getting to the target position before going back to normal. -1 means it stays in investigation state until the script tells it otherwise.
 * @param asCallbackFunction, Callback for when Kate is in position. Syntax: void Func(const tString&in asEntityName).
 * @param abLookWithFlashlight, if the flashlight should be pointed directly at the object.
 **/
void Kate_Investigate(	const tString &in asEntityName,
						const tString &in asPathNodeName, const tString &in asLookAtEntityName,
						float afTimeToReturn = 2.f, const tString &in asCallbackFunction="", bool abLookWithFlashlight = true)
{
	cScript_SetGlobalArgString(0, asPathNodeName);
	cScript_SetGlobalArgString(1, asLookAtEntityName);
	cScript_SetGlobalArgString(2, asCallbackFunction);
	cScript_SetGlobalArgFloat(3, afTimeToReturn);
	cScript_SetGlobalArgBool(4, abLookWithFlashlight);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_Investigate");
}

//-------------------------------------------------------

/**
 * Adds an investigate target to Kate's InvestigateMultiple state.
 * 
 * @param asEntityName, Name of Kate robot
 * @param asPathNodeName, The pathnode to move to
 * @param asLookAtEntityName, entity to shine flashlight on.
 **/
void Kate_AddInvestigateTarget(	const tString &in asEntityName, const tString &in asPathNodeName, const tString &in asLookAtEntityName)
{
	cScript_SetGlobalArgString(0, asPathNodeName);
	cScript_SetGlobalArgString(1, asLookAtEntityName);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_AddInvestigateTarget");
}

//-------------------------------------------------------

/**
 * Makes Kate move between multiple nodes and entities as if investigating them. Set what entities with Kate_AddInvestigateTarget.
 * 
 * @param asEntityName, Name of Kate robot
 **/
void Kate_InvestigateMultiple(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_InvestigateMultiple");
}

//-------------------------------------------------------

/**
 * Makes Kate follow the player.
 * 
 * @param asEntityName, Name of Kate robot
 **/
void Kate_FollowPlayer(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_FollowPlayer");
}

//-------------------------------------------------------

/**
 * Sets the distance at which Kate will try to get away from the player.
 * 
 * @param asEntityName, Name of Kate robot
 * @param afFleeDist, distance to set.
 * @param asHomeEntity, entity to not stray too far from.
 * @param afMaxDistFromHome, max distance to stray from home entity.
 **/
void Kate_FleeFromPlayer(const tString &in asEntityName, float afFleeDist, const tString &in asHomeEntity, float afMaxDistFromHome)
{
	cScript_SetGlobalArgFloat(0, afFleeDist);
	cScript_SetGlobalArgString(1, asHomeEntity);
	cScript_SetGlobalArgFloat(2, afMaxDistFromHome);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentKate", "_Global_FleeFromPlayer");
}

//-------------------------------------------------------

