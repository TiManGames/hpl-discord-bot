#include "agent_flesher.hps"

const float gfRossFlesherVisibleTimeMin = 1.0f;
const float gfRossFlesherVisibleTimeMax = 3.0f;

const float gfRossFlesherInvisibleTimeMin = 0.25f;
const float gfRossFlesherInvisibleTimeMax = 0.75f;

class cScrAgentFlesherRoss : cScrAgentFlesher
{
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrAgentFlesher::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		mBaseObj.SetFOV(cMath_ToRad(100));
		mBaseObj.SetSightRange(6.f);
		
		mBaseObj.GetMeshEntity().SetVisible(false);
		mBaseObj.SetEffectsActive(false, false);
	}
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{	
		cScrAgentFlesher::OnUpdate(afTimeStep);
		
		if(mBaseObj.IsActive()==false) return; //Gotta make sure as this might be called after a disable otherwise.
		
		if (mbActivationLOSCheck)
		{
			mbActivationLOSCheck=false;
			mBaseObj.GetEntityIsInPlayerLineOfSight("OnSetActive_LOSCheck", true);	
		}
		
		if (mfGlimpseTimer<0) return;
		
		mfGlimpseTimer -= afTimeStep;
		if (mfGlimpseTimer <= 0)
		{
			if (mbDisappear)
			{
				mbDisappear = false;
				mBaseObj.SetActive(false);
			}
			else if (mBaseObj.GetMeshEntity().IsVisible() && cLux_GetPlayer().IsDead()==false)
			{
				DeactivateGlimpse(cMath_RandRectf(gfRossFlesherInvisibleTimeMin, gfRossFlesherInvisibleTimeMax));
			}
			else
			{
				ActivateGlimpse(cMath_RandRectf(gfRossFlesherVisibleTimeMin, gfRossFlesherVisibleTimeMax));
			}
		}
	}	
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		cScrAgentFlesher::OnSetActive(abX);
		
		if(abX)
		{
			mbActivationLOSCheck = true;
		}
		else
		{
			mBaseObj.GetMeshEntity().SetVisible(false);
			mBaseObj.SetEffectsActive(false, false);
			mfGlimpseTimer=-1;
		}
	}
	
	//------------------------------------------------------------
	
	void OnSetActive_LOSCheck(bool abInSight)
	{
		if (abInSight)
		{
			DeactivateGlimpse(0.5f);
			DoBrightFlash(1.5);
			Effect_VideoDistortion_Start(1, 0.75, 0.0, 0.5);
		}
		else
		{
			ActivateGlimpse(1);
			DoBrightFlash(1);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateCheckPlayerLOS(float afTimeStep)
	{
		// Less intense effects while invisible.
		// Check mfGlimpseTimer in order to start the effects ahead of time
		if (mBaseObj.GetMeshEntity().IsVisible()==false && mfGlimpseTimer > 0.5) 
		{
			mbIsInPlayerLOS = false;
			mfCheckPlayerLOSCount = 0;
			return;
		}
		
		cScrAgentFlesher::UpdateCheckPlayerLOS(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void ActivateGlimpse(float afTime)
	{
		mBaseObj.GetMeshEntity().SetVisible(true);
		mBaseObj.SetEffectsActive(true, false);
		mfGlimpseTimer = afTime;
		DoBrightFlash(cMath_Min(mfGlimpseTimer, 0.3f));	
	}
	
	//------------------------------------------------------------
	
	void DeactivateGlimpse(float afTime)
	{
		mBaseObj.GetMeshEntity().SetVisible(false);
		mBaseObj.SetEffectsActive(false, false);
		mfGlimpseTimer = afTime;
	}
	
	//------------------------------------------------------------
	
	void Disappear()
	{
		if (mBaseObj.IsActive() == false) return;
		
		if (mBaseObj.GetEntityIsInPlayerLineOfSight(true))
		{
			if (mbDisappear) return;
			
			ActivateGlimpse(0.3);
			Effect_VideoDistortion_Start(1, 0.75, 0.0, 0.5);
			Effect_Shake_Start(0.2, 0, 0.3, 1);
			mbDisappear = true;
		}
		else
		{
			mBaseObj.SetActive(false);
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_ForceVisible()
	{
		ActivateGlimpse(cScript_GetGlobalArgFloat(0));
	}
	
	//------------------------------------------------------------
	
	float mfGlimpseTimer = -1;
	int mlDistortionEffectID = -1;
	bool mbActivationLOSCheck = false;
	bool mbDisappear = false;
}