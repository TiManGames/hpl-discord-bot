//-------------------------------------------------------

void Flesher_SetPositionAndFacing(const tString &in asEntityName, const cVector3f& in avPosition, const cVector3f& in avTarget)
{
	cScript_SetGlobalArgVector3f(0, avPosition);
	cScript_SetGlobalArgVector3f(1, avTarget);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesher", "_Global_SetPositionAndFacing");
}

//-------------------------------------------------------

/**
 * @param asEntityName, The flesher
 * @param asSpeed, One of the predefined Flesher speeds: "Walk", "FastWalk" or "Run"
 */
void Flesher_SetPatrolSpeed(const tString &in asEntityName, const tString& in asSpeed)
{
	cScript_SetGlobalArgString(0,asSpeed);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesher", "_Global_SetPatrolSpeed");
}


//-------------------------------------------------------

/**
 * @param asEntityName, The flesher
 * @param afMul, Multiplier for the distortion effect. Setting above 1 is not recommended.
 */
void Flesher_SetDistortionEffectMul(const tString &in asEntityName, float afMul)
{
	cScript_SetGlobalArgFloat(0,afMul);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesher", "_Global_SetDistortionEffectMul");
}

//-------------------------------------------------------

bool Flesher_IsHunting(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesher", "_Global_IsHunting");
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------------

/**
 * @param asEntityName, The Flesher
 * @param afAmount, Damage amount you want the Flesher to do when attacking (0.0-1.0)
 */
void Flesher_SetAttackDamageAmount(const tString &in asEntityName, float afAmount)
{
	cScript_SetGlobalArgFloat(0,afAmount);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesher", "_Global_SetAttackDamageAmount");
}


//-------------------------------------------------------

/////////////////////////////////////////
// ROSS FLESHER
/////////////////////////////////////////

//-------------------------------------------------------

/**
 * Deactivates the flesher. If the player looks at him when this happens, glitch effects are activated to better disguise it.
 * @param asEntityName, name of the entity, wildcards supported.
 */
void RossFlesher_Disappear(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesherRoss", "Disappear");
}

//-------------------------------------------------------

/**
 * Makes the flesher visible for the specified amount of time.
 * @param asEntityName, name of the entity, wildcards supported.
 * @param afTime, time for the flesher to be visible. Use -1 to make it visible indefinitely.
 */
void RossFlesher_ForceVisible(const tString &in asEntityName, float afTime)
{
	cScript_SetGlobalArgFloat(0, afTime);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesherRoss", "_Global_ForceVisible");
}

//-------------------------------------------------------

/////////////////////////////////////////
// ROSS CUBE VERSION
/////////////////////////////////////////

//-------------------------------------------------------

/**
 * Makes the flesher stay invisible until further notice.
 * @param asEntityName, name of the entity, wildcards supported.
 * @param abInvisible, if Ross should be forced to stay invisible
 */
 
void RossCube_ForceInvisible(const tString &in asEntityName, bool abInvisible)
{
	cScript_SetGlobalArgBool(0,abInvisible);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentRossCube", "_Global_ForceInvisible");
}

//-------------------------------------------------------

/**
 * Makes the flesher visible for the specified amount of time.
 * @param asEntityName, name of the entity, wildcards supported.
 * @param afTime, time for the flesher to be visible
 */

void RossCube_ForceVisible(const tString &in asEntityName, float afTime)
{
	cScript_SetGlobalArgFloat(0,afTime);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentRossCube", "_Global_ForceVisible");
}