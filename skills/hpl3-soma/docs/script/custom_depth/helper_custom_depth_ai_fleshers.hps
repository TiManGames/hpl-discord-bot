

//-------------------------------------------------------

/////////////////////////////////////////
// FLESHER
/////////////////////////////////////////

//-------------------------------------------------------

void Flesher_SetupPatrol(const tString &in asEntityName, bool abLoop, const tString&in asCallback)
{
	cScript_SetGlobalArgBool(0, abLoop);
	cScript_SetGlobalArgString(1, asCallback);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesher", "_Global_SetupPatrol");
}

//-------------------------------------------------------

void Flesher_StartPatrol(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesher", "_Global_StartPatrol");
}

//-------------------------------------------------------

void Flesher_SetEffectsEnabled(const tString &in asEntityName, bool abEnabled)
{
	cScript_SetGlobalArgBool(0, abEnabled);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentFlesher", "_Global_SetEffectsEnabled");
}

