#include "props/Prop_Grab.hps"

const tString gsArkDamageSound_1 = "Entities_Station/tech/generator_tiny/generator_blowout";
const tString gsArkDamageSound_2 = "Entities_Station/tech/generator_tiny/generator_blowout";
const tString gsArkDamageSound_3 = "Entities_Station/tech/generator_tiny/generator_blowout";

class cScrPropArk : cScrPropGrab
{
	
	void Init()
	{
		cScrPropGrab::Init();
		mBaseObj.SetScriptCollisionCallbackActive(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropGrab::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		int lIndex = 1;
		iLight@ pLight = mBaseObj.GetLightFromName("DamageLight_"+lIndex);
		while (pLight != null)
		{
			mvDamageLights.push_back(pLight.GetID());
			pLight.SetVisible(false);
			
			lIndex++;
			@pLight = mBaseObj.GetLightFromName("DamageLight_"+lIndex);
		}
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		if (mfHealthDelay > 0)
		{
			mfHealthDelay-=afTimeStep;
		}
		
		if (mfIllumTarget < mfIllum)
		{
			mfIllum = cMath_Max(mfIllum-afTimeStep*5.f, mfIllumTarget);
			mBaseObj.GetMeshEntity().SetIlluminationColor(mfIllum);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in aContactData)
	{
		if (mfHealthDelay > 0 || cMath_Abs(aContactData.mfMaxContactNormalSpeed) < 5.25)
			return;
		
		mlHealth = cMath_Max(0, mlHealth-1);
		mfHealthDelay = 0.75f;
		
		tString sSound = "";
		if (mlHealth == 2)
		{
			cLux_AddTodoMessage("Sound: Ark taking some damage.");
			mfIllumTarget = 0.7;
			sSound = gsArkDamageSound_1;
		}
		
		else if (mlHealth == 1)
		{
			cLux_AddTodoMessage("Sound: Ark taking damage.");
			mfIllumTarget = 0.5;
			sSound = gsArkDamageSound_2;
		}
		
		else
		{
			cLux_AddTodoMessage("Sound: Ark taking lots of damage.");
			mfIllumTarget = 0.3;
			sSound = gsArkDamageSound_3;
		}
		mBaseObj.PlaySound("ArkDamaged", sSound, true, true);
		
		cWorld@ pWorld = mBaseObj.GetMap().GetWorld();
		for(int i = 0; i < mvDamageLights.length(); i++)
		{
			iLight@ pLight = pWorld.GetLightFromID(mvDamageLights[i]);
			pLight.SetVisible(true);
			
			pLight.SetFlickerActive(true);
		}
		
		mBaseObj.Timer_Add(100, 1.5, "KillOnHitEffects");
	}	
	
	//------------------------------------------------------------
	
	void KillOnHitEffects(uint64 alTimerID)
	{
		cWorld@ pWorld = mBaseObj.GetMap().GetWorld();
		for(int i = 0; i < mvDamageLights.length(); i++)
		{
			iLight@ pLight = pWorld.GetLightFromID(mvDamageLights[i]);
			pLight.SetVisible(false);
			pLight.SetFlickerActive(false);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	array<tID> mvDamageLights;
	int mlHealth = 3;
	float mfHealthDelay = 0;
	
	float mfIllumTarget = 1;
	float mfIllum = 1;
}	