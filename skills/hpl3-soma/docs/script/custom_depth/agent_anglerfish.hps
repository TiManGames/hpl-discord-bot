	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		afY = cLux_DrawDebugText("Speed: "+mBaseObj.GetCharBody().GetVelocity(1.0f/60.0f).Length(), afY);
		afY = cLux_DrawDebugText("PlayerIsDetected: "+mBaseObj.PlayerIsDetected(), afY);
		afY = cLux_DrawDebugText("DistToPlaye: "+mBaseObj.GetDistanceToPlayer(), afY);
		
		return afY;
	}
	
	//------------------------------------------------------------
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		apFunctions.GetLowLevelGfx().DrawSphere(mvGroundPos, 0.3, cColor(0,5,0,1));
		cVector3f vUp = mvGroundPos;
		vUp.y = mfWantedHeight;
		apFunctions.GetLowLevelGfx().DrawSphere(vUp, 0.3, cColor(5,5,0,1));
	}
	
