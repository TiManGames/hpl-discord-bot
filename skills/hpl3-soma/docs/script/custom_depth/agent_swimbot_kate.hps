	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	void _Global_Investigate()
	{
		msInvestigatePathNode = cScript_GetGlobalArgString(0);
		msInvestigateEntity = cScript_GetGlobalArgString(1);
		msInvestigateCallback = cScript_GetGlobalArgString(2);
		mfTimeToLeave = cScript_GetGlobalArgFloat(3);
		mbLookWithFlashlight = cScript_GetGlobalArgBool(4);
		
		if (mpStateMachine.GetCurrentState() != eKateState_Investigate)
		{
			mpStateMachine.ChangeState(eKateState_Investigate);
		}
		else
		{
			State_Investigate_Enter();
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_AddInvestigateTarget()
	{		
		tString sNode = cScript_GetGlobalArgString(0);
		tString sEntity = cScript_GetGlobalArgString(1);
		mvInvestigatePathNodes.push_back(sNode);
		mvInvestigateEntities.push_back(sEntity);
	}
	
	//------------------------------------------------------------
	
	void _Global_InvestigateMultiple()
	{		
		mpStateMachine.ChangeState(eKateState_InvestigateMultiple);
	}
	
	//------------------------------------------------------------
	
	void _Global_LookAt()
	{
		mpStateMachine.ChangeState(eKateState_LookAt);
		mvLookAtTarget = cScript_GetGlobalArgVector3f(0);
		mbLookWithFlashlight = cScript_GetGlobalArgBool(1);
	}
	
	//------------------------------------------------------------
	
	void _Global_FollowPlayer()
	{
		mpStateMachine.ChangeState(eKateState_FollowPlayer);
	}
	
	//------------------------------------------------------------
	
	void _Global_AddChaseEntity()
	{
		iLuxEntity@ pEntity = Map_GetEntity(cScript_GetGlobalArgString(0));
		if (pEntity !is null) mvChaseEntities.push_back(pEntity.GetID());
	}
	
	//------------------------------------------------------------
	
	void _Global_RemoveChaseEntity()
	{
		iLuxEntity@ pEntity = Map_GetEntity(cScript_GetGlobalArgString(0));
		if (pEntity !is null)
		{
			for (int i = 0; i < mvChaseEntities.length(); i++)
			{
				if (mvChaseEntities[i] != pEntity.GetID()) continue;
				
				mvChaseEntities.removeAt(i);
				i--;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_ChaseEntity()
	{
		iLuxEntity@ pEntity = Map_GetEntity(cScript_GetGlobalArgString(0));
		if (pEntity !is null) mChaseEntityID = pEntity.GetID();
		else mChaseEntityID = tID_Invalid;
		
		if (mChaseEntityID == tID_Invalid)
		{
			cLux_AddDebugMessage("What is this entity called "+cScript_GetGlobalArgString(0));
		}
		mpStateMachine.ChangeState(eKateState_ChaseEntities);
		
		mbForcedChase = true;
	}
	
	//------------------------------------------------------------
	
	void _Global_FleeFromPlayer()
	{
		mfFleeFromPlayerDist = cScript_GetGlobalArgFloat(0);
		tString sFleeHomeNode = cScript_GetGlobalArgString(1);
		if (Entity_Exists(sFleeHomeNode))
		{
			mvFleeHomePos = Map_GetEntity(sFleeHomeNode).GetPosition();
		}
		else
		{
			Error("Entity " + sFleeHomeNode + " does not exist and cannod be used as Kate's home!");
			mvFleeHomePos = mBaseObj.GetPosition();
			return;
		}
		mfMaxDistFromHome = cScript_GetGlobalArgFloat(2);
		mpStateMachine.ChangeState(eKateState_FleeFromPlayer);
	}
	
	//------------------------------------------------------------
	
	void _Global_SlowDownFleeSpeed()
	{
		mCurrentFleeSpeed = eKateSpeed(mCurrentFleeSpeed+1);
		//mpMover.SetSpeedState(mCurrentFleeSpeed);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetMoveSpeedToFleeForLife()
	{
		mpMover.SetSpeedState(eKateSpeed_FleeForLife);
	}
	
	//------------------------------------------------------------
	
	void _Global_ReduceHealth()
	{
		mfHealth -= cScript_GetGlobalArgFloat(0);
		
		/////////////////
		// Hurt effects
		mBaseObj.SetEffectBaseColor(cColor_White*mfHealth);
		
		cParticleSystem@ pPS = cLux_GetCurrentMap().GetWorld().CreateParticleSystem(mBaseObj.GetName()+"Sparks", "elec_sparks_katebot.ps", cVector3f(1), true, false);
		mBaseObj.GetAttachEntity().AddChild(pPS);
		pPS.SetBrightness(7);
		pPS.SetFadeAtDistance(false);
		
		mBaseObj.PlayAnimation("hurt", 0.2, false, true);
		
		////////////////////////////////////////////////////////////
		// If fleeing from player, make sure speed is increased
		if (mpStateMachine.GetCurrentState() == eKateState_FleeFromPlayer)
		{
			mpStateMachine.StopTimer(2);
			mpStateMachine.AddTimer(2, 3.5);
			mpMover.SetSpeedState(eKateSpeed_FleeSprint);
		}
		
		mpMover.SetIdleAnimName("idle_hurt");
		mpMover.SetWalkAnimName("move_hurt");
		mpMover.SetRunAnimName("move_hurt");
	}
	
	//------------------------------------------------------------
	
	void _Global_Scare()
	{
		if (mfScaredTimer <= 0 && mbSoundsDisabled==false)
		{
			mBaseObj.PlaySound("ScaredKate", gsScaredSound, true, true);
		}
		mfScaredTimer = 1;
	}
	
	//------------------------------------------------------------
	
	void _Global_Crash()
	{
		tString sCrashEnt = cScript_GetGlobalArgString(0);
		if (Entity_Exists(sCrashEnt))
		{
			mvCrashPos = Map_GetEntity(sCrashEnt).GetPosition();
		}
		mpStateMachine.ChangeState(eKateState_Crash);
		mpPathfinder.SetEndOfPathCallbackFunc(cScript_GetGlobalArgString(1));
	}
		
	//------------------------------------------------------------
	
	void _Global_Weld()
	{
		msWeldFlare = cScript_GetGlobalArgString(0);
		
		/////////////////////////////
		// Get the target entities
		tString sTargetPrefix = cScript_GetGlobalArgString(1);
		mvWeldTargets.resize(0);
		tID id_ent = Map_GetEntityID(sTargetPrefix+"_1", eLuxEntityType_LastEnum, "");
		for (int i = 2; id_ent != tID_Invalid; i++)
		{
			mvWeldTargets.push_back(id_ent);
			id_ent = Map_GetEntityID(sTargetPrefix+"_"+i, eLuxEntityType_LastEnum, "");
		}
		
		msWeldExitNode = cScript_GetGlobalArgString(2);
		msWeldCallback = cScript_GetGlobalArgString(3);
		mfWeldSpeedMul = cScript_GetGlobalArgFloat(4);
		
		mpStateMachine.ChangeState(eKateState_Weld);
	}
		
