#include "script/Prop_Terminal.hps"
#include "helpers/helper_player.hps"

class cScrPropTerminal_Phone : cScrPropTerminal
{
	
	void Init()
	{
		mfTimeToAnimate = 1.0f;
		mfAniTimer = 0.0f;
		mbHasPickedupPhone = false;
		mbPhoneActivated = false;
	}
	
	void _Global_Pickup()
	{
		///////////////
		//Calcs initial position to the phone when picking it up from "pocket".
		cVector3f vInitialPos = cLux_GetPlayer().GetCamera().GetPosition();
		vInitialPos -= cLux_GetPlayer().GetCamera().GetUp();
		InternalPickup(vInitialPos, 1.6f);
	}
	
	void _Global_PickupFromOrient()
	{
		///////////////
		//Set initial orientation to the phone. If in eg. the phone is on a table instead of in "pocket".
		cMatrixf mtxInitOrientation = cScript_GetGlobalArgMatrix(0);
		mBaseObj.SetMatrix(mtxInitOrientation);
		InternalPickup(mtxInitOrientation.GetTranslation(), 1.0f);
	}
	
	void _Global_PutPhoneToEar()
	{
		InternalPutToEar();
	}
	
	void OnUpdate(float afTimeStep)
	{
		///////////////
		//Count timer till terminal activation when player has pickedup phone.
		/*if(mbHasPickedupPhone && !mbPhoneActivated)
		{
			mfAniTimer += afTimeStep;
			if(mfAniTimer > mfTimeToAnimate)
			{
				ActivatePhoneTerminal();
			}
		}
		
		if(mbHasAnsweredPhone)
		{
			mfAniTimer += afTimeStep;
			if(mfAniTimer > mfTimeToAnimate)
			{
				mBaseObj.SetActive(false);
				mbHasAnsweredPhone = false;
			}
		}*/
	}

	void InternalPickup(cVector3f avInitialPos, float afTimeToAnimate)
	{
		Player_SetActive(false);
		///////////////
		//Calcs goal position which is infront of the players camera.
		mvGoalPos = cLux_GetPlayer().GetCamera().GetPosition();
		mvGoalPos += cLux_GetPlayer().GetCamera().GetForward() * 0.15f;
		
		cVector3f vAngles = cMath_GetAngleFromPoints3D(cVector3f(0,0,0), cLux_GetPlayer().GetCamera().GetForward());
		cMatrixf mtxRot = cMath_MatrixRotateXYZ(vAngles);
	
		///////////////
		//Moves the phone to the goal position and its goal rotation.
		mBaseObj.MoveAngularTo(mtxRot, 4.5f, 4.0f, 0.01f, false, false, cVector3f(0,0,0), cVector3f(0,0,0));
		mBaseObj.SetPosition(avInitialPos);
		mBaseObj.MoveLinearTo(mvGoalPos, 5.0f, 3.0f, 0.1f, false);
		mfAniTimer = 0.0f;
		mfTimeToAnimate = afTimeToAnimate;
		mbHasPickedupPhone = true;
		mbPhoneActivated = false;
	}
	
	void InternalPutToEar()
	{
		cVector3f vOldPosition = mBaseObj.GetPosition();
		///////////////
		//Calcs goal position which is to the right of the players camera.
		mvGoalPos = cLux_GetPlayer().GetCamera().GetPosition();
		mvGoalPos += cLux_GetPlayer().GetCamera().GetRight() * 0.15f;
		
		cVector3f vAngles = cMath_GetAngleFromPoints3D(cVector3f(0,0,0), cLux_GetPlayer().GetCamera().GetRight());

		cMatrixf mtxRot = cMath_MatrixRotateXYZ(vAngles);
		cMatrixf mtxRot2 = cMath_MatrixRotateZ(20.0f); 
		
		///////////////
		//Moves the phone to the goal position and its goal rotation.
		mBaseObj.MoveAngularTo(mtxRot, 4.5f, 4.0f, 0.01f, false, false, cVector3f(0,0,0), cVector3f(0,0,0));
		mBaseObj.MoveAngularTo(mtxRot2, 10.5f, 8.0f, 0.01f, false, false, cVector3f(0,0,0), cVector3f(0,0,0));
		mBaseObj.SetPosition(vOldPosition);
		mBaseObj.MoveLinearTo(mvGoalPos, 3.5f, 3.0f, 0.1f, false);
		mfAniTimer = 0.0f;
		mfTimeToAnimate = 0.5f;
		mbHasAnsweredPhone = true;
	}
	
	void ActivatePhoneTerminal()
	{
		///////////////
		//OnInteract activates the terminal.
		iPhysicsBody@ pBody = mBaseObj.GetBodyFromName("Body_1");
		
		mBaseObj.OnInteract(1, pBody, mBaseObj.GetPosition(), "");
		
		mbPhoneActivated = true;
		
	}
	
	cVector3f mvGoalPos;
	bool mbHasPickedupPhone;
	bool mbHasAnsweredPhone;
	bool mbPhoneActivated;
	float mfAniTimer;
	float mfTimeToAnimate;
}