#include "base/HeroStatsHandler_Types.hps"
#include "helpers/helper_game.hps"

//-------------------------------------------------------

class cUtility_Datamine
{
	//------------------------------------------------------------
	
	void Init(	iLuxEntity@ pSourceEntity, cLuxProp@ pEffectProp, cResourceVarsObject@ apInstanceVars, 
				bool abIsBlackBox, bool abStopAllVoices = false)
	{
		//////////////////////////
		// Set entity
		if(pEffectProp !is null)
			mid_EffectProp = pEffectProp.GetID();
		else
			mid_EffectProp = tID_Invalid;
		
		mid_SourceEntity = pSourceEntity.GetID();
		
		//////////////////////////
		// Properties
		mbGlowActive = apInstanceVars.GetVarBool("DatamineGlow", false);
		if (mbGlowActive)
		{
			//if(pEffectProp !is null)
			//	pEffectProp.SetHighlightEffectActive(true);
		}
		msRangeArea = apInstanceVars.GetVarString("RangeArea", "");
			
		//////////////////////////
		// Callbacks
		msFinalSubjectCallback = apInstanceVars.GetVarString("FinalSubjectCallback", "");
		msDatamineDoneCallback = apInstanceVars.GetVarString("DataminingDoneCallback", "");
		
		//////////////////////////
		// Pages
		for (int i = 1; i <= 6; i++)
		{
			tString sSubject = apInstanceVars.GetVarString("Page_" + i + "_VoiceSubject", "");
			tString sCategory = apInstanceVars.GetVarString("Page_" + i + "_TextCategory", "");
			tString sEntry = apInstanceVars.GetVarString("Page_" + i + "_TextEntry", "");
			tString sImage = apInstanceVars.GetVarString("Page_" + i + "_Image", "");
			
			if (sSubject == "" && sCategory == "" && sEntry == "" && sImage == "") 
				continue;
			
			mvPageSubjects.push_back(sSubject);
			mvPageTextCategories.push_back(sCategory);
			mvPageTextEntries.push_back(sEntry);
			mvPageImages.push_back(sImage);
		}		
		
		mbStopAllVoices = abStopAllVoices;
	}
	
	//------------------------------------------------------------
	
	void AddToHandler()
	{
		cScript_SetGlobalArgID(0, mid_SourceEntity);
		cScript_SetGlobalArgBool(1, mbIsBlackbox);
		cScript_RunGlobalFunc("DatamineHandler", "cScrDatamineHandler", "_Global_AddDatamine");
	}
	
	//------------------------------------------------------------
	
	void SetEffectProp(cLuxProp@ apEffectProp)
	{
		mid_EffectProp = apEffectProp.GetID();
		//apEffectProp.SetHighlightEffectActive(mbGlowActive);
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
		cScript_SetGlobalArgID(0, mid_SourceEntity);
		cScript_RunGlobalFunc("DatamineHandler", "cScrDatamineHandler", "_Global_RemoveDatamine");
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		
	}
	
	//------------------------------------------------------------
	
	void SetGlowActive(bool abX)
	{
		if(mid_EffectProp == tID_Invalid) return;
		
		//cLux_ID_Prop(mid_EffectProp).SetHighlightEffectActive(mbGlowActive && abX && (!mbInteractionDone) );
	}
	
	//------------------------------------------------------------
	
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		if (cLux_ID_Entity(mid_SourceEntity).IsInteractedWith()) return false;		
				
		tString strAlreadyUsedVarName = "EntityInteract"+mid_SourceEntity;
				bool bAlreadyUsed = cScript_GetGlobalVarBool(strAlreadyUsedVarName);
		if ( !bAlreadyUsed )
		{
			cScript_SetGlobalVarBool(strAlreadyUsedVarName, true);
			HeroStat_IncreaseAmount(eHeroStats_RetrievedVoiceFiles,1);
		}
		
		/////////////////////
		// Base variables
		cScript_SetGlobalArgID(0, mid_SourceEntity);
		
		cScript_SetGlobalArgString(1, msFinalSubjectCallback);
		cScript_SetGlobalArgString(2, msDatamineDoneCallback);
		cScript_SetGlobalArgString(3, msRangeArea);
		cScript_SetGlobalArgBool(4, mbStopAllVoices);
		
		/////////////////////
		// Pages
		cScript_SetGlobalArgInt(5, mvPageTextCategories.length());
		for (int i = 0; i < mvPageTextCategories.length(); i++)
		{
			cScript_SetGlobalArgString(i*4 + 6, mvPageSubjects[i]);
			cScript_SetGlobalArgString(i*4 + 7, mvPageTextCategories[i]);
			cScript_SetGlobalArgString(i*4 + 8, mvPageTextEntries[i]);
			cScript_SetGlobalArgString(i*4 + 9, mvPageImages[i]);
		}
		
		/////////////////////
		// Call Begin
		cScript_RunGlobalFunc("DatamineHandler", "cScrDatamineHandler", "_Global_BeginDatamining");
				
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		if (cLux_ID_Entity(mid_SourceEntity).IsInteractedWith())
			return eCrossHairState_None;
			
		return eCrossHairState_Datamine;
	}
	
	//------------------------------------------------------------
	
	void AfterScan()
	{
		mbInteractionDone = true;
		
		// TODO: Temp datamine glow
		if (mbGlowActive && mid_EffectProp != tID_Invalid)
		{
			//cLux_ID_Prop(mid_EffectProp).SetHighlightEffectActive(false);
		}
	}
	
	//------------------------------------------------------------
	
	tID mid_SourceEntity;
	tID mid_EffectProp;
	
	bool mbInteractionDone = false;
	bool mbIsBlackbox = false;
	bool mbGlowActive = false;
	tString msRangeArea;
	bool mbStopAllVoices = false;
	
	tString msFinalSubjectCallback;
	tString msDatamineDoneCallback;
	[nosave] array<tString> mvPageSubjects;
	[nosave] array<tString> mvPageTextCategories;
	[nosave] array<tString> mvPageTextEntries;
	[nosave] array<tString> mvPageImages;
			
	//------------------------------------------------------------
}


//-------------------------------------------------------

