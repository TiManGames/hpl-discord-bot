#include "interfaces/Critter_Interface.hps"

class cScrCritterCaveSpider : iScrCritter, iScrCritter_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		mfNormalSpeed = apVars.GetVarFloat("NormalSpeed",0.5);
		mfIdleTime = apVars.GetVarFloat("IdleTime",5);
		mfMoveTime = apVars.GetVarFloat("MoveTime",8);
		
		mBaseObj.mlAnimState = 0; //Moving
		mBaseObj.SetIsFlying(false);
		mBaseObj.SetUseRayCollision(false);
		mBaseObj.SetAlignToGround(true);
		mBaseObj.SetCanRunOnWalls(true);
		mBaseObj.mfMaxTurnSpeed = 2.0f;
		mBaseObj.mfTurnSpeedMul = 3.0f;
		
		mlMoveState = 0;
		mfStateCount =cMath_RandRectf(0,2);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep)
	{
		///////////////////////////////
		//Gravity
		mBaseObj.mvGravityVel += mBaseObj.mvGroundNormal*-9.0f*afTimeStep;
		
		/////////////////////////////////////////
		// Move normal

		///////////////////////////////
		//Move state count
		mfStateCount -= afTimeStep;
		if(mfStateCount < 0)
		{
			mfStateCount = 	mlMoveState==0 ? 	cMath_RandRectf(mfMoveTime-mfMoveTime*0.5, mfMoveTime+mfMoveTime*0.5): 
												cMath_RandRectf(mfIdleTime-mfIdleTime*0.5, mfIdleTime+mfIdleTime*0.5);
			mlMoveState = mlMoveState==0 ? 1 :0;
			
			if(mlMoveState == 1)
			{
				//Give a push in a idrection to avoid some shaking.
				mBaseObj.mvWantedVel += mBaseObj.Move_GetWanderAdd2D(0,50, afTimeStep);
			}
		}
				
		///////////////////////////////
		//Movement
		if(mlMoveState == 1)
		{
			mBaseObj.mvWantedVel += mBaseObj.Move_GetWanderAdd2D(0.6,0.5, afTimeStep)*0.5f;
			mBaseObj.mvWantedVel += mBaseObj.Move_GetFlockingAdd(0.1f,1, //Center and CenterYMul
												1, //Separation
												0, //Alignment
												0, //Cohesion
												4, //Max group member checks
												afTimeStep);
	
		}
		///////////////////////////////
		//Standing still
		else
		{
			mBaseObj.mvWantedVel += mBaseObj.Move_GetStopAdd(4, afTimeStep);
		}
		
		mBaseObj.Move_ChangeMaxSpeed(mfNormalSpeed, 3, afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
		
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(float afAmount, int alStrength, const tString&in asType, const tString&in asSource)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] float mfNormalSpeed;
	[nosave] float mfIdleTime;
	[nosave] float mfMoveTime;
	
	//------------------------------------------------------------
	
	int mlMoveState; //0=stop, 1=move
	float mfStateCount;
	
	//------------------------------------------------------------
		
}	