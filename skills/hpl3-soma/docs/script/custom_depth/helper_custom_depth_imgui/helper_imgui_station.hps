int StationGui_GetActiveApp(const tString &in asEntityName, int alDefaultApp = -1)
{
	return Terminal_GetImGuiStateInt(asEntityName, "StationGui_ActiveApp", alDefaultApp);
}

//-------------------------------------------------------

void StationGui_SetActiveApp(int alAppIndex)
{
	ImGui_SetStateInt("StationGui_ActiveApp", alAppIndex);
}

//-------------------------------------------------------

void StationGui_SetActiveApp(const tString &in asEntityName, int alAppIndex)
{
	Terminal_SetImGuiStateInt(asEntityName, "StationGui_ActiveApp", alAppIndex);
}

//-------------------------------------------------------

void StationGui_DrawAppIcon(const tString &in asIcon)
{
	ImGui_DoImageCorrectAspect(cImGuiGfx(asIcon), ImGui_NrmPosGroup(cVector3f(0, 1, 1.1))+ImGui_NrmPos(0.015, -0.1375, 0), ImGui_NrmSize(0.0875, 0.175));
}
	
//-------------------------------------------------------

/**
 * Draws a default back button.
 * 
 * @param abEnabled, if the button should be possible to click. Defaults to true.
 * @param alState, state to set when button is pressed. Defaults to -1.
 * 
 * @return bool, if button was pressed.
 **/
bool StationGui_BackButton(bool abEnabled = true, int alState = -1, bool abSound = true)
{	
	bool bPressed = _StationGui_BackButton(_StationGui_CreateBackButton(false), abEnabled, alState, ImGui_NrmPosGroup(0.005, 0.9095, 4), ImGui_NrmSizeGroup(0.205, 0.083334),
										   ImGui_NrmPosGroup(0.145, 0.929, 0.3), ImGui_NrmSizeGroup(0.06));
	
	if (bPressed && abSound)
	{
		Depth_Audio_Terminal_Back(ImGui_GetName());
	}
	
	return bPressed;
}

/**
 * Draws a default back button for datapads.
 * 
 * @param abEnabled, if the button should be possible to click. Defaults to true.
 * @param alState, state to set when button is pressed. Defaults to -1.
 * 
 * @return bool, if button was pressed.
 **/
bool StationGui_DatapadBackButton(bool abEnabled = true, int alState = -1, bool abSound = true)
{	
	bool bPressed = _StationGui_BackButton(_StationGui_CreateBackButton(true), abEnabled, alState, ImGui_NrmPosGroup(0.05, 0.8975, 4), ImGui_NrmSizeGroup(0.32, 0.083334),
										   ImGui_NrmPosGroup(0.295, 0.91, 5), ImGui_NrmSizeGroup(0.06));
	
	if (bPressed && abSound)
	{
		Depth_Audio_Datapad_Back(ImGui_GetName());
	}
	
	return bPressed;
}
	
//-------------------------------------------------------

bool _StationGui_BackButton(const cImGuiButtonData &in aButton, bool abEnabled, int alState, const cVector3f vPos, const cVector2f vSize, 
							const cVector3f vOrnamentPos, const cVector2f vOrnamentSize)
{
	tString sPrevTransCat = ImGui_GetTransCategory();
	ImGui_SetTransCategory("GUI");
	
	cImGuiGfx gfx_button_ornament("station/chinsymbol/big_default_exit");		
	
	if (abEnabled==false) gfx_button_ornament.mColor.a = 0.2;
	ImGui_SetModUseInput(abEnabled);
	ImGui_SetModUISizeHoriExpansion(0, 4.8);
	bool bPressed = ImGui_DoButtonExt("BackButton", "Back", aButton, vPos, vSize);
	ImGui_SetModUISizeHoriExpansion(0, 0);

	ImGui_SetModUseInput(true);
	
	if (bPressed)
	{
		ImGui_SetStateInt("StationGui_ActiveApp", alState);
	}
	
	ImGui_DoImageCorrectAspect(gfx_button_ornament, vOrnamentPos, vOrnamentSize);
	
	ImGui_SetTransCategory(sPrevTransCat);
	return bPressed;
}
	
//-------------------------------------------------------

cImGuiButtonData _StationGui_CreateBackButton(bool abDatapad)
{
	cImGuiButtonData button = StationGui_CreateDefaultButtonData();
	
	if(ImGui_NrmSize(0.083334).y < 64)
	{
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/small_corner_slanted_bottomleft");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/small_corner_slanted_topleft");
		if (abDatapad) button.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/small_corner_bottomright");
	}
	else
	{
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/big_corner_slanted_bottomleft");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/big_corner_slanted_topleft");
		if (abDatapad) button.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/big_corner_bottomright");
	}

	button.mFontAlign = eFontAlign_Center;
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.047);
	
	return button;
}

//-------------------------------------------------------

int StationGui_FileList(const tString &in asCaption, int alFileCount, const cVector3f &in avPos = cVector3f_Zero, const cVector2f &in avSize = ImGui_NrmSizeGroup(cVector2f(0.35, 0.875)))
{		
	cImGuiButtonData toggleButton = StationGui_CreateToggleButtonData();
	toggleButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0375);
	
	int lSelectedFile = -1;
	
	ImGui_DoWindowStart(asCaption, StationGui_CreateDefaultWindowData(), avPos, avSize);
	if (alFileCount > 0)
	{
		lSelectedFile = ImGui_DoMultiToggleExt("FileSelection", -1, 1, ImGui_NrmSizeGroup(cVector2f(0, 0.02)), toggleButton, 
												ImGui_NrmPosGroup(cVector3f(0.05, 0.045, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, cMath_Min(1.f, 0.135*alFileCount))));
		lSelectedFile++;
	}
	ImGui_DoWindowEnd();
	
	return lSelectedFile;
}
	
//-------------------------------------------------------

int StationGui_FileList(int alFileCount, int alDefaultSelection = 0, const cVector3f &in avPos = ImGui_NrmPosGroup(0.02, 0.03, 1), const cVector2f &in avSize = ImGui_NrmSizeGroup(0.30, 0.9))
{
	return StationGui_FileList(alFileCount, ImGui_GetName(), alDefaultSelection, avPos, avSize);
}
	
//-------------------------------------------------------

int StationGui_FileList(int alFileCount, const tString &in asName, int alDefaultSelection = 0, const cVector3f &in avPos = ImGui_NrmPosGroup(0.02, 0.03, 1), const cVector2f &in avSize = ImGui_NrmSizeGroup(0.30, 0.9), float afNrmButtonHeight = 0.1f)
{
	cImGuiButtonData button = StationGui_CreateToggleButtonData();
	button.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Additive));
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	
	ImGui_GroupBegin(avPos, avSize);
		float fButtonHeight = afNrmButtonHeight;
		float fButtonSpace = 0.05f;
		float fListHeight = (fButtonHeight+fButtonSpace)*(alFileCount-1)+fButtonHeight;
		
		int lSelection = ImGui_DoMultiToggleExt(asName+"_FileList", alDefaultSelection, 1, ImGui_NrmSizeGroup(0, fButtonSpace), button, 
												ImGui_NrmPosGroup(0, 0, 1), ImGui_NrmSizeGroup(0.93, fListHeight));
												
		cImGuiGfx gfx_line("stationV2/misc/GUI_line");
		ImGui_DrawLineExt(ImGui_NrmPos2Group(1, 0, true), ImGui_NrmPos2Group(1, 1, true), 2.1, ImGui_NrmSize(0.004).x, gStationGuiColor_Normal, gfx_line);
	ImGui_GroupEnd();
	
	return lSelection;
}
	
