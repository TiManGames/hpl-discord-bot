//-------------------------------------------------------

/////////////////////////////////////////
// DATA RESTORATION
/////////////////////////////////////////

//-------------------------------------------------------

class cStationGui_DataRestorationSettings
{
	tString msCustomMsgEntry_Error;
	tString msCustomMsgEntry_Progress;
	tString msCustomMsgEntry_Result;
	
	tString msCustomSuccessSound;
	bool mbUseSuccessSound = true;
	
	bool mbAutoUpdateOutOfView = false;
}

//-------------------------------------------------------
		
bool StationGui_DataRestoration(int alFileCount, float fLoadTime, int &out alRestoredFiles, 
								cStationGui_DataRestorationSettings aSettings = cStationGui_DataRestorationSettings())
{
	int lFileRebuildState = ImGui_GetStateInt("DataRestorationState", 0);
	
	///////////////////
	// Check if done
	if (lFileRebuildState == 3)
	{
		alRestoredFiles = alFileCount;
		return true;
	}
	
	///////////////////
	// Setup
	tString sCurrentTransCat = ImGui_GetTransCategory();
	ImGui_SetTransCategory("StationGUI");

	cImGuiButtonData button = StationGui_CreateDefaultButtonData();
	
	///////////////////
	// Dialog window
	bool bDone = false;
	
	cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
	dialogBox.mfZ = 6;
	dialogBox.mType = eGuiDialogBoxType_OK;
	dialogBox.mbEndWindow = false;
	
	tString sText = "";
	if (lFileRebuildState==0)
	{
		ImGui_SetTransCategory(aSettings.msCustomMsgEntry_Error == "" ? "StationGUI" : sCurrentTransCat);
		sText = aSettings.msCustomMsgEntry_Error == "" ? "CorruptedData_Detected" : aSettings.msCustomMsgEntry_Error;
		alRestoredFiles = 0;
	}
	else if (lFileRebuildState==1)
	{
		ImGui_SetTransCategory(aSettings.msCustomMsgEntry_Progress == "" ? "StationGUI" : sCurrentTransCat);
		sText = aSettings.msCustomMsgEntry_Progress == "" ? "CorruptedData_Restoring" : aSettings.msCustomMsgEntry_Progress;
		dialogBox.mType = eGuiDialogBoxType_NoButton;
	}
	else if (lFileRebuildState==2)
	{
		ImGui_SetTransCategory(aSettings.msCustomMsgEntry_Result == "" ? "StationGUI" : sCurrentTransCat);
		sText = aSettings.msCustomMsgEntry_Result == "" ? "CorruptedData_Results" : aSettings.msCustomMsgEntry_Result;
		alRestoredFiles = alFileCount;
	}
	ImGui_SetTextOverride(ImGui_Translate(sText));
	ImGui_SetTransCategory("StationGUI");
		
	eGuiDialogCode returnCode;
	returnCode = Depth_ImGui_DialogBox("Error", "", dialogBox);
	ImGui_ClearTextOverride();
		if (lFileRebuildState==1)
		{
			if (Depth_ImGui_LoadingGauge("FileRebuild", fLoadTime, false, ImGui_NrmPosGroup(cVector3f(0.1, 0.5, 1)), 
										 ImGui_NrmSizeGroup(cVector2f(0.8, 0.3)), StationGui_CreateDefaultGaugeData()))
			{
				ImGui_IncStateInt("DataRestorationState", 1);
				Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), false);
				
				if (aSettings.mbUseSuccessSound && aSettings.msCustomSuccessSound=="")
					Depth_Audio_Terminal_Confirm(ImGui_GetName());
				else if (aSettings.mbUseSuccessSound)
					Sound_CreateAtEntity("FileRebuildSuccess", aSettings.msCustomSuccessSound, ImGui_GetName());
			}
			alRestoredFiles = int(Depth_ImGui_GetLoadingValue("FileRebuild")*float(alFileCount));
		}
	ImGui_DoWindowEnd();
	
	if (returnCode == eGuiDialogCode_OK)
	{
		ImGui_IncStateInt("DataRestorationState", 1);
		if (lFileRebuildState == 0 && aSettings.mbAutoUpdateOutOfView)
			Terminal_SetUpdateWhenOutOfView(ImGui_GetName(), true);
	}
	
	ImGui_SetTransCategory(sCurrentTransCat);
	
	return ImGui_GetStateInt("DataRestorationState", 0) == 3;
}
	
//-------------------------------------------------------

/////////////////////////////////////////
// MAPS
/////////////////////////////////////////
	
//-------------------------------------------------------

void StationGui_YouAreHereIcon(const cVector3f &in avPos, const cVector2f &in avSize)
{
	cImGuiGfx location = cImGuiGfx("map_tau_location");
	
	// Init rotation
	if (ImGui_GetStateBool("LocationRotationStarted", false)==false)
	{
		ImGui_FadeStateFloat("LocationAnim", 360, 6, eEasing_Linear, false);
		ImGui_SetStateBool("LocationRotationStarted", true);
	}
	
	// Repeat rotation
	if (ImGui_FadeOver("LocationAnim") || ImGui_IsFading("LocationAnim")==false)
	{
		ImGui_SetStateFloat("LocationAnim", 0);
		ImGui_FadeStateFloat("LocationAnim", 360, 6, eEasing_Linear, true);
	}

	ImGui_SetAlignment(eImGuiAlign_CenterCenter);
	ImGui_SetModRotateAngle(ImGui_GetStateFloat("LocationAnim", 0));
	ImGui_DoImageCorrectAspect(location, avPos, avSize);
	ImGui_SetModRotateAngle(0);
	
	ImGui_SetAlignment(eImGuiAlign_TopLeft);
}
