////////////////////////////////////////////////////////
// STATION HELPERS
////////////////////////////////////////////////////////

//-------------------------------------------------------

// Window
void StationGui_DoWindowStart(const tString &in asCaption, const cImGuiWindowData &in aWindow, const cVector3f &in avPos, const cVector2f &in avSize, bool abDrawOrnaments, bool abClip=false)
{
	if(abDrawOrnaments)
	{
		// Draw inside a group so we can take advantage of the NrmPos func
		// and before opening the window cos we dont want the padding to be active
		ImGui_GroupBegin(avPos, avSize);
		
			//Window ornaments
			StationGuiBG_OrnamentTopRight("station/ornament/corner_topright", cVector2f(50), eImGuiSizeType_CorrectAspectWidth, cColor(1,1), cVector2f(2,2), -0.1f);
			StationGuiBG_OrnamentBottomLeft("station/ornament/corner_bottomleft", cVector2f(50), eImGuiSizeType_CorrectAspectWidth, cColor(1,1), cVector2f(2,2), -0.1f);
						
			cColor chinCol = gStationGuiColor_Normal2 * cColor(1.0f,0.6f);
			StationGuiBG_OrnamentTopRight("station/chinsymbol/small_default_exit", cVector2f_MinusOne, eImGuiSizeType_Default, chinCol, cVector2f(5,5), 0.1f);
			StationGuiBG_OrnamentBottomLeft("station/chinsymbol/small_default_help", cVector2f_MinusOne, eImGuiSizeType_Default, chinCol, cVector2f(5,2), 0.1f);
		
		ImGui_GroupEnd();
	}
	
	ImGui_DoWindowStart(asCaption, aWindow, avPos, avSize, abClip);
	
	// debug: makes the group rect visible
	// ImGui_DrawFrame(aWindow.mGfxWindowData, ImGui_GetCurrentGroupPos()+cVector3f(0,0,1),ImGui_GetCurrentGroupSize(), cColor(2,0,0,1));
}

//-------------------------------------------------------

void StationGui_DoWindowEnd()
{
	ImGui_DoWindowEnd();
}		
	
