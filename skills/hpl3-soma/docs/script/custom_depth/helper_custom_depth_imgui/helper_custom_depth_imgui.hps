/////////////////////////////////////////
// SCREENSAVER
/////////////////////////////////////////

//-------------------------------------------------------

class cGuiScreenSaverSettings
{
	cImGuiGfx mCenterGfx;
	cVector2f mvCenterGfxNrmSize = cVector2f_One;
	cImGuiGfx mFullscreenGfx;
	float mfTime;
	bool mbStartOn;
}

//-------------------------------------------------------

bool Depth_ImGui_ScreenSaver(const cGuiScreenSaverSettings &in aSettings)
{
	bool bActive = ImGui_GetStateBool("ScreensaverOn", aSettings.mbStartOn);
	
	if (bActive == false)
	{
		if (ImGui_InFocus())
			ImGui_SetStateFloat("ScreensaverTimeOut", aSettings.mfTime);
		else
			ImGui_IncStateFloat("ScreensaverTimeOut", ImGui_GetTimeStep()*-1);
		
		float fTime = ImGui_GetStateFloat("ScreensaverTimeOut", aSettings.mfTime);
		
		if (fTime <= 0)
		{
			ImGui_SetStateBool("ScreensaverOn", true);
			ImGui_FadeStateFloat("ScreensaverAlpha", 1, 0.3);
		}
	}
	else
	{
		if (ImGui_InFocus())
		{
			ImGui_SetStateBool("ScreensaverOn", false);
			ImGui_FadeStateFloat("ScreensaverAlpha", 0, 0.3);
		}
	}
	
	float fAlpha = ImGui_GetStateFloat("ScreensaverAlpha", aSettings.mbStartOn ? 1 : 0);
	if (fAlpha > 0) 
	{
		ImGui_SetModColorMul(cColor(1, 1, 1, fAlpha));
		ImGui_DoImage(aSettings.mFullscreenGfx, cVector3f(0, 0, 9.5), ImGui_NrmSizeGroup(1));
		ImGui_SetAlignment(eImGuiAlign_CenterCenter);
		ImGui_DoImage(aSettings.mCenterGfx, ImGui_NrmPosGroup(0.5, 0.5, 9.6), 
					  ImGui_GetRatioCorrectSizeByRect(aSettings.mCenterGfx, ImGui_NrmSizeGroup(aSettings.mvCenterGfxNrmSize)));
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
		ImGui_SetModColorMul(cColor_White);
	}
	
	return bActive && ImGui_IsFading("ScreensaverAlpha")==false;
}

