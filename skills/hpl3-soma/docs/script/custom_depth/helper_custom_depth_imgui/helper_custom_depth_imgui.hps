//-------------------------------------------------------

enum eGuiDialogBoxType
{
	eGuiDialogBoxType_NoButton,
	eGuiDialogBoxType_OK,
	eGuiDialogBoxType_OKCancel,
}

//-------------------------------------------------------

enum eGuiDialogCode
{
	eGuiDialogCode_None,
	eGuiDialogCode_OK,
	eGuiDialogCode_Cancel,
}

//-------------------------------------------------------

class cGuiDialogBoxSettings
{
	float mfZ = 1.5f; //Z-pos of dialog box
	bool mbEndWindow = true; // If ImGui_DoWindowEnd() should be called at the end of the function.
	cVector2f mvSize; //Size of window
	bool mbUseCustomPos = false; // If the dialog box should be placed somehwere else than at the ceneter of the screen.
	cVector3f mvCustomPos; // Custom pos of the dialog box.
	eGuiDialogBoxType mType = eGuiDialogBoxType_NoButton; // Determines what buttons the dialog box should provide.
	bool mbAutoFocus = true; // If the dialog box buttons should automatically get focus. Does nothing for eGuiDialogBoxType_NoButton.
	tString msOKButtonText = "OK";
	tString msCancelButtonText = "Cancel";
	tString msOKButtonTextCat = "GUI";
	tString msCancelButtonTextCat = "GUI";
	
	tString msCustomOKSound = "";
	tString msCustomCancelSound = "";
	
	cImGuiWindowData mWindow;
	cImGuiTextFrameData mTextFrame;
	cImGuiButtonData mButton;
}

//-------------------------------------------------------

eGuiDialogCode Depth_ImGui_DialogBox(const tString&in asCaption, const tString&in asText, const cGuiDialogBoxSettings &in aSettings)
{	
	tString sCurrentTransCat = ImGui_GetTransCategory();
	
	bool bAutoFocus = aSettings.mbAutoFocus && ImGui_GetStateBool("DialogBoxAutoFocus", true);
	
	///////////////////////////////////////
	// Show message 
	cVector3f vPos; 
	if (aSettings.mbUseCustomPos)
		vPos = aSettings.mvCustomPos;
	else
	{
		cVector2f vScreenSize = ImGui_GetSize();
		vPos.x = (vScreenSize.x-aSettings.mvSize.x)*0.5;
		vPos.y = (vScreenSize.y-aSettings.mvSize.y)*0.5;
		vPos.z = aSettings.mfZ;
	}
	
	eGuiDialogCode returnCode = eGuiDialogCode_None;
	ImGui_DoWindowStart(asCaption, aSettings.mWindow, vPos,aSettings.mvSize);
		
		ImGui_DoTextFrameExt(asText, 0, 0, 0, aSettings.mTextFrame, 
								 ImGui_NrmPosGroup(0.0, 0.0,1), ImGui_NrmSizeGroup(1));
				
		ImGui_SetTransCategory("GUI");
		ImGui_SetAlignment(eImGuiAlign_CenterCenter); 
		if (aSettings.mType == eGuiDialogBoxType_OK)
		{
			ImGui_SetTransCategory(aSettings.msOKButtonTextCat);
			ImGui_ResizeFontToFit(ImGui_Translate(aSettings.msOKButtonText), aSettings.mButton.mFont, aSettings.mButton.mvDefaultSize.x*0.85);
			if (ImGui_DoButtonExt("DialogOK", aSettings.msOKButtonText, aSettings.mButton, 
								  ImGui_NrmPosGroup(cVector3f(0.5, 1, 1))-cVector3f(0, aSettings.mButton.mvDefaultSize.y*0.5, 0)))
			{
				returnCode = eGuiDialogCode_OK;
			}
			ImGui_SetTransCategory("GUI");
			
			if (bAutoFocus)
			{
				if (ImGui_ActionIsDown(eImGuiAction_MouseLeft)==false && ImGui_InFocus())
					ImGui_SetFocus("DialogOK");
				ImGui_SetStateBool("DialogBoxAutoFocus", false);
			}
		}
		else if (aSettings.mType == eGuiDialogBoxType_OKCancel)
		{
			ImGui_SetTransCategory(aSettings.msOKButtonTextCat);
			ImGui_ResizeFontToFit(ImGui_Translate(aSettings.msOKButtonText), aSettings.mButton.mFont, aSettings.mButton.mvDefaultSize.x*0.85);
			if (ImGui_DoButtonExt("DialogOK", aSettings.msOKButtonText, aSettings.mButton, 
								  ImGui_NrmPosGroup(cVector3f(0.25, 1, 1))-cVector3f(0, aSettings.mButton.mvDefaultSize.y*0.5, 0)))
			{
				returnCode = eGuiDialogCode_OK;
			}
			ImGui_SetTransCategory(aSettings.msCancelButtonTextCat);
			ImGui_ResizeFontToFit(ImGui_Translate(aSettings.msCancelButtonText), aSettings.mButton.mFont, aSettings.mButton.mvDefaultSize.x*0.85);
			if (ImGui_DoButtonExt("DialogCancel", aSettings.msCancelButtonText, aSettings.mButton, 
								  ImGui_NrmPosGroup(cVector3f(0.75, 1, 1))-cVector3f(0, aSettings.mButton.mvDefaultSize.y*0.5, 0)))
			{
				returnCode = eGuiDialogCode_Cancel;
			}
			ImGui_SetTransCategory("GUI");
			
			if (bAutoFocus)
			{
				if (ImGui_ActionIsDown(eImGuiAction_MouseLeft)==false)
					ImGui_SetFocus("DialogOK");
				ImGui_SetStateBool("DialogBoxAutoFocus", false);
			}
		}
		ImGui_SetAlignment(eImGuiAlign_LastEnum);
		
	// Only close window if mbEndWindow is true
	if (aSettings.mbEndWindow) ImGui_DoWindowEnd();
	
	// Reset autofocus
	if (returnCode != eGuiDialogCode_None)
	{
		ImGui_SetStateBool("DialogBoxAutoFocus", true);
	}
	
	ImGui_SetTransCategory(sCurrentTransCat);
	return returnCode;
}
	
