//-------------------------------------------------------

/////////////////////////////////////////
// LOADING DIALOG BOX
/////////////////////////////////////////

//-------------------------------------------------------

bool StationGui_LoadingWindow(const tString &in asName, const tString &in asCaption, const tString &in asText, float afLoadTime, bool abReset, const cVector2f &in avNrmSize = cVector2f(0.6, 0.2), float afZ=1.5f)
{		
	StationGui_DialogBox_Start(asCaption, asText, avNrmSize, afZ);
		bool bDone = Depth_ImGui_LoadingGauge(asName, afLoadTime, abReset, ImGui_NrmPosGroup(cVector3f(0.1, 0.5, 1)), 
											  ImGui_NrmSizeGroup(cVector2f(0.8, 0.3)), StationGui_CreateDefaultGaugeData());
	StationGui_DialogBox_End();
	
	return bDone;
}

//-------------------------------------------------------

/////////////////////////////////////////
// BIG STATUS MESSAGE
/////////////////////////////////////////

//-------------------------------------------------------

class cStationGui_BigStatusMessageSettings
{
	cStationGui_BigStatusMessageSettings()
	{
		mTextFrameData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
		mTextFrameData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.1);
		mTextFrameData.mFontAlign = eFontAlign_Center;
		mTextFrameData.mFont.mColor = cColor_White;
		mTextFrameData.mColorBase = cColor(0, 0, 0, 0.75);
		
		mvEdgeSpacing = cVector2f_Zero;
		mColor = gStationGuiColor_Warning;
	}
	
	cImGuiTextFrameData mTextFrameData;
	cVector2f mvEdgeSpacing;
	cColor mColor;
	float mfTextSizeMul = 1.0f;
	bool mbBlinking = false;
	float mfBlinkTime = 0.5f;
	eEasing mBlinkEasing = eEasing_Linear;
	bool mbForceFit = true;
}
		 
void StationGui_BigStatusMessage_Old(const tString&in asText, const cColor &in aColor = gStationGuiColor_Warning, float afTextSizeMul = 1.0f, 
							  bool abBlinking = false, float afBlinkTime = 0.5, eEasing aBlinkEasing = eEasing_Linear, 
							  cStationGui_BigStatusMessageSettings &in aSettings = cStationGui_BigStatusMessageSettings())
{
	aSettings.mColor = aColor;
	aSettings.mfTextSizeMul = afTextSizeMul;
	aSettings.mbBlinking = abBlinking;
	aSettings.mfBlinkTime = afBlinkTime;
	aSettings.mBlinkEasing = aBlinkEasing;
	StationGui_BigStatusMessage(asText, aSettings);
}
		 
void StationGui_BigStatusMessage(const tString&in asText, cStationGui_BigStatusMessageSettings &in aSettings = cStationGui_BigStatusMessageSettings())
{
	aSettings.mTextFrameData.mFont.mvSize = aSettings.mTextFrameData.mFont.mvSize*aSettings.mfTextSizeMul;
	aSettings.mTextFrameData.mFont.mColor = aSettings.mColor;
	
	if (aSettings.mbForceFit)
	{
		array<tWString> vRows;
		float fMaxWidth = ImGui_GetCurrentGroupSize().x-(aSettings.mvEdgeSpacing.x*2);
		GetFontWordWrapRows(aSettings.mTextFrameData.mFont, 1, asText, fMaxWidth, vRows);
		
		for(int i = 0; i < vRows.length(); i++)
			ImGui_ResizeFontToFit(vRows[i], aSettings.mTextFrameData.mFont, fMaxWidth);
	}

	cVector2f vSize = ImGui_NrmSizeGroup(1);
	vSize.y = ImGui_GetStateFloat(asText+"_StatusHeight", 0);

	if (aSettings.mbBlinking)
	{
		float fBlinkVal = ImGui_FadeOscillateFloat(asText+"_Blinking", 0.5, 1, aSettings.mfBlinkTime, aSettings.mBlinkEasing);
		aSettings.mTextFrameData.mFont.mColor = aSettings.mTextFrameData.mFont.mColor*fBlinkVal;
	}

	float fOverflow = ImGui_DoTextFrameExt(asText, aSettings.mvEdgeSpacing, 0, 0, aSettings.mTextFrameData, ImGui_NrmPosGroup(0.0, 0.5, 1)-cVector3f_Up*vSize.y*0.5f, vSize);

	// Hack to make text appear at the center of the screen
	if (fOverflow > 0)
	{
		if (vSize.y > 0)
			ImGui_SetStateFloat(asText+"_StatusHeight", 0);
		else
			ImGui_SetStateFloat(asText+"_StatusHeight", aSettings.mTextFrameData.mFont.mvSize.y*fOverflow);
	}
}


	
