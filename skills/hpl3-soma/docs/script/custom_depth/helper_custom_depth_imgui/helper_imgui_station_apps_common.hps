/////////////////////////////////////////
// STATION MAIN MENU
/////////////////////////////////////////

//-------------------------------------------------------

class cStationGui_MainMenuSettings
{
	cStationGui_MainMenuSettings()
	{
		mButton = StationGui_CreateDefaultButtonData();
		mButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(cVector2f(0.05, 0.05));
		
		mButton.mbUseTriggeredColor = false;
		mButton.mbClipText = false;
		mWindow = StationGui_CreateDefaultWindowData();
		mWindow.mGfxWindowData.mGfxCornerBottomRight.SetFile("station/window/sleek_corner_bottomright_alt");
	}
	
	cImGuiButtonData mButton;
	cImGuiWindowData mWindow;
	tString msCustomSound = "";
	float mfEdgePadding = 0.25f;
	float mfButtonHeight = 0.11f;
	bool mbExpandToFitText = true;
}

//-------------------------------------------------------

enum eStationGuiMainMenu
{
	eStationGuiMainMenu_Name = 0,
	eStationGuiMainMenu_Enabled,
	eStationGuiMainMenu_ChangeState,
	eStationGuiMainMenu_App,
}

//-------------------------------------------------------

/**
 * Adds an application to the main menu. Call this before StationGui_MainMenu. 
 * The App List is cleared automatically by StationGui_MainMenu, use StationGui_ClearApps if manual clearing is needed.
 * 
 * @param asName, Name of the app and lang entry used to display it in the menu.
 * @param abEnabled, If the button is enabled, if false it's grayed out and can't be clicked.
 * @param abChangeState, If clicking the button should automatically change the state of the terminal. If true the first app added will change state to 0, the next one to 1 etc.
 **/
array<array<tString>> gvStationGuiApps;
void StationGui_AddApp(const tString &in asName, bool abEnabled=true, bool abChangeState=true)
{
	array<tString> app = {asName, abEnabled, abChangeState, gvStationGuiApps.size()};
	gvStationGuiApps.push_back(app);
}

//-------------------------------------------------------

/**
 * Adds an application to the main menu. Call this before StationGui_MainMenu. 
 * The App List is cleared automatically by StationGui_MainMenu, use StationGui_ClearApps if manual clearing is needed.
 * 
 * @param asName, Name of the app and lang entry used to display it in the menu.
 * @param abEnabled, If the button is enabled, if false it's grayed out and can't be clicked.
 * @param alCustomState, If the app should change to a custom state, not the automatically assigned one.
 **/
void StationGui_AddApp(const tString &in asName, bool abEnabled, int alCustomState)
{
	array<tString> app = {asName, abEnabled, true, alCustomState};
	gvStationGuiApps.push_back(app);
}

//-------------------------------------------------------

/**
 * Clears the list of Apps. Keep in mind that StationGui_MainMenu clears the apps automatically.
 *  
 **/
void StationGui_ClearApps()
{
	gvStationGuiApps.resize(0);
}

//-------------------------------------------------------

/**
 * Draws a default main menu.
 *  
 * @return int, index of button pressed this frame. -1 if no button was pressed.
 **/
int StationGui_MainMenu(const cStationGui_MainMenuSettings &in aSettings = cStationGui_MainMenuSettings())
{
	///////////////////////
	// Data		
	cImGuiLabelData label;
	label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0234375);
	label.mbUseBackgroundGfx = false;
	label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Additive));
	
	cImGuiGfx gfx_menu_ornamentOS("stationV2/background/background_logo_pathOS_small");
	cImGuiGfx gfx_menu_ornament1("station/chinsymbol/big_default_help");
	cImGuiGfx gfx_menu_ornament2("station/chinsymbol/big_default_tools");
	gfx_menu_ornament1.mColor = gStationGuiColor_Normal;
	gfx_menu_ornament2.mColor = gStationGuiColor_Normal;

	tString sName = "";
	bool bEnabled = false;
	bool bChangeState = false;
	int lApp = -1;
		
	int lSelection = -1;
	int lAppCount = gvStationGuiApps.size();
	
	float fWindowWidth = 1.0f-aSettings.mfEdgePadding*2.0f;
	float fButtonWidthNrm = fWindowWidth-0.06;
	
	//////////////////////////////
	// Check if text fits buttons
	float fExtraWidth = 0;
	if (aSettings.mbExpandToFitText)
	{
		float fButtonWidth = ImGui_NrmSize(fButtonWidthNrm).x;
		for (int i=0; i < lAppCount; i++)
		{		
			tString sName = gvStationGuiApps[i][eStationGuiMainMenu_Name];
			float fWidth = GetFontLengthW(aSettings.mButton.mFont, 1, ImGui_Translate(sName));
			if (fWidth <= (fButtonWidth - 40)) continue;
			
			float fPossibleExtraWidth = fWidth-(fButtonWidth - 40);
			if (fPossibleExtraWidth > fExtraWidth)
			{
				fExtraWidth = fPossibleExtraWidth;
			}
		} 
		fWindowWidth += (fExtraWidth/ImGui_GetSize().x);
		fButtonWidthNrm = fWindowWidth-0.06;
	}
	
	/////////////////////////////////////////////////////////////
	// Handle focus when going back to Main Menu from other app
	int lFocusedApp = ImGui_GetStateInt("FocusedApp", -1);
	if (lFocusedApp >= 0 && lFocusedApp < lAppCount)
	{
		if (ImGui_ActionIsDown(eImGuiAction_MouseLeft)==false)
			ImGui_SetFocus(gvStationGuiApps[lFocusedApp][eStationGuiMainMenu_Name]);
		
		ImGui_SetStateInt("FocusedApp", -1);
	}
	
	ImGui_DoWindowStart("", aSettings.mWindow, 
						ImGui_NrmPos(cVector3f(aSettings.mfEdgePadding, 0.2-0.035*lAppCount, 1))-(cVector3f_Right*fExtraWidth*0.5), 
						ImGui_NrmSize(cVector2f(fWindowWidth, 0.25+(aSettings.mfButtonHeight+0.01)*lAppCount)));
	
		
		// Draw buttons
		for (int i=0; i < lAppCount; i++)
		{			
			sName = gvStationGuiApps[i][eStationGuiMainMenu_Name];
			bEnabled = cString_ToBool(gvStationGuiApps[i][eStationGuiMainMenu_Enabled], true);
			bChangeState = cString_ToBool(gvStationGuiApps[i][eStationGuiMainMenu_ChangeState], true);
			lApp = cString_ToInt(gvStationGuiApps[i][eStationGuiMainMenu_App], i);
			
			ImGui_SetModUseInput(bEnabled);
			if (ImGui_DoButtonExt(sName, sName, aSettings.mButton, ImGui_NrmPos(cVector3f(0.03, i*(aSettings.mfButtonHeight+0.0233)+0.025, 1.1)), ImGui_NrmSize(fButtonWidthNrm, aSettings.mfButtonHeight)))
			{
				lSelection = i;
				if (bChangeState)
				{
					ImGui_SetStateInt("FocusedApp", i);
					ImGui_SetStateInt("StationGui_ActiveApp", lApp);
				}
				
				if (aSettings.msCustomSound == "")
					Depth_Audio_Terminal_Forward(ImGui_GetName());
				else
					Sound_CreateAtEntity(ImGui_GetName()+"MenuButton", aSettings.msCustomSound, ImGui_GetName());
			}
				
			ImGui_SetModUseInput(true);
		}
		
		// Ornaments
		tString sCurrentTransCat = ImGui_GetTransCategory();
		ImGui_SetTransCategory("StationGUI");
		ImGui_DoLabelExt("StationGUI_VersionNO", label, ImGui_NrmPosGroup(cVector3f(0.03, 0.89+0.015*lAppCount, 1.1)));
		ImGui_DrawGfx(gfx_menu_ornamentOS, ImGui_NrmPos(cVector3f(aSettings.mfEdgePadding+0.011, 0.337+0.085*lAppCount, 1.1))-cVector3f_Right*fExtraWidth*0.5, ImGui_GetRatioCorrectSizeByWidth(gfx_menu_ornamentOS, 0.2*ImGui_GetSize().x));
		
		float fRightEdge = 1.0f-aSettings.mfEdgePadding;
		ImGui_SetAlignment(eImGuiAlign_TopRight);
		ImGui_DrawGfx(gfx_menu_ornament1, ImGui_NrmPos(fRightEdge-0.095, 0.384+0.085*lAppCount, 1.1)+cVector3f_Right*fExtraWidth*0.5, ImGui_GetRatioCorrectSizeByWidth(gfx_menu_ornament1, 0.0325*ImGui_GetSize().x));
		ImGui_DrawGfx(gfx_menu_ornament2, ImGui_NrmPos(fRightEdge-0.055, 0.33+0.085*lAppCount, 1.1)+cVector3f_Right*fExtraWidth*0.5, ImGui_GetRatioCorrectSizeByWidth(gfx_menu_ornament2, 0.045*ImGui_GetSize().x));
		ImGui_SetTransCategory(sCurrentTransCat);
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
		
	ImGui_DoWindowEnd();
	
	StationGui_ClearApps();
	return lSelection;
}
	
