class cStationGui_TextReaderSettings
{
	cStationGui_TextReaderSettings()
	{
		msCustomHeader = "";
		mvTextFontSize = ImGui_NrmSizeKeepRatio(0.0325);
		mWindow = StationGui_CreateDefaultWindowData();
		mButton = StationGui_CreateDefaultButtonData();
		mButton.mFont.mvSize = mvTextFontSize;
	}
	
	tString msCustomHeader;
	cVector2f mvTextFontSize;
	cImGuiWindowData mWindow;
	cImGuiButtonData mButton;
	float mfFileListButtonHeight = 0.1f;
	bool mbDrawAppIcon = true;
	bool mbCorrectImageRatioForUV = false;
	bool mbFullScreen = false;
}

//-------------------------------------------------------

/**
 * Default station text reader for terminals with a single text entry.
 * 
 * @param asTransCat, translation category to use.
 * @param asCaption, caption for the window.
 * @param asText, text entry to display.
 * @param aSettings, custom settings for the reader.
 * @param avWindowNrmPosGroup, custom position for window if desired
 * @param avWindowNrmSizeGroup, custom size for window if desired
 * 
 **/
void StationGui_TextReaderSingle(const tString&in asTransCat, const tString&in asCaption, const tString&in asText, 
	const cStationGui_TextReaderSettings &in aSettings = cStationGui_TextReaderSettings(), 
	cVector3f avWindowNrmPosGroup=cVector3f(0.05, 0.05, 1), cVector2f avWindowNrmSizeGroup=cVector2f(0.9, 0.8))
{
	tString sPrevTransCat = ImGui_GetTransCategory();
	ImGui_SetTransCategory(asTransCat);
	StationGui_TextReaderSingle(asCaption, asText, aSettings, avWindowNrmPosGroup, avWindowNrmSizeGroup);
	ImGui_SetTransCategory(sPrevTransCat);
}

//-------------------------------------------------------

/**
 * Default station text reader for terminals with a single text entry.
 * 
 * @param asCaption, caption for the window.
 * @param asText, text entry to display.
 * @param aSettings, custom settings for the reader.
 * @param avWindowNrmPosGroup, custom position for window if desired
 * @param avWindowNrmSizeGroup, custom size for window if desired
 * 
 **/
void StationGui_TextReaderSingle(const tString&in asCaption, const tString&in asText, const cStationGui_TextReaderSettings &in aSettings = cStationGui_TextReaderSettings(), 
	cVector3f avWindowNrmPosGroup=cVector3f(0.05, 0.02, 1), cVector2f avWindowNrmSizeGroup=cVector2f(0.9, 0.775))
{
	Depth_ImGui_AddTextFile(asCaption, asText);
	StationGui_TextReaderSingle(aSettings, avWindowNrmPosGroup, avWindowNrmSizeGroup);
}

//-------------------------------------------------------

/**
 * Default station text reader for terminals with a single text entry. 
 * Use Depth_ImGui_AddTextFile() to specify what should be displayed on it.
 * 
 * @param aSettings, custom settings for the reader.
 * @param avWindowNrmPosGroup, custom position for window if desired
 * @param avWindowNrmSizeGroup, custom size for window if desired
 * 
 **/
void StationGui_TextReaderSingle(const cStationGui_TextReaderSettings &in aSettings = cStationGui_TextReaderSettings(), 
	cVector3f avWindowNrmPosGroup=cVector3f(0.05, 0.02, 1), cVector2f avWindowNrmSizeGroup=cVector2f(0.9, 0.775))
{	
	cGuiTextFile file = gvTextFiles[0];
	
	ImGui_DoWindowStart(file.msTitle, aSettings.mWindow, ImGui_NrmPosGroup(avWindowNrmPosGroup), ImGui_NrmSizeGroup(avWindowNrmSizeGroup));
		_StationGui_TextReader_DrawBody(file, aSettings);
	ImGui_DoWindowEnd();
	
	Depth_ImGui_ClearTextFiles();
}

//-------------------------------------------------------

/**
 * Multi-article reader for datapads.
 * 
 * @param asCaption, caption for the window.
 * @param afFontSize, size of font.
 * 
 **/
void StationGui_DatapadMultiReader(const cStationGui_TextReaderSettings &in aSettings = cStationGui_TextReaderSettings())
{
	////////////////////////////
	// Data
	cImGuiButtonData nextButton = StationGui_CreateDefaultButtonData();
	nextButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.047);
	nextButton.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/big_corner_bottomright");
	nextButton.mGfxFrame.mGfxCornerTopRight.SetFile("stationV2/button/big_corner_slanted_topright");
	cImGuiButtonData prevButton = StationGui_CreateDefaultButtonData();
	prevButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.047);
	prevButton.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/big_corner_bottomright");
	prevButton.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/big_corner_slanted_topleft");
	
	tString sPrevTransCat = ImGui_GetTransCategory();
	
	int lArticleID = ImGui_GetStateInt("ArticleID", 0);
	ImGui_DoWindowStart(gvTextFiles[lArticleID].msTitle, aSettings.mWindow, 
						ImGui_NrmPosGroup(cVector3f(0.05, 0.175, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, aSettings.mbFullScreen ? 0.8 : 0.65)));
		_StationGui_TextReader_DrawBody(gvTextFiles[lArticleID], aSettings);
	ImGui_DoWindowEnd();
	
	////////////////////////
	//Next/Prev buttons			
	ImGui_SetTransCategory("GUI");
	ImGui_SetModUseInput(lArticleID > 0 && ImGui_IsFirstRun()==false);
	if (ImGui_DoButtonExt("Prev", "Prev", prevButton, ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.1))))
	{
		ImGui_IncStateInt("ArticleID", -1);
	}
	ImGui_SetModUseInput(lArticleID < gvTextFiles.length()-1 && ImGui_IsFirstRun()==false);
	if (ImGui_DoButtonExt("Next", "Next", nextButton, ImGui_NrmPosGroup(cVector3f(0.65, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.3, 0.1))))
	{
		ImGui_IncStateInt("ArticleID", 1);
	}
	ImGui_SetModUseInput(true);
	
	ImGui_SetTransCategory(sPrevTransCat);
	
	Depth_ImGui_ClearTextFiles();
}

//-------------------------------------------------------

/**
 * Default station text reader for terminals with multiple text entries.
 * 
 * @param asTransCat, translation category to use.
 * @param asCaption, caption for the file list window.
 * @param asFileContentPrefix, prefix for the contents of the files. Assumes the first entry name in the lang file is MyPrefix_1.
 * @param asFileNamePrefix, prefix for the names of the files. Assumes the first entry name in the lang file is MyPrefix_1.
 * @param alFileCount, The number of files that should be displayed.
 * @param aSettings, custom settings for the text reader.
 * 
 * @return int, the currently selected file.
 **/		
int StationGui_TextReaderMulti(const tString&in asTransCat, const tString&in asCaption, const tString&in asFileContentPrefix, 
							   const tString&in asFileNamePrefix, int alFileCount, const cStationGui_TextReaderSettings &in aSettings = cStationGui_TextReaderSettings())
{
	tString sPrevTransCat = ImGui_GetTransCategory();
	ImGui_SetTransCategory(asTransCat);
	int lSelection = StationGui_TextReaderMulti(asCaption, asFileContentPrefix, asFileNamePrefix, alFileCount, aSettings);
	ImGui_SetTransCategory(sPrevTransCat);
	return lSelection;
}

//-------------------------------------------------------

/**
 * Default station text reader for terminals with multiple text entries.
 * 
 * @param asCaption, caption for the file list window.
 * @param asFileContentPrefix, prefix for the contents of the files. Assumes the first entry name in the lang file is MyPrefix_1.
 * @param asFileNamePrefix, prefix for the names of the files. Assumes the first entry name in the lang file is MyPrefix_1.
 * @param alFileCount, The number of files that should be displayed.
 * @param aSettings, custom settings for the text reader.
 * 
 * @return int, the currently selected file.
 **/
int StationGui_TextReaderMulti(const tString&in asCaption, const tString&in asFileContentPrefix, 
							   const tString&in asFileNamePrefix, int alFileCount, cStationGui_TextReaderSettings &in aSettings = cStationGui_TextReaderSettings())
{	
	for (int i = 1; i <= alFileCount; i++)
	{
		Depth_ImGui_AddTextFile(asFileNamePrefix+"_"+i, asFileContentPrefix+"_"+i);
	}
	
	aSettings.msCustomHeader = asCaption;
	return StationGui_TextReaderMulti(aSettings);
}

//-------------------------------------------------------

/**
 * Default station text reader for terminals with multiple text entries.
 * 
 * @param aSettings, custom settings for the text reader.
 * 
 * @return int, the currently selected file.
 **/
int StationGui_TextReaderMulti(const cStationGui_TextReaderSettings &in aSettings = cStationGui_TextReaderSettings())
{
	tString sCurrentTransCat = ImGui_GetTransCategory();
	
	for (uint i = 0; i < gvTextFiles.length(); i++)
	{		
		ImGui_AddItemString(gvTextFiles[i].msTitle);
	}
	
	/////////////
	// Default setup
	
	cImGuiLabelData label = ImGui_GetDefaultLabel();
	label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
	label.mFont.mColor = cColor_White;
	label.mFontAlign = eFontAlign_Left;
	label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
	
	cImGuiTextFrameData textData = StationGui_CreateDefaultTextFrameData();
	textData.mFont.mvSize = aSettings.mvTextFontSize;
	
	tString sHeader = "ReaderApp_Header";
	if (aSettings.msCustomHeader == "")
		ImGui_SetTransCategory("StationGUI");
	else
		sHeader = aSettings.msCustomHeader;
	ImGui_DoWindowStart(sHeader, aSettings.mWindow, ImGui_NrmPosGroup(cVector3f(0.02, 0.02, 1)), ImGui_NrmSizeGroup(cVector2f(0.96, aSettings.mbFullScreen ? 0.9 : 0.775)));
		ImGui_SetTransCategory(sCurrentTransCat);
	
		/////////////////////
		// File list
		int lSelection = StationGui_FileList(gvTextFiles.length(), gvTextFiles[0].msBody, 0, ImGui_NrmPosGroup(0.02, 0.03, 1), 
											 ImGui_NrmSizeGroup(0.30, 0.9), aSettings.mfFileListButtonHeight);
		if (ImGui_PrevUpdated())
		{
			Depth_Audio_Terminal_Forward(ImGui_GetName());
			Depth_ImGui_SetScrollValue("TextBody", 0);
		}
		
		//////////////////
		// Text Body
		ImGui_GroupBegin(ImGui_NrmPosGroup(0.32, 0.0, 1), ImGui_NrmSizeGroup(0.6525, 0.9));
			cImGuiGfx gfx_line("stationV2/misc/GUI_line");
			ImGui_DrawLineExt(ImGui_NrmPos2Group(0, 0.075, true), ImGui_NrmPos2Group(1, 0.075, true), 2.1, ImGui_NrmSize(0.00375).y, gStationGuiColor_Normal*0.8, gfx_line);
			
			float fOverlap = 0;
			float fOffs = 0;
			if (lSelection < gvTextFiles.length())
			{
				ImGui_DoLabelExt(gvTextFiles[lSelection].msTitle, label, ImGui_NrmPosGroup(cVector3f(0.0375, 0,1)), ImGui_NrmSizeGroup(cVector2f(1, -1)));
				
				ImGui_GroupBegin(ImGui_NrmPosGroup(0, 0.13, 1.1), ImGui_NrmSizeGroup(1, 0.95), true);
					_StationGui_TextReader_DrawBody(gvTextFiles[lSelection], aSettings);
				ImGui_GroupEnd();
			}
		ImGui_GroupEnd();
		
		if (aSettings.mbDrawAppIcon)
			StationGui_DrawAppIcon("stationV2/ossymbols/ossymbol_reader");
	
		Depth_ImGui_ClearTextFiles();
	ImGui_DoWindowEnd();
	
	return lSelection;
}
	
//-------------------------------------------------------

void _StationGui_TextReader_DrawBody(const cGuiTextFile &in aFile, const cStationGui_TextReaderSettings &in aSettings)
{
	cImGuiTextFrameData textData = StationGui_CreateDefaultTextFrameData();
	textData.mFont.mvSize = aSettings.mvTextFontSize;
	
	float fOffs = Depth_ImGui_GetScrollValue(aFile.msBody);
	cVector2f vImgSize = 0;
	
	float fImageYStart = -fOffs*(aSettings.mvTextFontSize.y*1.06);
	
	if (aFile.mbHasImage)
	{
		vImgSize = ImGui_GetRatioCorrectSizeByRect(aFile.mGfx, ImGui_NrmSizeGroup(1, 0.5), aSettings.mbCorrectImageRatioForUV);
		ImGui_SetAlignment(eImGuiAlign_TopCenter);
		ImGui_DoImage(aFile.mGfx, ImGui_NrmPosGroup(cVector3f(0.5, 0.025, 1))+cVector3f(0, fImageYStart, 0), vImgSize);
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
	}
	
	float fTextYStart = vImgSize.y + fImageYStart + 0.025f*ImGui_GetCurrentGroupSize().y;
	
	float fLineOverlap = ImGui_DoTextFrameExt(aFile.msBody, ImGui_NrmSizeGroup(cVector2f(0.075, 0.05)), aSettings.mvTextFontSize.y*0.06, 0, textData, 
											cVector3f(0, fTextYStart, 0), ImGui_NrmSizeGroup(cVector2f(1,0.975))-cVector2f(0, fTextYStart));

	float fOverlap = ImGui_GetStateFloat(aFile.msBody+"_Overlap", fLineOverlap);
	
	if (fOverlap>0.0f)
	{
		cImGuiSliderData sliderData = StationGui_CreateDefaultSliderData();
		ImGui_SetModUseUIPos(false);
		float fMax = fOverlap+2;
		fOffs = fMax-ImGui_DoSliderVerticalExt("TextSlider", fMax-fOffs, 0, fMax, 0.01f, sliderData, 
												   ImGui_NrmPosGroup(cVector3f(0.93, 0.05, 1.1)),  ImGui_NrmSizeGroup(cVector2f(0.05, 0.8625)));
		ImGui_SetModUseUIPos(true);
		Depth_ImGui_InputScroll(aFile.msBody, fOffs, fMax);
	}
}
	
//-------------------------------------------------------

/////////////////////////////////////////
// DIALOG BOX
/////////////////////////////////////////

//-------------------------------------------------------

cGuiDialogBoxSettings StationGui_CreateDefaultDialogBox()
{
	cGuiDialogBoxSettings settings;
	settings.mButton = StationGui_CreateDefaultButtonData();
	settings.mButton.mvDefaultSize = ImGui_NrmSizeKeepRatio(cVector2f(0.25, 0.1));
	settings.mTextFrame = StationGui_CreateDefaultTextFrameData();
	settings.mTextFrame.mFontAlign = eFontAlign_Center;
	settings.mTextFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.045);
	settings.mWindow = StationGui_CreateDefaultWindowData();
	settings.mWindow.SetPadding(20,20,20,20);
	settings.mvSize = ImGui_NrmSize(0.5, 0.4);
	return settings;
}

//-------------------------------------------------------

/**
 * Default station dialog box. Good for error messages and the like.
 * 
 * @param asCaption, caption for the window.
 * @param asText, Text to display in box.
 * @param avNrmSize, normalized size of the dialog. Defaults to 0.6, 0.2. Dialog will be drawn at the center of the screen regardless of size.
 * @param afZ, at what depth the dialog should be drawn.
 * @param avFontSizeMul, multiplier for the text size.
 * 
 **/
void StationGui_DialogBox_Start(const tString&in asCaption, const tString&in asText, const cVector2f &in avNrmSize = cVector2f(0.6, 0.2), float afZ=1.5f, const cVector2f &in avFontSizeMul =1.0f)
{
	//////////////////////////////////
	// Setup widget data
	cImGuiWindowData window = StationGui_CreateDefaultWindowData();
	
	///////////////////////////////////////
	// Show message 
	ImGui_DoWindowStart(asCaption, window, ImGui_NrmPosGroup(cVector3f((1.f-avNrmSize.x)*0.5, (1.f-avNrmSize.y)*0.5, afZ)), ImGui_NrmSizeGroup(avNrmSize));
		
	if (asText == "") return;
	StationGui_DialogBox_Text(asText, avFontSizeMul);
}

//-------------------------------------------------------

/**
 * Draws text in a previously defined dialog box. Useful when the text has to be modified separate to the box.
 * 
 * @param asText, Text to display.
 * 
 **/
void StationGui_DialogBox_Text(const tString&in asText, const cVector2f &in avFontSizeMul =1.0f)
{
	cImGuiTextFrameData textData;
	textData.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
	textData.mbUseBackgroundGfx = false;
	textData.mFont.mvSize = cVector2f(24, 24)*avFontSizeMul;
	textData.mFontAlign = eFontAlign_Center;
	textData.mColorText = cColor(0.8, 1);
	ImGui_DoTextFrameExt(asText, ImGui_NrmSizeGroup(cVector2f(0.05, 0)), 0, 0, textData, 
					  ImGui_NrmPosGroup(cVector3f(0.0, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
}

//-------------------------------------------------------

void StationGui_DialogBox_End()
{
	ImGui_DoWindowEnd();
}	
	
