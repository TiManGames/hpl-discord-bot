/////////////////////////////////////////
// GRAPH APP
//{///////////////////////////////////////

//-------------------------------------------------------

class cStationGui_GraphSettings
{
	cStationGui_GraphSettings()
	{
		mvPos = ImGui_NrmPosGroup(cVector3f(0.05, 0.02, 1));
		mvSize = ImGui_NrmSizeGroup(cVector2f(0.9, 0.775));
	}
	
	cVector3f mvPos;
	cVector2f mvSize;
	float mfGraphicsSizeMul = 1;
	cVector3f mvNrmGraphicsOffset = 0;
}

void StationGui_Graph(const cImGuiGfx &in aBaseGfx, const tString &in asHeader="", const cStationGui_GraphSettings &in aSettings = cStationGui_GraphSettings())
{
	ImGui_DoWindowStart(asHeader, StationGui_CreateDefaultWindowData(), aSettings.mvPos, aSettings.mvSize);
	ImGui_GroupBegin(ImGui_NrmPosGroup(-(aSettings.mfGraphicsSizeMul-1)*0.5)+ImGui_NrmPosGroup(aSettings.mvNrmGraphicsOffset), 
					 ImGui_NrmSizeGroup(aSettings.mfGraphicsSizeMul));
		ImGui_SetAlignment(eImGuiAlign_CenterCenter);
		ImGui_DoImage(aBaseGfx, ImGui_NrmPosGroup(cVector3f(0.5, 0.5, 0.5)), ImGui_GetRatioCorrectSizeByRect(aBaseGfx, ImGui_NrmSizeGroup(1)));
		
		float fLoadTime = ImGui_GetStateFloat("GraphLoad", 0);
		ImGui_FadeStateFloat("GraphLoad", 1, 1.25, eEasing_QuadInOut, false);
		
		//ImGui_SetAlignment(eImGuiAlign_CenterLeft);
		
		/////////////////////////
		// Draw overlays
		for (int i = 0; i < gvGraphOverlays.length(); i++)
		{
			// Calculate overlay size
			float fOverlayLoad = i*(-0.25/gvGraphOverlays.length())+(fLoadTime*1.25);
			fOverlayLoad = cMath_Clamp(fOverlayLoad, 0.0f, 1.0f);
			gvGraphOverlays[i].mGfx.mvUVMax = cVector2f(fOverlayLoad, 1);
			
			cVector2f vOverlaySize = ImGui_GetRatioCorrectSizeByRect(gvGraphOverlays[i].mGfx, ImGui_NrmSizeGroup(1));
			float fMaxX = vOverlaySize.x;
			vOverlaySize.x *= fOverlayLoad;
			cVector3f vOverlayPos = ImGui_NrmPosGroup(cVector3f(0.5, 0.5, gvGraphOverlays[i].mfZ));
			vOverlayPos.x -= fMaxX*0.5*(1.0f-fOverlayLoad);
			
			ImGui_DoImage(gvGraphOverlays[i].mGfx, vOverlayPos, vOverlaySize);
		}
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
	ImGui_GroupEnd();
	ImGui_DoWindowEnd();
	
	Depth_ImGui_ClearGraphOverlays();
}
 
//--------------------------------------------------

void StationGui_ResetGraph()
{
	ImGui_SetStateFloat("GraphLoad", 0);
	ImGui_StopFade("GraphLoad");
}

//} END GRAPH APP

//-------------------------------------------------------

/////////////////////////////////////////
// WAU LEECHING
/////////////////////////////////////////

//-------------------------------------------------------
	
/**
 * Draws the dirtorted image gibberish stuff on the terminal screen.
 * 
 * @param aColorMul, color multiplier.
 * @param afDistortion, how distorted the image should be.
 * @param afZ, z value to render the gibberish at.
 * 
 **/	
void Depth_ImGui_WauLeechGibberish(const cColor &in aColorMul, float afDistortion, float afZ = 2.0f)
{
	// Static overlay
	if (ImGui_RepeatTimer("StaticIndex", 0.1))
	{
		ImGui_SetStateInt("StaticImageIndex", cMath_RandRectl(0, 1));
		ImGui_SetStateInt("AnimationRotation", cMath_RandRectl(0, 1));
	}
	ImGui_SetModColorMul(gStationGuiColor_Normal*cColor(1, 0.8)*aColorMul);
	ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
	ImGui_DoImage(cImGuiGfx("static_"+ImGui_GetStateInt("StaticImageIndex", 0)+""), cVector3f(0, 0, afZ+0.1f), ImGui_NrmSizeGroup(1));
	
	if (ImGui_RepeatTimer("ImageIndex", 0.14))
	{
		ImGui_SetStateInt("GibberishImageIndex", cMath_RandRectl(0, 2));
	}
	ImGui_SetModRotateAngle(ImGui_GetStateInt("AnimationRotation", 0)*180);
	
	Depth_ImGui_DrawLineDistortedGfx(	cImGuiGfx("leechgibberish_"+ImGui_GetStateInt("GibberishImageIndex", 0)), 
										cVector3f(0, 0, afZ), 
										 ImGui_NrmSizeGroup(1),
										aColorMul,
										afDistortion, 1.0f);
	ImGui_ResetModifiers();
}