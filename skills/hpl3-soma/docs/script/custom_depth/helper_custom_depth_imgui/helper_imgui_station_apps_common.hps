//-------------------------------------------------------

cGuiScreenSaverSettings StationGui_CreateDefaultScreenSaver()
{
	cGuiScreenSaverSettings settings;

	settings.mCenterGfx = cImGuiGfx("screensaver_01.dds", eImGuiGfx_TextureAnimated);
	settings.mCenterGfx.mfAnimationTime = 0.1f;
	settings.mvCenterGfxNrmSize = cVector2f(0.75, 0.75);
	settings.mFullscreenGfx = cImGuiGfx("");
	settings.mFullscreenGfx.mColor = cColor(0, 1);
	
	settings.mbStartOn = true;
	settings.mfTime = 60;
	
	return settings;
}
	
