//-------------------------------------------------------

/////////////////////////////////////////
// ERROR BOXES
/////////////////////////////////////////
	
//-------------------------------------------------------

class cStationGui_ErrorSettings
{
	cStationGui_ErrorSettings()
	{
		mDialogBox = StationGui_CreateDefaultDialogBox();
		mDialogBox.mType = eGuiDialogBoxType_OK;
	}
	cGuiDialogBoxSettings mDialogBox;
}
	
//-------------------------------------------------------

tString StationGui_GetError()
{
	return Entity_GetVarString(ImGui_GetName(), "StationGui_Error");
}

//-------------------------------------------------------	

/**
 * Sets an error to be displayed in an error box. Make sure StationGui_DrawAndCheckErrors is called in the OnGui function for this to be displayed.
 * 
 * @param asErrorMsg, message to display
 * @param asSoundEffect, custom error sound to play.
 **/
void StationGui_SetError(const tString&in asErrorMsg, const tString &in asSoundEffect = "")
{
	tString sEntity = ImGui_GetName();
	Entity_SetVarString(sEntity, "StationGui_Error", asErrorMsg);
	
	if (asErrorMsg != "")
	{
		if (asSoundEffect != "") Sound_CreateAtEntity(sEntity+"_Error", asSoundEffect, sEntity, 0.0f, false, 1.0f);
		else Depth_Audio_Terminal_Error(sEntity);
	}
}

//-------------------------------------------------------		

/**
 * Sets an error to be displayed in an error box. Make sure StationGui_DrawAndCheckErrors is called in the OnGui function for this to be displayed.
 * Can be called from outside of an OnGui function.
 * 
 * @param asTerminal, terminal to set the error on.
 * @param asErrorMsg, message to display
 * @param asSoundEffect, custom error sound to play.
 **/
void StationGui_SetError(const tString&in asTerminal, const tString&in asErrorMsg, const tString &in asSoundEffect = "")
{
	Entity_SetVarString(asTerminal, "StationGui_Error", asErrorMsg);
	
	if (asErrorMsg != "")
	{
		if (asSoundEffect != "") Sound_CreateAtEntity(asTerminal+"_Error", asSoundEffect, asTerminal, 0.0f, false, 1.0f);
		else Depth_Audio_Terminal_Error(asTerminal);
	}
}
	
//-------------------------------------------------------

/**
 * Draws an error box with an optional OK button that disables the error.
 * 
 * @param abDisplayOKButton, If the OK button should be displayed. Defaults to true.
 **/
bool StationGui_ErrorBox(bool abDisplayOKButton=true)
{
	tString sError = StationGui_GetError();
	if (sError == "") return true;
	
	cGuiDialogBoxSettings dialogBox = StationGui_CreateDefaultDialogBox();
	dialogBox.mType = abDisplayOKButton ? eGuiDialogBoxType_OK : eGuiDialogBoxType_NoButton;
	
	return StationGui_ErrorBox(sError, dialogBox);
}
	
//-------------------------------------------------------

bool StationGui_ErrorBox(const tString &in asError, const cGuiDialogBoxSettings &in aDialogBox)
{
	tString sPrevTransCat = ImGui_GetTransCategory();
	
	ImGui_SetTextOverride(cResources_Translate("GUI", "Error"));
	eGuiDialogCode buttonPressed = Depth_ImGui_DialogBox("", asError, aDialogBox);
	ImGui_ClearTextOverride();
	
	if (buttonPressed==eGuiDialogCode_OK)
	{
		Depth_Audio_Terminal_Forward(ImGui_GetName());
		StationGui_SetError("");
	}
	
	return buttonPressed==eGuiDialogCode_OK;
}
	
//-------------------------------------------------------

/**
 * Simple helper for displaying error messages. Returns true if an error is being displayed.
 * 
 **/
bool StationGui_DrawAndCheckErrors(const cStationGui_ErrorSettings &in aSettings = cStationGui_ErrorSettings())
{
	tString sError = StationGui_GetError();
	if (sError != "")
	{
		return StationGui_ErrorBox(sError, aSettings.mDialogBox)==false;
	}
	
	return false;
}