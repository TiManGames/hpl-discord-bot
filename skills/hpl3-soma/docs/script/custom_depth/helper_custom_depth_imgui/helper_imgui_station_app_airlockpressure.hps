#include "helpers/helper_font.hps"

//-------------------------------------------------------

/////////////////////////////////////////
// AIRLOCK PRESSURE APP
//{///////////////////////////////////////

//-------------------------------------------------------
		
void StationGui_AirlockPressure(const tString &in asStatus, float afPressure, bool abStatusIsWarning)
{
	tString sPrevLangCat = ImGui_GetTransCategory();
	ImGui_SetTransCategory("StationGUI");
	//////////////////////
	// Data
	cImGuiTextFrameData text = StationGui_CreateDefaultTextFrameData();
	text.mFontAlign = eFontAlign_Center;
	text.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.08);
	
	cImGuiLabelData label = ImGui_GetDefaultLabel();
	label.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Bold));
	
	cImGuiWindowData window = StationGui_CreateDefaultWindowData();
	window.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.07);
	
	if (abStatusIsWarning)
	{
		text.mColorText = ImGui_FadeOscillateColor("TextColor", cColor_Red, cColor(0.5, 0, 0, 1), 0.5);
	}
	
	ImGui_DoWindowStart("PressureDiff_Status", window, 
						ImGui_NrmPosGroup(cVector3f(0.05, 0.05, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.4)));
		ImGui_SetTransCategory(sPrevLangCat);
		
		array<tWString> sRows;
		GetFontWordWrapRows(text.mFont, 1, asStatus, ImGui_GetCurrentGroupSize().x, sRows);
		cVector2f vSize = ImGui_NrmSizeGroup(1);
		vSize.y = text.mFont.mvSize.y*sRows.length();
		float fOverflow = ImGui_DoTextFrameExt(asStatus, 0, 0, 0, text, ImGui_NrmPosGroup(0.0, 0.4, 1)-cVector3f_Up*vSize.y*0.5f, vSize);
		
		ImGui_SetTransCategory("StationGUI");
	ImGui_DoWindowEnd();
	
	
	ImGui_DoWindowStart("PressureDiff_PressureHeader", window, 
						ImGui_NrmPosGroup(cVector3f(0.05, 0.475, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.475)));			
		ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.06, 0.25, 1)), ImGui_NrmSizeGroup(cVector2f(0.88, 0.5)));
			ImGui_SetModColorMul(gStationGuiColor_Normal*cColor(0.75, 1));
			ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(cVector3f(0, 0.25, 1)), ImGui_NrmSizeGroup(cVector2f(1, 0.5)));
			ImGui_SetModColorMul(cColor_White);
			
			label.mFont.mvSize = 46;
			ImGui_ResizeFontToFit("PressureDiff_In", label.mFont, ImGui_GetCurrentGroupSize().x*0.25);
			ImGui_ResizeFontToFit("PressureDiff_Out", label.mFont, ImGui_GetCurrentGroupSize().x*0.25);
			
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(-0.025, 0.25, 1.5)), ImGui_NrmSizeGroup(cVector2f(0.1675, 1.25)));
				ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(cVector3f(0.9, 0, 0)), ImGui_NrmSizeGroup(cVector2f(0.1, 0.625)));
				label.mFontAlign = eFontAlign_Left;
				ImGui_DoLabelExt("PressureDiff_In", label, ImGui_NrmPosGroup(cVector3f(1.1,0.4,0)), ImGui_NrmSizeGroup(cVector2f(0.8, -1)));
			ImGui_GroupEnd();
			
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0.875, -0.5, 1.5)), ImGui_NrmSizeGroup(cVector2f(0.1675, 1.25)));
				ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(cVector3f(0, 0.375, 0)), ImGui_NrmSizeGroup(cVector2f(0.1, 0.625)));
				label.mFontAlign = eFontAlign_Right;
				ImGui_DoLabelExt("PressureDiff_Out", label, ImGui_NrmPosGroup(cVector3f(-0.9,0.3,0)), ImGui_NrmSizeGroup(cVector2f(0.8, -1)));
			ImGui_GroupEnd();
			
			float fX = 0.126+0.749*afPressure;
			
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(fX, 0.25, 1.6)), ImGui_NrmSizeGroup(cVector2f(0.1675, 0.8)));
				ImGui_SetModColorMul(gStationGuiColor_Highlight2);
				ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(cVector3f(0, 0, 0)), ImGui_NrmSizeGroup(cVector2f(0.1, 0.625)));
				ImGui_SetModColorMul(cColor_White);
			ImGui_GroupEnd();
		ImGui_GroupEnd();
	
	ImGui_DoWindowEnd();
}

//} END AIRLOCK PRESSURE APP