#include "helpers/helper_font.hps"

//-------------------------------------------------------

/////////////////////////////////////////
// CATHERINE PORTRAIT
/////////////////////////////////////////

//-------------------------------------------------------

void Depth_ImGui_CathPortrait(float afTimeStep, const tString &in asVoiceCharacter="Catherine")
{
	cImGuiWindowData windowData = StationGui_CreateDefaultWindowData();
	
	cImGuiGfx barFraming;
	barFraming.mColor = gStationGuiColor_Normal; //cColor(53.0f/255.0f, 129.0f/255.0f, 142.0f/255.0f, 1.0f);
	float fFramingWidth = ImGui_NrmSize(0.0f, 0.01f).y;
	float fFontHeight = ImGui_NrmSize(0.0f, 0.04f).y;
	
	cImGuiLabelData text;
	text.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large));
	text.mFont.mvSize = cVector2f(fFontHeight,fFontHeight);
	
	cImGuiGfx noise("noise_01.dds", eImGuiGfx_TextureAnimated);
	noise.mfAnimationTime = 1/16.0f;
	noise.mMaterial = eGuiMaterial_Additive;
	noise.mbCrossfadeAnimation = true;
	
	
	cImGuiGfx scanline("scanline_01.dds", eImGuiGfx_TextureAnimated);
	scanline.mfAnimationTime = 1/15.0f;
	scanline.mMaterial = eGuiMaterial_Alpha;
	scanline.mbCrossfadeAnimation = true;
	
	bool bPortraitTalking = asVoiceCharacter != "" && Voice_CharacterIsSpeaking(asVoiceCharacter);
	bool bPortraitWasTalking = ImGui_GetStateBool("PortraitTalking", false);
	ImGui_SetStateBool("PortraitTalking", bPortraitTalking);
	
	cImGuiGfx cathFace;
	cImGuiGfx cathPrevFace;
	
	float fGlitchWaitMinTime = 3.0f;
	float fGlitchWaitMaxTime = 6.0f;
	float fGlitchMinTime = 0.01f;
	float fGlitchMaxTime = 0.05f;
	
	if(bPortraitTalking)
	{
		// Catherine is speaking
		cathFace = cImGuiGfx("catherine_active.dds", eImGuiGfx_Texture);
		
		cathPrevFace = cImGuiGfx("catherine_inactive.dds", eImGuiGfx_Texture);
		cathPrevFace.mColor = cColor(0.5f,1.0f);
		
		if(ImGui_TimerExists("GlitchTimer")==false && ImGui_GetStateInt("GlitchNumFrames")==0)
		{
			ImGui_AddTimer("GlitchTimer", cMath_RandRectf(fGlitchWaitMinTime,fGlitchWaitMaxTime));
		}
		
		if(ImGui_TimerOver("GlitchTimer"))
		{
			ImGui_SetStateInt("GlitchNumFrames", cMath_RandRectl(1,4));
			ImGui_SetStateInt("GlitchFrame", cMath_RandRectl(1,4));
			ImGui_AddTimer("GlitchFrameTime", cMath_RandRectf(fGlitchMinTime, fGlitchMaxTime));
		}
	}
	else
	{
		cathFace = cImGuiGfx("catherine_inactive.dds", eImGuiGfx_Texture);
		cathFace.mColor = cColor(0.5f,1.0f);
		
		cathPrevFace = cImGuiGfx("catherine_active.dds", eImGuiGfx_Texture);
	}
	
	if(bPortraitWasTalking!=bPortraitTalking)
	{
		float fCrossfadeTime = 0.1f;
		if(bPortraitWasTalking)
			fCrossfadeTime *= 1.5f;
		
		ImGui_SetStateFloat("FaceCrossfade", 0.0f);
		ImGui_FadeStateFloat("FaceCrossfade", 1.0f, fCrossfadeTime);
	}
	
	if(ImGui_TimerOver("GlitchFrameTime"))
	{
		ImGui_IncStateInt("GlitchNumFrames", -1);
		ImGui_SetStateInt("GlitchFrame", cMath_RandRectl(1,4));
		
		if(ImGui_GetStateInt("GlitchNumFrames")>0)
			ImGui_AddTimer("GlitchFrameTime", cMath_RandRectf(fGlitchMinTime, fGlitchMaxTime));
		else
			ImGui_AddTimer("GlitchTimer", cMath_RandRectf(fGlitchWaitMinTime,fGlitchWaitMaxTime));
	}
	
	
	float fScanlineStart = 0.1f;
	float fScanlineEnd = 0.8f;
	float fScanlineFadeInterval = 0.1f;
	
	///////////////////////////////////////////////
	// Center window (with face and stuff)
	ImGui_SetTransCategory("");
	StationGui_DoWindowStart("ctec-24-22-Chun", windowData, ImGui_NrmPos(0.2f, 0.020f, 1.0f), ImGui_NrmSize(0.6f, 0.96f), false, true);
	{
		cVector3f vCathPos = ImGui_NrmPosGroup(cVector3f(0.5f,0.5f,1.0f));
		cVector2f vCathSize = ImGui_GetRatioCorrectSizeByWidth(cathFace, ImGui_NrmSize(0.55f).x);
		
		ImGui_SetAlignment(eImGuiAlign_CenterCenter);
		
		if(ImGui_IsFading("FaceCrossfade"))
		{
			float fCrossfadeAlpha = ImGui_GetStateFloat("FaceCrossfade");
			
			ImGui_SetModColorMul(cColor(1.0f, 1.0f-fCrossfadeAlpha));
			ImGui_DoImage(cathPrevFace, vCathPos, vCathSize);
			ImGui_SetModColorMul(cColor(1.0f, fCrossfadeAlpha));
			ImGui_DoImage(cathFace, vCathPos, vCathSize);
			ImGui_SetModColorMul(cColor_White);
		}
		else
			ImGui_DoImage(cathFace, vCathPos, vCathSize);		
			
		if(bPortraitTalking && ImGui_GetStateInt("GlitchNumFrames")>0)
		{
			cImGuiGfx glitchOverlay("catherine_glitch" + ImGui_GetStateInt("GlitchFrame") + ".dds", eImGuiGfx_Texture);
			
			ImGui_SetModColorMul(cColor(1.0f, 0.7f));
			ImGui_DoImage(glitchOverlay, vCathPos+cVector3f(0,0,0.1f), vCathSize);
			ImGui_SetModColorMul(cColor_White);
		}
		
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
				
		ImGui_DoImage(noise, ImGui_NrmPosGroup(0,0,2), ImGui_NrmSizeGroup(1,1));
		
		float fScanlineY = ImGui_GetStateFloat("Scanline");
		float fScanlineAlpha = 1.0f;
		
		if(fScanlineY < fScanlineStart+fScanlineFadeInterval)
			fScanlineAlpha = (fScanlineY-fScanlineStart)/fScanlineFadeInterval;
		else if(fScanlineY>fScanlineEnd-fScanlineFadeInterval)
			fScanlineAlpha = (fScanlineEnd-fScanlineY)/fScanlineFadeInterval;
				
		ImGui_SetAlignment(eImGuiAlign_CenterCenter);
		ImGui_SetModColorMul(cColor(1,0.5f*fScanlineAlpha));
		ImGui_DoImage(scanline, ImGui_NrmPosGroup(0.5f, fScanlineY, 1.5f), ImGui_NrmSizeGroup(cVector2f(0.7f,-1.0f)));
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
		ImGui_SetModColorMul(cColor_White);
	}
	StationGui_DoWindowEnd();
	
	// Draw corner icons
	cImGuiGfx gfxIcon;
	cVector2f vIconSize;
	
	///////////////////////////////////////////
	// Ring buffer icon
	gfxIcon = cImGuiGfx("omnitool_buffer.dds", eImGuiGfx_Texture);
	vIconSize = ImGui_GetRatioCorrectSizeByNrmWidth(gfxIcon, 0.15f);
	
	ImGui_SetAlignment(eImGuiAlign_TopCenter);
	ImGui_SetModRotateAngle(ImGui_GetStateFloat("RingAngle"));
	ImGui_IncStateFloat("RingAngle", afTimeStep*180.0f);
	ImGui_DoImage(gfxIcon, ImGui_NrmPos(0.9f,0.02f,1.0f), vIconSize);
	ImGui_SetModRotateAngle(0);
	
	///////////////////////////////////////////
	// Warning icon
	gfxIcon = cImGuiGfx("ossymbol_warning.tga", eImGuiGfx_Texture);
	vIconSize = ImGui_GetRatioCorrectSizeByWidth(gfxIcon, ImGui_NrmSize(cVector2f(0.05f, 0.0f)).x*2.0f + 5.0f);
	
	ImGui_SetAlignment(eImGuiAlign_BottomCenter);
	gfxIcon.mColor = gStationGuiColor_Normal;
	ImGui_DoImage(gfxIcon, ImGui_NrmPos(0.1f,0.99f,1.0f), vIconSize);
	
	// Reset alignment
	ImGui_SetAlignment(eImGuiAlign_TopLeft);
		
	///////////////////////////////
	// Draw oscillating bars
	cImGuiGaugeData gaugeData = StationGui_CreateDefaultGaugeData();
	gaugeData.mbUseFrame= false;
	gaugeData.mGfxFill.mColor = gStationGuiColor_Normal * 0.75f;
	gaugeData.mOrientation = eImGuiGaugeOrientation_Vert;
	
	
	///////////////////////////////////
	// Vertical bars at the left
	cVector3f vBarPos = ImGui_NrmPos(0.05f, 0.3f, 1.0f);
	cVector2f vBarSize = ImGui_NrmSize(cVector2f(0.05f, 0.45f));
	ImGui_LayoutBegin(eImGuiLayout_X_Tabbed, vBarPos, cVector2f_MinusOne, cVector2f(vBarSize.x+5.0f,0));
	
	ImGui_DoLabelExt("x11", text);
	ImGui_DoLabelExt("x12", text);
												 
	ImGui_LayoutEnd();
	
	barFraming.mColor = gStationGuiColor_Normal * 0.75f;
	
	ImGui_DoImage(barFraming, vBarPos + cVector3f(0, text.mFont.mvSize.y+fFramingWidth, 0), cVector2f(vBarSize.x*2 + 5.0f, fFramingWidth));
	
	ImGui_LayoutBegin(eImGuiLayout_X, vBarPos + cVector3f(0, text.mFont.mvSize.y+3*fFramingWidth,0), cVector2f(vBarSize.x*0.5f,0), cVector2f(5,0));
	
	ImGui_DoGauge(gaugeData, Depth_ImGui_GetOscillatingSignalValue("CathBar", 0, eEasing_Linear, 0.2f, 1.0f, 2.0f), cVector3f_Zero, vBarSize);
	ImGui_DoGauge(gaugeData, Depth_ImGui_GetOscillatingSignalValue("CathBar", 1, eEasing_Linear, 0.2f, 1.0f, 2.0f), cVector3f_Zero, vBarSize);
												 
	ImGui_LayoutEnd();
	
	ImGui_DoImage(barFraming, vBarPos + cVector3f(0, text.mFont.mvSize.y+vBarSize.y+4*fFramingWidth,0), cVector2f(vBarSize.x*2 + 5.0f, fFramingWidth));
	
	
	///////////////////////////////////
	// Frequency bars at the right
	cVector3f vMeterPos = ImGui_NrmPos(0.81f, 0.365f, 1.0f);
	cVector2f vMeterSize = ImGui_NrmSize(0.18f, 0.535f);
	
	int lNumBars = 16;
	float fMinBarWidth = 0.05f;
	float fSignalBoost = 10.0f;
	
	vBarSize = ImGui_NrmSize(cVector2f(0.15f, 0.0f));
	vBarSize.y = vMeterSize.y/(lNumBars*1.25f);
	
	cVector2f vSepSize(vMeterSize.x*0.075f, vBarSize.y*0.25f);
	
	barFraming.mColor = gStationGuiColor_Normal * 0.75f;
	
	gaugeData.mOrientation = eImGuiGaugeOrientation_Hori;
	gaugeData.mGfxFill.mColor = gStationGuiColor_Normal;
	
	ImGui_DoLabelExt("tec.:#A12", text, ImGui_NrmPos(0.81f, 0.29f, 1.0f));
		
	ImGui_DoImage(barFraming, vMeterPos, vSepSize);
	ImGui_DoImage(barFraming, vMeterPos+cVector3f(0, vSepSize.y, 0), cVector2f(vSepSize.y, vMeterSize.y));
		
	ImGui_LayoutBegin(eImGuiLayout_Y, vMeterPos+cVector3f(vSepSize.y,0,0), cVector2f_MinusOne, cVector2f(0,0));
	
	ImGui_DoImage(barFraming, cVector3f_Zero, vSepSize);
	
	if(bPortraitTalking)
	{
		array<float> vSpectrum;
		cLux_GetVoiceHandler().GetSpectrumFromSpeakingCharacter(asVoiceCharacter, vSpectrum);
		
		if(vSpectrum.length()>0)
		{
			int lSamplesPerBar = vSpectrum.length()/lNumBars;
			float fInvSamplesPerBar = 1.0f/lSamplesPerBar;
			
			
			for(int i=0; i<lNumBars; ++i)
			{
				//float fSignal = fMinBarWidth + vSpectrum[i]*10.0f*(1.0f-fMinBarWidth);
				float fSignal = fMinBarWidth + vSpectrum[i]*fSignalBoost*(1.0f-fMinBarWidth);
				
				ImGui_SetStateFloat("Freq_signal_"+i, fSignal);
			}
			
			/*for(int i=0; i<lNumBars; ++i)
			{
				//float fSignal = fMinBarWidth + vSpectrum[i]*10.0f*(1.0f-fMinBarWidth);
				float fSignal = fMinBarWidth;
				for(int j=0; j<lSamplesPerBar; ++j)
				{
					fSignal += vSpectrum[i*lSamplesPerBar+j]*fSignalBoost*fInvSamplesPerBar;
				}
								
				ImGui_SetStateFloat("Freq_signal_"+i, fSignal);
			}
			 * */
		}
	}
	else
	{
		if(bPortraitWasTalking)
		{
			for(int i=0; i<lNumBars; ++i)
			{
				ImGui_FadeStateFloat("Freq_signal_" + i, fMinBarWidth, 0.15f);
			}
		}
		
		
	}

	for(int i=0; i<lNumBars; ++i)
	{
		float fSignal = ImGui_GetStateFloat("Freq_signal_"+i, fMinBarWidth);
		//cLux_AddDebugMessage("Bar height: " + vBarSize.y, true);
		ImGui_DoGauge(gaugeData, fSignal, cVector3f_Zero, vBarSize);
		ImGui_DoImage(barFraming, cVector3f_Zero, vSepSize);
	}
			
	ImGui_LayoutEnd();
	
	//////////////////////////////////
	// Periodic scanline sweep
	if(ImGui_RepeatTimer("ScanlineTimer", 10.0f))
	{
		ImGui_SetStateFloat("Scanline", fScanlineStart);
		ImGui_FadeStateFloat("Scanline", fScanlineEnd, 2.0f, eEasing_Linear);
	}
}