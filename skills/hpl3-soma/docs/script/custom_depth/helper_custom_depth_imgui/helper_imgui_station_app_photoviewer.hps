
	
//-------------------------------------------------------

/////////////////////////////////////////
// STATION PHOTO VIEWER
/////////////////////////////////////////

//-------------------------------------------------------

class cStationGui_PhotoViewerSettings
{
	cStationGui_PhotoViewerSettings()
	{
		mWindow = StationGui_CreateDefaultWindowData();
		mButton = StationGui_CreateDefaultButtonData();
		mButton.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.06);
	}
	
	tString msCustomForwardButtonSound = "";
	tString msCustomBackButtonSound = "";
	bool mbFullScreen = false;
	cImGuiWindowData mWindow;
	cImGuiButtonData mButton;
}

//-------------------------------------------------------
	
int StationGui_PhotoViewer(const tString &in asCaption = "", const tString &in asName = "", 
						   const cStationGui_PhotoViewerSettings &in aSettings = cStationGui_PhotoViewerSettings())
{	
	tString sCurrentTransCat = ImGui_GetTransCategory();
	ImGui_SetTransCategory("GUI");
	
	int lPhotoIndex = -1;
	cImGuiGfx photo;
	
	if (gvPhotoViewerAppEntries.length() > 0)
	{
		lPhotoIndex = cMath_Clamp(ImGui_GetStateInt(asName+"PhotoIndex", 0), 0, gvPhotoViewerAppEntries.length()-1);
		photo = cImGuiGfx(gvPhotoViewerAppEntries[lPhotoIndex].msFile, gvPhotoViewerAppEntries[lPhotoIndex].mGfxType);
	}
	else
	{
		photo = cImGuiGfx("");
	}
	
	ImGui_SetTransCategory(sCurrentTransCat);
	ImGui_DoWindowStart(asCaption, aSettings.mWindow, ImGui_NrmPosGroup(cVector3f(0.025, 0.02, 0.5)), 
						ImGui_NrmSizeGroup(cVector2f(0.95, aSettings.mbFullScreen ? 0.96 : 0.775)));
		ImGui_SetTransCategory("GUI");
		
		// Regular image
		if (gvPhotoViewerAppEntries[lPhotoIndex].msTextEntry == "")
		{
			ImGui_DoImageCorrectAspect(photo, ImGui_NrmPosGroup(cVector3f(0.05, 0.015, 1)), ImGui_NrmSizeGroup(cVector2f(0.9, 0.8)));
		}
		
		// Text entry image
		else
		{
			cVector3f vPos = ImGui_NrmPosGroup(cVector3f(0.5, 0.4075, 1));
			cVector2f vSize = ImGui_NrmSizeGroup(cVector2f(0.45, 0.8));
			
			ImGui_SetAlignment(eImGuiAlign_CenterRight);
			ImGui_DoImage(photo, vPos, ImGui_GetRatioCorrectSizeByRect(photo, vSize));
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
			
			ImGui_SetTransCategory(sCurrentTransCat);
			
			cImGuiTextFrameData textFrame = StationGui_CreateDefaultTextFrameData();
			textFrame.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.04);
			
			ImGui_DoTextFrameExt(gvPhotoViewerAppEntries[lPhotoIndex].msTextEntry,
								0, 0, 0, textFrame, ImGui_NrmPos(0.55f, 0.025f, 2), ImGui_NrmSize(0.35, 0.58));
			ImGui_SetTransCategory("GUI");
		}
		
		// Next Button
		ImGui_SetModUseInput(lPhotoIndex < (int(gvPhotoViewerAppEntries.length())-1));
		if (ImGui_DoButtonExt("NextButton", "Next", aSettings.mButton, ImGui_NrmPosGroup(cVector3f(0.7, 0.875, 2)), ImGui_NrmSizeGroup(cVector2f(0.275, 0.103))))
		{
			lPhotoIndex++;
			if (aSettings.msCustomForwardButtonSound=="")
				Depth_Audio_Terminal_Forward(ImGui_GetName());
			else
				Sound_CreateAtEntity(asName+"CameraFwdButton", aSettings.msCustomForwardButtonSound, ImGui_GetName(), 0.0f, false, 1.0f);
				
		}
		
		// Prev Button
		ImGui_SetModUseInput(lPhotoIndex > 0);
		if (ImGui_DoButtonExt("PrevButton", "Prev", aSettings.mButton, ImGui_NrmPosGroup(cVector3f(0.025, 0.875, 2)), ImGui_NrmSizeGroup(cVector2f(0.275, 0.103))))
		{
			lPhotoIndex--;
			if (aSettings.msCustomBackButtonSound=="")
				Depth_Audio_Terminal_Forward(ImGui_GetName());
			else
				Sound_CreateAtEntity(asName+"CameraBackButton", aSettings.msCustomBackButtonSound, ImGui_GetName(), 0.0f, false, 1.0f);
		}
	ImGui_DoWindowEnd();
	
	ImGui_SetStateInt(asName+"PhotoIndex", lPhotoIndex);

	ImGui_SetTransCategory(sCurrentTransCat);
	
	Depth_ImGui_ClearPhotoFiles();
	
	if (ImGui_PrevBecamePressed())
	{
		return lPhotoIndex;
	}
	return -1;
}