#include "helper_font.hps"

/////////////////////////////////////////
// Colors

//----------------- Primary -------------------------
/// used for stationary things like frames, or inactive elements like buttons.
cColor gStationGuiColor_Normal = cColor(0.227f, 0.51f, 0.557f); // #3a828e
/// for mouseover/hover effects or whenever green is needed.
cColor gStationGuiColor_Highlight = cColor(0.576f, 0.612f, 0.184f); // #939c2f
/// for warning or error screens, active buttons and elements.
cColor gStationGuiColor_Warning = cColor(0.706f, 0.208f, 0.082f); // #b43515

/// For focused AND selected
cColor gStationGuiColor_FocusedAndSelected = cColor(0.9, 0.6, 0.1);

//----------------- Secondary -------------------------
/// for the use with ornamental graphics like the chinese symbols.
cColor gStationGuiColor_Normal2 = cColor(0.396f, 0.698f, 0.745f); // #65b2be
/// for whenever you need yellow.
cColor gStationGuiColor_Highlight2 = cColor(0.655f, 0.592f, 0.176f); // #a7972d
/// for blazing "end of the world" red.
cColor gStationGuiColor_Warning2 = cColor(0.698f, 0.035f, 0.035f); // #b20909

//----------------- Tertiary -------------------------
/// for inactive/disabled stuff.
cColor gStationGuiColor_Disabled = cColor(0.192f, 0.192f, 0.192f); // #313131



//-------------------------------------------------------

////////////////////////////////////////////////////////////
// Default widget data creators
////////////////////////////////////////////////////////////

//-------------------------------------------------------

// Window
cImGuiWindowData StationGui_CreateDefaultWindowData()
{
	cImGuiWindowData window;
	
	window.mColorBase = gStationGuiColor_Normal;
	
	window.mGfxWindowData.mGfxBackground.mColor = cColor(0,0.75);
	
	if(ImGui_NrmSize(0.083334).y < 64)
	{
		window.mGfxWindowData.mGfxCornerTopRight.SetFile("stationV2/window/small_corner_topright");
		window.mGfxWindowData.mGfxCornerTopLeft.SetFile("stationV2/window/small_corner_topleft");
		window.mGfxWindowData.mGfxCornerBottomRight.SetFile("stationV2/window/small_corner_bottomright");
		window.mGfxWindowData.mGfxCornerBottomLeft.SetFile("stationV2/window/small_corner_bottomleft");
		
		window.mGfxWindowData.mGfxBorderTop.SetFile("stationV2/window/small_border_top");
		window.mGfxWindowData.mGfxBorderLeft.SetFile("stationV2/window/small_border_left");
		window.mGfxWindowData.mGfxBorderRight.SetFile("stationV2/window/small_border_right");
		window.mGfxWindowData.mGfxBorderBottom.SetFile("stationV2/window/small_border_bottom");
	}
	else
	{
		window.mGfxWindowData.mGfxCornerTopRight.SetFile("stationV2/window/big_corner_topright");
		window.mGfxWindowData.mGfxCornerTopLeft.SetFile("stationV2/window/big_corner_topleft");
		window.mGfxWindowData.mGfxCornerBottomRight.SetFile("stationV2/window/big_corner_bottomright");
		window.mGfxWindowData.mGfxCornerBottomLeft.SetFile("stationV2/window/big_corner_bottomleft");
		
		window.mGfxWindowData.mGfxBorderTop.SetFile("stationV2/window/big_border_top");
		window.mGfxWindowData.mGfxBorderLeft.SetFile("stationV2/window/big_border_left");
		window.mGfxWindowData.mGfxBorderRight.SetFile("stationV2/window/big_border_right");
		window.mGfxWindowData.mGfxBorderBottom.SetFile("stationV2/window/big_border_bottom");		
	}
	
	window.mGfxLabelData.mGfxBackground.mColor = cColor_White;
	
	window.mFontAlign = eFontAlign_Left;
	window.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.047);
	window.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Additive));
	window.mFont.mMaterial = eGuiMaterial_Additive;
	window.mHeaderType = eImGuiWindowHeader_FitCaption;
	
	window.SetLabelPadding(0.0f, 15.0f, 0.0f, 10.0f);
	
	return window;
}

//-------------------------------------------------------

cImGuiSliderData StationGui_CreateDefaultSliderData()
{
	cImGuiSliderData sliderData;
	
	sliderData.mGfxBackground.SetFile("station/scrollbar/scrollbar_bar_vert");
	sliderData.mGfxBaseInFocus.SetFile("station/scrollbar/scrollbar_bar_infocus");
	sliderData.mGfxButton.SetFile("station/scrollbar/scrollbar_button");
	sliderData.mGfxButtonInFocus.SetFile("station/scrollbar/scrollbar_button_infocus");
	sliderData.mColorBase = gStationGuiColor_Normal;
	sliderData.mGfxBaseInFocus.mColor = gStationGuiColor_Normal;
	sliderData.mGfxBackground.mvUVMax.y = ImGui_NrmSizeKeepRatio(0.00001).y;
	sliderData.mGfxBaseInFocus.mvUVMax.y = ImGui_NrmSizeKeepRatio(0.00001).y;
	sliderData.mvButtonSize.y = ImGui_NrmSizeKeepRatio(0.05).y;
	
	return sliderData;
}

//-------------------------------------------------------

cImGuiTextFrameData StationGui_CreateDefaultTextFrameData()
{
	cImGuiTextFrameData textData;
	
	textData.mbUseBackgroundGfx = false;
	textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.035);
	textData.mFontAlign = eFontAlign_Left;
	textData.mColorText = gStationGuiColor_Normal;
	
	return textData;
}

//-------------------------------------------------------

// Button
cImGuiButtonData StationGui_CreateDefaultButtonData()
{
	cImGuiButtonData button;
	
	button.mColorBase = gStationGuiColor_Normal;
	button.mbUseInFocusColor = true;
	button.mColorInFocus = gStationGuiColor_Highlight;
	button.mbUseTriggeredColor = true;
	button.mColorTriggered = gStationGuiColor_Warning;
	button.mbUseDisabledColor = true;
	button.mColorDisabled = gStationGuiColor_Disabled;
	button.mbUseBackgroundGfx = false;
	button.mbUseInFocusGfx = false;
	button.mbUseTriggeredGfx = false;
	button.mbUseFrame = true;
	
	if(ImGui_NrmSize(0.083334).y < 64)
	{
		button.mGfxFrame.mGfxBorderBottom.SetFile("stationV2/button/small_border_bottom");
		button.mGfxFrame.mGfxBorderLeft.SetFile("stationV2/button/small_border_left");
		button.mGfxFrame.mGfxBorderRight.SetFile("stationV2/button/small_border_right");
		button.mGfxFrame.mGfxBorderTop.SetFile("stationV2/button/small_border_top");
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/small_corner_bottomleft");
		button.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/small_corner_slanted_bottomright");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/small_corner_topleft");
		button.mGfxFrame.mGfxCornerTopRight.SetFile("stationV2/button/small_corner_topright");
	}
	
	else
	{
		button.mGfxFrame.mGfxBorderBottom.SetFile("stationV2/button/big_border_bottom");
		button.mGfxFrame.mGfxBorderLeft.SetFile("stationV2/button/big_border_left");
		button.mGfxFrame.mGfxBorderRight.SetFile("stationV2/button/big_border_right");
		button.mGfxFrame.mGfxBorderTop.SetFile("stationV2/button/big_border_top");
		button.mGfxFrame.mGfxCornerBottomLeft.SetFile("stationV2/button/big_corner_bottomleft");
		button.mGfxFrame.mGfxCornerBottomRight.SetFile("stationV2/button/big_corner_slanted_bottomright");
		button.mGfxFrame.mGfxCornerTopLeft.SetFile("stationV2/button/big_corner_topleft");
		button.mGfxFrame.mGfxCornerTopRight.SetFile("stationV2/button/big_corner_topright");
	}
	
	button.mGfxFrame.mGfxBackground.mColor.a = 0.7f;
	button.mFont.SetFile(Helper_Font_GetFontName(eLuxFontType_Sansation_Large_Additive));
	button.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.0625);
	button.mFont.mMaterial = eGuiMaterial_Additive;
	
	button.mbClipText = true;
	button.mfClipAreaPaddingLeft = 6;
	button.mfClipAreaPaddingRight = 16;
	button.mfScrollResetDelay = 1.0f;
	button.mfScrollSpeed = 32;
	
	return button;
}

//-------------------------------------------------------

cImGuiButtonData StationGui_CreateToggleButtonData()
{
	cImGuiButtonData button = StationGui_CreateDefaultButtonData();
	button.mbUseTriggeredAndInFocusColor = true;
	button.mColorTriggeredAndInFocus = gStationGuiColor_FocusedAndSelected;
	return button;
}

//-------------------------------------------------------

// Gauge
cImGuiGaugeData StationGui_CreateDefaultGaugeData()
{
	cImGuiGaugeData gauge;
	gauge.mGfxFrame.mGfxCornerTopRight.SetFile("station/bar/small_framing_upper_right");
	gauge.mGfxFrame.mGfxCornerTopLeft.SetFile("station/bar/small_framing_upper_left");
	gauge.mGfxFrame.mGfxCornerBottomRight.SetFile("station/bar/small_framing_lower_right");
	gauge.mGfxFrame.mGfxCornerBottomLeft.SetFile("station/bar/small_framing_lower_left");
    
	gauge.mGfxFrame.mGfxBorderTop.mColor = cColor(0.0f, 0.0f);
	gauge.mGfxFrame.mGfxBorderLeft.mColor = cColor(0.0f, 0.0f);
	gauge.mGfxFrame.mGfxBorderRight.mColor = cColor(0.0f, 0.0f);
	gauge.mGfxFrame.mGfxBorderBottom.mColor = cColor(0.0f, 0.0f);
	
	gauge.mGfxFrame.mGfxCornerTopLeft.mColor = gStationGuiColor_Normal;
	gauge.mGfxFrame.mGfxCornerTopRight.mColor = gStationGuiColor_Normal;
	gauge.mGfxFrame.mGfxCornerBottomRight.mColor = gStationGuiColor_Normal;
	gauge.mGfxFrame.mGfxCornerBottomLeft.mColor = gStationGuiColor_Normal;
	
	gauge.mGfxFrame.mGfxBackground.mColor = cColor(0,0);
	
	gauge.mGfxBackground.mColor = cColor(1.0f, 1.0f);
	gauge.mvPadding = cVector2f(2,2);
	
	return gauge;
}