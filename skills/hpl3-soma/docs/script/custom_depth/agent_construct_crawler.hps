	//------------------------------------------------------------
	
	void MoveTo(const cVector3f&in avPos, const tString&in asResultCallback="")
	{
		mpMover.SetUseMoveStateAnimations(true);
		mpPathfinder.MoveTo(avPos, 1.0f, true, asResultCallback, false);
	}
	
	//------------------------------------------------------------
	
	void SetIdleBarkMachineSilent()
	{
		mIdleBarkState = eCrawlerBark_Silent;
		if (mpStateMachine.GetCurrentState()==eCrawlerState_Idle)
			mpBarkMachine.ChangeState(eCrawlerBark_Silent);
	}
	
	//------------------------------------------------------------
	
	void SetIdleBarkMachineIdle()
	{
		mIdleBarkState = eCrawlerBark_Idle;
		if (mpStateMachine.GetCurrentState()==eCrawlerState_Idle)
			mpBarkMachine.ChangeState(eCrawlerBark_Idle);
	}
	
	//------------------------------------------------------------
	
	void SetIdleBarkMachineRamble()
	{
		mIdleBarkState = eCrawlerBark_Ramble;
		if (mpStateMachine.GetCurrentState()==eCrawlerState_Idle)
			mpBarkMachine.ChangeState(eCrawlerBark_Ramble);
	}
	
