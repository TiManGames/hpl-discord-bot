#include "interfaces/Agent_Interface.hps"
#include "custom_depth/helper_custom_depth.hps"

enum eMegaMouthState 
{
    eMegaMouthState_Idle,
	eMegaMouthState_Attack
}

enum eMegaMouthSpeed
{
    eMegaMouthSpeed_Idle,
	eMegaMouthSpeed_Attack
}

class cScrMegaMouth: iScrAgent, iScrAgent_Interface
{
	//------------------------------------------------------------

	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////

	//------------------------------------------------------------

	void Init() 
	{
		mBaseObj.SetUpdatePlayerDetection(true);
	}

	//------------------------------------------------------------

	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////

	//------------------------------------------------------------

	void SetupCharBody() 
	{
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();

		pCharBody.SetGravityActive(false);
		pCharBody.SetMass(60);

		pCharBody.SetAccurateClimbing(false);
		pCharBody.SetMaxNoSlideSlopeAngle(cMath_ToRad(30) );
		pCharBody.SetMaxPushMass(16);
		pCharBody.SetMaxPushForce(300);
		pCharBody.SetPushImpulse(100);
		pCharBody.SetPushIn2D(false);
		pCharBody.SetCharacterMaxPushMass(10);
		pCharBody.SetCharacterPushForce(100);
		pCharBody.SetMaxStepSize(0.0f);
		pCharBody.SetMaxStepSizeInAir(0.0f);
		pCharBody.SetStepClimbSpeed(0.5f);

		pCharBody.SetEntityPitchAmount(0.3f);

		pCharBody.SetMaxPositiveMoveSpeed(eCharDir_Forward,2);
		pCharBody.SetMoveAcc(eCharDir_Forward,1);
		pCharBody.SetMoveDeacc(eCharDir_Forward,1);
		pCharBody.SetMoveOppositeDirAccMul(eCharDir_Forward,1);
		pCharBody.SetDeaccelerateMoveSpeedInAir(true);
	}

	//------------------------------------------------------------

	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)	
	{
		/////////////////////////////////////////
		// Mover
		@mpMover = cLux_CreateEntityComponent_CharMover(mBaseObj, mBaseObj.GetCharBody());

		mpMover.LoadFromVariables(apVars);

		mpMover.SetMaxForwardSpeed(2);
		mpMover.SetMaxBackwardSpeed(1);

		mpMover.SetTurnMinBreakAngle(cMath_ToRad(40) );
		mpMover.SetTurnBreakMul(0);
		mpMover.SetTurnSpeedMul(3);
		mpMover.SetTurnMaxSpeed(4);

		mpMover.SetStoppedToWalkSpeed(0.2);
		mpMover.SetWalkToRunSpeed(3);
		mpMover.SetWalkToStoppedSpeed(0.15);
		mpMover.SetRunToWalkSpeed(0.8);

		mpMover.SetMoveSpeedAnimMul(1);

		mpMover.SetUse3DMovement(true);

		mpMover.SetBankingActive(true);
		mpMover.SetBankingAngleMul(0.3f);
		mpMover.SetBankingMaxAngle(cMath_ToRad(45));
		mpMover.SetBankingSpeedMul(3.0f);
		mpMover.SetBankingMaxSpeed(1.0f);

		mpMover.SetupWallAvoidance(2.5f, 8.0f, 4);
		mpMover.SetWallAvoidanceActive(true);

		mpMover.SetupDynamicObjectAvoidance(2.0f, 5, 4);
		mpMover.SetDynamicObjectAvoidanceActive(true);

		mpMover.SetMaxForwardSpeed(1.55f);

		mpMover.SetUseMoveStateAnimations(false);

		/////////////////////////////////
		// Speed States
		mpMover.AddSpeedState(eMegaMouthSpeed_Idle);
		mpMover.SetSpeedState_Forward(0.1f);
		mpMover.SetSpeedState_ForwardAcc(0.2f);
		
		mpMover.AddSpeedState(eMegaMouthSpeed_Attack);
		mpMover.SetSpeedState_Forward(3.0f);
		mpMover.SetSpeedState_ForwardAcc(6.0f);

		/////////////////////////////////////////
		// Backbone Tail
		@mpBackboneTail = cLux_CreateEntityComponent_BackboneTail(mBaseObj);
		mpBackboneTail.LoadFromVariables(apVars);

		/////////////////////////////////
		// State machine Module
		@mpStateMachine = cLux_CreateEntityComponent_StateMachine(mBaseObj);

		mpStateMachine.AddState("Idle", eMegaMouthState_Idle);
		mpStateMachine.AddState("Attack", eMegaMouthState_Attack);

		mpStateMachine.ChangeState(eMegaMouthState_Idle);
		
		/////////////////////////////////
		// Senses
		mBaseObj.SetFOV(cMath_ToRad(360.0f));
		mBaseObj.SetSightRange(7.0f);
	}

	//------------------------------------------------------------

	void OnAfterWorldLoad() 
	{
	}

	//------------------------------------------------------------

	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////

	//------------------------------------------------------------

	void OnUpdate(float afTimeStep) 
	{
	}

	//------------------------------------------------------------

	void ResetProperties() 
	{
	}

	//------------------------------------------------------------

	void BeforeEntityDestruction() 
	{
	}

	//------------------------------------------------------------

	void OnStartMove() 
	{
	}

	//------------------------------------------------------------

	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState) 
	{
	}

	//------------------------------------------------------------


	/////////////////////////////////////////
	// STATES
	/////////////////////////////////////////

	//------------------------------------------------------------
	// Default
	//------------------------------------------------------------
			
	bool State_Default_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_PlayerDetected)
		{
			//////////////////////
			// Player Detected
			if(mBaseObj.GetSensesActive()==false) return false;

			if (mpStateMachine.GetCurrentState() != eMegaMouthState_Attack)
			{
				cLux_AddDebugMessage("Fish seen player - attacking!");			
				mpStateMachine.ChangeState(eMegaMouthState_Attack);
			}
			
			if (mBaseObj.Timer_Exists(3))
				mBaseObj.Timer_Remove(3);
			return true;
		}
		else if (alMessageId == eLuxEntityMessage_PlayerUndetected)
		{
			//////////////////////
			// Lost track of player
			mBaseObj.Timer_Add(3, 3.0f, "TimerLostPlayer",false);
		}
		
		return false;
	}
			
	//------------------------------------------------------------
	
	void TimerLostPlayer(uint64 alTimerID)
	{
		if (mpStateMachine.GetCurrentState() == eMegaMouthState_Attack)
		{
			mpStateMachine.ChangeState(mpStateMachine.GetPrevState());
			cLux_AddDebugMessage("Fish lost track of player!");
		}
	}
			
	//------------------------------------------------------------
	// Idle
	//------------------------------------------------------------

	void State_Idle_Enter() 
	{
		mpMover.SetSpeedState(eMegaMouthSpeed_Idle);
		
		/////////////////////////
		// Callback
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (msIdleCallback != "" && 
			pMap.ScriptPrepare("void " + msIdleCallback + "(const tString &in asEntity)"))
		{
			pMap.SetArgString(0, mBaseObj.GetName());
			pMap.ScriptExecute();
		}
	}

	//------------------------------------------------------------

	void State_Idle_Update(float afTimeStep)
	{
	}

	//------------------------------------------------------------

	void State_Idle_Leave() 
	{
	}
	
	//------------------------------------------------------------
	// Attack
	//------------------------------------------------------------

	void State_Attack_Enter() 
	{
		mpMover.SetSpeedState(eMegaMouthSpeed_Attack);
		
		/////////////////////////
		// Callback
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (msAttackCallback != "" && 
			pMap.ScriptPrepare("void " + msAttackCallback + "(const tString &in asEntity)"))
		{
			pMap.SetArgString(0, mBaseObj.GetName());
			pMap.ScriptExecute();
		}
	}

	//------------------------------------------------------------

	void State_Attack_Update(float afTimeStep) 
	{
		if (!mBaseObj.GetSensesActive())
		{
			mpStateMachine.ChangeState(mpStateMachine.GetPrevState());
			return;
		}
		
		mvTargetPos = cLux_GetPlayer().GetCamera().GetPosition();
		mvTargetPos.y += cMath_RandRectf(-0.5f,0.5f);
		mpMover.MoveToPos(mvTargetPos);
		
		float fDist = mBaseObj.GetDistanceToPlayer();
		if (fDist<10.0f)
		{
			AttackMeter_AddInstance(mBaseObj.GetID(), 0.7f, 0.15f, 0.3f);

			if (fDist<4.0f) 
				AttackMeter_AddInstance(mBaseObj.GetID(), 1.0f, 0.3f, 0.3f);
		}
	}

	//------------------------------------------------------------

	void State_Attack_Leave() 
	{
		AttackMeter_RemoveInstance(mBaseObj.GetID());
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PLAYER DEATH
	/////////////////////////////////////////
		
	//------------------------------------------------------------
	
	void _Global_PlayerStartDamageCallback()
	{
		AttackMeter_RemoveInstance(mBaseObj.GetID());	
	}
	
	//------------------------------------------------------------
	
	void _Global_PlayerAfterDamageCallback()
	{
		mBaseObj.SetActive(false);
	}
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////

	//------------------------------------------------------------

	void OnSetActive(bool abX) 
	{
	}

	//------------------------------------------------------------

	void GiveDamage(float afAmount, int alStrength, const tString&in asType, const tString&in asSource) 
	{
	}

	//------------------------------------------------------------

	void OnHealthChange() 
	{
	}

	//------------------------------------------------------------

	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////

	//------------------------------------------------------------

	bool CanInteract(int alType, iPhysicsBody@ apBody) 
	{
		return false;
	}

	//------------------------------------------------------------

	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData) 
	{
		return false;
	}

	//------------------------------------------------------------

	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////

	//------------------------------------------------------------

	void _Global_SetIdle() 
	{
		mpStateMachine.ChangeState(eMegaMouthSpeed_Idle);
	}

	//------------------------------------------------------------

	void _Global_SetIdleCallback() 
	{
		msIdleCallback = cScript_GetGlobalArgString(0);
	}
	
	//------------------------------------------------------------

	void _Global_SetAttackCallback() 
	{
		msAttackCallback = cScript_GetGlobalArgString(0);
	}
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////

	//------------------------------------------------------------

	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY) 
	{
		return afStartY;
	}

	//------------------------------------------------------------

	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////

	//------------------------------------------------------------

	cLuxBackboneTail @mpBackboneTail;
	cLuxStateMachine@ mpStateMachine;
	cLuxCharMover@ mpMover;

	tString msIdleCallback;
	tString msAttackCallback;
	
	//------------------------------------------------------------

	[nosave] cVector3f mvTargetPos;

	//------------------------------------------------------------
}
