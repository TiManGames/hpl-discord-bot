	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float mfTowardsCenterMul;
	
	//------------------------------------------------------------
	
	tString msAgent;
	tID m_idAgent;
	
	bool mbCanChargePlayer=false;
	bool mbChargingPlayer=false;
	bool mbDeactivating=false;
	float mfChangeCanChargePlayerCount;
	
	bool mbCanWander=false;
	float mfChangeCanWanderCount;
	
	float mfSwimLineAdd=0;
	float mfPlayerLightAmount=1.0f;
	bool mbPlayerIsInTheOpen=false;
	bool mbPlayerIsInBuilding=false;
	
	bool mbExplorationMode_AllowAttack = false;
	
	eSwarmFishAnim mAnim = eSwarmFishAnim_Normal;
	
	//------------------------------------------------------------
		
}	