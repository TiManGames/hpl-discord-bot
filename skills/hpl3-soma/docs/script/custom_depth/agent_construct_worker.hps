	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		afStartY = cLux_DrawDebugText("PlayerIsDetected: "+mBaseObj.PlayerIsDetected(),afStartY);
		afStartY = cLux_DrawDebugText("HuntAngryCount: "+mfHuntAngryCount,afStartY);
		afStartY = cLux_DrawDebugText("DistanceToPlayer: "+mBaseObj.GetDistanceToPlayer(),afStartY);
		afStartY = cLux_DrawDebugText("DistToScavengeStart: "+mBaseObj.GetDistanceToPos(mvScavengeStartPos),afStartY);
		
		if (cLux_GetExplorationModeActive())
		{
			afStartY = cLux_DrawDebugText("ExplorationMode_AllowEnterStareCount: "+mfExplorationMode_AllowEnterStareCount,afStartY);
		}
		
		
		return afStartY;
	}
	
