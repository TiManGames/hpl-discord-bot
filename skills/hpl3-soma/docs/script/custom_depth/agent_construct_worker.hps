	//------------------------------------------------------------
		
	void _Global_Test_Hunt()
	{
		mpStateMachine.ChangeState(eConstructState_Hunt);
	}
	
	void _Global_Test_ExtendTentacles()
	{
		for(int i=0; i<8; ++i)
		{
			mTentacles.SetActive(i, true);
			mTentacles.SetIdle(i);
		}
	}
	
	void _Global_Test_RetractTentacles()
	{
		/*for(int i=0; i<8; ++i)
		{
			mTentacles.SetActive(i, false);
		}*/
		mTentacles.SetActive(0, false);
	}
	
	void _Global_Test_GlobalPos()
	{
		/*for(int i=0; i<8; ++i)
		{
			mTentacles.SetTarget(i, cScript_GetGlobalArgVector3f(0));
		}*/
		mTentacles.SetTarget(0, cVector3f(-6.172f, 2.374f, -7.924f));
	}
	
	//------------------------------------------------------------
	
	void _Global_SetMoveSoundsActive()
	{
		bool bMoveSoundsActive = cScript_GetGlobalArgBool(0);
		if (bMoveSoundsActive)
		{
			msLoopSound_Move = gsMoveLoopSound;
			msLoopSound_Idle = gsIdleLoopSound;
			msLoopSound_MoveStart = gsMoveLoopStartSound;
			msLoopSound_MoveStop = gsMoveLoopStopSound;
		}
		else
		{
			msLoopSound_Move = "";
			msLoopSound_Idle = "";
			msLoopSound_MoveStart = "";
			msLoopSound_MoveStop = "";
		}
	}
	
