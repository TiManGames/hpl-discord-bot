	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		cScrAgentSwimBot::OnSetActive(abX);
		
		if(abX==false)
		{
			DistortionEffect_RemoveInstance(mBaseObj.GetID());
			AttackMeter_RemoveInstance(mBaseObj.GetID());
			if (mlPlayerNearEffectID!=-1)
			{
				Effect_VideoDistortion_FadeOut(mlPlayerNearEffectID,0.5f);
				mlPlayerNearEffectID=-1;
			}
		}
	}
	
