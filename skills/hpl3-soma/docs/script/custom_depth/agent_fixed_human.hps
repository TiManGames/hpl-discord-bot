	/////////////////////////////////////////
	// HELPER
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void MoveTo(const cVector3f&in avPos, const tString& in asResultCallback="")
	{
		mpMover.SetUseMoveStateAnimations(true);
		mpPathfinder.MoveTo(avPos, 1.0f, true, asResultCallback, false);
	}
	
	//------------------------------------------------------------
	
	void TurnOffEffects()
	{
		/////////////////////////////////////
		// Death handler
		AttackMeter_RemoveInstance(mBaseObj.GetID());
	}
	
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_EnterPatrol()
	{
		int lState = mpStateMachine.GetCurrentState();
		
		if(lState != eFixedHumanState_Patrol)
		{
			mpStateMachine.ChangeState(eFixedHumanState_Patrol);
		}	
	}
	
	//------------------------------------------------------------
	
	void _Global_RevealPlayer()
	{
		mBaseObj.RevealPlayerPos();
	}
	
	//------------------------------------------------------------
	
	void _Global_EnterHunt()
	{
		int lState = mpStateMachine.GetCurrentState();
		
		if(	lState != eFixedHumanState_AfterHunt &&
			lState != eFixedHumanState_Hunt)
		{
			mpStateMachine.ChangeState(eFixedHumanState_Hunt);
		}	
	}
	
	//------------------------------------------------------------
	
	void _Global_SetRunning()
	{
		cLux_AddDebugMessage("Run!");
		mpMover.SetSpeedState(eFixedHumanSpeed_Run);
		//mpBarkMachine.ChangeState(eFixedHumanBark_Idle);
		mBaseObj.PlaySound("Alert",gsFixedHumanHuntSound,true, true);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetTrackDownActive()
	{
		if(mbTrackDownActive == cScript_GetGlobalArgBool(0)) return;
		
		mbTrackDownActive = cScript_GetGlobalArgBool(0);
		
		int lState = mpStateMachine.GetCurrentState();
		
		if(	lState != eFixedHumanState_AfterHunt &&
			lState != eFixedHumanState_Hunt &&
			lState != eFixedHumanState_Search &&
			lState != eFixedHumanState_Investigate)
		{
			if(mbTrackDownActive)
			{
				mpStateMachine.ChangeState(eFixedHumanState_TrackDown);
			}
			else
			{
				mpStateMachine.ChangeState(eFixedHumanState_Idle);
			}
		}	
	}
	
	//------------------------------------------------------------
	
	void _Global_GetState()
	{
		tString sState;
		switch (mpStateMachine.GetCurrentState())
		{
			case eFixedHumanState_Idle: 			sState = "Idle"; break;
			case eFixedHumanState_Wait: 			sState = "Wait"; break;
			case eFixedHumanState_Patrol: 		sState = "Patrol"; break;
			case eFixedHumanState_PlayerSpotted: sState = "PlayerSpotted"; break;
			case eFixedHumanState_Investigate: 	sState = "Investigate"; break;
			case eFixedHumanState_Search: 		sState = "Search"; break;
			case eFixedHumanState_TrackDown: 	sState = "TrackDown"; break;
			case eFixedHumanState_Hunt: 			sState = "Hunt"; break;
			case eFixedHumanState_AfterHunt: 	sState = "AfterHunt"; break;
			default:						sState = "Unknown"; break;
		}
		cScript_SetGlobalReturnString(sState);
	}
	
