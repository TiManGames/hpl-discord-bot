/**
 * Datapad Forward Sound
 * 
 **/
	void Depth_Audio_Datapad_Forward(const tString &in asEntity)
		{
			if(cLux_GetUnderwaterEffectsActive())
			{
				Sound_CreateAtEntity("Depth_Audio_Terminal_Underwater_Forward", "Entities_Station/tech/terminal_beeps/datapad/datapad_forward", asEntity, 0, false);
				cLux_AddDebugMessage("Datapad Forward Beep Triggered - Map Underwater");
			}
			else
			{
				Sound_CreateAtEntity("Depth_Audio_Terminal_Underwater_Forward", "Entities_Station/tech/terminal_beeps/datapad/datapad_forward", asEntity, 0, false);
				cLux_AddDebugMessage("Datapad Forward Triggered - Map NOT Underwater");
			}
		}
			
