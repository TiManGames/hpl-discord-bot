			else
			{
				Sound_CreateAtEntity("Depth_Audio_Omnitool_Raise", "Player/foley/default/hand_animation/omnitool_lower", "Player", 0, false);
			}
		}

//END Omnitool Sounds
//}-------------------------------------------------		
		
