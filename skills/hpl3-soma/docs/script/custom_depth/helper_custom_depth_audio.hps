/**
 * Error/Denied Terminal Sound
 * 
 **/
	void Depth_Audio_Terminal_Error(const tString &in asEntity)
		{
			if(cLux_GetUnderwaterEffectsActive())
			{
				Sound_CreateAtEntity("Depth_Audio_Terminal_Underwater_Error", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/pathOS_underwater_comp_error", asEntity, 0, false);
				cLux_AddDebugMessage("Denied Beep Triggered - Map Underwater");
			}
			else
			{
				Sound_CreateAtEntity("Depth_Audio_Terminal_Air_Error", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_error", asEntity, 0, false);
				cLux_AddDebugMessage("Denied Beep Triggered - Map NOT Underwater");
			}
		}
	
