	void Depth_Audio_PlayerTakeDamage()
	{
		Sound_CreateAtEntity("Damage", "Player/reaction/damage", "Player", 0.0f, false, 1.0f);
	}
	

/////////////////////////////////////////
// SCRIPTED REACTIONS
/////////////////////////////////////////

/**
 * Plays a gasping sound - good for reaction on stuff breaking/smashing in front of player
 * 
 **/	
	void Depth_Audio_SimonGasp(int alPrio = 1)
	{
		if(cLux_GetUnderwaterEffectsActive())
		{	
			Emotion_PlayEventBreath("Player/reaction/underwater/gasp", alPrio);
		}
		else
		{
			Emotion_PlayEventBreath("Player/reaction/air/gasp", alPrio);
		}
	}
	
/**
 * Plays on oomph sound
 * 
 **/
	void Depth_Audio_SimonBeaten()
	{
			if(cLux_GetUnderwaterEffectsActive())
			{	
				Emotion_PlayEventBreath("Player/reaction/underwater/hurt", 1);
				cLux_AddDebugMessage("Beaten emote - underwater");
			}
			else
			{
				Emotion_PlayEventBreath("Player/reaction/air/hurt", 1);
				cLux_AddDebugMessage("Beaten emote - non-uw");
			}
	}
	
/**
 * Plays a faux damage sound - for scripted damage, not intended to be used on systemic stuff
 */
	void Depth_Audio_SimonHurt_Damage()
	{
			if(cLux_GetUnderwaterEffectsActive())
			{	
				Emotion_PlayEventBreath("Player/reaction/underwater/hurt", 1);
				cLux_AddDebugMessage("Faux damage sound - underwater");
			}
			else
			{
				Emotion_PlayEventBreath("Player/reaction/air/hurt", 1);
				cLux_AddDebugMessage("Faux damage sound - non-uw");
			}
	}


