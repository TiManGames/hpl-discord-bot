/////////////////////////////////////////
// Fear Functions
//{///////////////////////////////////////

//////////////////////////////
//Fear Prefabs Sounds
//-------------------------------------------------
	void Depth_Audio_Fear_HighIntensity(float afDuration=12.0f, float afFadeOut=20.0f, int mlPriority=1, bool mbHeartbeat = true, bool mbBreathing = true)
	{
		if(mbHeartbeat == true)
		{
			Emotion_StartHeartbeat(0.45, 1.0f, mlPriority, afDuration, 0, afFadeOut / 2);
		}
		
		if(mbBreathing == true)
		{
			Emotion_StartBackgroundBreath(eBreathType_Fear, 1, mlPriority, 10, 0.0f, 0.2);
		}
	}
	
//-------------------------------------------------

	void Depth_Audio_Fear_MediumIntensity(float afDuration=8.0f, float afFadeOut=15.0f, int mlPriority=1, bool mbHeartbeat = true, bool mbBreathing = true)
	{
		if(mbHeartbeat == true)
		{
			Emotion_StartHeartbeat(0.75, 0.85f, mlPriority, afDuration, 0, afFadeOut / 1.8);
		}
		
		if(mbBreathing == true)
		{
			Emotion_StartBackgroundBreath(eBreathType_Fear, 0.75, mlPriority, afDuration, 0.0f, afFadeOut);
		}
	}

//-------------------------------------------------

	void Depth_Audio_Fear_LowIntensity(float afDuration=6.0f, float afFadeOut=10.0f, int mlPriority=1, bool mbHeartbeat = true, bool mbBreathing = true)
	{
		if(mbHeartbeat == true)
		{
			Emotion_StartHeartbeat(1.25, 0.5f, mlPriority, afDuration, 0, afFadeOut / 1.8);
		}
		
		if(mbBreathing == true)
		{
			Emotion_StartBackgroundBreath(eBreathType_Fear, 0.3, mlPriority, afDuration, 0.0f, afFadeOut);
		}
	}

//} END FEAR

