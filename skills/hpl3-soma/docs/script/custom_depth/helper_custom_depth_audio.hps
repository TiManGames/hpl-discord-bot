//-------------------------------------------------		
//Omnitool panel sounds		
//-------------------------------------------------

/**
 * Panel success - Omnitool is successfully used on an omnitool panel
 * 
 **/
		void Depth_Audio_Omnitool_Panel_Granted(iLuxEntity@ apEntity)
		{
			if(Map_GetUnderwater())
			{
				apEntity.PlaySound("Depth_Audio_Omnitool_Panel_Granted", "Entities_Station/tech/terminal_beeps/omnitool/panel/underwater/panel_door_hack_response", true, true);
			}
			else
			{
				apEntity.PlaySound("Depth_Audio_Omnitool_Panel_Granted", "Entities_Station/tech/terminal_beeps/omnitool/panel/air/panel_door_hack_response", true, true);
			}
		}
		
//-------------------------------------------------

/**
 * Panel success - Omnitool is denied access to an omnitool panel
 * 
 **/
		void Depth_Audio_Omnitool_Panel_Denied(iLuxEntity@ apEntity)
		{
			if(Map_GetUnderwater())
			{
				apEntity.PlaySound("Depth_Audio_Omnitool_Panel_Denied", "Entities_Station/tech/terminal_beeps/omnitool/panel/underwater/panel_door_hack_denied", true, true);
			}
			else
			{
				apEntity.PlaySound("Depth_Audio_Omnitool_Panel_Denied", "Entities_Station/tech/terminal_beeps/omnitool/panel/air/panel_door_hack_denied", true, true);
			}
		}
	
		
