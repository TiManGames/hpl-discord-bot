//Do not use these sounds
/**
 * Start - A short melodic tone indicating the computer bootup
 * 
 
	void Depth_Audio_Terminal_Start(const tString &in asEntity, bool withVoice = false)
		{
			if(cLux_GetUnderwaterEffectsActive() && withVoice==false)
			{
				Sound_CreateAtEntity("Depth_Audio_Terminal_Underwater_Shutdown", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/pathOS_underwater_comp_start", asEntity, 0, false);
				cLux_AddDebugMessage("Start Tone Triggered - NO VOICE - Map Underwater");
			}
			else if(cLux_GetUnderwaterEffectsActive() && withVoice==true)
			{
				Sound_CreateAtEntity("Depth_Audio_Terminal_Underwater_Shutdown", "Entities_Station/tech/terminal_beeps/pathOS_underwater_comp/pathOS_underwater_comp_start", asEntity, 0, false);
				cLux_AddDebugMessage("Start Tone Triggered - VOICE - Map Underwater");
			}
			else if(withVoice==false)
			{
				Sound_CreateAtEntity("Depth_Audio_Terminal_Air_Shutdown", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_start", asEntity, 0, false);
				cLux_AddDebugMessage("Start Tone Triggered - NO VOICE - Map NOT Underwater");
			}
			else if(withVoice==true)
			{
				Sound_CreateAtEntity("Depth_Audio_Terminal_Air_Shutdown", "Entities_Station/tech/terminal_beeps/pathOS_comp/pathOS_comp_start", asEntity, 0, false);
				cLux_AddDebugMessage("Start Tone Triggered - VOICE - Map NOT Underwater");
			}
		}
		
//-------------------------------------------------
//Do not use these sounds

