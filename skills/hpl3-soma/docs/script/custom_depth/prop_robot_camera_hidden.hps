#include "script/Prop_Rigid.hps"
#include "helper_player.hps"

class cScrPropRigid_RobotCamera : cScrPropRigid
{
	void Init()
	{
		mfRotateSpeed = 1.0f;
	}
	
	//-------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		cSubMeshEntity@ pCupola = mBaseObj.GetMeshEntity().GetSubMeshEntity(1);
		cVector3f vCurrentForward = pCupola.GetWorldMatrix().GetTranspose().GetForward();
		cVector3f vTargetForward = mvTargetFwd;
		vTargetForward.y = vCurrentForward.y;
		vTargetForward.Normalize();
		
		float fAngle = cMath_Vector3Angle(vCurrentForward, vTargetForward);
		
		if (fAngle < 0.05) return;
		float fRightDot = cMath_Vector3Dot(pCupola.GetWorldMatrix().GetTranspose().GetRight(), vTargetForward);
		
		mfYaw += cMath_Min(mfRotateSpeed*afTimeStep, fAngle)*cMath_Sign(fRightDot);
	}
	
	//-------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{		
		cSubMeshEntity@ pCupola = mBaseObj.GetMeshEntity().GetSubMeshEntity(1);
		cSubMeshEntity@ pEye = mBaseObj.GetMeshEntity().GetSubMeshEntity(2);
		cSubMeshEntity@ pEyeGlass = mBaseObj.GetMeshEntity().GetSubMeshEntity(3);
		cMatrixf mtxCupolaLocal = cMatrixf_Identity;
		mtxCupolaLocal.SetTranslation(pCupola.GetLocalMatrix().GetTranslation());
		pCupola.SetMatrix(cMath_MatrixMul(mtxCupolaLocal, cMath_MatrixRotateY(mfYaw)));
		cMatrixf mtxEyeLocal = pCupola.GetLocalMatrix();
		mtxEyeLocal.SetTranslation(pEye.GetLocalMatrix().GetTranslation());
		pEyeGlass.SetMatrix(mtxEyeLocal);
		
		mtxEyeLocal = cMath_MatrixMul(mtxEyeLocal, cMath_MatrixRotateX(mfPitch));
		pEye.SetMatrix(mtxEyeLocal);
	}
	
	//-------------------------------------------------------
	
	void _Global_SetLookAtTarget()
	{
		cVector3f vTargetPos = cScript_GetGlobalArgVector3f(0);
		cSubMeshEntity@ pCupola = mBaseObj.GetMeshEntity().GetSubMeshEntity(1);
		
		cVector3f vTargetForward = vTargetPos - pCupola.GetWorldPosition();
		SetTargetForward(vTargetForward);
	}
	
	//-------------------------------------------------------
	
	void _Global_SetTargetForward()
	{
		SetTargetForward(cScript_GetGlobalArgVector3f(0));
	}
	
	//-------------------------------------------------------
	
	void _Global_GetCurrentForward()
	{
		cSubMeshEntity@ pCupola = mBaseObj.GetMeshEntity().GetSubMeshEntity(1);
		cScript_SetGlobalReturnVector3f(pCupola.GetWorldMatrix().GetTranspose().GetForward());
	}
	
	//-------------------------------------------------------
	
	void _Global_SetRotateSpeed()
	{
		mfRotateSpeed = cScript_GetGlobalArgFloat(0);
	}
	
	//-------------------------------------------------------
	
	void SetTargetForward(const cVector3f &in avForward)
	{
		mvTargetFwd = cMath_Vector3Normalize(avForward);
	}
	
	//-------------------------------------------------------
	
	cVector3f mvTargetFwd;
	
	float mfRotateSpeed;
	
	float mfYaw;
	float mfPitch;
}