#include "agents/Agent_Humanoid.hps"
#include "helpers/helper_player.hps"

//------------------------------------------------------------

class cScrCryingAshley : cScrAgentHumanoid, iScrAgent_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	bool mbTrackingPlayer = false;
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		mbUsePathfinding = apVars.GetVarBool("UsePathfinding", true);
		
		cScrAgentHumanoid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
	}
	
	//------------------------------------------------------------
		
 	
	void OnUpdate(float afTimeStep)
	{
		if (!mbTrackingPlayer)
			return;
			
		cVector3f vTarget = Player_GetPosition();

		cVector3f vPos = mBaseObj.GetPosition();
		cVector3f vDiff = vTarget-vPos;
		vTarget = vPos-vDiff;	// Opposite direction, we always want to face away.
		
		cLuxCharMover @pCharMover = cast<cLuxCharMover@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_CharMover, mBaseObj.GetName()));
		pCharMover.TurnInstantlyToPos(vTarget);
	}
	
	//------------------------------------------------------------
	
	void _Global_StartTracking()
	{
		mbTrackingPlayer = true;
	}
	
	//------------------------------------------------------------
	
	void _Global_TurnAround()
	{
		// This actually is an instruction to turn around...
		mBaseObj.PlayAnimation("turn_around", 0.0f, false, true, "");
	}

	//------------------------------------------------------------
	
	void _Global_StopTracking()
	{
		mbTrackingPlayer = false;
	}
	
	//------------------------------------------------------------
}	