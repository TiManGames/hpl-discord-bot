#include "interfaces/Area_Interface.hps"
#include "player/player_types.hps"
#include "custom_depth/util_datamine.hps"

class cScrAreaDatamine : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		bool bIsBlackbox = apVars.GetVarBool("IsBlackbox", false);
		msEffectProp = apVars.GetVarString("EffectProp", "");
		bool bStopAllVoices = apVars.GetVarBool("StopAllVoices", false);
		
		mDatamine.Init(mBaseObj, null, apVars, bIsBlackbox, bStopAllVoices);
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad()
	{
		if(msEffectProp != "")
		{
			cLuxProp @pProp = cLux_ToProp( mBaseObj.GetMap().GetEntityByName(msEffectProp, eLuxEntityType_Prop));
			if(pProp !is null)
				mDatamine.SetEffectProp(pProp);
		}
		
		mDatamine.AddToHandler();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
		mDatamine.BeforeEntityDestruction();
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return mDatamine.OnInteract(alType, apBody, avFocusPos, asData);
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return mDatamine.GetInteractIconId(alType, apBody);
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void _Global_AfterScan()
	{
		mDatamine.AfterScan();
	}
	
	//------------------------------------------------------------
	
	void _Global_HasBeenMined()
	{
		cScript_SetGlobalReturnBool(mDatamine.mbInteractionDone);
	}
			
	//------------------------------------------------------------
	
	void _Global_SetGlowActive()
	{
		mDatamine.SetGlowActive(cScript_GetGlobalArgBool(0));
	}
			
	//------------------------------------------------------------
	
	void _Global_SetFinalSubjectCallback()
	{
		mDatamine.msFinalSubjectCallback = cScript_GetGlobalArgString(0);
	}
	
	//-----------------------------------------------------------------------
	
	void _Global_CanBeHighlighted()
	{
		cScript_SetGlobalReturnBool(mDatamine.mbInteractionDone==false && 
									mDatamine.mid_EffectProp != tID_Invalid);
		cScript_SetGlobalArgID(0,mDatamine.mid_EffectProp);
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimteStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		if(true) return 0;
		mBaseObj.DrawProjDebugText("Test:"+cMath_Vector3Dist(mBaseObj.GetPosition(), cLux_GetPlayer().GetCamera().GetPosition()) ,
									26, true);
		mBaseObj.DrawProjDebugText("More testing!!",
									26, true, eFontAlign_Left, cColor(1,0,0,1));
		
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cUtility_Datamine mDatamine;
	tString msEffectProp;
	
	//------------------------------------------------------------
		
}	