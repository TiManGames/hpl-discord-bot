	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		//if(true) return afStartY;
		//afStartY = cLux_DrawDebugText("SightRange: "+mBaseObj.GetCurrentPlayerSightDistance()+" (Mul: "+mBaseObj.GetSightRangeMul()+")", afStartY);
		//afStartY = cLux_DrawDebugText("DistToPlayer: "+mBaseObj.GetDistanceToPlayer(), afStartY);
		//afStartY = cLux_DrawDebugText("PlayerIsSeen: "+mBaseObj.PlayerIsSeen(), afStartY);
		cMeshEntity @pEntity = mBaseObj.GetMeshEntity();
		
		afStartY = cLux_DrawDebugText("GetUseMoveStateAnimations: "+mpMover.GetUseMoveStateAnimations(),afStartY);
		
		//for(int i=0; i<pEntity.GetAnimationStateNum(); ++i)
		/*{
			cAnimationState @pState = mBaseObj.GetCurrentAnimationState();
			if(pState !is null)
			{
				afStartY = cLux_DrawDebugText("Animation: "+pState.GetName(),afStartY);
				afStartY = cLux_DrawDebugText("  Time: "+pState.GetTimePosition(),afStartY);
				afStartY = cLux_DrawDebugText("  Speed: "+pState.GetSpeed(),afStartY);
				afStartY = cLux_DrawDebugText("  Weight: "+pState.GetWeight(),afStartY);
			}		
		}*/
		
		iCharacterBody @pCharBody= mBaseObj.GetCharBody();
		float fWantedSpeed = pCharBody.GetMoveSpeed(eCharDir_Forward);
		float fRealSpeed = cMath_Vector3Dist(pCharBody.GetPosition(), pCharBody.GetLastPosition());
		fRealSpeed = fRealSpeed / (1.0f/60.0f);
		
		if(cMath_Abs(fWantedSpeed)<0.0001) fWantedSpeed=0.0001f;
		//afStartY = cLux_DrawDebugText("Amount: "+(fRealSpeed/fWantedSpeed),afStartY);
		//afStartY = cLux_DrawDebugText("Stuck: "+mpMover.GetStuckCounter(),afStartY);
		afStartY = cLux_DrawDebugText("PlayerSeen: "+mBaseObj.PlayerIsDetected(),afStartY);
		afStartY = cLux_DrawDebugText("AwakeStageCount: "+mfDormant_AwakeStageCount + " / "+mfDormant_AwakenStageMax,afStartY);
		afStartY = cLux_DrawDebugText("AwakeStage: "+mlDormant_AwakeStage,afStartY);
		afStartY = cLux_DrawDebugText("ExtraSensitive: "+mbDormant_ExtraSensitive+" Count: "+mfDormant_ExtraSensitiveCount,afStartY);
		afStartY = cLux_DrawDebugText("DistToPlayer: "+ mBaseObj.GetDistanceToPlayer(),afStartY);
		afStartY = cLux_DrawDebugText("HuntCount: "+ mfAgressive_HuntCount,afStartY);
		afStartY = cLux_DrawDebugText("ReactToStimuliCount: "+ mfDormant_ReactToStimuliCount,afStartY);
		afStartY = cLux_DrawDebugText("StateChangeCount: "+ mfDormant_StateChangeCount,afStartY);
		//afStartY = cLux_DrawDebugText("mfRetreat_InsideRepelAreaCount: "+ mfRetreat_InsideRepelAreaCount,afStartY);
		afStartY = cLux_DrawDebugText("PlayerMoveCount: "+ mfDormant_PlayerMoveCount,afStartY);
		afStartY = cLux_DrawDebugText("GetSightRange: "+ mBaseObj.GetSightRangeAffectedByModifiers(),afStartY);		
		
		if (cLux_GetExplorationModeActive())
		{
			afStartY = cLux_DrawDebugText("ExplorationMode_ForceHuntPause: "+ mbExplorationMode_ForceHuntPause, afStartY);
			afStartY = cLux_DrawDebugText("ExplorationMode_SlowHunt: "+ mbExplorationMode_SlowHunt, afStartY);
			afStartY = cLux_DrawDebugText("ExplorationMode_KnockAwayCooldown: "+ mfExplorationMode_KnockAwayCooldown, afStartY);
			
		}
		
		
		return afStartY;
	}
	
