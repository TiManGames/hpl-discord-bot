//-------------------------------------------------------

/////////////////////////////////////////
// LEVIATHAN
/////////////////////////////////////////

//-------------------------------------------------------

/**
 * Disables all sounds for the specified Leviathan. Useful for custom events. Cannot reactivate. Use at the start of the map.
 **/
void Leviathan_InitSilent(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_InitSilent");
}

//-------------------------------------------------------

void Leviathan_SetIsHunting(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetIsHunting");
}

void Leviathan_HuntDashAtPlayer(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_HuntDashAtPlayer");
}

//-------------------------------------------------------

void Leviathan_SetFollowTrackDeathMeter(const tString &in asEntityName, bool abX, float afDamage)
{
	cScript_SetGlobalArgBool(0, abX);
	cScript_SetGlobalArgFloat(1, afDamage);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetFollowTrackDeathMeter");
}

//-------------------------------------------------------

void Leviathan_SetState_FollowTrack(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetState_FollowTrack");
}

void Leviathan_SetState_CirclePlayer(const tString &in asEntityName)
{
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetState_CirclePlayer");
}

//-------------------------------------------------------

void Leviathan_SetSpeed_Normal(const tString &in asEntityName) {
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetSpeed_Normal");
}

void Leviathan_SetSpeed_Hunt(const tString &in asEntityName) {
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetSpeed_Hunt");
}

void Leviathan_SetSpeed_CircleFast(const tString &in asEntityName) {
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetSpeed_CircleFast");
}


void Leviathan_SetSpeed_HuntDash(const tString &in asEntityName) {
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetSpeed_HuntDash");
}

//-------------------------------------------------------

void Leviathan_SetLightBrightness(const tString &in asEntityName, float afX) {
	cScript_SetGlobalArgFloat(0, afX);
	cScript_RunGlobalFunc(asEntityName, "cScrAgentLeviathan", "_Global_SetLightBrightness");
}