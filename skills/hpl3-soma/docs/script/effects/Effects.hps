
//-----------------------------------------

#include "interfaces/Effect_Interface.hps"

//-----------------------------------------

shared enum eEffect
{
	eEffect_Shake=0,
	eEffect_DoF=2,
	eEffect_ToneMapping=3,
	eEffect_ImageTrail=4,
	eEffect_Flash=5,
	eEffect_Screen=6,
	eEffect_ChromaticAberration=7,
	eEffect_RadialBlur=8,
	eEffect_VideoDistortion=9,
	eEffect_TimeGlitch=10,
	eEffect_Sway=11,
	eEffect_ImageFadeFX=12,
	eEffect_Gamepad=13
}

//-----------------------------------------

shared interface iScrEffect_Shake
{
	int Start(float afAmount, float afTime, float afFadeInTime,float afFadeOutTime,const cVector3f&in avDirAmount, float afFrequency);
	void FadeOut(int alID, float afFadeOutTime);
	void SetSourceEntity(int alID, tID a_idSource, float afMinDist, float afMaxDist, eEasing aEasingType);
	float GetCurrentShakeAmount();
	
}

//-----------------------------------------

shared interface iScrEffect_Fade
{
	void FadeIn(float afTime);
	void FadeOut(float afTime);
	bool IsFading();
}

//-----------------------------------------

shared interface iScrEffect_FadeProperty
{
	void FadeProperty(int alVarId, float afValue, float afTime);
}

//-----------------------------------------

shared interface iScrEffect_ToneMapping
{
	void SetFilmGrainActive(bool abX);
	void SetBloomActive(bool abX);

	void SetKey(float afKey);

	void FadeExposure(float afExposure, float afTime);
	void FadeWhiteCut(float afWhiteCut, float afTime);

	void FadeGrading(tString asTextureName, float afTime);
	void FadeGrading(iTexture@ apTexture, float afTime);

	void FadeBrightPass(float afBrightPass, float afTime);
	void FadeBloomWidth(float afBloomWidth, float afTime);
	void FadeBloomTint(float afR, float afG, float afB, float afTime);
	void FadeBloomFalloff(float afFalloff, float afTime);
	void SetSRGB(bool abX);

	void FadeFilmGrainIntensity(float afIntensity, float afTime);

	float GetExposure();
}

//-----------------------------------------

shared interface iScrEffect_DepthOfField
{
	int Start(float afFocusStart, float afFocusEnd, float afFalloff, float afFadeTime);
	void FadeFocus(int alID, float afFocusStart, float afFocusEnd, float afTime);
	void FadeFalloff(int alID, float afFocusFalloff, float afTime);
	void FadeOut(int alID, float afTime);
}

//-----------------------------------------

shared interface iScrEffect_Flash
{
	void Start(float afFadeIn, float afWhite, float afFadeOut);
}

//-----------------------------------------

shared interface iScrEffect_ImageTrail
{
	int Start(float afAmount, float afFadeIn, float afWhite, float afFadeOut);
	void SetDirectAmount(float afAmount);
	void FadeOut(int alID, float afFadeOut);
	void ClearAll();
}

//-----------------------------------------

shared interface iScrEffect_ChromaticAberration
{
	void StartAnim(float afDuration, float afAmount, float afRandomness, cVector2f avDirection);
	void SetDirect(float afAmount, float afRotation, float afHue, const cVector2f&in avOffset);
	int CreateInstance(float afAmount, float afRotation, float afHue, 
							const cVector2f&in avOffset=cVector2f_Zero);
	void SetInstanceValues(int alID, float afAmount, float afRotation, float afHue, 
							const cVector2f&in avOffset=cVector2f_Zero);
	void DestroyInstance(int alID);
}

//-----------------------------------------

shared interface iScrEffect_Screen
{
	int Start(tString asMaterial, cVector2f avPosition, cVector2f avSize);
	int Start(tString asMaterial, cVector2f avPosition, cVector2f avSize, float afTargetAlpha, float afFadeInTime, float afStayTime, float afFadeOutTime);

	void FadeOut(int alID, float afFadeTime);
	void FadeLiquidAmount(int alID, float afAmount, float afFadeTime);
	void FadeAlpha(int alID, float afAlpha, float afFadeTime);
}

//-----------------------------------------

shared interface iScrEffect_RadialBlur
{
	void SetDirect(float afSize, float afAlpha, float afDistance);
	int Start(float afSize, float afAlpha, float afDistance, float afTime);
	void FadeSize(int alID, float afSize, float afTime);
	void FadeStartDistance(int alID, float afDistance, float afTime);
	void FadeAlpha(int alID, float afAlpha, float afTime);
	void FadeOut(int alID, float afTime);
}

//-----------------------------------------

shared interface iScrEffect_VideoDistortion
{
	void SetSoundEffectsDisabled(bool abX);
	void SetDirectAmount(float afAmount);
	int Start(float afAmount, float afTime, float afFadeInTime, float afFadeOutTime, float afVolume);
	void FadeOut(int alID,float afFadeOutTime);
	void SetMaxAmount(int alID, float afMaxAmount);
	float GetAmount();
	float GetEffectAmount();
}

//-----------------------------------------

shared interface iScrEffect_ImageFadeFX
{
	void SetAmount(float afAmount);
	void FadeAmount(float afAmount, float afTime);
	void SetTextures(const tString& in asFadeTexture, const tString& in asColorTexture, const tString& in asOffsetTexture);
	
}

//-----------------------------------------

shared interface iScrEffect_TimeGlitch
{
	void Start(float afTimeAdvancement, float afPlayFastSoundTime, float afShakeAmount, bool abPlayEffectSound, float afSoundVol);
}

//-----------------------------------------

shared interface iScrEffect_Sway
{
	void FadeIn(float afSize, float afTime, float afRate, float afAngle, float afInitialAmount, 
		float afYMul, float afDecay, float afMoveFactor);
	void SetDirect(float afSize, float afRate, float afAngle, float afInitialAmount, 
		float afYMul, float afDecay, float afMoveFactor);
	void FadeOut(float afTime);
	void Stop();
	cVector3f GetOffset();
}

//-----------------------------------------

shared interface iScrEffect_Gamepad
{
	int StartRumble(float afAmount, float afTime, float afFadeInTime,float afFadeOutTime);
	int StartColorFade(cColor aColor, float afTime);
	void StopRumble(int alID);
	void StopColorFade(int alID);
	void SetShakeRumbleMul(float afX);
	void WakeUp();
}
	
//-----------------------------------------
