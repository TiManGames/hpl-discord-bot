#include "effect/Effects.hps"

/////////////////////////////////////////
// SETTINGS - IMAGE FADE FX
/////////////////////////////////////////

//------------------------------------------------------------

enum eImageFadeFXTexture
{
	eImageFadeFXTexture_Fade,
	eImageFadeFXTexture_Color,
	eImageFadeFXTexture_Offset,
	
}
//------------------------------------------------------------

class cScrEffect_ImageFadeFX : iScrEffect, iScrEffect_Interface, iScrEffect_ImageFadeFX 
{

	//----------------------------------
	
	void Init()
	{
		mvTextures.resize(3);
		msTextures.resize(3);
	}
	
	//----------------------------------
	
	void OnDestroy()
	{
		if(mpEffect is null) return;
		
		cLux_GetViewport().GetPostEffectComposite().RemovePostEffect(mpEffect);
		cGraphics_DestroyPostEffect(mpEffect);
		@mpEffect = null;
		mbEffectLoaded = false;
	}
	
	//---------------------------------

	void CreatePostEffect()
	{
		if(mbEffectLoaded == false)
		{
			//////////////////
			// Create the post effect if null
			@mpEffect = cast<cPostEffect_ImageFadeFX@>(cLux_GetViewport().GetPostEffectComposite().GetPostEffectFromType("ImageFadeFX"));

			if(mpEffect is null)
			{
				@mpEffect = cGraphics_CreatePostEffect_ImageFadeFX();
				cLux_GetViewport().GetPostEffectComposite().AddPostEffect(mpEffect, 100);
			}

			mbEffectLoaded = true;
		}
	}
	
	//----------------------------------
	
	void DestroyTextures()
	{
		for(int i=0; i<3; ++i)
		{
			if(mvTextures[i] !is null)
			{
				cResources_DestroyTexture(mvTextures[i]);
				msTextures[i] = "";
				@mvTextures[i] = null;
			}
		}
	}
	
	//----------------------------------
		
	void CreateTextures()
	{
		for(int i=0; i<3; ++i)
		{
			if(mvTextures[i] is null && msTextures[i] != "")
			{
				@mvTextures[i] = cResources_CreateTexture2D(msTextures[i], false);
				if(mvTextures[i] is null) msTextures[i] = "";
			}
		}
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PUBLIC METHODS
	/////////////////////////////////////////
	
	//---------------------------------
	
	void SetEffectTexture(const tString& in asTextureFile, int alId)
	{
		if(asTextureFile != msTextures[alId])
		{
			if(mvTextures[alId] !is null)
			{
				cResources_DestroyTexture(mvTextures[alId]);
			
				@mvTextures[alId] = null;
			}
			
			msTextures[alId] = asTextureFile;
			if(msTextures[alId] != "")
			{
				@mvTextures[alId] = cResources_CreateTexture2D(asTextureFile, false);
				if(mvTextures[alId] is null){
					Error("Effect ImageFadeFX could not load texture: '"+asTextureFile+"'");
					msTextures[alId] = "";
				} 
			}
			else
				@mvTextures[alId] = null;
		}
	}
	
	void SetTextures(const tString& in asFadeTexture, const tString& in asColorTexture, const tString& in asOffsetTexture)
	{
		CreatePostEffect();
		
		SetEffectTexture(asFadeTexture, 0);
		
		SetEffectTexture(asColorTexture, 1);
		
		SetEffectTexture(asOffsetTexture, 2);
		
		mpEffect.SetParams(mfAmount, mvTextures[0], mvTextures[1], mvTextures[2]);
	}
	
	//---------------------------------
	
	void FadeAmount(float afAmount, float afTime)
	{
		mfGoalAmount = afAmount;
		
		if(afTime >0)		
			mfAmountChangeSpeed = cMath_Abs(mfGoalAmount - mfAmount) / afTime;
		else
			SetAmount(mfGoalAmount);
			
		mBaseObj.SetActive(true);
	}
	
	void SetAmount(float afAmount)
	{
		CreatePostEffect();
		
		mfAmount = afAmount;
		
		mBaseObj.SetActive(mfAmount>0);
		mpEffect.SetParams(mfAmount, mvTextures[0], mvTextures[1], mvTextures[2]);
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// GENERAL CALLBACKS
	/////////////////////////////////////////
	
	
	//----------------------------------
	
	void OnStart()
	{
	}

	//----------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}
	
	//----------------------------------
	
	void OnMapLeave(cLuxMap @apMap)
	{
		Reset();
	}

	//----------------------------------
	
	void Reset()
	{
		DestroyTextures();
		
		if(mbEffectLoaded)
		{
			mpEffect.SetParams(0.0f, null, null, null);
		}	
	}

	//----------------------------------
	
	void Update(float afTimeStep)
	{
		///////////////////////
		// Creation check
		CreatePostEffect();
		CreateTextures();
		
		///////////////////////
		// Fade
		if(mfGoalAmount != mfAmount)
		{
			mfAmount = cMath_IncreaseTo(mfAmount, mfAmountChangeSpeed*afTimeStep, mfGoalAmount);
			SetAmount(mfAmount);
			cLux_AddDebugMessage("Amount: "+mfAmount);
		}
	}

	void OnDraw(float afTimeStep)
	{
	}

	//----------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//----------------------------------
	
	[nosave] bool mbEffectLoaded=false;
	
	//----------------------------------

	[nosave] cPostEffect_ImageFadeFX@ mpEffect = null;
	
	[nosave] array<iTexture@> mvTextures;
	array<tString> msTextures;
	
	//----------------------------------
	
	float mfAmount=0;
	float mfGoalAmount=0;
	float mfAmountChangeSpeed=0;
	
	
	//----------------------------------
}