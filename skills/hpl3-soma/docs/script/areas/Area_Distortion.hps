#include "interfaces/Area_Interface.hps"
#include "base/Player_Types.hps"

#include "helpers/helper_effects.hps"

class cScrAreaDistortion : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		mfEffectAmount = apVars.GetVarFloat("EffectAmount", 0);
		mfFadeInTime = apVars.GetVarFloat("FadeInTime", 1);
		mfFadeOutTime = apVars.GetVarFloat("FadeOutTime", 1);
		mfVolume = apVars.GetVarFloat("Volume", 1);
	
		msSourceEntity = apVars.GetVarString("SourceEntity", "");
		mfSourceEntityMinDist = apVars.GetVarFloat("SourceEntityMinDist", 1);
		mfSourceEntityMaxDist = apVars.GetVarFloat("SourceEntityMaxDist", -1);
		
		mBaseObj.SetCheckCollision(false);
	}
	
	//------------------------------------------------------------
		
	void OnAfterWorldLoad()
	{
		////////////////////////
		// Setup source entity
		if (msSourceEntity == "")
			return;
			
		iLuxEntity@ pEntity = mBaseObj.GetMap().GetEntityByName(msSourceEntity);
		
		if (pEntity is null)
		{
			Error("Entity "+msSourceEntity+" could not be found as source for distortion area "+mBaseObj.GetName());
			return;
		}
		
		m_idSourceEntity = pEntity.GetID();
		
		if (mfSourceEntityMaxDist >= 0)
			return;
			
		cVector3f vSize = mBaseObj.GetSize();
		for (int i = 0; i < 3; i++)
		{
			if (vSize.GetElement(i) > mfSourceEntityMaxDist)
				mfSourceEntityMaxDist = vSize.GetElement(i);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afDeltaTime)
	{			
		bool bCollision = mBaseObj.CollidesWithPlayer();
		if (bCollision)
		{
			float fAmount = mfEffectAmount;
			
			if (m_idSourceEntity != tID_Invalid)
			{
				iLuxEntity@ pEntity = mBaseObj.GetMap().GetEntityByID(m_idSourceEntity);
				cVector3f vDelta = cLux_GetPlayer().GetCharacterBody().GetPosition()-pEntity.GetPosition();
				float fDist = vDelta.Length();
				
				fAmount = 1.0f - (fDist - mfSourceEntityMinDist)/(mfSourceEntityMaxDist - mfSourceEntityMinDist);
				fAmount = cMath_Clamp(fAmount, 0.0, 1.0);
				fAmount*=mfEffectAmount;
			}
			
			fAmount += mfAddedEffectAmount;
			
			if (mlDistortionID == -1)
				mlDistortionID = Effect_VideoDistortion_Start(fAmount, -1, mfFadeInTime, 0, mfVolume);
			else
				Effect_VideoDistortion_SetMaxAmount(mlDistortionID, fAmount);
		}
		else if (bCollision==false && mlDistortionID >= 0)
		{
			Effect_VideoDistortion_FadeOut(mlDistortionID, mfFadeOutTime);
			mlDistortionID = -1;
		}
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return 0;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimteStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		if (abX==false)
		{
			if (mlDistortionID >= 0)
			{
				Effect_VideoDistortion_FadeOut(mlDistortionID, mfFadeOutTime);
				mlDistortionID = -1;
			}
		}
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void _Global_SetAddedDistortionAmount()
	{
		mfAddedEffectAmount = cScript_GetGlobalArgFloat(0);
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfEffectAmount = 0;
	float mfAddedEffectAmount = 0;
	float mfFadeInTime = 1;
	float mfFadeOutTime = 1;
	float mfVolume = 1;
	
	tString msSourceEntity = "";
	tID m_idSourceEntity = tID_Invalid;
	float mfSourceEntityMinDist = 1;
	float mfSourceEntityMaxDist = -1;
	
	int mlDistortionID = -1;
	
	//------------------------------------------------------------
}	