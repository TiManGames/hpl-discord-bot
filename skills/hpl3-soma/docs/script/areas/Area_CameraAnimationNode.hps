#include "interfaces/Area_Interface.hps"
#include "helpers/helper_player.hps"

// Initial value for eyeline
const float gfInvalidY = -9999.0f;

class cScrAreaCameraAnimationNode : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		mfMaxYaw = cMath_ToRad(apVars.GetVarFloat("MaxYaw", 45));
		mfMaxPitch = cMath_ToRad(apVars.GetVarFloat("MaxPitch", 45));
		mfLookSpeedMul = apVars.GetVarFloat("LookSpeedMultiplier", 1);
		mfAutoMove = apVars.GetVarFloat("AutoMovement", 0);
		mfLookMoveDist = apVars.GetVarFloat("LookMoveDistance", 0);
		mfLookMoveAngle = cMath_ToRad(apVars.GetVarFloat("LookMoveMaxAngle", 0));
		mbInteractive = apVars.GetVarBool("InteractiveMovement", true);
		mbCrouchOnExit = apVars.GetVarBool("CrouchOnExit", false);
		mbInitToCamera = apVars.GetVarBool("InitToCamera", false);
		mbUseSpeedFading = apVars.GetVarBool("UseSpeedFading", true);
		msCallbackFunc = apVars.GetVarString("CallbackFunc", "");
		mbUsePlayerEyeline = apVars.GetVarBool("UsePlayerEyeline",false);
		
		mfAutoMoveFadeGoal = mfAutoMove;
		
		// Calculate speed
		float fFwdTime = apVars.GetVarFloat("ForwardTime", 1);
		if (fFwdTime > 0)
			mfFwdSpeed = 1.f/fFwdTime;
		else
			mfFwdSpeed = 0;
		float fBackTime = apVars.GetVarFloat("BackwardTime", 1);
		if (fBackTime > 0)
			mfBackSpeed = 1.f/fBackTime;
		else
			mfBackSpeed = 0;
		
		mBaseObj.SetCheckCollision(false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	bool OnUpdateAutoSleep()
	{
		return mfAutoMoveFadeGoal == mfAutoMove;
	}

	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		/////////////////////
		// //Fade automove
		if (mfAutoMoveFadeGoal != mfAutoMove)
		{
			mfAutoMove = cMath_Easing(mAutoMoveFadeEasing, mfAutoMoveFadeCounter, mfAutoMoveFadeStart, mfAutoMoveFadeGoal);
			mfAutoMoveFadeCounter += afTimeStep/mfAutoMoveFadeTime;
		}
		
		if (mbUsePlayerEyeline && mvLastPos!=mBaseObj.GetPosition())
		{
			mfCachedEyeline = gfInvalidY;
			mvLastPos = mBaseObj.GetPosition();
		}
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimteStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}

	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_GetMaxYaw()
	{
		cScript_SetGlobalReturnFloat(mfMaxYaw);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetMaxPitch()
	{
		cScript_SetGlobalReturnFloat(mfMaxPitch);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetLookSpeedMul()
	{
		cScript_SetGlobalReturnFloat(mfLookSpeedMul);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetForwardTime()
	{
		float fTime = 0;
		if (mfFwdSpeed > 0) fTime = 1.f/mfFwdSpeed;
		
		cScript_SetGlobalReturnFloat(fTime);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetBackTime()
	{
		float fTime = 0;
		if (mfBackSpeed > 0) fTime = 1.f/mfBackSpeed;
		
		cScript_SetGlobalReturnFloat(fTime);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetForwardSpeed()
	{
		cScript_SetGlobalReturnFloat(mfFwdSpeed);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetBackSpeed()
	{
		cScript_SetGlobalReturnFloat(mfBackSpeed);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetAutoMove()
	{
		cScript_SetGlobalReturnFloat(mfAutoMove);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetLookMoveDist()
	{
		cScript_SetGlobalReturnFloat(mfLookMoveDist);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetLookMoveAngle()
	{
		cScript_SetGlobalReturnFloat(mfLookMoveAngle);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetInteractiveMovement()
	{
		cScript_SetGlobalReturnBool(mbInteractive);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetInteractiveMovement()
	{
		mbInteractive = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetCrouchOnExit()
	{
		cScript_SetGlobalReturnBool(mbCrouchOnExit);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetInitToCamera()
	{
		cScript_SetGlobalReturnBool(mbInitToCamera);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetInitToCamera()
	{
		mbInitToCamera = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetUseSpeedFading()
	{
		cScript_SetGlobalReturnBool(mbUseSpeedFading);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetCallbackFunc()
	{
		cScript_SetGlobalReturnString(msCallbackFunc);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetCallbackFunc()
	{
		msCallbackFunc = cScript_GetGlobalArgString(0);
	}
	
	//-----------------------------------------------------------------------
	
	void _Global_SetAutoMove()
	{
		mfAutoMove = cScript_GetGlobalArgFloat(0);
		mfAutoMoveFadeGoal = mfAutoMove;

		mBaseObj.WakeUp();
	}
	
	//-----------------------------------------------------------------------
	
	void _Global_FadeAutoMove()
	{
		mfAutoMoveFadeGoal = cScript_GetGlobalArgFloat(0);
		if (cMath_Abs(mfAutoMove-mfAutoMoveFadeGoal) < 0.001)
		{
			mfAutoMove = mfAutoMoveFadeGoal;
			return;
		}
		mfAutoMoveFadeStart = mfAutoMove;
		mfAutoMoveFadeTime = cMath_Max(cScript_GetGlobalArgFloat(1), 0.001);
		mAutoMoveFadeEasing = eEasing(cScript_GetGlobalArgInt(2));
		mfAutoMoveFadeCounter = 0;

		mBaseObj.WakeUp();
	}
	
	//-----------------------------------------------------------------------
	
	void _Global_GetPosition()
	{
		cVector3f vPosition = mBaseObj.GetPosition();
		if (mbUsePlayerEyeline)
		{
			if (mfCachedEyeline==gfInvalidY)	// Not cached
			{
				// Figure out how far it is to the ground
				float fDistance=0.0f;
				cVector3f vNormal;
				iPhysicsBody@ pHit = cLux_GetClosestBody(vPosition, cVector3f_Down, 100.0f, fDistance, vNormal);
				if (pHit is null)
				{
					Error("No ground under camera animation node that requires eyeline:"+mBaseObj.GetName());
				}
				else
				{
					float fGround = vPosition.y-fDistance;
					float fPlayerEyelineHeight = Player_GetDefaultEyelineHeight();
					mfCachedEyeline = fGround + fPlayerEyelineHeight;
				}			
			}
			vPosition.y = mfCachedEyeline;
		}
		cScript_SetGlobalReturnVector3f(vPosition);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfMaxYaw;
	float mfMaxPitch;
	float mfLookSpeedMul;
	float mfFwdSpeed;
	float mfBackSpeed;
	float mfAutoMove;
	float mfLookMoveDist;
	float mfLookMoveAngle;
	bool mbInteractive;
	bool mbCrouchOnExit;
	bool mbInitToCamera;
	bool mbUseSpeedFading;
	tString msCallbackFunc;
	bool mbUsePlayerEyeline;
	float mfCachedEyeline = gfInvalidY;
	cVector3f mvLastPos = cVector3f_Zero;
	
	float mfAutoMoveFadeStart;
	float mfAutoMoveFadeGoal;
	eEasing mAutoMoveFadeEasing;
	float mfAutoMoveFadeTime;
	float mfAutoMoveFadeCounter;
	
	//------------------------------------------------------------
		
}	