#include "interfaces/Area_Interface.hps"
#include "helpers/helper_player.hps"

class cScrAreaHide: iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mbPlayerIsInside = false;

		mBaseObj.SetAutoSleep(false);
		mBaseObj.SetVariableUpdateRate(cMath_RandRectf(0.25f, 0.35f)); //call variable update no faster than once per 0.3 sec
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{			
		mlPrio = apVars.GetVarInt("Prio", 0);
		mbRequiresCrouch = apVars.GetVarBool("RequiresCrouch", true);
		mfVisibilityRange = apVars.GetVarFloat("VisibilityRange", 3);
		mbRelativeVisRange = apVars.GetVarBool("RelativeVisRange", false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep)
	{	
		bool bCollide = mBaseObj.CheckCharacterCollision(cLux_GetPlayer().GetCharacterBody(), cLux_GetCurrentMap());
		
		//////////////////////////////
		// Player enters
		if(bCollide && mbPlayerIsInside==false)
		{
			cScript_SetGlobalArgID(0, mBaseObj.GetID());
			cScript_SetGlobalArgInt(1, mlPrio);
			cScript_SetGlobalArgBool(2, mbRequiresCrouch);
			cScript_SetGlobalArgFloat(3, mfVisibilityRange);
			cScript_SetGlobalArgBool(4, mbRelativeVisRange);
			cScript_RunGlobalFunc("LuxPlayer", "", "_Global_AddHideArea");
		}
		//////////////////////////////
		// Player leaves
		else if(bCollide==false && mbPlayerIsInside)
		{
			cScript_SetGlobalArgID(0, mBaseObj.GetID());
			cScript_RunGlobalFunc("LuxPlayer", "", "_Global_RemoveHideArea");
		}
		
		
		mbPlayerIsInside = bCollide;
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
		
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlPrio;
	bool mbRequiresCrouch;
	float mfVisibilityRange;
	bool mbRelativeVisRange;
	
	//------------------------------------------------------------
	
	bool mbPlayerIsInside;
		
	//------------------------------------------------------------
		
}	