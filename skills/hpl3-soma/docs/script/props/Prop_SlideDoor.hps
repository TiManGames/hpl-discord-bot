#include "interfaces/Prop_Interface.hps"
#include "player/Player_Types.hps"

class cSlideDoorPart
{
	iPhysicsBody @mpBody;
	cVector3f mvClosedPos;
	cVector3f mvOpenPos;
}


class cScrPropSlideDoor : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mfOpenAmount = 0;
		mfOpenAmountGoal =0;
		mbDoorMoving = false;
		mfCurrentSpeed = 0;
		mlLoopSoundId = -1;
		mfAutoCloseTimeCount =0;
		mfAutoCloseTestCount =0;
		
		mBaseObj.SetIsDoor(true);
		mBaseObj.SetIsClosedDoor(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void AddDoorPart(const tString&in asBody, cVector2f &in avMoveDir, float afMoveAmount)
	{
		cSlideDoorPart doorPart;
		
		///////////////////////////
		// Get Body
		int lBodyIdx = mBaseObj.GetBodyIndexFromName(asBody);
		if(lBodyIdx<0) 
		{
			Error("Could not find body '"+asBody+"' for slide door '"+mBaseObj.GetName()+"'\n");
			return;
		}
		iPhysicsBody @pBody = mBaseObj.GetBody(lBodyIdx);
		@doorPart.mpBody = pBody;
		
		///////////////////////////
		// Set up moveamount
		doorPart.mvClosedPos = pBody.GetLocalPosition();
		
		cBoundingVolume@ pBounds = pBody.GetBoundingVolume();
		cMatrixf mtxTransform = pBounds.GetTransform();
		pBounds.SetTransform(cMatrixf_Identity);
		
		cVector3f vDir(avMoveDir.x, avMoveDir.y, 0);
		vDir = vDir*pBounds.GetSize();
		vDir = cMath_MatrixMul3x3(mBaseObj.GetOnLoadTransform(), vDir); //Transform into world postion!
				
		doorPart.mvOpenPos = doorPart.mvClosedPos + vDir * afMoveAmount;
		
		pBounds.SetTransform(mtxTransform);
		
		///////////////////////////
		//Add to array
		mvDoorParts.insertLast(doorPart);
	}
	
	//------------------------------------------------------------
	
	void SetDoorOpenAmount(cSlideDoorPart &aDoorPart, float afAmount)
	{
		cVector3f vPos = GetClosedPos(aDoorPart)*(1-afAmount) + GetOpenPos(aDoorPart)*afAmount;
		
		aDoorPart.mpBody.SetPosition(vPos);
	}
	
		
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		/////////////////////////////////
		// Door Part properties
		tString sDoorBodies  = apVars.GetVarString("DoorParts_Body", ""); 
		tString sDoorMoveDirs  = apVars.GetVarString("DoorParts_MoveDir", ""); 
		tString sDoorMoveAmounts  = apVars.GetVarString("DoorParts_MoveAmount", ""); 
		
		array<tString> vBodies;
		array<float> vMoveDirs;
		array<float> vMoveAmounts;
		
		cString_GetStringVec(sDoorBodies, vBodies, "");
		cString_GetFloatVec(sDoorMoveDirs, vMoveDirs, "");
		cString_GetFloatVec(sDoorMoveAmounts, vMoveAmounts, "");
		
		m_mtxAttachment = cMatrixf_Identity;
		mbAttachmentUpdated = false;

		for(int i=0; i<vBodies.length(); ++i)
		{
			cVector2f vDir;
			vDir = (i*2+1 < vMoveDirs.length()) ? cVector2f(vMoveDirs[i*2], vMoveDirs[i*2+1]) : cVector2f(0,0);
			float fAmount = (vMoveAmounts.length()>=i+1) ? vMoveAmounts[i] : 0;
		
			AddDoorPart(vBodies[i], vDir, fAmount);		
		}
		
		/////////////////////////////////
		// Properties	
		mBaseObj.SetInteractionDisabled(!apVars.GetVarBool("OpenableByInteraction", true));	
		mfOpenSpeed = apVars.GetVarFloat("OpenSpeed", 1);
		mfCloseSpeed = apVars.GetVarFloat("CloseSpeed", 1);
		mfOpenAcc = apVars.GetVarFloat("OpenAcc", 1); 
		mfCloseAcc = apVars.GetVarFloat("CloseAcc", 6);
		mfOpenSlowDownDist = apVars.GetVarFloat("OpenSlowDownDist", 0.1f);
		mfCloseSlowDownDist = apVars.GetVarFloat("CloseSlowDownDist", 0.1f);
		mbCheckCollision = apVars.GetVarBool("CheckCollision", true);
		mfPushImpulse = apVars.GetVarFloat("PushImpulse", 0.08f);
		mfPushMaxMass = apVars.GetVarFloat("PushMaxMass", 40);
		
		msOpenSound_Start = apVars.GetVarString("OpenSound_Start","");
		msOpenSound_End = apVars.GetVarString("OpenSound_End","");
		msCloseSound_Start = apVars.GetVarString("CloseSound_Start","");
		msCloseSound_End = apVars.GetVarString("CloseSound_End","");
		msOpenSound_Loop = apVars.GetVarString("OpenSound_Loop","");
		msCloseSound_Loop = apVars.GetVarString("CloseSound_Loop","");
		
		mbUseAnimations = apVars.GetVarBool("UseAnimations", false);
		msAnimation_Opening = apVars.GetVarString("Animation_Opening", "");
		msAnimation_Closing = apVars.GetVarString("Animation_Closing", "");
		msAnimation_Open = apVars.GetVarString("Animation_Open", "");
		msAnimation_Closed = apVars.GetVarString("Animation_Closed", "");
		mbAnimation_ReplaceMovement = apVars.GetVarBool("Animation_ReplaceMovement", false);
		msAnimation_CollisionOpenBody = apVars.GetVarString("Animation_CollisionOpenBody", "");
		msAnimation_CollisionClosedBody = apVars.GetVarString("Animation_CollisionClosedBody", "");
		mfAnimation_CollisionOpenTime = apVars.GetVarFloat("Animation_CollisionOpenTime", 0);
		mfAnimation_CollisionClosedTime = apVars.GetVarFloat("Animation_CollisionClosedTime", 0);
		
		/////////////////////////////////
		// Get Bodies
		{
			if(msAnimation_CollisionOpenBody != "")
			{
				@mpBodyOpen = mBaseObj.GetBodyFromName(msAnimation_CollisionOpenBody);
				if(mpBodyOpen is null)
				{
					Error("Physics body '"+msAnimation_CollisionOpenBody+"' was not found in entity '"+mBaseObj.GetName()+"' to be used as CollisionOpenBody. MainBody used instead.");
					@mpBodyOpen = mBaseObj.GetMainBody();
				}
			}
			else
				@mpBodyOpen = null;
			
			if(msAnimation_CollisionClosedBody != "")
			{
				@mpBodyClosed = mBaseObj.GetBodyFromName(msAnimation_CollisionClosedBody);
				if(mpBodyClosed is null)
				{
					Error("Physics body '"+msAnimation_CollisionClosedBody+"' was not found in entity '"+mBaseObj.GetName()+"' to be used as CollisionClosedBody.");
					@mpBodyClosed = mBaseObj.GetMainBody();
				}
			}
			else
				@mpBodyClosed = mBaseObj.GetMainBody();
			
		}
		
		/////////////////////////////////
		// Agent collide body
		tString sAgentCollideBody = apVars.GetVarString("AgentColliderBody", "");
		if(sAgentCollideBody != "")
		{
			@mpAgentColliderBody = mBaseObj.GetBodyFromName(sAgentCollideBody);
			if(mpAgentColliderBody is null)
			{
				Error("Could not find AgentColliderBody '"+sAgentCollideBody+"' for slide door '"+mBaseObj.GetName()+"'");
			}
			else
			{
				//Only collides to characters that are not the player!
				mpAgentColliderBody.SetCollide(false);
				mpAgentColliderBody.SetCollideFlags(mBaseObj.GetMap().GetCollideFlag("-player"));
			}
		}
		
		/////////////////////////////////
		// Calculate the BV for entire (closed door)
		mvDoorAABB_Min = cVector3f(100000.0f);
		mvDoorAABB_Max = cVector3f(-100000.0f);
		
		for(int i=0; i<mBaseObj.GetBodyNum(); ++i)
		{
			iPhysicsBody@ pBody = mBaseObj.GetBody(i);
			
			mvDoorAABB_Min = cMath_ExpandAABBMin(mvDoorAABB_Min, pBody.GetBoundingVolume().GetMin());
			mvDoorAABB_Max = cMath_ExpandAABBMax(mvDoorAABB_Max, pBody.GetBoundingVolume().GetMax());
		}
		
		////////////////////////////////////
		// Instance variables
		mbOpenableByAgent = apInstanceVars.GetVarBool("OpenableByAgent", true);
		
		mbInteractToOpen = apInstanceVars.GetVarBool("InteractToOpen", false);
		
		mfAutoCloseTime = apInstanceVars.GetVarFloat("AutoCloseTime", 0);
		
		/////////////////////////////////////////
		// Set open amount
		mfOpenAmount = apInstanceVars.GetVarFloat("OpenAmount", 0);
		
		if (mbUseAnimations || mbAnimation_ReplaceMovement || mfOpenAmount > 0)
			SetOpenAmountInstantly(mfOpenAmount);
			
	}
	
	//------------------------------------------------------------
	
	void SetOpenAmountInstantly(float afX)
	{
		mfOpenAmount = afX;
		
		SetIsClosed(mfOpenAmount<0.95f);
		
		///////////////
		// Animations
		if(mbUseAnimations)
		{
			mBaseObj.StopAllAnimations(0.0f);
			
			if(mfOpenAmount > 0)
			{
				if (msAnimation_Open!="")
				{
					mBaseObj.PlayAnimation(msAnimation_Open, 0.0f, true);
				}
				else
				{
					mlCurrentAnimation = mBaseObj.PlayAnimation(msAnimation_Opening);
					mBaseObj.GetMeshEntity().GetAnimationState(mlCurrentAnimation).SetRelativeTimePosition(1);
				}
			}
			else
			{
				if (msAnimation_Closed!="")
				{
					mBaseObj.PlayAnimation(msAnimation_Closed, 0.0f, true);
				}
				else
				{
					mlCurrentAnimation = mBaseObj.PlayAnimation(msAnimation_Closing);
					mBaseObj.GetMeshEntity().GetAnimationState(mlCurrentAnimation).SetRelativeTimePosition(1);
				}
			}
		}
		
		/////////////////////////////
		// Move bodies correctly
		if(mbAnimation_ReplaceMovement==false)
		{
			for(int i=0; i<mvDoorParts.length(); ++i)
			{
				SetDoorOpenAmount(mvDoorParts[i], mfOpenAmount);
			}
		}
		
		////////////////////////////////////
		// Set up body collision correctly
		else
		{
			if(mpBodyClosed !is null) mpBodyClosed.SetActive(mfOpenAmount <= 0);
			if(mpBodyOpen !is null) mpBodyOpen.SetActive(mfOpenAmount > 0);
			
			mbAnimationMovementBodyOpen = mfOpenAmount > 0;
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		if(mbAgentIsOpeningDoor)
		{
			mfAgentIsOpeningFailsafeCount-=afTimeStep;
			if(mfAgentIsOpeningFailsafeCount<0)
				mbAgentIsOpeningDoor=false;
		}
		
		if(mbAgentIsOpeningRevertStateChange)
		{
			mBaseObj.ChangeConnectionState(1);
			mbAgentIsOpeningRevertStateChange=false;
		}
		
		UpdateAutoClose(afTimeStep);
		UpdateDoors(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	/*void OnPostUpdate(float afTimeStep)
	{
	
	}*/
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnAttachmentUpdate(const cMatrixf&in a_mtxTransformAdd)
	{
		m_mtxAttachment = cMath_MatrixMul(a_mtxTransformAdd, m_mtxAttachment);
		mbAttachmentUpdated = true;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		if(abX)
		{
			if(mpBodyClosed !is null) mpBodyClosed.SetActive(mfOpenAmount <= 0);
			if(mpBodyOpen !is null) mpBodyOpen.SetActive(mfOpenAmount > 0);
			if(mpAgentColliderBody !is null) mpAgentColliderBody.SetActive(mbIsClosed);
		}
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(float afAmount, int alStrength, const tString&in asType, const tString&in asSource)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState ==0) return;
		
		if(mbAgentIsOpeningDoor)
		{
			mbAgentIsOpeningRevertStateChange=true;
			return;
		}

		MoveDoorTo(alState ==1 ? 1 : 0, false);
	}
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return mfOpenAmountGoal<=0 && mfAutoCloseTime<=0; 
	}
	
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in apContactData)
	{
	
	}
	
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// INTERACT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return mbInteractToOpen;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		if(mbInteractToOpen==false) return false;
		
		if(mfOpenAmountGoal<=0) MoveDoorTo(1);
		else					MoveDoorTo(0);
	
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_PushButton;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// SPECIFIC ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetIsClosed(bool abX)
	{
		if(mbIsClosed == abX) return;
		
		mbIsClosed = abX;
		
		mBaseObj.SetIsClosedDoor(abX);
		
		if(mpAgentColliderBody !is null)
			mpAgentColliderBody.SetActive(mbIsClosed);
	}
	
	//------------------------------------------------------------

	void _Global_SetOpenAmount()
	{
		bool abInstant = cScript_GetGlobalArgBool(1);
		
		mBaseObj.SetAutoSleep(false);
		mBaseObj.WakeUp();
		
		if (abInstant)
		{
			SetOpenAmountInstantly(cScript_GetGlobalArgFloat(0));
		}
		else
		{
			MoveDoorTo(cScript_GetGlobalArgFloat(0));
		}
	}
	
	//------------------------------------------------------------

	void _Global_GetOpenAmount()
	{
		cScript_SetGlobalReturnFloat(mfOpenAmount);
	}
	
	//------------------------------------------------------------
	
	void MoveDoorTo(float afX, bool abChangeConnectionState=true)
	{
		if( cMath_Abs(afX-mfOpenAmount) < 0.00001f) return;
	
		////////////////////////////////////
		// Connection
		if(abChangeConnectionState)
			mBaseObj.ChangeConnectionState(afX>0 ? 1 : -1);
		
		///////////////////////////////////
		// Wake up
		mBaseObj.SetAutoSleep(false);
		mBaseObj.WakeUp();
		
		///////////////////////////////////
		// Variable Set up
		float fDir = afX - mfOpenAmount;
		
		/////////////////////////////////////
		// Start sound
		tString sStartSound = (fDir>0) ? msOpenSound_Start : msCloseSound_Start;
		if(mbDoorMoving==false)
		{
			mBaseObj.PlaySound("SlideDoorStart", sStartSound, true, false);
		}
		
		/////////////////////////////////////
		// Stop Loop sound (if needed)
		if(mlLoopSoundId>=0 && fDir * (mfOpenAmountGoal - mfOpenAmount)<0 ) //Check if directions are not the same!
		{
			cSoundEntity @pSound = mBaseObj.GetMap().GetWorld().GetSoundEntityFromCreationID(mlLoopSoundId);
			if(pSound !is null) pSound.FadeOut(5);
			
			mlLoopSoundId = -1;
		}
		
		/////////////////////////////////////
		// Play Loop sound
		tString sLoopSound = (fDir>0) ? msOpenSound_Loop : msCloseSound_Loop;
		if(mlLoopSoundId <0)
		{
			cSoundEntity @pSound = mBaseObj.PlaySound("SlideDoorLoop", sLoopSound, true, false);
			if(pSound !is null)
			{
				pSound.FadeIn(5);
				mlLoopSoundId = pSound.GetCreationID();
			}
		}
		
		///////////////////////////////////
		// Animations
		if(mbUseAnimations)
		{
			if(afX>0)
			{
				mlCurrentAnimation = mBaseObj.PlayAnimation(msAnimation_Opening);
			}
			else
			{
				mlCurrentAnimation = mBaseObj.PlayAnimation(msAnimation_Closing);
			}
		}
				
		/////////////////////////////////////
		// Set properties
		mbDoorMoving = true;
		
		mfAutoCloseTimeCount = 0;
		
		mfOpenAmountGoal = afX;
		
		
		SetIsClosed(mfOpenAmountGoal<0.95f);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void _Global_AgentNear()
	{
		if(mbOpenableByAgent==false || mfOpenAmountGoal>0.9f || mfOpenAmount>0.9f)
		{
			cScript_SetGlobalReturnBool(false);
			return;
		} 
		
		mbAgentIsOpeningDoor=true;
		mfAgentIsOpeningFailsafeCount = 10;
		MoveDoorTo(1);
		
		cScript_SetGlobalReturnBool(true);
	}
	
	//------------------------------------------------------------
	
	void _Global_OpenDirectly()
	{
		SetOpenAmountInstantly(1.0f);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetOpenableByAgent()
	{
		mbOpenableByAgent = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// SPECIFIC UPDATE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void UpdateAutoClose(float afTimeStep)
	{
		/////////////////////////////
		// Check if already closing or not supposed to close at all
		if(mfOpenAmountGoal<=0 || mfAutoCloseTime<=0) return;
		
		/////////////////////////////
		// Check if time to close.
		if(mfAutoCloseTimeCount < mfAutoCloseTime)
		{
			mfAutoCloseTimeCount += afTimeStep;
			if(mfAutoCloseTimeCount < mfAutoCloseTime) return;
		}
		
		/////////////////////////////////////////
		// Only check a few times per frame!
		// NOTE: Skipping this for now as the timer is reset!
		//mfAutoCloseTestCount += afTimeStep;
		//if(mfAutoCloseTime < 0.2f) return;
		//mfAutoCloseTestCount =0;
		
		/////////////////////////////
		// Check if any character inside door, else close.
		iPhysicsWorld @pPhysicsWorld = mBaseObj.GetMap().GetPhysicsWorld();
		
		bool bCharacterInside = false;
		array<iPhysicsBody@> vCollideBodies;
		pPhysicsWorld.GetBodiesInAABB(mvDoorAABB_Min, mvDoorAABB_Max, vCollideBodies);
			
		for(int i=0; i<vCollideBodies.length(); ++i)
		{
			iPhysicsBody @pBody = vCollideBodies[i];
			if(pBody.IsCharacter() && pBody.IsActive())
			{
				bCharacterInside = true;
				break;
			}
		}
		
		/////////////////////////////
		// If no character inside, close
		if(bCharacterInside==false)
		{
			MoveDoorTo(0);
		}
		// Else, reset the time count.
		else
		{
			mfAutoCloseTimeCount =0;
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateDoors(float afTimeStep)
	{
		if(mbDoorMoving==false) return;
		
		///////////////////////////////////
		// Animation Update
		if(mlCurrentAnimation >= 0 && mBaseObj.GetAnimationIsPlaying()==false)
		{
			if(mfOpenAmountGoal>0 && msAnimation_Open != "")
				mBaseObj.PlayAnimation(msAnimation_Open, 0.0f, true);
			else if(mfOpenAmountGoal<=0 && msAnimation_Closed != "")
				mBaseObj.PlayAnimation(msAnimation_Closed, 0.0f, true);
				
			mlCurrentAnimation = -1;
		}
		
		///////////////////////////////////
		// Animation Movement
		if(mbAnimation_ReplaceMovement)
		{
			mfOpenAmount = mfOpenAmountGoal;
			
			/////////////////////////////
			// Check if we should switch bodies
			if(mlCurrentAnimation >=0 && mbAnimationMovementBodyOpen != (mfOpenAmount>0)) 
			{
				float fAnimTimeCheck = mfOpenAmount>0 ? mfAnimation_CollisionOpenTime : mfAnimation_CollisionClosedTime;
				
				if(mBaseObj.GetMeshEntity().GetAnimationState(mlCurrentAnimation).GetTimePosition() > fAnimTimeCheck)
				{
					mbAnimationMovementBodyOpen = (mfOpenAmount>0);
					
					if(mpBodyClosed !is null) mpBodyClosed.SetActive(mfOpenAmount <= 0);
					if(mpBodyOpen !is null) mpBodyOpen.SetActive(mfOpenAmount > 0);
				}
			}
			
			/////////////////////////////
			// Check door opening/closing is over
			if(mlCurrentAnimation <0)
			{
				mBaseObj.SetAutoSleep(true);
				mbDoorMoving = false;
			}
		}
		/////////////////////////////////
		// Physics Movement
		else
		{
			///////////////////////////////////
			// Update the speed
			float fDir = mfOpenAmountGoal - mfOpenAmount;
			float fAcc =  (fDir > 0) ? mfOpenAcc : mfCloseAcc;
			float fSlowDownDist =  (fDir > 0) ? mfOpenSlowDownDist : mfCloseSlowDownDist;
			
			float fTargetSpeed = (fDir > 0) ? mfOpenSpeed : -mfCloseSpeed;
			
			//If close to goal, slow down speed.
			if( cMath_Abs(fDir) < fSlowDownDist)
			{
				fTargetSpeed = (cMath_Abs(fDir) / fSlowDownDist) * fTargetSpeed;
				
				//Not too small!
				if(fDir>0 && fTargetSpeed<0.01) fTargetSpeed = 0.01f;
				if(fDir<0 && fTargetSpeed>-0.01) fTargetSpeed = -0.01f;
			}
			
				
			float fAccDir = (fTargetSpeed - mfCurrentSpeed)>0 ? 1 : -1;
			
			mfCurrentSpeed += fAcc * fAccDir * afTimeStep;
			if(fAccDir>0 && mfCurrentSpeed>fTargetSpeed) mfCurrentSpeed = fTargetSpeed;
			if(fAccDir<0 && mfCurrentSpeed<fTargetSpeed) mfCurrentSpeed = fTargetSpeed;
			
			///////////////////////////////////
			// Update the open amount
			mfOpenAmount += afTimeStep * mfCurrentSpeed;
			
			if (mfOpenAmount < 0)
			{
				mfOpenAmount = 0;
				if (mfCurrentSpeed < 0 && mfOpenAmountGoal > 0) 
					mfCurrentSpeed = 0;
			}
			
			if(fDir > 0 &&	mfOpenAmount>=mfOpenAmountGoal)
			{
				mbAgentIsOpeningDoor = false;
				mfOpenAmount = mfOpenAmountGoal;
				mfCurrentSpeed = 0;
				mbDoorMoving = false;
				mBaseObj.SetAutoSleep(true);
			}
			if(fDir < 0 &&	mfOpenAmount<=mfOpenAmountGoal)
			{
				mbAgentIsOpeningDoor = false;
				mfOpenAmount = mfOpenAmountGoal;
				mfCurrentSpeed = 0;
				mbDoorMoving = false;
				mBaseObj.SetAutoSleep(true);
			}
			
			///////////////////////////////////
			// Check collision and push out of the way
			for(int i=0; i<mvDoorParts.length(); ++i)
			{
				float fNewAmount;
				if(PushAndCheckDoorCollision(mvDoorParts[i], mfOpenAmount, afTimeStep, fNewAmount))
				{
					//Make sure the new amount equals the least opened door part!
					if(fDir>0 && fNewAmount<mfOpenAmount) mfOpenAmount = fNewAmount;
					if(fDir<0 && fNewAmount>mfOpenAmount) mfOpenAmount = fNewAmount;
				}
			}
				
			///////////////////////////////////
			// Update door parts
			for(int i=0; i<mvDoorParts.length(); ++i)
			{
				MoveDoorOpenAmountTo(mvDoorParts[i], mfOpenAmount, afTimeStep);
			}
			
			///////////////////////////////////
			// Move stop effects
			if(mbDoorMoving == false)
			{
				////////////////////////////
				// Stop Loop sound
				if(mlLoopSoundId>=0) //Check if directions are not the same!
				{
					cSoundEntity @pSound = mBaseObj.GetMap().GetWorld().GetSoundEntityFromCreationID(mlLoopSoundId);
					if(pSound !is null) pSound.FadeOut(5);
					
					mlLoopSoundId = -1;
				}
				
				////////////////////////////
				// Play End Sound
				tString sEndSound = fDir>0 ? msOpenSound_End : msCloseSound_End;
				mBaseObj.PlaySound("SlideDoorEnd", sEndSound, true, false);
			}
		}
	}
	
	bool PushAndCheckDoorCollision(cSlideDoorPart &aDoorPart,float afAmount, float afTimeStep, float &out afNewAmount)
	{
		iPhysicsWorld @pPhysicsWorld = mBaseObj.GetMap().GetPhysicsWorld();
		cVector3f vGoalPos = GetClosedPos(aDoorPart)*(1-afAmount) + GetOpenPos(aDoorPart)*afAmount;
		
		/////////////////////////////////////////////
		//Get all bodies nearby and give them a push
		if(mfPushImpulse>0)
		{
			cVector3f vGoalAdd = vGoalPos - aDoorPart.mpBody.GetLocalPosition();
			
			cBoundingVolume @pBV = aDoorPart.mpBody.GetBoundingVolume();
			
			cVector3f vPushBodyVec = cMath_MatrixMul3x3(mBaseObj.GetOnLoadTransform(), cVector3f(0,0,1)) * mfPushImpulse;
			cVector3f vDoorCenter = cMath_MatrixMul(aDoorPart.mpBody.GetLocalMatrix(), aDoorPart.mpBody.GetMassCenter());
			
			array<iPhysicsBody@> vCollideBodies;
			pPhysicsWorld.GetBodiesInAABB(pBV.GetMin()+vGoalAdd-cVector3f(0.075f), pBV.GetMax()+vGoalAdd+cVector3f(0.075f), vCollideBodies);
			
			for(int i=0; i<vCollideBodies.length(); ++i)
			{
				iPhysicsBody @pBody = vCollideBodies[i];
				
				//Skip any non-dynamic or non-active bodies (+ anything too massive)
				if(pBody.IsActive()==false || pBody.GetMass()==0 || pBody.GetCollide()==false || pBody.GetMass() > mfPushMaxMass) continue;
				
				//Direction from body center to center of this door.
				cVector3f vCenterToBody = cMath_MatrixMul(pBody.GetLocalMatrix(), pBody.GetMassCenter()) - vDoorCenter; //Make sure center of mass is used.
				
				//Check what directin to push in
				float fPushDir = (cMath_Vector3Dot(vPushBodyVec, vCenterToBody) > 0) ? 1.0f : -1.0f;
				
				//Add the impulse
				pBody.AddImpulse(vPushBodyVec * fPushDir);
			}
		}		
		if(mbCheckCollision==false) return false;

		/////////////////////////////////////////////
		//Check collision and get push back
		cVector3f vPushVec(0);
		
		cMatrixf translatedMatrix = aDoorPart.mpBody.GetWorldMatrix();
		translatedMatrix.SetTranslation(vGoalPos);
		bool bCollide = pPhysicsWorld.CheckShapeWorldCollision(vPushVec,aDoorPart.mpBody.GetShape(), translatedMatrix, null, true);
		if(bCollide==false || vPushVec == cVector3f(0)) return false;
				
		//See the what the new (push backed) goal position would be:
		vGoalPos += vPushVec;
		
		//Calculate the open amount this new open means: 
		afNewAmount = 1.0f - cMath_Vector3Dist(vGoalPos, GetOpenPos(aDoorPart)) / cMath_Vector3Dist(GetClosedPos(aDoorPart), GetOpenPos(aDoorPart));
			
		return true;
	}
	
	void MoveDoorOpenAmountTo(cSlideDoorPart &aDoorPart, float afAmount, float afTimeStep)
	{
		cVector3f vGoalPos = GetClosedPos(aDoorPart)*(1-afAmount) + GetOpenPos(aDoorPart)*afAmount;
		cVector3f vDelta = vGoalPos - aDoorPart.mpBody.GetLocalPosition();
		
		aDoorPart.mpBody.StaticLinearMove(vDelta / afTimeStep);
	}

	cVector3f GetOpenPos(cSlideDoorPart& aDoorPart)
	{
		if(mbAttachmentUpdated)
		{
			return cMath_MatrixMul(m_mtxAttachment, aDoorPart.mvOpenPos);
		}
		else
		{
			return aDoorPart.mvOpenPos;
		}
	}

	cVector3f GetClosedPos(cSlideDoorPart& aDoorPart)
	{
		if(mbAttachmentUpdated)
		{
			return cMath_MatrixMul(m_mtxAttachment, aDoorPart.mvClosedPos);
		}
		else
		{
			return aDoorPart.mvClosedPos;		
		}
	}
		
