	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		msHudObjectEntity = apVars.GetVarString("HudObjectEntity", "");
		
		msPickupCallback = apInstanceVars.GetVarString("PickupCallback", "");
		msUseCallback = apInstanceVars.GetVarString("UseCallback", "");
		msDropCallback = apInstanceVars.GetVarString("DropCallback", "");
		msCanBeUsedCallback = apInstanceVars.GetVarString("CanBeUsedCallback", "");
		
		msInventoryNameTextEntry = apVars.GetVarString("InventoryTextEntry", "");
		
		msInventoryIcon = apVars.GetVarString("InventoryIcon", "");
		
		msHandAnimationSuffix = apVars.GetVarString("HandAnimationSuffix", "generic");
		
		mbIsHeavy = apVars.GetVarBool("IsHeavy", false);
		
		mCustomUseIcon = PlayerTypes_StringToCrossHairState( apVars.GetVarString("CustomUseIcon", "UseToolAction"));
		
		/////////////////////////
		// Instance Vars
		mbAutoHide = apInstanceVars.GetVarBool("AutoHideAfterPickup", true);
		mbHighlightActive = apInstanceVars.GetVarBool("HighlightActive", true);

		//////////////
		// Preload entity and icon
		cLux_PreloadEntity(msHudObjectEntity);
		cLux_PreloadGuiGfx(msInventoryIcon, eImGuiGfx_Image);
	}
	
