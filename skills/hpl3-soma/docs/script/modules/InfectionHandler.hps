	float mfRotateTemp=0;
	float mfScaleTemp=0;
	
	void OnDraw(float afFrameTime)
	{
		//if(true) return;
		cInfectionTree@ pTree;
		cVector2f vCenter, vSize;
		float fW, fH;
		float fAngle;
		cInfectionTreeAtom@ pAtom;
			
			
		for(int i=0; i<mvTrees.size(); ++i)
		{
			@pTree = @mvTrees[i];
			
			////////////////////////
			// Leaf Atoms
			/*for(int j=0; j<pTree.mvLeaves.size(); ++j)
			{
				cInfectionTreeLeaf@ pLeaf = pTree.mvLeaves[j];
				cInfectionTreeAtom@ pAtom = pTree.mvAtoms[pLeaf.mlAtomIdx];
				
				cVector2f vSize = cVector2f(pAtom.mfWidth,pAtom.mfWidth);
				cVector2f vChildPos = pAtom.mvStart + pAtom.mvDir*pAtom.mfHeight*pAtom.mfAlpha*gfChildPosMul;
				cVector3f vPos = cVector3f(vChildPos.x-vSize.x/2, vChildPos.y-vSize.x/2, 1);
				
				cLux_GetGameHudSet().DrawGfx(	mpLeafAtomGfx, vPos,vSize, cColor(1, pLeaf.mfAlpha*pAtom.mfStaticAlpha));
			}*/
			
			////////////////////////
			// Line Atoms
			for(int j=0; j<pTree.mvAtoms.size(); ++j)
			{
				@pAtom = @pTree.mvAtoms[j];
				
				vCenter = pAtom.mvStart;
				fW = pAtom.mfWidth;
				fH = cMath_Vector2Dist(pAtom.mvStart, pAtom.mvEnd)*1.0f;
				fAngle = cMath_GetAngleFromPoints2D(pAtom.mvEnd, pAtom.mvStart);
				
				const float fLimitR0 = 2.0f/3.0f;
				const float fLimitG0 = 1.0f/3.0f;
				
				float fA = pAtom.mfAlpha*pAtom.mfStaticAlpha;
				
				cLux_GetGameHudSet().DrawGfx(	mpLineAtomGfx, cVector3f(vCenter.x-fW/2, vCenter.y, 3), 
												cVector2f(fW, fH), cColor(0, fA),
												eGuiMaterial_Alpha, fAngle, true, cVector3f(fW/2, 0,0));
												
			}	
		}
	}
	
