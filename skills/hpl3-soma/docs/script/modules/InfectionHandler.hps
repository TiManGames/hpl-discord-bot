const tString gsInfectionLoopSound=""; 

//------------------------------------------------------------

class cInfectionTree
{
	array<cInfectionTreeAtom> mvAtoms;
	array<cInfectionTreeLeaf> mvLeaves;
	int mlRandSeed=0;
	float mfSpeed;
}

class cInfectionTreeAtom
{
	cVector2f mvStart=cVector2f(0);
	cVector2f mvEnd=cVector2f(0);
	cVector2f mvDir;
	float mfWidth=10;
	float mfHeight=10;
	float mfAlpha=1;
	float mfStaticAlpha=1;
	int mlGlobalCount;
	int mlBranchCount;
	int mlDepthCount;
}

class cInfectionTreeLeaf
{
	int mlAtomIdx;
	cVector2f mvDir;
	int mlMaxBranchSteps;
	float mfAlpha =0;
}

//------------------------------------------------------------

const float gfChildPosMul = 0.8;

//------------------------------------------------------------

