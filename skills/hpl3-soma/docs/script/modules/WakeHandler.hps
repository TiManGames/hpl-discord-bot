#include "interfaces/UserModule_Interface.hps"
#include "modules/ModuleInterfaces.hps"
#include "helpers/helper_imgui.hps"
#include "helpers/helper_effects.hps"

//------------------------------------------------------------

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

enum eWakeState
{
	eWakeState_Asleep,
	eWakeState_WakingUp,
	eWakeState_Awake
}

const float gfWakeHandlerZDepth = -50.0f;

//------------------------------------------------------------

class cScrWakeHandler : iScrUserModule, iScrUserModule_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mWakeState = eWakeState_Awake;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// USER SETTINGS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	
	}
	void SaveUserConfig()
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}
	
	void OnMapLeave(cLuxMap @apMap)
	{
	}
	
	//------------------------------------------------------------
	
	void PreloadData(cLuxMap @apMap)
	{
		ImGui_PreloadImage("advanced_black.dds", eImGuiGfx_Texture);
		ImGui_PreloadImage("wakeup.dds", eImGuiGfx_Texture);
	}

	void CreateWorldEntities(cLuxMap @apMap)
	{
	}
	
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////

	//------------------------------------------------------------
	
	void _Global_StartWakeup()
	{
		StartWakeup(cScript_GetGlobalArgFloat(0));
	}
	
	//------------------------------------------------------------
	
	void _Global_SetAsleep()
	{
		SetAsleep(cScript_GetGlobalArgBool(0));
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Reset()
	{

	}
	
	//------------------------------------------------------------
	
	void SetActive(bool abX)
	{
	}
	
	//------------------------------------------------------------

	void Update(float afTimeStep)
	{	
		
	}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
	}
	
	void VariableUpdate(float afDeltaTime)
	{
	}
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
	
	}
	
	//------------------------------------------------------------
	
	void SetAsleep(bool abAsleep)
	{
		if (abAsleep)
			mWakeState = eWakeState_Asleep;
		else
			mWakeState = eWakeState_Awake;
	}
	
	//------------------------------------------------------------
	
	void StartWakeup(float fTime)
	{
		mfWakeupTime = fTime;
		mfWakeupTimeElapsed = 0.0f;
		mWakeState = eWakeState_WakingUp;
		
		Effect_ImageTrail_Start(5.0f, 0.0f, 0.0f, fTime);
	}
	//------------------------------------------------------------

	void OnGui(float afTimeStep)
	{	
		if (mWakeState == eWakeState_Awake)
			return;
			
		if (mWakeState == eWakeState_Asleep)
		{
			DrawBlackBG();
			return;
		}
		
		if (mfWakeupTime<0.0f)
			return;
			
		mfWakeupTimeElapsed+=afTimeStep;
			
		float fEyesOpenAmount = cMath_Easing(eEasing_BounceIn, cMath_Clamp(mfWakeupTimeElapsed/mfWakeupTime,0.0f,1.0f));
		
		if (fEyesOpenAmount<=0.0f)
		{
			DrawBlackBG();
			return;
		}
		else if (fEyesOpenAmount<1.0f)
		{
			cImGuiGfx wakeupImage("wakeup.dds", eImGuiGfx_Texture);

			ImGui_GroupBegin(cLux_GetHudVirtualStartPos(), cLux_GetHudVirtualSize());
			
			float fOffset = fEyesOpenAmount*0.5f;
			
			// Bottom lid
			ImGui_DoImage(wakeupImage, ImGui_NrmPos(cVector3f(0, 0.4875f+fOffset, gfWakeHandlerZDepth)), ImGui_NrmSize(cVector2f(1.5,0.55f)));
			
			ImGui_SetModRotateAngle(180);
			
			// Top lid
			ImGui_DoImage(wakeupImage, ImGui_NrmPos(cVector3f(0, -(0.0125f+fOffset), gfWakeHandlerZDepth)), ImGui_NrmSize(cVector2f(1.5,0.55f)));
			ImGui_ResetModifiers();
			
			ImGui_GroupEnd();
		}
		
		if (mfWakeupTimeElapsed>mfWakeupTime)
		{
			mfWakeupTime = -1.0f;
			mWakeState = eWakeState_Awake;
		}
	}	
	
	//------------------------------------------------------------
	
	void OnDraw(float){}
	void OnPostRender(float){}
	void OnEnterContainer(const tString&in){}
	void OnLeaveContainer(const tString&in){}
	void AppGotInputFocus(){}
	void AppLostInputFocus(){}	
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount){}
	void OnExitPressed(){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void DrawBlackBG()
	{
		ImGui_GroupBegin(cLux_GetHudVirtualStartPos(), cLux_GetHudVirtualSize());
			
		cImGuiGfx blackImage("advanced_black.dds", eImGuiGfx_Texture);
		ImGui_DoImage(blackImage, ImGui_NrmPos(cVector3f(0, 0, gfWakeHandlerZDepth)), ImGui_NrmSize(cVector2f(1.5,1)));
		
		ImGui_GroupEnd();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{		
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////

	float mfWakeupTime;
	float mfWakeupTimeElapsed;
	eWakeState mWakeState;
	
	//------------------------------------------------------------

}