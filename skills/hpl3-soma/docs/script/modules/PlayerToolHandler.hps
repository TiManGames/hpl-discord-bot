	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_AddTool()
	{		
		////////////////////////////////
		// Get tool properties
		cToolData toolData;
		toolData.msPickedEntityName = cScript_GetGlobalArgString(0);
		toolData.msHudObjFile = cScript_GetGlobalArgString(1);
		toolData.msUseCallback = cScript_GetGlobalArgString(2);
		toolData.msDropCallback = cScript_GetGlobalArgString(3);
		toolData.msCanBeUsedCallback = cScript_GetGlobalArgString(4);
		bool bEquip = cScript_GetGlobalArgBool(5);
		bool bAutoHide = cScript_GetGlobalArgBool(6);		
		toolData.msInventoryIcon = cScript_GetGlobalArgString(7);
		toolData.msHandAnimationSuffix = cScript_GetGlobalArgString(8);
		toolData.mbIsHeavy = cScript_GetGlobalArgBool(9);
		toolData.m_idHudObject = tID_Invalid;
		toolData.mlCustomUseIcon = cScript_GetGlobalArgInt(10);
		
		////////////////////////////////
		//Check if proper
		if(toolData.msHudObjFile == "")
		{
			Error("Hud object string for tool prop is empty!");
			return;
		}
		
		////////////////////////////////
		// Check if we've already got it
		for (uint i = 0; i < mvInventory.length(); i++)
		{			
			if (mvInventory[i].msPickedEntityName == toolData.msPickedEntityName)
			{
				Error("Trying to add tool to inventory that we already have in inventory! '"+toolData.msPickedEntityName+"'");
				return;
			}
		}
		
		////////////////////////////////
		// Remove existing
		if (mlCurrentToolIndex >= 0)
		{
			//cLux_ID_Prop(mvInventory[mlCurrentToolIndex].m_idHudObject).SetActive(false);
			
			// Handle equipping new tool while current one is being removed
			if (mState == eToolState_Hide && mbRemoveToolWhenHidden)
			{		
				RemoveTool(mlCurrentToolIndex);
			}
		}
		
		////////////////////////////////
		//Add to inventory
		mvInventory.push_back(toolData);
		
		////////////////////////////////
		// Init and equip
		if (bEquip)
		{
			EquipTool(toolData.msPickedEntityName);
			mfAutoHideTimer = bAutoHide ? 2.25f : -1.f;
		}
		
		////////////////////////////////
		// Create Entity
		CreateHudObject(toolData);
		
	}
	
	//------------------------------------------------------------
	
	void _Global_PlayCustomAnimation()
	{
		if(mbActive==false) return;
		if(mState == eToolState_Hide) return;
		
		////////////////////////////////////
		// Get arguments
		msCustomAnim = cScript_GetGlobalArgString(0);
		mbCustomAnim_RemoveToolWhenOver = cScript_GetGlobalArgBool(1);
		msCustomAnim_Callback = cScript_GetGlobalArgString(2);
		
		////////////////////////////////////
		// Set up variables
		mbCustomAnim_HideToolWhenOver = false;
		mState = eToolState_CustomAnimation;
		
		cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
		tString sEntity = cLux_ID_Entity(pCurrentTool.m_idHudObject).GetName();
		
		////////////////////////////////////
		// Play animation
		PlayerHands_PlayAnimation(msCustomAnim, false, false,0.2f, sEntity, false);		
	}
	
	//------------------------------------------------------------
	
	
	void _Global_GetToolIsInInventory()
	{		
		tString sToolArg = cScript_GetGlobalArgString(0);
		for (uint i = 0; i < mvInventory.length(); i++)
		{			
			if (mvInventory[i].msPickedEntityName == sToolArg)
			{
				cScript_SetGlobalReturnBool(true);
				return;
			}
		}
		cScript_SetGlobalReturnBool(false);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetCurrentEntityName()
	{
		cScript_SetGlobalReturnString(GetCurrentEntityName());
	}
	
	//------------------------------------------------------------
	
	void _Global_GetCurrentHudEntityName()
	{
		if(mbActive==false || mlCurrentToolIndex < 0 || 
		   mvInventory[mlCurrentToolIndex].m_idHudObject == tID_Invalid) 
		{
			cScript_SetGlobalReturnString("");
		}
		
		cScript_SetGlobalReturnString(cLux_ID_Prop(mvInventory[mlCurrentToolIndex].m_idHudObject).GetName());
	}
	
	//------------------------------------------------------------
	
	void _Global_UnequipCurrentTool()
	{
		UnequipCurrentTool(cScript_GetGlobalArgBool(0));
	}
	
	//------------------------------------------------------------
	
	void _Global_ReEquipTool()
	{
		bool bSuccess = EquipTool(msPreviousTool);
		cScript_SetGlobalReturnBool(bSuccess);
	}
	
	//------------------------------------------------------------
	
	void _Global_EquipTool()
	{
		bool bSuccess = EquipTool(cScript_GetGlobalArgString(0), cScript_GetGlobalArgString(1));
		cScript_SetGlobalReturnBool(bSuccess);
	}
	
	//------------------------------------------------------------
	
	void _Global_RemoveTool()
	{
		RemoveTool(cScript_GetGlobalArgString(0));
	}
	
	//------------------------------------------------------------
	
	void _Global_GetToolCount()
	{
		cScript_SetGlobalArgInt(0,mvInventory.length());
	}
	
	//------------------------------------------------------------
		
	void _Global_GetToolIconList()
	{
		for (uint i = 0; i < mvInventory.length(); i++)
		{
			cScript_SetGlobalArgString(i,mvInventory[i].msInventoryIcon);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PUBLIC
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool CanPickOrUseTool()
	{
		if(mbActive && (mState == eToolState_Hide))
			return false;
			
		if(mbActive==false && PlayerHands_IsActive()) return false;
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool CanEquipToolAreaTool()
	{
		if(mbActive && (mState == eToolState_Unhide))
			return false;
			
		if(mbActive==false && PlayerHands_IsActive()) return false;
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool GetPlayerCarriesHeavyTool()
	{
		if(mbActive==false) return false;
		
		bool bHeavyTool = false;
		cToolData@ pCurrentTool = null;
		if (mlCurrentToolIndex >= 0 && mlCurrentToolIndex < mvInventory.length())
		{
			@pCurrentTool = mvInventory[mlCurrentToolIndex];
			bHeavyTool = pCurrentTool.mbIsHeavy;
		}
		return bHeavyTool;
	}
	
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Reset()
	{
		mbPlayerCarriesHeavyTool=false;
		
		msPreviousTool = "";
		mlCurrentToolIndex = -1;
		mvInventory.resize(0);
		
		mbActive = false;
		mbCanInteract = false;
		
		mPickBasics.Reset();
		
		mState = eToolState_Idle;
		mPrevState = eToolState_Idle;
		
		SetupMoveStateMultipliers();
		
		mbFadeInDrawAnim=false;
	}
	
	void SetActive(bool abX)
	{
		if(mbActive==abX) return;
		
		mbActive = abX;
		if(mbActive==false)
		{			
			mState = eToolState_Idle;
			mbCanInteract = false;
			
			PlayerHands_SetActive(false);
			SetToolInteractionAllowed(true);
		}		
	}
	
	bool IsActive()
	{
		return mbActive;
	}
	
	//------------------------------------------------------------

	void Update(float afTimeStep)
	{					
		if(mbActive==false || mlCurrentToolIndex < 0) return;
		
		cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
		
		////////////////////////////////////////////
		// Check if tool has been displayed long enough
		if (mfAutoHideTimer >= 0)
		{
			mfAutoHideTimer -= afTimeStep;
			if (mfAutoHideTimer < 0)
			{
				mState = eToolState_Hide;
			}
		}
		
		//////////////////////////
		//Check if if anything in focus can be used by tool
		mbCanInteract = false;
		if(CanPickOrUseTool() && pCurrentTool.msCanBeUsedCallback!="" && mfAutoHideTimer < 0)
		{
			cCamera @pCam = cLux_GetPlayer().GetCamera();
			if(mPickBasics.UpdatePickCheck(pCam, false))
			{
				//iLuxEntity@ pPickedEntity = cLux_ID_Entity(mPickBasics.m_idFocusedEntity);
				//if(pPickedEntity !is null && pPickedEntity.GetInteractionDisabled()==false)
				{
					cLuxMap@ pMap = cLux_GetCurrentMap();

					if(pMap.ScriptPrepare("bool "+pCurrentTool.msCanBeUsedCallback+"(const tString &in asToolName, const tString &in asFocusEntity)" ) )
					{
						tString sTool = pCurrentTool.msPickedEntityName;
						pMap.SetArgString(0, sTool);
						tString sFocusedEntity = mPickBasics.msFocusedEntityName;
						pMap.SetArgString(1, sFocusedEntity);
						
						if(pMap.ScriptExecute())
						{
							if(pMap.GetReturnBool())
							{
								Player_SetCrossHairState(eCrossHairState(pCurrentTool.mlCustomUseIcon));
								mbCanInteract = true;
							}
						}
					}
				}
			}
		}
		
		//////////////////////////////////////////
		//This set if the normal player state can use interactions.
		SetToolInteractionAllowed(!mbCanInteract);
		
		/////////////////////////////////////////
		// State var setup
		eToolState lastState = mState;
		tString sEntity = cLux_ID_Entity(pCurrentTool.m_idHudObject).GetName();
		
		/////////////////////////////////////////
		// State: None
		if(mState == eToolState_Idle)
		{
			/////////////////////////
			// Enter state
			if(mPrevState != eToolState_Idle)
			{
				PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_idle", true,false,0.2f,sEntity, false);
			}
		}
		/////////////////////////////////////////
		// State: Unhide
		else if(mState == eToolState_Unhide)
		{
			/////////////////////////
			// Enter state
			if(mPrevState != eToolState_Unhide)
			{
				PlayerHands_SetUseCustomPosition(false);
				PlayerHands_SetUseCustomRotation(false);
				
				float fFadeTime = mbFadeInDrawAnim ? 0.2f : 0.0f;
				PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_draw", false,false,fFadeTime,sEntity, false);
				
				//cLux_AddDebugMessage("Enter Unhide");
			}
			
			/////////////////////////
			// Animation over
			if(PlayerHands_GetAnimationPlaying()==false)
			{
				mState = eToolState_Idle;
			}	
		}
		/////////////////////////////////////////
		// State: Hide
		else if(mState == eToolState_Hide)
		{
			/////////////////////////
			// Enter state
			if(mPrevState != eToolState_Hide)
			{
				PlayerHands_PlayAnimation("tool_"+pCurrentTool.msHandAnimationSuffix+"_holster", false,false,0.2f,sEntity, true);
				//cLux_AddDebugMessage("Enter Hide");
			}
			
			/////////////////////////
			// Animation over
			if(PlayerHands_GetAnimationPlaying()==false)
			{
				cScript_RunGlobalFunc(msPreviousTool, "", "_Global_OnUnequip");
				
				if (mbRemoveToolWhenHidden)
				{
					RemoveTool(mlCurrentToolIndex);
				}
				else 
				{
					mlCurrentToolIndex = -1;
					SetupMoveStateMultipliers();
				}
				SetActive(false);
			}	
		}
		/////////////////////////////////////////
		// State: Custom animation
		else if(mState == eToolState_CustomAnimation)
		{
			/////////////////////////
			// Animation over
			if(PlayerHands_GetAnimationPlaying()==false)
			{
				//////////////////////////
				// Determine next state
				if(mbCustomAnim_RemoveToolWhenOver)				
				{
					RemoveTool(mlCurrentToolIndex);
					SetActive(false);
				}
				else if(mbCustomAnim_HideToolWhenOver)
				{
					mState = eToolState_Hide;
				}
				else
				{
					mState = eToolState_Idle;
				}
				
				//////////////////////////
				//Callback
				if(msCustomAnim_Callback != "")
				{
					cLuxMap @pMap = cLux_GetCurrentMap();
					if(pMap.ScriptPrepare("void "+msCustomAnim_Callback+"(const tString& in)"))
					{
						tString sAnim = msCustomAnim;
						pMap.SetArgString(0, sAnim);
						pMap.ScriptExecute();
					}
				}
			}
		}
		mPrevState = lastState;
		
	}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	void VariableUpdate(float afDeltaTime)
	{
	}
	
	//------------------------------------------------------------
	
	void OnDraw(float afFrameTime){}
