	void OnLeaveContainer(const tString&in){}
	void AppGotInputFocus(){}
	void AppLostInputFocus(){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false) return;
		if(mlCurrentToolIndex < 0) return;
		
		cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
		if(pCurrentTool.m_idHudObject == tID_Invalid) return;
		
		////////////////////////////
		// Use Tool
		if(alAction == eAction_Interact)
		{
			/////////////////////////////////////
			// Check if interaction possible
			if(pCurrentTool.msUseCallback == "") return;

			tString sFocusEntity = mPickBasics.msFocusedEntityName;
			if(sFocusEntity=="") return;
						
			if(mbCanInteract==false) return;
						
			/////////////////////////////////////
			// Call callback
			cLuxMap@ pMap = cLux_GetCurrentMap();
			if(pMap.ScriptPrepare("bool "+pCurrentTool.msUseCallback+"(const tString &in asToolName, const tString &in asFocusEntity)" ) )
			{
				tString sToolName = pCurrentTool.msPickedEntityName;
				pMap.SetArgString(0, sToolName);
				pMap.SetArgString(1, sFocusEntity);
				
				if(pMap.ScriptExecute())
				{
					if(pMap.GetReturnBool())
					{
						RemoveTool(sToolName); // Remove tool from inventory by default
					}
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
	}
	
	//------------------------------------------------------------
	
	void OnExitPressed()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool EquipTool(const tString& in asEntityName, const tString &in asLookEntities="")
	{
		for (uint i = 0; i < mvInventory.length(); i++)
		{
			if (mvInventory[i].msPickedEntityName != asEntityName) continue;
			
			EquipTool(i, asLookEntities);
			
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	bool EquipTool(int alIndex, const tString &in asLookEntities)
	{
		if (alIndex < 0 || alIndex >= mvInventory.length()) return false;
		
		int lIndex = alIndex; //Index might change, don't modify arg
		
		/////////////////////////////////////////////////////////////////////////
		// Handle equipping new tool while current one is being removed
		if (mState == eToolState_Hide && mbRemoveToolWhenHidden)
		{
			if (lIndex == mlCurrentToolIndex) return false;
			
			if (lIndex > mlCurrentToolIndex) lIndex--;
			
			RemoveTool(mlCurrentToolIndex);
		}
		
		////////////////////////
		// Tool already in use
		if (mbActive && lIndex == mlCurrentToolIndex)
		{
			mbFadeInDrawAnim = true;
			mfAutoHideTimer=-1;
			if(mState == eToolState_Hide) 
				mState = eToolState_Unhide;
			else if(mState == eToolState_CustomAnimation)
				mbCustomAnim_HideToolWhenOver = false;
			
			cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
			cScript_SetGlobalArgString(0, asLookEntities);
			cScript_RunGlobalFunc(pCurrentTool.msPickedEntityName, "", "_Global_UpdateLookEntities");
		
			return true;	
		}
		
		////////////////////////
		// Set up variables
		mbFadeInDrawAnim =false;
		mfAutoHideTimer=-1;
		mState = eToolState_Unhide;
		mPrevState = eToolState_Idle;
		SetActive(true);
								
		/////////////////////////////
		// Deactivate current tool
		if (mlCurrentToolIndex >= 0)
		{
			//if (mvInventory[mlCurrentToolIndex].m_idHudObject!=tID_Invalid)
			//	cLux_ID_Prop(mvInventory[mlCurrentToolIndex].m_idHudObject).SetActive(false);
		}
			
		////////////////
		//Equip tool
		mlCurrentToolIndex = lIndex;
		cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
		
		cScript_SetGlobalArgString(0, pCurrentTool.msPickedEntityName);
		cScript_RunGlobalFunc(pCurrentTool.msPickedEntityName, "", "_Global_OnEquip");
		
		cScript_SetGlobalArgString(0, asLookEntities);
		cScript_RunGlobalFunc(pCurrentTool.msPickedEntityName, "", "_Global_UpdateLookEntities");
		
		if (pCurrentTool.m_idHudObject == tID_Invalid)
		{
			CreateHudObject(pCurrentTool);
		}
		
		SetupMoveStateMultipliers();
		
		return true;
	}
	
	//------------------------------------------------------------
	
	void SetupMoveStateMultipliers()
	{
		bool bHeavyTool = false;
		cToolData@ pCurrentTool = null;
		if (mlCurrentToolIndex >= 0 && mlCurrentToolIndex < mvInventory.length())
		{
			@pCurrentTool = mvInventory[mlCurrentToolIndex];
			bHeavyTool = pCurrentTool.mbIsHeavy;
		}
		
		if (bHeavyTool)
		{
			cScript_SetGlobalVarFloat("ToolHeadBobMul", 1.25);
			cScript_SetGlobalVarFloat("ToolMoveSpeedMul", 0.75);
			cScript_SetGlobalVarFloat("ToolRunSpeedMul", 0.5);
		}
		else
		{
			cScript_SetGlobalVarFloat("ToolHeadBobMul", 1);
			cScript_SetGlobalVarFloat("ToolMoveSpeedMul", 1);
			cScript_SetGlobalVarFloat("ToolRunSpeedMul", 1);
		}
	}
	
	//------------------------------------------------------------
	
	void UnequipCurrentTool(bool abRemoveWhenHidden)
	{	
		if (mlCurrentToolIndex < 0 || mbRemoveToolWhenHidden) return; //Don't allow another unequip to override mbRemoveToolWhenHidden
		
		cToolData@ pCurrentTool = mvInventory[mlCurrentToolIndex];
		
		msPreviousTool = pCurrentTool.msPickedEntityName;
		
		mbRemoveToolWhenHidden = abRemoveWhenHidden;
		
		if(mState == eToolState_CustomAnimation)
		{
			mbCustomAnim_HideToolWhenOver=true;
		}
		else
		{
			mState = eToolState_Hide;
		}
	}
	
	//------------------------------------------------------------
	
	void RemoveTool(const tString& in asEntityName)
	{
		for (uint i = 0; i < mvInventory.length(); i++)
		{			
			if (mvInventory[i].msPickedEntityName == asEntityName)
			{
				RemoveTool(i);
				break;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void SetToolInteractionAllowed(bool abState)
	{
		cScript_SetGlobalArgBool(0,abState);
		cScript_RunGlobalFunc("State_Normal", "", "_Global_SetToolInteractionAllowed");
	}
	
	//------------------------------------------------------------
	
	void RemoveTool(int alIndex)
	{
		mbRemoveToolWhenHidden = false;
		
		if (alIndex == mlCurrentToolIndex)
		{
			SetActive(false);
			mbCanInteract = false;
			mlCurrentToolIndex = -1;
			SetToolInteractionAllowed(true);
			SetupMoveStateMultipliers();
		}
		else if (mlCurrentToolIndex > alIndex)
			mlCurrentToolIndex--;
			
		cToolData@ pCurrentTool = mvInventory[alIndex];
		//cLux_ID_Prop(pCurrentTool.m_idHudObject).SetActive(false);
		cLux_GetCurrentMap().DestroyEntity(cLux_ID_Entity(pCurrentTool.m_idHudObject));
		pCurrentTool.m_idHudObject = tID_Invalid;
		
		mvInventory.removeAt(alIndex);
		
		if (mvInventory.length() == 0)
		{
			SetActive(false);
		}
	}
	
	//------------------------------------------------------------
	
	void RemoveAllTools()
	{
		for (uint i = 0; i < mvInventory.length(); i++)
		{
			cToolData@ pTool = mvInventory[i];
			
			/////////////////////////////////
			// Destroy hud object
			if(pTool.m_idHudObject != tID_Invalid) 
			{
				//cLux_ID_Prop(pTool.m_idHudObject).SetActive(false);
				cLux_GetCurrentMap().DestroyEntity(cLux_ID_Entity(pTool.m_idHudObject));
				pTool.m_idHudObject = tID_Invalid;
			}
		}
		mvInventory.resize(0);
		msPreviousTool = "";
		mlCurrentToolIndex = -1;
		SetupMoveStateMultipliers();
		
		SetActive(false);
	}
	
	//------------------------------------------------------------
	
	void CreateHudObject(cToolData@ aToolData)
	{
		cLux_GetCurrentMap().CreateEntity(aToolData.msPickedEntityName + "_HudObject", aToolData.msHudObjFile, cMatrixf_Identity,cVector3f(1) );
		iLuxEntity @pEntity = cLux_GetCurrentMap().GetLatestEntity();
		
		//////////////////////////////
		// Check if correct entity type
		if(pEntity.GetEntityType() != eLuxEntityType_Prop)
		{
			Error("Hud object '"+aToolData.msHudObjFile+"' is of wrong type!\n");
			return;
		}
		
		cLuxProp@ pTool = cast<cLuxProp>(cLux_GetCurrentMap().GetEntityByName(aToolData.msPickedEntityName));
		
		cLuxProp@ pProp = cast<cLuxProp>(pEntity);
		pProp.SetAllowMapTransfer(false);
		pProp.SetEffectsActive(pTool.GetEffectsActive(), false);
				
		//////////////////////////////
		// Set up inventory entry with ID.
		for (int i = 0; i < mvInventory.length(); i++)
		{
			if (aToolData.msPickedEntityName != mvInventory[i].msPickedEntityName)
				continue;
			
			mvInventory[i].m_idHudObject = pProp.GetID();
			break;
		}
		
		//////////////////////////////
		// Set up render flags
		for(int i=0; i<pProp.GetMeshEntity().GetSubMeshEntityNum(); ++i)
		{
			cSubMeshEntity @pEnt = pProp.GetMeshEntity().GetSubMeshEntity(i);
			pEnt.SetRenderFlagBit(eRenderableFlag_VisibleInReflection, false);
			pEnt.SetRenderFlagBit(eRenderableFlag_ShadowCaster, false);
		}
		
		//////////////////////////////
		// Setup prop
		pProp.SetActive(false);
	}
	
	//------------------------------------------------------------
	
	tString GetCurrentEntityName()
	{
		if(mbActive==false || mlCurrentToolIndex < 0) 
		{
			return "";
		}
		
		return mvInventory[mlCurrentToolIndex].msPickedEntityName;
	}
	
