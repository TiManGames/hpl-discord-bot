	//------------------------------------------------------------
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		if(true)return;
		
		for(int i=0; i<mvAudioSources.size(); ++i)
		{
			cScrDatamineAudioSource@ pSource = @mvAudioSources[i];
			iLuxEntity @pEntity = cLux_ID_Entity(mvAudioSources[i].m_idEntity);
			
			for(int j=0; j<pSource.mvAnimNodes.size(); ++j)
			{
				cScrDatamineAnimNode@ pNode = @pSource.mvAnimNodes[j];
				
				apFunctions.GetLowLevelGfx().DrawSphere(pNode.mvPosition, 0.3, cColor(10,0,10,1));
			}
			
			apFunctions.GetLowLevelGfx().DrawSphere(pEntity.GetPosition(), 0.3, cColor(10,1));
		}
	}
	
