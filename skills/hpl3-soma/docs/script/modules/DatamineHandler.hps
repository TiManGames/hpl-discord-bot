	//------------------------------------------------------------
	
	iLuxEntity@ GetClosestEntity(const array<tID> &in avEntities)
	{
		cVector3f vCamPos = cLux_GetPlayer().GetCamera().GetPosition();
		cVector3f vEntityPos;
		float fClosest = 1000000;
		iLuxEntity@ pClosestEntity = null;
		for (uint i = 0; i < avEntities.length(); i++)
		{
			iLuxEntity@ pEntity = cLux_ID_Entity(avEntities[i]);
			if (pEntity is null)
			{
				// This can happen when using submaps.
				continue;
			}
			vEntityPos = pEntity.GetPosition();
			float fDist = cMath_Vector3DistSqr(vCamPos, vEntityPos);
			if (fDist < fClosest)
			{
				fClosest = fDist;
				@pClosestEntity = pEntity;
			}
		}
		return pClosestEntity;
	}
	
	//------------------------------------------------------------
	
	void StopDatamining()
	{	
		Effect_Rumble_Start(0.6, 1.0f);
							
		Effect_VideoDistortion_EnableAll(true);
		
		iLuxEntity@ pEntity = cLux_ID_Entity(m_idDataminingEntity);
		pEntity.SetIsInteractedWith(false);
		
		Sound_StopGui(gsDatamineDataminingLoop,2);
		Sound_StopGui(gsDatamineDatamineStart,1);
		cLux_PlayGuiSoundData(gsDatamineDatamineEnd, eSoundEntryType_Gui, 1, true);
		
		mvDataminePages.resize(0);
		m_idDataminingEntity = tID_Invalid;
		mfDataminingProgress = 0;
		m_idRangeArea = tID_Invalid;
		
		Player_FadeMoveSpeedMulTo(1, 1);
		Player_FadeRunSpeedMulTo(1, 1);
		Player_FadeLookSpeedMulTo(1, 1);
		
		cLux_GetPlayer().GetCamera().SetPitchLimits(mfPitchMinLimit, mfPitchMaxLimit);
		cLux_GetPlayer().GetCamera().SetYawLimits(0, 0);
		
		cLux_GetPlayer().ChangeState(ePlayerState_Normal);
	
		Voice_FadeSceneVolumeTo(msVoiceScene, 1,0);
		
		if(mpStaticSoundLoop !is null && cSound_IsValid(mpStaticSoundLoop, mlStaticSoundLoopId))
		{
			mpStaticSoundLoop.FadeOut(1);
			@mpStaticSoundLoop = null;
		}
		
		Player_SetCrouchActionDisabled(false);
		
		if (m_idDataminingSoundLoop != tID_Invalid) 
			cLux_ID_SoundEntity(m_idDataminingSoundLoop).FadeOut(2);
			
		cLux_AddDebugMessage("msVoiceScene "+msVoiceScene);
		if (msVoiceScene != "")
		{
			if (Voice_SceneIsActive(msVoiceScene))
				Voice_Stop(msVoiceScene);

			Voice_SetFocusScene("");
		}
		
		for(int i=0; i<mvAudioSources.size(); ++i)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(mvAudioSources[i].m_idEntity);
			
			cParticleSystem @pPS = cLux_ID_ParticleSystem(mvAudioSources[i].m_idPS);
			if(pPS !is null)
			{
				//pPS.SetPosition(pPS.GetWorldPosition());
				pPS.GetEntityParent().RemoveChild(pPS);
				pPS.Kill();	
			} 
			
			pEnt.SetPosition(mvAudioSources[i].mvAreaBasePos);
		}
	}
	
	//------------------------------------------------------------
	
	void RemoveDatamine(tID a_idEntity)
	{
		for (int i = 0; i < mvBlackboxes.length(); i++)
		{
			if (mvBlackboxes[i]!=a_idEntity) continue;
			
			mvBlackboxes.removeAt(i);
			return;
		}
	
		for (int i = 0; i < mvDatamines.length(); i++)
		{
			if (mvDatamines[i]!=a_idEntity) continue;
			
			mvDatamines.removeAt(i);
			return;
		}
	}
	
	//------------------------------------------------------------
	
	void NextPage()
	{
		mlCurrentDataminePage++;
		
		/////////////////////////
		// Passed last page
		if (mlCurrentDataminePage >= mvDataminePages.length())
		{
			/////////////////////////
			// Callback
			cLuxMap@ pMap = cLux_GetCurrentMap();
			if (msDatamineDoneCallback != "" && 
				pMap.ScriptPrepare("void " + msDatamineDoneCallback + "(const tString &in asEntity)"))
			{
				tString sName = cLux_ID_Entity(m_idDataminingEntity).GetName();
				pMap.SetArgString(0, sName);
				pMap.ScriptExecute();
			}
			/////////////////////////
			
			
			
			StopDatamining();
		}
		
		else
		{
			/////////////////////
			// Voice Subject
			cScrDataminePage@ pPage = mvDataminePages[mlCurrentDataminePage];
			if (pPage.msSubject != "")
			{
				if (msVoiceScene != "")
					Voice_Stop(msVoiceScene);
				if (mbStopAllVoices)
					Voice_StopAll();
				
				tString sCallback = "";
				if (mlCurrentDataminePage == mlLastVoicedPage)
					sCallback = msDatamineSubjectCallback;
					
				Voice_Play(pPage.msSubject, -1, sCallback);
				
				msVoiceScene = Voice_GetSubjectSceneName(pPage.msSubject);
				Voice_SetFocusScene(msVoiceScene);
			}
			
			///////////////////////////////////////////////////////
			// Check if there is nothing to display on this page
/*			if (pPage.msImage == "" && pPage.msTextCategory == "")
			{
				NextPage();
			}*/
		}
	}
	
	//------------------------------------------------------------
	
	void GetAllAudioSources()
	{
		mvAudioSources.resize(0);
		
		array<tID> vSources;
		cLux_GetCurrentMap().GetEntityArrayID("*", eLuxEntityType_Area, "cScrDatamineAudioSource", vSources);
		for(int i=0;i<vSources.size(); ++i)
		{
			//////////////////////////
			// Check if it belongs to this Data mine
			cScript_RunGlobalFunc(cLux_ID_Area(vSources[i]).GetName(), "", "_Global_GetDatamineName");
			if(cScript_GetGlobalReturnString() == cLux_ID_Entity(m_idDataminingEntity).GetName())
			{
				//////////////////////////
				// Add the audio source
				cScrDatamineAudioSource source;
				source.m_idEntity = vSources[i];
				
				cScript_RunGlobalFunc(cLux_ID_Area(vSources[i]).GetName(), "", "_Global_GetVoiceCharacter");
				source.msVoiceCharacter = cScript_GetGlobalReturnString();
				
				cScript_RunGlobalFunc(cLux_ID_Area(vSources[i]).GetName(), "", "_Global_GetCharacterImage");
				source.msCharacterImage = cScript_GetGlobalReturnString();
				
				source.mvAreaBasePos = cLux_ID_Area(vSources[i]).GetPosition();
				
				//////////////////////////
				// Get animation if any.
				cScript_RunGlobalFunc(cLux_ID_Area(vSources[i]).GetName(), "", "_Global_AnimNodeBaseName");
				tString sAnimNodeBase = cScript_GetGlobalReturnString();
				if(sAnimNodeBase != "")
				{
					int lCount=1;
					tString sAnimNode = sAnimNodeBase +"_"+lCount;
					iLuxEntity@ pNode = cLux_GetCurrentMap().GetEntityByName(sAnimNode, eLuxEntityType_Area, "cScrDatamineAnimNode");
					while(pNode !is null)
					{
						cScrDatamineAnimNode node;
						
						cScript_RunGlobalFunc(sAnimNode, "", "_Global_GetTimeToNode");
						node.mfTimeToNode = cScript_GetGlobalReturnFloat();
						
						cScript_RunGlobalFunc(sAnimNode, "", "_Global_GetEasingFunc");
						node.mEasing = eEasing(cScript_GetGlobalReturnInt());
						
						node.mvPosition = pNode.GetPosition();
						
						source.mvAnimNodes.push_back(node);
						
						++lCount;
						sAnimNode = sAnimNodeBase +"_"+lCount;
						@pNode = cLux_GetCurrentMap().GetEntityByName(sAnimNode, eLuxEntityType_Area, "cScrDatamineAnimNode");
					}
				}
				
				
				mvAudioSources.push_back(source);
			}
		}
	}
	
