	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
		if (tID_Invalid == m_idDataminingEntity) return;
		
		////////////////////////////////////
		// Skip line
		if((alAction == eAction_Interact) && cLux_ScriptDebugOn())
		{			
			Voice_AdvanceFromCurrentSound(msVoiceScene);
		}
			
		/////////////////////////
		// Cancel the data mining
		if ((alAction == eAction_InteractCancel) && abPressed)
		{
			StopDatamining();
		}
		
		
	}
	
