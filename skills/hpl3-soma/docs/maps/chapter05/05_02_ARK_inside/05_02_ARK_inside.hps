	bool mbCatherineSpotted = false;
	float mfPlayerWalk = 1.0f;

	//-------------------------------------------------------
	
	bool OnCollideSeeCatherineFirstTime(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		Extra_BeginFinalize();
		
		Audio_BeginCathMusic();
		Voice_Play("1ESeeCatherine1");
		Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldAll);
        Music_Stop(3.0f, eMusicPrio_MinorEvent);
		return false;
	}
	
	//-------------------------------------------------------

	bool OnCollideSeeCatherine(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;

		HeadTracker_SetActive("catherine_1",false);		
		
		if (alState == 1 && mbCatherineSpotted == false)
		{
			mbCatherineSpotted = true;
			SequenceOutro("");
		}
		
		return false;
	}

	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceOutro;	
	void SequenceOutro(const tString &in asName)
	{
		Sequence_Begin("SequenceOutro", mSequenceOutro);
		
		///////////////////////////////
		// Simon calls out to Catherine
		if (Sequence_DoStepAndWait(0.0f)) 	// delay removed
		{
			//CameraAnimation_Begin("CamAnim_FinalWalk","",false);
			Voice_Play("1ESeeCatherine2_Ver1",0);
            
            Map_AddTimer("EndingMusic", 0.25f, "EndingMusic");
            Sound_FadeGlobalVolume(0.0f, 3.0f, eSoundEntryType_WorldAll);
		}
		
		///////////////////////
		// Catherine turns around
		else if (Sequence_DoStepAndWait(2.5f))
		{
			Entity_PlayAnimation("catherine_1","look_at_simon",0.1f,true,true);
			Effect_Fade_Out(2.5f);
			Player_FadeMoveSpeedMulTo(0.5f,2.5f);
			Player_SetRunSpeedMul(0.0f);
			cLux_AddTodoMessage("SOUND : START MUSIC HERE");
		}
		
		//////////////////////
		// Begin Outro (quick fade here)
		else if (Sequence_DoStepAndWait(0.0f))
		{
			Map_ChangeMap("05_03_space.hpm", "", "", "");
		}
		
		Sequence_End();
	}
    
    void EndingMusic(const tString &in asTimer)
    {
        //Ending music that plays over to 5.3
        Music_PlayExt("05_03_satellitescene", false, 1.0f, 1.0f, 0.0f , 0.0f, eMusicPrio_OverrideAll, false);
    }

