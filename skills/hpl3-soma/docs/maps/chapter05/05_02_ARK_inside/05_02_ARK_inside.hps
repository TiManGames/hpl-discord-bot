	void StartIntro()
	{
		Effect_Fade_Out(0);
		Game_AutoSave();
		Map_AddTimer("timer_kickintro",0.5f,"TimerKickIntro");
	}
	
	//-------------------------------------------------------
	
	void TimerKickIntro(const tString &in asTimer)
	{
		//Player_Teleport("PlayerStart_1",true);
		
		CameraAnimation_Begin("SitAnim","",false);
		Entity_SetActive("simon_legs",true);
		
		Sound_SetGlobalVolume(1.0f, eSoundEntryType_Gui);
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_GuiWorld);
		Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);

		Sound_PlayGui("05_02/SFX/ark_intro", 1.0f, eSoundEntryType_Gui);
		
		Map_AddTimer("timer_wakeup",5.75f,"TimerWakeup");
		Map_AddTimer("fadeinaudio", 3.0f, "fadeinaudio");
		
		
		//Entity_PlayAnimation(name,anim,fadetime,loop,transition,callback)
	}
	
	//-------------------------------------------------------
	
	void TimerWakeup(const tString &in asTimer)
	{
		Effect_Fade_In(0.0f);
		Emotion_StartHeartbeat(0.75f, 0.5f, 1, 1.0f,0.25f, 5.0f);
		Emotion_StartBackgroundBreath(eBreathType_Normal, 0.65f, 1, 5.0f, 0.0f, 6.0f);
        Map_AddTimer("timer_preload",1.0f,"TimerPreload");
	}
	    
	//-------------------------------------------------------
	
    void fadeinaudio(const tString &in asTimer)
    {
		Sound_FadeGlobalVolume(1.0f, 8.0f, eSoundEntryType_WorldAll);
		Sound_FadeGlobalVolume(1.0f, 8.0f, eSoundEntryType_GuiWorld);
    }
    
