	void Audio_BeginCathMusic()
	{
		if(mbCathMusicActive==false)
		{
			Music_Stop(5.0f, eMusicPrio_MinorEvent);
			//Music_PlayExt("05_02_city_reveal", false, 0.65f, 1.0f, 0.0f, 0.0f, eMusicPrio_SceneAmb, false);
