	//}End Music
    bool mbExitCaveSweet = false;
    int mlWaterFallHandler = 0;
    bool WaterfallHandler(const tString &in asParent, const tString &in asChild, int alState)
    {
        if (alState != 1) 
            return true;
        
        if(asChild=="Waterfall_Stage0_Trigger")
        {
            mlWaterFallHandler = 0;
        }
        
        if(asChild=="Waterfall_Stage1_Trigger")
        {
            mlWaterFallHandler = 1;
        }
        
        if(asChild=="Waterfall_Stage2_Trigger")
        {
            mlWaterFallHandler = 2;
        }
        
        if(asChild=="Waterfall_Stage3_Trigger")
        {
            mlWaterFallHandler = 3;
			
			if(mbExitCaveSweet==false)
			{
				Sound_CreateAtEntity("ExitCaveSweet", "05_02/SFX/exit_cave_sweet", "Player");
				mbExitCaveSweet = true;
			}
        }
        
        WaterfallSound();
        cLux_AddDebugMessage("Waterfall sound stage "+mlWaterFallHandler);
        return true;
    }
	
	void Extra_BeginFinalize()
	{
		if(cScript_GetGlobalVarInt("WauFlowerCount")==1)
		{
			cLux_ResetShudderEffects(37);
		}
	}
    
    void WaterfallSound()
    {
        float afFadeTime = 2.0f;
        
        if(mlWaterFallHandler == 0)
        {
            if(Sound_Exists("WaterfallSound_Stage_0"))
            {
                Sound_Stop("WaterfallSound_Stage_0", afFadeTime*2);
            }
        }
        
        if(mlWaterFallHandler == 1)
        {
            if(Sound_Exists("WaterfallSound_Stage_0")==false)
            {
                 Sound_CreateAtEntity("WaterfallSound_Stage_0", "05_02/AMB/spot/waterfall/stage0", "WaterfallSoundSource", afFadeTime*2, true, 1.0f);
            }
            
            if(Sound_Exists("WaterfallSound_Stage_1"))
            {
                Sound_Stop("WaterfallSound_Stage_1", afFadeTime*3);
            }
        }
        
        if(mlWaterFallHandler == 2)
        {
            if(Sound_Exists("WaterfallSound_Stage_1")==false)
            {
               Sound_CreateAtEntity("WaterfallSound_Stage_1", "05_02/AMB/spot/waterfall/stage1", "WaterfallSoundSource", afFadeTime, true, 1.0f); 
            }
            
            if(Sound_Exists("WaterfallSound_Stage_0"))
            {
                Sound_Stop("WaterfallSound_Stage_0", afFadeTime*3);
            }
            
            if(Sound_Exists("WaterfallSound_Stage_2"))
            {
                Sound_Stop("WaterfallSound_Stage_2", afFadeTime);
            }
        }
        
        if(mlWaterFallHandler == 3)
        {
            if(Sound_Exists("WaterfallSound_Stage_1"))
            {
                Sound_Stop("WaterfallSound_Stage_1", afFadeTime);
            }
            
            if(Sound_Exists("WaterfallSound_Stage_2")==false)
            {
               Sound_CreateAtEntity("WaterfallSound_Stage_2", "05_02/AMB/spot/waterfall/stage2", "WaterfallSoundSource", afFadeTime*2, true, 1.0f);
            }
        }
    }
	    	
	//-------------------------------------------------------
    
	bool TurnOffSweet(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(Sound_Exists("ExitCaveSweet"))
		{
			Sound_Stop("ExitCaveSweet", 3.0f);
		}
		return true;
	}
    	
	//-------------------------------------------------------
    
    bool Trigger_CreakyBridge(const tString &in asParent, const tString &in asChild, int alState)
    {
        if(alState != 1)
            return true;
        
        Sound_CreateAtEntity("BridgeCreak", "05_02/AMB/spot/bridge_creak", asChild);
        Entity_SetActive("CreakyBridgeTrigger_*", false);
        Map_AddTimer("CreakBridgeTriggerCooldown", cMath_RandRectf(3.0f,6.0f), "CreakBridgeTriggerCooldown");
        return true;
    }
    
    void CreakBridgeTriggerCooldown(const tString &in asTimer)
    {
        cLux_AddDebugMessage("Bridge Creaks Re-Enabled");
        Entity_SetActive("CreakyBridgeTrigger_*", true);
    }
	
