	////////////////////////////
	// Set up map environment
	void Setup()
	{
		GetBase().SetDisplayNameEntry("05-02-ARK-inside");
		RichPresence_SetCurrent(eRichPresence_TheARK );
		
//		Effect_DoF_Start(0, 40.0f, 0.1, 0.0);
		Effect_Bloom_FadeBrightPass(0.05f, 2);
		Effect_Bloom_FadeBloomWidth(128, 0.6);
		Effect_Bloom_FadeBloomFalloff(1.5f, 2);
		Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		cTerrain@ pTerrain = cLux_GetCurrentMap().GetWorld().GetTerrain();
		if(pTerrain !is null) pTerrain.SetCheapMaterial("forestground_mixed.mat", 0.25f);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		/////////////////////////
		// Audio preload
        Sound_SetGlobalVolume(0.0f, eSoundEntryType_WorldAll);
        Sound_PreloadProject("05_02");
        Sound_PreloadGroup("Player/foley/default/hand_animation", true);
        
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
            Sound_FadeGlobalVolume(1.0f, 1.0f, eSoundEntryType_WorldAll);
            Map_AddTimer("timer_preload",0.5f,"TimerPreload");
		}
		
		// Make sure player energy is restored to full!
		Player_SetMaxHealth(1.0f);
		Player_SetHealth(1.0f);
		
		PlayerHands_SetHandModel_Human();
		
		Player_SetFlashlightActive(false,false);
		Player_SetFlashlightDisabled(true);

		//Cath voice set via voicehandler to handle filtering falloff
		//Voice_SetSource("Catherine","Catherine", 2, 30, true, 30);
	
	
		if(!cLux_ScriptDebugOn())
		{
			Effect_Fade_Out(0);
			StartIntro();
		}
		
		Entity_PlayAnimation("catherine_1","look_at_clouds",0.1f,true);
		Player_SetRunBreathingDisabled(true);
		
		
		
		LastOnSoma_SetText("05_02_ARK_inside_1");	
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		MainMenu_SetBGPhase(eMainMenuPhase_AfterEnd);
		
		Player_SetFootWear("sneaker");
		Player_SetClothing("dressed");
	}

