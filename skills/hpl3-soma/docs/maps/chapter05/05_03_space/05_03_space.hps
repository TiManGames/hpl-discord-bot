class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
	
	cMatrixf m_mtxProbeRot;
	cVector3f mvProbePos;
	
	cColor mDistantHaloColor;
	cColor mProbeHaloColor;
	
	bool mbEnded=false;
	
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		GetBase().SetDisplayNameEntry("05-03-space");
	}
	
	//-------------------------------------------------------
	
	void SetFOV(float afDegrees, float afSpeed)
	{
		Player_FadeFOVTo(cMath_ToRad(afDegrees),afSpeed);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{		
		Effect_Bloom_FadeBrightPass(0.75f, 2);
		Effect_Bloom_FadeBloomWidth(128, 2);
		Effect_Bloom_FadeBloomFalloff(0.5f, 2);
		Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		iLuxEntity @pProbe = cLux_GetCurrentMap().GetEntityByName("ark_probe_1");
		m_mtxProbeRot = pProbe.GetMatrix();
		mvProbePos = pProbe.GetPosition();
		m_mtxProbeRot.SetTranslation(0);
		
		Effect_Fade_Out(0);
		
		
		cBillboard @pDistantHalo = cLux_GetCurrentMap().GetWorld().GetBillboard("DistantHalo");
		mDistantHaloColor = pDistantHalo.GetColor();
		
		cBillboard @pProbeHalo = cLux_GetCurrentMap().GetWorld().GetBillboard("ProbeHalo");
		mProbeHaloColor = pProbeHalo.GetColor();
		
		/*Player_SetLookSpeedMul(0.0f);
		Player_SetCrouchDisabled(true);
		Player_SetJumpDisabled(true);
		Player_SetRunBreathingDisabled(true);
		Player_SetActive(false);*/
		
		
		
		SetFOV(10.0f,60.0f);
		//cLux_GetPlayer().GetCharacterBody().SetActive(false);
		
		//Map_AddTimer("timer_introvoice",0.1f,"TimerIntroDialogue");
		TimerIntroDialogue("");

		Sound_PreloadGroup("05_02/SFX/sat", true);
        //PLEASE NOTE - Music now starts on 5.2 to lead into 5.3 - do not reenable!
		
		Player_SetActive(false);
		
		LastOnSoma_SetText("");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		MainMenu_SetBGPhase(eMainMenuPhase_AfterEnd);
		Player_ShowCrossHairIcons(false);

		Effect_ToneMapping_UseSRGB(true);
		
		Player_ShowCrossHairIcons(false);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Effect_ToneMapping_UseSRGB(false);
		Player_FadeFOVToDefault(0.5);
		Player_ShowCrossHairIcons(true);
	}
	
	//-------------------------------------------------------
	
	tString msAreaName = "CamArea_1";
	tString msTargetAreaName = "CamArea_1";
	float msTimer = 0.0f;
	
	cVector3f mvLastPos;
	float mfTime = 0.0f;
	float mfCamTime = 0.0f;
	float mfProbeTime = 0.0f;
	float mfProbeLowerTime = 0.0f;
	bool mbMoveCamera = false;
	bool mbMoveProbe = false;
	bool mbGameOver = false;
	bool mbOutroRunning = false;
	
	void Update(float afTimeStep)
	{
		if (!mbOutroRunning) return;
		if (mbGameOver) return;
		
		mfTime += afTimeStep;
		//cLux_AddDebugMessage(""+mfTime);
	
		if (mbMoveCamera)
		{
			mfCamTime += afTimeStep*0.05f;
			mfCamTime = cMath_Clamp(mfCamTime,0.0f,0.1f);
			for (int i=1; i<6; i++)
			{
				CameraAnimationNode_SetAutoMove("CamArea_"+i,mfCamTime);
			}
		}
		
		if (mfTime >= 29.0f)	// 33 for V2
		{
			mfProbeTime += afTimeStep*0.05f;
			mfProbeTime = cMath_Clamp(mfProbeTime,0.0f,0.13f);
			iLuxEntity @pProbe = cLux_GetCurrentMap().GetEntityByName("ark_probe_1");
			mvProbePos.x -= afTimeStep * cMath_Min(cMath_Abs(mvProbePos.x), 300.0f)*mfProbeTime;
			mvProbePos.z -= afTimeStep * mfProbeTime * 0.5f;
			
	
			if (mfTime >= 46.5f)
			{
				mfProbeLowerTime += afTimeStep;
				mfProbeLowerTime = cMath_Clamp(mfProbeLowerTime,0.0f,0.08f);
				mvProbePos.y -= afTimeStep * mfProbeLowerTime * 0.5f;
			}
			
			pProbe.SetPosition(mvProbePos);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			cLux_AddDebugMessage("Player "+cLux_GetPlayer().IsActive());
		}
		
		if (alAction == eAction_Test2)
		{
			/*mlCamNum++;
			if (mlCamNum > 3)
				mlCamNum = 1;
			
			msAreaName = "CamArea_"+mlCamNum;
			cLux_AddDebugMessage(msAreaName);*/
			//Effect_DoF_FadeFalloff(mlid_DepthOfField,0.0f,5.0f);
		}
		
		if (alAction == eAction_Test3)
		{
			mlTargetNum++;
			if (mlTargetNum > 3)
				mlTargetNum = 1;
			
			msTargetAreaName = "CamArea_"+mlTargetNum;
			cLux_AddDebugMessage(msTargetAreaName);
		}
		
		
	}

	int mlTargetNum = 1;
	int mlCamNum = 1;
	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
	//-------------------------------------------------------
 
	//} END MAIN CALLBACKS
 
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
 
	//-------------------------------------------------------

	void TimerIntroDialogue(const tString &in asTimer)
	{
		Voice_Play("FinalWords_Version2");
		Map_AddTimer("timer_begin",0.1f,"TimerBeginSequences");
	}
	
	//-------------------------------------------------------
	
	int mlid_ScanLines;
	int mlid_DepthOfField;
	void TimerBeginSequences(const tString &in asTimer)
	{
		//mlid_ScanLines = Effect_Screen_Start("00_04_scan_noise.mat", cVector2f(0.5, 0.5), cVector2f(0.5,0.5),  1, 0.01, 6, 7.0);
		//mlid_DepthOfField = Effect_DoF_Start(0.1f, 0.5f, 1, 0);
		
		Effect_ChromaticAberration_StartAnim(8.0f,0.005,0.005,cVector2f_Zero);
		Effect_ImageTrail_Start(0.08,0.1,7.0,1.0);
		
		mbOutroRunning = true;
		SequenceZoomOut("");
		CameraAnimation_Begin("CamArea","",false);
		Map_AddTimer("timer_endgame",85.0f,"Timer_GameOver");
	}
	
	//-------------------------------------------------------
	
	void Timer_GameOver(const tString&in asTimer)
	{
		Effect_Fade_Out(23.0f);
		Map_AddTimer("Timer_Achievement",24.0f,"Timer_Achievement");
		Map_AddTimer("Timer_EndGame",28.0f,"Timer_EndGame");
	}
	
	//-------------------------------------------------------
	
	void Timer_Achievement(const tString &in asTimer)
	{
		Achievement_Unlock(eAchievement_TheEnd); //maybe move this?
	}
	
	//-------------------------------------------------------
	
	void Timer_EndGame(const tString&in asTimer)
	{
		mbGameOver = true;
		MainMenu_GameOver();
	}
 
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE X *OUTRO*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		void OnSimonSpeak(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if (!abStartOfLine) Effect_Fade_In(5);
		}
	 
		//-------------------------------------------------------
	 
		cSequenceStatesData mSequenceZoomOut;	
		void SequenceZoomOut(const tString &in asName)
		{
			Sequence_Begin("SequenceZoomOut", mSequenceZoomOut);
			
			//Zoom out from ARK
			if (Sequence_DoStepAndWait(0.1f)) 
			{
				Player_StartLookAt("ark_probe_1",100.0f,100.0f,100.0f);
			}
			else if (Sequence_DoStepAndWait(4.0f)) 
			{	
				//mfPlayerFOV = 0.7f;
				//Player_FadeFOVMulTo(mfPlayerFOV,0.1f);
				SetFOV(40.0f,0.025f);
				Prop_RotateToSpeed("ark_probe_1",0.0025f,-0.1f,true,"");
				//Effect_DoF_FadeFocus(mlid_DepthOfField,0.0,8.0,4.0);
			}
			else if (Sequence_DoStepAndWait(5.5f))
			{
				//iLuxEntity @pProbe = cLux_GetCurrentMap().GetEntityByName("ark_probe_1");
				Prop_RotateToSpeed("ark_probe_1",0.01f,-0.1f,false,"");
                Sound_PlayGui("05_02/SFX/sat/fly_out", 1.0f, eSoundEntryType_Gui);
				cLux_AddTodoMessage("SOUND: Satellite sound starts here");
			}
			else if (Sequence_DoStepAndWait(16.5f))
			{
				//	CameraAnimationNode_SetAutoMove("AnimMoveAroundArk_1",1.0f);
				//	CameraAnimation_Begin("AnimMoveAroundArk","",false)
				mbMoveCamera = true;
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				mbMoveProbe = true;
				Prop_RotateToSpeed("ark_probe_1",0.025f,-0.1f,false,"");;
				//Effect_DoF_FadeFalloff(mlid_DepthOfField,0.0f,20.0f);
			}
			else if (Sequence_DoStepAndWait(6.0f))
			{
				for	(uint i=1;i<11;++i)
				{
					ParticleSystem_CreateAtEntity("ps_probejets_"+i,"probejet_fast_small_loop.ps","probejet_area_"+i,true);
				}
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				for	(uint i=1;i<11;++i)
				{
					ParticleSystem_Destroy("ps_probejets_"+i);
				}
				//Effect_DoF_FadeFocus(mlid_DepthOfField,0.0,11.0,4.0);
			}
			else if (Sequence_DoStepAndWait(5.9f))
			{
				for	(uint i=1;i<11;++i)
				{
					if (ParticleSystem_Exists("ps_probejets_"+i))
						ParticleSystem_SetVisible("ps_probejets_"+i, false);
				}
				
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Prop_RotateToSpeed("ark_probe_1",0.02f,-0.1f,false,"");
				
			}
			
		Sequence_End();
	}
	 
