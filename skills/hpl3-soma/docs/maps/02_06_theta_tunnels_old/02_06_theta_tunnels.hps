	//-------------------------------------------------------
	
	void Setup()
	{
		//Stops spark sound from leaking across map, sets to true when entering office containing spark
		Light_SetFlickerActive("sleved_open_animated01_1_big", false);
		Light_SetVisible("sleved_open_animated01_1_big", false);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{

		//////////////////////////////////////////
		// Player setup
		Player_SetMoveSpeedMul(1); //Might be 0 if preload locked the player
		
		Player_SetAmbientLight_Indoors();
		
		PlayerHands_SetHandModel_Diving();
		
		SetupArkRoom();
		SetupAirlocks();
		SetupPanelClamps();
		SetupProjectors();
		SetupCatherine();
		SetupBrandon();
		
		bool bDoIntro = true;

		///////////////////////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			bDoIntro = false;
		}
		
		if (bDoIntro)
		{
			//Effect_Fade_Out(0.0f);
			//Effect_Fade_In(5.0f);
		}
		
		//////Level Audio and Preloads	
		Sound_PreloadCoreSounds();
		Sound_PreloadCoreInteractions();
		Sound_PreloadGroup("02_06_theta_tunnels/amb", true);
		Sound_PreloadGroup("02_06_theta_tunnels/sfx", true);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		GetBase().SetDisplayNameEntry("02-06-theta-tunnels");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
		cLux_AddDebugMessage("OnPlayerKilled");
		Dialog_StopAll();
		
		cLux_AddDebugMessage("OnPlayerKilled "+asSource);
		if (asSource == "puppet_tunnel")
		{
			// We want to transition to 2.7 here as planned.
			SequencePuppetCapture("");
			Entity_SetActive("puppet_tunnel",false);
		}
		else if (asSource != "")
		{
			mlAkersKillCount++;
			//Map_AddTimer("2_PlayerWakesUpFromDeath", 10, "TimerPlayVoice");
			
			if(mlAkersKillCount>=3)
				Puppet_SetHideAndWaitPaused("puppet_dynamic", true);
		}
		
		else if (asSource == "puppet_elevator")
		{
			Music_Stop(1.0f, eMusicPrio_BgAmb);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			//door_panel_chip_formatted
			
			//Tool_PickUp("door_panel_chip_formatted", false, false);
			
			//CollideAreaEnableAkers("", "", 1);
			
			SetupProjectors();
			
			//Puppet_SetAgressionAmount("puppet_dynamic",0.5);
			
			/*cLuxClosestEntityData pData;
			if (!cLux_GetClosestEntity(cLux_GetPlayer().GetCamera().GetPosition(),cLux_GetPlayer().GetCamera().GetForward(),100, 0, false, pData))
				return;
				
			tString sEntity = pData.mpEntity.GetName();

			Button_SetLocked(sEntity, !Button_IsLocked(sEntity), true);
			Lamp_SetLit(sEntity, !Lamp_GetLit(sEntity), true);
			SlideDoor_SetClosed(sEntity, false, false);*/
		}
		
		if (alAction == eAction_Test2)
		{
			Puppet_SetAgressionAmount("puppet_dynamic",1.0);
			Puppet_SetComeOutOfHidingTimeMul("puppet_dynamic", 0.3f);
			//Prop_RotateToSpeed("ScannerArm", 10, 5, true, "");
		}
		
		if (alAction == eAction_Test3)
		{
			StopScannerArm();
		}
		
		if (alAction == eAction_Test4)
		{
			mbReInit=true;
			Terminal_SetGuiActive("ARKTerminal", true);
			StationGui_SetActiveApp("ARKTerminal", eSimulationTerminalApp_WorldSetup);
		}
		
		if (alAction == eAction_Test5)
		{
			Voice_Stop("Dialog");
			Voice_Play("1_ScanningAndSimDone_1");
			Voice_PlayWhenPossible("1_ScanningAndSimDone_2", "VoiceCondition_ScanningAndSimDone", -1, 0, "VoiceOver_EjectCathTool");
		}
		
		if (alAction == eAction_Test7)
		{
			CameraAnimation_Begin("ElevatorBreakAnim", "", true);
		}
		
		if (alAction == eAction_Test8)
		{
			for (int i = 1; i <= 4; i++)
			{
				cScript_SetGlobalVarBool("PlayerErasedLegacyData_"+i, false);
			}
		}
			
		
		if (alAction == eAction_Test9)
		{
			security_chip_unformatted_OnPlayerInteract("");
		}
	}
	
