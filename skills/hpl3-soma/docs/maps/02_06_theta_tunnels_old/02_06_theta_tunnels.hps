		void AddDoorLockButton(const tString &in asName, const tString &in asGfx, const tString &in asPanelPrefix)
		{
			cDoorLockAppButton lock = CreateDoorLockButton(asName, asGfx, asPanelPrefix);
			StationGui_DoorLockApp_AddLock(lock);
		}
		
		cDoorLockAppButton CreateDoorLockButton(const tString &in asName, const tString &in asGfx, const tString &in asPanelPrefix)
		{
			cDoorLockAppButton lock(asName);
			lock.mvButtons.push_back(asPanelPrefix+"_1");
			lock.mvButtons.push_back(asPanelPrefix+"_2");
			lock.mGfx = cImGuiGfx(asGfx);
			return lock;
		}
		
