			/////////////////////////////////////////
			// Scene 1 - Body Scanner
			//{//////////////////////////////////////
			
			//-------------------------------------------------------
			
			bool mbScannerLookedAt = false;
			bool mbScanPending = false;
			bool mbPlayVoiceOnScanDoorButtonPress = true;
			
			//-------------------------------------------------------
			
			void OnGui_OuterScanTerminal(const tString&in asEntityName, float afTimeStep)
			{
				StationGui_BigStatusMessage(Entity_GetVarString(asEntityName, ""), gStationGuiColor_Warning, 2);
			}
			
			//-------------------------------------------------------
			
			void OnChange_ScannerDoorButton(const tString &in asEntity, int alState)
			{
				MoveObject_SetState("ScannerBridge", alState == 1 ? 1 : 0);
				
				if (mbPlayVoiceOnScanDoorButtonPress)
					Voice_PlayWhenPossible("1_ExaminesScanner", "VoiceCondition_ExaminesScanner", -1, 1, "VoiceOver_ExaminedScanner", 0);
			}
			
			//-------------------------------------------------------
			
			void LookAt_Scanner(const tString &in asEntity, int alState)
			{
				mbScannerLookedAt = alState==1;
				if (alState==-1 || CathTool_IsInserted("CathTool")==false)
					return;
					
				Voice_PlayWhenPossible("1_ExaminesScanner", "VoiceCondition_ExaminesScanner", -1, 1, "VoiceOver_ExaminedScanner", 0);
			}
			
			//-------------------------------------------------------
			
			bool VoiceCondition_ExaminesScanner(const tString&in asSubject)
			{
				if (mbKnowsAboutScanner)
					return false;
					
				if (Doorway_PlayerIsInGroup("Scanner")==false && mbScannerLookedAt==false)
					return false;
				
				mbKnowsAboutScanner = true;
				Entity_SetPlayerLookAtCallback("ScannerLookAt", "");
				mbPlayVoiceOnScanDoorButtonPress = false;
				return true;
			}
			
			//-------------------------------------------------------
			
			void VoiceOver_ExaminedScanner(const tString&in asScene, const tString&in asSubject)
			{
				if (Doorway_PlayerIsInGroup("Scanner") && Entity_GetCollide("ScanChamberTable", "ScannerTableCheck")==false)
				{
					StartScanning();
				}
				else
				{
					mbScanPending = true;
					Voice_Play("1_ExaminesScanner_2_Outside", -1, "", 0);
				}
			}
			
			//-------------------------------------------------------
			
			bool Doorway_EnteredScanner(const tString &in asArea, const tString &in asEntity, int alState)
			{
				if (mbScanPending == false)
					return true;

				if (alState == -1 || Entity_GetCollide("ScanChamberTable", "ScannerTableCheck"))
					return true;
				
				StartScanning();
				return true;
			}
			
			//-------------------------------------------------------
			
			bool Trigger_ScanChamberTableInScanner(const tString &in asParent, const tString &in asChild, int alState)
			{
				if (mbScanPending == false)
					return true;
					
				if (alState == 1 || Doorway_PlayerIsInGroup("Scanner")==false)
					return true;
					
				StartScanning();
				return false;
			}
			
			//-------------------------------------------------------
			
			void StartScanning()
			{
				Entity_SetActive("ScannerTableCheck", false);
				
				Terminal_SetGuiActive("Scanner_ExtTerminal", false);
				Button_SetSwitchedOn("ScannerDoor_Button", false, true);
				Entity_SetActive("ScannerDoor_Blocker", true);
				Map_AddTimer("Timer_StartScanningDialog", 2, "Timer_StartScanningDialog");
			}
			
			//-------------------------------------------------------
			
			void Timer_StartScanningDialog(const tString &in asTimer)
			{
				Entity_SetActive("ScannerDoorway", false);
				Voice_Stop("Dialog");
				Voice_Play("1_EnteredScanner", -1, "VoiceOver_EnteredScanner");
			}
			
			//-------------------------------------------------------
			
			void VoiceOver_EnteredScanner(const tString&in asScene, const tString&in asSubject)
			{
				Button_SetLocked("ScannerButton", false, true);
			}
			
			//-------------------------------------------------------
			
			void OnChange_ScannerButton(const tString &in asEntity, int alState)
			{
				Seq_ScannerScanning("");
			}
			
			//-------------------------------------------------------
			
			cSequenceStatesData mScannerScanningSequence;
				
			void Seq_ScannerScanning(const tString &in asTimer)
			{
				Sequence_Begin("Seq_ScannerScanning", mScannerScanningSequence);
					
				if (Sequence_DoStepAndWait(2))
				{
					cLux_AddTodoMessage("Sound: Scanner scanning");
					Terminal_SetGuiActive("Scanner", true, 1);
					Prop_RotateToSpeed("ScannerArm", 0.75, 5, true, "");
				}
				else if (Sequence_DoStepAndWait(1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.5))
				{
					Dialog_Begin();
						Dialog_AddBranch("1_ScannerScanning_1", "1_ScannerScanning_2_NotLooking");
							Dialog_AddSubject("1_ScannerScanning_1", "Subject_ScannerScanning");
							Dialog_AddPause(1.5);
							Dialog_AddEndEvent_Callback("DialogEvent_LookingAtScreen", "1_ScannerScanning_2_Looking");
						Dialog_AddBranchAndSubject("1_ScannerScanning_2_NotLooking", "1_ScannerScanning_3");
						Dialog_AddBranchAndSubject("1_ScannerScanning_2_Looking", "1_ScannerScanning_3");
						Dialog_AddBranchAndSubject("1_ScannerScanning_3", "", "Subject_ScannerScanning");
					Dialog_End(); 
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndPause(0.1))
				{
					Terminal_IncImGuiStateInt("Scanner", "ScanState", 1);
				}
				else if (Sequence_DoStepAndWait(3))
				{
					Terminal_SetGuiActive("Scanner", false, 0.3);
					StopScannerArm();
				}
				else if (Sequence_DoStepAndWait(0.5))
				{
					Button_SetSwitchedOn("ScannerDoor_Button", true, true);
					Entity_SetActive("ScannerDoor_Blocker", false);
					Button_SetLocked("ScannerDoor_Button", true, true);
					Button_SetLocked("ScannerButton", true, true);
				}
				else
				{
					mbPlayerScanned = true;
					if (mbFinishedSim)
					{
						Voice_Stop("Dialog");
						Voice_Play("1_ScanningAndSimDone_1");
						Voice_PlayWhenPossible("1_ScanningAndSimDone_2", "VoiceCondition_ScanningAndSimDone", -1, 0, "VoiceOver_EjectCathTool");
					}
					else
					{
						Voice_Play("1_ScanningDone_SimNotDone");
					}
				}
				Sequence_End();
			}
			
