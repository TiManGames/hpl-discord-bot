		////////////////////////////////////////////////////////////
		// Scene 1 - *Using airlocks from ARK room*
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msAirlockEntryDoor = "";
		tString msAirlockExitDoor = "";
		tString msAirlockEntryTrigger = "";
		tString msAirlockLight = "";
		tString msAirlockScanner = "";
		int mlAirlockParticleAreas = 32;
		
		//-------------------------------------------------------
			
		void SetupAirlocks()
		{
			Lamp_SetLit("airlock_scanner_north_left",false,false);
			Lamp_SetLit("airlock_scanner_north_right",false,false);
			Lamp_SetLit("airlock_scanner_east_left",false,false);
			Lamp_SetLit("airlock_scanner_east_right",false,false);
		}
		
		//-------------------------------------------------------
		
		void AirlockButton(const tString &in asEntity, int alState)
		{		
			///////////////////////////////////////////////
			// Disable exit triggers
			Entity_SetActive("ArealockExitTrigger_*",false);
				
			///////////////////////////////////////////////
			// Setup how doors should behave based on button pushed
			if (asEntity == "AirlockButton_North_1")
			{
				msAirlockEntryDoor = "NorthAirlock_door_inside";
				msAirlockEntryTrigger = "Area_AirlockEntry_North_Inside";
				msAirlockScanner = "airlock_scanner_north";
			}
			else if (asEntity == "AirlockButton_North_2")
			{
				msAirlockEntryDoor = "NorthAirlock_door_outside";
				msAirlockEntryTrigger = "Area_AirlockEntry_North_Outside";
				msAirlockScanner = "airlock_scanner_north";
			}
			else if (asEntity == "AirlockButton_East_1")
			{
				msAirlockEntryDoor = "EastAirlock_door_inside";
				msAirlockEntryTrigger = "Area_AirlockEntry_East_Inside";
				msAirlockScanner = "airlock_scanner_east";
			}
			else if (asEntity == "AirlockButton_East_2")
			{
				msAirlockEntryDoor = "EastAirlock_door_outside";
				msAirlockEntryTrigger = "Area_AirlockEntry_East_Outside";
				msAirlockScanner = "airlock_scanner_east";
			}
			
			if (alState == 1)
			{
				///////////////////////////////////////
				// Activate entry trigger
				Entity_SetActive(msAirlockEntryTrigger,true);
				
				////////////////////////////////////////////////
				// Open the entry door
				OpenAirlockDoor(msAirlockEntryDoor);
			}
			else
			{
				////////////////////////////////////////////////
				// Close the entry door
				CloseAirlockDoor(msAirlockEntryDoor);
			}
		}
		
		//--------------------------------s-----------------------
		
		void OpenAirlockDoor(const tString &in asDoorName, bool abInstant=false)
		{
			SlideDoor_SetClosed(asDoorName,false,abInstant);
			
		}
		
		//-------------------------------------------------------
		
		void CloseAirlockDoor(const tString &in asDoorName, bool abInstant=false)
		{
			SlideDoor_SetClosed(asDoorName,true,abInstant);
		}
		
		//-------------------------------------------------------
		
		bool EnterAirLock(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			///////////////////////////////////////////////////////////////////////////
			// Disable this trigger so it doesn't get called again during this sequence
			Entity_SetActive(asChild,false);
			
			//////////////////////////////////////////////////
			// Slow down the player so they can't glitch the air lock
			Player_SetMoveSpeedMul(0.5);
			
			////////////////////////////////////////////////////////////////////
			// Setup the right airlock doors before running the airlock sequence
			if (asChild == "Area_AirlockEntry_North_Inside")
			{
				msAirlockLight = "Airlock_Light_North";
				msAirlockEntryDoor = "NorthAirlock_door_inside";
				msAirlockExitDoor = "NorthAirlock_door_outside";
			}
			else if (asChild == "Area_AirlockEntry_North_Outside")
			{
				msAirlockLight = "Airlock_Light_North";
				msAirlockEntryDoor = "NorthAirlock_door_outside";
				msAirlockExitDoor = "NorthAirlock_door_inside";
			}
			else if (asChild == "Area_AirlockEntry_East_Inside")
			{
				msAirlockLight = "Airlock_Light_East";
				msAirlockEntryDoor = "EastAirlock_door_inside";
				msAirlockExitDoor = "EastAirlock_door_outside";
			}
			else if (asChild == "Area_AirlockEntry_East_Outside")
			{
				msAirlockLight = "Airlock_Light_East";
				msAirlockEntryDoor = "EastAirlock_door_outside";
				msAirlockExitDoor = "EastAirlock_door_inside";
			}
			
			/////////////////////////////////////////////////
			// Begin Airlock Sequence
			SequenceAirLock("");
			
			return true;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mAirLockSequence;
		void SequenceAirLock(const tString &in asTimer)
		{
			Sequence_Begin("SequenceAirLock", mAirLockSequence);
			
			if (Sequence_DoStepAndWait(3.0f))
			{
				///////////////////////////////////
				// Close the door the player entered from
				CloseAirlockDoor("*Airlock_door*",false);
				
				//////////////////////////////////
				// Activate Light
				Light_FadeTo(msAirlockLight,cColor(0.569,1,0.941,1),3,3.0);
				
				//////////////////////////////////////////////
				// Light scanners
				Lamp_SetLit(msAirlockScanner+"_left",true,true);
				Lamp_SetLit(msAirlockScanner+"_right",true,true);
				
				//////////////////////////////////////////////
				//Airlock idle sound
				Sound_CreateAtEntity("AirlockIdle", "Entities_Station/tech/scanner/scan_idle","Player",0.0f,false,1.0f);
				
				//////////////////////////////////////////////
				//Disable crouch
				Player_SetCrouchDisabled(true);
			
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{    
				
				//////////////////////////////////////////////
				// Scanner Sound
				Sound_CreateAtEntity("AirlockScan","Entities_Station/tech/scanner/scan_sequence","Player",0.0f,false,1.0f);
				
			
				/////////////////////////////////////////////
				// Move Scanners
				Prop_MoveLinearTo(msAirlockScanner+"_left",msAirlockScanner+"_left_end",1.0f,1.0f,0.1f,true);
				Prop_MoveLinearTo(msAirlockScanner+"_right",msAirlockScanner+"_right_end",1.0f,1.0f,0.1f,true);
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				//ParticleSystem_Destroy("airlock_steam_*");
			
				/////////////////////////////////////////////
				// Move Scanners
				Prop_MoveLinearTo(msAirlockScanner+"_left",msAirlockScanner+"_left_start",1.0f,1.0f,0.1f,true);
				Prop_MoveLinearTo(msAirlockScanner+"_right",msAirlockScanner+"_right_start",1.0f,1.0f,0.1f,true);
				
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				
				///////////////////////////////////
				//End audio
				Sound_Stop("AirlockIdle", 0.1f);
				Sound_CreateAtEntity("AirlockIdleEnd","Entities_Station/tech/scanner/scan_stop","Player",0.0f,false,1.0f);
				
				///////////////////////////////////
				// Give the player control back
				Player_SetMoveSpeedMul(1.0);
				
				//////////////////////////////////////////////
				//Enable crouch
				Player_SetCrouchDisabled(false);
				
				///////////////////////////////////
				// Open the appropriate door for player to leave air lock
				OpenAirlockDoor(msAirlockExitDoor);
				
				///////////////////////////////////
				// Fade airlock lights
				Light_FadeTo("Airlock_Light*",cColor(0,0,0,0),3,3.0);
				
				///////////////////////////////////
				// Enable airlock exit triggers
				Entity_SetActive("Area_AirlockExitTrigger_*",true);
				
				///////////////////////////////////
				// Turn off scanner effects
				Lamp_SetLit(msAirlockScanner+"_left",false,true);
				Lamp_SetLit(msAirlockScanner+"_right",false,true);	
				
				
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool ExitAirlock(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			/////////////////////////////////
			// Disable all airlock exit areas
			Entity_SetActive("Area_AirlockExitTrigger_*",false);
				
			///////////////////
			// Close exit doors
			CloseAirlockDoor(msAirlockExitDoor);		
			
			/////////////////////////
			// Turn buttons back off
			Button_SetSwitchedOn("AirlockButton_*",false,true);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		//}END EVENT Airlock
	
