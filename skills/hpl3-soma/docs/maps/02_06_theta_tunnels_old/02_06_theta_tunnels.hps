		//-------------------------------------------------------

	
		/////////////////////////////////////////
		// Scene 1 - Puppet Reveal Security Corridor
		//{//////////////////////////////////////
		
		//-------------------------------------------------------

		float mfScanningProgress = 0;
		float mfImageDisplay = 0;
		void OnGui_ScannerScreen(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			cImGuiGfx xRayFront = cImGuiGfx("xray_front", eImGuiGfx_Texture);
			cImGuiGfx xRaySide = cImGuiGfx("xray_side", eImGuiGfx_Texture);
			cImGuiGfx xRayGrid = cImGuiGfx("xray_cross", eImGuiGfx_Texture);
				
					
			//StationGuiBG_BackdropV2();
			StationGuiBG_Scanlines();
			
			int lScanState = ImGui_GetStateInt("ScanState", eScannerState_Boot);
			
			if (lScanState == eScannerState_Boot)
			{
				
			}
			
			///////////////////////////
			// Print scan image, line by line
			else if (lScanState == eScannerState_BodyScan)
			{
				mfScanningProgress += afTimeStep * 0.4f;
							
				if(mfScanningProgress>=2.0f)
				{
					mfScanningProgress = 2;
					ImGui_IncStateInt("ScanState", 1);
				}
					
				if (int(mfScanningProgress*10)!=int(mfImageDisplay*10))
					mfImageDisplay = cMath_RoundFloatToDecimals(mfScanningProgress, 1);
			}
					
			cVector2f vBaseImgSize = ImGui_GetRatioCorrectSizeByNrmHeight(xRayFront, 1);
			xRayFront.mvUVMax = xRaySide.mvUVMax = cVector2f(1, mfImageDisplay/2.0f);
			
			///////////////////////////
			// Draw brain stuff
			if (lScanState == eScannerState_Brain)
			{
				ScanBodyPartHighlight("brain", vBaseImgSize);
				if (ScanPopUpImg("brain", cImGuiGfx("xray_brain_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.8, 0.05, 1), 0.2))
				{
					ScanInfoLines_AddNrmVertex(cVector2f(0.8, 0.15));
					ScanInfoLines_AddNrmVertex(cVector2f(0.675, 0.15));
					ScanInfoLines("BrainLines");
				}
				
				ScanInfoText("Scanner_Brain", 2, -1, afTimeStep, ImGui_NrmPosGroup(0.8, 0.30, 5), ImGui_NrmSize(0.2, 0.35));
			}
			
			///////////////////////////
			// Draw blackbox stuff
			else if (lScanState == eScannerState_Blackbox || lScanState == eScannerState_ShowReed)
			{
				ScanBodyPartHighlight("blackbox", vBaseImgSize);
				if (ScanPopUpImg("blackbox", cImGuiGfx("xray_blackbox_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.8, 0.25, 1), 0.2))
				{
					ScanInfoLines_AddNrmVertex(cVector2f(0.9, 0.25));
					ScanInfoLines_AddNrmVertex(cVector2f(0.9, 0.175));
					ScanInfoLines_AddNrmVertex(cVector2f(0.675, 0.175));
					ScanInfoLines("BlackboxLines");
				}

				ScanInfoText("Scanner_Blackbox_1", 1, 2.5, afTimeStep, ImGui_NrmPosGroup(0.8, 0.50, 5), ImGui_NrmSize(0.2, 0.35));
				ScanInfoText("Scanner_Blackbox_2", 2.5, 5, afTimeStep, ImGui_NrmPosGroup(0.8, 0.50, 5), ImGui_NrmSize(0.2, 0.35));
				ScanInfoText("Scanner_Blackbox_3", 5, -1, afTimeStep, ImGui_NrmPosGroup(0.8, 0.50, 5), ImGui_NrmSize(0.2, 0.35));
			}
			
			///////////////////////////
			// Draw battery stuff
			else if (lScanState == eScannerState_Battery)
			{
				ScanBodyPartHighlight("battery", vBaseImgSize);
				if (ScanPopUpImg("battery", cImGuiGfx("xray_battery_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.8, 0.4, 1), 0.2))
				{
					ScanInfoLines_AddNrmVertex(cVector2f(0.8, 0.5));
					ScanInfoLines_AddNrmVertex(cVector2f(0.76, 0.5));
					ScanInfoLines_AddNrmVertex(cVector2f(0.76, 0.325));
					ScanInfoLines_AddNrmVertex(cVector2f(0.675, 0.325));
					ScanInfoLines("BatteryLines");
				}
				
				ScanInfoText("Scanner_Battery", 2, -1, afTimeStep, ImGui_NrmPosGroup(0.8, 0.65, 5), ImGui_NrmSize(0.2, 0.35));
			}
			
			///////////////////////////
			// Draw gel stuff
			else if (lScanState == eScannerState_Gel)
			{
				ScanBodyPartHighlight("body", vBaseImgSize);
				if (ScanPopUpImg("gel", cImGuiGfx("xray_gel_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.8, 0.1, 1), 0.2))
				{
					ScanInfoLines_AddNrmVertex(cVector2f(0.8, 0.225));
					ScanInfoLines_AddNrmVertex(cVector2f(0.725, 0.225));
					ScanInfoLines("GelLines");
				}
				
				ScanInfoText("Scanner_Gel", 2, -1, afTimeStep, ImGui_NrmPosGroup(0.8, 0.35, 5), ImGui_NrmSize(0.2, 0.35));
			}
			
			///////////////////////////
			// Draw flesh stuff
			else if (lScanState == eScannerState_Flesh)
			{
				ScanBodyPartHighlight("body", vBaseImgSize);
				if (ScanPopUpImg("flesh", cImGuiGfx("xray_flesh_01.dds", eImGuiGfx_TextureAnimated), cVector3f(0.8, 0.35, 1.5), 0.2))
				{
					ScanInfoLines_AddNrmVertex(cVector2f(0.8, 0.475));
					ScanInfoLines_AddNrmVertex(cVector2f(0.74, 0.475));
					ScanInfoLines("FleshLines");
				}
				
				ScanInfoText("Scanner_Flesh", 2, -1, afTimeStep, ImGui_NrmPosGroup(0.8, 0.6, 5), ImGui_NrmSize(0.2, 0.35));
			}
				
			////////////////////////////
			// Reed info
			if (lScanState >= eScannerState_ShowReed)
			{
				ScanPopUpImg("reed", cImGuiGfx("xray_reed"), cVector3f(0.3, 0.3, 5.1), 0.2);
				ScanInfoText("Scanner_Reed", 0, -1, afTimeStep, ImGui_NrmPosGroup(-0.1, 0.65, 5)+cVector3f_Right*vBaseImgSize.x, ImGui_NrmSize(0.2, 0.35), 0.05);
			}
			
			ImGui_DoImage(xRaySide, 0, vBaseImgSize*xRayFront.mvUVMax);
			ImGui_DoImage(xRayFront, cVector3f(vBaseImgSize.x, 0, 0)/*+ImGui_NrmPosGroup(0, 0, 0)*/, vBaseImgSize*xRayFront.mvUVMax);
			ImGui_SetModRotateAngle(180);
			ImGui_SetModColorMul(gStationGuiColor_Normal*0.5);
			cVector2f vProgressSize = ImGui_NrmSizeGroup(0, 0.0125);
			vProgressSize.x = vBaseImgSize.x*2.0f*(mfScanningProgress-mfImageDisplay)*10.f;
			ImGui_DoImage(cImGuiGfx(""), ImGui_NrmPosGroup(0, xRayFront.mvUVMax.y, 1), vProgressSize);
			ImGui_SetModColorMul(cColor_White);
			ImGui_SetModRotateAngle(0);
			
			////////////////////////////
			// Grid
			ImGui_GroupBegin(cVector3f(0, 0, 3), ImGui_NrmSize(0.825, 1));
			cVector2f vGridImageSize = ImGui_GetRatioCorrectSizeByNrmHeight(xRayGrid, 0.0875);
			float fWidth = 10;
			float fHeight = 10;
			for (int x = 0; x < fWidth; x++)
			{
				float fXPos = x*(1.0/fWidth);
				for (int y = 0; y < fHeight; y++)
				{
					ImGui_DoImage(xRayGrid, ImGui_NrmPosGroup(fXPos, y*(1.0/fHeight), 0), vGridImageSize);
				}
			}
			ImGui_GroupEnd();
		}
		
		//-------------------------------------------------------
		
		void ScanBodyPartHighlight(const tString &in asGfxSuffix, const cVector2f vImgSize)
		{
			cImGuiGfx xRayFront = cImGuiGfx("xray_front_"+asGfxSuffix, eImGuiGfx_Texture);
			cImGuiGfx xRaySide = cImGuiGfx("xray_side_"+asGfxSuffix, eImGuiGfx_Texture);
			ImGui_SetModColorMul(cColor_White * ImGui_FadeOscillateFloat("BodyPartColor", 0.75, 1, 0.5));
			ImGui_DoImage(xRaySide, cVector3f(0, 0, 2), vImgSize);
			ImGui_DoImage(xRayFront,cVector3f(vImgSize.x, 0, 2), vImgSize);
			ImGui_SetModColorMul(cColor_White);
		}
		
		//-------------------------------------------------------
		
		bool ScanPopUpImg(const tString &in asName, cImGuiGfx &in aGfx, const cVector3f &in avImgNrmPos, float afImgNrmWidth)
		{
			aGfx.mfAnimationTime = 0.125;
			aGfx.mbCrossfadeAnimation = true;
			
			const float fBorderSize = 4;
			ImGui_FadeStateFloat(asName+"_ZoomFade", 1, 0.5, eEasing_QuadInOut, false);
			float fFadeIn = ImGui_GetStateFloat(asName+"_ZoomFade", 0);
			
			cVector3f vPos = ImGui_NrmPosGroup(avImgNrmPos);
			cVector2f vSize = ImGui_GetRatioCorrectSizeByNrmWidth(aGfx, afImgNrmWidth);
			
			if (fFadeIn < 0.99) ImGui_SetModColorMul(cColor(0, 1));
			else 
			{
				ImGui_FadeStateFloat(asName+"_alpha", 1, 0.2, eEasing_QuadInOut, false);
				ImGui_SetModColorMul(cColor(ImGui_GetStateFloat(asName+"_alpha", 0), 1));
			}
				
			ImGui_DoImage(fFadeIn >= 0.99 ? aGfx : cImGuiGfx(""), vPos+cVector3f(fBorderSize, fBorderSize, 0.01), (vSize-cVector2f(fBorderSize*2.0f))*fFadeIn);
			
			ImGui_SetModColorMul(gStationGuiColor_Normal);
			ImGui_DoImage(cImGuiGfx(""), vPos, vSize*fFadeIn);
			ImGui_SetModColorMul(cColor_White);
			
			return fFadeIn > 0.99;
		}
		
		//-------------------------------------------------------
		
		void ScanInfoText(const tString &in asEntry, float afStartTime, float afEndTime, float afDeltaTime, const cVector3f &in vPos, const cVector2f &in vSize, float afFontSize = 0.03)
		{
			if (afEndTime > 0)
			{
				ImGui_IncStateFloat(asEntry+"_End", afDeltaTime);
				if (ImGui_GetStateFloat(asEntry+"_End", 0) > afEndTime)
					return;
			}
			
			cImGuiTextFrameData text = PathOS_CreateDefaultTextFrameData();
			text.mFont.mvSize = ImGui_NrmSizeKeepRatio(afFontSize);
				
			tWString sText = ImGui_Translate(asEntry);
			
			ImGui_IncStateFloat(asEntry+"_Delay", afDeltaTime);
			bool bDelayOver = ImGui_GetStateFloat(asEntry+"_Delay", 0) > afStartTime;
			
			if (bDelayOver)
				ImGui_FadeStateFloat(asEntry+"_Progress", sText.length()+0.1, sText.length()*0.05, eEasing_Linear, false);
			
			float fProgress = ImGui_GetStateFloat(asEntry+"_Progress", 0);
			int lSize = int(fProgress);
			
			bool bAddCaret = (lSize != sText.length()) && (bDelayOver || ImGui_FadeOscillateFloat("LineBlink", 0, 1, 0.5, eEasing_Linear) > 0.5f);
			
			sText.resize(lSize);
			
			if (bAddCaret)
				sText += "_";
				
			ImGui_SetTextOverride(sText);
			ImGui_DoTextFrameExt("", 10, 0, 0, text, vPos, vSize);
			ImGui_ClearTextOverride();
		}
		
		//-------------------------------------------------------
		
		array<cVector2f> mvScanInfoLines;
		
		void ScanInfoLines_AddNrmVertex(const cVector2f &in avVertex)
		{
			mvScanInfoLines.push_back(avVertex);
		}
		
		void ScanInfoLines(const tString &in asName)
		{
			ImGui_FadeStateFloat(asName, 1, 0.5, eEasing_QuadInOut, false);
			float fLines = ImGui_GetStateFloat(asName);
			float fDiv = 1.0f/float(mvScanInfoLines.length()-1);
			
			ImGui_AddLineStripNrmVertex(mvScanInfoLines[0]);
			for (int i = 1; i < mvScanInfoLines.length(); i++)
			{
				if (fLines < fDiv*(i-1))
					break;
					
				float fFraction = (fLines-fDiv*(i-1))/fDiv;
				fFraction = cMath_Clamp(fFraction, 0.01, 1.f);
				
				ImGui_AddLineStripNrmVertex(mvScanInfoLines[i-1] + (mvScanInfoLines[i] - mvScanInfoLines[i-1])*fFraction);
			}
			
			ImGui_DrawAndClearLineStrip(2, 2.5, gStationGuiColor_Normal);
			
			mvScanInfoLines.resize(0);
		}
		
