		//-------------------------------------------------------
		
		int mlCurrentProjector = 1;
		
		//-------------------------------------------------------
		
		void SetupProjectors()
		{
			Entity_SetActive("Projector_1",true);
			Entity_SetActive("Projector_2",false);
			Entity_SetActive("Projector_3",false);
			Entity_SetActive("Projector_4",false);
			Lamp_SetLit("Projector_1",true,false);
			Lamp_SetLit("Projector_2",false,false);
			Lamp_SetLit("Projector_3",false,false);
			Lamp_SetLit("Projector_4",false,false);
			
			Map_AddTimer("ProjectorLoop", 1.0f, "Timer_ProjectorLoop");
		}
		
		void Timer_ProjectorLoop(const tString&in asTimer)
		{
			cLux_AddTodoMessage("Sound: Switch Projector sound!");
			
			Entity_SetActive("Projector_"+mlCurrentProjector,false);
			Lamp_SetLit("Projector_"+mlCurrentProjector,false,false);
						
			mlCurrentProjector++;
			if(mlCurrentProjector>4) mlCurrentProjector=1;
			
			Entity_SetActive("Projector_"+mlCurrentProjector,true);
			Lamp_SetLit("Projector_"+mlCurrentProjector,true,false);
			
			Map_AddTimer("ProjectorLoop", 5.0f, "Timer_ProjectorLoop");
		}
		
		//-------------------------------------------------------
		
		//} END Lecture Room Slideshow
		
		///////////////////////////////////////////////////
		// Event: Doctors Audio Log
		//{////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		void Doctor_Log_OnConnectionStateChange(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				cLux_AddDebugMessage("Starting audio log");
				//Voice_SetSource("Masters",asEntity,0,12,true,12);
				Voice_Play("3_DoctorAudioLog");
				Sound_CreateAtEntity("DrTapeStart", "Entities_Station/object/tape_recorder/start", asEntity);
				Sound_CreateAtEntity("DrTapeLoop", "Entities_Station/object/tape_recorder/loop", asEntity);
				
				//Set interaction disbaled for 1 second to stop from sound spamming
				Entity_SetInteractionDisabled("Doctor_Log", true);
				Map_AddTimer("ReEnableTapePlayerInteraction", 1.f, "Timer_TapePlayerInteractionEnable");
			}
			
			if (alState == -1)
			{
				cLux_AddDebugMessage("Stopping audio log");
				Voice_Stop("DataMining");
				
				Sound_Stop("DrTapeLoop", 0.05f);
				Sound_Stop("DrTapeStart", 0.05f);
				Sound_CreateAtEntity("DrTapeStop", "Entities_Station/object/tape_recorder/stop", asEntity);
				Sound_CreateAtEntity("DrTapeLoopEnd", "Entities_Station/object/tape_recorder/loop_end", asEntity);
				
				//Set interaction disbaled for 0.5 seconds to stop from sound spamming
				Entity_SetInteractionDisabled("Doctor_Log", true);
				Map_AddTimer("ReEnableTapePlayerInteraction", 0.5f, "Timer_TapePlayerInteractionEnable");
			}
		}
		
		void Timer_TapePlayerInteractionEnable(const tString &in asTimer)
		{
			Entity_SetInteractionDisabled("Doctor_Log", false);
		}
	
