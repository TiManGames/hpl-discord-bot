		//-------------------------------------------------------
		
		void SetupCatherine()
		{
			Tool_PickUp("CathTool", false, false);
		}
		
		bool mbLightsOut = false;
		
		void SetLevelLights(bool abOn)
		{
			cLux_AddTodoMessage("SOUND: Clunk as the lights go off please!");
			Sound_PlayGui("02_06_theta_tunnels/sweeteners/lights_out",1.0f);
			
			Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
			
			mbLightsOut = true;
			
			//////////////////////////////////////
			// Lights out!
			cLux_AddDebugMessage("Lights toggled");
			Lamp_SetLit("fluorescent_tube_curved_special_*",abOn,true);
			Lamp_SetLit("door_lamp_*",abOn,true);
			Lamp_SetLit("theta_wall_small_1",abOn,true);
			/*Light_SetVisible("PointLight_35",abOn);
			Light_SetVisible("PointLight_36",abOn);
			Light_SetVisible("SpotLight_26",abOn);*/
			
			//Remove ventilation and distant coral spot triggers
			Entity_SetActive("Area_MindCoralSounds_*", false);
			Entity_SetActive("Area_CoralSoundsArea_*", false);
			Map_RemoveTimer("ResetCoralSoundAreas");
			
			//////////////////////////////////
			//Remove music areas for events no longer needed
			Entity_SetActive("Area_EmptyBedMusicTrigger", false);
			Entity_SetActive("Area_EmptyBedMusicTrigger_1", false);
			
			Light_SetVisible("corridor_amb_*",abOn);
			Billboard_SetVisible("corridor_billboard_*",abOn);
			
			float fBright = 0.007f;
			if (abOn == false) fBright = 0.0f;
			
			Light_SetBrightness("BoxLight_8",fBright);
		}
		
		//-------------------------------------------------------
		
		// Temporarily disable control panels while door is opening
		void SlidingDoorLock(const tString &in asEntity, int alState)
		{			
			///////////////////////////////////////////////////////////////
			// Get wildcard (each door uses similarly named control panels)
			tString sLastChar = cString_GetLastChar(asEntity);
			tString sEntity = cString_ReplaceCharTo(asEntity,sLastChar,"*");
			
			Entity_SetInteractionDisabled(sEntity,true);	
			Map_AddTimer(sEntity,0.25,"SlidingDoorUnlock");
		}

		//-------------------------------------------------------
		
		//////////////////////////////////
		// Re-enable disabled door panels
		void SlidingDoorUnlock(const tString &in asTimer) 
		{
			Entity_SetInteractionDisabled(asTimer,false);
		}
		
		
		//-------------------------------------------------------
		
		//Turns off office sparks when player is not in Brandon office to stop sound leak
		bool Trigger_OfficeSpark(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				//Light_SetVisible("sleved_open_animated01_1_big", true);
				cLux_AddDebugMessage("Turn on office spark");
				Light_SetFlickerActive("sleved_open_animated01_1_big", true);
				Sound_Play("sleved_open_animated01_1_spark", 1.0f);
			}
			return true;
		}
		
		bool Trigger_OfficeSparkOff(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("Turn off office spark");
			Light_SetFlickerActive("sleved_open_animated01_1_big", false);
			Sound_Stop("sleved_open_animated01_1_spark", 1.0f);
			Light_SetVisible("sleved_open_animated01_1_big", false);
			return true;
		}
		
