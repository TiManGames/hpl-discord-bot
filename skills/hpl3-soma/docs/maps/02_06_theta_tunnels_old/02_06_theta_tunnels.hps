		void OnGuiReadableWhiteboard(float afTimeStep, float afAlpha)
		{
			cVector3f vPos;
			vPos.x = -cLux_GetHudVirtualOffset().x;
			vPos.y = -cLux_GetHudVirtualOffset().y;
			
			ImGui_GroupBegin(vPos, ImGui_GetSize());
			
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			ImGui_DrawReadableLabel("WhiteboardARK_Step1",
				ImGui_NrmPosGroup(cVector3f(0.37f, 0.3f, 1)), 
				ImGui_NrmSizeGroup(cVector2f(0.3f,0.075f)), 
				afAlpha);
				
			ImGui_DrawReadableLabel("WhiteboardARK_Step2",
				ImGui_NrmPosGroup(cVector3f(0.70f, 0.27f, 1)), 
				ImGui_NrmSizeGroup(cVector2f(0.3f,0.075f)), 
				afAlpha);
				
			ImGui_DrawReadableLabel("WhiteboardARK_Step3",
				ImGui_NrmPosGroup(cVector3f(0.72f, 0.6f, 1)), 
				ImGui_NrmSizeGroup(cVector2f(0.3f,0.075f)), 
				afAlpha);
				
			ImGui_DrawReadableLabel("WhiteboardARK_Step4",
				ImGui_NrmPosGroup(cVector3f(0.53f, 0.68f, 1)), 
				ImGui_NrmSizeGroup(cVector2f(0.3f,0.075f)), 
				afAlpha);

			ImGui_DrawReadableLabel("WhiteboardARK_Lift",
				ImGui_NrmPosGroup(cVector3f(0.63f, 0.15f, 1)), 
				ImGui_NrmSizeGroup(cVector2f(0.3f,0.075f)), 
				afAlpha);

			ImGui_ResetModifiers();
			
			ImGui_GroupEnd();
		}
		
