		//////////////////////////////////////////
		// Terminal: Elevator OutSide
		//{///////////////////////////////////////
		
		//-------------------------------------------------------
		
		void Elevator_Terminal_OnGui(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			/////////////////////////////////
			// Backdrop
			StationGuiBG_Scanlines();
			StationGuiBG_BackdropV2();
			
			if (mbUnformattedChipInPanel)
				StationGui_BigStatusMessage("ChipCorrupt", gStationGuiColor_Warning, 0.825);
			else if (mbPanelChipReplaced)
				StationGui_BigStatusMessage("ChipSuccess", gStationGuiColor_Highlight, 0.9);
			else
				StationGui_BigStatusMessage("ChipEmpty");
		}
		
		//-------------------------------------------------------
		
		void RenderKeypadSerial(const tString &in asEntityName, float afTimeStep)
		{
			ImGui_SetTransCategory("02_06_theta_tunnels");
			
			//////////////////////////////
			// Window data
			cImGuiWindowData window = PathOS_CreateDefaultWindowData();
			window.mColorBase = gStationGuiColor_Normal;
			
			////////////////////////////
			// Text
			cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
			textData.mbUseBackgroundGfx = false;
			textData.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.1125);
			textData.mFontAlign = eFontAlign_Center;
			
			/////////////////////////////////
			// Backdrop
			StationGuiBG_Scanlines();

			tString sName = Entity_GetVarString(asEntityName, "");
			
			ImGui_DoWindowStart("", window, ImGui_NrmPosGroup(cVector3f(0.1,0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.8, 0.8)));
				cVector2f vSize = ImGui_NrmSizeGroup(1);
				vSize.y = ImGui_GetStateFloat(sName+"_Height", 0);
				float fOverflow = ImGui_DoTextFrameExt(sName, ImGui_NrmSizeGroup(cVector2f(0, 0.0)), 0, 0, textData, ImGui_NrmPosGroup(0.0, 0.45, 1)-cVector3f_Up*vSize.y*0.5f, vSize);
			ImGui_DoWindowEnd();

			// Hack to make text appear at the center of the screen
			if (fOverflow > 0)
			{
				ImGui_SetStateFloat(sName+"_Height", textData.mFont.mvSize.y*fOverflow);
			}
		}

		//-------------------------------------------------------
		
		//} END Elevator Outside

		//////////////////////////////////////////
		// Termianal: Elevator Inside
		//{///////////////////////////////////////

		//-------------------------------------------------------
		
		void Elevator_InsideTerminal_OnGui(const tString&in asEntityName, float afTimeStep)
		{
			/////////////////
			// Data
			cImGuiButtonData button = ImGui_GetDefaultButton();
			button.mGfxBackground = cImGuiGfx("");
			button.mbUseInFocusGfx = false;
			button.mbUseTriggeredGfx = false;
			button.mbUseInFocusColor = true;
			button.mbUseTriggeredColor = true;
			button.mColorInFocus = cColor_White*1.3;
			button.mColorTriggered = cColor_White*1.3;
			ImGui_SetDefaultButton(button);
			
			cImGuiLabelData label = ImGui_GetDefaultLabel();
			label.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.06);
			label.mFontAlign = eFontAlign_Center;
			ImGui_SetDefaultLabel(label);
			
			/////////////////
			// Default look
			StationGuiBG_Scanlines();
			StationGuiBG_Backdrop();
			
			bool bPrevFloorSelected = (ImGui_GetStateInt("FloorSelected_0", 0)==1 || ImGui_GetStateInt("FloorSelected_1", 0)==1);
			bool bFloorSelected = bPrevFloorSelected;
			
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0,0.1, 1)), ImGui_NrmSizeGroup(cVector2f(1, 0.825)));
			
				ImGui_SetTransCategory("");	
				///////////////////////////////
				// ELEVATOR BUTTONS
				if (DoElevatorButton(2, cColor(0.8, 0.4, 0, 1), "LABORATORY", false))
				{
					cLux_AddTodoMessage("Sound: Error sound, elevator already on this floor.");
					Sound_CreateAtEntity("Elevator error","Entities_Station/doors/slidedoor_normal/button_signal_error",asEntityName,0,false);
				}
				if (DoElevatorButton(1, cColor(0.8, 0, 0, 1), "MAINTENANCE", true))
				{
					ImGui_SetStateInt("FloorSelected_1", 1);
					bFloorSelected = true;
				}		
				if (DoElevatorButton(0, cColor(0.125, 0.75, 0.125, 1), "TRANSPORT ST.", true))
				{
					ImGui_SetStateInt("FloorSelected_0", 1);
					bFloorSelected = true;
				}	
				
				///////////////////////////////
				// CHECK FOR FLOOR CHANGE
				if (bFloorSelected && bPrevFloorSelected==false)
				{				
					Player_ChangeStateToNormal();
					Entity_SetInteractionDisabled(asEntityName, true);
					
					HandleElevatorClosing();
				}
				
				ImGui_SetModUseInput(true);
			
			ImGui_GroupEnd();
		}

		//-------------------------------------------------------
		
		bool DoElevatorButton(int lFloor, const cColor &in aCol, const tString&in asText, bool abToggle)
		{
			cImGuiLabelData labelBig = ImGui_GetDefaultLabel();
			labelBig.mFont.mvSize = ImGui_NrmSizeKeepRatio(0.2);
			labelBig.mFontAlign = eFontAlign_Left;
			
			ImGui_GroupBegin(ImGui_NrmPosGroup(cVector3f(0,0.66-lFloor*0.33, 1)), ImGui_NrmSizeGroup(cVector2f(1, 0.32)));
				ImGui_SetModColorMul(aCol);
				
				bool bFloorSelected;
				if (abToggle) 
					bFloorSelected = ImGui_DoToggleButton("FloorButton_"+lFloor, "", false, ImGui_NrmPosGroup(cVector3f(0,0, 0.5)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
				else
					bFloorSelected = ImGui_DoButton("FloorButton_"+lFloor, "", ImGui_NrmPosGroup(cVector3f(0,0, 0.5)), ImGui_NrmSizeGroup(cVector2f(1, 1)));
				
				ImGui_SetModColorMul(cColor_White);
				ImGui_DoLabel(asText, ImGui_NrmPosGroup(cVector3f(0.25,0.35, 0.75)), ImGui_NrmSizeGroup(cVector2f(0.75, 0.3)));
				tString sFloor = ""+lFloor;
				if (lFloor == 0) sFloor = "B";
				ImGui_DoLabelExt(sFloor, labelBig, ImGui_NrmPosGroup(cVector3f(0.075,0.1, 0.8)), ImGui_NrmSizeGroup(cVector2f(0.62, 0.3)));		
			ImGui_GroupEnd();
			
			return bFloorSelected;
		}
		
		//} END Elevator Inside

