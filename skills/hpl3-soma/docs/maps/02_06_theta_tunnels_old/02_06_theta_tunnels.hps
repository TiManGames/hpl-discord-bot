	//----------------------------------------------------------------------
	//{Music
	
	//Event Music
	bool Trigger_LeaveVentMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_Play("02_06_exitvents", 0.55f, false, eMusicPrio_BigEvent);
		return false;
	}
	
	//----------------------------------------------------------------------
	bool mbEmptyBedMusicPlayed = false;
	
	bool Trigger_EmptyBedMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbEmptyBedMusicPlayed==false)
		{
			Music_Stop(1.0f, eMusicPrio_BgAmb);
			mbAmbientMusicPlaying = false;
			Music_FadeVolumeMul(1.0f, 2.0f);
			Map_AddTimer("EmptyBedMusic", 1.0f, "EmptyBedMusicStart");
			mbEmptyBedMusicPlayed = true;
		}
		return false;
	}
	
	void EmptyBedMusicStart(const tString &in asTimer)
	{
		Music_Play("02_06_emptybed", 0.35f, false, eMusicPrio_BigEvent);
		Map_AddTimer("StartAmbient", 11.f, "AmbientMusicHandler");
	}
	
	//----------------------------------------------------------------------
	
	//Ambient Music
	bool mbAmbientMusicPlaying = false;

	void AmbientMusicHandler(const tString &in asTimer)
	{
		if (asTimer=="StartAmbient" && mbAmbientMusicPlaying==false && mbLightsOut==false)
		{
			cLux_AddDebugMessage("First stage ambient music triggering");
			Music_PlayExt("02_06_ambient", true, 0.35f, 1.0f, 0.0f, 0.0f, eMusicPrio_BgAmb, true);
			//Music_FadeVolumeMul(1.0f, 3.0f);
			mbAmbientMusicPlaying = true;
			
			//Dynamic fades
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(8.f,12.f), "AmbientMusicFade");
			Map_AddTimer("FadeOut", cMath_RandRectf(35.f,65.f), "AmbientMusicFade");
		}
		
		//Fade Music back up
		else if (asTimer=="AmbientMusicFadeBackIn" && mbAmbientMusicPlaying==true)
		{
			//Music_FadeVolumeMul(1.0f, cMath_RandRectf(12.f,15.f));
			Map_AddTimer("FadeOut", cMath_RandRectf(35.f,65.f), "AmbientMusicFade");
		}
		else if (asTimer=="StopAmbientMusic" && mbAmbientMusicPlaying==true)
		{
			Music_Stop(4.5f, eMusicPrio_BgAmb);
			Map_RemoveTimer("RandomFadeRider");
			Map_RemoveTimer("FadeOut");
			//Music_FadeVolumeMul(1.0f,1.0f);
			mbAmbientMusicPlaying = false;
		}
	}
	
	void AmbientMusicFade(const tString &in asTimer)
	{
		if(asTimer=="FadeOut")
		{	
			Map_RemoveTimer("RandomFadeRider");
			cLux_AddDebugMessage("Ambient Music Fading Out");
			//Music_FadeVolumeMul(0.0f, cMath_RandRectf(12.0f,15.0f));
			Map_AddTimer("AmbientMusicFadeBackIn", cMath_RandRectf(25.f,45.f), "AmbientMusicHandler");
		}
		if(asTimer=="RandomFadeRider")
		{
			cLux_AddDebugMessage("Ambient Music Fading");
			Map_AddTimer("RandomFadeRider", cMath_RandRectf(10.f,15.f), "AmbientMusicFade");
			//Music_FadeVolumeMul(cMath_RandRectf(0.65f, 1.2f), cMath_RandRectf(5.0f,8.0f));
		}
	}
	
	//---------------------------------------------------------------------
	
	bool Trigger_HallwayDroneMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_Play("02_06_hallwaydrone", 0.45f, true, eMusicPrio_BgAmb);
		return false;
	}
	//} END Music
		
	//--------------------------------------------
	//Akers end attack
	bool mbEndAkersAudioPrepared = false;
	bool Audio_AkersAttackPrepare(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbEndAkersAudioPrepared==false)
		{	
			cLux_AddDebugMessage("Audio prep");
			cSound_FadeLowPassFilter(800.00, 0.0f, 5.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(0.65f, 3.0f, eSoundEntryType_WorldAll);
			//Music_FadeVolumeMul(1.35, 3.0f);
			mbEndAkersAudioPrepared = true;
		}
		return true;
	}
	
	bool Audio_AkersAttackReset(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(mbEndAkersAudioPrepared==true)
		{
			cLux_AddDebugMessage("Reset audio prep");
			cSound_FadeLowPassFilter(22000.00, 0.0f, 5.0f, eSoundEntryType_World);
			Sound_FadeGlobalVolume(1.0f, 3.0f, eSoundEntryType_WorldAll);
			//Music_FadeVolumeMul(1.0, 3.0f);
			mbEndAkersAudioPrepared = false;
		}
		return true;
	}
	
	bool Audio_AkersAttackPrepareFinalDuck(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(mbEndAkersAudioPrepared==true)
		{
			cLux_AddDebugMessage("Final audio prep");
			Sound_FadeGlobalVolume(0.25f, 2.0f, eSoundEntryType_WorldAll);
			cSound_FadeLowPassFilter(200.00, 0.0f, 2.0f, eSoundEntryType_World);
		}
		return true;
	}
	
	//--------------------------------------------
	
	//////////////////////////////////////////
	// Mind coral distant sweeteners
	bool CollidePlayCoralSounds(const tString &in asParent, const tString &in asChild, int alState)
	{
		return false; //Interferes with the Puppet, so disabling this for now!
		
		//cLux_AddDebugMessage("parent: " + asParent + " chld: " + asChild);
		if (alState != 1) return true;
		
		////////////////////////////////////
		// Play coral sounds when player goes in to certain areas
		cLux_AddTodoMessage("SOUND: Bank of sounds for creepy coral creature lurking in vents/distance");
		
		tString sTargetArea = Entity_GetVarString(asChild,"");
		Sound_CreateAtEntity("coral_"+sTargetArea,"02_06_theta_tunnels/sfx/distant_coral_movement",sTargetArea,0.0f,false,1.f);
		
		//Disable both sets of sound triggers to stop from spam
		Entity_SetActive("Area_MindCoralSounds_*", false);
		Entity_SetActive("Area_CoralSoundsArea_*", false);
			
		//Reenable areas after random time
		Map_AddTimer("ResetCoralSoundAreas", cMath_RandRectf(35.0f, 55.0f), "MindCoralSoundTriggerEnable");
		
		//Add some fear breathing
		Map_AddTimer("CoralSoundFearBreathing", cMath_RandRectf(3.0f, 5.0f), "CoralSoundFearBreathing");
		Map_AddTimer("StopAmbientMusic", 1.0f, "AmbientMusicHandler");
		Map_AddTimer("StartAmbient", cMath_RandRectf(8.f,12.f), "AmbientMusicHandler");
		
		return false;
	}
	
	//-------------------------------------------------------

	//////////////////////////////////////////
	// Mind coral crawling sounds from vents etc
	tString msCoralSoundArea = "";
	bool MindCoralSoundTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
		{
			cLux_AddDebugMessage("Coral vent sound triggered @ " + asChild);
			msCoralSoundArea = Entity_GetVarString(asChild,"");
			Sound_CreateAtEntity("mindcoral_crawling","02_06_theta_tunnels/sfx/vent_sweetener",msCoralSoundArea,0,false,1.0);
			
			//Disable both sets of sound triggers to stop from spam
			Entity_SetActive("Area_MindCoralSounds_*", false);
			Entity_SetActive("Area_CoralSoundsArea_*", false);
			
			//Reenable areas after random time
			Map_AddTimer("ResetCoralSoundAreas", cMath_RandRectf(35.0f, 55.0f), "MindCoralSoundTriggerEnable");
			
			//Add some fear breathing
			Map_AddTimer("CoralSoundFearBreathing", cMath_RandRectf(3.0f, 5.0f), "CoralSoundFearBreathing");
		}
		return true;
	}
	
	void MindCoralSoundTriggerEnable(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Coral sound triggers reenabled");
		Entity_SetActive("Area_MindCoralSounds_*", true);
		Entity_SetActive("Area_CoralSoundsArea_*", true);
	}
	
	void CoralSoundFearBreathing (const tString &in asTimer)
	{
		Depth_Audio_Fear_LowIntensity();
	}
	
