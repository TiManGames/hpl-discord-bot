		//-------------------------------------------------------

		bool mbARKCableConnected = false;

		//-------------------------------------------------------
		
		void SetupArkRoom()
		{
		}

		//-------------------------------------------------------

		bool StickyArea_ARKCable_Attach(const tString &in asStickyArea, const tString &in asBodyName)
		{
			
			Sound_CreateAtEntity("sound_plugin","Entities_Station/tech/plug/electric_cable_plug",asStickyArea,0,false,1.0);
			mbARKCableConnected = true;
			
			if (CathTool_IsInserted("CathTool"))
			{
				Map_AddTimer("timer_bootARK",1.5f,"TimerBootArk");
				Lamp_SetFlickerActive("ARKTerminalLED_1", true);
				Lamp_SetLit("ARKTerminalLED_2", true, true);
				Lamp_SetLit("ARKTerminalLED_3", true, true);
			}
				
			return true;
		}
		
		//-------------------------------------------------------
		
		void TimerBootArk(const tString &in asTimer)
		{
			cLux_AddDebugMessage("ARK is Booting");
			Sound_CreateAtEntity("Ark_Bootup","02_06_theta_tunnels/sfx/ark_sim_boot","Area_Effect_ArkTerminal",0,false,1.0);
			StationGui_SetActiveApp("ARKTerminal", eSimulationTerminalApp_Boot);
		}
		
		//-------------------------------------------------------
		
		bool OnUseCathTool(const tString &in asTool, const tString &in asEntity)
		{
			if (asEntity == "AirlockButton_North_1")
			{
				CathTool_UseOnPanel(asTool, asEntity);
				return false;
			}
			if (asEntity == "AirlockButton_North_2")
			{
				CathTool_UseOnPanel(asTool, asEntity);
				return false;
			}
			if (asEntity == "Inactive_DoorPanel_AirlockButton_East_1")
			{
				CathTool_UseOnPanel(asTool, asEntity);
				return false;
			}
			if (asEntity == "StartCathSlot")
			{
				CathTool_Insert(asTool, "StartCathSlot");
				CathTool_SetHintsCallback(asTool, "GiveCathHints");
				Terminal_SetGuiActive("CathTerminal", true, 1);
				Entity_SetActive("CathToolArea", false);
				Seq_ArkLabPowerOn("");
				return true;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool mbStartedSim = false;
		bool mbFinishedSim = false;
		bool mbPlayerScanned = false;
		tString GiveCathHints(const tString& in asName)
		{
			if (mbStartedSim==false)
			{
				return "1_CathHint_StartSim";
			}
			
			if (mbFinishedSim==false)
			{
				return "1_CathHint_RunDiagOnDummy";
			}
			
			if (mbKnowsAboutScanner==false)
			{
				return "1_CathHint_FindScanner";
			}
			
			if (mbPlayerScanned==false)
			{
				return "1_CathHint_ScanYourself";
			}
			return "";
		}
		
		//-------------------------------------------------------
		
		//} END Event ARK ROOM
	
		////////////////////////////////////////////////////////////
		// Scene 1 - *Turn on power*
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		cSequenceStatesData mArkLabPowerOnSequence;
			
		void Seq_ArkLabPowerOn(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ArkLabPowerOn", mArkLabPowerOnSequence);
			
			if (Sequence_DoStepAndWait(1))
			{
				Sound_CreateAtEntity("PowerOnArkLab", "02_06_theta_tunnels/sfx/events/ark_room_powerup", "Player");
				
				Dialog_StartConversation("Catherine", "CathTerminal");
				Dialog_Begin();
					Dialog_AddBranch("CathPluggedIn");
						Dialog_AddPause(2);
						Dialog_AddSubject("1_CathPluggedIn_1", "Subject_PluginDialog");
				Dialog_End();
			}
			
			else if (Sequence_DoStepAndPause(1))
			{
				for (int i = 1; Entity_Exists("ArkTestingLamp_"+i); i++)
				{
					float fMinDelay = 0.2*(i-1);
					LightFlickeringLamp("ArkTestingLamp_"+i, fMinDelay, fMinDelay+0.2, 0.5, 1.5);
				}
				
				for (int i = 1; Entity_Exists("ArkLabLampTop_"+i); i++)
				{
					float fMinDelay = 2 + 0.2*(i-1);
					LightFlickeringLamp("ArkLabLampTop_"+i, fMinDelay, fMinDelay+0.2, 0.5, 1.5);
				}
				
				for (int i = 1; Entity_Exists("ArkLabLampLow_"+i); i++)
				{
					float fMinDelay = 4 + 0.4*(i-1);
					LightFlickeringLamp("ArkLabLampLow_"+i, fMinDelay, fMinDelay+0.25, 0.5, 1.5);
				}
				
				Lamp_SetLit("ArkLabDeskLamp", true, true);
				
				Sound_CreateAtEntity("ArkLampSpot", "02_06_theta_tunnels/amb/spots/grid_light", "GridLightSoundSource", 1.0f, true, 1.0f);
				
				Button_SetLocked("AirlockButton_North_1", false, true);
				Button_SetLocked("ScannerDoor_Button", false, true);
				Entity_SetVarString("Scanner_ExtTerminal", "", "Scanner_Outside_Pending");
				
				Terminal_SetGuiActive("ARKTerminal", true, 0.5);
				Lamp_SetLit("ARKTerminalLED_1", true, true);
				Lamp_SetLit("ARKTerminalLED_4", true, true);
				
				Terminal_SetGuiActive("Scanner_ExtTerminal", true);
				
				if (mbARKCableConnected)
				{
					Map_AddTimer("timer_bootARK",1.5f,"TimerBootArk");
					Lamp_SetFlickerActive("ARKTerminalLED_1", true);
					Lamp_SetLit("ARKTerminalLED_2", true, true);
					Lamp_SetLit("ARKTerminalLED_3", true, true);
				}
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Voice_Play("1_CathPluggedIn_2");
				Entity_SetActive("ArkPrototypeLookAt", true);
				CathTool_SetHintsEnabled("CathTool", true);
			}
			
			Sequence_End();
		}
		
