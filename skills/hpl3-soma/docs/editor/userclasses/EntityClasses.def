		<Class Name="Prop_ConstructLure" InheritsFrom="Prop">
			<EditorSetupVars>
				<Var Name="AffectLightsVar" Value="Enabled" />
				<Var Name="AffectParticlesVar" Value="Enabled" />
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="Lure">
					<Var Name="Enabled" Type="Bool" DefaultValue="true" 			Description="The the lure is turned on." />
					<Var Name="AttractDistance" Type="Float" DefaultValue="10" 		Description="How far away it will attract constructs" />
					<Var Name="CanBeInteractedWith" Type="bool" DefaultValue="true" 		Description="If the device is possible to directly interact with" />
					<Var Name="StopAtPathNode" Type="String" DefaultValue="" 		Description="Pathnode where the robot will stop when it should eat on the machine." />
					<Var Name="EatAttachAreas" Type="String" DefaultValue="" 		Description="One or more areas where to attach when eating on the lure." />
					<Var Name="EatTime" Type="Float" DefaultValue="3" 				Description="The time the construct will spend eating. If below <0 then it can never be drained." />
				</Group>
			</InstanceVars>
		</Class>

		<Class Name="Prop_EnergySource" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="EnergySource">
					<Var Name="EnergyAvailable" Type="Float" DefaultValue="-1" 	Description="Energy in this socket to be drained / regained. -1 to use default alue." />
					<Var Name="DrainedCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_Callback" Description="Callback when energy source is completely drained. Syntax: void Func(tString &in EntityName)." />
				</Group>
			</InstanceVars>
		</Class>

		<Class Name="Prop_OmniSlot" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="OmniSlot">
					<Var Name="SlotPositionOffset" Type="Vec3" DefaultValue="0 0 0" Description="Offset from the entity to place the inserted tool at." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="OmniSlot">
					<Var Name="AttachedTool" Type="String" DefaultValue="" Description="Tool that starts out attached to this slot." />
					<Var Name="DetachAllowed" Type="Bool" DefaultValue="false" Description="If the tool inserted can be removed at the start of the level." />
					<Var Name="AttachAllowed" Type="Bool" DefaultValue="true" Description="If attaching a tool is allowed at the start of the level. Only valid if no tool is attached." />
					<Var Name="OnLamp" Type="String" DefaultValue="" Description="Lamp that lets the player know the Omnitool is attached." />
					<Var Name="OffLamp" Type="String" DefaultValue="" Description="Lamp that lets the player know the Omnitool can be detached or attached." />
				</Group>
			</InstanceVars>
		</Class>
		
	</Classes>
</UserClassDefinition>

