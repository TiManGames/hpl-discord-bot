		<Class Name="Agent_Construct_Worker" InheritsFrom="Agent" UsesComponents="CharMover, Listener, Attacker">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="Construct_State">
					<Var Name="IdleMode" Type="Enum" DefaultValue="Normal"	Description="The idle mode of the construct" >
						<EnumValue Name="Normal" />
						<EnumValue Name="HeadPound" />
						<EnumValue Name="Stalk" />
						<EnumValue Name="Scavenge" />
					</Var>
					<Var Name="Mood" Type="Enum" DefaultValue="Docile"	Description="The mood of the construct when player is too close." >
						<EnumValue Name="Docile" />
						<EnumValue Name="Cautious" />
						<EnumValue Name="Agressive" />
					</Var>
					<Var Name="ActiveHunter" Type="Bool" DefaultValue="false"	Description="If on, then it will start hunting the player much earlier and attack faster." />
					<Var Name="LowOnEnergy" Type="Bool" DefaultValue="false"	Description="If the construct does not have much juice left." />
				</Group>
				<Group Name="Construct_Bark">
					<Var Name="VoiceCharacter" Type="String" DefaultValue=""	Description="The name of the voice character." />
					
					<Var Name="IdleSubject" Type="String" DefaultValue=""	Description="The subject played at random when in idle mode" />
					<Var Name="IdleMinMaxTime" Type="Vector2" DefaultValue=""	Description="Min and Max time between the random idle barks." />
					<Var Name="StalkSubject" Type="String" DefaultValue=""	Description="The subject played at random when in stalk mode" />
					<Var Name="StalkMinMaxTime" Type="Vector2" DefaultValue=""	Description="Min and Max time between the random stalk barks." />
					<Var Name="TemptSubject" Type="String" DefaultValue=""	Description="The subject played at random when in temptation mode" />
					<Var Name="TemptMinMaxTime" Type="Vector2" DefaultValue=""	Description="Min and Max time between the random temptation barks." />
					
					<Var Name="StalkFirstStartSubject" Type="String" DefaultValue=""	Description="Played first time stalk starts" />
					<Var Name="StalkStartSubject" Type="String" DefaultValue=""	Description="Played when stalk starts" />
					<Var Name="StalkEndSubject" Type="String" DefaultValue=""	Description="Played when stalk ends" />
					<Var Name="SearchStartSubject" Type="String" DefaultValue=""	Description="Played when a search starts" />
					<Var Name="SearchFoundSubject" Type="String" DefaultValue=""	Description="Played when a search ends with player being found" />
					<Var Name="AlertSubject" Type="String" DefaultValue=""	Description="Played when hearing a sound made by the player." />
					<Var Name="AlertBeforeSeenSubject" Type="String" DefaultValue=""	Description="Played when hearing a sound made by the player before having seen him." />
				</Group>
			</InstanceVars>
		</Class>
		
