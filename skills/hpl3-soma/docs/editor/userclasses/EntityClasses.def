		<Class Name="Prop_Terminal" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Terminal">
					<Var Name="ConnectedSubmesh" Type="String" DefaultValue="" 			Description="Name of the submesh the Gui should be rendered on." />
					<Var Name="ClearColor" Type="Color" DefaultValue="0 0 0 1" 			Description="The normal clear color" />
					<Var Name="ScreenSize" Type="Vector2" DefaultValue="512 512" 			Description="The size (in pixels) of the screen. 1024 is max." />
					
					<Var Name="OfflineClearColor" Type="Color" DefaultValue="0 0 0 1" 			Description="Which color the terminal screen should be when no gui is active" />
					<Var Name="ScreenPosition" Type="Vec3" DefaultValue="0 0 0" 			Description="Local position of the center of the screen." />
					<Var Name="ScreenNormal" Type="Vec3" DefaultValue="0 0 1" 			Description="Normal vector of the screen." />
					<Var Name="TargetCameraDistance" Type="Float" DefaultValue="1" 			Description="The distance from the screen the camera should have when the player is interacting with the terminal." />
				</Group>	
			</TypeVars>
			<InstanceVars>
				<Group Name="Terminal">
					<Var Name="OnGuiFunction" Type="Function" DefaultValue="" ReturnType="void" Params="const tString&amp;in asEntityName, float afTimeStep" Suffix="_OnGui" Description="Callback function where all the drawing of the gui will take place. Syntax. void Func(const tString&amp;in asEntityName, float afTimeStep)" />
					<Var Name="EnterCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString&amp;in asEntityName" Suffix="_GuiEnter" Description="Callback function called when Gui is entered. Syntax. void Func(const tString&amp;in asEntityName)" />
					<Var Name="LeaveCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString&amp;in asEntityName" Suffix="_GuiLeave" Description="Callback function called when Gui is left. Syntax. void Func(const tString&amp;in asEntityName)" />
					<Var Name="ShowMouse" Type="Bool" DefaultValue="true" 			Description="If the mouse should be shown when interacting." />
					<Var Name="AllowInteraction" Type="Bool" DefaultValue="false" 			Description="If the player can interact with this gui." />
					<Var Name="UpdateWhenOutOfView" Type="Bool" DefaultValue="false" 			Description="If the OnGui function should be called when out of view. Better performance if false." />
					<Var Name="GuiActive" Type="Bool" DefaultValue="true" 			Description="If the GUI should start out active." />
					<Var Name="CacheAtScreenSize" Type="Float" DefaultValue="0.05f" Description="Which size the gui has on the screen when a cached version should be used instead. -1 = no cache" />
					<Var Name="PlayerPosEntity" Type="String" DefaultValue="" 		Description="Entity to place player at when using terminal. If left blank, the player position will be automatically calculated based on the terminal screen's position and normal." />
					<Var Name="FPSWhenIdle" Type="Float" DefaultValue="30" 		Description="When the GUI is not in focus (ie not zoomed in on), this is the FPS that it will be updated with. If 0 it will render a single frame and then go to sleep. Max is 30." />
          <Var Name="TerminalColorMul" Type="Color" DefaultValue="1 1 1 1" Description="Color that gets multipled with the submesh that the terminal image is rendered to" />
          <Var Name="TerminalBrightness" Type="Float" DefaultValue="1" Description="Brightness of the terminal submesh" />
          <Var Name="VerticalFOV" Type="Float" DefaultValue="70"  Description="Vertical Field of View to use when interacting with the prop. In degrees" />
        </Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Readable" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Readable_Base">
					<Var Name="OpenEntityFile" Type="String" DefaultValue="" 			Description="Filename of prop to display while reading." />
					<Var Name="DistanceFromCamera" Type="Float" DefaultValue="0.3" 			Description="How far away from the camera the prop should be while reading." />
					<Var Name="YStartOffset" Type="Float" DefaultValue="-0.5" 			Description="How far up (positive) or down (negative) the prop should be placed before moving into position." />
				</Group>
				<Group Name="Readable">
					<Var Name="TextCategory" Type="String" DefaultValue="" 			Description="Category for text contents." />
					<Var Name="FrontTextEntry" Type="String" DefaultValue="" 			Description="Entry for the text displayed when interacting with the front side of the prop." />
					<Var Name="BackTextEntry" Type="String" DefaultValue="" 			Description="Entry for the text displayed when interacting with the back side of the prop." />
					<Var Name="TitleEntry" Type="String" DefaultValue="" 			Description="Entry for title displayed at top of screen while reading." />
				</Group>
				<Group Name="Readable_Sounds">
					<Var Name="OpenSound" Type="String" DefaultValue="" 			Description="Sound played when interaction starts." />
					<Var Name="CloseSound" Type="String" DefaultValue="" 			Description="Sound played when interaction ends." />
					<Var Name="PageTurnSound" Type="String" DefaultValue="" 			Description="Sound played when progressing to next page." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Readable">
					<Var Name="TextCategory" Type="String" DefaultValue="" 	Description="Overrides category set in entity file. Leave blank for default." />
					<Var Name="FrontTextEntry" Type="String" DefaultValue="" 		Description="Overrides entry set in entity file. Leave blank for default." />
					<Var Name="BackTextEntry" Type="String" DefaultValue="" 		Description="Overrides entry set in entity file. Leave blank for default." />
					<Var Name="TitleEntry" Type="String" DefaultValue="" 			Description="Overrides entries set in entity file. Leave blank for default." />
					<Var Name="OpenEntityFile" Type="String" DefaultValue="" 		Description="Overrides prop set in entity file. Leave blank for default." />
					<Var Name="CloseCallback" Type="Function" ReturnType="void"   Params="const tString &amp;in asEntity" Suffix="_OnClose"	Description="Callback when readable is closed by player. Syntax void MyFunc(const tString &in asName)" />
          <Var Name="VerticalFOV" Type="Float" DefaultValue="70"  Description="Vertical Field of View to use when interacting with the prop. In degrees" />
        </Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_HandheldTerminal" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="HandheldTerminal_Base">
					<Var Name="ConnectedSubmesh" Type="String" DefaultValue="" 			Description="Name of the submesh the Gui should be rendered on." />
					<Var Name="ClearColor" Type="Color" DefaultValue="0 0 0 1" 			Description="The normal clear color" />
					<Var Name="ScreenSize" Type="Vector2" DefaultValue="512 512" 			Description="The size (in pixels) of the screen. 1024 is max." />
					<Var Name="OfflineClearColor" Type="Color" DefaultValue="0 0 0 1" 			Description="Which color the terminal screen should be when no gui is active" />
					<Var Name="DistanceFromCamera" Type="Float" DefaultValue="0.3" 			Description="How far away from the camera the prop should be while held." />
					<Var Name="YStartOffset" Type="Float" DefaultValue="-0.5" 			Description="How far up (positive) or down (negative) the prop should be placed before moving into position." />
					<Var Name="HandAnimationSuffix" Type="String" DefaultValue="" 			Description="Hand animation to play when using the terminal. Can be empty." />
					<Var Name="HudEntFile" Type="String" DefaultValue="" 			Description="The entity used for placement and scaling of the entity when picked up. If empty, this file will be used." />
				</Group>
				<Group Name="HandheldTerminal_Sounds">
					<Var Name="PickupSound" Type="String" DefaultValue="" 			Description="Sound played when interaction starts." />
					<Var Name="DropSound" Type="String" DefaultValue="" 			Description="Sound played when interaction ends." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="HandheldTerminal">
					<Var Name="TerminalColorMul" Type="Color" DefaultValue="1 1 1 1" 			Description="Color that gets multipled with the submesh that the terminal image is rendered to" />
					<Var Name="TerminalBrightness" Type="Float" DefaultValue="1" 			Description="Brightness of the terminal submesh." />
					<Var Name="OnGuiFunction" Type="Function" DefaultValue="" ReturnType="void" Params="const tString&amp;in asEntityName, float afTimeStep" Suffix="_OnGui" Description="Callback function where all the drawing of the gui will take place. Syntax. void Func(const tString&amp;in asEntityName, float afTimeStep)" />
					<Var Name="LeaveCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString&amp;in asEntityName" Suffix="_GuiLeave" Description="Callback function called when Gui is left. Syntax. void Func(const tString&amp;in asEntityName)" />
					<Var Name="AllowCancel" Type="Bool" DefaultValue="true"			Description="If false, the right mouse button can't cancel."/>
					<Var Name="ShowMouse" Type="Bool" DefaultValue="true" 			Description="If the mouse should be shown when interacting." />
					<Var Name="LockCamera" Type="Bool" DefaultValue="true" 			Description="Set to false if the player should be allowed to look around while using the terminal." />
					<Var Name="VerticalFOV" Type="Float" DefaultValue="70"  Description="Vertical Field of View to use when interacting with the prop. In degrees" />
					<Var Name="GUIActiveOnTransition" Type="Bool" DefaultValue="false" 			Description="If the GUI should render while the terminal is moving into place." />
					<Var Name="FPSWhenIdle" Type="Float" DefaultValue="30" 		Description="When the GUI is not in focus (ie not zoomed in on), this is the FPS that it will be updated with. If 0 it will render a single frame and then go to sleep. Max is 30." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Tool" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Tool">
					<Var Name="HudObjectEntity" Type="String" DefaultValue="" 			Description="ent file of the hud object." />
					<Var Name="InventoryTextEntry" Type="String" DefaultValue="" 	Description="Text entry to display in players inventory" />
					<Var Name="InventoryIcon" Type="File"  ResType="Texture2D" DefaultValue="" 	Description="Image used in players inventory" />
					<Var Name="HandAnimationSuffix" Type="String"  DefaultValue="generic" 	Description="This gets added on to the player hand animations when chosing one. tool_draw_[suffix], tool_idle_[suffix] and tool_holster_[suffix]" />
					<Var Name="IsHeavy" Type="Bool" DefaultValue="false" 			Description="If true, player's movement is modified while this tool is equipped." />
					<Var Name="CustomUseIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="UseToolAction" Description="Icon shown when the prop can be used on an object." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Tool">
					<Var Name="PickupCallback" Type="Function" ReturnType="bool" Params="const tString &amp;in asTool" Suffix="_OnPickUp"						Description="Callback when tool is picked up. If returns false, pickup does not happen. Syntax bool MyFunc(tString &in asName)" />
					<Var Name="UseCallback" Type="Function" ReturnType="bool" Params="const tString &amp;in asTool, const tString &amp;in asEntity" Suffix="_OnUse" Description="Callback when tool is used. If returns false, normal use is overridden. Syntax bool MyFunc(tString &in asToolName, tString &in asFocusEntity)" />
					<Var Name="DropCallback" Type="Function" ReturnType="bool" Params="const tString &amp;in asTool" Suffix="_OnDrop"							Description="Callback when prop is dropped after usage. If returns false, normal drop behavior is not used. Syntax bool MyFunc(tString &in asName)" />
					<Var Name="CanBeUsedCallback" Type="Function" ReturnType="bool" Params="const tString &amp;in asTool, const tString &amp;in asEntity" Suffix="_CanBeUsed" Description="Callback used to determine if an entity can be used or not depending on return value. Used to change the what crosshair is shown.. Syntax bool MyFunc(tString &in asToolName, tString &in asName)" />
					<Var Name="AutoHideAfterPickup" Type="Bool" DefaultValue="true" Description="If the tool should be hidden after being picked up. It will be displayed for a few seconds then lowered. Uncheck if the tool will be picked up inside the tool area where it should be used." />
					<Var Name="HighlightActive" Type="Bool" DefaultValue="true" Description="If the tool should have the highlight effect when looked at." />
				</Group>
			</InstanceVars>
		</Class>
		
