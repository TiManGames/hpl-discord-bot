		<Class Name="Prop_Infection" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Infection">
					<Var Name="GrowthSound" Type="File"  ResType="Sound" DefaultValue="" 	Description="Sound created when infection grows." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Infection_General">
					<Var Name="DisablePlayerCollision" Type="Bool" DefaultValue="false"	Description="If the infection should have its character collision disabled." />
					<Var Name="DisableParticles" Type="Bool" DefaultValue="false"	Description="If the infection should have its particle systems disabled." />
					<Var Name="DisableGrowthSound" Type="Bool" DefaultValue="false"	Description="If the infection should have its growth sound disabled." />
					<Var Name="GrowthDelay" Type="Float" DefaultValue="0.2"	Description="The time it takes for the entity to start growing after it has been activated by its parent entity." />
					<Var Name="GrowthSpeed" Type="Float" DefaultValue="5"	Description="The speed at which the entity grows. It takes 1/speed seconds to grow to full size." />
					<Var Name="GrowthCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity, bool abStartOfGrowth" 	Suffix="_OnGrowth"  Description="Function called when infection prop starts growing and when it stops. Syntax: void FunctionName(const tString &in asEntity, bool abStartOfGrowth)" />
					<Var Name="ExtraChildren" Type="String" DefaultValue=""	Description="Additional child entities (other than the one next in the path) that should grow after this one. Entire child paths need to be added through script, this is for single entities only." />
				</Group>
			</InstanceVars>
		</Class>
		
