		<Class Name="Agent_Flesher" InheritsFrom="Agent" UsesComponents="CharMover, HeadTracker, Listener, Attacker" >
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="Flesher_State">	
					<Var Name="TeleportChanceModifier" Type="Float" DefaultValue="1"	Description="The larger the bigger chance that it will teleport and lower means lower chance." />
					<Var Name="DistortionEffectMul" Type="Float" DefaultValue="1"	Description="Multiplier for big the distortion effect is." />
					<Var Name="HuntBuildUpTimeMul" Type="Float" DefaultValue="1"	Description="Multiplier for how long it takes for the fleshers goes into hunt mode form the player looking at it." />
					<Var Name="AttackCanBeFatal" Type="Bool" DefaultValue="true"	Description="If an attack can kill the player" />
					<Var Name="HuntOnlyAttackWhenLooking" Type="Bool" DefaultValue="false"	Description="If this is true, then when in hunt mode, the attack meter will only start if the player looks or moves slowly." />
					<Var Name="EdgeGlowAmount" Type="Float" DefaultValue="0"	Description="How much edge glow we want on it." />
				</Group>
				<Group Name="Flesher_Movement">
					<Var Name="PatrolSpeed" Type="Enum" DefaultValue="Walk"	Description="The speed it moves with when patrolling" >
						<EnumValue Name="Walk" />
						<EnumValue Name="FastWalk" />
						<EnumValue Name="Run" />
					</Var>
				</Group>
				<Group Name="Flesher_Bark">
					<Var Name="VoiceCharacter" Type="String" DefaultValue=""	Description="The name of the voice character." />
					
					<Var Name="IdleSubject" Type="String" DefaultValue=""	Description="The subject played at random when in idle mode" />
					<Var Name="IdleMinMaxTime" Type="Vector2" DefaultValue=""	Description="Min and Max time between the random idle barks." />
					<Var Name="SearchSubject" Type="String" DefaultValue=""	Description="The subject played at random when in stalk mode" />
					<Var Name="SearchMinMaxTime" Type="Vector2" DefaultValue=""	Description="Min and Max time between the random stalk barks." />
					<Var Name="HuntSubject" Type="String" DefaultValue=""	Description="The subject played at random when in hunt mode" />
					<Var Name="HuntMinMaxTime" Type="Vector2" DefaultValue=""	Description="Min and Max time between the random hunt barks." />
				</Group>
			</InstanceVars>
		</Class>
		
