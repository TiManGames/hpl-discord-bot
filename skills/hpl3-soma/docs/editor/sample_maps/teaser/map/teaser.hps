	float mfScaleExtraMul = 0.0f;
	float mfScaleExtraMulDest = 1.0f;
	float mfScaleExtraSpeed=1.0f;
	
	void SetBrainScale(float afScaleExtra)
	{
		cMatrixf mtxFinal = m_mtxBaseBrainTransform;
		cMatrixf mtxScale = cMath_MatrixScale(cVector3f(1) + cVector3f(0.3, 0.17, 0.0)*0.15f*afScaleExtra);
		mtxFinal = cMath_MatrixMul(m_mtxBaseBrainTransform, mtxScale);
		
		cLux_GetCurrentMap().GetEntityByName(msCurrentBrainEntity).GetMeshEntity().SetMatrix(mtxFinal);
	}
	
	void Timer_UpdateBrainPulse(const tString&in asTimer)
	{
		////////////////////////////
		// Update the brain
		float fAmount = cLux_GetCurrentMap().GetEntityByName("teaser_brain_pedastal_1").GetMeshEntity().GetIlluminationColor().r;
		
		if(msCurrentBrainEntity=="brain_4")
			SetBrainScale(0);
		else
			SetBrainScale(cMath_SigmoidCurve(fAmount));
		
		Entity_SetEffectBaseColor(msCurrentBrainEntity, cColor(1,1)*fAmount);
		
		////////////////////////////
		// Call timer again
		Map_AddTimer("UpdateBrainPulse", 0.01f, "Timer_UpdateBrainPulse");		
	}
		
	//-------------------------------------------------------
		
	void Timer_BrainPulseOn(const tString&in asTimer)
	{
		Entity_FadeEffectBaseColor("teaser_brain_pedastal_1",cColor(1,1), mfBrainPulseTime);
		Map_AddTimer("PulseOff", mfBrainPulseTime, "Timer_BrainPulseOff");
		
	
		Sound_PlayGui("teaser_heartbeat.snt", mfBrainPulseHeartVol);
	}
	
	void Timer_BrainPulseOff(const tString&in asTimer)
	{
		Entity_FadeEffectBaseColor("teaser_brain_pedastal_1",cColor(0,0), mfBrainPulseTime);
		
		Map_AddTimer("PulseOn", mfBrainPulseTime, "Timer_BrainPulseOn");		
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Scene 2 Event C: Remove brain cover + sanity drains
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	void BrainCover_OnPlayerInteract(const tString &in asEntity)
	{
		Sequence_BrainThaw("");
		//Sequence_BrainReplace("");
		//Sequence_TestTentacles("");
		
		Map_AddTimer("HeartVol", 0.1f, "Timer_IncreaseHeartVol");
		Map_RemoveTimer("HeartVolMinor");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeqBrainThaw;
	void Sequence_BrainThaw(const tString &in asX)
	{
		Sequence_Begin("Sequence_BrainThaw", mSeqBrainThaw);
		
		if (Sequence_DoStepAndWait(0.75f))
		{
		}
		if (Sequence_DoStepAndWait(3.5f))
		{
			Music_Play("01_01_elevator2", 0.35f, false, 0);
			
			Player_FadeRollTo(-3.6f, 0.05, 2);
			Player_FadeFOVMulTo(0.9, 0.02);
		}
		if (Sequence_DoStepAndWait(2))
		{
			Sound_PlayGui("teaser_man_08.ogg", 1.0f);
			
			Effect_ImageTrail_Start(1, 2, 200, 200);
			Player_FadeRollTo(5.6f, 0.25, 2);
			Player_FadeFOVMulTo(1.1, 0.06);
			ParticleSystem_CreateAtEntityExt("ThawSmoke", "smoke_bright_med_slow_loop", "Area_BrainEffects", false,
											cColor(0.7, 0.035) );
											
			Effect_Shake_Start(0.025, 0.5, 0.3, 1, cVector3f(1, 0.1, 0));
		}
		if (Sequence_DoStepAndWait(1))
		{		
			Sound_CreateAtEntity("ear_ring", "teaser_ear_ring.snt","player", 10.0f, true);
		}
		if (Sequence_DoStepAndWait(1))
		{
			Player_FadeRollTo(-10.6f, 0.5, 4);
			Player_FadeFOVMulTo(1.0, 0.03);
		}
		if (Sequence_DoStepAndWait(2))
		{
			Player_FadeRollTo(0, 0.45, 4);
			Effect_Shake_Start(0.1, 0.5, 0.3, 1, cVector3f(1, 0.1, 0));
			
			Music_PlayExt("01_04_wau_trainride", false, 0.8f, 0.9f, 7, 0, 0, false);
		}
		for(int i=1; i<=4; ++i)
		{
			if (Sequence_DoStepAndWait(0.75f - i*0.15f))
			{
				Entity_PlayAnimation("teaser_brain_room_tentacle_01_"+i, "rise", 0.1f, false, true, "AnimOver_TentacleUp");
				
				Map_AddTimer("Area_TentacleEmerge_"+i, 0.25f, "Timer_EmergeEffect");
			}
		}
		if (Sequence_DoStepAndWait(2))
		{
			Effect_Shake_Start(0.17, 0.3, 0.3, 0.7, cVector3f(1, 0.1, 0));
		}
		if (Sequence_DoStepAndWait(0))
		{
			Sequence_BrainReplace("");
		}
		
		Sequence_End();
	}

	
	//-------------------------------------------------------
	
	void AnimOver_TentacleUp(const tString &in asEntityName, const tString &in asAnimName)
	{
		Entity_PlayAnimation(asEntityName, "idle", 0.1f, true);
	}
	
	//-------------------------------------------------------
	
	void Timer_EmergeEffect(const tString&in asArea)
	{
		cLux_AddDebugMessage("PS "+asArea);
		ParticleSystem_CreateAtEntity("Emerge", "emerge_tentacle_sparks_n_smoke.ps",asArea, false);
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeqTestTentacles;
	void Sequence_TestTentacles(const tString &in asX)
	{
		Sequence_Begin("Sequence_TestTentacles", mSeqTestTentacles);
		
		for(int i=1; i<=4; ++i)
		{
			if (Sequence_DoStepAndWait(0.75f - i*0.15f))
			{
				Entity_PlayAnimation("teaser_brain_room_tentacle_01_"+i, "rise", 0.1f, false, true, "AnimOver_TentacleUp");
				
				Map_AddTimer("Area_TentacleEmerge_"+i, 0.25f, "Timer_EmergeEffect");
			}
		}
		if (Sequence_DoStepAndWait(0))
		{
			//Entity_SetActive("TriggerArea_2", true);
			Sequence_BrainReplace("");
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void Timer_IncreaseHeartVol(const tString&in asTimer)
	{
		mfBrainPulseTime *= 0.95f;
		mfBrainPulseHeartVol += 0.2;
		if(mfBrainPulseHeartVol>=1)
		{
			mfBrainPulseHeartVol = 1;
			return;
		}
		
		Map_AddTimer("HeartVol", 2.0f, "Timer_IncreaseHeartVol");		
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Scene 2 Event D: Brains gets replaced.
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	int mlCurrentBrainCount=0;
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeqBrainReplace;
	void Sequence_BrainReplace(const tString &in asX)
	{
		Sequence_Begin("Sequence_BrainReplace", mSeqBrainReplace);
		
		if (Sequence_DoStepAndWait(3))
		{
			mfBrainPulseTime = 0.75;
		}
		if (Sequence_DoStepAndWait(1.75f))
		{
			Entity_PlayAnimation("teaser_brain_room_tentacle_01_1", "stab_1", 0.3f, false, true, "AnimOver_Stab");
			cLux_AddTodoMessage("STAB 1 STARTS");
		}
		if (Sequence_DoStepAndWait(1))
		{
			Entity_SetActive("TriggerArea_2", true);
			
			Player_SetMoveSpeedMul(0.6f);
			
			HurtAndChangeBrainEffect(0.5, 1);
			ReplaceTentacleMaterial(1);
			Player_FadeRollTo(5.6f, 0.15, 4);
			
			cLux_AddTodoMessage("Tentacles #1's stab hits");
			
			mfBrainPulseTime = 0.5;
		}
		if (Sequence_DoStepAndWait(2))
		{
			Sound_PlayGui("teaser_man_09.ogg", 1.0f);
		}
		if (Sequence_DoStepAndWait(1))
		{
			ParticleSystem_CreateAtEntity("Spray", "stab_brain_spray_oneshot.ps", "Area_BrainStab_1", false);
		}
		if (Sequence_DoStepAndWait(2.55))
		{
			Entity_PlayAnimation("teaser_brain_room_tentacle_01_2", "stab_2", 0.3f, false, true, "AnimOver_Stab");
			cLux_AddTodoMessage("STAB 2 STARTS");
		}
		if (Sequence_DoStepAndWait(0.05))
		{
			HurtAndChangeBrainEffect(0.75, 2);
			ReplaceTentacleMaterial(2);
			Player_FadeRollTo(9.6f, 0.15, 4);
			
			Player_SetMoveSpeedMul(0.4f);
			
			cLux_AddTodoMessage("Tentacles #2's stab hits");
			
			mfBrainPulseTime = 0.3;
		}
		if (Sequence_DoStepAndWait(0.25))
		{
			Sound_PlayGui("teaser_man_10.ogg", 1.0f);
					
			Entity_PlayAnimation("teaser_brain_room_tentacle_01_3", "stab_3", 0.3f, false, true, "AnimOver_Stab");
			cLux_AddTodoMessage("STAB 3 STARTS");
		}
		if (Sequence_DoStepAndWait(3.25))
		{
			ParticleSystem_CreateAtEntity("Spray", "stab_brain_spray_oneshot.ps", "Area_BrainStab_2", false);
		}
		if (Sequence_DoStepAndWait(2))
		{
			HurtAndChangeBrainEffect(1, 3);
			ReplaceTentacleMaterial(3);
			Player_FadeRollTo(36.6f, 0.75, 4);
						
			cLux_AddTodoMessage("Tentacles #3's stab hits");
			
			ParticleSystem_Destroy("ThawSmoke");
			
			mfBrainPulseTime = 0.2;
		}
		if (Sequence_DoStepAndWait(1.5f))
		{
			Player_MoveHeadPos(cVector3f(0, -1, 0), 5, 6, 0.3);
			mfBrainPulseTime = 0.3;
		}
		if (Sequence_DoStepAndWait(0.5f))
		{
			ParticleSystem_CreateAtEntity("Spray", "stab_brain_spray_oneshot.ps", "Area_BrainStab_3", false);
		}
		if (Sequence_DoStepAndWait(2))
		{
			Sound_PlayGui("teaser_man_11.ogg", 1.0f);
			
			Sound_Stop("ear_ring", 2);
			
			Effect_Fade_Out(2);
			mfBrainPulseTime = 0.5;
		}
		if (Sequence_DoStepAndWait(3))
		{
			mfBrainPulseTime = 0.75;
			
			ChangeBrain();
			Entity_SetActive("brain_chunk_04*",true);
			
			Entity_PlayAnimation("teaser_brain_room_tentacle_01_*", "wait" );
		}
		if (Sequence_DoStepAndWait(1))
		{
			mfBrainPulseTime = 1.0;
			Effect_Fade_In(4);
			Player_MoveHeadPos(cVector3f(0, -0.5, 0), 2, 6, 0.2);
			Player_FadeRollTo(0, 1.75, 6);
			Player_StartLookAt(msCurrentBrainEntity, 1, 1, 1, "");
		}
		if (Sequence_DoStepAndWait(5))
		{
			Sound_PlayGui("teaser_man_12.ogg", 1.0f);
			
			Player_FadeFOVMulTo(0.65f, 0.21f);
			Player_MoveHeadPos(cVector3f(0, 0.0, 0), 1, 3, 0.1);
		}
		if (Sequence_DoStepAndWait(3))
		{
			Effect_Fade_Out(3);
		}
		if(Sequence_DoStepAndWait(0))
		{
			Sound_PlayGui("teaser_man_13.ogg", 1.0f);
		}
		
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void ReplaceTentacleMaterial(int alNum)
	{
		cMeshEntity @pEntity = cLux_GetCurrentMap().GetEntityByName("teaser_brain_room_tentacle_01_"+alNum).GetMeshEntity();
		
		cMaterial @pMat = cResources_CreateMaterial("tentacle_weapon_bloody.mat");
		
		pEntity.GetSubMeshEntity(0).SetCustomMaterial(pMat, false);
	}
	
	//-------------------------------------------------------
	
	float mfBaseCamPitch;
	float mfTentacleShakeAngle;
	[nosave] cBoneState@[] mvShakeBones;
	cVector3f[] mvBoneRotVec = {cVector3f(1), cVector3f(1)};
	float[] mfBoneRotMul = {0.75f, 0.25f};
	tString[] vBoneNames = {"locator190Node", "locator186Node"};
	int mlNumOfShakeBones=2;
		
	void Tentacle_Grab(const tString &in asEntity)
	{
		Entity_SetActive("TriggerArea_2", false);
		Entity_PlayAnimation("teaser_brain_room_tentacle_01_4", "attack_player_1", 0.2f, false, true, "AnimOver_Stab");
		
		mvShakeBones.resize(2);
		
		cMeshEntity @ pEnt = cLux_GetCurrentMap().GetEntityByName("teaser_brain_room_tentacle_01_4").GetMeshEntity();
		
		for(int i=0; i<mlNumOfShakeBones; ++i)
		{
			@mvShakeBones[i]  = pEnt.GetBoneStateFromName(vBoneNames[i]);
			
			cMatrixf mtxInvWorldBone = cMath_MatrixInverse(mvShakeBones[i].GetWorldMatrix());
			mvBoneRotVec[i] = cMath_Vector3Normalize(cMath_MatrixMul(mtxInvWorldBone, cVector3f(1,0.3f,0))); //Make sure to normalize since matrix might have scale!
		}
			
		mfBaseCamPitch = cLux_GetPlayer().GetCamera().GetPitch();
				
		Map_AddTimer("ShakeTentacleLogic", 0.01, "Timer_ShakeTentacleLogic");
		Map_AddTimer("ShakeTentacleOver", 1.75, "Timer_ShakeTentacleOver");
		
		//SequenceStates_Pause("Sequence_BrainReplace");
	}
	
	void Timer_ShakeTentacleOver(const tString&in asTimer)
	{
		//SequenceStates_Resume("Sequence_BrainReplace");
		
		Map_RemoveTimer("ShakeTentacleLogic");
		Map_AddTimer("FadeShakeTentacleLogic", 0.01, "Timer_FadeShakeTentacleLogic");
		
		Map_AddTimer("ShakeTentacleHit", 0.31, "Timer_ShakeTentacleHit");
	}
	
	void Timer_ShakeTentacleHit(const tString&in asTimer)
	{
		Effect_Shake_Start(0.65, 0.3, 0.1, 0.4, cVector3f(1, 0.1, 0));
		Effect_ChromaticAberration_Start(0.95, 0.055, 0.3, cVector2f(1, 0.1));
		
		Player_AddBodyForce(cVector3f(-20000,1000,20000), false);
	}
		
	//-------------------------------------------------------
	
	void Timer_ShakeTentacleLogic(const tString&in asTimer)
	{
		float fPitch = cLux_GetPlayer().GetCamera().GetPitch();
		
		mfTentacleShakeAngle = fPitch - mfBaseCamPitch;
		mfTentacleShakeAngle *= 2.0f;
		cLux_AddDebugMessage("Angle: "+mfTentacleShakeAngle);
		
		for(int i=0; i<mlNumOfShakeBones; ++i)
		{
			mvShakeBones[i].SetUsePreTransform(true);
			cQuaternion qHeadRotate(mfTentacleShakeAngle*mfBoneRotMul[i], mvBoneRotVec[i]);
			mvShakeBones[i].SetPreTransform(cMath_MatrixQuaternion(qHeadRotate));
		}
		
		Map_AddTimer("ShakeTentacleLogic", 0.01, "Timer_ShakeTentacleLogic");
	}
	
	//-------------------------------------------------------
	
	void Timer_FadeShakeTentacleLogic(const tString&in asTimer)
	{
		if(mfTentacleShakeAngle<0.0f) {
			mfTentacleShakeAngle += 0.1f;
			if(mfTentacleShakeAngle>0.0f) mfTentacleShakeAngle =0;	
		}
		else if(mfTentacleShakeAngle>0.0f) {
			mfTentacleShakeAngle -= 0.1f;
			if(mfTentacleShakeAngle<0.0f) mfTentacleShakeAngle =0;	
		}
		
		cLux_AddDebugMessage("Angle: "+mfTentacleShakeAngle);
		
		for(int i=0; i<mlNumOfShakeBones; ++i)
		{
			cQuaternion qHeadRotate(mfTentacleShakeAngle*mfBoneRotMul[i], mvBoneRotVec[i]);
			mvShakeBones[i].SetPreTransform(cMath_MatrixQuaternion(qHeadRotate));
		}
		
		if(mfTentacleShakeAngle==0)
		{
			for(int i=0; i<mlNumOfShakeBones; ++i)
				mvShakeBones[i].SetUsePreTransform(false);
			return;
		}
		
		Map_AddTimer("FadeShakeTentacleLogic", 0.01, "Timer_FadeShakeTentacleLogic");
	}
	
	
	//-------------------------------------------------------
	
	void AnimOver_Stab(const tString &in asEntityName, const tString &in asAnimName)
	{
		Entity_PlayAnimation(asEntityName, "idle", 0.1f, true);
	}
	
	//-------------------------------------------------------
	
	void ChangeBrain()
	{
		mlCurrentBrainCount++;
		Entity_CreateAtEntity(	"brain_"+mlCurrentBrainCount, "teaser_brain_infected_stage"+mlCurrentBrainCount,
								msCurrentBrainEntity, false);
		Entity_SetActive(msCurrentBrainEntity, false);
		
		msCurrentBrainEntity = "brain_"+mlCurrentBrainCount;
	}
		
	//-------------------------------------------------------
	
	void HurtAndChangeBrainEffect(float afAmount, int alTentacleIdx)
	{
		Effect_Shake_Start(0.45*afAmount, 0.3, 0.1, 0.4, cVector3f(1, 0.1, 0));
		Effect_ChromaticAberration_Start(0.75, 0.055*afAmount, 0.3, cVector2f(1, 0.1));
		Player_FadeAspectMulTo(1 - 0.15f*afAmount, 3);
		
		Entity_SetActive("brain_seed_"+alTentacleIdx, false);
		
		ChangeBrain();
		
		Entity_SetActive("brain_chunk_flying_0"+alTentacleIdx+"*", true);
		Prop_SetActiveAndFade("brain_chunk_0"+alTentacleIdx+"*", true, 0.3f);
		
		ParticleSystem_CreateAtEntity("BrainBloodSplat", "stab_brain_oneshot", "Area_BrainStab_"+alTentacleIdx, false);
		
		Map_AddTimer("Area_BrainStab_"+alTentacleIdx, 0.6f, "Timer_BrainHurtOver");
	}
	
	void Timer_BrainHurtOver(const tString&in asTimer)
	{
		ParticleSystem_CreateAtEntity("Elec1", "elec_spark_lightning_oneshot_small",asTimer, false);
		
		Player_FadeAspectMulTo(1, 2);
	}
	
