	//-------------------------------------------------------
	
	cSequenceStatesData mSeqAwakeCorpse;
	void Sequence_AwakeCorpse(const tString &in asX)
	{
		Sequence_Begin("Sequence_AwakeCorpse", mSeqAwakeCorpse);
		
		/////////////////
		// Turn on light
		if (Sequence_DoStepAndWait(1.0f))
		{
			//Effect_Shake_Start(0.1, 0.2f, 0.05f, 0.1f);
			
			Entity_SetActive("teaser_corpse_ragdoll", false);
			Entity_SetActive("teaser_corpse_1", true);
			
			Entity_SetEffectsActive("teaser_brain_piece_1", true, true);
			Entity_SetEffectsActive("teaser_brain_pedastal_nocables_1", true, true);
			
			Entity_PlayAnimation("teaser_corpse_1", "breathing_loop", 0.1f, true);
			mfStoragePulseTime = 0.3f;
			Timer_BrainDevicePulseOff("");
			
			CorpseShockEffect(0.75f);
									
			Music_PlayExt("01_01_thick_air", true, 0.8f, 1.0f, 4, 4, 0, false);
		}
		/////////////////
		// Pulse + animation starts
		if (Sequence_DoStepAndWait(2.0f))
		{
			Sound_PlayGui("teaser_man_04.ogg", 1.0f);
		}
		/////////////////
		// Cool down breathing.
		if (Sequence_DoStepAndWait(8.0f))
		{
			mfStoragePulseTime = 1.4f;
		}
		/////////////////
		// Pulse goes up and sparks start to fly
		if (Sequence_DoStepAndWait(1.5f))
		{
			CorpseShockEffect(0.5f);
			
			Entity_PlayAnimation("teaser_corpse_1", "jerk");
					
			ParticleSystem_CreateAtEntity("Spark1", "elec_spark_oneshot.ps", "Area_Spark_1", false);
			LightFlash_Add(0.2, 0.1, 0.5, "Area_Spark_1", cColor(1.0f, 0.8f, 0.1f, 1.0f), 2.2f, 1.0f);
			ParticleSystem_CreateAtEntity("Elec1", "elec_spark_lightning_oneshot_small", "Area_Spark_1", false);
			
			Entity_SetActive("blood_splash_1", true);
			
			mfStoragePulseTime = 0.5f;
		}
		if (Sequence_DoStepAndWait(1.0f))
		{
			for(int i=0; i<3; ++i)
				ParticleSystem_CreateAtEntity("Spark2", "elec_spark_oneshot.ps", "Area_Spark_2", false);
			LightFlash_Add(0.2, 0.1, 0.5, "Area_Spark_2", cColor(1.0f, 0.8f, 0.1f, 1.0f), 2.2f, 1.0f);
			
			Entity_SetActive("blood_splash_2", true);
			
			ParticleSystem_CreateAtEntity("Elec1", "elec_spark_lightning_oneshot_small", "Area_Spark_2", false);
			
			Entity_PlayAnimation("teaser_corpse_1", "spasm_loop", 0.1f, true);
		}
		/////////////////
		// Now smokes come up too
		if (Sequence_DoStepAndWait(3.0f))
		{
			for(int i=0; i<4; ++i)
				ParticleSystem_CreateAtEntity("Spark3", "elec_spark_oneshot.ps", "Area_Spark_3", false);
				
			LightFlash_Add(0.2, 0.1, 0.5, "Area_Spark_3", cColor(1.0f, 0.8f, 0.1f, 1.0f), 2.2f, 1.0f);
			
			ParticleSystem_CreateAtEntityExt("Smoke1", "smoke_bright_med_loop", "Area_StorageConSmoke_2", false,
											cColor(0.7, 0.3) );
											
			Entity_SetActive("blood_splash_3", true);
											
			Music_PlayExt("01_01_thick_air", true, 1.0f, 1.0f, 3, 3, 0, false);
		}
		/////////////////
		// Corpses goes into spasms
		if (Sequence_DoStepAndWait(1.0f))
		{
			ParticleSystem_CreateAtEntityExt("Smoke2", "smoke_bright_med_loop", "Area_StorageConSmoke_1", false,
											cColor(0.7, 0.3) );
											
			for(int i=0; i<4; ++i)
				ParticleSystem_CreateAtEntity("Spark3", "elec_spark_oneshot.ps", "Area_Spark_3", false);
				
			LightFlash_Add(0.2, 0.1, 0.5, "Area_Spark_3", cColor(1.0f, 0.8f, 0.1f, 1.0f), 2.2f, 1.0f);
			
			ParticleSystem_CreateAtEntityExt("Smoke1", "smoke_bright_med_loop", "Area_StorageConSmoke_2", false,
											cColor(0.7, 0.3) );
											
			mfStoragePulseTime = 0.3f;
		}
		/////////////////
		// Final spasms before death.
		if (Sequence_DoStepAndWait(1.5f))
		{
			ParticleSystem_Destroy("Smoke1");
			
			Entity_PlayAnimation("teaser_corpse_1", "jerk");
			
			mfStoragePulseTime = 0.1f;
		}
		/////////////////
		// Remove all effects left.
		if (Sequence_DoStepAndWait(1.5f))
		{
			ParticleSystem_Destroy("Smoke2");
			
			Map_RemoveTimer("PulseOff");
			Map_RemoveTimer("PulseOn");
			
			Entity_SetActive("blood_pool_1", true);
			Entity_SetActive("blood_pool_2", true);
			GrowBloodPool();
			
			for(int i=0; i<2; ++i)		
			{
				Entity_FadeEffectBaseColor(mvStoragePulseDevice[i],cColor(0,0), 0.5);
			}
		}
		if (Sequence_DoStepAndWait(2.5f)){}
		if (Sequence_DoStepAndWait(10.0f))
		{
			Sound_PlayGui("teaser_man_05.ogg", 1.0f);
		}
		//The next in line-line does not sound good.
		/*if (Sequence_DoStepAndWait(5.0f))
		{
			Sound_PlayGui("teaser_man_06.ogg", 1.0f);
		}*/
		
		Sequence_End();
	}

	//-------------------------------------------------------
	
	cMatrixf[] mvBloodPoolBaseMtx;
	float[] mfBloodScaleAmount = {0.0f, 0.0f, 0.0f};
	float[] mfBloodScaleSpeed = {0.1f, 0.11f, 0.13f};
	int mlBloodPoolNum = 3;
	
	cMatrixf m_mtxBasePoolBaseMtx;
	float mfBasePoolScaleAmount=0;
	
	void GrowBloodPool()
	{
		mvBloodPoolBaseMtx.resize(mlBloodPoolNum);
		
		for(int i=1; i<=mlBloodPoolNum; ++i)
		{
			mvBloodPoolBaseMtx[i-1] = cLux_GetCurrentMap().GetEntityByName("blood_pool_"+i).GetMeshEntity().GetLocalMatrix();
		}
		
		m_mtxBasePoolBaseMtx = cLux_GetCurrentMap().GetEntityByName("blood_pool_base").GetMatrix();
		
		Entity_SetActive("blood_pool_base", true);
		
		Map_AddTimer("BasePoolGrow", 0.01f, "Timer_BasePoolGrow");
		Map_AddTimer("BloodPoolGrow", 1.5f, "Timer_BloodPoolGrow");
	}

	void Timer_BasePoolGrow(const tString&in asTimer)
	{
		mfBasePoolScaleAmount += (1.0f/60.0f) * 0.25f;
		if(mfBasePoolScaleAmount>1.0f) mfBasePoolScaleAmount = 1.0f;
		
		Map_AddTimer("BasePoolGrow", 0.01, "Timer_BasePoolGrow");
		
		float fScaleAdd = cMath_SigmoidCurve(mfBasePoolScaleAmount)*0.84f;
					
		cMatrixf mtxScale = cMath_MatrixScale(cVector3f(1,1,1)* (cVector3f(1,1,1) + 
							cVector3f(fScaleAdd,0, fScaleAdd)) );
		cMatrixf  mtxTrans = cMath_MatrixMul(m_mtxBasePoolBaseMtx, mtxScale);
		
		cLux_GetCurrentMap().GetEntityByName("blood_pool_base").SetMatrix(mtxTrans);
	}
	
	void Timer_BloodPoolGrow(const tString&in asTimer)
	{
		for(int i=1; i<=mlBloodPoolNum; ++i)
		{
			int lIdx = i-1;
			
			mfBloodScaleAmount[lIdx] += (1.0f/60.0f) * mfBloodScaleSpeed[lIdx];
			if(mfBloodScaleAmount[lIdx]>1.0) mfBloodScaleAmount[lIdx] = 1.0f;
		
			float fScaleAdd = cMath_SigmoidCurve(mfBloodScaleAmount[lIdx])*0.75f;
					
			cMatrixf mtxScale = cMath_MatrixScale(cVector3f(1,1,1)* (1.0f + fScaleAdd));
			cMatrixf  mtxTrans = cMath_MatrixMul(mvBloodPoolBaseMtx[lIdx], mtxScale);
			
			cLux_GetCurrentMap().GetEntityByName("blood_pool_"+i).GetMeshEntity().SetMatrix(mtxTrans);
		}
		
		Map_AddTimer("BloodPoolGrow", 0.01, "Timer_BloodPoolGrow");
	}
	
	
	//-------------------------------------------------------
	
	void CorpseShockEffect(float afAmount)
	{
		Player_FadeAspectMulTo(0.75f, 1.3f);
		Player_FadeFOVMulTo(0.85f, 1.5f);
		Effect_ImageTrail_Start(0.8f, 0.2f, 2, 3.3f);
		
		Map_AddTimer("ShockEffectOver", 0.85f, "Timer_ShockEffectOver");
	}
	
	void Timer_ShockEffectOver(const tString&in asTimer)
	{
		Player_FadeAspectMulTo(1.0, 1.0);
		Player_FadeFOVMulTo(1.0, 1.1);
	}
	
	//-------------------------------------------------------
	
	
	void Timer_BrainDevicePulseOn(const tString&in asTimer)
	{
		for(int i=0; i<2; ++i)		
		{
			Entity_FadeEffectBaseColor(mvStoragePulseDevice[i],cColor(1,1), mfStoragePulseTime);
		}
		Map_AddTimer("PulseOff", mfStoragePulseTime, "Timer_BrainDevicePulseOff");
	}
	
	void Timer_BrainDevicePulseOff(const tString&in asTimer)
	{
		for(int i=0; i<2; ++i)		
		{
			Entity_FadeEffectBaseColor(mvStoragePulseDevice[i],cColor(0,0), mfStoragePulseTime);
		}
		Map_AddTimer("PulseOn", mfStoragePulseTime, "Timer_BrainDevicePulseOn");		
	}
	
