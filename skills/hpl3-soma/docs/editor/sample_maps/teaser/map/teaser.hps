	//-------------------------------------------------------
	
	int mlDOFWakeUp;
 
    //-------------------------------------------------------
	
	cSequenceStatesData mSeqWakeUp;
	void Sequence_WakeUp(const tString &in asX)
	{
		Sequence_Begin("Sequence_WakeUp", mSeqWakeUp);
		
		if (Sequence_DoStepAndWait(3))
		{
			Effect_Fade_Out(0);
		}	
		if (Sequence_DoStepAndWait(0.1))
		{
			Effect_Fade_Out(0);
			CameraAnimation_Begin("CA_WakeUp", "CamAnim_Over", true);
			
			//Effect_ToneMapping_FadeExposure(3, 0.0001f);
			Effect_ToneMapping_FadeWhiteCut(0.1, 0.0001f);
			Effect_ImageTrail_Start(2, 0.001, 4, 6);
			
			mlDOFWakeUp = Effect_DoF_Start(0.2, 2,1, 0.01);
		}
		if (Sequence_DoStepAndWait(3))
		{
			Effect_Fade_In(6);
			Effect_ToneMapping_FadeWhiteCut(1.0, 10);
			Music_PlayExt("01_01_thick_air", true, 0.45f, 0.9f, 3, 0, 0, false);
			
		}
		if (Sequence_DoStepAndWait(3))
		{
			Map_AddTimer("", 3, "TimerWhatHappened");
		
		}
		if (Sequence_DoStepAndWait(3))
		{
			
		}
		
		Sequence_End();
	}

	bool CamAnim_Over(const tString &in asEntity, int alDirection)
	{
		Effect_DoF_FadeFocus(mlDOFWakeUp, 0.2, 30, 8);
		
		
		return false;
	}
	
	void TimerWhatHappened(const tString&in asTimer)
	{
		Sound_PlayGui("teaser_man_01.ogg", 1.0f);
	}
	
