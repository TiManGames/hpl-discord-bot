	bool Collide_BrainPulseStart(const tString&in asParent, const tString&in asChild, int alState)
	{
		Music_Stop(7, 0);
		
		Lamp_SetLit("teaser_brain_pedastal_1", true, true);
		
		Map_AddTimer("PulseOff", 1.0f, "Timer_BrainPulseOff");
		Map_AddTimer("UpdateBrainPulse", 0.0f, "Timer_UpdateBrainPulse");
						
		cLux_AddDebugMessage("Brain Pulse Start!");
		
		
		
		Map_AddTimer("HeartVolMinor", 0.1f, "Timer_MinorIncreaseHeartVol");
				
		return false;
	}
	
	
	void Timer_MinorIncreaseHeartVol(const tString&in asTimer)
	{
		mfBrainPulseHeartVol += 0.01;
		if(mfBrainPulseHeartVol>=0.3)
		{
			mfBrainPulseHeartVol = 0.3;
			return;
		}
		
		Map_AddTimer("HeartVolMinor", 0.1f, "Timer_MinorIncreaseHeartVol");		
	}
	
