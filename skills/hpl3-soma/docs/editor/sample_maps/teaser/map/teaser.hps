	bool Collide_SeeSpider(const tString&in asParent, const tString&in asChild, int alState)
	{
		Music_PlayExt("01_02_trapped_pipes", true, 1.0f, 1.0f, 7, 3, 0, false);
		
		Entity_SetEffectsActive("spider_1", true, true);
		
		Sequence_SpiderEncounter("");
		
		return false;
	}
	
	cSequenceStatesData mSeqSpiderEncounter;
	void Sequence_SpiderEncounter(const tString &in asX)
	{
		Sequence_Begin("Sequence_SpiderEncounter", mSeqSpiderEncounter);
		
		if (Sequence_DoStepAndWait(0.35f)){}
		if (Sequence_DoStepAndWait(0.85f))
		{
			Player_FadeAspectMulTo(0.65, 1.3f);
			Player_FadeFOVMulTo(0.75, 1.5f);
			Effect_ImageTrail_Start(0.8f, 0.2f, 2, 3.3f);
		}
		if (Sequence_DoStepAndWait(0.5))
		{
			Entity_PlayAnimation("spider_1", "teaser_idle_loop", 0.1f, true, true, "AnimOver_SpiderOnFloor");
			
			Player_FadeAspectMulTo(1.0, 1.0);
			Player_FadeFOVMulTo(1.0, 1.1);
		}
		if (Sequence_DoStepAndWait(0.5))
		{
			
		}
		
		/*if (Sequence_DoStepAndWait(4.0))
		{
			SpiderSanityEffect(3);
		}
		if (Sequence_DoStepAndWait(5.0))
		{
			SpiderSanityEffect(0.5);
		}
		if (Sequence_DoStepAndWait(0.0))
		{
			SpiderSanityEffect(0.5);
		}*/
		
		
		
		Sequence_End();
	}
	
	void SpiderSanityEffect(float afAmount)
	{
		Effect_Shake_Start(0.55*afAmount, 0.01, 0.3, 0.01, cVector3f(1, 0, 0));
		Effect_ImageTrail_Start(0.6, 0.05, 0.4, 0.1);
	}
	
