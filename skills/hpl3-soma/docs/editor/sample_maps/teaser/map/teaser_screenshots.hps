//--------------------------------------------------
 
/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/
 
//--------------------------------------------------
 
class cScrMap : iScrMap
{
   //--------------------------------------------
 
   /////////////////////////////////////////
   // ==============
   // MAIN CALLBACKS
   // ==============
   /////////////////////////////////////////
 
   //-------------------------------------------------------
 
   ////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		/////////////////////////
		// Set up
		Entity_SetEffectsActive("teaser_brain_piece_1", false, false);
		
		Effect_Bloom_FadeBloomWidth(100,0.0001f);
		Effect_Bloom_FadeBrightPass(0.2, 0.01f);
		Effect_Bloom_FadeBloomFalloff(0.1f, 0.01f);
		
		Entity_SetEffectsActive("spider_1", false, false);
		
		Entity_AttachToSocket("StickBrainDevice", "teaser_corpse_1", "HeadCap", true, false);
		
		Entity_AttachToSocket("brain_seed_1", "teaser_brain_room_tentacle_01_1", "Seed", true, false);
		Entity_AttachToSocket("brain_seed_2", "teaser_brain_room_tentacle_01_2", "Seed", true, false);
		Entity_AttachToSocket("brain_seed_3", "teaser_brain_room_tentacle_01_3", "Seed", true, false);
		Entity_AttachToSocket("brain_seed_4", "teaser_brain_room_tentacle_01_4", "Seed", true, false);
		
		cLux_GetCurrentMap().GetEntityByName("teaser_corpse_1").StopAllAnimations(0.0);
		
		Player_SetHeadBobMul(0.3f);
		
		m_mtxBaseBrainTransform = cLux_GetCurrentMap().GetEntityByName("brain_0").GetMeshEntity().GetLocalMatrix();
		
		Entity_PlayAnimation("teaser_corpse_1", "breathing_loop", 0.1f, true, false);
		
		//Map_AddTimer("LampSwing", 0.1f, "Timer_LampSwing");

		Player_SetCrossHairState(eCrossHairState_None);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//Add any debug stuff here
			
			cLux_SetDebugInfoWindowText("Text that should show up when pressing F1");
		}
		else
		{
			//Sequence_WakeUp("");
		}
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}
	
	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		//cLux_AddTodoMessage("UPDATE!");
		Player_SetCrossHairState(eCrossHairState_None);
	}
	
	void PostUpdate(float afTimeStep)
	{
		Player_SetCrossHairState(eCrossHairState_None);
	}
	
	////////////////////////////
	// The player has died.
	void OnPlayerDead(int aType, const tString&in asSource)
	{
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			cLux_AddDebugMessage("Test");
			//Sound_CreateAtEntity("ear_ring", "teaser_ear_ring.snt","player", 14.0f, true);
			//Debug stuff when pressing key 1
			
			Entity_SetActive("blood_pool_1", true);
			Entity_SetActive("blood_pool_2", true);
			//GrowBloodPool();
			
			//LightFlash_Add(1,1,1, "teaser_brain_piece_1", cColor(1,1), 2, 1);
		}
		if(alAction == eAction_Test2)
		{
		}
	}
	
	//-------------------------------------------------------
	
	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
   //-------------------------------------------------------
 
   /////////////////////////////////////////
   // ==============
   // MAIN FUNCTIONS
   // ==============
   /////////////////////////////////////////
 
   //-------------------------------------------------------
 
   cMatrixf m_mtxBaseBrainTransform;
 
   //-------------------------------------------------------
 
   /*Put any functions that are used in more than one scene here.*/   
 
