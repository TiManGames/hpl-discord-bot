    <CATEGORY Name="Voices_global">
        <Entry Name="globaltestscene_globaltestsub_001_globaltestchar_001">Isso é um teste global!</Entry>
        <Entry Name="globaltestscene_firstdatamine_001_player_001">Quê... Como eu fiz isso?</Entry>
        <Entry Name="globaltestscene_firstwauflower_human_001_player_001">Ah, o que foi isso?</Entry>
        <Entry Name="GlobalTestScene_FirstWauFlower_Human_001_Player_002">Não dói mais.</Entry>
        <Entry Name="globaltestscene_firstwauflower_tentacle_001_player_001">Meu deus, mas o quê...!</Entry>
        <Entry Name="globaltestscene_getflashlight_001_player_001">Como eu... De onde eu tirei essa lanterna?</Entry>
        <Entry Name="globaltestscene_getflashlightunderwater_001_player_001">Como eu... De onde eu tirei essa lanterna?</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_001_Catherine_001">O que diabos você está fazendo?</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_002_Player_001">Eu sei que parece ruim, mas me faz sentir muito melhor. Ajuda a me concentrar.</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_003_Catherine_001">É... Mas você está se conectando com o WAU...</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_004_Player_001">Eu preciso disso, tá bom? Eu não teria chegado tão longe sem isso.</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_005_Catherine_001">Vamos continuar.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_00_intro">
        <Entry Name="intro_intro_0_001_simon_001">Ashley, quer uma carona?</Entry>
        <Entry Name="intro_intro_0_004_ashley_001">Bom, se você não se importar em passar por Parkdale.</Entry>
        <Entry Name="intro_intro_0_005_simon_001">Nada, pode entrar.</Entry>
        <Entry Name="intro_intro_1_001_simon_001">*arranque da chave de ignição*</Entry>
        <Entry Name="intro_intro_2_003_simon_001">Está gostando do trabalho até agora?</Entry>
        <Entry Name="intro_intro_2_004_ashley_001">É, estou me divertindo. Foi uma boa semana.</Entry>
        <Entry Name="intro_intro_3_001_ashley_001">Você está bem, Simon? Acho que está sangrando.</Entry>
        <Entry Name="intro_intro_3_002_simon_001">Ah, isso não é nada. É que o meu cérebro não consegue parar de sangrar desde o acidente.</Entry>
        <Entry Name="intro_intro_4_001_ashley_001">Aqui, tome isso.</Entry>
        <Entry Name="intro_intro_5_001_simon_001">Não, isso é para depois. Para o exame.</Entry>
        <Entry Name="intro_intro_5_002_ashley_001">É verde.</Entry>
        <Entry Name="intro_intro_6_001_simon_001">Ashley, preciso lhe dizer uma coisa.</Entry>
        <Entry Name="intro_intro_6_002_ashley_001">Simon, por favor, não vamos deixar isso estranho...</Entry>
        <Entry Name="intro_intro_6_003_simon_001">Não, não, não é nada disso.</Entry>
        <Entry Name="intro_intro_7_001_simon_001">Por que agora?</Entry>
        <Entry Name="intro_intro_7_002_ashley_001">Quem é David Munshi?</Entry>
        <Entry Name="intro_intro_7_003_simon_001">Por que nunca dá tempo?!</Entry>
		<Entry Name="intro_intro_7_004_ashley_001">Para quê?</Entry>
        <Entry Name="intro_intro_8_001_ashley_001">Para quê?</Entry>
        <Entry Name="intro_intro_9_001_simon_001">Para dizer que sinto muito.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_01_apartment">
        <Entry Name="Phonecall_1_PhoneCall_001_Player_001">Tá, já acordei!</Entry>
        <Entry Name="Phonecall_1_PhoneCall_002_David_001">Alô, Simon Jarrett?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_003_Player_001">Sim, sou eu.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_004_David_001">Meu nome é David Munshi. Nós nos falamos mais cedo...</Entry>
        <Entry Name="Phonecall_1_PhoneCall_005_Player_001">A tomografia! Sim, eu me lembro.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_006_David_001">Você está bem?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_007_Player_001">Sim, sim... Só tive um pesadelo. Hoje ainda está de pé?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_008_David_001">Sim, é por isso que estou ligando. Eu queria lembrá-lo de beber o fluido rastreador que eu lhe enviei. Ele irá me ajudar a capturar uma imagem melhor dos seus danos cerebrais.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_009_Player_001">Não se preocupe, eu tenho ele por aqui.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_010_David_001">OK, ótimo. Então a gente se vê daqui a algumas horas.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_011_Player_001">Tá, até daqui a pouco.</Entry>
        <Entry Name="SimonTalking_5_FoundTracer_001_Player_001">Ali está.</Entry>
        <Entry Name="SimonTalking_6_DrinkTracer_001_Player_001">Parece leite, mas o gosto... é como chupar uma moeda.</Entry>
        <Entry Name="SimonTalking_7_BrokenShower_001_Player_001">Não quero deixar o doutor esperando. Eu tomo banho quando voltar.</Entry>
        <Entry Name="SimonTalking_8_OpenDrapes_001_Player_001">O verão está chegando. Espero que seja bom.</Entry>
        <Entry Name="SimonTalking_9_InspectFridge_001_Player_001">Só tem fast food. Eu deveria comprar algo mais saudável quando voltar.</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_001">Ei, Simon. Aqui é o Jesse! Você vai trabalhar nesse fim de semana ou o quê?</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_002">Eu lembro que havia alguma coisa que você tinha que fazer... Mas era nessa semana ou na outra?</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_003">De qualquer forma, é só me mandar um e-mail ou sei lá. Falouteamopacas!</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_002_AnswerMachine_001">Fim das mensagens.</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_003_Player_001">Eu juro que esse cara tem a memória de um peixe de aquário.</Entry>
        <Entry Name="SimonTalking_11_UseTV_001_Player_001">Legal, assistir TV agora me dá dor de cabeça. Valeu, cérebro.</Entry>
        <Entry Name="Phonecall_12_TryToExit_001_Player_001">Eu realmente deveria beber o fluido rastreador antes de ir no Dr. Munshi.</Entry>
        <Entry Name="SimonTalking_13_TracerReminder_001_Player_001">Onde eu deixei o fluido rastreador?</Entry>
        <Entry Name="SimonTalking_13_TracerReminderB_001_Player_001">Anda, fluido rastreador radioativo, cadê você?</Entry>
        <Entry Name="AnswerMachine_13_NoNewMessages_001_AnswerMachine_001">Você não tem novas mensagens.</Entry>
        <Entry Name="Phonecall_1_PhoneCallOver_001_Player_001">...meu deus...</Entry>
        <Entry Name="SimonTalking_2_UnsentMailReaction_001_Player_001">Eu esqueci de enviar. Mas e daí? Eu já tinha falado para ele.</Entry>
        <Entry Name="SimonTalking_2_SentMailReaction_001_Player_001">Antes tarde do que nunca.</Entry>
        <Entry Name="SimonTalking_2_UnsentMailReaction_HeardMsg_001_Player_001">Ah, eu esqueci de enviar.</Entry>
        <Entry Name="SimonTalking_10_AnswerMachine_NotReadMail_001_Player_001">Eu até mandei um e-mail para lembrá-lo, ou não mandei?</Entry>
        <Entry Name="SimonTalking_10_AnswerMachine_SentMail_001_Player_001">Bom, enviei o e-mail. Ele já deve ter recebido agora.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_02_subway">
        <Entry Name="Announcer_StationStAndrew_001_Announcer_001">St Andrew -- Próxima estação, St Andrew.</Entry>
        <Entry Name="Announcer_StationOsgoode_001_Announcer_001">Osgoode -- Próxima estação, Osgoode.</Entry>
        <Entry Name="Announcer_StationStPatrick_001_Announcer_001">St Patrick -- Próxima estação, St Patrick.</Entry>
        <Entry Name="Announcer_StationQueensPark_001_Announcer_001">Queen&apos;s Park -- Próxima estação, Queen&apos;s Park.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_001_Player_001">Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_002_Jesse_001">Ei, Simon. Recebi o seu e-mail. Eu só queria lhe desejar boa sorte e que você saiba que eu tenho tudo sobre controle.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_003_Player_001">Obrigado, eu provavelmente vou passar na loja depois do exame.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_004_Jesse_001">Relaxa. O Matt e o Chris vão me ajudar.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_005_Player_001">Matty da S&amp;L?</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_006_Jesse_001">Acho que você não ficou sabendo. Ele vai trabalhar em tempo integral. Na seção de comics.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_007_Player_001">Esse é o trabalho da Ashley.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_008_Jesse_001">É. Bom, você sabe...</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_009_Player_001">Esquece. Não estou fazendo nenhum favor deixando uma vaga vazia. Ela não vai voltar de qualquer forma.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_010_Jesse_001">Bom, boa sorte. Espero que eles encontrem uma forma de reverter... você sabe... essa coisa toda de morrer.</Entry>
        <Entry Name="simon_phonecall_emailsent_011_player_001">Essa coisa toda de morrer? Você é o pior consolador do mundo.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_012_Jesse_001">Bom, e o que você queria que eu dissesse?</Entry>
        <Entry Name="simon_phonecall_emailsent_013_player_001">A gente se vê depois, Jesse. Não queime o lugar todo enquanto eu não estou.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_014_Jesse_001">Câmbio e desligo, amigo.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_001_Player_001">Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_002_Jesse_001">Simon, e aí? Eu queria saber se você vai passar na loja hoje.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_003_Player_001">Talvez mais tarde. Eu vou fazer a tal da tomografia, lembra?</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_004_Jesse_001">É hoje?!</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_005_Player_001">Sabia que você ia esquecer.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_006_Jesse_001">Desculpa. Na próxima, me mande um e-mail. Você sabe que eu preciso ter essas coisas escritas!</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_007_Player_001">Sabe aquela coisa chamada calendário? Você devia comprar um.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_008_Jesse_001">Eu tenho um. Eu só... nunca uso ele.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_009_Player_001">Talvez eu dê uma passada depois. Dependendo de quanto tempo durar o exame.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_010_Jesse_001">Beleza. Eu vou chamar o Chris para me ajudar. Enfim, vamos ter um novo servo hoje. Caso você queira passar aqui para dar um &quot;oi&quot;.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_011_Player_001">Já substituiu a Ashley. Que rápido.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_012_Jesse_001">Não, não foi rápido. Estamos com falta de funcionários há semanas e você sabe disso.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_013_Player_001">É, acho que já faz um tempo.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_014_Jesse_001">E como faz. Tipo um mês já.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_015_Jesse_001">De qualquer forma, vai lá fazer o seu exame. Receba as boas notícias do doutor, dê uma passada na loja, venha dar um &quot;oi&quot; para o cara novo e o almoço fica por minha conta.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_016_Player_001">Obrigado, Jesse. Realmente agradeço pelo apoio.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_017_Jesse_001">Não quero ter que substituir outro servo.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_018_Player_001">Isso não foi engraçado</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_019_Jesse_001">Foi um pouquinho engraçado.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_020_Player_001">Não, não foi. Tchau, Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_021_Jesse_001">Até mais.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_03_laboratory">
        <Entry Name="general_1_arriving_001_player_001">Oi? Doutor Munshi?</Entry>
        <Entry Name="general_2_lockeddoor0_001_player_001">Será esse o lugar? Deve ser.</Entry>
        <Entry Name="general_2_lockeddoor1_001_player_001">Doutor Munshi? Você está me ouvindo? Olá?!</Entry>
        <Entry Name="general_2_lockeddoor2_001_player_001">Tá, preciso de um código.</Entry>
        <Entry Name="General_3_TryExit0_001_Player_001">Ainda não é hora de desistir.</Entry>
        <Entry Name="General_3_TryExit1_001_Player_001">Ainda não, preciso resolver isso.</Entry>
        <Entry Name="General_3_TryExit2_001_Player_001">Deve haver uma forma de entrar no laboratório.</Entry>
        <Entry Name="General_4_TurnOnLights_001_Player_001">Cadê todo mundo? Achei que este lugar estaria cheio.</Entry>
        <Entry Name="General_7_GreetDavid_001_David_001">Ah, oi! Não ouvi você entrando. Simon Jarrett, certo?</Entry>
        <Entry Name="General_7_GreetDavid_002_Player_001">Doutor Munshi?</Entry>
        <Entry Name="General_7_GreetDavid_003_David_001">É só Sr. Munshi por enquanto, mas estou quase lá. Na verdade, você está me ajudando neste exato momento.</Entry>
        <Entry Name="General_7_GreetDavid_004_Player_001">Isso é parte da sua tese?</Entry>
        <Entry Name="General_7_GreetDavid_005_David_001">É, é um estudo que estou fazendo com meu colega Paul Berg. Esperamos formular uma forma mais gentil de trabalhar com reconstrução cerebral. Para podermos ajudar pessoas como você.</Entry>
        <Entry Name="General_7_GreetDavid_006_David_001">Você tomou o fluido rastreador?</Entry>
        <Entry Name="General_7_GreetDavid_007_Player_001">Sim, tomei.</Entry>
        <Entry Name="General_7_GreetDavid_008_David_001">Ótimo. Podemos começar assim que você estiver pronto.</Entry>
        <Entry Name="General_8_InteractDavid1_001_Player_001">Então... O que exatamente estamos fazendo?</Entry>
        <Entry Name="General_8_InteractDavid1_002_David_001">Vamos fazer um escaneamento do seu cérebro. Depois vamos construir um modelo computadorizado dele e bombardeá-lo com estímulos. O programa nos ajudará a iterar rapidamente o seu plano de tratamento até que esteja totalmente otimizado. Ou seja, desenvolveremos o tratamento perfeito para sua condição.</Entry>
        <Entry Name="General_8_InteractDavid1_003_Player_001">Então não é só um estudo, isso pode realmente me ajudar?</Entry>
        <Entry Name="General_8_InteractDavid1_004_David_001">Esperamos que sim. Senão tudo isso terá sido uma perda de tempo.</Entry>
        <Entry Name="General_8_InteractDavid2_001_Player_001">Você sabe que eu tenho uma condição séria, não sabe? Não sei se você sabe sobre o acidente... E sobre os dias contados que eu tenho para viver?</Entry>
        <Entry Name="General_8_InteractDavid2_002_David_001">Sim, eu sei. Deve ter sido difícil ter que ouvir isso. Como você já deve saber, isso é porque o seu cérebro ficou tão fraco que agora ele pode sangrar aleatoriamente...</Entry>
        <Entry Name="General_8_InteractDavid2_003_Player_001">...e se piorar muito, isso vai me matar.</Entry>
        <Entry Name="General_8_InteractDavid2_004_David_001">Bom, nós provavelmente não poderemos restaurar o seu cérebro completamente, mas podemos transformar os seus dias contados em anos. Décadas, talvez. Se você se cuidar e não fizer nada muito louco, podemos fazer você viver por muito mais.</Entry>
        <Entry Name="general_8_interactdavid3_001_player_001">Eu realmente espero que você esteja certo sobre isso.</Entry>
        <Entry Name="general_8_interactdavid3_002_david_001">Eu também. Isso poderá ter um grande impacto em como tratamos as pessoas com dano cerebral.</Entry>
        <Entry Name="general_8_interactdavid3_003_david_001">Então, o que me diz, vamos começar?</Entry>
        <Entry Name="general_8_interactdavid3_004_player_001">Claro, vamos começar.</Entry>
        <Entry Name="general_8_interactdavid3_005_david_001">Sente-se.</Entry>
        <Entry Name="General_10_SitDown_001_David_001">Certo, então vamos acabar logo com a parte chata. Você é Simon Jarett, correto?</Entry>
        <Entry Name="General_10_SitDown_002_Player_001">Sim.</Entry>
        <Entry Name="General_10_SitDown_003_David_001">Toronto, Canadá. David Munshi.</Entry>
        <Entry Name="General_10_SitDown_004_David_001">Nascido em 16 de julho de 1988?</Entry>
        <Entry Name="General_10_SitDown_005_Player_001">Sim.</Entry>
        <Entry Name="General_10_SitDown_006_David_001">Neurografia plana versão seis.</Entry>
        <Entry Name="General_10_SitDown_007_David_001">Ótimo. Todos os arquivos estão em ordem.</Entry>
        <Entry Name="General_10_SitDown_008_Player_001">Isso vai doer?</Entry>
        <Entry Name="General_10_SitDown_009_David_001">É apenas um escaneamento. Vai doer tanto quanto tirar uma foto.</Entry>
        <Entry Name="General_11_GogglesOn_001_Player_001">Os índios pensavam que as câmeras roubavam suas almas.</Entry>
        <Entry Name="General_11_GogglesOn_002_David_001">Ah, é? Bom, então vamos torcer para que eles estejam errados.</Entry>
        <Entry Name="General_11_GogglesOn_003_David_001">Pronto? Diga &quot;X&quot;!</Entry>
        <Entry Name="general_13_davidreminder_0_001_david_001">Por favor, sente-se.</Entry>
        <Entry Name="General_13_DavidReminder_1_001_David_001">Apenas sente-se e logo terminaremos com isso.</Entry>
        <Entry Name="General_14_LeaveRoom_0_001_David_001">Não ande por aí. Há muitas agulhas e aparelhos em volta.</Entry>
        <Entry Name="General_14_LeaveRoom_1_001_David_001">O que me diz, vamos continuar com o exame?</Entry>
        <Entry Name="General_14_LeaveRoom_2_001_David_001">Depressa. Não temos o dia todo.</Entry>
