        <Entry Name="General_15_PowerSwitchMessage_002_David_001">Apenas sente-se e podemos começar.</Entry>
        <Entry Name="General_15_PowerSwitchMessage_003_David_001">Anda, vamos começar.</Entry>
        <Entry Name="General_8_InteractDavid4_001_David_001">Quando você estiver pronto.</Entry>
        <Entry Name="General_8_InteractDavid4_002_David_001">Pode se sentar.</Entry>
        <Entry Name="General_8_InteractDavid4_003_David_001">Vamos começar o show.</Entry>
        <Entry Name="general_2_lockeddoor0_noanswer_001_player_001">Ótimo, o telefone dele está desligado.</Entry>
