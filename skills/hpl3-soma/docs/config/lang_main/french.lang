        <Entry Name="general_FinalWords_Version2_002_Catherine_001">Eh bien, nous avons réussi.</Entry>
        <Entry Name="general_FinalWords_Version2_003_Player_001">Quel soulagement !</Entry>
        <Entry Name="general_FinalWords_Version2_004_Catherine_001">Tout va bien, Simon. Tout va bien maintenant.</Entry>
