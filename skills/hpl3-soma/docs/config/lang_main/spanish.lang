        <Entry Name="simulation_3_alicevoid_9_002_wan_001">¡¿Qué le habéis hecho a Alice?!</Entry>
        <Entry Name="simulation_3_alicevoid_9_003_wan_001">¡Si está herida, acabaré contigo de una puta vez!</Entry>
        <Entry Name="simulation_3_alicecabin_2_001_alice_001">Genial, ¿verdad?</Entry>
        <Entry Name="simulation_3_alicecabin_2_002_alice_001">¿Te gusta?</Entry>
        <Entry Name="simulation_3_alicecabin_2_003_alice_001">No es lo que esperarías, ¿me equivoco?</Entry>
        <Entry Name="simulation_3_alicecabin_3_001_wan_001">Alice, ¿dónde estamos?</Entry>
        <Entry Name="simulation_3_alicecabin_4_001_alice_001">Esto es el ARCA. Pero tenemos un problema...</Entry>
        <Entry Name="simulation_3_alicecabin_4_002_alice_001">Lo hemos conseguido, es el ARCA. Pero necesito preguntarte algo.</Entry>
        <Entry Name="simulation_3_alicecabin_4_003_alice_001">No te preocupes, estás a salvo. Pero necesito que me escuches.</Entry>
