    <CATEGORY Name="Voices_global">
        <Entry Name="globaltestscene_globaltestsub_001_globaltestchar_001">¡Esto es una prueba general!</Entry>
        <Entry Name="globaltestscene_firstdatamine_001_player_001">¿Qué? ¿Cómo he hecho eso?</Entry>
        <Entry Name="globaltestscene_firstwauflower_human_001_player_001">¡Ah! ¿Qué ha sido eso?</Entry>
        <Entry Name="GlobalTestScene_FirstWauFlower_Human_001_Player_002">Ya no duele.</Entry>
        <Entry Name="globaltestscene_firstwauflower_tentacle_001_player_001">Por el amor de Dios, ¿qué demonios...?</Entry>
        <Entry Name="globaltestscene_getflashlight_001_player_001">¿Cómo he...? ¿De dónde he sacado una linterna?</Entry>
        <Entry Name="globaltestscene_getflashlightunderwater_001_player_001">¿Cómo he...? ¿De dónde he sacado una linterna?</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_001_Catherine_001">¿Qué demonios estás haciendo?</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_002_Player_001">Sé que parece algo malo, pero me hace sentir mucho mejor. Me ayuda a concentrarme.</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_003_Catherine_001">Eso es... Te estás conectando al WAU.</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_004_Player_001">Lo necesito, ¿vale? Sin esto, no habría llegado hasta aquí.</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_005_Catherine_001">Sigamos...</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_00_intro">
        <Entry Name="intro_intro_0_001_simon_001">Ashley, ¿quieres que te lleve?</Entry>
        <Entry Name="intro_intro_0_004_ashley_001">Vale, claro, si no te importa pasar por Parkdale.</Entry>
        <Entry Name="intro_intro_0_005_simon_001">Claro, monta.</Entry>
        <Entry Name="intro_intro_1_001_simon_001">*gira la llave de arranque*</Entry>
        <Entry Name="intro_intro_2_003_simon_001">¿Te gusta el trabajo?</Entry>
        <Entry Name="intro_intro_2_004_ashley_001">Sí, me estoy divirtiendo. Ha sido una buena semana.</Entry>
        <Entry Name="intro_intro_3_001_ashley_001">Simon, ¿estás bien? Creo que estás sangrando.</Entry>
        <Entry Name="intro_intro_3_002_simon_001">Oh, no es nada, es que mi cerebro no deja de sangrar desde el accidente.</Entry>
        <Entry Name="intro_intro_4_001_ashley_001">Toma esto.</Entry>
        <Entry Name="intro_intro_5_001_simon_001">No, eso es para después, para el escáner.</Entry>
        <Entry Name="intro_intro_5_002_ashley_001">Está en verde.</Entry>
        <Entry Name="intro_intro_6_001_simon_001">Ashley, necesito decirte algo.</Entry>
        <Entry Name="intro_intro_6_002_ashley_001">Simon, por favor, no conviertas esto en una situación incómoda...</Entry>
        <Entry Name="intro_intro_6_003_simon_001">No, no, no es nada de eso.</Entry>
        <Entry Name="intro_intro_7_001_simon_001">¿Por qué ahora?</Entry>
        <Entry Name="intro_intro_7_002_ashley_001">¿Quién es David Munshi?</Entry>
        <Entry Name="intro_intro_7_003_simon_001">¡¿Por qué nunca hay tiempo suficiente?!</Entry>
		<Entry Name="intro_intro_7_004_ashley_001">¿Para qué?</Entry>
        <Entry Name="intro_intro_8_001_ashley_001">¿Para qué?</Entry>
        <Entry Name="intro_intro_9_001_simon_001">Para decir que lo siento.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_01_apartment">
        <Entry Name="Phonecall_1_PhoneCall_001_Player_001">¡Ya estoy!</Entry>
        <Entry Name="Phonecall_1_PhoneCall_002_David_001">Hola, ¿Simon Jarrett?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_003_Player_001">Sí, soy yo.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_004_David_001">Me llamo David Munshi. Hemos hablado antes...</Entry>
        <Entry Name="Phonecall_1_PhoneCall_005_Player_001">¡El escáner cerebral! Lo recuerdo.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_006_David_001">¿Estás bien?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_007_Player_001">Sí, sí, solo ha sido una pesadilla. ¿Sigue en pie lo de hoy?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_008_David_001">Sí, para eso llamaba. Quería recordarte que te bebas el líquido de contraste que te envié. Me ayudará a captar mejor la imagen de los daños.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_009_Player_001">No te preocupes, lo tengo en alguna parte.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_010_David_001">Vale, genial. Bueno, nos vemos en un par de horas.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_011_Player_001">Vale, hasta pronto.</Entry>
        <Entry Name="SimonTalking_5_FoundTracer_001_Player_001">Ahí está.</Entry>
        <Entry Name="SimonTalking_6_DrinkTracer_001_Player_001">Parece leche pero el sabor... es como chupar una moneda.</Entry>
        <Entry Name="SimonTalking_7_BrokenShower_001_Player_001">No quiero hacer esperar al doctor. Ya me ducharé cuando vuelva.</Entry>
        <Entry Name="SimonTalking_8_OpenDrapes_001_Player_001">Se acerca el verano. Espero que sea bueno.</Entry>
        <Entry Name="SimonTalking_9_InspectFridge_001_Player_001">Solo comida rápida. Debería comprar algo más sano de camino a casa.</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_001">Eh, Simon. ¡Soy Jesse! ¿Trabajas este fin de semana o qué?</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_002">Tenías algo que hacer... ¿era este fin de semana o el siguiente?</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_003">Bueno, mándame un correo o algo. ¡Tequieroteechodemenos!</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_002_AnswerMachine_001">Fin de los mensajes.</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_003_Player_001">Te juro que el tipo tiene memoria de pez.</Entry>
        <Entry Name="SimonTalking_11_UseTV_001_Player_001">Vaya, ahora ver la tele me da dolor de cabeza. Gracias, cerebro.</Entry>
        <Entry Name="Phonecall_12_TryToExit_001_Player_001">Debería beberme el contraste antes de ir a ver al Dr. Munshi.</Entry>
        <Entry Name="SimonTalking_13_TracerReminder_001_Player_001">¿Dónde he dejado el líquido de contraste?</Entry>
        <Entry Name="SimonTalking_13_TracerReminderB_001_Player_001">Venga... contraste radioactivo. ¿Dónde estás?</Entry>
        <Entry Name="AnswerMachine_13_NoNewMessages_001_AnswerMachine_001">No tienes mensajes nuevos.</Entry>
        <Entry Name="Phonecall_1_PhoneCallOver_001_Player_001">... Por Dios...</Entry>
        <Entry Name="SimonTalking_2_UnsentMailReaction_001_Player_001">Se me ha olvidado pulsar Enviar. ¿Pasa algo? Total, ya se lo he dicho.</Entry>
        <Entry Name="SimonTalking_2_SentMailReaction_001_Player_001">Más vale tarde que nunca.</Entry>
        <Entry Name="SimonTalking_2_UnsentMailReaction_HeardMsg_001_Player_001">Oh, se me ha olvidado pulsar Enviar.</Entry>
        <Entry Name="SimonTalking_10_AnswerMachine_NotReadMail_001_Player_001">Incluso le envié un correo para recordárselo, ¿no?</Entry>
        <Entry Name="SimonTalking_10_AnswerMachine_SentMail_001_Player_001">Bueno, ya he enviado el correo. Debe de haberle llegado ya.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_02_subway">
        <Entry Name="Announcer_StationStAndrew_001_Announcer_001">St Andrew -- La siguiente estación es St Andrew.</Entry>
        <Entry Name="Announcer_StationOsgoode_001_Announcer_001">Osgoode -- La siguiente estación es Osgoode.</Entry>
        <Entry Name="Announcer_StationStPatrick_001_Announcer_001">St Patrick -- La siguiente estación es St Patrick.</Entry>
        <Entry Name="Announcer_StationQueensPark_001_Announcer_001">Queen&apos;s Park -- La siguiente estación es Queen&apos;s Park.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_001_Player_001">Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_002_Jesse_001">Hola, Simon. He recibido tu correo. Solo quería desearte suerte y decirte que lo tenemos todo cubierto.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_003_Player_001">Gracias. Creo que podré volver a la tienda después del escaneado.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_004_Jesse_001">No te preocupes. Matt y Chris me están echando una mano.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_005_Player_001">¿Matty de S&amp;L?</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_006_Jesse_001">Supongo que no te has enterado... Va a trabajar jornada completa en el departamento de cómics.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_007_Player_001">Ese es el trabajo de Ashley.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_008_Jesse_001">Sí, bueno. Ya sabes...</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_009_Player_001">Olvídalo. Dejar el hueco vacío no es hacerle ningún favor. Tampoco es que vaya a volver.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_010_Jesse_001">Buena suerte. Espero que encuentren la manera de invertir todo ese proceso de... eso de morirse.</Entry>
        <Entry Name="simon_phonecall_emailsent_011_player_001">¿Eso de morirse? Menudos ánimos das tú...</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_012_Jesse_001">¿Y qué otra cosa puedo decir?</Entry>
        <Entry Name="simon_phonecall_emailsent_013_player_001">Hasta luego, Jesse. No quemes el local en mi ausencia.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_014_Jesse_001">Cambio y corto, amigo.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_001_Player_001">Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_002_Jesse_001">Simon, ¿qué hay? Quería saber si hoy vas a venir a la tienda.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_003_Player_001">Quizá más tarde. Tengo el escaneado cerebral, ¿recuerdas?</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_004_Jesse_001">¡Es hoy!</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_005_Player_001">Sabía que se te olvidaría.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_006_Jesse_001">Lo siento. La próxima vez, mándame un correo. ¡Ya sabes que estas cosas las necesito por escrito!</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_007_Player_001">¿Sabes que vendemos calendarios? Deberías comprarte uno.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_008_Jesse_001">Tengo uno. Solo que... nunca apunto nada.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_009_Player_001">Quizá me pase más tarde. Depende de lo que tarde lo del escáner.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_010_Jesse_001">Genial. Le diré a Chris que me ayude. Hoy llega un nuevo empleado. A lo mejor te quieres pasar a saludar.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_011_Player_001">Un sustituto para Ashley. Qué rapidez.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_012_Jesse_001">No es cierto. Hemos estado cortos de personal durante varias semanas, ya lo sabes.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_013_Player_001">Supongo que ya ha pasado un tiempo...</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_014_Jesse_001">Sí. Ya ha pasado un mes.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_015_Jesse_001">Bueno, vete al escáner. Espero que tengas buenas noticias del doctor o lo que sea. Ven a la tienda, saluda al nuevo y la comida corre de mi parte.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_016_Player_001">Gracias, Jesse. Te lo agradezco mucho.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_017_Jesse_001">No quiero tener que sustituir a otro empleado.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_018_Player_001">Eso no tiene gracia.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_019_Jesse_001">Tiene un poco de gracia.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_020_Player_001">No, no la tiene. Adiós, Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_021_Jesse_001">Hasta luego.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_03_laboratory">
        <Entry Name="general_1_arriving_001_player_001">¿Hola? ¿Doctor Munshi?</Entry>
        <Entry Name="general_2_lockeddoor0_001_player_001">Es aquí, ¿verdad? Debe de ser.</Entry>
        <Entry Name="general_2_lockeddoor1_001_player_001">¿Doctor Munshi? ¿Hay alguien aquí? ¡¿Hola?!</Entry>
        <Entry Name="general_2_lockeddoor2_001_player_001">Vale, necesitamos un código.</Entry>
        <Entry Name="General_3_TryExit0_001_Player_001">Todavía no puedo rendirme.</Entry>
        <Entry Name="General_3_TryExit1_001_Player_001">Todavía no, puedo descubrirlo.</Entry>
        <Entry Name="General_3_TryExit2_001_Player_001">Tiene que haber una manera de entrar en el laboratorio.</Entry>
        <Entry Name="General_4_TurnOnLights_001_Player_001">¿Dónde está todo el mundo? Pensé que habría mucha gente en este lugar.</Entry>
        <Entry Name="General_7_GreetDavid_001_David_001">Oh, ¡hola! No te había oído llegar. Simon Jarrett, ¿verdad?</Entry>
        <Entry Name="General_7_GreetDavid_002_Player_001">¿Doctor Munshi?</Entry>
        <Entry Name="General_7_GreetDavid_003_David_001">Solo Sr. Munshi, pero estoy trabajando en ello. Lo cierto es que tú me estás ayudando a conseguirlo.</Entry>
        <Entry Name="General_7_GreetDavid_004_Player_001">¿Esto forma parte de tu tesis?</Entry>
        <Entry Name="General_7_GreetDavid_005_David_001">Sí, es un estudio que estoy haciendo con mi compañero Paul Berg. Esperamos diseñar una manera no agresiva de trabajar en la reconstrucción cerebral. Para ayudar a gente como tú.</Entry>
        <Entry Name="General_7_GreetDavid_006_David_001">¿Te has tomado el líquido de contraste?</Entry>
        <Entry Name="General_7_GreetDavid_007_Player_001">Sí.</Entry>
        <Entry Name="General_7_GreetDavid_008_David_001">Estupendo. Cuando estés listo, podemos empezar.</Entry>
        <Entry Name="General_8_InteractDavid1_001_Player_001">Y... ¿qué es lo que estamos haciendo, exactamente?</Entry>
        <Entry Name="General_8_InteractDavid1_002_David_001">Vamos a escanear tu cerebro. Después vamos a construir un modelo computarizado con él y vamos a bombardearlo con estímulos. El programa nos ayudará a iterar rápidamente tu plan de tratamiento hasta perfilarlo completamente. En resumen: vamos a crear el tratamiento perfecto para ti.</Entry>
        <Entry Name="General_8_InteractDavid1_003_Player_001">Entonces, ¿no es solo un estudio? ¿Esto me puede ayudar?</Entry>
        <Entry Name="General_8_InteractDavid1_004_David_001">Eso espero. De lo contrario, esto sería una auténtica pérdida de tiempo.</Entry>
        <Entry Name="General_8_InteractDavid2_001_Player_001">Sabes que tengo una enfermedad grave, ¿verdad? ¿Sabes lo del accidente? ¿Lo de que me quedan X meses de vida?</Entry>
        <Entry Name="General_8_InteractDavid2_002_David_001">Sí, lo sé. Debe de ser duro tener que escuchar algo así. Como sabes, tu cerebro empieza a sangrar de vez en cuando porque está muy debilitado...</Entry>
        <Entry Name="General_8_InteractDavid2_003_Player_001">... y si alguna vez empeora considerablemente, moriré.</Entry>
        <Entry Name="General_8_InteractDavid2_004_David_001">Bueno, probablemente no podamos restablecer completamente tu cerebro, pero seguramente podamos transformar esos X meses en años. Incluso en décadas. Si te cuidas y no haces ninguna locura, probablemente consigamos que vivas más que todos nosotros.</Entry>
        <Entry Name="general_8_interactdavid3_001_player_001">Espero que tengas razón.</Entry>
        <Entry Name="general_8_interactdavid3_002_david_001">Yo también. Esto podría marcar un antes y un después en el tratamiento del daño cerebral.</Entry>
        <Entry Name="general_8_interactdavid3_003_david_001">¿Qué me dices? ¿Seguimos adelante?</Entry>
        <Entry Name="general_8_interactdavid3_004_player_001">Por supuesto, empecemos.</Entry>
        <Entry Name="general_8_interactdavid3_005_david_001">Toma asiento.</Entry>
        <Entry Name="General_10_SitDown_001_David_001">De acuerdo. Primero, vamos a quitarnos de encima el papeleo. Eres Simon Jarrett, ¿correcto?</Entry>
        <Entry Name="General_10_SitDown_002_Player_001">Correcto.</Entry>
        <Entry Name="General_10_SitDown_003_David_001">Toronto, Canadá. David Munshi...</Entry>
        <Entry Name="General_10_SitDown_004_David_001">¿Naciste el 16 de julio de 1988?</Entry>
        <Entry Name="General_10_SitDown_005_Player_001">Correcto.</Entry>
        <Entry Name="General_10_SitDown_006_David_001">Neurógrafo plano versión seis.</Entry>
        <Entry Name="General_10_SitDown_007_David_001">Bien. Todos los archivos están en orden.</Entry>
        <Entry Name="General_10_SitDown_008_Player_001">¿Me va a doler?</Entry>
        <Entry Name="General_10_SitDown_009_David_001">No es más que un escáner. Duele tanto como hacerte una foto.</Entry>
        <Entry Name="General_11_GogglesOn_001_Player_001">Los indios pensaban que las cámaras podían robarles el alma.</Entry>
        <Entry Name="General_11_GogglesOn_002_David_001">¿De veras? Bueno, esperemos que estén equivocados.</Entry>
        <Entry Name="General_11_GogglesOn_003_David_001">¿Preparado? ¡Di &quot;patataaa&quot;!</Entry>
        <Entry Name="general_13_davidreminder_0_001_david_001">Toma asiento, por favor.</Entry>
        <Entry Name="General_13_DavidReminder_1_001_David_001">Toma asiento y enseguida acabamos.</Entry>
        <Entry Name="General_14_LeaveRoom_0_001_David_001">No te muevas. Hay agujas y otras cosas por todas partes.</Entry>
        <Entry Name="General_14_LeaveRoom_1_001_David_001">¿Qué te parece si empezamos con el escaneado?</Entry>
        <Entry Name="General_14_LeaveRoom_2_001_David_001">Date prisa. No tenemos todo el día.</Entry>
        <Entry Name="general_7_greetdavidfirst_001_player_001">¿David Munshi?</Entry>
        <Entry Name="General_15_PowerSwitchMessage_001_David_001">Por favor, no toques nada.</Entry>
        <Entry Name="General_15_PowerSwitchMessage_002_David_001">Siéntate y empecemos.</Entry>
        <Entry Name="General_15_PowerSwitchMessage_003_David_001">Venga, vamos a hacerlo.</Entry>
        <Entry Name="General_8_InteractDavid4_001_David_001">Cuando estés listo...</Entry>
        <Entry Name="General_8_InteractDavid4_002_David_001">Toma asiento.</Entry>
        <Entry Name="General_8_InteractDavid4_003_David_001">Que empiece el espectáculo.</Entry>
        <Entry Name="general_2_lockeddoor0_noanswer_001_player_001">Genial, tiene el teléfono desconectado.</Entry>
        <Entry Name="general_2_lockeddoor0_noanswer_002_player_001">No pasa nada. Puedo apañármelas.</Entry>
        <Entry Name="general_2_lockeddoor0_dialing_001_player_001">Vamos a llamar rápidamente a Munshi.</Entry>
        <Entry Name="comment_3_tryexitaftermunshi_001_player_001">Debería hacerme el escaneado antes de marcharme.</Entry>
        <Entry Name="comment_3_tryexitaftermunshi_002_player_001">Total, ya me estoy muriendo. No creo que el escáner de Munshi pueda empeorar las cosas.</Entry>
        <Entry Name="comment_3_tryexitaftermunshi_003_player_001">Todavía no puedo marcharme, Munshi me está esperando para hacer el escaneado.</Entry>
        <Entry Name="comment_3_codewithouthint_001_player_001">¡Ah, lo he adivinado! Es increíble.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_01_01_upsilon_awake">
        <Entry Name="general_1a_wakeup_001_player_001">¿Qué ha pasado?</Entry>
        <Entry Name="general_1a_stumblingindark_001_player_001">¿Hola? ¿Sr. Munshi?</Entry>
        <Entry Name="general_1a_stumblingindark_002_player_001">¿Ha ido mal algo?</Entry>
        <Entry Name="general_1a_stumblingindark_003_player_001">Esto no tiene gracia.</Entry>
        <Entry Name="general_1a_stumblingindark_004_player_001">No debería meterme en...</Entry>
        <Entry Name="general_1a_stumblingindark_005_player_001">... esto me está estresando.</Entry>
        <Entry Name="general_1a_stumblingindark_006_player_001">¡Hola! ¿Hay alguien?</Entry>
        <Entry Name="General_1B_PowerOn_BeforeCollapse_001_Player_001">¿Qué lugar es este? ¿Cómo he llegado aquí?</Entry>
        <Entry Name="General_1B_PowerOn_StandUp_001_Player_001">Puedo averiguarlo. Solo necesito tranquilizarme. No hace falta empeorar las cosas.</Entry>
        <Entry Name="datamine_2b_datamineairlockintercom_001_amy_001">Carl, está funcionando mejor de lo esperado. Les está costando mucho abrir las puertas.</Entry>
        <Entry Name="datamine_2b_datamineairlockintercom_002_carl_001">Bueno, mejor sella permanentemente todas las que puedas. Es mejor no correr riesgos.</Entry>
        <Entry Name="datamine_2b_datamineairlockintercom_003_amy_001">Recibido. ¿Has cortado el suelo de la fábrica?</Entry>
        <Entry Name="datamine_2b_datamineairlockintercom_004_carl_001">Todo hecho. Esto los mantendrá alejados prácticamente a todos. Voy a cerrar el centro de comunicaciones.</Entry>
        <Entry Name="datamine_2b_datamineairlockintercom_005_amy_001">Pero asegúrate de dejar una salida.</Entry>
        <Entry Name="datamine_2b_datamineairlockintercom_006_carl_001">Confía en mí: te llevaré a Zeta sana y salva. Solo tenemos que asegurarnos de dejar suficiente potencia activada para no tener que regresar.</Entry>
        <Entry Name="datamine_2b_datamineairlockintercom_007_amy_001">Comprendido. Nos vemos en el campamento.</Entry>
        <Entry Name="datamine_2c_dataminesemiinfectedrobot_001_semiinfectedrobot_001">*Respira mal*</Entry>
        <Entry Name="datamine_2c_dataminesemiinfectedrobot_002_amy_001">Eh, tú. ¿Sabes hablar? ¿Puedes hablar como los otros?</Entry>
        <Entry Name="datamine_2c_dataminesemiinfectedrobot_003_semiinfectedrobot_001">*Respira mal*</Entry>
        <Entry Name="datamine_2c_dataminesemiinfectedrobot_004_amy_001">¿Por qué estás así?</Entry>
        <Entry Name="datamine_2c_dataminesemiinfectedrobot_005_semiinfectedrobot_001">*Respira mal*</Entry>
        <Entry Name="datamine_2c_dataminesemiinfectedrobot_006_amy_001">¿Quieres un poco de gel estructural? Sí, que raro. No tiene ningún sentido.</Entry>
        <Entry Name="datamine_2c_dataminesemiinfectedrobot_007_semiinfectedrobot_001">*Respira mal*</Entry>
        <Entry Name="datamine_2c_dataminesemiinfectedrobot_008_amy_001">Voy a apagarte, ¿vale? Sí, me pones los pelos de punta así que voy a apag-</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_001_SuitRobot_001">Mantenlas cerradas, que no entren.</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_002_SuitRobot_001">No reconozco este lugar. Parece Pathos-II, pero no es ningún lugar en el que he estado antes.</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_003_SuitRobot_001">Di algo, Vanessa. ¿Has cerrado las puertas? Deberíamos mantenerlas cerradas.</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_004_SuitRobot_001">Todo se está volviendo borroso. Será una especie de ataque, pero nunca había sentido algo así.</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_005_SuitRobot_001">Veo algo, algo diferente. No es Lambda, de eso no hay duda.</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_006_SuitRobot_001">No reconozco este lugar. ¿Todavía estamos en Pathos-II?</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_007_SuitRobot_001">Llévame de vuelta a Lambda. Subamos a la Curie, subamos a la Curie y olvidemos todo esto.</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_008_SuitRobot_001">El alcantarillado negruzco del WAU. Es lo que quieren.</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_009_SuitRobot_001">Ciérrala, ciérralas todas. Las puertas están en nuestro lado.</Entry>
        <Entry Name="Datamine_2I_SuitRobotRambling_010_SuitRobot_001">¿Esto es Úpsilon? Eso tendría sentido.</Entry>
        <Entry Name="datamine_2i_suitrobotcallsout_005_suitrobot_001">¡Por favor, no te vayas! ¡Tengo miedo!</Entry>
        <Entry Name="Datamine_2I_SimonConfrontSuitRobot_001_Player_001">¿A ti qué te pasa?</Entry>
        <Entry Name="Datamine_2I_SuitRobotScaredOfEnemy_001_SuitRobot_001">¡Por Dios! Viene a por nosotros. No quiero estar aquí. Por favor. Vanessa. No, no, no pienses en Vanessa. La alcanzará a ella también.</Entry>
        <Entry Name="Datamine_2I_SuitRobotScaredOfEnemy_002_SuitRobot_001">¡Lárgate! Yo no te he hecho nada. Esto no es culpa mía. Es el WAU. Échale la culpa al WAU.</Entry>
        <Entry Name="Datamine_2J_SuitRobotDies_001_SuitRobot_001">¡No! ¡No, no es justo! ¡He sobrevivido! Aaah, no--</Entry>
        <Entry Name="Datamine_2J_SuitRobotDatamine_001_SuitRobot_001">¡No! ¡No es justo! ¡He sobrevivido! ¡Aargh!</Entry>
        <Entry Name="Datamine_2J_SuitRobotDatamine_002_SuitRobot_001">*ruido del robot del traje que está siendo despedazado*</Entry>
        <Entry Name="General_2K_OmniToolNotConfigured_001_AutomatedVoice_001">Acceso denegado. Formato incorrecto.</Entry>
        <Entry Name="General_2M_OmniToolFixed_001_AutomatedVoice_001">Acceso permitido.</Entry>
        <Entry Name="Datamine_2J_SuitRobotDrained_001_SuitRobot_001">¡No, nooo! Por favor... ¡Quiero vivir!</Entry>
        <Entry Name="Datamine_2J_SuitRobotDatamineDrained_001_SuitRobot_001">¡No, nooo! Por favor... Quiero vivir.</Entry>
        <Entry Name="Datamine_2J_SuitRobotDatamineDrained_002_SuitRobot_001">*Sonido de Simon luchando con la flor del WAU mientras el robot del traje exhala y muere*</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_001_carl_001">Amy, ¿estás ahí?</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_002_amy_001">Estoy aquí.</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_003_carl_001">¿Lista para dejarlo ir?</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_004_amy_001">Supongo.</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_005_carl_001">Ya habrá más oportunidades de adoptar el rollo zen con los peces al volver a Zeta.</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_006_amy_001">Voy a echar de menos este lugar.</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_007_carl_001">¿Úpsilon?</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_008_amy_001">Venga ya, hemos trabajado muchos años aquí. ¿Tú no lo vas a echar de menos, ni siquiera un poco?</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_009_carl_001">¿Una central energética llena de máquinas psicóticas? Creo que sobreviviré...</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_010_amy_001">Qué insensible. No es culpa de Úpsilon que haya sido invadido.</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_011_carl_001">Como quieras, pero sella esa cosa y vuelve ahora mismo al campamento.</Entry>
        <Entry Name="datamine_3b_datamineamyintercom_012_amy_001">Recibido.</Entry>
        <Entry Name="Datamine_3F_TalkingDoor_001_TalkingDoor_001">No lo entiendo.</Entry>
        <Entry Name="Datamine_3F_TalkingDoor_002_TalkingDoor_001">¿Puedes ayudar?</Entry>
        <Entry Name="Datamine_3F_TalkingDoor_003_TalkingDoor_001">No lo sé, no sé qué ha pasado.</Entry>
        <Entry Name="Datamine_3F_TalkingDoor_004_TalkingDoor_001">Solo necesito volver.</Entry>
        <Entry Name="Datamine_3F_TalkingDoor_005_TalkingDoor_001">Tienes que ayudarme.</Entry>
        <Entry Name="Datamine_3F_TalkingDoorCloses_001_TalkingDoor_001">...</Entry>
        <Entry Name="Datamine_3F_TalkingDoorWeeps_001_TalkingDoor_001">Quédate, quédate, quédate. Quédate, quédate, quédate, quédate.</Entry>
        <Entry Name="Datamine_3F_TalkingDoorWeeps_002_TalkingDoor_001">Todo irá bien. Todo irá bien. Todo saldrá bien.</Entry>
        <Entry Name="Datamine_3F_TalkingDoorWeeps_003_TalkingDoor_001">Tú en lugar de mí. Tú en lugar de mí.</Entry>
        <Entry Name="Datamine_3F_TalkingDoorWeeps_004_TalkingDoor_001">Todo va bien. Todo va bien.</Entry>
        <Entry Name="Datamine_3F_TalkingDoorWeeps_005_TalkingDoor_001">Quédate aquí. Quédate. Quédate aquí. Quédate.</Entry>
        <Entry Name="Datamine_3F_TalkingDoorWeeps_006_TalkingDoor_001">En lugar de mí. En lugar de mí.</Entry>
        <Entry Name="Datamine_3F_TalkingDoorWeeps_007_TalkingDoor_001">Todo está bien. Todo está bien.</Entry>
        <Entry Name="Datamine_3G_TalkingDoorButton_001_TalkingDoor_001">¡Aléjate de mí!</Entry>
        <Entry Name="Datamine_3G_TalkingDoorButton_002_TalkingDoor_001">¡Déjame en paz!</Entry>
        <Entry Name="Datamine_3G_TalkingDoorButton_003_TalkingDoor_001">¡Basta!</Entry>
        <Entry Name="Datamine_2I_InteractAfterDoorBang_001_Player_001">¿Qué es eso? ¿Qué está pasando?</Entry>
        <Entry Name="Datamine_2I_InteractAfterDoorBang_002_SuitRobot_001">Mantén cerrada esa puerta.</Entry>
        <Entry Name="Datamine_2J_SuitRobotSeeCorpse_001_Player_001">¡Dios mío! Yo no quería que pasara eso.</Entry>
        <Entry Name="datamine_3a_entertunnel_001_player_001">¿Qué... dónde estoy?</Entry>
        <Entry Name="Datamine_3C_ReadAmyNotes_001_Player_001">Esto no tiene sentido alguno. ¿Quién es esta gente?</Entry>
        <Entry Name="Datamine_OrientationVideo_1_001_Strohmeier_001">Ya sé que te dijeron que los técnicos de campo tendrían acceso total por todo Pathos-II. Pero yo estoy aquí para decirte que eso no va a suceder.</Entry>
        <Entry Name="Datamine_OrientationVideo_1_002_Strohmeier_001">No me malinterpretes... No quiero entrometerme en vuestro camino, os necesitamos para mantener este lugar en marcha, pero al menos tiene que haber cierto nivel de seguridad con estas cosas.</Entry>
        <Entry Name="Datamine_OrientationVideo_2_001_Strohmeier_001">No quiero enterarme de que te has colado en un área en cuarentena de Ómicron y de que has infestado el lugar con algún virus o con lo que sea que estén haciendo allí.</Entry>
        <Entry Name="Datamine_OrientationVideo_3_001_Strohmeier_001">Esto es lo que puedes hacer: podrás usarlo para abrir puertas, básicamente todas las puertas. Si no puedes, significa que algo va mal o que alguien no quería que entraras ahí. Y entonces, ¿qué haces?</Entry>
        <Entry Name="Datamine_OrientationVideo_4_001_Strohmeier_001">Mete ese Omnitool en un terminal, a ver si encuentras la manera de hacerlo. A veces, vas a tener que entrar en lugares en los que no deberías estar.</Entry>
        <Entry Name="Datamine_OrientationVideo_4_002_Strohmeier_001">Tienes que encontrar la manera, por el amor de Dios, para eso eres ingeniero.</Entry>
        <Entry Name="Datamine_OrientationVideo_5_001_Strohmeier_001">¿Qué más? Cuida tu equipamiento. No seas un capullo. Eso es todo, básicamente. Me llamo John Strohmeier, agente de seguridad de Pathos-II.</Entry>
        <Entry Name="Datamine_OrientationVideo_5_002_Strohmeier_001">Tengo un despacho en Zeta. Ven a verme si tienes algún asunto que no puedas resolver. Buena suerte.</Entry>
        <Entry Name="Datamine_3F_TalkingDoorDrains_001_TalkingDoor_001">¡No, para, para!</Entry>
        <Entry Name="general_pickingupomnitool_001_player_001">Esto me lo voy a quedar. Tengo la sensación de que me vendrá bien.</Entry>
        <Entry Name="General_ReactingToOmnitool_001_Player_001">¿Qué hace? ¿Está reaccionando a algo aquí cerca?</Entry>
        <Entry Name="general_omnitoolopensdoor_001_player_001">Es un abrepuertas. Por supuesto.</Entry>
        <Entry Name="general_helperjaneplugin_001_helperjane_001">Consola de mantenimiento Úpsilon 3, incluyendo asiento de piloto, activada.</Entry>
        <Entry Name="general_helperjaneplugtoolchipfound_001_helperjane_001">Chip de herramientas encontrado.</Entry>
        <Entry Name="general_helperjaneupdatetoolchip_001_helperjane_001">Código de seguridad del chip de herramientas actualizado.</Entry>
        <Entry Name="General_SimonHurt_001_Player_001">Mierda...</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_01_02_upsilon_inside">
        <Entry Name="ControlRoomContact_2D_FirstContact_1_001_Catherine_001">Oh, ¿qué... qué está sucediendo? ¿Hola? ¿Hay alguien ahí?</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_002_Player_001">Eh, eh, ¿me oyes?</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_003_Catherine_001">Te oigo... oh... Úpsilon. ¿Qué está ocurriendo?</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_004_Player_001">No tengo ni idea. Me he despertado aquí.</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_005_Catherine_001">¿En la sala, ahora?</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_006_Player_001">Oh... era una especie de asiento, ¿con un casco?</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_007_Catherine_001">¿De veras? ¿Cómo te llamas?</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_008_Player_001">Soy Simon Jarrett.</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_009_Catherine_001">¿Y qué es lo que...? Oh, la señal está... malditos relés. ¿Dónde estás ahora?</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_010_Player_001">En alguna parte que tiene que ver con la energía eléctrica, no sé si es una planta o un transformador...</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_011_Catherine_001">Debes de estar en algún lugar de la planta térmica.</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_012_Catherine_001">Deberías ir arriba, al centro de comunicaciones. Es la sala con el techo abovedado.</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_013_Player_001">Eh, mira este lugar no es... Aquí hay algo que no cuadra, algo falla. ¿Hola?</Entry>
        <Entry Name="ControlRoomContact_2D_FirstContact_1_014_Catherine_001">Lo siento, no te he oído bien, hemos perdido otro relé. Escucha, dirígete al centro de comunicación en el piso de arriba. Yo esperaré aquí.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructPlea_2_001_CarlConstruct_001">¿Quién anda ahí?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructPlea_2_002_CarlConstruct_001">Te oigo moverte.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructPlea_2_003_CarlConstruct_001">Me vendría bien un poco de ayuda.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructPlea_2_004_CarlConstruct_001">¿Qué estáis haciendo?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_1_001_Player_001">¿Qué es lo que eres tú?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_1_002_CarlConstruct_001">¿Estás ciego? Soy yo, Carl. Carl Semken ¿Reparador? ¿Algo de esto te resulta familiar?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_1_003_Player_001">Yo... No, en realidad no.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_1_004_CarlConstruct_001">Bueno, gracias por tu gran ayuda. Tampoco es que esté en el suelo después de haberme desmayado, o algo.</Entry>
        <Entry Name="carlblackbox_4c_carlblackbox_001_carl_001">¿Has puesto en marcha los últimos turbos de refuerzo?</Entry>
        <Entry Name="carlblackbox_4c_carlblackbox_002_amy_001">Todo está equilibrado, hemos compensado la apuesta en la medida de lo posible.</Entry>
        <Entry Name="carlblackbox_4c_carlblackbox_003_carl_001">Eso es. Energía suficiente para alimentar Pathos-II hasta el siguiente apocalipsis. Estamos listos.</Entry>
        <Entry Name="CarlBlackBox_4C_CarlBlackBox_004_Amy_001">Espero que no hayamos estropeado nada. No quiero tener que volver aquí otra vez.</Entry>
        <Entry Name="CarlBlackBox_4C_CarlBlackBox_005_Carl_001">Calma, se acabó. Nos vamos a Zeta.</Entry>
        <Entry Name="CarlBlackBox_4C_CarlBlackBox_006_Amy_001">Quizá deberíamos sellar más bloques. No confío en que los asistentes dejen en paz este lugar.</Entry>
        <Entry Name="CarlBlackBox_4C_CarlBlackBox_007_Carl_001">Lo hemos sellado todo, todo, desde los barracones hasta el centro de comunicaciones. Si alguien vuelve a pisar este lugar, lo tendrán muy difícil para despl-</Entry>
        <Entry Name="CarlBlackBox_4C_CarlBlackBox_008_Amy_001">¡Carl!</Entry>
        <Entry Name="CarlBlackBox_4C_CarlBlackBox_009_Carl_001">Corre.</Entry>
        <Entry Name="CarlBlackBox_SimonReadCarlBlackBox_001_Player_001">¿Qué estabas haciendo aquí?</Entry>
        <Entry Name="amyblackbox_simonreadamyblackbox_001_player_001">WAU, ¿qué nombre es ese?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_001_Catherine_001">Ah, eso está mejor. Simon, ¿verdad?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_002_Player_001">Jarrett. Simon Jarrett.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_003_Catherine_001">Hola Simon, Soy Catherine. ¿Ya has averiguado qué está pasando?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_004_Player_001">¿Yo? Esperaba que tú tuvieras respuestas.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_005_Catherine_001">Probablemente tenga algunas. ¿Qué es lo que quieres saber?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_006_Player_001">No sé por dónde empezar... Veamos, ¿qué lugar es este? ¿Cómo he llegado aquí? Y ¿por qué los robots hablan como si fueran personas?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_007_Catherine_001">Bueno, obviamente estás en Úpsilon. ¿Nunca habías estado ahí? ¿Dónde trabajabas?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_008_Player_001">El Grimorio, en Toronto. ¿Eso es importante?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_009_Catherine_001">No, me refiero a dónde trabajabas en Pathos-II...</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_010_Player_001">¡Yo no sé qué es eso!</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_011_Catherine_001">Vaya, esto no me lo esperaba. ¿Viniste directamente desde Toronto?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_012_Player_001">Sí. Y yo tampoco me esperaba esto.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_013_Catherine_001">¿Has visto a alguien? ¿Personal o técnicos de campo?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_1_014_Player_001">Solo robots. Unos robots lunáticos.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_3_001_Player_001">¿Qué ha sido eso? ¡Aaah!</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_3_002_Catherine_001">¿Qué está ocurriendo?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_3_003_Player_001">Creo que este lugar está a punto de derrumbarse. ¿¡Qué hago!?</Entry>
        <Entry Name="CommRoomContact_CommRoomSimonCall_001_Player_001">Eh, ¿estás ahí? He encontrado el techo abovedado.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_4_001_Catherine_001">¡Simon, ven a Lambda!</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_4_002_Player_001">¡¿Cómo llego hasta ahí?!</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_4_003_Catherine_001">Hay trenes lanzadera que conectan todos los centros. ¡Encuentra uno y ven! ¡Te estaré esperando!</Entry>
        <Entry Name="SimonComments_LowerDoorLeverFail_001_Player_001">No parece estar conectada.</Entry>
        <Entry Name="ControlRoomBody_2A_ControlRoomBodyMoans_001_ControlRoomBody_001">*Respira lento*</Entry>
        <Entry Name="ControlRoomBody_2A_ControlRoomBodyMoans_002_ControlRoomBody_001">*Respira lento*</Entry>
        <Entry Name="ControlRoomBody_2A_ControlRoomBodyMoans_003_ControlRoomBody_001">*Respira lento*</Entry>
        <Entry Name="ControlRoomBody_2A_ControlRoomBodyMoans_004_ControlRoomBody_001">*Respira lento*</Entry>
        <Entry Name="ControlRoomBody_2A_ControlRoomBodyDies_001_ControlRoomBody_001">¡Lo necesito!</Entry>
        <Entry Name="ControlRoomBody_2A_ControlRoomBodyDies_002_ControlRoomBody_001">¿Por qué? Estaba bien. Era feliz.</Entry>
        <Entry Name="CarlConstruct_4A_CarlIntroductionShout_001_CarlConstruct_001">Ay, mierda... Esto no está bien. Me desmayé. ¿Amy? ¡¿Rogers?! ¡¿Estáis oyendo esto?! Me vendría bien un poco de ayuda.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructVisible_1_001_CarlConstruct_001">¿Qué demonios te ha pasado?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructVisible_2_001_CarlConstruct_001">¿Qué le pasa a tu... a todo? ¿Te has ido a nadar por una alcantarilla o algo así?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructVisible_2_002_CarlConstruct_001">Hola, ¿me oyes? ¿Me oyes? Soy yo, Carl, llamando desde el suelo... ¿a tu lado?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_001_CarlConstruct_001">¿Necesitas algo?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_002_CarlConstruct_001">Por si no te habías dado cuenta, necesito ayuda.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_003_CarlConstruct_001">¿Te has perdido o algo así?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_004_CarlConstruct_001">¿Te importaría echarme una mano?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_005_CarlConstruct_001">¿Qué demonios estás haciendo?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_2_001_Player_001">¿Eres un ser humano?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_2_002_CarlConstruct_001">Mierda, ¿me ha delatado mi cuerpo? Me esfuerzo mucho por seguir siendo un misterio. Sí, soy un ser humano. ¿Y tú?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_2_003_Player_001">Me llamo Simon. ¿Sabes algo sobre este lugar?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_2_004_CarlConstruct_001">Oh, ¿eres nuevo? Eso hace que esto resulte un poco menos incómodo. Mira, es evidente que estoy herido. Si ves a alguien más por ahí, diles dónde estoy.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_3_001_Player_001">Y ¿dónde estás, exactamente?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_3_002_CarlConstruct_001">¿Estás de coña? Estoy aquí. ¿Me ves cómo saludo? Mira mis manos. Eh, amigo.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_3_003_Player_001">¡Vale, vale! Mira, es que... No lo veo. Veo una máquina, un robot que habla.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_3_004_CarlConstruct_001">¿Adónde demonios estás mirando? Estoy aquí. ¿Lo ves?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_3_005_Player_001">Mm, vale... No esperaba que tuvieras ese aspecto.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_3_006_CarlConstruct_001">Tienes una fijación con las apariencias, ¿lo sabías?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_EndOfSubjects_001_CarlConstruct_001">Si ves a alguien más, diles dónde estoy.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_EndOfSubjects_002_CarlConstruct_001">Me duele mucho. Ve a buscar ayuda.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_EndOfSubjects_003_CarlConstruct_001">Encuentra a alguien que pueda ayudar.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_001_CarlConstruct_001">¡Para! ¡Me duele!</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_002_CarlConstruct_001">Ay, mierda... Joder.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_003_CarlConstruct_001">¡Para, para!</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_004_CarlConstruct_001">Oh, maldita sea.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_005_CarlConstruct_001">Coño...</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_006_CarlConstruct_001">No lo hagas. No lo soporto.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_007_CarlConstruct_001">Me cago en la puta.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_008_CarlConstruct_001">Por favor, no.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_009_CarlConstruct_001">No lo soporto. Por favor.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTorture_010_CarlConstruct_001">Para, por favor.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_PostTorture_001_CarlConstruct_001">Eh, tú, ayuda.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_PostTorture_002_CarlConstruct_001">Por favor, díselo a Amy. Necesito ayuda.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_PostTorture_003_CarlConstruct_001">Estoy muy mal.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructSimonBack_PostTorture_004_CarlConstruct_001">No me puedo mover. Por favor.</Entry>
        <Entry Name="CarlConstruct_CarlConstructSimonLeaves_PostTorture_001_CarlConstruct_001">Por favor. Ve a buscar ayuda.</Entry>
        <Entry Name="CarlConstruct_CarlConstructSimonLeaves_PostTorture_002_CarlConstruct_001">No me dejes morir aquí.</Entry>
        <Entry Name="CarlConstruct_CarlConstructSimonLeaves_PostTorture_003_CarlConstruct_001">Diles a los otros dónde estoy.</Entry>
        <Entry Name="CarlConstruct_CarlConstructSimonLeaves_PostTorture_004_CarlConstruct_001">Necesito ayuda desesperadamente.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_1_001_Player_001">¿Qué es lo que eres tú?</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_posttorture_1_002_carlconstruct_001">¿Estás ciego? Soy yo, Carl. Carl Semken</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_1_003_Player_001">No entiendo lo que está pasando.</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_posttorture_1_004_carlconstruct_001">¿Qué hay que entender? ¡Estoy herido! Necesito ayuda. Trae a Holland.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_1_005_Player_001">¿Quién es Holland?</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_posttorture_1_006_carlconstruct_001">El tipo de las emergencias. Dile a Jonsy que llame a Ómicron.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_2_001_Player_001">Lo siento, creo que he tirado de la palanca equivocada.</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_posttorture_2_002_carlconstruct_001">No te preocupes, pero tráeme a un médico.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_3_001_Player_001">¿No sería más lógico traer a un mecánico?</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_posttorture_3_002_carlconstruct_001">¡¿Ahora vamos a hacer chistes malos?! ¡Tráeme a un médico!</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_4_001_Player_001">¡Pero si eres un robot!</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_posttorture_4_002_carlconstruct_001">¡¿De veras?! ¿Los robots tienen piernas, manos, cara? Estás alucinando.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_4_003_Player_001">Bueno, cálmate. No voy a...</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_posttorture_4_004_carlconstruct_001">Joder, ve a buscar ayuda.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_001_CarlConstruct_001">(grito)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_002_CarlConstruct_001">(grito)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_003_CarlConstruct_001">(grito)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_004_CarlConstruct_001">(grito)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_005_CarlConstruct_001">(grito)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_006_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_007_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_008_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_009_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructBroken_010_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4L_CarlConstructDrain_NoTorture_001_CarlConstruct_001">Por favor, no... No quiero morir.</Entry>
        <Entry Name="CarlConstruct_4L_CarlConstructDrain_Tortured_001_CarlConstruct_001">¿Qué... qué... qué estás haciendo? ¡Para, para! ¡Aggrrr!</Entry>
        <Entry Name="CommRoomContact_CommRoomSite_Theta_001_Strasky_001">...Aquí hay algo mejor... Está aquí...</Entry>
        <Entry Name="CommRoomContact_CommRoomSite_Omicron_001_Ross_001">Acaba con tu vida. No queda nada por lo que vivir.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_FlowControl_001_Player_001">Excepto uno. Creo que dijo que se llamaba Carl. No estaba mal... Pero yo... creo que lo maté accidentalmente al desconectar la energía.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_FlowControl_002_Catherine_001">Oh, bueno... Los robots no sienten nada.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_SuckedCarlPower_001_Player_001">Excepto uno. Yo... Lo maté. No era mi intención hacerlo.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_SuckedCarlPower_002_Catherine_001">Oh, bueno. Esto, pues... intenta que no se vuelva a repetir. Aunque no sea más que un robot, podría resultar útil.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_TorturedCarl_001_Player_001">Excepto uno. Creo que estaba herido. No sé qué hacer.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_TorturedCarl_002_Catherine_001">¿Dijo que estaba herido?</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_TorturedCarl_003_Player_001">Más o menos. No lo sé.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_NoCarlMeeting_001_Catherine_001">Esto es muy extraño.</Entry>
        <Entry Name="CommRoomContact_CommRoomDialog_2_NoCarlMeeting_002_Player_001">Ni que lo digas...</Entry>
        <Entry Name="SimonComments_WaterComment_001_Player_001">Mierda, mierda, mierda... ¿Dónde...? ¿Qué hago...? ¡Oh, joder!</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_1_001_Strasky_001">Jonsy. ¿Cómo va la evacuación?</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_1_002_Jonsdottir_001">Tenemos todo lo que necesitamos trasladar, pero no podemos dejar la planta sin supervisión.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_1_003_Jonsdottir_001">Adams ha decidido dejar a Amy Azzaro y a Carl Semken para que ejecuten el proceso de automatización.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_1_004_Strasky_001">Y apuesto a que estarán encantados.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_1_005_Jonsdottir_001">Solo quería que supieras que vamos según el plan y que mañana hablaré contigo.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_1_006_Strasky_001">De acuerdo, se lo diré a Wolchezk.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_2_001_Strasky_001">Jonsy. Una mañana preciosa para la evacuación, ¿verdad?</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_2_002_Jonsdottir_001">Con eso servirá. Quería presentarte a Amy y a Carl. Ellos se encargarán de hablar en cuanto me marche a Zeta. Saluda.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_2_003_Carl_001">¡Eh, Zeta!</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_2_004_Amy_001">¡Hola!</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_2_005_Strasky_001">Hola chicos, soy Peter Strasky, expedidor de Zeta. Si puedo ayudar en algo, decídmelo.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_2_006_Jonsdottir_001">Supongo que eso es todo. Nos veremos pronto. Cuando lleguemos.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_2_007_Strasky_001">De acuerdo, Jonsy. Buen viaje.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_3_001_Carl_001">Eh... Hola... ¿Zeta?</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_3_002_Strasky_001">Úpsilon. ¿Qué pasa?</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_3_003_Carl_001">Nos vendría muy bien contactar con Heather... Me refiero a Wolchezk, ingeniero de mantenimiento del centro.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_3_004_Strasky_001">Es prácticamente imposible establecer enlaces directos. En este momento, los relés de LUMAR son un desastre. Puedes enviar mensajes a través del centro de comunicaciones y, si quieres, prácticamente estoy siempre aquí, listo para comunicar cualquier cosa a mano. Ya sé que el sistema es una mierda, pero en este momento es lo único que funciona.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_3_005_Carl_001">Vale, tendremos que apañárnoslas. Hasta luego.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_4_001_Carl_001">Hola... Peter, ¿verdad?</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_4_002_Strasky_001">Estoy aquí. ¿Qué pasa?</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_4_003_Carl_001">Vamos a salir. Solo quería decirte que voy a sellar ahora el centro de comunicaciones, así que esta es la última noticia que tendrás de nosotros. Si no hemos aparecido dentro de un par de horas, manda a la caballería.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_4_004_Strasky_001">Espera, ¿qué está pasando? El plan sigue siendo el mismo, ¿verdad?</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_4_005_Carl_001">Sí, iremos a la lanzadera para viajar directamente a Zeta.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_4_006_Strasky_001">Vale. Voy a juntar a las tropas para una fiesta de bienvenida.</Entry>
        <Entry Name="CommRoomRecording_CommRoomRecording_4_007_Carl_001">Así me gusta.</Entry>
        <Entry Name="ControlRoomBody_2A_DetachTentacle_001_ControlRoomBody_001">No.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_4_001_Player_001">¿Cómo es que estás herido?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_4_002_CarlConstruct_001">No lo sé. Perdí el conocimiento. No recuerdo cómo llegué aquí.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_4_003_Player_001">¿Qué es lo que recuerdas?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_4_004_CarlConstruct_001">Estaba en el asiento de piloto, controlando remotamente a un AU...</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_4_005_Player_001">¿AU?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_4_006_CarlConstruct_001">Asistente universal. Un robot, como estas cosas, pero más vivaracho. Bueno, la cosa es que estaba con unos escudos térmicos y... Eso es lo último que recuerdo.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_5_001_Player_001">¿Estabas manejando un robot por control remoto?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_5_002_CarlConstruct_001">Lo hacemos siempre. Los robots no tienen la consciencia necesaria para hacer ciertas cosas. La placa base no tiene intuición, ¿entiendes?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_5_003_Player_001">¿Es posible que te hayas quedado atrapado en el robot?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_5_004_CarlConstruct_001">Tu mente está muy conectada al asistente, pero no. Bastante improbable...</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_6_001_Player_001">Escucha, no quiero alarmarte, pero creo que podrías estar atrapado dentro de un robot.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_6_002_CarlConstruct_001">Y yo te digo que vayas al oculista. Estoy aquí. Me veo las dos manos, los dos pies... Cuando controlas a un asistente por control remoto, lo único que ves es una imagen de vídeo desde la unidad asistente. Tu cuerpo no aparece para nada en la imagen.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_EndOfSubjects_001_CarlConstruct_001">Ve a decírselo a los demás.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_EndOfSubjects_002_CarlConstruct_001">No me toques.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructTalk_PostTorture_EndOfSubjects_003_CarlConstruct_001">Tráeme a Holland.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_001_CarlConstruct_001">¿Por qué?</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_002_CarlConstruct_001">No puedo.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_003_CarlConstruct_001">No lo hagas.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_004_CarlConstruct_001">Ayuda.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_005_CarlConstruct_001">Ahora no.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_006_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_007_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_008_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_009_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructDeathSob_010_CarlConstruct_001">(sollozo)</Entry>
        <Entry Name="CarlConstruct_4D_RobotDatamine_001_Carl_001">Lo hemos sellado todo, todo, desde los barracones hasta el centro de comunicaciones. Si alguien vuelve a pisar este lugar, lo tendrán muy difícil para despl--</Entry>
        <Entry Name="CarlConstruct_4D_RobotDatamine_002_Amy_001">¡Carl!</Entry>
        <Entry Name="CarlConstruct_4D_RobotDatamine_003_Carl_001">Corre.</Entry>
        <Entry Name="CarlConstruct_4D_RobotDatamine_004_Amy_001">¡Aléjate de mí, coño!</Entry>
        <Entry Name="CarlConstruct_4D_RobotDatamine_005_Amy_001">Hijo de la gran puta.</Entry>
        <Entry Name="CarlConstruct_4E_CarlConstructPlea_1_001_CarlConstruct_001">Amy, ¿eres tú? ¿Qué ha pasado con el asiento de piloto?</Entry>
        <Entry Name="simoncomments_carlbody_seebody_001_player_001">Oh, ¿está muerto? Está muerto.</Entry>
        <Entry Name="simoncomments_2a_lookatjonsi_001_player_001">¿Qué es eso? ¿Qué hace?</Entry>
        <Entry Name="simoncomments_2a_talktojonsi_001_player_001">Eh, eh, ¿me oyes?</Entry>
        <Entry Name="simoncomments_2a_talktojonsi_002_player_001">¡Hola!</Entry>
        <Entry Name="simoncomments_2a_talktojonsi_003_player_001">Eh, tú...</Entry>
        <Entry Name="simoncomments_2a_talktojonsi_004_player_001">Hola....</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_postbreakingpoint_endofsubjects_001_player_001">¿Estás bien?</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_postbreakingpoint_endofsubjects_002_player_001">¿Hola?</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_postbreakingpoint_endofsubjects_003_player_001">¿Me oyes?</Entry>
        <Entry Name="carlconstruct_4e_carlconstructtalk_postbreakingpoint_endofsubjects_004_player_001">Eh.</Entry>
        <Entry Name="simoncomments_2a_talktojonsi_dead_001_player_001">No, no era mi intención...</Entry>
        <Entry Name="simoncomments_2a_talktojonsi_dead_002_player_001">Lo siento mucho.</Entry>
        <Entry Name="simoncomments_2a_talktojonsi_dead_003_player_001">Tenía que arreglar esta cosa...</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_01_03_upsilon_outside">
        <Entry Name="RobotTalk_Scavenge_Idle_001_ScavengeRobot_001">Está tan vacío...</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_002_ScavengeRobot_001">Todo el mundo se ha ido.</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_003_ScavengeRobot_001">¿Cuánto tiempo ha pasado?</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_004_ScavengeRobot_001">Me siento agotado.</Entry>
        <Entry Name="robottalk_scavenge_idle_005_scavengerobot_001">Los echo tanto de menos...</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_006_ScavengeRobot_001">¿Cómo puedes tener tanta sed? Más seco que un puto desierto.</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_007_ScavengeRobot_001">Tiene que haber gel por aquí.</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_008_ScavengeRobot_001">No me siento muy bien.</Entry>
        <Entry Name="robottalk_scavenge_idle_010_scavengerobot_001">¿Cómo he llegado aquí?</Entry>
        <Entry Name="robottalk_scavenge_idle_011_scavengerobot_001">¿Qué estoy haciendo aquí fuera?</Entry>
        <Entry Name="robottalk_scavenge_idle_012_scavengerobot_001">No puedo pensar con claridad.</Entry>
        <Entry Name="robottalk_scavenge_idle_013_scavengerobot_001">Necesito más gel estructural.</Entry>
        <Entry Name="robottalk_scavenge_idle_014_scavengerobot_001">Estoy perdiendo. Estoy muriendo.</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_015_ScavengeRobot_001">¿Lo han escondido?</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_019_ScavengeRobot_001">Me han dejado aquí.</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_020_ScavengeRobot_001">No tengo adónde ir.</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_021_ScavengeRobot_001">Tengo que dejar salir un poco de sangre.</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_022_ScavengeRobot_001">La sangre negra.</Entry>
        <Entry Name="robottalk_scavenge_idle_023_scavengerobot_001">Todo el mundo ha desaparecido.</Entry>
        <Entry Name="robottalk_scavenge_idle_024_scavengerobot_001">¡El WAU ha hecho algo, tiene que haber hecho algo!</Entry>
        <Entry Name="robottalk_scavenge_idle_025_scavengerobot_001">¿Cómo tienes tanta sed? Me muero por beber.</Entry>
        <Entry Name="robottalk_scavenge_idle_026_scavengerobot_001">Tiene que haber gel por aquí.</Entry>
        <Entry Name="robottalk_scavenge_idle_027_scavengerobot_001">¿Adónde ha ido todo el mundo?</Entry>
        <Entry Name="robottalk_scavenge_idle_028_scavengerobot_001">¿Cómo he llegado aquí?</Entry>
        <Entry Name="robottalk_scavenge_idle_029_scavengerobot_001">No puedo pensar con claridad.</Entry>
        <Entry Name="robottalk_scavenge_idle_030_scavengerobot_001">Estoy perdiendo, estoy muriendo.</Entry>
        <Entry Name="robottalk_scavenge_idle_031_scavengerobot_001">¿Dónde lo han escondido?</Entry>
        <Entry Name="robottalk_scavenge_idle_032_scavengerobot_001">¡Se lo han llevado todo!</Entry>
        <Entry Name="robottalk_scavenge_idle_033_scavengerobot_001">No hay adónde ir.</Entry>
        <Entry Name="robottalk_scavenge_idle_034_scavengerobot_001">La sangre negra.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_001_ScavengeRobot_001">¿Tienes un poco de sobra?</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_002_ScavengeRobot_001">Lo necesito, entiéndeme.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_003_ScavengeRobot_001">Solo un poco.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_004_ScavengeRobot_001">Venga, solo para salir del paso.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_005_ScavengeRobot_001">No seas egoísta.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_006_ScavengeRobot_001">Tú tienes mucho.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_007_ScavengeRobot_001">No seas así.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_008_ScavengeRobot_001">Ya sabes cómo son estas cosas.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_009_ScavengeRobot_001">Se me ha acabado.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_015_ScavengeRobot_001">Sabes que lo necesito.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_016_ScavengeRobot_001">Cabrón insensible.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_017_ScavengeRobot_001">Dame un poco de gel estructural.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_018_ScavengeRobot_001">No quiero hacerte daño.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_019_ScavengeRobot_001">Podemos compartirlo.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_020_ScavengeRobot_001">Ven aquí.</Entry>
        <Entry Name="robottalk_scavenge_stalk_022_scavengerobot_001">No me conviertas en el malo de la película.</Entry>
        <Entry Name="robottalk_scavenge_stalk_023_scavengerobot_001">Lo necesito, entiéndeme.</Entry>
        <Entry Name="robottalk_scavenge_stalk_024_scavengerobot_001">Solo un poco.</Entry>
        <Entry Name="robottalk_scavenge_stalk_025_scavengerobot_001">No seas avaricioso.</Entry>
        <Entry Name="robottalk_scavenge_stalk_026_scavengerobot_001">Tú tienes mucho.</Entry>
        <Entry Name="robottalk_scavenge_stalk_027_scavengerobot_001">A mí no me queda nada.</Entry>
        <Entry Name="robottalk_scavenge_stalk_028_scavengerobot_001">No me hagas rogar.</Entry>
        <Entry Name="robottalk_scavenge_stalk_029_scavengerobot_001">Esto va en serio.</Entry>
        <Entry Name="robottalk_scavenge_stalk_030_scavengerobot_001">No me abandones.</Entry>
        <Entry Name="robottalk_scavenge_stalk_031_scavengerobot_001">Avaricioso hijo de puta.</Entry>
        <Entry Name="robottalk_scavenge_stalk_032_scavengerobot_001">Dame un poco de gel.</Entry>
        <Entry Name="robottalk_scavenge_stalk_033_scavengerobot_001">Sabes que lo necesito.</Entry>
        <Entry Name="robottalk_scavenge_stalk_034_scavengerobot_001">Cabrón, no tienes corazón.</Entry>
        <Entry Name="robottalk_scavenge_stalk_035_scavengerobot_001">Dame un poco de gel estructural.</Entry>
        <Entry Name="robottalk_scavenge_stalk_036_scavengerobot_001">Nadie tiene por qué acabar herido.</Entry>
        <Entry Name="robottalk_scavenge_stalk_037_scavengerobot_001">No me hagas convertirme en el tipo malo.</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_001_ScavengeRobot_001">¿Por qué me obligas a hacer esto?</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_002_ScavengeRobot_001">No es culpa mía que estemos así.</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_003_ScavengeRobot_001">¡Dame un poco!</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_004_ScavengeRobot_001">¡Dámelo!</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_005_ScavengeRobot_001">¡Lo necesito!</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_006_ScavengeRobot_001">¡No seas egoísta!</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_009_ScavengeRobot_001">Tú tienes mucho.</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_011_ScavengeRobot_001">¡No me dejes morir de hambre!</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_012_ScavengeRobot_001">Necesito más.</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_014_ScavengeRobot_001">¡No puedo dejarte ir!</Entry>
        <Entry Name="robottalk_scavenge_tempted_017_scavengerobot_001">¿Por qué me obligas a hacer esto?</Entry>
        <Entry Name="robottalk_scavenge_tempted_018_scavengerobot_001">Dame un poco.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkFirstStart_001_ScavengeRobot_001">Tú eres real. Por favor, dame un poco para el dolor.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkStart_001_ScavengeRobot_001">Has cambiado de opinión.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkStart_002_ScavengeRobot_001">Me alegro de verte de vuelta.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkStart_003_ScavengeRobot_001">Pensé que me ibas a dejar morir.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkStart_004_ScavengeRobot_001">Al final, tu conciencia se ha apoderado de ti.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkStart_005_ScavengeRobot_001">Oh, así que vamos a hacer esto.</Entry>
        <Entry Name="robottalk_scavenge_stalkstart_006_scavengerobot_001">Me alegro de verte de vuelta.</Entry>
        <Entry Name="robottalk_scavenge_stalkstart_007_scavengerobot_001">Veo que, por fin, tu conciencia ha hecho acto de presencia.</Entry>
        <Entry Name="robottalk_scavenge_stalkstart_008_scavengerobot_001">Vale, vamos a hacerlo.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkEnd_001_ScavengeRobot_001">No te marches. ¡Ayúdame!</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkEnd_002_ScavengeRobot_001">Lo llevaba en el interior. Podía sentirlo.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkEnd_003_ScavengeRobot_001">¡Eh, espera! Vuelve.</Entry>
        <Entry Name="RobotTalk_Scavenge_StalkEnd_004_ScavengeRobot_001">Va a volver, ¿verdad? Correcto.</Entry>
        <Entry Name="robottalk_scavenge_stalkend_005_scavengerobot_001">Eh, espera, ¡vuelve!</Entry>
        <Entry Name="RobotTalk_Scavenge_Alert_001_ScavengeRobot_001">¿Por qué te escondes?</Entry>
        <Entry Name="RobotTalk_Scavenge_Alert_002_ScavengeRobot_001">Sal, no te haré daño.</Entry>
        <Entry Name="RobotTalk_Scavenge_Alert_003_ScavengeRobot_001">Te oigo moverte sigilosamente.</Entry>
        <Entry Name="RobotTalk_Scavenge_Alert_004_ScavengeRobot_001">Sé que estás ahí. Te estoy oyendo.</Entry>
        <Entry Name="RobotTalk_Scavenge_Alert_005_ScavengeRobot_001">Sal.</Entry>
        <Entry Name="RobotTalk_Scavenge_Alert_006_ScavengeRobot_001">No tienes nada que temer.</Entry>
        <Entry Name="RobotTalk_Scavenge_Alert_007_ScavengeRobot_001">Puedo ayudarte.</Entry>
        <Entry Name="robottalk_scavenge_alert_008_scavengerobot_001">¿Por qué te escondes?</Entry>
        <Entry Name="robottalk_scavenge_alert_009_scavengerobot_001">Sal, no te haré daño.</Entry>
        <Entry Name="robottalk_scavenge_alert_010_scavengerobot_001">Te estoy oyendo por ahí.</Entry>
        <Entry Name="robottalk_scavenge_alert_011_scavengerobot_001">¡No tienes por qué tener miedo!</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_001_ScavengeRobot_001">¿Qué es eso?</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_002_ScavengeRobot_001">¿Quién anda ahí?</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_003_ScavengeRobot_001">Juraría que he oído algo.</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_004_ScavengeRobot_001">¿Hay alguien ahí?</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_005_ScavengeRobot_001">¿Hola?</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_006_ScavengeRobot_001">¿Qué?</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_007_ScavengeRobot_001">¿Qué está ocurriendo?</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_008_ScavengeRobot_001">¿Quién es?</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_009_ScavengeRobot_001">¿Hay alguien ahí?</Entry>
        <Entry Name="RobotTalk_Scavenge_AlertBeforeSeen_010_ScavengeRobot_001">¿Quién está haciendo eso?</Entry>
        <Entry Name="robottalk_scavenge_alertbeforeseen_011_scavengerobot_001">¿Qué es eso?</Entry>
        <Entry Name="robottalk_scavenge_alertbeforeseen_012_scavengerobot_001">¡Te juro que he oído algo!</Entry>
        <Entry Name="robottalk_scavenge_alertbeforeseen_013_scavengerobot_001">¿Hay alguien ahí?</Entry>
        <Entry Name="robottalk_scavenge_alertbeforeseen_014_scavengerobot_001">¿Qué?</Entry>
        <Entry Name="robottalk_scavenge_alertbeforeseen_015_scavengerobot_001">¿Qué está pasando?</Entry>
        <Entry Name="robottalk_scavenge_alertbeforeseen_016_scavengerobot_001">¿Quién anda ahí?</Entry>
        <Entry Name="robottalk_scavenge_alertbeforeseen_017_scavengerobot_001">¿Hay alguien ahí?</Entry>
        <Entry Name="robottalk_scavenge_alertbeforeseen_018_scavengerobot_001">¿Quién está haciendo eso?</Entry>
        <Entry Name="simoncomments_intro_breath_001_player_001">¿Qué... qué diablos...? ¿Cómo es posible?</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_001_Echo_Amy_001">¿Zeta, me recibes? Más te vale contestarme, Strasky. ¡Venga!</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_002_Echo_Peter_001">Amy, ¿dónde estás?</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_003_Echo_Amy_001">Los campos... tuve que marcharme.</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_004_Echo_Peter_001">¿Carl está contigo?</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_005_Echo_Amy_001">Todo se fue al cuerno.</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_006_Echo_Peter_001">Espera. Tienes la energía automatizada, ¿verdad? ¿La planta es segura? Necesitamos esa energía para mantener los centros activos...</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_007_Echo_Amy_001">¡A la mierda la energía! ¡Y a la mierda tú, Strasky! ¡Las máquinas mataron a Carl!</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_008_Echo_Peter_001">Ay, mierda... Venga, calma, todo irá bien. ¿Puedes volver a Zeta?</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_009_Echo_Amy_001">Sí, creo que sí. Me iré hacia la lanzadera, la auxiliar.</Entry>
        <Entry Name="Echo_Datamine_AmyTheta_010_Echo_Peter_001">Buena suerte, Amy. Tienes todo mi apoyo.</Entry>
        <Entry Name="simoncomments_leftcommroom_001_player_001">Esto no es... Esto es una locura...</Entry>
        <Entry Name="simoncomments_leftcommroom_objective_001_player_001">Lambda, encuentra una lanzadera hacia Lambda.</Entry>
        <Entry Name="simoncomments_thankkatebot_001_player_001">¡Vaya, gracias pequeñín!</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_01_04_transport_station">
        <Entry Name="radio_simononenterlevel_001_player_001">Esperemos que las lanzaderas todavía funcionen.</Entry>
        <Entry Name="Slideshow_Slideshow1_001_SlideshowNarrator_001">Bienvenido a Pathos-II, tu autopista exprés a las estrellas.</Entry>
        <Entry Name="Slideshow_Slideshow2_001_SlideshowNarrator_001">Lo que en los años sesenta comenzó como una operación minera térmica se ha convertido ahora en la sede del cañón espacial Omega, la manera más asequible del mundo de lanzar satélites y sondas espaciales.</Entry>
        <Entry Name="Slideshow_Slideshow3_001_SlideshowNarrator_001">Nuestra exclusiva ubicación en el océano Atlántico permite a este gigantesco cañón de bobina, más largo que un maratón, lanzar proyectiles sin riesgo de daños por combustión en la carga útil.</Entry>
        <Entry Name="Slideshow_Slideshow4_001_SlideshowNarrator_001">La estación abarca varios centros y cuenta con un equipo variado de científicos e ingenieros. Juntos pueden producir, montar y lanzar las naves más sofisticadas del mundo.</Entry>
        <Entry Name="Slideshow_SlideshowStation03_001_SlideshowNarrator_001">Ahora vamos a salir de Úpsilon en dirección a Lambda. Lambda es el centro de distribución y transporte de Pathos-II. Ahí podréis encontrar trenes lanzadera que llevan a los demás puntos de la estación y transportes hacia la superficie.</Entry>
        <Entry Name="Slideshow_SlideshowStation04_001_SlideshowNarrator_001">Ahora vamos a salir de Úpsilon en dirección a Zeta. Zeta es el corazón de Pathos-II. Alberga la administración de la estación, las instalaciones médicas y el equipo de preparación de la carga útil, donde se preparan y se programan satélites antes de enviarlos a Fi para su lanzamiento.</Entry>
        <Entry Name="Slideshow_SlideshowStation05_001_SlideshowNarrator_001">Ahora vamos a salir de Úpsilon en dirección a Ómicron. Ómicron es el centro de investigación médica e hidrocultura de Pathos-II. Ómicron está construido en el límite del abismo y, con el Escalador, puede estudiar más de cuatro kilómetros de profundidad.</Entry>
        <Entry Name="radio_simononfloodroom_001_player_001">Allá vamos otra vez.</Entry>
        <Entry Name="Slideshow_SlideshowStation06_001_SlideshowNarrator_001">Ahora vamos a salir de Úpsilon en dirección a Delta. Delta fabrica y monta proyectiles de carga para satélites y sondas específicamente para usarlas en el cañón espacial Omega. Junto con Zeta, pueden adaptar cualquier satélite o carga útil a las necesidades del cliente.</Entry>
        <Entry Name="Slideshow_SlideshowStation08_001_SlideshowNarrator_001">Ahora vamos a salir de Úpsilon en dirección a Fi. Fi es el centro operativo del cañón espacial Omega. El túnel de la lanzadera a Tau todavía está en construcción. Esta lanzadera parará en Ómicron. Utiliza el Escalador a Ómicron para llegar a Tau y después continúa a Fi a través de los túneles de acceso.</Entry>
        <Entry Name="Slideshow_SlideshowStation07_001_SlideshowNarrator_001">Ahora vamos a salir de Úpsilon en dirección a Tau. Tau es una plataforma de investigación modular para estudiar el mundo submarino y la vida humana en condiciones extremas. El túnel de la lanzadera a Tau todavía está en construcción. Esta lanzadera parará en Ómicron. Utiliza el Escalador de Ómicron para llegar a Tau.</Entry>
        <Entry Name="Datamine_IntercomDatamine_001_AmyIntercom_001">¿Strasky? Adelante, Zeta.</Entry>
        <Entry Name="Datamine_IntercomDatamine_002_Strasky_001">Amy, ¿estás bien?</Entry>
        <Entry Name="Datamine_IntercomDatamine_003_AmyIntercom_001">¿Qué? No puedo...</Entry>
        <Entry Name="Datamine_IntercomDatamine_004_Strasky_001">¿Dónde estás ahora?</Entry>
        <Entry Name="Datamine_IntercomDatamine_005_AmyIntercom_001">¡¿Strasky?! Estoy en la lanzadera, pero no pinta bien. Las luces están parpadeando como locas. Creo que el regulador de energía está roto.</Entry>
        <Entry Name="Datamine_IntercomDatamine_006_Strasky_001">Olvídate de la energía y ven aquí.</Entry>
        <Entry Name="Datamine_IntercomDatamine_007_AmyIntercom_001">Tengo que arreglarlo. No quiero quedarme a mitad de camino hacia Zeta.</Entry>
        <Entry Name="Datamine_IntercomDatamine_008_Strasky_001">Amy, no te oigo. ¿No puedes echar a correr?</Entry>
        <Entry Name="Datamine_IntercomDatamine_009_AmyIntercom_001">¿Qué has dicho? ¡No te oigo! No te preocupes. Lo arreglaré. Encontraré la forma de hacerlo.</Entry>
        <Entry Name="CargoPod_CargoPadRecording_001_AmysHusband_001">Supongo que es una suerte que no hayamos tenidos hijos. Ya me resulta bastante duro mirar a mis padres a los ojos.</Entry>
        <Entry Name="CargoPod_CargoPadRecording_002_AmysHusband_001">Por cierto, van a un refugio antibombardeos al norte, junto con tu padre. Supongo que alguien le ayudará a enviarte un mensaje. Bueno, espero que lo hagan.</Entry>
        <Entry Name="CargoPod_CargoPadRecording_003_AmysHusband_001">Aunque ni siquiera sé si recibirás este mensaje. Si lo recibes, quiero que sepas que nunca te culpé por perseguir tus sueños.</Entry>
        <Entry Name="CargoPod_CargoPadRecording_004_AmysHusband_001">Es que... Estaba enfadado porque no se ajustara más a lo que imaginé que serían nuestras vidas. Quería la casa con jardín, la gran familia, ¿entiendes?</Entry>
        <Entry Name="CargoPod_CargoPadRecording_005_AmysHusband_001">Supongo que lo que estoy intentando decir es: Estoy orgulloso de ti. Y aunque haya sido difícil estar separado de ti, no me arrepiento de nada. Soy feliz... y me gustaría poder decir esto sin que se estuviera cayendo el cielo.</Entry>
        <Entry Name="CargoPod_CargoPadRecording_006_AmysHusband_001">*risa débil*</Entry>
        <Entry Name="CargoPod_CargoPadRecording_007_AmysHusband_001">Te quiero, Amy. Siempre te quise y siempre te querré.</Entry>
        <Entry Name="comments_canttakechipcomment_001_player_001">Mierda, ¿estás bien?</Entry>
        <Entry Name="amycorpse_amydeath_001_amycorpse_001">*Mmmmm...*</Entry>
        <Entry Name="amycorpse_amydeath_002_player_002">¡Oh, joder!</Entry>
        <Entry Name="AmyRobot_AmyRobotAwakens_001_AmyRobot_001">Vale, ya estoy. Vigila los niveles. Avísame en cuanto suba. Quiero poder monitorizar mi estado.</Entry>
        <Entry Name="AmyRobot_AmyRobotAwakens_002_AmyRobot_001">Ya puedo sentirlo. Mira a ver si puedes estabilizar y reducir gradualmente.</Entry>
        <Entry Name="AmyRobot_AmyRobotAwakens_003_AmyRobot_001">¿Gavin? ¿Carl? Que alguien diga algo, ¡me estáis asustando!</Entry>
        <Entry Name="AmyRobot_AmyRobotAwakens_004_AmyRobot_001">¡¿Carl?! Sácame. ¡Sácame ahora!</Entry>
        <Entry Name="AmyRobot_AmyRobotAwakens_005_AmyRobot_001">¡Aaaah, coño, joder! ¡Sácame!</Entry>
        <Entry Name="AmyRobot_AmyRobotRamling_001_AmyRobot_001">No funciona.</Entry>
        <Entry Name="AmyRobot_AmyRobotRamling_002_AmyRobot_001">No me siento muy bien.</Entry>
        <Entry Name="AmyRobot_AmyRobotRamling_003_AmyRobot_001">Finley. Qué mal...</Entry>
        <Entry Name="AmyRobot_AmyRobotRamling_004_AmyRobot_001">Carl... ¿Carl?</Entry>
        <Entry Name="AmyRobot_AmyRobotRamling_005_AmyRobot_001">No puedo levantarme.</Entry>
        <Entry Name="amycorpse_amychippull_001_amycorpse_001">Noooo...</Entry>
        <Entry Name="Comments_ChipPickup_Bad_001_Player_001">Está en muy mal estado.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SeesPlayer_001_AmyRobot_001">¿Qué es eso?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SeesPlayer_002_AmyRobot_001">¿Qué eres?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SeesPlayer_003_AmyRobot_001">Aléjate de mí.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SeesPlayer_004_AmyRobot_001">¿Qué coño quieres?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SeesPlayer_005_AmyRobot_001">No te acerques más.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardNotSeen_001_AmyRobot_001">Carl, ¿eres tú? Ayúdame a quitar el casco.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardNotSeen_002_AmyRobot_001">¿Qué es ese ruido?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardNotSeen_003_AmyRobot_001">¿Oyes eso? ¿Es mi cabeza?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardNotSeen_004_AmyRobot_001">Eso de ahí, ¿no lo oyes, Carl?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardNotSeen_005_AmyRobot_001">Ese puto ruido...</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardAndSeen_001_AmyRobot_001">¡He oído eso! ¡Sal!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardAndSeen_002_AmyRobot_001">Sigues ahí fuera. ¡Te estoy oyendo!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardAndSeen_003_AmyRobot_001">Te oigo moverte. ¡No te escondas!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardAndSeen_004_AmyRobot_001">Oigo cada paso que das.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardAndSeen_005_AmyRobot_001">Sigue así, con cada paso que das me resulta más fácil encontrarte.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardAndSeen_006_AmyRobot_001">Haces mucho ruido, ¡¿lo sabías?!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_PlayerHeardAndSeen_007_AmyRobot_001">Te estoy oyendo y voy a por ti.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_001_AmyRobot_001">Carl, necesito que lo apagues.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_002_AmyRobot_001">Tengo que sacar este casco.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_003_AmyRobot_001">*respiración pesada*</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_004_AmyRobot_001">¿Hay alguien? Soy Amy Azzaro.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_005_AmyRobot_001">Estoy atascada.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_006_AmyRobot_001">*respiración pesada*</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_007_AmyRobot_001">Esto no ha sido buena idea.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_008_AmyRobot_001">*respiración pesada*</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_009_AmyRobot_001">Peor que antes.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_010_AmyRobot_001">Mantén la calma.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_011_AmyRobot_001">*respiración pesada*</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_012_AmyRobot_001">No puedo creer que esté sucediendo esto.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_013_AmyRobot_001">Qué putada.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Idle_014_AmyRobot_001">La he jodido.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Searching_001_AmyRobot_001">Es culpa tuya. Tú estás haciendo esto.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Searching_002_AmyRobot_001">Sal.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Searching_003_AmyRobot_001">¿Dónde estás?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Searching_004_AmyRobot_001">Sal.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Searching_005_AmyRobot_001">Haz que pare o te mato.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Searching_006_AmyRobot_001">¿Por qué estás haciendo esto?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Searching_007_AmyRobot_001">¡Sal aquí, cobarde!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Searching_008_AmyRobot_001">Tengo que detenerte.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Hunting_001_AmyRobot_001">¡Apágalo!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Hunting_002_AmyRobot_001">¡Haz que pare!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Hunting_003_AmyRobot_001">¡Páralo ya!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Hunting_004_AmyRobot_001">¡Es culpa tuya!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Hunting_005_AmyRobot_001">¡Tú estás haciendo esto!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Hunting_006_AmyRobot_001">¡Basta!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_Hunting_007_AmyRobot_001">¡Déjame en paz!</Entry>
        <Entry Name="AmyRobot_AmyEncounter_LostSight_001_AmyRobot_001">Ha parado, ha desaparecido.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_LostSight_002_AmyRobot_001">Ya se ha ido. ¿Eso no era real?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_LostSight_003_AmyRobot_001">¿Adónde ha ido?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_LostSight_004_AmyRobot_001">El casco... está mintiendo.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_LostSight_005_AmyRobot_001">Ya no está.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_LostSight_006_AmyRobot_001">Ha desaparecido.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_LostSight_007_AmyRobot_001">¿Estaba todo en mi cabeza?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_LostSight_008_AmyRobot_001">Está jugando con mis sentidos.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SpottingPlayer_001_AmyRobot_001">¿Qué clase de bicho retorcido eres tú?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SpottingPlayer_002_AmyRobot_001">¡Eh, tú! ¿Qué haces aquí?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SpottingPlayer_003_AmyRobot_001">¿De dónde has salido?</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SpottingPlayer_004_AmyRobot_001">Ahí estás otra vez.</Entry>
        <Entry Name="AmyRobot_AmyEncounter_SpottingPlayer_005_AmyRobot_001">Te estoy viendo.</Entry>
        <Entry Name="Slideshow_Slideshow5_001_SlideshowNarrator_001">Aparte de ser nuestra operación principal, Pathos-II también alberga varios proyectos de investigación de ciencias marinas, incluyendo hidrocultura,  perturbaciones y construcción submarina.</Entry>
        <Entry Name="radio_lambdatransmissionlink_001_catherine_001">Simon... ¿Simon? ¿Estás ahí?</Entry>
        <Entry Name="radio_lambdatransmissionlink_002_player_001">Catherine, ¿eres tú? Iba de camino pero el tren lanzadera... se estrelló.</Entry>
        <Entry Name="radio_lambdatransmissionlink_003_catherine_001">¿Estás bien? El sistema dice que la sección está sellada por una supuesta ruptura del casco.</Entry>
        <Entry Name="radio_lambdatransmissionlink_004_player_001">¡No, no estoy bien! ¿Qué demonios le ha pasado al mundo? ¿Por qué estamos bajo el agua?</Entry>
        <Entry Name="radio_lambdatransmissionlink_005_catherine_001">Uf, estás totalmente fuera de lugar, ¿verdad?</Entry>
        <Entry Name="radio_lambdatransmissionlink_005_catherine_002">No te preocupes ahora por eso. Me hago cargo de que estás confundido, pero estás muy cerca de Lambda. Solo tienes que seguir.</Entry>
        <Entry Name="radio_lambdatransmissionlink_006_player_001">¿Cómo de cerca? ¿Puedo ir andando?</Entry>
        <Entry Name="radio_lambdatransmissionlink_007_catherine_001">Sí, pero el túnel está cerrado para que no se derrumbe la estructura. Tienes que encontrar la trampilla de mantenimiento de tu sección. Te llevará al exterior.</Entry>
        <Entry Name="radio_lambdatransmissionlink_008_player_001">¿Trampilla de mantenimiento? De acuerdo.</Entry>
        <Entry Name="radio_lambdatransmissionlink_009_catherine_001">¿Qué es eso? ¿Qué está pasando ahí fuera?</Entry>
        <Entry Name="radio_lambdatransmissionlink_009_catherine_002">Tengo que irme. Hasta pronto, Simon.</Entry>
        <Entry Name="radio_lambdatransmissionlink_010__soundeffect_001">*crujido*</Entry>
        <Entry Name="radio_lambdatransmissionlink_011_player_001">¿Catherine? ¿Estás bien?</Entry>
        <Entry Name="Comments_ForgotOmnitool_001_Player_001">Joder, me he olvidado el Omnitool en la lanzadera.</Entry>
        <Entry Name="dialog_talktoamy_1_001_player_001">Eh, ¿estás...?</Entry>
        <Entry Name="dialog_talktoamy_1_002_amycorpse_001">No me hagas daño.</Entry>
        <Entry Name="dialog_talktoamy_2_001_player_001">¿Puedo ayudarte?</Entry>
        <Entry Name="dialog_talktoamy_2_002_amycorpse_001">No me dejará morir. Nada puede morir.</Entry>
        <Entry Name="dialog_talktoamy_3_001_player_001">¿Qué ha pasado?</Entry>
        <Entry Name="dialog_talktoamy_3_002_amycorpse_001">Un accidente... reparando la energía. Me dirigía a Zeta.</Entry>
        <Entry Name="dialog_talktoamy_cablepulled_1_001_player_001">¿Estás bien?</Entry>
        <Entry Name="dialog_talktoamy_cablepulled_1_002_amycorpse_001">No lo sé. Me quiero ir a casa.</Entry>
        <Entry Name="dialog_talktoamy_4_001_player_001">¿Puedo hacer algo?</Entry>
        <Entry Name="dialog_talktoamy_4_002_amycorpse_001">Si ves a Masters o a Holland, diles que necesito ayuda, ¿vale? Amy necesita ayuda.</Entry>
        <Entry Name="dialog_talktoamy_final_1_001_player_001">Aguanta un poco.</Entry>
        <Entry Name="dialog_talktoamy_final_1_002_amycorpse_001">Haré lo que puedo.</Entry>
        <Entry Name="dialog_talktoamy_final_2_001_player_001">Encontraré a alguien que pueda ayudar.</Entry>
        <Entry Name="dialog_talktoamy_final_2_002_amycorpse_001">Recibido.</Entry>
        <Entry Name="dialog_talktoamy_final_3_001_player_001">Todo irá bien.</Entry>
        <Entry Name="dialog_talktoamy_final_3_002_amycorpse_001">Gracias.</Entry>
        <Entry Name="Dialog_TalkToAmy_Final_4_001_Player_001">Te dejarán en perfecto estado.</Entry>
        <Entry Name="Dialog_TalkToAmy_Final_4_002_AmyCorpse_001">Eso espero.</Entry>
        <Entry Name="dialog_talktoamy_cablepulled_final_1_001_player_001">No te preocupes, todo va a salir bien.</Entry>
        <Entry Name="dialog_talktoamy_cablepulled_final_1_002_amycorpse_001">Vale.</Entry>
        <Entry Name="dialog_talktoamy_cablepulled_final_2_001_player_001">No tienes nada por lo que preocuparte.</Entry>
        <Entry Name="dialog_talktoamy_cablepulled_final_2_002_amycorpse_001">Vale.</Entry>
        <Entry Name="dialog_talktoamy_cablepulled_final_3_001_player_001">Todo saldrá bien.</Entry>
        <Entry Name="dialog_talktoamy_cablepulled_final_3_002_amycorpse_001">Vale.</Entry>
        <Entry Name="comments_abouttocrash_001_player_001">¡Oh, mierda!</Entry>
        <Entry Name="comments_cargopadrecording_comment_001_player_001">¿Qué les ha pasado? Toda esa gente...</Entry>
        <Entry Name="helperjane_helperjane_pluggedin_001_helperjane_001">Lanzadera J6 activada.</Entry>
        <Entry Name="helperjane_helperjane_pluggedin_badpower_001_helperjane_001">¡Aviso! Energía poco fiable. Continúa con precaución.</Entry>
        <Entry Name="helperjane_helperjane_pluggedin_goodpower_001_helperjane_001">En espera.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_02_01_ms_curie_outside">
        <Entry Name="terminal_terminal_interviewrecording_1_001_catherineterminal_001">¿Tienes ilusión por el ARCA?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_1_002_interviewee_1_001">Al principio no le veía sentido, pero después pensé: ¿por qué no?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_1_002_interviewee_1_002">Quiero decir que, si podemos salvar aunque solo sea un pequeño fragmento de nosotros, ¿por qué no íbamos a hacerlo?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_1_004_catherineterminal_001">Entonces, ¿estás a favor?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_1_005_interviewee_1_001">Creo que es muy importante que hagamos esto.</Entry>
        <Entry Name="terminal_terminal_interviewrecording_2_001_catherineterminal_001">¿Qué opinas sobre el ARCA?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_2_002_interviewee_2_001">Es una gran idea. Por fin hacemos algo, ¿no?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_2_004_catherineterminal_001">¿Te sientes optimista con las probabilidades del proyecto de... esto... de... de que el ARCA llegue al espacio?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_2_005_interviewee_2_001">Sin duda, se puede conseguir. Ya has resuelto el problema principal... Cómo conseguir que entremos todos ahí.</Entry>
        <Entry Name="terminal_terminal_interviewrecording_2_005_interviewee_2_002">Ahora, lo único que tenemos que hacer es construir esa cosa y esperar que Fi siga estando operativo.</Entry>
        <Entry Name="terminal_terminal_interviewrecording_2_005_interviewee_2_003">Sí, creo que podemos hacerlo, pero no va a resultar fácil.</Entry>
        <Entry Name="terminal_terminal_interviewrecording_3_001_catherineterminal_001">¿Qué opinas sobre el proyecto ARCA?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_3_002_interviewee_3_001">Es una idea increíble en todos los sentidos. Te hace pensar en lo que realmente significar ser humano.</Entry>
        <Entry Name="terminal_terminal_interviewrecording_3_004_catherineterminal_001">¿Por qué dices eso?</Entry>
        <Entry Name="terminal_terminal_interviewrecording_3_005_interviewee_3_001">Más allá de lo básico, más allá de lo superficial, no dudo de que haya algo con más valor aún.</Entry>
        <Entry Name="terminal_terminal_interviewrecording_3_005_interviewee_3_002">Tú has proporcionado la plataforma, que no está necesariamente restringida a nuestra progenie digital, sino un medio de supervivencia real.</Entry>
        <Entry Name="terminal_terminal_interviewrecording_3_007_interviewee_3_001">Creo, sinceramente, que podemos continuar viviendo a través de la realidad de la continuidad.</Entry>
		<Entry Name="terminal_terminal_interviewrecording_3_006_interviewee_3_001" />
        <Entry Name="cathandsimon_2_cath_warnsplayer_1_001_player_001">¿Catherine?</Entry>
        <Entry Name="cathandsimon_2_cath_warnsplayer_1_002_catherinerobot_001">¡Silencio! ¡No lo mires!</Entry>
        <Entry Name="cathandsimon_2_cath_allclear_1_001_catherinerobot_001">Creo que es seguro salir ahora.</Entry>
        <Entry Name="cathandsimon_2_cath_allclear_extra_1_001_catherinerobot_001">Simon, ¿estás ahí? Estoy herida.</Entry>
        <Entry Name="cathandsimon_2_cath_allclear_extra_1_002_catherinerobot_001">Se ha ido, creo que estamos a salvo.</Entry>
        <Entry Name="cathandsimon_2_cath_allclear_extra_1_003_catherinerobot_001">Me vendría bien un poco de ayuda.</Entry>
        <Entry Name="cathandsimon_2_cath_allclear_extra_1_004_catherinerobot_001">¿A qué esperas? Ven aquí.</Entry>
        <Entry Name="cathandsimon_2_cath_allclear_extra_1_005_catherinerobot_001">Hola, ¿oyes esto? Estoy aquí.</Entry>
        <Entry Name="cathandsimon_2_cath_comeseemehurt_001_catherinerobot_001">Ay, mierda... Simon, eres un idiota. Esperaba que no desencadenaras otra explosión.</Entry>
        <Entry Name="cathandsimon_2_cath_comeseemehurt_002_catherinerobot_001">¿Estás bien? Porque me vendría bien un poco de ayuda.</Entry>
        <Entry Name="cathandsimon_2_cath_comeseemehurt_003_catherinerobot_001">¡Ah, maldita sea! ¿Por qué ha tenido que pasar esto ahora?</Entry>
        <Entry Name="cathandsimon_2_cath_comeseemehurt_004_catherinerobot_001">¿Simon? Que alguien me ayude, por favor.</Entry>
        <Entry Name="cathandsimon_2_cath_comeseemehurt_005_catherinerobot_001">¿Hola?</Entry>
        <Entry Name="cathandsimon_2_cath_comeseemehurt_006_catherinerobot_001">¿Puedes darte prisa?</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_001_player_001">No, tú también no. Estaba deseando que fueras un ser humano.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_002_catherinerobot_001">No te dejes engañar por la circuitería. Yo también fui un ser humano.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_003_player_001">No puedo aguantarlo más, esto es... todo esto es una mierda.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_005_player_001">Me rindo. Ya no queda nada.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_006_catherinerobot_001">Calma. No es el fin del mundo.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_007_player_001">¿Seguro? Pues tiene toda la pinta. Por lo que yo sé, podría no quedar nadie aparte de mí.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_008_catherinerobot_001">¿A qué te refieres? Estoy aquí.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_009_player_001">No te lo tomes a mal, pero me refería a ningún humano aparte de mí.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_012_catherinerobot_001">¿Te has mirado al espejo últimamente? Eres un traje de buceo que habla y anda con un sistema electrónico integrado para completarlo.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_013_player_001">Yo... Yo no...</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_014_catherinerobot_001">¿No quieres pensar en ello? Bueno, pues empieza a pensarlo.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_015_player_001">Ya no quiero hacer esto. Ya no quiero ser esto. Quiero dejarlo.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_017_catherinerobot_001">Antes de tomes una decisión atolondrada... ¿Podríais ayudarme con algo?</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_018_player_001">¿Qué?</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_019_catherinerobot_001">Estaba intentando averiguar qué había pasado con mi proyecto cuando ese bruto me tiró al suelo.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_020_player_001">¿Tu proyecto? ¿Cómo te puede importar algo cuando sabes que no eres más que un simple robot en un mundo muerto y estúpido?</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_021_catherinerobot_001">Venga, céntrate. Necesito repararme para poder volver a trabajar. Entonces, ya puedes enfurruñarte todo lo que quieras.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_1_022_player_001">Estás de guasa, ¿verdad? Creo que tengo más probabilidades de construir una máquina del tiempo que de volver a montar todas tus piezas.</Entry>
        <Entry Name="cathandsimon_3_cath_beforepopchip_2_001_catherinerobot_001">No debería de ser difícil. Coge el chip y mételo en el Omnitool.</Entry>
        <Entry Name="cathandsimon_3_cath_beforepopchip_2_002_player_001">¿Por qué un chip de robot cabe en un abrepuertas?</Entry>
        <Entry Name="cathandsimon_3_cath_beforepopchip_2_003_catherinerobot_001">Es una conexión estánd...</Entry>
        <Entry Name="cathandsimon_3_cath_beforepopchip_2_004_player_001">Oh, ¿Catherine? Vale, vamos a intentarlo.</Entry>
        <Entry Name="cathandsimon_3_cath_whileomnittoolisputin_001_catherinerobot_001">Cuando el Omnitool se haya cargado, conecta mi chip de córtex en el Omnitool.</Entry>
        <Entry Name="cathandsimon_3_cath_whileomnittoolisputin_002_player_001">¿Qué es un chip de córtex?</Entry>
        <Entry Name="cathandsimon_3_cath_whileomnittoolisputin_003_catherinerobot_001">Te resultará evidente. Lo sacaré para que lo veas. Coge el chip y mételo en el Omnitool. Venga, solo necesito que hagas esto por mí.</Entry>
        <Entry Name="cathandsimon_3_cath_whileomnittoolisputin_004_player_001">Claro, lo que sea.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_001_catherineomnitool_001">... arizada, encaja prácticamente cualquier cosa.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_001_catherineomnitool_002">Oh, esto es extraño.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_001_catherineomnitool_003">¿Ya estoy en el Omnitool? Gracias.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_002_player_001">¿De qué trata el proyecto?</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_003_catherineomnitool_001">¿Mi proyecto? Bueno, yo salvé a toda la gente de la estación en forma de escaneados cerebrales y los metí en un mundo artificial. Íbamos a lanzarlo al espacio para salvarlo de... bueno, de todo esto.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_004_player_001">¿Me estás diciendo que ibas a lanzar al espacio un mundo informatizado lleno de gente?</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_005_catherineomnitool_001">Sí. Al principio no era más que un proyecto de prueba, pero la cosa se puso seria cuando el cometa destrozó la superficie. Entonces, de repente, se convirtió en algo de gran relevancia y le dieron el nombre oficial de ARCA.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_006_player_001">Muy apropiado. ¿Hasta dónde llegaste?</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_007_catherineomnitool_001">No lo sé. Esa versión de mí, lo que soy, procedió de un escaneado que hice al principio. La Catherine viva podría haber completado el proyecto y haberlo lanzado. Supongo que todavía podría estar viva. Un concepto muy retorcido...</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_008_player_001">Entonces, ¿los robots que hablan también son fruto de tus escaneados?</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_009_catherineomnitool_001">Podrían serlo, pero lo dudo. Si fuera así, tendrían mucho más sentido común. Ah, vale. Por fin.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_010_player_001">¿Qué está pasando?</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_011_catherineomnitool_001">He conseguido restablecer algunos datos del servidor de seguridad. Esto debería decirnos todo lo que necesitamos saber.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_011_catherineomnitool_002">Oh... ¿Podrías hacerme el favor de correr a la otra sala y echar un vistazo? No puedo ver los archivos en este estado. Necesito saber que el ARCA está a salvo.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_012_player_001">Por supuesto, Cath.</Entry>
        <Entry Name="cathandsimon_3_cath_wakeupinomnitool_013_catherineomnitool_001">Gracias. Te abriré la puerta.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_1_001_catherineomnitool_001">¿Qué es lo que habías dicho antes? ¿Que eres de Toronto?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_1_002_player_001">Sí, fui a que me hicieran un escaneado cerebral y, de repente, aquí estoy.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_1_003_catherineomnitool_001">Eso no tiene ningún sentido. ¿Cómo... por qué iba alguien a traer un escaneado desde Toronto?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_1_004_player_001">¿Crees que eso es extraño? ¿Y si te dijera que fue en el año 2015?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_1_005_player_001">Hala...</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_2_001_catherineomnitool_001">Esto no tiene sentido alguno.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_2_002_player_001">¿Has dicho algo?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_2_003_catherineomnitool_001">Lo siento, todavía estoy intentando averiguar cómo llegaste aquí.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_2_004_player_001">Continúa. Me gustaría mucho saber quién pensó que era buena idea enviar a un canadiense al fondo del mar.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_3_001_player_001">¿Qué sucedió antes? Esa criatura era extrañamente abrumadora.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_3_002_catherineomnitool_001">Sí, básicamente rebosaba electromagnetismo.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_3_003_player_001">Eso nos hace mal, ¿verdad?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_3_004_catherineomnitool_001">Como mínimo nos aturde. Es un golpe para los sentidos.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_4_001_catherineomnitool_001">¿Qué pasó con la torre? ¿Y el muelle? ¿Y el centro de bienvenida?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_4_002_player_001">¿Qué torre? ¿De qué estás hablando?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_4_003_catherineomnitool_001">Este lugar está en ruinas. Todas las cámaras tienen interferencias. Es... es tan extraño.</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_5_001_player_001">¿Catherine?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_5_002_catherineomnitool_001">¿Qué?</Entry>
        <Entry Name="cathandsimon_3_cath_banterwithsimon_5_003_player_001">Nada. No importa.</Entry>
        <Entry Name="cathandsimon_3_cath_leavecloudandfoundnoark_1_001_catherineomnitool_001">A ver si puedes averiguar dónde está el ARCA.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingdone_1_001_player_001">La he encontrado. Está en un centro llamado Tau.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingdone_1_002_catherineomnitool_001">Oh, no. ¡Está en la Tierra! Y tan cerca de Fi... Casi lo consiguen.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingdone_1_002_catherineomnitool_002">Maldita sea. En ese estado no podrá resistir mucho tiempo... Como mucho, un par de décadas. Eso no es mucho para construir un futuro.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingdone_1_003_player_001">Si llegáramos hasta ella... ¿Podríamos montar en el ARCA?</Entry>
        <Entry Name="cathandsimon_3_cath_trackingdone_1_004_catherineomnitool_001">Supongo, pero en este momento no soy muy flexible.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_1_001_player_001">Me encargaré de que lleguemos hasta allí. Puedo moverme, saltar, nadar... más o menos. Estás atascada en el abrepuertas... el Omnitool. Yo te llevo allí y tú me indicas qué hay que hacer.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_1_002_catherineomnitool_001">Eso suena muy arriesgado... Además, no me gusta la idea de que me lleves por ahí.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_1_003_player_001">Venga, Catherine. Eso es lo que tú querías hacer, tu misión final. ¡Vamos a lanzar el ARCA!</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_1_004_catherineomnitool_001">Necesitaríamos encontrar la manera de entrar en el abismo. No se puede utilizar el Escalador sin un ExoTraje.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_1_004_catherineomnitool_002">Probablemente tendríamos que ir a Zeta y rezar para que el DUNBAT siga funcionando.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_1_005_player_001">Vale, nos vamos a Zeta.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_1_006_catherineomnitool_001">No lo sé, está bastante lejos.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_1_007_player_001">Catherine, mira a tu alrededor. ¿Qué otra cosa se puede hacer?</Entry>
        <Entry Name="cathandsimon_2_cath_playernearcathfirsttime_unhurt_001_catherinerobot_001">Simon, aquí.</Entry>
        <Entry Name="cathandsimon_2_cath_playernearcathfirsttime_unhurt_002_catherinerobot_001">Eh, aquí abajo.</Entry>
        <Entry Name="cathandsimon_2_cath_playernearcathfirsttime_unhurt_003_catherinerobot_001">Estoy justo a tu lado.</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_1_001_catherineomnitool_001">Eh, ¿qué...? ¿Qué es esto...? ¿Embarcación de emergencia CURIE 4?</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_1_001_catherineomnitool_002">Eh, Simon, ¿me oyes?</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_1_002_player_001">Te oigo. ¿Puedes poner esto en marcha?</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_1_003_catherineomnitool_001">Espera, voy a intentarlo.</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_2_001_catherineomnitool_001">Lo siento, está muerto.</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_2_002_player_001">Vale la pena intentarlo.</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_2_003_catherineomnitool_001">Esta embarcación de emergencia vino de la CURIE. Era una nave que hacía trayectos entre Lambda y Lisboa. Parece que los restos están cerca. A lo mejor, dentro encuentras una embarcación como esta.</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_2_004_player_001">Me parece un buen plan.</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_2_005_catherineomnitool_001">Voy a guardar la información de seguridad y a actualizar el Omnitool. Ya está. Te ayudará a desplazarte.</Entry>
        <Entry Name="cathandsimon_4_cath_putintolifeboat_2_006_player_001">Estupendo.</Entry>
        <Entry Name="cathandsimon_2_cath_remindofomnitool_001_catherinerobot_001">Solo tienes que conectarlo al terminal.</Entry>
        <Entry Name="cathandsimon_2_cath_remindofomnitool_002_catherinerobot_001">El terminal, está ahí mismo.</Entry>
        <Entry Name="cathandsimon_2_cath_remindofomnitool_003_catherinerobot_001">Simon, mete el Omnitool en el terminal.</Entry>
        <Entry Name="cathandsimon_2_cath_remindofomnitool_004_catherinerobot_001">No es un concepto complicado. ¡Conéctalo!</Entry>
        <Entry Name="cathandsimon_2_cath_remindofomnitool_005_catherinerobot_001">¿Estás... debería preocuparme? ¡Conecta el Omnitool!</Entry>
        <Entry Name="cathandsimon_2_cath_remindofomnitool_006_catherinerobot_001">Vale. Simon. Esta herramienta que llevas... encaja perfectamente en ese terminal de ahí.</Entry>
        <Entry Name="cathandsimon_3_cath_leavecloudandfoundnoark_2_001_catherineomnitool_001">Tiene que haber una forma de averiguar dónde está el ARCA.</Entry>
        <Entry Name="cathandsimon_3_cath_leavecloudandfoundnoark_3_001_catherineomnitool_001">¿Puedes encontrar el ARCA?</Entry>
        <Entry Name="cathandsimon_3_cath_hearfootsteps_washurt_001_catherineomnitool_001">Simon. Creo que ha vuelto. Ten cuidado. No sé si podrías resistir otro impacto.</Entry>
        <Entry Name="cathandsimon_3_cath_hearfootsteps_wasunhurt_001_catherineomnitool_001">Cuidado. Creo que ha vuelto. Abre bien los ojos.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingstarted_001_player_001">He encontrado un rastreador sintonizado con la señal del ARCA.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingstarted_002_catherineomnitool_001">Oh, qué inteligente. Me pregunto si eso lo he pensado yo... ¿Todavía funciona? Necesito saber qué le ha pasado.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingstarted_003_player_001">Creo que sí. Al menos, está haciendo algo.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingstarted_004_catherineomnitool_001">¿Dónde está?</Entry>
        <Entry Name="cathandsimon_3_cath_trackingstarted_005_player_001">Espera, estoy intentando encontrarla.</Entry>
        <Entry Name="cathandsimon_3_cath_trackingstarted_006_catherineomnitool_001">Por favor, que esté a salvo.</Entry>
        <Entry Name="cathandsimon_2_simon_enterlambda_001_catherinerobot_001">¡No te metas! Esto es importante. ¡No!</Entry>
        <Entry Name="cathandsimon_2_simon_enterlambda_003_catherinerobot_001">¡Aaaah!</Entry>
        <Entry Name="AgentBark_Attack_Idle_001_AttackBot_001">Mi cabeza, no lo soporto.</Entry>
        <Entry Name="AgentBark_Attack_Idle_002_AttackBot_001">La sed es insaciable.</Entry>
        <Entry Name="AgentBark_Attack_Idle_003_AttackBot_001">¡Joder!</Entry>
        <Entry Name="AgentBark_Attack_Idle_004_AttackBot_001">Aquí no hay nada. No hay nada en ninguna parte.</Entry>
        <Entry Name="AgentBark_Attack_Idle_005_AttackBot_001">Necesito la sangre.</Entry>
        <Entry Name="AgentBark_Attack_Idle_006_AttackBot_001">Es siempre igual. Todos los días, cada maldita hora...</Entry>
        <Entry Name="AgentBark_Attack_Idle_007_AttackBot_001">¿Adónde ha ido todo el mundo?</Entry>
        <Entry Name="AgentBark_Attack_Idle_008_AttackBot_001">Putos idiotas.</Entry>
        <Entry Name="AgentBark_Attack_Idle_009_AttackBot_001">No debería haber confiado en ellos.</Entry>
        <Entry Name="AgentBark_Attack_Idle_010_AttackBot_001">Son todos unos mentirosos.</Entry>
        <Entry Name="AgentBark_Attack_Idle_011_AttackBot_001">Todavía me arde en los ojos.</Entry>
        <Entry Name="AgentBark_Attack_Idle_012_AttackBot_001">No puedo salir.</Entry>
        <Entry Name="AgentBark_Attack_Idle_013_AttackBot_001">Dejaron que nos pudriéramos.</Entry>
        <Entry Name="AgentBark_Attack_Idle_014_AttackBot_001">La sangre negra del WAU.</Entry>
        <Entry Name="AgentBark_Attack_Idle_015_AttackBot_001">Puedo encontrar el camino para llegar allí.</Entry>
        <Entry Name="AgentBark_Attack_Idle_016_AttackBot_001">No se puede invertir el proceso, ¿verdad?</Entry>
        <Entry Name="AgentBark_Attack_Idle_017_AttackBot_001">La sangre negra de mis venas me salvará.</Entry>
        <Entry Name="AgentBark_Attack_Idle_018_AttackBot_001">No hay otra forma.</Entry>
        <Entry Name="AgentBark_Attack_Idle_019_AttackBot_001">Necesito encontrar más.</Entry>
        <Entry Name="AgentBark_Attack_Idle_020_AttackBot_001">Necesito más combustible.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_001_AttackBot_001">¿Listo?</Entry>
        <Entry Name="AgentBark_Attack_Stalk_002_AttackBot_001">¿Estás listo para esto?</Entry>
        <Entry Name="AgentBark_Attack_Stalk_003_AttackBot_001">Hagámoslo...</Entry>
        <Entry Name="AgentBark_Attack_Stalk_004_AttackBot_001">Enséñame qué es lo que tienes.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_005_AttackBot_001">Venga, tipo duro.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_006_AttackBot_001">Hora de sangrar.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_007_AttackBot_001">Ábrete y deja salir esa sangre.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_008_AttackBot_001">Tengo que dejar salir un poco de esa sangre negra.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_009_AttackBot_001">Dame el combustible.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_010_AttackBot_001">Córtate.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_011_AttackBot_001">Córtate y ábrete.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_012_AttackBot_001">No vas a ir a ninguna parte.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_013_AttackBot_001">Ven aquí.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_014_AttackBot_001">Ven aquí.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_015_AttackBot_001">Vamos.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_016_AttackBot_001">Ni se te ocurra intentar escapar.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_017_AttackBot_001">Esto está sucediendo.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_018_AttackBot_001">No hay salida.</Entry>
        <Entry Name="AgentBark_Attack_Stalk_019_AttackBot_001">No puedes escapar de mí.</Entry>
        <Entry Name="AgentBark_Attack_StalkFirstStart_001_AttackBot_001">Por fin. He esperado a que llegara este momento.</Entry>
        <Entry Name="AgentBark_Attack_StalkEnd_001_AttackBot_001">¿Adónde coño ha ido?</Entry>
        <Entry Name="AgentBark_Attack_StalkEnd_002_AttackBot_001">¿Lo he perdido? ¡No, no puede ser!</Entry>
        <Entry Name="AgentBark_Attack_StalkEnd_003_AttackBot_001">¡Vuelve, cobarde!</Entry>
        <Entry Name="AgentBark_Attack_StalkEnd_004_AttackBot_001">¡No te marches! ¡Tienes que sangrar!</Entry>
        <Entry Name="AgentBark_Attack_StalkEnd_005_AttackBot_001">No, ¿ha escapado? ¡Maldito seas!</Entry>
        <Entry Name="AgentBark_Attack_StalkEnd_006_AttackBot_001">¡Cobarde llorón! ¡Vuelve!</Entry>
        <Entry Name="AgentBark_Attack_SearchStart_001_AttackBot_001">¿Estás intentando esconderte de mí?</Entry>
        <Entry Name="AgentBark_Attack_SearchStart_002_AttackBot_001">Será mejor que busques un buen escondite: voy a por ti.</Entry>
        <Entry Name="AgentBark_Attack_SearchStart_003_AttackBot_001">Te encontraré.</Entry>
        <Entry Name="AgentBark_Attack_SearchStart_004_AttackBot_001">¿De verdad vas a hacer que me ponga a buscarte?</Entry>
        <Entry Name="AgentBark_Attack_SearchStart_005_AttackBot_001">Encontraré la madriguera en la que te has metido.</Entry>
        <Entry Name="AgentBark_Attack_SearchStart_006_AttackBot_001">Te encontraré y te mataré.</Entry>
        <Entry Name="AgentBark_Attack_SearchFound_001_AttackBot_001">Te encontré.</Entry>
        <Entry Name="AgentBark_Attack_SearchFound_002_AttackBot_001">Te estoy viendo.</Entry>
        <Entry Name="AgentBark_Attack_SearchFound_003_AttackBot_001">Oh, allá vamos.</Entry>
        <Entry Name="AgentBark_Attack_SearchFound_004_AttackBot_001">Te he encontrado.</Entry>
        <Entry Name="AgentBark_Attack_SearchFound_005_AttackBot_001">Ya te tengo.</Entry>
        <Entry Name="AgentBark_Attack_SearchFound_006_AttackBot_001">Ahí estás.</Entry>
        <Entry Name="agentbark_attack_tempted_001_attackbot_001">¡Ven aquí!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_002_AttackBot_001">¡Te voy a hacer pedazos!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_003_AttackBot_001">¡Reza todo lo que sepas, pedazo de basura!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_004_AttackBot_001">¡Se acabó!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_005_AttackBot_001">Toma. ¡Llora como una perra!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_006_AttackBot_001">¡Hora de morir!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_007_AttackBot_001">¡No hay escapatoria!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_008_AttackBot_001">¡La muerte es lo único que queda!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_009_AttackBot_001">¡Dame ese combustible!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_010_AttackBot_001">¡Sangra para mí!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_011_AttackBot_001">¡Se te acabó la suerte!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_012_AttackBot_001">¡Quiero hacerte sufrir!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_013_AttackBot_001">¡Sufrir el dolor!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_014_AttackBot_001">¡No escaparás!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_015_AttackBot_001">¡Has llegado al final de tu trayecto!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_016_AttackBot_001">¡Ya no tienes nada, nada!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_017_AttackBot_001">¡Derrama esa sangre negra!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_018_AttackBot_001">¡Esto termina aquí!</Entry>
        <Entry Name="AgentBark_Attack_Tempted_019_AttackBot_001">¡Muere!</Entry>
        <Entry Name="AgentBark_Attack_StalkStart_001_AttackBot_001">Ahí estás.</Entry>
        <Entry Name="AgentBark_Attack_StalkStart_002_AttackBot_001">Vamos a hacerlo...</Entry>
        <Entry Name="AgentBark_Attack_StalkStart_003_AttackBot_001">Allá voy, lo quieras o no.</Entry>
        <Entry Name="AgentBark_Attack_StalkStart_004_AttackBot_001">Esto va a resultar divertido.</Entry>
        <Entry Name="AgentBark_Attack_StalkStart_005_AttackBot_001">Te voy a joder bien.</Entry>
        <Entry Name="AgentBark_Attack_StalkStart_006_AttackBot_001">Allá vamos.</Entry>
        <Entry Name="agentbark_attack_alert_001_attackbot_001">Tengo oídos, ¿lo sabías?</Entry>
        <Entry Name="AgentBark_Attack_Alert_002_AttackBot_001">Oigo cada uno de tus pasos.</Entry>
        <Entry Name="AgentBark_Attack_Alert_003_AttackBot_001">Te estoy oyendo. ¡No te escondas!</Entry>
        <Entry Name="AgentBark_Attack_Alert_004_AttackBot_001">¡He oído eso! ¡Sal!</Entry>
        <Entry Name="AgentBark_Attack_Alert_005_AttackBot_001">Haces muchísimo ruido.</Entry>
        <Entry Name="AgentBark_Attack_Alert_006_AttackBot_001">¿Todo ese ruido lo estás haciendo tú?</Entry>
        <Entry Name="AgentBark_Attack_Alert_007_AttackBot_001">Te estoy oyendo.</Entry>
        <Entry Name="AgentBark_Attack_Alert_008_AttackBot_001">Te oigo y te puedo oler.</Entry>
        <Entry Name="AgentBark_Attack_AlertBeforeSeen_001_AttackBot_001">¿Qué es ese ruido?</Entry>
        <Entry Name="AgentBark_Attack_AlertBeforeSeen_002_AttackBot_001">¡Da la cara!</Entry>
        <Entry Name="AgentBark_Attack_AlertBeforeSeen_003_AttackBot_001">¿Qué es eso?</Entry>
        <Entry Name="AgentBark_Attack_AlertBeforeSeen_004_AttackBot_001">¿Hay alguien ahí?</Entry>
        <Entry Name="AgentBark_Attack_AlertBeforeSeen_005_AttackBot_001">¿Qué está ocurriendo?</Entry>
        <Entry Name="AgentBark_Attack_AlertBeforeSeen_006_AttackBot_001">Eh, ¿quién es?</Entry>
        <Entry Name="cathandsimon_3_cath_readcometarticle_001_player_001">No hay otra manera... un cometa acabó con el planeta.</Entry>
        <Entry Name="cathandsimon_3_cath_readcometarticle_002_catherineomnitool_001">Me temo que sí.</Entry>
        <Entry Name="cathandsimon_3_cath_readcometarticle_003_player_001">Os quedasteis todos aquí, abandonados.</Entry>
        <Entry Name="cathandsimon_3_cath_readcometarticle_004_catherineomnitool_001">Y nosotros fuimos los afortunados.</Entry>
        <Entry Name="cathandsimon_3_cath_glasspoundresponse_unhurt_001_catherineomnitool_001">¿Qué estás haciendo? Ten cuidado.</Entry>
        <Entry Name="cathandsimon_3_cath_reminderreturnaftertracking_001_catherineomnitool_001">Venga, vamos a hacerlo. Ven a recogerme.</Entry>
        <Entry Name="cathandsimon_3_cath_reminderreturnaftertracking_002_catherineomnitool_001">No olvides llevarme contigo: el Omnitool.</Entry>
        <Entry Name="cathandsimon_3_cath_reminderreturnaftertracking_003_catherineomnitool_001">¿Dónde te has metido? Estoy esperando.</Entry>
        <Entry Name="cathandsimon_2_cath_playernearcathfirsttime_hurt_001_catherineomnitool_001">Ahí estás. Levantado y todo.</Entry>
        <Entry Name="cathandsimon_2_cath_playernearcathfirsttime_hurt_002_catherineomnitool_001">Ese bruto no sabe jugar bien con la electrónica.</Entry>
        <Entry Name="cathandsimon_2_cath_playernearcathfirsttime_hurt_003_catherineomnitool_001">¿Hola? Estoy aquí.</Entry>
        <Entry Name="cathandsimon_2_cath_screamsafterplayerdie_001_catherinerobot_001">¡No!</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolin_001_catherinerobot_001">Vale, es la hora del plan B. ¿Cuál es el plan B?</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolin_001_catherinerobot_002">¡Oh, el Omnitool! La herramienta que introdujiste en el terminal.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolin_002_player_001">Ah, sí. El abrepuertas.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolin_003_catherinerobot_001">Sí. Puedes tirar de mi chip de córtex y meterlo en el Omnitool.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolin_004_player_001">¿Qué es un chip de córtex?</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolin_005_catherinerobot_001">Te resultará evidente. Lo sacaré para que lo veas. Coge el chip y mételo en el Omnitool. Venga, solo necesito que hagas esto por mí.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolin_006_player_001">Sí, vale.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolout_001_catherinerobot_001">Solo necesito acceder al ordenador. Oh, ¿eso que llevas es un Omnitool?</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolout_002_player_001">¿El abrepuertas? Lo cogí en Úpsilon, donde me desperté.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolout_003_catherinerobot_001">Eso valdrá. Conéctalo al terminal.</Entry>
        <Entry Name="cathandsimon_2_cath_interacttalk_2_omnitoolout_004_player_001">Claro, lo que sea.</Entry>
        <Entry Name="cathandsimon_3_cath_putinomnittoolbeforetalk_001_catherinerobot_001">Oh, has encontrado un Omnitool. Muy práctico.</Entry>
        <Entry Name="cathandsimon_3_cath_glasspoundresponse_hurt_001_catherineomnitool_001">Deberías de dejar de llamar la atención.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_lifeboatfound_001_player_001">¿Sabes? He encontrado afuera una embarcación hundida. Apuesto a que podría llevarnos a Zeta.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_lifeboatfound_002_catherineomnitool_001">¿De veras?</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_lifeboatfound_003_player_001">No parecía estar siniestro total. Incluso se encendió un poco cuando probé el Omnitool.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_lifeboatfound_004_catherineomnitool_001">Vale, vamos a echar un vistazo. Voy a desconectarme de esta cosa. No olvides llevarme contigo.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_nolifeboat_001_player_001">Quizá todavía haya un tren lanzadera que funcione y que pueda llevarnos a Zeta.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_nolifeboat_002_catherineomnitool_001">Lo dudo.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_nolifeboat_003_player_001">Echa un vistazo alrededor. Si la cosa no funciona, iré andando.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_nolifeboat_004_catherineomnitool_001">De acuerdo. Voy a desconectarme de esta cosa. No olvides llevarme contigo.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_2_nolifeboat_005_player_001">No lo olvidaré.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_3_001_player_001">¿Puedo sacar el Omnitool?</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_3_002_catherineomnitool_001">Espera, espera... Vale, pero asegúrate de volver a conectarme en algún momento.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_3_003_player_001">Hecho.</Entry>
        <Entry Name="cathandsimon_4_cath_backtogetomnitool_3_004_catherineomnitool_001">Buena suerte, Simon.</Entry>
        <Entry Name="cathandsimon_3_cath_checkcityplans_001_player_001">¿Esto es del interior del ARCA?</Entry>
        <Entry Name="cathandsimon_3_cath_checkcityplans_002_catherineomnitool_001">Sí, son algunas de las primeras reproducciones del mundo interior.</Entry>
        <Entry Name="cathandsimon_3_cath_checkcityplans_003_player_001">Parece mucho más cómodo que este lugar.</Entry>
        <Entry Name="cathandsimon_3_cath_beforepopchip_1a_001_catherinerobot_001">El Omnitool ya está listo.</Entry>
        <Entry Name="cathandsimon_3_cath_beforepopchip_1b_001_catherinerobot_001">Gracias.</Entry>
        <Entry Name="cathandsimon_3_cathhint_notfoundcomputer_1_001_catherineomnitool_001">Comprueba el ordenador de la otra sala.</Entry>
        <Entry Name="cathandsimon_3_cathhint_notusedtracker_1_001_catherineomnitool_001">Tiene que haber algo en el ordenador que pueda decirnos lo que ha pasado con el ARCA.</Entry>
        <Entry Name="cathandsimon_3_cathhint_notfoundcomputer_2_001_catherineomnitool_001">Ya te lo he dicho: ve a comprobar el ordenador de la otra sala.</Entry>
        <Entry Name="cathandsimon_3_cathhint_notusedtracker_2_001_catherineomnitool_001">Venga, seguro que el ordenador puede decirnos lo que le ha pasado al ARCA.</Entry>
        <Entry Name="cathandsimon_3_cathhint_usedtrackernotfoundark_1_001_catherineomnitool_001">Has dicho que habías encontrado una herramienta de seguimiento. Pruébalo.</Entry>
        <Entry Name="cathandsimon_3_cathhint_usedtrackernotfoundark_2_001_catherineomnitool_001">Venga, usa la herramienta de seguimiento para encontrar el ARCA.</Entry>
        <Entry Name="simoncomments_3_comment_seecurie_001_player_001">Esta debe de ser el barco del que hablaba Catherine.</Entry>
        <Entry Name="simoncomments_3_comment_seecurie_001_player_002">Espero que todavía tenga una embarcación de escape que podamos usar.</Entry>
        <Entry Name="simoncomments_3_comment_enterlambda_001_player_001">Esto debe de ser Lambda, donde se encuentra Catherine.</Entry>
        <Entry Name="simoncomments_3_comment_getcathchip_1_001_player_001">Creo que debería coger el chip que mencionó Catherine.</Entry>
        <Entry Name="simoncomments_3_comment_getcathchip_2_001_player_001">Necesito encontrar el chip del que hablaba Catherine y conectarlo al Omnitool.</Entry>
        <Entry Name="simoncomments_3_comment_getcathchip_3_001_player_001">Catherine ha propulsado el chip de córtex del robot que habitaba. Debería desplazarlo al Omnitool.</Entry>
        <Entry Name="simoncomments_3_comment_usecathchip_1_001_player_001">Debería intentar recuperar a Catherine.</Entry>
        <Entry Name="simoncomments_3_comment_usecathchip_2_001_player_001">Vamos a conectar el chip al Omnitool.</Entry>
        <Entry Name="simoncomments_3_comment_usecathchip_3_001_player_001">Debería introducir el chip que he sacado del robot en el Omnitool para ver si Catherine puede darme alguna respuesta.</Entry>
        <Entry Name="terminal_3_comment_seelambdacomputer_001_player_001">¿Quieres comprobar el ordenador?</Entry>
        <Entry Name="terminal_3_comment_seelambdacomputer_002_catherineomnitool_001">Sí, busca cualquier cosa relacionada con el ARCA.</Entry>
        <Entry Name="simoncomments_3_comment_leavelambda_visitedlifeboat_001_player_001">Mierda... Necesito algo. Debería buscar en la embarcación que he encontrado fuera de Lambda.</Entry>
        <Entry Name="simoncomments_3_comment_leavelambda_notvisitedlifeboat_001_player_001">Oh, venga. Abres todo lo demás... ¿es una cuestión de permisos de seguridad?</Entry>
        <Entry Name="simoncomments_3_restatemission_001_player_001">Puedo encontrar Lambda, ¿vale? Venga, ¿tan grande es este océano?</Entry>
        <Entry Name="cathandsimon_2_interactcathbeforeomnitoolfirst_001_player_001">¿Qué querías que hiciera?</Entry>
        <Entry Name="cathandsimon_2_interactcathbeforeomnitoolfirst_002_catherinerobot_001">Esa herramienta que llevas. Conéctala en ese ordenador de ahí.</Entry>
        <Entry Name="cathandsimon_2_interactcathbeforeomnitoolrepeat_001_catherinerobot_001">Usa el Omnitool con el ordenador.</Entry>
        <Entry Name="cathandsimon_2_interactcathbeforeomnitoolrepeat_002_catherinerobot_001">Conecta el Omnitool al ordenador.</Entry>
        <Entry Name="cathandsimon_2_interactcathbeforeomnitoolrepeat_003_catherinerobot_001">Pon esa cosa cuadrada que llevas en el agujero de ahí donde encaja perfectamente.</Entry>
        <Entry Name="terminal_helperjane_plugin_001_helperjane_001">Terminal Lambda 27 activada.</Entry>
        <Entry Name="terminal_helperjane_addcortexchip_001_helperjane_001">Chip de córtex personalizado encontrado. Desconectando asistente Jane. Que tengas un buen día.</Entry>
        <Entry Name="terminal_helperjane_plugintoescapevessel_001_helperjane_001">No es posible activar la embarcación de escape. No se encuentra el protocolo.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_02_02_ms_curie_inside">
        <Entry Name="dialog_1_intro_001_player_001">¿Puedes controlar esto?</Entry>
        <Entry Name="dialog_1_intro_002_catherine_001">El timón de estribor está obturado, pero puedo compensarlo.</Entry>
        <Entry Name="dialog_1_intro_003_player_001">¿Cómo sabes siquiera en qué dirección vamos?</Entry>
        <Entry Name="dialog_1_intro_004_catherine_001">No te preocupes, me he conectado al navegador. Nos dirigimos a Zeta. Debería ser cuestión de minutos.</Entry>
        <Entry Name="dialog_1_intro_005_player_001">Pensé que no iba a salir con vida de ahí.</Entry>
        <Entry Name="dialog_1_intro_006_catherine_001">Parece que el WAU estaba impidiendo que la Curie entrara en fallo catastrófico. ¿Cómo ha llegado al barco?</Entry>
        <Entry Name="dialog_1_intro_007_player_001">¿Estamos hablando de los tentáculos negros de la sala de motores? Ya los había visto antes en Úpsilon. ¿Qué son?</Entry>
        <Entry Name="dialog_1_intro_008_catherine_001">Son una manifestación de WAU, una inteligencia artificial que gobierna toda la estación y que no está funcionando como debe.</Entry>
        <Entry Name="dialog_1_intro_009_player_001">¿Toda la estación? Entonces, acabamos de crearnos un enemigo poderoso.</Entry>
        <Entry Name="dialog_1_intro_010_catherine_001">No, no, no es eso. La IA no es una personalidad, no siente ni piensa como nosotros. Es más como... como un cáncer.</Entry>
        <Entry Name="dialog_1_afterexplosion_001_player_001">¿Ese era el barco?</Entry>
        <Entry Name="dialog_1_afterexplosion_002_catherine_001">Parece que tu sabotaje ha funcionado mejor de lo esperado.</Entry>
        <Entry Name="dialog_1_afterexplosion_002_catherine_002">¡Prepárate para el impacto!</Entry>
        <Entry Name="dialog_1_afterbeinghit_001_catherine_001">Agárrate! ¡La explosión nos ha sacado de la meseta!</Entry>
        <Entry Name="dialog_1_afterbeinghit_002_player_001">¡¿Qué significa eso?!</Entry>
        <Entry Name="dialog_1_afterbeinghit_003_catherine_001">Si no llego a Delta, estamos muertos.</Entry>
        <Entry Name="radio_1_staticvoice_001_automatedvoice_001">El cielo está negro y cubierto de humo. El océano está oscuro, increíblemente oscuro. Veo tierra firme en la distancia. Según el sistema de navegación, se trata de Lisboa y de la costa de Portugal.</Entry>
        <Entry Name="Radio_1_StaticVoice_002_AutomatedVoice_001">¿Algún indicio de vida? Cambio, ¿Hopper?</Entry>
        <Entry Name="Radio_1_StaticVoice_003_Hopper_001">Está en llamas. Todo está en llamas. Las llamas llegan hasta el cielo. Es irreal.</Entry>
        <Entry Name="Radio_1_StaticVoice_004_AutomatedVoice_001">¿Algún indicio de vida? Cambio.</Entry>
        <Entry Name="Radio_1_StaticVoice_005_Hopper_001">No, nada aparte de una gigantesca tormenta de fuego que cubre el continente.</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_001_catherine_001">Eh, ¿qué...?</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_002_catherine_001">Oh, lo has conseguido. Esto es mucho mejor. A ver si podemos hacer que esta cosa se mueva.</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_003_catherine_001">Uh, espera, ¿qué...? ¿Los bloqueos de seguridad están bloqueando la salida de la embarcación? ¿Estás de broma? ¿Crees que este barco podría estar en una emergencia peor? Está en el fondo del mar.</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_004_catherine_001">Entonces, mira en la sala de motores a ver si puedes averiguarlo. Quizá haya un mecanismo para anularlo, o algo así.</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_005_player_001">Ahí fuera hay monstruos. Como los que vimos en Lambda.</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_006_catherine_001">Más motivos para irnos.</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_007_player_001">¿Qué?</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_008_catherine_001">Venga, ya sabes cómo es esto: no los mires ni te acerques demasiado. Afectará a tus circuitos.</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_009_player_001">Mierda...</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_010_catherine_001">Tenemos que salir de aquí.</Entry>
        <Entry Name="cathmeeting_2a_plugincatherine_011_player_001">Lo sé, lo sé. Me voy.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_1_001_player_001">¿Qué son esas cosas? Parecen personas. Una gente muy estropeada...</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_1_002_catherine_001">Creo que podrían ser gente muerta resucitada.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_1_003_player_001">Vuelta a la vida.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_1_004_catherine_001">Bueno, llamémoslo eso.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_2_001_player_001">Catherine, ¿crees que deberíamos intentar ir a la superficie?</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_2_002_catherine_001">No, el cometa ha hecho algo radical en la atmósfera. Dudo que vuelva a estar como antes.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_2_003_player_001">Temía que dijeras eso.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_3_001_player_001">¿De verdad crees que esto nos va a llevar a Zeta de una pieza?</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_3_002_catherine_001">No veo por qué no. Parece estar en buen estado.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_3_003_player_001">¿En buen estado? Yo no usaría esa palabra, pero me alegro de ver tu seguridad.</Entry>
        <Entry Name="radio_captaindialog_1_001_captain_001">Atención a la tripulación, os habla el capitán. Los últimos esfuerzos por detener el cometa han fracasado oficialmente. El impacto es inminente.</Entry>
        <Entry Name="cathmeeting_3a_removewau_001_catherine_001">Por Dios, ¡¿qué es lo que has hecho?! El reactor se ha desequilibrado completamente, creo que estamos de mierda hasta el cuello.</Entry>
        <Entry Name="cathmeeting_3a_removewau_002_catherine_001">Simon, ¡se acaban de soltar los cierres del bote salvavidas! ¡Rápido, vuelve aquí!</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_001_player_001">Vale, ya estoy.</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_002_catherine_001">Entonces, larguémonos de aquí.</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_003_player_001">¿Por qué tarda tanto?</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_004_catherine_001">Tengo que bombear y sacar el agua antes de poder despegar.</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_005_player_001">¿No puedes darte más prisa?</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_006_catherine_001">¡Ya casi estoy!</Entry>
        <Entry Name="cathmeeting_3c_waterdrained_001_catherine_001">Vale, allá vamos. ¡Agárrate a algo!</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_branch2_001_catherine_001">¿Eh? ¿Qué demonios ha pasado aquí? ¿Qué son todos estos... de emergencia? ¡¿Qué es lo que has hecho?!</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_branch2_002_player_001">Lo he estropeado todo, ¿vale? ¿Puedes sacarnos de aquí?</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_branch2_003_catherine_001">Sí, sí. Solo tengo que bombear el agua para sacarla y preparar una trayectoria.</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_branch2_004_player_001">Date prisa.</Entry>
        <Entry Name="cathmeeting_3c_lifeboatescape_branch2_005_catherine_001">Un segundo.</Entry>
        <Entry Name="cathmeeting_3c_waterdrained_branch2_001_catherine_001">Vale, despegando. ¡Hay que agarrarse a algo!</Entry>
        <Entry Name="radio_captaindialog_2_001_captain_001">Curie está a salvo mientras está sumergido. La tripulación, o lo que queda de ella, están bien. Para el resto del mundo, no hay una manera buena de describirlo. La destrucción es absoluta. La superficie ha desaparecido.</Entry>
        <Entry Name="radio_brockleydialog_1_001_brockley_001">Estamos jodidos. Ha sido un terrible error. Incluso con los trajes, estamos en un terrible atolladero. Mantén Curie a salvo. ¡Olvídate de Omega, olvídate de la superficie!</Entry>
        <Entry Name="cathmeeting_hintescapepod_lookforpowerroom_1_001_catherine_001">Algo está estabilizando el barco. Tenemos que hacer que sepa que es una emergencia.</Entry>
        <Entry Name="cathmeeting_hintescapepod_lookforpowerroom_2_001_catherine_001">Convencer al barco de que esto es una emergencia.</Entry>
        <Entry Name="cathmeeting_hintescapepod_wreckpowerroom_1_001_catherine_001">Sabotea el estabilizador, Simon. Las cuerdas negras que mencionaste, tira de ellas hacia abajo.</Entry>
        <Entry Name="cathmeeting_hintescapepod_wreckpowerroom_2_001_catherine_001">Arranca todas las cuerdas negras.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_proom_001_player_001">¿Sabes... sabes algo sobre unas cuerdas negras metálicas que parecen alimentarse de la maquinaria?</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_proom_002_catherine_001">¿Eh?</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_proom_002_catherine_002">Ah, te refieres a que el WAU está aquí.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_proom_003_player_001">¿Qué?</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_proom_004_catherine_001">Eso es lo que mantiene el barco de una pieza.</Entry>
        <Entry Name="cathmeeting_2b_returntolifeboat_proom_004_catherine_002">Tira de ellas, Simon. Arráncalas todas.</Entry>
        <Entry Name="cathmeeting_2c_flesherenterslifeboat_001_catherine_001">¡Cuidado!</Entry>
        <Entry Name="cathmeeting_2c_enterlifeboatafterdeath_001_catherine_001">¿Simon? ¿Estás bien?</Entry>
        <Entry Name="cathmeeting_2c_enterlifeboatafterdeath_002_player_001">Creo que sí.</Entry>
        <Entry Name="cathmeeting_2c_enterlifeboatafterdeath_003_catherine_001">Me has dado un susto de muerte. Pensé que me iba a quedar aquí para siempre.</Entry>
        <Entry Name="simoncomments_1_enterlevel_001_player_001">Vale, ya estamos. Vamos a buscar una embarcación de escape que funcione.</Entry>
        <Entry Name="simoncomments_reactorwarning_001_autowarning_001">+¡Aviso! Colapso del reactor inminente. Procedan a las embarcaciones de emergencia.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_02_03_delta">
        <Entry Name="recording_7_zeppelintransmission_2_001_akers_001">Peter, ¿me oyes?</Entry>
        <Entry Name="recording_7_zeppelintransmission_2_002_strasky_001">Sí, te oigo, Terry. Quiero decir, Sr. Akers, señor.</Entry>
        <Entry Name="recording_7_zeppelintransmission_2_003_akers_001">He cambiado de opinión. Me gustaría ir a Zeta. Dejar dormir a Delta.</Entry>
        <Entry Name="recording_7_zeppelintransmission_2_004_strasky_001">¡Por supuesto! Uf, no pensé que volvería a tener noticias suyas. Hace mucho tiempo que no hablábamos.</Entry>
        <Entry Name="recording_7_zeppelintransmission_2_004_strasky_002">Tenemos varios buceadores en un zepelín estudiando Lambda. Me aseguraré de que le recojan cuando terminen.</Entry>
        <Entry Name="recording_7_zeppelintransmission_2_005_akers_001">Ah, y gracias por la advertencia. Me aseguraré de que se sientan como en casa.</Entry>
        <Entry Name="recording_7_zeppelintransmission_2_006_strasky_001">Vale, nos vemos cuando llegue aquí.</Entry>
        <Entry Name="recording_7_zeppelintransmission_1_001_wan_001">¿Strasky? Ya podemos ver el zepelín.</Entry>
        <Entry Name="recording_7_zeppelintransmission_1_002_strasky_001">Bien. Perdón por el desastre. Sin el sistema de posicionamiento, los zeps pierden todo el rato las rutas definidas.</Entry>
        <Entry Name="recording_7_zeppelintransmission_1_002_strasky_002">Wolchezk dijo que podrías haberlo arreglado desde ahí reconectando la antena.</Entry>
        <Entry Name="recording_7_zeppelintransmission_1_002_strasky_003">Supongo que ya no importa. ¿Vais a venir todos?</Entry>
        <Entry Name="recording_7_zeppelintransmission_1_003_wan_001">No, solo yo, Goya y Krier. Akers se ha empeñado en comportarse como un viejo cabezota.</Entry>
        <Entry Name="recording_7_zeppelintransmission_1_004_strasky_001">De acuerdo. Hasta pronto, Brandon. ¡Feliz evacuación!</Entry>
        <Entry Name="datamine_2_dataminemaggie_003_maggie_001">Adelante, Strasky. ¿Me recibes?</Entry>
        <Entry Name="datamine_2_dataminemaggie_004_maggie_001">¡Zeta, escucha! ¡Akers se dirige a Zeta!</Entry>
        <Entry Name="datamine_2_dataminemaggie_005_strasky_001">Delta LUMAR Annex, recibiendo una señal pero sin sonido.</Entry>
        <Entry Name="datamine_2_dataminemaggie_006_maggie_001">¡Strasky! ¡Soy Komorebi! ¡Akers ha perdido el juicio, es peligroso!</Entry>
        <Entry Name="datamine_2_dataminemaggie_007_maggie_001">¡¿Strasky?!</Entry>
        <Entry Name="datamine_2_dataminemaggie_008_strasky_001">Lo siento, Delta. Todavía no hay sonido, intenta llamar desde otro punto de acceso.</Entry>
        <Entry Name="datamine_2_dataminemaggie_009_maggie_001">Strasky, puedo intentar enviar... Tengo imágenes...</Entry>
        <Entry Name="recording_7_zeppelincontact_1_001_automated voice_001">Transporte activo. Carga no especificada.</Entry>
        <Entry Name="recording_7_zeppelincontact_2_001__soundeffect_001">*interferencias*</Entry>
        <Entry Name="recording_7_zeppelincontact_3_1_001_zeppelin3_001">Está por todas partes.</Entry>
        <Entry Name="recording_7_zeppelincontact_3_1_002_player_001">¿Qué, hola?</Entry>
        <Entry Name="recording_7_zeppelincontact_3_2_001_zeppelin3_001">Toda esa agua... Nos estamos hundiendo.</Entry>
        <Entry Name="recording_7_zeppelincontact_3_2_002_player_001">¿Quién es?</Entry>
        <Entry Name="recording_7_zeppelincontact_3_2_003_zeppelin3_001">Alan. ¿Cómo te llamas?</Entry>
        <Entry Name="recording_7_zeppelincontact_3_2_004_player_001">Simon. ¿Dónde... Dónde estás?</Entry>
        <Entry Name="recording_7_zeppelincontact_3_3_001_player_001">Alan, ¿me oyes? ¿Alan?</Entry>
        <Entry Name="Recording_7_ZeppelinContact_3_3_002__SoundEffect_001">*interferencias*</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_001">¿Me escuchas hablar? Claro que sí.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_002">Quería que supieras... que lo sé. No me elegiste a ciegas entre la manada.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_003">La resaca de las lentas olas de Delta rompiendo contra la orilla te sumerge en un sueño ligero.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_004">Es hermoso, y no voy a ser egoísta. Voy a ayudar, a arroparlos, a ver cómo duermen.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_005">Ellos también encuentran la paz dentro del universo del WAU.</Entry>
        <Entry Name="comment_7_allantennasupfailedcall_001_player_001">Ahí. Ahora debería poder conseguir el zepelín.</Entry>
        <Entry Name="comment_7_calledzeppelin_001_player_001">El zepelín está en camino. Será mejor prepararse.</Entry>
        <Entry Name="comment_7_seeingzeppelin_001_player_001">Sin duda, eso es el zepelín.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_001_catherine_001">¡Ah!</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_002_player_001">Calma. Estamos a salvo.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_003_catherine_001">Es desconcertante existir y dejar de hacerlo así, de repente. ¿Dónde estamos ahora?</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_004_player_001">En Delta, al menos eso es lo que dijiste antes del accidente.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_005_catherine_001">Oh, claro. Por supuesto. ¿Esto es un zepelín?</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_006_player_001">El nombre le va que ni pintado. ¿Crees que podría llevarnos a Zeta?</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_007_catherine_001">Es un transporte de carga. Los usan para transportar materiales entre los centros. Todo lo que es demasiado grande para las lanzaderas. Seguro que puede llevarnos.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_008_catherine_001">Grr, ¿por qué no funciona? Venga... Oh, el chip de herramientas está roto.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_009_player_001">¿Eso no es una pieza del Omnitool?</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_010_catherine_001">Vaya, mira quién ha estado prestando atención.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_011_player_001">En Úpsilon tuve que hacerlo.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_012_catherine_001">Entonces, ya sabes cómo funciona. Tenemos que conseguir un nuevo chip de herramientas y cambiarlo.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_013_player_001">¿Podrías indicarme cómo llegar al almacén de chips de herramientas más cercano?</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_014_catherine_001">Creo que sería más fácil coger uno de un robot.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_015_player_001">¿Qué? ¿Le doy un mamporro a un robot en la cabeza y le robo los chips?</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_016_catherine_001">Esa caja de herramientas de ahí dice que tiene un bastón de aturdimiento. Podrías usar eso.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_017_player_001">Venga, no quiero hacerle daño a nadie, ¿eso no es demasiado?</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_018_catherine_001">No es más que un robot, Simon.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_019_player_001">¡Nosotros no somos más que robots!</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_019_player_002">Más o menos.</Entry>
        <Entry Name="dialog_8_insertcatherineonplatform_020_player_001">Voy a conseguir el chip.</Entry>
        <Entry Name="dialog_8_fixcatherine_start_001_catherine_001">Gracias, Simon. No te enfades, ¿vale? Necesitamos ese chip desesperadamente. Nos podríamos quedar aquí atascados...</Entry>
        <Entry Name="dialog_8_fixcatherine_start_002_player_001">¿Podrías hacerlo? ¿Matar a un robot, sin más?</Entry>
        <Entry Name="dialog_8_fixcatherine_start_003_catherine_001">Yo también me encariño con ellos, no soy un monstruo. Pero, en este caso, había que hacerlo.</Entry>
        <Entry Name="dialog_8_pushycatherine_1_001_player_001">Yo... Me siento fatal.</Entry>
        <Entry Name="dialog_8_pushycatherine_1_002_catherine_001">Los robots solo parecen ser seres inteligentes. Se parecen más a los perros que a los humanos.</Entry>
        <Entry Name="dialog_8_pushycatherine_1_003_player_001">¡Yo no golpearía a un perro!</Entry>
        <Entry Name="dialog_8_pushycatherine_1_004_catherine_001">Lo siento, he elegido mal las palabras.</Entry>
        <Entry Name="dialog_8_pushycatherine_1_005_player_001">¡No quiero hacerle daño a nadie!</Entry>
        <Entry Name="dialog_8_pushycatherine_1_006_catherine_001">Bueno, necesitamos un chip de herramientas o nos quedaremos aquí atascados.</Entry>
        <Entry Name="comment_8_tookstunrod_001_player_001">Supongo que no tengo elección.</Entry>
        <Entry Name="comment_8_firststunrodhit_001_player_001">Oh, venga.</Entry>
        <Entry Name="comment_8_takingchip_001_player_001">Espero que esto funcione.</Entry>
        <Entry Name="comment_8_nottakingchip_001_player_001">Todavía necesito el chip para reparar a Catherine.</Entry>
        <Entry Name="dialog_8_playerarriveswithchip_001_catherine_001">Debería resultar fácil de arreglar.</Entry>
        <Entry Name="dialog_2_escapepoddistresssignal_001_automated voice_001">Equipo de rescate de Delta notificado. Por favor, permanezcan en sus asientos.</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_001_evans_001">Has visto eso, ¡¿verdad?! ¡¿Has visto cómo Akers les inyectaba esa puta mierda?!</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_002_maggie_001">Me ha pillado de lleno.</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_003_evans_001">Creo que lo he empeorado al estirar. Yo... Siento como se desangra.</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_003_evans_002">¿Puedes verlo?</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_004_maggie_001">¡Joder, se ha subido al zepelín! Va a regresar a Zeta.</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_004_maggie_002">Tenemos que advertírselo.</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_005_evans_001">Buena suerte. La radio de la plataforma no funciona, ¿recuerdas?</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_006_maggie_001">El LUMAR Annex debería funcionar. Tiene que funcionar.</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_007_evans_001">Sí, tú vas. No lo voy a conseguir.</Entry>
        <Entry Name="datamine_3_dataminelaunchsitecrew_008_maggie_001">Venga, Evans. Tenemos que avisarlos, venga...</Entry>
        <Entry Name="dialog_8_zeppelinliftoff_001_catherine_001">Gracias.</Entry>
        <Entry Name="dialog_8_stunningtakingtoolong_1_001_player_001">¿Podemos hacer esto de otra manera? Estos robots no han hecho nada malo.</Entry>
        <Entry Name="dialog_8_stunningtakingtoolong_1_002_catherine_001">¡Venga ya! Necesito uno de sus chips de herramientas para que podamos volar hasta allí.</Entry>
        <Entry Name="comment_2_doorisstuck_001_player_001">Jamás conseguiré abrir esto.</Entry>
        <Entry Name="comment_2_seeskate_notrescued_001_player_001">Tú eres el equipo de rescate, ¿eh? Buen trabajo.</Entry>
        <Entry Name="dialog_9_katehelpedplayer_001_player_001">Gracias, hombrecillo. Eres más fuerte de lo que pareces.</Entry>
        <Entry Name="dialog_9_katehelpedplayer_002_player_001">Eres muy útil, hombrecillo, ¿lo sabías?</Entry>
        <Entry Name="dialog_9_katehelpedplayer_003_player_001">Necesito un punto de apoyo mejor.</Entry>
        <Entry Name="comment_9_nearedge_001_player_001">La caída es muy profunda.</Entry>
        <Entry Name="comment_9_nearedge_002_player_001">Ten cuidado, Simon. Cuidado.</Entry>
        <Entry Name="comment_7_triedopeningtraindoor_001_player_001">Está cerrado por el óxido. Probablemente sea mejor así. No sé si me fío del tren lanzadera.</Entry>
        <Entry Name="comment_2_seeskate_rescued_001_player_001">Eh, hombrecillo. No esperaba volver a verte.</Entry>
        <Entry Name="goya_2_confusedrobotidling_001_goya_001">Un día brutal, ¿me equivoco? No me puedo creer cuánto estoy sudando con este traje.</Entry>
        <Entry Name="goya_2_confusedrobotidling_002_goya_001">Creo que pronto voy a necesitar vacaciones. Tengo que hablar de eso con Akers. ¿No es cierto, Akers?</Entry>
        <Entry Name="goya_2_confusedrobotidling_003_goya_001">Sí, ¿dirás algo de mi parte? No sé si eso es buena idea. Bah, solo te estoy tomando el pelo.</Entry>
        <Entry Name="goya_2_confusedrobotidling_004_goya_001">Brandon, ¿has movido la cubierta de Cartago? Tenemos que probarla antes de enviarla.</Entry>
        <Entry Name="goya_2_confusedrobotidling_005_goya_001">Se nota mucho cuando Astrid está fuera de la plataforma. Este lugar parece un vestuario. Y no en el lado positivo...</Entry>
        <Entry Name="goya_2_confusedrobotidling_006_goya_001">No sé, tío. Yo creo que podemos mantener la clase aunque no estén las mujeres, ¿entiendes?</Entry>
        <Entry Name="goya_2_confusedrobotidling_007_goya_001">Sí, sí. Cuántas tonterías dices, Brandon. Te he visto cuando aparece Alice Koster, la directora de carga útil.</Entry>
        <Entry Name="goya_2_confusedrobotidling_008_goya_001">¿Tú le dejarías gestionar tu carga útil? ¿Qué? Eso ni siquiera tiene sentido. Venga, basta de hacer el idiota y a trabajar.</Entry>
        <Entry Name="goya_2_confusedrobotidling_009_goya_001">Olvídalo, Akers, ya no voy a jugar contigo. Como si el ajedrez no fuera ya lo bastante aburrido... Solo tienes que ir y ganar en cuatro movimientos.</Entry>
        <Entry Name="goya_2_confusedrobotidling_010_goya_001">¿Has movido los escudos exteriores? ¡No! ¡El fino, el que está generando! Sí, sí, ya sé que, técnicamente, no es un escudo. No importa, lo he encontrado.</Entry>
        <Entry Name="goya_2_confusedrobotidling_011_goya_001">¿Por qué ibas a querer ir a Zeta? ¿Para qué ser un pez pequeño en un estanque grande?</Entry>
        <Entry Name="goya_2_confusedrobotidling_012_goya_001">Si te digo la verdad, me encanta mi trabajo. Me gusta que Delta sea una operación muy ajustada. Aquí puedo probarlo todo.</Entry>
        <Entry Name="goya_2_confusedrobotidling_013_goya_001">Tiene buena pinta, ¿verdad? Sí, servirá.</Entry>
        <Entry Name="goya_2_confusedrobotidling_014_goya_001">Cuidado, Brand. Con tranquilidad.</Entry>
        <Entry Name="goya_2_confusedrobotidling_015_goya_001">Sí, solo unos pocos más.</Entry>
        <Entry Name="goya_2_confusedrobotidling_016_goya_001">Eh, prueba el otro. No funciona.</Entry>
        <Entry Name="goya_2_confusedrobotidling_017_goya_001">Lo tengo.</Entry>
        <Entry Name="dialog_8_returnnobaton_001_catherine_001">Yo no recomendaría enfrentarse a un robot con las manos. En esa caja de herramientas de ahí hay un bastón. Los buceadores los usan para asustar a los tiburones, así que seguro que atiza bien.</Entry>
        <Entry Name="dialog_8_returnnobaton_002_catherine_001">Deberías coger el bastón de esa caja de herramientas. No queremos que los robots acaben robándote los chips.</Entry>
        <Entry Name="dialog_8_returnnobaton_003_catherine_001">No te olvides del bastón. Lo necesitarás para pelear con los robots.</Entry>
        <Entry Name="dialog_8_returnnobaton_004_catherine_001">Coge el bastón de la caja de herramientas. Seguro que resultará útil.</Entry>
        <Entry Name="dialog_8_fixcatherine_kate_001_player_001">¿Hay alguna diferencia entre ellos? He optado por uno pequeño.</Entry>
        <Entry Name="dialog_8_fixcatherine_kate_002_catherine_001">¡No, no un K-8, son monísimos!</Entry>
        <Entry Name="dialog_8_fixcatherine_kate_003_player_001">¡¿Qué?!</Entry>
        <Entry Name="dialog_8_fixcatherine_kate_004_catherine_001">No te preocupes, son más tontos que las rocas.</Entry>
        <Entry Name="dialog_8_fixcatherine_kate_005_player_001">Eres lo peor.</Entry>
        <Entry Name="dialog_8_fixcatherine_delusionalrobot_001_player_001">Él estaba hablando. Estaba delirando, pero parecía sincero, presente.</Entry>
        <Entry Name="dialog_8_fixcatherine_delusionalrobot_002_catherine_001">Sí, bueno... Seguro que está bien.</Entry>
        <Entry Name="dialog_8_fixcatherine_delusionalrobot_003_player_001">¿De verdad era tan diferente a nosotros?</Entry>
        <Entry Name="dialog_8_fixcatherine_end_001_player_001">Estoy empezando a asumirlo, a asumirlo de verdad... Soy un robot.</Entry>
        <Entry Name="dialog_8_fixcatherine_end_002_catherine_001">¿No habíamos hablado ya de esto?</Entry>
        <Entry Name="dialog_8_fixcatherine_end_003_player_001">Supongo que lo he sabido desde que me desperté en Úpsilon.</Entry>
        <Entry Name="dialog_8_fixcatherine_end_003_player_002">Intento reprimirlo, como si mi cerebro no quisiera pensar en ello.</Entry>
        <Entry Name="dialog_8_fixcatherine_end_003_player_003">Cada vez es más difícil no pensarlo.</Entry>
        <Entry Name="dialog_8_fixcatherine_end_004_catherine_001">Sí... ¿Podrías darle a ese interruptor de ahí para que podamos ponernos en marcha?</Entry>
        <Entry Name="dialog_8_fixcatherine_end_005_player_001">Oh sí, claro.</Entry>
        <Entry Name="goya_8_goyahit_001_goya_001">Grrrr, ¿Qué... qué está sucediendo?</Entry>
        <Entry Name="goya_8_goyahit_002_goya_001">¡Argh, joder! Eso duele.</Entry>
        <Entry Name="goya_8_goyahit_003_goya_001">¡Grrr!</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_1_001_goya_001">Brandon. ¿Estás bien? ¿Qué demonios ha pasado?</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_1_002_goya_001">No lo entiendo. ¿Qué ha sido eso?</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_1_003_goya_001">Abajo, Brandon. No sé si es seguro.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_1_004_goya_001">Por Dios... Este lugar es una locura.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_1_005_goya_001">¡Akers! ¡¿Has visto esto?!</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_1_006_goya_001">Eso ha dolido.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_1_007_goya_001">Ha salido de la nada.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_1_008_goya_001">Hay que tener más cuidado.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_2_001_goya_001">¡Tíos, necesito ayuda!</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_2_002_goya_001">¡¿Brandon?! ¡Venga, ayúdame!</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_2_003_goya_001">Mierda, el traje se está llenando de agua.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_2_004_goya_001">Ah, Dios mío, hay mucha sangre.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_2_005_goya_001">Tíos, estoy jodido. Estoy muy mal.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_2_006_goya_001">¡¿Brandon?! ¡¿Terry?!</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_2_007_goya_001">No quiero morir.</Entry>
        <Entry Name="goya_2_confusedrobotidling_damaged_2_008_goya_001">¿Por qué está pasando esto?</Entry>
        <Entry Name="dialog_8_cathhint_nostunrod_1_001_catherine_001">Coge el bastón de la caja que he abierto y busca un robot que tenga un chip de herramientas que funcione.</Entry>
        <Entry Name="dialog_8_cathhint_nochip_1_001_catherine_001">Eh, necesitamos el chip de herramientas, ¿recuerdas? No estamos matando robots por diversión.</Entry>
        <Entry Name="dialog_8_cathhint_nochip_2_001_catherine_001">Coge el chip del robot que dejaste inconsciente.</Entry>
        <Entry Name="dialog_8_cathhint_nostunrod_2_001_catherine_001">Coge el bastón de esa caja de ahí y ve a buscar un robot que tenga un chip de herramientas que funcione.</Entry>
        <Entry Name="dialog_8_cathhint_hurtrobot_1_001_catherine_001">Necesitamos un chip de herramientas de uno de los robots. Deberías poder dejarlos KO con el bastón que has cogido.</Entry>
        <Entry Name="dialog_8_cathhint_hurtrobot_2_001_catherine_001">Usa el bastón que has cogido para dejar KO a un robot y robarle el chip de herramientas.</Entry>
        <Entry Name="dialog_8_cathhint_killrobot_1_001_catherine_001">El bastón no ha sido diseñado precisamente para aporrear robots, quizá tengas que darle unas cuantas veces.</Entry>
        <Entry Name="dialog_8_cathhint_killrobot_2_001_catherine_001">Tienes que seguir dándole al robot hasta que caiga.</Entry>
        <Entry Name="comment_2_restateobjective_001_player_001">No te preocupes, Cath. Encontraré la manera de llegar a Zeta.</Entry>
        <Entry Name="comment_3_kateopeneddoor_001_player_001">¡Buen robot!</Entry>
        <Entry Name="goya_2_goyainteract_player_001_player_001">Oye, ¿crees que podrías echar una mano? Necesito llegar a Zeta.</Entry>
        <Entry Name="goya_2_goyainteract_player_002_player_001">Eh, eh, ¿me oyes?</Entry>
        <Entry Name="goya_2_goyainteract_player_003_player_001">Eh, tú...</Entry>
        <Entry Name="goya_2_goyainteract_player_004_player_001">Escucha...</Entry>
        <Entry Name="goya_2_goyainteract_goya_001_goya_001">No te quedes ahí, tienes más cabeza que eso.</Entry>
        <Entry Name="goya_2_goyainteract_goya_002_goya_001">Ayúdame, ¿quieres?</Entry>
        <Entry Name="goya_2_goyainteract_goya_003_goya_001">Dame un poco de espacio, ¿vale?</Entry>
        <Entry Name="goya_2_goyainteract_goya_004_goya_001">Haz algo útil.</Entry>
        <Entry Name="goya_2_goyainteract_goya_005_goya_001">No te preocupes, lo tengo.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_02_04_theta_outside">
        <Entry Name="dialog_1_catherinegivesdirections_001_catherine_001">Lo has hecho muy bien, Simon. Hemos tenido un ligero desvío a Delta, pero seguimos por buen camino.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_002_player_001">Sí.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_003_catherine_001">Deberíamos aterrizar en una plataforma de carga justo a las afueras de Zeta. Entramos, cogemos el DUNBAT y bajamos al abismo. 4000 metros. Hay un largo camino.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_003_catherine_002">Pero no tenemos que preocuparnos, porque con el DUNBAT el ARCA podría haber estado en la Fosa de las Marianas, aguantaría cualquier cosa.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_004_player_001">Eso está genial.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_005_catherine_001">Y luego podemos empezar a escuchar a otras personas cuando hablan, porque así es como funcionan las conversaciones.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_006_player_001">¿Qué? Oh, lo siento. Es que no puedo dejar de pensar en lo que nos hemos convertido. Es evidente que ya no somos humanos. Pero entonces, ¿cómo es que puedo sentir como Simon? ¿Cómo puedo sentir algo?</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_006_player_002">Quiero decir... Técnicamente no tengo orejas ni boca... Es raro pensarlo. Emito sonidos... Todavía estoy diciendo cosas.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_007_catherine_001">De eso no hay duda...</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_007_catherine_002">Tu nuevo cuerpo probablemente tiene sentidos parecidos a los que tenías cuando eras un ser humano. Y tu mente, conociendo solo una manera de percibir el mundo superpone esa habilidad definida sobre tus nuevas características.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_008_player_001">Entonces mi mente lo está encubriendo, haciendo como si nada fuera diferente.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_009_catherine_001">Si no lo hiciera, probablemente serías incapaz de interactuar por el mundo. Y el estrés llegaría a matarte o a perder el juicio.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_010_player_001">Así que he encontrado un buen equilibrio entre la consciencia y la ignorancia.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_010_player_002">¿Significa eso que no debería pensar en estas cosas o son mis pensamientos los que me ayudan a soportarlo?</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_012_player_001">¿Podría inclinar la balanza aumentando de repente mi percepción y perder el juicio?</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_013_catherine_001">Yo no me preocuparía por eso. Tenemos asuntos reales que tratar. Salvar a la humanidad, ¿recuerdas?</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_013_catherine_002">Y hablando de eso... Nos estamos acercando a Zeta, voy a propulsar el Omnitool. No olvides llevarme contigo.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_014_player_001">Cath, antes de que te vayas... ¿La inteligencia artificial que mencionaste en la embarcación de escape?</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_015_player_001">Oh, sí, ¿la unidad guardiana?</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_016_player_001">¿Estamos así por culpa del WAU? Quiero decir que parece algo que haría una IA no fiable.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_017_catherine_001">Supongo que puso en marcha todo esto, pero no se guía por un propósito.</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_017_catherine_002">Es muy difícil explicar cómo funcionan las máquinas, Simon. Concéntrate en entrar en Zeta, ¿vale?</Entry>
        <Entry Name="dialog_1_catherinegivesdirections_019_catherine_001">Hasta pronto.</Entry>
        <Entry Name="comment_3_openingmechanismbroken_001_player_001">Puedo apañármelas con esto.</Entry>
        <Entry Name="datamine_antennadatamine_001_strohmeier_001">¿Está encendida esta cosa? ¿Me oye todo el mundo?</Entry>
        <Entry Name="datamine_antennadatamine_002_strasky_001">Adelante, Strohm.</Entry>
        <Entry Name="datamine_antennadatamine_003_strohmeier_001">Escuchad, a todo el personal.</Entry>
        <Entry Name="datamine_antennadatamine_004_strohmeier_001">El proyecto ARCA ha provocado muchas discusiones durante los últimos meses. No voy a fingir que comprendo de qué diablos hablaba Sarang y cómo, de repente, la lógica de su Continuidad te lleva al suicidio.</Entry>
        <Entry Name="datamine_antennadatamine_004_strohmeier_002">Por el amor de Dios, o por lo que coño sea que te parezca importante, no te suicides. Este lugar ya es lo bastante patético: no obligues a tus amigos a limpiar tu sangre.</Entry>
        <Entry Name="datamine_antennadatamine_004_strohmeier_003">Descansad en paz, todos vosotros.</Entry>
        <Entry Name="datamine_antennadatamine_005_strohmeier_001">¿Bien?</Entry>
        <Entry Name="datamine_antennadatamine_006_strasky_001">Precioso.</Entry>
        <Entry Name="datamine_antennadatamine_007_strasky_001">De acuerdo, escuchad todos. Se acabó el espectáculo. Volved al trabajo.</Entry>
        <Entry Name="dialog_bassrobot_wakes_001_bassrobot_001">Eso es todo, ¿verdad? Gracias, Catherine.</Entry>
        <Entry Name="dialog_bassrobot_wakes_002_bassrobot_001">Espera, ¿ya estoy aquí?</Entry>
        <Entry Name="dialog_bassrobot_line1_001_bassrobot_001">No lo entiendo.</Entry>
        <Entry Name="dialog_bassrobot_conversation1_001_player_001">¿Hola?</Entry>
        <Entry Name="dialog_bassrobot_conversation1_002_bassrobot_001">¿Quién es? ¿Mark?</Entry>
        <Entry Name="dialog_bassrobot_conversation1_003_player_001">No. No nos hemos visto antes.</Entry>
        <Entry Name="dialog_bassrobot_conversation1_004_bassrobot_001">¿Esto es el ARCA?</Entry>
        <Entry Name="dialog_bassrobot_conversation1_005_player_001">Creo que estamos a salvo.</Entry>
        <Entry Name="dialog_bassrobot_conversation1_006_bassrobot_001">Oh, me preocupaba que algo hubiera salido mal.</Entry>
        <Entry Name="dialog_bassrobot_conversation1_007_player_001">¿Cómo te llamas?</Entry>
        <Entry Name="dialog_bassrobot_conversation1_008_bassrobot_001">Robin Bass, técnico de mantenimiento de campo de Zeta.</Entry>
        <Entry Name="dialog_bassrobot_conversation1_009_player_001">Es un placer, Robin.</Entry>
        <Entry Name="dialog_bassrobot_conversation2_001_player_001">¿Cómo has llegado aquí?</Entry>
        <Entry Name="dialog_bassrobot_conversation2_002_bassrobot_001">Me escanearon, como a los demás. Y después me suicidé.</Entry>
        <Entry Name="dialog_bassrobot_conversation2_002_bassrobot_002">Al menos, eso creo. Esa parte no la recuerdo.</Entry>
        <Entry Name="dialog_bassrobot_conversation2_003_player_001">¿Cómo funciona eso? ¿Morir te llevó a entrar en el ARCA?</Entry>
        <Entry Name="dialog_bassrobot_conversation2_004_bassrobot_001">Uf, está claro que tú no eres de Zeta. Deja que lo adivine... ¿Ómicron? No sabía si Catherine podría escanearos a vosotros. Tenéis suerte. En Zeta se habló mucho sobre esto.</Entry>
        <Entry Name="dialog_bassrobot_conversation2_004_bassrobot_002">La idea es que, cuando te activan en el ARCA, básicamente hay dos entidades que son tú, ¿correcto? Una humana y un escáner viviente en el ARCA.</Entry>
        <Entry Name="dialog_bassrobot_conversation2_004_bassrobot_003">Lo que tú quieres no es que tu copia te sobreviva, sino sobrevivir tú en el ARCA. Si tu forma humana muere antes de iniciar el escaneado, o poco después de este, serás tú el que viva en el ARCA. Alucinante, ¿verdad?</Entry>
        <Entry Name="dialog_bassrobot_conversation3_001_player_001">¿Fue Catherine quien te animó a esto, a suicidarte?</Entry>
        <Entry Name="dialog_bassrobot_conversation3_002_bassrobot_001">¿Catherine Chun? No. Creo que no lo comprendes. Ella solo escaneó gente y la colocó en el ARCA.</Entry>
        <Entry Name="dialog_bassrobot_conversation3_002_bassrobot_002">Espero poder verla pronto para disculparme. Siempre se metía en líos con Strohmeier cuando alguien se suicidaba.</Entry>
        <Entry Name="dialog_bassrobot_conversation3_003_player_001">Creo que no le importa.</Entry>
        <Entry Name="dialog_bassrobot_conversation3_004_bassrobot_001">¿Dónde está todo el mundo? Pensé que aquí habría unas cuarenta o cincuenta personas.</Entry>
        <Entry Name="dialog_bassrobot_conversation3_005_player_001">No lo sé. Si veo a alguien, te lo diré.</Entry>
        <Entry Name="dialog_bassrobot_conversation4_001_player_001">Robin, no sé cómo decir esto...</Entry>
        <Entry Name="dialog_bassrobot_conversation4_002_bassrobot_001">¿Qué?</Entry>
        <Entry Name="dialog_bassrobot_conversation4_003_player_001">Esto... Esto es...</Entry>
        <Entry Name="dialog_bassrobot_conversation4_004_bassrobot_001">¿Sí?</Entry>
        <Entry Name="dialog_bassrobot_conversation4_005_player_001">Increíble, ¿verdad? Me refiero al ARCA.</Entry>
        <Entry Name="dialog_bassrobot_conversation4_006_bassrobot_001">Sí, es genial. Catherine y los chicos lo han conseguido. Nos han salvado a todos.</Entry>
        <Entry Name="dialog_bassrobot_conversation5_001_player_001">Hasta luego.</Entry>
        <Entry Name="dialog_bassrobot_conversation5_002_bassrobot_001">Sí.</Entry>
        <Entry Name="dialog_bassrobot_conversation6_001_player_001">Me marcho.</Entry>
        <Entry Name="dialog_bassrobot_conversation6_002_bassrobot_001">Si encuentras a alguien más, avísame.</Entry>
        <Entry Name="dialog_bassrobot_conversation7_001_player_001">¿Estás bien?</Entry>
        <Entry Name="dialog_bassrobot_conversation7_002_bassrobot_001">Creo que sí. Me siento bien.</Entry>
        <Entry Name="dialog_bassrobot_die_001_bassrobot_001">¡Cielos! ¿Qué estás haciendo? ¡Para, para, por favor!</Entry>
        <Entry Name="dialog_bassrobot_die_002_player_001">*resuello*</Entry>
        <Entry Name="dialog_bassrobot_line2_001_bassrobot_001">¿Se supone que tiene que ser así?</Entry>
        <Entry Name="dialog_bassrobot_line3_001_bassrobot_001">Esperaba algo distinto.</Entry>
        <Entry Name="dialog_bassrobot_line4_001_bassrobot_001">¿Dónde está todo el mundo? Yo fui la única persona a la que escanearon.</Entry>
        <Entry Name="dialog_bassrobot_line5_001_bassrobot_001">¿Mark? ¿Hola?</Entry>
        <Entry Name="dialog_bassrobot_line6_001_bassrobot_001">Es diferente...</Entry>
        <Entry Name="dialog_bassrobot_line7_001_bassrobot_001">Quizá esto sea un paraíso.</Entry>
        <Entry Name="dialog_bassrobot_line8_001_bassrobot_001">No me siento preparada.</Entry>
        <Entry Name="dialog_bassrobot_line9_001_bassrobot_001">Quizá mejore con el tiempo...</Entry>
        <Entry Name="dialog_bassrobot_line10_001_bassrobot_001">No sé si es esto.</Entry>
        <Entry Name="dialog_bassrobot_line11_001_bassrobot_001">¿Eh?</Entry>
        <Entry Name="dialog_bassrobot_line12_001_bassrobot_001">Uau.</Entry>
        <Entry Name="dialog_bassrobot_line13_001_bassrobot_001">Oh.</Entry>
        <Entry Name="dialog_bassrobot_line14_001_bassrobot_001">Qu...</Entry>
        <Entry Name="dialog_bassrobot_line15_001_bassrobot_001">Uh...</Entry>
        <Entry Name="datamine_landingdatamine_001_alvaro_001">Strasky, despierta a la Dra. Masters, vamos a traer a Akers.</Entry>
        <Entry Name="datamine_landingdatamine_002_strasky_001">¿Qué pasa?</Entry>
        <Entry Name="datamine_landingdatamine_003_alvaro_001">¿Qué puedo decir? Ha tenido un mal día.</Entry>
        <Entry Name="datamine_landingdatamine_004_wan_001">¡Madre mía! Está destrozado por la metralla de la estructura. El WAU no se ha cortado nada con él.</Entry>
        <Entry Name="datamine_landingdatamine_005_alvaro_001">Brandon, activa el interruptor de pánico del traje, no quiero agotar el oxígeno.</Entry>
        <Entry Name="datamine_landingdatamine_006_wan_001">Estás de guasa, ¿verdad? Está colgando de un puto hilo... Tenemos que moverlo.</Entry>
        <Entry Name="datamine_landingdatamine_007_alvaro_001">Strasky, prepara la enfermería. Tenemos que movernos rápido.</Entry>
        <Entry Name="datamine_landingdatamine_008_strasky_001">¡Espera! ¿Dónde están Komorebi y los demás?</Entry>
        <Entry Name="datamine_landingdatamine_009_alvaro_001">Esto es todo lo que tenemos. Supongo que siguen en Delta.</Entry>
        <Entry Name="datamine_landingdatamine_010_wan_001">Emma, no puedo hacer esto sin ayuda, coge por el otro lado.</Entry>
        <Entry Name="datamine_landingdatamine_012_alvaro_001">Strask, estemos o no estemos listos, vamos allá.</Entry>
        <Entry Name="datamine_landingdatamine_013_strasky_001">De acuerdo. Hasta pronto.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_001_CathDatamine_001">Sarah, ¿estás ahí?</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_002_Lindwall_001">¿Quién es? ¿Catherine? Tengo mucho trabajo.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_003_CathDatamine_001">Solo quería decir: gracias, gracias por lo que hiciste.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_004_Lindwall_001">No te preocupes. Pero deberías defenderte sola. Strohmeier no tiene esa clase de autoridad. Puedes mandarlo a tomar por culo.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_005_CathDatamine_001">Yo no... Yo no soy ese tipo de persona.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_006_Lindwall_001">No puedes esperar que la gente pelee por ti todo el tiempo. Eres una persona brillante, Cath. Eres tan inteligente que haces que la cabeza me dé vueltas. Pero a veces desapareces en tu interior. De repente, es como hablar con una cría de cinco años.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_007_CathDatamine_001">Es difícil. Yo no puedo convertirme en otra cosa, sin más. Todo el mundo sabría que estoy fingiendo.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_008_Lindwall_001">No es demasiado tarde para ganarse a la gente. Strasky te tiene aprecio. Yo también. Reed te tiene aprecio.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_009_CathDatamine_001">Strasky le tiene aprecio a todo el mundo.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_010_Lindwall_001">Sí, eso es cierto.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_011_CathDatamine_001">Espera, ¿crees que a Reed le caigo bien?</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_012_Lindwall_001">Catherine. Tú le caes bien a mucha gente. Solo necesitas abrirte un poco. Ser más accesible.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_012_Lindwall_002">¿Puedo volver ya al trabajo? Preferiría que no me riñeran dos veces en el mismo día.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_013_CathDatamine_001">Vale, nos vemos dentro.</Entry>
        <Entry Name="Datamine_RadioDatamineCathLindwall_014_Lindwall_001">Cambio y corto.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_001">¿Me oyes hablar? Por supuesto que sí.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_002">Quería que supieras que lo sé. No me elegiste a ciegas.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_003">Las olas pausadas de Delta rompiendo contra la orilla te sumían en un tremendo sopor.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_004">Es algo hermoso y no me dejaré llevar por el egoísmo. Voy a ayudar, los voy a arropar, los observaré mientras duermen.</Entry>
        <Entry Name="datamine_7_dataminebrokenradio_001_akers_005">Ellos también encontrarán la paz en el universo del WAU.</Entry>
    </CATEGORY>
