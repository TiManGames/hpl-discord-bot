        <Entry Name="simulation_3_alonebeach_5_001_wan_002">Está vacío... Está demasiado vacío. En este lugar hay algo que no encaja.</Entry>
        <Entry Name="simulation_3_alonebeach_5_001_wan_003">No es real. ¡Esto no es real! ¡Tengo que salir de aquí!</Entry>
        <Entry Name="simulation_3_alonecabin_2_001_catherine_001">Todo está bien, Sr. Wan. Relájese.</Entry>
