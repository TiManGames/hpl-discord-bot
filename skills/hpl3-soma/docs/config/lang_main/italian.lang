    <CATEGORY Name="Voices_global">
        <Entry Name="globaltestscene_globaltestsub_001_globaltestchar_001">Questo è un test globale!</Entry>
        <Entry Name="globaltestscene_firstdatamine_001_player_001">Cosa... Come ho fatto a farlo?</Entry>
        <Entry Name="globaltestscene_firstwauflower_human_001_player_001">E quello cos&apos;era?</Entry>
        <Entry Name="GlobalTestScene_FirstWauFlower_Human_001_Player_002">Non fa più male.</Entry>
        <Entry Name="globaltestscene_firstwauflower_tentacle_001_player_001">Gesù, ma che diavolo...</Entry>
        <Entry Name="globaltestscene_getflashlight_001_player_001">Come... Dove ho preso questa torcia?</Entry>
        <Entry Name="globaltestscene_getflashlightunderwater_001_player_001">Come... Dove ho preso questa torcia?</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_001_Catherine_001">Ma che diavolo fai?</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_002_Player_001">So che non è bello a vedersi, ma mi fa stare molto meglio. Mi aiuta a concentrarmi.</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_003_Catherine_001">Quello è... Voglio dire... Ti stai collegando a WAU.</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_004_Player_001">Ne ho bisogno, ok? Senza WAU non ce l&apos;avrei fatta ad arrivare fin qui.</Entry>
        <Entry Name="GlobalTestScene_WauFlower_CathAndSimon_005_Catherine_001">Forza, continuiamo.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_00_intro">
        <Entry Name="intro_intro_0_001_simon_001">Ashley, vuoi un passaggio?</Entry>
        <Entry Name="intro_intro_0_004_ashley_001">Beh, d&apos;accordo, se non ti dispiace passare da Parkdale.</Entry>
        <Entry Name="intro_intro_0_005_simon_001">Nessun problema, salta su.</Entry>
        <Entry Name="intro_intro_1_001_simon_001">*gira la chiave d&apos;accensione*</Entry>
        <Entry Name="intro_intro_2_003_simon_001">Ti piace il lavoro, per ora?</Entry>
        <Entry Name="intro_intro_2_004_ashley_001">Sì, mi diverto. È stata una buona settimana.</Entry>
        <Entry Name="intro_intro_3_001_ashley_001">Stai bene, Simon? Mi pare che tu stia sanguinando.</Entry>
        <Entry Name="intro_intro_3_002_simon_001">Oh, non è niente. Dopo l&apos;incidente, il mio cervello continua a sanguinare.</Entry>
        <Entry Name="intro_intro_4_001_ashley_001">Ecco, prendi questo.</Entry>
        <Entry Name="intro_intro_5_001_simon_001">No, questo è per dopo... Per la scansione.</Entry>
        <Entry Name="intro_intro_5_002_ashley_001">È verde.</Entry>
        <Entry Name="intro_intro_6_001_simon_001">Ashley, devo dirti una cosa.</Entry>
        <Entry Name="intro_intro_6_002_ashley_001">Simon, ti prego, non mettermi a disagio...</Entry>
        <Entry Name="intro_intro_6_003_simon_001">No, no, non è come pensi.</Entry>
        <Entry Name="intro_intro_7_001_simon_001">Perché proprio ora?</Entry>
        <Entry Name="intro_intro_7_002_ashley_001">Chi è David Munshi?</Entry>
        <Entry Name="intro_intro_7_003_simon_001">Perché non c&apos;è mai abbastanza tempo?!</Entry>
		<Entry Name="intro_intro_7_004_ashley_001">Per cosa?</Entry>
        <Entry Name="intro_intro_8_001_ashley_001">Per cosa?</Entry>
        <Entry Name="intro_intro_9_001_simon_001">Per dire che mi dispiace.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_01_apartment">
        <Entry Name="Phonecall_1_PhoneCall_001_Player_001">Sì, sono sveglio!</Entry>
        <Entry Name="Phonecall_1_PhoneCall_002_David_001">Pronto, Simon Jarrett?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_003_Player_001">Sì, sono io.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_004_David_001">Mi chiamo David Munshi. Abbiamo parlato prima...</Entry>
        <Entry Name="Phonecall_1_PhoneCall_005_Player_001">La scansione cerebrale! Mi ricordo.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_006_David_001">Va tutto bene?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_007_Player_001">Sì, sì... Solo un brutto sogno. Tutto confermato per oggi?</Entry>
        <Entry Name="Phonecall_1_PhoneCall_008_David_001">Sì, ti ho chiamato apposta. Volevo ricordarti di bere il fluido tracciante che ti ho mandato. Mi aiuterà ad acquisire un&apos;immagine dei danni più nitida.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_009_Player_001">Non si preoccupi, ce l&apos;ho qui da qualche parte.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_010_David_001">Ok, bene. Allora ci vediamo tra un paio d&apos;ore.</Entry>
        <Entry Name="Phonecall_1_PhoneCall_011_Player_001">Ok, a presto.</Entry>
        <Entry Name="SimonTalking_5_FoundTracer_001_Player_001">Eccolo qua.</Entry>
        <Entry Name="SimonTalking_6_DrinkTracer_001_Player_001">Sembra latte, ma il sapore... È come succhiare una moneta.</Entry>
        <Entry Name="SimonTalking_7_BrokenShower_001_Player_001">Non voglio far aspettare il dottore. Farò una doccia quando torno.</Entry>
        <Entry Name="SimonTalking_8_OpenDrapes_001_Player_001">Arriva l&apos;estate. Speriamo porti buone cose.</Entry>
        <Entry Name="SimonTalking_9_InspectFridge_001_Player_001">Sempre fast food. Quando rientro, dovrei comprare qualcosa di più sano.</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_001">Ehi, Simon! Sono Jesse! Questo weekend lavori o cosa?</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_002">Ricordo che avevi qualcosa in programma... Era questo weekend o il prossimo?</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_001_Jerry_003">Comunque, mandami un&apos;e-mail, va bene? Ciaomimanchibaci!</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_002_AnswerMachine_001">Fine dei messaggi.</Entry>
        <Entry Name="AnswerMachine_10_AnswerMachine_003_Player_001">Giuro che quell&apos;uomo ha la memoria di un pesce rosso.</Entry>
        <Entry Name="SimonTalking_11_UseTV_001_Player_001">Bene, ora persino guardare la TV mi dà il mal di testa. Grazie, cervello.</Entry>
        <Entry Name="Phonecall_12_TryToExit_001_Player_001">Devo davvero bere quel fluido tracciante prima di andare dal dott. Munshi.</Entry>
        <Entry Name="SimonTalking_13_TracerReminder_001_Player_001">Ma dove ho messo il fluido tracciante?</Entry>
        <Entry Name="SimonTalking_13_TracerReminderB_001_Player_001">Eddai, fluido tracciante radioattivo. Dove sei?</Entry>
        <Entry Name="AnswerMachine_13_NoNewMessages_001_AnswerMachine_001">Nessun nuovo messaggio.</Entry>
        <Entry Name="Phonecall_1_PhoneCallOver_001_Player_001">Cristo...</Entry>
        <Entry Name="SimonTalking_2_UnsentMailReaction_001_Player_001">Avevo dimenticato di premere Invio. Poco male. Gliene ho già parlato.</Entry>
        <Entry Name="SimonTalking_2_SentMailReaction_001_Player_001">Meglio tardi che mai.</Entry>
        <Entry Name="SimonTalking_2_UnsentMailReaction_HeardMsg_001_Player_001">Oh, ho dimenticato di premere Invio.</Entry>
        <Entry Name="SimonTalking_10_AnswerMachine_NotReadMail_001_Player_001">Gli ho anche mandato un&apos;e-mail per ricordarglielo, no?</Entry>
        <Entry Name="SimonTalking_10_AnswerMachine_SentMail_001_Player_001">Bene, ho mandato l&apos;e-mail. A quest&apos;ora l&apos;avrà letta.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_02_subway">
        <Entry Name="Announcer_StationStAndrew_001_Announcer_001">St. Andrew. Prossima stazione, St. Andrew.</Entry>
        <Entry Name="Announcer_StationOsgoode_001_Announcer_001">Osgoode. Prossima stazione, Osgoode.</Entry>
        <Entry Name="Announcer_StationStPatrick_001_Announcer_001">St. Patrick. Prossima stazione, St. Patrick.</Entry>
        <Entry Name="Announcer_StationQueensPark_001_Announcer_001">Queen&apos;s Park. Prossima stazione, Queen&apos;s Park.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_001_Player_001">Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_002_Jesse_001">Ehi, Simon. Ho ricevuto la tua e-mail. Volevo augurarti buona fortuna e farti sapere che ti copro io.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_003_Player_001">Grazie, dovrei riuscire a passare in negozio dopo la scansione.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_004_Jesse_001">Non farti problemi. Ci sono Matt e Chris ad aiutarmi.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_005_Player_001">Matty di S&amp;L?</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_006_Jesse_001">Forse non l&apos;hai saputo. Verrà da noi a tempo pieno, nel reparto fumetti.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_007_Player_001">Ma quello è il lavoro di Ashley.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_008_Jesse_001">Sì, beh. Sai...</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_009_Player_001">Lascia perdere. Dovremo pur assumere qualcun altro, prima o poi. Lei non tornerà.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_010_Jesse_001">Beh, buona fortuna. Ti auguro di risolvere tutta quella faccenda di... beh... morire.</Entry>
        <Entry Name="simon_phonecall_emailsent_011_player_001">La faccenda di morire? Bel supporto morale!</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_012_Jesse_001">Beh, che vuoi che dica?</Entry>
        <Entry Name="simon_phonecall_emailsent_013_player_001">Ci vediamo dopo, Jesse. Non dare fuoco a tutto mentre non ci sono.</Entry>
        <Entry Name="Simon_Phonecall_EmailSent_014_Jesse_001">Passo e chiudo, amico.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_001_Player_001">Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_002_Jesse_001">Simon, che succede? Volevo verificare che oggi verrai al negozio.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_003_Player_001">Magari più tardi. Ho la scansione cerebrale, ricordi?</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_004_Jesse_001">È oggi!</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_005_Player_001">Sapevo che l&apos;avresti dimenticato.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_006_Jesse_001">Mi dispiace. La prossima volta mandami un&apos;e-mail. Queste cose devi mettermele per iscritto, lo sai!</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_007_Player_001">Lo sai che vendiamo calendari, no? Perché non te ne compri uno?</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_008_Jesse_001">Ce l&apos;ho. È solo che... non ci scrivo mai niente.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_009_Player_001">Magari faccio un salto più tardi. Dipende da quanto durerà questa scansione.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_010_Jesse_001">Ottimo. Mi farò dare una mano da Chris. Comunque, oggi arriva il nuovo schiavetto. Magari vuoi passare a fargli un saluto.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_011_Player_001">Il rimpiazzo di Ashley? Di già? Ma è passato così poco...</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_012_Jesse_001">Poco? Siamo a corto di personale da settimane e lo sai.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_013_Player_001">Forse è vero.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_014_Jesse_001">Certo che è vero. È praticamente un mese, ormai.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_015_Jesse_001">Comunque, fai la scansione, fatte dare buone notizie dal dottore, passa in negozio, saluta il nuovo assunto. Il pranzo lo offro io.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_016_Player_001">Grazie, Jesse. Apprezzo davvero il tuo sostegno.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_017_Jesse_001">Non voglio dover rimpiazzare un altro schiavetto.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_018_Player_001">Non fa ridere.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_019_Jesse_001">Un po&apos; fa ridere.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_020_Player_001">No, per niente. Ciao, Jesse.</Entry>
        <Entry Name="Simon_Phonecall_EmailNotSent_021_Jesse_001">Ci vediamo.</Entry>
    </CATEGORY>
    <CATEGORY Name="Voices_00_03_laboratory">
        <Entry Name="general_1_arriving_001_player_001">Pronto? Dottor Munshi?</Entry>
        <Entry Name="general_2_lockeddoor0_001_player_001">Il posto è questo, vero? Dev&apos;essere questo.</Entry>
        <Entry Name="general_2_lockeddoor1_001_player_001">Dottor Munshi? Mi sente? Ehilà?</Entry>
        <Entry Name="general_2_lockeddoor2_001_player_001">Ok, serve un codice.</Entry>
        <Entry Name="General_3_TryExit0_001_Player_001">Non posso arrendermi subito.</Entry>
        <Entry Name="General_3_TryExit1_001_Player_001">Non ancora, posso farcela.</Entry>
        <Entry Name="General_3_TryExit2_001_Player_001">Deve pur esserci un modo di entrare nel laboratorio.</Entry>
        <Entry Name="General_4_TurnOnLights_001_Player_001">Dove sono tutti? Mi immaginavo un posto pieno di gente.</Entry>
        <Entry Name="General_7_GreetDavid_001_David_001">Oh, salve! Non ti avevo sentito entrare. Simon Jarrett, vero?</Entry>
        <Entry Name="General_7_GreetDavid_002_Player_001">Dottor Munshi?</Entry>
        <Entry Name="General_7_GreetDavid_003_David_001">Non sono ancora dottore, ma ci sto lavorando. Anzi, tu mi stai dando un grosso aiuto.</Entry>
        <Entry Name="General_7_GreetDavid_004_Player_001">Questo fa parte della sua tesi?</Entry>
        <Entry Name="General_7_GreetDavid_005_David_001">Sì, è uno studio che sto portando avanti con il mio collega Paul Berg. Vogliamo sviluppare un metodo non aggressivo per la ricostruzione cerebrale. Per aiutare le persone come te.</Entry>
        <Entry Name="General_7_GreetDavid_006_David_001">Hai ingerito il fluido tracciante?</Entry>
        <Entry Name="General_7_GreetDavid_007_Player_001">Sì, sì.</Entry>
        <Entry Name="General_7_GreetDavid_008_David_001">Ottimo. Appena sei pronto, possiamo cominciare.</Entry>
        <Entry Name="General_8_InteractDavid1_001_Player_001">Quindi... Che cosa stiamo facendo?</Entry>
        <Entry Name="General_8_InteractDavid1_002_David_001">Faremo una scansione del tuo cervello. Poi ne ricaveremo un modello informatico e lo bombarderemo di stimoli. Ripeteremo il programma per perfezionare il tuo piano di trattamento finché non sarà completamente ottimizzato. In pratica, svilupperemo il trattamento perfetto per la tua malattia.</Entry>
        <Entry Name="General_8_InteractDavid1_003_Player_001">Quindi non è soltanto uno studio... Questa procedura mi aiuterà davvero?</Entry>
        <Entry Name="General_8_InteractDavid1_004_David_001">Spero proprio di sì. Altrimenti sarà una gran perdita di tempo.</Entry>
        <Entry Name="General_8_InteractDavid2_001_Player_001">Lei sa che ho un problema serio, vero? Ha saputo dell&apos;incidente? Del fatto che mi mancano X mesi da vivere?</Entry>
        <Entry Name="General_8_InteractDavid2_002_David_001">Sì, ho saputo. Dev&apos;essere stata dura. Come ben sai, il tuo cervello è talmente debole che può iniziare a sanguinare in qualsiasi momento...</Entry>
        <Entry Name="General_8_InteractDavid2_003_Player_001">E se questa situazione si aggrava, muoio.</Entry>
        <Entry Name="General_8_InteractDavid2_004_David_001">Beh, forse non guariremo del tutto il tuo cervello, ma dovremmo riuscire a trasformare quegli X mesi in anni, persino in decenni. Con un po&apos; di attenzione ed evitando gli eccessi, potrai persino vivere più a lungo di tutti noi.</Entry>
        <Entry Name="general_8_interactdavid3_001_player_001">Spero proprio che lei abbia ragione.</Entry>
        <Entry Name="general_8_interactdavid3_002_david_001">Anch&apos;io. Sarebbe un passo importantissimo nella cura delle persone con danni cerebrali.</Entry>
        <Entry Name="general_8_interactdavid3_003_david_001">Quindi, che ne dici, vogliamo cominciare?</Entry>
        <Entry Name="general_8_interactdavid3_004_player_001">Certo, andiamo.</Entry>
        <Entry Name="general_8_interactdavid3_005_david_001">Siediti.</Entry>
        <Entry Name="General_10_SitDown_001_David_001">Ok, sbrighiamo subito questa formalità. Tu sei Simon Jarrett, giusto?</Entry>
        <Entry Name="General_10_SitDown_002_Player_001">Giusto.</Entry>
        <Entry Name="General_10_SitDown_003_David_001">Toronto, Canada. David Munshi.</Entry>
        <Entry Name="General_10_SitDown_004_David_001">Nato il 16 luglio 1988?</Entry>
        <Entry Name="General_10_SitDown_005_Player_001">Giusto.</Entry>
        <Entry Name="General_10_SitDown_006_David_001">Neurodiagramma piatto versione sei.</Entry>
        <Entry Name="General_10_SitDown_007_David_001">Bene. Tutti i file sono in ordine.</Entry>
        <Entry Name="General_10_SitDown_008_Player_001">Farà male?</Entry>
        <Entry Name="General_10_SitDown_009_David_001">È solo una scansione. Non farà più male di una fotografia.</Entry>
        <Entry Name="General_11_GogglesOn_001_Player_001">Gli indiani pensavano che le fotografie rubassero l&apos;anima.</Entry>
        <Entry Name="General_11_GogglesOn_002_David_001">Ah sì? Beh, speriamo che si sbaglino.</Entry>
        <Entry Name="General_11_GogglesOn_003_David_001">Pronto? Di&apos; cheese!</Entry>
        <Entry Name="general_13_davidreminder_0_001_david_001">Siediti, per favore.</Entry>
        <Entry Name="General_13_DavidReminder_1_001_David_001">Siediti e finiremo in un attimo.</Entry>
        <Entry Name="General_14_LeaveRoom_0_001_David_001">Non andartene in giro. Ci sono aghi e altre cose pericolose.</Entry>
        <Entry Name="General_14_LeaveRoom_1_001_David_001">Che ne dici, vogliamo cominciare con la scansione?</Entry>
        <Entry Name="General_14_LeaveRoom_2_001_David_001">Sbrigati. Non abbiamo tutto il giorno.</Entry>
        <Entry Name="general_7_greetdavidfirst_001_player_001">David Munshi?</Entry>
