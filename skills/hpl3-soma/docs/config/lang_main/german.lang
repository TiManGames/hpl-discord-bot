        <Entry Name="RobotTalk_Scavenge_Tempted_001_ScavengeRobot_001">Warum zwingst du mich, sowas zu tun?</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_002_ScavengeRobot_001">Es ist nicht mein Fehler, dass wir so sind.</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_003_ScavengeRobot_001">Gib mir was!</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_004_ScavengeRobot_001">Gib es her!</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_005_ScavengeRobot_001">Ich brauche es!</Entry>
        <Entry Name="RobotTalk_Scavenge_Tempted_006_ScavengeRobot_001">Sei nicht egoistisch,</Entry>
