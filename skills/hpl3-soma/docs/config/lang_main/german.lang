        <Entry Name="robottalk_scavenge_idle_032_scavengerobot_001">Sie haben alles mitgenommen!</Entry>
        <Entry Name="robottalk_scavenge_idle_033_scavengerobot_001">Ich kann nirgendwo hin.</Entry>
        <Entry Name="robottalk_scavenge_idle_034_scavengerobot_001">Das schwarze Blut.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_001_ScavengeRobot_001">Hast du ein bisschen was übrig?</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_002_ScavengeRobot_001">Ich brauche es, weißt du?</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_003_ScavengeRobot_001">Nur ein bisschen.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_004_ScavengeRobot_001">Komm schon, nur um über die Runden zu kommen.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_005_ScavengeRobot_001">Sei nicht gierig,</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_006_ScavengeRobot_001">du hast doch genug.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_007_ScavengeRobot_001">Jetzt sei doch nicht so.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_008_ScavengeRobot_001">Du weißt doch, wie das ist.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_009_ScavengeRobot_001">Ich habe nichts mehr.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_015_ScavengeRobot_001">Du weißt, dass ich es brauche.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_016_ScavengeRobot_001">Du herzloses Stück Scheiße!</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_017_ScavengeRobot_001">Gib mir ein bisschen Strukturgel ab.</Entry>
        <Entry Name="RobotTalk_Scavenge_Stalk_018_ScavengeRobot_001">Ich will dich nicht verletzen!</Entry>
