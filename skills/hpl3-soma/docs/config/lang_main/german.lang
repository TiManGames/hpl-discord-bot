        <Entry Name="RobotTalk_Scavenge_Idle_001_ScavengeRobot_001">Es ist so leer.</Entry>
        <Entry Name="RobotTalk_Scavenge_Idle_002_ScavengeRobot_001">Alle sind fortgegangen.</Entry>
