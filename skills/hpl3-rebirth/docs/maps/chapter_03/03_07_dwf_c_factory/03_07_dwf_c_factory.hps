	bool OnCollide_Player_SetPermafailArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		tString sArea = Entity_GetVarString(asParent, "");
		FearHandler_SetPermaFailRespawnArea(sArea);
		Entity_SetActive(asParent, false);
		return true;
	}
	
	//-------------------------------------------------------
	
	bool mbPreviouslyGrounded = false;
	tString msLandDetectionState = "";
	void UpdateLandDetection(float afTimeStep)
	{
		if (msLandDetectionState == "") return;
		
		bool bGrounded = cLux_GetPlayer().GetCharacterBody().IsOnGround();
		if (bGrounded && mbPreviouslyGrounded == false)
		{
			if (msLandDetectionState == "BalconyJump")
			{
				Player_GiveDamage(1, 1, eDamageType_Fall, "");
			}
			msLandDetectionState = "";
		}
		mbPreviouslyGrounded = bGrounded;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_Visibility(const tString &in asParent, const tString &in asChild, int alState)
	{
		int lAreaIndex = cString_GetNumericSuffixInt(asParent, -1);
		if (lAreaIndex == 1)
		{
			Visibility_SetAreaActive("VisibilityArea_TopFloor_1", true);
		}
		else if (lAreaIndex == 2)
		{
			Visibility_SetAreaActive("VisibilityArea_TopFloor_2", true);
		}
		else if (lAreaIndex == 3)
		{
			Visibility_SetAreaActive("VisibilityArea_TopFloor_3", true);
		}
		else if (lAreaIndex == 4)
		{
			Visibility_SetAreaActive("VisibilityArea_MiddleBottomFloor_1", true);
		}
		else if (lAreaIndex == 5)
		{
			Visibility_SetAreaActive("VisibilityArea_MiddleBottomFloor_2", true);
		}
		else if (lAreaIndex == 6)
		{
			Visibility_SetAreaActive("VisibilityArea_RnD", false);
			Visibility_SetAreaActive("VisibilityArea_ShuttleRift", false);
			Visibility_SetAreaActive("VisibilityArea_Rails_1", false);
			Visibility_SetAreaActive("VisibilityArea_Elevator_1", false);
		}
		return true;
	}
	
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
	 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 10 *Ride the shuttle to the Factory*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------

		/*Put any variables that are used by many events in Scene X here.*/

		//-------------------------------------------------------

		/*Put any functions that are used in more than one event in Scene X here.*/

		//-------------------------------------------------------

		//} END General	

		/////////////////////////////////////////
		// Event A *The SHUTTLE starts moving*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		int mlRailPointCount = 19;
		int mlRailMovementIndex = 1;
		float mfShuttleMovementProgress = 0;
		tString msRailPointName = "Target_Rail_";
		tString msShuttleName = "Shuttle";
		
		tID m_idShuttle = tID_Invalid;
		array<tID> mvShuttleMovementPoints;
		
		bool mbShuttleMoving = false;
		tID m_idShuttleMovement_Current = tID_Invalid;
		tID m_idShuttleMovement_From = tID_Invalid;
		tID m_idShuttleMovement_To = tID_Invalid;
		cVector3f mvShuttle_PrevMoveDir;
		float mfShuttle_TargetSpeed = 5.0f;
		float mfShuttle_CurrentSpeed = 5.0f;
		float mfShuttle_MoveAcceleration = 5.0f;
		tString msShuttle_MoveCallback = "";
		cVector3f mvShuttle_MoveOffset = cVector3f_Zero;
		
		bool mbShuttleRotating = false;
		tID m_idShuttleRotate_From = tID_Invalid;
		tID m_idShuttleRotate_To = tID_Invalid;
		cVector3f mvShuttleRotate_PrevDelta;
		float mfShuttle_CurrentRotateSpeed = 1.0f;
		float mfShuttle_TargetRotateSpeed = 1.0f;
		tString msShuttle_RotateCallback = "";
		
		tID m_idShuttle_MovementLoop = tID_Invalid;
		tID m_idShuttle_MovementEngineLoop = tID_Invalid;
		
		float mfShuttle_MoveDist = 0;
		float mfShuttle_MoveSlowDownDist = 0.7f;
		float mfShuttle_RotateDist = 0;
		float mfShuttle_RotateSlowDownDist = 0.1f;
		
		//-------------------------------------------------------
		
		void InitShuttle()
		{
			Entity_SetActive("Target_ShuttleRide*", false);
			Entity_StopAnimation("Target_ShuttleRide*");
			
			iLuxEntity@ pShuttle = Map_GetEntity("Shuttle");
			pShuttle.StopAllAnimations(0);
			m_idShuttle = pShuttle.GetID();
			
			for (int i = 1; true; ++i)
			{
				iLuxEntity@ pEnt = Map_GetEntity("Target_ShuttleRide_" + i);
				if (pEnt is null) break;
				mvShuttleMovementPoints.push_back(pEnt.GetID());
			}
			
			pShuttle.SetMatrix(cLux_ID_Entity(mvShuttleMovementPoints[0]).GetMatrix());
			m_idShuttleMovement_Current = mvShuttleMovementPoints[0];
			
			Lamp_SetLit("Lamp_Railing_Lift", false, false);
			Lamp_SetLit("Lamp_Railing_StationToLift*", false, false);
			Lamp_SetLit("Lamp_Railing_LiftToFactory*", false, false);
			Lamp_SetLit("dwf_elevator_2_light*", false, false);
		}
		
		//-------------------------------------------------------
		
		void InitShuttleCorridor()
		{
			Light_SetBrightness("Light_ShuttleCorridor*", 0);
		}
		
		//-------------------------------------------------------
		
		void MoveShuttle(int alIdTo, int alIdFrom = -1, const tString &in asCallback = "", float afSpeed = 5.0f)
		{
			mbShuttleMoving = true;
			mvShuttle_PrevMoveDir = cVector3f_Zero;
			
			m_idShuttleMovement_To = mvShuttleMovementPoints[alIdTo - 1];
			if (alIdFrom < 0) m_idShuttleMovement_From = m_idShuttleMovement_Current;
			else m_idShuttleMovement_From = mvShuttleMovementPoints[alIdFrom - 1];
			iLuxEntity@ pTo = cLux_ID_Entity(m_idShuttleMovement_To);
			iLuxEntity@ pFrom = cLux_ID_Entity(m_idShuttleMovement_From);
			
			mfShuttle_MoveDist = cMath_Vector3Dist(pTo.GetPosition(), pFrom.GetPosition());
			mfShuttle_CurrentSpeed = mfShuttle_TargetSpeed = afSpeed;
			mfShuttle_MoveAcceleration = 5.0f;
			msShuttle_MoveCallback = asCallback;
			
			cSoundEntity@ pShuttleLoop = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("ShuttleLoop", "03_07_dw_factory/shuttle/shuttle_rail", true);
			pShuttleLoop.SetVolume(1.0f);
			pShuttleLoop.FadeIn(2.0f);
			m_idShuttle_MovementLoop = pShuttleLoop.GetID();
			
			cSoundEntity@ pShuttleEngineLoop = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("ShuttleEngineLoop", "03_07_dw_factory/shuttle/engine/shuttle_engine", true);
			m_idShuttle_MovementEngineLoop = pShuttleEngineLoop.GetID();
			
			//Sound_CreateAtEntity("Sound_ShuttleStart", "03_07_dw_factory/shuttle/shuttle_start", "Target_ShuttleCenterTop");
//			Sound_CreateAtEntity("Sound_ShuttleEngine_1", "03_07_dw_factory/shuttle/engine/shuttle_engine", "Sound_ShuttleEngine", 1.0f, true, 0.6f);
			
			
			Effect_Shake_Start(0.02, 0.4, 0, 0.3);
		}
		
		void RotateShuttle(int alIdTo, int alIdFrom = -1, const tString &in asCallback = "", float afSpeed = 1.0f)
		{
			mbShuttleRotating = true;
			mvShuttleRotate_PrevDelta = cVector3f_Zero;
			
			m_idShuttleRotate_To = mvShuttleMovementPoints[alIdTo - 1];
			if (alIdFrom < 0) m_idShuttleRotate_From = m_idShuttleMovement_Current;
			else m_idShuttleRotate_From = mvShuttleMovementPoints[alIdFrom - 1];
			iLuxEntity@ pTo = cLux_ID_Entity(m_idShuttleRotate_To);
			iLuxEntity@ pFrom = cLux_ID_Entity(m_idShuttleRotate_From);
			
			mfShuttle_RotateDist = cMath_MatrixEulerAngleDistance(pFrom.GetMatrix(), pTo.GetMatrix()).Length();
			mfShuttle_CurrentRotateSpeed = mfShuttle_TargetRotateSpeed = afSpeed;
			msShuttle_RotateCallback = asCallback;
			Effect_Shake_Start(0.02, 0.4, 0, 0.3);
		}
		
		void UpdateShuttle(float afTimeStep)
		{	
			if (mbShuttleMoving)
			{
				mfShuttle_CurrentSpeed = cMath_IncreaseTo(mfShuttle_CurrentSpeed, mfShuttle_MoveAcceleration * afTimeStep, mfShuttle_TargetSpeed);
				
				iLuxEntity@ pShuttle = cLux_ID_Entity(m_idShuttle);
				iLuxEntity@ pTo = cLux_ID_Entity(m_idShuttleMovement_To);
				iLuxEntity@ pFrom = cLux_ID_Entity(m_idShuttleMovement_From);
				
				cVector3f vToPos = pTo.GetPosition() + mvShuttle_MoveOffset;
				cVector3f vDelta = vToPos - pShuttle.GetPosition();
				
				float fDist = vDelta.Length();
				float fDistMul = 1;
				if (fDist <= mfShuttle_MoveSlowDownDist) fDistMul = cMath_Clamp(fDist / mfShuttle_MoveSlowDownDist, 0.05f, 1.0f);
				else if (fDist >= mfShuttle_MoveDist - mfShuttle_MoveSlowDownDist) fDistMul = cMath_Clamp((mfShuttle_MoveDist - fDist) / mfShuttle_MoveSlowDownDist, 0.05f, 1.0f);
								
				cVector3f vMoveDir = cMath_Vector3Normalize(vDelta);				
				cVector3f vMove = vMoveDir * mfShuttle_CurrentSpeed * fDistMul;
				
				cSoundEntity@ pShuttleLoop = cLux_ID_SoundEntity(m_idShuttle_MovementLoop);
				if (pShuttleLoop !is null)
				{
					pShuttleLoop.SetPosition(Map_GetEntity("Target_ShuttleCenterTop").GetPosition());
					
					cSoundEntity@ pShuttleEngineLoop = cLux_ID_SoundEntity(m_idShuttle_MovementEngineLoop);
					if (pShuttleEngineLoop !is null) pShuttleEngineLoop.SetPosition(Map_GetEntity("Sound_ShuttleEngine").GetPosition());
					
					if (fDist <= mfShuttle_MoveSlowDownDist || mfShuttle_CurrentSpeed == 0.0f)
					{
						Sound_CreateAtEntity("ShuttleStop", "03_07_dw_factory/shuttle/shuttle_stop", "Target_ShuttleCenterTop");
//						Sound_Stop("Sound_ShuttleEngine_1", 1.5f);
						Sound_CreateAtEntity("Sound_ShuttleEngineStop", "03_07_dw_factory/shuttle/engine/shuttle_engine_stop", "Sound_ShuttleEngine");
						Effect_Shake_Start(0.02, 0.4, 0, 0.3);
						pShuttleLoop.FadeOut(2.0f);
						m_idShuttle_MovementLoop = tID_Invalid;
						
						if (pShuttleEngineLoop !is null) pShuttleEngineLoop.FadeOut(2);
						m_idShuttle_MovementEngineLoop = tID_Invalid;
					}
				}
												
				float fDot = cMath_Vector3Dot(vMoveDir, mvShuttle_PrevMoveDir);
				if (mvShuttle_PrevMoveDir.Length() > 0 && fDot <= 0)
				{
					vMove = (vToPos - pShuttle.GetPosition()) / afTimeStep;
					m_idShuttleMovement_Current = m_idShuttleMovement_To;
					mbShuttleMoving = false;
					ShuttleCallback(msShuttle_MoveCallback);
				}
								
				pShuttle.GetMainBody().StaticLinearMove(vMove);
				mvShuttle_PrevMoveDir = vMoveDir;
				
//				DrawTestPoint(pShuttle.GetPosition(), cEngine_GetStepSize() + 0.01f, cColor_Green * 2, 0.2f);
//				DrawTestPoint(pTo.GetPosition(), cEngine_GetStepSize() + 0.01f, cColor_Red * 2, 0.2f);
//				DrawTestPoint(pFrom.GetPosition(), cEngine_GetStepSize() + 0.01f, cColor_Red * 2, 0.2f);
			}
			
			if (mbShuttleRotating)
			{
				iLuxEntity@ pShuttle = cLux_ID_Entity(m_idShuttle);
				iLuxEntity@ pTo = cLux_ID_Entity(m_idShuttleRotate_To);
				iLuxEntity@ pFrom = cLux_ID_Entity(m_idShuttleRotate_From);
				
				cVector3f vDelta = cMath_MatrixEulerAngleDistance(pShuttle.GetMatrix(), pTo.GetMatrix());
								
				float fDist = vDelta.Length();
				float fDistMul = 1;
				if (fDist <= mfShuttle_RotateSlowDownDist) fDistMul = cMath_Clamp(fDist / mfShuttle_RotateSlowDownDist, 0.02f, 1.0f);
				else if (fDist >= mfShuttle_RotateDist - mfShuttle_RotateSlowDownDist) fDistMul = cMath_Clamp((mfShuttle_RotateDist - fDist) / mfShuttle_RotateSlowDownDist, 0.02f, 1.0f);

				cVector3f vRot = cMath_Vector3Normalize(vDelta) * mfShuttle_CurrentRotateSpeed * fDistMul;
				float fDot = cMath_Vector3Dot(vDelta, mvShuttleRotate_PrevDelta);
				if (mvShuttleRotate_PrevDelta.Length() > 0 && fDot <= 0)
				{
					vRot = vDelta / afTimeStep;
					mbShuttleRotating = false;
					ShuttleCallback(msShuttle_RotateCallback);
					Effect_Shake_Start(0.02, 0.4, 0, 0.3);
				}
				
				float fT = 1.0f - cMath_Clamp(fDist / mfShuttle_RotateDist, 0.0f, 1.0f);
				cVector3f vTargetPos = pFrom.GetPosition() * (1.0f - fT) + pTo.GetPosition() * (fT);
				cVector3f vMove = (vTargetPos - pShuttle.GetPosition()) / afTimeStep;
				
				pShuttle.GetMainBody().StaticAngularMove(vRot);
				pShuttle.GetMainBody().StaticLinearMove(vMove);
				mvShuttleRotate_PrevDelta = vDelta;
				
//				DrawTestPoint(pTo.GetPosition(), cEngine_GetStepSize() + 0.01f, cColor_Red * 2, 0.2f);
//				DrawTestPoint(pFrom.GetPosition(), cEngine_GetStepSize() + 0.01f, cColor_Red * 2, 0.2f);
			}
			
			if (mbShuttle_FallMove)
			{
				cVector3f vTarget = Map_GetEntity(msShuttle_FallAnimEnt).GetPosition();
				cVector3f vMoveDir = vTarget - cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
				vMoveDir.y = 0;
				cVector3f vMove = cMath_Vector3Normalize(vMoveDir) * 3.0f * afTimeStep;
								
				if (vMove.Length() < vMoveDir.Length())
				{
					cVector3f vNewPos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition() + vMove;
					cLux_GetPlayer().GetCharacterBody().SetFeetPosition(vNewPos, false);
				}
				else
				{
					mbShuttle_FallMove = false;
					cLux_GetPlayer().GetCharacterBody().SetFeetPosition(vTarget, false);
				}
			}
			
		}
		
		
		void ShuttleCallback(const tString &in asCallback)
		{
			if (asCallback == "ShuttleRide")
			{
				SequenceStates_Resume("Seq_ShuttleRide");
			}
		}
		
		//-------------------------------------------------------
		
		int mlShuttle_SkipSequence = 0;
		cSequenceStatesData mSequenceShuttleRide;
		void Seq_ShuttleRide(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ShuttleRide", mSequenceShuttleRide);
			if (Sequence_DoStepAndWait(0.1f))
			{
				Player_SetPregnancyExertionActive(false);
				
				FearHandler_SetDifficultyMul(0.35f);
				FearHandler_SetPermaFailEnabled(false);
				FearHandler_SetDarknessFactorActive(false);
				
				Sequence_SkipNextSteps(mlShuttle_SkipSequence);
			}
			else if (Sequence_DoStepAndWait(0.2))
			{
				Player_Teleport("Start_Begin", false);
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				Effect_Fade_In(2);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Sound_CreateAtEntity("Sound_DoorOpen_1", "03_07_DW_theatre/events/shuttle_door/door_1", "Door_ShuttleTunnel_2");
				SlideDoor_SetOpenAmount("Door_ShuttleTunnel_2", 1);
				Light_FadeBrightnessToDefault("Light_ShuttleCorridor*", 2);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("dwf_railing_light_20", true, true);
				Lamp_SetLit("dwf_railing_light_1", true, true);
				Lamp_SetLit("dwf_railing_light_4", true, true);
			}
			else if (Sequence_DoStepAndPause(0.0))
			{
				if (cScript_GetGlobalVarBool("DWF_RnD_UsedVitaeChair")) Voice_PlayDelayed("Dialogue_Reflections_Tortured", 6);
				else Voice_PlayDelayed("Dialogue_Reflections_NotTortured", 6);
				MoveShuttle(2, -1, "ShuttleRide", 0.8f);
				Sound_CreateAtEntity("Sound_ShuttleStart", "03_07_dw_factory/shuttle/shuttle_ride_begin_2", "Target_ShuttleCenterTop");
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				SlideDoor_SetOpenAmount("Door_RnD_2", 1);
				Sound_CreateAtEntity("Sound_DoorOpen_1", "03_07_DW_theatre/events/shuttle_door/door_2", "Door_RnD_2");
				Map_AddTimer("OnTimer_DarkWorldLightningLoop", 5, "OnTimer_DarkWorldLightningLoop");
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				Music_PlayExt("A2_3_8_Factory_Reveal.ogg", false, 0.3f, 1.0f, 3.0f, 0.0f, eMusicPrio_BigEvent, false);
				Music_Play("A2_3_8_Factory_Ambience.ogg", 0.19f, false, eMusicPrio_SceneAmb);
			}
			else if (Sequence_DoStepAndPause(0.0)) MoveShuttle(3, -1, "ShuttleRide", 2);
			else if (Sequence_DoStepAndWait(1.0))
			{
				Entity_AttachToEntity("ShuttleLift_1", "Shuttle", "", true, false, false);
				Lamp_SetFlickerActive("Lamp_Railing_Lift_1", true);
			}
			else if (Sequence_DoStepAndPause(0.0)) MoveShuttle(4, -1, "ShuttleRide", 4);
			else if (Sequence_DoStepAndWait(1.0))
			{
				Entity_RemoveEntityAttachment("ShuttleLift_1");
				Lamp_SetFlickerActive("Lamp_Railing_Lift_1", false);
			}
			else if (Sequence_DoStepAndPause(0.5)) MoveShuttle(5, -1, "ShuttleRide", 3);
			else if (Sequence_DoStepAndPause(0.5)) RotateShuttle(6, -1, "ShuttleRide");
			else if (Sequence_DoStepAndPause(0)) MoveShuttle(17, -1, "ShuttleRide", 7.5);
			else if (Sequence_DoStepAndWait(7.0))
			{
				Map_AddTimer("Timer_ArriveAtStation", 2.5, "OnTimer_ArriveAtStation");
				Map_AddTimer("Timer_PullOutOfStation", 6.5, "OnTimer_PullOutOfStation");
			}
			else if (Sequence_DoStepAndPause(0.5))
			{
				MoveShuttle(7, 17, "ShuttleRide", 7.5);
			}
			else if (Sequence_DoStepAndPause(0.5)) RotateShuttle(8, -1, "ShuttleRide");
			else if (Sequence_DoStepAndPause(0.0)) MoveShuttle(9, -1, "ShuttleRide");
			else if (Sequence_DoStepAndWait(1.0))
			{
				Entity_AttachToEntity("ShuttleLift_2", "Shuttle", "", true, false, false);
			}
			else if (Sequence_DoStepAndPause(0.0)) MoveShuttle(10, -1, "ShuttleRide", 6);
			else if (Sequence_DoStepAndWait(1.5))
			{
				Lamp_SetLit("Lamp_Railing_Lift", false, true);
				TurnOnRailingLightSegment("Lamp_Railing_LiftToFactory_", 1, 4);
				Entity_RemoveEntityAttachment("ShuttleLift_2");
			}
			else if (Sequence_DoStepAndPause(0.5)) MoveShuttle(11, -1, "ShuttleRide");
			else if (Sequence_DoStepAndPause(0.5)) RotateShuttle(12, -1, "ShuttleRide");
			else if (Sequence_DoStepAndPause(0.5)) MoveShuttle(13, -1, "ShuttleRide");
			else if (Sequence_DoStepAndWait(2.5))
			{
				TurnOnRailingLightSegment("Lamp_Railing_LiftToFactory_", 5, 11);
			}
			else if (Sequence_DoStepAndPause(0.0)) RotateShuttle(14, -1, "ShuttleRide");
			else if (Sequence_DoStepAndPause(0.0)) MoveShuttle(15, -1, "ShuttleRide", 7.5);
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PullOutOfStation(const tString &in asTimer)
		{
			mfShuttle_TargetSpeed = 7.5;
			mfShuttle_MoveAcceleration = 4;
			
			TurnOnRailingLightSegment("Lamp_Railing_StationToLift_", 1, 3);
			FearHandler_SetForcedAddFearRate(0.3f, 4.0f, false, 1.0f, 0.2f, 0.75f);
			Map_AddTimer("Timer_TurnOnElevator2Lights", 2.0f, "OnTimer_TurnOnElevator2Lights");
			
			SlideDoor_SetOpenAmount("Door_ShuttleStation", 1, false);
			Sound_CreateAtEntity("Sound_DoorOpen_1", "03_07_DW_theatre/events/shuttle_door/door_1", "Door_ShuttleStation");
			
			Sound_Stop("Sound_ShuttleEngineSlower", 1.5f);
			Sound_CreateAtEntity("Sound_ShuttleEngine", "03_07_dw_factory/shuttle/engine/shuttle_engine", "Sound_ShuttleEngine");
			Sound_CreateAtEntity("Sound_ShuttleSpeedUp", "03_07_dw_factory/shuttle/shuttle_speed_up", "Sound_ShuttleEngine");
			
			Voice_PlayDelayed("Dialogue_PullingOutOfStation", 1.0f);
			Music_Play("A2_3_8_Shuttle_Speedup.ogg", 0.3f, false, eMusicPrio_MinorEvent);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ArriveAtStation(const tString &in asTimer)
		{
			Voice_PlayDelayed("Dialogue_PullingThroughStation", 0.0f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SpeedArea_1(const tString &in asParent, const tString &in asChild, int alState)
		{
			mfShuttle_TargetSpeed = 3.0;
			mfShuttle_MoveAcceleration = 2;
			
			Sound_Stop("Sound_ShuttleEngine", 1.5f);
			Sound_CreateAtEntity("Sound_ShuttleEngineSlow", "03_07_dw_factory/shuttle/engine/shuttle_engine_slowdown", "Sound_ShuttleEngine");
			Sound_CreateAtEntity("Sound_ShuttleSlow", "03_07_dw_factory/shuttle/shuttle_slow_down", "Sound_ShuttleEngine");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SpeedArea_2(const tString &in asParent, const tString &in asChild, int alState)
		{
			mfShuttle_TargetSpeed = 7.5;
			mfShuttle_MoveAcceleration = 4;
			TurnOnRailingLightSegment("Lamp_Railing_StationToLift_", 1, 3);
			FearHandler_SetForcedAddFearRate(0.3f, 4.0f, false, 1.0f, 0.2f, 0.75f);
			Map_AddTimer("Timer_TurnOnElevator2Lights", 2.0f, "OnTimer_TurnOnElevator2Lights");
			
			SlideDoor_SetOpenAmount("Door_ShuttleStation", 1, false);
			
			Sound_Stop("Sound_ShuttleEngineSlower", 1.5f);
			Sound_CreateAtEntity("Sound_ShuttleEngine", "03_07_dw_factory/shuttle/engine/shuttle_engine", "Sound_ShuttleEngine");
			Sound_CreateAtEntity("Sound_ShuttleSpeedUp", "03_07_dw_factory/shuttle/shuttle_speed_up", "Sound_ShuttleEngine");
			
			Voice_PlayDelayed("Dialogue_PullingOutOfStation", 1.0f);
			Music_Play("A2_3_8_Shuttle_Speedup.ogg", 0.3f, false, eMusicPrio_MinorEvent);
			return false;
		}
		
		void OnTimer_TurnOnElevator2Lights(const tString &in asTimer)
		{
			TurnOnElevatorRailingLightSegment("dwf_elevator_2_light_", 1, 6);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SpeedArea_3(const tString &in asParent, const tString &in asChild, int alState)
		{
			mfShuttle_TargetSpeed = 1.1;
			mfShuttle_MoveAcceleration = 3;
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SpeedArea_4(const tString &in asParent, const tString &in asChild, int alState)
		{
			mfShuttle_TargetSpeed = 0.3;
			mfShuttle_MoveAcceleration = 1;
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SpeedArea_5(const tString &in asParent, const tString &in asChild, int alState)
		{
			mfShuttle_TargetSpeed = 1.5;
			mfShuttle_MoveAcceleration = 2;
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SpeedArea_6(const tString &in asParent, const tString &in asChild, int alState)
		{
			mfShuttle_TargetSpeed = 5.0;
			mfShuttle_MoveAcceleration = 4;
			
			Effect_Shake_Start(0.02, 0.4, 0, 0.3);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SpeedArea_7(const tString &in asParent, const tString &in asChild, int alState)
		{
			mfShuttle_TargetSpeed = 5.0;
			mfShuttle_MoveAcceleration = 2;
			return false;
		}
		
