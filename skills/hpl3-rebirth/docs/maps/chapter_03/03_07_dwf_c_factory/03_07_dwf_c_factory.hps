	void SetWraithSpotlightMask(const tString &in asAgent, const tString &in asReferenceLight)
	{
		iLight@ pLight = cLux_GetCurrentMap().GetWorld().GetLight(asReferenceLight);
		if (pLight is null) return;
		
		cLightMaskBox@ pBox = pLight.GetMask();
		if (pBox is null) return;
		
		Wraith_GetSpotlightEntity(asAgent).GetLightFromName("Light_Spot_1").SetMask(pBox);
	}
	
