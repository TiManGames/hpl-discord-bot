	void SetButtonColor(const tString &in asButton, cColor aColor, bool abFade = false)
	{
		if (abFade) Entity_FadeEffectBaseColor(asButton, aColor, 0.2f);
		else Entity_SetEffectBaseColor(asButton, aColor);
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Button flash
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	[nosave] array<tID> mvFlashTimers;
	[nosave] array<cColor> mvFlashOrigColors;
	[nosave] array<cColor> mvFlashColors;
	[nosave] array<float> mvFlashTimes;
	[nosave] array<bool> mvFlashRepeat;
	
	//-------------------------------------------------------
	
	void BlinkButton(const tString &in asButton)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asButton);
		FlashButton(asButton, pEnt.GetEffectBaseColor(), 1.4f, 0.5f, true);
	}
	
	//-------------------------------------------------------
	
	void StopBlinkButton(const tString &in asButton, bool abReturnColor = false)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asButton);
		for (int i = 0; i < mvFlashTimers.size(); ++i)
		{
			if (mvFlashTimers[i] == pEnt.GetID())
			{
				mvFlashRepeat[i] = false;
				Map_RemoveTimer(asButton);
				if (abReturnColor) OnTimer_StopFlash(asButton);
				else OnTimer_UnblockFlash(asButton);
			}
		}
	}
	
	//-------------------------------------------------------
	
	void FlashButton(const tString &in asButton, float afBrightness = 1.4f)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asButton);
		FlashButton(asButton, pEnt.GetEffectBaseColor(), afBrightness);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_FlashButton(const tString &in asTimer)
	{
		FlashButton(asTimer);
	}
	
	//-------------------------------------------------------
	
	void FlashButton(const tString &in asButton, cColor aColor, float afBrightness = 1.4f, float afTime = 0.5f, bool abRepeat = false)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asButton);
		for (int i = 0; i < mvFlashTimers.size(); ++i)
		{
			if (mvFlashTimers[i] == pEnt.GetID()) return;
		}
								
		mvFlashTimers.push_back(pEnt.GetID());
		mvFlashOrigColors.push_back(pEnt.GetEffectBaseColor());
		mvFlashRepeat.push_back(abRepeat);
		mvFlashTimes.push_back(afTime);
		
		cColor newCol = aColor * afBrightness;
		mvFlashColors.push_back(newCol);
		
		Entity_FadeEffectBaseColor(asButton, newCol, afTime);
		Map_AddTimer(asButton, afTime, "OnTimer_StopFlash");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_StopFlash(const tString &in asTimer)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asTimer);
		for (int i = 0; i < mvFlashTimers.size(); ++i)
		{
			if (mvFlashTimers[i] == pEnt.GetID())
			{
				Entity_FadeEffectBaseColor(asTimer, mvFlashOrigColors[i], mvFlashTimes[i]);
				Map_AddTimer(asTimer, mvFlashTimes[i] + 0.05f, "OnTimer_UnblockFlash");
				return;
			}
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_UnblockFlash(const tString &in asTimer)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asTimer);
		for (int i = 0; i < mvFlashTimers.size(); ++i)
		{
			if (mvFlashTimers[i] == pEnt.GetID())
			{
				bool bRepeat = mvFlashRepeat[i];
				cColor repeatColor = mvFlashColors[i];
				float fTime = mvFlashTimes[i];
				pEnt.StopEffectBaseColorFade();
				pEnt.SetEffectBaseColor(mvFlashOrigColors[i]);
				
				mvFlashTimers.removeAt(i);
				mvFlashOrigColors.removeAt(i);
				mvFlashColors.removeAt(i);
				mvFlashRepeat.removeAt(i);
				mvFlashTimes.removeAt(i);
				if (bRepeat) FlashButton(asTimer, repeatColor, 1.0f, fTime, true);
				return;
			}
		}
	}
			
