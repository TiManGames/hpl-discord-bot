		//-------------------------------------------------------

		//} END General	

		/////////////////////////////////////////
		// Event A *Enter the Factory and see the FLYING WRAITH appear*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbShuttleEncounter_LookingAtIntroWraith = false;
		bool mbShuttleEncounterMusicStarted = false;
		
		float mfEnvParticleFadeOut = -1;
		float mfEnv_BigOrigBrightness = 0;
		array<cVector3f> mvEnv_OrigWinds;
		
		//-------------------------------------------------------
		
		void UpdateShuttleEncounter(float afTimeStep)
		{
			if (mfEnvParticleFadeOut > 0)
			{
				mfEnvParticleFadeOut -= afTimeStep;
				float fT = cMath_Clamp(mfEnvParticleFadeOut / 2.0f, 0.0f, 1.0f);
				
				cEnvironmentParticles@ pBigParticle = cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(2);
				if (pBigParticle !is null)
				{
					pBigParticle.SetBrightness(mfEnv_BigOrigBrightness * fT);
					if (fT <= 0) pBigParticle.SetVisible(false);
				}
				
				for (int i = 0; i < cLux_GetCurrentMap().GetWorld().GetEnvironmentParticleNum(); ++i)
				{
					if (i == 2) continue;
					cEnvironmentParticles@ pParticle = cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i);
					cVector3f vNewWind = mvEnv_OrigWinds[i] * fT;
					pParticle.SetWindVelocity(vNewWind);
				}
				
			}
		}

		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_EnterFactory(const tString &in asParent, const tString &in asChild, int alState)
		{
			
			mfEnvParticleFadeOut = 2.0f;
			
			cEnvironmentParticles@ pBigParticle = cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(2);
			if (pBigParticle !is null)
			{
				mfEnv_BigOrigBrightness = pBigParticle.GetBrightness();
			}
			
			for (int i = 0; i < cLux_GetCurrentMap().GetWorld().GetEnvironmentParticleNum(); ++i)
			{
				cEnvironmentParticles@ pParticle = cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i);
				mvEnv_OrigWinds.push_back(pParticle.GetWindVelocity());
			}
			
			Prop_SetActiveAndFade("clouds_first_area", true, 2);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_TrackFinalRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			Amulet_StartTracking(true, "Rift_2");
			Voice_PlayDelayed("Dialogue_AmuletTrackingRift", 1.0);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SetupShuttleEncounter(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("[Map] Setup shuttle encounter");
			
			//////////////
			// Setup first wraith
			Entity_SetActive("Wraith_Shuttle_1", true);
			Wraith_SetStruggleWinnable("Wraith_Shuttle_1", false);
			Wraith_SetInfiniteStruggle("Wraith_Shuttle_1", true);
			Wraith_SetGazeDetection("Wraith_Shuttle_1", false);
			Wraith_SetPlayStruggleOutroAnim("Wraith_Shuttle_1", false);
			Wraith_SetStruggleDashActive("Wraith_Shuttle_1", false);
			Wraith_SetFly("Wraith_Shuttle_1", true);
			Wraith_SetHearing("Wraith_Shuttle_1", false);
			Wraith_SetCallback_Struggle("Wraith_Shuttle_1", "OnStruggle_EndShuttleEncounter");
			Wraith_CommandCustom_Execute("Wraith_Shuttle_1", true, "");
			
//			Wraith_SetSight("Wraith_Shuttle_1", false);
			
			Map_AddTimer("Timer_SetupShuttleEncounterWraith1", 0.1f, "OnTimer_SetupShuttleEncounterWraith1");
			
			//////////////
			// Setup second wraith
			Wraith_SetStruggleWinnable("Wraith_Shuttle_2", false);
			Wraith_SetInfiniteStruggle("Wraith_Shuttle_2", true);
			Wraith_SetGazeDetection("Wraith_Shuttle_2", false);
			Wraith_SetPlayStruggleOutroAnim("Wraith_Shuttle_2", false);
			Wraith_SetStruggleDashActive("Wraith_Shuttle_2", false);
			Wraith_SetFly("Wraith_Shuttle_2", true);
			Wraith_SetHearing("Wraith_Shuttle_2", false);
			Wraith_SetCallback_Struggle("Wraith_Shuttle_2", "OnStruggle_EndShuttleEncounter");
			
//			Wraith_SetSight("Wraith_Shuttle_2", false);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetupShuttleEncounterWraith1(const tString &in asTimer)
		{
			CharMover_TurnToEntity("Wraith_Shuttle_1", "Target_ShuttleEncounter_LookAt_1", "");
//			Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.75, 0.4, 0.05, "Target_ShuttleEncounter_LookAt_1", true, true);
			Wraith_TurnSpotlightToPos("Wraith_Shuttle_1", Map_GetEntity("Target_ShuttleEncounter_LookAt_1").GetPosition(), true, false);
			Wraith_SetSpotlightOn("Wraith_Shuttle_1", false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_StartShuttleEncounter(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("[Map] Start shuttle encounter");
			Seq_ShuttleEncounterIntro("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceShuttleEncounterIntro;
		void Seq_ShuttleEncounterIntro(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ShuttleEncounterIntro", mSequenceShuttleEncounterIntro);
			if (Sequence_DoStepAndWait(2.0f))
			{
				Pregnancy_SetWhispering(true);
				
				Wraith_SetSpotlightOn("Wraith_Shuttle_1", true);
				Wraith_TurnSpotlightToPos("Wraith_Shuttle_1", Map_GetEntity("Target_ShuttleEncounter_LookAt_2").GetPosition(), true, true);
				Wraith_SetCallback_BeamSeen("Wraith_Shuttle_1", "OnBeamSeen_SeesWraithDialogue", 1.25, true);
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				// show bream
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.75, 0.4, 0.05, "Target_ShuttleEncounter_LookAt_2", true, true);
			}
			else if (Sequence_DoStepAndPause(0.5f))
			{
				// move out
				Map_AddTimer("Timer_StartShuttleEncounterMusic", 2, "OnTimer_StartShuttleEncounterMusic");
				Map_RemoveTimer("Timer_CheckSeeWraith");
				Wraith_CommandFlyToNode_Execute("Wraith_Shuttle_1", "Target_ShuttleEncounter_MoveTo_1", true, 1, false, "OnCommandEnd_ResumeShuttleEncounterIntro");
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				// look at random pods
				Wraith_SetSpotlightOn("Wraith_Shuttle_1", true);
				CharMover_TurnToEntity("Wraith_Shuttle_1", "Target_ShuttleEncounter_LookAt_3", "");
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.75, 0.4, 0.05, "Target_ShuttleEncounter_LookAt_3", true, true);
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				// notice shuttle
				Wraith_CommandCustom_Execute("Wraith_Shuttle_1", true, "");
				Wraith_SetSpotlightMovement_ForwardOffset("Wraith_Shuttle_1", 0, 0, true);
				Wraith_SetSpotlightColor("Wraith_Shuttle_1", "alert");
				
				Sound_CreateAtEntity("WraithSpotPlayer", "creatures/vocalisations/creature/wraith/wraith_short_alert", "Wraith_Shuttle_1", 0, false, 1, 40, 100);
				
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				// look at the back
				CharMover_TurnToEntity("Wraith_Shuttle_1", "Target_ShuttleWraithBack", "");
				Wraith_TurnSpotlightToPos("Wraith_Shuttle_1", Map_GetEntity("Target_ShuttleWraithBack").GetPosition(), true, true, 0.7f);
			}
			else if (Sequence_DoStepAndWait(10.0f))
			{
				// start scanning whole shuttle
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.4f, 0.4f, 0.01f, "Target_ShuttleRightSide", true, true);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				// follow shuttle front right, look at front
				Wraith_Command_Remove("Wraith_Shuttle_1");
				Wraith_ModeFlyFollowEntity_Setup("Wraith_Shuttle_1", "Target_ShuttleWraithFrontRight", 0.75);
				Wraith_Mode_Set("Wraith_Shuttle_1", eWraithMode_FlyFollowEntity, true);
				Wraith_SetSpotlightMovement_FollowEntity("Wraith_Shuttle_1", "Target_ShuttleCenterFront", true);
				Wraith_StartFacingEntity("Wraith_Shuttle_1", "Target_ShuttleCenterFront");
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				// move to front, scan
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.5f, 0.2f, 0.01f, "Target_ShuttleCenterFront", true, true);
				Wraith_ModeFlyFollowEntity_SetEntity("Wraith_Shuttle_1", "Target_ShuttleWraithFront", 0.75);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				//move to front left
				Wraith_ModeFlyFollowEntity_SetEntity("Wraith_Shuttle_1", "Target_ShuttleWraithFrontLeft", 0.75f);
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				// scan shuttle
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.4f, 0.25f, 0.01f, "Target_ShuttleCenterFront", true, true);
				Wraith_StartFacingEntity("Wraith_Shuttle_1", "Target_ShuttleCenterFront");
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				// start second wraith
				Seq_ShuttleEncounter_Wraith2("");
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				// move left, look back
//				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.4f, 0.4f, 0.01f, "Target_ShuttleLeftSide", true, true);
				Wraith_SetSpotlightMovement_FollowEntity("Wraith_Shuttle_1", "Target_ShuttleCenterBack", true);
				Wraith_ModeFlyFollowEntity_SetEntity("Wraith_Shuttle_1", "Target_ShuttleWraithLeft");
				Wraith_StartFacingEntity("Wraith_Shuttle_1", "Target_ShuttleCenterBack");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Seq_ShuttleEncounterFinale("");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnBeamSeen_SeesWraithDialogue(const tString &in asEntityName, int alState)
		{
			Voice_PlayDelayed("Dialogue_SeesWraith", 0.5f);
			Map_AddTimer("Timer_StartShuttleEncounterMusic", 0, "OnTimer_StartShuttleEncounterMusic");
			Music_Play("A2_1_4_ErskinesCorpse_2.ogg", 0.6f, false, eMusicPrio_MinorEvent);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartShuttleEncounterMusic(const tString &in asTimer)
		{
			if (mbShuttleEncounterMusicStarted) return;
			mbShuttleEncounterMusicStarted = true;
			Music_PlayExt("A2_1_4_DarkWorld_Scary.ogg", true, 0.6f, 1.0f, 5.0f, 1.0f, eMusicPrio_SceneAmb, false);
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_ResumeShuttleEncounterIntro(const tString &in asEntity)
		{
			SequenceStates_Resume("Seq_ShuttleEncounterIntro");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PodAreaSound(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_ShuttleSlow", "03_07_dw_factory/shuttle/shuttle_slow_loop", "Target_ShuttleCenterTop");
			return false;
		}
		
		//-------------------------------------------------------

		//} END Event A *Enter the Factory and see the FLYING WRAITH appear*
		
		/////////////////////////////////////////
		// Event B *Hide from the wraith that is inspecting the SHUTTLE*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbShuttleEncounter_PastStruggle = false;
		bool mbShuttle_Stop = false;
		bool mbShuttle_Stopped = false;
		
		//-------------------------------------------------------
		
		void OnStruggle_EndShuttleEncounter(const tString &in asEntityName)
		{
			if (mbShuttleEncounter_PastStruggle) return;
			SequenceStates_Stop("Seq_ShuttleEncounterIntro");
			SequenceStates_Stop("Seq_ShuttleEncounter_Wraith2");
			SequenceStates_Stop("Seq_ShuttleEncounterFinale");
			Seq_ShuttleEncounterPastStruggle("");
			
			mfShuttle_TargetSpeed = 1.75;
			mfShuttle_MoveAcceleration = 2;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceShuttleEncounterFinale;
		void Seq_ShuttleEncounterFinale(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ShuttleEncounterFinale", mSequenceShuttleEncounterFinale);
			if (Sequence_DoStepAndWait(2.0f))
			{
				// w1 scan shuttle
				Wraith_StartFacingEntity("Wraith_Shuttle_1", "Target_ShuttleCenter");
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.5f, 0.4f, 0.01f, "Target_ShuttleLeftSide", true, true);
			}
			else if (Sequence_DoStepAndWait(6.0f))
			{
				// w2 scan shuttle
				Wraith_StartFacingEntity("Wraith_Shuttle_2", "Target_ShuttleCenter");
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_2", 0.5f, 0.4f, 0.01f, "Target_ShuttleRightSide", true, true);
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{
				// w2 move back right, scan
				Wraith_ModeFlyFollowEntity_SetEntity("Wraith_Shuttle_2", "Target_ShuttleWraithBackRight", 0.6);
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_2", 0.5f, 0.1f, 0.01f, "Target_ShuttleLeftSide", true, true);
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				// w2 move final
				Wraith_ModeFlyFollowEntity_SetEntity("Wraith_Shuttle_2", "Target_ShuttleWraithBackRightFinal");
				
				// w1 look to left
				Wraith_ModeFlyFollowEntity_SetEntity("Wraith_Shuttle_1", "Target_ShuttleWraithFrontLeft", 0.6);
				Wraith_SetSpotlightMovement_Forward("Wraith_Shuttle_1", true);
//				Wraith_SetSpotlightMovement_FollowEntity("Wraith_Shuttle_1", "Target_ShuttleLeftSide", true);
//				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_Shuttle_1", 0.5f, 0.1f, 0.01f, "Target_ShuttleCenterFront", true, true);
			}
			else if (Sequence_DoStepAndWait(8.0f))
			{
				// w1 move final
				Wraith_SetSpotlightMovement_FollowEntity("Wraith_Shuttle_1", "Target_ShuttleCenterFront_2", true);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Map_AddTimer("Timer_CheckPastStruggle", 0, "OnTimer_CheckPastStruggle");
				Map_AddTimer("EncounterTooLong", 6, "");
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void OnTimer_CheckPastStruggle(const tString &in asTimer)
		{
			if (mbShuttleEncounter_PastStruggle) return;
			if (Wraith_GetAlertState("Wraith_Shuttle_1") == 0 && Wraith_GetAlertState("Wraith_Shuttle_2") == 0 && (mbShuttleEncounter_PastStruggle == false || Map_TimerExists("EncounterTooLong") == false))
			{
				if (Map_TimerExists("EncounterTooLong") == false) cLux_AddDebugMessage("[Map] Encounter took too long");
				Seq_ShuttleEncounterPastStruggle("");
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.4));
		}
		
		//-------------------------------------------------------

		//} END Event B *Hide from the wraith that is inspecting the SHUTTLE*
		
		/////////////////////////////////////////
		// Event C *A second wraith appears*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceShuttleEncounter_Wraith2;
		void Seq_ShuttleEncounter_Wraith2(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ShuttleEncounter_Wraith2", mSequenceShuttleEncounter_Wraith2);
			if (Sequence_DoStepAndWait(0.2f))
			{
				// activate in stealth
				Entity_SetActive("Wraith_Shuttle_2", true);
				Wraith_SetCoverage("Wraith_Shuttle_2", 0);
				Wraith_SetFly("Wraith_Shuttle_2", true);
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				Wraith_CommandDash_Execute("Wraith_Shuttle_2", Map_GetEntity("Target_ShuttleWraith_PassBy_1").GetPosition(), false, true);
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				// start following shuttle
				Wraith_ModeFlyFollowEntity_Setup("Wraith_Shuttle_2", "Target_ShuttleWraith_PassBy_1");
				Wraith_Mode_Set("Wraith_Shuttle_2", eWraithMode_FlyFollowEntity, true);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				// look forward
				Wraith_SetSpotlightMovement_ForwardOffset("Wraith_Shuttle_2", cMath_ToRad(0), cMath_ToRad(5), true);
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				// make sound and move ahead
				Sound_CreateAtEntity("WraithSound", "creatures/vocalisations/creature/wraith/wraith_ search", "Wraith_Shuttle_2", 0, false, 1, 40, 100);
				Wraith_ModeFlyFollowEntity_SetEntity("Wraith_Shuttle_2", "Target_ShuttleWraith_PassBy_2", 0.75f);
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				// look at at front and make sound
				Wraith_SetSpotlightMovement_FollowEntity("Wraith_Shuttle_2", "Target_ShuttleCenterFront", true);
				Wraith_StartFacingEntity("Wraith_Shuttle_2", "Target_ShuttleCenterFront");
				Sound_CreateAtEntity("WraithSound", "creatures/vocalisations/creature/wraith/wraith_ search", "Wraith_Shuttle_2", 0, false, 1, 40, 100);
			}
			Sequence_End();
		}

		//-------------------------------------------------------

		//} END Event C *A second wraith appears*
		
		/////////////////////////////////////////
		// Event D *Get spotted by one of the wraiths and fall into the Factory*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		tString msShuttle_FallAnimEnt;
		tString msShuttle_FallLanternAnimEnt;
		tString msShuttle_FallAnim;
		bool mbShuttle_FallMove = false;
		int mlShuttle_StopPos = 0;
		bool mbShuttle_FallFront = true;
		
		//-------------------------------------------------------
		
		void ShakeShuttle(bool abAnim = true)
		{
			Sound_CreateAtEntity("RattleFloor", "03_07_dw_factory/shuttle/shuttle_shake", "Target_ShuttleCenter");
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("RattleFloor");
			pSound.SetCustomMaxDistance(40.0f);
			pSound.SetCustomMinDistance(20.0f);
			pSound.SetUseCustomProperties(true);
			
			Effect_Shake_Start(0.06f, 0.8f, 0.2f, 0.2f);
			FearHandler_SetForcedAddFearRate(0.5f, 2.0f, true, 4.0f, 0.2f, 0.25f);
			
			if (abAnim) Entity_PlayAnimation("Shuttle", "dwf_shuttle_sway", 0.25f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Shuttle_SetStopSpot(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			cLux_AddDebugMessage("[Map] Pass by stop: " + asParent);
			if (mbShuttle_Stop == false && Entity_GetVarString(asParent, "") != "final") return true;
			if (mbShuttle_Stopped) return true;
			
			SequenceStates_Resume("Seq_ShuttleEncounterPastStruggle");
			
			mbShuttle_Stopped = true;
			mfShuttle_TargetSpeed = 0;
			mfShuttle_MoveAcceleration = 1;
			
			mlShuttle_StopPos = 1;
			
			cLux_AddDebugMessage("[Map] Stop shuttle " + asParent + " " + mlShuttle_StopPos);
			
			return true;
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceShuttleEncounterPastStruggle;
		void Seq_ShuttleEncounterPastStruggle(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ShuttleEncounterPastStruggle", mSequenceShuttleEncounterPastStruggle);
			if (Sequence_DoStepAndWait(4.0f))
			{
				cLux_AddDebugMessage("[Map] Past struggle");
				mbShuttleEncounter_PastStruggle = true;
				
				Wraith_SetStruggleFollowEnt("Wraith_Shuttle_1", "Shuttle", Map_GetEntity("Wraith_Shuttle_1").GetPosition() - Map_GetEntity("Shuttle").GetPosition());
				Wraith_SetStruggleFollowEnt("Wraith_Shuttle_2", "Shuttle", Map_GetEntity("Wraith_Shuttle_2").GetPosition() - Map_GetEntity("Shuttle").GetPosition());
			}	
			else if (Sequence_DoStepAndWait(1.0f))
			{
				// stop struggle
				Wraith_StopStruggle("Wraith_Shuttle_1");
				Wraith_StopStruggle("Wraith_Shuttle_2");
				
				// senses off
				Agent_SetSensesActive("Wraith_Shuttle_1", false);
				Agent_SetSensesActive("Wraith_Shuttle_2", false);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Wraith_ModeIdle_SetResetSpotlight("Wraith_Shuttle_1", false, true);
				Wraith_Mode_Set("Wraith_Shuttle_1", eWraithMode_Idle, true);
				Wraith_ModeIdle_SetResetSpotlight("Wraith_Shuttle_2", false, true);
				Wraith_Mode_Set("Wraith_Shuttle_2", eWraithMode_Idle, true);
				
				Wraith_SetSpotlightColor("Wraith_Shuttle_1", "idle");
				Wraith_SetSpotlightColor("Wraith_Shuttle_2", "idle");
				
				Wraith_StopSpotlightMovement("Wraith_Shuttle_1");
				Wraith_StopSpotlightMovement("Wraith_Shuttle_2");
				
				Wraith_StopFacingEntity("Wraith_Shuttle_1");
				Wraith_StopFacingEntity("Wraith_Shuttle_2");
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Wraith_CommandDash_Execute("Wraith_Shuttle_1", Map_GetEntity("Target_WraithShuttleDisappear_1").GetPosition(), false, true, true);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Wraith_CommandDash_Execute("Wraith_Shuttle_2", Map_GetEntity("Target_WraithShuttleDisappear_2").GetPosition(), false, true, true);
			}
			else if (Sequence_DoStepAndWait(5.0))
			{
				mbShuttle_Stop = true;
				if (mbShuttle_Stopped) SequenceStates_Resume("Seq_ShuttleEncounterPastStruggle");
				Sound_Stop("Sound_ShuttleSlow", 2.0f);
				Sound_CreateAtEntity("ShuttleStop", "03_07_dw_factory/shuttle/shuttle_stop", "Target_ShuttleCenterTop");
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				ShakeShuttle();
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				ShakeShuttle();
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				Seq_ShuttleFall("");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		cVector3f SelectShuttleEncounterDisengageArea(const tString &in asAgent)
		{
			array<iLuxEntity@> vEnts;
			Map_GetEntityArray("Target_ShuttleEncounterDisengage*", vEnts);
			
			cVector3f vAgentPos = Map_GetEntity(asAgent).GetPosition();
			
			int fMinDist = -1;
			cVector3f vPos;
			for (int i = 0; i < vEnts.size(); ++i)
			{
				iLuxEntity@ pEnt = vEnts[i];
				if (pEnt.GetVarBool("disengage_selected")) continue;
				cVector3f vNode = pEnt.GetPosition();
				float fDist = cMath_Vector3DistSqr(vAgentPos, vNode);
				if (fMinDist < 0 || fDist < fMinDist)
				{
					fMinDist = fDist;
					vPos = vNode;
					pEnt.SetVarBool("disengage_selected", true);
				}
			}
			
			return vPos;
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_ShuttleWraithDisappear(const tString &in asEntity)
		{
			Wraith_CommandDisappear_Execute(asEntity, true, true);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceShuttleFall;
		void Seq_ShuttleFall(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ShuttleFall", mSequenceShuttleFall);
			if (Sequence_DoStepAndPause(0))
			{
				msShuttle_FallAnimEnt = "";
				msShuttle_FallAnim = "";
				msShuttle_FallLanternAnimEnt = "";
				iLuxEntity@ pShuttle = Map_GetEntity("Shuttle");
				float fBackwardsDot = cMath_Vector3Dot(cLux_GetPlayer().GetCamera().GetForward(), pShuttle.GetMatrix().GetTranspose().GetForward());
				if (fBackwardsDot <= 0)
				{
					mbShuttle_FallFront = false;
					cLux_AddDebugMessage("[Map] Back fall");
					Voice_Play("Scene_TasiFalls_Back");
					Sound_CreateAtEntity("Sound_ShuttleOpenBack", "03_07_dw_factory/shuttle/shuttle_open_back", "player");
					Sound_CreateAtEntity("Sound_PlayerFront", "03_07_dw_factory/shuttle/animation/player_fall_back", "player");
					Map_AddTimer("Timer_SoundLanternBreakRear", 6.5f, "OnTimer_LanternBreak");
					Music_Stop(0.4f, eMusicPrio_SceneAmb);
					Music_Play("A2_3_8_Shuttle_Fall.ogg", 0.4f, false, eMusicPrio_MinorEvent);
					msShuttle_FallAnimEnt = "Target_ShuttleFallAnim_Back";
					msShuttle_FallAnim = "hang_from_shuttle_then_fall_trapdoor_back";
					msShuttle_FallLanternAnimEnt = "lantern_shuttle_fall_trapdoorback";
				}
				else
				{
					mbShuttle_FallFront = true;
					cLux_AddDebugMessage("[Map] Front fall");
					Voice_Play("Scene_TasiFalls_Front");
					Sound_CreateAtEntity("Sound_ShuttleOpenFront", "03_07_dw_factory/shuttle/shuttle_open_front", "player");
					Sound_CreateAtEntity("Sound_PlayerFront", "03_07_dw_factory/shuttle/animation/player_fall_front", "player");
					Map_AddTimer("Timer_SoundLanternBreakFront", 5.7f, "OnTimer_LanternBreak");
					Music_Play("A2_3_8_Shuttle_Fall_Front.ogg", 0.4f, false, eMusicPrio_MinorEvent);
					msShuttle_FallAnimEnt = "Target_ShuttleFallAnim_Front";
					msShuttle_FallAnim = "hang_from_shuttle_then_fall_trapdoor_front";
					msShuttle_FallLanternAnimEnt = "lantern_shuttle_fall_trapdoorfront";
				}
				
				ShakeShuttle(true);
				PlayerBody_PlayCutsceneAnimation("regain_balance_dwf_shuttle_sway", false, 0.25f, "OnAnimEnd_PlayerSway");
				FearHandler_SetForcedAddFearRate(1.0f, 999.0f, true, 4.0f, 0.2f, 0.25f);
				
				Item_PutAway(eItemHandlerHand_Right);
				Item_PutAway(eItemHandlerHand_Left);
				
				Player_SetMoveSpeedMul(0);
				mbShuttle_FallMove = true;
			}
			else if (Sequence_DoStepAndPause(0.0f))
			{
				PlayerBody_SetCutsceneMaxPitch(20);
				PlayerBody_PlayCutsceneAtEntity(msShuttle_FallAnim, msShuttle_FallAnimEnt, false, 0.25f, "OnAnimEnd_ShuttleFall", 1, 0, 0, mbShuttle_FallFront ? 0 : 180);				
				Entity_PlayAnimation("Shuttle", "dwf_shuttle_open_trapdoors", 0);
				Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimationMessage_PlayerFall", false);
				
				Entity_PlaceAtEntity("LanternBroken_Animnation", msShuttle_FallAnimEnt, cVector3f_Zero, true);
				Entity_SetActive("LanternBroken_Animnation", true);				
				Entity_PlayAnimation("LanternBroken_Animnation", msShuttle_FallLanternAnimEnt);
				Entity_SetAnimationMessageEventCallback("LanternBroken_Animnation", "OnAnimationMessage_LanternFall", false);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
//				Pregnancy_SetBarksActive(false);
//				Player_GiveDamage(1.0f, 0.8f, 0, "");
//				Effect_Fade_Out(0.1f);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
//				Pregnancy_SetBarksActive(true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LanternBreak(const tString &in asTimer)
		{
			Sound_Play("Sound_LanternBreak", 0.0f);
		}
		
		//-------------------------------------------------------
		
		void OnAnimationMessage_PlayerFall(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			// landing
			if (alMessageEventID == 0)
			{
				Player_GiveDamage(0.2, 0.9, eDamageType_Fall, "");
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_PlayerSway(const tString &in asAnimName)
		{
			SequenceStates_Resume("Seq_ShuttleFall");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ShuttleFall(const tString &in asAnimName)
		{
			mfTopFloorRiftDistance = Player_GetDistanceToEntity("Rift_2");
			if (mlShuttle_StopPos == 1)
			{
				Entity_SetActive("Trigger_StartWraithTopEncounterStart_1", true);
				mfTopFloorLookAtStartTime = 8;
				mfTopFloorStartTime = 16;
				mfTopFloorEncounter_MoveForwardDist = 4;
			}
			else if (mlShuttle_StopPos == 2)
			{
				Entity_SetActive("Trigger_StartWraithTopEncounterStart_2", true);
				mfTopFloorLookAtStartTime = 5;
				mfTopFloorStartTime = 10;
				mfTopFloorEncounter_MoveForwardDist = 4;
			}
			else if (mlShuttle_StopPos == 3)
			{
				Entity_SetActive("Trigger_StartWraithTopEncounterStart_3", true);
				mfTopFloorLookAtStartTime = 4;
				mfTopFloorStartTime = 8;
				mfTopFloorEncounter_MoveForwardDist = 2;
			}
			
			Player_SetPregnancyExertionActive(true);
			Player_SetMoveSpeedMul(1);
			ItemType_RemoveFromInventory("Lantern", -1);
			
			FearHandler_SetDarknessFactorActive(true);
			FearHandler_SetForcedAddFearRate(0.0f, -1.0f, true, 4.0f, 0.075f, 0.0f);
			if (FearHandler_GetLevel() > 0.4) FearHandler_FadeLevelTo(0.4, 4, true);
			
			cScript_SetGlobalVarBool("Global_LanternLost", true);
			
			Visibility_SetAreaActive("VisibilityArea_Elevator_2", false);
			
			Map_GetEntity("Shuttle").StopAllAnimations(1.0f);
			Entity_SetActive("Trigger_RemindGoalDialogue", true);
			
			mlPermaFailStage = eFactoryCPerfmaFailStage_TopFloor;
			
			Map_AddTimer("Timer_CheckTopFloorEncounter", 0.0f, "OnTimer_CheckTopFloorEncounter");
			
			Music_PlayExt("A2_3_8_Pod_Ambience.ogg", true, 0.2f, 1.0f, 2.0f, 0.0f, eMusicPrio_SceneAmb, false);
		}
		
		//-------------------------------------------------------
		
		void OnAnimationMessage_LanternFall(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			// break
			if (alMessageEventID == 0)
			{
				Entity_SetEffectsActive("LanternBroken_Animnation", false, false);
			}
			
			// switch with grab
			else if (alMessageEventID == 1)
			{
				Entity_SetActive("LanternBroken_Animnation", false);
				Entity_SetActive("LanternBroken_Lid", true);
				Entity_SetActive("LanternBroken_Grab", true);
			}
		}
		
		//-------------------------------------------------------

		//} END Event D *Get spotted by one of the wraiths and fall into the Factory*

	//} END SCENE 11
	 
