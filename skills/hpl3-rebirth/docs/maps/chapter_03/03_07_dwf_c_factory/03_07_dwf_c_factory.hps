	void OnStart()
	{					
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		//sky rotation
		cVector3f vRot = cVector3f(0, cMath_ToRad(143), 0);
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);

		cLux_GetCurrentMap().GetPhysicsWorld().SetWorldSize(Map_GetEntity("Target_PhysicsMin").GetPosition(), Map_GetEntity("Target_PhysicsMax").GetPosition());
		
		if (cScript_GetGlobalVarBool("DWF_RnD_UsedVitaeChair"))
			Achievement_Unlock(eAchievement_Torturer);
		else
			Achievement_Unlock(eAchievement_Altruist);
		
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		//PlayerBody_SetModel("player.ent");
		PlayerBody_SetActive(true);
		FearHandler_SetPermaFailEnabled(true);
        Heat_SetActive(false);
		Player_SetAutoTeleportWhenBelowAltitude(9.2);
		
		if (cLux_ScriptDebugOn() == false)
		{
			Effect_Fade_Out(0);
			Player_Teleport("Start_Begin", true);
			Seq_ShuttleRide("");
		}
		
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(15);
		
		/////////////////////////
		// Inventory
		if (cLux_ScriptDebugOn())
		{
			Item_AddToInventory("ShadowFleshCanister");
			
			if (ItemType_IsInInventory("Lantern") == false)
			{
				Item_AddToInventory("Lantern");
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
				Item_AddToInventory("HerbertOil");
				Item_SetContent(ItemType_GetFirstInInventory("HerbertOil"), "Oil", 10);
				Item_AddToInventory("Matchbook");
				Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
			}
		}
		
		Light_SetVisible("DebugLight*", false);
		Light_SetVisible("Light_Box_Debug*", false);
		
		/////////////////////////
		// System setup
		Amulet_StartTracking(true, "Rift_1");
		Player_SetMapDeepShadow(1.0f);
		FearHandler_SetPermaFailRespawnArea("PermaFail_TopFloor");
		Blackboard_AddWraithBillboards("WraithBillboard");
		FearHandler_SetDifficultyMul(0.6f);
		FearHandler_SetLevelTo(0);
		RiftHandler_SetAllowHint(false);
		
		Player_SetNightVisionBrightness(3.5);
		
		if (cLux_ScriptDebugOn() == false)
		{
			Visibility_SetAreaActive("VisibilityArea_TopFloor_1", false);
			Visibility_SetAreaActive("VisibilityArea_TopFloor_2", false);
			Visibility_SetAreaActive("VisibilityArea_TopFloor_3", false);
			Visibility_SetAreaActive("VisibilityArea_MiddleBottomFloor_1", false);
			Visibility_SetAreaActive("VisibilityArea_MiddleBottomFloor_2", false);
		}
		
//		cLux_GetPlayer().SetCollideCallbacksActive(false);
		
//		FearHandler_SetActive(false);
		
		/////////////////////////
		// Init scenes
		InitShuttle();
		InitDarkWorldLightning();
		InitShuttleCorridor();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Player_RestoreClipPlane();
	}

