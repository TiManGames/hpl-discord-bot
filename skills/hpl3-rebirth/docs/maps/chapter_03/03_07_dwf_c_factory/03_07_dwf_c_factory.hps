		/////////////////////////////////////////
		// Event B *Avoid the FLYING WRAITH on the top floor*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		float mfTopFloorRiftDistance = 0;
		float mfTopFloorEncounter_MoveForwardDist = 0;
		float mfTopFloorStartTimer = 0;
		float mfTopFloorStartTime = 0;
		float mfTopFloorLookAtStartTime = 0;
		bool mbTopFloorStartLookAt = false;
		int mlTopFloorAboveScareIndex = 0;
		
		//-------------------------------------------------------
		
		void OnLookAt_StartWraithTopEncounter(const tString &in asEntity, int alState)
		{
			mbTopFloorStartLookAt = alState == 1;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckTopFloorEncounter(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.2, 0.4);
			mfTopFloorStartTimer += fNext;
			if (CanStartTopFloorEncounter())
			{
				StartTopFloorEncounter();
				return;
			}
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		bool CanStartTopFloorEncounter()
		{
			if (mfTopFloorStartTimer >= mfTopFloorLookAtStartTime && mbTopFloorStartLookAt) return true;
			if (mfTopFloorStartTimer >= mfTopFloorStartTime) return true;
			float fRiftDist = Player_GetDistanceToEntity("Rift_2");
			if (fRiftDist <= mfTopFloorRiftDistance - mfTopFloorEncounter_MoveForwardDist) return true;
			return false;
		}
		
		//-------------------------------------------------------
		
		void StartTopFloorEncounter()
		{
			cLux_AddDebugMessage("[Map] Top floor encounter: " + mfTopFloorStartTimer + "/" + mfTopFloorLookAtStartTime + "/" + mfTopFloorStartTime
										+ " " + Player_GetDistanceToEntity("Rift_2") + "/" + (mfTopFloorRiftDistance + mfTopFloorEncounter_MoveForwardDist) + " stop: " + mlShuttle_StopPos);
			
			Entity_SetActive("Trigger_StartWraithTopEncounterStart_" + mlShuttle_StopPos, false);
			
			FearHandler_SetDifficultyMul(0.6f);
			FearHandler_SetPermaFailEnabled(true);
			
			Entity_SetActive("Wraith_TopFloor", true);
			
			Entity_PlaceAtEntity("Wraith_TopFloor", "Target_Wraith_TopFloor_" + mlShuttle_StopPos, cVector3f_Zero, true);
			iLuxEntity@ pStartEnt = Map_GetEntity("Target_Wraith_TopFloor_" + mlShuttle_StopPos);
			CharMover_TurnInstantlyToPos("Wraith_TopFloor", pStartEnt.GetPosition() - pStartEnt.GetMatrix().GetTranspose().GetForward());
			
			Wraith_SetFly("Wraith_TopFloor", true);
			Wraith_SetSpotlightSoundVolumeMul("Wraith_TopFloor", 0);
			Agent_SetSensesActive("Wraith_TopFloor", false);
			
			Wraith_CommandFlyToNode_Execute("Wraith_TopFloor", "Target_TopFloorIntro_MoveTo_" + mlShuttle_StopPos + "_2", true, 0, false, "OnCommandComplete_LookAt");
		}
		
		//-------------------------------------------------------
		
		void OnCommandComplete_LookAt(const tString &in asEntity)
		{
			Agent_SetSensesActive("Wraith_TopFloor", true);
			Wraith_SetSpotlightSoundVolumeMul("Wraith_TopFloor", 1);
			Wraith_CommandLookAtPosition_Execute("Wraith_TopFloor", Map_GetEntity("Target_TopFloorIntro_LookAt_1").GetPosition(), true, false, true, "OnCommandComplete_SetTopFloorStress");
		}
		
		//-------------------------------------------------------
		
		void OnCommandComplete_SetTopFloorStress(const tString &in asEntity)
		{
//			if (mlShuttle_StopPos == 2) Wraith_SetPlayerStress("Wraith_TopFloor", -0.35f);
//			else if (mlShuttle_StopPos == 3) Wraith_SetPlayerStress("Wraith_TopFloor", -1.0f);
			Wraith_CommandFlyToNode_Execute("Wraith_TopFloor", "Target_FlyingWraithNode_TopFloor_19", false, 1, false, "OnCommandComplete_TopFloorStartPatrol");
		}
		
		//-------------------------------------------------------
		
		void OnCommandComplete_TopFloorStartPatrol(const tString &in asEntity)
		{
			Wraith_SetHearing("Wraith_TopFloor", false);
			
//			Wraith_SetSpotlightSoundVolumeMul("Wraith_TopFloor", 0.2f);
//			Wraith_SetVolumeMul("Wraith_TopFloor", 0.2f);
			Agent_SetSoundVolume("Wraith_TopFloor", 0.1f);
			
			Wraith_ModeFlyPatrol_SetPlayerGoalDirection("Wraith_TopFloor", "Target_GoalDirection_TopFloor_1");
			Wraith_ModeFlyPatrol_ClearNodes("Wraith_TopFloor");
			Wraith_ModeFlyPatrol_AddNodeRange("Wraith_TopFloor", "Target_FlyingWraithNode_TopFloor*", 1, 9);
			Wraith_ModeFlyPatrol_AddNodeRange("Wraith_TopFloor", "Target_FlyingWraithNode_TopFloor*", 28, 30);
			Wraith_ModeFlyPatrol_AddNodeRange("Wraith_TopFloor", "Target_FlyingWraithNode_TopFloor*", 19, 26);
			Wraith_ModeFlyPatrol_ClearLookAtFields("Wraith_TopFloor");
			Wraith_ModeFlyPatrol_AddLookAtfield("Wraith_TopFloor", "Target_FlyingWraithLookAtField_TopFloor_1");
			Wraith_ModeFlyPatrol_AddLookAtfield("Wraith_TopFloor", "Target_FlyingWraithLookAtField_TopFloor_2");
			Wraith_ModeFlyPatrol_AddLookAtfield("Wraith_TopFloor", "Target_FlyingWraithLookAtField_TopFloor_3");
			Wraith_ModeFlyPatrol_AddLookAtfield("Wraith_TopFloor", "Target_FlyingWraithLookAtField_TopFloor_4");
			Wraith_ModeFlyPatrol_AddLookAtfield("Wraith_TopFloor", "Target_FlyingWraithLookAtField_TopFloor_5");
			Wraith_ModeFlyPatrol_AddLookAtfield("Wraith_TopFloor", "Target_FlyingWraithLookAtField_TopFloor_6");
			Wraith_ModeFlyPatrol_SetUseRandomNodes("Wraith_TopFloor", true);
			Wraith_ModeFlyPatrol_Setup("Wraith_TopFloor", false);
			Wraith_Mode_Set("Wraith_TopFloor", eWraithMode_FlyPatrol, false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartTopFloorGrounded(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_StartTopFloorGrounded*", false);
			
			Agent_SetSensesActive("Wraith_TopFloor", false);
			
			Entity_SetActive("Wraith_TopFloorGrounded", true);
			Wraith_SetHearing("Wraith_TopFloorGrounded", false);
			
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_TopFloorGrounded");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_56");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_36");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_18");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_5");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_11");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_8");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_83");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_23");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TopFloorGrounded", "PathNode_Top_5");
			Wraith_ModeWraithPatrol_Setup("Wraith_TopFloorGrounded", false, false);
			Wraith_Mode_Set("Wraith_TopFloorGrounded", eWraithMode_WraithPatrol, false);
			
			Wraith_CommandLookAtPosition_Execute("Wraith_TopFloorGrounded", Map_GetEntity("Target_TopFloorGrounded_LookAt_1").GetPosition(), true, false, true);
			
			Map_AddTimer("Timer_EnableTopFloorGroundedHearing", 3, "OnTimer_EnableTopFloorGroundedHearing");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableTopFloorGroundedHearing(const tString &in asTimer)
		{
			Wraith_SetHearing("Wraith_TopFloorGrounded", true);	
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_DisengageTopFloor(const tString &in asParent, const tString &in asChild, int alState)
		{
			iLuxEntity@ pTrigger = Map_GetEntity(asParent);
			if (alState == 1)
			{
				pTrigger.SetVarVector3f("PlayerPos", Player_GetPosition());
			}
			else
			{
				cVector3f vOldPos = pTrigger.GetVarVector3f("PlayerPos");
				cVector3f vDir = Player_GetPosition() - vOldPos;
				vDir.Normalize();
				float fDot = cMath_Vector3Dot(vDir, pTrigger.GetMatrix().GetTranspose().GetForward());
				if (fDot > 0)
				{
					cLux_AddDebugMessage("[Map] Disengage top floor");
					Wraith_SetHearing("Wraith_TopFloorGrounded", false);
					FearHandler_SetPermaFailRespawnArea("PermaFail_TopFloor_2");
				}
				else
				{
					cLux_AddDebugMessage("[Map] Engage top floor");
					Wraith_SetHearing("Wraith_TopFloorGrounded", true);
				}
			}
			return true;
		}
		
		//-------------------------------------------------------

		//} END Event B *Avoid the FLYING WRAITH on the top floor*
		
		/////////////////////////////////////////
		// Event B *Look at at the wraiths on the middle floor before descending*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool OnCollide_PrepareMiddleFloorEncounterVista(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("[Map] Prepare middle floor encounter vista");
			
			Wraith_CommandDash_Execute("Wraith_TopFloor", Map_GetEntity("Target_WraithDisappear_TopFloor_1").GetPosition(), true, true, true);
			
			// Set up flying wraith on middle floor
			Entity_SetActive("Wraith_Balcony", true);
			Wraith_SetFly("Wraith_Balcony", true);
			Agent_SetSensesActive("Wraith_Balcony", false);
			
			SetBalconyWraithDefault();
			return false;
		}
		
		//-------------------------------------------------------

		//} END Event B *Look at at the wraiths on the middle floor before descending*
		
		/////////////////////////////////////////
		// Event C *Sneak past the FLYING WRAITH between the top and middle floors*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		void SetBalconyWraithDefault()
		{
			Wraith_ModeFlyPatrol_SetPlayerGoalDirection("Wraith_Balcony", "Target_GoalDirection_MiddleFloor_1");
			Wraith_ModeFlyPatrol_ClearNodes("Wraith_Balcony");
			Wraith_ModeFlyPatrol_AddNodeRange("Wraith_Balcony", "Target_FlyingWraithNode_MiddleFloor*", 43, 46);
			Wraith_ModeFlyPatrol_AddNodeRange("Wraith_Balcony", "Target_FlyingWraithNode_MiddleFloor*", 37, 40);
			Wraith_ModeFlyPatrol_AddNodeRange("Wraith_Balcony", "Target_FlyingWraithNode_MiddleFloor*", 49, 52);
			Wraith_ModeFlyPatrol_AddNodeRange("Wraith_Balcony", "Target_FlyingWraithNode_MiddleFloor*", 25, 28);
			Wraith_ModeFlyPatrol_SetUseRandomNodes("Wraith_Balcony", true);
			Wraith_ModeFlyPatrol_ClearLookAtFields("Wraith_Balcony");
			Wraith_ModeFlyPatrol_AddLookAtfield("Wraith_Balcony", "Target_FlyingWraithLookAtField_MiddleFloor_");
			Wraith_Mode_Set("Wraith_Balcony", eWraithMode_FlyPatrol, true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartSafeRoomEncounter(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_StartSafeRoomEncounter("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceStartSafeRoomEncounter;
		void Seq_StartSafeRoomEncounter(const tString &in asTimer)
		{
			Sequence_Begin("Seq_StartSafeRoomEncounter", mSequenceStartSafeRoomEncounter);
			if (Sequence_DoStepAndWait(0.2))
			{
				Wraith_CommandDash_Execute("Wraith_TopFloorGrounded", Map_GetEntity("Target_WraithDisappear_TopFloor_1").GetPosition(), true, true, true);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Wraith_CommandDash_Execute("Wraith_Balcony", Map_GetEntity("Target_SafeRoomEncounter_MoveTo_1").GetPosition(), true, false, true, "OnCommandEnd_ResumeSafeRoomEncounter");
				Sound_CreateAtEntity("WaterEncounterIntro", "creatures/vocalisations/creature/wraith/start_search", "Wraith_Balcony", 0, false, 1, 30, 80);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Agent_SetSensesActive("Wraith_Balcony", true);
				Wraith_SetSpotlightColor("Wraith_Balcony", "alert");
				Wraith_CommandLookAtPosition_Execute("Wraith_Balcony", Map_GetEntity("Target_SafeRoomEncounter_LookAt_1").GetPosition(), true, true, true, "OnCommandEnd_ResumeSafeRoomEncounter");
				Wraith_SetCallback_CalmedDown("Wraith_Balcony", "OnWraithCalmedDown_ResumeSafeRoomEncounter");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Agent_SetSensesActive("Wraith_Balcony", false);
				Wraith_CommandDash_Execute("Wraith_Balcony", Map_GetEntity("Target_SafeRoomEncounter_MoveTo_2").GetPosition(), false, true, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_ResumeSafeRoomEncounter(const tString &in asEntity)
		{
			SequenceStates_Resume("Seq_StartSafeRoomEncounter");
		}
		
		//-------------------------------------------------------
		
		void OnWraithCalmedDown_ResumeSafeRoomEncounter(const tString &in asEntity)
		{
			SequenceStates_Resume("Seq_StartSafeRoomEncounter");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_BalconyJump(const tString &in asParent, const tString &in asChild, int alState)
		{
			msLandDetectionState = "BalconyJump";
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event C *Sneak past the FLYING WRAITH between the top and middle floors*
		
	//} END SCENE 12
 
}