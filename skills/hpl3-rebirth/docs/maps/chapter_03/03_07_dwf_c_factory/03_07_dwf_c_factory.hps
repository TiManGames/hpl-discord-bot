	}
	
	//-------------------------------------------------------
	
	int mlWraithPermafailCount_TopFloor = 0;
	bool OnPermaFail(const tString &in asSource)
	{		
		FearHandler_ClearPermaFailScenes();
		SetupGenericPermaFail();
		
		if (mlPermaFailStage == eFactoryCPerfmaFailStage_TopFloor)
		{
			++mlWraithPermafailCount_TopFloor;
			Wraith_CommandDash_Execute("Wraith_TopFloor", Map_GetEntity("Target_WraithDisappear_TopFloor_1").GetPosition(), true, true, true);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	array<int> mvUnplayedGenericPermaFails = { 1, 2 };
	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 3; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);
			
		tString sAreaBase = "Area_PermaFail_Generic";		
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_3", sAreaBase + "_3_End_3", 4.f, 2.5);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_1", sAreaBase + "_1_End_1", 4.f, 2.5f);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 3.f, 3.0);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_2", sAreaBase + "_2_End_2", 5.f, 4.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_3", sAreaBase + "_2_End_3", 3.f, 2.5f);
				break;
		}
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFailRespawn()
	{
		if (mlPermaFailStage == eFactoryCPerfmaFailStage_TopFloor)
		{
			Wraith_CommandDash_Execute("Wraith_TopFloor", Map_GetEntity("Target_WraithDisappear_TopFloor_1").GetPosition(), true, true, true);
			if ((mlWraithPermafailCount_TopFloor <= 1 && mlWraithAttackCount_TopFloor >= 3) || mlWraithPermafailCount_TopFloor >= 2)
			{
				Wraith_CommandDash_Execute("Wraith_TopFloorGrounded", Map_GetEntity("Target_WraithDisappear_TopFloor_1").GetPosition(), true, true, true);
			}
		}
		return true;
	}

	//-------------------------------------------------------
	
	int mlWraithAttackCount_TopFloor = 0;
	void OnDamageTaken(const tString&in asSource, int alType)
	{
		if (alType == eDamageType_Silent)
		{
			if (mlPermaFailStage == eFactoryCPerfmaFailStage_TopFloor)
			{
				++mlWraithAttackCount_TopFloor;
			}
		}
	}
	
