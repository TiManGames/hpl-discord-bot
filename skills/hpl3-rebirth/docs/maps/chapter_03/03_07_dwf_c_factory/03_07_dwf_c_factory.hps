	void OnPlayerSubmerge()
	{
		array<iLuxEntity@> vPlants;
		Map_GetEntityArray("FloatingPlant*", vPlants);
		for (int i = 0; i < vPlants.size(); ++i)
		{
			iPhysicsBody@ pBody = vPlants[i].GetMainBody();
			pBody.SetCollideCharacter(false);
		}
	}
	
	//-------------------------------------------------------
	
	void OnPlayerEmerge()
	{
		array<iLuxEntity@> vPlants;
		Map_GetEntityArray("FloatingPlant*", vPlants);
		for (int i = 0; i < vPlants.size(); ++i)
		{
			iPhysicsBody@ pBody = vPlants[i].GetMainBody();
			pBody.SetCollideCharacter(true);
		}
	}
	
	//-------------------------------------------------------
	
	tString msLightSegment_Name;
	int mlLightSegment_CurrentIndex = 0;
	int mlLightSegment_FromIndex;
	int mlLightSegment_ToIndex;
	
	void TurnOnRailingLightSegment(const tString &in asSegmentName, int alFromIndex, int alToIndex)
	{
		msLightSegment_Name = asSegmentName;
		mlLightSegment_CurrentIndex = alFromIndex;
		mlLightSegment_FromIndex = alFromIndex;
		mlLightSegment_ToIndex = alToIndex;
		Map_AddTimer("Timer_TurnOnRailingLight", 0.0f, "OnTimer_TurnOnRailingLight");
	}
	
	void OnTimer_TurnOnRailingLight(const tString &in asTimer)
	{
		tString sLight = msLightSegment_Name + mlLightSegment_CurrentIndex;
		iLuxEntity@ pEnt = Map_GetEntity(sLight);
		if (pEnt !is null)
		{
			Lamp_SetLit(sLight, true, true);
			
			Sound_CreateAtEntity("LightOn_" + mlLightSegment_CurrentIndex, "03_07_dw_factory/spotlight/on", sLight);
//			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("LightOn_" + mlLightSegment_CurrentIndex);
//			pSound.SetCustomMaxDistance(100.0f);
//			pSound.SetCustomMinDistance(20.0f);
//			pSound.SetUseCustomProperties(true);
		}
		
		++mlLightSegment_CurrentIndex;
		if (mlLightSegment_CurrentIndex <= mlLightSegment_ToIndex) Map_AddTimer("Timer_TurnOnRailingLight", 0.4f, "OnTimer_TurnOnRailingLight");
	}
	
	//-------------------------------------------------------
	
	tString msElevatorLightSegment_Name;
	int mlElevatorLightSegment_CurrentIndex = 0;
	int mlElevatorLightSegment_FromIndex;
	int mlElevatorLightSegment_ToIndex;
	
	void TurnOnElevatorRailingLightSegment(const tString &in asSegmentName, int alFromIndex, int alToIndex)
	{
		msElevatorLightSegment_Name = asSegmentName;
		mlElevatorLightSegment_CurrentIndex = alFromIndex;
		mlElevatorLightSegment_FromIndex = alFromIndex;
		mlElevatorLightSegment_ToIndex = alToIndex;
		Map_AddTimer("Timer_TurnOnElevatorRailingLight", 0.0f, "OnTimer_TurnOnElevatorRailingLight");
	}
	
	void OnTimer_TurnOnElevatorRailingLight(const tString &in asTimer)
	{
		tString sLight1 = msElevatorLightSegment_Name + mlElevatorLightSegment_CurrentIndex + "_1";
		tString sLight2 = msElevatorLightSegment_Name + mlElevatorLightSegment_CurrentIndex + "_2";
		iLuxEntity@ pEnt1 = Map_GetEntity(sLight1);
		iLuxEntity@ pEnt2 = Map_GetEntity(sLight2);
		if (pEnt1 !is null && pEnt2 !is null)
		{
			Lamp_SetLit(sLight1, true, true);
			Lamp_SetLit(sLight2, true, true);
			
			Sound_CreateAtEntity("LightOn_" + mlLightSegment_CurrentIndex, "03_07_dw_factory/spotlight/on", sLight1);
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("LightOn_" + mlLightSegment_CurrentIndex);
			pSound.SetCustomMaxDistance(100.0f);
			pSound.SetCustomMinDistance(20.0f);
			pSound.SetUseCustomProperties(true);
		}
		
		++mlElevatorLightSegment_CurrentIndex;
		if (mlElevatorLightSegment_CurrentIndex <= mlElevatorLightSegment_ToIndex) Map_AddTimer("Timer_TurnOnElevatorRailingLight", 0.4f, "OnTimer_TurnOnElevatorRailingLight");
	}
	
