     //////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 2 *Head through the NEST ENTRANCE GATE*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 2 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 2 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Open the NEST ENTRANCE GATE*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event A here.*/
		 
		//bool mbOpenedEntranceGate = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event A here.*/
		 
		 void OnConnectionStateChange_EntranceGateWheel(const tString &in asEntity, int alState)
		 {
			 if (alState == 0) return;

			 OnTimer_DoGateShake("EntranceGateStrut_5");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_EntranceGateWheel(const tString &in asEntity)
		 {
			 Wheel_SetAutoRotateMul("EntranceGateWheel", 3.f);
			 
			 Map_RemoveTimer("Timer_CloseEntranceGate");
			 Map_AddTimer("Timer_UpdateEntranceGateWheel", 0.1f, "OnTimer_UpdateEntranceGateWheel");
		 }
		 
		 //-------------------------------------------------------
		 
		 float mfPrevEntranceWheelAngle = 0.f;
		 void OnTimer_UpdateEntranceGateWheel(const tString &in asTimer)
		 {
			 // TODO: Do this properly!
			 float fAngle = Wheel_GetCurrentAngle("EntranceGateWheel");
			 float fDiff = cMath_Abs(cMath_GetAngleDistanceDeg(fAngle, mfPrevEntranceWheelAngle));
			 mfPrevEntranceWheelAngle = fAngle;
			 Sound_Fade("Sound_EntranceGateMove", fDiff > 0.1f ? 1.f : 0.f, 0.1f);
			 
			 if (Entity_IsInteractedWith("EntranceGateWheel") == false)
			 {				 
				 Map_AddTimer("Timer_CloseEntranceGate", 15.f, "OnTimer_CloseEntranceGate");
				 
				 ////////////////////////////
				 // Snap to angle locks (unless fully open)
				 float fAngle = Wheel_GetCurrentAngle("EntranceGateWheel");
				 if (fAngle >= 358.f) return;
				 
				 for (int i = 0; i <= 360; i += 45)
				 {
					 if (fAngle > i) continue;
					 
					 float fTar = fAngle < 346 ? cMath_ToRad(i - 45) : cMath_ToRad(348.f);
					 Wheel_SetAngle("EntranceGateWheel", fTar, true);
					 
					 Wheel_SetAutoRotateMul("EntranceGateWheel", 5.f);
					 
					 if (fAngle < 1.f || fAngle > 347.f || cMath_Abs(fAngle - cMath_ToDeg(fTar)) < 1.f)
					 {
						 Sound_Fade("Sound_EntranceGateMove", 0.f, 0.1f);
						 break;
					 }						
					 
					 Map_AddTimer("EntranceGateStrut_5", 0.4f, "OnTimer_DoGateShake");
					 
					 Sound_Fade("Sound_EntranceGateMove", 1.f, 0.1f);
					 Map_AddTimer("Timer_StopEntranceGateSound", 0.4f, "OnTimer_StopEntranceGateSound");
					 break;
				 }				 
				 return;
			 }
			 
			 Map_AddTimer("Timer_UpdateEntranceGateWheel", 0.1f, "OnTimer_UpdateEntranceGateWheel");
		 }

		 //-------------------------------------------------------
		 
		 void OnTimer_CloseEntranceGate(const tString &in asTimer)
		 {
			 Wheel_SetAutoRotateMul("EntranceGateWheel", 5.f);
			 Wheel_SetAngle("EntranceGateWheel", 0.f, true);
			 
			 Sound_Fade("Sound_EntranceGateMove", 1.f, 0.1f);
			 Map_AddTimer("Timer_StopEntranceGateSound", 1.f, "OnTimer_StopEntranceGateSound");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StopEntranceGateSound(const tString &in asTimer)
		 {
			 Sound_Stop("Sound_EntranceGateMove", 0.1f);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *Head through the blocker and exit the Nest Entrance*
		 
		 /////////////////////////////////////////
		 // Event C *Build a ghoul shrine (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event C here.*/
		 	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event C here.*/
		 
		 bool OnPermaFail_NestEntrance(const tString &in asSource)
		 {
			 SetupGenericPermaFail();
			 Entity_SetActive("Ghoul_Blocker_2", false);
			 FearHandler_SetPermaFailRespawnArea("Area_PermaFail_NestEntrance_*");
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *Build a ghoul shrine (PERMAFAIL)*
	 
	 //} END SCENE 2
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 3 *ACCIDENTALLY WAKE UP A SLEEPING GHOUL AND FIND A WAY OUT OF THE NEST SLEEPING HALL*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 3 here.*/
		
		int mlSleepingHallGhoulHitCount = 0;
		bool mbSleepingHallEncounterOver = false;
        bool mbSleepingHallGhoulsGone = false;
        tString msSleepingHallGhoul = "Ghoul_SleepingHall";
        tString msSleeperSleepingHallGhoul = "Sleeper_SleepingHall_1";
        tString msSleepingHallFightGhoul = "Ghoul_SleepingHallFight";
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 3 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Encounter the SLEEPING GHOULs*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event A here.*/
		 
		 int mlSleepingHallHoleBlockCount = 0;
		 int mlTHGuideMoveTarget = 0;
		 int mlTHGuideMoveTargetLimit = 2;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event A here.*/
		 
		 bool OnTrigger_Player_ActivateSleepingHallSleeperSenses(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 SleepingGhoul_SetSensesActive("Sleeper_SleepingHall_" + cString_GetNumericSuffixInt(asParent), true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnThreatActivate_SleeperSleepingHall(const tString &in asEntity)
		 {
			 if (Entity_GetVarBool(asEntity, "HasBeenSpotted")) return;
			 Entity_SetVarBool(asEntity, "HasBeenSpotted", true);
			 
			 SleepingGhoul_ForceReact(asEntity, 0.f, 0.f);
			 FearThreat_SetComponentFearActive(asEntity, false);
			 		 
			 Map_AddTimer(asEntity, 0.4f, "OnTimer_ActivateSleeperFearThreat");			 
			 Map_AddTimer("Timer_PlayFirstSleeperDialogue", 4.f, "OnTimer_PlayFirstSleeperDialogue");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ActivateSleeperFearThreat(const tString &in asTimer)
		 {
			 FearThreat_SetComponentFearActive(asTimer, true);
			 SleepingGhoul_SetSensesActive(asTimer, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayFirstSleeperDialogue(const tString &in asTimer)
		 {
			 if (Blackboard_GetAgentCount() > 0 || SleepingGhoul_IsAwake("Sleeper_SleepingHall_2"))
				 return;
				 
			if (Map_GetEntity("Sleeper_SleepingHall_2").CheckIsOnScreen(true) == false ||
				Entity_GetDeltaToEntity("player", "Sleeper_SleepingHall_2").SqrLength() > 15.f * 15.f ||
				Entity_PlayerIsInFront("Area_SleepingBark"))
			 {
				 Map_AddTimer("Timer_PlayFirstSleeperDialogue", 0.4f, "OnTimer_PlayFirstSleeperDialogue");
				 return;
			 }
			 
			 Voice_StopAll();
			 Voice_Play("Dialogue_FirstSleepingGhoul");
			 
			 mbSleepDialoguePlayed = true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_BlockSleepingHallHole(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mlSleepingHallHoleBlockCount += alState;
			 Entity_SetActive("FearThreat_SleepingHallHole_1", mlSleepingHallHoleBlockCount < 2);
			 return true;
		 }
	
		//-------------------------------------------------------	 
		 
		 bool OnTrigger_BreakPottery(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Entity_GetCollide(asParent, "pottery_basic_small_grab_1"))
			 {
				 Prop_SetHealth("pottery_basic_small_grab_1", 0.f);
				 Entity_SetActive(asParent, false);
				 return false;
			 }
			 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnBreak_SleepingHallCanister(const tString &in asEntity)
		 {
			 if (SleepingGhoul_IsAwake("Sleeper_SleepingHall_2") == false)
				 SleepingGhoul_ForceReact("Sleeper_SleepingHall_2", 1.5f, 1.5f, "stir_strong");
			 
			 SleepingGhoul_SetSensesActive("Sleeper_SleepingHall_2", true);
			 Sound_CreateAIEventAtEntity(asEntity, 15.f, 5);
			 
			 FearHandler_SetForcedAddFearRate(0.2f, 2.f, true, -1.f, 0.05f);
		 }
		
		 //-------------------------------------------------------

		 bool Trigger_MusicPlay(const tString &in asParent, const tString &in asChild, int alState)
		 {
			Music_PlayExt("A2_3_6_SleepingHallSneak.ogg", true, 0.2f, 1.0f, 3.0f, 0.0f, eMusicPrio_SceneAmb, true);
			return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_StartSeqTHGuide(const tString &in asEntity, int alState)
		 {
			 if (alState == -1 || 
				 Blackboard_GetAgentCount() > 0 ||
				 Entity_GetDeltaToEntity(asEntity, "player").Length() < 2.f) 
				 return;
				 
			 mlTHGuideMoveTargetLimit = Entity_GetVarInt(asEntity, "");
			 
			 //if (mlTHGuideMoveTargetLimit == 5)
			 //	 Map_AddTimer("Timer_PlayThankTinHinanDialogue", 2.f, "OnTimer_PlayThankTinHinanDialogue");
			 
			 Entity_SetActive(asEntity, false);			 
			 
			 Sound_CreateAtEntity("Sound_THMovement", "creatures/foley/creature/tin_hinan/body_sound", "TH_Guide");
			 
			 if (Map_GetEntity("TH_Guide").GetEffectsActive() == false)
				Sound_CreateAtEntity("Sound_THAppear", "creatures/foley/creature/tin_hinan/appear", "TH_Guide");
				
			 Entity_SetEffectsActive("TH_Guide", true, true);
			 
			 Map_AddTimer("Timer_ThGuideMove", mlTHGuideMoveTargetLimit == 2 ? 0.3f : 0.75f, "OnTimer_ThGuideMove");
			 
			 Map_RemoveTimer("Timer_PlayFirstSleeperDialogue");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ThGuideMove(const tString &in asTimer)
		 {
			 OnMoveLinear_THGuide("TH_Guide");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnMoveLinear_THGuide(const tString &in asPropName)
		 {
			 mlTHGuideMoveTarget++;
			 tString sArea = "Area_GuideTarget_" + mlTHGuideMoveTarget;
			 
			 if (mlTHGuideMoveTarget > mlTHGuideMoveTargetLimit)
			 {
				 Sound_Stop("Sound_THMovement", 1.f);
				 Entity_SetActive("Trigger_StartSeqTHGuide_2", true);
				 return;
			 }
				 
			 if (Entity_Exists(sArea) == false)
			 {
				 Entity_SetEffectsActive("TH_Guide", false, true);
				 
				 Sound_Stop("Sound_THMovement", 1.f);
				 Sound_CreateAtEntity("Sound_THDisappear", "creatures/foley/creature/tin_hinan/disappear", "TH_Guide");
				 return;
			 }
			 
			 Prop_MoveLinearTo("TH_Guide", sArea, 2.f, 4.f, 0.f, false, "OnMoveLinear_THGuide");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayThankTinHinanDialogue(const tString &in asTimer)
		 {
			 if (Blackboard_GetAgentCount() == 0 && mbSleepingHallGhoulWokenUp == false)
				 Voice_Play("Dialogue_ThankTinHinan");
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Encounter the SLEEPING GHOULs*
		 
		 /////////////////////////////////////////
		 // Event B *The SLEEPING GHOULs wake up*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event B here.*/
         
         void OnTimer_WakeUpSleepingHallGhoul(const tString &in asTimer)
         {
             if (mbSleepingHallEncounterOver || 
				 Entity_IsActive(msSleeperSleepingHallGhoul) == false ||
				 SleepingGhoul_IsAwake(msSleeperSleepingHallGhoul)) 
				 return;
				 
			 SleepingGhoul_ForceWakeUp(msSleeperSleepingHallGhoul);
         }
         
         //-------------------------------------------------------
		 
		 void OnWakeUp_SleepingHallSleeper(const tString &in asEntity)
		 {
			 Ghoul_ModePatrol_ClearNodes(asEntity);
			 Ghoul_ModePatrol_AddNode(asEntity, "PathNodeArea_326", 3.f, 5.f); // First room
			 Ghoul_ModePatrol_AddNode(asEntity, "PathNodeArea_839", 3.f, 5.f); // Fight room
			 Ghoul_ModePatrol_AddNode(asEntity, "PathNodeArea_127", 3.f, 5.f); // Middle room
			 Ghoul_ModePatrol_AddNode(asEntity, "PathNodeArea_967", 3.f, 5.f); // End room
			 Ghoul_ModePatrol_Setup(asEntity, true, eGhoulSpeed_FastWalk);
			 Ghoul_Mode_Set(asEntity, eGhoulMode_Patrol, false);
			 
			 Ghoul_CommandSmell_Execute(asEntity, true);
			 
			 Map_AddTimer(asEntity, 10.f, "OnTimer_AlertSleepingHallSleeperLeave");
			 Map_RemoveTimer("Timer_PlayFirstSleeperDialogue");
			 
			 Hint_ShowHint_Hold("Hints", "HintHideMode", true);
			 
			 if (Entity_GetEffectsActive("TH_Guide"))
			 {
				 Entity_SetEffectsActive("TH_Guide", false, true);
				 Sound_Stop("Sound_THMovement", 1.f);
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_AlertSleepingHallSleeperLeave(const tString &in asTimer)
		 {
			Ghoul_CommandGoToHole_Execute(asTimer, Map_GetEntity(asTimer).GetPosition(), false, false, true, true, eGhoulSpeed_FastWalk);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *The SLEEPING GHOULs wake up*
		 
		 /////////////////////////////////////////
		 // Event C *Encounter the HATCH SLEEPERS*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event C here.*/
		 
		 bool mbEnteredHatchScareArea = false;
		 bool mbTriggeredHatchScare = false;
		 array<tString> mvHatchGhouls = { "Sleeper_Hatch_1", "Sleeper_Hatch_2", "Sleeper_Hatch_3" };
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event C here.*/
		 
		 bool OnTrigger_Player_EnterHatchScareArea(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mbEnteredHatchScareArea = true;
			 
			 if (alState == -1)
			 {
				 if (Entity_PlayerIsInFront(asParent))
					 Entity_SetActive("FearThreat_SleepingHallHole_1", false);
				 else
					 Entity_SetActive("FearThreat_SleepingHallHole_1", mlSleepingHallHoleBlockCount < 2);
			 }
			 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_SleepingHallDoor_2_Close(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Entity_IsActive("Sleeper_Hatch_1") == false && alState == -1 && mbTriggeredHatchScare == false)
			 {
				 Entity_SetActive("Sleeper_Hatch_*", true);
				 Entity_SetActive("Trigger_SleepingHallHatchScare", true);
			 }
				 
			 SleepingGhoul_SetSensesActive("Sleeper_Hatch_*", alState == -1);
			 return true;
		 } 
		 
		 //-------------------------------------------------------

		 void OnLookAt_SleepingHallHatchScare(const tString &in asEntity, int alState)
		 {
			 if (mbTriggeredHatchScare) return;
			 mbTriggeredHatchScare = true;
			 
			 SleepingGhoul_ForceReact("Sleeper_Hatch_1", 0.5f, 0.5f);
			 SleepingGhoul_ForceReact("Sleeper_Hatch_2", 1.2f, 1.2f);
			 SleepingGhoul_ForceReact("Sleeper_Hatch_3", 0.8f, 0.8f);
			 
			 Music_Play("A2_3_6_SleepingHallGhoulGroup.ogg", 1.0f, false, eMusicPrio_BigEvent);
			 
			 FearHandler_SetForcedAddFearRate(0.2f, 5.f, true, -1.f, 0.05f, 0.2f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnWakeUp_SleeperHatch(const tString &in asEntity)
		 {
			 if (cString_Sub(asEntity, 0, 7) == "Sleeper" && SleepingGhoul_GetType(asEntity) == "Screamer")
			 {
				 SleepingGhoul_ForceWakeUp(mvHatchGhouls[0]);
				 return;
			 }
			 
			 ////////////////////////////////
			 // Set up behaviour			 
			 Ghoul_ModePatrol_AddNode(asEntity, "PathNode_118", 6.f, 6.f);
			 Ghoul_ModePatrol_Setup(asEntity, false, eGhoulSpeed_FastWalk);
			 Ghoul_Mode_Set(asEntity, eGhoulMode_Patrol, true);		 
			 
			 Map_RemoveTimer("Timer_PlayFirstSleeperDialogue");
			 Map_AddTimer(asEntity, 10.f, "OnTimer_HatchGhoulLeave");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_HatchGhoulLeave(const tString &in asTimer)
		 {
			Ghoul_CommandGoToSpecificHole_Execute(asTimer, "HatchHole_1", false, false, true, eGhoulSpeed_Walk, "OnEnterHole_HatchGhoul");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnEnterHole_HatchGhoul(const tString &in asEntity)
		 {
			 mvHatchGhouls.pop_front();
			 if (mvHatchGhouls.size() == 0) return;
			 SleepingGhoul_ChangeToAlert(mvHatchGhouls[0]);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *Encounter the HATCH SLEEPERS*
		 
		 /////////////////////////////////////////
		 // Event D *Collapse the fake exit tunnel*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event D here.*/
		 
		  bool mbSleepingHallDoorClosed = false;
		  bool mbSleepingHallGhoulWokenUp = false;
		 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event D here.*/
		 
		 bool OnTrigger_SleepingHallDoor_Close(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mbSleepingHallDoorClosed = alState == 1;			 
			 SleepingGhoul_SetSensesActive(msSleeperSleepingHallGhoul, mbSleepingHallDoorClosed == false);
			 return true;
		 }
		 
		//-------------------------------------------------------		 
		 
		 void OnTear_TunnelBrace(const tString &in asEntity)
		 {
			 Prop_SetHealth(asEntity, 0.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnBreak_TunnelBrace(const tString &in asEntity)
		 {			 
			 if (Entity_PlayerIsInFront("Area_TunnelBraceTear") == false)
				 return;
			 
			 Entity_SetActive("TunnelDebris_2_*", true);
			 Entity_SetActive("TunnelBlocker_*", true);
			 
			 ParticleSystem_SetActive("PS_TunnelDebris_*", true);	 
			 ParticleSystem_SetActive("PS_TunnelSmoke_1", true);
			 
			 Billboard_SetVisible("Billboard_Tunnel", false);
			 Light_SetVisible("Light_Tunnel_*", false);
			 
			 int lShakeId = Effect_Shake_Start(0.01f, 1.5f, 0.1f, 1.f);
			 Effect_Shake_SetSourceEntity(lShakeId, "TunnelBlocker_2", 5.f, 15.f);
			 
			 Sound_CreateAtEntity("Sound_TunnelCollapse", "03_06_ghouls_nest/events/sleeping_hall_hole_collapse", asEntity);
			 
			 Map_GetEntity(asEntity + "_broken").GetBodyFromName("Body_2").SetMass(0.f);
			 Map_GetEntity(asEntity + "_broken").GetMeshEntity().GetSubMeshEntityName("damaged_bottom").SetVisible(false);
			 Map_AddTimer("Timer_CollapseSleepingHallTunnel", 0.5f, "OnTimer_CollapseSleepingHallTunnel");	
		 } 
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_CollapseSleepingHallTunnel(const tString &in asTimer)
		 {			 
			 Entity_SetActive("TunnelBlockBox_*", true);			 
			 Map_AddTimer("Timer_WakeUpSleepingHallGhoul", 1.5f, "OnTimer_WakeUpSleepingHallGhoul");	
		 }
		 
         //-------------------------------------------------------
         
         void OnWakeUp_SleepingHallGhoul(const tString &in asEntity)
         {
			 mbSleepingHallGhoulWokenUp = true;
			 
			 Entity_SetActive("SleepingHallExitBlocker", false);			 
			 SleepingGhoul_Reset("Sleeper_SleepingHall_2");			 
			 	
			 Agent_SetSensesActive(msSleepingHallGhoul, true);
			 Ghoul_SetSmellingActive(msSleepingHallGhoul, false);
			 
			 SetupSleepingHallGhoulPatrol();
			 
			 Hint_ShowHint_Hold("Hints", "HintHideMode", true);
			 
			 Map_RemoveTimer("Timer_PlayFirstSleeperDialogue");
			 Map_AddTimer("Timer_PlaySniffPromptDialogue", 0.5f, "OnTimer_PlaySniffPromptDialogue");
			 
			 if (Entity_GetEffectsActive("TH_Guide"))
			 {
				 Entity_SetEffectsActive("TH_Guide", false, true);
				 Sound_Stop("Sound_THMovement", 1.f);
			 }
         }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlaySniffPromptDialogue(const tString &in asTimer)
		 {
			 if (Ghoul_IsAggressive(msSleepingHallGhoul) || Agent_PlayerDetected(msSleepingHallGhoul)) 
				 return;
				 
			 Voice_Play("Dialogue_SniffPrompt");
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetupSleepingHallGhoulPatrol()
		 {			 
			 Ghoul_ModePatrol_ClearNodes(msSleepingHallGhoul);
			 Ghoul_ModePatrol_AddNode(msSleepingHallGhoul, "PathNodeArea_550", 2.f, 4.f); // Middle room
             Ghoul_ModePatrol_AddNode(msSleepingHallGhoul, "PathNodeArea_1208", 1.f, 2.f); // Middle room
             Ghoul_ModePatrol_AddNode(msSleepingHallGhoul, "PathNodeArea_858", 2.f, 4.f); // Fight room
             Ghoul_ModePatrol_AddNode(msSleepingHallGhoul, "PathNodeArea_839", 2.f, 4.f); // Fight room
             Ghoul_ModePatrol_AddNode(msSleepingHallGhoul, "PathNodeArea_180", 2.f, 4.f); // First room
             Ghoul_ModePatrol_AddNode(msSleepingHallGhoul, "PathNodeArea_185", 1.f, 2.f); // First room
			 Ghoul_ModePatrol_Setup(msSleepingHallGhoul, true, eGhoulSpeed_FastWalk);
			 Ghoul_Mode_Set(msSleepingHallGhoul, eGhoulMode_Patrol, true);
			 
             Map_AddTimer("Timer_SleepingHallGhoulLeave", 60.f, "OnTimer_SleepingHallGhoulLeave");
		 }
         
		 //-------------------------------------------------------
		 
		 bool OnTrigger_SleepingHallGhoulSmell(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Ghoul_SetSmellingActive(msSleepingHallGhoul, true);
			 Ghoul_CommandSmell_Execute(msSleepingHallGhoul);
			 return false;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event D *Collapse the fake exit tunnel*
		 
