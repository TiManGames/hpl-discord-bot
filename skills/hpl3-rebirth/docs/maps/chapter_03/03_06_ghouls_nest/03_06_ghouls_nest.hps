	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("03-06-ghouls-nest");
		
		// Set up color grading etc.
		
		Pregnancy_SetStage(ePregStage_Stage2);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_TTH_AfterName);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(true);
		Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_Initial");
		FearHandler_SetWhisperStage(eFearWhisperStage_MilkingToDWFA);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(1);
		StruggleFlashHandler_SetProgression(1);
		
		Player_SetAutoTeleportWhenBelowAltitude(-50.f);
	}
	
