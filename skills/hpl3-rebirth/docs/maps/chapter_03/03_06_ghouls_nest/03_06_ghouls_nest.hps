		 bool OnPermaFail_ChaseCell(const tString &in asSource)
		 {
			 Music_StopAll(3.f);
			 Sound_Stop("GhoulAwaken", 1.f);
			 
			 Entity_SetActive("Ghoul_EndChase_*", false);
			 Entity_SetActive("Trigger_ActivateChaseCellGhoul", true);
			 Entity_SetActive("Trigger_PlayChaseCellGrowl", true);
			 Entity_SetActive("EndChaseLock_1", false);
			 
			 Prop_SetHealth("CellDoor", 0.2f);
			 
			 SwingDoor_SetOpenAmount("LivingQuartersDoor_7", 0.f);
			 SwingDoor_SetBlocked("LivingQuartersDoor_7", true, false);
			 
			 Lamp_SetLit("lamp_spire_29", false, false);
			 Light_SetBrightness("Light_CellDeathScenario", 1.f);
			 
			 SetupGenericPermaFail();
			 
			 msEndChasePermaFailArea = "PermaFail_CommonRoom";
			 FearHandler_SetPermaFailRespawnArea("PermaFail_ChaseCell");
			 return true;
		 }
		 
