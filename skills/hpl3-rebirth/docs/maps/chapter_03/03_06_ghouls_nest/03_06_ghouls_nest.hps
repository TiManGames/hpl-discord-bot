		 /////////////////////////////////////////
		 // Event C *Wake up in the Temple (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event C here.*/
		 		 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event C here.*/
		 
		 bool OnPermaFail_Temple(const tString &in asSource)
		 {
			 mlPermaFailStage = eGhoulsNestPermaFailStage_TempleSecond;
			 
			 if (Entity_GetDeltaToEntity("Ghoul_Overlap_1", "MoveTarArea_LargeOverlap_1").SqrLength() > 2.f * 2.f)	
				 Agent_TeleportFeetToEntity("Ghoul_Overlap_1", "RetreatArea_TempleGhoul", true);
			 
			 SetupGenericPermaFail();
			 FearHandler_SetPermaFailRespawnArea("PermaFail_Temple");		 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnPermaFail_TempleSecond(const tString &in asSource)
		 {
			 Entity_SetActive("Ghoul_Overlap_*", false);
			 Entity_SetActive("Sleeper_Temple_*", false);
			 
			 Sound_Stop("Sound_GhoulWorship_*", 0.f);
			
			SetupGenericPermaFail();
			FearHandler_SetPermaFailRespawnArea("PermaFail_TempleSecond");
			return true;
		 }
		 
