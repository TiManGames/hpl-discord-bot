         bool OnTrigger_BreakCourtyardGate(const tString &in asParent, const tString &in asChild, int alState)  
         {			 
			 msEndChasePermaFailArea = "PermaFail_ChaseTunnel";
			 
			 ////////////////////////
			 // Break the gate!			 
             Entity_SetActive("Ghoul_EndChase_8", true);
			 Map_GetEntity("Ghoul_EndChase_8").GetMeshEntity().SetUpdateBonesWhenCulled(true);
			 
			 Agent_PlayCutsceneAnimation("Ghoul_EndChase_8", "smash_courtyard_gate", 0.f, false, "OnAnimEnd_CourtyardGateSmash");
			 Entity_PlayAnimation("CourtyardGate", "courtyard_gate_smash", 0.f);	 
			 
             Sound_CreateAtEntity("CourtyardGateSmash", "03_06_ghouls_nest/chase_sequence/roman_door_open", "CourtyardGate");
             Sound_CreateAtEntity("CourtyardGhoulSwarm", "03_06_ghouls_nest/chase_sequence/ghoul_chase_roman_door_swarm", "CourtyardGate");
			 Sound_CreateAtEntity("CourtyardGhoulSwarm", "03_06_ghouls_nest/chase_sequence/ghoul_chase_roman_door_growl", "CourtyardGate");
			 
			 FearHandler_SetForcedAddFearRate(0.35f, 2.f, true);
			 
			 Music_PlayExt("A2_NPC_GhoulNestChase", true, 1.0f, 1, 3.0f, 0, eMusicPrio_OverrideAll, true);

			 ParticleSystem_CreateAtEntity("PS_CourtyardGateBreak", "smoke_oneshot_grate_break.ps", "Area_CourtyardGatePS", false);
			 ParticleSystem_CreateAtEntity("PS_CourtyardGateDust", "dust_impact_med_oneshot.ps", "Area_CourtyardGatePS", false).SetColor(cColor(0.756,0.668,0.579,0.2));
			 
			 PlayChaseRunEmote(4, 0.6f);
			 
			 ////////////////////////
			 // Activate backtrack ghoul behind player if no other ghoul there!
			 if (Blackboard_GetAgentCount() > 0) 
				 return false;
				 
			 Entity_SetActive("Trigger_ActivateBacktrackGhoul_2", false);
			 SetEndChaseGhoulChaseReady("Ghoul_EndChase_13");
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_CourtyardGateSmash(const tString &in asAgent, const tString &in asAnim)
		 {	 
			 cLux_ToAgent(Map_GetEntity(asAgent)).GetCharBody().SetYaw(0.f);
			 
			 Agent_SetSensesActive("Ghoul_EndChase_8", true);
			 Agent_RevealPlayerPosition("Ghoul_EndChase_8");
			 
			 Map_AddTimer("Ghoul_EndChase_8", 1.f, "OnTimer_SetEndChaseGhoulReady");
		 }
         
         //-------------------------------------------------------

         bool OnTrigger_ActivateBacktrackGhoul(const tString &in asParent, const tString &in asChild, int alState)
         {
             if (alState == -1) return true;
             
             tString sGhoul = "";
             for (int i = 1; i <= mlEndChaseGhoulCount; i++)
             {
                 sGhoul = "Ghoul_EndChase_" + i;
                 if (Entity_IsActive(sGhoul) && Entity_EntityIsInFront(sGhoul, asParent) ||
					 Blackboard_GetAgentCount() == 0) 
					 return true;
             }
             
             sGhoul = Entity_GetVarString(asParent, "");
             SetEndChaseGhoulChaseReady(sGhoul);

             Entity_SetActive(asParent, false);
             return true;
         }
         
         //-------------------------------------------------------
         
		 bool OnTrigger_ActivateFakeExitEndChaseGhouls(const tString &in asParent, const tString &in asChild, int alState)
		 {
             if (alState == -1) return true;
             
             Entity_SetActive(asParent, false);
			 
			 int lId = cString_GetNumericSuffixInt(asParent);
             if (lId == 1)
             {
                 SetEndChaseGhoulChaseReady("Ghoul_EndChase_5");  
				 Sound_CreateAtEntity("LightGhoulEmerge", "03_06_ghouls_nest/chase_sequence/ghoul_chase_light_emerge", "audio_LightEmergeGhoul");
				 
				 if (Blackboard_GetAgentCount() > 2)
					 DeactivateFarthestEndChaseGhoul(5);
			 }
			 return false;
		 }
		 
