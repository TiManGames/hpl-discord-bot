         {
             mbSleepingHallEncounterOver = true;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnPlayerEnterHide()
		 {
			 if (mbSleepingHallEncounterOver || Entity_IsActive(msSleepingHallGhoul) == false)
				 return;
				
			 Map_AddTimer("Timer_PlayHidePromptDialogue", 1.5f, "OnTimer_PlayHidePromptDialogue");
		 }
		
		 //-------------------------------------------------------
		
		 void OnTimer_PlayHidePromptDialogue(const tString &in asTimer)
		 {
			 if (Ghoul_IsAggressive(msSleepingHallGhoul) || Agent_PlayerDetected(msSleepingHallGhoul))
				 return;
				
			 if (Map_TimeHasPassed("Timer_HidePromptDialogue", 10.f))
				 Voice_Play("Dialogue_HideBarks");
		 }
         
         //-------------------------------------------------------
	 
