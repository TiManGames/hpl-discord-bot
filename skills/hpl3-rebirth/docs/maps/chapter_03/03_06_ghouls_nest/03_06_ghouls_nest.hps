	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/

	int mlPermaFailStage = eGhoulsNestPermaFailStage_Entrance;
	int mlCurrPermaFailScene = 0;
	bool mbFairchildPermaFailDone = false;
	bool mbSleepDialoguePlayed = false;
	
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	bool OnTrigger_GateStrutSpikes(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1) return true;
		
		if (Wheel_IsAutoMoving("ExitGateWheelBase") == false && 
			Wheel_IsAutoMoving("EntranceGateWheel") == false &&
			Player_GetSpeed() < 2.f)
			return true;
		
		if (Map_TimeHasPassed("Timer_GateStrutDamage", 1.f))
		{
			Player_GiveDamage(0.2f, 0.35f, eDamageType_Default, asChild);
			Player_AddBodyForceAwayFromEntity(asChild, 20000.f, true);
		}	
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DoGateShake(const tString &in asTimer)
	{
		float fVol = Map_TimerExists("Timer_UpdateExitGateBanging") ? 0.5f : 1.f;
		Sound_CreateAtEntity("Sound_GateStop", "03_06_ghouls_nest/nest_gate/gate_arm_stop", asTimer, 0.f, false, fVol);
		
		int lShakeID = Effect_Shake_Start(fVol > 0.5f ? 0.004f : 0.002f, cMath_RandRectf(0.3f, 0.4f), 0.2f, 0.2f);
		Effect_Shake_SetSourceEntity(lShakeID, asTimer, 2.f, 30.f, eEasing_Linear);
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SetWhispering(const tString &in asParent, const tString &in asChild, int alState)
	{
		Pregnancy_SetWhispering(alState == -1 && Entity_PlayerIsInFront(asParent));
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_ShadowFlesh(const tString &in asParent, const tString &in asChild, int alState)
    {
        if (alState == -1) return true;
        if (Map_TimeHasPassed("Timer_ShadowFleshDamage", 1.f) == false) return true;
        
        Player_GiveDamage(0.1f, 0.2f, eDamageType_Guardian, asParent);
        return cMath_RandRectl(0, 1) == 1;
    }
	
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
    
     //////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 1 *EXAMINE THE ROMAN BATHHOUSE AND WALK THROUGH THE BATHHOUSE CORRIDOR*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 1 here.*/
        
        tString msBlockerGhoul = "Ghoul_Blocker_2";
        
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 1 here.*/
        
        void SetupBlockerGhoul()
        {			
			Entity_SetActive("FearRate_BlockerGhoulSound_2", true);
            
			// Disappear if player has already seen it
			if (cScript_GetGlobalVarBool("TTH_EncounteredBlockerGhoul"))
			{
				Entity_SetActive("Ghoul_Blocker_2", false);
				Entity_SetActive("Trigger_BlockerGhoulLeave", false);
				Entity_SetActive("bedouin_corpse_2", false);
				Sound_Stop("Sound_GhoulCorpseDismember_2", 0.f);
				Entity_SetActive("FearRate_BlockerGhoulSound_2", false);
				Entity_SetActive("Sound_BlockerGhoulMusic_1", false);
				return;   
            }      
             
            /////////////////////////////
            // Prepare blocker ghoul
            Entity_SetActive(msBlockerGhoul, true);
			Pathfinder_Stop(msBlockerGhoul);
			Pathfinder_Track_Stop(msBlockerGhoul);
			Agent_SetSensesActive(msBlockerGhoul, true);			
			
			Ghoul_ModeGuard_Setup(msBlockerGhoul, "BlockerGhoulLookAtArea_2", "BlockerGhoulEatArea_2", "eat_ground", "Sound_GhoulCorpseDismember_2", "eat_ground_react_to_sound");
			Ghoul_Mode_Set(msBlockerGhoul, eGhoulMode_Guard, true);
        }
		
		//-------------------------------------------------------
		 
		 void OnTimer_SetupBlockerGhoul(const tString &in asTimer)
		 {
			 SetupBlockerGhoul();
		 }
		 
        //-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Hear unsettling sounds coming from the Bathhouse Corridor*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event A here.*/
	 
