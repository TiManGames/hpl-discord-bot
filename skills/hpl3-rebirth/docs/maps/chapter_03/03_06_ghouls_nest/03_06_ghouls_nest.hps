		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event B here.*/
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *Spot the BLOCKER GHOUL*
		 
		 /////////////////////////////////////////
		 // Event C *The BLOCKER GHOUL leaves*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event C here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event C here.*/
         
         bool OnTrigger_BlockerGhoulLeave(const tString &in asParent, const tString &in asChild, int alState)
         {
             if (alState == -1 || Entity_IsActive(msBlockerGhoul) == false) 
                 return true;
			 
			 cScript_SetGlobalVarBool("TTH_EncounteredBlockerGhoul", true);
			 Prop_SetStaticPhysics("bedouin_corpse_2", false);
			 Body_AddImpulse("bedouin_corpse_2_Body_1", cVector3f(-1.f, 0.f, 0.f), false);
			 
             Map_AddTimer("Timer_BlockerGhoulLeave", 3.f, "OnTimer_BlockerGhoulLeave");             
             return false;
         }
         
         //-------------------------------------------------------
         
         void OnTimer_BlockerGhoulLeave(const tString &in asTimer)
         {
			 Entity_SetActive("FearRate_BlockerGhoulSound_*", false);
			 Ghoul_CommandGoToSpecificHole_Execute(msBlockerGhoul, "BathhouseCorridorHole_1", true, false, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_BlockerGhoulChangeHole(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Ghoul_Command_Remove(msBlockerGhoul, true);
			 Ghoul_CommandGoToSpecificHole_Execute(msBlockerGhoul, "BathhouseCorridorHole_2", true, false, true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *The BLOCKER GHOUL LEAVES*
		 
