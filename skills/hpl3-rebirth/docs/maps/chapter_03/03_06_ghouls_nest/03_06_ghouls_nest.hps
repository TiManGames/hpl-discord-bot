		 /*Put any functions that are only used in Scene 1, Event A here.*/
		 
		 bool OnTrigger_Player_PlayIntroDialogue_2(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (cScript_GetGlobalVarBool("TTH_GhoulsNestClearDialoguePlayed")) return false;
			 
			 Map_AddTimer("Dialogue_Intro_Clear", 1.f, "OnTimer_PlayDialogue");
			 cScript_SetGlobalVarBool("TTH_GhoulsNestClearDialoguePlayed", true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayDialogue(const tString &in asTimer)
		 {
			 Voice_PlayWhenPossible(asTimer);
		 }
    	 
