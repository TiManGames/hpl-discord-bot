	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 7 *Open the NEST EXIT GATE and trigger the end chase*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 7 here.*/
		
		bool mbExitGateBroken = false;
		bool mbExitGateBanging = false;
		float[] mvExitGateAngleLocks = { 0.f, 139.f, 184.f, 224.f, 274.f, 320.f };
		
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 7 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Encounter the broken NEST EXIT GATE*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event A here.*/
		 
		 int mlCurrGateAngleLock = 0;
		 bool mbEnteredNestExit = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event A here.*/
		 
		 bool OnTrigger_EnterNestExit(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
			 FearHandler_SetPermaFailRespawnArea("");
			 
			 Entity_SetActive("Ghoul_LeonsNest", false);
			 Agent_SetAutoDisableWhenOutOfSightActive("Ghoul_Overlap_*", true, 5.f);
			 Agent_SetSensesActive("Ghoul_Overlap_*", false);
			 Entity_SetActive("Sleeper_Temple_*", false);
			 
			 Blackboard_SetCheckCollisionCourse(true);
			 
			 Map_RemoveTimer("Timer_PlayInjuredGhoulWhimper");
			 Map_RemoveTimer("Timer_StartSeqLeonsNestCrawl");
			 
			 Entity_SetActive("FearThreat_LeonsNest", false);
			 Entity_SetActive("FearScaryObject_TempleOverlap", false);
			 
			 Sound_Stop("Sound_GhoulWorship_*", 1.f);
			 
			 Entity_SetActive("Trigger_EnterNestExit_*", false);
			 
			 OnTimer_UpdateExitGateBanging("");
			 OnTimer_UpdateExitGateSound("");

			 mbEnteredNestExit = true;
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_UpdateExitGateBanging(const tString &in asTimer)
		 {
			 if (mlCurrGateAngleLock != 0)	mlCurrGateAngleLock = 0;
			 else							mlCurrGateAngleLock = cMath_RandRectl(1, 2);

			 Wheel_SetAutoRotateMul("ExitGateWheelBase", 3.f);
			 
			 Wheel_SetAngle("ExitGateWheelBase", cMath_ToRad(47.f * mlCurrGateAngleLock), true); 
			 Map_AddTimer("Timer_UpdateExitGateBanging", cMath_RandRectf(1.8f, 2.2f), "OnTimer_UpdateExitGateBanging");
			 mbExitGateBanging = true;
		 }
		 
		 //-------------------------------------------------------
		 
		 // TODO: do this properly!
		 float mfPrevExitWheelAngle = 0.f;
		 void OnTimer_UpdateExitGateSound(const tString &in asTimer)
		 {
			 float fAngle = Wheel_GetCurrentAngle("ExitGateWheelBase");
			 float fDiff = cMath_Abs(cMath_GetAngleDistanceDeg(fAngle, mfPrevExitWheelAngle));
			 mfPrevExitWheelAngle = fAngle;
			 
			 float fVol = Map_TimerExists("Timer_UpdateExitGateBanging") ? 0.5f : 1.f;
			 Sound_Fade("Sound_ExitGateMove", fDiff > 0.1f ? fVol : 0.f, 0.1f);
			 
		     float fParam = cMath_Clamp(cMath_Max(fAngle - 100.f, 0.f) / 200.f, 0.f, 1.f);
			 Sound_SetParam("Sound_ExitGateMove", "GateGrind", cMath_Easing(eEasing_CubicOut, fParam));
			 
			 Map_AddTimer("Timer_UpdateExitGateSound", 0.1f, "OnTimer_UpdateExitGateSound");
		 }
		 
		 //-------------------------------------------------------
		 
		 void ForceStartEndChase()
		 {
			 mlPermaFailStage = eGhoulsNestPermaFailStage_Chase;
			 
			 Entity_SetActive("Ghoul_ExitGateBang", false);
			 Map_RemoveTimer("Timer_UpdateEndChaseBuildup");
				 
			 SequenceStates_Stop("Seq_DestroyExitGateGrate");
			 Entity_SetActive("Ghoul_ExitGateBang", false);
				
			 Sound_Fade("Sound_ExitGateGrowl", 0.f, 1.f);
			 Sound_Fade("Sound_ExitGateGhoulScuffle", 0.f, 1.f);
				 
			 Entity_SetActive("Trigger_ActivateSecondEndChaseGhoul", true);
			 Entity_SetActive("Trigger_DeactivateFirstEndChaseGhoul", true);
			 OnTimer_StartEndChase("");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ShowRunHint(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mfPlayerRunCount = 0;
			 Hint_StopHint();
			 Map_AddTimer("Timer_UpdatePlayerRunCount",0.1f,"OnTimer_UpdatePlayerRunCount");
			 Map_AddTimer("Timer_ShowRunHint", 4.f, "OnTimer_ShowRunHint");
			 return false;
		 }
		 
		//-------------------------------------------------------
		
		float mfPlayerRunCount = 0;
		 
		void OnTimer_UpdatePlayerRunCount(const tString &in asTimer)
		{
			if (Player_GetRunning())
				mfPlayerRunCount += 0.1f;
				
			if (mfPlayerRunCount >= 2.f)
				return;
				
			Map_AddTimer("Timer_UpdatePlayerRunCount", 0.1f, "OnTimer_UpdatePlayerRunCount");
		}
		
		//------------------------------------------------------- 
		 
		void OnTimer_ShowRunHint(const tString &in asTimer)
		{
			if (mfPlayerRunCount >= 2.f) return;
			
			Hint_RemoveFromGiven("Hints", "HintRun");
			Hint_ShowHint("Hints", "HintRun", true);
		}
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Encounter the broken NEST EXIT GATE*
         
          /////////////////////////////////////////
		 // Event B *Remove the FRONT PANEL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event B here.*/
		 
		 void OnTear_ExitGateLid(const tString &in asEntity)
		 {			 
			 //Sound_CreateAtEntity("Sound_DetachExitGateLid", "_temp/object interactive core/levers/metal_lever/metal_lever_min", asEntity);
			 Map_GetEntity(asEntity).GetBody(0).SetCollideFlags(mBaseObj.GetCollideFlag("-wheel"));
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *Remove the FRONT PANEL*
         
         /////////////////////////////////////////
		 // Event C *Turn the NEST EXIT WHEEL BASE*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event C here.*/
		 
		 bool mbExitGateScufflePlayed = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event C here.*/
		 
		 void OnConnectionStateChange_ExitGateWheelBase(const tString &in asEntity, int alState)
		 {
			 if (alState == 0 || mbEnteredNestExit == false) return;
			 
			 OnTimer_DoGateShake("ExitGateStrut_5");
			 
			 if (alState == -1 && 
				 Entity_IsInteractedWith(asEntity) == false && 
				 mbExitGateBroken == false)
			 {
				 Map_RemoveTimer("Timer_UpdateExitGateBanging");
				 mlCurrGateAngleLock = 1;
				 OnTimer_UpdateExitGateBanging("");
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_ExitGateWheelBase(const tString &in asEntity)
		 {			 
			 Map_RemoveTimer("Timer_StartSeqExitGateBreak");
			 Map_RemoveTimer("Timer_SeqExitGateBreak");
			 Map_RemoveTimer("Timer_UpdateExitGateBanging");

			 mbExitGateBanging = false;
			 
			 Map_AddTimer("Timer_CheckExitGateWheelBaseInteract", 0.1f, "OnTimer_CheckExitGateWheelBaseInteract");
			 
			 for (int i = 1; i < 5; i++)
			 {
				 if (Entity_GetCollide(asEntity, "Trigger_UpdateExitGateCatcherState_" + i) == false ||
					 i == 2 || i == 4)
					 continue;
					 
				 MoveObject_SetState("ExitGateCatcher_" + i, 0);
				 Sound_CreateAtEntity("Sound_Catcher", "03_06_ghouls_nest/nest_gate/gate_clip", "ExitGateCatcher_" + i);
				 
				 Entity_SetInteractionDisabled("ExitGateCatcher_" + i, false);
				 Wheel_SetJammed("ExitGateWheelBase", false, 0.f, 0.f);
			 }
			 
			 Voice_PlayDelayed("Dialogue_BeQuiet", 1.5f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_CheckExitGateWheelBaseInteract(const tString &in asTimer)
		 {
			 if (Entity_IsInteractedWith("ExitGateWheelBase") == false)
			 {				 
				 ////////////////////////////
				 // Snap to start
				 float fAngle = Wheel_GetCurrentAngle("ExitGateWheelBase");
				 if (fAngle >= 358.f) return;
				 
				 Wheel_SetAutoRotateMul("ExitGateWheelBase", 5.f);
				 Wheel_SetAngle("ExitGateWheelBase", 0.f, true);			 
				 
				 // If at end, break gate!
				 if (fAngle >= mvExitGateAngleLocks[mvExitGateAngleLocks.size() - 1] - 0.5f) // Small offset here to account for wheel auto move not being 100%
					 Map_AddTimer("Timer_StartSeqExitGateBreak", 1.f, "OnTimer_StartSeqExitGateBreak");
					 
				 return;
			 }
			 
			 Map_AddTimer("Timer_CheckExitGateWheelBaseInteract", 0.1f, "OnTimer_CheckExitGateWheelBaseInteract");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_UpdateExitGateCatcherState(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 int lState = alState == -1 ? 1 : 0;
			 bool bInteractedWith = Entity_IsInteractedWith(asChild);
			 if (bInteractedWith == false && mbExitGateBroken == false && mbExitGateBanging == false)
				 lState = 1;
			 
			 int lId = cString_GetNumericSuffixInt(asParent);
			 tString sCatcher = "ExitGateCatcher_" + lId;
			 
			 /////////////////////////////
			 // If at second blocker catcher, play ghoul scuffle!
			 if (mbExitGateScufflePlayed == false && lId == 3)
			 {
				 mbExitGateScufflePlayed = true;
				 Seq_ExitGateScuffle("");	 
			 }
			 
			 /////////////////////////////
			 // Gate is breaking, move catcher!
			 if (mbExitGateBroken)
			 {
				 MoveObject_SetState(sCatcher, lState);
				 
				 if (lState > 0.f)
					 Entity_SetInteractionDisabled(sCatcher, false);
				 return true;
			 }
			 
			 /////////////////////////////
			 // Catcher works properly,  fold in!
			 if (bInteractedWith && lId != 2 && lId != 4)
			 {
				 MoveObject_SetState(sCatcher, lState);
				 if (MoveObject_GetState(sCatcher) != lState)
					 Sound_CreateAtEntity("Sound_Catcher", "03_06_ghouls_nest/nest_gate/gate_clip", sCatcher);
				 
				 if (lState > 0.f)
					 Entity_SetInteractionDisabled(sCatcher, false);
					 
				 Wheel_SetJammed("ExitGateWheelBase", true, mvExitGateAngleLocks[0], 348.f);
				 return true;
			 }
			 
			 /////////////////////////////
			 // Catcher in the way, snap to correct lock!
			 if (MoveObject_GetState(sCatcher) > 0.f)
			 {		
				 bool bInFront = Entity_EntityIsInFront("Trigger_ExitGateWheelSpoke", asParent);
				 float fMin = bInFront ? mvExitGateAngleLocks[lId] : mvExitGateAngleLocks[0];
				 float fMax = bInFront ? 348.f : mvExitGateAngleLocks[lId] - 20.f;

				 Wheel_SetJammed("ExitGateWheelBase", true, fMin, fMax);
				 
				 if (alState == 1)
					 OnTimer_DoGateShake("ExitGateStrut_5");
				 return true;
			 }
			 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_ExitGateCatcher(const tString &in asEntity)
		 {
			 ////////////////////////
			 // Push catcher in!
			 MoveObject_SetState(asEntity, 0.f);
			 Entity_SetInteractionDisabled(asEntity, true);
			 Sound_CreateAtEntity("Sound_Catcher", "03_06_ghouls_nest/nest_gate/gate_clip", asEntity);
			 
			 tString sConnectedCatcher = Entity_GetVarString(asEntity, "");
			 if (Entity_Exists(sConnectedCatcher))
			 {
				 MoveObject_SetState(sConnectedCatcher, 1.f);
				 Entity_SetInteractionDisabled(sConnectedCatcher, false);
			 }				 
			 
			 ////////////////////////
			 // Catcher pushed in, set wheel free
			 int lId = cString_GetNumericSuffixInt(asEntity);			 
			 if (Entity_GetCollide("Trigger_ExitGateWheelSpoke", "Trigger_UpdateExitGateCatcherState_" + lId))
				 Wheel_SetJammed("ExitGateWheelBase", false, 0.f, 0.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSequenceExitGateScuffle;
		 void Seq_ExitGateScuffle(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_ExitGateScuffle", mSequenceExitGateScuffle);
			 Sequence_Wait(1.f);
			 if (Sequence_DoStepAndWait(1.f))
			 {
				 Sound_CreateAtEntity("Sound_ExitGateGrowl", "", "Area_ExitGateScuffle");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Sound_CreateAtEntity("Sound_ExitGateGhoulScuffle", "03_06_ghouls_nest/nest_gate/ghoul_distant_screams", "Area_ExitGateScuffle");
				 Map_AddTimer("Timer_StopExitGateScuffleLoops", 15.f, "OnTimer_StopExitGateScuffleLoops");
				 
				 FearHandler_SetForcedAddFearRate(0.2f, 6.f, false, -1.f, 0.05f, 0.2f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 ParticleSystem_CreateAtEntity("PS_GrateDust", "sand_falling_stream_small_oneshot.ps", "Area_ExitGateRoofPSTar", false).SetBrightness(0.25f);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StopExitGateScuffleLoops(const tString &in asTimer)
		 {
			 Sound_Fade("Sound_ExitGateGrowl", 0.f, 1.f);
			 Sound_Fade("Sound_ExitGateGhoulScuffle", 0.f, 1.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StartSeqExitGateBreak(const tString &in asTimer)
		 {
			 //////////////////////////
			 // If at final catcher, start gate craziness!	
			 if (Wheel_GetCurrentAngle("ExitGateWheelBase") < 275.f)
				 return;
				 
			 Seq_ExitGateBreak("");
		 }
         
         //-------------------------------------------------------
	 
		 //} END Event C *Turn the NEST EXIT WHEEL BASE*
		 
		 /////////////////////////////////////////
		 // Event D *The NEST EXIT GATE goes haywire*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event D here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event D here.*/
         
		 cSequenceStatesData mSequenceDataExitGateBreak;
		 void Seq_ExitGateBreak(const tString &in asTimer)
		 {
			 float fGhoulSoundDelay = Entity_GetCollide("player", "Area_ExitGate") ? 1.f : 3.5f;
			 
			 Sequence_Begin("Seq_ExitGateBreak", mSequenceDataExitGateBreak);
			 if (Sequence_DoStepAndWait(0.1f))
			 {
				 FearHandler_SetPermaFailEnabled(false);
				 
				 mbExitGateBroken = true;
				 MoveObject_SetState("ExitGateCatcher_5", 0);
				 Wheel_SetAutoRotateMul("ExitGateWheelBase", 6.f);
				 Wheel_SetJammed("ExitGateWheelBase", false, 0.f, 348.f);
				 
				 ///////////////////////
				 // Break wheel base!
				 Entity_SetInteractionDisabled("ExitGateWheelBase", true);
				 Entity_SetCollide("ExitGateWheelBase", false);
				 Map_GetEntity("ExitGateWheelBase").GetMeshEntity().SetVisible(false);
				 
				 // TEMP, fix this cleaner with the proper ents!
				 Entity_SetActive("ExitGateWheelBase_Broken", true);
				 Map_GetEntity("ExitGateWheelBase_Broken").GetMeshEntity().GetSubMeshEntityName("TTH_nest_gate_mechanism_wheelB__2_").SetVisible(false);
				 
				 Entity_SetActive("ExitGateWheelBase_Fall", true);
				 Entity_PlaceAtEntity("ExitGateWheelBase_Fall", "ExitGateWheelBase_Broken", cVector3f(0.f), false);
				 Map_GetEntity("ExitGateWheelBase_Fall").GetMeshEntity().GetSubMeshEntityName("TTH_nest_gate_mechanism_wheelB").SetVisible(false);
				 Map_GetEntity("ExitGateWheelBase_Fall").GetBody(1).AddTorque(cVector3f(0.f, 0.f, -500.f));

				 Sound_CreateAtEntity("Sound_ExitGateWheelBaseBreak", "_temp/object interactive core/levers/metal_lever/metal_lever_min", "ExitGateWheelBase");
				 Sound_CreateAtEntity("Sound_ExitGateWheelBaseBreak", "03_06_ghouls_nest/nest_gate/gate_break", "Trigger_ForceGhoulCrawl");
				 ParticleSystem_CreateAtEntity("PS_ExitGateDust", "dust_medium_long_onehsot.ps", "Area_ExitGatePS", false);
				 				 
				 Effect_Shake_Start(0.0025f, 12.f, 0.2f, 2.f);
				 
				 Voice_PlayDelayed("Dialogue_NoisyDoor", 1.5f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 SetExitGateState(0.23f);	
			 
				 FearHandler_SetForcedAddFearRate(0.5f, 15.f, false, -1.f, 0.1f);
				 Sound_CreateAtEntity("Sound_ExitGateBreak", "pillar_vitae/doors/trap_door_mechanism", "ExitGateStrut_5");
			 }
             else if (Sequence_DoStepAndWait(0.5f)) 	SetExitGateState(0.05f);
             else if (Sequence_DoStepAndWait(0.43f)) 	SetExitGateState(0.63f);
             else if (Sequence_DoStepAndWait(0.7f))		SetExitGateState(0.f);
             else if (Sequence_DoStepAndWait(0.6f)) 	SetExitGateState(0.7f);
             else if (Sequence_DoStepAndWait(0.5f)) 	
			 {
				 SetExitGateState(0.13f);				 
				 BreakExitGateStrut("ExitGateStrut_2");
			 }
             else if (Sequence_DoStepAndWait(0.37f))	SetExitGateState(0.85f);
             else if (Sequence_DoStepAndWait(0.35f))
			 {
				 SetExitGateState(0.8f);
				 BreakExitGateStrut("ExitGateStrut_5");				 
			 }
             else if (Sequence_DoStepAndWait(0.22f))	SetExitGateState(0.05f);
			 else if (Sequence_DoStepAndWait(0.52f))
			 {
				 SetExitGateState(0.35f);
				 BreakExitGateStrut("ExitGateStrut_8");
			 }
             else if (Sequence_DoStepAndWait(0.43f))	SetExitGateState(0.83f);
             else if (Sequence_DoStepAndWait(0.7f))
			 {
				 SetExitGateState(0.f);
				 Entity_SetActive("Trigger_LockExitGateStrutPush", true);
				 ActivatePushStrut("ExitGateStrut_7", "ExitGateStrutPush_3", true);
			 }
             else if (Sequence_DoStepAndWait(0.6f)) 	SetExitGateState(0.47f);
             else if (Sequence_DoStepAndWait(0.5f)) 	SetExitGateState(0.13f);
             else if (Sequence_DoStepAndWait(0.45f))	SetExitGateState(0.85f);
             else if (Sequence_DoStepAndWait(0.33f))
			 {
				 SetExitGateState(0.44f);
				 ActivatePushStrut("ExitGateStrut_6", "ExitGateStrutPush_2");
			 }
             else if (Sequence_DoStepAndWait(0.41f))	SetExitGateState(0.05f);
             else if (Sequence_DoStepAndWait(0.33f))	SetExitGateState(0.91f);
             else if (Sequence_DoStepAndWait(1.13f))
			 {
				 SetExitGateState(0.12f);
				 ActivatePushStrut("ExitGateStrut_4", "ExitGateStrutPush_1");
			 }
             else if (Sequence_DoStepAndWait(0.33f)) 	SetExitGateState(0.94f);			 
             else if (Sequence_DoStepAndWait(1.f))
			 {
				 SetExitGateState(0.05f);				 
				 BreakExitGateStrut("ExitGateStrut_3");
			 }
             else if (Sequence_DoStepAndWait(0.33f))	SetExitGateState(0.4f);
             else if (Sequence_DoStepAndWait(1.f))
			 {
				 SetExitGateState(0.12f);
				 
				 Map_GetProp("ExitGateWheelBase").RemoveInteractConnection("ExitGateStrut_9");
				 Prop_SetStaticPhysics("ExitGateStrut_9", false);
				 
				 Map_AddTimer("Timer_UpdatePlayerRunCount",0.1f,"OnTimer_UpdatePlayerRunCount");
				 
				 Entity_SetActive("BlockBox_NestExitGate_1", false);
				 Entity_SetActive("Trigger_ForceStartEndChase", true);
			 }
             else if (Sequence_DoStepAndWait(fGhoulSoundDelay))
             {
				 Map_RemoveTimer("Timer_UpdateExitGateSound");	
				 Sound_Stop("Sound_ExitGateMove", 0.3f);
				 
				 Prop_SetStaticPhysics("ExitGateStrut_*", true);
             }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 if (Entity_IsActive("Ghoul_EndChase_1")) return;
				 
				 Seq_DestroyExitGateGrate("");
				 
				 Sound_CreateAtEntity("GhoulAwaken", "03_06_ghouls_nest/broken_door/ghoul_group_awaken", "Sound_GhoulAwaken");
				 Map_AddTimer("Timer_UpdateEndChaseBuildup", 0.1f, "OnTimer_UpdateEndChaseBuildup");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetExitGateState(float afOpenAmount)
		 {
			 Wheel_SetAngle("ExitGateWheelBase", cMath_PiMul2 * afOpenAmount, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void BreakExitGateStrut(const tString &in asStrut)
		 {
			 Map_GetProp("ExitGateWheelBase").RemoveInteractConnection(asStrut);
			 Prop_SetStaticPhysics(asStrut, true);
			 
			 Prop_AlignRotation(asStrut, "Tar_" + asStrut, 1.f * 0.74f, 1.f * 0.74f, 0.1f, false);
			 Prop_MoveLinearTo(asStrut, "Tar_" + asStrut, 1.1f * 0.74f, 1.25f * 0.74f, 0.1f, false);
			 
			 ParticleSystem_CreateAtEntity("PS_StrutSparks", "sparks.ps", asStrut, false);
			 
			 int lShakeID = Effect_Shake_Start(0.01f, cMath_RandRectf(0.5f, 0.6f), 0.2f, 0.2f);
			 Effect_Shake_SetSourceEntity(lShakeID, asStrut, 2.f, 15.f, eEasing_Linear);
			 
			 LightFlash_Add(0.1f, 0.05f, 0.05f, asStrut, cColor(1,0.948,0.688,1), 3.f, 1.f);
		 }
		 
		 
		 //-------------------------------------------------------
		 
		 void ActivatePushStrut(const tString &in asStrut, const tString &in asPushStrut, bool abStatic = false)
		 {
			 Entity_SetActive(asStrut, false);
			 Entity_SetActive(asPushStrut, true); 
			 Entity_RemoveEntityAttachment(asPushStrut);
			 Entity_SetActive(Entity_GetVarString(asPushStrut, ""), false);
			 Entity_SetInteractionDisabled(asPushStrut, false);
			 
			 tString sBrokenStrut = asPushStrut + "_Broken";
			 Entity_SetActive(sBrokenStrut, true);
			 Entity_SetCollideCharacter(sBrokenStrut, false);
			 Entity_RemoveEntityAttachment(sBrokenStrut);
			 
			 Body_AddImpulse(asPushStrut + "_Broken_Body_1", cVector3f(-2.f, -1.f, 1.f), false);
			 Body_AddImpulse(asPushStrut + "_Broken_Body_2", cVector3f(1.5f, -1.5f, -2.f), false);
			 Body_AddImpulse(asPushStrut + "_Broken_Body_3", cVector3f(2.f, -0.5f, 1.5f), false);
			 Body_AddImpulse(asPushStrut + "_Broken_Body_4", cVector3f(-1.5f, -2.f, 0.5f), false);
			 
			 if (abStatic)
				 Prop_SetStaticPhysics(asPushStrut, true);
			 
			 ParticleSystem_CreateAtEntity("PS_StrutSparks", "sparks.ps", asStrut, false);
			 
			 int lShakeID = Effect_Shake_Start(0.01f, cMath_RandRectf(0.4f, 0.6f), 0.2f, 0.2f);
			 Effect_Shake_SetSourceEntity(lShakeID, asStrut, 2.f, 15.f, eEasing_Linear);
			 
			 LightFlash_Add(0.1f, 0.05f, 0.05f, asStrut, cColor(1,0.948,0.688,1), 3.f, 1.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSequenceDataDestroyExitGrate;
		 void Seq_DestroyExitGateGrate(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_DestroyExitGateGrate", mSequenceDataDestroyExitGrate);
			 if (Sequence_DoStepAndWait(2.f))
			 {
				 Sound_CreateAtEntity("Sound_ExitGateVentEnter", "03_06_ghouls_nest/nest_gate/roof_vent_scuffle_enter", "Area_ExitGateScuffle");
				 Sound_CreateAtEntity("Sound_ExitGateVentEnterVocal", "03_06_ghouls_nest/nest_gate/roof_vent_vocal_enter", "Area_ExitGateScuffle");
				 
				 cLux_ToAgent(Map_GetEntity("Ghoul_ExitGateBang")).GetCharBody().SetTestCollision(false);
				 Entity_SetActive("Ghoul_ExitGateBang", true);
				 CharMover_SetUseMoveStateAnimations("Ghoul_ExitGateBang", false);
				 
				 Entity_SetAnimationMessageEventCallback("Ghoul_ExitGateBang", "OnRecieveMessage_BangingGhoul", false);
				 
				 Entity_PlayAnimation("Ghoul_ExitGateBang", "ceiling_grate_enter", 0.f);
				 
				 Map_AddTimer("Timer_PlayRunDialogue", 3.5f, "OnTimer_PlayRunDialogue");
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				 PlayGrateBangAnimation("ceiling_grate_bang");
			 }
			 else if (Sequence_DoStepAndWait(2.f))	PlayGrateBangAnimation("ceiling_grate_bang");
			 else if (Sequence_DoStepAndWait(3.f))	PlayGrateBangAnimation("ceiling_grate_reach");
			 else if (Sequence_DoStepAndWait(1.5f)) PlayGrateBangAnimation("ceiling_grate_pull");
			 else if (Sequence_DoStepAndWait(2.5f))	PlayGrateBangAnimation("ceiling_grate_reach");
			 else if (Sequence_DoStepAndWait(2.f))	PlayGrateBangAnimation("ceiling_grate_bang");
			 else if (Sequence_DoStepAndWait(3.f))	PlayGrateBangAnimation("ceiling_grate_reach");
			 else if (Sequence_DoStepAndWait(1.5f))	PlayGrateBangAnimation("ceiling_grate_pull");
			 else if (Sequence_DoStepAndWait(2.f))	PlayGrateBangAnimation("ceiling_grate_bang");
			 else if (Sequence_DoStepAndWait(1.5f))	PlayGrateBangAnimation("ceiling_grate_bang");
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Entity_SetActive("Ghoul_ExitGateBang", false);
				 ForceStartEndChase();
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayRunDialogue(const tString &in asTimer)
		 {
			 //if (Player_GetRunning() == false)
				Voice_Play("Dialogue_Run");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnRecieveMessage_BangingGhoul(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		 {
			 if (alMessageEventID == 0)
			 {
				 ParticleSystem_CreateAtEntity("PS_ExitGateRoofBang", "smoke_oneshot_grate_break.ps", "Area_ExitGateRoofPSTar", false).SetBrightness(0.4f);			 
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void PlayGrateBangAnimation(const tString &in asAnim)
		 {
			 Entity_PlayAnimation("Ghoul_ExitGateBang", asAnim);
			 Entity_PlayAnimation("NestExitGrate", asAnim);
		 }
		 
		 //-------------------------------------------------------
		 
		 //} END Event D *The NEST EXIT GATE goes haywire*
		 
		 /////////////////////////////////////////
		 // Event E *Push open the BROKEN EXIT GATE STRUT and start the chase*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event D here.*/
		 
		 float mfPrevDistToExitGate = 100.f;
		 float mfGhoulAwakenParamAdd = 0.f;
		 bool mbUseGhoulAwakenDistAdd = false;
		 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event D here.*/
		 
		 bool OnTrigger_Player_UseAwakenScreamDistParam(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1) return true;
			 
			 mbUseGhoulAwakenDistAdd = Entity_PlayerIsInFront(asParent);
			 return true;
		 }
		 
		 //------------------------------------------------------
		 
		 void OnTimer_UpdateEndChaseBuildup(const tString &in asTimer)
		 {
			 if (mbUseGhoulAwakenDistAdd)
			 {
				 float fDist = Entity_GetDeltaToEntity("player", "Area_ExitGatePos").Length();
				 if (fDist < 8.f)
				 {
					 if (mfPrevDistToExitGate > fDist)
					 {
						 mfPrevDistToExitGate = fDist;
						 mfGhoulAwakenParamAdd = (1.f - (fDist / 8.f)) * 0.5f;
					 }
				 }
			 }			 
			 
			 float fPassedTime = Map_GetTimerUserVarFloat(asTimer) + 0.1f;			 
			 float fT = fPassedTime / (20.f - mfGhoulAwakenParamAdd * 10.f);
			 
			 fT = cMath_Easing(eEasing_QuadOut, cMath_Clamp(fT + mfGhoulAwakenParamAdd, 0.f, 1.f));
			 Sound_SetParam("GhoulAwaken", "GhoulScream", fT);
			 
			 if (fT >= 1.f)
			 {
				 SequenceStates_Stop("Seq_DestroyExitGateGrate");
				 Entity_SetActive("Ghoul_ExitGateBang", false);
				
				 Sound_Fade("Sound_ExitGateGrowl", 0.f, 1.f);
				 Sound_Fade("Sound_ExitGateGhoulScuffle", 0.f, 1.f);
				 
				 Entity_SetActive("Trigger_ActivateSecondEndChaseGhoul", true);
				 Entity_SetActive("Trigger_DeactivateFirstEndChaseGhoul", true);
				 OnTimer_StartEndChase("");
				 return;
			 }		 
			 
			 Map_RestartCurrentTimer(0.1f);
			 Map_SetTimerUserVarFloat(asTimer, fPassedTime);
		 }
		 
		 //------------------------------------------------------
		 
		 void OnInteract_ExitGateStrutPush(const tString &in asEntity)
		 {
			 Entity_SetVarBool(asEntity, "InteractedWith", true);
			 Map_GetEntity(asEntity).GetMainBody().SetGravity(false);
			 Map_AddTimer(asEntity, 0.1f, "OnTimer_UpdateExitGateStrutPushInteract");
			 
			 Entity_SetActive("Trigger_ExitGateStrutSpikes_*", false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_UpdateExitGateStrutPushInteract(const tString &in asTimer)
		 {
			 if (Entity_IsInteractedWith(asTimer) == false)
			 {
				 Map_GetEntity(asTimer).GetMainBody().SetGravity(true);
				 return;
			 }
			 
			 Map_AddTimer(asTimer, 0.1f, "OnTimer_UpdateExitGateStrutPushInteract");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnCollide_Player_WakeUpExitGateStrutPush(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1) return true;
			 Body_AddImpulse(asParent + "_Body_1", cVector3f(0.f, -1.f, 0.f), false);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_LockExitGateStrutPush(const tString &in asParent, const tString &in asChild, int alState)
		 {			 			 
			 if (Entity_GetVarBool(asChild, "InteractedWith") == false) return true;
			 
			 Map_RemoveTimer(asChild);
			 Prop_SetStaticPhysics(asChild, true);
			 Player_ChangeStateToNormal();
			 
			 Effect_Shake_Start(0.0075f, 0.75f, 0.2f, 0.2f);
			 
			 Sound_CreateAtEntity("Sound_PushStrutStop", "03_06_ghouls_nest/nest_gate/gate_arm_stop", asChild);
			 return true;
		 }

		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ForceStartEndChase(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_AddTimer("Timer_StopGhoulAwakenSound", 5.f, "OnTimer_StopGhoulAwakenSound");
			 
			 if (Entity_IsActive("Ghoul_EndChase_1") == false)
				 ForceStartEndChase();		 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StopGhoulAwakenSound(const tString &in asTimer)
		 {
			 Sound_Stop("GhoulAwaken", 1.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StartEndChase(const tString &in asTimer)
		 {
			 ////////////////////////
			 // Spawn first chase ghoul!
			 mlPermaFailStage = eGhoulsNestPermaFailStage_Chase;			 
			 
			 Prop_SetHealth("EndChaseRoof", 0.f);
			 Entity_SetCollide("BlockBox_NestExitGate_1", false);
			 Entity_SetActive("NestExitGrate", false);
			 
			 Sound_CreateAtEntity("Sound_ExitGateRoofBang", "level_entity_shared/doors/tin_hinan_door/tin_hinan_door_hit", "EndChaseRoof");		
			 Sound_Stop("Sound_ExitGateRoofNoise", 1.f);
			 
			 Entity_SetActive("Ghoul_EndChase_1", true);
			 Entity_PlayAnimation("Ghoul_EndChase_1", "ceiling_grate_bang", 0.f, false);
			 Map_GetEntity("Ghoul_EndChase_1").GetMeshEntity().GetAnimationStateFromName("ceiling_grate_bang").SetRelativeTimePosition(0.65f);
			 
			 Map_AddTimer("Timer_EndChaseGhoulFall", 0.2f, "OnTimer_EndChaseGhoulFall");
			 
			 LoadScreen_ProgressStory();
			 FearHandler_SetWhispersActive(false);
			 
			 FearHandler_SetAllowMonsterHint(false);
			 FearHandler_SetPermaFailEnabled(false);
			 
			 Player_SetNightVisionIgnoreFearArea(true);
			 
			 Entity_SetActive("Fear_1", false);
			 Entity_SetActive("Fear_Chase", true);
			 
			 ///////////////////
			 // Set up HQB state
			 cScript_SetGlobalVarBool("TTH_PortalFailed", true);
             cScript_SetGlobalVarBool("TTH_PillarRoomComplete", true); 
             cScript_SetGlobalVarBool("TTH_GhoulsNestComplete", true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_EndChaseGhoulFall(const tString &in asTimer)
		 {
			 cLux_ToAgent(Map_GetEntity("Ghoul_EndChase_1")).GetCharBody().SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-player"));
			 Entity_PlayAnimation("Ghoul_EndChase_1", "wall_fall", 0.7f, true, true);
			 
			 CharMover_SetUseMoveStateAnimations("Ghoul_EndChase_1", false);
			 CharMover_SetDynamicObjectAvoidanceActive("Ghoul_EndChase_1", false);
			 
			 Body_AddImpulse("EndChaseRoof_broken_Body_7", cVector3f(0.f, -1.f, 0.f), false);
			 Body_AddImpulse("EndChaseRoof_broken_Body_3", cVector3f(0.f, -0.8f, 0.f), false);
			 Body_AddImpulse("EndChaseRoof_broken_Body_4", cVector3f(0.f, -1.2f, 0.f), false);
			 Body_AddImpulse("EndChaseRoof_broken_Body_8", cVector3f(0.f, -0.6f, 0.f), false);
			 
			 Entity_SetCollideCharacter("EndChaseRoof_broken", false);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_EndChaseGhoulLand(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_GetEntity("ExitGateTop").GetBody(0).SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-agent"));
			 
			 FearHandler_SetForcedAddFearRate(0.4f, 3.f, true);
			 
			 cLux_ToAgent(Map_GetEntity("Ghoul_EndChase_1")).GetCharBody().SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("+agent"));
			 Entity_PlayAnimation(asChild, "wall_fall_to_land", 0.3f, false, true, "OnAnimationOver_EndChaseGhoulFall");
			 
			 ///////////////////////////
			 // Set up chase!
			 Blackboard_SetProximityEventsActive(false);
			 
			 Sound_CreateAtEntity("NestExitGhoulEmerge", "03_06_ghouls_nest/chase_sequence/ghoul_chase_start", "Ghoul_EndChase_1");
			 Music_PlayExt("A2_NPC_GhoulNestChase", true, 1.0f, 1, 4.0f, 0, eMusicPrio_OverrideAll, true);                
			 
			 ////////////////////////////
			 // Set up perma fail
			 msEndChasePermaFailArea = "PermaFail_ChaseCell";
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimationOver_EndChaseGhoulFall(const tString &in asEntityName, const tString &in asAnimName)
		 {
			 Agent_RevealPlayerPosition(asEntityName);
			 
			 ///////////////
			 // Place at anim end pos
			 iCharacterBody@ pBody = cLux_ToAgent(Map_GetEntity(asEntityName)).GetCharBody();
			 pBody.SetFeetPosition(pBody.GetFeetPosition() + cVector3f(1.120285f, 0.f,  -0.229607f), true);
			 Entity_PlayAnimation(asEntityName, "idle", 0.f, false, true);
			 
			 Map_AddTimer(asEntityName, 2.f, "OnTimer_PursuePlayer");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PursuePlayer(const tString &in asTimer)
		 {
			 //////////////
			 // Start chase!
			 SetEndChaseGhoulChaseReady(asTimer);
			 Agent_SetSensesActive(asTimer, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_DeactivateFirstEndChaseGhoul(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Entity_IsActive("Ghoul_EndChase_17") == false)
				 return false;
			 
			 Entity_SetActive(asParent, false);
			 if (Map_GetEntity(asChild).CheckIsOnScreen(true) == false)
				 Entity_SetActive(asChild, false);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_ForceGhoulCrawl(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
			 //////////////////////////////////
			 // Really ugly solution to the ghoul's weird pathfinding when moving through the gate.
			 if (alState == 1)
			 {				
				 if (Entity_GetCollide(asParent, "player")) return true;
				
				 Entity_SetCollideCharacter("ExitGateStrut*", false);				 
				 Ghoul_SetAdaptiveHuntSpeed(asChild, false, 14.f);
				 Ghoul_SetAdjustHuntSpeed(asChild, false);
				 CharMover_SetUseMoveStateAnimations(asChild, false);
				 CharMover_SetSpeedState(asChild, 1);
				 Entity_PlayAnimation(asChild, "crawl", 0.3f, true, true);				 
				 return true;
			 }
			 
			 Entity_SetCollideCharacter("ExitGateStrut*", true);			 
			 Ghoul_SetAdaptiveHuntSpeed(asChild, true, 14.f);
			 Ghoul_SetAdjustHuntSpeed(asChild, true);
			 CharMover_SetUseMoveStateAnimations(asChild, true);
			 CharMover_SetSpeedState(asChild, 2);
			 
			 Ghoul_Mode_Set(asChild, eGhoulMode_Hunt, true);
			 return true;
		 }
		 
		 //-------------------------------------------------------

		 //} END Event E *Push open the BROKEN EXIT GATE STRUT and start the chase*
	 
	 //} END SCENE 7
	 
	 //////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 8 *GET CHASED BY MULTIPLE GHOULS BEFORE FINALLY MANAGING TO EXIT THE GHOUL'S NEST*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 8 here.*/
		
		int mlEndChaseGhoulCount = 18;
		int mlEndChasePermaFailCount = 0;
		tString msEndChasePermaFailArea = "PermaFail_ChaseCell";
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 8 here.*/
        
        void SetEndChaseGhoulChaseReady(const tString &in asGhoul)
        {
			Entity_SetActive(asGhoul, true);			
			Ghoul_Mode_Set(asGhoul, eGhoulMode_Hunt, true);
        }
        
        //-------------------------------------------------------
        
        void DeactivateFarthestEndChaseGhoul(int alSkipId = -1)
        {
             ////////////////////////////////////
             // Enable auto disable on active ghoul farthest away from player
             float fMaxDistSqr = 0.f;
             tString sGhoul = "";
             tString sFarthest = "";
             for (int i = 1; i <= mlEndChaseGhoulCount; i++)
             {
                 sGhoul = "Ghoul_EndChase_" + i;
                 float fDistSqr = Entity_GetDeltaToEntity(sGhoul, "player").SqrLength();
                 if (i == alSkipId || 
					 Entity_IsActive(sGhoul) == false || 
					 fDistSqr < fMaxDistSqr ||
					 Entity_GetVarBool(sGhoul, "EndChase_AutoDisable")) 
                     continue;
                  
                 fMaxDistSqr = fDistSqr;
                 sFarthest = sGhoul;
             }

             Agent_SetAutoDisableWhenOutOfSightActive(sFarthest, true, 5.f);
			 Entity_SetVarBool(sFarthest, "EndChase_AutoDisable", true);
			 
			 cLux_AddDebugMessage("Deactivating farthest chase ghoul: " + sFarthest);
         }
         
         //-------------------------------------------------------
         
         bool OnTrigger_ActivateHoleEndChaseGhoul(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
             tString sGhoul = Entity_GetVarString(asParent, "");
			 
			 if (Entity_IsActive(sGhoul)) return false;
			 
			 Entity_SetActive(sGhoul, true);
			 Ghoul_CommandGoToSpecificHole_Execute(sGhoul, "EndChaseHole_" + cString_GetNumericSuffixInt(sGhoul), true, true);
			 
			 if (sGhoul == "Ghoul_EndChase_11")
				 msEndChasePermaFailArea = "PermaFail_PortalRoomCorridor";

			 int lId = cString_GetNumericSuffixInt(sGhoul);
             if (Blackboard_GetAgentCount() > 2 && lId == 9 || lId == 10 || lId == 11)
				 DeactivateFarthestEndChaseGhoul();
				 
             Map_AddTimer(sGhoul, 0.1f, "OnTimer_HoleEndChaseGhoulEmerge");     
			 
			 if (lId == 2)			PlayChaseRunEmote(0, 0.8f);
			 else if (lId == 9)		PlayChaseRunEmote(6, 0.8f);
			 else if (lId == 11)	PlayChaseRunEmote(5, 0.8f);
			 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_HoleEndChaseGhoulEmerge(const tString &in asTimer)
		 {			 
			 Ghoul_CommandEmergeFromHole_Execute(asTimer, "EndChaseHole_" + cString_GetNumericSuffixInt(asTimer), true, "OnPostEmerge_HoleEndChaseGhoul");
			 Sound_CreateAtEntity(asTimer + "_Emerge", "03_06_ghouls_nest/chase_sequence/ghoul_chase_tunnel_emerge", asTimer);
		 }
         
         //-------------------------------------------------------
         
         void OnPostEmerge_HoleEndChaseGhoul(const tString &in asEntity)
         {
             SetEndChaseGhoulChaseReady(asEntity);			 
			 FearHandler_SetForcedAddFearRate(0.35f, 2.f, true);
         }
		
		//-------------------------------------------------------
		
		void OnTimer_SetEndChaseGhoulReady(const tString &in asTimer)
		{
			SetEndChaseGhoulChaseReady(asTimer);
		}
		
		//-------------------------------------------------------
		
		void PlayChaseRunEmote(int alLineId, float afDelay = 0.3f)
		{
			Voice_PlayDelayed("Dialogue_RunEmotes", afDelay, alLineId);
		}
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Run to the Tin Hinan Common Room*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event A here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event A here.*/
         
         bool OnTrigger_SetupClimbEndChaseGhoul(const tString &in asParent, const tString &in asChild, int alState)
         {
			 /////////////////
			 // Set up climber!
			 if (FearHandler_GetIsPermaFailing()) return true;
			 Entity_SetActive("Ghoul_EndChase_7", true);			 
			 Map_AddTimer("Ghoul_EndChase_7", 0.1f, "OnTimer_EndChaseGhoulClimb");
			 Map_AddTimer("Ghoul_EndChase_7", 3.5f, "OnTimer_PauseClimbEndChaseGhoul");
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_EndChaseGhoulClimb(const tString &in asTimer)
		 {
			 Pathfinder_MoveToNode("Ghoul_EndChase_7", "PathNodeArea_1040", "OnPathfinderMove_EndChaseClimber");
		 }
         
         //-------------------------------------------------------
		 
		 void OnTimer_PauseClimbEndChaseGhoul(const tString &in asTimer)
		 {
			 Entity_SetActive("Ghoul_EndChase_7", false);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_ActivateClimbEndChaseGhoul(const tString &in asParent, const tString &in asChild, int alState)
         {
			 msEndChasePermaFailArea = "PermaFail_CommonRoom";
			 
			 if (FearHandler_GetIsPermaFailing()) return true;
			 
			 /////////////////
			 // Re-activate climber!
			 Entity_SetActive("Ghoul_EndChase_7", true);
			 FearHandler_SetForcedAddFearRate(0.35f, 2.f, true);			 
			 Sound_CreateAtEntity("ClimbGhoulSound", "03_06_ghouls_nest/chase_sequence/ghoul_chase_cavern_climb", "Ghoul_EndChase_7");
			 
			 PlayChaseRunEmote(1, 1.f);
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnPathfinderMove_EndChaseClimber(const tString &in asEntityName, bool abReachedEnd)
		 {
			 Agent_SetSensesActive(asEntityName, true);
			 
			 if (Blackboard_GetAgentCount() > 2)
			 {
				 DeactivateFarthestEndChaseGhoul(3);
				 DeactivateFarthestEndChaseGhoul(3);
			 }
			 
			 Map_AddTimer(asEntityName, 2.f, "OnTimer_SetEndChaseGhoulReady");
		 }
         
         //-------------------------------------------------------
         
         bool OnTrigger_EndChaseFall(const tString &in asParent, const tString &in asChild, int alState)
         {
			 FearHandler_TriggerPermaFail_Fall();
             return false;
         }
         
         //-------------------------------------------------------
         
         bool OnTrigger_EndChaseDoorScare(const tString &in asParent, const tString &in asChild, int alState)
         {
             Seq_EndChaseDoorScare("");
             return false;
         }
         
         //-------------------------------------------------------
         
         cSequenceStatesData mSequenceEndChaseDoorScareData;
         void Seq_EndChaseDoorScare(const tString &in asTimer)
         {
             Sequence_Begin("Seq_EndChaseDoorScare", mSequenceEndChaseDoorScareData);
			 Sequence_Wait(0.5f);
			 if (Sequence_DoStepAndWait(0.9f))	
             {
				 DoEndChaseDoorScareBang(cVector3f(0.f, 0.f, -5.f));
				 FearHandler_SetForcedAddFearRate(0.35f, 2.f, true);
				 
				 Prop_SetHealth("EndChaseScareDoor", 0.7f);
             }
             else if (Sequence_DoStepAndWait(1.3f))	DoEndChaseDoorScareBang(cVector3f(0.f, 0.f, 3.f));
             else if (Sequence_DoStepAndWait(0.9f))	DoEndChaseDoorScareBang(cVector3f(0.f, 0.f, -4.f));
             else if (Sequence_DoStepAndWait(1.2f))	DoEndChaseDoorScareBang(cVector3f(0.f, 0.f, 5.f));
             else if (Sequence_DoStepAndWait(1.5f))	DoEndChaseDoorScareBang(cVector3f(0.f, 0.f, -6.f));
             Sequence_End();
         }
		 
		 //-------------------------------------------------------
		 
		 void DoEndChaseDoorScareBang(const cVector3f &in avImpulse)
		 {
			 Sound_CreateAtEntity("Sound_BreakDoor", "level_entity_shared/doors/tin_hinan_door/tin_hinan_door_hit", "EndChaseScareDoor");
			 
			 ParticleSystem_CreateAtEntity("PS_DoorBreak", "smoke_oneshot_brbreak_rock_door.ps", "EndChaseScareDoor", false);
			 Body_AddImpulse("EndChaseScareDoor_Body_1", avImpulse, true);
		 }
         
         //-------------------------------------------------------
		 
		 bool OnTrigger_SetupGrateEndChaseGhoul(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 /////////////////
			 // Set up grate ghoul!
			 Entity_SetActive("Ghoul_EndChase_3", true);			 
			 Map_AddTimer("Ghoul_EndChase_3", 0.1f, "OnTimer_GrateEndChaseGhoulClimb");
			 Map_AddTimer("Ghoul_EndChase_3", 2.6f, "OnTimer_PauseGrateEndChaseGhoul");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_GrateEndChaseGhoulClimb(const tString &in asTimer)
		 {
			 Pathfinder_MoveToNode(asTimer, "PathNodeArea_890", "OnPathfinderMove_GrateEndChaseGhoul");
		 }
         
         //-------------------------------------------------------
		 
		 void OnTimer_PauseGrateEndChaseGhoul(const tString &in asTimer)
		 {
			 Entity_SetActive("Ghoul_EndChase_3", false);
		 }
		 
		 //-------------------------------------------------------
         
         bool OnTrigger_ActivateGrateEndChaseGhoul(const tString &in asParent, const tString &in asChild, int alState)
         {			 
			 ////////////////////////////
			 // Break grate
			 Entity_SetCollide("EndChaseGrate", false);
			 Joint_Break("EndChaseGrate_JointHinge_1");
			 Body_AddImpulse("EndChaseGrate_Body_1", cVector3f(0.f, 5.f, 5.f), false);
			 Map_GetEntity("EndChaseGrate").GetBody(0).AddTorque(cVector3f(0.f, 500.f, 0.f));
			 Map_AddTimer("Timer_SetEndChaseGrateCollide", 0.1f, "OnTimer_SetEndChaseGrateCollide");

			 Entity_SetActive("BlockBox_ChaseGrate", true);
			 
			 FearHandler_SetForcedAddFearRate(0.35f, 2.f, true);
			 
			 Sound_CreateAtEntity("EndChaseGrateSound_1", "03_06_ghouls_nest/chase_sequence/ghoul_chase_grate_climb", "EndChaseGrate");
             Sound_CreateAtEntity("EndChaseGrateSound_2", "03_06_ghouls_nest/chase_sequence/ghoul_chase_grate_open", "EndChaseGrate");
			 
			 ////////////////////////////
			 // Reactivate grate climber!
			 Entity_SetActive("Ghoul_EndChase_3", true);
			 cLux_ToAgent(Map_GetEntity("Ghoul_EndChase_3")).GetCharBody().SetActive(false);
			 
			 PlayChaseRunEmote(2, 0.6f);
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnPathfinderMove_GrateEndChaseGhoul(const tString &in asEntityName, bool abReachedEnd)
		 {
			 Entity_SetActive("BlockBox_ChaseGrate", false);
			 
			 cLux_ToAgent(Map_GetEntity("Ghoul_EndChase_3")).GetCharBody().SetActive(true);
			 Agent_SetSensesActive(asEntityName, true);
			 
			 if (Blackboard_GetAgentCount() > 2)
				 DeactivateFarthestEndChaseGhoul(3);
			 
			 Map_AddTimer(asEntityName, 2.f, "OnTimer_SetEndChaseGhoulReady");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetEndChaseGrateCollide(const tString &in asTimer)
		 {
			 Entity_SetCollide("EndChaseGrate", true);			 
		 }
         
         //-------------------------------------------------------
		 
		 bool OnTrigger_Player_CommonRoomTunnel(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 tString sGhoul = "Ghoul_EndChase_";
			 
			 if (alState == 1)
			 {
				 /////////////////////////////////
				 // All ghouls leave, except one who stays back
				 for (int i = 1; i <= mlEndChaseGhoulCount; i++)
				 {
					 if (Entity_IsActive(sGhoul + i) == false) continue;
					 
					 if (i == 3)
					 {
						 Ghoul_Mode_Set(sGhoul + i, eGhoulMode_Idle);
						 Ghoul_CommandRetreat_Execute(sGhoul + i, true, true);
						 continue;
					 }
					 
					 Ghoul_Mode_Set(sGhoul + i, eGhoulMode_Idle);
					 Agent_SetAutoDisableWhenOutOfSightActive(sGhoul + i, true, 10.f);
					 Ghoul_CommandRetreat_Execute(sGhoul + i, true, true);
				 }

				 Blackboard_SetCheckCollisionCourse(false);
				 return true;
			 }
			 
			 /////////////////////////////////
			 // Player exited tunnel, resume hunt!
			 Ghoul_Command_Remove("Ghoul_EndChase_3", true);
			 SetEndChaseGhoulChaseReady("Ghoul_EndChase_3");
			 Blackboard_SetCheckCollisionCourse(true);
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Run to the Tin Hinan Common Room*
		 
		 /////////////////////////////////////////
		 // Event B *Enter the Tin Hinan Common Room*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event B here.*/
		 
		 bool mbEquipLanternAfterLanding = false;
		 bool mbCommonRoomGhoulSpawned = false;
		 bool mbUnlockedCommonRoomDoor = false;
		 int mlPauseGhoulEmergeStage = 0;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event B here.*/
		 
		 bool OnTrigger_EnterCommonRoom(const tString &in asParent, const tString &in asChild, int alState)
		 {             
             Entity_SetActive("Ghoul_EndChase*", false);
			
			 Music_Stop(4.0, eMusicPrio_OverrideAll);
			 Music_PlayExt("A2_3_6_GhoulNestEvent_Alt", true, 0.2f, 1, 1.5f, 0, eMusicPrio_OverrideAll, true);
			 
			 Blackboard_SetCheckCollisionCourse(true);
			 
			 msEndChasePermaFailArea = "PermaFail_CommonRoomTunnel";
			 
			 Sound_CreateAtEntity("Sound_Land", "player/foley/damage/player_fall_damage", "player");
			 
			 if (Item_GetHeldType(eItemHandlerHand_Left) == "Lantern")
				 mbEquipLanternAfterLanding = true;
			 
			 Item_PutAway(eItemHandlerHand_Right);
			 Item_PutAway(eItemHandlerHand_Left);
			 
			 //////////////////////////
			 // Play land anim
			 float fDist = 0.f;
			 cVector3f vNrm = 0.f;
			 cVector3f vPos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
			 
			 cLux_GetClosestBody(vPos, cVector3f_Down, 1.f, fDist, vNrm);
			 vPos -= cVector3f(0.f, fDist, 0.f);
			 
			 // Play at an entity if the distance is large s othe player can't fall through the world!
			 if (fDist > 2.f)
				 PlayerBody_PlayCutsceneAtEntity("fall_and_get_up_quickly", "Area_CommonRoomLandAnim", false, 0.5f, "OnAnimEnd_CommonRoomLand");
			 else
				PlayerBody_PlayCutsceneAnimation("fall_and_get_up_quickly", false, 0.3f, "OnAnimEnd_CommonRoomLand", 1.f, 0.f, true, vPos, cLux_GetPlayer().GetCharacterBody().GetYaw());
				
			 Voice_PlayDelayed("Dialogue_RunPause", 0.1f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_CommonRoomLand(const tString &in asAnim)
		 {
			 if (mbEquipLanternAfterLanding)
				 Item_Equip(ItemType_GetFirstInInventory("Lantern"));
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_StartResumeChase(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_AddTimer("Timer_ResumeChase", 12.f, "OnTimer_ResumeChase");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ResumeChase(const tString &in asTimer)
		 {
			 ///////////////////////
			 // Create sounds!
			 if (mlPauseGhoulEmergeStage == 0)
			 {
				 Sound_Play("Sound_PauseGhoulCrawl", 1.f);
				 Sound_Play("Sound_PauseGhoulApproach", 1.f);
			 }			 
			
			 ///////////////////////
			 // Sounds grow stronger...	
			 int lMaxStage = 8;
			 mlPauseGhoulEmergeStage++;
			 
			  // Jump to stage 5 if the player has unlocked the door!
			 if (mbUnlockedCommonRoomDoor && mlPauseGhoulEmergeStage < lMaxStage - 2)
				 mlPauseGhoulEmergeStage = lMaxStage - 2;
				
			 float fVol = float(mlPauseGhoulEmergeStage) / float(lMaxStage);
			
			 Sound_Fade("Sound_PauseGhoulCrawl", fVol, 1.f);
			 Sound_Fade("Sound_PauseGhoulApproach", fVol, 1.f);
			 Sound_SetParam("Sound_PauseGhoulApproach", 0, fVol);
			
			 if (mlPauseGhoulEmergeStage % 3 == 0)
				 Sound_CreateAtEntity("Sound_PauseGhoulCrawlSweet", "creatures/foley/creature/ghoul/ghoul_hole/ghoul_wall_sound_sweet", "Area_CommonRoomTunnelExit", 0.f, false, fVol);
			 if (mlPauseGhoulEmergeStage == 4)
				 Sound_CreateAtEntity("Sound_PauseGhoulScream", "03_06_ghouls_nest/collapsed_tunnel_sweet/ghoul_tunnel_ghoul", "Area_CommonRoomTunnelExit");
			 
			 ///////////////////////
			 // Spawn ghoul!
			 if (mlPauseGhoulEmergeStage == lMaxStage - 2)
			 {				 
				 mbCommonRoomGhoulSpawned = true;
			 
				 Entity_SetActive("Ghoul_EndChase_4", true);
				 FearThreatAgent_SetComponentEnabled("Ghoul_EndChase_4", false);
				 
				 Agent_PlayCutsceneAnimation("Ghoul_EndChase_4", "drop_from_tunnel_chase", 0.f, false, "OnAnimEnd_CommonRoomGhoul", 1.f, 0.f, false, 0.f, 0.f, false, true);
			 }
			 
			 // Ghoul at hole soon!
			 if (mlPauseGhoulEmergeStage == lMaxStage - 1)
			 {
				 Map_AddTimer("Timer_DoPauseGhoulAtHoleEffects", 0.4f, "OnTimer_DoPauseGhoulAtHoleEffects");
			 }
			 
			 ////////////////////////
			 // Ghoul sitting in exit, sequence done!
			 if (mlPauseGhoulEmergeStage == lMaxStage)
			 {				 
				 Map_AddTimer("Timer_PauseGhoulLeaveHole", 2.f, "OnTimer_PauseGhoulLeaveHole");
				 
				 Sound_Stop("Sound_PauseGhoulCrawl", 1.f);
				 Sound_Stop("Sound_PauseGhoulApproach", 1.f);
				 
				 Voice_PlayDelayed("Dialogue_RunRestarts", 1.f);
				 return;
			 }				 
			
			 Map_AddTimer("Timer_ResumeChase", 1.f, "OnTimer_ResumeChase");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoPauseGhoulAtHoleEffects(const tString &in asTimer)
		 {
			 FearThreatAgent_SetComponentEnabled("Ghoul_EndChase_4", true);
			
			 ParticleSystem_CreateAtEntity("PS_EmergePS", "dust_impact_med_oneshot.ps", "Area_CommonRoomTunnelPS", false).SetBrightness(0.08f);
			 
			 Sound_CreateAtEntity("Sound_PauseGhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_exit_hole", "Area_CommonRoomTunnelExit");
			 Sound_CreateAtEntity("Sound_PauseGhoulEmerge", "03_06_ghouls_nest/chase_sequence/ghoul_chase_tunnel_emerge", "Area_CommonRoomTunnelExit");
			 
			 Music_PlayExt("A2_NPC_GhoulNestChase", true, 1.0f, 1, 5.0f, 0, eMusicPrio_OverrideAll, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PauseGhoulLeaveHole(const tString &in asTimer)
		 {
			 Sound_CreateAtEntity("Sound_PauseGhoulLeaveHole", "creatures/foley/creature/ghoul/ghoul_hole/ghoul_exit_hole", "Area_CommonRoomTunnelExit");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_ChasePauseDoor(const tString &in asEntity)
		 {
			 mbUnlockedCommonRoomDoor = true;
			 
			 if (mbCommonRoomGhoulSpawned == false)
			 {
				 Map_RemoveTimer("Timer_ResumeChase");
				 Map_AddTimer("Timer_ResumeChase", 0.1f, "OnTimer_ResumeChase");
			 }
		 }
		 
