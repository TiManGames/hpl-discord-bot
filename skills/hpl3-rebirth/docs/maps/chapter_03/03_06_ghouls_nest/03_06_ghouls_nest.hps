		 /////////////////////////////////////////
		 // Event F *Enter the Sleeping Hall Tunnel*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event F here.*/
         
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event F here.*/
         
		 bool OnTrigger_Player_EnterSleepingHallTunnel(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 tString sGhoul = "";
			 array<tString> vGhouls = { msSleepingHallGhoul, "Ghoul_SleepingHallAlert_1" };
			 for (int i = 0; i < vGhouls.size(); i++)
			 {
				 sGhoul = vGhouls[i];
				 if (Entity_IsActive(sGhoul) == false) continue;
				 
				 Ghoul_Command_Remove(sGhoul, true);
				 Ghoul_CommandGoToHole_Execute(sGhoul, Map_GetEntity(sGhoul).GetPosition(), true, false, true, true, eGhoulSpeed_FastWalk);
			 }
			 
			 Entity_SetActive("Sleeper_SleepingHall_*", false);
			 Entity_SetActive("Sleeper_Hatch_*", false);
			 Entity_SetActive("Ghoul_Hatch_*", false);
			 FearArea_SetUnsafeMusic("Fear_SleepingHall", "");
			 
			 Entity_SetActive("FearThreat_Bathhouse_*", false);
			 Entity_SetActive("FearScaryObject_Flesh_*", false);
			 Entity_SetActive("FearThreat_SleepingHall*", false);		 
			 Entity_SetActive("FearThreat_SleepingHallTunnel_*", true);
			 Music_Stop(8.0f, eMusicPrio_SceneAmb);
			 
			 FearHandler_SetPaused(false);
			 return false;
		 }
         
		 //-------------------------------------------------------
	 
		 //} END Event F *Enter the Sleeping Hall Tunnel*
         
         /////////////////////////////////////////
		 // Event G *Wake up in sleeping ghoul alcove*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event G here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event G here.*/
         
         bool OnPermaFail_SleepingHallAlcove(const tString &in asSource)
         {
			 Entity_SetActive(asSource, false);
			 
			 if (mbSleepingHallGhoulWokenUp)
			 {
				 Entity_SetActive("Trigger_ResetSleepingHallGhoul", true);
				 Entity_SetActive("Trigger_StartSeqTHGuide_*", false);
				 Entity_SetActive("TH_Guide", false);
				 SwingDoor_SetClosed("SleepingHallDoor", true, true);
				 
				 Entity_SetActive(msSleepingHallGhoul, false);
			 }
			 
			 Entity_SetActive("Sleeper_SleepingHall_2", false);
			 Entity_SetActive("Ghoul_SleepingHallAlert_1", false);
			 
			 SleepingGhoul_Reset("Sleeper_SleepingHall_*");
			 
			 if (mbTriggeredHatchScare)
			 {
				 Entity_SetActive("Ghoul_Hatch_*", false);
				 Entity_SetActive("Sleeper_Hatch_*", false);
			 }
			 
			 SetupGenericPermaFail();
			 
			 mlPermaFailStage = eGhoulsNestPermaFailStage_SleepingHallScuffle;
			 FearHandler_SetPermaFailRespawnArea("PermaFail_SleepingHallAlcove");
			 return true;
         }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ResetSleepingHallGhoul(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_RemoveTimer("Timer_SleepingHallGhoulLeave");
			 
			 Entity_SetActive(msSleepingHallGhoul, true);
			 
			 Agent_SetSensesActive(msSleepingHallGhoul, true);
			 Ghoul_SetSmellingActive(msSleepingHallGhoul, false);
			 
			 Agent_TeleportFeetToEntity(msSleepingHallGhoul, "Area_SleepingHallGhoulReset");
			 cLux_ToAgent(Map_GetEntity(msSleepingHallGhoul)).GetCharBody().StopMovement();
			 
			 Agent_ResetPlayerDetectionState(msSleepingHallGhoul);
			 
			 Ghoul_CommandPatrol_ClearNodes(msSleepingHallGhoul);
			 Ghoul_CommandPatrol_AddNode(msSleepingHallGhoul, "PathNodeArea_154");
			 Ghoul_CommandPatrol_Execute(msSleepingHallGhoul, true, 1, false, eGhoulSpeed_Walk);
			 
			 Sound_CreateAtEntity("Sound_SleepingGhoulReset", "creatures/vocalisations/creature/ghoul/ghoul_search", msSleepingHallGhoul);
			
			 Map_AddTimer("Timer_ResetSleepingHallGhoul", 4.f, "OnTimer_ResetSleepingHallGhoul");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ResetSleepingHallGhoul(const tString &in asTimer)
		 {			 
			 Ghoul_SetSmellingActive(msSleepingHallGhoul, true);			 
			 SetupSleepingHallGhoulPatrol();
		 }
         
		 //-------------------------------------------------------
	 
		 //} END Event G *Wake up in sleeping ghoul alcove*
         
         /////////////////////////////////////////
		 // Event H *Dragged away, escape when SLEEPING HALL GHOUL gets distracted (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event H here.*/
		 
		 //int mlFightDofId = -1;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event H here.*/
         
         /*void DeathScenario_OnDeath_SleepingHallFight(const tString &in asSource)
         {    
			 SleepingGhoul_Reset("Sleeper_SleepingHall_*");		
			 
             Entity_SetActive(msSleepingHallGhoul, true);
			 Entity_SetActive(msSleeperSleepingHallGhoul, false);
			 
             Map_RemoveTimer("Timer_SleepingHallGhoulLeave");
			 Map_RemoveTimer("Timer_SleepingHallGhoulSniff");
             
             Entity_SetActive("Trigger_SleepingHallFight", true);             
			 
			 Entity_SetActive("SleepingHallHoleBlocker_1", false);
			 Entity_SetActive("FearThreat_SleepingHallHole_1", true);
			 
			 SwingDoor_SetOpenAmount("SleepingHallDoor_3", 0.8f);
			 
			 Death_PickRespawnArea("DeathArea_SleepingHallFight");
			 Death_SetRespawnCallback("OnRespawn_SleepingHallFight");             
         }
		 
		 //-------------------------------------------------------
		 
		 bool OnRespawn_SleepingHallFight(const tString &in asSource)
		 {
			 Sequence_SleepingHallFight("");
			 return true;
		 }
         
         //-------------------------------------------------------
		 
         cSequenceStatesData mSequenceSleepingHallFightData;
         void Sequence_SleepingHallFight(const tString &in asTimer)
         {
             Sequence_Begin("Sequence_SleepingHallFight", mSequenceSleepingHallFightData);
             if (Sequence_DoStepAndWait(4.f))
			 {
				 Effect_Fade_Out(0.15f);
			 }
			 else if (Sequence_DoStepAndWait(0.25f))
             {				 
				 Pathfinder_Stop(msSleepingHallGhoul);
				 Pathfinder_Track_Stop(msSleepingHallGhoul);
				 Ghoul_Mode_Set(msSleepingHallGhoul, eGhoulMode_Idle, true);
				 Ghoul_Command_Remove(msSleepingHallGhoul);
				 
				 Agent_SetSensesActive(msSleepingHallGhoul, false);
				 
				 Death_ResetPlayerToNormal();
             }
			 else if (Sequence_DoStepAndWait(0.25f))
			 {
				 Effect_ImageTrail_Start(1.f, 0.f, 5.f, 2.f);
				 mlFightDofId = Effect_DoF_Start(0.f, 0.1f, 0.025f, 1.f);
				 
				 // Make sure the player is placed and oriented correctly before attaching to the ghoul
				 PlayerBody_PlayCutsceneAtEntity("dragged_by_ghoul", "Area_DraggedByGhoulAnimStart", true, 0.f);
			 }
             else if (Sequence_DoStepAndWait(1.f))
             {
                 // Setup event
                 Agent_TeleportFeetToEntity(msSleepingHallGhoul, "SleepingHallFightDeathPosArea",false);
                 Agent_FaceEntity(msSleepingHallGhoul, "Trigger_SleepingHallFight");
				 
				 Ghoul_ModePatrol_ClearNodes(msSleepingHallGhoul);
				 Ghoul_ModePatrol_AddNode(msSleepingHallGhoul, "PathNodeArea_840");
				 Ghoul_ModePatrol_Setup(msSleepingHallGhoul, false);
				 Ghoul_Mode_Set(msSleepingHallGhoul, eGhoulMode_Patrol, true);    
				 
				 PlayerBody_PlayCutsceneAnimation("dragged_by_ghoul", true, 0.f);
                 Entity_AttachToEntity("player", msSleepingHallGhoul, "", false);

				 FearHandler_SetPaused(true);				 				 
             }
             else if (Sequence_DoStepAndPause(0.f))
             {
                 Effect_Fade_In(2.f);
             }
             else if (Sequence_DoStepAndWait(0.1f))
             {
                 Entity_SetActive(msSleepingHallFightGhoul, true);
             }
             else if (Sequence_DoStepAndWait(1.f))
             {
				 Effect_DoF_FadeOut(mlFightDofId, 2.f);
				 
                 // FIGHT GHOUL emerges
				 Ghoul_CommandEmergeFromHole_Execute(msSleepingHallFightGhoul, "SleepingHallHole_2", true);
             }
             else if (Sequence_DoStepAndWait(3.f))
             {
                 // SLEEPING HALL GHOUL notices FIGHT GHOUL and stops dragging player
                 Pathfinder_Stop(msSleepingHallGhoul);
                 
                 // Player regains control
				 cVector3f vPos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
				 PlayerBody_PlayCutsceneAnimation("dragged_by_ghoul_exit", false, 0.3f, "OnAnimOver_DraggedByGhoul", 1.f, 0.f, true, vPos, cMath_ToRad(249.f));
                 Entity_RemoveEntityAttachment("player");
				 
				 Player_SetCrouching(true, true, true);
             }
             else if (Sequence_DoStepAndWait(5.f))
             {
                 // Fight begins
                 Entity_SetActive("Trigger_SleepingHallFightArea", true);
                 
                 Blackboard_SetProximityEventsActive(true);
                 Blackboard_SetCheckCollisionCourse(false);
                 Blackboard_ForceProximityEvent(Map_GetEntity(msSleepingHallGhoul, eLuxEntityType_Agent).GetID(), 
                                                Map_GetEntity(msSleepingHallFightGhoul, eLuxEntityType_Agent).GetID(), 
                                                eAgentProximityEvent_GhoulFight);
												
             }
             else if (Sequence_DoStepAndWait(2.5f))
             {
                 Blackboard_SetProximityEventsActive(false);
                 
                 // FIGHT GHOUL leaves
                 Entity_StopAnimation(msSleepingHallFightGhoul);
				 Ghoul_CommandGoToSpecificHole_Execute(msSleepingHallFightGhoul, "SleepingHallHole_2", true, false, true, eGhoulSpeed_FastWalk, "");
             }
             else if (Sequence_DoStepAndWait(0.5f))
             {
                 // SLEEPING HALL GHOUL looks for player
                 CharMover_SetDynamicObjectAvoidanceActive(msSleepingHallGhoul, false);
                 Agent_SetSensesActive(msSleepingHallGhoul, true);
             }
             else if (Sequence_DoStepAndWait(2.f))
             {
                 Entity_SetActive("Trigger_SleepingHallFightArea", false);
             }
             else if (Sequence_DoStepAndWait(1.f))
             {
                 Blackboard_SetCheckCollisionCourse(true);
                 CharMover_SetDynamicObjectAvoidanceActive(msSleepingHallGhoul, true);
                 Map_AddTimer("Timer_SleepingHallGhoulLeave", 30.f, "OnTimer_SleepingHallGhoulLeave");
             }
			 else if (Sequence_DoStepAndContinue())
			 {
				 OnTimer_SleepingHallGhoulPatrol("");
				 
				 FearHandler_SetPaused(false);
			 }
             Sequence_End();
         }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimOver_DraggedByGhoul(const tString &in asAnim)
		 {
			 Map_AddTimer("Timer_ResetPlayerAfterDrag", 0.1f, "OnTimer_ResetPlayerAfterDrag");			 
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ResetPlayerAfterDrag(const tString &in asTimer)
		 {
			 Death_ResetPlayerToNormal();
			 Player_ChangeStateToNormal();
		 }
		 		 
		 //-------------------------------------------------------
         
         bool OnTrigger_SleepingHallFight(const tString &in asParent, const tString &in asChild, int alState)
         {
             SequenceStates_Resume("Sequence_SleepingHallFight");
             return false;
         }
         
         //------------------------------------------------------
         
         bool OnTrigger_SleepingHallFightArea(const tString &in asParent, const tString &in asChild, int alState)
         {
			 if (FearHandler_GetIsPermaFailing())
			    return true;
			 
             SequenceStates_Stop("Sequence_SleepingHallFight");
			 
			 Agent_SetSensesActive(msSleepingHallGhoul, true);
			 Agent_SetSensesActive(msSleepingHallFightGhoul, true);
			 Agent_RevealPlayerPosition(msSleepingHallGhoul);
			 Agent_RevealPlayerPosition(msSleepingHallFightGhoul);
			 
			 FearHandler_SetPaused(false);
             return false;
         }*/
		 
		 //-------------------------------------------------------
	 
		 //} END Event H *Dragged away, escape when SLEEPING HALL GHOUL gets distracted (PERMAFAIL)*
         
		 /////////////////////////////////////////
		 // Event I *Wake up, ghouls gone, suffer alcove scare* (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event I here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event I here.*/
         
         bool OnPermaFail_SleepingHallScuffle(const tString &in asSource)
         {			 
			 Entity_SetActive(asSource, false);
			 Entity_SetActive(msSleepingHallGhoul, false);
			 Entity_SetActive(msSleepingHallFightGhoul, false);
			 Entity_SetActive("Ghoul_SleepingHallAlert_*", false);
			 
			 Entity_SetActive("Sleeper_SleepingHall_*", false);
             Entity_SetActive("Trigger_StartSeqAlcoveScare*", true);
			 Entity_SetActive("SleepingHallExitBlocker", false);
             
             mbSleepingHallEncounterOver = true;
             mbSleepingHallGhoulsGone = true;
			 
			 if (mbTriggeredHatchScare)
			 {
				 Entity_SetActive("Ghoul_Hatch_*", false);
				 Entity_SetActive("Sleeper_Hatch_*", false);
			 }
             
             Map_RemoveTimer("Timer_SleepingHallGhoulLeave");
			 
			 tString sArea = "PermaFail_SleepingHallScuffle";
			 if (mbEnteredHatchScareArea == false)
			 {
				 mbEnteredHatchScareArea = true;
				 sArea = "PermaFail_SleepingHallHatchScare";
			 }
			 
			 SetupGenericPermaFail();
			 
			 mlPermaFailStage = eGhoulsNestPermaFailStage_SleepingHallFinal;
			 FearHandler_SetPermaFailRespawnArea(sArea);
			 return true;		 
         }
         
         //-------------------------------------------------------
         
         bool OnTrigger_Player_StartSeqAlcoveScare(const tString &in asParent, const tString &in asChild, int alState)
         {
			 Map_AddTimer("Timer_StartSeqAlcoveScare", 0.3f, "Seq_AlcoveScare");
             return false;
         }
         
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSequenceAlcoveScareData;
		 void Seq_AlcoveScare(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_AlcoveScare", mSequenceAlcoveScareData);
			 if (Sequence_DoStepAndWait(0.2f))
			 {
				 ParticleSystem_CreateAtEntity("PS_AlcoveScare", "dust_impact_simple_oneshot.ps", "SoundArea_AlcoveScare_1", false);
				 Sound_CreateAtEntity("Sound_AlcoveScare", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", "SoundArea_AlcoveScare_1");
			 }
			 else if (Sequence_DoStepAndWait(0.1f))
			 {
				 Body_AddImpulse("AlcoveScareDebris_2_corpses_hipbone_fractured_Prop_Rigid", cVector3f(3.f, 0.f, 0.f), false);
				 FearHandler_SetForcedAddFearRate(0.3f, 7.f, true, -1.f, 0.05f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Body_AddImpulse("AlcoveScareDebris_1_Body_1", cVector3f(2.5f, 1.f, 0.f), false);
			 }
			 else if (Sequence_DoStepAndWait(5.f))
			 {
				 Sound_CreateAtEntity("Sound_AlcoveScareWhisper", "creatures/vocalisations/creature/ghoul/ghoul_stalk_whisper", "SoundArea_AlcoveScare_2");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Sound_CreateAtEntity("Sound_AlcoveScareWhisper", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", "SoundArea_AlcoveScare_2");
			 }
			 Sequence_End();
		 }
		 
         //-------------------------------------------------------
	 
		 //} END Event I *Wake up, ghouls gone, suffer alcove scare (PERMAFAIL)*
		 
		 /////////////////////////////////////////
		 // Event J *Wake up in a sleeping ghoul pose*
		 //{//////////////////////////////////////w
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event K here.*/
		 	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event K here.*/
         
         bool OnPermaFail_SleepingHallFinal(const tString &in asSource)
         {
			 if (cString_Sub(asSource, 0, 11) == "Ghoul_Hatch")
			 {
				 Entity_SetActive("Ghoul_Hatch_*", false);
				 Entity_SetActive("Sleeper_Hatch_*", false);
			 }
			 
			 SetupGenericPermaFail();
			 
			 Entity_SetActive("Ghoul_Hatch_*", false);
			 Entity_SetActive("Sleeper_Hatch_*", false);			 
		     Entity_SetActive("SleepingHallExitBlocker", false);			 
		
			 FearHandler_SetPermaFailRespawnArea("PermaFail_SleepingHallFinal");
			 return true;
         }
         
		 //-------------------------------------------------------
	 
		 //} END Event K *Wake up in a sleeping ghoul pose*
	 
	 //} END SCENE 3
     
     //////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 4 *CRAWL THROUGH THE SLEEPING HALL GHOUL TUNNEL*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 4 here.*/
        
        array<tString> mvTunnelScareAreas;
        float mfTunnelScareTimeMin = 10.f;
        float mfTunnelScareTimeMax = 20.f;
        
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 4 here.*/
        
		bool OnTrigger_Player_ForceCrawl(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) return true;
			
			bool bInFront = Entity_PlayerIsInFront(asParent);
			
			Player_SetStandDisabled(bInFront);
			Player_SetJumpDisabled(bInFront);
			
			if (bInFront == false)
				Player_SetCrouching(false, false, false);
			
			return true;
		}
		
		//-------------------------------------------------------
		
        void OnTimer_PlayTunnelScare(const tString &in asTimer)
        {
			if (FearHandler_GetIsPermaFailing() || mbCaughtByTunnelCollapseGhoul)
				return;
			
            for (int i = 0; i < mvTunnelScareAreas.size(); i++)
            {                
                if (Map_TimerExists(mvTunnelScareAreas[i] + "_RecentlyUsed")) continue;
                
                float fSqrLength = Entity_GetDeltaToEntity(mvTunnelScareAreas[i], "player").SqrLength();
                if (fSqrLength > 14.f * 14.f || fSqrLength < 7.f * 7.f || Entity_IsInPlayerFOV(mvTunnelScareAreas[i]))
                    continue;
                
				tString sSound = cMath_RandRectl(0, 2) == 2  ? "03_06_ghouls_nest/collapsed_tunnel_sweet/ghoul_tunnel_ghoul" : 
															   "03_06_ghouls_nest/collapsed_tunnel_sweet/ghoul_tunnel_rock";
				
                Sound_CreateAtEntity("Sound_TunnelScare", sSound, mvTunnelScareAreas[i], 0.f, false, 0.3f);
                Map_AddTimer(mvTunnelScareAreas[i] + "_RecentlyUsed", 120.f, "");
				
				FearHandler_SetForcedAddFearRate(0.1f, 5.f, false, -1.f, 0.02f);
				break;
            }
            
            ResetTunnelScareTimer();
        }
        
        //-------------------------------------------------------
        
        void ResetTunnelScareTimer()
        {
            Map_RemoveTimer("Timer_PlayTunnelScare");
            Map_AddTimer("Timer_PlayTunnelScare", cMath_RandRectf(mfTunnelScareTimeMin, mfTunnelScareTimeMax), "OnTimer_PlayTunnelScare");
        }
		
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Start hearing noises*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event A here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event A here.*/
         
         bool OnTrigger_Player_TunnelScuffleScare(const tString &in asParent, const tString &in asChild, int alState)
         {
			 if (FearHandler_GetIsPermaFailing())
				 return true;
			 
             Map_AddTimer("Timer_TunnelScuffleScare", 0.2f, "OnTimer_TunnelScuffleScare");
             return false;
         }
         
         //-------------------------------------------------------
         
         void OnTimer_TunnelScuffleScare(const tString &in asTimer)
         {
             Sound_CreateAtEntity("Sound_TunnelScuffleScare", "03_06_ghouls_nest/events/tunnel_jar_scare", "Area_TunnelScuffleScare_1", 0.f, false, 0.3f);
             ParticleSystem_CreateAtEntity("PS_TunnelScuffleScare", "dust_impact_simple_oneshot.ps", "Area_TunnelScuffleScare_1", false).SetColor(cColor(0.846,0.621,0.505,1));
             
			 Prop_SetStaticPhysics("ScuffleAmphora", false);
			 Body_AddImpulse("ScuffleAmphora_Body_1", cVector3f(1.f, 0.f, 0.f), false);
			 
             ResetTunnelScareTimer();
			 
			 FearHandler_SetForcedAddFearRate(0.1f, 5.f, true, -1.f, 0.02f);
			 
			 FearArea_SetUnsafeMusic("Fear_1", "fear_system_danger_01");
         }
    	 
		 //-------------------------------------------------------
	 
		 //} END Event A *Start hearing noises*
		 
		 /////////////////////////////////////////
		 // Event B *Movement from above causes wall/ceiling crumble*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event B here.*/
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *Movement from above causes wall/ceiling crumble*
		 
		 /////////////////////////////////////////
		 // Event C *Catch glimpse of TUNNEL SCARE GHOUL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event C here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event C here.*/
         
         bool OnTrigger_Player_ActivateTunnelScareGhoul(const tString &in asParent, const tString &in asChild, int alState)
         {
			 int lSuffix = cString_GetNumericSuffixInt(asParent);
			
			 Entity_SetActive("Trigger_ActivateTunnelScareGhoul_*", false);
			 
			 if (lSuffix == 2)
				 return false;
			 			 
             tString sGhoul = "Ghoul_TunnelScare";			 
             Entity_SetActive(sGhoul, true);			 
			 cLux_ToAgent(Map_GetEntity(sGhoul)).GetCharBody().SetTestCollision(false);
			 CharMover_SetUseMoveStateAnimations(sGhoul, false);
		
			 tString sAnim = "crawl_custom_glimpse_" + (lSuffix == 1 ? "a" : "b");
			 
			 Entity_PlayAnimation(sGhoul, sAnim, 0.f, false, false, "", true);
			 Entity_SetAnimationSpeed(sGhoul, sAnim, 1.25f);
			 
			 Sound_CreateAtEntity("Sound_TunnelScareVox", "creatures/vocalisations/creature/ghoul/ghoul_idle", sGhoul, 0.f, false, 0.3f);
			 ParticleSystem_CreateAtEntity("PS_Scuffle", "dust_impact_simple_oneshot.ps", sGhoul, false).SetColor(cColor(0.846,0.621,0.505,1));
			 
			 Map_AddTimer(sGhoul, 3.5f, "OnTimer_DeactivateTunnelScareGhoul");
			 
			 FearHandler_SetForcedAddFearRate(0.5f, 5.f, true, -1.f, 0.1f, 0.6f);
			 
             ResetTunnelScareTimer();
             return false;
         }
		 		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DeactivateTunnelScareGhoul(const tString &in asTimer)
		 {
			 Entity_SetActive(asTimer, false);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *Catch glimpse of TUNNEL SCARE GHOUL*
         
         /////////////////////////////////////////
		 // Event D *Noises and movement all around the player increases*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event D here.*/
		 
		 int mlTunnelScuffleScareId = 0;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event D here.*/
         
         bool OnTrigger_Player_StartSeqTunnelScuffleScare(const tString &in asParent, const tString &in asChild, int alState)
         {
			 if (FearHandler_GetIsPermaFailing())
				 return true;
			 
			 mlTunnelScuffleScareId = cString_GetNumericSuffixInt(asParent);
             Seq_TunnelScuffleScare("");
             Entity_SetActive("Trigger_StartSeqTunnelScuffleScare_*", false);
             return false;
         }
		 
		 //-------------------------------------------------------
         
         cSequenceStatesData mSequenceTunnelScuffleScareData;
         void Seq_TunnelScuffleScare(const tString &in asTimer)
         {
             Sequence_Begin("Seq_TunnelScuffleScare", mSequenceTunnelScuffleScareData);
             if (Sequence_DoStepAndWait(0.2f))
			 {
				 ParticleSystem_CreateAtEntity("PS_TunnelScuffle", "sand_falling_stream_small_oneshot.ps", "Area_ScufflePS_" + mlTunnelScuffleScareId, false);
				 ParticleSystem_SetColor("PS_TunnelScuffle", cColor(1,0.821,0.602,1));
			 }
             else if (Sequence_DoStepAndWait(0.3f))
             {
				 ResetTunnelScareTimer();
				 
                 Sound_CreateAtEntity("Sound_TunnelScuffleScare_1", "03_06_ghouls_nest/events/tunnel_brick_scare", "Area_TunnelScuffleScare_2", 0.f, false, 0.3f);
				 
				 Entity_SetActive("ScuffleBrick_" + mlTunnelScuffleScareId + "_1", true);
				 Entity_SetActive("ScuffleBrick_" + mlTunnelScuffleScareId + "_3", true);
				 
				 FearHandler_SetForcedAddFearRate(0.1f, 5.f, true, -1.f, 0.02f);		 
			 }
			 else if (Sequence_DoStepAndWait(4.f))
			 {
				 Entity_SetActive("ScuffleBrick_" + mlTunnelScuffleScareId + "_*", true);
			 }
             else if (Sequence_DoStepAndWait(0.2f))
             {
                 Sound_CreateAtEntity("Sound_TunnelScuffleScare_2", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", "Area_TunnelScuffleScare_3", 0.f, false, 0.3f);
             }
             Sequence_End();
         }
		 
		 //-------------------------------------------------------
	 
		 //} END Event D *Noises and movement all around the player increases*
         
         /////////////////////////////////////////
		 // Event E *Noises and movement from behind the player grows louder*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event E here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event E here.*/
         
         bool OnTrigger_Player_StartSeqTunnelMovementBehind(const tString &in asParent, const tString &in asChild, int alState)
         {
             Seq_TunnelMovementBehind("");
             return false;
         }
		 
		 //-------------------------------------------------------
         
         cSequenceStatesData mSequenceTunnelMovementBehindData;
         void Seq_TunnelMovementBehind(const tString &in asTimer)
         {
             Sequence_Begin("Seq_TunnelMovementBehind", mSequenceTunnelMovementBehindData);
             Sequence_Wait(1.f);
			 if (Sequence_DoStepAndWait(3.f))
             {
				 Sound_CreateAtEntity("Sound_TunnelEndScare_2", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", "SoundArea_TunnelEnd_1", 0.f, false, 0.3f);
				 
				 FearHandler_SetForcedAddFearRate(0.1f, 5.f, true, -1.f, 0.02f);				 
				 ResetTunnelScareTimer();
             }
             else if (Sequence_DoStepAndWait(2.f))
             {
                 Sound_CreateAtEntity("Sound_TunnelEndScare_3", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", "SoundArea_TunnelEnd_2", 0.f, false, 0.3f);
             }
             else if (Sequence_DoStepAndWait(2.f))
             {
                 Sound_CreateAtEntity("Sound_TunnelEndScare_4", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", "SoundArea_TunnelEnd_3", 0.f, false, 0.3f);
             }
             Sequence_End();
         }
         
         //-------------------------------------------------------
	 
		 //} END Event E *Noises and movement from behind the player grows louder*
         
         /////////////////////////////////////////
		 // Event F *Spot the light at the end of the tunnel*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event F here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event F here.*/
		 
		 bool OnTrigger_Player_SleepingHallTunnelExited(const tString &in asParent, const tString &in asChild, int alState)
         {
             Map_RemoveTimer("Timer_PlayTunnelScare");
			 
			 Entity_SetActive("Ghoul_Blocker_*", false);
			 Entity_SetActive("FearThreat_SleepingHall*", false);
			 Entity_SetActive("Sleeper_SleepingHall_*", false);
			 
			 Entity_SetActive("Sleeper_Courtyard_*", true);			 
			 SleepingGhoul_SetSensesActive("Sleeper_Courtyard_*", false);
			 Map_AddTimer("Timer_UpdateCourtyardSleep", 1.f / 60.f, "OnTimer_UpdateCourtyardSleep");
			 
			 Billboard_SetVisible("Billboard_13", false);
			 
			 FearHandler_SetUpdateInterval(1.f);
			 
			 FearArea_SetUnsafeMusic("Fear_1", "");
			 FearHandler_SetForcedAddFearRate(0.f, 0.f, false);
			 
			 Pregnancy_SetWhispering(false);
			 
			 Player_SetStandDisabled(false);
			 Player_SetJumpDisabled(false);
			 Player_SetCrouching(false, false, false);
			 
			 if (Oil_GetCount("ModernOil") > 1)
				 Entity_SetActive("oil_flask_modern_french_2", false);
			 
			// Map_AddTimer("Timer_PlayBarracksTunnelSounds", 6.f, "OnTimer_PlayBarracksTunnelSounds");
			
			 Music_RemoveDynamicTrack(cLux_GetCurrentMap().GetPlayerEntity().GetID());
             return false;
         }
		 
		 //-------------------------------------------------------
	 
		 //} END Event F *Spot the light at the end of the tunnel*
		 
		 /////////////////////////////////////////
		 // Event G *Get chased by TUNNEL COLLAPSE GHOUL (optional)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event G here.*/
		 
		 bool mbCaughtByTunnelCollapseGhoul = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event G here.*/
		 
		 bool OnTrigger_Player_StartSeqTunnelCollapse(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Seq_TunnelCollapse("");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSequenceDataTunnelCollapse;
		 void Seq_TunnelCollapse(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_TunnelCollapse", mSequenceDataTunnelCollapse);
			 if (Sequence_DoStepAndWait(0.1f))
			 {
				 Entity_SetActive("Ghoul_TunnelCollapse", true);				 
				 Agent_PlayCutsceneAnimation("Ghoul_TunnelCollapse", "crawl_custom_c", 0.f, false);
				 CharMover_SetTurnRate("Ghoul_TunnelCollapse", 0.f, 0.f, 0.f, 0.f);
				 
				 Entity_AttachToSocket("Trigger_GhoulTunnelCollapseDamage", "Ghoul_TunnelCollapse", "socket_righthand_damage", false, true);
				 
				 // Stupid hack to give proper fear effects since "Ghoul_TunnelCollapse" is at origo (since the anim is in world space)
				 //Entity_SetActive("Ghoul_TunnelCollapse_Fear", true);
				 Map_GetEntity("Ghoul_TunnelCollapse_Fear").GetMeshEntity().SetVisible(false);
				 Entity_AttachToSocket("Ghoul_TunnelCollapse_Fear", "Ghoul_TunnelCollapse", "socket_righthand_damage", true, true);
				 cLux_ToAgent(Map_GetEntity("Ghoul_TunnelCollapse_Fear")).GetCharBody().SetTestCollision(false);
				 
				 Entity_SetActive("Trigger_ResumeSeqTunnelCollapse_1", true);
				 Entity_SetActive("Trigger_PushTunnelBrick", true);
				 				 
				 Sound_CreateAtEntity("Sound_GhoulTunnelEmerge", "03_06_ghouls_nest/events/tunnel_collapse_ghoul", "Trigger_GhoulTunnelCollapseDamage");
				 Sound_CreateAtEntity("Sound_TunnelCreakStart", "03_06_ghouls_nest/events/tunnel_wall_creak_start", "Sound_TunnelCollapse");
				 Sound_CreateAtEntity("Sound_TunnelCreakLoop", "03_06_ghouls_nest/events/tunnel_wall_creak", "Sound_TunnelCollapse");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 //Ghoul_SetVisibile("Ghoul_TunnelCollapse_Fear", false);
			 }
			 else if (Sequence_DoStepAndPause(0.f))
			 {				 
				 Sound_CreateAtEntity("Sound_TunnelGhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_blinded_pain", "Trigger_GhoulTunnelCollapseDamage");
				 Music_AddDynamicTrack(cLux_GetCurrentMap().GetPlayerEntity().GetID(), 0, eMusicPrio_AgentHunt, "A2_NPC_Ghoul_Chase.ogg", 0.22f, 3.0f, 6.0f);
				 
				 //FearHandler_SetForcedAddFearRate(1.f, 10.f, false, -1.f, -1.f);
				 
				 Entity_SetActive("Ghoul_TunnelCollapse_Fear", true);
				 Ghoul_SetVisibile("Ghoul_TunnelCollapse_Fear", false);
			 }
			 else if (Sequence_DoStepAndWait(0.7f))
			 {
				 Prop_SetStaticPhysics("CollapsedTunnelDebris_1_6", false);
				 
				 if (mbCaughtByTunnelCollapseGhoul == false)
				 {
					 Sound_Stop("Sound_TunnelCreakStart", 1.f);
					 Sound_Stop("Sound_TunnelCreakLoop", 1.f);
					
					 Sound_CreateAtEntity("Sound_TunnelCollapse", "03_06_ghouls_nest/events/tunnel_wall_collapse", "Sound_TunnelCollapse");
				 }
			 }
			 else if (Sequence_DoStepAndWait(0.2f))
			 {
				 ParticleSystem_SetActive("PS_CollapsedTunnelDebris_1_*", true);	 
				 ParticleSystem_SetActive("PS_CollapsedTunnelSmoke_1", true);
			 }
			 else if (Sequence_DoStepAndWait(3.f))
			 {
				 Entity_SetActive("TunnelRoofBlocker_2", true);
				 Entity_SetActive("CollapsedTunnelDebris_2_*", true);
				 
				 Entity_SetActive("Ghoul_TunnelCollapse", false);
				 Entity_SetActive("Ghoul_TunnelCollapse_Fear", false);
				 
				 Music_RemoveDynamicTrack(cLux_GetCurrentMap().GetPlayerEntity().GetID());
				 
				 if (mbCaughtByTunnelCollapseGhoul == false)
					 FearHandler_SetForcedAddFearRate(0.4f, 9.f, false, -1.f, 0.05f);
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				  if (mbCaughtByTunnelCollapseGhoul == false)
					  Sound_CreateAtEntity("Sound_GhoulTunnelMad", "creatures/vocalisations/creature/ghoul/ghoul_blinded_pain", "Trigger_GhoulTunnelCollapseDamage");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				  if (mbCaughtByTunnelCollapseGhoul == false)
					  Sound_CreateAtEntity("Sound_GhoulTunnelLeave", "creatures/foley/creature/ghoul/ghoul_hole/ghoul_enter_hole", "Trigger_GhoulTunnelCollapseDamage");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_PushTunnelBrick(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Prop_SetStaticPhysics("CollapsedTunnelDebris_1_7", false);
			 Body_AddImpulse("CollapsedTunnelDebris_1_7_Body_1", cVector3f(0.f, 0.f, 0.5f), false);
			 Prop_SetStaticPhysics("CollapsedTunnelDebris_1_5", false);
			 Body_AddImpulse("CollapsedTunnelDebris_1_5_Body_1", cVector3f(-0.5f, 0.f, 0.5f), false);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_ResumeSeqTunnelCollapse(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 SequenceStates_Resume("Seq_TunnelCollapse");
			 
			 Map_RemoveTimer("Timer_StopTunnelWelderRot");			 
			 Prop_AlignRotation("TunnelWelder", "TunnelWelder_Tar", 2.f, 10.f, 0.f, false);
			 Prop_MoveLinearTo("TunnelWelder", "TunnelWelder_Tar", 4.f, 20.f, 0.f, false);
			 
			 Effect_Shake_Start(0.02f, 2.f, 0.f, 2.f);
			 
			 Entity_SetActive(asParent, false);
			 Entity_SetActive("Trigger_GhoulTunnelCollapseDamage", false);
			 Entity_SetActive("CollapsedTunnelBlockBox", true);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_GhoulTunnelCollapseDamage(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
			 FearHandler_SetForcedAddFearRate(0.f, 1.f, false, -1.f, 100.f);
			 
			 Entity_SetActive(asParent, false);
			 Map_AddTimer(asParent, 0.01f, "OnTimer_TunnelCollapseHit");
			 
			 Sound_CreateAtEntity("Sound_GhoulHit", "creatures/vocalisations/creature/ghoul/ghoul_attack", asParent);
			 Player_GiveDamage(1.f, 0.9f, eDamageType_Default, "Ghoul_TunnelCollapse");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_TunnelCollapseHit(const tString &in asTimer)
		 {
			 if (Struggle_IsActive(true))
				 Struggle_Stop(true);
			 
			 if (FearHandler_GetIsPermaFailing() == false)
				 FearHandler_TriggerPermaFail(false, "Ghoul_TunnelCollapse", true);
			 
			 mbCaughtByTunnelCollapseGhoul = true;
			
			 Sound_Stop("Sound_TunnelCreakStart", 1.f);
			 Sound_Stop("Sound_TunnelCreakLoop", 1.f);
			 Music_RemoveDynamicTrack(cLux_GetCurrentMap().GetPlayerEntity().GetID());	
			 Entity_SetActive("Ghoul_TunnelCollapse_Fear", false);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event G *Get chased by TUNNEL COLLAPSE GHOUL*
		 
		 /////////////////////////////////////////
		 // Event H *Wake up in the Barracks (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event H here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event H here.*/
		 
		 bool OnPermaFail_Tunnel(const tString &in asSource)
		 {				
			 Entity_SetActive("Sleeper_Courtyard_*", true);
			 SleepingGhoul_SetSensesActive("Sleeper_Courtyard_*", false);
			 Map_AddTimer("Timer_UpdateCourtyardSleep", 1.f / 60.f, "OnTimer_UpdateCourtyardSleep");
					 					 
			 Entity_SetActive("Trigger_SleepingHallTunnelExited", false);
			
			 Entity_SetActive("Ghoul_TunnelCollapse", false);
			 Entity_SetActive("Ghoul_TunnelCollapse_Fear", false);
			 Entity_SetActive("BarracksBackTrackBlocker", true);
					
			 FearHandler_SetUpdateInterval(0.4f);
			 FearHandler_SetForcedAddFearRate(0.f, 1.f, false, -1.f, 100.f);
					
			 // Cancel tunnel forced-crouching.
			 Player_SetStandDisabled(false);
			 Player_SetJumpDisabled(false);
			 
			 if (mbFairchildPermaFailDone == false)
				 PrepareFairchildPermaFail();
			
			 SetupGenericPermaFail();
			 FearHandler_SetPermaFailRespawnArea("PermaFail_Barracks");
			 
			 Music_RemoveDynamicTrack(cLux_GetCurrentMap().GetPlayerEntity().GetID());
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event H *Wake up in the Barracks (PERMAFAIL)*
	 
	 //} END SCENE 4
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 5 *SNEAK THROUGH THE ROMAN COURTYARD*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 5 here.*/
		
		bool mbVisitedCourtyard = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 5 here.*/
		
		void SetupLeonScare()
		{
			 mbUpdateCourtyardSleepers = false;
			 
			 Entity_SetActive("Trigger_StartLeonScare", true);
			 Entity_SetActive("Ghoul_LeonsNest", true);
			 Entity_PlayAnimation("Ghoul_LeonsNest", "crawl_custom_d_sit", 0.f, true);
			 
			 FearHandler_SetUpdateInterval(-1.f);
		}
		
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Spot the sea of sleeping ghouls in the courtyard*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event A here.*/
		 
		 int mlBarracksDoorLockedCount = 0;
		 int mlBarracksTunnelScareCount = 0;
		 		 	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event A here.*/
		 
		 void OnTimer_PlayBarracksTunnelSounds(const tString &in asTimer)
		 {
			 Sound_Play("Sound_BarracksHole", 0.5f, false);
			 FearHandler_SetForcedAddFearRate(0.1f, 3.f, false, -1.f, -1.f, 0.2f);
			 
			 mlBarracksTunnelScareCount++;
			 if (mlBarracksTunnelScareCount >= 5)
				 return;
			 
			 Map_AddTimer("Timer_PlayBarracksTunnelSounds", cMath_RandRectf(7.f, 12.f), "OnTimer_PlayBarracksTunnelSounds");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_LockBarracksDoor(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
			 mlBarracksDoorLockedCount += alState;
			 
			 bool bLocked = mlBarracksDoorLockedCount == 2 && SwingDoor_GetClosed("BarracksDoor_1") && SwingDoor_GetClosed("BarracksDoor_2");
			 FearArea_SetLocked("Fear_Barracks", bLocked);	

			 if (bLocked)
				 Map_RemoveTimer("Timer_PlayBarracksTunnelSounds");
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_OpenCourtyardDoor(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1 && mbVisitedCourtyard == false)
			 {				 
				 mbVisitedCourtyard = true;
				 Entity_SetActive("Trigger_ActivateSleeperSenses", true);
				 
				 SleepingGhoul_ForceReact("Sleeper_Courtyard_33", 0.5f, 0.5f);
				 SleepingGhoul_ForceReact("Sleeper_Courtyard_24", 1.2f, 1.2f);
				 SleepingGhoul_ForceReact("Sleeper_Courtyard_22", 0.8f, 0.8f);
				 
				 Pregnancy_SetWhispering(true);
				 
				 Player_SetNightVisionIgnoreFearArea(true);
				 
				 FearArea_SetSafe("Fear_Barracks", false);
			 }			
				
			 SleepingGhoul_SetSensesActive("Sleeper_Courtyard_*", alState == -1 || Entity_PlayerIsInFront(asParent) == false);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool Trigger_AllowCourtyardStinger(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Trigger_PlayCourtyardStinger", alState == 1);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_PlayCourtyardStinger(const tString &in asEntity, int alState)
		 {
			 Sound_CreateAIEventAtEntity(asEntity, 7.5f, 2);
			 Music_Play("A2_3_6_CourtyardSneak.ogg", 0.5f, false, eMusicPrio_BigEvent);
			 
			 Map_AddTimer("Timer_StopCourtyardStinger", 8.0f, "OnTimer_StopCourtyardStinger");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_PlayCourtyardSneakMusic(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1)
				 return true;
			 
			 if (Entity_PlayerIsInFront(asParent))
				 Music_PlayExt("A2_3_6_CourtyeardEnter.ogg", true, 0.25f, 1.0f, 6.0f, 0.0f, eMusicPrio_SceneAmb, true);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_PlaySleepingDialogue(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (mbSleepDialoguePlayed == false && Player_GetSpeed() < 3.f && Blackboard_GetAgentCount() == 0)
				 Voice_PlayDelayed("Dialogue_TheyreSleeping", 1.5f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StopCourtyardStinger(const tString &in asTimer)
		 {
			Music_Stop(5.0f, eMusicPrio_BigEvent);			
			Music_PlayExt("A2_3_6_CourtyeardEnter.ogg", true, 0.25f, 1.0f, 6.0f, 0.0f, eMusicPrio_SceneAmb, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_CloseCourtyardDoors(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 SleepingGhoul_SetSensesActive("Sleeper_Courtyard_*", alState == -1 || Entity_PlayerIsInFront(asParent));
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ActivateSleeperSenses(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1) return true;
			 
			 bool bActive = Entity_GetCollide("Trigger_OpenCourtyardDoor", "CourtyardDoor_1") == false && 
							Entity_PlayerIsInFront(asParent) == false; 
			 SleepingGhoul_SetSensesActive("Sleeper_Courtyard_*", bActive);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_UpdateCourtyardSleep(const tString &in asTimer)
		 {
			 mbUpdateCourtyardSleepers = true;
		 }
		 
         //-------------------------------------------------------
	 
		 //} END Event A *Spot the sea of sleeping ghouls in the courtyard*
         
         /////////////////////////////////////////
		 // Event B *Sneak through the courtyard*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event B here.*/
		 
		 array<tString> mvCourtyardGhouls;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event B here.*/
		 
		 bool OnTrigger_Player_WakeUpGhoulCourtyardAlert(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Trigger_WakeUpGhoulCourtyardAlert_*", false);
			 Entity_SetActive("Trigger_CourtyardGhoulCrawl_2", true);
			 
			 tString sSleeper = Entity_GetVarString(asParent, "");
			 if (SleepingGhoul_IsAwake(sSleeper)) return false;
			 
			 Map_AddTimer(sSleeper, 1.5f, "OnTimer_WakeUpGhoulCourtyardAlert");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_WakeUpGhoulCourtyardAlert(const tString &in asTimer)
		 {
			 SleepingGhoul_ForceWakeUp(asTimer);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnWakeUp_GhoulCourtyardAlert(const tString &in asEntity)
		 {
			 mbSleepDialoguePlayed = true;
			 
			 for (int i = 0; i < mvCourtyardGhouls.size(); i++)
			 {
				 if (asEntity == mvCourtyardGhouls[i])
				 {
					 mvCourtyardGhouls.removeAt(i);
					 break;
				 }
			 }
			 
			 Agent_SetSensesActive(asEntity, true);			 
			 Ghoul_CommandSmell_Execute(asEntity, true);
			 
			 Map_AddTimer(asEntity, 2.5f, "OnTimer_GhoulCourtyardLeave");
		 }
         
         //-------------------------------------------------------
		 
		 void OnTimer_GhoulCourtyardLeave(const tString &in asTimer)
		 {
			 if (Entity_IsActive(asTimer) == false) return;

			 //////////////////////
			 // First and second ghouls always leave through the same
			 int lId = cString_GetNumericSuffixInt(asTimer);
			 if (lId == 1 || lId == 2)
			 {
				 Ghoul_CommandGoToSpecificHole_Execute(asTimer, "CourtyardHole_2", false, false, true, eGhoulSpeed_Walk);
				 return;
			 }
			 
			 Agent_SetAutoDisableWhenOutOfSightActive(asTimer, true, 20.f);
			 
			 ////////////////////
			 // Farthest from player
			 float fDist1 = Entity_GetDeltaToEntity("player", "CourtyardHole_2").SqrLength();
			 float fDist2 = Entity_GetDeltaToEntity("player", "CourtyardHole_3").SqrLength();			 
			 tString sHole = fDist1 < fDist2 ? "CourtyardHole_3" : "CourtyardHole_2";
			 Ghoul_CommandGoToSpecificHole_Execute(asTimer, sHole, false, false, true, eGhoulSpeed_Walk);
		 }
         
         //-------------------------------------------------------
		 
		 void OnWakeUp_CourtyardScreamer(const tString &in asEntity)
		 {
			 mbSleepDialoguePlayed = true;
			 
			 if (Map_TimeHasPassed("Timer_CourtyardGhoulWokeUp", 5.f) == false) return;
			 
			 ///////////////////
			 // Wake up closest alert ghoul!
			 tString sSleeper = "";
			 float fShortestSqrDist = 10000.f;
			 for (int i = 0; i < mvCourtyardGhouls.size(); i++)
			 {
				 float fSqrDist = Entity_GetDeltaToEntity(asEntity, mvCourtyardGhouls[i]).SqrLength();
				 if (fSqrDist < fShortestSqrDist)
				 {
					 sSleeper = "Sleeper_Courtyard_Alert_" + cString_GetNumericSuffixInt(mvCourtyardGhouls[i]);
					 if (SleepingGhoul_IsAwake(sSleeper))
					 {
						 sSleeper = "";
						 continue;
					 }
					 
					 fShortestSqrDist = fSqrDist;
				 }
				 
				 if (Entity_IsActive(mvCourtyardGhouls[i]))
					 Agent_RevealPlayerPosition(mvCourtyardGhouls[i]);
			 }
			 
			 if (sSleeper == "") return; 
			 Map_AddTimer(sSleeper, cMath_RandRectf(1.f, 2.f), "OnTimer_WakeUpGhoulCourtyardAlert");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_CourtyardGhoulClimb(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
			 if (alState == 1 || 
				 Entity_PlayerIsInFront(asParent) == false ||
				 Player_GetSpeed() > 3.f) 
				 return true;
				 
			 array<tString> vStrings;
			 cString_GetStringVec(Entity_GetVarString(asParent, ""), vStrings, ";");
			 tString sGhoul = vStrings[0];
			 tString sNode = vStrings[1];
			 
			 Entity_SetActive(sGhoul, true);
			 Map_AddTimer(sGhoul, 0.1f, "OnTimer_CourtyardGhoulClimb");
			 Map_SetTimerUserVarString(sGhoul, sNode);
			 
			 FearThreatAgent_SetBaseFearRate(sGhoul, 0.05f);
			 FearThreatAgent_SetComponentLookAtFactor(sGhoul, 0.1f);
			 FearThreatAgent_SetSurpriseFactor(sGhoul, 0.1f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_CourtyardGhoulClimb(const tString &in asTimer)
		 {
			 Pathfinder_MoveToNode(asTimer, Map_GetTimerUserVarString(asTimer));
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_DeactivateCourtyardGhoulClimb(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive(asChild, false);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_CourtyardGhoulCrawl(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1 || Entity_PlayerIsInFront(asParent) == false) return true;
			 tString sGhoul = Entity_GetVarString(asParent, "");
			 
			 Entity_SetActive(sGhoul, true);
			
			 cLux_ToAgent(Map_GetEntity(sGhoul)).GetCharBody().SetTestCollision(false);
			 CharMover_SetUseMoveStateAnimations(sGhoul, false);
			 
			 Entity_PlayAnimation(sGhoul, "crawl", 0.f, true);
			 Map_AddTimer(sGhoul, 0.1f, "OnTimer_CourtyardGoulCrawl");		 
			 
			 FearThreatAgent_SetBaseFearRate(sGhoul, 0.05f);
			 FearThreatAgent_SetComponentLookAtFactor(sGhoul, 0.1f);
			 FearThreatAgent_SetSurpriseFactor(sGhoul, 0.1f);
			 
			 Sound_CreateAtEntity("Sound_GhoulCrawl", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", sGhoul);
			 
			 Map_AddTimer(sGhoul, 0.1f, "OnTimer_SetCourtyardGhoulCrawlSpeed");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_CourtyardGoulCrawl(const tString &in asTimer)
		 {
			 int lId = cString_GetNumericSuffixInt(asTimer);
			 Pathfinder_MoveToEntity(asTimer, "Trigger_StopCourtyardGhoulCrawl_" + lId, "");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetCourtyardGhoulCrawlSpeed(const tString &in asTimer)
		 {
			 CharMover_SetSpeedState(asTimer, 2);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_StopCourtyardGhoulCrawl(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive(asChild, false);			 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_CourtyardGhoulFall(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 FearThreatAgent_SetComponentEnabled("Ghoul_CourtyardFall", false);
			 
			 Entity_SetActive("Ghoul_CourtyardFall", true);
			 Entity_PlayAnimation("Ghoul_CourtyardFall", "wall_fall", 0.f, true, true);
			 
			 CharMover_SetUseMoveStateAnimations("Ghoul_CourtyardFall", false);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_CourtyardFallGhoulLand(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 SleepingGhoul_ForceReact("Sleeper_Courtyard_12", 0.3f, 0.3f);
			 SleepingGhoul_ForceReact("Sleeper_Courtyard_1", 0.6f, 0.6f);
			 
			 Sound_CreateAtEntity("Sound_GhoulDropSting", "03_06_ghouls_nest/stingers/ghoul_drop_stinger", "player");
			 Sound_Play("Sound_CourtyardGhoulLand", 0.f);

			 FearThreatAgent_SetComponentEnabled(asChild, true);
			 			 
			 Entity_PlayAnimation(asChild, "wall_fall_to_land", 0.3f, false, true, "OnAnimationOver_CourtyardGhoulFall");
			 
			 ParticleSystem_CreateAtEntity("PS_FallGhoulDust", "dust_impact_simple_oneshot.ps", asParent, false);
			 ParticleSystem_CreateAtEntity("PS_FallGhoulSplash", "falling_ghoul_goo_splash.ps", asParent, false);
			 ParticleSystem_SetBrightness("PS_FallGhoulDust", 0.5f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimationOver_CourtyardGhoulFall(const tString &in asEntityName, const tString &in asAnimName)
		 {
			 Agent_SetSensesActive(asEntityName, true);
			 
			 ///////////////
			 // Place at anim end pos
			 iCharacterBody@ pBody = cLux_ToAgent(Map_GetEntity(asEntityName)).GetCharBody();
			 pBody.SetFeetPosition(pBody.GetFeetPosition() + cVector3f(1.120285f, 0.f,  -0.229607f), true);		 
			 Entity_PlayAnimation(asEntityName, "idle", 0.f, false, true);

			 OnTimer_GhoulCourtyardLeave(asEntityName);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *Sneak through the courtyard*
         
         /////////////////////////////////////////
		 // Event C *Block the ghoul holes*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event C here.*/
		
		 int mlKitchenHoleBlockCount = 0;
		 int mlCourtyardExitHoleBlockCount = 0;
		 bool mbKitchenDoorLocked = false;
		
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event C here.*/
		 
		 bool OnTrigger_Player_EnterKitchen(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Trigger_CourtyardGhoulFall", true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_LockKitchenDoor(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mbKitchenDoorLocked = alState == 1 && SwingDoor_GetClosed("CourtyardDoor_2");
			 bool bSafe = mlKitchenHoleBlockCount >= 2 && mbKitchenDoorLocked;
			 //FearArea_SetSafe("Fear_KitchenStorage", bSafe);			 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_CoverKitchenHole(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mlKitchenHoleBlockCount += alState;
			 Entity_SetActive("FearThreat_KitchenHole", mlKitchenHoleBlockCount < 2);
			 
			 bool bSafe = mlKitchenHoleBlockCount >= 2 && mbKitchenDoorLocked;
			 //FearArea_SetSafe("Fear_KitchenStorage", bSafe);			 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ActivateCourtyardExitHole(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 FearThreat_SetComponentFearActive("FearThreat_CourtyardHole_2", true);
			 return false;
		 }

		 //-------------------------------------------------------
		 
		 bool OnTrigger_CoverCourtyardExitHole(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mlCourtyardExitHoleBlockCount += alState;
			 Entity_SetActive("FearThreat_CourtyardHole_2", mlCourtyardExitHoleBlockCount < 2);
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *Block the ghoul hole in the kitchen*
         
         /////////////////////////////////////////
		 // Event D *Get chased by ghouls*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event D here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event D here.*/
		 
		 void OnBreak_CourtyardDoor(const tString &in asEntity)
		 {
			 SleepingGhoul_SetSensesActive("Sleeper_Courtyard_*", true);
			 
			 if (asEntity == "BarracksDoor_1" || asEntity == "BarracksDoor_2")
			 {
				 FearArea_SetSafe("Fear_Barracks", false);				 
				 Pregnancy_ClearBabyTalkSpecialSubject();
			 }
			 else if (asEntity == "CourtyardDoor_2")
			 {
				 FearArea_SetSafe("Fear_KitchenStorage", false);
				 Pregnancy_ClearBabyTalkSpecialSubject();
			 } 
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event D *Get chased by ghouls*
         
         /////////////////////////////////////////
		 // Event E *Pick up Leon's Pendant (MEMORY)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event E here.*/
		 
		 bool mbSpottedFairchild = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event E here.*/
		 
		 bool OnTrigger_Player_ExitCourtyard(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Sleeper_Courtyard_*", false);
			 Entity_SetActive("FearThreat_KitchenHole", false);
			 Entity_SetActive("FearThreat_CourtyardHole_2", false);
			 Entity_SetActive("Ghoul_Courtyard*", false);
			 Music_Stop(6.0f, eMusicPrio_SceneAmb);
			 
			 SetupLeonScare();
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_Fairchild(const tString &in asEntity, int alState)
		 {
			 if (mbSpottedFairchild) return;
			 
			 mbSpottedFairchild = true;
			 Voice_PlayWhenPossible("Dialogue_Fairchild_Found");
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event E *Pick up Leon's Pendant (MEMORY)*
                  
         /////////////////////////////////////////
		 // Event G *Wake up in Leon's Nest (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event G here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event G here.*/
		 
		 bool OnPermaFail_Courtyard(const tString &in asSource)
		 {					
			 mbUpdateCourtyardSleepers = false;
			 Entity_SetActive("Sleeper_Courtyard_*", false);
			 Entity_SetActive("FearThreat_KitchenHole", false);
			 Entity_SetActive("FearThreat_CourtyardHole_2", false);
			 Entity_SetActive("Trigger_ExitCourtyard", false);
					 
			 Entity_SetActive("Ghoul_Courtyard*", false);
			 Entity_SetActive("CourtyardlTunnelBlocker", true);
			 
			 if (mbFairchildPermaFailDone == false)
				 PrepareFairchildPermaFail();
						 
			 SetupGenericPermaFail();
			 FearHandler_SetPermaFailRespawnArea("PermaFail_LeonsNest");
			 return true;
		 }
		
		 //------------------------------------------------------------
		
		 void PrepareFairchildPermaFail()
		 {
			 mbFairchildPermaFailDone = true;
			
			 Entity_SetActive("Sleeper_SleepingHall_*", false);
			 Entity_SetActive("Sleeper_Hatch_*", false);
			 Entity_SetActive("Ghoul_*", false);
			
			 Entity_SetActive("FearThreat_Bathhouse_*", false);
			 Entity_SetActive("FearScaryObject_Flesh_*", false);
			 Entity_SetActive("FearThreat_SleepingHall*", false);
			 Entity_SetActive("FearThreat_SleepingHallTunnel_*", false);
			
			 Entity_SetActive("BarracksBlocker", false);
			 Entity_SetActive("Fairchil*", false);
			
			 Map_RemoveTimer("Timer_PlayTunnelScare");
			 SwingDoor_SetOpenAmount("BarracksDoor_2", 0.6f);
			
			 Billboard_SetVisible("Billboard_13", false);
		 }
		
		 //------------------------------------------------------------
		
		 cSequenceStatesData mSeqDataFairchildPermaFail;
		 void Seq_FairchildPermaFail(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_FairchildPermaFail", mSeqDataFairchildPermaFail);
			 if (Sequence_DoStepAndWait(0.f))
			 {			
				 Player_SetMoveSpeedMul(0.f);
				 Player_SetLookSpeedMul(0.f);
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				 Sound_FadeGlobalVolume(0.f, 0.5f, eSoundEntryType_World);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {	
				 tString sEnt = mbVisitedCourtyard ? "Fairchild_Gnaw_LeonsNest" : "Fairchild_Gnaw_Barracks";
				 tString sArea = mbVisitedCourtyard ? "Start_LeonsNest" : "Start_Barracks";
				
				 Player_Teleport(sArea);
				 Entity_SetActive(sEnt, true);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {		
				 tString sStandTar = "Fairchild_Gnaw_Barracks";
				 if (mbVisitedCourtyard)
					 sStandTar = "Fairchild_Gnaw_LeonsNest";
				 else
					 Pregnancy_SetWhispering(false);
				
				 tString sLoop = "gnaw_on_fairchild_loop";
				 tString sIntro = "gnaw_on_fairchild_intro";
				 tString sOutro = "gnaw_on_fairchild_outro";
				 tString sStruggle = "gnaw_on_fairchild_resist";
				 tString sCallback = "OnStruggleEnd_FairchildPermaFail";
				
				 Struggle_SetAnimationEntity(sStandTar, "f_"+sLoop, "f_"+sIntro, "f_"+sOutro, "f_"+sStruggle, true);
				 Struggle_StartAnimation(sStandTar, "struggle_"+sLoop, "struggle_"+sStruggle, "struggle_"+sIntro, 
										 "struggle_"+sOutro, true, "", sCallback, sCallback, "", 10.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 FearHandler_SetPaused(false);
				 Effect_Fade_In(2.f);
				 
				 Sound_FadeGlobalVolume(1.f, 1.f, eSoundEntryType_World);
			 }
			 Sequence_End();
		 }
		
		 //-------------------------------------------------------
		
		 void OnStruggleEnd_FairchildPermaFail()
		 {						
			 Map_AddTimer("Timer_PlayEatFairchildDialogue", 0.3f, "OnTimer_PlayEatFairchildDialogue");
			 Sound_PlayGui("03_06_ghouls_nest/stingers/permafail_event", 1.f);
			
			 FearHandler_FadeLevelTo(0.f, 1.f);
			 
			 Player_SetMoveSpeedMul(1.f);
			 Player_SetLookSpeedMul(1.f);
		 }
	
		 //-------------------------------------------------------
	 
		 //} END Event G *Wake up in Leon's Nest (PERMAFAIL)*
	 
	 //} END SCENE 5
	 
	 //////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 6 *HIDE FROM AND SNEAK PAST THE PREOCCUPIED GHOULS IN THE ROMAN TEMNPLE*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 6 here.*/
		
		int mlTempleGhoulHitCount = 0;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 6 here.*/
	 
		//-------------------------------------------------------
		
		//} END General
        
         /////////////////////////////////////////
		 // Event A *Hide from OVERLAP GHOUL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event A here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event A here.*/
         
         bool OnTrigger_Player_StartSeqOverlapGhoulDrop(const tString &in asParent, const tString &in asChild, int alState)
         {		
			 mlPermaFailStage = eGhoulsNestPermaFailStage_Temple;
			 
             Seq_OverlapGhoulDrop("");             			 
			 Sound_CreateAtEntity("Sound_TableGhoulScuffle","03_06_ghouls_nest/events/tunnel_table_ghoul_scuffle","Area_OverlapGhoulDrop");
			 
			 if (Oil_GetCount("ModernOil") > 1)
				 Entity_SetActive("oil_flask_modern_french_3", false);
				
			 return false;
         }
         
		 //-------------------------------------------------------
         
         cSequenceStatesData mSeqOverlapGhoulDrop;
         void Seq_OverlapGhoulDrop(const tString &in asTimer)
         {
             Sequence_Begin("Seq_OverlapGhoulDrop", mSeqOverlapGhoulDrop);
             Sequence_Wait(1.f);
             if (Sequence_DoStepAndWait(0.01f))
             {
				Player_SetNightVisionIgnoreFearArea(false);
				 
				Entity_SetActive("Sleeper_Temple_*", true);
				Sound_Play("Sound_GhoulWorship_*", 1.f);
				 
				Entity_SetActive("Ghoul_Overlap_1", true);
                Agent_PlayCutsceneAtEntity("Ghoul_Overlap_1", "land_on_table", "Area_OverlapGhoulAnim", 0.f, false);
				
				Prop_SetHealth("TempleTable", 0.f);
				
				ParticleSystem_CreateAtEntity("PS_DropDust", "dust_impact_med_oneshot.ps", "Area_OverlapGhoulDrop", false).SetBrightness(0.075f);
                Sound_CreateAtEntity("Sound_GhoulDrop", "03_06_ghouls_nest/events/tunnel_table_break", "Area_OverlapGhoulDrop");
                
				Sound_CreateAtEntity("Sound_GhoulDropSting", "03_06_ghouls_nest/stingers/ghoul_drop_stinger", "player");
				Music_Play("A2_3_6_GhoulDropScare.ogg", 0.6f, false, eMusicPrio_BigEvent);				
				
				Ghoul_ModeEnthralled_Setup("Ghoul_Overlap_1", "LookAtArea_LargeOverlap_1", "MoveTarArea_LargeOverlap_1", "enthralled");
				Ghoul_Mode_Set("Ghoul_Overlap_1", eGhoulMode_Enthralled, false);		
             }
			 else if (Sequence_DoStepAndWait(7.f))
			 {
				 Body_AddImpulse("TempleTable_broken_piece5", cVector3f(0.f, -2.f, 0.f), false);
				 Body_AddImpulse("TempleTable_broken_piece1", cVector3f(0.f, -2.f, 0.f), false);
			 }
			 else if (Sequence_DoStepAndContinue())
			 {
				 Agent_SetSensesActive("Ghoul_Overlap_1", true);
             }
             Sequence_End();          
         }
		 
		 //-------------------------------------------------------
		 
		 void OnBreak_TempleTable(const tString &in asEntity)
		 {
			 iLuxEntity@ pEnt = Map_GetEntity(asEntity + "_broken");
			 for (int i = 0; i < pEnt.GetBodyNum(); ++i)
				 pEnt.GetBody(i).SetCollideFlags(mBaseObj.GetCollideFlag("-agent"));
		 }
		 
		 //-------------------------------------------------------
         
         bool OnTrigger_Player_ExitTempleTunnel(const tString &in asParent, const tString &in asChild, int alState)
         {
			 Prop_SetStaticPhysics("TempleDoor", false);
			 
			 if (SequenceStates_IsActive("Seq_OverlapGhoulDrop"))
			 {
				 Agent_SetSensesActive("Ghoul_Overlap_1", true);
				 return false;
			 }	
             return true;
         }
		          
         //-------------------------------------------------------
		 
		 bool OnTrigger_GhoulOverlap_RunToOverlap(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Ghoul_GetCurrentState(asChild) != "Enthralled" || alState == -1) return true;
			 CharMover_SetSpeedState(asChild, 3);
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
