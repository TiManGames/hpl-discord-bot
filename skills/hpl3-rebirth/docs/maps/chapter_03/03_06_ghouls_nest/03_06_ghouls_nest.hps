		 void OnAnimEnd_CommonRoomGhoul(const tString &in asAgent, const tString &in asAnim)
		 {					 
			 Agent_SetSensesActive("Ghoul_EndChase_4", true);
			 Agent_RevealPlayerPosition("Ghoul_EndChase_4");
			 
			 Map_AddTimer("Ghoul_EndChase_4", 0.5f, "OnTimer_SetEndChaseGhoulReady");
		 }
		 
