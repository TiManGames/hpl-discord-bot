enum eGhoulsNestPermaFailStage
{
	eGhoulsNestPermaFailStage_Entrance = 0,
	eGhoulsNestPermaFailStage_NestEntrance = 1,
	eGhoulsNestPermaFailStage_SleepingHallAlcove = 2,
	eGhoulsNestPermaFailStage_SleepingHallScuffle = 3,
	eGhoulsNestPermaFailStage_SleepingHallFinal = 4,
	eGhoulsNestPermaFailStage_Tunnel = 5,
	eGhoulsNestPermaFailStage_Courtyard = 6,
	eGhoulsNestPermaFailStage_Temple = 7,
	eGhoulsNestPermaFailStage_TempleSecond = 8,
	eGhoulsNestPermaFailStage_Chase = 9,
}

