	//-------------------------------------------------------
	
	/////////////////////////
	// Put courtyard sleepers to sleep if far away! 
	// (Do it here instead of a module since it's such a one-off)
	bool mbUpdateCourtyardSleepers = false;
	array<tID> mvCourtyardSleepers;
	
	void VariableUpdate(float afDeltaTime)
	{
		if (mbUpdateCourtyardSleepers == false) 
			return;
		
		cVector3f vPlayerPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
		iLuxEntity@ pEnt = null;

		for (int i = 0; i < mvCourtyardSleepers.size(); i++)
		{
			@pEnt = cLux_ID_Entity(mvCourtyardSleepers[i]);
			if (pEnt is null) continue;
				
			float fDistSqr = (vPlayerPos - pEnt.GetPosition()).SqrLength();
			bool bSleeping = pEnt.IsSleeping();
			if (fDistSqr > 12.f * 12.f && bSleeping == false)
			{
				if (SleepingGhoul_IsAwake(pEnt.GetName()))
					continue;
				
				cAnimationState@ pState = pEnt.GetCurrentAnimationState();
				if (pState !is null)
					pState.SetPaused(true);
				
				pEnt.Sleep();
				//pEnt.StopAllAnimations(0.3f);
			}
			else if (fDistSqr <= 12.f * 12.f && bSleeping)
			{
				cAnimationState@ pState = pEnt.GetCurrentAnimationState();
				if (pState !is null)
					pState.SetPaused(false);
				
				pEnt.WakeUp();
				//pEnt.PlayAnimation("idle", 0.3f, true);
			}		
		}		
	}
	
	//-------------------------------------------------------
	
	void OnDamageTaken(const tString &in asSource, int alType)
	{
		if (alType != eDamageType_Silent)
			return;
			
		if (asSource == msSleepingHallGhoul)
			++mlSleepingHallGhoulHitCount;
		else if (asSource == "Ghoul_Overlap_1")
			++mlTempleGhoulHitCount;
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail(const tString &in asSource)
	{
		mlCurrPermaFailScene = 0;
		FearHandler_ClearPermaFailScenes();
		
		//////////////////////
		// Despawn Sleeping Hall ghoul?
		if (mlSleepingHallGhoulHitCount >= 3 && mlPermaFailStage == eGhoulsNestPermaFailStage_SleepingHallAlcove)
			mlPermaFailStage = eGhoulsNestPermaFailStage_SleepingHallScuffle;
		
		mlSleepingHallGhoulHitCount = 0;
		
		//////////////////////
		// Despawn Temple ghoul?
		if (mlTempleGhoulHitCount >= 3 && mlPermaFailStage == eGhoulsNestPermaFailStage_Temple)
			mlPermaFailStage = eGhoulsNestPermaFailStage_TempleSecond;
			
		mlTempleGhoulHitCount = 0;
		
		//////////////////////
		// Setup permafail
		switch (mlPermaFailStage)
		{
			case eGhoulsNestPermaFailStage_Entrance:					return OnPermaFail_Entrance(asSource);
			case eGhoulsNestPermaFailStage_NestEntrance: 				return OnPermaFail_NestEntrance(asSource);
			case eGhoulsNestPermaFailStage_SleepingHallAlcove:			return OnPermaFail_SleepingHallAlcove(asSource);
			case eGhoulsNestPermaFailStage_SleepingHallScuffle:			return OnPermaFail_SleepingHallScuffle(asSource);
			case eGhoulsNestPermaFailStage_SleepingHallFinal:			return OnPermaFail_SleepingHallFinal(asSource);
			case eGhoulsNestPermaFailStage_Tunnel:						return OnPermaFail_Tunnel(asSource);
			case eGhoulsNestPermaFailStage_Courtyard:					return OnPermaFail_Courtyard(asSource);
			case eGhoulsNestPermaFailStage_Temple:						return OnPermaFail_Temple(asSource);
			case eGhoulsNestPermaFailStage_TempleSecond:				return OnPermaFail_TempleSecond(asSource);
			case eGhoulsNestPermaFailStage_Chase:
			{	
				FearHandler_SetPermaFailWakeUpMusicPrio(eMusicPrio_OverrideAll); // Need this so the custom wake up music works
				
				tString sArea = msEndChasePermaFailArea;
				mlEndChasePermaFailCount++;
				
				if (mlEndChasePermaFailCount == 3 && sArea != "PermaFail_PortalRoom")
					return OnPermaFail_PortalRoomCorridor(asSource);
			
				if (sArea == "PermaFail_ChaseCell")
					return OnPermaFail_ChaseCell(asSource);
				else if (sArea == "PermaFail_CommonRoomTunnel")
					return OnPermaFail_CommonRoomTunnel(asSource);
				else if (sArea == "PermaFail_CommonRoom")
					return OnPermaFail_CommonRoom(asSource);
				else if (sArea == "PermaFail_ChaseTunnel")
					return OnPermaFail_ChaseTunnel(asSource);
				else if (sArea == "PermaFail_PortalRoomCorridor")
					return OnPermaFail_PortalRoomCorridor(asSource);
				else if (sArea == "PermaFail_PortalRoom")
					return OnPermaFail_PortalRoom(asSource);
				
				break;
			}
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnPermaFailRespawn()
	{
		if (mlPermaFailStage == eGhoulsNestPermaFailStage_Chase)
		{
			Map_AddTimer("Timer_PlayChaseRespawnMusic", 17.f, "OnTimer_PlayChaseRespawnMusic");
		}
		
		if (mlPermaFailStage == eGhoulsNestPermaFailStage_Chase && mbWakeUpInPortalRoom)
			return OnPermaFailRespawn_PortalRoom();
		
		return true;
	}
	
	//-------------------------------------------------------
	
	array<int> mvUnplayedGenericPermaFails = { 1, 2, 3 };	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 4; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);
		
		tString sAreaBase = "Area_PermaFail_Generic";		
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_1", sAreaBase + "_1_End_1", 3.f, 2.f, true, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_2", sAreaBase + "_1_End_2", 2.5f, 2.f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_3", sAreaBase + "_1_End_3", 2.5f, 2.f, true);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 3.f, 2.f, true, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_2", sAreaBase + "_2_End_2", 4.5f, 2.f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_3", sAreaBase + "_2_End_3", 2.5f, 2.f, true, true);
				break;
			case 3:
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_1", sAreaBase + "_3_End_1", 4.5f, 2.f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_2", sAreaBase + "_3_End_2", 3.f, 2.f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_3", sAreaBase + "_3_End_3", 2.f, 2.f, true, true);
				break;
		}
	}
	
	//------------------------------------------------------------
	
	bool OnTrigger_Player_RegisterPermaFail(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState!=1) return true;
		if (FearHandler_GetIsPermaFailing()) return true;
		
		int lStage = eGhoulsNestPermaFailStage(Entity_GetVarInt(asParent, ""));
		if (mlPermaFailStage < lStage)
			mlPermaFailStage = lStage;	
	
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_EnterSafeRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1)
		{
			Pregnancy_ClearBabyTalkRoomSpecificSubject();
			return true;
		}
		
		tString sSubject = "";
		if (asParent == "Fear_Temple")						sSubject = "BabyTalk_SafeRoom_Sacristy";
		else if (asParent == "Fear_Barracks")				sSubject = "BabyTalk_SafeRoom_Barracks";
		else if (asParent == "Fear_KitchenStorage")			sSubject = "BabyTalk_SafeRoom_KitchenStorage";
		
		Pregnancy_SetBabyTalkRoomSpecificSubject(sSubject, true);		
		return true;
	}
	
	//-------------------------------------------------------
 
	//} END MAIN CALLBACKS
 
