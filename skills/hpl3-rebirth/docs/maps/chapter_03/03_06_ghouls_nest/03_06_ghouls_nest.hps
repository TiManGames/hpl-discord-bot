	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{		
		// Any general setup of script / entities
		
		/////////////////////////
		// Debug
		if (cLux_ScriptDebugOn())
		{
            if (ItemType_GetCountInInventory("Lantern") < 1)
            {
                Item_AddToInventory("Lantern");	
                Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
                Item_AddToInventory("HerbertOil");
                Item_AddToInventory("Orb");
            }
			
			if (ItemType_GetCountInInventory("Matchbook") < 1)
			{
				Item_AddToInventory("Matchbook");
				Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
			}	
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{			
		PlayerBody_SetActive(true);
		
		Player_SetMapDeepShadow(0.15f);
		Player_SetNightVisionBrightness(2.6f);
		Player_SetNightVisionRadius(5.5f);
		
		FearHandler_SetActive(true);
		FearHandler_SetPermaFailEnabled(true);
        Heat_SetActive(false);
		
		Pregnancy_SetBabyKicksEnabled(true);
		
		GhoulProgression_SetLimit(13);
		
		Blackboard_SetProximityEventsActive(false);
		
		cScript_SetGlobalVarBool("TTH_PillarRoomComplete", true);
		cScript_SetGlobalVarBool("TTH_VitaeStationComplete", true);		
		
		/////////////////////////
        // Setup blocker ghoul	
		SetupBlockerGhoul();		
		
		////////////////////////
		// Set up nest entrance		
		cLuxProp@ pEntranceWheel = Map_GetProp("EntranceGateWheel");
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_1", Map_GetProp("EntranceGateStrut_1"), false, eEasing_SineOut);
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_2", Map_GetProp("EntranceGateStrut_2"), false, eEasing_Linear);
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_3", Map_GetProp("EntranceGateStrut_3"), false, eEasing_QuartIn);
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_4", Map_GetProp("EntranceGateStrut_4"), false, eEasing_QuadIn);
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_5", Map_GetProp("EntranceGateStrut_5"), false, eEasing_Linear);
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_6", Map_GetProp("EntranceGateStrut_6"), false, eEasing_QuadOut);
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_7", Map_GetProp("EntranceGateStrut_7"), false, eEasing_QuartIn);
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_8", Map_GetProp("EntranceGateStrut_8"), false, eEasing_SineIn);
		pEntranceWheel.AddInteractConnection("EntranceGateStrut_9", Map_GetProp("EntranceGateStrut_9"), false, eEasing_Linear);
		
		/////////////////////////
		// Setup Sleeping Hall
		SleepingGhoul_SetSensesActive("Sleeper_SleepingHall_*", false);
		
		// These are inactive from start so the pathnodes get linked correctly
		Entity_SetActive("HatchScareViewBlocker", true);
		Entity_SetActive("SleepingHallExitBlocker", true);
		Entity_SetActive("Sleeper_SleepingHall_1", true);
		
		ParticleSystem_SetActive("PS_TunnelDebris_*", false);
		ParticleSystem_SetActive("PS_TunnelSmoke_1", false);
		ParticleSystem_SetActive("PS_CollapsedTunnelDebris_*", false);
		ParticleSystem_SetActive("PS_CollapsedTunnelSmoke_1", false);
		
		////////////////////////
        // Set up Sleeping Hall Tunnel
        mvTunnelScareAreas.resize(0);
        for (int i = 1; i < 26; i++)
            mvTunnelScareAreas.push_back("Area_TunnelScare_" + i);
		
		/////////////////////////
		// Setup courtyard
		mvCourtyardSleepers.resize(0);		
		array<iLuxEntity@> vEnts;
		Map_GetEntityArray("Sleeper_Courtyard_*", vEnts, eLuxEntityType_Prop);				
		
		for (int i = 0; i < vEnts.size(); i++)
		{
			iLuxEntity@ pEnt = vEnts[i];
			if (pEnt is null || pEnt.GetVarString("") == "NoSleep") 
				continue;
			
			mvCourtyardSleepers.push_back(pEnt.GetID());
		}
		
		mvCourtyardGhouls.resize(0);		
		array<iLuxEntity@> vGhouls;
		Map_GetEntityArray("Ghoul_CourtyardAlert_*", vGhouls, eLuxEntityType_Agent);	
		
		for (int i = 0; i < vGhouls.size(); ++i)
			mvCourtyardGhouls.push_back(vGhouls[i].GetName());
		
		/////////////////////////
		// Set up nest exit
		MoveObject_SetState("ExitGateCatcherStuck", 1.f);
		MoveObject_SetState("ExitGateCatcher_2", 1.f);
		
		cLuxProp@ pExitWheel = Map_GetProp("ExitGateWheelBase");
		pExitWheel.AddInteractConnection("ExitGateStrut_1", Map_GetProp("ExitGateStrut_1"), false, eEasing_Linear);
		pExitWheel.AddInteractConnection("ExitGateStrut_2", Map_GetProp("ExitGateStrut_2"), false, eEasing_QuartIn);
		pExitWheel.AddInteractConnection("ExitGateStrut_3", Map_GetProp("ExitGateStrut_3"), false, eEasing_SineOut);
		pExitWheel.AddInteractConnection("ExitGateStrut_4", Map_GetProp("ExitGateStrut_4"), false, eEasing_QuadIn);
		pExitWheel.AddInteractConnection("ExitGateStrut_5", Map_GetProp("ExitGateStrut_5"), false, eEasing_Linear);
		pExitWheel.AddInteractConnection("ExitGateStrut_6", Map_GetProp("ExitGateStrut_6"), false, eEasing_CubicIn);
		pExitWheel.AddInteractConnection("ExitGateStrut_7", Map_GetProp("ExitGateStrut_7"), false, eEasing_QuartIn);
		pExitWheel.AddInteractConnection("ExitGateStrut_8", Map_GetProp("ExitGateStrut_8"), false, eEasing_SineIn);
		pExitWheel.AddInteractConnection("ExitGateStrut_9", Map_GetProp("ExitGateStrut_9"), false, eEasing_Linear);
		
		Entity_AttachToEntity("InteractAux_ExitGateWheelBase", "ExitGateWheelBase", "Body_1", true, false, true);
		Entity_AttachToEntity("InteractAux_ExitGateStrutPush_1", "ExitGateStrutPush_1", "Body_1", true, false, true);
		Entity_AttachToEntity("InteractAux_ExitGateStrutPush_2", "ExitGateStrutPush_2", "Body_1", true, false, true);
		
		Entity_StopAnimation("NestExitGrate");
		Entity_Sleep("NestExitGrate");
		
		////////////////////////////////////////
        // Set up end chase
		Entity_SetActive("ExitGateStrut_*", true);
		Entity_SetActive("BlockBox_NestExitGate_1", true);
		Entity_SetActive("ExitGateTop", true);
		
        tString sGhoul = "";
		for (int i = 1; i <= mlEndChaseGhoulCount; i++)
		{
            sGhoul = "Ghoul_EndChase_" + i;
			if (Entity_Exists(sGhoul) == false)
				continue;
			
            Ghoul_SetSuperHunt(sGhoul, false);
            Ghoul_SetCanBeAttracted(sGhoul, false);
            Ghoul_SetAdaptiveHuntSpeed(sGhoul, true, 14.f);
			Ghoul_SetAllowPlayerThrow(sGhoul, false);
		}
		
		Entity_StopAnimation("CourtyardGate");
		Entity_Sleep("CourtyardGate");
				
		Game_AutoSave();
	}

