		 {			 
			 Music_StopAll(3.f);
			 Sound_Stop("GhoulAwaken", 1.f);
			 Sound_PlayGui("player/vocalisations/hurt/player_death_wake", 1.0f);
			 
			 Entity_SetActive("Ghoul_EndChase_*", false);
			 Entity_SetActive("Trigger_DeactivateEndChaseGhouls", false);
			 Entity_SetActive("BlockBox_PortalRoomCorridorGhoul", true);
             Entity_SetActive("Trigger_ActivatePortalRoomCorridorEndChaseGhoul", true);
			 
			 msChaseRespawnMusic = "A2_3_6_GhoulNestEvent";
			 
			 Map_AddTimer("Timer_PlayPortalRoomCorridorScuffle", 5.f, "OnTimer_PlayPortalRoomCorridorScuffle");
			 
			 SetupGenericPermaFail();
			 
			 //msEndChasePermaFailArea = "PermaFail_PortalRoom";
			 FearHandler_SetPermaFailRespawnArea("PermaFail_PortalRoomCorridor");
			 return true;
		 }
		 
