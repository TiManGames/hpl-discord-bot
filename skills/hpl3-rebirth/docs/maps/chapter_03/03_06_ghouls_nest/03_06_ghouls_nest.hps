	//////////
	//AUDIO
	//////////
	 
	 //BLOCKER GHOUL//
	bool Sound_BlockerGhoulMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_PlayExt("A2_3_6_GhoulHallEating.ogg", true, 0.15f, 1.0f, 3.0f, 0.0f, eMusicPrio_SceneAmb, true);
		return false;
	}
	 
	 bool TunnelChaseSound(const tString &in asParent, const tString &in asChild, int alState)
     {
		 if (FearHandler_GetIsPermaFailing())
			 return true;
		 
         if (alState == 1 && Blackboard_GetHuntingAgentCount() > 0)
			 Sound_CreateAtEntity("ChaseTunnelSweet", "03_06_ghouls_nest/chase_sequence/tunnel/chase_tunnel_sweet", "player");
         else
			Sound_Stop("ChaseTunnelSweet", 0.5);
		 
		 return true;
     }
	 
	 /////COLLAPSED TUNNEL SWEET/////
	 
	bool Sound_TunnelGhoulSweet(const tString &in asParent, const tString &in asChild, int alState)
	{
		Sound_CreateAtEntity("Sound_GhoulTunnelEnter", "03_06_ghouls_nest/collapsed_tunnel_sweet/tunnel_enter_alert", "Sound_TunnelGhoulWarning");
		return false;
	}
	
	bool Sound_TunnelSweetStart(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		Sound_CreateAtEntity("Sound_TunnelCollapseSweet","03_06_ghouls_nest/collapsed_tunnel_sweet/collapsed_tunnel_sweet","player");
		return true;
	}
	
	bool Sound_TunnelSweetStop(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
			Sound_Stop("Sound_TunnelCollapseSweet", 0.5f);
		else
			Sound_Stop("Sound_TunnelCollapseSweet", 0.5f);
			
		return true;
	}

	bool Sound_ExitTunnelSweetEnd(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
			Sound_Stop("Sound_TunnelCollapseSweet", 0.5f);
		else
			Sound_Stop("Sound_TunnelCollapseSweet", 0.5f);
			
		return true;
	}
	
	///GHOUL TABLE WALL SCUFFLE///
	
		bool GhoulTableScuffle(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_TableGhoulScuffle","03_06_ghouls_nest/events/tunnel_table_ghoul_wall","Sound_Scuffle");
			return false;
		}
	
