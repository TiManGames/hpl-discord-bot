		 bool OnTrigger_DeactivateEndChaseGhouls(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 msEndChasePermaFailArea = "PermaFail_PortalRoomCorridor";
			 
			 tString sGhoul = "";			 
			 for (int i = 1; i <= mlEndChaseGhoulCount; i++)
			 {
				 sGhoul = "Ghoul_EndChase_" + i;
				 if (i == 11 || Entity_IsInPlayerFOV(sGhoul)) continue;
				 Entity_SetActive(sGhoul, false);
			 }			 
			 return false;
		 }
		 
