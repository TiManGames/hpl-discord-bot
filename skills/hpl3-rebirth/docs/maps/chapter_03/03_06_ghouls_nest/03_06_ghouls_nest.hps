	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
        if (alAction == eAction_Test0)
        {
			Player_Teleport("Start_Begin");
        }
		if(alAction == eAction_Test1)
		{
            Player_Teleport("Start_Bathhouse_Collapsed");
			
            if (ItemType_GetCountInInventory("VitaeCanister") < 1)
                Item_AddToInventory("VitaeCanister");
				
			cScript_SetGlobalVarBool("TTH_EncounteredBlockerGhoul", true);
			cScript_SetGlobalVarInt("TTH_HerbertsHQShadowAdvanceStage", 2);
			
			OnEnter();
			
            cLux_AddDebugMessage("OTHER SUBLEVELS COMPLETE, FIRST TIME HERE!");
		}
		if (alAction == eAction_Test2)
        {            
			//cLux_SetGodModeActivated(!cLux_GetGodModeActivated());
			
			Item_AddToInventory("Lantern");	
			Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
		}
		if (alAction == eAction_Test3)
		{
            Player_Teleport("Start_SleepingHall");      
            Entity_SetActive("Ghoul_Blocker_*", false);
			
			if (ItemType_GetCountInInventory("Lantern") < 1)
            {
                Item_AddToInventory("Lantern");	
                Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
                Item_AddToInventory("HerbertOil");
                Item_AddToInventory("Orb");
            }
		}
		if (alAction == eAction_Test4)
		{
			Player_Teleport("Start_SleepingHallGhoulTunnelEntrance", true);
			Entity_SetActive("Ghoul_Blocker_*", false);
		}
		if (alAction == eAction_Test5)
		{
			Player_Teleport("Start_Courtyard");
			Entity_SetActive("Ghoul_Blocker_*", false);
		}
        if (alAction == eAction_Test6)
        {
			Player_Teleport("Start_Temple");
			Entity_SetActive("Ghoul_Blocker_*", false);
        }
        if (alAction == eAction_Test7)
        {
			Player_Teleport("Start_ExitGate");
			Entity_SetActive("Ghoul_Blocker_*", false);
        }
        if (alAction == eAction_Test8)
        {
			Entity_SetActive("Ghoul_Blocker_*", false);	
			
			Player_Teleport("Start_EndChase");
			Entity_SetActive("ExitGateStrut_*", false);
			Entity_SetActive("BlockBox_NestExitGate_1", false);
			
			OnTimer_StartEndChase("");
			Entity_SetActive("EndChaseRoof", false);
			
			mlPermaFailStage = eGhoulsNestPermaFailStage_Chase;
			
			if (ItemType_GetCountInInventory("Lantern") < 1)
            {
                Item_AddToInventory("Lantern");	
                Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
                Item_AddToInventory("HerbertOil");
                Item_AddToInventory("Orb");
            }
        }
        if (alAction == eAction_Test9)
        { 
			//Entity_SetActive("Ghoul_*", false);
			//Entity_SetActive("Sleeper_*", false);
			
			//SwingDoor_SetOpenAmount("french_dresser_two_door_1", 1.f);
			
			//Entity_SetActive("Sleeper_Courtyard_*", true);
			
			//cLux_AddTodoMessage(""+mvCourtyardGhouls.size());
			
			Sound_Stop("Sound_GhoulWorship_*", 1.f);
        }
		if (alAction == eAction_TestPlus)
		{			
			FearHandler_FadeLevelTo(1.f, 1.f);
		}
		if (alAction == eAction_TestMinus)
		{		
			//Visibility_SetAreaActive("VisibilityArea_CourtyardTunnel", false);
			//Prop_SetHealth("TempleTable", 0.f);
			//Pathfinder_MoveToNode("Ghoul_Overlap_1", "PathNode_77", "");
			
			//OnTimer_ResumeChase("");
			
			//Entity_SetActive("Ghoul_Overlap_1", true);
			//Agent_PlayCutsceneAtEntity("Ghoul_Overlap_1", "land_on_table", "Area_OverlapGhoulAnim", 0.f, false);
			
			//Seq_FairchildPermaFail("");
			
			 tString sStandTar = "Fairchild_Gnaw_Barracks";
				 if (mbVisitedCourtyard)
					 sStandTar = "Fairchild_Gnaw_LeonsNest";
				 else
					 Pregnancy_SetWhispering(false);
					 
					 Entity_SetActive(sStandTar, true);
				
				 tString sLoop = "gnaw_on_fairchild_loop";
				 tString sIntro = "gnaw_on_fairchild_intro";
				 tString sOutro = "gnaw_on_fairchild_outro";
				 tString sStruggle = "gnaw_on_fairchild_resist";
				 tString sCallback = "OnStruggleEnd_FairchildPermaFail";
				
				 Struggle_SetAnimationEntity(sStandTar, "f_"+sLoop, "f_"+sIntro, "f_"+sOutro, "f_"+sStruggle, true);
				 Struggle_StartAnimation(sStandTar, "struggle_"+sLoop, "struggle_"+sStruggle, "struggle_"+sIntro, 
										 "struggle_"+sOutro, true, "", sCallback, sCallback, "", 10.f);
		}
	}
	
