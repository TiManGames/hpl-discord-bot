		 //-------------------------------------------------------
		 
		 void SetVitaeBankOpen(bool abX, bool abSetup = false)
		 {
			 Map_RemoveTimer("Timer_OpenVitaeBankTop");
			 Map_RemoveTimer("Timer_OpenVitaeBankSides");
			 
			 if (abX)
			 {
				 Entity_SetInteractionDisabled("VitaeCanister_1", false);
				 Entity_SetInteractionDisabled("VitaeCanister_2", false);
				 Entity_SetInteractionDisabled("BrokenVitaeCanister_1", false);
				 
				 Map_AddTimer("Timer_OpenVitaeBankTop", 0.f, "OnTimer_OpenVitaeBankTop");
				 Map_SetTimerUserVarInt("Timer_OpenVitaeBankTop", 1);
				 
				 Map_AddTimer("Timer_OpenVitaeBankSides", 1.5f, "OnTimer_OpenVitaeBankSides");
				 Map_SetTimerUserVarInt("Timer_OpenVitaeBankSides", 1);
			 }
			 else
			 {				 
				 Map_AddTimer("Timer_OpenVitaeBankTop", 1.5f, "OnTimer_OpenVitaeBankTop");
				 Map_SetTimerUserVarInt("Timer_OpenVitaeBankTop", 0);
				 
				 Map_AddTimer("Timer_OpenVitaeBankSides", 0.f, "OnTimer_OpenVitaeBankSides");
				 Map_SetTimerUserVarInt("Timer_OpenVitaeBankSides", 0);
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_OpenVitaeBankTop(const tString &in asTimer)
		 {
			 bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			 MoveObject_SetState("VitaeBank_1", bX ? 1.f : -1.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_OpenVitaeBankSides(const tString &in asTimer)
		 {
			 bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			 MoveObject_SetState("VitaeBank_2", bX ? 1.f : -1.f);
			 MoveObject_SetState("VitaeBank_3", bX ? 1.f : -1.f);
		 }
		 		 
		 //-------------------------------------------------------
		 
		 void SetWaterOrbActive(bool abX, bool abInstant = false)
		 {
			 iLuxEntity@ pEnt = mBaseObj.GetEntityByName("Portal_WaterOrb", eLuxEntityType_Prop);
			 if (pEnt is null)
				 return;
			
			if (abInstant)
			{
				pEnt.GetMeshEntity().SetDiffuseColorMul(cColor(1.f, 1.f, 1.f, abX ? 1.f : 0.f));
				pEnt.SetActive(abX);
				return;
			}
			
			mfWaterOrbFadeCount = 5.f;
			mbFadeInWaterOrb = abX;
			
			if (abX)
			{
				pEnt.SetActive(true);
				pEnt.GetMeshEntity().SetDiffuseColorMul(cColor(1.f, 1.f, 1.f, 0.f));
			}
		 }
		
		 //-------------------------------------------------------
		
		 void UpdatePortalEffects(float afDeltaTime)
		 {
			 if (mfWaterOrbFadeCount > 0.f)
			 {
				 mfWaterOrbFadeCount -= afDeltaTime;
				 float fAlpha = cMath_Clamp(mfWaterOrbFadeCount / 5.f, 0.f, 1.f);
					
				 if (mbFadeInWaterOrb)
					 fAlpha = 1.f - fAlpha;
						
				 iLuxEntity@ pOrb = mBaseObj.GetEntityByName("Portal_WaterOrb", eLuxEntityType_Prop);
				 if (pOrb !is null)
				 {
					 pOrb.GetMeshEntity().SetDiffuseColorMul(cColor(1.f, 1.f, 1.f, fAlpha));
					
					 if (mbFadeInWaterOrb == false && fAlpha <= 0.f)
						 pOrb.SetActive(false);
				 }
			 }
		 }
		 		 
