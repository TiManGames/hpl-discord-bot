		 /*Put any variables that are only used in Scene 3, Event C here.*/
         
		 array<tString> mvShadowRumbleAreas = { "Area_CollapsedRumble_1", "Area_CollapsedRumble_2", "Area_CollapsedRumble_3", "Area_CollapsedRumble_4" };
         int mlUsedShadowRumbleAreas = 0;
         int mlLastShadowRumbleId = -1;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event C here.*/
		 		 
		 void OnPathEnd_THGuide(const tString &in asEntity, bool abReachedEnd)
		 {
			 YoungTinHinan_Deactivate("TH_Guide", 1.f, false);
		 }
		 
		 //-------------------------------------------------------
         
         bool OnTrigger_Player_SettleCollapsedSlabChamberPillar(const tString &in asParent, const tString &in asChild, int alState)
         {
             Prop_RotateToSpeed("CollapsedSlabChamberPillar", 0.7f, 1.f, cVector3f(-1.f, 0.f, 0.f), false, "RotOffset_CollapsedSlabChamberPillar");
             Effect_Shake_Start(0.02f, 0.1f, 1.f, 0.5f);
             Sound_CreateAtEntity("Sound_PillarSettle", "03_03_herberts_hq/chase_tunnel/chase_tunnel_debris", "CollapsedSlabChamberPillar");
             ParticleSystem_CreateAtEntity("PS_PillarSettle", "sand_falling_stream_small_oneshot_instant.ps", "PSArea_CollapsedSlabChamberPillar", false).SetColor(cColor(1,0.894,0.703,0.3));
             
			 FearHandler_SetForcedAddFearRate(0.3f, 3.f, false, -1.f, 0.1f);
			 
             Map_AddTimer("CollapsedSlabChamberPillar", 0.7f, "OnTimer_StopSettleCollapsedSlabChamberPillar");
             return false; 
         }
         
         //------------------------------------------------------
         
         void OnTimer_StopSettleCollapsedSlabChamberPillar(const tString &in asTimer)
         {
             Sound_Stop("Sound_PillarSettle", 3.f);
             Prop_StopMovement(asTimer);
         }
         
         //------------------------------------------------------
         
         bool OnTrigger_Player_PlayCollapsedShadowRumble(const tString &in asParent, const tString &in asChild, int alState)
         {
             Map_AddTimer("Timer_PlayCollapsedShadowRumble", 0.5f, "OnTimer_PlayCollapsedShadowRumble");
			 Music_PlayExt("A2_3_3_Tomb_Ambience.ogg", true, 0.2f, 1.0f, 5.0f, 0.0f, eMusicPrio_BgAmb, true);
             return false;
         }
		 
         //-------------------------------------------------------
         
         void OnTimer_PlayCollapsedShadowRumble(const tString &in asTimer)
         {
			 Entity_SetActive("Trigger_SetWhispering_2", true);
			 
             float fMinDist = 1000.f;
             int lId = -1;
             for (int i = 0; i < mvShadowRumbleAreas.size(); i++)
             {
                 float fDist = Entity_GetDeltaToEntity("player", mvShadowRumbleAreas[i]).Length();
                 if (fDist < fMinDist && i != mlLastShadowRumbleId)
                 {
                     lId = i;
					 mlLastShadowRumbleId = i;
                     fMinDist = fDist;
                 }
             }
			 lId++;

             Sound_CreateAtEntity("Sound_ShadowRumble", "03_03_herberts_hq/shadow_guardian/shadow_guardian_death", mvShadowRumbleAreas[lId - 1]);
             
             tString sFlesh = "ShadowFlesh_Collapsed_" + lId + "_1";
             if (Entity_Exists(sFlesh) && Entity_IsActive(sFlesh) == false)
             {
                sFlesh.resize(sFlesh.length() - 1);
                sFlesh += "*";
                ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 1.5f, 3.f, true);
                
                mlUsedShadowRumbleAreas++;
				
				Entity_SetActive("FearScaryObject_Collapsed_Dynamic_" + lId + "_*", true);
				if (lId == 3)
				{
					Entity_SetActive("Trigger_ForceCollapsedFleshSpawn", false);
					Light_FadeTo("SpotLight_30", cColor(0.f), 0.f, 1.f);
				}
             }
             else
             {
                Effect_ImageTrail_Start(0.7f, 1.f, 5.f, 1.f);
                Effect_Shake_Start(0.015f, 5.f, 1.f, 1.f);
             }
			 
			 FearHandler_SetForcedAddFearRate(0.3f, 3.f, false, -1.f, 0.1f);
             
			 Map_RestartCurrentTimer(mlUsedShadowRumbleAreas >= 3 ? cMath_RandRectf(70.f, 100.f) : cMath_RandRectf(30.f, 45.f));
			 Map_SetTimerUserVarInt(asTimer, -1);
         }
         
         //-------------------------------------------------------
         
         bool OnTrigger_Player_PauseCollapsedShadowRumble(const tString &in asParent, const tString &in asChild, int alState)
         {
             if (alState == 1) return true;             
             Map_SetTimerPaused("Timer_PlayCollapsedShadowRumble", Entity_PlayerIsInFront(asParent));
             return true;
         }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ForceCollapsedFleshSpawn(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_RemoveTimer("Timer_PlayCollapsedShadowRumble");
			 Map_AddTimer("Timer_PlayCollapsedShadowRumble", 1.f, "OnTimer_PlayCollapsedShadowRumble");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_SpawnCollapseEndFlesh(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_RemoveTimer("Timer_PlayCollapsedShadowRumble");
			 Map_AddTimer("Timer_PlayCollapsedShadowRumble", mlUsedShadowRumbleAreas >= 3 ? cMath_RandRectf(70.f, 100.f) : cMath_RandRectf(30.f, 45.f), "OnTimer_PlayCollapsedShadowRumble");
			 
			 ShadowFlesh_Spawn("ShadowFlesh_CollapseEnd_*", "Decal_ShadowFlesh_CollapseEnd_*", 1.5f, 3.f, true);
			 LightFlash_Add(1.f, 0.5f, 1.f, "Area_CollapseEndFlesh_1", cColor_Red * 0.7f, 20.f, 1.f);
			 LightFlash_Add(1.f, 0.5f, 1.f, "Area_CollapseEndFlesh_2", cColor_Red * 0.7f, 20.f, 1.f);
			 
			 Entity_SetActive("FearScaryObject_CollapseEnd_*", true);
			 
			 FearHandler_SetForcedAddFearRate(0.3f, 3.f, false, -1.f, 0.1f);
			 return false;
		 }
	 
