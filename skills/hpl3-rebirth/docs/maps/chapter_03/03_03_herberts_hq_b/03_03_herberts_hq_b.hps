			 {
				 Map_AddTimer(asEntity, 3.f, "OnTimer_BreakPortalRoof");
				 mbBreakPortalRoof = false;
			 }
		 }
	
		 //-------------------------------------------------------
		 
		 void OnTimer_UpdateBeamFilter(const tString &in asTimer)
		 {
			//////////////////////////////
			// Sounds
			bool bInteractedWith = Entity_IsInteractedWith(asTimer);
			bool bJammed = Wheel_GetJammed(asTimer);
			float fAngVel = Map_GetEntity(asTimer).GetBody(0).GetAngularVelocity().Length();
						
			tString sStartSound = "03_03_herberts_hq/beam_filter/beam_filter_start";
			tString sStopSound = "03_03_herberts_hq/beam_filter/beam_filter_stop";
			
			if (bJammed)
			{
				sStartSound = "03_03_herberts_hq/beam_filter/mechanism/junction_stop";
				sStopSound = "";
			}
			
			if (fAngVel > 0.1f && mfPrevFilterAngVel < 0.1f)
				Sound_CreateAtEntity("Sound_BeamFilterStart", sStartSound, "SoundArea_BeamFilter");
			if (fAngVel < 0.1f && mfPrevFilterAngVel > 0.1f || bInteractedWith == false && fAngVel > 0.1f)
				Sound_CreateAtEntity("Sound_BeamFilterStop", sStopSound, "SoundArea_BeamFilter");
		
			Sound_Fade("Sound_RotateBeamFilter", fAngVel > 0.1f && bInteractedWith && bJammed == false ? 1.f : 0.f , 0.5f);
			
			if (bInteractedWith == false)
				Sound_Stop("Sound_RotateBeamFilter", 0.5f);
			
			//////////////////////////////
			// Auto rotate to goal if close enough!
			mfPrevFilterAngVel = fAngVel;	
				
			if (bInteractedWith == false)
			{				
				mfPrevFilterAngVel = 0.f;
			
				//////////////////
				// Auto align if close to tar/start
				float fAngle = Wheel_GetCurrentAngle(asTimer);
				float fDist = cMath_GetAngleDistanceDeg(fAngle, 0.f);
				
				if (cMath_Abs(fDist) > 30.f)
					return;
					
				Wheel_SetAngle(asTimer, cMath_ToRad(fAngle + fDist), true);    
				return;
			}
		
			Map_AddTimer(asTimer, 0.05f, "OnTimer_UpdateBeamFilter");
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event E *Turn the CONTROL WHEELs on BEAM FILTER SUBSTATIONs*
         
         /////////////////////////////////////////
		 // Event F *Replace the BROKEN VITAE CANISTER*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event F here.*/
		 
		 int mlPrevPortalRoomCanistersInPlace = 2;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event F here.*/
         
         bool CanUse_VitaeCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
         {
			 for (int i = 1; i < 4; i++)
			 {
				 tString sArea = "InteractArea_PlaceVitaeCanister_" + i;
				 if (asPickedEntity == sArea)
					 return true;
				
				 tString sBrokenCanister = "BrokenVitaeCanister_" + i;
				 if (Entity_GetCollide(sBrokenCanister, sArea) && asPickedEntity == sBrokenCanister)
					 return true;
			 }			 
			 return false;
         }
         
         //-------------------------------------------------------
         
         bool OnUse_VitaeCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, 
                                  const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
         {			 
			 int lId = cString_GetNumericSuffixInt(asTargetEntity);			 
			 SetCanisterActive(lId, true);
			 
			 Item_Unequip(asItemID);
			 Item_RemoveFromInventory(asItemID);
			 
			 cScript_SetGlobalVarBool("TTH_CanisterActive_" + lId, true);
			 
			 tString sBrokenCanister = "BrokenVitaeCanister_" + lId;
			 if (Entity_GetCollide(sBrokenCanister, asTargetEntity))
			 {
				 Prop_SetStaticPhysics(sBrokenCanister, false);				 
				 Body_AddImpulse(sBrokenCanister + "_Body_1", cVector3f(0.f, 0.5f, -1.5f), true);
			 }
			 
			 UpdatePortalState();
			 UpdatePortalRoomPower();
             return true;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_PickUpVitaeCanister(const tString &in asEntity)
		 {
			 int lId = cString_GetNumericSuffixInt(asEntity);
			 SetCanisterActive(lId, false);
			 
			 cScript_SetGlobalVarBool("TTH_CanisterActive_" + lId, false);
			 
			 Item_AddToInventory("VitaeCanister", true);
			 UpdatePortalRoomPower();
		 }
		 
		 //-------------------------------------------------------
		 
		 void UpdatePortalRoomPower()
		 {			 
			 int lCanistersInPlace = cScript_GetGlobalVarInt("TTH_PortalCanistersInPlace");
			 
			 //////////////////////////////
			 // Just one canister, turn off power!
			 if (lCanistersInPlace == 1 && mlPrevPortalRoomCanistersInPlace == 2)
			 {
				 Entity_SetActive("Fear_PortalRoom_Unsafe", true);

				 if (mbPortalRoomLightsOn)
					FadePortalRoomLights(false, 0.1f, true);
				 
				 SetSubstationState(1, false, false, true);
				 SetSubstationState(2, false, false, true);
				 SetSubstationState(3, false, false, true);
				 
				 Map_AddTimer("Timer_JamControlWheels", 5.f, "OnTimer_JamControlWheels");
			 }
			 //////////////////////////////
			 // Both canisters in, turn on power!
			 else if (lCanistersInPlace == 2 && mlPrevPortalRoomCanistersInPlace == 1)
			 {
				 FadePortalRoomLights(true, 0.1f);
				 
				 SetSubstationState(1, true);
				 SetSubstationState(2, true);
				 SetSubstationState(3, true);
				 
				 ActivatePortalDestinationFlicker(true, 0.5f);
				 
				 Entity_SetActive("Fear_PortalRoom_Unsafe", false);
			 }
			 
			 mlPrevPortalRoomCanistersInPlace = lCanistersInPlace;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_BrokenPortalCanister(const tString &in asEntity)
		 {
			 if (cString_GetNumericSuffixInt(asEntity) == 1)
				 Entity_SetActive("InteractAreaAux_BrokenPortalCanister", false);
			 				 
			 if (cScript_GetGlobalVarBool("TTH_GhoulsNestComplete") == false)
				 Voice_PlayDelayed("Dialogue_ThePortal_EmptyCanister", 1.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetCanisterActive(int alId, bool abX, bool abSetupAfterLoad = false)
		 {
			 Entity_SetActive("VitaeCanister_" + alId, abX);
			 Entity_SetActive("InteractArea_PlaceVitaeCanister_" + alId, abX == false);
			 
			 if (abX)
			 {
				 Entity_SetCollide("VitaeCanister_" + alId, false);
				 Map_AddTimer("VitaeCanister_" + alId, 1.f, "OnTimer_ActivateCanisterCollision");
			 }
			 
			 tString sTimerA = "Timer_DoCanisterEffects_Step_1_" + alId;
			 tString sTimerB = "Timer_DoCanisterEffects_Step_2_" + alId;
			 tString sLock = "CanisterLock_" + alId;
			 
			 Map_RemoveTimer(sTimerA);
			 Map_RemoveTimer(sTimerB);
			 Map_RemoveTimer("CanisterPipe_" + alId + "_1");
			 Map_RemoveTimer("CanisterPipe_" + alId + "_2");
			 Map_RemoveTimer("Timer_ResetNoCanisterLight_Step1");
			 Map_RemoveTimer("Timer_ResetNoCanisterLight_Step2");
			 
			 for (int i = 1; i < 5; ++i)
				 Map_RemoveTimer(sLock + "_" + i);
			 
			 if (abX)
			 {
				 Map_AddTimer(sTimerA, 0.001f, "OnTimer_DoCanisterEffects_Step1");
				 Map_AddTimer(sTimerB, 0.9f, "OnTimer_DoCanisterEffects_Step2");
				 
				 for (int i = 1; i < 5; ++i)
				 {
					 tString sLockTimer = sLock + "_" + i;
					 Map_AddTimer(sLockTimer, i * 0.2f, "OnTimer_PlayLockAnim");
					 Map_SetTimerUserVarInt(sLockTimer, 1);
				 }
			 }
			 else
			 {
				 Map_AddTimer(sTimerA, 0.001f, "OnTimer_DoCanisterEffects_Step1");
				 Map_AddTimer(sTimerB, 0.3f, "OnTimer_DoCanisterEffects_Step2");
				 
				 for (int i = 1; i < 5; ++i)
				 {
					 tString sLockTimer = sLock + "_" + i;
					 Map_AddTimer(sLockTimer, (4.f - (i - 1.f)) * 0.2f, "OnTimer_PlayLockAnim");
					 Map_SetTimerUserVarInt(sLockTimer, 0);
				 }
			 }
			 
			  Map_SetTimerUserVarInt(sTimerA, alId);
			  Map_SetTimerUserVarInt(sTimerB, alId);
			  Map_SetTimerUserVarString(sTimerA, abX ? "on" : "off");
			  Map_SetTimerUserVarString(sTimerB, abX ? "on" : "off");
			  
			 if (abSetupAfterLoad == false)
			 {
				 if (abX)
					 Sound_PlayGui("03_07_DW_theatre/canister_unplug/small/small_insert", 1.f, eSoundEntryType_GuiWorld);
				 else
					 Sound_PlayGui("03_07_DW_theatre/canister_unplug/small/small_remove", 1.f, eSoundEntryType_GuiWorld);
			 }
			 
			 ///////////////////
			 // Update VS canister
			 if (alId == 3 && abSetupAfterLoad == false)
				 SetVitaeStationEntranceActive(abX);

			 ///////////////////
			 // Update portal canisters
			 if (abSetupAfterLoad)
				 return;			 
			 if (alId != 1 && alId != 2)
				 return;
			 
			 int lPortalCanistersInPlace = cScript_GetGlobalVarInt("TTH_PortalCanistersInPlace");
			 cScript_SetGlobalVarInt("TTH_PortalCanistersInPlace", abX ? ++lPortalCanistersInPlace : --lPortalCanistersInPlace);
			 
			 if (lPortalCanistersInPlace == 2)
			 {
				 Entity_SetEffectsActive("VitaeBank_1", false, true);
				 
				 SetVitaeBankOpen(false);
				 Entity_SetInteractionDisabled("VitaeCanister_*", true);
				 
				 IncreasePortalRoomEventStage();
				 Sketchbook_CompleteIdea("find_vitaecanister");
				 
				 if (abSetupAfterLoad == false)
					Sound_PlayGui("03_05_vitae_station/level/vitae_energy_burst", 1.f);
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ActivateCanisterCollision(const tString &in asTimer)
		 {
			 Entity_SetCollide(asTimer, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayLockAnim(const tString &in asTimer)
		 {
			  bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			  Entity_PlayProcAnimation(asTimer, "Close", 0.3f * (bX ? 1.f : -1.f));
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoCanisterEffects_Step1(const tString &in asTimer)
		 {
			 int lId = Map_GetTimerUserVarInt(asTimer);
			 bool bX = Map_GetTimerUserVarString(asTimer) == "on";
			 
			 float fNoCanisterLight = 1.f;				 
			 Light_FadeBrightnessTo("Light_NoCanister_" + lId + "_*", bX ? 0.f : fNoCanisterLight, 0.3f, bX ? eEasing_SineOut : eEasing_SineIn);	 
			 
			 /*if (lId < 4)
			 {
				 tString sSound = "Sound_CanisterActive_" + lId;
				 if (bX)	Sound_CreateAtEntity(sSound, "04_03_undercity/machine/energy", "VitaeCanister_" + lId, 4.f);
				 else		Sound_Stop(sSound, 1.f);
			 }*/			 
					 
			 Sound_PlayGui("level_entity_shared/doors/undercity_door/stop", 0.5f, eSoundEntryType_GuiWorld);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoCanisterEffects_Step2(const tString &in asTimer)
		 {
			 int lId = Map_GetTimerUserVarInt(asTimer);
			 bool bX = Map_GetTimerUserVarString(asTimer) == "on";
			 
			  if (lId > 3)
				  return;
			 			 
			 tString sPipe = "CanisterPipe_" + lId + "_";
			 Map_AddTimer(sPipe + 1, cMath_RandRectf(0.f, 0.3f), "OnTimer_SetCanisterPipeState");
			 Map_AddTimer(sPipe + 2, cMath_RandRectf(0.f, 0.3f), "OnTimer_SetCanisterPipeState");
			 Map_SetTimerUserVarInt(sPipe + 1, bX ? 1 : 9);
			 Map_SetTimerUserVarInt(sPipe + 2, bX ? 1 : 9);
			 
			 /*tString sCog = "Cog_Canister_" + lId + "_1";
			 if (bX)	Entity_FadeProcAnimationSpeed(sCog, "Spin", 0.75f, cMath_RandRectf(1.5f, 2.5f));
			 else		Entity_FadeProcAnimationSpeed(sCog, "Spin", 0.f, cMath_RandRectf(2.f, 5.f));*/
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetCanisterPipeState(const tString &in asTimer)
		 {
			 Lamp_SetLit(asTimer, Map_GetTimerUserVarInt(asTimer) == 1, true);
		 }
         
         //-------------------------------------------------------
         
		 //} END Event F *Replace the BROKEN VITAE CANISTER*
		 
		 ////////////////////////////////////////
		 // Event G *Place the ORB*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event G here.*/
		 
		 bool mbPlacedOrb = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event G here.*/
		 
		 bool CanUse_Orb(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
         {
			 bool bRet = asPickedEntity == "InteractArea_PlaceOrb";
			 if (bRet && mbPortalCutscenePlayed == false)
			 {
				 PlayPortalCutscene();
				 return false;
			 }
			 
			 return bRet;
         }
         
         //-------------------------------------------------------
         
         bool OnUse_Orb(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, 
					    const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
         {			 
			 Item_Unequip(asItemID);
			 Item_RemoveFromInventory(asItemID);

			 PlaceOrb(true);
             return true;
         }
		 
		 //-------------------------------------------------------
		 
		 void PlaceOrb(bool abX, bool abSetupAfterLoad = false)
		 {
			 mbPlacedOrb = abX;
			 cScript_SetGlobalVarBool("TTH_PlacedOrb", abX);
			  
			 Entity_SetActive("Orb_Pedestal", abX);
			 Entity_SetActive("InteractArea_PlaceOrb", abX == false);
			 Entity_SetActive("OrbShimmer", abX);
			 
			 if (abX)
			 {
				 Entity_AttachToSocket("Orb_Pedestal", "OrbHolder", "Orb_Socket", true, true);
				 Entity_AttachToSocket("Orb_Pedestal", "OrbHolder", "Orb_Socket", true, true);
			 }
		 
			 if (abSetupAfterLoad)
			 {
				 tString sState = abX ? "Close" : "Open";
				 Entity_PlayAnimation("OrbHolder", sState);
				 Map_GetEntity("OrbHolder", eLuxEntityType_Prop).GetMeshEntity().GetAnimationStateFromName(sState).SetRelativeTimePosition(1.f);
				 
				 SetPortalButtonActive(abX);
				 UpdatePortalState();
			 }
			 else
			 {
				 Seq_PlaceOrb("");
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataPlaceOrb;
		 void Seq_PlaceOrb(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_PlaceOrb", mSeqDataPlaceOrb);
			 if (Sequence_DoStepAndWait(0.5f))
			 {
				 Sound_CreateAtEntity("PlaceOrb", "new_sounds/player/orb_put_down", "Orb_Pedestal");
//				 Sound_PlayGui("03_04_pillar_room/config_device/plate_solve_clunk", 1.f, eSoundEntryType_GuiWorld);
			 }
			 else if (Sequence_DoStepAndWait(2.5f))
			 {
				 Entity_PlayAnimation("OrbHolder", "Close", 0.f, false);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 SetCurrentPortalDestinationActive(true);
				 
				 SetPortalButtonActive(true);
				 UpdatePortalState();
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event G *Place the ORB*
		 
		 /////////////////////////////////////////
		 // Event H *Press the PORTAL BUTTON (OPTIONAL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event H here.*/
		 
		 float mfPortalActivationFlickerTime = 0.f;
		 int mlFadePortalRoomLightsStage = 0;
		 bool mbPortalRoomLightsOn = false;
		 bool mbFadePortalRoomLightsInstantly = false;
		 bool mbFadePortalRoomLightsEffects = true;
		 int mlPortalDoesntWorkDialogueCount = 1;
		 bool mbFilterEffectsActive = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event H here.*/
		 
		 void OnConnectionStateChange_PortalButton(const tString &in asEntity, int alState)
		 {
			 ActivatePortal(alState == 1);
		 }
		 
		 //-------------------------------------------------------
		 
		 void ActivatePortal(bool abActivate)
		 {
			 if (mbPortalActive && abActivate && cScript_GetGlobalVarInt("TTH_PortalCanistersInPlace") == 2)
			 {
				 /////////////////////
				 // Activate portal!
				 FadePortalRoomLights(false, 0.25f);				 
				 Seq_EnlargePortal("");	
				 
				 Entity_SetInteractionDisabled("Portal_Button", true);
				 SetPortalButtonActive(false);
				 
				 Sound_CreateAtEntity("Sound_PortalOpen_1", "03_03_herberts_hq/orb_activate/orb_activate_debris", "player");
				 Sound_CreateAtEntity("Sound_PortalOpen_2", "03_03_herberts_hq/alter_open/alter_open_quake", "player");
				 Sound_CreateAtEntity("Sound_PortalOpen_3", "03_03_herberts_hq/beam_filter/beam_filter_correct", "player");
			 
				 Music_Stop(4.0f, eMusicPrio_BigEvent);
				 
				 mbAllowPortalDestinationFlicker = false;
				 //ActivatePortalDestinationFlicker(false, 0.5f);
				 
				 msPortalDestination = "Portal_Destination_Wreckage";
				 SetCurrentPortalDestinationActive(false, cMath_RandRectf(0.15f, 0.25f));
				 msPortalDestination = "Portal_Destination_DW";
				 SetCurrentPortalDestinationActive(false, cMath_RandRectf(0.15f, 0.25f));				 
				 msPortalDestination = "Portal_Destination_Town";				 
				 SetCurrentPortalDestinationActive(true, 5.f, 2.f);
				 
				 ParticleSystem_SetVisible("PS_DestinationRefraction_*", false);
				 
				 Player_FadeMoveSpeedMulTo(0.1f, 0.f);
				 Player_FadeLookSpeedMulTo(0.6f, 5.f);
				 
				 //Achievement_Unlock(eAchievement_Traveller);
				 
				 if (cScript_GetGlobalVarBool("TTH_GhoulsNestComplete"))
					 Map_AddTimer("Timer_AlterOpenMusic", 5.9f, "OnTimer_AlterOpenMusicPlay");
					 
				 return;
			 }
			 
			 if (abActivate == false) 
				 return;
			 
			 Map_AddTimer("Timer_GivePortalFeedback", 0.5f, "OnTimer_GivePortalFeedback");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_GivePortalFeedback(const tString &in asTimer)
		 {
			 ///////////////////
			 // Give feedback on what's missing!		
			 if (Entity_IsActive("Portal") == false)
			 {
				 Sound_CreateAtEntity("Sound_PortalError", "04_03_undercity/machine/energy_off", "SoundArea_BeamFilter");
				 
				 Map_RemoveTimer("Timer_GlowingOrbLowFlicker");
				 OnTimer_GlowingOrbLowFlicker("Timer_GlowingOrbLowFlicker");
				 
				 Map_RemoveTimer("Timer_PortalDestinationFlicker");
			 } 				

			 if (mvBeamFiltersInPlace.size() != 3 ||
				 cScript_GetGlobalVarInt("TTH_PortalCanistersInPlace") < 2 || 
				 cScript_GetGlobalVarBool("TTH_PillarRoomComplete") == false)
			 {
				 Sound_CreateAtEntity("Sound_JunctionError", "03_03_herberts_hq/beam_filter/beam_filter_misaligned", "SoundArea_BeamFilter");
				 
				 if (cScript_GetGlobalVarBool("TTH_PillarRoomComplete") && Map_TimeHasPassed("Timer_FilterParticles", 20.f))
				 {
					 for (int i = 1; i < 4; ++i)
						ParticleSystem_CreateAtEntity("PS_BeamDust_" + i, "sand_falling_stream_small_oneshot_instant.ps", "Area_FilterPS_" + i, false).SetBrightness(0.4f);
				 }
				 
				 Map_RemoveTimer("Timer_FilterFlicker");
				 Map_AddTimer("Timer_FilterFlicker", 0.1f, "OnTimer_FilterFlicker");
			 }
			
			 DoSketch("tth_hint_portal_wayout", "tth_hint_portal");
			 
			 mlPortalDoesntWorkDialogueCount++;
			 if (mlPortalDoesntWorkDialogueCount % 2 == 0 && 
				 mbShadowAppeared == false && 
				 Map_TimerExists("Dialogue_PortalDoesntWork") == false)
			 {
				 Map_AddTimer("Dialogue_PortalDoesntWork", 4.f, "OnTimer_PlayDialogue");
			 }
			 
			 Map_RemoveTimer("Timer_ResetPortalPuzzleFeedback");
			 Map_AddTimer("Timer_ResetPortalPuzzleFeedback", 6.f, "OnTimer_ResetPortalPuzzleFeedback");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_FilterFlicker(const tString &in asTimer)
		 {
			 SetFilterEffectsActive(1, mbFilterEffectsActive);
			 SetFilterEffectsActive(2, mbFilterEffectsActive);
			 SetFilterEffectsActive(3, mbFilterEffectsActive);
			 
			 mbFilterEffectsActive = !mbFilterEffectsActive;
			 
			 Map_AddTimer("Timer_FilterFlicker", mbFilterEffectsActive ? 0.2f : 0.3f, "OnTimer_FilterFlicker");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_GlowingOrbLowFlicker(const tString &in asTimer)
		 {
			 float fTime = cMath_RandRectf(0.05f, 0.075f);
			 
			 mfPortalActivationFlickerTime += fTime;
			 if (mfPortalActivationFlickerTime > 2.f)
			 {
				 mfPortalActivationFlickerTime = 0.f;
				 
				 Entity_SetEffectBaseColor("Portal_GlowingOrbLow", cColor(1.f));
				 Entity_SetEffectsActive("Portal_GlowingOrbLow", false, true);
				 
				 SetCurrentPortalDestinationActive(false, 0.045f);
				 return;
			 }
			 
			 Entity_FadeEffectBaseColor("Portal_GlowingOrbLow", cColor(1.f) * cMath_RandRectf(0.02f, 1.f), fTime);
			 
			 SetCurrentPortalDestinationActive(Entity_GetEffectBaseColor(msPortalDestination) == cColor(0.f), 0.045f);
			 
			 Map_AddTimer("Timer_GlowingOrbLowFlicker", fTime, "OnTimer_GlowingOrbLowFlicker");
		 }
		 
         //-------------------------------------------------------
		 
		 void OnTimer_ResetPortalPuzzleFeedback(const tString &in asTimer)
		 {			 
			 Entity_SetEffectsActive("Portal_GlowingOrbLow", true, true);			 
			 Map_AddTimer("Timer_PortalDestinationFlicker", 0.1f, "OnTimer_PortalDestinationFlicker");
			 
			 for (int i = 1; i < 4; ++i)
				 SetFilterEffectsActive(i, mvBeamFiltersInPlace.find("BeamFilter_" + i) != -1);
			 
			 mbFilterEffectsActive = false;
			 Map_RemoveTimer("Timer_FilterFlicker");
		 }
		 
		 //-------------------------------------------------------

		 void OnTimer_AlterOpenMusicPlay(const tString &in asTimer)
		 {
			 Music_PlayExt("A2_3_3_activate_orb", false, 0.5f, 1.0f, 1.5f, 0.0f, eMusicPrio_BigEvent, false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetPortalButtonActive(bool abX, bool abSetup = false)
		 { 
			 Map_RemoveTimer("Timer_MovePortalButtonDoor");
			 Map_RemoveTimer("Timer_MovePortalButtonPlate");
			
			 if (abX)
			 {
				 Map_AddTimer("Timer_MovePortalButtonDoor", 0.f, "OnTimer_MovePortalButtonDoor");
				 Map_SetTimerUserVarInt("Timer_MovePortalButtonDoor", 1);
			
				 Map_AddTimer("Timer_MovePortalButtonPlate", 1.5f, "OnTimer_MovePortalButtonPlate");
				 Map_SetTimerUserVarInt("Timer_MovePortalButtonPlate", 1);
			 }
			 else
			 {
				 Map_AddTimer("Timer_MovePortalButtonDoor", 2.9f, "OnTimer_MovePortalButtonDoor");
				 Map_SetTimerUserVarInt("Timer_MovePortalButtonDoor", 0);
			
				 Map_AddTimer("Timer_MovePortalButtonPlate", 0.f, "OnTimer_MovePortalButtonPlate");
				 Map_SetTimerUserVarInt("Timer_MovePortalButtonPlate", 0);
			 }
		 }
		
		 //-------------------------------------------------------
		
		 void OnTimer_MovePortalButtonDoor(const tString &in asTimer)
		 {
			 bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			 MoveObject_SetState("AltarDoor", (bX ? -1.f : 0.f));
		 }
		
		 //-------------------------------------------------------
		
		 void OnTimer_MovePortalButtonPlate(const tString &in asTimer)
		 {
			 bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			 MoveObject_SetState("AltarPlate", (bX ? 0.f : -15.5f));
		 }
		 
		 //-------------------------------------------------------
		 
		 void FadePortalRoomLights(bool abLit, float afDelay = 0.1f, bool abInstant = false, bool abEffects = true)
		 {
			 mbPortalRoomLightsOn = abLit;
			 mlFadePortalRoomLightsStage = 0;
			 mbFadePortalRoomLightsInstantly = abInstant;
			 mbFadePortalRoomLightsEffects = abEffects;
			 
			 Map_AddTimer("Timer_FadePortalRoomLights", afDelay, "OnTimer_FadePortalRoomLights");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_FadePortalRoomLights(const tString &in asTimer)
		 {
			 /////////////////////////
			 // Shut on/off the lights
			 bool bGhoulsNestComplete = cScript_GetGlobalVarBool("TTH_GhoulsNestComplete");
			 
			 float fFadeTime = mbFadePortalRoomLightsEffects ? 1.f : 0.f;
			 switch (mlFadePortalRoomLightsStage)
			 {
				 case 0:
				 {	
					if (mbPortalRoomLightsOn == false)
					{
						Light_FadeTo("Light_Portal", cColor(0.511,0.822,0.782,1) * 0.4f, 7.f, fFadeTime);				 
						Entity_FadeEffectBaseColor("Portal_GlowingOrb", cColor(1.f) * 1.3f, fFadeTime);
						
						Light_FadeBrightnessTo("cage_flash_light_back", 0.f, fFadeTime);						
					}				 
					break;
				 }
				 case 1:
				 {	
					if (mbPortalRoomLightsOn == false)
					{
						if (bGhoulsNestComplete && mbPortalActive)
							ResetShadowFleshSpawnTimer();
							
						Light_FadeBrightnessTo("cage_flash_light_top", 0.f, fFadeTime);
					}
					
					Lamp_SetLit("SubstationLamp_2_*", mbPortalRoomLightsOn, mbFadePortalRoomLightsEffects);	
					Lamp_SetLit("Lamp_PortalRoomLights_2", mbPortalRoomLightsOn, mbFadePortalRoomLightsEffects);	
					Lamp_SetLit("Lamp_2_*", mbPortalRoomLightsOn, mbFadePortalRoomLightsEffects);
					break;
				 }
				 case 2:
				 {	
					if (mbPortalRoomLightsOn == false)
					{
						Light_FadeBrightnessTo("cage_flash_light_front", 0.f, fFadeTime);
					}
					
					Light_FadeBrightnessTo("SpotLight_PortalRoom_*", mbPortalRoomLightsOn ? 25.f : 0.f, fFadeTime);				 
					break;
				 }
				 case 3:
				 {	
					 if (mbPortalRoomLightsOn == false)
					 {
						 Light_FadeBrightnessTo("cage_flash_light_right", 0.f, fFadeTime);
					 }
					 
					Lamp_SetLit("SubstationLamp_3_*", mbPortalRoomLightsOn, mbFadePortalRoomLightsEffects);	
					Lamp_SetLit("Lamp_PortalRoomLights_3", mbPortalRoomLightsOn, mbFadePortalRoomLightsEffects);
					break;
				 }
				 case 4:
				 {	
					if (mbPortalRoomLightsOn == false)
					{
						if (bGhoulsNestComplete && mbPortalActive)
							ResetShadowFleshSpawnTimer();
							
						Light_FadeBrightnessTo("cage_flash_light_left", 0.f, fFadeTime);
					}
					
				    Lamp_SetLit("SubstationLamp_1_*", mbPortalRoomLightsOn, mbFadePortalRoomLightsEffects);	
					Lamp_SetLit("Lamp_PortalRoomLights_1", mbPortalRoomLightsOn, mbFadePortalRoomLightsEffects);
					break;
				 }
				 case 5:
				 {
					Lamp_SetLit("Lamp_PortalRoomLights_4", mbPortalRoomLightsOn, mbFadePortalRoomLightsEffects);
					
					if (mbPortalRoomLightsOn)
						Light_FadeBrightnessToDefault("Light_PortalLarge_*", fFadeTime);
					else
						Light_FadeBrightnessTo("Light_PortalLarge_*", 0.f, fFadeTime);
					break;
				 }
			 }
			 
			 /////////////////////////
			 // Play clunk at the start of the sequence
			 if (mbFadePortalRoomLightsEffects && mlFadePortalRoomLightsStage == 0)
			 {
				 Sound_CreateAtEntity("Sound_MachineClunk", "03_03_herberts_hq/alter_open/orb_machine_clunk", "Area_AlterOpenSounds");
			 }
			 /////////////////////////
			 // Otherwise, shake and stuff
			 else if (mbFadePortalRoomLightsEffects)
			 {
				 Effect_Shake_Start(mbPortalRoomLightsOn ? 0.005f : 0.02f, 1.f, 0.5f, 0.5f);
				 Sound_CreateAtEntity("Sound_AlterLightsOff", "03_03_herberts_hq/alter_open/alter_lights_off", "Area_AlterOpenSounds");
			 }
			 
			 /////////////////////////
			 // Continue sequence!				
			 mlFadePortalRoomLightsStage++;			 
			 if (mlFadePortalRoomLightsStage > 5)
			 {
				 mlFadePortalRoomLightsStage = 5;
				 return;
			 }
			 
			 float fTime = mbPortalRoomLightsOn ? 1.f : 0.75f;
			 if (mbFadePortalRoomLightsInstantly)					fTime = 0.1f;
			 if (mbFadePortalRoomLightsEffects == false) 			fTime = 0.f;
			 
			 Map_AddTimer("Timer_FadePortalRoomLights", fTime, "OnTimer_FadePortalRoomLights");
		 }
		 
		 //-------------------------------------------------------
         
		 //} END Event H *Press the PORTAL BUTTON (OPTIONAL)*
	 
	 //} END SCENE 1
 
