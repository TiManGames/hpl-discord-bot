//--------------------------------------------------
 
/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/

//--------------------------------------------------

const float gfMaxBeamFocus = 5.f;
 
//--------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("03-03-herberts-hq-b");
		
		// Set up color grading etc.
		
		Pregnancy_SetStage(ePregStage_Stage2);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkMinimumStage(eBabyTalkStage_TTH_BeforeName);
		Player_SetAllowCheckBaby(true);

		if (cScript_GetGlobalVarBool("TTH_Milked"))
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_MilkingToDWFA);
		}
		else
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_HQAToVitaeStation);
		}
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(1);
		StruggleFlashHandler_SetProgression(1);
		
		Player_SetAutoTeleportWhenBelowAltitude(-70.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		ImGui_PreloadImage("loadscreen_backdrop");

		///////////////
		// Preload particles
		ParticleSystem_Preload("dust_large_long_oneshot.ps");
		ParticleSystem_Preload("dust_medium_long_onehsot.ps");
		ParticleSystem_Preload("dust_impact_large_oneshot.ps");
		ParticleSystem_Preload("smoke_oneshot_grate_break.ps");
		ParticleSystem_Preload("collapse_dust_temp.ps");
		ParticleSystem_Preload("sand_falling_stream_small_oneshot_instant.ps");
		ParticleSystem_Preload("smoke_oneshot_brbreak_rock_door.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		//////////////
		// Preload sounds
		//Sound_PreloadGroup("creatures/vocalisations/creature/shadow_guardian", true);
		Sound_PreloadGhost();
					 
		Sound_PreloadEvent("04_03_undercity/machine/energy_on");
		Sound_PreloadEvent("04_03_undercity/machine/energy_off");
		Sound_PreloadEvent("03_04_pillar_room/config_device/plate_energy_misaligned");
		Sound_PreloadEvent("03_03_herberts_hq/beam_filter/beam_filter_misaligned");
		Sound_PreloadEvent("03_03_herberts_hq/beam_filter/beam_filter_correct");
		Sound_PreloadEvent("03_03_herberts_hq/alter_open/alter_open_quake");
		Sound_PreloadEvent("03_03_herberts_hq/level_complete_events/HQ_collapse");
		Sound_PreloadEvent("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated");
		Sound_PreloadEvent("level_entity_shared/fire/fire_ignite/wall_torch_ignite");
		Sound_PreloadEvent("03_07_DW_theatre/canister_unplug/large/large_insert");
		Sound_PreloadEvent("03_07_DW_theatre/canister_unplug/large/large_loop");
		Sound_PreloadEvent("03_07_DW_theatre/canister_unplug/small/small_insert");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(8);
		
		// Any general setup of script / entities
		
		//////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			if (ItemType_GetCountInInventory("Lantern") < 1)
            {
                Item_AddToInventory("Lantern");
                    
                Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
            
                Item_AddToInventory("HerbertOil");
                Item_AddToInventory("HerbertOil");
            }
			
			if (ItemType_GetCountInInventory("Orb") < 1)
                Item_AddToInventory("Orb");
            if (ItemType_GetCountInInventory("Radio") < 1)
                Item_AddToInventory("Radio");
				
			if (ItemType_GetCountInInventory("Matchbook") < 1)
			{
				Item_AddToInventory("Matchbook");
				Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
			}
		}
		
		//////////////////////
		// Set up flesh
		Entity_AddCollideCallback("player", "ShadowFlesh_*", "OnCollide_Player_ShadowFlesh");
		
		//////////////////////
		// Set up Ante-Chamber
		ParticleSystem_SetActive("PS_SlabChamberCollapse_*", false);
		
        //////////////////////
        // Set up Portal Room
		// TODO: Remove this check! Shouldn't be necessary, but OnStart seems to be called multiple times atm...
		if (cScript_GetGlobalVarBool("TTH_EnteredHQB") == false)
		{
			SetPortalButtonActive(false, true);
			
			cScript_SetGlobalVarBool("TTH_CanisterActive_1", true);
			cScript_SetGlobalVarBool("TTH_CanisterActive_2", true);
			cScript_SetGlobalVarInt("TTH_PortalCanistersInPlace", 2);
			
			cScript_SetGlobalVarBool("TTH_EnteredHQB", true);
		}		
		
		//////////////////////
		// Misc setup
		Amulet_StopTracking();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{			
		PlayerBody_SetActive(true);
		
		Player_SetMapDeepShadow(0.2f);
		
		FearHandler_SetActive(true);
		FearHandler_SetPermaFailEnabled(false);
		
		RiftHandler_SetAllowHint(false);
        
        Heat_SetActive(false);
		
		Pregnancy_SetBabyKicksEnabled(true);
		FearHandler_SetWhispersActive(true);
		
		/////////////////////////////
        // Set up vars	
        bool bPillarRoomComplete = cScript_GetGlobalVarBool("TTH_PillarRoomComplete");
        bool bVitaeStationComplete = cScript_GetGlobalVarBool("TTH_VitaeCanisterCollected");
        bool bGhoulsNestComplete = cScript_GetGlobalVarBool("TTH_GhoulsNestComplete");
		bool bVitaeStationEntranceActive = cScript_GetGlobalVarBool("TTH_VitaeStationEntranceActive");
		bool bPortalFailed = cScript_GetGlobalVarBool("TTH_PortalFailed");
		int lShadowAdvanceStage = cScript_GetGlobalVarInt("TTH_HerbertsHQShadowAdvanceStage");
		
		///////////////////////////
		// Set up flesh
		ShadowFlesh_ResetSpawnedDecalsOnMapLeave(false);
		ShadowFlesh_SetupDecals("Decal_Shadow*");
        
		/////////////////////
		// Set up wake up after Shadow chase death
		if (cScript_GetGlobalVarBool("TTH_AnteChamberWakeUp"))
		{
			cScript_SetGlobalVarBool("TTH_AnteChamberWakeUp", false);
			FearHandler_SetPermafailBabySceneEnabled(false);			
			FearHandler_TriggerPermaFail(false, "ShadowChase");
		}
		
		/////////////////////
		// Set up wake up after Ghoul's nest chase death
		if (cScript_GetGlobalVarBool("TTH_GhoulsNestDeathProgress"))
		{
			cScript_SetGlobalVarBool("TTH_GhoulsNestDeathProgress", false);
			FearHandler_SetPermafailBabySceneEnabled(false);
			FearHandler_TriggerPermaFail(false, "GhoulsNestChase");
		}
		
		////////////////////////
		// Set up chase door flesh
		if (cScript_GetGlobalVarBool("TTH_InteractedWithChaseDoor"))
		{
			Entity_SetInteractionDisabled("LevelDoor_Entrance", true);
			
			Entity_SetActive("ShadowFlesh_Entrance_*", true);
			Decal_SetDynamicVisible("Decal_ShadowFlesh_Entrance_*", true);
		}
		
		if (bGhoulsNestComplete)
			Entity_SetInteractionDisabled("LevelDoor_Entrance", true);
		
        ///////////////////////////////
        // Set up Shadow advancement
        if (lShadowAdvanceStage == 1)
		{
			Entity_SetActive("ShadowFlesh_AnteChamber_Advance_1_*", true);
			Decal_SetDynamicVisible("Decal_ShadowFlesh_AnteChamber_Advance_1_*", true);
		}
        else if (lShadowAdvanceStage == 2)
		{
			Entity_SetActive("ShadowFlesh_AnteChamber_Advance_2_*", true);
			Decal_SetDynamicVisible("Decal_ShadowFlesh_AnteChamber_Advance_2_*", true);
		}     

		///////////////////////////
		// Set up Ghoul's Nest entrance
		Ghoul_SetCanBeAttracted("Ghoul_Blocker_1", false);					
		Agent_SetSensesActive("Ghoul_Blocker_1", false);					
		Ghoul_ModeGuard_Setup("Ghoul_Blocker_1", "BlockerGhoulLookAtArea_1", "BlockerGhoulEatArea_1", "eat_ground_close_sound", "Sound_GhoulCorpseDismember_1", "eat_ground_react_to_sound");
		Ghoul_Mode_Set("Ghoul_Blocker_1", eGhoulMode_Guard, true);
		
		///////////////////////////
		// Set up Vitae Station Entrance
		Entity_PlayProcAnimation("VS_Cog_1", "Spin", 1.f, true, 0.f);
		Entity_PlayProcAnimation("VS_Cog_2", "Spin", -1.f, true, 0.f);
		Entity_PlayProcAnimation("VS_Cog_3", "Spin", 1.f, true, 0.f);
		Entity_PlayProcAnimation("VS_Cog_4", "Spin", -1.f, true, 0.f);
		
		SetVitaeStationEntranceActive(bVitaeStationEntranceActive, true);
		SetCanisterActive(3, cScript_GetGlobalVarBool("TTH_CanisterActive_3"), true);
			
		if (cScript_GetGlobalVarBool("TTH_CanisterActive_3"))
			Entity_SetActive("InteractArea_PlaceVitaeCanister_3", false);
		
		if (cScript_GetGlobalVarBool("TTH_AllowVitaeStationSymbolBark"))
			Entity_SetActive("Trigger_LookAtVitaeSymbol", true);
		
		if (bVitaeStationComplete)
		{
			DoSketch("tth_hint_vitaedoor_checked", "tth_hint_vitaedoor");
			Entity_SetActive("Trigger_PlayRememberCanisterDialogue", true);
			Entity_SetActive("Trigger_PlayRememberCanisterDialogue2", true);
			Achievement_Unlock(eAchievement_Murderer);
		}
		
		///////////////////////////
		// Set up substations
		if (bPillarRoomComplete)
		{
			Light_SetBrightness("Light_Point_Beam", 1.25f);
			
			if (bPortalFailed)
			{
				SetSubstationState(1, false, false, true);
				SetSubstationState(2, false, false, true);
				SetSubstationState(3, false, false, true);
			}
			else
			{
				SetSubstationState(1, true);
				SetSubstationState(2, true);
				SetSubstationState(3, true);
			}
		}
		else
		{
			SetSubstationState(1, true);
			SetSubstationState(2, false);
			SetSubstationState(3, false);
		}
		
		////////////////////////////
		// Set up Portal beam
		ParticleSystem_SetBrightness("PS_BeamSmoke", 0.f);
		
        if (bPillarRoomComplete)
        {								
			Entity_SetActive("Beam", true);
			Entity_SetActive("Beam_Window", true);
			Entity_SetActive("Trigger_Beam", true);
			
			Achievement_Unlock(eAchievement_Tinkerer);
			
			Light_SetBrightness("Light_Spot_pillar_room", 20.f);
			
			Sound_Play("Sound_PillarBeam", 0.3f);
			
			Map_AddTimer("Timer_UpdateBeam", 0.1f, "OnTimer_UpdateBeam");
        }
        else
        {			
			Entity_SetActive("Beam", false);
			Entity_SetActive("Beam_Window", false);			
			Entity_SetActive("Trigger_Beam", false);
			
			Light_SetBrightness("Light_Spot_pillar_room", 0.f);
        }
		
		////////////////////////////
		// Set up Portal destinations
		mbAllowPortalDestinationFlicker = false;
		
		Entity_SetEffectBaseColor("Portal_Destination_Wreckage", cColor(0.f));
		Entity_SetEffectBaseColor("Portal_Destination_Town", cColor(0.f));
		Entity_SetEffectBaseColor("Portal_Destination_DW", cColor(0.f));
				
		////////////////////////////
		// Set up Portal
		PlaceOrb(cScript_GetGlobalVarBool("TTH_PlacedOrb"), true);
				
		////////////////////////////
		// Set up wheels and filters		
		mvBeamFiltersInPlace.resize(0);
		
		if (bPillarRoomComplete)
		{
			// Just so the player will always have to align the filter!
			if (cScript_GetGlobalVarBool("TTH_SetupPortalAfterPillarsComplete") == false)
			{
				if (Entity_GetCollide("BeamFilter_1_Active", "Area_FilterMiddle"))
				{
					float fCurrentAngle = Wheel_GetCurrentAngle("ControlWheel_1");
					float fDist = cMath_GetAngleDistanceDeg(fCurrentAngle, 0.f);
					float fDir = fCurrentAngle > 0.f ? -1.f : 1.f;
					float fAngleAdd = fDist + 360.f * fDir;
					
					Wheel_SetAngle("ControlWheel_1", cMath_ToRad(fCurrentAngle + fAngleAdd), true);
				}
				
				cScript_SetGlobalVarBool("TTH_SetupPortalAfterPillarsComplete", true);
			}
		}
		
		if (bPortalFailed == false)
		{
			// Set up initial rotation
			if (cScript_GetGlobalVarBool("TTH_FirstTimeInHQB") == false)
			{
				Wheel_SetAngle("ControlWheel_1", cMath_ToRad(360.f), true);
				Wheel_SetAngle("ControlWheel_2", cMath_ToRad(0.f), true);
				Wheel_SetAngle("ControlWheel_3", cMath_ToRad(0.f), true);
				
				cScript_SetGlobalVarBool("TTH_FirstTimeInHQB", true);
			}
		}
		
		Entity_SetCollide("PortalGear_*", false);
		
		////////////////////////////
		// Set up Vitae Bank and canisters
		if (bPortalFailed)
		{
			SetVitaeBankOpen(true, true);
		}
		
		SetCanisterActive(1, cScript_GetGlobalVarBool("TTH_CanisterActive_1"), true);
		SetCanisterActive(2, cScript_GetGlobalVarBool("TTH_CanisterActive_2"), true);
			
		if (cScript_GetGlobalVarBool("TTH_CanisterActive_1"))
			Entity_SetActive("InteractArea_PlaceVitaeCanister_1", false);			
		if (cScript_GetGlobalVarBool("TTH_CanisterActive_2"))
			Entity_SetActive("InteractArea_PlaceVitaeCanister_2", false);
		
        ////////////////////////////
		// Set up Portal Room event
		Map_AddTimer("Timer_SettingUpPortal", 3.f, "");
		
		if (bGhoulsNestComplete || bPortalFailed)
		{
			FadePortalRoomLights(false, 0.f, true, false);
			Entity_SetActive("Fear_PortalRoom_Unsafe", true);
			//Entity_SetActive("Fear_PortalRoom", false);
		}			
		
        if (bGhoulsNestComplete)
        {
			Light_SetBrightness("Light_Point_CollapsedEntrance", 0.25f);
			
			Entity_SetActive("Fear_PortalRoom_Final", true);
			//Entity_SetActive("Fear_PortalRoom", false);
			
			Entity_SetActive("Trigger_StartPortalRoomEvent", true);
			Lamp_SetLit("PortalRoomEntrance_LadderLamp", false, true);
			Entity_SetActive("PortalRoomEntrance_LadderLamp", false);
			Light_SetVisible("Light_PillarRoomLadder_*", false);
			Entity_SetActive("PortalRoomEntrance_*", false);
			Entity_SetActive("PortalRoomEntranceRubble_*", true);
			Entity_SetActive("BlockBox_PillarRoomEntrance", true);
			ShadowFlesh_Spawn("ShadowFlesh_PortalRoomBlock_*", "Decal_ShadowFlesh_PortalRoomBlock_*", 0.1f, 0.1f, false, 0.f, 0.f);
			Entity_SetActive("Trigger_TakeOutOrb", false);
			
            LevelDoor_SetLocked("LevelDoor_GhoulsNest_End", true);
			Entity_SetInteractionDisabled("LevelDoor_GhoulsNest_End", true);
			
			Light_SetVisible("Light_PortalRoomEntrance_*", false);
			Light_SetBrightness("PointLight_85", 0.f);
			
			DoSketch("tth_hint_lenses");
			DoSketch("tth_arrow_lenses_portal");
			DoSketch("tth_hint_tunnels_checked", "tth_hint_tunnels");
			
			// No kicks during portal scene
			Pregnancy_SetBabyKicksEnabled(false);
        }
		
		Game_AutoSave();
	}
	

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail(const tString &in asSource)
	{
		if (asSource == "ShadowChase")
			OnPermaFail_ShadowChaseDeath();
		else if (asSource == "GhoulsNestChase")
			OnPermaFail_GhoulNestChase();
		return true;
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
        if(alAction == eAction_Test0)
		{
            Player_Teleport("Start_Begin");
		}
		if(alAction == eAction_Test1)
		{			
            cScript_SetGlobalVarBool("TTH_PillarRoomComplete", true);            
            Player_Teleport("Start_PillarRoomEntrance", true);
            OnEnter();          
			
            cLux_AddDebugMessage("PILLAR ROOM COMPLETE!");
		}
        if(alAction == eAction_Test2)
		{
			cScript_SetGlobalVarBool("TTH_VitaeCanisterCollected", true);
			
			if (ItemType_GetCountInInventory("VitaeCanister") < 1)
				Item_AddToInventory("VitaeCanister");			
			
			cScript_SetGlobalVarBool("TTH_VitaeStationEntranceActive", true);
			cScript_SetGlobalVarBool("TTH_CanisterActive_3", true);
				
            Player_Teleport("Start_VitaeStationEntrance", true);
            OnEnter();            
			
            cLux_AddDebugMessage("VITAE STATION COMPLETE!");
		}
        if(alAction == eAction_Test3)
		{
            Player_Teleport("Start_PortalRoomEntrance", true);
            OnEnter();
		}
		if (alAction == eAction_Test4)
        {       
			//cScript_SetGlobalVarBool("TTH_PillarRoomComplete", true); 
			//OnEnter();
			
			//Seq_EnlargePortal("");
			
			//Item_AddToInventory("Orb");
			
			cLux_AddTodoMessage(""+cScript_GetGlobalVarInt("TTH_PortalCanistersInPlace"));
        }
        if (alAction == eAction_Test5)
        {
			if (ItemType_GetCountInInventory("VitaeCanister") < 1)
                Item_AddToInventory("VitaeCanister");
				
			Player_Teleport("Start_VitaeStationEntranceBegin");
        }
        if (alAction == eAction_Test6)
        {
			//Seq_ShadowBreaksPortal("");
			//return;
            if (ItemType_GetCountInInventory("VitaeCanister") < 1)
                Item_AddToInventory("VitaeCanister");
			if (ItemType_GetCountInInventory("VitaeCanister") < 2)
                Item_AddToInventory("VitaeCanister");
				
			cScript_SetGlobalVarBool("TTH_CanisterActive_2", false);
			cScript_SetGlobalVarInt("TTH_PortalCanistersInPlace", 0);
			
			cScript_SetGlobalVarBool("TTH_PortalFailed", true);
            cScript_SetGlobalVarBool("TTH_PillarRoomComplete", true); 
            cScript_SetGlobalVarBool("TTH_GhoulsNestComplete", true);
			
            Player_Teleport("Start_PortalRoomEvent", true);
            OnEnter();
            
            cLux_AddDebugMessage("ALL SUBLEVELS COMPLETE!");
        }
		if (alAction == eAction_Test7)
		{							
			cScript_SetGlobalVarBool("TTH_CanisterActive_2", false);
			cScript_SetGlobalVarInt("TTH_PortalCanistersInPlace", 0);
			
			cScript_SetGlobalVarBool("TTH_PortalFailed", true);
            cScript_SetGlobalVarBool("TTH_PillarRoomComplete", true); 
            cScript_SetGlobalVarBool("TTH_GhoulsNestComplete", true);
			
            OnEnter();
						
			PlaceOrb(true, false);
			
			SetCanisterActive(1, true);
			SetCanisterActive(2, true);
			SetCanisterActive(3, true);
			
			mvBeamFiltersInPlace.resize(0);
			mvBeamFiltersInPlace.push_back("BeamFilter_1");
			mvBeamFiltersInPlace.push_back("BeamFilter_2");
			mvBeamFiltersInPlace.push_back("BeamFilter_3");
			
			OnTimer_UpdateBeam("");
			
			Map_AddTimer("Timer_SetVitaeBankOpen", 1.f, "OnTimer_SetVitaeBankOpen");
			Map_SetTimerUserVarInt("Timer_SetVitaeBankOpen", 0);

			mbShadowAppeared = true;
		}
		if (alAction == eAction_Test8)
		{
			//msFleshGhoul = "Ghoul_Flesh_2";
			//Seq_FleshGhoul("");
		}
		if (alAction == eAction_Test9)
		{
			//Entity_SetActive("ShadowFlesh_PortalRoom_*", true);
			//Entity_SetEffectsActive("PortalBeamAdd_1", true, true);c
			
			//cLux_AddTodoMessage(""+cMath_RGBToHex(cColor(0.594,1,0.995,1)));
			
			//Entity_SetActive("PortalRoomEntrance_*", false);
			//Entity_SetActive("PortalRoomEntranceBlocker_*", true);
			//ShadowFlesh_Spawn("ShadowFlesh_EntranceBreak_1_*", "", 1.5f, 3.f, true);
			//ShadowFlesh_Spawn("ShadowFlesh_EntranceStart_*", "", 1.5f, 3.f, true);
			
			cLux_SetScriptDebugOn(false);
			Player_Teleport("Start_PortalRoomCorridor");
			Seq_AnteChamberCollapse("");
		}
		if (alAction == eAction_TestMinus)
		{
			//SetVitaeBankOpen(true);
			//PlaceOrb(true);
			
			/*Entity_SetActive("TH_Cutscene", true);
			Entity_SetUpdateBonesWhenCulled("TH_Cutscene", true);
			Entity_PlayAnimation("TH_Cutscene", "tinhinan_wake_up_after_collapse", 0.f, false);
			Map_GetEntity("TH_Cutscene", eLuxEntityType_Prop).GetMeshEntity().SetCoverageAmount(0.4f);
			PlayerBody_PlayCutsceneAtEntity("player_wake_up_after_collapse", "Area_CollapsedWakeUp", false, 0.f, "OnAnimEnd_CollapseWakeUp");*/
		}
		if (alAction == eAction_TestPlus)
		{
			//SetVitaeBankOpen(false);
			
			//cScript_SetGlobalVarBool("TTH_CanisterActive_1", true);
			//cScript_SetGlobalVarBool("TTH_CanisterActive_2", true);
			//cScript_SetGlobalVarInt("TTH_PortalCanistersInPlace", 2);
			
			//cScript_SetGlobalVarBool("TTH_EnteredHQB", true);
			
			//cLux_AddTodoMessage(""+Map_GetEntity("Beam_Full").GetPosition());
			
			//Entity_SetEffectsActive("Beam_Full", true, false);
			//Entity_SetActive("Beam_Full", false);
			//cLux_AddTodoMessage(""+mvBeamFiltersInPlace.size());
			
			FearHandler_FadeLevelTo(1.f, 1.f);
			FearHandler_SetForcedAddFearRate(1.f, 10.f);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		return afY;
	}
 
	//-------------------------------------------------------
 
	//} END MAIN CALLBACKS 
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/

	[nosave] float mfPrevFilterAngVel = 0.f;
	bool mbBreakPortalRoof = false;
 
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	void Update(float afTimeStep)
	{
		UpdateCorruptedGhoulEffects(afTimeStep);
		UpdatePortalEffects(afTimeStep);
		UpdateVisionOrb(afTimeStep);
		
		///////////////////
		// Reset beam if it disappears
		cParticleSystem@ pPS_1 = mBaseObj.GetWorld().GetParticleSystem("Beam_Full_PS_1");
		cParticleSystem@ pPS_2 = mBaseObj.GetWorld().GetParticleSystem("Beam_Full_PS_2");
					 
		if (pPS_1 !is null && pPS_1.GetWorldPosition().SqrLength() > 0.f)
			return;
		
		if (pPS_1 !is null)
		{
			cMatrixf mtxNew = cMath_MatrixTranslate(cVector3f(-94.996f, 6.964f, 131.6f));
			cMatrixf mtxRot = cMath_MatrixRotateXYZ(cVector3f(0.f, 0.f, cMath_Pi));
			cMatrixf mtxScale = cMath_MatrixScale(cVector3f(0.25f, 1.f, 0.25f));
			mtxNew.SetRotation(cMath_MatrixMul(mtxRot, mtxScale));
			pPS_1.SetWorldMatrix(mtxNew);
		}
					 
		if (pPS_2 !is null)
		{
			pPS_2.SetWorldMatrix(cMath_MatrixTranslate(cVector3f(-94.996f, -0.535f, 131.6f)));	
		}
	}
	
