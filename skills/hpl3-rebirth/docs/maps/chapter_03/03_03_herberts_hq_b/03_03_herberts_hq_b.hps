    bool OnCollide_Player_ShadowFlesh(const tString &in asParent, const tString &in asChild, int alState)
    {
        if (alState == -1) return true;
        if (Map_TimeHasPassed("Timer_ShadowFleshDamage", 1.f) == false) return true;
        
        Player_GiveDamage(0.1f, 0.2f, eDamageType_Guardian, asParent);
        return cMath_RandRectl(0, 1) == 1;
    }
	
