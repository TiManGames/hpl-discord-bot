		 /////////////////////////////////////////
		 // Event A *Explore the area*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event A here.*/
	 
		 bool mbPlayedLadderDialogue = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event A here.*/
         
		 bool OnTrigger_Player_ActivatePillarRoomLadderLight(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Lamp_SetLit("PortalRoomEntrance_LadderLamp", true, true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_PlayLadderBark(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Ladder)
				 return true;
				 
			 if (mbPlayedLadderDialogue == false)
			 {
				 mbPlayedLadderDialogue = true;
				 Voice_Play("Global_Tasi_Bark_Stage2_Climb_Medium_Done"); // Short ladder, forcing this bark here
			 }
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
         void OnLookAt_PlayDialogueTrapped(const tString &in asEntity, int alState)
         {
             //Voice_PlayWhenPossible("Dialogue_Trapped");
             Entity_SetActive("Trigger_PlayDialogueTrapped_*", false);
         }
	 
