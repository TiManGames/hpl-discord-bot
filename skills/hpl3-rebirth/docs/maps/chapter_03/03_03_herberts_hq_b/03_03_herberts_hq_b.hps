	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 4 *ACTIVATE THE PORTAL AND ESCAPE*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 4 here.*/
		
        bool mbShadowAppeared = false;
        array<int> mvRemainingBeamFilters = {1, 2, 3};

		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 4 here.*/
		
		void IncreasePortalRoomEventStage()
		{		
            int lStage = cScript_GetGlobalVarInt("TTH_HerbertsHQPortalRoomEventStage") + 1;
            cScript_SetGlobalVarInt("TTH_HerbertsHQPortalRoomEventStage", lStage);
			
			switch (lStage)
			{
				case 1:
					Seq_ShadowAppear("");
					break;
                case 2:
					Entity_SetActive("Trigger_SpawnTrapShadowFlesh_*", true);					
					mbBreakPortalRoof = true;
					break;
				case 3:					
					Entity_SetActive("Trigger_StartSeqFleshGhoul_*", true);
					
					//////////////////////////
					// If the player still has to use filter at the upper level, deactivate other triggers
					if (Entity_GetCollide("Trigger_BeamFilterLens_3", "Trigger_Beam") == false)
					{
						Entity_SetActive("Trigger_StartSeqFleshGhoul_3", false);
						Entity_SetActive("Trigger_StartSeqFleshGhoul_4", false);
						Entity_SetActive("Trigger_StartSeqFleshGhoul_5", false);
					}
					
					Voice_PlayWhenPossible("Dialogue_ThePortal_AllGoesToHell", "", 10.f, 1.f);
					
					mbBreakPortalRoof = true;
					break;
				case 4:
                    Entity_SetActive("Trigger_SpawnPortalBlockFlesh_*", true);
                    break;
			}
		}
		
		//-------------------------------------------------------
		 
		 void OnTimer_UpdatePortalRoomEventFear(const tString &in asTimer)
		 {
			 if (FearHandler_GetRate() < 0.1f)
				 FearHandler_SetForcedAddFearRate(0.1f, -1.f, false);
				 
			 Map_AddTimer("Timer_UpdatePortalRoomEventFear", 1.f, "OnTimer_UpdatePortalRoomEventFear");
		 }

        //-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Ghouls bang on door*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event A here.*/
		 
		 bool mbPortalRoomEventStarted = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functionsthat are only used in Scene 4, Event A here.*/
		 
		 bool OnTrigger_Player_StartPortalRoomEvent(const tString &in asParent, const tString &in asChild, int alState)
		 {		 
			 if (FearHandler_GetIsPermaFailing() == false)
			 {
				Voice_PlayDelayed("Dialogue_ThePortal_GotBack", 1.f, -1, "");
				if (FearHandler_GetLevel() > 0.5f)
					FearHandler_FadeLevelTo(0.5f, 0.f, true);
			 }
			 
			 mbPortalRoomEventStarted = true;
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_StartSeqBangOnDoor(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Seq_BangOnPortalRoomDoor("");
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSequenceBangOnPortalRoomDoorData;
		 void Seq_BangOnPortalRoomDoor(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_BangOnPortalRoomDoor", mSequenceBangOnPortalRoomDoorData);
			 Sequence_Wait(0.2f);
			 if (Sequence_DoStepAndWait(1.f)) 			BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.4f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.6f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.7f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.4f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.5f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.8f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(4.f)) 		BangOnPortalRoomDoor(true);
			 else if (Sequence_DoStepAndWait(5.f)) 		BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.4f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.3f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.6f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.7f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(6.f)) 		BangOnPortalRoomDoor(true);
			 else if (Sequence_DoStepAndWait(0.5f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(2.4f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.3f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(8.f)) 		BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.5f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.4f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(0.7f)) 	BangOnPortalRoomDoor();
			 else if (Sequence_DoStepAndWait(6.f)) 		BangOnPortalRoomDoor(true);
			 else if (Sequence_DoStepAndContinue())
			 {
				 Map_AddTimer("Timer_BangOnPortalRoomDoor", 7.f, "Seq_BangOnPortalRoomDoor");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void BangOnPortalRoomDoor(bool abScream = false)
		 {			
			 if (abScream)
				  Sound_CreateAtEntity("Sound_PortalRoomDoorScream", "creatures/vocalisations/creature/ghoul/ghoul_door_scream", "Area_PortalRoomDoor");
			 else
				 Sound_CreateAtEntity("Sound_PortalRoomDoorBang", "level_entity_shared/doors/tin_hinan_door/tin_hinan_door_hit", "Area_PortalRoomDoor");				
			 
			 Body_AddImpulse("LevelDoor_GhoulsNest_End_Body_1", cVector3f(0.f, 0.f, -1.f), false);
			 ParticleSystem_CreateAtEntity("PS_BreakPortalRoomDoor", "smoke_oneshot_brbreak_rock_door.ps", "Area_PortalRoomDoor", false).SetBrightness(0.1f);
			 
			 if (Entity_GetDeltaToEntity("player", "Area_PortalRoomDoor").SqrLength() < 20.f * 20.f)
				FearHandler_SetForcedAddFearRate(0.14f, 2.f, true, -1.f, 0.025f);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Ghouls bang on door*
         
         /////////////////////////////////////////
		 // Event B *The Shadow appears*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event B here.*/
		 
		 cSequenceStatesData mSeqDataShadowAppear;
		 void Seq_ShadowAppear(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_ShadowAppear", mSeqDataShadowAppear);
			 Sequence_Wait(8.f);
			 if (Sequence_DoStepAndWait(2.f))
			 {
				 if (mbShadowAppeared || cScript_GetGlobalVarBool("TTH_GhoulsNestComplete") == false)
				 {
					 SequenceStates_Stop("Seq_ShadowAppear");
				 }
				 else
				 {
					 mbShadowAppeared = true;
					 FearArea_SetSafe("Fear_PortalRoom_Final", false);
				 }
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Entity_SetActive("Trigger_StartSeqBangOnDoor", true);
				
				 Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);
				 //Music_PlayExt("A2_3_3_herberts_hq", true, 0.2f, 0.8f, 5.0f, 0.0f, eMusicPrio_BigEvent, true); 
			 			 
			     FearHandler_SetForcedAddFearRate(0.5f, 6.f, false, -1.f, 0.1f);
				
				 ShadowFlesh_Spawn("ShadowFlesh_PortalRoom_Appear_1_*", "Decal_ShadowFlesh_PortalRoom_Appear_1_*", 1.5f, 3.f, true);			 
				 Light_FadeBrightnessTo("Light_ShadowAppear", 10.f, 0.75f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Light_FadeBrightnessToDefault("Light_ShadowAppear", 0.75f);

				 Map_AddTimer("Timer_UpdatePortalRoomEventFear", 1.f, "OnTimer_UpdatePortalRoomEventFear");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_PortalRoom_Appear_2_*", "Decal_ShadowFlesh_PortalRoom_Appear_2_*", 1.5f, 3.f, true);
				 ResetShadowFleshSpawnTimer();				 
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Music_PlayExt("A2_4_2_DoctorTunnelChase.ogg", true, 0.6f, 1.0f, 5.0f, 0.0f, eMusicPrio_BigEvent, true);
				 
				 Prop_SetHealth("BreakablePillar_PortalRoom_Entrance_1", 0.f);
				 Sound_CreateAtEntity("Sound_BreakPillar", "03_03_herberts_hq/level/wall_break", "BreakablePillar_PortalRoom_Entrance_1");
				 
				 Voice_Play("Dialogue_ThePortal_ShadowWakes");
			 }
			 Sequence_End();
		 }
		
		 //-------------------------------------------------------
	 
		 //} END Event B *The Shadow appears*
         
         /////////////////////////////////////////
		 // Event C *Configure the BEAM FILTERs*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event C here.*/
		 
		 float mfBeamFocus = 0.f;
		 array<tString> mvBeamFiltersInPlace;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event C here.*/
	 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_BeamFilterLens_AffectBeam(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
			 int lId = cString_GetNumericSuffixInt(asChild);
			 
			 //////////////////////
			 // Effects!			 
             if (alState == 1)
			 {
				 int lFilterId = mvBeamFiltersInPlace.find("BeamFilter_" + lId);
				 if (lFilterId == -1)
					mvBeamFiltersInPlace.push_back("BeamFilter_" + lId);
				 
				 SetFilterEffectsActive(lId, true);
				 
				 if (Map_TimerExists("Timer_SettingUpPortal") == false)
					 Sound_PlayGui("03_05_vitae_station/level/vitae_energy_burst", 1.f, eSoundEntryType_GuiWorld);
					 
				 if (mvBeamFiltersInPlace.size() == 3 && cScript_GetGlobalVarBool("TTH_GhoulsNestComplete"))
					 Voice_PlayDelayed("Dialogue_ThePortal_SolvedFocus", 1.f);
					 
				 if (mvBeamFiltersInPlace.size() == 3)
				 {
					 Entity_SetEffectsActive("Beam", false, true);
					 
					 Entity_SetActive("Beam_Full", true);
					 Map_RemoveTimer("Timer_DeactiveFullBeam");
					 //Entity_SetEffectsActive("Beam_Full", true, false);
				 }
			 }
			 else
			 {
				 if (mvBeamFiltersInPlace.size() == 3)
				 {
					 Entity_SetEffectsActive("Beam", true, true);
					 
					 Map_RemoveTimer("Timer_DeactiveFullBeam");
					 Map_AddTimer("Timer_DeactiveFullBeam", 0.1f, "OnTimer_DeactivateFullBeam");
					 //Entity_SetEffectsActive("Beam_Full", false, true);
				 }
				 
				 int lFilterId = mvBeamFiltersInPlace.find("BeamFilter_" + lId);
				 if (lFilterId != -1)
					 mvBeamFiltersInPlace.removeAt(lFilterId);
				 
				 SetFilterEffectsActive(lId, false);
			 }
                 		 
			 if (Map_TimerExists("Timer_UpdateBeam") == false)
				 OnTimer_UpdateBeam("");	
			 
			 //////////////////////
             // Increase event stage
			 if (alState == -1 || 
			     mbPortalRoomEventStarted == false ||
				 cScript_GetGlobalVarBool("TTH_GhoulsNestComplete") == false) 
				 return true;
             
			 int lRemainingFilterId = mvRemainingBeamFilters.find(lId);			 
			 if (lRemainingFilterId != -1)
			 {
				 mvRemainingBeamFilters.removeAt(lRemainingFilterId);
				 IncreasePortalRoomEventStage();
				 
				 mlDummyFleshSpawnCount = 0; // Reset dummy spawns
			 }             
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DeactivateFullBeam(const tString &in asTimer)
		 {
			 Entity_SetActive("Beam_Full", false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetFilterEffectsActive(int alId, bool abX)
		 {
			 tString sFilter = "BeamFilter_" + alId + "_Active";
			 tString sJunction = "PillarJunction_" + alId + "_Active";
			 tString sLamp = "SubstationLamp_" + alId + "_*";
			 
			 if (abX)
			 {
				 const float fMul = 4.f;
				 Entity_FadeEffectBaseColor(sFilter, cColor(0.58*fMul, 1*fMul, 0.8*fMul,1), 0.5f);				 
				 Entity_FadeEffectBaseColor(sJunction, cColor(0.58*fMul, 1*fMul, 0.8*fMul,1), 0.5f);
				 Entity_FadeEffectBaseColor(sLamp, cColor(0.306*2,0.871*2,0.792*2,1), 0.5f);
			 }
			 else
			 {
				 Entity_FadeEffectBaseColor(sFilter, cColor(0.58, 1, 0.8,1), 0.5f);
				 Entity_FadeEffectBaseColor(sJunction, cColor(0.58, 1, 0.8,1), 0.5f);
				 Entity_FadeEffectBaseColor(sLamp, cColor(1,1,1,1), 0.5f);
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_UpdateBeam(const tString &in asTimer)
		 {
			////////////////////
			// Adjust beam effects
			iLuxEntity@ pEnt = Map_GetEntity("Beam", eLuxEntityType_Prop);
			cBillboard@ pBeam = pEnt.GetBillboardFromName("Billboard_1");
			cBillboard@ pBeam_2 = pEnt.GetBillboardFromName("Billboard_2");
			
			cVector3f vBeamPos = Map_GetEntity("Area_BeamStartPos").GetPosition();
			cVector2f vBeamSize = cVector2f(5.f, 15.f);
			
			float fBeamFocusTarget = mvBeamFiltersInPlace.size() * (gfMaxBeamFocus / 3.f);
			mfBeamFocus = cMath_InterpolateLinear(mfBeamFocus, fBeamFocusTarget, 1.f / 10.f);
			
			if (cMath_Abs(mfBeamFocus - fBeamFocusTarget) <= 0.05f)
				mfBeamFocus = fBeamFocusTarget;
			
			vBeamPos.y -= mfBeamFocus * 0.5f;
			vBeamSize.x -= mfBeamFocus;
			vBeamSize.y += mfBeamFocus;
				
			vBeamSize.x = cMath_Max(vBeamSize.x, 0.5f);
			pBeam.SetSize(vBeamSize);
			pBeam_2.SetSize(cVector2f(vBeamSize.x * 0.5f, vBeamSize.y));
			
			float fBeamBrightness = 0.25f + cMath_Easing(eEasing_ExpoIn, 1.f - (vBeamSize.x / 5.f)) * 40.f;
			pBeam.SetBrightness(fBeamBrightness);
			pBeam_2.SetBrightness(fBeamBrightness * 2.f);
			
			float fCageLightBrightness = cMath_Easing(eEasing_CubicIn, cMath_Clamp(mfBeamFocus / gfMaxBeamFocus, 0.f, 1.f)) * 7.f;
			Light_SetBrightness("cage_flash_light_*", fCageLightBrightness);			
			Light_SetBrightness("Light_BeamSpec", cMath_Clamp(mfBeamFocus / gfMaxBeamFocus, 0.f, 1.f) * 70.f);
			
			pEnt.SetSaveDataIsUpdated(true);
			pEnt.SetScriptableIsSaved(true);
			
			////////////////////
			// Update portal state!
			UpdatePortalState();
			
			////////////////////
			// Stop updating if focus close to tar!
			if (cMath_Abs(mfBeamFocus - fBeamFocusTarget) <= 0.05f)
				return;
				
			Map_AddTimer("Timer_UpdateBeam", (1.f / 60.f), "OnTimer_UpdateBeam");
		 }
		 
		 //-------------------------------------------------------
		 
		 void UpdatePortalState()
		 {			 
			 ///////////////////
			 // Activate portal?
			 if (mfBeamFocus >= gfMaxBeamFocus && mbPlacedOrb)
			 {
				 Entity_SetActive("OrbFlare", true);
				 Entity_SetEffectsActive("OrbFlare", false, false);
				 Entity_SetEffectsActive("OrbFlare", true, true);
				 				 
				 if (mbPortalActive == false && cScript_GetGlobalVarInt("TTH_PortalCanistersInPlace") == 2)
				 {	
					 mbPortalActive = true;

					 Amulet_StartTracking(true, "", -1.f);
					 					 
					 Entity_SetActive("Portal", true);					
					 Entity_SetActive("Trigger_PortalAccessPlatform", true);
					 
					 Sound_Play("Sound_PortalLoop", 0.5f);
						 
					 Sound_CreateAtEntity("Sound_BeamFilterBurst", "03_03_herberts_hq/orb_activate/orb_activate_power_up", "Portal");
					 Sound_PlayGui("03_04_pillar_room/pillar_activate/pillar_energy_burst", 1.f, eSoundEntryType_GuiWorld);
						 
					 DoSketch("tth_hint_portal_tasi", "tth_hint_portal_wayout");
					 DoSketch("tth_hint_lenses_checked", "tth_hint_lenses");
				 }
				 return;
			 }
			 
			 //////////////////////////
			 // Not all filters are in place/no orb, stop portal!
			 Entity_SetEffectsActive("OrbFlare", false, true);
				 
			 if (mbPortalActive)
			 {
				 mbPortalActive = false;
					 
				 Amulet_StopTracking();
				 
				 Entity_SetActive("Portal", false);				 
				 Entity_SetActive("Trigger_PortalAccessPlatform", false);
				 
				 Sound_Stop("Sound_PortalLoop", 0.5f);
			 }
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *Configure the BEAM FILTERs*
		 
		  /////////////////////////////////////////
		 // Event D *SHADOW FLESH appears in intervals*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event D here.*/
		 
		 array<tString> mvPortalEventShadowFlesh = { "ShadowFlesh_PortalRoom_Dynamic_001_*", "ShadowFlesh_PortalRoom_Dynamic_002_*",
													 "ShadowFlesh_PortalRoom_Dynamic_003_*", "ShadowFlesh_PortalRoom_Dynamic_004_*",
													 "ShadowFlesh_PortalRoom_Dynamic_005_*", "ShadowFlesh_PortalRoom_Dynamic_006_*",
													 "ShadowFlesh_PortalRoom_Dynamic_007_*", "ShadowFlesh_PortalRoom_Dynamic_008_*",
													 "ShadowFlesh_PortalRoom_Dynamic_009_*", "ShadowFlesh_PortalRoom_Dynamic_010_*", 
													 "ShadowFlesh_PortalRoom_Dynamic_011_*", "ShadowFlesh_PortalRoom_Dynamic_012_*",
													 "ShadowFlesh_PortalRoom_Dynamic_013_*", "ShadowFlesh_PortalRoom_Dynamic_014_*",
													 "ShadowFlesh_PortalRoom_Dynamic_015_*", "ShadowFlesh_PortalRoom_Dynamic_016_*"}; 
													 
		 array<tString> mvDummyFleshSpawnAreas = { "Area_DummyFleshSpawn_1", "Area_DummyFleshSpawn_2", "Area_DummyFleshSpawn_3",
												   "Area_DummyFleshSpawn_4", "Area_DummyFleshSpawn_5", "Area_DummyFleshSpawn_6",
												   "Area_DummyFleshSpawn_7", "Area_DummyFleshSpawn_8", "Area_DummyFleshSpawn_9"};
		 int mlDummyFleshSpawnCount = 0;		 
		 bool mbPortalRoomFailActive = false;
                                                     		 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event D here.*/
		 
		 void OnTimer_SpawnShadowFlesh(const tString &in asTimer)
		 {
             int lSize = mvPortalEventShadowFlesh.size();
			 
			 ////////////////////////////
             // No more flesh, do dummy spawn effects!			 
			 if (lSize == 0 && mlDummyFleshSpawnCount < 5)
			 {
				 tString sArea = mvDummyFleshSpawnAreas[cMath_RandRectl(0, mvDummyFleshSpawnAreas.size() - 1)];
				 
				 if (Entity_Exists(sArea))
				 {
					 ShadowFlesh_DoFleshEffectsAtPos(Map_GetEntity(sArea).GetPosition(), cMath_RandRectf(20.f, 30.f));
					 ResetShadowFleshSpawnTimer();
					 
					 ++mlDummyFleshSpawnCount;
					 return;
				 }
			 }
			 
			 ////////////////////////////
             // No more flesh and done enough dummies, trigger portal!
             if (lSize == 0 && mbPortalRoomFailActive == false)
             {
				 Entity_SetActive("Portal", true);
                 Entity_SetActive("Trigger_PortalAccessPlatform", true);
                 Sound_Play("Sound_PortalLoop", 0.5f);
				 
				 Sound_CreateAtEntity("Sound_BeamFilterBurst", "03_03_herberts_hq/orb_activate/orb_activate_power_up", "SoundArea_BeamFilter");
				 
				 Entity_SetActive("Portal_GlowingOrb", true);
				 Entity_SetEffectsActive("Portal_GlowingOrb", false, false);
				 Entity_SetEffectsActive("Portal_GlowingOrb", true, true);

				 FadePortalRoomLights(false, 0.25f);				 
				 Seq_EnlargePortal("");
				 				 
				 mbPortalRoomFailActive = true;
                 return;
             }
			 
			 if (lSize == 0)
				 return;
             
			 ////////////////////////////
             // Spawn flesh most likely to be seen
			 ResetShadowFleshSpawnTimer();
			 
			 float fMinDistSqr = 1000.f * 1000.f;
			 int lIndex = -1;		
             tString sFlesh = "";
			 for (int i = 0; i < mvPortalEventShadowFlesh.size(); i++)
			 {
				 sFlesh = mvPortalEventShadowFlesh[i];
				 sFlesh.resize(sFlesh.length() - 1);
				 sFlesh += 1;
				 
				 float fDistSqr = Entity_GetDeltaToEntity("player", sFlesh).SqrLength();
                 if (Entity_IsInPlayerFOV(sFlesh)) fDistSqr *= 0.1f;
				 if (fDistSqr < fMinDistSqr)
				 {
					 fMinDistSqr = fDistSqr;
					 lIndex = i;
				 }
			 }
			 
			 if (lIndex == -1)
				 lIndex = cMath_RandRectl(0, mvPortalEventShadowFlesh.size() - 1);
				 
			 sFlesh = mvPortalEventShadowFlesh[lIndex];
			 mvPortalEventShadowFlesh.removeAt(lIndex);

             ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 1.5f, 2.5f, true);
			 
			 if (FearHandler_GetRate() < 0.3f)
				FearHandler_SetForcedAddFearRate(0.3f, 6.f, false, -1.f, 0.1f);
             
			 /////////////////////////
			 // Break stuff!			 
             tString sWall = "BreakableWall_PortalRoom_Dynamic_" + cString_Sub(sFlesh, 31, 3);
             if (Entity_Exists(sWall))
             {
                 Prop_SetHealth(sWall, 0.f);
                 Sound_CreateAtEntity("Sound_BreakWall", "03_03_herberts_hq/level/wall_break", sWall);
				 
				 tString sExtraBreakEnt = Entity_GetVarString(sWall, "");
				 if (Entity_Exists(sExtraBreakEnt))
					 Prop_SetHealth(sExtraBreakEnt, 0.f);
             }
			              
             sFlesh.resize(sFlesh.length() - 1);
             sFlesh += 1;

			 tString sPillar = "";
			 tString sClosestPillar = "";
			 float fMinDistToPillarSqr = 1000.f * 1000.f;
			 for (int i = 1; i < 12; i++)
			 {
				 sPillar = "BreakablePillar_PortalRoom_" + i;
				 if (Entity_Exists(sPillar) == false) continue;
				 
				 float fDistSqr = Entity_GetDeltaToEntity(sPillar, sFlesh).SqrLength();
				 if (fDistSqr < fMinDistToPillarSqr)
				 {
					 fMinDistToPillarSqr = fDistSqr;
					 sClosestPillar = sPillar;
				 }
				 
				 Map_AddTimer(sClosestPillar, 0.25f, "OnTimer_BreakProp");
			 }
		 }
	 
		 //-------------------------------------------------------
         
         void ResetShadowFleshSpawnTimer()
         {
             Map_RemoveTimer("Timer_SpawnShadowFlesh");
             Map_AddTimer("Timer_SpawnShadowFlesh", cMath_RandRectf(7.f, 12.f), "OnTimer_SpawnShadowFlesh");
         }
		 
		 //-------------------------------------------------------
		 
		 void OnBreak_PortalRoomWall(const tString &in asEntity)
		 {
			 Prop_SetHealth(Entity_GetVarString(asEntity, ""), 0.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_BreakPortalRoof(const tString &in asTimer)
		 {
			 int lId = 2;//cString_GetNumericSuffixInt(asTimer);
			 tString sWall = "BreakableWall_PortalRoom_Roof_" + lId;
			 
			 if (Entity_IsActive(sWall))
			 {
				 Prop_SetHealth(sWall, 0.f);			 
				 
				 tString sFlesh = "ShadowFlesh_PortalRoom_Roof_" + lId + "_*";
				 ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 1.5f, 3.f, true);
				 Sound_CreateAtEntity("Sound_BreakWall", "03_03_herberts_hq/level/wall_break", sWall);
			 }
			 
			 msPortalRoomBreakCorner = lId == 1 ? "BreakablePillar_PortalRoom_R_Corner_" : "BreakablePillar_PortalRoom_L_Corner_";
			 if (Entity_IsActive(msPortalRoomBreakCorner + 1))
				 Seq_BreakPortalRoomCorner("");
		 }
         
         //-------------------------------------------------------
		 
		 void OnBreak_PortalRoomRoof(const tString &in asEntity)
		 {
			 Entity_SetColorMul(asEntity + "_broken", cColor(0.193,0.22,0.248,1));
			 iLuxEntity@ pEnt = Map_GetEntity(asEntity + "_broken");
			 pEnt.GetBodyFromName("Body_3").SetMass(0.f);
			 pEnt.GetBodyFromName("Body_4").SetMass(0.f);
			 pEnt.GetBodyFromName("Body_5").SetMass(0.f);
		 }
         
         //-------------------------------------------------------
	 
		 //} END Event D *SHADOW FLESH appears in intervals*
         
         /////////////////////////////////////////
		 // Event E *ROOF breaks*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event E here.*/
		 
		 tString msPortalRoomBreakCorner = "";
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event E here.*/
		 
		 cSequenceStatesData mSequenceBreakPortalRoomCornerData;
		 void Seq_BreakPortalRoomCorner(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_BreakPortalRoomCorner", mSequenceBreakPortalRoomCornerData);
			 if (Sequence_DoStepAndWait(1.f))
			 {
				 //Sound_PlayGui("temp_quake.ogg", 0.6f, eSoundEntryType_GuiWorld);
				 Effect_Shake_Start(0.02f, 9.f, 1.f, 1.f);
			 }
			 else if (Sequence_DoStepAndWait(0.75f))
			 {
				 Prop_SetHealth(msPortalRoomBreakCorner + 1, 0.f);
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 Prop_SetHealth(msPortalRoomBreakCorner + 2, 0.f);
			 }
			 else if (Sequence_DoStepAndWait(0.55f))
			 {
				 Prop_SetHealth(msPortalRoomBreakCorner + 3, 0.f);
			 }
			 else if (Sequence_DoStepAndWait(0.25f))
			 {
				 Prop_SetHealth(msPortalRoomBreakCorner + 4, 0.f);
			 }
			 Sequence_End();
		 }
			
		 //-------------------------------------------------------
		 
		 //} END Event E *ROOF breaks*
         
         /////////////////////////////////////////
		 // Event F *Get trapped by Shadow Flesh*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event F here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event F here.*/
         
         bool OnTrigger_Player_SpawnTrapShadowFlesh(const tString &in asParent, const tString &in asChild, int alState)
         {
			 if (alState == 1 || Entity_PlayerIsInFront(asParent) == false) return true;
			 
			 ////////////////////////
			 // Make sure the flesh ghoul doesn't get spawned behind the blocking flesh
			 if (asParent == "Trigger_SpawnTrapShadowFlesh_3_2" || asParent == "Trigger_SpawnTrapShadowFlesh_3_1")
				 Entity_SetVarBool("Trigger_StartSeqFleshGhoul_1", "DisableFleshGhoul", true);
             else if (asParent == "Trigger_SpawnTrapShadowFlesh_3_3" || asParent == "Trigger_SpawnTrapShadowFlesh_3_5")	
				 Entity_SetVarBool("Trigger_StartSeqFleshGhoul_2", "DisableFleshGhoul", true);
			 
             Map_RemoveTimer("Timer_SpawnShadowFlesh");
             Map_AddTimer(asParent, 0.2f, "OnTimer_SpawnTrapShadowFlesh");
			 
			 Entity_SetActive(asParent, false);
			 if (cString_Sub(asParent, 0, 30) == "Trigger_SpawnTrapShadowFlesh_3")
				 Entity_SetActive("Trigger_SpawnTrapShadowFlesh_3_*", false);
				 
             return true;
         }
         
         //-------------------------------------------------------
         
         void OnTimer_SpawnTrapShadowFlesh(const tString &in asTimer)
         {
			 tString sFlesh = Entity_GetVarString(asTimer, "");
             ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 1.f, 2.f, true);
			 Entity_SetActive("BlockBox_Trap_" + cString_Sub(sFlesh, 28, 3), true);
			 
			 tString sWall = "BreakableWall_PortalRoom_Trap_" + cString_Sub(sFlesh, 28, 3);
			 if (cString_GetLastChar(sWall) == "*")
			 {
				 sWall.resize(sWall.length() - 1);
				 sWall += "1";
			 }			 
			 if (Entity_Exists(sWall))
			 {
				 Prop_SetHealth(sWall, 0.f);
				 Sound_CreateAtEntity("Sound_BreakWall", "03_03_herberts_hq/level/wall_break", sWall);
			 }
			 
			 tString sPillar = "BreakablePillar_PortalRoom_Trap_" + cString_Sub(sFlesh, 28, 3);
			 if (cString_GetLastChar(sWall) == "*")
			 {
				 sPillar.resize(sPillar.length() - 1);
				 sPillar += "1";
			 }
			 Map_AddTimer(sPillar, 0.25f, "OnTimer_BreakProp");
			 
			 if (FearHandler_GetRate() < 0.3f)
				FearHandler_SetForcedAddFearRate(0.3f, 3.f, false, -1.f, 0.1f);
             
             ResetShadowFleshSpawnTimer();
         }
		 
		 //-------------------------------------------------------
	 
		 //} END Event F *Get trapped by Shadow Flesh*
		 
		 /////////////////////////////////////////
		 // Event G *FLESH GHOUL gets corrupted by SHADOW FLESH*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event G here.*/
		 
		 tString msFleshGhoul = "";
		 bool mbDoCorruptedGhoulEffects = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event G here.*/
                  
         //-------------------------------------------------------
         
         bool OnTrigger_Player_StartSeqFleshGhoul(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1 || 
				Entity_PlayerIsInFront(asParent) == false || 
				Entity_GetVarBool(asParent, "DisableFleshGhoul")) 
				return true;
			 
			 Entity_SetActive("Trigger_StartSeqFleshGhoul_*", false);
			 msFleshGhoul = Entity_GetVarString(asParent, "");
			 Seq_FleshGhoul("");
			 return false;
		 }
         
         //-------------------------------------------------------
		 
		 cSequenceStatesData mSequenceDataFleshGhoul;
		 void Seq_FleshGhoul(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_FleshGhoul", mSequenceDataFleshGhoul);
			 if (Sequence_DoStepAndWait(0.1f))
             {
				 CharMover_SetDynamicObjectAvoidanceActive(msFleshGhoul, false);
				 Entity_SetCollideCharacter("BreakablePillar_PortalRoom_Trap_*", false);

				 Entity_SetActive(msFleshGhoul, true);
             }
             else if (Sequence_DoStepAndWait(0.8f))
			 {
				 Ghoul_CommandPatrol_AddNode(msFleshGhoul, "PathNode_Flesh_" + cString_GetNumericSuffixInt(msFleshGhoul));
				 Ghoul_CommandPatrol_Execute(msFleshGhoul, true, 1, false, eGhoulSpeed_Run);				 
                 
                 Sound_CreateAtEntity("Sound_FleshGhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_spot", msFleshGhoul);
                 
                 Map_RemoveTimer("Timer_SpawnShadowFlesh");
				 
				 if (FearHandler_GetRate() < 0.5f)
					FearHandler_SetForcedAddFearRate(0.5f, 6.f, false, -1.f, 0.1f);
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				  tString sWall = "BreakableWall_PortalRoom_Flesh_" + cString_GetNumericSuffixInt(msFleshGhoul);
				  if (Entity_Exists(sWall))
				  {
					  Prop_SetHealth(sWall, 0.f);
					  Sound_CreateAtEntity("Sound_BreakWall", "03_03_herberts_hq/level/wall_break", sWall);
				  }					  
				 
				 tString sFlesh = "ShadowFlesh_PortalRoom_" + msFleshGhoul + "_*";
				 ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 2.f, 2.5f, true);				 
				 
				 ResetShadowFleshSpawnTimer();
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 int lId = cString_GetNumericSuffixInt(msFleshGhoul);				 
				 tString sPillar = lId == 1 || lId == 3 ? "BreakablePillar_PortalRoom_Flesh_1" :
														  "BreakablePillar_PortalRoom_Flesh_2";
				  if (Entity_Exists(sPillar))
				  {
					  Prop_SetHealth(sPillar, 0.f);
					  Sound_CreateAtEntity("Sound_BreakWall", "03_03_herberts_hq/level/wall_break", sPillar);
				  }
			 }
             else if (Sequence_DoStepAndWait(1.f))
             {	
				 Sound_CreateAtEntity("Sound_FleshGhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_blinded_pain", msFleshGhoul);
				 
				 Entity_SetActive(msFleshGhoul, false);				 		 
				 Entity_SetActive("FleshArm", true);				 		 
				 Entity_SetActive("FleshGhoul", true);				 		 
				 Prop_SetActiveAndFade("CorruptedGhoul", true, 2.f);

				 cMatrixf mtxTransform = Map_GetEntity(msFleshGhoul, eLuxEntityType_Agent).GetMeshEntity().GetWorldMatrix();
				 Map_GetEntity("FleshArm", eLuxEntityType_Prop).GetMeshEntity().SetMatrix(mtxTransform);					 
				 Map_GetEntity("FleshGhoul", eLuxEntityType_Prop).GetMeshEntity().SetWorldMatrix(mtxTransform);
				 Map_GetEntity("CorruptedGhoul", eLuxEntityType_Prop).GetMeshEntity().SetMatrix(mtxTransform);
				 
				 Map_GetEntity("FleshGhoul", eLuxEntityType_Prop).FadeMeshScaleMul(cVector3f(0.99f), 2.f);
				 
				 Entity_PlayAnimation("FleshArm", "corrupt_ghoul", 0.3f, false);	
				 Entity_PlayAnimation("CorruptedGhoul", "corruption_test_rigid", 0.3f, false);	
				 Entity_PlayAnimation("FleshGhoul", "corruption_test_rigid", 0.3f, false);
				 
				 Entity_FadeEffectBaseColor("CorruptedGhoul", cColor(0.f), 3.f);
				 Entity_FadeEffectBaseColor("FleshGhoul", cColor(0.f), 3.f);
				 
				 Entity_SetCollideCharacter("BreakablePillar_PortalRoom_Trap_*", true);
             }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 mbDoCorruptedGhoulEffects = true;
				 Entity_SetActive("CorruptedGhoul_Collision", true);
				 Entity_PlaceAtEntity("CorruptedGhoul_Collision", "CorruptedGhoul", 0.f, true, true);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void UpdateCorruptedGhoulEffects(float afTimeStep)
		 {
			 if (mbDoCorruptedGhoulEffects)
			 {
				 iLuxEntity@ pEnt = Map_GetEntity("FleshGhoul", eLuxEntityType_Prop);
				 float fCoverage = pEnt.GetMeshEntity().GetCoverageAmount();
				 
				 fCoverage -= (1.f / 3.f) * afTimeStep;
				 if (fCoverage < 0.f)
				 {
					 fCoverage = 1.f;
					 mbDoCorruptedGhoulEffects = false;
					 pEnt.SetActive(false);
				 }
				 
				 pEnt.GetMeshEntity().SetCoverageAmount(fCoverage);
			 }
		 }
		 		 
		 //-------------------------------------------------------
	 
		 //} END Event G *FLESH GHOUL gets corrupted by SHADOW FLESH*
		 
		 /////////////////////////////////////////
		 // Event H *Enlarge the PORTAL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event H here.*/
         
		float mfWaterOrbFadeCount = 15.f;
		bool mbFadeInWaterOrb = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event H here.*/
         
         cSequenceStatesData mSequenceEnlargePortalData;
         void Seq_EnlargePortal(const tString &in asTimer)
         {
             Sequence_Begin("Seq_EnlargePortal", mSequenceEnlargePortalData);
			 if (Sequence_DoStepAndWait(3.f))
			 {						
				 Player_SetAllowCheckBaby(false);
 
				 Rift_SetForceOpen("Portal", true);
				 Rift_SetOpenSpeed("Portal", 0.1f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 SetWaterOrbActive(true);
				 Prop_SetActiveAndFade("Portal_Cubemap", true, 5.f);
				 
				 Sound_CreateAtEntity("Sound_PortalStartScream", "03_03_herberts_hq/alter_open/alter_shadow_scream", "player");
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
             {						
				 Sound_CreateAtEntity("Sound_AlterOrbExpand", "03_03_herberts_hq/alter_open/alter_portal_open", "Area_AlterOpenSounds"); 
                 Effect_ImageTrail_Start(0.4f, 0.5f, 5.f, 0.f);
                 
				 if (Entity_GetCollide("player", "Trigger_PortalAccessPlatform"))
				 {
					 Player_FadeMoveSpeedMulTo(0.1f, 1.f);
					 Player_FadeLookSpeedMulTo(0.1f, 3.f);
				 }
                 else
				 {
					 Player_FadeMoveSpeedMulTo(0.1f, 5.f);
					 Player_FadeLookSpeedMulTo(0.1f, 5.f);
				 }
				 
				 //Effect_Sway_FadeIn(0.25f, 10.f, 2.f, -2.5f, 1.f, 0.25f, 0.995f, 0.f);
				 
				 if (cScript_GetGlobalVarBool("TTH_GhoulsNestComplete"))
				 {
					 Entity_RemoveCollideCallback("player", "ShadowFlesh_PortalRoom_Portal_*");
					 
					 Map_RemoveTimer("Timer_SpawnShadowFlesh");
					 SpawnRemainingFlesh();
				 }
             }
             else if (Sequence_DoStepAndWait(1.f))
             {                 					 				 
                 Effect_Shake_Start(0.025f, 5.f, 0.5f, 0.f);
                 Effect_ImageTrail_Start(0.6f, 0.5f, 5.f, 0.f);
                 
				 if (cScript_GetGlobalVarBool("TTH_GhoulsNestComplete"))
					 SpawnRemainingFlesh();
             }
			 else if (Sequence_DoStepAndWait(1.f))
             {
                 Player_StartLookAt("Portal", 0.025f, 1.f, 1.f);
             }
             else if (Sequence_DoStepAndWait(1.f))
             {				 
				 float fEffectTime = cScript_GetGlobalVarBool("TTH_GhoulsNestComplete") ? 6.5f : 4.5f;
				 Effect_Shake_Start(0.025f, fEffectTime, 0.5f, 0.f);
                 Effect_ImageTrail_Start(0.6f, 0.5f, fEffectTime, 0.f);
                 
				 if (cScript_GetGlobalVarBool("TTH_GhoulsNestComplete"))
				 {
					 FearHandler_SetForcedAddFearRate(0.8f, 10.f, false, -1.f, 0.1f);
					 SpawnRemainingFlesh();
				 }
             }
			 else if (Sequence_DoStepAndWait(3.f))
			 {
				 if (Entity_GetCollide("player", "Trigger_PortalAccessPlatform"))
				 {
				 }
				 
				 if (cScript_GetGlobalVarBool("TTH_PortalFailed"))
					 Achievement_Unlock(eAchievement_Traveller);
			 }
             else if (Sequence_DoStepAndWait(2.3f))
             {
				 if (cScript_GetGlobalVarBool("TTH_PortalFailed") == false)
				 {					 
					 cScript_SetGlobalVarBool("TTH_PortalFailed", true);
					 
					 Entity_SetInteractionDisabled("Portal_Button", false);
					 
					 Prop_SetActiveAndFade("Portal_Cubemap", false, 0.1f);
					 
					 SetWaterOrbActive(false, true);
					 					 
					 Sound_CreateAtEntity("Sound_PortalStop", "03_04_pillar_room/config_device/plate_energy_misaligned", "player");
					 
					 Sound_Stop("Sound_BeamFilterBurst", 0.5f);
					 Sound_Stop("Sound_PortalOpen_1", 0.5f);
					 Sound_Stop("Sound_PortalOpen_2", 0.5f);
					 Sound_Stop("Sound_PortalOpen_3", 0.5f);
					 Sound_Stop("Sound_AlterOrbExpand", 0.5f);
					 
					 for (int i = 1; i < 4; ++i)
					 {
						 tString sWheel = "ControlWheel_" + i;
						 float fCurrentAngle = Wheel_GetCurrentAngle(sWheel);
						 float fAngleAdd = fCurrentAngle >= 0.f ? -360.f : 360.f;
						 
						 Wheel_SetAngle(sWheel, cMath_ToRad(fCurrentAngle + fAngleAdd), true);
						 
						 //cLux_AddTodoMessage("OLD ANGLE: " + (fCurrentAngle));
						 //cLux_AddTodoMessage("NEW ANGLE: " + (fCurrentAngle + fAngleAdd));
					 }
					 
					 //Wheel_SetAngle("ControlWheel_1", cMath_ToRad(360.f), true);
					 //Wheel_SetAngle("ControlWheel_2", cMath_ToRad(360.f), true);
					 //Wheel_SetAngle("ControlWheel_3", cMath_ToRad(360.f), true);
					 
					 //Effect_Sway_FadeOut(1.f);
					 
					 Player_StopLookAt(1.f);
					 Player_FadeMoveSpeedMulTo(1.f, 1.f);
					 Player_FadeLookSpeedMulTo(1.f, 1.f);
					 
					 Rift_SetForceOpen("Portal", false);
					 Rift_SetForceClose("Portal", true);
					 Rift_SetOpenSpeed("Portal", 1.f);
					 
					 BreakVitaeCanister();		
					 
					 Map_AddTimer("Timer_AddVitaeCanisterReminder", 10.f, "OnTimer_AddVitaeCanisterReminder");
					 
					 Player_SetAllowCheckBaby(true);
					 
					 SetCurrentPortalDestinationActive(false, 0.15f);
				 }
				 else
				 {
					 Seq_ShadowBreaksPortal("");
				 }
             }
             Sequence_End();
         }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_AddVitaeCanisterReminder(const tString &in asTimeR)
		 {
			 Sketchbook_AddIdea("find_vitaecanister");
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataShadowBreaksPortal;
		 void Seq_ShadowBreaksPortal(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_ShadowBreaksPortal", mSeqDataShadowBreaksPortal);
			 if (Sequence_DoStepAndWait(2.f))
			 {                 
				 Effect_Shake_Start(0.03f, 5.f, 0.5f, 0.f);
                 Effect_ImageTrail_Start(0.6f, 0.5f, 5.f, 0.f);
				 
				 SpawnRemainingFlesh();                 
				 OnTimer_BreakPortalRoof("Timer_BreakPortalRoof_3");
			 }
			 else if (Sequence_DoStepAndWait(0.3f))
             {				 
                 Effect_Shake_Start(0.09f, 1.f, 0.5f, 4.f);
                 Effect_ImageTrail_Start(1.5f, 0.5f, 5.f, 0.f);
                 
				 ShadowFlesh_Spawn("ShadowFlesh_PortalRoom_Portal_1_*", "Decal_ShadowFlesh_PortalRoom_Portal_1_*", 2.f, 3.5f, false);
				 ShadowFlesh_Spawn("ShadowFlesh_PortalRoom_Portal_3_*", "Decal_ShadowFlesh_PortalRoom_Portal_3_*", 2.f, 2.5f, false);
				 
				 Sound_CreateAtEntity("Sound_FleshSpawn", "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", "Portal");
				 LightFlash_Add(0.52f, 0.25f, 0.25f, "Area_PortalFleshLight", cColor_Red * 0.7f, 15.f, 5.f);
				 
				 Light_SetFlickerActive("Light_Spot_pillar_room", true);
				 Map_AddTimer("Timer_DisableBeamFlicker", 0.5f, "OnTimer_DisableBeamFlicker");
				 
				 OnTimer_BreakPortalRoof("Timer_BreakPortalRoof_2");
				 
				 Sound_CreateAtEntity("SoundBeamFilter1Break", "03_03_herberts_hq/orb_activate/beam_filter_break_1", "BeamFilter_3");
				 Sound_CreateAtEntity("OrbBeamFilterDrop1", "03_03_herberts_hq/orb_activate/beam_filter_drop_1", "BeamFilter_3_Broken");
				 Sound_CreateAtEntity("SoundBeamFilter2Creak", "03_03_herberts_hq/orb_activate/beam_filter_creak_2", "BeamFilter_1");
				 Sound_CreateAtEntity("SoundShadowGrowth3", "03_03_herberts_hq/orb_activate/orb_power_up_shadow_growth_3", "ShadowFlesh_PortalRoom_Portal_5_8");
				 Sound_CreateAtEntity("Sound_OrbBreak", "03_03_herberts_hq/alter_open/alter_start_open", "player");
             }
			 else if (Sequence_DoStepAndWait(0.7f))
			 {
				 OnTimer_PortalLightFlicker("");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Map_RemoveTimer("Timer_PortalLightFlicker");				 
				 Entity_SetEffectsActive("Portal_GlowingOrb", true, false);
				 Entity_SetEffectsActive("Portal_GlowingOrbLow", true, false);
			 }
			 else if (Sequence_DoStepAndWait(0.4f))
             {
                 Effect_Shake_Start(0.12f, 1.f, 0.5f, 4.f);
                 Effect_ImageTrail_Start(1.5f, 0.5f, 5.f, 0.f);				 
                 				 
				 ShadowFlesh_Spawn("ShadowFlesh_PortalRoom_Portal_5_*", "Decal_ShadowFlesh_PortalRoom_Portal_5_*", 2.f, 3.f, false);
				 Sound_CreateAtEntity("Sound_FleshSpawn", "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", "Portal");
				 LightFlash_Add(0.25f, 0.35f, 0.25f, "Area_PortalFleshLight", cColor_Red * 0.7f, 15.f, 5.f);
				 
				 Light_SetFlickerActive("Light_Spot_pillar_room", true);
				 Map_AddTimer("Timer_DisableBeamFlicker", 0.6f, "OnTimer_DisableBeamFlicker");
				 
				 Sound_CreateAtEntity("Sound_PortalFail", "04_03_undercity/machine/energy_on", "player");
				 Sound_CreateAtEntity("SoundBeamFilter2Break", "03_03_herberts_hq/orb_activate/beam_filter_break_2", "BeamFilter_1");
				 Sound_CreateAtEntity("OrbBeamFilterDrop2", "03_03_herberts_hq/orb_activate/beam_filter_drop_2", "BeamFilter_1_Broken");
				 	 
				 msPortalDestination = "Portal_Destination_Town";				 
				 SetCurrentPortalDestinationActive(false, 0.15f);
				 msPortalDestination = "Portal_Destination_DW";
				 SetCurrentPortalDestinationActive(true, 2.f, 2.f);	
			 }
			 else if (Sequence_DoStepAndWait(0.6f))
			 {
				 OnTimer_PortalLightFlicker("");
				 Voice_Play("Dialogue_ThePortal_ThroughThePortal", 0);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Map_RemoveTimer("Timer_PortalLightFlicker");				 
				 Entity_SetEffectsActive("Portal_GlowingOrb", true, false);
				 Entity_SetEffectsActive("Portal_GlowingOrbLow", true, false);
			 }
             else if (Sequence_DoStepAndWait(1.5f))
             {				 
				 Effect_Shake_Start(0.16f, 2.f, 1.f, 4.f);
				 Effect_ImageTrail_Start(1.5f, 0.5f, 3.f, 0.f);                 			 
				 
				 ShadowFlesh_Spawn("ShadowFlesh_PortalRoom_Portal_4_*", "Decal_ShadowFlesh_PortalRoom_Portal_4_*", 2.5f, 3.5f, false);
				 Sound_CreateAtEntity("Sound_FleshSpawn", "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", "Portal");
				 LightFlash_Add(0.25f, 0.45f, 0.25f, "Area_PortalFleshLight", cColor_Red * 0.7f, 15.f, 5.f);				 
				 
				 Light_SetFlickerActive("Light_Spot_pillar_room", true);
				 Map_AddTimer("Timer_DisableBeamFlicker", 0.4f, "OnTimer_DisableBeamFlicker");
				 
				 OnTimer_BreakPortalRoof("Timer_BreakPortalRoof_1");				 
				 
				 Sound_CreateAtEntity("Sound_PortalFail", "04_03_undercity/machine/energy_off", "player");
				 Sound_CreateAtEntity("SoundOrbActivatedScreams", "03_03_herberts_hq/orb_activate/orb_activated_energy_scream", "player");
				 Sound_CreateAtEntity("SoundBeamFilter1Break", "03_03_herberts_hq/orb_activate/beam_filter_break_1", "BeamFilter_3");
				 Sound_Stop("SoundOrbDebris", 0.5f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 OnTimer_PortalLightFlicker("");
				 Sound_CreateAtEntity("Sound_PortalFail", "04_03_undercity/machine/energy_on", "player");
				 LightFlash_Add(0.25f, 0.5f, 0.25f, "Area_PortalFleshLight", cColor_Red * 0.7f, 15.f, 5.f);
				 
				 if (Entity_GetCollide("player", "Trigger_PortalAccessPlatform") == false)
				 {
					 Entity_SetActive("Portal_WaterOrb_Fail", true);
					 cVector3f vDelta = Entity_GetDeltaToEntity("Portal_WaterOrb_Fail", "player");
					 vDelta.y = 0;
					 Map_GetEntity("Portal_WaterOrb_Fail").FadeMeshScaleMul(cVector3f(vDelta.Length() * 4.f), 2.f);					 
				 }
			 }
			 else if (Sequence_DoStepAndWait(0.4f))
			 {
				 Map_RemoveTimer("Timer_PortalLightFlicker");			 
				 Entity_SetEffectsActive("Portal_GlowingOrb", true, false);
				 Entity_SetEffectsActive("Portal_GlowingOrbLow", true, false);
				 Entity_SetEffectsActive("Portal", true, false);
				 Entity_FadeEffectBaseColor("PortalBeam*", cColor(1.f) * 3.f, 0.1f);
				 
				 Light_SetFlickerActive("Light_Spot_pillar_room", true);
				 Map_AddTimer("Timer_DisableBeamFlicker", 0.5f, "OnTimer_DisableBeamFlicker");
				 				 
				 Sound_CreateAtEntity("Sound_AlterOpenEnd", "03_03_herberts_hq/alter_open/alter_end_open", "player");
			 }
			 else if (Sequence_DoStepAndWait(0.3f))
			 {
				 Sound_CreateAtEntity("Sound_PortalFail", "04_03_undercity/machine/energy_on", "player");
				 
				 LightFlash_Add(0.5f, 1.f, 0.25f, "Area_PortalFleshLight", cColor_Red * 0.7f, 15.f, 10.f);
				 Sound_CreateAtEntity("Sound_FleshSpawn", "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", "Portal");
			 }
             else if (Sequence_DoStepAndWait(0.4f))
             {				 				 
				 Voice_Play("Dialogue_ThePortal_ThroughThePortal", 1);
				 
                 Effect_Shake_Start(0.2f, 3.f, 0.5f, 4.f);
                 Effect_ImageTrail_Start(1.f, 0.5f, 3.f, 0.f);				 
				 
				 Sound_CreateAtEntity("Sound_PortalFlesh", "03_03_herberts_hq/alter_open/shadow_flesh_portal", "player");

				 Effect_Flash_Start(0.7f, 5.f, 1.f, 2.f);
				 
				 FearHandler_SetForcedAddFearRate(0.f, 1.f, false, 100.f, 100.f);
             }
			 else if (Sequence_DoStepAndWait(1.f))
			 {				 
				 Sound_FadeGlobalVolume(0.f, 1.f, eSoundEntryType_AllExceptGui);
				 Music_StopAll(1.f);
				 
				 Effect_Shake_FadeOut(-1, 0.25f);
				 Effect_Rumble_Stop(-1);
				 				 
				 Sound_PlayGui("03_03_herberts_hq/alter_open/shadow_flesh_portal_sting", 1.f);
			 }
			 else if (Sequence_DoStepAndWait(0.1f))
			 {
				 Voice_StopAll();
				 Sound_Stop("Sound_*", 0.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 ShadowFlesh_ResetSpawnedDecalsOnMapLeave(true);
				 
				 Player_SetLookSpeedMul(1.f);
				 Player_SetAllowCheckBaby(true);
				 
				 Sketchbook_CompleteIdea("escape_tth");
				 Sketchbook_NewIdeasPage();
				 
				 // Enable kicks again
				 Pregnancy_SetBabyKicksEnabled(true);
				 
				 Map_ChangeMap("03_07_dwf_a_theatre.hpm", "Start_Begin", "", "");
			 }
			 Sequence_End();
		 }
         
         //-------------------------------------------------------
         
         void SpawnRemainingFlesh()
         {
             // If any normal left - spawn!
             int lSize = mvPortalEventShadowFlesh.size();
             if (lSize < 1) return;
             
             int lRand = cMath_RandRectl(0, lSize - 1);
             tString sFlesh = mvPortalEventShadowFlesh[lRand];
             ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 1.5, 2.5f, true);
             mvPortalEventShadowFlesh.removeAt(lRand);
                     
             tString sWall = "BreakableWall_PortalRoom_Dynamic_" + cString_Sub(sFlesh, 31, 3);
             if (Entity_Exists(sWall))
			 {
				 Prop_SetHealth(sWall, 0.f);
				 Sound_CreateAtEntity("Sound_BreakWall", "03_03_herberts_hq/level/wall_break", sWall);
			 }				 
         }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PortalLightFlicker(const tString &in asTimer)
		 {
			 bool bOn = Light_GetBrightness("Light_Portal") > 0.f;
			 
			 Light_SetBrightness("Light_Portal", bOn ? 0.f : 50.f);
			 Entity_SetEffectsActive("Portal_GlowingOrb", !bOn, false);
			 Entity_SetEffectsActive("Portal_GlowingOrbLow", !bOn, false);
			 
			 Map_AddTimer("Timer_PortalLightFlicker", cMath_RandRectf(0.05f, 0.2f), "OnTimer_PortalLightFlicker");
		 }
	 
		 //-------------------------------------------------------
		 
		 void BreakVitaeCanister()
		 {
			 cScript_SetGlobalVarBool("TTH_AllowVitaeStationSymbolBark", true);
			 Entity_SetActive("Trigger_LookAtVitaeSymbol", true);
			 
			 cScript_SetGlobalVarBool("TTH_CanisterActive_1", false);
			 Sound_Stop("Sound_PortalStartScream", 0.5f);
			 
			 SetCanisterActive(1, false);
			 Sound_StopGui("03_07_DW_theatre/canister_unplug/small/small_remove", 0.f, false);

			 Entity_SetActive("InteractAreaAux_BrokenPortalCanister", true);
			 
			 Map_AddTimer("Timer_SetVitaeBankEffectsActive", 0.5f, "OnTimer_SetVitaeBankEffectsActive");
			 Map_AddTimer("Timer_SetVitaeBankOpen", 7.f, "OnTimer_SetVitaeBankOpen");
			 Map_SetTimerUserVarInt("Timer_SetVitaeBankOpen", 1);
			 
			 Map_AddTimer("Timer_ResetPortalButton", 8.f, "OnTimer_ResetPortalButton");
			 		 	
			 Sound_CreateAtEntity("Sound_BreakVitaeCanister", "04_03_undercity/machine/energy_on", "Area_BrokenCanisterEffects");			 
			 ParticleSystem_CreateAtEntity("PS_BrokenVitaeCanister", "dust_large_long_oneshot.ps", "Area_BrokenCanisterDustPS", false).SetColor(cColor(0.51,0.824,0.718,0.69));
			 
			 Map_AddTimer("Timer_SpawnBrokenCanisterDust", 0.8f, "OnTimer_SpawnBrokenCanisterDust");
			 
			 Light_SetFlickerActive("Light_Spot_pillar_room", true);
			 Map_AddTimer("Timer_DisableBeamFlicker", 1.2f, "OnTimer_DisableBeamFlicker");
			 
			 Effect_Shake_Start(0.015f, 1.f, 0.25f, 0.5f);
			 
			 UpdatePortalRoomPower();
			 
			 Map_AddTimer("Timer_PlayFirstTimeFailDialogue", 4.f, "OnTimer_PlayFirstTimeFailDialogue");
		 }
		 
