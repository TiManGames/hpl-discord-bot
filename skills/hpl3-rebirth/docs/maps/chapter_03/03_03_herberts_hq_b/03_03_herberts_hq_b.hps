		 {
			 FearHandler_SetPaused(false);
			 Player_FadeLookSpeedMulTo(1.f, 1.f);
			 
			 Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_AfterCollapse");			 
			 Map_AddTimer("Timer_PlayBabyWakeUpDialogue", 1.f, "OnTimer_PlayBabyWakeUpDialogue");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayBabyWakeUpDialogue(const tString &in asTimer)
		 {
			 Voice_PlayWhenPossible("Dialogue_NeedToFindPortal");
		 }
         
         //-------------------------------------------------------
         
         bool OnTrigger_Player_SpawnSlabChamberBlockFlesh(const tString &in asParent, const tString &in asChild, int alState)
         {
			 int lId = cString_GetNumericSuffixInt(asParent);
			 tString sFlesh = "ShadowFlesh_SlabChamberBlock_" + lId + "_*";
			 float fMin = lId == 1 ? 0.5f : 1.f;
			 float fMax = lId == 1 ? 0.75f : 2.f;
             ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, fMax, true);
			 Entity_SetActive("BlockBox_SlabBlock_" + lId, true);
             return false;
         }
         
