		 /*Put any variables that are only used in Scene 1, Event C here.*/
		 
		 bool mbPortalDestinationCutsceneActive = false;
		 bool mbAllowPortalDestinationFlicker = false;
		 float mfPortalDestinationFlickerTime = 1.f;
		 cVector3f mvPortalCutscenePos = 0.f;
		 float mfPortalCutsceneAngle = 0.f;
		 bool mbPortalCutscenePlayed = false;
		 bool mbFadeInVisionOrb = false;
		 float mfVisionOrbAlphaGoal = 1.f;
		 tString msPortalDestination = "Portal_Destination_Town";
		 array<tString> mvPortalDestinations = {"Portal_Destination_Wreckage", "Portal_Destination_Town", "Portal_Destination_DW"};
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event C here.*/
		 
		 bool OnTrigger_AddSketch_Portal(const tString &in asParent, const tString &in asChild, int alState)
		 {
