			ImGui_SetTransCategory("03_03_herberts_hq_b");
			
			ImGui_DrawReadableLabel("Zoom_Map_Flow",
				ImGui_NrmPosGroup(cVector3f(0.375, 0.3, 1)),
				afAlpha);
			
			ImGui_DrawReadableLabel("Zoom_Map_Pillars",
				ImGui_NrmPosGroup(cVector3f(0.5, 0.05, 1)),
				afAlpha);
				
			ImGui_DrawReadableLabel("Zoom_Map_Pillars_Note",
				ImGui_NrmPosGroup(cVector3f(0.6, 0.15, 1)),
				afAlpha);
				
			ImGui_DrawReadableLabel("Zoom_Map_Portal",
				ImGui_NrmPosGroup(cVector3f(0.45, 0.5, 1)),
				afAlpha);
				
			ImGui_DrawReadableLabel("Zoom_Map_Orb",
				ImGui_NrmPosGroup(cVector3f(0.5, 0.8, 1)),
				afAlpha);
				
			ImGui_DrawReadableLabel("Zoom_Map_Wheel",
				ImGui_NrmPosGroup(cVector3f(0.675, 0.6, 1)),
				afAlpha);
				
			ImGui_DrawReadableLabel("Zoom_Map_Vitae",
				ImGui_NrmPosGroup(cVector3f(0.6, 0.9, 1)),
				afAlpha);
			
			ImGui_ResetModifiers();

			ImGui_GroupEnd();
		}	
	
