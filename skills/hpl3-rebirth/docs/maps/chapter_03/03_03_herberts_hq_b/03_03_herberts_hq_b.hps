		 void OnInteract_ControlWheel(const tString &in asEntity)
		 {
			 DoSketch("tth_hint_lenses");
			 DoSketch("tth_arrow_lenses_portal");
			 
			 Map_AddTimer(asEntity, 0.1f, "OnTimer_UpdateBeamFilter");
		
			 /////////////////////////////
			 // Collapse roof
