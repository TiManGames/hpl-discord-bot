		 /////////////////////////////////////////
		 // Event B *Activate the Vitae Station*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event B here.*/
		 
		 void SetVitaeStationEntranceActive(bool abX, bool abInstant = false)
		 {			 
			 if (abX && abInstant == false)
			 {
				 Seq_ActivateVitaeStationEntrance("");
				 return;
			 }
			 
			 Lamp_SetLit("VitaePipe_VS_*", abX, abInstant == false);
			 
			 float fLightFadeTime = abInstant ? 0.f : 0.5f;
			 Light_FadeBrightnessTo("Light_Spot_VS_Entrance_*", abX ? 1.f : 0.f, fLightFadeTime);
			 Light_FadeBrightnessTo("Light_Point_VS_Entrance_*", abX ? 0.75f : 0.f, fLightFadeTime);
			 
			 Lamp_SetLit("Lamp_VS_Entrance_*", abX, abInstant == false);
			 
			 SlideDoor_SetClosed("Portcullis_VS_Entrance", abX == false, abInstant);
			 Entity_SetActive("BlockBox_VS_Entrance", abX == false);
			 
			 Billboard_SetBrightness("Billboard_VS_Entrance", 3.f);
			 
			 if (abInstant == false)
				 Sound_CreateAtEntity("Sound_StationLock", "03_07_DW_theatre/canister_unplug/large/large_remove", "Sound_StationUnlock");
				 Sound_Stop("Sound_StationUnlockLoop", 1.5f);
			 
			 if (abX)
			 {
				 cScript_SetGlobalVarBool("TTH_VitaeStationEntranceActive", true);				 
				 Entity_SetInteractionDisabled("LevelDoor_VitaeStation", false);
				 
				 Entity_FadeProcAnimationSpeed("VS_Cog_1", "Spin", 0.3f, 7.f);
				 Entity_FadeProcAnimationSpeed("VS_Cog_2", "Spin", -0.3f, 7.f);
				 
				 Sound_Play("Sound_VitaeStation", 1.f);
				 
				 Sound_CreateAtEntity("Sound_CogLoop", "new_sounds/herb_hq/gears_loop", "VS_Cog_1", 1, true);
				 
				 if (abInstant == false)
					Sound_PlayGui("03_05_vitae_station/level/vitae_energy_burst", 1.f, eSoundEntryType_GuiWorld);
			 }
			 else
			 {
				 cScript_SetGlobalVarBool("TTH_VitaeStationEntranceActive", false);
				 Entity_SetInteractionDisabled("LevelDoor_VitaeStation", true);
				 
				 Entity_FadeProcAnimationSpeed("VS_Cog_1", "Spin", 0.f, 7.f);
				 Entity_FadeProcAnimationSpeed("VS_Cog_2", "Spin", 0.f, 7.f);
				 
				 Sound_CreateAtEntity("Sound_CogStop", "new_sounds/herb_hq/gears_stop", "VS_Cog_1");
				 Sound_Stop("Sound_CogLoop", 1.f);
				 
				 Sound_Stop("Sound_VitaeStation", 1.f);
			 }				
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataActivateVitaeStationEntrance;
		 void Seq_ActivateVitaeStationEntrance(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_ActivateVitaeStationEntrance", mSeqDataActivateVitaeStationEntrance);
			 if (Sequence_DoStepAndWait(1.f))
			 {
				 cScript_SetGlobalVarBool("TTH_VitaeStationEntranceActive", true);				 
				 Entity_SetInteractionDisabled("LevelDoor_VitaeStation", false);
				 Entity_SetInteractionDisabled("VitaeCanister_3", true);
				 
				 Sound_CreateAtEntity("Sound_StationUnlock", "03_07_DW_theatre/canister_unplug/large/large_insert", "Sound_StationUnlock");
				 Sound_CreateAtEntity("Sound_StationUnlockLoop", "03_07_DW_theatre/canister_unplug/large/large_loop", "Sound_StationUnlock");

				 Lamp_SetLit("Lamp_VS_Entrance_1", true, true);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {			 
				 Light_FadeBrightnessTo("Light_Point_VS_Entrance_1_*", 0.5f, 0.5f);				 
				 //Sound_CreateAtEntity("Sound_VSEntranceLights_1", "03_03_herberts_hq/alter_open/alter_lights_off", "VitaeCanister_3");
				 
				 Effect_Shake_Start(0.006f, 0.5f, 0.5f, 0.5f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				  Lamp_SetLit("VitaePipe_VS_1_*", true, true);
				 
				  Light_FadeBrightnessTo("Light_Spot_VS_Entrance_*", 1.f, 0.5f);
				  Light_FadeBrightnessTo("Light_Point_VS_Entrance_2_*", 0.5f, 0.5f);
				  
				  Effect_Shake_Start(0.006f, 0.5f, 0.5f, 0.5f);
				 
				  Entity_FadeProcAnimationSpeed("VS_Cog_1", "Spin", 0.3f, 7.f);
				  Entity_FadeProcAnimationSpeed("VS_Cog_2", "Spin", -0.3f, 7.f);
				  
				  Sound_CreateAtEntity("Sound_CogStart", "new_sounds/herb_hq/gears_start", "VS_Cog_1");
				  Sound_CreateAtEntity("Sound_CogLoop", "new_sounds/herb_hq/gears_loop", "VS_Cog_1", 1, true);
				  Sound_Play("Sound_VitaeStation", 1.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Lamp_SetLit("Lamp_VS_Entrance_2", true, true);
				 Effect_Shake_Start(0.006f, 0.5f, 0.5f, 0.5f);
				 
				 Billboard_SetBrightness("Billboard_VS_Entrance", 3.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 SlideDoor_SetClosed("Portcullis_VS_Entrance", false, false);
				 Entity_SetActive("BlockBox_VS_Entrance", false);
				 
				 Entity_SetInteractionDisabled("VitaeCanister_3", false);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_VitaeSymbol(const tString &in asEntity, int alState)
		 {
			 if (Voice_AnySceneIsActive() || alState == -1 || SlideDoor_GetOpenAmount("Portcullis_VS_Entrance") > 0.f)
				 return;
				 
			 Voice_Play("Dialogue_VitaeSymbol");
			 Entity_SetActive(asEntity, false);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *Activate the Vitae Station*
	 
	 //} END SCENE 2
     
    //////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 3 *THE SHADOW ADVANCES, ANTE-CHAMBER COLLAPSES*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 3 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 3 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A *First Shadow advance*
		//{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event A here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functionsthat are only used in Scene 3, Event A here.*/
         
         bool OnTrigger_Player_StartSeqFirstShadowAdvance(const tString &in asParent, const tString &in asChild, int alState)
         {	
			 if (Entity_IsActive("VitaeCanister_3") || cScript_GetGlobalVarBool("TTH_VitaeCanisterCollected") == false)
				 return true;
			 
             Seq_FirstShadowAdvance("");
			 return false;
         }
         
         //-------------------------------------------------------
         
         cSequenceStatesData mSeqFirstShadowAdvanceData;
         void Seq_FirstShadowAdvance(const tString &in asTimer)
         {
             Sequence_Begin("Seq_FirstShadowAdvance", mSeqFirstShadowAdvanceData);
             if (Sequence_DoStepAndWait(1.f))
             {
                 cScript_SetGlobalVarInt("TTH_HerbertsHQShadowAdvanceStage", 1);   
                 
                 Effect_Shake_Start(0.05f, 9.f, 1.f, 1.f);
                 Effect_ImageTrail_Start(0.7f, 1.f, 9.f, 1.f);
				 
				 Entity_SetActive("AnteChamberDebris_3_*", true);				 
				 
				 Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);
				 Sound_CreateAtEntity("SoundPillarQuake", "03_03_herberts_hq/level_complete_events/pillar_room_complete/pillar_room_quake", "SoundArea_AnteChamberAdvance");
				 
				 Map_AddTimer("Timer_ShadowSpawnMusic", 12.0f, "OnTimer_ShadowFleshSpawnMusic");
             }
             else if (Sequence_DoStepAndWait(2.f))
             {				 
				 FearHandler_SetForcedAddFearRate(0.5f, 9.f, true, -1.f, 0.1f);
				 Map_AddTimer("Timer_AnteChamberForcedRate", 20.f, "OnTimer_AnteChamberForcedRate");
				 
				 Entity_SetActive("AnteChamberDebris_1_*", true);        
				 
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_5_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_5_*", 1.f, 2.f, true);
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_4_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_4_*", 1.f, 2.f, false);
             }
             else if (Sequence_DoStepAndWait(2.f))
             {
				 Entity_SetActive("AnteChamberDebris_2_*", true);
				 
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_1_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_1_*", 1.5f, 3.f, true);
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_9_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_9_*", 1.5f, 3.f, false);
				 Sound_PlayGui("03_03_herberts_hq/orb_activate/orb_power_up_shadow_growth_1", 1.0f);
				 
				 Entity_SetActive("FearScaryObject_ShadowFlesh_AnteChamber_*", true);
             }
             else if (Sequence_DoStepAndWait(2.f))
             {
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_6_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_6_*", 1.5f, 3.f, true);
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_10_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_10_*", 1.5f, 3.f, false);
				 
				 tString sArea = "";
				 for (int i = 1; i < 13; i++)
				 {
					 sArea = "Area_AdvanceDust_" + i;
					 if (Entity_Exists(sArea) == false) continue;
					 
					 ParticleSystem_CreateAtEntity("PS_CollapseDust_" + i, "dust_medium_long_onehsot.ps", sArea, false).SetColor(cColor(1,0.939,0.828,1));
				 }
			 }
			 else if (Sequence_DoStepAndWait(2.2f))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_8_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_8_*", 1.5f, 3.f, true);
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_3_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_3_*", 1.5f, 3.f, true);
				 Sound_PlayGui("03_03_herberts_hq/orb_activate/orb_power_up_shadow_growth_2", 1.0f);
			 }
			 else if (Sequence_DoStepAndWait(1.8f))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_2_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_2_*", 1.5f, 3.f, true);
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_11_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_11_*", 1.5f, 3.f, true);		 
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_1_7_*", "Decal_ShadowFlesh_AnteChamber_Advance_1_7_*", 1.5f, 3.f, true);
			 }
             Sequence_End();
         }
	 
		 //-------------------------------------------------------
		 
		 void OnTimer_ShadowFleshSpawnMusic(const tString &in asTimer)
		 {
			 Music_PlayExt("A2_3_3_Shadow_Spread.ogg", false, 0.4f, 1.0f, 2.5f, 0.0f, eMusicPrio_BigEvent, false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_AnteChamberForcedRate(const tString &in asTimer)
		 {
			 FearHandler_SetForcedAddFearRate(0.01f, 20.f, false);
		 }

         //-------------------------------------------------------
	 
		 //} END Event A *First Shadow advance*
         
        /////////////////////////////////////////
		 // Event B *Shadow advance triggers collapse*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event B here.*/
		 
		 int mlBlurID = -1;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event B here.*/
		 
		 bool OnTrigger_Player_PlayRememberCanisterDialogue(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Voice_PlayDelayed("Dialogue_RememberCanister", 0.5f, 0);
			 return false;
		 }
		 
		 //-------------------------------------------------------

		 bool OnTrigger_Player_PlayRememberCanisterDialogue2(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Entity_IsActive("VitaeCanister_3"))
				Voice_PlayDelayed("Dialogue_RememberCanister", 0.5f, 1);
			 return false;
		 }
		 
		 //-------------------------------------------------------
         
         bool OnTrigger_Player_StartSeqAnteChamberCollapse(const tString &in asParent, const tString &in asChild, int alState)
         {
			 if (Entity_IsActive("VitaeCanister_3") || cScript_GetGlobalVarBool("TTH_VitaeCanisterCollected") == false)
				 return true;

             Seq_AnteChamberCollapse("");
             Entity_SetActive("Trigger_SpawnSlabChamberBlockFlesh_*", true);
			 
			 Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);
             return false;
         }
	 
		 //-------------------------------------------------------
         
         cSequenceStatesData mSeqAnteChamberCollapseData;
         void Seq_AnteChamberCollapse(const tString &in asTimer)
         {
             Sequence_Begin("Seq_AnteChamberCollapse", mSeqAnteChamberCollapseData);
             if (Sequence_DoStepAndWait(0.5f))
             {
                 cScript_SetGlobalVarInt("TTH_HerbertsHQShadowAdvanceStage", 2);
                 
				 Sound_CreateAtEntity("SoundAnteChamberStrain", "03_03_herberts_hq/level_complete_events/HQ_collapse", "Area_SlabChamberRoof_1");				 
				 ParticleSystem_SetActive("PS_SlabChamberCollapse_1", true);
				 
				 ShadowFlesh_Spawn("ShadowFlesh_SlabChamberBlock_1_*", "Decal_ShadowFlesh_SlabChamberBlock_1_*", 1.5f, 2.f, true);
				 Entity_SetActive("BlockBox_SlabBlock_1", true);
			 }
             else if (Sequence_DoStepAndWait(0.5f))
             {
                 FearHandler_SetForcedAddFearRate(0.8f, -1.f, true);
				 
				 Sound_Stop("03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", 0.01f);

                 Player_FadeMoveSpeedMulTo(0.8f, 3.f);
                 Player_FadeLookSpeedMulTo(0.8f, 4.f);
				 
				 Light_FadeTo("Light_ShadowCollapse", cColor_Red, 40.f, 0.5f);
				 LightFlash_Add(1.f, 0.5f, 1.f, "Area_CollapseFlash", cColor_Red * 0.7f, 20.f, 0.5f);
				 
				 Effect_Shake_Start(0.1f, 1.5f, 0.5f, 0.5f);
				 
				 tString sArea = "";
				 for (int i = 1; i < 11; i++)
				 {
					 sArea = "Area_CollapseDust_" + i;
					 if (Entity_Exists(sArea) == false) 
						 continue;
					 
					 ParticleSystem_CreateAtEntity("PS_SlabCollapseDust_" + i, "dust_medium_long_onehsot.ps", sArea, false).SetColor(cColor(1,0.939,0.828,1));
				 }
				 
				 Entity_SetActive("SlabChamberRoofDebris_1_*", true);
				 ParticleSystem_SetActive("PS_SlabChamberCollapse_2", true);
				 
				 SequenceStates_Stop("Seq_FirstShadowAdvance");
             }
             else if (Sequence_DoStepAndWait(1.5f))
             {        				
				 ParticleSystem_CreateAtEntity("PS_SlabPillarBreakDust_1_1", "smoke_oneshot_grate_break.ps", "Area_SlabPillarBreak_1_1", false);
				 ParticleSystem_CreateAtEntity("PS_SlabPillarBreakDust_1_2", "smoke_oneshot_grate_break.ps", "Area_SlabPillarBreak_1_2", false);
				 
				 Sound_CreateAtEntity("Sound_PillarBreak_1", "01_02_caves/quake/quake_3/rock_impact", "Area_SlabPillarBreak_1_1");
				 
				 Light_FadeTo("Light_ShadowCollapse", cColor_Red, 0.f, 0.5f);
         
                 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_2_2_*", "Decal_ShadowFlesh_AnteChamber_Advance_2_2_*", 1.5f, 3.f, true);				 
				 Effect_Shake_Start(0.1f, 2.5f, 0.5f, 0.5f);
             }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				 Entity_SetActive("SlabChamberRoofDebris_2_*", true);
				
				 ParticleSystem_CreateAtEntity("PS_SlabPillarBreakDust_2", "smoke_oneshot_grate_break.ps", "Area_SlabPillarBreak_2", false);
				 Sound_CreateAtEntity("Sound_PillarBreak_1", "01_02_caves/quake/quake_3/rock_impact", "Area_SlabPillarBreak_2");
			 }
             else if (Sequence_DoStepAndWait(3.f))
             {                 
                 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_2_3_*", "Decal_ShadowFlesh_AnteChamber_Advance_2_3_*", 1.5f, 3.f, true);
				 Effect_Shake_Start(0.1f, 2.5f, 0.5f, 0.5f);
			 }
             else if (Sequence_DoStepAndWait(0.2f))
             {
                 ShadowFlesh_Spawn("ShadowFlesh_AnteChamber_Advance_2_4_*", "Decal_ShadowFlesh_AnteChamber_Advance_2_4_*", 1.5f, 3.f, true);
					
                 ParticleSystem_CreateAtEntity("PS_SlabChamberRoofCollapse", "collapse_dust_temp.ps", "Area_SlabChamberRoof", false);
				 Sound_CreateAtEntity("SoundAnteChamberRoofCollapse", "03_03_herberts_hq/level_complete_events/vitae_complete/vitae_complete_roof_cave_in", "Area_SlabChamberRoof");
				
				 Effect_Shake_Start(0.05f, 0.5f, 0.5f, 0.5f);
			 }
             else if (Sequence_DoStepAndWait(0.2f))
             {
                 Prop_SetHealth("SlabChamberRoof_2", 0.f);
             }
			 else if (Sequence_DoStepAndWait(0.3f))
			 {
				 Player_FadeLookSpeedMulTo(0.f, 0.3f);
				 
				 Entity_PlaceAtEntity("Area_KnockOutLookAt", "player", cVector3f(0.f, 1.8f, 0.f) + Player_GetForward() * 5.f, false);
				 Player_StartLookAt("Area_KnockOutLookAt", 1.f, 5.f, 5.f);
			 }
             else if (Sequence_DoStepAndWait(0.4f))
             {
				 Item_PutAway(eItemHandlerHand_Left);
				 Item_PutAway(eItemHandlerHand_Right);
				 
				 Player_StopLookAt(1.f);
				 PlayerBody_PlayCutsceneAnimation("knocked_out_by_debris_in_place", false, 0.3f);
				 
				 Entity_SetActive("SlabChamberHeadDebris", true);
				 Entity_SetCollide("SlabChamberHeadDebris", false);
				 Entity_SetCollideCharacter("SlabChamberHeadDebris", false);
				 
				 Entity_PlaceAtEntity("SlabChamberHeadDebris", "player", cVector3f(0.f, 1.5f, 0.f) + Player_GetForward() * 0.75f, false);
				 Entity_LookAtEntity("SlabChamberHeadDebris", "player");
				 
				 Body_AddImpulse("SlabChamberHeadDebris_Body_1", cVector3f(0.f, -2.f, 0.f), false);
				 
				 Sound_CreateAtEntity("SoundAnteRoofDebris", "03_03_herberts_hq/level_complete_events/vitae_complete/vitae_complete_debris_roof", "player");
				 Sound_CreateAtEntity("SoundAnteDustDebris", "03_03_herberts_hq/level_complete_events/vitae_complete/vitae_complete_debris", "player");
             }
			 else if (Sequence_DoStepAndWait(0.2f))
			 {
				 FearHandler_SetForcedAddFearRate(0.f, 0.f, false, -1.f, 10.f);
				 Effect_Fade_Out(0.2f);
				 
				 Sound_CreateAtEntity("Sound_KnockedOut", "player/foley/damage/player_fall_death", "player");
			 }
             else if (Sequence_DoStepAndWait(4.f))
             {				 
				 cLux_GetPlayer().SetActive(false);
				 FearHandler_SetPaused(true);
				 
				 Entity_SetActive("SlabChamberRoo*", false);
				 Entity_SetActive("SlabChamberHeadDebris", false);
				 
				 Entity_SetActive("FearScaryObject_ShadowFlesh_AnteChamber_*", false);
				 Entity_SetActive("FearScaryObject_ShadowFlesh_Collapsed_*", true);
				 
				 Sound_FadeGlobalVolume(0.f, 1.f, eSoundEntryType_World);
				 Music_StopAll(1.f);
             }
             else if (Sequence_DoStepAndWait(2.f))
             {						
				 Player_SetCrouching(true, true, true);				 
				 Player_SetMoveSpeedMul(1.f);
                 Player_SetLookSpeedMul(1.f);
				 Player_SetStandDisabled(false);
				 
				 Sound_CreateAtEntity("Sound_CollapseWake", "03_03_herberts_hq/events/tasi_collapse_wake", "player");
				 PlayerBody_PlayCutsceneAtEntity("player_wake_up_after_collapse", "Area_CollapsedWakeUp", false, 0.f, "", 0.f, 0.f);
				 
				 Music_Play("A2_3_3_Tin_Hinan_Rescue.ogg", 0.2f, false, eMusicPrio_MinorEvent);
				 
				 Entity_SetActive("TH_Cutscene", true);
				 Entity_SetUpdateBonesWhenCulled("TH_Cutscene", true);
				 Entity_PlayAnimation("TH_Cutscene", "tinhinan_wake_up_after_collapse", 0.f, false);
				 Entity_SetAnimationPaused("TH_Cutscene", "tinhinan_wake_up_after_collapse", true);
             }
			 else if (Sequence_DoStepAndWait(0.75f))
			 {
				 Sound_FadeGlobalVolume(1.f, 1.f, eSoundEntryType_World);
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 Sound_CreateAtEntity("Sound_YoungTinHinanAppear", "level_dreams/anim/cave_in_appear", "player");	
				 Sound_CreateAtEntity("Sound_YoungTinHinanLoop", "creatures/foley/creature/tin_hinan/body_sound", "TH_Cutscene", 0.2f);
				 
				 mlBlurID = Effect_Blur_Start(1.f, 0.5f);
			 }
             else if (Sequence_DoStepAndWait(0.25f))
             {                
				 cLux_GetPlayer().SetActive(true);
				 
				 Effect_Fade_In(2.f);
				 Effect_ImageTrail_Start(3.f, 0.f, 10.f, 4.f);
				 
				 PlayerBody_PlayCutsceneAtEntity("player_wake_up_after_collapse", "Area_CollapsedWakeUp", false, 0.f, "OnAnimEnd_CollapseWakeUp");
				 Entity_SetAnimationPaused("TH_Cutscene", "tinhinan_wake_up_after_collapse", false);
				 
				 PlayerBody_SetCutsceneMaxPitch(2.f);
				 PlayerBody_SetCutsceneMaxYaw(2.f);
				 Player_SetLookSpeedMul(0.1f);
             }
			 else if (Sequence_DoStepAndWait(1.5f))
			 {
				 Light_FadeBrightnessTo("Light_TH_WakeUp_*", 50.f, 1.25f, eEasing_QuadIn);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Effect_Fade_Out(1.5f);
			 }
			 else if (Sequence_DoStepAndWait(1.25f))
			 {
				 Light_FadeBrightnessTo("Light_TH_WakeUp_*", 0.f, 0.5f, eEasing_QuadOut);
			 }
			 else if (Sequence_DoStepAndWait(2.5f))
			 {
				 SetWakeUpCutsceneTimePos(4.4f);
				 Effect_Fade_In(1.f);
				 
				 Light_FadeBrightnessTo("Light_TH_WakeUp_*", 25.f, 1.25f, eEasing_QuadIn);
			 }
			 else if (Sequence_DoStepAndWait(1.75f))
			 {			 
				 Effect_Fade_Out(1.f);
			 }
			 else if (Sequence_DoStepAndWait(2.5f))
			 {				 
				 SetWakeUpCutsceneTimePos(8.f);
				 Effect_Fade_In(1.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {			 
				 Effect_Fade_Out(1.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Sound_Stop("Sound_YoungTinHinanLoop", 1.f);
				 
				 Light_SetBrightness("Light_TH_WakeUp_*", 0.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Entity_SetActive("TH_Cutscene", false);
				 YoungTinHinan_Activate("TH_Guide", 0.1f, false);
			 }
			 else if (Sequence_DoStepAndWait(2.5f))
			 {				 
				 SetWakeUpCutsceneTimePos(11.6f);
				 Effect_Fade_In(1.f);
				 
				 Voice_PlayDelayed("Dialogue_WokenUp", 1.f);
				 Effect_Blur_FadeOut(mlBlurID, 3.f);
			 }
			 else if (Sequence_DoStepAndWait(5.f))
			 {			
				 Map_GetEntity(PlayerBody_GetEntityName()).GetMeshEntity().GetAnimationStateFromName("player_wake_up_after_collapse").FadeSpeed(0.3f, 2.f);				 
			 }
			 else if (Sequence_DoStepAndWait(3.75f))
			 {
				 YoungTinHinan_MoveTo("TH_Guide", "PathNode_82", "OnPathEnd_THGuide", 1);
				 DoSketch("tth_hint_tunnels");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Map_GetEntity(PlayerBody_GetEntityName()).GetMeshEntity().GetAnimationStateFromName("player_wake_up_after_collapse").FadeSpeed(1.f, 2.f);
			 }
             Sequence_End();
         }
		 
		 //-------------------------------------------------------
		 
		 void SetWakeUpCutsceneTimePos(float afT)
		 {
			 PlayerBody_GetAnimationState("player_wake_up_after_collapse").SetTimePosition(afT);
			 Map_GetEntity("TH_Cutscene", eLuxEntityType_Prop).GetMeshEntity().GetAnimationStateFromName("tinhinan_wake_up_after_collapse").SetTimePosition(afT);
		 }
		 
