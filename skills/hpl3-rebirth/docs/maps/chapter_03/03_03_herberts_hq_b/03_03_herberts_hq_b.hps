		 //-------------------------------------------------------
		 		 
		 bool OnTrigger_Player_ActivatePortalFlicker(const tString &in asParent, const tString &in asChild, int alState)
		 {			
			ActivatePortalDestinationFlicker(alState == 1, 1.f);
			return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void ActivatePortalDestinationFlicker(bool abX, float afFadeTime)
		 {
			 if (abX == false)
			 {
				 mbAllowPortalDestinationFlicker = false;
				 
				 SetCurrentPortalDestinationActive(abX, afFadeTime);
				 Map_RemoveTimer("Timer_PortalDestinationFlicker");
			 }
			 else
			 {
				 if (cScript_GetGlobalVarInt("TTH_PortalCanistersInPlace") < 2)
					 return;
				 
				 mbAllowPortalDestinationFlicker = true;
				 SetCurrentPortalDestinationActive(true, afFadeTime);
				 Map_AddTimer("Timer_PortalDestinationFlicker", 3.f, "OnTimer_PortalDestinationFlicker");
			 }				
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PortalDestinationFlicker(const tString &in asTimer)
		 {			 
			 if (mbAllowPortalDestinationFlicker == false)
				 return;
				 
			 float fTime = cMath_RandRectf(0.15f, 0.2f);
			 mfPortalDestinationFlickerTime -= fTime;
			 
			 if (mfPortalDestinationFlickerTime <= 0.f)
			 {
				 mfPortalDestinationFlickerTime = mbPortalDestinationCutsceneActive ? cMath_RandRectf(1.f, 1.5f) : cMath_RandRectf(2.f, 3.5f);
				 
				 msPortalDestination = "Portal_Destination_Wreckage";
				 SetCurrentPortalDestinationActive(false, cMath_RandRectf(0.15f, 0.25f));
				 msPortalDestination = "Portal_Destination_DW";
				 SetCurrentPortalDestinationActive(false, cMath_RandRectf(0.15f, 0.25f));				 
				 msPortalDestination = "Portal_Destination_Town";				 
				 SetCurrentPortalDestinationActive(true, cMath_RandRectf(0.4f, 0.7f));
				 
				 Map_RestartCurrentTimer(cMath_RandRectf(3.5f, 7.f));
				 return;
			 } 
			 
			 SetCurrentPortalDestinationActive(false, fTime);
			 
			 int lId = cMath_RandRectl(0, mvPortalDestinations.size() - 1);
			 msPortalDestination = mvPortalDestinations[lId];
			 
			 mvPortalDestinations.removeAt(lId);
			 if (mvPortalDestinations.size() == 0)
			 {
				 mvPortalDestinations.push_back("Portal_Destination_Wreckage");
				 mvPortalDestinations.push_back("Portal_Destination_Town");
				 mvPortalDestinations.push_back("Portal_Destination_DW");
			 }
			 
			 SetCurrentPortalDestinationActive(true, fTime);
			 
			 Map_RestartCurrentTimer(fTime);
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetCurrentPortalDestinationActive(bool abX, float afTime = 0.5f, float afMul = 1.f)
		 {
			 cColor color = abX ? cColor(1.f) : cColor(0.f, 0.f, 0.f, 0.f);
			 Entity_FadeEffectBaseColor(msPortalDestination, color * afMul, afTime);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_StartPortalCutscene(const tString &in asEntity, int alState)
		 {
			 if (Entity_GetCollide("player", "Trigger_PortalAccessPlatform") == false)
				 return;
			 
			 PlayPortalCutscene();
		 }
		 
		 //-------------------------------------------------------
		 
		 void PlayPortalCutscene()
		 {
			 if (mbPortalRoomEventStarted || mbPortalCutscenePlayed || cScript_GetGlobalVarBool("TTH_PortalFailed"))
				 return;
			 
			 mbPortalCutscenePlayed = true;
			 
			 if (cScript_GetGlobalVarBool("TTH_LookedAtDestinations"))
			 {
				 Map_RemoveTimer("Timer_StartPortalCutscene");
				 Entity_SetActive("Trigger_StartPortalCutscene_*", false);
				 return;
			 }
			 
			 Entity_SetInteractionDisabled("InteractArea_PlaceOrb", true);
			 
			 Map_AddTimer("Timer_StartPortalCutscene", 0.01f, "OnTimer_StartPortalCutscene");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StartPortalCutscene(const tString  &in asTimer)
		 {
			 if (cLux_GetPlayer().GetCharacterBody().IsOnGround() == false)
			 {
				 Map_RestartCurrentTimer();
				 return;
			 }		 
			 
			 mbPortalDestinationCutsceneActive = true;
			 cScript_SetGlobalVarBool("TTH_LookedAtDestinations", true);			 
			 
			 Entity_SetActive("Trigger_StartPortalCutscene_*", false);
			 
			 Voice_StopAll();
			 Voice_Play("Dialogue_PortalSeeTown", -1, "OnVoiceEnd_SeeTown");
			 
			 Player_SetCrouching(false, false, false);
			 
			 PlayerBody_SetUnequipItemsOnCutscene(false);
			 Item_TakeOut(ItemType_GetFirstInInventory("Orb"));
			 
			 mvPortalCutscenePos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
			 cVector3f vDir = cMath_Vector3Normalize(Map_GetEntity("Trigger_StartPortalCutscene_1", eLuxEntityType_Area).GetPosition() - Player_GetCameraPosition());
			 mfPortalCutsceneAngle = cMath_GetAngleFromPoints3D(0.f, vDir).y;
			 
			 PlayerBody_SetArmAnimationPitch(false, true, false);
			 PlayerBody_SetArmAnimationYaw(false, true, false);
			 
			 PlayerBody_PlayCutsceneAnimation("tasi_hold_orb_to_portal_start", false, 0.5f, "OnAnimEnd_PortalCutsceneStart", 0.f, 0.f, true, mvPortalCutscenePos, mfPortalCutsceneAngle);
			 PlayerBody_SetCutsceneMaxPitch(10.f);
			 PlayerBody_SetCutsceneMaxYaw(10.f);
			 
			 Map_AddTimer("Timer_ResetOrbCutsceneSpeed", 6.f, "OnTimer_ResetOrbCutsceneSpeed");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnVoiceEnd_SeeTown(const tString &in asScene, const tString &in asSubject)
		 {
			 Voice_PlayDelayed("Dialogue_PortalCutScene", 0.1f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ResetOrbCutsceneSpeed(const tString &in asTimer)
		 {
			 PlayerBody_GetAnimationState("tasi_hold_orb_to_portal_start").SetSpeed(1.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_PortalCutsceneStart(const tString &in asAnim)
		 {
			 PlayerBody_SetUnequipItemsOnCutscene(false);
			 PlayerBody_PlayCutsceneAnimation("tasi_hold_orb_to_portal_idle", true, 0.3f, "", 1.f, 0.f, true, mvPortalCutscenePos, mfPortalCutsceneAngle, false, true);
			 PlayerBody_SetCutsceneMaxPitch(10.f);
			 PlayerBody_SetCutsceneMaxYaw(10.f);
			 
			 Map_AddTimer("Timer_EndPortalCutscene", 9.f, "OnTimer_EndPortalCutscene");
			 Map_AddTimer("Timer_EnableVisionOrb", 2.f, "OnTimer_EnableVisionOrb");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_EnableVisionOrb(const tString &in asTimer)
		 {
			 mbFadeInVisionOrb = true;
			 mfVisionOrbAlphaGoal = 1.f;
			 
			 PlayerBody_FadeCutsceneMaxPitch(0.f, 5.f);
			 PlayerBody_FadeCutsceneMaxYaw(0.f, 5.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_EndPortalCutscene(const tString &in asTimer)
		 {
			 PlayerBody_SetUnequipItemsOnCutscene(false);
			 PlayerBody_PlayCutsceneAnimation("tasi_hold_orb_to_portal_end", false, 0.3f, "OnAnimEnd_PortalCutsceneEnd", 1.f, 0.f, true, mvPortalCutscenePos, mfPortalCutsceneAngle, false, true);
			 PlayerBody_SetCutsceneMaxPitch(0.f);
			 PlayerBody_SetCutsceneMaxYaw(0.f);
			 
			 mbFadeInVisionOrb = true;
			 mfVisionOrbAlphaGoal = 0.f;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_PortalCutsceneEnd(const tString &in asAnim)
		 {
			 PlayerBody_SetArmAnimationPitch(true, true, false);
			 PlayerBody_SetArmAnimationYaw(true, true, false);
			 
			 PlayerHands_PlayAnimation("tool_orb_idle", true, false, 0.f, Item_GetHeldEntity(eItemHandlerHand_Right), true, 1.f, -1.f, true, true);
			 
			 Sketchbook_AddIdea("escape_tth");
			 mbPortalDestinationCutsceneActive = false;
			 
			 Entity_SetInteractionDisabled("InteractArea_PlaceOrb", false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void UpdateVisionOrb(float afTimeStep)
		 {
			 if (mbFadeInVisionOrb == false)
				 return;
				
			 iLuxEntity@ pEnt = mBaseObj.GetEntityByName(Item_GetHeldEntity(eItemHandlerHand_Right), eLuxEntityType_Prop);
			 if (pEnt !is null)
			 {
				 cBillboard@ pBillboard = pEnt.GetBillboardFromName("Billboard_1");
				 if (pBillboard is null)
					 return;
				 
				 float fAlpha = pBillboard.GetColor().a;
				 float fSpeed = mfVisionOrbAlphaGoal == 1.f ? (1.f / 5.f) : (1.f / 5.f);				 
				 
				 fAlpha = cMath_IncreaseTo(fAlpha, afTimeStep * fSpeed, mfVisionOrbAlphaGoal);
				 pBillboard.SetColor(cColor(1.f, 1.f, 1.f, fAlpha));
				 
				 if (fAlpha == mfVisionOrbAlphaGoal)
					 mbFadeInVisionOrb = false;
			 }
			 else
			 {
				 mbFadeInVisionOrb = false;
			 }
		 }
	 
