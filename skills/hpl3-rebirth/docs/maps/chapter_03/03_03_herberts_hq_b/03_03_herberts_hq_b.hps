	//-------------------------------------------------------
	
	void SetSubstationState(int alId, bool abActive, bool abAffectWheelOnly = false, bool abAffectLightsOnly = false)
	{		
		tString sWheel = "ControlWheel_" + alId;
		tString sJunction = "PillarJunction_" + alId;
		tString sJunctionLight = "Light_PillarJunction_" + alId + "_*";
		tString sBeamFilter = "BeamFilter_" + alId;
		
		if (abAffectWheelOnly == false)
		{
			Entity_SetEffectsActive(sBeamFilter + "_Active", abActive, true);
			Entity_SetEffectsActive(sJunction + "_Active", abActive, true);
			Light_FadeTo(sJunctionLight, cColor(0.594,1,0.995,1) * (abActive ? 1.5f : 0.f), 4.f, 0.1f);
			
			if (abAffectLightsOnly)
				return;
				
			Entity_SetActive(sBeamFilter + "_Active", abActive);
			Entity_SetActive(sBeamFilter + "_Inactive", abActive == false);
			
			Entity_SetActive(sJunction + "_Active", abActive);
			Entity_SetActive(sJunction + "_Inactive", abActive == false);
		}
		
		if (abActive)
		{
			Wheel_SetJammed(sWheel, false, 0.f, 0.f);
			cLux_AddDebugMessage("------------UNJAM");
		}
		else if (abActive == false)
		{
			float fAngle = Wheel_GetCurrentAngle(sWheel);
			Wheel_SetJammed(sWheel, true, fAngle - 3.f, fAngle + 3.f);
			cLux_AddDebugMessage("-------------JAM");
		}			
	}
	
	//-------------------------------------------------------
	
	void OnTimer_JamControlWheels(const tString &in asTimer)
	{
		SetSubstationState(1, false, true);
		SetSubstationState(2, false, true);
		SetSubstationState(3, false, true);
	}
	
