         /////////////////////////////////////////
		 // Event I *Trigger Shadow chase*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event I here.*/
		 
		 bool mbChaseStarted = false;
		 int mlChaseStartAnimationId = 1;
		 tString msChaseStartHeldItem = "";
		 tString msChaseStartAnim = "";
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event I here.*/
		 
		 bool OnTrigger_Player_SetupChaseDoorLighting(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1)
				 return true;
			 
			 Light_SetBrightness("Light_Spot_TuaregDoor", Entity_PlayerIsInFront(asParent) ? 5.f : 0.f);
			 return true;
		 }
		 
		 bool OnTrigger_Player_StartSeqShadowAppearQueensGrave(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Seq_ShadowAppearQueensGrave("");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataShadowAppearQueensGrave;
         void Seq_ShadowAppearQueensGrave(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_ShadowAppearQueensGrave", mSeqDataShadowAppearQueensGrave);
             if (Sequence_DoStepAndWait(1.f))
			 {
				 Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);	
                 Effect_Shake_Start(0.005f, 6.f, 1.f, 1.f);
				 
				 Entity_SetActive("Trigger_PlayIntroComment_Daylight", false);
			 }
             else if (Sequence_DoStepAndPause(0.5f))
             {
				 FearHandler_SetForcedAddFearRate(0.2f, 5.f, false);
             }
             Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ResumeSeqShadowAppearQueensGrave(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 SequenceStates_Resume("Seq_ShadowAppearQueensGrave");
			 return false;
		 }
         
         //-------------------------------------------------------
         
         bool OnTrigger_Player_ForceShadowChase(const tString &in asParent, const tString &in asChild, int alState)
         {
			 mlChaseStartAnimationId = cString_GetNumericSuffixInt(asParent);
			 Entity_SetActive("Trigger_ForceShadowChase_*", false);
			 
			 Seq_StartShadowChase("");
			 SequenceStates_Stop("Seq_ShadowAppearQueensGrave");
			 
			 mlPermaFailStage = eHQAPermaFailStage_ShadowChaseCarry;
			 msPermaFailRespawnArea = "PermaFail_ShadowCarry_1";
			 
			 Player_FadeRunSpeedMulTo(1.f, 1.f);			 
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSequenceStartShadowChase;
         void Seq_StartShadowChase(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_StartShadowChase", mSequenceStartShadowChase);
			 
			 float fStartTime = mlChaseStartAnimationId == 1 ? 1.f : 0.1f;
			 float fAnimPauseTime = mlChaseStartAnimationId == 1 ? 1.5f : 0.f;
			 float fAnimResumeTime = mlChaseStartAnimationId == 1 ? 2.f : 1.f;
			 
			 if (Sequence_DoStepAndWait(fStartTime))
			 {
				 // No kicks during chase
				 Pregnancy_SetBabyKicksEnabled(false);
				 
				 FearHandler_SetPermaFailEnabled(false);
				 Entity_SetActive("Trigger_PlayIntroComment_Daylight", false);
				 
				 Amulet_StopTracking();
				 FearHandler_SetWhispersActive(false);
				 
				 Light_FadeTo("Light_Spot_ChaseStart", gShadowFleshLightColor, 30.f, 0.5f);
				 Light_FadeBrightnessTo("Light_Spot_TuaregDoor", 0.f, 0.5f, eEasing_SineOut);
				 
				 Entity_SetActive("ShadowFlesh_Chase_Start_*", false);
			 }
			 else if (Sequence_DoStepAndWait(0.1f))
			 {			
				 Voice_StopAll();
				 
				 Effect_Shake_Start(0.001f, 2.f, 1.f, 1.f);
				 Effect_Rumble_Start(1, 1.5, 0, 0.5);
				 
				 Entity_SetActive("TuaregDoor", false);
				 ParticleSystem_SetActive("PS_DoorBreak", true);
				 ParticleSystem_SetVisible("PS_DoorBreak", true);
				 ParticleSystem_CreateAtEntity("PS_DoorDust", "dust_impact_large_oneshot.ps", "Area_ChaseDoorBreak", false).SetBrightness(0.1f);
				 Sound_CreateAtEntity("Sound_DoorBreak", "03_06_ghouls_nest/chase_sequence/ghoul_chase_door_smash", "TuaregDoor");
				 
				 Entity_SetActive("TuaregDoor_Broken_*", true);
				 
				 array<iLuxEntity@> vEnts;
				 Map_GetEntityArray("TuaregDoor_Broken_*", vEnts, eLuxEntityType_Prop);
				 for (int i = 0; i < vEnts.size(); ++i)
					 Body_AddImpulse(vEnts[i].GetName() + "_Body_1", cVector3f(1.f, 0.f, 1.f), false);
				 
				 Sound_CreateAtEntity("Sound_StartFlesh", "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", "Area_ShadowStart");
				 Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);	
				
				 Entity_SetActive("BlockBox_TrapFlesh", true);
				 
				 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_1_*", "Decal_ShadowFlesh_Chase_Start_1_*", 5.f, 5.1f, true);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 msChaseStartHeldItem = Item_GetHeld(eItemHandlerHand_Left);
				 
				 Item_PutAway(eItemHandlerHand_Left);
				 Item_PutAway(eItemHandlerHand_Right);
				 
				 msChaseStartAnim = mlChaseStartAnimationId == 1 ? "player_fall_hqa_chase_a" : "player_fall_hqa_chase_b";
				 PlayerBody_PlayCutsceneAtEntity(msChaseStartAnim, "Area_ChaseStart", false, 0.3f, "OnAnimEnd_ChaseStart");
				 PlayerBody_SetCutsceneMaxPitch(20.f);
				 PlayerBody_SetCutsceneMaxYaw(20.f);
			 }
			 else if (Sequence_DoStepAndWait(fAnimPauseTime))
			 {
				Light_FadeBrightnessTo("Light_ChaseStart_*", 1.f, 1.f, eEasing_SineInOut); // Sneaky light to make the flesh more visible
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_2_*", "Decal_ShadowFlesh_Chase_Start_2_*", 0.9f, 1.f, true);
				 Effect_Rumble_Start(0.4, 1, 0, 0.5);
				 
				 Player_FadeNightVisionStrength(1.75f, 2.f);			
				 Player_SetMapDeepShadow(0.5f);
				 Player_SetNightVisionIgnoreFearArea(true);
				 
				 PlayerBody_GetAnimationState(msChaseStartAnim).FadeSpeed(mlChaseStartAnimationId == 1 ? 0.3f : 0.15f, 1.f);
				 
				 FearHandler_SetForcedAddFearRate(0.5f, 5.f, false);
			 }
			 else if (Sequence_DoStepAndWait(1.5f))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_3_*", "Decal_ShadowFlesh_Chase_Start_3_*", 0.9f, 1.f, true); 
				 Effect_Rumble_Start(0.4, 1, 0, 0.5);
				 ParticleSystem_CreateAtEntity("PS_ShadowStart", "shadow_locator.ps", "Area_ShadowStart", false);
			 }
			 else if (Sequence_DoStepAndWait(fAnimResumeTime))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_4_*", "Decal_ShadowFlesh_Chase_Start_4_*", 0.9f, 1.f, true);
				 Effect_Rumble_Start(0.4, 1, 0, 0.5);
				 
				 if (mlChaseStartAnimationId == 2)
					 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_8_*", "Decal_ShadowFlesh_Chase_Start_8_*", 0.9f, 1.f, true);
					 
				 Music_PlayExt("A2_3_3_Shadow_Chase.ogg", true, 0.4f, 1.0f, 3.5f, 0.0f, eMusicPrio_BigEvent, true);
			 }
			 else if (Sequence_DoStepAndWait(1.5f))
			 {
				 PlayerBody_GetAnimationState(msChaseStartAnim).FadeSpeed(1.f, 0.3f);
				 
				 ParticleSystem_CreateAtEntity("PS_ShadowStart", "shadow_locator.ps", "Area_ShadowStart", false);
				 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_5_*", "Decal_ShadowFlesh_Chase_Start_5_*", 0.9f, 1.f, true);
				 Effect_Rumble_Start(0.4, 1, 0, 0.5);
				 FearHandler_SetForcedAddFearRate(0.5f, 8.f, false);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_6_*", "Decal_ShadowFlesh_Chase_Start_6_*", 0.9f, 1.f, true);
				 Effect_Rumble_Start(0.4, 1, 0, 0.5);
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 Player_GiveDamage(0.01f, 0.1f, eDamageType_Guardian, "");
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_9_*", "Decal_ShadowFlesh_Chase_Start_9_*", 0.9f, 1.f, true);
			 }
			 else if (Sequence_DoStepAndWait(1.5f))
			 {				 				 
				 float fTime = mlChaseStartAnimationId == 1 ? 1.f : 3.f;
				 Map_AddTimer("Timer_PlayChaseRunDialogue", fTime, "OnTimer_PlayChaseRunDialogue");
			 }
			 else if (Sequence_DoStepAndWait(1.5f))
			 {
				 ParticleSystem_CreateAtEntity("PS_ShadowStart", "shadow_locator.ps", "Area_ShadowStart_1", false);
				 ShadowFlesh_Spawn("ShadowFlesh_Chase_Start_7_*", "Decal_ShadowFlesh_Chase_Start_7_*", 0.9f, 1.f, true);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Map_AddTimer("Timer_StartShadowChase", 1.f, "OnTimer_StartShadowChase");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayChaseRunDialogue(const tString &in asTimer)
		 {
			 Pregnancy_SetBarksActive(false);
			 Player_SetHealthSpeedMulActive(false);
				 
			 if (Player_GetRunning() == false)
			 {
				 Hint_StopHint();				 
				 Hint_RemoveFromGiven("Hints", "HintRun");
				 Hint_ShowHint_Hold("Hints", "HintRun", true, 1.5f, true, 15.f);
				 
				 //Voice_Play("Dialogue_Run");
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_ChaseStart(const tString &in asAnim)
		 {
			 Light_FadeTo("Light_Chase_StartPoint", gShadowFleshLightColor, 7.f, 0.5f);
			 
			 if (msChaseStartHeldItem != "")
				Item_TakeOut(msChaseStartHeldItem);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayShadowChaseMusic(const tString &in asTimer)
		 {
			 Music_PlayExt("A2_3_3_Shadow_Chase.ogg", true, 0.4f, 1.0f, 5.0f, 0.0f, eMusicPrio_BigEvent, true);
		 }
         
		 //-------------------------------------------------------
		 
		 void OnTimer_StartShadowChase(const tString &in asTimer)
		 {
			 StartShadowChase();
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_StartShadowChase(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 StartShadowChase();
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void StartShadowChase()
		 {
			 if (mbChaseStarted)
				 return;
				 
			 mbChaseStarted = true;
			 mlCurrShadowChasePath = 1;
			 mlCurrShadowChaseStep = 1;
				 
			 Timer_ShadowChaseAdvance("");
				 
			 Player_SetFallDamageActive(false);
		 }
		 
         //-------------------------------------------------------
	 
		 //} END Event I *Trigger Shadow chase*
		 
		 /////////////////////////////////////////
		 // Event J *Wake up in the Tomb (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event J here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event J here.*/
		 
		 bool OnPermaFail_ChieftainTomb()
		 {	
			 SetupGenericPermaFail();
			 FearHandler_SetPermaFailRespawnArea(msPermaFailRespawnArea);
			 return true;
		 }
	
		 //------------------------------------------------------------
	
		 bool OnPermaFailRespawn_ChieftainTomb()
		 {
			 return true;
		 }
							 
