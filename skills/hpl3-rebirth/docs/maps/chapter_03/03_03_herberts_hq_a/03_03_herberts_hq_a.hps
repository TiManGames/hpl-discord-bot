		 //} END Event J *Wake up in the Tomb (PERMAFAIL)*
	 
	 //} END SCENE 1
     
    //////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 2 *GET CHASED BY THE SHADOW*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 1 here.*/
        
        int mlCurrShadowChaseStep = 1;
        int mlPrevShadowChaseStep = 1;
        int mlCurrShadowChasePath = 1;
        int mlPrevShadowChasePath = 1;
        int mlCurrPlayerChaseStep = 1;
        int mlCurrPlayerChasePath = 1;
        int mlPrevShadowChaseStepAdd = 1;
		int mlChasePlayerPassiveCount = 0;
		int mlChasePauseCount = 0;
		int mlShadowChasePermaFailCount = 0;
        cVector3f mvPrevPlayerPos;
		array<tString> mvCurrDeadlyAreas;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 2 here.*/
        
        void Timer_ShadowChaseAdvance(const tString &in asTimer)
        {
			/////////////////////
            // Set up areas			
            tString sPathAreaBase = "ShadowChase_Path_" + mlCurrShadowChasePath + "_StepArea_";
            tString sCurrShadowStepArea = sPathAreaBase + mlCurrShadowChaseStep;
			
			/////////////////////
            // Handle death		
			Entity_SetVarBool(sCurrShadowStepArea, "KillPlayer", true);
			
			for (int i = 0; i < mvCurrDeadlyAreas.size(); i++)
			{
				if (Entity_GetCollide(mvCurrDeadlyAreas[i], "player") && cLux_GetGodModeActivated() == false)
				{
					HandleShadowDeath();
					return;
				} 
			}

			mvCurrDeadlyAreas.resize(0);
			mvCurrDeadlyAreas.push_back(sCurrShadowStepArea);			
			if (mlPrevShadowChaseStepAdd == 2)
				mvCurrDeadlyAreas.push_back(sPathAreaBase + (mlCurrShadowChaseStep - 1));
            
            /////////////////////
            // Spawn flesh	
			int lDamageReach = 2;
			if (mlPrevShadowChaseStepAdd != 0)
			{
				// Larger range at the very start so the player gets nibbled on
				/*if (mlCurrPlayerChasePath == 1) 
				{
					if (mlCurrPlayerChaseStep <= 13)
						lDamageReach = 3;
				}*/
				
				int lCount = cMath_Min(4, lDamageReach + 1);
				for (int i = 1; i < lCount; i++)
				{
					tString sNextFleshArea = sPathAreaBase + (mlCurrShadowChaseStep + i);
					if (Entity_Exists(sNextFleshArea))
					{
						ShadowFlesh_Spawn(sNextFleshArea + "_Flesh_*", "Decal_" + sNextFleshArea + "_Flesh_*", 2.f, 3.f, false);
						
						if (i > lDamageReach || Entity_GetCollide("player", sNextFleshArea) == false)
							continue;
							
						if (Map_TimeHasPassed("Timer_ShadowFleshDamage", 2.f) == false)
							continue;
						
						Player_GiveDamage(0.3f, 0.8f, eDamageType_Guardian, "TheShadow");
						mlChasePauseCount = 2;		
					}	
				}
			}									
            
			/////////////////////
            // Call step event
            tString sEventFunc = "Timer_ShadowChaseStepEvent_Path_" + mlCurrShadowChasePath + "_Step_" + mlCurrShadowChaseStep;
            if (mBaseObj.ScriptMethodExists("void " + sEventFunc + "(const tString &in asTimer)"))
                Map_AddTimer("ShadowChaseStepEvent", 0.f, sEventFunc);
            
			/////////////////////
            // If double step last time, trigger events and enable damage for skipped step
            if (mlPrevShadowChaseStepAdd == 2)
            {
                tString sSkippedArea = sPathAreaBase + (mlCurrShadowChaseStep - 1);
				Entity_SetVarBool(sSkippedArea, "KillPlayer", true);
                
                sEventFunc = "Timer_ShadowChaseStepEvent_Path_" + mlCurrShadowChasePath + "_Step_" + (mlCurrShadowChaseStep - 1);
                if (mBaseObj.ScriptMethodExists("void " + sEventFunc + "(const tString &in asTimer)"))
                    Map_AddTimer("ShadowChaseStepEvent", 0.f, sEventFunc);
            }
            
			/////////////////////
			// Effects!
			ParticleSystem_CreateAtEntity("PS_ShadowLocator", "shadow_locator.ps", sCurrShadowStepArea, false);
			
            Light_FadeTo(sCurrShadowStepArea + "_Light", gShadowFleshLightColor, 10.f, 2.f);
			
			{
				cLightSpot@ pSpot = cast<cLightSpot@>(mBaseObj.GetWorld().GetLight("Light_Spot_Chase"));
			
				cVector3f vSpotPos = Map_GetEntity(sCurrShadowStepArea).GetPosition();
				cVector3f vCamPos = cLux_GetPlayer().GetCamera().GetPosition();
					
				cVector3f vForward = cMath_Vector3Normalize(vSpotPos - vCamPos);			
				cVector3f vRight = cMath_Vector3Normalize(cMath_Vector3Cross(vForward, cVector3f_Down));
				cVector3f vUp = cMath_Vector3Normalize(cMath_Vector3Cross(vForward, vRight));
								
				cMatrixf mtxSpot = cMath_MatrixUnitVectors(vRight, vUp, vForward, vSpotPos);
				pSpot.SetWorldMatrix(mtxSpot);
				
				pSpot.FadeTo(gShadowFleshLightColor, 30.f, 0.8f);
				Map_AddTimer("Timer_FadeOutChaseSpot", 0.8f, "OnTimer_FadeOutChaseSpot");
			}
			
            
            Sound_CreateAtEntity("ChaseStepSound" + mlCurrShadowChaseStep, "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", sCurrShadowStepArea, 0.f, false, 0.5f);
            if (cMath_RandRectl(0, 6) == 6 && Sound_GuiIsPlaying("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated") == false)
                Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);	
            
            int lShakeID = Effect_Shake_Start(0.015f, cMath_RandRectf(0.8f, 1.5f), 0.2f, 0.2f);
            Effect_Shake_SetSourceEntity(lShakeID, sCurrShadowStepArea, 2.f, 30.f, eEasing_Linear);
            
            float fDist = Entity_GetDeltaToEntity(sCurrShadowStepArea, "player").Length();
            Effect_ImageTrail_Start(1.f - (cMath_Min(fDist, 15.f) / 15.f), 0.2f, 0.5f, 0.2f);
			
			FearHandler_SetForcedAddFearRate(0.6f, 1.3f, false);
                
            /////////////////////
            // Advance chase
            int lStepAdd = fDist > 10.f ? 2 : 1;
            
            // Only advance every other time if the player is trying
            bool bPlayerTrying = Player_GetCurrentStateName() != "State_Normal" ||
								 Entity_GetCollide("player", "CrouchArea_CollapsedTunnel") ||
								 (mvPrevPlayerPos - cLux_GetPlayer().GetCharacterBody().GetPosition()).Length() > 4.f || 
								 cLux_GetPlayer().GetTimeSincePhysicsObjectInteraction() < 1.f ||
								 Map_TimerExists("Timer_JustDiedFromShadow");
								 
			mvPrevPlayerPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
			
			/////////////////
			// Slow down on first path!
			if (mlCurrPlayerChasePath == 1)
			{
				lStepAdd = 1;
				
				if (mlCurrPlayerChaseStep > 14 && mlCurrShadowChaseStep < 12)
				{
					bPlayerTrying = false;
					lStepAdd = 2;
				}
				else if (mlCurrShadowChaseStep > 13)
				{
					bPlayerTrying = true;
				}
			}				
			else
			{
				// Only double step if player is really not doing anything
				mlChasePlayerPassiveCount = bPlayerTrying ? 0 : ++mlChasePlayerPassiveCount;			
				if (mlChasePlayerPassiveCount > 4)
					lStepAdd = 2;	
			}						
			
			/////////////////
			// Slow down if player trying!
			if (lStepAdd == 1 && bPlayerTrying && mlPrevShadowChaseStepAdd != 0 && 
				Map_GetEntity(sCurrShadowStepArea).CheckIsOnScreen(true) == false)
				lStepAdd = 0;
			
			if (bPlayerTrying == false)
				mlChasePauseCount = 0;
			
			if (mlChasePauseCount > 0)
			{
				lStepAdd = 0;
				mlChasePauseCount--;
			}
            
			/////////////////
            // Need to switch path to get to player?
            bool bAtPathEnd = Entity_Exists(sPathAreaBase + (mlCurrShadowChaseStep + lStepAdd)) == false;
            if (lStepAdd > 0 && (mlCurrShadowChasePath != mlCurrPlayerChasePath || bAtPathEnd))
            {
                array<int> vPotentialPaths;
                cString_GetIntVec(Entity_GetVarString(sCurrShadowStepArea, ""), vPotentialPaths, "_");
                
                if (vPotentialPaths.size() > 0)
                {
                    int lNextPath = -1;
                    for (int i = 0; i < vPotentialPaths.size(); i++)
                    {
                        // Path leads to the player!
                        if (mlCurrPlayerChasePath == vPotentialPaths[i])
                        {
                            lNextPath = vPotentialPaths[i];
                            break;
                        }
                        
						/////////////////
                        // If path leads to player, switch to it!
                        switch (vPotentialPaths[i])
                        {
                            case 3:
                                if (mlCurrPlayerChasePath == 5 || mlCurrPlayerChasePath == 8)
                                    lNextPath = vPotentialPaths[i];                                
                                break;
                            case 4: 
                                if (mlCurrPlayerChasePath == 6 || mlCurrPlayerChasePath == 8)
                                    lNextPath = vPotentialPaths[i];
                                break;
                            case 5: 
                                if (mlCurrPlayerChasePath == 8)
                                    lNextPath = vPotentialPaths[i];
                                break;
                            case 6: 
                                if (mlCurrPlayerChasePath == 8)
                                    lNextPath = vPotentialPaths[i];
                                break;
                            case 7: 
                                if (mlCurrPlayerChasePath == 6 || mlCurrPlayerChasePath == 8)
                                    lNextPath = vPotentialPaths[i];
                                break;
                        }
                    }
                    
					/////////////////
                    // No path leading to player, go with default!
                    if (lNextPath == -1)
                        lNextPath = vPotentialPaths[0];
                    
                    int lNextStep = 1;
                    
					/////////////////
                    // Next path is same as previous path! Continue where we left off
                    if (mlPrevShadowChasePath == lNextPath)
                        lNextStep = mlPrevShadowChaseStep + 1;
                    
                    mlPrevShadowChasePath = mlCurrShadowChasePath;
                    mlPrevShadowChaseStep = mlCurrShadowChaseStep;
                    mlCurrShadowChasePath = lNextPath;
                    mlCurrShadowChaseStep = lNextStep;
                    
                    lStepAdd = 0;
                }
                else
                {
					/////////////////
                    // Don't do double step at end of path
                    if (lStepAdd == 2 && bAtPathEnd)
                        lStepAdd = 1;
                    
					/////////////////
                    // If next step doesn't exist, end chase
                    if (Entity_Exists(sPathAreaBase + (mlCurrShadowChaseStep + lStepAdd)) == false)
                        return;
                }
            }
            
			/////////////////
            // Advance!
            mlCurrShadowChaseStep += lStepAdd;
            mlPrevShadowChaseStepAdd = lStepAdd;
			
			float fAdvanceTime = cMath_RandRectf(1.3f, 1.5f);
			
			// Fine tune speed at chase start
			if (mlCurrPlayerChasePath == 1)
			{
				float fSpeedMul = mlCurrPlayerChaseStep < 14 ? 0.95f : 1.15f;
				fAdvanceTime *= fSpeedMul;
			}
			
            Map_AddTimer("ShadowChaseAdvance", fAdvanceTime, "Timer_ShadowChaseAdvance");
        }
		
		//-------------------------------------------------------
		
		void OnTimer_FadeOutChaseSpot(const tString &in asTimer)
		{
			Light_FadeTo("Light_Spot_Chase", gShadowFleshLightColor, 0.f, 0.5f);
		}

        //-------------------------------------------------------
        
        bool OnTrigger_ShadowStep(const tString &in asParent, const tString &in asChild, int alState)
        {
            if (alState == -1) return true;
			if (mbChaseStarted == false) return true;
			if (FearHandler_GetIsPermaFailing()) return true;
            
            mlCurrPlayerChaseStep = cString_GetNumericSuffixInt(asParent);
            mlCurrPlayerChasePath = cString_ToInt(cString_Sub(asParent, 17, 1), 0); 
            
            if (Entity_GetVarBool(asParent, "KillPlayer") == false || 
                Map_TimerExists("ShadowChaseAdvance") == false ||
                cLux_GetGodModeActivated()) 
                return true;              
            
            HandleShadowDeath();
            return true;
        }
		
		//-------------------------------------------------------
		
        void HandleShadowDeath()
        {
			if (mbChaseStarted == false)
				return;
			
			Player_SetForceNightVision(false);
			
            Light_FadeTo("ShadowChase_Path_*", cColor(0.f, 0.f, 0.f, 0.f), -1.f, 1.f);
			Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);	
			
			Map_RemoveTimer("ShadowChaseAdvance");
									
			Player_GiveDamage(0.f, 1.f, eDamageType_Guardian, "TheShadow");
			
			FearHandler_TriggerPermaFail(true);
			FearHandler_FadeLevelTo(1.f, 2.f, true);
			
			++mlShadowChasePermaFailCount;
        }
		
		//--------------------------------------------------------
        
        void Timer_ChapelCollapse(const tString &in asTimer)
        {
            Entity_SetActive("chapel_roof_broken", true);
            Entity_SetActive("chapel_roof_collapse_*", true);
            ParticleSystem_CreateAtEntity("ChapelCollapseParticle", "dust_roof_break.ps", "ChapelCollapsePSArea", false).SetColor(cColor(1,0.931,0.879,1));
			
			FearHandler_SetForcedAddFearRate(0.4f, 2.f, true, -1.f, 0.1f);
			
			Map_AddTimer("Timer_ChapelCollapseShake", 1.f, "OnTimer_ChapelCollapseShake");
        }
		
		//-------------------------------------------------------
		
		void OnTimer_ChapelCollapseShake(const tString &in asTimer)
		{
			Effect_Shake_Start(0.035f, 1.f, 0.5f, 1.f);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_TriggerRockFall(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("FallingRock", true);
			Body_AddImpulse("FallingRock_Body_1", cVector3f(1.75f, 0.f, 0.f), false); 
			return false;
		}
		
		//--------------------------------------------------------

		void OnLookAt_AmphoraRoomCollapse(const tString &in asEntity, int alState)
		{
			Sound_Play("SoundRoomCollapse",0.5f);
            Effect_Shake_Start(0.03f, 9.f, 1.f, 1.f);
            
            Map_AddTimer("AmphoraRoomCollapse", 0.05f, "Timer_AmphoraRoomCollapse");
		}
		
		//--------------------------------------------------------
        
        void Timer_AmphoraRoomCollapse(const tString &in asTimer)
        {
            Entity_SetActive("amphora_room_debris_*", true);
			
			FearHandler_SetForcedAddFearRate(0.4f, 2.f, true, -1.f, 0.1f);
			
			PlayChaseRunEmote(4, 1.f);
        }
        
        //-------------------------------------------------------
        
        void Timer_ShadowChaseStepEvent_Path_6_Step_4(const tString &in asTimer)
        {
            Body_AddImpulse("archaeology_shovel_3_Body_1", cVector3f(-1.f, 0.f, 0.f), false);
        }
        
        //-------------------------------------------------------
        
        void Timer_ShadowChaseStepEvent_Path_8_Step_12(const tString &in asTimer)
        {
            if (Joint_IsBroken("support_beam_push_2_JointHinge_1")) 
				return;
            
            OnTrigger_BreakSupportBeam("", "", 1);
        }
		
		//-------------------------------------------------------
		
		void SetupChasePermaFailScenes()
		{
			/////////////////////
			// Setup the carry sequence
			mlShadowCarryStep = 0;
			
			Entity_SetActive("ShadowCarry_*", false);
			Visibility_SetAreaActive("VisibilityArea_ShadowCarry", true);
			
			ShadowFlesh_SetupDecals("Decal_ShadowCarry_*");
			
			/////////////////////
			// Empty scenes so we can play the shadow carry animation in the map script
			FearHandler_AddPermaFailScene("", "", "", "", 2.5f);
			FearHandler_AddPermaFailScene("", "", "", "", 2.5f);
			FearHandler_AddPermaFailScene("", "", "", "", 2.5f);
			
		    FearHandler_SetPlayPermaFailGhoulBreathing(false);
		}
		
		//-------------------------------------------------------
		
		void PlayChaseRunEmote(int alLineId, float afDelay = 0.3f)
		{
			Voice_PlayDelayed("Dialogue_RunEmotes", afDelay, alLineId);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_PlayChaseRunEmote(const tString &in asParent, const tString &in asChild, int alState)
		{
			PlayChaseRunEmote(Entity_GetVarInt(asParent, ""));
			return false;
		}
        
        //-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Uncover and climb down the CHASE LADDER*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event A here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event A here.*/
         
         bool OnTrigger_Player_PlayLandAnim(const tString &in asParent, const tString &in asChild, int alState)
		 {	
			 int lId = cString_GetNumericSuffixInt(asParent);
			 if (lId == 2)
				 mlChasePauseCount = 2;
				 
			 if	(lId == 1)	PlayChaseRunEmote(1);
			 else			PlayChaseRunEmote(2);
			 
			 msHeldItem = Item_GetHeld(eItemHandlerHand_Left);
			 
			 Item_PutAway(eItemHandlerHand_Left);
			 Item_PutAway(eItemHandlerHand_Right);
			 
			 Player_GiveDamage(0.1f, 0.5f, eDamageType_Default, "player");
			 
			 if (lId == 1)
			 {
				 PlayerBody_PlayCutsceneAtEntity("fall_and_get_up_quickly", asParent, false, 0.3f, "OnAnimEnd_ChaseFall", 1.3f);
			 }
			 else
			 {
				 cVector3f vPos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
				 vPos.y = Map_GetEntity(asParent).GetPosition().y;
				 float fAngle = cMath_GetAngleFromPoints3D(0, Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward()).y;
				 PlayerBody_PlayCutsceneAnimation("fall_and_get_up_quickly", false, 0.3f, "OnAnimEnd_ChaseFall", 1.3f, 0.f, true, vPos, fAngle);
			 }
			 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_ChaseFall(const tString &in asAnim)
		 {
			 Item_TakeOut(msHeldItem);				 
			 Player_SetCrouching(false, true, true);
		 }
		 
         //-------------------------------------------------------
         
         bool OnTrigger_ShadowChaseLadderArea(const tString &in asParent, const tString &in asChild, int alState)
         {
             if (mlCurrShadowChaseStep < 16)
                 mlCurrShadowChaseStep = 16;
				 
			 Sound_CreateAtEntity("SoundChapelCollapse", "03_03_herberts_hq/shadow_guardian/shadow_chase_roof_collapse", "chapel_roof_broken");
			 
			 Map_AddTimer("ChapelCollapse", 1.f, "Timer_ChapelCollapse");
			 
			 PlayChaseRunEmote(0, 2.f);
             return false;
         }
         
         //-------------------------------------------------------
         
         bool OnTrigger_EnterAmphoraRoom(const tString &in asParent, const tString &in asChild, int alState)
         {
             if (mlCurrShadowChasePath == 5 && mlCurrShadowChaseStep > 3) return false;
             
             mlCurrShadowChasePath = 5;
             mlCurrShadowChaseStep = 4;
             return false;
         }
         
         //-------------------------------------------------------
         
         bool OnTrigger_Player_AdvanceShadow(const tString &in asParent, const tString &in asChild, int alState)
         {
             if (mlCurrShadowChasePath > 2 || mlCurrShadowChasePath == 2 && mlCurrShadowChaseStep >= 12) return false;
             
             mlCurrShadowChasePath = 2;
             mlCurrShadowChaseStep = 12;
             return false;
         }
         	 
		 //-------------------------------------------------------
	 
		 //} END Event A *Uncover and climb down the CHASE LADDER*
         
         /////////////////////////////////////////
		 // Event B *Bypass the collapse*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event B here.*/
         
         int mlCollapseBridgePart = 2;
		 tString msHeldItem = "";
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event B here.*/
         
         bool OnCollide_Player_BridgeQuake(const tString &in asParent, const tString &in asChild, int alState)
         {
			 Entity_SetActive("Trigger_PlayLandAnim_2", true);
			 Map_AddTimer("Timer_BridgeQuake", 0.25f, "OnTimer_BridgeQuake");
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_BridgeQuake(const tString &in asTimer)
		 {
			 Sound_CreateAtEntity("BridgeCreak", "03_03_herberts_hq/shadow_guardian/bridge_collapse_creak", "ChaseBridge");
			 Sound_CreateAtEntity("RockDrop", "03_03_herberts_hq/shadow_guardian/bridge_rock_drop", "BridgeRock_1");
             Effect_Shake_Start(0.01f, 5.f, 1.f, 1.f);

			 ShadowFlesh_Spawn("ShadowChase_BridgeFlesh_*", "Decal_ShadowChase_BridgeFlesh_*", 0.8f, 1.f);
			 LightFlash_Add(1.5f, 0.5f, 1.f, "BridgeBlocker", gShadowFleshLightColor, 7.f, 1.f);
             
             Entity_SetActive("BridgeRock_*", true);
			 Entity_SetCollideCharacter("BridgeRock_*", false);
		 }
         
         //-------------------------------------------------------
         
         bool OnCollide_CollapseChaseBridge(const tString &in asParent, const tString &in asChild, int alState)
         {
             Sound_CreateAtEntity("BridgeSmash", "03_03_herberts_hq/shadow_guardian/bridge_collapse_smash", "CollapsedChaseBridge_Part_3");
			 Sound_Play("SoundBridgeDebris",0.5f);
			 
			 Entity_SetActive("ChaseBridge", false);
             Entity_SetActive("CollapsedChaseBridge*", true);
			 Entity_SetCollideCharacter("CollapsedChaseBridge*", false);
             Entity_SetActive("lower_passage_blocker_1", true);
			 
             Prop_SetStaticPhysics("CollapsedChaseBridge_Part_3", false);
			 
			 ParticleSystem_CreateAtEntity("PS_BridgeBreak_1", "smoke_oneshot_grate_break.ps", "CollapsedChaseBridge_Part_1", false);
			 ParticleSystem_CreateAtEntity("PS_BridgeBreak_2", "smoke_oneshot_grate_break.ps", "CollapsedChaseBridge_Part_3", false);
			 
             Map_AddTimer("Timer_CollapseChaseBridge", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CollapseChaseBridge");
			 
			 PlayChaseRunEmote(5, 0.5f);
			 
			 Entity_SetActive("Trigger_PlayLandCutscene", true);
             return false;
         }
         
         //-------------------------------------------------------
         
         void OnTimer_CollapseChaseBridge(const tString &in asTimer)
         {             
             Prop_SetStaticPhysics("CollapsedChaseBridge_Part_" + mlCollapseBridgePart--, false);
             if (mlCollapseBridgePart <= 0) return;
			 
			 FearHandler_SetForcedAddFearRate(0.4f, 2.f, true, -1.f, 0.1f);
             Map_AddTimer("Timer_CollapseChaseBridge", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CollapseChaseBridge");
         }
         
         //-------------------------------------------------------
         
         bool OnTrigger_EnterCollapseArea(const tString &in asParent, const tString &in asChild, int alState)
         {
             if (mlCurrShadowChasePath == 8 && mlCurrShadowChaseStep > 0) return false;
             
             mlCurrShadowChasePath = 8;
             mlCurrShadowChaseStep = 1;
             return false;
         }
         
         //-------------------------------------------------------
		 
		 void OnInteract_SupportBeam(const tString &in asEntity)
		 {
			 if (Map_TimerExists("Timer_BreakSupportBeam")) return;
			 Map_AddTimer("Timer_BreakSupportBeam", 1.5f, "OnTimer_BreakSupportBeam");
			 
			 PlayChaseRunEmote(8, 0.5f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_BreakSupportBeam(const tString &in asTimer)
		 {
			 OnTrigger_BreakSupportBeam("", "", 1);
		 }
		 
		 //-------------------------------------------------------
         
		 bool mbBeamBroken = false;
         bool OnTrigger_BreakSupportBeam(const tString &in asParent, const tString &in asChild, int alState)
         {
			  if (mbBeamBroken) 
				  return false;
			 
			 mbBeamBroken = true;
			 
			 Entity_SetActive("Trigger_BreakSupportBeam", false);
			 
			 Joint_Break("support_beam_push_2_JointHinge_1");
			 Body_AddImpulse("support_beam_push_2_Body_1", cVector3f(-1.f, 1.f, 0.f), false);
			 Entity_SetCollideCharacter("support_beam_push_2", false);
			 
             Player_ChangeStateToNormal();
             
			 ParticleSystem_CreateAtEntity("PS_WallCollapse", "dust_impact_med_oneshot.ps", "Area_SupportBeamPS", false).SetColor(cColor(1,0.898,0.746,0.3f));
			 ParticleSystem_CreateAtEntity("PS_RoofSand", "sand_falling_stream.ps", "Area_RoofSand", false).SetColor(cColor(1,0.898,0.746,0.035f));
             
			 Sound_PlayGui("03_03_herberts_hq/chase_tunnel/chase_tunnel_start", 1.f, eSoundEntryType_World);
			 Sound_PlayGui("03_03_herberts_hq/chase_tunnel/tunnel_quake_loop_louder", 1.f, eSoundEntryType_World);
			 
             Effect_Shake_Start(0.03f, 9.f, 1.f, 1.f);
			 
			 FearHandler_SetForcedAddFearRate(0.4f, 2.f, false, -1.f, 0.1f);
             
             Map_AddTimer("Timer_SpawnCollapseParticles", 3.f, "OnTimer_SpawnCollapseParticles");
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnBreak_SupportBeamPush(const tString &in asEntity)
		 {
			 Entity_SetCollideCharacter(asEntity + "_broken", false);
		 }
         
         //-------------------------------------------------------
         
         void OnTimer_SpawnCollapseParticles(const tString &in asTimer)
         {
			 ParticleSystem_CreateAtEntity("PS_FinalBeamDebris", "dust_impact_simple_oneshot.ps", "Area_FinalBeamDebrisPS", false).SetColor(cColor(1,0.898,0.746,0.3f));
         }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_PortalRoomDoor(const tString &in asEntity)
		 {
			 mbChaseStarted = false;
			 Map_RemoveTimer("Timer_ShadowChaseAdvance");
			 FearHandler_SetPermaFailEnabled(false);
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event B *Bypass the collapse*
         
         /////////////////////////////////////////
		 // Event C *Carried by the Shadow (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event C here.*/
		 
		 int mlShadowCarryStep = 0;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event C here.*/
         
		 bool OnPermaFail_ShadowChaseCarry()
		 {	            
			 Map_RemoveTimer("ShadowChaseAdvance");
			 
			 Music_StopAll(1.5f);
			 
			 Sound_Stop("TunnelQuakeDebris", 0.5);
			 Sound_Stop("TunnelQuakesRule", 0.5);
			 Sound_Stop("RoomQuake", 0.5);
			 Sound_Stop("RoomQuakeDebris", 0.5);
			 Entity_SetActive("Sound_ChaseTunnelQuake_1", false);
			 			
			 bool bTopScenario = msPermaFailRespawnArea == "PermaFail_ShadowCarry_1";			
			 
			 mlCurrShadowChasePath = bTopScenario ? 6 : 5;
			 mlCurrShadowChaseStep = bTopScenario ? 4 : 4;
			 
			 if (bTopScenario)
				 Entity_SetActive("lower_passage_blocker_1", false);
			 else
				 Entity_SetActive("Trigger_AmphoraRoomCollapse", false);
									 
			 Entity_SetActive("Trigger_EnterAmphoraRoom", false);			 
			 Entity_SetActive("Trigger_ExitTrailDeathArea_" + cString_GetNumericSuffixInt(msPermaFailRespawnArea), true);
			 Entity_SetActive("DeathTrailBlocker_*", true);
			  
			 SetupChasePermaFailScenes();			 
			 FearHandler_SetPermaFailRespawnArea(msPermaFailRespawnArea);
			 return true;
		 }
		 
		 //------------------------------------------------------------
		 
		 bool OnPermaFailRespawn_ShadowChaseCarry()
		 {
			 mlPermaFailStage = eHQAPermaFailStage_ShadowChaseFinalCorridor;			 
			 Visibility_SetAreaActive("VisibilityArea_ShadowCarry", false);	
			 
			 Player_FadeNightVisionStrength(1.f, 1.f);		 
			 return true;
		 }
		 
		 //------------------------------------------------------------
		 
		 void OnPermaFailSceneStarted()
		 {			 
			 if (mlPermaFailStage < eHQAPermaFailStage_ShadowChaseCarry)
				 return;
			 
			 cAnimationState@ pState = PlayerBody_GetAnimationState("carried_by_the_shadow_mid_air");
			 if (pState.IsActive() == false)
			 {
				 float fStartPos = 0.f;
				 if (mlShadowChasePermaFailCount == 2) 			fStartPos = 0.1f;
				 else if (mlShadowChasePermaFailCount == 3)		fStartPos = 0.2f;
				 				 
				 PlayerBody_PlayCutsceneAnimation("carried_by_the_shadow_mid_air", false, 0.f, "", 0.8f, fStartPos, true, cVector3f(52.75f, 3.f, 42.75f), cMath_ToRad(135));
				 Map_AddTimer("Timer_DoShadowCarryStep", 0.f, "OnTimer_DoShadowCarryStep");
				 return;
			 }
				 
			 pState.SetSpeed(0.8f);
			 Map_AddTimer("Timer_DoShadowCarryStep", 0.f, "OnTimer_DoShadowCarryStep");
		 }
		 
		 //------------------------------------------------------------
		 
		 void OnPermaFailSceneEnded()
		 {
			 if (mlPermaFailStage < eHQAPermaFailStage_ShadowChaseCarry)
				 return;
			 
			 cAnimationState@ pState = PlayerBody_GetAnimationState("carried_by_the_shadow_mid_air");
			 if (pState.IsActive() == false)
				 return;
				 
			 pState.SetSpeed(0.f);
			 Map_RemoveTimer("Timer_DoShadowCarryStep");
		 }
		 
		 //------------------------------------------------------------
		 
		 void OnTimer_DoShadowCarryStep(const tString &in asTimer)
		 {
			 if (mlShadowCarryStep == 0)
				 Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);	
			 
			 tString sStep = "";
			 tString sArea = "";
			 for (int i = 0; i < 2; i ++)
			 {
				 mlShadowCarryStep++;
				 
				 sArea = "Trigger_ShadowCarry_" + mlShadowCarryStep;
				 sStep = "ShadowCarry_" + (mlShadowCarryStep + 1) + "_";
				 ShadowFlesh_Spawn(sStep + "Flesh_*", "Decal_" + sStep + "Flesh_*", 0.2f, 0.3f, true);
			 }
			 
			 Sound_CreateAtEntity("Sound_" + sStep, "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", sArea, 0.f, false, 0.5f);
				 
			 if (mlShadowCarryStep >= 15)
				 return;
			 
			 Map_AddTimer("Timer_DoShadowCarryStep", cMath_RandRectf(1.1f, 1.2f) * 1.75f, "OnTimer_DoShadowCarryStep");
		 }
		 
         //------------------------------------------------------
         
         bool OnTrigger_ExitTrailDeathArea(const tString &in asParent, const tString &in asChild, int alState)
         {
             if (Map_TimerExists("ShadowChaseAdvance")) 
				 return false;
             
			 Map_AddTimer("Timer_JustDiedFromShadow", 10.f, "");	
             Map_AddTimer("ShadowChaseAdvance", 1.f, "Timer_ShadowChaseAdvance");
			 		 
			 Map_AddTimer("Timer_FadeInTrailLight", 1.f, "OnTimer_FadeInTrailLight");			 
			 Map_AddTimer("Timer_PlayShadowChaseMusic", 1.f, "OnTimer_PlayShadowChaseMusic");
			 
			 Player_FadeNightVisionStrength(1.75f, 2.f);
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_FadeInTrailLight(const tString &in asTimer)
		 {
			 Light_FadeTo("Light_Spot_Trail_" + cString_GetNumericSuffixInt(msPermaFailRespawnArea) + "_*", gShadowFleshLightColor, 20.f, 1.f);
			 Map_AddTimer("Timer_FadeOutTrailLight", 3.f, "OnTimer_FadeOutTrailLight");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_FadeOutTrailLight(const tString &in asTimer)
		 {
			  Light_FadeTo("Light_Spot_Trail_" + cString_GetNumericSuffixInt(msPermaFailRespawnArea) + "_*", cColor(0), 15.f, 1.f);
		 }
		 
         //-------------------------------------------------------
	 
		 //} END Event C *Carried by the Shadow (PERMAFAIL)*
		 
		 /////////////////////////////////////////
		 // Event D *Wake up in final corridor (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event D here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event D here.*/
		 
		 bool OnPermaFail_ShadowChaseFinalCorridor()
		 {
			 Map_RemoveTimer("ShadowChaseAdvance");
			 
			 Music_StopAll(1.5f);
			 
			 Sound_Stop("TunnelQuakeDebris", 0.5);
			 Sound_Stop("TunnelQuakesRule", 0.5);
			 Sound_Stop("RoomQuake", 0.5);
			 Sound_Stop("RoomQuakeDebris", 0.5);
			 
			 Sound_StopGui("03_03_herberts_hq/chase_tunnel/chase_tunnel_start", 0.5f);
			 Sound_StopGui("03_03_herberts_hq/chase_tunnel/tunnel_quake_loop_louder", 0.5f);
			 
			 Entity_SetActive("Sound_ChaseTunnelQuake_1", false);
			 Entity_SetActive("lower_passage_blocker_2", true);
			 Entity_SetActive("support_beam_push_2", false);
			 
			 ParticleSystem_SetVisible("PS_RoofSand", false);
			 
			 SetupChasePermaFailScenes();			 
			 FearHandler_SetPermaFailRespawnArea("PermaFail_FinalCorridor");
			 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnPermaFailRespawn_ShadowChaseFinalCorridor()
		 {			 
			 mlPermaFailStage = eHQAPermaFailStage_None;
			 
			 for (int i = 10; i < 16; ++i)
			 {
				 tString sFlesh = "ShadowChase_Path_8_StepArea_" + i + "_*";
				 ShadowFlesh_Spawn(sFlesh, "Decal_ShadowChase_Path_8_StepArea_" + i + "_*", 0.1f, 0.2f, false, 0.f, 0.f);
				 Entity_AddCollideCallback("player", sFlesh, "OnCollide_Player_ShadowFlesh");
			 }
			 
			 Entity_SetActive("ShadowChase_Path_8_StepArea_16_Flesh_*", false);
			 Decal_SetDynamicVisible("Decal_ShadowChase_Path_8_StepArea_16_Flesh_*", false);
			 
			 Sound_Stop("TunnelQuakeDebris", 0.5);
			 Sound_Stop("TunnelQuakesRule", 0.5);
			 
			 Sound_StopGui("03_03_herberts_hq/chase_tunnel/chase_tunnel_start", 0.5f);
			 Sound_StopGui("03_03_herberts_hq/chase_tunnel/tunnel_quake_loop_louder", 0.5f);
			 
			 ParticleSystem_SetVisible("PS_RoofSand", false);
			 
			 Visibility_SetAreaActive("VisibilityArea_ShadowCarry", true);			 
			 Player_FadeNightVisionStrength(1.f, 1.f);
			 
			 Map_AddTimer("Timer_PlayFinalCorridorShadowScream", 27.f, "OnTimer_PlayFinalCorridorShadowScream");
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayFinalCorridorShadowScream(const tString &in asTimer)
		 {
			 Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);	
			 Effect_Shake_Start(0.001f, 6.f, 1.f, 1.f);
			 FearHandler_SetForcedAddFearRate(0.2f, 5.f, false);
		 }
		 
         //-------------------------------------------------------
	 
		 //} END Event D *Wake up in final corridor (PERMAFAIL)*
	 
	 //} END SCENE 2
	 
	 //////////
	 //AUDIO
	 //////////
	 
	 //-------------------------------------------------------
	
	 bool OnTrigger_TombMusic(const tString &in asParent, const tString &in asChild, int alState)
	 {
		 if (alState == 1) return true;
		 
		 if (Entity_PlayerIsInFront(asParent))
			 Music_Stop(4.f, eMusicPrio_BgAmb);
		 else
			 Music_PlayExt("A2_3_3_Tomb_Ambience.ogg", true, 0.1f, 1.0f, 4.f, 0.0f, eMusicPrio_BgAmb, true);
		 return true;
	 }
	 
	 //-------------------------------------------------------
	 
	 bool QuakeSound(const tString &in asParent, const tString &in asChild, int alState)
	 {
		 if (alState == 1)
		 {
			 if (Map_TimerExists("ShadowChaseAdvance"))
				 Sound_CreateAtEntity("TunnelQuakeDebris", "03_03_herberts_hq/chase_tunnel/chase_tunnel_debris", "player");
			 if (Map_TimerExists("ShadowChaseAdvance"))
				 Sound_CreateAtEntity("TunnelQuakesRule", "03_03_herberts_hq/chase_tunnel/tunnel_quake_loop", "player");
				 return true;
		 }
		 else
		 {
			 Sound_Stop("TunnelQuakeDebris", 0.5);
			 Sound_Stop("TunnelQuakesRule", 0.5);
			 return true;
		 }
	 }
	 
	 //-------------------------------------------------------
	 
	 bool RoomQuake(const tString &in asParent, const tString &in asChild, int alState)
	 {
		 if (alState == 1)
		 {
			 if (Map_TimerExists("ShadowChaseAdvance"))
				 Sound_CreateAtEntity("RoomQuake", "03_03_herberts_hq/chase_tunnel/room_quake_loop", "player");
			 if (Map_TimerExists("ShadowChaseAdvance"))
				 Sound_CreateAtEntity("RoomQuakeDebris", "03_03_herberts_hq/chase_tunnel/chase_room_debris", "player");
				 return true;
		 }
		 else
		 {
			 Sound_Stop("RoomQuake", 0.5);
			 Sound_Stop("RoomQuakeDebris", 0.5);
			 return true;
		 }
	 }
	 
	 //-------------------------------------------------------
}