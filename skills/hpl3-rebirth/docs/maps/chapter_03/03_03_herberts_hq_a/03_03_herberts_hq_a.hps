		 bool OnTrigger_Player_StartAmuletTracking(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (FearHandler_GetIsPermaFailing()) 
				 return true;
			 
			 Amulet_StartTracking(true, "", -1.f);
			 //Voice_PlayDelayed("Dialogue_Amulet", 2.f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_PlayShadowSmellDialogue(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Voice_PlayDelayed("Dialogue_BeforeShadow", 0.5f);
			 return false;
		 }
	 
		 //-------------------------------------------------------
	 
