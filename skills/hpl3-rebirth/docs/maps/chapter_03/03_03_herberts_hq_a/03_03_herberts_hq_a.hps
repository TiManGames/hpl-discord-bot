         /////////////////////////////////////////
		 // Event E *Open DIMENSIONAL RIFT #1*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event E here.*/
		 
		 bool mbFirstRiftOpened = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event E here.*/
		 
		 bool OnTrigger_Player_StartSeqAlertShadow(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Seq_AlertShadow("");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_DoLightningFlash(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_AddTimer("Timer_DoDarkWorldLightning", 1.f, "OnTimer_DoDarkWorldLightning");
			 return false;
		 }
		
		 //-------------------------------------------------------
		
		 void OnTimer_DoDarkWorldLightning(const tString &in asTimer)
		 {
			 if (SequenceStates_IsActive("Seq_AlertShadow") == false &&
				 Entity_GetCollide("player", "Trigger_DoLightningFlash"))
			 {
				 Seq_DarkWorldLightning("");
				 return;
			 }
			 
			 Map_AddTimer("Timer_DoDarkWorldLightning", 10.f, "OnTimer_DoDarkWorldLightning");
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataDarkWorldLightning;	
		 void Seq_DarkWorldLightning(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_DarkWorldLightning", mSeqDataDarkWorldLightning);
			 if (Sequence_DoStepAndWait(0.1f))
			 {
				 Sound_CreateAtEntity("Sound_Lightning", "01_02_caves/events/darkworld_thunder", "player");
			 }
			 else if (Sequence_DoStepAndWait(0.06f))
			 {
				 Map_Preset_Fade("Preset_LightningFull", 0.1f);
				 Light_FadeBrightnessTo("Light_Spot_lighting_aaron_righ*", 150.f, 0.1f, eEasing_SineIn);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Map_Preset_Fade("Preset_Default", 1.f);
				 Light_FadeBrightnessTo("Light_Spot_lighting_aaron_righ*", 0.f, 1.f, eEasing_SineOut);
				 Map_AddTimer("Timer_DoDarkWorldLightning", cMath_RandRectf(15.f, 25.f), "OnTimer_DoDarkWorldLightning");
			 }
			 Sequence_End();
		 }
		
		//-------------------------------------------------------
		 
		 bool OnTrigger_Player_FallPermafail(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1 || FearHandler_GetIsPermaFailing())
				 return true;
			
			 Voice_StopAll();
			 Music_StopAll(1.f);
			 
			 SequenceStates_Stop("Seq_AlertShadow");
			 Light_SetBrightness("Light_ShadowScare", 0.f);
			
			 FearHandler_TriggerPermaFail(false, "fall", true);			
			 return true;
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event E *Open DIMENSIONAL RIFT #1*
         
         /////////////////////////////////////////
		 // Event F *The Shadow gets alerted*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event F here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functionsthat are only used in Scene 1, Event F here.*/
		 
		 cSequenceStatesData mSequenceAlertShadow;
         void Seq_AlertShadow(const tString &in asTimer)
         {
             Sequence_Begin("Seq_AlertShadow", mSequenceAlertShadow);
             Sequence_Wait(0.5f);
			 if (Sequence_DoStepAndWait(0.5f))
             {
				 Sound_Play("Sound_ShadowAppear", 0.0f);
             }
			 else if (Sequence_DoStepAndWait(3.f))
			 {
				 FearHandler_SetForcedAddFearRate(0.4f, 4.f, false, -1.f, 0.1f, 0.5f);
				 
				 Light_FadeBrightnessTo("Light_ShadowScare", 2.f, 1.f, eEasing_CubicIn);
				 
				 Effect_ImageTrail_Start(1.f, 2.f, 1.5f, 1.f);
				 Effect_Shake_Start(0.02f, 6.f, 1.f, 1.f);	
			 }
			 else if (Sequence_DoStepAndWait(1.5f))
			 {
				 Light_FadeBrightnessTo("Light_ShadowScare", 0.f, 1.5f, eEasing_CubicOut);
			 }
			 else if (Sequence_DoStepAndWait(10.f))
			 {
				 Music_Play("A2_3_3_Guardian_Warning.ogg", 0.6f, false, eMusicPrio_BigEvent);
				 Music_Stop(5.f, eMusicPrio_BgAmb);
			 }
             Sequence_End();
         }
		 
		 //-------------------------------------------------------
	 
		 //} END Event F *The Shadow gets alerterd*
         
         /////////////////////////////////////////
		 // Event G *SHADOW FLESH appears*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event G here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event G here.*/
         
         bool OnTrigger_AlertFleshAppear(const tString &in asParent, const tString &in asChild, int alState)
         {
			 Entity_SetActive("Trigger_PlayFleshDialogue", false);
             Seq_FleshAppear("");
			 
			 if (Oil_GetCount("HerbertOil") > 0)
				 Entity_SetActive("oil_flask_herbert_1", false);
             return false;
         }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSequenceFleshAppear;
         void Seq_FleshAppear(const tString &in asTimer)
         {
             Sequence_Begin("Seq_FleshAppear", mSequenceFleshAppear);
             Sequence_Wait(2.f);
			 if (Sequence_DoStepAndWait(0.5f))
             {
				 ShadowFlesh_Spawn("ShadowFlesh_Alert_*", "Decal_ShadowFlesh_Alert_*", 1.5f, 3.f, true);
                 Effect_Shake_Start(0.015f, 6.f, 1.f, 1.f);
				 
				 Sound_PlayGui("creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", 1.f, eSoundEntryType_Gui);	
             }
			 else if (Sequence_DoStepAndWait(1.5f))
			 {
				 FearHandler_SetForcedAddFearRate(0.5f, 6.f, true, -1.f, 0.1f);
				 Entity_SetActive("FearScaryObject_ShadowFlesh_Tuareg_*", true);
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 Prop_SetHealth("PotShadowBreak_8", 0.f);
				 Music_Play("A2_3_3_Shadow_Guardian_Slime.ogg", 0.6f, false, eMusicPrio_BigEvent);
			 }
             Sequence_End();
         }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_PlayFleshDialogue(const tString &in asEntity, int alState)
		 {
			 Voice_Play("Dialogue_ExamineShadow");
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event G *SHADOW FLESH appears*
         
         /////////////////////////////////////////
		 // Event H *Open DIMENSIONAL RIFT #2*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event H here.*/
		 
