	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	int mlDarkWorldWhisperAreaCount = 0;
	int mlPermaFailStage = eHQAPermaFailStage_CheiftainTomb;
	tString msPermaFailRespawnArea = "Area_PermaFail_Start_*";
 
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
    
    // TEMP! Seperate area for this?
    bool OnCollide_Player_ShadowFlesh(const tString &in asParent, const tString &in asChild, int alState)
    {
        if (alState == -1) return true;
		if (Player_GetCurrentStateName() == "State_CutsceneAnimation") return true;
        if (Map_TimeHasPassed("Timer_ShadowFleshDamage", 1.f) == false) return true;
				
        Player_GiveDamage(0.1f, 0.2f, eDamageType_Guardian, asParent);
        return cMath_RandRectl(0, 1) == 1;
    }
     
	//-------------------------------------------------------
	
	void OnTimer_PlayDialogue(const tString &in asTimer)
	{
		Voice_PlayWhenPossible(asTimer, "", 30.f, 2.f);
	}
		
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SetWhispering(const tString &in asParent, const tString &in asChild, int alState)
	{
		Pregnancy_SetWhispering(alState == -1 && Entity_PlayerIsInFront(asParent));
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_SetPermaFailStage(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState!=1) return true;
		if (FearHandler_GetIsPermaFailing()) return true;
		
		int lId = cString_GetNumericSuffixInt(asParent);
		if (lId == 1)
		{
			FearHandler_SetPermaFailEnabled(true);
			mlPermaFailStage = eHQAPermaFailStage_CheiftainTomb;
		}
		else if (lId == 6)
		{
			mlPermaFailStage = eHQAPermaFailStage_ShadowChaseFinalCorridor;
		}
			
		msPermaFailRespawnArea = Entity_GetVarString(asParent, "");	
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_PlayDarkWorldWhispers(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 && mlDarkWorldWhisperAreaCount <= 0)
			DarkWorldWhispers_Play(2);
		
		mlDarkWorldWhisperAreaCount += alState;
		
		if (mlDarkWorldWhisperAreaCount <= 0)
			DarkWorldWhispers_Stop();
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnInteract_ArchaeologyLamp(const tString &in asEntity)
	{
		Entity_AddImpulse(asEntity, cVector3f(0.5f, 0.f, 0.f), true, true);
	}
	
