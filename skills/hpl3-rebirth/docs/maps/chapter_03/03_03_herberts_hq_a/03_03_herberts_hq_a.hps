enum eHQAPermaFailStage
{
	eHQAPermaFailStage_None,
	eHQAPermaFailStage_CheiftainTomb,
	eHQAPermaFailStage_ShadowChaseCarry,
	eHQAPermaFailStage_ShadowChaseFinalCorridor,
	eHQAPermaFailStage_LoadHQB,
}

//------------------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("03-03-herberts-hq-a");
		
		// Set up color grading etc.
		Map_Preset_SetupDirLight("Preset_Default", false, cColor(0.269,0.339,0.35,1), 0.f, cVector3f(0.693, -0.687, 0.219), cColor(0.222,0.289,0.299,1), cColor(0.101,0.171,0.182,1));
		Map_Preset_SetupColorGrading("Preset_Default", "grading_default.dds");
		Map_Preset_SetupBloom("Preset_Default", 128.f, 0.75f, 0.5f, cColor(1.f));
		
		Map_Preset_SetupDirLight("Preset_LightningFull", true, cColor(1,1.5,2,1), 5, cVector3f(0.693, -0.687, 0.219), cColor(0.092,0.069,0.069,1), cColor(0.092,0.069,0.069,1));
		Map_Preset_SetupColorGrading("Preset_LightningFull", "grading_lightning_flash.dds");
		Map_Preset_SetupBloom("Preset_LightningFull", 4.f, 0.02f, 1.5f, cColor(1.f, 2.f, 2.f, 1.f));
		
		Pregnancy_SetStage(ePregStage_Stage2);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_TTH_BeforeName);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingMonster);
		Player_SetAllowCheckBaby(true);
		FearHandler_SetWhisperStage(eFearWhisperStage_HQAToVitaeStation);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(1);
		StruggleFlashHandler_SetProgression(1);
		
		Player_SetAutoTeleportWhenBelowAltitude(-60.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		///////////////
		// Preload particles
		ParticleSystem_Preload("dust_impact_simple_oneshot.ps");
		ParticleSystem_Preload("shadow_locator.ps");
		ParticleSystem_Preload("dust_roof_break.ps");
		ParticleSystem_Preload("smoke_oneshot_grate_break.ps");
		ParticleSystem_Preload("dust_impact_med_oneshot.ps");	
		ParticleSystem_Preload("sand_falling_stream.ps");		

		//////////////
		// Preload screen effects
		Material_Preload("shadow_death_screen.mat");
		
		//////////////
		// Preload sounds
		//Sound_PreloadProject("03_03_herberts_hq");
		//Sound_PreloadGroup("creatures/vocalisations/creature/shadow_guardian", true);
		Sound_PreloadGroup("level_entity_shared/portal", true);		
		Sound_PreloadEvent("03_03_herberts_hq/chase_tunnel/room_quake_loop");
		Sound_PreloadEvent("03_03_herberts_hq/chase_tunnel/chase_room_debris");
		Sound_PreloadEvent("03_03_herberts_hq/chase_tunnel/chase_tunnel_debris");
		Sound_PreloadEvent("03_03_herberts_hq/chase_tunnel/tunnel_quake_loop");
		Sound_PreloadEvent("03_03_herberts_hq/shadow_guardian/chase_room_collapse");
		Sound_PreloadEvent("level_entity_shared/fire/fire_ignite/wall_torch_ignite");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(8);
		
		// Any general setup of script / entities
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
            if (ItemType_GetCountInInventory("Lantern") < 1)
            {
                Item_AddToInventory("Lantern");                    
                Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 4);
            }
			
			if (ItemType_GetCountInInventory("HerbertOil") < 1)
            {
                Item_AddToInventory("HerbertOil");                    
            }
            
            //if (ItemType_GetCountInInventory("CurseMedallion") < 1)
              //  Item_AddToInventory("CurseMedallion");
				
            if (ItemType_GetCountInInventory("Radio") < 1)
                Item_AddToInventory("Radio");
				
			if (ItemType_GetCountInInventory("Matchbook") < 1)
			{
				Item_AddToInventory("Matchbook");
				Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 2);
			}
			
			if (ItemType_GetCountInInventory("CurseMedallion") < 1)
			{
				Item_AddToInventory("CurseMedallion");
			}
			
			if (ItemType_GetCountInInventory("Orb") < 1)
			{
				Item_AddToInventory("Orb");
			}
		} 
		
		Player_SetMapDeepShadow(0.1f);

		FearHandler_SetActive(true);
		
		Pregnancy_SetBabyKicksEnabled(true);
		
        ///////////////////////////////
        // Setup chase
		ParticleSystem_SetActive("PS_DoorBreak", false);
		ParticleSystem_SetVisible("PS_DoorBreak", false);
        Entity_AddCollideCallback("player", "ShadowFlesh_*", "OnCollide_Player_ShadowFlesh");
		
		// TEMP! Disable player collision on chase flesh
		// TODO: Place flesh better so this isn't an issue.
		array<iLuxEntity@> vEnts;
		Map_GetEntityArray("ShadowChase_*", vEnts, eLuxEntityType_Prop);
		iPhysicsBody @pBody = null;
		for (int i = 0; i < vEnts.size(); i++)
		{
			@pBody = vEnts[i].GetBody(0);			
			if (pBody is null) 
				continue;
			
			pBody.SetCollideCharacter(false);
			pBody.SetCollide(false);
		}
		
		ShadowFlesh_SetupDecals("Decal_Shadow*");
		
		for (int lPath = 1; lPath < 13; ++lPath)
		{
			tString sArea = "ShadowChase_Path_" + lPath + "_StepArea_";
			for (int lStep = 1; Entity_Exists(sArea + lStep); ++lStep)
			{
				ShadowFlesh_AddGroup(sArea + lStep + "_Flesh_*", "Decal_" + sArea + lStep + "_Flesh_*");
			}
		}
		
		/////////////////
		// Start wake up sequence
		if (cLux_ScriptDebugOn() == false)
			Seq_WakeUpPregProgress("");
	}
	
	////////////////////////////
	// Run when entering map
	void OnEnter()
	{		
		PlayerBody_SetActive(true);
		FearHandler_SetPermaFailEnabled(true);
        Heat_SetActive(false);
		
		Player_SetRunSpeedMul(1.f);
		Player_SetNightVisionBrightness(2.5f);
		
		Achievement_Unlock(eAchievement_Somnambulist);
			
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Pregnancy_SetBarksActive(true);
		Player_SetHealthSpeedMulActive(true);
		Player_SetFallDamageActive(true);
		FearHandler_SetWhispersActive(true);
		Player_SetNightVisionIgnoreFearArea(false);
		Pregnancy_SetBabyKicksEnabled(true);
		
		///////////////////
		// Clear permafails
		FearHandler_ClearPermaFailScenes();
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail(const tString &in asSource)
	{
		FearHandler_ClearPermaFailScenes();
		
		Light_SetBrightness("Light_Spot_TuaregDoor", 0.f);
		
		switch (mlPermaFailStage)
		{
			case eHQAPermaFailStage_CheiftainTomb:				return OnPermaFail_ChieftainTomb();
			case eHQAPermaFailStage_ShadowChaseCarry:			return OnPermaFail_ShadowChaseCarry();
			case eHQAPermaFailStage_ShadowChaseFinalCorridor:	return OnPermaFail_ShadowChaseFinalCorridor();
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFailRespawn()
	{
		switch (mlPermaFailStage)
		{
			case eHQAPermaFailStage_CheiftainTomb:				return OnPermaFailRespawn_ChieftainTomb();
			case eHQAPermaFailStage_ShadowChaseCarry:			return OnPermaFailRespawn_ShadowChaseCarry();
			case eHQAPermaFailStage_ShadowChaseFinalCorridor:	return OnPermaFailRespawn_ShadowChaseFinalCorridor();
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	array<int> mvUnplayedGenericPermaFails = { 1, 2 };	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 3; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);
		
		tString sAreaBase = "Area_PermaFail_Generic";		
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_1", sAreaBase + "_1_End_1", 3.f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_2", sAreaBase + "_1_End_2", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_3", sAreaBase + "_1_End_3", 1.5f, 2.25f, true);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_2", sAreaBase + "_2_End_2", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_3", sAreaBase + "_2_End_3", 3.f, 2.25f, true);
				break;
		}
	}
	
