	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 1 *TRY TO ESCAPE THE TOMB*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 1 here.*/		
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 1 here.*/
		
		//-------------------------------------------------------
		
		//} END General	
		
		 /////////////////////////////////////////
		 // Event A *Wake up, pregnancy progressed*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event A here.*/
		 
		 int mlWakeUpBlurId = -1;
		 int mlWakeUpMoveCount = 0;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event A here.*/
		 
		 cSequenceStatesData mSequenceWakeUpPregProgressData;
		 void Seq_WakeUpPregProgress(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_WakeUpPregProgress", mSequenceWakeUpPregProgressData);
			 if (Sequence_DoStepAndWait(1.f))
			 {
				 Player_SetNightVisionEnabled(false);
				 Player_SetActive(false);
				 
				 Effect_Fade_Out(0.f);
				 //Sound_CreateAtEntity("Sound_WakeSting", "03_03_herberts_hq/events/tasi_wake", "player");
				 mlWakeUpBlurId = Effect_DoF_Start(0.f, 0.f, 0.025f, 0.f);
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				 Player_SetActive(true);
				 PlayerBody_PlayCutsceneAtEntity("wake_up_see_pregnancy", "Area_WakeUpAnim", true, 0.f, "", 0.f);
				 PlayerBody_SetCutsceneMaxPitch(10.f);
				 PlayerBody_SetCutsceneMaxYaw(10.f);
			 }
			 else if (Sequence_DoStepAndWait(3.f))
			 {
				 Effect_Fade_In(4.f);		 
			 }
			 else if (Sequence_DoStepAndWait(3.f))
			 {
				 PlayerBody_PlayCutsceneAtEntity("wake_up_see_pregnancy", "Area_WakeUpAnim", false, 0.f);
				 PlayerBody_SetCutsceneMaxPitch(10.f);
				 PlayerBody_SetCutsceneMaxYaw(10.f);
				 Music_Play("A2_3_3_Tasi_Wake.ogg", 0.3f, false, eMusicPrio_MinorEvent);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Effect_DoF_FadeFocus(mlWakeUpBlurId, 0.f, 0.2f, 1.f);
			 }
			 else if (Sequence_DoStepAndWait(19.5f))
			 {
				 Voice_PlayWhenPossible("Dialogue_Intro");
			 }
			 else if (Sequence_DoStepAndWait(6.f))
			 {
				 Effect_DoF_FadeOut(mlWakeUpBlurId, 1.f);
			 }
			 else if (Sequence_DoStepAndWait(7.f))
			 {
				 Player_Disorient(4.f, false);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Player_SetMoveSpeedMul(0.6f);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_FadeMoveSpeed(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 float fMul = Entity_GetVarFloat(asParent, "");
			 
			 int lId = cString_GetNumericSuffixInt(asParent);
			 if (lId == 1)
			 {
				 Map_AddTimer("Timer_FadePregnancyMoveMul", 1.f, "OnTimer_FadePregnancyMoveMul");
				 Entity_SetActive(asParent, false);
			 }
			 else
			 {
				 Map_RemoveTimer("Timer_FadePregnancyMoveMul");
				 Player_FadeMoveSpeedMulTo(fMul, 10.f);	
			 }		 
			 
			 Player_SetNightVisionEnabled(true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_FadePregnancyMoveMul(const tString &in asTimer)
		 {
			 if (Player_GetSpeed() > 0)
				 ++mlWakeUpMoveCount;
			 
			 if (mlWakeUpMoveCount >= 20)
			 {
				 Map_RemoveTimer(asTimer);
				 Player_FadeMoveSpeedMulTo(0.75f, 10.f);
				 return;
			 }
			 
			 Map_RestartCurrentTimer(1.f);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Wake up, pregnancy progressed*
	 
		 /////////////////////////////////////////
		 // Event B *Tasi speaks an intro*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event B here.*/
		 
		 bool mbDreamIntroCommentPlayed = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event B here.*/
		 
		 void OnInteract_SmallSlabStone(const tString &in asEntity)
		 {
			 if (mbDreamIntroCommentPlayed) return;
			 
			 mbDreamIntroCommentPlayed = true;
			 Map_AddTimer("Dialogue_IntroComment_Dream", 1.0f, "OnTimer_PlayDialogue");
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *Tasi speaks an intro*
         
         /////////////////////////////////////////
		 // Event C *Find a way out*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event C here.*/
		 
		 //bool mbTombDialoguePlayed = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event C here.*/
		 
		 bool OnTrigger_Player_DoStumble(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 cVector3f vTriggerFwd = Map_GetEntity("Trigger_DoStumble").GetMatrix().GetTranspose().GetForward();
			 if (cMath_Vector3Dot(Player_GetForward(), vTriggerFwd) < 0.1f)
				 return false;
				 
			 Voice_StopAll();
			 
			 Item_PutAway(eItemHandlerHand_Left);
			 Item_PutAway(eItemHandlerHand_Right);
			 Player_SetCrouching(false, true, true);
			 Player_ChangeStateToNormal();
			 
			 PlayerBody_PlayCutsceneAtEntity("herberts_hq_a_stumble_ls", "Area_StumbleAnim", false, 1.2f);
			 
			 Player_Disorient(1.f, false);
			 
			 Map_AddTimer("Dialogue_NoticeWeight", 0.5f, "OnTimer_PlayDialogue");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_PlayTombDialogue(const tString &in asEntity, int alState)
		 {
			 /*if (mbTombDialoguePlayed || alState == -1 || 
				 cLux_GetLightLevelAtPos(Map_GetEntity(asEntity).GetPosition(), null, 0.5f) < 0.2f) 
				 return;
			 
			 Voice_StopAll();
			 Voice_Play("Dialogue_IntroComment_1");
			 mbTombDialoguePlayed = true;
			 
			 Entity_SetActive("Trigger_PlayTombDialogue_*", false);*/
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_SlabCreak(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1) return true;
			 Sound_CreateAtEntity("Sound_SlabCreak", "03_03_herberts_hq/level/slab_stress", asParent);
			 ParticleSystem_CreateAtEntity("PS_SlabCreak", "dust_impact_simple_oneshot.ps", asParent, false).SetBrightness(0.35f);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnBreak_Slab(const tString &in asEntity)
		 {
			 Entity_SetActive("TombSlab", false);
			 Entity_SetActive("Trigger_SlabCreak", false);
			 Sound_CreateAtEntity("Sound_SlabDebris", "03_03_herberts_hq/level/slab_debris", "Sound_SlabDebris");
			 
			 Entity_AddCollideCallback("Trigger_LimitEntitiesInLadderHole", "TombSlab_broken", "OnTrigger_LimitEntitiesInLadderHole");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_PlayLadderDialogue(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1 || Player_GetCurrentStateName() != "State_Ladder") return true;	 
			 
			 Map_AddTimer("Timer_PlayLadderDialogue", 1.5f, "OnTimer_PlayLadderDialogue");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayLadderDialogue(const tString &in asTimer)
		 {
			 Voice_StopAll();
			 Voice_Play("Dialogue_Ladder");		
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_LadderHole(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1 && asChild == "SlabStone_12")
			 {
				 Entity_SetActive("BlockBox_LadderHole", false);
				 return false;
			 }
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_QueensGraveLadder(const tString &in asEntity, int alState)
		 {
			 if (alState == -1) return;
			 
			 Voice_StopAll();
			 Voice_Play(Entity_GetVarString(asEntity, ""));
			 Entity_SetActive(asEntity, false);
			 
			 //Sketchbook_AddSketchImageByPage("tth_hint_ladder", "tth_hqa");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnBreak_Pottery(const tString &in asEntity)
		 {
			 Entity_AddCollideCallback("Trigger_LimitEntitiesInLadderHole", asEntity + "_broken", "OnTrigger_LimitEntitiesInLadderHole");
		 }
		 
		 //-------------------------------------------------------
		 
		 int mlLadderHoleBodyCount = 0;
		 bool OnTrigger_LimitEntitiesInLadderHole(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (mlLadderHoleBodyCount > 4 && Entity_PlayerIsInFront(asParent) == false)
			 {
				 Entity_SetActive(asChild, false);
				 return true;
			 }
			 
			 mlLadderHoleBodyCount += alState;
			 return true;
		 }
		 
		//-------------------------------------------------------
	 
