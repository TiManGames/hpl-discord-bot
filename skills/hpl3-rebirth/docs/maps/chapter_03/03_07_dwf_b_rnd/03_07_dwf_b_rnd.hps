		//-------------------------------------------------------
		
		bool mbWraithChaseOutSetup = false;
		bool mbWraithChaseOutStarted = false;
		bool mbWraithChaseOutDoorClosed = false;
		
		//-------------------------------------------------------
		
		void SetupWraithChaseOut()
		{
			if (mbWraithChaseOutSetup) return;
			mbWraithChaseOutSetup = true;
			
			Entity_SetActive("Trigger_WraithChaseOut2", true);
			Entity_SetActive("Wraith_PushOutOfTortureRoom", true);
			Agent_SetSensesActive("Wraith_PushOutOfTortureRoom", false);
			Wraith_SetSpotlightSoundVolumeMul("Wraith_PushOutOfTortureRoom", 0.0f);
			
			Entity_SetActive("Trigger_ChaseOutWraithDisappear", true);
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_RnDWraithChaseOutButton(const tString &in asEntity, int alState)
		{
			OnConnectionStateChange_RnDDoorButton(asEntity, alState);
			if (mbWraithChaseOutSetup && mbWraithChaseOutStarted == false)
			{
				mbWraithChaseOutStarted = true;
				Map_AddTimer("Timer_StartWraithChaseOut", 1.0f, "OnTimer_StartWraithChaseOut");
				Map_AddTimer("Timer_ActivateWraithChaseOutSenses", 3.0f, "OnTimer_ActivateWraithChaseOutSenses");
				FearHandler_SetPermaFailRespawnArea("PermaFail_ShuttleStationCorridor");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartWraithChaseOut(const tString &in asTimer)
		{
			Wraith_SetSpotlightSoundVolumeMul("Wraith_PushOutOfTortureRoom", 1.0f);
			Wraith_CommandSearch_Execute("Wraith_PushOutOfTortureRoom", Map_GetEntity("Target_WraithChaseoutSearch").GetPosition(), true, "");
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_PushOutOfTortureRoom");
			Wraith_ModeWraithPatrol_AddNode("Wraith_PushOutOfTortureRoom", "PathNode_ChaseOutTarget");
			Wraith_ModeWraithPatrol_Setup("Wraith_PushOutOfTortureRoom", false, false);
			Wraith_Mode_Set("Wraith_PushOutOfTortureRoom", eWraithMode_WraithPatrol, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateWraithChaseOutSenses(const tString &in asTimer)
		{
			Agent_SetSensesActive("Wraith_PushOutOfTortureRoom", true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Wraith_ChaseOutWraithDisappear(const tString &in asParent, const tString &in asChild, int alState)
		{
			Wraith_CommandDisappear_Execute("Wraith_PushOutOfTortureRoom", true);
			return false;
		}
		
