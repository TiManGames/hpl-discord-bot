		/////////////////////////////////////////
		// Event A *Restore power to the torture chamber*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlRndEmitterId = 0;
		int mlChangeEmitterRadius1 = 0;
		int mlChangeEmitterRadius2 = 0;
		int mlChangeEmitterRadius3 = 0;
		float mfCustomRndEmitterRadius = -1;
		float mfCustomRndExtenderRadius = -1;
		bool mbTortureChamberActive = false;
		bool mbTortureChamberLocked = false;
		bool mbTortureBoothOpen = false;
		int mlTortureChamberActivationStage = 0;
		bool mbRndEmitterFlickerOn = false;
		cColor mRndEmitterColorOrig;

		//-------------------------------------------------------
		
		void OnTimer_FlickerRndEmitter(const tString &in asTimer)
		{
			mbRndEmitterFlickerOn = !mbRndEmitterFlickerOn;
			
			float fEffectsAlpha = mbRndEmitterFlickerOn ? 1.0f : cMath_RandRectf(0.1, 0.8);
			float fFadeTime = cMath_RandRectf(0.05, 0.15);
			
			Entity_FadeEffectBaseColor("PowerEmitter_RnD", mRndEmitterColorOrig * fEffectsAlpha, fFadeTime);
			
			if (mbRndEmitterFlickerOn == false) Sound_CreateAtEntity("Flicker", "03_07_DW_theatre/UI/map_board_flicker", "PowerEmitter_RnD", 0, false, 0.5, 6, 12);
			
			array<iLight@> vEmitterLights;
			Map_GetLightArray("Light_Transmitter_*", vEmitterLights);
			for (int i = 0; i < vEmitterLights.size(); ++i)
			{
				iLight@ pLight = vEmitterLights[i];
				if (pLight is null) continue;
				
				if (mbRndEmitterFlickerOn) pLight.FadeBrightnessToDefault(fFadeTime);
				else pLight.FadeBrightnessTo(pLight.GetDefaultBrightness() * fEffectsAlpha, fFadeTime);
			}
			
			float fNext = mbRndEmitterFlickerOn ? cMath_RandRectf(0.1, 0.4) : cMath_RandRectf(0.02, 0.05);
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceRndEmitterPulse;
		void Seq_RndEmitterPulse(const tString &in asTimer)
		{
			float fFlashAlpha = 3.5;
			
			Sequence_Begin("Seq_RndEmitterPulse", mSequenceRndEmitterPulse);
			if (Sequence_DoStepAndWait(0.1))
			{
				Map_RemoveTimer("Timer_FlickerRndEmitter");
				
				Entity_FadeEffectBaseColor("PowerEmitter_RnD", mRndEmitterColorOrig * fFlashAlpha, 0.08);
				
				array<iLight@> vEmitterLights;
				Map_GetLightArray("Light_Transmitter_*", vEmitterLights);
				for (int i = 0; i < vEmitterLights.size(); ++i)
				{
					iLight@ pLight = vEmitterLights[i];
					if (pLight is null) continue;
					pLight.FadeBrightnessTo(pLight.GetDefaultBrightness() * fFlashAlpha, 0.08);
				}
				
				Sound_CreateAtEntity("EmitterPulse", "02_04_living_quarters/scare_events/light_scare/spark_scare", "PowerEmitter_RnD", 0, false, 0.5, 5, 14);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Entity_FadeEffectBaseColor("PowerEmitter_RnD", mRndEmitterColorOrig * 0.4, 0.7);
				
				array<iLight@> vEmitterLights;
				Map_GetLightArray("Light_Transmitter_*", vEmitterLights);
				for (int i = 0; i < vEmitterLights.size(); ++i)
				{
					iLight@ pLight = vEmitterLights[i];
					if (pLight is null) continue;
					pLight.FadeBrightnessTo(pLight.GetDefaultBrightness() * 0.4, 0.7);
				}
				
				mbRndEmitterFlickerOn = false;
				Map_AddTimer("Timer_FlickerRndEmitter", 5, "OnTimer_FlickerRndEmitter");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnInteract_OpenTortureBooth(const tString &in asEntity)
		{
			if (Entity_GetVarBool(asEntity, "ButtonActive") == false) return;
			
			if (mbTortureMachineComplete)
			{
				Sound_CreateAtEntity("ButtonPress", "03_07_dw_factory/torture_victim/machine_feedback/button_positive", asEntity);
				Seq_BringVictimForward("");
			}
			else
			{
				if (mbTortureBoothOpen == false)
				{
					mbTortureBoothOpen = true;
					
					// open front glass
					SlideDoor_SetOpenAmount("Door_TortureBoothGlassFront", 1, false);
					
					Sound_CreateAtEntity("ButtonPress", "03_07_dw_factory/torture_victim/machine_feedback/button_positive", asEntity);
					SetButtonColor("Button_OpenTortureBooth", mButtonColor_Red, false);
				}
				else
				{
					Sound_CreateAtEntity("ButtonPress", "03_07_dw_factory/torture_victim/machine_feedback/button_negative", asEntity);
					FlashBoothIndicators();
				}
			}
			FlashButton(asEntity);
		}
		
