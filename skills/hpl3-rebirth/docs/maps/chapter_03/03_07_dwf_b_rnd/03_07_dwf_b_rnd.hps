	// ==============
	// SCENE 5 *Carry the extender back to the torture room and avoid the wraith*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////

		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbDefrosting = false;
		bool mbVictimDefrozen = false;
		float mfDefrostTimer = 0.0f;
		bool mbTortureBoothsActive = false;
		bool mbEmptyCanisterInserted = false;
		bool mbTorturePanelActive = false;
		int mlSelectedTorture = -1;
		int mlNewTorture = -1;
		bool mbTortureLeverDown = false;
		bool mbTortureActive = false;
		float mfCanisterVitae = 0.0f;
		float mfHappyTime = 6.0f;
		bool mbVictimAtTorture = false;
		bool mbVictimAtHappyBooth = false;
		bool mbVictimAtFreezeBooth = false;
		
		array<bool> mvHappyMemoriesInserted = { false, false, false, false, false, false };
		int mlHappyMemoryCount = 0;
		bool mbInjectingHappy = false;
		bool mbRetractedHappyneedle = false;
		bool mbStartedInjectingHappy = false;
		bool mbHappyInjectionDone = false;
		float mfHappyNeedleProgress = 0;
		int mlTortureCount = 0;
		bool mbMovingTortureBooth = false;
		bool mbTortureSuspended = false;
		tString msMovingBoothStop = "";
		
		cColor mTortureIndicatorColor_Red = cColor(1.0, 0.3, 0.3);
		cColor mTortureIndicatorColor_Green = cColor(0, 1.4, 0);
		cColor mTortureIndicatorColor_Orange = cColor(2.0, 1.0, 0);
		cColor mButtonColor_Red = cColor(1.0f, 0.2f, 0.2f);
		cColor mButtonColor_White = cColor(0.6, 1, 0.9);
		cColor mButtonColor_Green = cColor(0.3, 1.0, 0.3);
		cColor mButtonColor_Purple = cColor(0.9, 0.2, 1.0);
		cColor mButtonColor_RedExtreme = cColor(1.0, 0.15, 0.15);
		cColor mTorturePanelLightColor_Locked = cColor(1.0, 0.15, 0.0);
		cColor mTorturePanelLightColor_Unlocked = cColor(0.8, 1.0, 0.9);
		cColor mTorturePanelLightColor_Torture = cColor(1.0, 0.2, 0.2) * 1.5;
				
		bool mbVictimDead = false;
		bool mbTortureReady = false;
		bool mbVictimLowVitae = false;
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Torture control panel
		/////////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlTorturePanelState = 2;
		bool mbTortureLever_Active = false;
		bool mbTortureLever_Locked = false;
		
		//-------------------------------------------------------
		
		void SetTortureLeverState(bool abActive, bool abLocked, bool abInstant = false, bool abSaveState = true)
		{
			if (abSaveState)
			{
				mbTortureLever_Active = abActive;
				mbTortureLever_Locked = abLocked;
			}
			
			if (mbTortureRoomOn || abSaveState == false || abInstant)
			{
				Entity_SetEffectsActive("Lamp_TortureLever", abActive, !abInstant);
				SetButtonColor("Lamp_TortureLever", abLocked ? mTorturePanelLightColor_Locked : mTorturePanelLightColor_Unlocked);
				bool bLeverLocked = abActive && abLocked;
				Lever_SetStuckState("Lever_Torture", bLeverLocked ? 1 : 0, false);
				Entity_SetVarBool("Lever_Torture", "ConnectionStateChange", abActive && abLocked == false);
			}
		}
		
		//-------------------------------------------------------
		
		bool mbTortureCardMissing = false;
		bool mbTortureCardForceStickyDisabled = true;
		void SetTortureCardSlotState(bool abCardMissing, bool abForceStickyDisabled = false, bool abInstant = false, bool abSaveState = true)
		{
			if (abSaveState)
			{
				mbTortureCardMissing = abCardMissing;
				mbTortureCardForceStickyDisabled = abForceStickyDisabled;
			}
			
			if (mbTortureRoomOn || abSaveState == false || abInstant)
			{
				if (abCardMissing && abForceStickyDisabled == false)
				{
					SetButtonColor("Lamp_TortureTop", mRobotArmRingColor_Wrong * 1.0, false);
					FlashButton("Lamp_TortureTop", mRobotArmRingColor_Wrong, 3.0f, 0.5, true);
					Entity_SetEffectsActive("Lamp_TortureTop", true, !abInstant);
				}
				
				if (abCardMissing == false || abForceStickyDisabled)
				{
					StopBlinkButton("Lamp_TortureTop", true);
					Entity_SetEffectsActive("Lamp_TortureTop", false, !abInstant);
				}
			}
			
			bool bStickyActive = abForceStickyDisabled == false && mbTortureRoomOn;
			Entity_SetActive("Sticky_TortureCard", bStickyActive);
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Button controls
		/////////////////////////////////////////
		
		//-------------------------------------------------------
		
		void SetButtonActive(const tString &in asButton, bool abActive)
		{
			Entity_SetEffectsActive(asButton, abActive, false);
			Entity_SetVarBool(asButton, "ButtonActive", abActive);
		}
		
		//-------------------------------------------------------
		
		void SetButtonColor(const tString &in asButton, cColor aColor, bool abFade = false)
		{
			if (abFade) Entity_FadeEffectBaseColor(asButton, aColor, 0.2f);
			else Entity_SetEffectBaseColor(asButton, aColor);
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Button flash
		/////////////////////////////////////////
		
		//-------------------------------------------------------
		
		[nosave] array<tID> mvFlashTimers;
		[nosave] array<cColor> mvFlashOrigColors;
		[nosave] array<cColor> mvFlashColors;
		[nosave] array<float> mvFlashTimes;
		[nosave] array<bool> mvFlashRepeat;
		
		//-------------------------------------------------------
		
		void BlinkButton(const tString &in asButton)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asButton);
			FlashButton(asButton, pEnt.GetEffectBaseColor(), 1.4f, 0.5f, true);
		}
		
		//-------------------------------------------------------
		
		void StopBlinkButton(const tString &in asButton, bool abReturnColor = false)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asButton);
			for (int i = 0; i < mvFlashTimers.size(); ++i)
			{
				if (mvFlashTimers[i] == pEnt.GetID())
				{
					mvFlashRepeat[i] = false;
					Map_RemoveTimer(asButton);
					if (abReturnColor) OnTimer_StopFlash(asButton);
					else OnTimer_UnblockFlash(asButton);
				}
			}
		}
		
		//-------------------------------------------------------
		
		void FlashButton(const tString &in asButton, float afBrightness = 1.4f)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asButton);
			FlashButton(asButton, pEnt.GetEffectBaseColor(), afBrightness);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FlashButton(const tString &in asTimer)
		{
			FlashButton(asTimer);
		}
		
		//-------------------------------------------------------
		
		void FlashButton(const tString &in asButton, cColor aColor, float afBrightness = 1.4f, float afTime = 0.5f, bool abRepeat = false)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asButton);
			for (int i = 0; i < mvFlashTimers.size(); ++i)
			{
				if (mvFlashTimers[i] == pEnt.GetID()) return;
			}
									
			mvFlashTimers.push_back(pEnt.GetID());
			mvFlashOrigColors.push_back(pEnt.GetEffectBaseColor());
			mvFlashRepeat.push_back(abRepeat);
			mvFlashTimes.push_back(afTime);
			
			cColor newCol = aColor * afBrightness;
			mvFlashColors.push_back(newCol);
			
			Entity_FadeEffectBaseColor(asButton, newCol, afTime);
			Map_AddTimer(asButton, afTime, "OnTimer_StopFlash");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopFlash(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asTimer);
			for (int i = 0; i < mvFlashTimers.size(); ++i)
			{
				if (mvFlashTimers[i] == pEnt.GetID())
				{
					Entity_FadeEffectBaseColor(asTimer, mvFlashOrigColors[i], mvFlashTimes[i]);
					Map_AddTimer(asTimer, mvFlashTimes[i] + 0.05f, "OnTimer_UnblockFlash");
					return;
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UnblockFlash(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asTimer);
			for (int i = 0; i < mvFlashTimers.size(); ++i)
			{
				if (mvFlashTimers[i] == pEnt.GetID())
				{
					bool bRepeat = mvFlashRepeat[i];
					cColor repeatColor = mvFlashColors[i];
					float fTime = mvFlashTimes[i];
					pEnt.StopEffectBaseColorFade();
					pEnt.SetEffectBaseColor(mvFlashOrigColors[i]);
					
					mvFlashTimers.removeAt(i);
					mvFlashOrigColors.removeAt(i);
					mvFlashColors.removeAt(i);
					mvFlashRepeat.removeAt(i);
					mvFlashTimes.removeAt(i);
					if (bRepeat) FlashButton(asTimer, repeatColor, 1.0f, fTime, true);
					return;
				}
			}
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Light flash
		/////////////////////////////////////////
		
		//-------------------------------------------------------
		
		[nosave] array<tID> mvFlashLightTimers;
		[nosave] array<float> mvFlashLightRadius;
		[nosave] array<float> mvFlashLightOrigBrightness;
		
		//-------------------------------------------------------
		
		void FlashLight(const tString &in asLight, float afBrightness = 2.0f, float afRadius = 1.2f)
		{
			iLight@ pLight = Map_GetLight(asLight);
			for (int i = 0; i < mvFlashLightTimers.size(); ++i)
			{
				if (mvFlashLightTimers[i] == pLight.GetID()) return;
			}
			
			mvFlashLightTimers.push_back(pLight.GetID());
			mvFlashLightRadius.push_back(pLight.GetRadius());
			mvFlashLightOrigBrightness.push_back(pLight.GetBrightness());
			
			pLight.FadeTo(pLight.GetDiffuseColor(), pLight.GetRadius() * afRadius, 0.5f);
			pLight.FadeBrightnessTo(pLight.GetBrightness() * afBrightness, 0.5f);
			Map_AddTimer(asLight, 0.5f, "OnTimer_StopLightFlash");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopLightFlash(const tString &in asTimer)
		{
			iLight@ pLight = Map_GetLight(asTimer);
			for (int i = 0; i < mvFlashLightTimers.size(); ++i)
			{
				if (mvFlashLightTimers[i] == pLight.GetID())
				{
					pLight.FadeTo(pLight.GetDiffuseColor(), mvFlashLightRadius[i], 0.5f);
					pLight.FadeBrightnessTo(mvFlashLightOrigBrightness[i], 0.5f);
					Map_AddTimer(asTimer, 0.55f, "OnTimer_UnblockLightFlash");
					return;
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UnblockLightFlash(const tString &in asTimer)
		{
			iLight@ pLight = Map_GetLight(asTimer);
			for (int i = 0; i < mvFlashLightTimers.size(); ++i)
			{
				if (mvFlashLightTimers[i] == pLight.GetID())
				{
					mvFlashLightTimers.removeAt(i);
					mvFlashLightOrigBrightness.removeAt(i);
					return;
				}
			}
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Experiment chambers
		/////////////////////////////////////////
		
		//-------------------------------------------------------
		
		cVector3f mvTortureChambeDoor_EnterDir;
		bool OnCollide_Player_CloseTortureChamberDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asParent);
			if (alState == 1)
			{
				mvTortureChambeDoor_EnterDir = pEnt.GetPosition() - Player_GetPosition();
				mvTortureChambeDoor_EnterDir = cMath_Vector3Project(mvTortureChambeDoor_EnterDir, pEnt.GetMatrix().GetTranspose().GetForward());
				mvTortureChambeDoor_EnterDir.Normalize();
			}
			else
			{
				cVector3f vExitDir = Player_GetPosition() - Map_GetEntity(asParent).GetPosition();
				vExitDir = cMath_Vector3Project(vExitDir, pEnt.GetMatrix().GetTranspose().GetForward());
				vExitDir.Normalize();

				if (cMath_Vector3Dot(vExitDir, mvTortureChambeDoor_EnterDir) >= 0)
				{
					SlideDoor_SetOpenAmount("Door_TortureChamber", 0, false);
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SafeFromWraith(const tString &in asParent, const tString &in asChild, int alState)
		{
			Wraith_SetHearing("Wraith_ExtenderEncounter", alState == -1);
			Wraith_SetHearing("Wraith_ShuttleDoorEncounter", alState == -1);
			return true;
		}
		
