		//-------------------------------------------------------
		
		bool mbRadiusTest = true;
		void SetRndExtenderRadius()
		{
			return;
			if (mbRadiusTest)
			{
				if (Map_TimerExists("ExtenderRadiusCooldown")) return;
				Map_AddTimer("ExtenderRadiusCooldown", 0.1, "");
			}
			
			DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_RnD", -1);
			DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_ShuttleStation", -1);
			DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_TortureRoom", -1);
			
			if (mlChangeEmitterRadius3 > 0)
			{
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_TortureRoom", 5);
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_RnD", 25);
			}
			else if (mlChangeEmitterRadius2 > 0)
			{
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_RnD", 22);
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_ShuttleStation", 21);
			}
			else if (mlChangeEmitterRadius1 > 0)
			{
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_RnD", 10);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Extender_Overpass(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlEmitterRadiusArea_Overpass += alState;
			SetExtenderRadius();		
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Extender_OverpassControlPanel(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlEmitterRadiusArea_OverpassControlPanel += alState;
			SetExtenderRadius();
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Extender_TortureChamber(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlEmitterRadiusArea_TortureChamber += alState;
			SetExtenderRadius();
			return true;
		}
		
		//-------------------------------------------------------
		
		int mlEmitterRadiusArea_Overpass = 0;
		int mlEmitterRadiusArea_OverpassControlPanel = 0;
		int mlEmitterRadiusArea_RnD = 0;
		int mlEmitterRadiusArea_TortureChamber = 0;
		
		void SetExtenderRadius()
		{
			DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_ShuttleStation", -1);
			DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_RnD", -1);
			DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_Overpass", -1);
			DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_TortureRoom", -1);
			if (mlEmitterRadiusArea_OverpassControlPanel > 0)
			{
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_ShuttleStation", 21);
			}
			else if (mlEmitterRadiusArea_TortureChamber > 0)
			{
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_RnD", 1);
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_Overpass", 30);
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_TortureRoom", 30);
			}
			else if (mlEmitterRadiusArea_Overpass > 0)
			{
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_RnD", 1);
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_Overpass", 20);
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_TortureRoom", 10);
			}
			else if (mlEmitterRadiusArea_RnD > 0)
			{
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_RnD", 16);
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerEmitter_Overpass", 1);
				DarkWorldPower_SetEntityPairRadius("PowerExtender_StorageRoom", "PowerReceiver_TortureRoom", 1);
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Restore power to the torture chamber*
		
	//} END SCENE 5
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 6 *Torture the victim and heal the baby*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////

		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void InitTortureChamber()
		{
			// pry open physics door
			Entity_SetActive("Door_TortureMiddlePhysics_*", true);
			MovingButton_SetDisabled("Door_TortureMiddle_Button_*", true);
			SetSliderDoorMaxDistance("Door_TortureMiddlePhysics_Left", 0.8);
			SetSliderDoorMaxDistance("Door_TortureMiddlePhysics_Right", 0.8);
			
			// doors
//			Entity_SetActive("Door_TortureChamber_*", true);
//			SetRnDDoorState("Door_TortureChamber", true, true, false);
			Entity_SetActive("Door_TortureChamberPhysics_*", true);
			MovingButton_SetDisabled("Door_TortureChamber_Button_*", true);
			SetSliderDoorMaxDistance("Door_TortureChamberPhysics_Left", 0.8);
			SetSliderDoorMaxDistance("Door_TortureChamberPhysics_Right", 0.8);
						
			SetRnDDoorState("Door_TortureEntrance", true, true, false);
			
			// vitae pipes
			Entity_SetEffectsActive("VitaePipe_TortureBooth_*", false, false);
			
			// TH arrival
			Light_SetVisible("Light_THArrival_Spot", false);
			Billboard_SetVisible("Billboard_THArrival", false);
			
			// torture panel
			{
//				Lamp_SetLit("Lamp_TorturePanel", false, false);
//				Entity_SetEffectsActive("TorturePanel", false, false);
//				Lamp_SetLit("Lamp_TorturePanel_*", false, false);
				SetTortureCardSlotState(false, true, true);
				SetTortureLeverState(false, false, true);
				
				cSubMeshEntity@ pSubMesh = Map_GetEntity("TorturePanel_Lights").GetMeshEntity().GetSubMeshEntityName("control_panels_torture_lights");
				m_idTortureMeter = pSubMesh.GetID();
				pSubMesh.GetMaterial().SetUvAnimationSpeed(0, 0);
				pSubMesh.GetMaterial().SetUvAnimationTime(0, -0.01);
				SetTortureMeterState(eTortureMeterState_Inactive);
			}
			
			// chamber general
			Light_SetBrightness("Light_TortureChamber_Point_*", 0);
			Light_SetBrightness("Light_TortureChamber*", 0);
			Lamp_SetLit("Lamp_TortureChamber*", false, false);
			Decal_SetDynamicVisible("decal_post_torture_drill*", false);
			
			// storage
			{
				for (int i = 1; i <= 4; ++i)
				{
					Map_GetEntity("Victim_Storage_" + i).GetMeshEntity().SetVariableAnimationUpdate(true);
					Entity_PlayAnimation("Victim_Storage_" + i, "frozen_brought_in", 0);
//					Map_GetEntity("Victim_Storage_" + i).GetMeshEntity().GetAnimationStateFromName("frozen_brought_in").SetPaused(true);
					Entity_AttachToSocket("Victim_Storage_" + i, "Hanger_Storage_" + i, "socket_victim", true);
				}
			}
			
			// torture booth
			{
//				Lamp_SetLit("Lamp_TortureBooth_*", false, false);
				mbPower_CompleteButtonState = false;
				SetButtonActive("Button_CompleteTortureSetup_1", false);
			}
			
			// torture hanger
			{
				Map_GetEntity("TortureHanger").GetMeshEntity().SetVariableAnimationUpdate(true);
				Entity_SetActive("TortureHanger", true);
				Entity_PlayAnimation("TortureHanger", "rnd_torture_hanger_brought_in", 0, false, false, "");
				cAnimationState@ pAnim = Map_GetEntity("TortureHanger").GetMeshEntity().GetAnimationStateFromName("rnd_torture_hanger_brought_in");
				pAnim.SetRelativeTimePosition(0);
				pAnim.SetPaused(true);
			}
			
			// torture victim
			{
				Map_GetEntity("TortureVictim").GetMeshEntity().SetVariableAnimationUpdate(true);
				msTortureVictim_Idle = "defrosted";
				Entity_SetActive("TortureVictim", true);
				Entity_PlayAnimation("TortureVictim", "defrosted", 0, false, false, "");
				cAnimationState@ pAnim = Map_GetEntity("TortureVictim").GetMeshEntity().GetAnimationStateFromName("defrosted");
				pAnim.SetRelativeTimePosition(0);
				pAnim.SetPaused(true);
				
				Entity_AttachToSocket("TortureVictim", "TortureHanger", "socket_victim", true, true);
				Voice_SetSource("Victim", "TortureVictim", 0, 12, true);
			}
			
			// torture arms
			{
				for (int i = 1; i <= 5; ++i)
				{
					// activate all the arms
					tString sArmName = "TortureArm_" + i;
					iLuxEntity@ pEnt = Map_GetEntity(sArmName);
					mvRobotArms.push_back(pEnt.GetID());
					Entity_SetActive(sArmName, true);
					
					// init rings and turn off light
					mvRobotArmRings.push_back(pEnt.GetMeshEntity().GetSubMeshEntityName("m_Arm_" + i + "_socket_edge").GetID());
					SetRobotArmRingColor(i, mRobotArmRingColor_Off);
					
					// attach sticky areas
					Entity_SetActive("Sticky_RobotArm_" + i, false);
					Entity_AttachToSocket("Sticky_RobotArm_" + i, "TortureArm_" + i, "socket_tool", true, true);
				}
				
				// set start pose
				PlayRobotArmAnimation("start_pose");
			}
			
			// inner torture window
			{
				Entity_SetActive("TortureWindow_Inner", true);
				Entity_PlayAnimation("TortureWindow_Inner", "rnd_torture_inner_window_brought_up", 0, false, false, "");
				cAnimationState@ pAnim = Map_GetEntity("TortureWindow_Inner").GetMeshEntity().GetAnimationStateFromName("rnd_torture_inner_window_brought_up");
				pAnim.SetRelativeTimePosition(0);
				pAnim.SetPaused(true);
			}
			
			// outer torture window
			{
				Entity_SetActive("TortureWindow_Outer", true);
				Entity_PlayAnimation("TortureWindow_Outer", "rnd_torture_outer_window_brought_up", 0, false, false, "");
				cAnimationState@ pAnim = Map_GetEntity("TortureWindow_Outer").GetMeshEntity().GetAnimationStateFromName("rnd_torture_outer_window_brought_up");
				pAnim.SetRelativeTimePosition(0);
				pAnim.SetPaused(true);
				
				Entity_SetActive("Blocker_OuterTortureBooth", true);
			}
			
			// torture shutter
			{
				Entity_SetActive("TortureShutter", true);
				Entity_PlayAnimation("TortureShutter", "rnd_torture_shutters_brought_down", 0, false, false, "");
				cAnimationState@ pAnim = Map_GetEntity("TortureShutter").GetMeshEntity().GetAnimationStateFromName("rnd_torture_shutters_brought_down");
				pAnim.SetRelativeTimePosition(0);
				pAnim.SetPaused(true);
			}
			
			// canister socket
			SetCanisterSocketLocked(true, false);
			SetCanisterSocketLocked(true);
			SetCanisterIndicatorState(0, false);
			SetCanisterIndicatorState(0);
			mbPower_CanisterBlockerActive = true;
			Entity_SetActive("Blocker_CanisterSocket", true);
			
			// drills
			Entity_StopAnimation("TortureTool_Drill*");
			
			// drowner
			Entity_StopAnimation("TortureTool_Drowner*");
			
			// burners
			SetBurnerState("TortureTool_Burner_1", 0);
			SetBurnerState("TortureTool_Burner_2", 0);
			SetBurnerState("TortureTool_Burner_3", 0);
			SetBurnerState("TortureTool_Burner_4", 0);
			SetBurnerState("TortureTool_Burner_5", 0);
			
			// freezer fog
			cFogArea@ pFog = cLux_GetCurrentMap().GetWorld().GetFogArea("FogArea_Freezer_stage_2");
			m_idFreezerFog = pFog.GetID();
			mFreezerFogOrigColor = pFog.GetColor();
			mFreezerFogColor = cColor(0);
			pFog.SetColor(mFreezerFogColor);
		}
		
		//-------------------------------------------------------
		
		void UpdateTortureChamber(float afTimeStep)
		{
			if (mbFadeFreezerFog)
			{
				mfFreezerFogFadeTimer += afTimeStep;
				float fT = cMath_Clamp(mfFreezerFogFadeTimer / mfFreezerFogFadeTime, 0.0f, 1.0f);
				
				cFogArea@ pFog = cLux_ID_FogArea(m_idFreezerFog);
				mFreezerFogColor = mFreezerFogFadeFrom * (1.0f - fT) + mFreezerFogFadeTo * fT;
				pFog.SetColor(mFreezerFogColor);
				if (fT >= 1) mbFadeFreezerFog = false;
			}
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Burner effects
		/////////////////////////////////////////
		
		//-------------------------------------------------------
		
		void SetBurnerState(const tString &in asEntity, int alState, float afFadeTime = -1.0f)
		{
			if (alState == Entity_GetVarInt(asEntity, "BurnerState") - 10) return;
			Entity_SetVarInt(asEntity, "BurnerState", alState + 10);
			
			iLuxEntity@ pEnt = Map_GetEntity(asEntity);
			if (pEnt is null) return;
			
			//////////////////////
			// Particles
			bool bIdlePS = alState == 1;
			cParticleSystem@ pPS_Idle = cLux_GetCurrentMap().GetWorld().GetParticleSystem(asEntity + "_PS_idle");
			if (bIdlePS && pPS_Idle is null)
			{
				@pPS_Idle = cLux_GetCurrentMap().GetWorld().CreateParticleSystem(asEntity + "_PS_idle", "03_07_torture_torch_fire_idle.ps", cVector3f_One, false, false);

				cMatrixf mtxStart = cMath_MatrixRotateXYZ(cVector3f(0,-90,0) * cMath_Pi / 180);
				mtxStart.SetTranslation(cVector3f(-0.08,0,0));
				pPS_Idle.SetMatrix(mtxStart);
				
				pEnt.GetAttachEntity().AddChild(pPS_Idle);
			}
			else if (pPS_Idle !is null)
			{
				if (bIdlePS && pPS_Idle.IsDying()) pPS_Idle.Restart();
				else if (bIdlePS == false) pPS_Idle.Kill();
			}
			
			bool bRampPS = alState == 2;
			cParticleSystem@ pPS_Ramp = cLux_GetCurrentMap().GetWorld().GetParticleSystem(asEntity + "_PS_ramp");
			if (bRampPS && pPS_Ramp is null)
			{
				@pPS_Ramp = cLux_GetCurrentMap().GetWorld().CreateParticleSystem(asEntity + "_PS_ramp", "03_07_torture_torch_fire_ramp.ps", cVector3f_One, false, false);

				cMatrixf mtxStart = cMath_MatrixRotateXYZ(cVector3f(0,-90,0) * cMath_Pi / 180);
				mtxStart.SetTranslation(cVector3f(-0.1,0,0));
				pPS_Ramp.SetMatrix(mtxStart);
				
				pEnt.GetAttachEntity().AddChild(pPS_Ramp);
			}
			else if (pPS_Ramp !is null)
			{
				if (bRampPS && pPS_Ramp.IsDying()) pPS_Ramp.Restart();
				else if (bRampPS == false) pPS_Ramp.Kill();
			}
			
			bool bFullPS = alState == 3;
			cParticleSystem@ pPS_Full = cLux_GetCurrentMap().GetWorld().GetParticleSystem(asEntity + "_PS_full");
			if (bFullPS && pPS_Full is null)
			{
				@pPS_Full = cLux_GetCurrentMap().GetWorld().CreateParticleSystem(asEntity + "_PS_full", "03_07_torture_torch_fire_full.ps", cVector3f_One, false, false);

				cMatrixf mtxStart = cMath_MatrixRotateXYZ(cVector3f(0,-90,0) * cMath_Pi / 180);
				mtxStart.SetTranslation(cVector3f(-0.04,0,0));
				pPS_Full.SetMatrix(mtxStart);
				
				pEnt.GetAttachEntity().AddChild(pPS_Full);
			}
			else if (pPS_Full !is null)
			{
				if (bFullPS && pPS_Full.IsDying()) pPS_Full.Restart();
				else if (bFullPS == false) pPS_Full.Kill();
			}
			
			//////////////////////
			// Billboards
			bool bRampBillboard = alState == 2;
			pEnt.GetBillboardFromName("Billboard_Ramp").SetVisible(bRampBillboard);
			
			bool bFullBillboard = alState == 3;
			pEnt.GetBillboardFromName("Billboard_Full").SetVisible(bFullBillboard);
			
			
			/////////////////////
			// Lights
			float fLightFadeTime = cMath_Max(0.0, afFadeTime);
			
			bool bIdleLamp = alState == 1;
			if (bIdleLamp) pEnt.GetLightFromName("Light_Point_Idle").FadeBrightnessToDefault(fLightFadeTime);
			else pEnt.GetLightFromName("Light_Point_Idle").FadeBrightnessTo(0, fLightFadeTime);
			
			bool bRampLamp = alState == 2;
			if (bRampLamp) pEnt.GetLightFromName("Light_Point_Ramp").FadeBrightnessToDefault(fLightFadeTime);
			else pEnt.GetLightFromName("Light_Point_Ramp").FadeBrightnessTo(0, fLightFadeTime);
			
			bool bFullLamp = alState == 3;
			if (bFullLamp) pEnt.GetLightFromName("Light_Point_Full").FadeBrightnessToDefault(fLightFadeTime);
			else pEnt.GetLightFromName("Light_Point_Full").FadeBrightnessTo(0, fLightFadeTime);
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Drowner effects
		/////////////////////////////////////////
		
		//-------------------------------------------------------
		
		void SetDrownerState(const tString &in asEntity, int alState, float afFadeTime = -1.0f)
		{
			if (alState == Entity_GetVarInt(asEntity, "DrownerState") - 10) return;
			Entity_SetVarInt(asEntity, "DrownerState", alState + 10);
			
			iLuxEntity@ pEnt = Map_GetEntity(asEntity);
			if (pEnt is null) return;
			
			bool bRampPS = alState == 1;
			cParticleSystem@ pPS_Ramp = cLux_GetCurrentMap().GetWorld().GetParticleSystem(asEntity + "_PS_ramp");
			if (bRampPS && pPS_Ramp is null)
			{
				@pPS_Ramp = cLux_GetCurrentMap().GetWorld().CreateParticleSystem(asEntity + "_PS_ramp", "03_07_torture_water_test.ps", cVector3f_One, false, false);

				cMatrixf mtxStart = cMath_MatrixRotateXYZ(cVector3f(0,-90,0) * cMath_Pi / 180);
				mtxStart.SetTranslation(cVector3f(0,0,0));
				pPS_Ramp.SetMatrix(mtxStart);
				
				pEnt.GetAttachEntity().AddChild(pPS_Ramp);
			}
			else if (pPS_Ramp !is null)
			{
				if (bRampPS && pPS_Ramp.IsDying()) pPS_Ramp.Restart();
				else if (bRampPS == false) pPS_Ramp.Kill();
			}
			
			bool bFullPS = alState == 2;
			cParticleSystem@ pPS_Full = cLux_GetCurrentMap().GetWorld().GetParticleSystem(asEntity + "_PS_full");
			if (bFullPS && pPS_Full is null)
			{
				@pPS_Full = cLux_GetCurrentMap().GetWorld().CreateParticleSystem(asEntity + "_PS_full", "03_07_torture_water_full.ps", cVector3f_One, false, false);

				cMatrixf mtxStart = cMath_MatrixRotateXYZ(cVector3f(0,-90,0) * cMath_Pi / 180);
				mtxStart.SetTranslation(cVector3f(0,0,0));
				pPS_Full.SetMatrix(mtxStart);
				
				pEnt.GetAttachEntity().AddChild(pPS_Full);
			}
			else if (pPS_Full !is null)
			{
				if (bFullPS && pPS_Full.IsDying()) pPS_Full.Restart();
				else if (bFullPS == false) pPS_Full.Kill();
			}
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Victim animations
		/////////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msTortureVictim_Idle;
		
		//-------------------------------------------------------
		
		void TortureVictim_SetIdle(const tString &in asAnim, bool abPlay = true)
		{
			msTortureVictim_Idle = asAnim;
			if (abPlay) Entity_PlayAnimation("TortureVictim", asAnim, 0, true);
		}
		
		//-------------------------------------------------------
		
		void TortureVictim_PlayAnimation(const tString &in asAnim, float afFade = 0)
		{
			Entity_PlayAnimation("TortureVictim", asAnim, afFade, false, false, "OnAnimEnd_TortureVictim_RestartIdle");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_TortureVictim_RestartIdle(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_PlayAnimation("TortureVictim", msTortureVictim_Idle, 0, true);
		}
		
		//-------------------------------------------------------

		//} END General
		
		/////////////////////////////////////////
		// Event A *Power up the torture chamber*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------

		array<tID> mvRobotArmRings;
		cColor mRobotArmRingColor_Off = cColor(0, 0, 0);
		cColor mRobotArmRingColor_Default = cColor(1, 1, 1) * 1.2;
		cColor mRobotArmRingColor_Wrong = cColor(1, 0, 0);
		cColor mRobotArmRingColor_Correct = cColor(0, 1, 0);
		tID m_idFreezerFog = tID_Invalid;
		cColor mFreezerFogOrigColor = cColor(0, 0, 0);
		cColor mFreezerFogColor;
		cColor mFreezerFogFadeFrom;
		cColor mFreezerFogFadeTo;
		bool mbFadeFreezerFog = false;
		float mfFreezerFogFadeTimer = 0;
		float mfFreezerFogFadeTime = 0;
		bool mbRobotArmsSocketsActive = false;
		
		//-------------------------------------------------------
		
		void FadeFreezerFogColor(cColor aColor, float afTime)
		{
			mbFadeFreezerFog = true;
			mfFreezerFogFadeTimer = 0;
			mfFreezerFogFadeTime = afTime;
			mFreezerFogFadeFrom = mFreezerFogColor;
			mFreezerFogFadeTo = aColor;
		}
		
		//-------------------------------------------------------
		
		void SetRobotArmRingColor(int alArmIndex, cColor aColor)
		{
			cLux_ID_SubMeshEntity(mvRobotArmRings[alArmIndex - 1]).SetIlluminationColor(aColor);
		}
		
		//-------------------------------------------------------
		
		void FadeRobotArmRingColor(int alArmIndex, cColor aFadeColor, float afTime = 1, int alFades = 1, bool abCustomOriginalColor = false, cColor aCustomColor = cColor_White)
		{
			FadeSubMeshIllumColor(mvRobotArmRings[alArmIndex - 1], aFadeColor, afTime, alFades, abCustomOriginalColor, aCustomColor);
		}
		
		//-------------------------------------------------------
		
		void StopRobotArmRingColorFade(int alArmIndex)
		{
			StopSubMeshIllumFade(mvRobotArmRings[alArmIndex - 1]);
		}
		
		//-------------------------------------------------------
		
		void PlayRobotArmAnimation(const tString &in asAnim, float afFadeTime = 0, bool abLoop = false, const tString &in asCallback = "", bool abArm1 = true, bool abArm2 = true, bool abArm3 = true, bool abArm4 = true, bool abArm5 = true)
		{
			bool bCallback = asCallback != "";
			for (int i = 1; i <= 5; ++i)
			{
				if (i == 1 && abArm1 == false) continue;
				if (i == 2 && abArm2 == false) continue;
				if (i == 3 && abArm3 == false) continue;
				if (i == 4 && abArm4 == false) continue;
				if (i == 5 && abArm5 == false) continue;
				
				Entity_PlayAnimation("TortureArm_" + i, "rnd_arm_" + i + "_" + asAnim, afFadeTime, abLoop, false, bCallback ? asCallback : "");
				bCallback = false;
			}
		}
		
		//-------------------------------------------------------
		
		void PlayActiveRobotArmAnimation(const tString &in asAnim, float afFadeTime = 0, bool abLoop = false, const tString &in asCallback = "")
		{
			bool bArm1 = mvRobotArmState[0] == 2;
			bool bArm2 = mvRobotArmState[1] == 2;
			bool bArm3 = mvRobotArmState[2] == 2;
			bool bArm4 = mvRobotArmState[3] == 2;
			bool bArm5 = mvRobotArmState[4] == 2;
			PlayRobotArmAnimation(asAnim, afFadeTime, abLoop, asCallback, bArm1, bArm2, bArm3, bArm4, bArm5);
		}
		
		//-------------------------------------------------------
		
		void PlayInactiveRobotArmAnimation(const tString &in asAnim, float afFadeTime = 0, bool abLoop = false, const tString &in asCallback = "")
		{
			bool bArm1 = mvRobotArmState[0] != 2;
			bool bArm2 = mvRobotArmState[1] != 2;
			bool bArm3 = mvRobotArmState[2] != 2;
			bool bArm4 = mvRobotArmState[3] != 2;
			bool bArm5 = mvRobotArmState[4] != 2;
			cLux_AddDebugMessage("INACTIVE ANIM " + asAnim + " " + bArm1 + " "+  bArm2 + " " + bArm3 + " " + bArm4 + " " + bArm5);
			PlayRobotArmAnimation(asAnim, afFadeTime, abLoop, asCallback, bArm1, bArm2, bArm3, bArm4, bArm5);
		}
		
		//-------------------------------------------------------
		
		void SetActiveRobotArmAnimationSpeed(const tString &in asAnim, float afSpeed)
		{
			for (int i = 1; i <= 5; ++i)
			{
				if (mvRobotArmState[i - 1] != 2) continue;
				cLux_ID_Entity(mvRobotArms[i - 1]).GetMeshEntity().GetAnimationStateFromName("rnd_arm_" + i + "_" + asAnim).SetSpeed(afSpeed);
			}
		}
		
		//-------------------------------------------------------
		
		float GetActiveRobotArmAnimationTime(const tString &in asAnim)
		{
			for (int i = 1; i <= 5; ++i)
			{
				if (mvRobotArmState[i - 1] != 2) continue;
				return cLux_ID_Entity(mvRobotArms[i - 1]).GetMeshEntity().GetAnimationStateFromName("rnd_arm_" + i + "_" + asAnim).GetTimePosition();
			}
			return -1;
		}
		
		//-------------------------------------------------------
		
		bool GetActiveRobotArmAnimationIsActive(const tString &in asAnim)
		{
			for (int i = 1; i <= 5; ++i)
			{
				if (mvRobotArmState[i - 1] != 2) continue;
				return cLux_ID_Entity(mvRobotArms[i - 1]).GetMeshEntity().GetAnimationStateFromName("rnd_arm_" + i + "_" + asAnim).IsActive();
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		void PlayActiveTortureToolAnimation(const tString &in asAnim, float afFadeTime = 0, bool abLoop = false, const tString &in asCallback = "")
		{
			for (int i = 1; i <= 5; ++i)
			{
				if (mvRobotArmState[i - 1] != 2) continue;
				tString sTool = mvRobotArmAttach[i - 1];
				tString sToolPrefix = "";
				if (cString_GetFirstStringPos(sTool, "Drill") >= 0) sToolPrefix = "rnd_drill_" + i + "_";
				else if (cString_GetFirstStringPos(sTool, "Burner") >= 0) continue;
				else if (cString_GetFirstStringPos(sTool, "Drowner") >= 0) sToolPrefix = "rnd_drowner_";
				Entity_PlayAnimation(sTool, sToolPrefix + asAnim, afFadeTime, abLoop, false, asCallback);
			}
		}
		
		//-------------------------------------------------------
		
		void SetActiveTortureToolAnimationSpeed(const tString &in asAnim, float afSpeed)
		{
			for (int i = 1; i <= 5; ++i)
			{
				if (mvRobotArmState[i - 1] != 2) continue;
				tString sTool = mvRobotArmAttach[i - 1];
				tString sToolPrefix = "";
				if (cString_GetFirstStringPos(sTool, "Drill") >= 0) sToolPrefix = "rnd_drill_" + i + "_";
				else if (cString_GetFirstStringPos(sTool, "Burner") >= 0) continue;
				else if (cString_GetFirstStringPos(sTool, "Drowner") >= 0) sToolPrefix = "rnd_drowner_";
				Map_GetEntity(sTool).GetMeshEntity().GetAnimationStateFromName(sToolPrefix + asAnim).SetSpeed(afSpeed);
			}
		}
		
		//-------------------------------------------------------
		
		void SetTortureSocketsInteraction(bool abEnabled, bool abSaveState = true)
		{
			if (abSaveState) mbRobotArmsSocketsActive = abEnabled;
			if (mbTortureRoomOn == false && abSaveState) return;
			
			for (int i = 1; i <= 5; ++i)
			{
				tString sTool = mvRobotArmAttach[i - 1];
				if (sTool != "") Entity_SetInteractionDisabled(sTool, !abEnabled);
				else Entity_SetActive("Sticky_RobotArm_" + i, abEnabled);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnEnter_Player_ActivateTortureChamber(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_ActivateTortureChamber("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceActivateTortureChamber;
		void Seq_ActivateTortureChamber(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ActivateTortureChamber", mSequenceActivateTortureChamber);
			if (Sequence_DoStepAndWait(0.5))
			{	
//				Entity_SetActive("Fear_TortureChamber", true);
				
				// turn on prep room
				Entity_SetActive("Trigger_ExitDoorHintDialogue", false);
				Entity_SetActive("Fear_1", false);
				Entity_SetActive("Fear_2", false);
				Entity_SetActive("Fear_3", false);
				
				// torture panel lights
				mlTortureChamberActivationStage = 1;
				Sound_CreateAtEntity("TortureChamberLights", "03_07_DW_theatre/events/torture_room_powerup/lights", "Lamp_TorturePanel_1");
				if (mbTortureRoomOn) Lamp_SetLit("Lamp_TorturePanel_*", true, true);
				
				// turn off vitae chair maintenance
				Lamp_SetLit("torture_chair_maintenance_lamp_*", false, true);
				Light_FadeBrightnessTo("torture_chair_maintenance_light_*", 0, 0.5);
				
				// sounds
				Sound_Play("Sound_TorturePowerUp_1", 0.0f);
				Sound_Play("Sound_TorturePowerUp_2", 0.0f);
				Sound_Play("Sound_TorturePowerLoop", 6.0f);
			}
			else if (Sequence_DoStepAndPause(1.0))
			{
				if (mbTortureRoomOn) Lamp_SetLit("Lamp_TortureBooth_*", true, true);
				
				// start bringing in victim
				Entity_SetAnimationMessageEventCallback("TortureHanger", "OnAnimationMessage_ResumeActivateTortureChamber", false);
				Entity_PlayAnimation("TortureHanger", "rnd_torture_hanger_brought_in", 0, false, false, "");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				// start defrost
				ParticleSystem_CreateAtEntity("Defrost1", "dark_world_factory_defrosting.ps", "Target_Defrost_1", true);
				ParticleSystem_CreateAtEntity("Defrost2", "dark_world_factory_defrosting.ps", "Target_Defrost_2", true);
				Sound_Play("Sound_VictimDefrost", 0.0f);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				// victim idle
				TortureVictim_SetIdle("confused_idle", false);
				TortureVictim_PlayAnimation("defrosted", 0);
				Voice_PlayPeriodically("Victim_Mumble_Unfrozen", 20, 40, 6);
				Map_AddTimer("Timer_EnableDefrostedLookAt", 4, "OnTimer_EnableDefrostedLookAt");
				Map_AddTimer("Timer_DisableDefrostedLookAt", 10, "OnTimer_DisableDefrostedLookAt");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				// open hanger arms
				Entity_PlayAnimation("TortureHanger", "rnd_torture_hanger_defrost_open", 0, false, false, "OnAnimEnd_ResumeActivateTortureChamber");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// stop defrost
				ParticleSystem_Destroy("Defrost1");
				ParticleSystem_Destroy("Defrost2");
			}
			else if (Sequence_DoStepAndPause(1.5))
			{
				// arms ready up
				PlayRobotArmAnimation("open_up_readying_for_tool_insertion", 0, false, "OnAnimEnd_ResumeActivateTortureChamber");
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				// close inner
				SetBackTortureWindowOpen(false);
				SetVictimTalkActive(true);
				
				// bench lights
				mlTortureChamberActivationStage = 2;
				if (mbTortureRoomOn)
				{
					Lamp_SetLit("Lamp_TortureBench_*", true, true);
					FadeFreezerFogColor(mFreezerFogOrigColor, 1.5f);
					Lamp_SetLit("Lamp_Freezer_Backlight_Lamp_*", true, true);
					
					// turn on torture canister glow
					Entity_SetEffectsActive("TortureCanister*", true, true);
				}
				
				Entity_SetActive("Trigger_TortureDiagramDialogue*", true);
				
				
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				// open outer
				SetFrontTortureWindowOpen(true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
//				for (int i = 1; i <= 5; ++i) Entity_SetActive("Sticky_RobotArm_" + i, true);
				SetTortureSocketsInteraction(true);
				
				// activate torture panel
				SetTortureLeverState(true, true);
				SetTortureCardSlotState(true, false);
				
				// unlock canister socket
				SetCanisterSocketLocked(false);
				mbPower_CanisterBlockerActive = false;
				if (mbTortureRoomOn) Entity_SetActive("Blocker_CanisterSocket", false);
				
				// activate bring in buttons
				mbPower_CompleteButtonState = true;
				if (mbTortureRoomOn) SetButtonActive("Button_CompleteTortureSetup_1", true);
			}
			Sequence_End();
		}
		
