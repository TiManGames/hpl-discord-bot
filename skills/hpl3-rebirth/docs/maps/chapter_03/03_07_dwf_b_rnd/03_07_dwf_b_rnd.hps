		{	
			if (alState == 1)
			{
				Voice_PlayWhenPossible("Dialogue_SeeVictimInPod", "OnVoiceCondition_SeeVictimInPodDialogue", -1, 2, "OnVoiceEnd_SeeVictimInPodDialogue");
			}
			else
			{
				Voice_StopCheckTimer("Dialogue_SeeVictimInPod");
			}			
		}
		
