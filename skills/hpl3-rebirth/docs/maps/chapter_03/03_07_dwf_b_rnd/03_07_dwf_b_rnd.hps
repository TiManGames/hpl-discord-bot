		void OnLookAt_SeeShuttleStationAgainDialogue(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				Voice_PlayWhenPossible("Dialogue_SeeShuttleStationAgain", "OnVoiceCondition_SeeShuttleStationAgain", -1, 2);
			}
			else
			{
				Voice_StopCheckTimer("Dialogue_SeeShuttleStationAgain");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnVoiceCondition_SeeShuttleStationAgain(const tString& in asSubject)
		{
			if (FearHandler_IsAgentNearby()) return false;
			if (Entity_IsActive("Wraith_ExtenderEncounter") && Player_GetDistanceToEntity("Wraith_ExtenderEncounter") < 26.0f) return false;
			
			Entity_SetActive("Trigger_SeeShuttleStationAgainDialogue_*", false);
			Entity_SetActive("Trigger_ShuttleStationAgainDialogueArea_*", false);
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event A *See the shuttle station again*
		
