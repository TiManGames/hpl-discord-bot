		// Event A *Encounter Tin Hinan in the torture room*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbArrivalSceneStarted = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SetupTHArrivalScene(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_SetupTHArrivalScene_*", false);
			
			YoungTinHinan_SetCustomCoverage("THGhost_Arrival", 0.0f);
			YoungTinHinan_Activate("THGhost_Arrival", 1.0, true);
			Entity_SetActive("Trigger_THArrivalScene", true);
			Entity_SetActive("Trigger_THArrivalForceEnd", true);
			
			Map_AddTimer("Timer_CheckArrivalSceneDistance", 0, "OnTimer_CheckArrivalSceneDistance");
			Entity_SetActive("Trigger_TheViewLongerDialogue*", false);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_THArrivalForceEnd(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_StartArrivalScene", 0, "OnTimer_StartArrivalScene");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartTHArrivalScene(const tString &in asEntity, int alState)
		{
			Map_AddTimer("Timer_StartArrivalScene", 0, "OnTimer_StartArrivalScene");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckArrivalSceneDistance(const tString &in asTimer)
		{
			if (Player_GetDistanceToEntity("THGhost_Arrival") <= 3.5)
			{
				Map_AddTimer("Timer_StartArrivalScene", 0, "OnTimer_StartArrivalScene");
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.1, 0.4));	
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartArrivalScene(const tString &in asTimer)
		{
			if (mbArrivalSceneStarted) return;
			mbArrivalSceneStarted = true;
			Seq_THArrivalScene("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTHArrivalScene;
		void Seq_THArrivalScene(const tString &in asTimer)
		{
			Sequence_Begin("Seq_THArrivalScene", mSequenceTHArrivalScene);
			if (Sequence_DoStepAndWait(0))
			{
//				Entity_SetActive("Fear_TortureChamber", true);
				
				YoungTinHinan_SetCustomCoverage("THGhost_Arrival", 0.5f);
				Agent_FaceEntity("THGhost_Arrival", "Player");
				Entity_PlayAnimation("THGhost_Arrival", "tinhinan_before_torture", 0);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				// start dialogue state
				Voice_SetSource("Tin Hinan", "THGhost_Arrival", 6, 25, true);
				Dialog_StartConversation("Tin Hinan", "THGhost_Arrival", 1.5f, cVector3f_Zero, true);
				
				Item_PutAway(eItemHandlerHand_Right);
				Item_PutAway(eItemHandlerHand_Left);
				
				// fade in th
				YoungTinHinan_SetCustomCoverage("THGhost_Arrival", 0.5f);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				// remove light through door
				Light_SetVisible("Light_THArrival_Spot", false);
				Billboard_SetVisible("Billboard_THArrival", false);
			}
			else if (Sequence_DoStepAndPause(0.5))
			{
				// start dialogue
				Dialog_Begin();
				Dialog_AddBranchAndSubject("Dialogue_TinHinanAppears", "", "OnVoice_ResumeTHArrivalScene");
				Dialog_End();
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				// stop dialogue state
				Dialog_StopConversation();
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				// fade out th
				YoungTinHinan_Deactivate("THGhost_Arrival", 1);
			}
			else if (Sequence_DoStepAndWait(0))
			{
//				Entity_SetActive("Fear_TortureChamber", false);
				
				Sketchbook_CompleteIdea("find_babyhelp");
				Sketchbook_AddIdea("use_chair");
				
				Voice_Play("Dialogue_VitaeMission", -1, "OnVoiceEnd_EndTHArrivalScene");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnVoice_ResumeTHArrivalScene(const tString&in asSubject, bool abStartOfSubject)
		{
			if (abStartOfSubject) return;
			SequenceStates_Resume("Seq_THArrivalScene");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_EndTHArrivalScene(const tString&in asScene, const tString&in asSubject)
		{
			Entity_SetActive("Trigger_ChairDialogue", true);
			Entity_SetActive("Trigger_ReceiverDialogue", true);
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Encounter Tin Hinan in the torture room*
		
	//} END SCENE 3
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 3 *Find the extender in the RnD section*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////

		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are used by many events in Scene X here.*/

		//-------------------------------------------------------

		/*Put any functions that are used in more than one event in Scene X here.*/

		//-------------------------------------------------------

		//} END General	
		
		/////////////////////////////////////////
		// Event A *Encounter the wraith while carrying the extender*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbExtenderEncounterStarted = false;
		int mlExtenderPulseCount = 0;
		int mlExtenderActivatedCount = 0;
		bool mbExtenderPulseExtraRangeActive = false;
		float mfExtenderPulseExtraRange = 1.0f;
		bool mbExtenderPulsing = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Extender_RnD(const tString &in asParent, const tString &in asChild, int alState)
		{
			bool bBroken = mlExtenderActivatedCount < 2 && alState == 1;
			DarkWorldPowerExtender_SetBroken("PowerExtender_StorageRoom", bBroken);
			mlEmitterRadiusArea_RnD += alState;
			SetExtenderRadius();
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnPower_PowerExtender_StorageRoom(bool abActive, const tString&in asEntity)
		{
			if (mbStorageExtenderOutsideRnD) return;
			
			if (abActive)
			{
				mlExtenderPulseCount = 0;
				if (mbExtenderEncounterStarted == false)
				{
					mbExtenderEncounterStarted = true;
					Map_AddTimer("Timer_ActivateExtenderWraith", 0, "OnTimer_ActivateExtenderWraith");
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnExtenderPulse_PowerExtender_StorageRoom()
		{
			++mlExtenderPulseCount;
			if (mlExtenderPulseCount == 1)
			{
				++mlExtenderActivatedCount;
				
				if (mlExtenderActivatedCount <= 2) Seq_RndEmitterPulse("");
				
				if (mlExtenderActivatedCount == 1)
				{
					Voice_PlayDelayed("Dialogue_ExtenderZap", 0.25);
				}
				else if (mlExtenderActivatedCount >= 2)
				{
					DarkWorldPowerExtender_SetBroken("PowerExtender_StorageRoom", false);
					if (Wraith_GetAlertState("Wraith_ExtenderEncounter") <= 1)
					{
						Voice_PlayDelayed("Dialogue_WraithHearsExtender", 1.0);
					}
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateExtenderWraith(const tString &in asTimer)
		{
			Pregnancy_SetWhispering(true);
			
			Entity_SetActive("Trigger_THArrivalScene", false);
			Entity_SetActive("Trigger_CloseTortureMiddleDoor", false);
			Entity_SetActive("Trigger_PodIdle", false);
			
			Entity_SetActive("Door_TortureMiddlePhysics_*", false);
			Entity_SetActive("Door_TortureMiddle_*", true);
			SetRnDDoorState("Door_TortureMiddle", true, false, false);

						
			Entity_SetActive("Wraith_ExtenderEncounter", true);
//			Wraith_SetCallback_BeamSeen("Wraith_ExtenderEncounter", "OnBeamSeen_WraithHearsExtenderDialogue", 1);
			
			Wraith_ClearPlayerPath("Wraith_ExtenderEncounter");
			for (int i = 1; i <= 7; ++i) Wraith_AddPlayerPathNode("Wraith_ExtenderEncounter", "PlayerPath_ExtenderEncounter_" + i);
			
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_ExtenderEncounter");
			for (int i = 1; i <= 10; ++i) Wraith_ModeWraithPatrol_AddNode("Wraith_ExtenderEncounter", "PathNode_ExtenderWraith_" + i);
			Wraith_ModeWraithPatrol_Setup("Wraith_ExtenderEncounter", false, false);
			Wraith_ModeWraithPatrol_SetBurstTime("Wraith_ExtenderEncounter", 20.0f);
			Wraith_ModeWraithPatrol_SetLookAroundTime("Wraith_ExtenderEncounter", 15.0f);
			
//			Voice_PlayDelayed("Dialogue_WraithHearsExtender", 1);
			
			FearHandler_SetPermaFailRespawnArea("PermaFail_HappinessResearch");
			
			Agent_SetSoundVolume("Wraith_ExtenderEncounter", 0);
			
			Map_AddTimer("OnTimer_WraithWakeUpSound", 2.5f, "OnTimer_WraithWakeUpSound");
			Map_AddTimer("Timer_WraithStartPatrol", 2.0f, "OnTimer_WraithStartPatrol");
			Map_AddTimer("Timer_WraithEncounterMusic", 4.5f, "OnTimer_WraithEncounterMusic");
			
			Music_Play("A2_3_7_Wraith_Patrol_Stinger.ogg", 0.2f, false, eMusicPrio_MinorEvent);
			Sound_CreateAtEntity("Sound_ExtenderExplode", "03_07_DW_theatre/energy_extender_broken/extender_explosion", "PowerExtender_StorageRoom");
			
			Voice_Stop("Comments");
		}
		
		void OnTimer_WraithStartPatrol(const tString &in asTimer)
		{
			Wraith_Mode_Set("Wraith_ExtenderEncounter", eWraithMode_WraithPatrol, false);
		}
		
		void OnTimer_WraithWakeUpSound(const tString &in asTimer)
		{
			Agent_SetSoundVolume("Wraith_ExtenderEncounter", 1);
			Sound_CreateAtEntity("WraithIntroScream", "creatures/vocalisations/creature/wraith/intro_scream", "Wraith_ExtenderEncounter", 0, false, 1, 50, 60);
		}
		
		void OnTimer_WraithEncounterMusic(const tString &in asTimer)
		{
			Music_PlayExt("A2_3_7_Wraith_Patrol.ogg", true, 0.2f, 1.0f, 8.0f, 1.0f, eMusicPrio_SceneAmb , true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckExtenderExtraRange(const tString &in asTimer)
		{
			float fDist = cMath_Vector3Dist(Map_GetEntity("PowerExtender_StorageRoom").GetPosition(), Map_GetEntity("PowerEmitter_RnD").GetPosition());
			if (fDist < mfCustomRndEmitterRadius - mfExtenderPulseExtraRange || fDist > mfCustomRndEmitterRadius)
			{
				mbExtenderPulseExtraRangeActive = false;
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.2f, 0.4f));
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Encounter the wraith while carrying the extender*	
		
		/////////////////////////////////////////
		// Event A *Door to RnD closes after carrying the extender out of the RnD*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbStorageExtenderOutsideRnD = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Extender_OutsideRnD(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Entity_SetVarVector3f(asParent, "DoorwayEnterPos", Map_GetEntity(asChild).GetPosition());
			}
			else
			{
				cVector3f vEnterPos = Entity_GetVarVector3f(asParent, "DoorwayEnterPos");
				cVector3f vDir = Map_GetEntity(asChild).GetPosition() - vEnterPos;
				vDir.Normalize();
				float fDot = cMath_Vector3Dot(vDir, Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward());
				if (fDot > 0)
				{
					mbStorageExtenderOutsideRnD = true;
					Entity_SetActive("Trigger_CloseRnDDoor", true);
				}
				else
				{
					mbStorageExtenderOutsideRnD = false;
					Entity_SetActive("Trigger_CloseRnDDoor", false);
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_CloseRnDEntranceDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			//Sound_CreateAtEntity("RnDDoorClose", "03_03_herberts_hq/beam_filter/mechanism/junction_stop", "Door_RnDEntrancePhysics_Right");
			PhysicsSlideDoor_SetLocked("Door_RnDEntrancePhysics_*", true, true);
			FearHandler_SetPermaFailRespawnArea("PermaFail_TortureChamber");
			Seq_WraithFinale("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWraithFinale;
		void Seq_WraithFinale(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WraithFinale", mSequenceWraithFinale);
			if (Sequence_DoStepAndWait(0.5))
			{
				Pregnancy_SetWhispering(false);
				DarkWorldPowerExtender_SetBroken("PowerExtender_StorageRoom", false);
				Agent_SetSensesActive("Wraith_ExtenderEncounter", false);
				Wraith_CommandDash_Execute("Wraith_ExtenderEncounter", Map_GetEntity("Target_ExtenderEncounter_Disappear_1").GetPosition(), false, true, true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Music_Stop(2, eMusicPrio_SceneAmb);
				Sound_CreateAtEntity("WraithFinalScream", "creatures/vocalisations/creature/wraith/end_search", "Target_WraithFinalSound");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Door to RnD closes after carrying the extender out of the RnD*
		
		/////////////////////////////////////////
		// Event A *Return to the cattle tunnels*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool OnCollide_Intro(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_Play("A2_03_05_SafeArea", 0.4f, true, eMusicPrio_SceneAmb);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_LeaveLevelToTheater(const tString &in asEntity)
		{
			Map_ChangeMap("03_07_dwf_a_theatre", "Start_FromShuttleStation", "", "");
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Return to the cattle tunnels*		
		
		/////////////////////////////////////////
		// Event B *Climb up the ladder and see the RIFT*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_LookAtRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			Player_ChangeStateToNormal();
			PlayerBody_PlayCutsceneAtEntity("climb_up_dwf_b_rnd_platform", "Target_ClimbUpObsAnim", false, 0.5f, "OnAnimEnd_LookAtRift");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_LookAtRift(const tString &in asAnimName)
		{
			PlayerBody_PlayCutsceneAtEntity("climb_up_dwf_b_rnd_platform_glas_idle", "Target_ClimbUpObsAnim", true, 0.2f);
			Voice_PlayDelayed("Dialogue_TheView", 0.0f, -1, "OnDialogueEnd_TheView");
			Map_AddTimer("Timer_LookAtRailsCooldown", 100.0f, "");
			
			Map_AddTimer("Timer_ExitLookAtRiftIdle", 2.0f, "OnTimer_ExitLookAtRiftIdle");
		}
		
		//-------------------------------------------------------
		
		void OnDialogueEnd_TheView(const tString&in asScene, const tString&in asSubject)
		{
			Map_RemoveTimer("Timer_LookAtRailsCooldown");
			Map_AddTimer("Timer_LookAtRailsCooldown", 1.0f, "");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ExitLookAtRiftIdle(const tString &in asTimer)
		{
			PlayerBody_PlayCutsceneAtEntity("climb_up_dwf_b_rnd_platform_idle_lower_arm", "Target_ClimbUpObsAnim", false, 0.2f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_LookAtRails(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_LookAtRails", alState == 1);
			if (alState == -1)
			{
				Map_RemoveTimer("Timer_CheckLookAtRails");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Rails(const tString &in asEntity, int alState)
		{
			if (alState == 1) Map_AddTimer("Timer_CheckLookAtRails", 0.2f, "OnTimer_CheckLookAtRails");
			else Map_RemoveTimer("Timer_CheckLookAtRails");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckLookAtRails(const tString &in asTimer)
		{
			if (Map_TimerExists("Timer_LookAtRailsCooldown") == false)
			{
				Voice_Play("Dialogue_TheView_Longer");
				Entity_SetActive("Trigger_LookAtRailsArea", false);
				Entity_SetActive("Trigger_LookAtRails", false);
			}
			else
			{
				Map_AddTimer("Timer_CheckLookAtRails", cMath_RandRectf(0.2f, 0.4f), "OnTimer_CheckLookAtRails");
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Climb up the ladder and see the RIFT*
		
		/////////////////////////////////////////
		// Event B *Activate the power in the Shuttle Station and see the SHUTTLE RAIL and RIFT*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbShuttlePowerOn = false;
		int mlRailLightIndex = 0;
		int mlRaiLightUiIndex = 0;
		bool mbShuttleVitaeStandOut = false;
		bool mbLookingAtShuttle = false;
		float mfShuttleControlLightTime = 0;
		tID m_idShuttleControlLights = tID_Invalid;
			
		//-------------------------------------------------------
		
		void InitShuttleStation()
		{		
			Entity_SetEffectsActive("Indicator_ShuttleStationPowerLever", true, false);
			SetButtonColor("Indicator_ShuttleStationPowerLever", mButtonColor_Red);
			
			Lamp_SetLit("Lamp_ShuttleStation*", false, false);
			
			Lamp_SetLit("Lamp_PanelRails*", false, false);
			
			Lamp_SetLit("Lamp_PanelVitae*", false, false);
			Entity_SetActive("Lamp_PanelVitae*", false);
			
			Entity_SetActive("Lamp_PanelWorkingShuttle", false);
			Entity_SetActive("Lamp_PanelBrokenShuttle_*", false);
			
			SetButtonActive("Button_ShuttleVitae*", false);
			
			Button_SetDisabled("Door_ShuttleToPod_Button*", true, false);
						
			Entity_SetActive("Trigger_InsertVitae_1", false);
			Entity_SetActive("Lamp_PanelRails_*", false);
						
//			InitMeterEntity("VitaeCanister_Full_ShuttleStation");
			
			Light_SetBrightness("Light_Point_ShuttleVitae_*", 0.0f);
			
			Light_SetVisible("Light_Point_ShuttleVitaeMissing", false);
			
			Light_SetBrightness("Light_Point_SStationDoor_*", 0.0f);
			
			Lamp_SetLit("Lamp_ShuttleGate*", false, false);
						
			Entity_SetEffectsActive("PowerEmitter_ShuttleStation", false, false);
			
			SetRnDDoorState("Door_ShuttleStation", true, false);
			
			SetShuttleControlPanelActive(false, true);
			
			Entity_PlayAnimation("WorkingShuttle", "dwf_back_door_open", 0, false, false);
			Map_GetEntity("WorkingShuttle").GetMeshEntity().GetAnimationStateFromName("dwf_back_door_open").SetPaused(true);
			
			SetSmallControlPanelState("ShuttleControl_Left", eSmallControlPanelState_Disabled, true);
			SetSmallControlPanelState("ShuttleControl_Right", eSmallControlPanelState_Disabled, true);
			
			SetSmallControlPanelState("ShuttleOpen", eSmallControlPanelState_Disabled, true);
			SetSmallControlPanelState("ShuttleOpen_Broken_1", eSmallControlPanelState_Disabled, true);
			
			// shuttle main control panel
			{
				iLuxEntity@ pEnt = Map_GetEntity("ShuttleControl_Middle");
				cSubMeshEntity@ pLights = pEnt.GetMeshEntity().GetSubMeshEntityName("shuttle_lights");
				m_idShuttleControlLights = pLights.GetID();
				mfShuttleControlLightTime = -0.05;
				pLights.GetMaterial().SetUvAnimationSpeed(0, 0);
				pLights.GetMaterial().SetUvAnimationTime(0, mfShuttleControlLightTime);
			}
		}
		
		//-------------------------------------------------------
		
		bool mbShuttleControlActive = false;
		void SetShuttleControlPanelActive(bool abX, bool abInstant = false)
		{
			mbShuttleControlActive = abX;
//			SetSmallControlPanelState("ShuttleControl_Middle_LeverLeft", eSmallControlPanelState_Locked);
//			SetSmallControlPanelState("ShuttleControl_Middle_LeverRight", eSmallControlPanelState_Locked);
//			SetSmallControlPanelState("ShuttleControl_Right", eSmallControlPanelState_Locked);
			SetSmallControlPanelState("ShuttleControl_Left", abX ? eSmallControlPanelState_Unlocked : eSmallControlPanelState_Disabled);
			Lamp_SetLit("Lamp_ShuttlePlatform*", abX, !abInstant);
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChanged_ActivateShuttle(const tString &in asEntity, int alState)
		{
			if (Entity_GetVarInt("ShuttleControl_Left", "SmallControlPanelState") != eSmallControlPanelState_Unlocked) return;
			if (alState != 1) return;
			mbShuttlePowerOn = true;
			SetSmallControlPanelState("ShuttleControl_Left", eSmallControlPanelState_Active);
			Sketchbook_AddIdea("use_shuttle");
			Seq_ActivateShuttleStation("");
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ShuttleControLever(const tString &in asEntity)
		{
			if (Entity_GetVarInt("ShuttleControl_Left", "SmallControlPanelState") != eSmallControlPanelState_Unlocked) return;
			Player_StartLookAt("Target_ShuttleControlLever_LookAt", 1.0f, 1.25f, 1.5f, true);
			cLux_GetPlayer().AutomoveCharBodyTo(1.5f, 1.5f, 1.5f, Map_GetEntity("Target_ShuttleControlLever_MoveTo").GetPosition());
			Player_SetMoveSpeedMul(0);
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_ShuttleControLever(const tString &in asEntity)
		{
			Player_StopLookAt(1);
			cLux_GetPlayer().StopAutomoveCharBody();
			Player_SetMoveSpeedMul(1);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqActivateShuttleStation;
		void Seq_ActivateShuttleStation(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ActivateShuttleStation", mSeqActivateShuttleStation);
			if (Sequence_DoStepAndWait(0.5f))
			{
				Entity_SetActive("Trigger_TasiNearsTheShuttleDialogue", true);
				Entity_SetActive("Trigger_TasiAboutToUseShuttleDialogue", true);
				Entity_SetActive("Trigger_ShuttleLookAt", true);
				
				// disable dialogue
				Entity_SetActive("Trigger_ShuttleStationAgainDialogueArea_*", false);
				Entity_SetActive("Trigger_SeeShuttleStationAgainDialogue_*", false);
				Voice_StopCheckTimer("Dialogue_SeeShuttleStationAgain");
				Entity_SetActive("Trigger_LookAtRift", false);
				
				// turn off shuttle maintenance
				Lamp_SetLit("shuttle_maintenance_lamp_*", false, true);
				Light_FadeBrightnessTo("shuttle_maintenance_light_*", 0, 0.5);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Entity_SetEffectsActive("PowerEmitter_ShuttleStation", true, true);
				
				Light_FadeBrightnessToDefault("Light_Point_ShuttleStation*", 0.5f);
				Lamp_SetLit("Lamp_ShuttleStation*", true, true);
				
				Entity_SetActive("Lamp_PanelWorkingShuttle", true);
				Lamp_SetLit("Lamp_PanelWorkingShuttle*", true, true);
				
				Entity_SetActive("Lamp_PanelBrokenShuttle_*", true);
				Lamp_SetLit("Lamp_PanelBrokenShuttle_*", true, true);
				
				Light_SetVisible("Light_PanelMissingVitae", false);
				
				Sound_CreateAtEntity("ShuttleStationLightsOn", "03_07_dw_factory/level/torture_room_lights", "WorkingShuttle");
				
				iLuxEntity@ pEnt = Map_GetEntity("ShuttleControl_Middle");
				cSubMeshEntity@ pLights = pEnt.GetMeshEntity().GetSubMeshEntityName("shuttle_lights");
				mfShuttleControlLightTime = 0.5;
				pLights.GetMaterial().SetUvAnimationSpeed(0, 0);
				pLights.GetMaterial().SetUvAnimationTime(0, mfShuttleControlLightTime);
				
//				Music_PlayExt("A2_3_6_SafeArea", false, 0.4f, 1.0f, 3.0f, 0.0f, eMusicPrio_SceneAmb, false);

				Sound_Play("Sound_StationStart_1", 0.0f);
				Sound_Play("Sound_StationStart_2", 2.0f);
				Sound_Play("Sound_StationLoop", 2.0f);
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Sound_CreateAtEntity("ShuttleActivates", "03_03_herberts_hq/beam_filter/mechanism/junction_stop", "WorkingShuttle");
				Lamp_SetLit("Lamp_ShuttleGate*", true, true);
				
				SetSmallControlPanelState("ShuttleOpen", eSmallControlPanelState_Unlocked);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
//				Lamp_SetLit("Lamp_PanelRails*", true, true);
				OnTimer_ActivateRailLights("");
//				OnTimer_ActivateRailUi("");
				Sound_Play("Sound_RailLoop", 2.0f);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Voice_PlayWhenPossible("Dialogue_ShuttleLightsUp", "OnVoiceCondition_ShuttleLightsUp", 7, 2);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnVoiceCondition_ShuttleLightsUp(const tString& in asSubject)
		{
			return mbLookingAtShuttle;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_ShuttleLightSupDialogue(const tString &in asEntity, int alState)
		{
			mbLookingAtShuttle = alState == 1;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateRailLights(const tString &in asTimer)
		{
			++mlRailLightIndex;
			tString sEntityName = "dwf_railing_light_" + mlRailLightIndex;
			iLuxEntity@ pEnt = Map_GetEntity(sEntityName);
			if (pEnt is null)
			{
				SequenceStates_Resume("Seq_ActivateShuttleStation");
				return;
			}
			
			Sound_CreateAtEntity("LightOn_" + mlRailLightIndex, "03_07_dw_factory/spotlight/on", sEntityName);
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("LightOn_" + mlRailLightIndex);
			pSound.SetCustomMaxDistance(100.0f);
			pSound.SetCustomMinDistance(20.0f);
			pSound.SetUseCustomProperties(true);
			
			Lamp_SetLit(sEntityName, true, true);
			
			Map_AddTimer("Timer_ActivateRailLights", 0.4f, "OnTimer_ActivateRailLights");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateRailUi(const tString &in asTimer)
		{
			++mlRaiLightUiIndex;
			
			iLuxEntity@ pEnt = Map_GetEntity("Lamp_PanelRails_" + mlRaiLightUiIndex);
			if (pEnt is null) return;
			
			Entity_SetActive("Lamp_PanelRails_" + mlRaiLightUiIndex, true);
			Lamp_SetLit("Lamp_PanelRails_" + mlRaiLightUiIndex, true, true);
			
			Map_AddTimer("Timer_ActivateRailUi", 0.6f, "OnTimer_ActivateRailUi");
		}

		//-------------------------------------------------------
		
		void OnTimer_TurnOffSendShuttle(const tString &in asTimer)
		{
			Map_AddTimer("TurnOffSendShuttleCooldown", 0.55, "");
			Entity_FadeEffectBaseColor("Lamp_PanelVitae_Missing", Entity_GetEffectBaseColor("Lamp_PanelVitae_Missing") * (1.0f/4.0f), 0.5f);
			Entity_FadeEffectBaseColor("Lamp_PanelVitae_Full", Entity_GetEffectBaseColor("Lamp_PanelVitae_Full") * (1.0f/4.0f), 0.5f);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_BrokenVitaeCanister(const tString &in asEntity)
		{
			Voice_PlayDelayed("Dialogue_OutOfGas", 0.5f);
			Entity_SetActive("Trigger_ShuttlePlaceFullVitae", true);
			Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_OutOfGas");
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChanged_OpenShuttle(const tString &in asEntity, int alState)
		{
			if (Entity_GetVarInt(asEntity, "SmallControlPanelState") != eSmallControlPanelState_Unlocked) return;
			if (alState != 1) return;
			SetSmallControlPanelState(asEntity, eSmallControlPanelState_Active);
			Seq_OpenShuttle("");
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ShuttleOpenLever(const tString &in asEntity)
		{
			if (Entity_GetVarInt(asEntity, "SmallControlPanelState") != eSmallControlPanelState_Unlocked) return;
			Player_StartLookAt("Target_ShuttleControlLever_LookAt_1", 1.0f, 1.25f, 1.5f, true);
			cLux_GetPlayer().AutomoveCharBodyTo(1.5f, 1.5f, 1.5f, Map_GetEntity("Target_ShuttleControlLever_MoveTo_1").GetPosition());
			Player_SetMoveSpeedMul(0);
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_ShuttleOpenLever(const tString &in asEntity)
		{
			Player_StopLookAt(1);
			cLux_GetPlayer().StopAutomoveCharBody();
			Player_SetMoveSpeedMul(1);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceOpenShuttle;
		void Seq_OpenShuttle(const tString &in asTimer)
		{
			Sequence_Begin("Seq_OpenShuttle", mSequenceOpenShuttle);
			if (Sequence_DoStepAndWait(0.5))
			{
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Entity_SetActive("Trigger_StartShuttle", true);
				Entity_SetActive("block_box_working_shuttle_door*", false);
				Entity_PlayAnimation("WorkingShuttle", "dwf_back_door_open", 0, false, false);
				Sound_CreateAtEntity("ShuttleDoorOpen", "03_07_dw_factory/shuttle/shuttle_open", "WorkingShuttle");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Activate the power in the Shuttle Station and see the SHUTTLE RAIL and RIFT*
		
	//} END SCENE 3
	
