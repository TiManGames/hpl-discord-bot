		//} END Event A *Get pushed out of the torture room by a wraith*

		/////////////////////////////////////////
		// Event A *Sneak past the wraith back into the Torture Room*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		void SetupHappyToTortureEncounter()
		{
			Entity_SetActive("Trigger_StartHappyToTorture", true);
			Entity_SetActive("Trigger_ResumeHappyToTorture", true);
			
			FearHandler_SetPermaFailRespawnArea("PermaFail_HappyToTorture");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartHappyToTorture(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_HappyToTorture("");
			return false;
		}
		
		cSequenceStatesData mSeqHappyToTorture;
		void Seq_HappyToTorture(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HappyToTorture", mSeqHappyToTorture);
			if (Sequence_DoStepAndWait(0.5f))
			{
				Entity_SetActive("Wraith_HappyToTorture", true);
				Wraith_SetCallback_Pulse("Wraith_HappyToTorture", "OnWraithPulse_PullUpAmulet", true);
				Wraith_SetHearing("Wraith_HappyToTorture", false);
				Wraith_SetCallback_Alerted("Wraith_HappyToTorture", "OnAlerted_CancelHappyToTorture");
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{
				Wraith_TurnSpotlightToPos("Wraith_HappyToTorture", Map_GetEntity("Target_HappyToTorture_LookAt_1").GetPosition(), true);
				CharMover_TurnToEntity("Wraith_HappyToTorture", "Target_HappyToTorture_LookAt_1");
			}
			else if (Sequence_DoStepAndPause(0.1f))
			{
				Wraith_SetHearing("Wraith_HappyToTorture", true);
				Wraith_CommandPatrol_ClearNodes("Wraith_HappyToTorture");
				Wraith_CommandPatrol_AddNode("Wraith_HappyToTorture", "PathNode_HappyToTorture_1_1");
				Wraith_CommandPatrol_Execute("Wraith_HappyToTorture", true, 0, false, true, eWraithSpeed_Walk, "OnCommandEnd_ResumeHappyToTorture");
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Wraith_TurnSpotlightToPos("Wraith_HappyToTorture", Map_GetEntity("Target_HappyToTorture_LookAt_2").GetPosition(), true, true, 3);
			}
			else if (Sequence_DoStepAndPause(0.0f))
			{
				Wraith_ModeWraithPatrol_ClearNodes("Wraith_HappyToTorture");
				Wraith_ModeWraithPatrol_AddNode("Wraith_HappyToTorture", "PathNode_HappyToTorture_1_2");
				Wraith_ModeWraithPatrol_Setup("Wraith_HappyToTorture", false, false);
				Wraith_ModeWraithPatrol_SetPulseTime("Wraith_HappyToTorture", 30.0f);
				Wraith_ModeWraithPatrol_SetBurstTime("Wraith_HappyToTorture", 20.0f);
				Wraith_Mode_Set("Wraith_HappyToTorture", eWraithMode_WraithPatrol, true);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Wraith_ModeWraithPatrol_ClearNodes("Wraith_HappyToTorture");
				Wraith_ModeWraithPatrol_AddNode("Wraith_HappyToTorture", "PathNode_HappyToTorture_2_1");
				Wraith_ModeWraithPatrol_AddNode("Wraith_HappyToTorture", "PathNode_HappyToTorture_2_2");
				Wraith_ModeWraithPatrol_AddNode("Wraith_HappyToTorture", "PathNode_HappyToTorture_2_3");
				Wraith_ModeWraithPatrol_Setup("Wraith_HappyToTorture", false, false);
				Wraith_ModeWraithPatrol_SetPulseTime("Wraith_HappyToTorture", 30.0f);
				Wraith_ModeWraithPatrol_SetBurstTime("Wraith_HappyToTorture", 20.0f);
				Wraith_Mode_Set("Wraith_HappyToTorture", eWraithMode_WraithPatrol, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_ResumeHappyToTorture(const tString &in asEntity)
		{
			SequenceStates_Resume("Seq_HappyToTorture");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Wraith_ResumeHappyToTorture(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceStates_Resume("Seq_HappyToTorture");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnAlerted_CancelHappyToTorture(const tString &in asEntityName)
		{
			Wraith_Command_Remove("Wraith_HappyToTorture", false);
			
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_HappyToTorture");
			Wraith_ModeWraithPatrol_AddNode("Wraith_HappyToTorture", "PathNode_HappyToTorture_2_1");
			Wraith_ModeWraithPatrol_AddNode("Wraith_HappyToTorture", "PathNode_HappyToTorture_2_2");
			Wraith_ModeWraithPatrol_AddNode("Wraith_HappyToTorture", "PathNode_HappyToTorture_2_3");
			Wraith_ModeWraithPatrol_Setup("Wraith_HappyToTorture", false, false);
			Wraith_ModeWraithPatrol_SetPulseTime("Wraith_HappyToTorture", 30.0f);
			Wraith_ModeWraithPatrol_SetBurstTime("Wraith_HappyToTorture", 20.0f);
			Wraith_Mode_Set("Wraith_HappyToTorture", eWraithMode_WraithPatrol, false);
			
			Wraith_SetCallback_Alerted("Wraith_HappyToTorture", "");
		}
		
