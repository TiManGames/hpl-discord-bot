		void OnTimer_SetTortureWindowBlockerInactive(const tString &in asTimer)
		{
			Entity_SetActive(asTimer, false);
		}
		
		//-------------------------------------------------------
		
		array<tID> mvTorturePipes;
		array<float> mvTorturePipes_Times;
		array<tID> mvRobotArmPipe_Id;
		array<float> mvRobotArmPipe_Timer;
		array<float> mvRobotArmPipe_StartTime;
		array<float> mvRobotArmPipe_EndTime;
		array<float> mvRobotArmPipe_AnimTime;
		array<eEasing> mvRobotArmPipe_Easing;
		array<int> mvRobotArmPipe_TorturePipeId;
		bool mbTopTubesFilled = false;
		bool mbBottomTubesFilled = false;
		bool mbQuickFill = false;
		
		void UpdateRobotArmPipes(float afTimeStep)
		{
			for (int i = 0; i < mvRobotArmPipe_Id.size(); ++i)
			{
				cSubMeshEntity@ pSubMesh = cLux_ID_SubMeshEntity(mvRobotArmPipe_Id[i]);
				float fTimer = mvRobotArmPipe_Timer[i];
				fTimer += afTimeStep;
				mvRobotArmPipe_Timer[i] = fTimer;
				
				float fT = cMath_Clamp(fTimer / mvRobotArmPipe_AnimTime[i], 0.0f, 1.0f);
				fT = cMath_Easing(mvRobotArmPipe_Easing[i], fT, 0.0f, 1.0f);
				float fNewTime = cMath_InterpolateLinear(mvRobotArmPipe_StartTime[i], mvRobotArmPipe_EndTime[i], fT);
				if (pSubMesh !is null) pSubMesh.GetMaterial().SetUvAnimationTime(0, fNewTime);
				mvTorturePipes_Times[mvRobotArmPipe_TorturePipeId[i]] = fNewTime;
								
				if (fT >= 1.0f)
				{
					mvRobotArmPipe_Id.removeAt(i);
					mvRobotArmPipe_Timer.removeAt(i);
					mvRobotArmPipe_StartTime.removeAt(i);
					mvRobotArmPipe_EndTime.removeAt(i);
					mvRobotArmPipe_AnimTime.removeAt(i);
					mvRobotArmPipe_Easing.removeAt(i);
					mvRobotArmPipe_TorturePipeId.removeAt(i);
					i--;
				}
			}
		}
		
		void AnimateRobotArmPipe(tID a_idSubMesh, int alTorturePipeId, float afStartTime, float afEndTime, float afAnimTime, eEasing aEasing)
		{
			cMaterial@ pMat = cLux_ID_SubMeshEntity(a_idSubMesh).GetMaterial();
			pMat.SetUvAnimationSpeed(0, 0);
			pMat.SetUvAnimationTime(0, afStartTime);
			
			mvRobotArmPipe_Id.push_back(a_idSubMesh);
			mvRobotArmPipe_Timer.push_back(0);
			mvRobotArmPipe_StartTime.push_back(afStartTime);
			mvRobotArmPipe_EndTime.push_back(afEndTime);
			mvRobotArmPipe_AnimTime.push_back(afAnimTime);
			mvRobotArmPipe_Easing.push_back(aEasing);
			mvRobotArmPipe_TorturePipeId.push_back(alTorturePipeId);
		}
		
		void FillUpRobotArmPipe(int alId, int alTorturePipeId)
		{
			cSubMeshEntity@ pSubMesh = Map_GetEntity("TortureArm_" + alId).GetMeshEntity().GetSubMeshEntityName("m_Arm_" + alId + "_tubes_inner");
			AnimateRobotArmPipe(pSubMesh.GetID(), alTorturePipeId, 0.01, 0.136, mbQuickFill ? 0.2 : 1.0, eEasing_Linear);
		}
		
		void EmptyRobotArmPipe(int alId, int alTorturePipeId)
		{
			cSubMeshEntity@ pSubMesh = Map_GetEntity("TortureArm_" + alId).GetMeshEntity().GetSubMeshEntityName("m_Arm_" + alId + "_tubes_inner");
			AnimateRobotArmPipe(pSubMesh.GetID(), alTorturePipeId, 0.505, 0.635, mbQuickFill ? 0.2 : 1.0, eEasing_Linear);
		}
		
		void FillUpTopTortureTubes(bool abSaveState = true, bool abQuick = false)
		{
			if (abSaveState && mbTopTubesFilled) return;
			if (abSaveState) mbTopTubesFilled = true;
			if (mbTortureRoomOn == false && abSaveState) return;
			
			mbQuickFill = abQuick;
			
			float fFillTime = abQuick ? 0.2 : 1.2;
			AnimateRobotArmPipe(Map_GetEntity("TortureTubes").GetMeshEntity().GetSubMeshEntityName("tubes_inner_top").GetID(), eTorturePipe_Top, 0.0, 0.37, fFillTime, eEasing_Linear);
			
			Map_AddTimer("Timer_FillUpWaterArmPipe", fFillTime, "OnTimer_FillUpWaterArmPipe");
		}
		
		void EmptyTopTortureTubes(bool abSaveState = true, bool abQuick = false)
		{
			if (abSaveState && mbTopTubesFilled == false) return;
			if (abSaveState) mbTopTubesFilled = false;
			if (mbTortureRoomOn == false && abSaveState) return;
			
			mbQuickFill = abQuick;
			
			float fFillTime = abQuick ? 0.2 : 1.2;
			AnimateRobotArmPipe(Map_GetEntity("TortureTubes").GetMeshEntity().GetSubMeshEntityName("tubes_inner_top").GetID(), eTorturePipe_Top, 0.5, 0.87, fFillTime, eEasing_Linear);
			
			Map_AddTimer("Timer_EmptyWaterArmPipe", fFillTime, "OnTimer_EmptyWaterArmPipe");
		}
		
		void FillUpBottomTortureTubes(bool abSaveState = true, bool abQuick = false)
		{
			if (abSaveState && mbBottomTubesFilled) return;
			if (abSaveState) mbBottomTubesFilled = true;
			if (mbTortureRoomOn == false && abSaveState) return;
			
			mbQuickFill = abQuick;
			
			float fFillTime = abQuick ? 0.2 : 1.2;
			AnimateRobotArmPipe(Map_GetEntity("TortureTubes").GetMeshEntity().GetSubMeshEntityName("tubes_inner_bottom").GetID(), eTorturePipe_Bottom, 0.0, 0.35, fFillTime, eEasing_Linear);
			
			Map_AddTimer("Timer_FillUpGasArmPipes", fFillTime, "OnTimer_FillUpGasArmPipes");
		}
		
		void EmptyBottomTortureTubes(bool abSaveState = true, bool abQuick = false)
		{
			if (abSaveState && mbBottomTubesFilled == false) return;
			if (abSaveState) mbBottomTubesFilled = false;
			if (mbTortureRoomOn == false && abSaveState) return;
			
			mbQuickFill = abQuick;
			
			float fFillTime = abQuick ? 0.2 : 1.2;
			AnimateRobotArmPipe(Map_GetEntity("TortureTubes").GetMeshEntity().GetSubMeshEntityName("tubes_inner_bottom").GetID(), eTorturePipe_Bottom, 0.5, 0.85, fFillTime, eEasing_Linear);
			
			Map_AddTimer("Timer_EmptyGasArmPipes", fFillTime, "OnTimer_EmptyGasArmPipes");
		}
		
		//-------------------------------------------------------
		
		bool OnAttach_TortureCard(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Sound_CreateAtEntity("AttachTortureCard", "03_07_dw_factory/torture_machine/card_add", asStickyArea);
			if (mbTorture_Over) return true;
			
			tString sEntity = Body_GetEntityName(asBodyName);
			if (cString_GetFirstStringPos(sEntity, "Drilling") >= 0) mSelectedTorture = eTortureType_Drilling;
			else if (cString_GetFirstStringPos(sEntity, "Burning") >= 0) mSelectedTorture = eTortureType_Burning;
			else if (cString_GetFirstStringPos(sEntity, "Drowning") >= 0) mSelectedTorture = eTortureType_Drowning;
			
			SetRobotArmsColor();
			SetCanisterIndicatorColor();
			
			SetTortureCardSlotState(false, false);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnDetach_TortureCard(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Sound_CreateAtEntity("AttachTortureCard", "03_07_dw_factory/torture_machine/card_remove", asStickyArea);
			if (mbTorture_Over) return;
			
			SetTortureCardSlotState(true, false);
			
			mSelectedTorture = eTortureType_None;
			
			SetRobotArmsColor();
			SetCanisterIndicatorColor();
		}
		
		//-------------------------------------------------------
		
		bool OnAttach_RobotArm(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Sound_CreateAtEntity("TortureSourceDetach", "03_07_dw_factory/torture_machine/torture_tools/flame/flame_attach", asStickyArea);
			if (mbTorture_Over) return true;
			
			int lArmIndex = cString_GetNumericSuffixInt(asStickyArea, -1);
			tString sEntity = Body_GetEntityName(asBodyName);
			cVector3f vRotationOffset = cVector3f_Zero;
			cVector3f vTranslationOffset = cVector3f_Zero;
			
			if (cString_GetFirstStringPos(sEntity, "Drill") >= 0)
			{
				vRotationOffset = cVector3f(0,0,0);
				vTranslationOffset = cVector3f(0, 0, 0.14);
				mvRobotArmAttach[lArmIndex - 1] = sEntity;
				mvRobotArmAttachType[lArmIndex - 1] = "Drill";
			}
			else if (cString_GetFirstStringPos(sEntity, "Burner") >= 0)
			{
				vRotationOffset = cVector3f(0,90,0);
				vTranslationOffset = cVector3f(-0.12, 0, 0);
				mvRobotArmAttach[lArmIndex - 1] = sEntity;
				mvRobotArmAttachType[lArmIndex - 1] = "Burner";
			}
			else if (cString_GetFirstStringPos(sEntity, "Drowner") >= 0)
			{
				vRotationOffset = cVector3f(0, 0, 0);
				vTranslationOffset = cVector3f(0, 0, 0.14);
				mvRobotArmAttach[lArmIndex - 1] = sEntity;
				mvRobotArmAttachType[lArmIndex - 1] = "Drowner";
			}
			StickyArea_SetRotationOffset(asStickyArea, vRotationOffset);
			StickyArea_SetTranslationOffset(asStickyArea, vTranslationOffset);
			
			CheckRobotArm(lArmIndex, true);
			if (mvRobotArmState[lArmIndex - 1] == 2) DoRobotArmTestRun(lArmIndex);
			SetRobotArmsColor();
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnDetach_RobotArm(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Sound_CreateAtEntity("TortureSourceDetach", "02_04_living_quarters/winch/winch_stop", asStickyArea);
			if (mbTorture_Over) return;
			
			int lArmIndex = cString_GetNumericSuffixInt(asStickyArea, -1);
			
			tString sTool = mvRobotArmAttach[lArmIndex - 1];
			if (cString_GetFirstStringPos(sTool, "Burner") >= 0) SetBurnerState(sTool, 0, 0.5);
			
			mvRobotArmAttach[lArmIndex - 1] = "";
			mvRobotArmAttachType[lArmIndex - 1] = "";
			CheckRobotArm(lArmIndex);
			SetRobotArmsColor();
		}
		
		//-------------------------------------------------------
		
		void SetRobotArmsColor(bool abSetupCheck = false)
		{
			eTortureType lToolSetup = GetTortureToolsSetup();
			for (int i = 1; i <= 5; ++i)
			{
				cColor ringColor = mRobotArmRingColor_Off;
				if (mSelectedTorture == eTortureType_None || mbTorture_Over || mbTortureRoomOn == false)
				{
					FadeRobotArmRingColor(i, mRobotArmRingColor_Off);
				}
				else if (abSetupCheck)
				{
					if (mSelectedTorture == lToolSetup) FadeRobotArmRingColor(i, mRobotArmRingColor_Correct);
					else FadeRobotArmRingColor(i, mRobotArmRingColor_Wrong * 3, 0.5, -1, true, mRobotArmRingColor_Wrong);
				}
				else
				{
					if (mvRobotArmAttach[i - 1] == "") FadeRobotArmRingColor(i, mRobotArmRingColor_Default);
					else FadeRobotArmRingColor(i, mRobotArmRingColor_Off);
				}
			}
		}
		
		//-------------------------------------------------------
		
		bool OnAttach_TortureSource(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Sound_CreateAtEntity("TortureSourceCorrect", "03_07_dw_factory/torture_victim/machine_feedback/attach_positive", asStickyArea);
			if (mbTorture_Over) return true;
			
			tString sSource = Body_GetEntityName(asBodyName);
			if (cString_GetFirstStringPos(sSource, "Gas") >= 0) msTortureSource = "Gas";
			else if (cString_GetFirstStringPos(sSource, "Water") >= 0) msTortureSource = "Water";
			else msTortureSource = "";
			msTortureSourceEntity = msTortureSource == "" ? "" : sSource;
			
			for (int i = 1; i <= 5; ++i) CheckRobotArm(i, false);
			
			PowerUpCanisterSocket();
			SetRobotArmsColor();
			return true;
		}
		
		//-------------------------------------------------------
		
		void PowerUpCanisterSocket(bool abAttach = true)
		{
			eTortureType lSocketSetup = GetCanisterSetup();
			DoActiveRobotArmTestRun();
							
			SetCanisterIndicatorState(0);
			if (lSocketSetup == eTortureType_Burning)
			{
				FillUpBottomTortureTubes();
				if (abAttach) Sound_CreateAtEntity("TortureSourceTest", "03_07_dw_factory/torture_machine/canister/flame_insert", "Sticky_TortureSource");
			}
			else if (lSocketSetup == eTortureType_Drowning)
			{
				FillUpTopTortureTubes();
				if (abAttach) Sound_CreateAtEntity("TortureSourceTest", "03_07_dw_factory/torture_machine/canister/water_insert", "Sticky_TortureSource");
			}
		}
		
		//-------------------------------------------------------
		
		void PowerDownCanisterSocket(bool abDetach = true)
		{
			eTortureType lSocketSetup = GetCanisterSetup();
			if (lSocketSetup == eTortureType_Burning)
			{
				EmptyBottomTortureTubes();
			}
			else if (lSocketSetup == eTortureType_Drowning)
			{
				EmptyTopTortureTubes();
			}
			
			if (abDetach && mSelectedTorture != eTortureType_None) SetCanisterIndicatorState(1);
			else SetCanisterIndicatorState(0);
		}
		
		//-------------------------------------------------------
		
		void SetCanisterIndicatorColor(bool abSetupCheck = false)
		{
			if (mSelectedTorture == eTortureType_None)
			{
				SetCanisterIndicatorState(0);
			}
			else
			{
				if (abSetupCheck)
				{
					eTortureType lSocketSetup = GetCanisterSetup();
					if (lSocketSetup == mSelectedTorture) SetCanisterIndicatorState(3);
					else SetCanisterIndicatorState(2);
				}
				else
				{
					SetCanisterIndicatorState(1);
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UnlockCanisterSocket(const tString &in asTimer)
		{
			SetCanisterSocketLocked(false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FillUpGasArmPipes(const tString &in asTimer)
		{
			FillUpRobotArmPipe(1, eTorturePipe_Arm1);
			FillUpRobotArmPipe(2, eTorturePipe_Arm2);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FillUpWaterArmPipe(const tString &in asTimer)
		{
			FillUpRobotArmPipe(5, eTorturePipe_Arm5);
		}

		//-------------------------------------------------------
		
		void OnDetach_TortureSource(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Sound_CreateAtEntity("TortureSourceDetach", "02_04_living_quarters/winch/winch_stop", asStickyArea);
			if (mbTorture_Over) return;
			
			PowerDownCanisterSocket();
			SetRobotArmsColor();
			TurnOffActiveRobotArmTestIdle();
			
			msTortureSource = "";
			msTortureSourceEntity = "";
			
			for (int i = 1; i <= 5; ++i) CheckRobotArm(i, false);
			
			Entity_SetActive("Sticky_TortureSource", false);
			mbPower_CanisterBlockerActive = true;
			if (mbTortureRoomOn) Entity_SetActive("Blocker_CanisterSocket", true);
			Map_AddTimer("Timer_ActivateCanisterSocketSticky", 1.0, "OnTimer_ActivateCanisterSocketSticky");
			Map_AddTimer("Timer_DeactivateCanisterSocketBlocker", 1.2, "OnTimer_DeactivateCanisterSocketBlocker");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateCanisterSocketSticky(const tString &in asTimer)
		{
			Entity_SetActive("Sticky_TortureSource", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivateCanisterSocketBlocker(const tString &in asTimer)
		{
			mbPower_CanisterBlockerActive = false;
			if (mbTortureRoomOn) Entity_SetActive("Blocker_CanisterSocket", false);
		}
		
