			StickyArea_SetRotationOffset("Sticky_RobotArm_5", vRotationOffset);
			StickyArea_SetTranslationOffset("Sticky_RobotArm_5", vTranslationOffset);
			StickyArea_AttachEntity("Sticky_TortureSource", "TortureCanister_Water", "");
			StickyArea_AttachEntity("Sticky_RobotArm_5", "TortureTool_Drowner", "");
			
			msTortureType = "drowning";
			mSelectedTorture = eTortureType_Drowning;
			
			mvRobotArmState[0] = 0;
			mvRobotArmState[1] = 0;
			mvRobotArmState[2] = 0;
			mvRobotArmState[3] = 0;
			mvRobotArmState[4] = 2;
			
			mbTortureRoomOn = true;
			
			Seq_VictimIsBroughtForward("");
			Lamp_SetLit("Lamp_TorturePanel_*", true, true);
			Lamp_SetLit("Lamp_TortureBooth_*", true, true);
			return;
			return;
			mbRadiusTest = false;
			mbExtenderEncounterStarted = true;
			Player_Teleport("Start_HappinessResearch");
