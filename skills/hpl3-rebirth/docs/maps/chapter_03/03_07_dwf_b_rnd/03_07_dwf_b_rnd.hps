	//-------------------------------------------------------
	
	void OnConnectionStateChange_RnDDoorButton(const tString &in asEntity, int alState)
	{
		tString sDoor = Entity_GetVarString(asEntity, "");
		
		tString sDoorLeft = sDoor + "_Left";
		if (SlideDoor_GetOpenAmount(sDoorLeft) > 0) SlideDoor_SetOpenAmount(sDoorLeft, 0);
		else SlideDoor_SetOpenAmount(sDoorLeft, 1);
		
		tString sDoorRight = sDoor + "_Right";
		if (SlideDoor_GetOpenAmount(sDoorRight) > 0) SlideDoor_SetOpenAmount(sDoorRight, 0);
		else SlideDoor_SetOpenAmount(sDoorRight, 1);
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_CloseRnDDoor(const tString &in asParent, const tString &in asChild, int alState)
	{
		iLuxEntity@ pTrigger = Map_GetEntity(asParent);		
		if (alState == 1)
		{
			cVector3f vEnterDir = cMath_Vector3Project(Player_GetPosition() - pTrigger.GetPosition(), pTrigger.GetMatrix().GetTranspose().GetForward());
			Entity_SetVarVector3f(asParent, "CloseDoor_EnterDir", vEnterDir);
		}
		else
		{
			cVector3f vEnterDir = Entity_GetVarVector3f(asParent, "CloseDoor_EnterDir");
			cVector3f vDir = cMath_Vector3Project(Player_GetPosition() - pTrigger.GetPosition(), pTrigger.GetMatrix().GetTranspose().GetForward());
			float fDot = cMath_Vector3Dot(vDir, vEnterDir);
			if (fDot <= 0)
			{
				tString sDoor = Entity_GetVarString(asParent, "");
				if (Button_IsSwitchedOn(sDoor + "_Button_1"))
				{
					Button_SetSwitchedOn(sDoor + "_Button_*", false, true);
				}
			}
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	tString msEntityChain_Entity;
	tString msEntityChain_Callback;
	int mlEntityChain_FromIndex = 0;
	int mlEntityChain_ToIndex = 0;
	int mlEntityChain_Index = 0;
	float mfEntityChain_Time = 0;
	bool mbEntityChain_Activate = true;
	
	void ActivateEntityChain(const tString &in asEntity, int alFrom, int alTo, float afTime, const tString &in asCallback = "")
	{
		ActivateEntityChainGeneric(asEntity, true, alFrom, alTo, afTime, asCallback);
	}
	
	void DeactivateEntityChain(const tString &in asEntity, int alFrom, int alTo, float afTime, const tString &in asCallback = "")
	{
		ActivateEntityChainGeneric(asEntity, false, alFrom, alTo, afTime, asCallback);
	}
	
	void ActivateEntityChainGeneric(const tString &in asEntity, bool abActivate, int alFrom, int alTo, float afTime, const tString &in asCallback = "")
	{
		msEntityChain_Entity = asEntity;
		mbEntityChain_Activate = abActivate;
		mlEntityChain_FromIndex = alFrom;
		mlEntityChain_ToIndex = alTo;
		mfEntityChain_Time = afTime;
		mlEntityChain_Index = mlEntityChain_FromIndex;
		msEntityChain_Callback = asCallback;
		Map_AddTimer("Timer_ActivateEntityChain", afTime, "OnTimer_ActivateEntityChain");
	}
	
	void OnTimer_ActivateEntityChain(const tString &in asTimer)
	{
		Entity_SetActive(msEntityChain_Entity + "_" + mlEntityChain_Index, mbEntityChain_Activate);
		int lSign = cMath_Sign(mlEntityChain_ToIndex - mlEntityChain_FromIndex);
		mlEntityChain_Index += lSign;
		if (mlEntityChain_Index != mlEntityChain_ToIndex + lSign) Map_AddTimer("Timer_ActivateEntityChain", mfEntityChain_Time, "OnTimer_ActivateEntityChain");
		else if (msEntityChain_Callback != "") Map_AddTimer(msEntityChain_Callback, 0.0f, msEntityChain_Callback);
	}
	
	//-------------------------------------------------------
	
	tString msPeriodicVoice_Subject;
	cVector2f mvPeriodicVoice_Time;
	bool mbPeriodicVoice_Playing = false;
	
	void Voice_PlayPeriodically(const tString &in asSubject, float afMinTime, float afMaxTime, float afFirstTime = -1)
	{
		msPeriodicVoice_Subject = asSubject;
		mvPeriodicVoice_Time.x = afMinTime;
		mvPeriodicVoice_Time.y = afMaxTime;
		
		float fTime = afFirstTime;
		if (fTime < 0) fTime = cMath_RandRectf(mvPeriodicVoice_Time.x, mvPeriodicVoice_Time.y);
		Map_RemoveTimer("Timer_PlayPeriodicVoice");
		Map_RemoveTimer("Timer_CheckPeriodicVoice");
		Map_AddTimer("Timer_PlayPeriodicVoice", fTime, "OnTimer_PlayPeriodicVoice");
	}
	
	void Voice_StopPeriodic(bool abStopSubject = false)
	{
		if (abStopSubject) Voice_Stop(msPeriodicVoice_Subject);
		Map_RemoveTimer("Timer_PlayPeriodicVoice");
		Map_RemoveTimer("Timer_CheckPeriodicVoice");
	}
	
	void OnTimer_PlayPeriodicVoice(const tString &in asTimer)
	{
		Map_AddTimer("Timer_CheckPeriodicVoice", 0, "OnTimer_CheckPeriodicVoice");
		Voice_Play(msPeriodicVoice_Subject);
	}
	
	void OnTimer_CheckPeriodicVoice(const tString &in asTimer)
	{
		if (Voice_SubjectIsPlaying(msPeriodicVoice_Subject) == false)
		{
			Map_AddTimer("Timer_PlayPeriodicVoice", cMath_RandRectf(mvPeriodicVoice_Time.x, mvPeriodicVoice_Time.y), "OnTimer_PlayPeriodicVoice");
			return;
		}
		Map_AddTimer("Timer_CheckPeriodicVoice", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CheckPeriodicVoice");
	}
	
