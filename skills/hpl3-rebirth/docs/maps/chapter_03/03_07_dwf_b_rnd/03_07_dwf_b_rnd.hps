		//} END General	

		/////////////////////////////////////////
		// Event A *Insert the vitae into the SHUTTLE*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_TasiNearsTheShuttleDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Dialogue_TasiNearsTheShuttle");
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_TasiAboutToUseShuttleDialogue(const tString &in asEntity, int alState)
		{
			if (mbTorture_Over == false && mfTorture_VictimVitae >= 1.0) Voice_Play("Dialogue_TasiAboutToUseShuttleNoTorture");
			else if (mbTorture_Over == false && mfTorture_VictimVitae >= 0.6f) Voice_Play("Dialogue_TasiAboutToUseShuttlePartTorture");
		}
		
		//-------------------------------------------------------
		
		bool CanUse_VitaeCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{
			if (asPickedEntity == "Trigger_ShuttlePlaceFullVitae") return true;
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnUse_VitaeCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			Entity_SetActive("Trigger_StartShuttle", true);
			
			Item_RemoveFromInventory(Item_GetHeld());
			Entity_SetActive("VitaeCanister_Full_ShuttleStation", true);
			Entity_SetEffectsActive("VitaeCanister_Full_ShuttleStation", true, true);
			SetMeterEntityValue("VitaeCanister_Full_ShuttleStation", 1.0f);
			
			Light_SetVisible("Light_Point_ShuttleVitaeMissing", false);
			
			Sound_CreateAtEntity("InsertVitaeSuccess", "03_07_dw_factory/torture_victim/machine_feedback/attach_positive", "Trigger_ShuttlePlaceFullVitae");
			
			Entity_SetActive("Lamp_PanelVitae_Missing", false);
			Entity_SetActive("Lamp_PanelVitae_Full", true);
			Lamp_SetLit("Lamp_PanelVitae_Full", true, true);
			
			Map_AddTimer("Timer_OpenShuttleDoor", 1, "OnTimer_OpenShuttleDoor");
			
			Voice_PlayDelayed("Dialogue_TasiFixesTheShuttle", 1.0f);						
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_OpenShuttleDoor(const tString &in asTimer)
		{
			Sound_CreateAtEntity("ShuttleDoorOpen", "03_04_pillar_room/config_device/plate_solve_clunk", "WorkingShuttle");
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Insert the vitae into the SHUTTLE*
		
		/////////////////////////////////////////
		// Event B *Enter the shuttle and be taken to the factory*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool OnCollide_Player_StartShuttle(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_StartShuttle("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceStartShuttle;
		void Seq_StartShuttle(const tString &in asTimer)
		{
			Sequence_Begin("Seq_StartShuttle", mSequenceStartShuttle);
			if (Sequence_DoStepAndWait(3.0))
			{
				Sketchbook_CompleteIdea("use_shuttle");
				Sketchbook_NewIdeasPage();
				Voice_PlayDelayed("Dialogue_TasiGetsIntoTheShuttle", 2);
				
				Entity_SetActive("block_box_working_shuttle_door*", true);
				Entity_PlayAnimation("WorkingShuttle", "dwf_back_door_open", 0);
				cAnimationState@ pDoorAnim = Map_GetEntity("WorkingShuttle").GetMeshEntity().GetAnimationStateFromName("dwf_back_door_open");
				pDoorAnim.SetRelativeTimePosition(1);
				pDoorAnim.SetSpeed(-1);
				
				Sound_CreateAtEntity("ShuttleDoorOpen", "03_07_dw_factory/shuttle/shuttle_open", "WorkingShuttle");
			}
			else if (Sequence_DoStepAndWait(2.5))
			{
				Sound_CreateAtEntity("OpenDoor", "03_07_dw_factory/shuttle/shuttle_open_front", "Door_ShuttleTunnel_1");
				SlideDoor_SetOpenAmount("Door_ShuttleTunnel_1", 1);
				
				FearHandler_FadeLevelTo(0, 10);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Sound_CreateAtEntity("Sound_ShuttleStart", "03_07_dw_factory/shuttle/shuttle_start", "WorkingShuttle", 0, false, 1, 6, 15);
				Sound_CreateAtEntity("Sound_ShuttleEngine", "03_07_dw_factory/shuttle/engine/shuttle_engine", "WorkingShuttle", 0, false, 1, 6, 15);
				Sound_CreateAtEntity("Sound_ShuttleRail", "03_07_dw_factory/shuttle/shuttle_rail", "WorkingShuttle", 0, false, 1, 6, 15);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Prop_MoveLinearTo("WorkingShuttle", "Target_WorkingShuttle_1", 0.5, 3, 0, true, "OnMoveEnd_ResumeStartShuttle");
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Sound_Stop("Sound_ShuttleRail", 0.5);
				Sound_CreateAtEntity("ShuttleStop", "03_07_dw_factory/shuttle/shuttle_stop", "WorkingShuttle", 0, false, 1, 6, 15);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Sound_CreateAtEntity("OpenDoor", "03_07_dw_factory/shuttle/shuttle_open_front", "Door_ShuttleTunnel_1");
				Light_FadeBrightnessTo("Light_ShuttleCorridor*", 0, 2);
				Lamp_SetLit("dwf_railing_light_2", false, true);
				Lamp_SetLit("dwf_railing_light_3", false, true);
				Lamp_SetLit("dwf_railing_light_4", false, true);
				Lamp_SetLit("dwf_railing_light_5", false, true);
				SlideDoor_SetOpenAmount("Door_ShuttleTunnel_1", 0);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Effect_Fade_Out(2.0);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Map_ChangeMap("03_07_dwf_c_factory.hpm", "Start_Begin", "", "");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnMoveEnd_ResumeStartShuttle(const tString& in asPropName)	 
		{
			SequenceStates_Resume("Seq_StartShuttle");
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Enter the shuttle and be taken to the factory*
		
	//} END SCENE 9
	
