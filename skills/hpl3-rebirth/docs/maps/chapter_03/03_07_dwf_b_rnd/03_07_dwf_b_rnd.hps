	void OnTimer_PlayWhenPossible(const tString &in asTimer)
	{
		if (Voice_CharacterIsSpeaking("Player") == false)
		{
			Voice_PlayDelayed(asTimer, 0.5);
			return;
		}
		Map_RestartCurrentTimer(0.2);
	}
	
	//-------------------------------------------------------
	
	void SetRnDDoorState(const tString &in asDoor, bool abDisabled, bool abOpen, bool abInstant = true)
	{
		MovingButton_SetDisabled(asDoor + "_Button*", abDisabled, false);
		
		cScript_SetGlobalArgBool(0, abOpen);
		cScript_SetGlobalArgBool(1, true);
		cScript_RunGlobalFunc(asDoor + "_Button_1", "cScrPropMovingButton", "_Global_SetSwitchedOnWithoutConnection");
//		MovingButton_SetSwitchedOn(asDoor + "_Button_1", abOpen, true);
		
		cScript_SetGlobalArgBool(0, abOpen);
		cScript_SetGlobalArgBool(1, true);
		cScript_RunGlobalFunc(asDoor + "_Button_2", "cScrPropMovingButton", "_Global_SetSwitchedOnWithoutConnection");
//		MovingButton_SetSwitchedOn(asDoor + "_Button_2", abOpen, true);

		if (abOpen == false) SlideDoor_SetOpenAmount(asDoor + "_Left", 0.0f, abInstant);
		else if (abOpen) SlideDoor_SetOpenAmount(asDoor + "_Left", 1.0f, abInstant);
		
		if (abOpen == false) SlideDoor_SetOpenAmount(asDoor + "_Right", 0.0f, abInstant);
		else if (abOpen) SlideDoor_SetOpenAmount(asDoor + "_Right", 1.0f, abInstant);
	}
	
	//-------------------------------------------------------
	
	void SetSmallControlPanelState(const tString &in asEnt, eSmallControlPanelState aState, bool abInstant = false)
	{
		if (Entity_GetVarInt(asEnt, "SmallControlPanelState") == aState) return;
		Entity_SetVarInt(asEnt, "SmallControlPanelState", aState);
				
		tString sIndicator = "Indicator_" + asEnt;
		if (aState == eSmallControlPanelState_Disabled)
		{
			Entity_SetEffectsActive(sIndicator, false, !abInstant);
			Lever_SetStuckState(asEnt, 1, !abInstant);
			StopBlinkButton(sIndicator);
		}
		else if (aState == eSmallControlPanelState_Locked)
		{
			Entity_SetEffectsActive(sIndicator, true, !abInstant);
			Lever_SetStuckState(asEnt, 1, !abInstant);
			SetButtonColor(sIndicator, mButtonColor_Red * 1.5, !abInstant);
			StopBlinkButton(sIndicator);
		}
		else if (aState == eSmallControlPanelState_Unlocked)
		{
			Entity_SetEffectsActive(sIndicator, true, !abInstant);
			Lever_SetStuckState(asEnt, 0, !abInstant);
			SetButtonColor(sIndicator, mButtonColor_White);
			FlashButton(sIndicator, mButtonColor_White, 1.8, 0.5, true);
		}
		else if (aState == eSmallControlPanelState_Active)
		{
			Entity_SetEffectsActive(sIndicator, true, !abInstant);
			Lever_SetStuckState(asEnt, 1, !abInstant);
			SetButtonColor(sIndicator, mButtonColor_Green);
			StopBlinkButton(sIndicator);
		}
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// SubMesh Illumination Fading
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	array<tID> mvSubMeshIllumFade_Ent;
	array<float> mvSubMeshIllumFade_Counter;
	array<float> mvSubMeshIllumFade_Time;
	array<cColor> mvSubMeshIllumFade_OriginalColor;
	array<cColor> mvSubMeshIllumFade_FadeColor;
	array<cColor> mvSubMeshIllumFade_CustomColor;
	array<int> mvSubMeshIllumFade_FadeCount;
	array<int> mvSubMeshIllumFade_FadeCounter;
	array<int> mvSubMeshIllumFade_Direction;
	array<eEasing> mvSubMeshIllumFade_EasingIn;
	array<eEasing> mvSubMeshIllumFade_EasingOut;
	
	//-------------------------------------------------------
	
	void FadeSubMeshIllumColor(tID a_idSubMesh, cColor aFadeColor, float afTime = 0.5, int alFades = 1, bool abCustomOriginalColor = false, cColor aCustomColor = cColor_White, eEasing aEasingIn = eEasing_Linear, eEasing aEasingOut = eEasing_Linear)
	{
		int lFadeIndex = mvSubMeshIllumFade_Ent.find(a_idSubMesh);
		if (lFadeIndex >= 0)
		{
			RemoveSubMeshIllumFade(lFadeIndex);
		}
		
		cSubMeshEntity@ pSubMesh = cLux_ID_SubMeshEntity(a_idSubMesh);
		mvSubMeshIllumFade_Ent.push_back(a_idSubMesh);
		mvSubMeshIllumFade_Counter.push_back(0);
		mvSubMeshIllumFade_Time.push_back(afTime);
		mvSubMeshIllumFade_OriginalColor.push_back(pSubMesh.GetIlluminationColor());
		mvSubMeshIllumFade_FadeColor.push_back(aFadeColor);
		mvSubMeshIllumFade_CustomColor.push_back(abCustomOriginalColor ? aCustomColor : pSubMesh.GetIlluminationColor());
		mvSubMeshIllumFade_FadeCount.push_back(alFades);
		mvSubMeshIllumFade_FadeCounter.push_back(0);
		mvSubMeshIllumFade_Direction.push_back(1);
		mvSubMeshIllumFade_EasingIn.push_back(aEasingIn);
		mvSubMeshIllumFade_EasingOut.push_back(aEasingIn);
	}
	
	//-------------------------------------------------------
	
	void BlinkSubMeshIllumColor(tID a_idSubMesh, float afBrightnessMul = 2, float afTime = 1, int alBlinks = 1, bool abCustomOriginalColor = false, cColor aCustomColor = cColor_White, eEasing aEasingIn = eEasing_Linear, eEasing aEasingOut = eEasing_Linear)
	{
		cSubMeshEntity@ pSubMesh = cLux_ID_SubMeshEntity(a_idSubMesh);
		int lFades = alBlinks < 0 ? -1 : alBlinks * 2;
		FadeSubMeshIllumColor(a_idSubMesh, pSubMesh.GetIlluminationColor() * afBrightnessMul, afTime / 2,  lFades, abCustomOriginalColor, aCustomColor);
	}
	
	//-------------------------------------------------------
	
	void UpdateSubMeshIllumFading(float afTimeStep)
	{
		for (int i = 0; i < mvSubMeshIllumFade_Ent.size(); ++i)
		{	
			// update counter
			int fDirection = mvSubMeshIllumFade_Direction[i];
			float fNewCount = mvSubMeshIllumFade_Counter[i] + fDirection * afTimeStep;
			mvSubMeshIllumFade_Counter[i] = fNewCount;
			
			int lFadeCounter = mvSubMeshIllumFade_FadeCounter[i];
			
			// figure out new color
			float fT = cMath_Clamp(fNewCount / mvSubMeshIllumFade_Time[i], 0.0f, 1.0f);
			fT = cMath_Easing(fDirection > 0 ? mvSubMeshIllumFade_EasingIn[i] : mvSubMeshIllumFade_EasingOut[i], fT);
			cColor firstColor = lFadeCounter == 0 ? mvSubMeshIllumFade_OriginalColor[i] : mvSubMeshIllumFade_CustomColor[i];
			cColor newColor = firstColor * (1.0f - fT) + mvSubMeshIllumFade_FadeColor[i] * (fT);
			cSubMeshEntity@ pIllum = cLux_ID_SubMeshEntity(mvSubMeshIllumFade_Ent[i]);
			if (pIllum !is null) pIllum.SetIlluminationColor(newColor);
						
			// update fade count, remove fade if none left
			if (fT == 1 || fT == 0)
			{
				// change direction
				mvSubMeshIllumFade_Direction[i] = fDirection > 0 ? -1 : 1;
				
				++lFadeCounter;
				mvSubMeshIllumFade_FadeCounter[i] = lFadeCounter;
				if (lFadeCounter >= 100000) lFadeCounter = 2;
				
				int lFadeCount = mvSubMeshIllumFade_FadeCount[i];
				if (lFadeCount > 0)
				{
					if (lFadeCounter == lFadeCount)
					{
						RemoveSubMeshIllumFade(i);
						--i;
					}
					else
					{
						mvSubMeshIllumFade_FadeCounter[i] = lFadeCounter;
					}
				}
			}
		}
	}
	
	//-------------------------------------------------------
	
	void RemoveSubMeshIllumFade(int alFadeIndex)
	{
		mvSubMeshIllumFade_Ent.removeAt(alFadeIndex);
		mvSubMeshIllumFade_Counter.removeAt(alFadeIndex);
		mvSubMeshIllumFade_Time.removeAt(alFadeIndex);
		mvSubMeshIllumFade_OriginalColor.removeAt(alFadeIndex);
		mvSubMeshIllumFade_FadeCount.removeAt(alFadeIndex);
		mvSubMeshIllumFade_FadeCounter.removeAt(alFadeIndex);
		mvSubMeshIllumFade_FadeColor.removeAt(alFadeIndex);
		mvSubMeshIllumFade_CustomColor.removeAt(alFadeIndex);
		mvSubMeshIllumFade_Direction.removeAt(alFadeIndex);
		mvSubMeshIllumFade_EasingIn.removeAt(alFadeIndex);
		mvSubMeshIllumFade_EasingOut.removeAt(alFadeIndex);
	}
	
	//-------------------------------------------------------
	
	void StopSubMeshIllumFade(tID a_idSubMesh, float afTime = 0.5, bool abOriginalColor = true, cColor aCustomColor = cColor_White)
	{
		int lFadeIndex = mvSubMeshIllumFade_Ent.find(a_idSubMesh);
		if (lFadeIndex < 0) return;
		
		FadeSubMeshIllumColor(a_idSubMesh, abOriginalColor ? mvSubMeshIllumFade_OriginalColor[lFadeIndex] : aCustomColor, afTime, 1);
		RemoveSubMeshIllumFade(lFadeIndex);
	}
	
	//-------------------------------------------------------
	
	void SetSliderDoorMaxDistance(const tString &in asEntity, float afDist)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asEntity);
		if (pEnt is null) return;
		
		iPhysicsJoint@ pJoint = pEnt.GetMainBody().GetJoint(0);
		if (pJoint is null) return;
		
		iPhysicsJointSlider@ pSlider = cPhysics_ToJointSlider(pJoint);
		if (pSlider is null) return;
		
		pSlider.SetMaxDistance(afDist);
	}
	
	
