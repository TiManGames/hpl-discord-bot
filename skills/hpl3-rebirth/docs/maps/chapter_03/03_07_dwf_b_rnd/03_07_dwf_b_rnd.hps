			Player_Teleport("Start_WraithSoundTest");
			Entity_SetActive("TestWraith", true);
			Wraith_CommandPulse_Execute("TestWraith", true);
		}
		
		if(alAction == eAction_Test8)
		{
//			Map_AddTimer("Timer_ActivateExtenderWraith", 0, "OnTimer_ActivateExtenderWraith");
//			return;
