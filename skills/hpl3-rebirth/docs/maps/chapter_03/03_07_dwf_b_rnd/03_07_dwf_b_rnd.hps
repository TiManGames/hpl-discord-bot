		/////////////////////////////////////////
		// Event B *Search the happiness research room and think of the baby*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		float mfHappyPictureInteractTime = 0.0f;
		bool mbHappyPictureReactionStarted = false;
		bool mbHappyPictureFirstPart = false;
		int mlHappyPictureDialogueIndex = 0;
		int mlHappyPictureDialogueAreaCount = 0;
		bool mbHappyPictureCutsceneEnabled = true;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_AllowHappyFamilyDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlHappyPictureDialogueAreaCount += alState;
			return true;
		}

		//-------------------------------------------------------
		
		void OnInteract_HappyPicture(const tString &in asEntity)
		{
			if (mbHappyPictureReactionStarted) return;
			if (Map_TimerExists("Timer_CheckHappyPictureInteract") == false)
				Map_AddTimer("Timer_CheckHappyPictureInteract", 0.2f, "OnTimer_CheckHappyPictureInteract");
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_HappyPicture(const tString &in asEntity)
		{
			mfHappyPictureInteractTime = 0;
			Map_RemoveTimer("Timer_CheckHappyPictureInteract");
			if (mbHappyPictureReactionStarted) Map_AddTimer("Timer_StartHappyPictureCutscene", 0.5f, "OnTimer_StartHappyPictureCutscene");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckHappyPictureInteract(const tString &in asTimer)
		{
			mfHappyPictureInteractTime += 0.2f;
			if (mfHappyPictureInteractTime >= 2.0f)
			{
				mbHappyPictureReactionStarted = true;
				PlayNextHappyFamilyDialoguePart();
				return;
			}
			Map_AddTimer("Timer_CheckHappyPictureInteract", 0.2f, "OnTimer_CheckHappyPictureInteract");
		}
		
		//-------------------------------------------------------
		
		void PlayNextHappyFamilyDialoguePart()
		{
			if (mlHappyPictureDialogueAreaCount == 0) return;
			
			++mlHappyPictureDialogueIndex;
			Voice_PlayDelayed("Dialogue_HappyFamily_" + mlHappyPictureDialogueIndex, 0.5f, -1, "OnDialogueEnd_HappyPicture");
		}
		
		//-------------------------------------------------------
		
		void OnDialogueEnd_HappyPicture(const tString&in asScene, const tString&in asSubject)
		{
			if (mlHappyPictureDialogueIndex < 4)
			{
				PlayNextHappyFamilyDialoguePart();
			}
			else
			{
				Map_AddTimer("Timer_DisableHappyPictureCutscene", 2.0f, "OnTimer_DisableHappyPictureCutscene");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartHappyPictureCutscene(const tString &in asTimer)
		{
			if (mbHappyPictureCutsceneEnabled == false) return;
			mbHappyPictureCutsceneEnabled = false;
			PlayerBody_PlayCutsceneAnimation("react_to_baby_kick_6m", false, 0.5f, "");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableHappyPictureCutscene(const tString &in asTimer)
		{
			mbHappyPictureCutsceneEnabled = false;
		}
		
		//-------------------------------------------------------
		
	//} END SCENE 4
	
