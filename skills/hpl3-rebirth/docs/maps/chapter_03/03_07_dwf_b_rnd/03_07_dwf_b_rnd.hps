		/////////////////////////////////////////
		// Event A *Sneak past a more aggressive R&D WRAITH into the Pod Room*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool OnCollide_Player_SetupTortureToExitEncounter(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_SetupTortureToExitEncounter", 0.5, "OnTimer_SetupTortureToExitEncounter");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetupTortureToExitEncounter(const tString &in asTimer)
		{
			cLux_AddDebugMessage("[Map] Start torture to exit encounter");
			
			Entity_SetActive("Wraith_TortureToExit", true);
			Wraith_SetCallback_Pulse("Wraith_TortureToExit", "OnWraithPulse_PullUpAmulet", true);
			Wraith_SetSpotlightSoundVolumeMul("Wraith_TortureToExit", 0.5);
			Agent_SetSensesActive("Wraith_TortureToExit", false);
			Wraith_SetHearing("Wraith_TortureToExit", false);
			
			Wraith_ClearPlayerPath("Wraith_TortureToExit");
			for (int i = 1; i <= 9; ++i) Wraith_AddPlayerPathNode("Wraith_TortureToExit", "PlayerPath_TortureToExit_" + i);
			
			Entity_SetActive("Trigger_StartTortureToExitPatrol*", true);
			Entity_SetActive("Trigger_TortureToExitPhase2", true);
			
			FearHandler_SetPermaFailRespawnArea("PermaFail_TortureToExit");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartTortureToExitPatrol(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_StartTortureToExitPatrol_*", false);
			
			Agent_SetSensesActive("Wraith_TortureToExit", true);
			
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_TortureToExit");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TortureToExit", "PathNode_HappyTortureToExit_1_1");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TortureToExit", "PathNode_HappyTortureToExit_1_2");
			Wraith_ModeWraithPatrol_AddNode("Wraith_TortureToExit", "PathNode_HappyTortureToExit_1_3");
			Wraith_ModeWraithPatrol_Setup("Wraith_TortureToExit", true, false);
			Wraith_ModeWraithPatrol_SetPulseTime("Wraith_TortureToExit", 10.0f);
			Wraith_ModeWraithPatrol_SetBurstTime("Wraith_TortureToExit", 15.0f);
			Wraith_Mode_Set("Wraith_TortureToExit", eWraithMode_WraithPatrol, true);
			
			Entity_SetActive("Trigger_StartTortureToExitPatrol2", true);
			
			Map_AddTimer("Timer_HappyToTortureEnableHearing", 2.0f, "OnTimer_HappyToTortureEnableHearing");
			return false;
		}
		
		bool OnCollide_Player_StartTortureToExitPatrol2(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_PlaceAtEntity("Wraith_TortureToExit", "Target_Wraith_TortureToExit_2");
			CharMover_TurnInstantlyToEntity("Wraith_TortureToExit", "Target_TortureToExit_LookAt_1");
			OnCollide_Player_StartTortureToExitPatrol(asParent, asChild, alState);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_HappyToTortureEnableHearing(const tString &in asTimer)
		{
			Wraith_SetHearing("Wraith_TortureToExit", true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Wraith_TortureToExitPhase2(const tString &in asParent, const tString &in asChild, int alState)
		{
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_TortureToExit");
			for (int i = 1; i <= 16; ++i)
			{
				Wraith_ModeWraithPatrol_AddNode("Wraith_TortureToExit", "PathNode_HappyTortureToExit_2_" + i);
			}
			Wraith_ModeWraithPatrol_Setup("Wraith_TortureToExit", true, false);
			Wraith_ModeWraithPatrol_SetPulseTime("Wraith_TortureToExit", 10.0f);
			Wraith_ModeWraithPatrol_SetBurstTime("Wraith_TortureToExit", 15.0f);
			Wraith_Mode_Set("Wraith_TortureToExit", eWraithMode_WraithPatrol, true);
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Sneak past a more aggressive R&D WRAITH into the Pod Room*
		
		/////////////////////////////////////////
		// Event B *Find the POWER EXTENDERS in the Storage Room*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		//-------------------------------------------------------
		
		//} END Event B *Find the POWER EXTENDERS in the Storage Room*
		
		/////////////////////////////////////////
		// Event C *Power the POD ROOM EXIT*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbTheaterReciever1 = false;
		bool mbTheaterRoomOn = false;
		bool mbTheaterScanActive = true;
		bool mbTheaterHangerPrimed = false;
		bool mbShuttleControlPowerOn = false;
		bool mbTortureRoomOn = false;
		bool mbLookingAtShuttle2 = false;
		bool mbShuttleFirstPower = false;
		
		//-------------------------------------------------------
		
		void OnPower_PowerReceiver_ShuttleStation(bool abActive, const tString&in asEntity)
		{
			SetShuttleControlPanelActive(abActive, false);
			if (abActive)
			{
				mbShuttleControlPowerOn = true;
				
				if (mbShuttleFirstPower == false)
				{
					mbShuttleFirstPower = true;
					Map_AddTimer("Timer_PlayShuttleStationPoweredDialogue", 2, "OnTimer_PlayShuttleStationPoweredDialogue");
				}
				
				Sound_Play("Sound_LampSmall", 2.0f);
				Sound_Play("Sound_LampSmallLoop", 2.0f);
				
				Sound_CreateAtEntity("ShuttleControlActivate", "03_07_DW_theatre/energy_receiver/receiver_on", "PowerReceiver_ShuttleStation", 0, false, 1, 10, 25);
			}
			else
			{
				mbShuttleControlPowerOn = false;
				Sound_Stop("Sound_LampSmallLoop", 2.0f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayShuttleStationPoweredDialogue(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_ShuttleStationAgainDialogueArea_*", false);
			Entity_SetActive("Trigger_SeeShuttleStationAgainDialogue_*", false);
			Entity_SetActive("Trigger_ShuttlesAreWorkingLookAt", true);
			Voice_PlayWhenPossible("Dialogue_ShuttleStationPowered", "OnVoiceCondition_ShuttlesAreWorkingDialogue", 10, 1);
		}
		
		//-------------------------------------------------------
		
		bool OnVoiceCondition_ShuttlesAreWorkingDialogue(const tString& in asSubject)
		{
			if (mbShuttleControlPowerOn == false) return false;
			if (mbLookingAtShuttle2 == false) return false;
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_ShuttlesAreWorking(const tString &in asEntity, int alState)
		{
			mbLookingAtShuttle2 = alState == 1;
		}
		
		//-------------------------------------------------------
		
		bool mbPower_CompleteButtonState = false;
		bool mbPower_CanisterBlockerActive = false;

		void OnPower_PowerReceiver_TortureRoom(bool abActive, const tString&in asEntity)
		{
			mbTortureRoomOn = abActive;
			
			Lamp_SetLit("Lamp_TCEntrance*", abActive, true);
			
			
			if (mlTortureChamberActivationStage == 0 && abActive) Seq_ActivateTortureChamber("");
//			Entity_SetActive("Trigger_ActivateTortureChamber", mlTortureChamberActivationStage == 0 && abActive);
			
			Light_FadeBrightnessTo("Light_Receiver_Extra_*", abActive ? 1.5 : 0, 0.5);
			
			if (mlTortureChamberActivationStage >= 1)
			{
				Lamp_SetLit("Lamp_TorturePanel_*", abActive, true);
				Lamp_SetLit("Lamp_TortureBooth_*", abActive, true);
			}
			
			if (mlTortureChamberActivationStage >= 2)
			{
				Lamp_SetLit("Lamp_TortureBench_*", abActive, true);
				Lamp_SetLit("Lamp_TortureBooth_*", abActive, true);
				
				// freezer light
				Lamp_SetLit("Lamp_Freezer_Backlight_Lamp_*", abActive, true);
				if (abActive) FadeFreezerFogColor(mFreezerFogOrigColor, 1.5f);
				else FadeFreezerFogColor(cColor(0), 1.5f);
				
				// torture canister glow
				Entity_SetEffectsActive("TortureCanister*", abActive, true);
			}
			
			// complete button
			if (abActive) SetButtonActive("Button_CompleteTortureSetup_1", mbPower_CompleteButtonState);
			else SetButtonActive("Button_CompleteTortureSetup_1", abActive);
			
			// torture socket
			if (abActive == false) SetTortureCardSlotState(false, true, false, false);
			else SetTortureCardSlotState(mbTortureCardMissing, mbTortureCardForceStickyDisabled, false, false);
			
			// torture lever
			if (abActive == false) SetTortureLeverState(false, false, false, false);
			else SetTortureLeverState(mbTortureLever_Active, mbTortureLever_Locked, false, false);
			
			// torture canister
			if (abActive == false)
			{
				SetCanisterSocketLocked(true, false);
				SetCanisterIndicatorState(0, false);
				Entity_SetActive("Blocker_CanisterSocket", true);
			}
			else
			{
				SetCanisterSocketLocked(mbTortureCanister_Locked, false);
				SetCanisterIndicatorColor();
//				SetCanisterIndicatorState(mlTortureCanister_IndicatorState, false);
				Entity_SetActive("Blocker_CanisterSocket", mbPower_CanisterBlockerActive);
			}
			
			// torture meter
			if (abActive) SetTortureMeterState(mTortureMeterState, false, false);
			else SetTortureMeterState(eTortureMeterState_Inactive, false, false);
			
			// torture tubes
			if (abActive == false)
			{
				if (mbTopTubesFilled) EmptyTopTortureTubes(false, true);
				if (mbBottomTubesFilled) EmptyBottomTortureTubes(false, true);
				
				if (mbVictimForward)
				{
					SetTortureEffectsState("", false);
					SetTortureSoundState("", false);
				}
				else TurnOffActiveRobotArmTestIdle();
			}
			else
			{
				if (mbTopTubesFilled) FillUpTopTortureTubes(false, true);
				if (mbBottomTubesFilled) FillUpBottomTortureTubes(false, true);
				
				if (mbVictimForward)
				{
					SetTortureEffectsState(msTortureEffectsState, false);
					SetTortureSoundState(msTorture_SoundState, false);
				}
				else DoActiveRobotArmTestRun();
			}
			
			// torture chamber doors
			if (mbTortureChamberDoorsLocked == false)
			{
				SetRnDDoorState("Door_TortureChamber", !abActive, true, false);
				SetRnDDoorState("Door_TortureMiddle", !abActive, true, false);
				SetRnDDoorState("Door_TortureEntrance", !abActive, true, false);
			}
			
			// robot arms
			SetRobotArmsColor();
			
			// robot arm sockets
			if (abActive == false) SetTortureSocketsInteraction(false, false);
			else SetTortureSocketsInteraction(mbRobotArmsSocketsActive, false);
			
			// prep room
			Lamp_SetLit("Lamp_PrepRoom*", abActive, true);
		}
		
		//-------------------------------------------------------
		
		//} END Event C *Power the POD ROOM EXIT*
		
		/////////////////////////////////////////
		// Event D *Notice and inspect the TORTURE POD in the Pod Room*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		//-------------------------------------------------------
		
		//} END Event D *Notice and inspect the TORTURE POD in the Pod Room*
		
		/////////////////////////////////////////
		// Event E *Return to the Shuttle Station*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		cVector3f mvLeaveRnD_EnterPos;
		bool OnCollide_Player_LeaveRnD(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mvLeaveRnD_EnterPos = Player_GetPosition();
			}
			else
			{
				cVector3f vPassDir = Player_GetPosition() - mvLeaveRnD_EnterPos;
				vPassDir.Normalize();
				if (cMath_Vector3Dot(vPassDir, Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward()) > 0.0f)
				{
					Entity_SetActive("Wraith_TortureToExit", false);
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event E *Return to the Shuttle Station*
		
	//} END SCENE 8
	
