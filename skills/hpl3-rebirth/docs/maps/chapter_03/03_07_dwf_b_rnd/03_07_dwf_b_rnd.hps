		//-------------------------------------------------------
		
		bool mbDialogue_BeforeTorture = true;
		bool mbDialogue_TortureScreamsActive = false;
		bool mbDialogue_TortureWithoutKnowing = false;
		bool mbDialogue_TorturedOnce = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_VictimBooth(const tString &in asEntity, int alState)
		{
			if (alState == -1) return;
			if (asEntity == "Victim_ToHappy")
			{
				if (mlTortureCount > 0) Voice_Play("Dialogue_ToVictimBeforeFreshTorture");
			}
			else if (mlTortureCount > 0) Voice_Play("Dialogue_ToVictimBeforeFreshTorture");
			else if (mbDialogue_TorturedOnce == false && mbDialogue_BeforeTorture) Voice_Play("Dialogue_ToVictimBeforeTorture");
			else if (mbDialogue_TorturedOnce && mbTortureSuspended) Voice_Play("Dialogue_ToVictimAfterDraining");
			else if (mbDialogue_TorturedOnce) Voice_Play("Dialogue_ToVictimAfterTorture");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_BeforeTortureDialogue(const tString &in asEntity, int alState)
		{
			if (alState == -1) return;
			if (mbDialogue_TorturedOnce == false && mbDialogue_BeforeTorture) Voice_Play("Dialogue_ToVictimBeforeTorture");
		}
		
		//-------------------------------------------------------
		
		void SetTortureScreamsActive(bool abX)
		{
			if (mbTortureChamberLocked) return;
			if (abX == mbDialogue_TortureScreamsActive) return;
			mbDialogue_TortureScreamsActive = abX;
			if (mbDialogue_TortureScreamsActive)
			{
				mbDialogue_TorturedOnce = true;
				if (mbDialogue_TasiKnowsSheNeedsToTorture == false)
				{
					mbDialogue_TortureWithoutKnowing = true;
					mbDialogue_TasiKnowsSheNeedsToTorture = true;
					Voice_PlayDelayed("Dialogue_TasiRealisesSheIsTorturing", 1.0);
				}
				
				if (mbVictimDead == false)
				{
					Voice_SetSource("Victim", "TortureVictim_Booth", 10, 25, true);
					if (msTortureSource == "Gas") Voice_PlayPeriodically("Victim_Tortured_Burning", 0.5, 0.5, 0);
					else if (msTortureSource == "Water") Voice_PlayPeriodically("Victim_Tortured_Drowning", 0.5, 0.5, 0);
					else if (msTortureSource == "Vitae") Voice_PlayPeriodically("Victim_Tortured_Drilling", 0.5, 0.5, 0);
				}
				
//				SetTortureDialogue(true);
				FearHandler_SetForcedAddFearRate(0.5f, 9999, false, -1, -1, 0);
			}
			else
			{
				if (mbVictimDead == false)
				{
					Voice_SetSource("Victim", "TortureVictim_Booth", 0, 10, true);
					Voice_PlayPeriodically("Victim_Mumble_Tortured", 5, 10, 3);
				}
				
				mfTimeSinceLastTorture = 0;
//				SetTortureDialogue(false);
				FearHandler_SetForcedAddFearRate(0.5f, -1, false, -1, 0.08f, 0.5);
			}
		}
		
		//-------------------------------------------------------
		
		void SetTortureBoothDialogue(bool abActive)
		{
			cLux_AddDebugMessage("[Map] SetTortureBoothDialogue " + abActive);
			if (abActive) Map_AddTimer("Timer_TortureBoothDialogue", cMath_RandRectf(2.5f, 5.0f), "OnTimer_TortureBoothDialogue");
			else Map_RemoveTimer("Timer_TortureBoothDialogue");
		}
		
		void OnTimer_TortureBoothDialogue(const tString &in asTimer)
		{
			if (mbVictimDead) return;
			
			if (mfTimeSinceLastTorture >= 45.0f) Voice_Play("Victim_Mumble_WaitForTorture");
			else if (mbVictimLowVitae) Voice_Play("Victim_Mumble_Drained");
			else Voice_Play("Victim_Mumble_Tortured");
			
			Map_AddTimer("Timer_TortureBoothDialogue", cMath_RandRectf(5.0f, 10.0f), "OnTimer_TortureBoothDialogue");
		}
		
		//-------------------------------------------------------
		
		void SetTortureDialogue(bool abActive)
		{
			cLux_AddDebugMessage("[Map] SetTortureDialogue " + abActive);
//			if (abActive) Map_AddTimer("Timer_TortureDialogue", 0, "OnTimer_TortureDialogue");
//			else Map_RemoveTimer("Timer_TortureDialogue");
		}
		
		void OnTimer_TortureDialogue(const tString &in asTimer)
		{
			if (mbVictimDead) return;
			if (Voice_CharacterIsSpeaking("Victim") == false)
			{
				if (mlSelectedTorture == 1) Voice_Play("Victim_Tortured_Drowning");
				else if (mlSelectedTorture == 2) Voice_Play("Victim_Tortured_Burning");
				else if (mlSelectedTorture == 3) Voice_Play("Victim_Tortured_Drilling");
			}
			
			Map_RestartCurrentTimer(0.2f);
		}
		
