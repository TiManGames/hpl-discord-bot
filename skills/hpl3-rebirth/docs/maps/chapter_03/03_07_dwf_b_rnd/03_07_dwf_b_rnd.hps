		//-------------------------------------------------------
		
		void CheckTortureMachineComplete()
		{
			bool bComplete = false;
			if (msTortureSource == "" && mvRobotArmState[0] == 2 && mvRobotArmState[1] == 2 && mvRobotArmState[2] == 2 && mvRobotArmState[3] == 2) bComplete = true;
			else if (msTortureSource == "Gas" && mvRobotArmState[0] == 2 && mvRobotArmState[1] == 2) bComplete = true;
			else if (msTortureSource == "Water" && mvRobotArmState[4] == 2) bComplete = true;
						
			if (bComplete && mbTortureMachineComplete == false)
			{
				mbPower_CompleteButtonState = true;
				if (mbTortureRoomOn) SetButtonActive("Button_CompleteTortureSetup_1", true);
				SetCanisterIndicatorState(2);
				
				Sound_CreateAtEntity("TortureSetupDone", "03_07_dw_factory/torture_victim/machine_feedback/machine_positive", "Target_TortureMachineSounds");
			}
			else if (bComplete == false && mbTortureMachineComplete)
			{
				mbPower_CompleteButtonState = false;
				SetButtonActive("Button_CompleteTortureSetup_1", false);
				SetCanisterIndicatorState(1);
			}
			mbTortureMachineComplete = bComplete;
		}
		
		//-------------------------------------------------------
		
		eTortureType GetTortureToolsSetup()
		{
			if (mvRobotArmAttachType[0] == "Drill" && mvRobotArmAttachType[1] == "Drill" &&
				mvRobotArmAttachType[2] == "Drill" && mvRobotArmAttachType[3] == "Drill")
			{
				return eTortureType_Drilling;
			}
				
			if (mvRobotArmAttachType[0] == "Burner" && mvRobotArmAttachType[1] == "Burner")
			{
				return eTortureType_Burning;
			}
			
			if (mvRobotArmAttachType[4] == "Drowner")
			{
				return eTortureType_Drowning;
			}
			
			return eTortureType_None;
		}
		
		//-------------------------------------------------------
		
		eTortureType GetCanisterSetup()
		{
			if (msTortureSource == "") return eTortureType_Drilling;
			if (msTortureSource == "Gas") return eTortureType_Burning;
			if (msTortureSource == "Water") return eTortureType_Drowning;
			return eTortureType_None;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlayerInsideTortureBooth(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbPlayerInsideTortureBooth = alState == 1;
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_CompleteTortureSetup(const tString &in asEntity)
		{
			if (Entity_GetVarBool(asEntity, "ButtonActive") == false) return;
			
			eTortureType lTortureToolSetup = GetTortureToolsSetup();
			eTortureType lCanisterSetup = GetCanisterSetup();
			bool bTools = lTortureToolSetup != eTortureType_None;
			bool bCanister = lTortureToolSetup == lCanisterSetup;
			
			// arm feedback
			SetRobotArmsColor(true);
			SetCanisterIndicatorColor(true);
			
			if (mSelectedTorture == lCanisterSetup && lCanisterSetup == lTortureToolSetup && mbPlayerInsideTortureBooth == false)
			{
				if (lTortureToolSetup == eTortureType_Drilling) msTortureType = "drilling";
				else if (lTortureToolSetup == eTortureType_Burning) msTortureType = "burning";
				else if (lTortureToolSetup == eTortureType_Drowning) msTortureType = "drowning";
				DiscardUnusedTools();
				
				Sound_CreateAtEntity("MachineSuccess", "03_07_dw_factory/torture_victim/machine_feedback/machine_positive", "Target_TortureMachineSounds");
				
				Seq_VictimIsBroughtForward("");
			}
			else
			{
				Sound_CreateAtEntity("MachineFail_1", "03_07_dw_factory/torture_victim/machine_feedback/button_negative", "Button_CompleteTortureSetup_1");
				FlashButton("Button_CompleteTortureSetup_1", mButtonColor_RedExtreme, 2.5);
			}
		}
		
		//-------------------------------------------------------
		
		void DiscardUnusedTools()
		{
			if (msTortureType == "drilling")
			{
				StickyArea_Detach("Sticky_RobotArm_5");
			}
			else if (msTortureType == "burning")
			{
				StickyArea_Detach("Sticky_RobotArm_3");
				StickyArea_Detach("Sticky_RobotArm_4");
				StickyArea_Detach("Sticky_RobotArm_5");
			}
			else if (msTortureType == "drowning")
			{
				StickyArea_Detach("Sticky_RobotArm_1");
				StickyArea_Detach("Sticky_RobotArm_2");
				StickyArea_Detach("Sticky_RobotArm_3");
				StickyArea_Detach("Sticky_RobotArm_4");
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceVictimIsBroughtForward;
		void Seq_VictimIsBroughtForward(const tString &in asTimer)
		{
			Sequence_Begin("Seq_VictimIsBroughtForward", mSequenceVictimIsBroughtForward);
			if (Sequence_DoStepAndWait(1.5))
			{
				mbVictimForward = true;
				
				mbPower_CompleteButtonState = false;
				SetButtonActive("Button_CompleteTortureSetup_1", false);
				
				Entity_SetInteractionDisabled(StickyArea_GetAttachedEntityName("Sticky_TortureCard"), true);
				Entity_SetActive("Sticky_TortureCard", false);
								
				Voice_StopPeriodic();
				
				SetCanisterSocketLocked(true);
				SetFrontTortureWindowOpen(false);
				
				// lock lever, light up torture panel
				SetTortureLeverState(true, true);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				SetBackTortureWindowOpen(true);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				// retract inactive arms
				PlayInactiveRobotArmAnimation("ready_tr_start_pose", 0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// bring victim forward
				Entity_SetAnimationMessageEventCallback("TortureHanger", "OnAnimationMessage_ResumeVictimIsBroughtForward", false);
				Entity_PlayAnimation("TortureHanger", "rnd_torture_hanger_brought_up_to_robot_arms", 0, false, false, "");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// victim reacts to tools
				TortureVictim_SetIdle("panic_idle", false);
				TortureVictim_PlayAnimation("brought_forward", 0.2);
				Voice_StopPeriodic(true);
				Voice_PlayPeriodically("Victim_Mumble_WaitForTortureNearTools", 4, 8, 3);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// arms ready up
				PlayActiveRobotArmAnimation("move_into_position", 0, false, "OnAnimEnd_ResumeVictimIsBroughtForward");
				PlayActiveTortureToolAnimation("move_into_position", 0, false);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				PlayActiveRobotArmAnimation("torture_idle", 0, true);
				PlayActiveTortureToolAnimation("torture_idle", 0, true);
				
				SetTortureSoundState("idle");
				SetTortureEffectsState("idle");
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				// unlock torture panel controls				
				mbTorturePanelActive = true;
				SetTortureLeverState(true, false);
				SetTortureMeterState(eTortureMeterState_Danger);
				SetTortureMeterAmount(1.0f - mfTorture_VictimVitae);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ResumeVictimIsBroughtForward(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("Seq_VictimIsBroughtForward");
		}
		
		//-------------------------------------------------------
		
		void OnAnimationMessage_ResumeVictimIsBroughtForward(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			SequenceStates_Resume("Seq_VictimIsBroughtForward");
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Set up the torture machine*
		
		/////////////////////////////////////////
		// Event A *Attempt to talk to the victim*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlVictimTalkStage = 1;
		bool mbVictimLookedAt = false;
		bool mbVictimTalkActive = false;
		
		//-------------------------------------------------------
		
		void SetVictimTalkActive(bool abX)
		{
			mbVictimTalkActive = abX;
			if (abX && mbVictimLookedAt) Entity_SetActive("Trigger_TalkToVictim", true);
			else Entity_SetActive("Trigger_TalkToVictim", false);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_VictimTalk(const tString &in asEntity, int alState)
		{
			mbVictimLookedAt = alState == 1;
			if (mbVictimTalkActive && mlVictimTalkStage == 1) Entity_SetActive("Trigger_TalkToVictim", mbVictimLookedAt);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_TalkToVictim(const tString &in asEntity)
		{
			if (mlVictimTalkStage == 1) Voice_Play("Dialogue_ToVictimBeforeTorture", -1, "OnVoiceEnd_TalktToVictim");
//			else if (mlVictimTalkStage == 2) Voice_Play("Dialogue_ToVictimAfterTorture", -1, "OnVoiceEnd_TalktToVictim");
//			else if (mlVictimTalkStage == 3) Voice_Play("Dialogue_ThankVictim", -1, "OnVoiceEnd_TalktToVictim");
			
			SetVictimTalkActive(false);
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_TalktToVictim(const tString&in asScene, const tString&in asSubject)
		{
			if (mlVictimTalkStage == 1 && Voice_SubjectHasUnplayedLines("Dialogue_ToVictimBeforeTorture") == false) return;
			if (mlVictimTalkStage == 2 && Voice_SubjectHasUnplayedLines("Dialogue_ToVictimAfterTorture") == false) return;
			if (mlVictimTalkStage == 3 && Voice_SubjectHasUnplayedLines("Dialogue_ThankVictim") == false) return;
			
			Map_AddTimer("Timer_SetVictimTalkActive", 1.0, "OnTimer_SetVictimTalkActive");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetVictimTalkActive(const tString &in asTimer)
		{
			SetVictimTalkActive(true);
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Attempt to talk to the victim*
		
		/////////////////////////////////////////
		// Event A *Torture the victim*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbTorture_Over = false;
		bool mbTorture_Active = false;
		bool mbTorture_AnimStarted = false;
		bool mbTorture_ExtractionEnabled = false;
		bool mbTorture_CanChangeFlow = true;
		bool mbTorture_ShutterClosed = false;
		float mfTorture_VictimVitae = 1;
		float mfTorture_ExtractionTime = 20.0f;
		bool mbTorture_ExtractionActive = false;
		tString msTorture_SoundState = "";
		bool mbVictimTortured = false;
		tID m_idTortureMeter = tID_Invalid;
		eTortureMeterState mTortureMeterState = eTortureMeterState_Inactive;
		cColor mTortureMeterColor_Good = cColor(0.0, 0.2, 1.0) * 1.0;
		cColor mTortureMeterColor_Warning = cColor(1.0, 0.9, 0.5) * 2;
		cColor mTortureMeterColor_Bad = cColor(1.0, 0.8, 0.2) * 2;
		cColor mTortureMeterColor_Danger = cColor(1.0, 0.2, 0.0) * 2;
		float mfTortureMeterPulseTime = 0;
		bool mbAfterLittleTortureBabyTalk = false;
		tID m_idTorture_LeverRampSound = tID_Invalid;
		float mfTorture_LeverRampSoundTimer = 0;
		float mfTorture_LeverLightPulseTimer = 0;
		float mfTorture_LeverLightPulseMulGoal = 0;
		float mfTorture_LeverLightPulseMul = 0;
		
		//-------------------------------------------------------
		
		void UpdateTorture(float afTimeStep)
		{
			if (mbTorture_Active && mbTorture_ShutterClosed == false)
			{
				if (msTortureType == "drilling" && GetActiveRobotArmAnimationIsActive("start_torture") && GetActiveRobotArmAnimationTime("start_torture") >= 5.9f ||
					msTortureType == "burning" && GetActiveRobotArmAnimationIsActive("start_torture") && GetActiveRobotArmAnimationTime("start_torture") >= 5.9f ||
					msTortureType == "drowning" && GetActiveRobotArmAnimationIsActive("start_torture") && GetActiveRobotArmAnimationTime("start_torture") >= 6.0f)
				{
					CloseShutter();
				}
			}
			
			if (mbTorture_Active && mbTorture_ExtractionEnabled)
			{
				float fStopMul = cMath_Clamp((mfTorture_VictimVitae) / (0.7f), 0.0f, 1.0f);
				fStopMul = cMath_Easing(eEasing_QuadOut, fStopMul);
				float fDrainSpeed = 0.012f + ((1 / mfTorture_ExtractionTime) * fStopMul);
				mfTorture_VictimVitae -= afTimeStep * fDrainSpeed;
				mfTorture_VictimVitae = cMath_Clamp(mfTorture_VictimVitae, 0.0f, 1.0f);
				SetTortureMeterAmount(1.0f - mfTorture_VictimVitae);
				
				// torture over
				if (mfTorture_VictimVitae <= 0)
				{
					StopTorture();
					mbTorture_Over = true;
					mbTorture_Active = false;
					mbTorture_CanChangeFlow = false;
					Seq_AfterTorture("");
				}
				
			}
			
			if (mbAfterLittleTortureBabyTalk == false && mfTorture_VictimVitae < 0.95)
			{
				mbAfterLittleTortureBabyTalk = true;
				Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_AfterTorturedALittle");
			}
			
			///////////////////
			// Lever ramp up
			float fLeverAmount = Lever_GetPulledAmount("Lever_Torture");
			bool bLeverRampOn = mbTortureRoomOn && mbTorturePanelActive && fLeverAmount <= 0.85f;
			
			if (bLeverRampOn && m_idTorture_LeverRampSound == tID_Invalid)
			{
				Sound_CreateAtEntity("LeverRamp", "03_07_dw_factory/torture_machine/lever", "Lever_Torture", 0, true, 1, 4, 71);
				cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("LeverRamp");
				m_idTorture_LeverRampSound = pSound.GetID();
			}
			else
			{
				cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idTorture_LeverRampSound);
				if (pSound !is null)
				{
					float fVolMul = 1.0f - cMath_Clamp((fLeverAmount - 0.2f) / (0.85f - 0.2f), 0.0f, 1.0f);
					float fOnMul = bLeverRampOn ? 1 : 0;
					float fTortureActiveMul = mbTorture_Active ? 0 : 1.0f;
					pSound.FadeVolumeMul(fTortureActiveMul * (0.5 * fOnMul + 0.5 * fVolMul), bLeverRampOn ? 0 : 1);
					pSound.FadeSpeedMul(1.0f + fVolMul * 3.0f, 0);
					
					if (bLeverRampOn) mfTorture_LeverRampSoundTimer = 0;
					else
					{
						mfTorture_LeverRampSoundTimer += afTimeStep;
						if (mfTorture_LeverRampSoundTimer >= 0.5)
						{
							pSound.FadeOut(2);
							m_idTorture_LeverRampSound = tID_Invalid;
						}
					}
				}
			}
			
			if (mbTorturePanelActive && bLeverRampOn)
			{
				float fLeverLightBrightness = 0.8;
				cColor leverLightColor = mTorturePanelLightColor_Unlocked;
			
				float fRampMul = 1.0f - cMath_Clamp((fLeverAmount - 0.15f) / (0.85f - 0.15f), 0.0f, 1.0f);
					
				mfTorture_LeverLightPulseMulGoal = 0;
				if (mfTorture_LeverLightPulseTimer > 0)
				{
					mfTorture_LeverLightPulseTimer -= afTimeStep * 4;
					mfTorture_LeverLightPulseMulGoal = 1;
					if (mfTorture_LeverLightPulseTimer < 0) mfTorture_LeverLightPulseTimer = 0;
				}
				mfTorture_LeverLightPulseMul = cMath_IncreaseTo(mfTorture_LeverLightPulseMul, afTimeStep * 2, mfTorture_LeverLightPulseMulGoal);
				
//				fLeverLightBrightness = 0.8f + 1.0f * fRampMul + 1.5f * mfTorture_LeverLightPulseMul;
				fLeverLightBrightness = 0.8f + 1.0f * fRampMul;
				if (mbTorture_Active) leverLightColor = mTorturePanelLightColor_Torture;
				
				SetButtonColor("Lamp_TortureLever", leverLightColor * fLeverLightBrightness);
			}
			
			
			///////////////////
			// Set torture pulse color
			if (mbTorture_Active)
			{
				if (mfTorture_VictimVitae > 0.7) SetTortureMeterState(eTortureMeterState_Danger);
				else if (mfTorture_VictimVitae > 0.4) SetTortureMeterState(eTortureMeterState_Bad);
				else if (mfTorture_VictimVitae > 0.1) SetTortureMeterState(eTortureMeterState_Warning);
				else if (mfTorture_VictimVitae >= 0) SetTortureMeterState(eTortureMeterState_Good);
			}
			
			/////////////////////
			// Play torture idle when start torture returns to 0
			if (mbTorture_AnimStarted && GetActiveRobotArmAnimationIsActive("start_torture") && GetActiveRobotArmAnimationTime("start_torture") == 0)
			{
				mbTorture_AnimStarted = false;
				PlayActiveRobotArmAnimation("torture_idle", 0, true);
				PlayActiveTortureToolAnimation("torture_idle", 0, true);
				Entity_PlayAnimation("TortureVictim", msTortureVictim_Idle, 0.2f, true);
			}
		}
		
		//-------------------------------------------------------
		
		void UpdateVitaePipes(float afTimeStep)
		{
			if (mfVitaePipe_UvSpeedTarget != mfVitaePipe_UvSpeed)
			{
				mfVitaePipe_UvSpeed = cMath_IncreaseTo(mfVitaePipe_UvSpeed, 0.1f * afTimeStep, mfVitaePipe_UvSpeedTarget);
			}
			
			if (mfVitaePipe_VitaeCoverage != mfVitaePipe_VitaeCoverageTarget)
			{
				mfVitaePipe_VitaeCoverage = cMath_IncreaseTo(mfVitaePipe_VitaeCoverage, 0.75f * afTimeStep, mfVitaePipe_VitaeCoverageTarget);
				cSubMeshEntity@ pPipeVitae = cLux_ID_SubMeshEntity(m_idVitaePipe_Vitae);
				if (pPipeVitae !is null) pPipeVitae.SetCoverageAmount(mfVitaePipe_VitaeCoverage);
			}
			
			if ((mfVitaePipe_UvSpeed == 0 && mfVitaePipe_PrevUvSpeed != 0) || mfVitaePipe_UvSpeed != 0)
			{
				mfVitaePipe_UvTime += afTimeStep * mfVitaePipe_UvSpeed;
				cSubMeshEntity@ pPipeVitae = cLux_ID_SubMeshEntity(m_idVitaePipe_Vitae);
				if (pPipeVitae !is null) pPipeVitae.GetMaterial().SetUvAnimationTime(0, mfVitaePipe_UvTime);
			}
			mfVitaePipe_PrevUvSpeed = mfVitaePipe_UvSpeed;
		}
		
		//-------------------------------------------------------
		
		void SetTortureMeterState(eTortureMeterState aState, bool abInstant = false, bool abSaveState = true)
		{
			if (abSaveState && mTortureMeterState == aState) return;
			if (abSaveState) mTortureMeterState = aState;
			if (mbTortureRoomOn == false && abSaveState) return;
			
			Map_RemoveTimer("Timer_TortureMeterPulse");
			
			if (aState == eTortureMeterState_Inactive)
			{
				StopSubMeshIllumFade(m_idTortureMeter, 0, false);
				cLux_ID_SubMeshEntity(m_idTortureMeter).SetIlluminationColor(cColor(0));
			}
			else if (aState == eTortureMeterState_Done)
			{
				StopSubMeshIllumFade(m_idTortureMeter, 0, false);
				cLux_ID_SubMeshEntity(m_idTortureMeter).SetIlluminationColor(cColor(0.0, 0.8, 1.0) * 0.8);
			}
			else
			{
				float fTime = 1.0f;
				cColor baseColor = cColor_White;
				cColor flashColor = cColor_White;
				
				if (aState == eTortureMeterState_Good)
				{
					fTime = 0.22f;
					baseColor = cColor(0.5, 1.0, 0.0) * 0.6;
					flashColor = baseColor * 1.15;
				}
				else if (aState == eTortureMeterState_Warning)
				{
					fTime = 0.4f;
					baseColor = cColor(1.0, 0.8, 0.0) * 0.7;
					flashColor = baseColor * 1.1;
				}
				else if (aState == eTortureMeterState_Bad)
				{
					fTime = 0.7f;
					baseColor = cColor(1.0, 0.3, 0.0) * 1.0;
					flashColor = baseColor * 1.2;
				}
				else if (aState == eTortureMeterState_Danger)
				{
					fTime = 1.0f;
					baseColor = cColor(1.0, 0.0, 0.0) * 1.1;
					flashColor = baseColor * 1.3;
				}
				
				FadeSubMeshIllumColor(m_idTortureMeter, baseColor, fTime, -1, true, flashColor, eEasing_SineOut, eEasing_SineIn);
				
				mfTortureMeterPulseTime = fTime * 2;
				Map_AddTimer("Timer_TortureMeterPulse", fTime * 2 - 0.2, "OnTimer_TortureMeterPulse");
			}
			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TortureMeterPulse(const tString &in asTimer)
		{
			if (mbTorture_Active) mfTorture_LeverLightPulseTimer = 1;
			Sound_CreateAtEntity("PulseMeter", "03_07_dw_factory/torture_machine/heartbeat", "TorturePanel_Lights", 0.0f, false, 1.0f);
			Map_RestartCurrentTimer(mfTortureMeterPulseTime);
		}
		
		//-------------------------------------------------------
		
		float mfTortureMeterAmount = 0;
		void SetTortureMeterAmount(float afAmount)
		{
			cSubMeshEntity@ pSub = cLux_ID_SubMeshEntity(m_idTortureMeter);
			if (pSub is null) return;
			
//			float fT = cMath_Clamp(afAmount / 1.13f, 0.0f, 1.0f);
			float fT = afAmount;
			fT = (fT * 0.49f) - 0.01f;
			pSub.GetMaterial().SetUvAnimationSpeed(0, 0);
			pSub.GetMaterial().SetUvAnimationTime(0, fT);
			
			mfTortureMeterAmount = fT;
		}
		
		//-------------------------------------------------------
		
		void SetTortureSoundState(const tString &in asState, bool abSaveState = true)
		{
			if (abSaveState && asState == msTorture_SoundState) return;
			if (asState == "") StopOtherTortureSoundStates("");
			
			if (abSaveState) msTorture_SoundState = asState;
			if (mbTortureRoomOn == false && abSaveState) return;
			
			StopOtherTortureSoundStates(asState);
			
			if (asState == "idle")
			{
				tString sSound = "";
				if (msTortureType == "drilling") sSound = "03_07_dw_factory/torture_machine/drill_intensity";
				else if (msTortureType == "burning") sSound = "03_07_dw_factory/torture_machine/fire_intensity";
				else if (msTortureType == "drowning") sSound = "03_07_dw_factory/torture_machine/water_intensity";
				if (Sound_Exists("TortureTools_Idle") == false) Sound_CreateAtEntity("TortureTools_Idle", sSound, "Target_TortureMachineSounds", 0, true, 1, 8, 25);
				Sound_SetParam("TortureTools_Idle", "intensity", 0.3);
//				cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("TortureTools_Idle");
//				if (pSound !is null) pSound.FadeVolumeMul(1.0, 1);
			}
			else if (asState == "ramp")
			{
				tString sSound = "";
				if (msTortureType == "drilling") sSound = "level_dreams/anim/torture_machine/drill/loop";
				else if (msTortureType == "burning") sSound = "level_dreams/anim/torture_machine/flame/loop";
				else if (msTortureType == "drowning") sSound = "level_dreams/anim/torture_machine/water/loop";
				
				if (Sound_Exists("TortureTools_Idle") == false) Sound_CreateAtEntity("TortureTools_Idle", sSound, "Target_TortureMachineSounds", 0, true, 1, 8, 25);
				Sound_SetParam("TortureTools_Idle", "intensity", 1);
//				cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("TortureTools_Idle");
//				if (pSound !is null) pSound.FadeVolumeMul(1.0, 1);
			}
			else if (asState == "full")
			{
				tString sSound = "";
				if (msTortureType == "drilling") sSound = "level_dreams/anim/torture_machine/drill/loop";
				else if (msTortureType == "burning") sSound = "level_dreams/anim/torture_machine/flame/loop";
				else if (msTortureType == "drowning") sSound = "level_dreams/anim/torture_machine/water/loop";
				Sound_CreateAtEntity("TortureTools_Full", sSound, "Target_TortureMachineSounds", 0, true, 1, 8, 25);
			}
		}
		
		//-------------------------------------------------------
		
		void StopOtherTortureSoundStates(const tString &in asState)
		{
			if (asState != "idle" && asState != "ramp") Sound_Stop("TortureTools_Idle", 0.5);
			if (asState != "full") Sound_Stop("TortureTools_Full", 0.5);
		}
		
		//-------------------------------------------------------
		
		tString msTortureEffectsState = "";
		void SetTortureEffectsState(const tString &in asState, bool abSaveState = true)
		{
			if (abSaveState && asState == msTortureEffectsState) return;
			if (abSaveState) msTortureEffectsState = asState;
			if (mbTortureRoomOn == false && abSaveState) return;
				
			if (asState == "idle")
			{
			}
			else if (asState == "ramp")
			{
			}
			else if (asState == "full")
			{
			}
			
			// per active arm
			for (int i = 0; i < mvRobotArmState.size(); ++i)
			{
				if (mvRobotArmState[i] != 2) continue;
				
				tString sTool = mvRobotArmAttach[i];
				
				if (asState == "idle")
				{
					if (msTortureType == "burning") SetBurnerState(sTool, 2, 0.5f);
					else if (msTortureType == "drowning") SetDrownerState(sTool, 1, 0.5f);
				}
				else if (asState == "ramp")
				{
					if (msTortureType == "burning") SetBurnerState(sTool, 3, 0.5f);
					else if (msTortureType == "drowning") SetDrownerState(sTool, 2, 0.5f);
				}
				else if (asState == "full")
				{
					if (msTortureType == "burning") SetBurnerState(sTool, 3, 0.5f);
					else if (msTortureType == "drowning") SetDrownerState(sTool, 2, 0.5f);
				}
				else if (asState == "")
				{
					if (msTortureType == "burning") SetBurnerState(sTool, 0, 0.5f);
					else if (msTortureType == "drowning") SetDrownerState(sTool, 0, 0.5f);
				}
			}
		}
		
		//-------------------------------------------------------
		
		void SetActiveBurnerState(int alState)
		{
			for (int i = 0; i < mvRobotArmState.size(); ++i)
			{
				if (mvRobotArmState[i] != 2) continue;
				tString sTool = mvRobotArmAttach[i];
				SetBurnerState(sTool, alState, 0.5);
			}
		}

		//-------------------------------------------------------
		
		void SetActiveDrownerState(int alState)
		{
			
		}
		
		//-------------------------------------------------------
		
		void StartTorture(bool abRestart = false)
		{
			if (mbTorture_CanChangeFlow == false) return;
			if (mbTorture_Active) return;
			mbTorture_Active = true;
			
			Sound_CreateAtEntity("TortureStart", "02_07_alchemist_lab/life_support/energy_on", "Lamp_TortureLever", 0, false, 1, 5, 12);
			
			if (mbTorture_ExtractionEnabled == false)
			{
				if (GetActiveRobotArmAnimationIsActive("start_torture") == false)
				{
					mbTorture_AnimStarted = true;
					PlayActiveRobotArmAnimation("start_torture", 0);
					PlayActiveTortureToolAnimation("start_torture", 0);
					if (msTortureType == "drowning")
					{
						Entity_PlayAnimation("TortureVictim", "torture_start_drowning", 0.2f, false);
					}
					else
					{
						Entity_PlayAnimation("TortureVictim", "torture_start_burning_drilling", 0.2f, false);
					}
					
				}
				SetActiveRobotArmAnimationSpeed("start_torture", 1);
				SetActiveTortureToolAnimationSpeed("start_torture", 1);
				if (msTortureType == "drowning") Map_GetEntity("TortureVictim").GetMeshEntity().GetAnimationStateFromName("torture_start_drowning").SetSpeed(1);
				else Map_GetEntity("TortureVictim").GetMeshEntity().GetAnimationStateFromName("torture_start_burning_drilling").SetSpeed(1);
				
				SetTortureSoundState("ramp");
				SetTortureEffectsState("ramp");
			}
			else
			{
				if (mbTorture_ExtractionActive == false)
				{
					mbTorture_ExtractionActive = true;
					
					Voice_Stop("Victim");
					tString sTortureVoiceSubject = "";
					if (msTortureType == "drilling") sTortureVoiceSubject = "Victim_Tortured_Drilling";
					else if (msTortureType == "burning") sTortureVoiceSubject = "Victim_Tortured_Burning";
					else if (msTortureType == "drowning") sTortureVoiceSubject = "Victim_Tortured_Drowning";
					Voice_PlayPeriodically(sTortureVoiceSubject, 0, 0, abRestart ? 0 : 1);
					
					// tasi reaction
					if (Voice_SubjectHasUnplayedLines("Dialogue_TasiRealisesSheIsTorturing")) Map_AddTimer("Timer_TasiTortureReaction", 2, "OnTimer_TasiTortureReaction");
//					else Voice_Play("Dialogue_TasiTortures");
					
					SetTortureSoundState("full");
					SetTortureEffectsState("full");
				}
			}
			
			if (mbTorture_ExtractionActive == false && abRestart == false)
			{
				Player_StartLookAt("Target_TortureLookAt", 1.0f, 1.25f, 1.5f, true);
			}
			else if (mbTorture_ExtractionActive)
			{
				Player_StartLookAt("Target_TortureLookAt_2", 1.0f, 1.25f, 1.5f, true);
			}
			cLux_GetPlayer().AutomoveCharBodyTo(1.5f, 1.5f, 1.5f, Map_GetEntity("Target_PlayerTorturePos").GetPosition());
			Player_SetMoveSpeedMul(0.0f);
			
//			Entity_SetEffectsActive("Lamp_TortureTop", true, true);
//			if (Sound_Exists("TortureMachine") == false) Sound_CreateAtEntity("TortureMachine", "03_07_dw_factory/lab_torture_pods/pod_torture_start", "Target_TortureMachineSounds", 0, true, 0.5, 5, 20);
		}
		
		//-------------------------------------------------------
		
		void StopTorture()
		{
			if (mbTorture_CanChangeFlow == false) return;
			if (mbTorture_Active == false) return;
			mbTorture_Active = false;
			
			Sound_CreateAtEntity("TortureStop", "02_07_alchemist_lab/life_support/energy_off", "Lamp_TortureLever", 0, false, 1, 5, 12);
			
			if (mbTorture_ExtractionEnabled == false)
			{
				SetActiveRobotArmAnimationSpeed("start_torture", -1);
				SetActiveTortureToolAnimationSpeed("start_torture", -1);
				if (msTortureType == "drowning") Map_GetEntity("TortureVictim").GetMeshEntity().GetAnimationStateFromName("torture_start_drowning").SetSpeed(-1);
				else Map_GetEntity("TortureVictim").GetMeshEntity().GetAnimationStateFromName("torture_start_burning_drilling").SetSpeed(-1);
				
				SetTortureSoundState("idle");
				SetTortureEffectsState("idle");
			}
			else
			{
				if (mbTorture_ExtractionActive)
				{
					mbTorture_ExtractionActive = false;
					Sound_Stop("TortureTest", 0.5);
					
					Voice_Stop("Victim");
					Voice_Play("Victim_TortureBreaksOff");
					
					Voice_StopPeriodic();
					Voice_PlayPeriodically("Victim_Mumble_Tortured", 10, 20, 6);
					
					SetTortureSoundState("idle");
					SetTortureEffectsState("idle");
					
					Map_RemoveTimer("Timer_TasiTortureReaction");
					
//					if (mbDialogue_TasiTortureReaction) Voice_PlayDelayed("Dialogue_TasiStopsTorturingFirstTime", 1);
				}
			}
			
			Player_StopLookAt(0.5f);
			cLux_GetPlayer().StopAutomoveCharBody();
			Player_SetMoveSpeedMul(1.0f);
			
//			StopBlinkButton("Lamp_TortureLever", false);
//			SetButtonColor("Lamp_TortureLever", mTorturePanelLightColor_Unlocked, true);
			
//			Entity_SetEffectsActive("Lamp_TortureTop", false, true);
			Sound_Stop("TortureMachine", 0.5);
		}
		
		//-------------------------------------------------------
		
		void CloseShutter()
		{
			mbVictimTortured = true;
			mbTorture_ShutterClosed	 = true;
			mbTorture_CanChangeFlow = false;
			mlVictimTalkStage = 2;
//			Entity_SetAnimationMessageEventCallback("TortureShutter", "OnAnimationMessage_ResumeTorture", true);
			Entity_PlayAnimation("TortureShutter", "rnd_torture_shutters_brought_down", 0);
			
			Voice_Stop("Victim");
			Voice_Play("Victim_AsShuttersClose");
			
			Music_PlayExt("A2_3_7_Torture_Begin_VersionA", false, 0.3f, 1.0f, 0.5f, 1.0f, eMusicPrio_MinorEvent, true);
			Music_Play("A2_3_7_Torture_Suspense_VersionA", 0.3, true, eMusicPrio_SceneAmb);
			
			Map_AddTimer("Timer_ResumeTortureControl", 1, "OnTimer_ResumeTortureControl");
		}
		
		//-------------------------------------------------------
		
		void OnInteract_TortureLever(const tString &in asEntity)
		{
			Player_StartLookAt("Target_TortureLeverLookAt", 1.0f, 1.25f, 1.5f, true);
			cLux_GetPlayer().AutomoveCharBodyTo(1.5f, 1.5f, 1.5f, Map_GetEntity("Target_PlayerTorturePos").GetPosition());
			Player_SetMoveSpeedMul(0.0f);
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_TortureLever(const tString &in asEntity)
		{
			Player_StopLookAt(0.5f);
			cLux_GetPlayer().StopAutomoveCharBody();
			Player_SetMoveSpeedMul(1.0f);
		}
		
		//-------------------------------------------------------
	
		void OnConnectionStateChange_DoTorture(const tString &in asEntity, int alState)
		{
			if (Entity_GetVarBool(asEntity, "ConnectionStateChange") == false) return;
			if (alState == -1)
			{
				StartTorture();
//				Lever_SetStuckState(asEntity, -1, false);
//				Map_AddTimer(asEntity, 1.5, "OnTimer_ReleaseTortureLever");
			}
			else
			{
				StopTorture();
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ReleaseTortureLever(const tString &in asTimer)
		{
			Lever_SetStuckState(asTimer, 0, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResumeTortureControl(const tString &in asTimer)
		{
			mbTorture_ExtractionEnabled = true;
			mbTorture_CanChangeFlow = true;
			if (Lever_GetState("Lever_Torture") == -1)
			{
				// start torture again extraction effects
				mbTorture_Active = false;
				StartTorture(true);
			}
			else
			{
				StopTorture();
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TasiTortureReaction(const tString &in asTimer)
		{
			if (mbTorture_Active == false) return;
			mbDialogue_TasiTortureReaction = true;
			mbDialogue_TasiKnowsSheNeedsToTorture = true;
			Voice_Play("Dialogue_TasiRealisesSheIsTorturing");
		}
		
		//-------------------------------------------------------
		
		bool mbForwardButtonLocked = true;
		bool mbTortureSectionLocked = true;
		bool mbTortureChamberDoorsLocked = false;
		bool mbVictimMoving = false;
		float mfVitaePipe_UvSpeedTarget = 0;
		float mfVitaePipe_UvSpeed = 0;
		float mfVitaePipe_PrevUvSpeed = 0;
		float mfVitaePipe_VitaeCoverage = 1;
		float mfVitaePipe_VitaeCoverageTarget = 1;
		float mfVitaePipe_UvTime = 0;
		tID m_idVitaePipe = tID_Invalid;
		tID m_idVitaePipe_Vitae = tID_Invalid;
		
		//-------------------------------------------------------
		
		void InitVitaePipe()
		{
			Entity_SetEffectsActive("VitaePipe_TortureBooth", false, false);
			
			iLuxEntity@ pPipe = Map_GetEntity("VitaePipe_TortureBooth");
			m_idVitaePipe = pPipe.GetMeshEntity().GetID();
			cSubMeshEntity@ pPipeVitae = pPipe.GetMeshEntity().GetSubMeshEntityName("vitae");
			m_idVitaePipe_Vitae = pPipeVitae.GetID();
			cMaterial@ pPipeMat = pPipeVitae.GetMaterial();
			pPipeMat.SetUvAnimationSpeed(0, 0);
			pPipeMat.SetUvAnimationTime(0, 0);
			mfVitaePipe_UvTime = 0;
		}

		//-------------------------------------------------------
		
		void InitTorturePipes()
		{
			cSubMeshEntity@ pTopMesh = Map_GetEntity("TortureTubes").GetMeshEntity().GetSubMeshEntityName("tubes_inner_top");
			pTopMesh.SetIlluminationColor(mTortureTubesTopColor);
			pTopMesh.GetMaterial().SetUvAnimationSpeed(0, 0);
			pTopMesh.GetMaterial().SetUvAnimationTime(0, 0);
			mvTorturePipes.push_back(pTopMesh.GetID());
			mvTorturePipes_Times.push_back(0);
			
			cSubMeshEntity@ pBottomMesh = Map_GetEntity("TortureTubes").GetMeshEntity().GetSubMeshEntityName("tubes_inner_bottom");
			pBottomMesh.SetIlluminationColor(mTortureTubesBottomColor);
			pBottomMesh.GetMaterial().SetUvAnimationSpeed(0, 0);
			pBottomMesh.GetMaterial().SetUvAnimationTime(0, 0);
			mvTorturePipes.push_back(pBottomMesh.GetID());
			mvTorturePipes_Times.push_back(0);
			
			cSubMeshEntity@ pArm1 = Map_GetEntity("TortureArm_1").GetMeshEntity().GetSubMeshEntityName("m_Arm_1_tubes_inner");
			pArm1.SetIlluminationColor(mTortureTubesBottomColor);
			pArm1.GetMaterial().SetUvAnimationSpeed(0, 0);
			pArm1.GetMaterial().SetUvAnimationTime(0, 0);
			mvTorturePipes.push_back(pArm1.GetID());
			mvTorturePipes_Times.push_back(0);
			
			cSubMeshEntity@ pArm2 = Map_GetEntity("TortureArm_2").GetMeshEntity().GetSubMeshEntityName("m_Arm_2_tubes_inner");
			pArm2.SetIlluminationColor(mTortureTubesBottomColor);
			pArm2.GetMaterial().SetUvAnimationSpeed(0, 0);
			pArm2.GetMaterial().SetUvAnimationTime(0, 0);
			mvTorturePipes.push_back(pArm2.GetID());
			mvTorturePipes_Times.push_back(0);
			
			cSubMeshEntity@ pArm5 = Map_GetEntity("TortureArm_5").GetMeshEntity().GetSubMeshEntityName("m_Arm_5_tubes_inner");
			pArm5.SetIlluminationColor(mTortureTubesTopColor);
			pArm5.GetMaterial().SetUvAnimationSpeed(0, 0);
			pArm5.GetMaterial().SetUvAnimationTime(0, 0);
			mvTorturePipes.push_back(pArm5.GetID());
			mvTorturePipes_Times.push_back(0);
		}
		
		//-------------------------------------------------------
		
		void SetVitaePipeSpeedTarget(float afSpeed, bool abInstant = false)
		{
			mfVitaePipe_UvSpeedTarget = afSpeed;
			if (abInstant)
			{
				mfVitaePipe_UvSpeed = mfVitaePipe_UvSpeedTarget;
				cMaterial@ pPipeMat = cLux_ID_SubMeshEntity(m_idVitaePipe_Vitae).GetMaterial();
				pPipeMat.SetUvAnimationSpeed(0, mfVitaePipe_UvSpeed);
			}
		}
		
		//-------------------------------------------------------
		
		void SetVitaePipeTime(float afTime)
		{
			cMaterial@ pPipeMat = cLux_ID_SubMeshEntity(m_idVitaePipe_Vitae).GetMaterial();
			pPipeMat.SetUvAnimationTime(0, afTime);
		}
		
		//-------------------------------------------------------
		
		void SetVitaePipeCoverageTarget(float afCoverage, bool abInstant = false)
		{
			mfVitaePipe_VitaeCoverageTarget = afCoverage;
			if (abInstant)
			{
				mfVitaePipe_VitaeCoverage = mfVitaePipe_VitaeCoverageTarget;
				cLux_ID_SubMeshEntity(m_idVitaePipe_Vitae).SetCoverageAmount(mfVitaePipe_VitaeCoverage);
			}
		}
		
		//-------------------------------------------------------
		
		void SetVictimForwardButtonState(bool abActive, bool abLocked)
		{
			mbForwardButtonLocked = abLocked;
			SetButtonActive("Button_VictimForward", abActive);
			SetButtonColor("Button_VictimForward", mbForwardButtonLocked ? mButtonColor_Red : mButtonColor_White);
		}
		
		//-------------------------------------------------------
		
		void FlashBoothIndicators()
		{
			FlashButton("Lamp_TortureTopArm_1", 4);
			FlashButton("Lamp_TortureTopArm_2", 4);
			FlashButton("Lamp_TortureTopArm_3", 4);
			FlashButton("Lamp_TortureTopArm_4", 4);
			FlashButton("Lamp_TortureTopWater", 4);
			FlashButton("Indicator_TortureSource", 4);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_VictimForward(const tString &in asEntity)
		{
			if (Entity_GetVarBool(asEntity, "ButtonActive") == false) return;
			
			FlashButton(asEntity);
			if (mbForwardButtonLocked)
			{
				Sound_CreateAtEntity("ButtonPress", "03_07_dw_factory/torture_victim/machine_feedback/machine_negative", asEntity);
				FlashBoothIndicators();
			}
			else
			{
				Sound_CreateAtEntity("ButtonPress", "03_07_dw_factory/torture_victim/machine_feedback/machine_Positive", asEntity);
				Seq_BringVictimForward("");
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceBringVictimForward;
		void Seq_BringVictimForward(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BringVictimForward", mSequenceBringVictimForward);
			if (Sequence_DoStepAndWait(1))
			{
				// close front glass
				SlideDoor_SetOpenAmount("Door_TortureBoothGlassFront", 0, false);
				
				Voice_StopPeriodic();
				SetVictimForwardButtonState(false, true);
				SetButtonActive("Button_OpenTortureBooth", false);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				SlideDoor_SetOpenAmount("Door_TortureBoothGlassBack", 1, false);
				SlideDoor_SetOpenAmount("Door_TortureBoothGlassFront", 0, false);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Prop_MoveLinearTo("TortureVictim_Booth", "TortureVictim_Booth_Target_1", 2, 2, 0, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				SlideDoor_SetOpenAmount("Door_TortureBoothGlassBack", 0, false);
				SetTortureSectionActive(true, false);
				SetTortureLeverState(true, false);
				
				Voice_SetSource("Victim", "TortureVictim_Booth", 0, 10, true);
				Voice_PlayPeriodically("Victim_Mumble_WaitForTorture", 5, 10, 0);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				mbVictimForward = true;
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void SetTortureSectionActive(bool abX, bool abLocked)
		{
			mbTortureSectionLocked = abLocked;
			bool bLever = abX && abLocked == false;
			SetTortureLeverState(abX, abLocked);
			SetButtonColor("Lamp_TortureLever", bLever ? mButtonColor_Green : mButtonColor_Red);
			
			bool bMeters = abX && (abLocked == false || mbTortureSuspended);
			
			SetMeterActive("Meter_Victim_1", bMeters);
			
			SetMeterActive("Meter_Canister_1", bMeters);
			SetMeterValue("Meter_Canister_1", mfCanisterVitae);
			
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceAfterTorture;
		void Seq_AfterTorture(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AfterTorture", mSequenceAfterTorture);
			if (Sequence_DoStepAndPause(0))
			{
				Pregnancy_ClearBabyTalkSpecialSubject();
				
				// final troture machine sounds
				SetTortureSoundState("");
				tString sSound = "";
				if (msTortureType == "drilling") sSound = "03_07_dw_factory/torture_machine/drill/end";
				else if (msTortureType == "burning") sSound = "03_07_dw_factory/torture_machine/flame/end";
				else if (msTortureType == "drowning") sSound = "03_07_dw_factory/torture_machine/water/end";
				Sound_CreateAtEntity("TortureTools_End", sSound, "Target_TortureMachineSounds", 0, true, 1, 8, 25);
				
				Music_Stop(4, eMusicPrio_SceneAmb);
				
				// last scream
				Voice_StopPeriodic(true);
				Voice_StopAll();
				mlVictimTalkStage = 3;
				Voice_Stop("Victim");
				if (msTortureType == "drowning") Voice_Play("Victim_DeathScreamDrowning", -1, "OnVoiceEnd_ResumeAfterTorture");
				else Voice_Play("Victim_DeathScream", -1, "OnVoiceEnd_ResumeAfterTorture");
				
				// tasi reaction
				float fDelay = msTortureType == "drowning" ? 4 : 2;
				Voice_PlayDelayed("Dialogue_ReactToDying", fDelay);
				
				// turn off torture panel
				SetTortureLeverState(false, false);
				SetTortureCardSlotState(false, false);
				SetTortureMeterState(eTortureMeterState_Done);
				mbTorturePanelActive = false;
				
				// deactivate torture panel buttons
				SetButtonActive("Button_OpenTortureBooth", false);
				SetVictimForwardButtonState(false, true);
				SetTortureLeverState(false, true);
				
				// prevent player from sitting until it powers up
				Entity_SetActive("Trigger_EnterVitaeChair", false);
				
				// lock doors
				mbTortureChamberDoorsLocked = true;
				SetRnDDoorState("Door_TortureMiddle", true, false, false);
				SetRnDDoorState("Door_TortureChamber", true, false, false);
			}
			else if (Sequence_DoStepAndWait(1))
			{	
				// stop machine sounds
				SetTortureSoundState("");
				
				// set up lighting
				Lamp_SetLit("Lamp_TortureBooth_*", false, true);
				Lamp_SetLit("Lamp_TortureBench_*", false, true);
				
				if (mbTortureRoomOn)
				{
					FadeFreezerFogColor(cColor(0), 1.5f);
					Lamp_SetLit("Lamp_Freezer_Backlight_Lamp_*", false, true);
				}
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				PlayRobotArmAnimation("ready_tools_plug_pose");
				EmptyTopTortureTubes();
				EmptyBottomTortureTubes();
				SetCanisterIndicatorState(0);
				SetRobotArmsColor();
				
				// open outer window
//				SetFrontTortureWindowOpen(false);
				SetBackTortureWindowOpen(false);
				
				// setup post torture effects
				if (msTortureType == "drilling")
				{
					Decal_SetDynamicVisible("decal_post_torture_drill*", true);
				}
				Voice_PlayDelayed("Dialogue_EnoughTorture", 1);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				// remove victim
//				Entity_SetActive("TortureVictim", false);
//				Entity_SetActive("TortureHanger", false);
				
				// stop effects
				SetTortureEffectsState("");
				
				// open shutter
				Entity_PlayAnimation("TortureShutter", "rnd_torture_shutters_brought_down", 0, false, false, "");
				cAnimationState@ pAnim = Map_GetEntity("TortureShutter").GetMeshEntity().GetAnimationStateFromName("rnd_torture_shutters_brought_down");
				pAnim.SetRelativeTimePosition(0.23);
				pAnim.SetSpeed(-0.1);
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				// post torture particles
				if (msTortureType == "drowning") ParticleSystem_CreateAtEntity("AfterWater", "03_07_after_torture_water", "Target_AfterTorturePS_Drowning", false);	
				else if (msTortureType == "burning") ParticleSystem_CreateAtEntity("AfterFire", "03_07_after_torture_fire", "Target_AfterTorturePS_Burning", false);
				
				Sound_CreateAtEntity("VictimTakenOut", "03_07_dw_factory/hangar/hanger_up_robot_arms", "Target_TortureMachineSounds", 0, false, 1, 4, 20);
				Entity_PlayAnimation("TortureVictim", "dead", 0);
				Map_GetEntity("TortureVictim").GetMeshEntity().GetAnimationStateFromName("dead").SetRelativeTimePosition(0.1f);
				
				Entity_PlayAnimation("TortureHanger", "rnd_torutre_hanger_brought_out", 0);
				cAnimationState@ pAnim = Map_GetEntity("TortureHanger").GetMeshEntity().GetAnimationStateFromName("rnd_torutre_hanger_brought_out");
				pAnim.SetRelativeTimePosition(0.05);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				SetFrontTortureWindowOpen(true);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				//Sound_CreateAtEntity("VitaeFlowActivated", "03_04_pillar_room/pillar_activate/energy_start", "Target_TortureMachineSounds");
			}
			else if (Sequence_DoStepAndWait(1.7))
			{
				// enable vitae flow
				mbChairHasVitae = true;
				SetVitaePipeTime(0.0);
				SetVitaePipeSpeedTarget(0.02);
				Entity_SetEffectsActive("VitaePipe_TortureBooth", true, true);
				
				Entity_SetActive("Target_TracesOfTortureDialogue", true);
			}
			else if (Sequence_DoStepAndWait(1.7))
			{
				SetVitaePipeSpeedTarget(0.07);
			}
			else if (Sequence_DoStepAndWait(1.8))
			{
				SetVitaePipeSpeedTarget(0.2);
			}
			else if (Sequence_DoStepAndWait(0.3))
			{
				// activate chair
				Entity_PlayAnimation("dwf_vitae_chair", "vitae_chair_activates", 0.0f, false, false, "OnAnimationEnd_ResumeAfterTorture");
				Lamp_SetLit("Lamp_VitaeChairEnv*", true, true);
				Lamp_SetLit("Lamp_VitaeChair_*", true, false);
				BlinkButton("Lamp_VitaeChair_1");
				BlinkButton("Lamp_VitaeChair_2");
				BlinkButton("Lamp_VitaeChair_3");
				SetVitaeChairScannersActive(false);
				SetVitaeChairGeneralEffectsActive(true);
				
				Sound_CreateAtEntity("Sound_ActivateRight", "03_07_dw_factory/injection_chair/activate_right", "Target_VitaeChariRightArmSounds");
				Sound_CreateAtEntity("Sound_ActivateLeft", "03_07_dw_factory/injection_chair/activate_left", "Target_VitaeChariLeftArmSounds");
				Sound_CreateAtEntity("Sound_ActivateCentre", "03_07_dw_factory/injection_chair/activatte_center", "Target_VitaeCharirTopSounds");
				Sound_CreateAtEntity("Sound_ActivateEnergy", "03_07_dw_factory/injection_chair/activatte_energy_on", "dwf_vitae_chair");
				Sound_Play("Sound_InjectionChairIdle", 3.0f);
				
				Music_Play("A2_3_7_Chair_Activate.ogg", 0.2f, false, eMusicPrio_MinorEvent);
				
				// activate th
				mlChairReadyId = mbChairReadyPrimaryPos ? 1 : 2;
				msChairReadyEntity = "THGhost_ChairReady_" + mlChairReadyId;
				YoungTinHinan_SetCustomCoverage(msChairReadyEntity, 0.2);
				YoungTinHinan_Activate(msChairReadyEntity, 1.0);
				Entity_SetActive("Trigger_ChairReady_" + mlChairReadyId, true);
				Map_AddTimer("Timer_CheckChairReadyLookAt", 0, "OnTimer_CheckChairReadyLookAt");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// stop pipe movement
				SetVitaePipeSpeedTarget(0.0, true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				// enable chair enter
				Entity_SetActive("Trigger_EnterVitaeChair", true);
				Entity_PlayAnimation("dwf_vitae_chair", "vitae_chair_active_b", 0.0, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_ResumeAfterTorture(const tString&in asScene, const tString&in asSubject)
		{
			SequenceStates_Resume("Seq_AfterTorture");
		}
		
		//-------------------------------------------------------
		
		void OnAnimationEnd_ResumeAfterTorture(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("Seq_AfterTorture");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_TracesOfTortureDialogue(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_TracesOfTorture");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterTortureRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				if (mbTorture_Over == false && mbTorture_ShutterClosed)
					Music_PlayExt("A2_3_7_Torture_Suspense_VersionA", true, 0.3, 1.0f, 2.0f, 0, eMusicPrio_SceneAmb, true);
			}
			else
			{
				if (mbTorture_Over == false && mbTorture_ShutterClosed)
				{	
					Music_Stop(4, eMusicPrio_SceneAmb);
					Music_Stop(4, eMusicPrio_MinorEvent);
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Torture the victim*

		/////////////////////////////////////////
		// Event A *Tin Hinan appears in front of the chair*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlChairReadyId = -1;
		tString msChairReadyEntity = "";
		bool mbChairReadyPrimaryPos = true;
		float mfChairReadyOnScreenTimer = 0;
		bool mbChairReadyPlayed = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ChairReadySpawn2(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbChairReadyPrimaryPos = alState != 1;
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_ChairReady(const tString &in asEntity, int alState)
		{
			if (mbChairReadyPlayed == false) Seq_THChairReadyScene("");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckChairReadyLookAt(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.2, 0.4);
			iLuxEntity@ pTrigger = Map_GetEntity("Trigger_ChairReadyScreen_" + mlChairReadyId);
			if (pTrigger.CheckIsOnScreen(true))
			{
				mfChairReadyOnScreenTimer += fNext;
				if (mfChairReadyOnScreenTimer >= 2.0)
				{
					if (mbChairReadyPlayed == false) Seq_THChairReadyScene("");
					return;
				}
			}
			else
			{
				mfChairReadyOnScreenTimer = 0;
			}
			
			if (Player_GetDistanceToEntity(msChairReadyEntity) <= 4)
			{
				if (mbChairReadyPlayed == false) Seq_THChairReadySceneSmall("");
				return;
			}
			
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTHChairReadyScene;
		void Seq_THChairReadyScene(const tString &in asTimer)
		{			
			Sequence_Begin("Seq_THChairReadyScene", mSequenceTHChairReadyScene);
			if (Sequence_DoStepAndWait(1.5))
			{
				// clean up
				Entity_SetActive("Trigger_ChairReadyScreen_*", false);
				Entity_SetActive("Trigger_ChairReadySpawn*", false);
				Entity_SetActive("Trigger_ChairReady_*", false);
				Map_RemoveTimer("Timer_CheckChairReadyLookAt");
				
				Agent_FaceEntity(msChairReadyEntity, "Player");
				
				// start dialogue state
				Voice_SetSource("Tin Hinan", msChairReadyEntity, 6, 25, true);
				Dialog_StartConversation("Tin Hinan", msChairReadyEntity, 1.f, cVector3f_Zero, true);
				
				Item_PutAway(eItemHandlerHand_Right);
				Item_PutAway(eItemHandlerHand_Left);
				
				Entity_PlayAnimation(msChairReadyEntity, "tinhinan_after_torture", 0.3);
				
				// th materializes
				YoungTinHinan_SetCustomCoverage(msChairReadyEntity, 0.8);
			}
			else if (Sequence_DoStepAndWait(7.0))
			{
				// start dialog
				Voice_StopAll();
				Dialog_Begin();
				Dialog_AddBranchAndSubject("Dialogue_ChairReady", "", "OnVoice_ResumeTHChairReadyScene");
				Dialog_End();
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				// stop dialogue state
				Dialog_StopConversation();
			}
			else if (Sequence_DoStepAndWait(0))
			{
				// th vanishes
				YoungTinHinan_Deactivate(msChairReadyEntity, 1, true);
			}	
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnVoice_ResumeTHChairReadyScene(const tString&in asSubject, bool abStartOfSubject)
		{
			if (abStartOfSubject) return;
			SequenceStates_Resume("Seq_THChairReadyScene");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTHChairReadySceneSmall;
		void Seq_THChairReadySceneSmall(const tString &in asTimer)
		{		
			Sequence_Begin("Seq_THChairReadySceneSmall", mSequenceTHChairReadySceneSmall);
			if (Sequence_DoStepAndWait(1))
			{
				Entity_SetActive("Trigger_ChairReady_" + mlChairReadyId, false);
				
				Voice_SetSource("Tin Hinan", msChairReadyEntity, 6, 25, true);
				Voice_Play("Dialogue_ChairReady", 1, "");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				YoungTinHinan_Deactivate(msChairReadyEntity, 1, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Tin Hinan appears in front of the chair*
		
		/////////////////////////////////////////
		// Event A *Sit in the vitae chair and heal the baby*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbChairHasVitae = false;
		bool mbChairInUse = false;
		bool mbChairReadyScenePlayed = false;
		
		float mfChair_LeftArm_Time = 0;
		float mfChair_LeftArm_AnimSpeed = 0;
		float mfChair_LeftArm_PrevAnimSpeed = 0;
		float mfChair_LeftArm_AnimSpeedTarget = 0;
		
		float mfChair_RightArm_Time = 0;
		float mfChair_RightArm_AnimSpeed = 0;
		float mfChair_RightArm_PrevAnimSpeed = 0;
		float mfChair_RightArm_AnimSpeedTarget = 0;
		int mlChair_RadialBlur = -1;
		
		tID m_idVitaeChair = tID_Invalid;
		tID m_idVitaeTubeLeft = tID_Invalid;
		tID m_idVitaeTubeRight = tID_Invalid;
		
		//-------------------------------------------------------
		
		void InitVitaeChair()
		{
			Lamp_SetLit("Lamp_VitaeChair_*", false, false);
			Lamp_SetLit("Lamp_VitaeChairEnv*", false, false);
			
			Entity_PlayAnimation("dwf_vitae_chair", "vitae_chair_folded", 0, true, false, "");

			m_idVitaeChair = Map_GetEntity("dwf_vitae_chair").GetID();
			
			iLuxEntity@ pChair = cLux_ID_Entity(m_idVitaeChair);
			
			cSubMeshEntity@ pTubeR2 = pChair.GetMeshEntity().GetSubMeshEntityName("m_tube_vitae_R2");
			m_idVitaeTubeRight = pTubeR2.GetID();
			pTubeR2.SetIlluminationColor(cColor_White * 0.7f);
			pTubeR2.GetMaterial().SetUvAnimationSpeed(0, 0);
			pTubeR2.GetMaterial().SetUvAnimationTime(0, 0);
			
			cSubMeshEntity@ pTubeL2 = pChair.GetMeshEntity().GetSubMeshEntityName("m_tube_vitae_L2");
			m_idVitaeTubeLeft = pTubeL2.GetID();
			pTubeL2.SetIlluminationColor(cColor_White * 0.7f);
			pTubeL2.GetMaterial().SetUvAnimationSpeed(0, 0);
			pTubeL2.GetMaterial().SetUvAnimationTime(0, 0);
			
			SetVitaeChairScannersActive(false);
			SetVitaeChairGeneralEffectsActive(false);
		}
		
		//-------------------------------------------------------
		
		void UpdateVitaeChair(float afTimeStep)
		{
			// left arm
			{
				if (mfChair_LeftArm_AnimSpeed != mfChair_LeftArm_AnimSpeedTarget)
				{
					mfChair_LeftArm_AnimSpeed = cMath_IncreaseTo(mfChair_LeftArm_AnimSpeed, afTimeStep * 2, mfChair_LeftArm_AnimSpeedTarget);
				}
				
				if ((mfChair_LeftArm_AnimSpeed == 0 && mfChair_LeftArm_PrevAnimSpeed != 0) || mfChair_LeftArm_AnimSpeed != 0)
				{
					mfChair_LeftArm_Time += afTimeStep * mfChair_LeftArm_AnimSpeed;
					cSubMeshEntity@ pTube = cLux_ID_SubMeshEntity(m_idVitaeTubeLeft);
					if (pTube !is null) pTube.GetMaterial().SetUvAnimationTime(0, mfChair_LeftArm_Time);
				}
				
				mfChair_LeftArm_PrevAnimSpeed = mfChair_LeftArm_AnimSpeed;
			}
			
			// right arm
			{
				if (mfChair_RightArm_AnimSpeed != mfChair_RightArm_AnimSpeedTarget)
				{
					mfChair_RightArm_AnimSpeed = cMath_IncreaseTo(mfChair_RightArm_AnimSpeed, afTimeStep * 2, mfChair_RightArm_AnimSpeedTarget);
				}
				
				if ((mfChair_RightArm_AnimSpeed == 0 && mfChair_RightArm_PrevAnimSpeed != 0) || mfChair_RightArm_AnimSpeed != 0)
				{
					mfChair_RightArm_Time += afTimeStep * mfChair_RightArm_AnimSpeed;
					cSubMeshEntity@ pTube = cLux_ID_SubMeshEntity(m_idVitaeTubeRight);
					if (pTube !is null) pTube.GetMaterial().SetUvAnimationTime(0, mfChair_RightArm_Time);
				}
				
				mfChair_RightArm_PrevAnimSpeed = mfChair_RightArm_AnimSpeed;
			}
		}
		
		//-------------------------------------------------------
		
		void SetVitaeChairLeftArmTubeSpeed(float afSpeed)
		{
			mfChair_LeftArm_AnimSpeedTarget = afSpeed;
		}
		
		//-------------------------------------------------------
		
		void SetVitaeChairRightArmTubeSpeed(float afSpeed)
		{
			mfChair_RightArm_AnimSpeedTarget = afSpeed;
		}
		
		//-------------------------------------------------------
		
		void SetVitaeChairScannersActive(bool abX)
		{
			cColor newColor = abX ? cColor(0,1.0, 0.7) * 2.0 : cColor(0);
			
			cMeshEntity@ pMesh = Map_GetEntity("dwf_vitae_chair").GetMeshEntity();
			pMesh.GetSubMeshEntityName("m_chair_light_R1").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_light_R2").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_light_R3").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_light_L1").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_light_L2").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_light_L3").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_light_M1").SetIlluminationColor(newColor);
		}
		
		//-------------------------------------------------------
		
		void SetVitaeChairGeneralEffectsActive(bool abX)
		{
			cColor newColor = abX ? cColor_White * 1.0 : cColor(0);
			
			cMeshEntity@ pMesh = Map_GetEntity("dwf_vitae_chair").GetMeshEntity();
			pMesh.GetSubMeshEntityName("m_chair_arm_R1").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_arm_R2").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_arm_R3").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_arm_L1").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_arm_L2").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_arm_L3").SetIlluminationColor(newColor);
			pMesh.GetSubMeshEntityName("m_chair_arm_M1").SetIlluminationColor(newColor);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_VitaeChair(const tString &in asEntity)
		{
			if (mbChairInUse) return;
			mbChairInUse = true;
			
			if (mbChairHasVitae) Seq_UseVitaeChair("");
			else Seq_UseVitaeChairFailure("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceUseVitaeChairFailure;	
		void Seq_UseVitaeChairFailure(const tString &in asTimer)
		{
			Sequence_Begin("Seq_UseVitaeChairFailure", mSequenceUseVitaeChairFailure);
			if (Sequence_DoStepAndPause(0))
			{
				ClearVitaeChair();
				PlayerBody_PlayCutsceneAtEntity("player_sit_down_non_powered_vitae_chair", "dwf_vitae_chair", false, 0.5, "OnAnimEnd_PlayVitaeChairIdle_1", 1, 0, 0, 180);
				Sound_CreateAtEntity("sound_sit", "03_07_dw_factory/injection_chair/animation/chair_sit", "player");
			}
			else if (Sequence_DoStepAndPause(0))
			{
//				PlayerBody_PlayCutsceneAtEntity("player_seated_idle_non_powered_vitae_chair", "dwf_vitae_chair", true, 0, "", 1, 0, 0, 180);
				if (mbVictimTortured == false) Voice_Play("Dialogue_ChairNoPower");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				mbChairInUse = false;
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_PlayVitaeChairIdle_1(const tString &in asAnimName)
		{
			PlayerBody_PlayCutsceneAtEntity("player_seated_idle_non_powered_vitae_chair", "dwf_vitae_chair", false, 0, "OnAnimEnd_PlayVitaeChairIdle_2", 1, 0, 0, 180);
			Sound_CreateAtEntity("sound_stand", "03_07_dw_factory/injection_chair/animation/chair_stand", "player");
			SequenceStates_Resume("Seq_UseVitaeChairFailure");
		}
		
		void OnAnimEnd_PlayVitaeChairIdle_2(const tString &in asAnimName)
		{
			PlayerBody_PlayCutsceneAtEntity("player_stand_up_from_non_powered_vitae_chair", "dwf_vitae_chair", false, 0, "", 1, 0, 0, 180);
			SequenceStates_Resume("Seq_UseVitaeChairFailure");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceUseVitaeChair;
		void Seq_UseVitaeChair(const tString &in asTimer)
		{
			Sequence_Begin("Seq_UseVitaeChair", mSequenceUseVitaeChair);
			if (Sequence_DoStepAndWait(1))
			{
				ClearVitaeChair();
				
				YoungTinHinan_Deactivate(msChairReadyEntity, 1, true);
				Entity_SetActive("Trigger_ChairReady_" + mlChairReadyId, false);
				Map_RemoveTimer("Timer_CheckChairReadyLookAt");
								
				// set after injection states
				cScript_SetGlobalVarBool("DWF_RnD_UsedVitaeChair", true);
				cScript_SetGlobalVarBool("DWF_TasiHasTortured", true);
				Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_AfterTortured");
				Sketchbook_CompleteIdea("use_chair");
				
				// player anim
				PlayerBody_SetCutsceneMaxPitch(12);
				PlayerBody_SetCutsceneMaxYaw(12);
				PlayerBody_PlayCutsceneAtEntity("player_use_vitae_chair", "dwf_vitae_chair", false, 0.5, "", 1, 0, 0, 180);
				Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimationMessage_ResumeUseVitaeChair", false);
				
				// setup chair
				StopBlinkButton("Lamp_VitaeChair_1");
				StopBlinkButton("Lamp_VitaeChair_2");
				StopBlinkButton("Lamp_VitaeChair_3");
				SetVitaeChairScannersActive(false);
				
				// chair anim
				Entity_PlayAnimation("dwf_vitae_chair", "vitae_chair_injecting_player", 1.0f, false, false);
				Entity_SetAnimationMessageEventCallback("dwf_vitae_chair", "OnAnimationMessage_ResumeUseVitaeChair", false);
				
				// injection sounds
				Sound_CreateAtEntity("Sound_InjectionRight", "03_07_dw_factory/injection_chair/injection_sequence_right", "Target_VitaeChariRightArmSounds", 0, true);
				Sound_CreateAtEntity("Sound_Injectionleft", "03_07_dw_factory/injection_chair/injection_sequence_left", "Target_VitaeChariLeftArmSounds", 0, true);
				Sound_Stop("Sound_InjectionChairIdle", 6.0f);
				Sound_Play("Sound_InjectionChairAggression", 5.0f);
				
				Music_Play("A2_3_7_Chair_Injection.ogg", 0.2f, false, eMusicPrio_MinorEvent);
				
				// play dialogue
				Voice_StopAll();				
				Voice_PlayDelayed("Dialogue_TasiUsesChair", 17.0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// activate injection lighting
				Light_FadeBrightnessTo("Light_VitaeInjection_*", 0.5f, 2);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// start scan
				SetVitaeChairScannersActive(true);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// stop scan
				SetVitaeChairScannersActive(false);
			}
			else if (Sequence_DoStepAndWait(4.3))
			{
				// fill left tube
				SetVitaeChairLeftArmTubeSpeed(0.08);
			}
			else if (Sequence_DoStepAndWait(1.4))
			{
				// stop
				SetVitaeChairLeftArmTubeSpeed(0);
			}
			else if (Sequence_DoStepAndWait(2.2))
			{
				// fill left canister
				SetVitaeChairLeftArmTubeSpeed(0.04);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// stop
				SetVitaeChairLeftArmTubeSpeed(0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// left needle stick
				mlChair_RadialBlur = Effect_RadialBlur_Start(0.4f, 1.f, 0.4f, 0.15f);
				Effect_Rumble_Start(1, 0.4);
				Map_AddTimer("Timer_StopInjectionRadialBlur", 0.4, "OnTimer_StopInjectionRadialBlur");
			}
			else if (Sequence_DoStepAndWait(2.9))
			{
				// inject vitae left
				SetVitaeChairLeftArmTubeSpeed(-0.03);
			}
			else if (Sequence_DoStepAndPause(0.0))
			{
				// stop
				SetVitaeChairLeftArmTubeSpeed(0.0f);
			}
			else if (Sequence_DoStepAndWait(4.3))
			{
				// fill right tube
				SetVitaeChairRightArmTubeSpeed(0.08);
			}
			else if (Sequence_DoStepAndWait(0.75))
			{
				// stop
				SetVitaeChairRightArmTubeSpeed(0);
			}
			else if (Sequence_DoStepAndWait(2.2))
			{
				// fill right canister
				SetVitaeChairRightArmTubeSpeed(0.04);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// stop
				SetVitaeChairRightArmTubeSpeed(0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// right needle stick
				mlChair_RadialBlur = Effect_RadialBlur_Start(0.4f, 1.f, 0.4f, 0.15f);
				Effect_Rumble_Start(1, 0.4);
				Map_AddTimer("Timer_StopInjectionRadialBlur", 0.4, "OnTimer_StopInjectionRadialBlur");
			}
			else if (Sequence_DoStepAndWait(2.9))
			{
				// inject vitae right
				SetVitaeChairRightArmTubeSpeed(-0.03);
			}
			else if (Sequence_DoStepAndWait(0.3))
			{
				// stop
				SetVitaeChairRightArmTubeSpeed(0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// ghost appears
				YoungTinHinan_SetCustomCoverage("THGhost_UseChair", 0.f);
				YoungTinHinan_Activate("THGhost_UseChair", 1.0f);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				// drain vitae
				SetVitaeChairRightArmTubeSpeed(-0.1);
				SetVitaeChairLeftArmTubeSpeed(-0.1);
			}
			else if (Sequence_DoStepAndWait(1.9))
			{
				// fade out vitae pipe
				SetVitaePipeCoverageTarget(0);
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				// stop
				SetVitaeChairRightArmTubeSpeed(0);
				SetVitaeChairLeftArmTubeSpeed(0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// deactivate chair
				Entity_SetEffectsActive("dwf_vitae_chair", false, true);
				Lamp_SetLit("Lamp_VitaeChairEnv", false, true);
				Lamp_SetLit("Lamp_VitaeChair_*", false, true);
				Sound_Stop("Sound_InjectionChairAggression", 6.0f);
				Sound_CreateAtEntity("Sound_ActivateEnergy", "03_07_dw_factory/injection_chair/activatte_energy_on", "dwf_vitae_chair", 0, true);
				Light_FadeBrightnessTo("Light_VitaeInjection_*", 0, 0.5);
				
				mbChairHasVitae = false;
				mbChairInUse = false;
			}
			else if (Sequence_DoStepAndWait(5.0))
			{
				// ghost flies away
				YoungTinHinan_MoveTo("THGhost_UseChair", "Target_THGhost_UseChair_MoveTo_1", "");
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				// ghost disappears
				YoungTinHinan_Deactivate("THGhost_UseChair", 0.5, true);
				Music_Play("A2_3_7_VictimReveal.ogg", 0.3f, false, eMusicPrio_MinorEvent);
			}
			else if (Sequence_DoStepAndWait(4.5))
			{
				// unlock doors
				mbTortureChamberDoorsLocked = false;
				SetRnDDoorState("Door_TortureMiddle", false, true, false);
				SetRnDDoorState("Door_TortureChamber", false, true, false);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Voice_Play("Dialogue_TasiOutOfChair");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopInjectionRadialBlur(const tString &in asTimer)
		{
			Effect_RadialBlur_FadeOut(mlChair_RadialBlur, 0.6);
		}
		
		//-------------------------------------------------------
		
		void OnAnimationMessage_ResumeUseVitaeChair(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			SequenceStates_Resume("Seq_UseVitaeChair");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_VitaeChairScreenPulse(const tString &in asTimer)
		{
			float fAspect = cLux_GetPlayer().GetCamera().GetAspect();
			float fBaseSize = 0.945f - (0.383f * (fAspect - 1.333f));
			cVector2f vSize = cVector2f(fBaseSize * fAspect, fBaseSize * 1.2f);
			Effect_Screen_Start("player_progress_screen.mat" , cVector2f(0.5f, 0.5f), vSize * 1.2f, 1.0f, 0.5f, 0.2f, 0.5f, 0);
			Map_RestartCurrentTimer(1.3f);
		}
		
		//-------------------------------------------------------
		
		void ClearVitaeChair()
		{
			cLuxArea@ pArea = cLux_ToArea(Map_GetEntity("Trigger_ChairAABB"));
			cBoundingVolume@ pVolume = pArea.GetMainBody().GetBoundingVolume();
			array<iPhysicsBody@> vBodies;
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(pVolume.GetMin(), pVolume.GetMax(), vBodies);
			for (int i = 0; i < vBodies.size(); ++i)
			{
				iPhysicsBody@ pBody = vBodies[i];
				if (pBody is null) continue;
				iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
				if (pEnt is null) continue;
				if (pBody.GetMass() == 0) continue;
				
				cVector3f vDir = pArea.GetMainBody().GetWorldMatrix().GetTranspose().GetForward();
				pBody.AddImpulse(vDir * 5);
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Sit in the vitae chair and heal the baby*
		
		/////////////////////////////////////////
		// Event A *See a glimpse of the R&D WRAITH*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbAmuletPingedTutorial = false;
		
		//-------------------------------------------------------
		
		void SetupHappyRoomWraithIntro1()
		{
			Entity_SetActive("Wraith_StorageRoom", false);
			SlideDoor_SetOpenAmount("Door_StorageRoom", 1, true);
			
			Entity_SetActive("Trigger_PrepareHappyRoomEncounter", true);
			Entity_SetActive("Trigger_StartHappyEncounter", true);
			Entity_SetActive("Trigger_HappyRoomWraithIntro2_*", true);
			
			Entity_SetActive("WraithHappy_Intro_1", true);
			Wraith_SetSpotlightSoundVolumeMul("WraithHappy_Intro_1", 0.05f);

			Entity_SetActive("Trigger_HappyRoomWraithIntro1_LookAt_*", true);
			Entity_SetActive("Trigger_HappyRoomWraithIntro1_Cancel_*", true);
			Map_AddTimer("Timer_HappyRoomWraithIntro1_LookAt", 0.2f, "OnTimer_HappyRoomWraithIntro1_LookAt");
			
			FearHandler_SetPermaFailRespawnArea("PermaFail_HappyRoomWraithIntro");
		}
		
		//-------------------------------------------------------
		
		void OnWraithPulse_PullUpAmulet(const tString &in asEntityName)
		{
			if (mbAmuletPingedTutorial) return;
			mbAmuletPingedTutorial = true;
			Map_AddTimer("Timer_PullUpAmulet", 0.0, "OnTimer_PullUpAmulet");
		}
		
		void OnTimer_PullUpAmulet(const tString &in asTimer)
		{
			Item_Equip(ItemType_GetFirstInInventory("CurseMedallion"));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_HappyRoomWraithIntro1_LookAt(const tString &in asTimer)
		{
			Wraith_TurnSpotlightToPos("WraithHappy_Intro_1", Map_GetEntity("Target_HappyRoomWraith_LookAt_1").GetPosition(), true, false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_HappyRoomWraithIntro1_Cancel(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_HappyRoomWraithIntro1_LookAt_*", false);
			Map_AddTimer("Timer_HappyRoomWraithIntro1_Hide", 0.0f, "OnTimer_HappyRoomWraithIntro1_Hide");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_HappyRoomWraithIntro1_LookAway(const tString &in asEntity, int alState)
		{
			Entity_SetActive("Trigger_HappyRoomWraithIntro1_LookAt_*", false);
			Map_AddTimer("Timer_HappyRoomWraithIntro1_LookAway", 0.0f, "OnTimer_HappyRoomWraithIntro1_LookAway");
			Map_AddTimer("Timer_HappyRoomWraithIntro1_Hide", 2.0f, "OnTimer_HappyRoomWraithIntro1_Hide");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_HappyRoomWraithIntro1_LookAway(const tString &in asTimer)
		{
			Wraith_TurnSpotlightToPos("WraithHappy_Intro_1", Map_GetEntity("Target_HappyRoomWraith_LookAt_2").GetPosition(), true, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_HappyRoomWraithIntro1_Hide(const tString &in asTimer)
		{
			Wraith_SetStealth("WraithHappy_Intro_1", true, true, "OnStealth_HappyRoomWraithIntro1_Deactivate");
		}
		
		//-------------------------------------------------------
		
		void OnStealth_HappyRoomWraithIntro1_Deactivate(const tString &in asEntity, bool abStealthActive)
		{
			Entity_SetActive("Trigger_HappyRoomWraithIntro1_LookAt_*", false);
			Entity_SetActive("Trigger_HappyRoomWraithIntro1_Cancel_*", false);
			Entity_SetActive("WraithHappy_Intro_1", false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_HappyRoomWraithIntro2(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_HappyRoomWraithIntro2_*", false);
			Seq_HappyRoomWraithIntro2("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceHappyRoomWraithIntro2;
		void Seq_HappyRoomWraithIntro2(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HappyRoomWraithIntro2", mSequenceHappyRoomWraithIntro2);
			if (Sequence_DoStepAndWait(0.5))
			{
				Entity_SetActive("WraithHappy_Intro_2", true);
				Agent_SetSensesActive("WraithHappy_Intro_2", false);
				Wraith_SetSpotlightSoundVolumeMul("WraithHappy_Intro_2", 0.05);
			}
			else if (Sequence_DoStepAndWait(4.0f))
			{
				Wraith_TurnSpotlightToPos("WraithHappy_Intro_2", Map_GetEntity("Target_HappyRoomWraith_LookAt_3").GetPosition(), true, true, 1.5);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				Wraith_TurnSpotlightToPos("WraithHappy_Intro_2", Map_GetEntity("Target_HappyRoomWraith_LookAt_4").GetPosition(), true, true, 1.5);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				Entity_SetActive("WraithHappy_Intro_2", false);
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event A *See a glimpse of the R&D WRAITH*
		
		/////////////////////////////////////////
		// Event B *See the R&D WRAITH appearing in front of the Happy Room and sneak past it*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		bool OnCollide_Player_PrepareHappyRoomEncounter(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Wraith_HappyRoomEncounter", true);
			Wraith_SetCallback_Pulse("Wraith_HappyRoomEncounter", "OnWraithPulse_PullUpAmulet", true);
			Wraith_SetSpotlightSoundVolumeMul("Wraith_HappyRoomEncounter", 0.0f);
			Wraith_SetHearing("Wraith_HappyRoomEncounter", false);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_StartHappyEncounter(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_HappyRoomEncounter("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceHappyRoomEncounter;
		void Seq_HappyRoomEncounter(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HappyRoomEncounter", mSequenceHappyRoomEncounter);
			if (Sequence_DoStepAndWait(0.5))
			{
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Wraith_CommandPatrol_ClearNodes("Wraith_HappyRoomEncounter");
				Wraith_CommandPatrol_AddNode("Wraith_HappyRoomEncounter", "PathNode_HappyEncounter_1");
				Wraith_CommandPatrol_Execute("Wraith_HappyRoomEncounter", true, 1, false, true, eWraithSpeed_Walk, "OnCommandComplete_ResumeHappyRoomEncounter");
				Wraith_SetSpotlightSoundVolumeMul("Wraith_HappyRoomEncounter", 0.25f);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Wraith_SetCallback_Alerted("Wraith_HappyRoomEncounter", "OnAlerted_CancelHappyRoomEncounter");
				Wraith_SetHearing("Wraith_HappyRoomEncounter", true);	
			}
			else if (Sequence_DoStepAndPause(0.5))
			{
				Sound_CreateAtEntity("WraithAnnounce", "creatures/vocalisations/creature/wraith/wraith_idle", "Wraith_HappyRoomEncounter");
				cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("WraithAnnounce");
				pSound.SetCustomMaxDistance(50);
				pSound.SetCustomMinDistance(20);
				pSound.SetUseCustomProperties(true);
			}
			else if (Sequence_DoStepAndWait(3.5))
			{
				Wraith_TurnSpotlightToPos("Wraith_HappyRoomEncounter", Map_GetEntity("Target_HappyRoomEncounter_LookAt_1").GetPosition(), true, true, 1.5f);
			}
			else if (Sequence_DoStepAndPause(0.1))
			{
				Wraith_CommandPatrol_ClearNodes("Wraith_HappyRoomEncounter");
				Wraith_CommandPatrol_AddNode("Wraith_HappyRoomEncounter", "PathNode_HappyEncounter_2");
				Wraith_CommandPatrol_Execute("Wraith_HappyRoomEncounter", true, 1, false, true, eWraithSpeed_Walk, "OnCommandComplete_ResumeHappyRoomEncounter");
			}
			else if (Sequence_DoStepAndWait(4.0))
			{
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_HappyRoomEncounter", 0.8, 0.45, 0.1, "Target_HappyRoomEncounter_LookAt_2", true, true);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Wraith_SetSpotlightMovement_FollowEntity("Wraith_HappyRoomEncounter", "Target_HappyRoomEncounter_LookAt_2", true);
			}
			else if (Sequence_DoStepAndPause(0.0))
			{
				Wraith_SetStealth("Wraith_HappyRoomEncounter", true, true, "OnStealth_ResumeHappyRoomEncounter");
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Entity_SetActive("Wraith_HappyRoomEncounter", false);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAlerted_CancelHappyRoomEncounter(const tString &in asEntityName)
		{
			SequenceStates_Stop("Seq_HappyRoomEncounter");
			Wraith_CommandDisappear_Execute("Wraith_HappyRoomEncounter", false);
		}
		
		//-------------------------------------------------------
		
		void OnCommandComplete_ResumeHappyRoomEncounter(const tString &in asEntity)
		{
			SequenceStates_Resume("Seq_HappyRoomEncounter");
		}

		//-------------------------------------------------------
		
		void OnStealth_ResumeHappyRoomEncounter(const tString &in asEntity, bool abStealthActive)
		{
			SequenceStates_Resume("Seq_HappyRoomEncounter");
		}
		
		//-------------------------------------------------------
		
		//} END Event B *See the R&D WRAITH appearing in front of the Happy Room and sneak past it*
		
	//} END SCENE 6
	
