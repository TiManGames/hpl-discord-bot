		//-------------------------------------------------------
		
		bool OnCollide_Player_ShuttleStationAgainDialogueArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlDialogue_ShuttleStationAgainAreas += alState;
			Entity_SetActive("Trigger_SeeShuttleStationAgainDialogue_*", mlDialogue_ShuttleStationAgainAreas > 0);
			if (mlDialogue_ShuttleStationAgainAreas == 0) Voice_StopCheckTimer("Dialogue_SeeShuttleStationAgain");
			return true;
		}
		
