		//} END Event A *Power up the torture chamber*
		
		/////////////////////////////////////////
		// Event A *Set up the torture machine*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		array<tID> mvRobotArms;
		tString msTortureSource = "";
		tString msTortureSourceEntity = "";
		array<tString> mvRobotArmAttach = { "", "", "", "", "" };
		array<tString> mvRobotArmAttachType = { "", "", "", "", "" };
		array<int> mvRobotArmState = { 0, 0, 0, 0, 0 };
		bool mbTortureMachineComplete = false;
		bool mbRobotArmTest_Active = false;
		bool mbPlayerInsideTortureBooth = false;
		bool mbVictimForward = false;
		tString msTortureType = ""; // drilling, burning, drowning
		eTortureType mSelectedTorture = eTortureType_None;
		bool mbTortureCanister_Locked = true;
		int mlTortureCanister_IndicatorState = 0;
		cColor mTortureTubesTopColor = cColor(0.1,0.6,1) * 1;
		cColor mTortureTubesBottomColor = cColor(1,0.8,0.2) * 1;
		
		//-------------------------------------------------------
		
		void SetCanisterSocketLocked(bool abX, bool abSaveState = true)
		{
			if (abSaveState) mbTortureCanister_Locked = abX;
			
			if (mbTortureRoomOn || abSaveState == false)
			{
				if (msTortureSource == "") Entity_SetActive("Sticky_TortureSource", !abX);
				else Entity_SetInteractionDisabled(msTortureSourceEntity, abX);
				
				if (abX)
				{
					Entity_PlayProcAnimation("CanisterSlot", "CloseRight", 0.4);
					Entity_PlayProcAnimation("CanisterSlot", "CloseLeft", 0.4);
				}
				else
				{
					Entity_StopProcAnimation("CanisterSlot", "CloseRight", 0.4);
					Entity_StopProcAnimation("CanisterSlot", "CloseLeft", 0.4);
				}
			}
		}
		
		//-------------------------------------------------------
		
		void SetCanisterIndicatorState(int alState, bool abSaveState = true)
		{
			if (abSaveState) mlTortureCanister_IndicatorState = alState;
			
			if (mbTortureRoomOn || abSaveState == false)
			{
				bool bLightOn = alState > 0;
				Entity_SetEffectsActive("Indicator_TortureSource", bLightOn, true);
				Entity_SetEffectsActive("CanisterSlot", bLightOn, true);
				
				cColor mColor = mButtonColor_White;
				if (alState == 1)
				{
					StopBlinkButton("Indicator_TortureSource", false);
					SetButtonColor("Indicator_TortureSource", mButtonColor_White, true);
					
					StopBlinkButton("CanisterSlot", false);
					SetButtonColor("CanisterSlot", mButtonColor_White, true);
				}
				else if (alState == 2)
				{
					SetButtonColor("Indicator_TortureSource", mButtonColor_Red, false);
					FlashButton("Indicator_TortureSource", mButtonColor_Red, 2.5, 0.5, true);
					
					SetButtonColor("CanisterSlot", mButtonColor_Red, false);
					FlashButton("CanisterSlot", mButtonColor_Red, 2.5, 0.5, true);
				}
				else if (alState == 3)
				{
					StopBlinkButton("Indicator_TortureSource", false);
					SetButtonColor("Indicator_TortureSource", mButtonColor_Green, true);
					
					StopBlinkButton("CanisterSlot", false);
					SetButtonColor("CanisterSlot", mButtonColor_Green, true);
				}
				else if (alState == 4)
				{
					StopBlinkButton("Indicator_TortureSource", false);
					SetButtonColor("Indicator_TortureSource", mButtonColor_Red, false);
					
					StopBlinkButton("CanisterSlot", false);
					SetButtonColor("CanisterSlot", mButtonColor_Red, false);
				}
			}
		}
		
		//-------------------------------------------------------
		
		void SetFrontTortureWindowOpen(bool abOpen)
		{
			if (abOpen)
			{
				Entity_PlayAnimation("TortureWindow_Outer", "rnd_torture_outer_window_brought_up", 0);
				Map_AddTimer("Blocker_OuterTortureBooth", 0.5, "OnTimer_SetTortureWindowBlockerInactive");
			}
			else
			{
				Entity_PlayAnimation("TortureWindow_Outer", "rnd_torture_outer_window_brought_down", 0);
				Entity_SetActive("Blocker_OuterTortureBooth", true);
			}
		}
		
		void SetBackTortureWindowOpen(bool abOpen)
		{
			if (abOpen)
			{
				Entity_PlayAnimation("TortureWindow_Inner", "rnd_torture_inner_window_brought_down", 0);
				Map_AddTimer("Blocker_InnerTortureBooth", 0.5, "OnTimer_SetTortureWindowBlockerInactive");
			}
			else
			{
				Entity_PlayAnimation("TortureWindow_Inner", "rnd_torture_inner_window_brought_up", 0);
