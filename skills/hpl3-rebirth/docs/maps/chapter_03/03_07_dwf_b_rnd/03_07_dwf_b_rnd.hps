		{
			EmptyRobotArmPipe(5, eTorturePipe_Arm5);
		}
		
		//-------------------------------------------------------
		
		void CheckRobotArm(int alArmIndex, bool abOnArmAttach = false)
		{
			int lState = 0; // -1 wrong, 0 inactive, 1 can use, 2 good
			
			// figure out tool type
			tString sArmState = mvRobotArmAttach[alArmIndex - 1];
			tString sType = mvRobotArmAttachType[alArmIndex - 1];
			
			// figure out what kind of arm it is
			bool bBottomArm = alArmIndex == 1 || alArmIndex == 2;
			bool bMaskArm = alArmIndex == 5;
			
			if (msTortureSource == "")
			{
				if (bMaskArm == false && cString_GetFirstStringPos(sArmState, "Drill") >= 0) lState = 2;
				else if (bMaskArm && sArmState == "") lState = 0;
				else if (sArmState != "") lState = -1;
			}
			else if (msTortureSource == "Gas")
			{
				if (bMaskArm == false && bBottomArm && cString_GetFirstStringPos(sArmState, "Burner") >= 0) lState = 2;
				else if (bBottomArm == false && sArmState == "") lState = 0;
				else if (sArmState != "") lState = -1;
			}
			else if (msTortureSource == "Water")
			{
				if (bMaskArm && cString_GetFirstStringPos(sArmState, "Drowner") >= 0) lState = 2;
				else if (bMaskArm == false && sArmState == "") lState = 0;
				else if (sArmState != "") lState = -1;
			}
			
			///////////////////////
			// Effects depending on state
			if (lState == 2)
			{
			}
			else
			{
			}
			
//			if (lState == 1) FadeRobotArmRingColor(alArmIndex, mRobotArmRingColor_Default);
//			else FadeRobotArmRingColor(alArmIndex, mRobotArmRingColor_Off);
			
			// save state
			mvRobotArmState[alArmIndex - 1] = lState;
			
			cLux_AddDebugMessage("[Map] Check Arm " + alArmIndex + " - State: " + lState);
		}
		
		//-------------------------------------------------------
		
		void DoActiveRobotArmTestRun()
		{
			array<bool> vActiveArms;
			int lCorrectArms = 0;
			for (int i = 1; i <= 5; ++i)
			{
				bool bCorrect = mvRobotArmState[i - 1] == 2;
				if (bCorrect) ++lCorrectArms;
				vActiveArms.push_back(bCorrect);
			}
			
			if (lCorrectArms > 0)
			{
				DoRobotArmTestRun(vActiveArms);
			}
			else
			{
				SetCanisterSocketLocked(true);
				Map_AddTimer("Timer_UnlockCanisterSocket", 2.0, "OnTimer_UnlockCanisterSocket");
			}
		}
		
		//-------------------------------------------------------
		
		void TurnOffActiveRobotArmTestIdle()
		{
			array<bool> vActiveArms;
			int lCorrectArms = 0;
			for (int i = 1; i <= 5; ++i)
			{
				if (mvRobotArmState[i - 1] == 2)
				{
					tString sTool = mvRobotArmAttach[i - 1];
					if (cString_GetFirstStringPos(sTool, "Burner") >= 0) SetBurnerState(sTool, 0, 0.5);
					else if (cString_GetFirstStringPos(sTool, "Drowner") >= 0) SetDrownerState(sTool, 0, 0.5);
				}
			}
		}
		
		//-------------------------------------------------------
		
		array<bool> mvRobotArmTest_ActiveArms;
		void DoRobotArmTestRun(array<bool> avActiveArms)
		{
			if (mbRobotArmTest_Active) return;
			mvRobotArmTest_ActiveArms = avActiveArms;
			mbRobotArmTest_Active = true;
			Seq_RobotArmTest("");
		}
		
		//-------------------------------------------------------
		
		void DoRobotArmTestRun(int alArmIndex)
		{
			array<bool> vActiveArms;
			for (int i = 1; i <= 5; ++i)
			{
				vActiveArms.push_back(i == alArmIndex);
			}
			DoRobotArmTestRun(vActiveArms);
		}
		
		//-------------------------------------------------------

		cSequenceStatesData mSequenceRobotArmTest;
		void Seq_RobotArmTest(const tString &in asTimer)
		{
			Sequence_Begin("Seq_RobotArmTest", mSequenceRobotArmTest);
			if (Sequence_DoStepAndWait(0.5))
			{
				SetTortureSocketsInteraction(false);
				SetCanisterSocketLocked(true);
				
				Voice_StopPeriodic(true);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// move arm
				for (int i = 1; i <= 5; ++i)
				{
					if (mvRobotArmTest_ActiveArms[i - 1] == false) continue;
					Entity_PlayAnimation("TortureArm_" + i, "rnd_arm_" + i + "_test_run", 0, false, false, "");
					
					tString sTool = mvRobotArmAttach[i - 1];
					if (cString_GetFirstStringPos(sTool, "Drill") >= 0) DoDrillEffects(i);
					else if (cString_GetFirstStringPos(sTool, "Burner") >= 0) DoBurnerEffects(i);
					else if (cString_GetFirstStringPos(sTool, "Drowner") >= 0) DoDrownerEffects(i);
				}
			}
			else if (Sequence_DoStepAndWait(0))
			{
				SetTortureSocketsInteraction(true);
				SetCanisterSocketLocked(false);
				
				mbRobotArmTest_Active = false;
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ResumeRobotArmTest(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("Seq_RobotArmTest");
		}
		
