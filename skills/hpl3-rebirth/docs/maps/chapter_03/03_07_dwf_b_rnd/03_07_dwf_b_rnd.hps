			Player_Teleport("Start_TorturePanel", true);
			Seq_ActivateTortureChamber("");
			return;
			Player_Teleport("Start_PodRoom");
		}
		
		if(alAction == eAction_Test7)
		{
//			OnAttach_RobotArm("Sticky_RobotArm_5", Map_GetEntity("TortureTool_Drowner").GetMainBody().GetName());
//			OnAttach_TortureSource("Sticky_TortureSource", Map_GetEntity("TortureCanister_Water").GetMainBody().GetName());

			Entity_SetActive("Sticky_TortureSource", true);
			for (int i = 1; i <= 5; ++i) Entity_SetActive("Sticky_RobotArm_" + i, true);

