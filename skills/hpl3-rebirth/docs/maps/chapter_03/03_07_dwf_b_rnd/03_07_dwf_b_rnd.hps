	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		//sky rotation
		cVector3f vRot = cVector3f(0, cMath_ToRad(143), 0);
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);		
	
		Achievement_Unlock(eAchievement_Diagnostician);
		
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		//PlayerBody_SetModel("player.ent");
		PlayerBody_SetActive(true);
		FearHandler_SetPermaFailEnabled(false);
        Heat_SetActive(false);
		Player_SetAutoTeleportWhenBelowAltitude(7);
//		Map_Preload("03_07_dwf_c_factory.hpm");

		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(15);
		
		/////////////////////////
		// Inventory
		if (cLux_ScriptDebugOn())
		{
			Amulet_StartTracking(true, "RiftClose");
		}
		else
		{
			Effect_Fade_Out(0);
			Map_AddTimer("Timer_LevelFadeIn", 1.5, "OnTimer_LevelFadeIn");
		}
		
		if (ItemType_IsInInventory("Lantern") == false)
		{
			Item_AddToInventory("Lantern");
			Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
			Item_AddToInventory("HerbertOil");
			Item_SetContent(ItemType_GetFirstInInventory("HerbertOil"), "Oil", 10);
			Item_AddToInventory("Matchbook");
			Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
		}
		
		/////////////////////////
		// System setup
		Player_SetMapDeepShadow(0.3f);
		cLux_GetCurrentMap().SetMaxInteractDistance(20.0f);
		Blackboard_AddWraithBillboards("WraithBillboard");
		FearHandler_SetDifficultyMul(0.6f);
		FearHandler_SetPermaFailRespawnArea("PermaFail_Default");
		RiftHandler_SetAllowHint(false);
		
		Player_SetNightVisionBrightness(2);
		
		/////////////////////////
		// Init scenes
		InitShuttleStation();
		InitWorkingPod();
		InitTortureChamber();
		InitRnD();
		InitDarkWorldLightning();
		InitVitaeChair();
		InitVitaePipe();
		InitTorturePipes();
	}

	//-------------------------------------------------------
	
	[nosave] bool mbLoaded = false;
	void OnLoad()
	{
		mbLoaded = true;
		
		cSubMeshEntity@ pPipeVitae = cLux_ID_SubMeshEntity(m_idVitaePipe_Vitae);
		if (pPipeVitae !is null)
		{
			pPipeVitae.GetMaterial().SetUvAnimationSpeed(0, 0);
			pPipeVitae.GetMaterial().SetUvAnimationTime(0, mfVitaePipe_UvTime);
		}
		
		cSubMeshEntity@ pChairRight = cLux_ID_SubMeshEntity(m_idVitaeTubeRight);
		if (pChairRight !is null)
		{
			pChairRight.GetMaterial().SetUvAnimationSpeed(0, 0);
			pChairRight.GetMaterial().SetUvAnimationTime(0, mfChair_RightArm_Time);
		}
		
		cSubMeshEntity@ pChairLeft = cLux_ID_SubMeshEntity(m_idVitaeTubeLeft);
		if (pChairLeft !is null)
		{
			pChairLeft.GetMaterial().SetUvAnimationSpeed(0, 0);
			pChairLeft.GetMaterial().SetUvAnimationTime(0, mfChair_LeftArm_Time);
		}
		
		for (int i = 0; i < mvTorturePipes.size(); ++i)
		{
			cSubMeshEntity@ pPipe = cLux_ID_SubMeshEntity(mvTorturePipes[i]);
			if (pPipe !is null)
			{
				pPipe.GetMaterial().SetUvAnimationSpeed(0, 0);
				pPipe.GetMaterial().SetUvAnimationTime(0, mvTorturePipes_Times[i]);
				
			}
		}
		
		cSubMeshEntity@ pTortureMeter = cLux_ID_SubMeshEntity(m_idTortureMeter);
		if (pTortureMeter !is null)
		{
			pTortureMeter.GetMaterial().SetUvAnimationSpeed(0, 0);
			pTortureMeter.GetMaterial().SetUvAnimationTime(0, mfTortureMeterAmount);
		}
		
		cSubMeshEntity@ pShuttleControlLights = cLux_ID_SubMeshEntity(m_idShuttleControlLights);
		if (pShuttleControlLights !is null)
		{
			pShuttleControlLights.GetMaterial().SetUvAnimationSpeed(0, 0);
			pShuttleControlLights.GetMaterial().SetUvAnimationTime(0, mfShuttleControlLightTime);
		}
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Player_RestoreClipPlane();
		Effect_Fade_In(0);
	}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("DEAD : SOURCE = " + asSource);
		
		if (asSource == "SomeReason")
		{
			Effect_Fade_Out(1.0f);
			return true; // return true to completely override base behaviour
		}
		
		// return false for default behaviour
		return false;
	}
	
	//-------------------------------------------------------
	
	int mlWraithPermafailCount_ExtenderEncounter = 0;
	tString msPermafailSource = "";
	
	bool OnPermaFail(const tString &in asSource)
	{
		msPermafailSource = asSource;
		if (asSource == "Wraith_ExtenderEncounter")
		{
			++mlWraithPermafailCount_ExtenderEncounter;
		}
		
		FearHandler_ClearPermaFailScenes();
		SetupGenericPermaFail();
		
		return true;
	}
	
	//-------------------------------------------------------
	
	array<int> mvUnplayedGenericPermaFails = { 1, 2, 3 };
	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 3; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);
			
		tString sAreaBase = "Area_PermaFail_Generic";		
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_1", sAreaBase + "_1_End_1", 4.f, 3.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_2", sAreaBase + "_1_End_2", 5.f, 1.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_3", sAreaBase + "_1_End_3", 3.f, 2.0f, true, true);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 5.f, 2.5f);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_2", sAreaBase + "_2_End_2", 4, 2.5);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_3", sAreaBase + "_2_End_3", 4, 2.5f);
				break;
			case 3:
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_1", sAreaBase + "_3_End_1", 3.5f, 3.0f, true, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_2", sAreaBase + "_3_End_2", 5.f, 2.5f);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_3", sAreaBase + "_3_End_3", 5.f, 2.5f);
				break;
		}
	}
	
	//-------------------------------------------------------
	
	int mlWraithAttackCount_ExtenderEncounter = 0;
	void OnDamageTaken(const tString&in asSource, int alType)
	{
		if (alType == eDamageType_Silent)
		{
			if (asSource == "Wraith_ExtenderEncounter")
			{
				++mlWraithAttackCount_ExtenderEncounter;
			}
		}	
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnPermaFailRespawn()
	{		
		// return false for default behaviour (fadeout and death area)
		if ((mlWraithPermafailCount_ExtenderEncounter <= 1 && mlWraithAttackCount_ExtenderEncounter >= 3) || mlWraithPermafailCount_ExtenderEncounter >= 2)
		{
			cLux_AddDebugMessage("[Map] " + msPermafailSource + " disappeard, permafail: " + mlWraithPermafailCount_ExtenderEncounter + " attack: " + mlWraithAttackCount_ExtenderEncounter);
			Wraith_CommandDash_Execute("Wraith_ExtenderEncounter", Map_GetEntity("Target_ExtenderEncounter_Disappear_1").GetPosition(), true, true, true);
		}
		
		return true;
	}

	//-------------------------------------------------------

	bool bTest = false;
	int lTest = 0;
	float fTest = 0;
	tID m_idTest1;
	int aasdf = 0;
	
	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_TestPlus)
		{
			Entity_PlayAnimation("TortureVictim", "rnd_torture_victim_defrost_idle", 0, true);
			return;
//			FillUpRobotArmPipe(5);
			
			return;
			Entity_SetActive("TortureWindow_Outer", false);
			Entity_SetActive("TortureWindow_Inner", false);
			
			Entity_SetActive("Blocker_InnerTortureBooth", false);
			Entity_SetActive("Blocker_OuterTortureBooth", false);
			
			Lamp_SetLit("Lamp_TorturePanel_*", true, true);
			Lamp_SetLit("Lamp_TortureBooth_*", true, true);
			
			for (int i = 1; i <= 5; ++i) FadeRobotArmRingColor(i, mRobotArmRingColor_Default, 0.5);
			for (int i = 1; i <= 5; ++i) Entity_SetActive("Sticky_RobotArm_" + i, true);
			
			PlayRobotArmAnimation("open_up_readying_for_tool_insertion", 0, false, "OnAnimEnd_ResumeActivateTortureChamber");
			
			SetCanisterSocketLocked(false);
			
			SetButtonActive("Button_CompleteTortureSetup_1", true);
			
			return;
			Entity_PlayAnimation("TestDrill", "rnd_drill_1_move_into_position", 0, false, false);
//			Entity_PlayAnimation("TestDrowner", "rnd_drowner_torture_idle", 0, false, false);
			return;
			Seq_ActivateShuttleStation("");
			return;
			Map_GetEntity("WorkingShuttle").GetMeshEntity().GetAnimationStateFromName("dwf_back_door_open").SetPaused(false);
			return;
			++lTest;
			SetDrownerState("TortureTool_Drowner", lTest, 0.5);
			lTest %= 2;
		}
		
		if(alAction == eAction_TestMinus)
		{
//			EmptyRobotArmPipe(1);
			return;
			Entity_PlayAnimation("TortureArm_1", "rnd_arm_1_test_run", 0.5, false, false, "");
			return;
			Dialog_StartConversation("Tin Hinan", "THGhost_ChairReady", 1.f, cVector3f_Zero, true);
			return;
			bTest = !bTest;
			SetVitaeChairScannersActive(bTest);
			return;
			iLuxEntity@ pEnt = Map_GetEntity("dwf_vitae_chair");
			pEnt.GetMeshEntity().GetSubMeshEntityName("m_tube_vitae_R2").SetIlluminationColor(cColor(0));
			
			return;
			
			return;
			SetRnDDoorState("Door_ShuttleStation", false, false, false);
			return;
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_ShuttleDoorEncounter");
			Wraith_ModeWraithPatrol_AddNode("Wraith_ShuttleDoorEncounter", "PathNode_5");
			Wraith_ModeWraithPatrol_Setup("Wraith_ShuttleDoorEncounter", false, false);
			Wraith_Mode_Set("Wraith_ShuttleDoorEncounter", eWraithMode_WraithPatrol, true);
			return;
			CameraAnimationNode_SetAutoMove("CameraAnimation_VitaeSeat_2", 1.0f);
			return;
			Voice_Play("Dialogue_TheView", -1, "", 10);
		}
		
		if(alAction == eAction_Test1)
		{
//			Seq_ActivateShuttleStation("");
//			return;
//			Decal_SetDynamicVisible("decal_post_torture_drill*", true);
//			return;
//			FearHandler_SetActive(false);
//			Entity_SetActive("Wraith_Test", true);
//			return;
			//			Player_Teleport("Start_Test");
//			mbChairHasVitae = true;
			Lamp_SetLit("Lamp_TorturePanel_*", true, true);
//			Lamp_SetLit("Lamp_TortureBooth_*", true, true);
			Light_FadeBrightnessToDefault("Light_TortureChamber_Point_*", 0.5);
//			Lamp_SetLit("Lamp_VitaeChair", true, true);
			Lamp_SetLit("Lamp_TortureBench_*", true, true);
			Entity_SetEffectsActive("VitaePipe_TortureBooth_*", true, true);
			
			msTortureType = "burning";
			
			Seq_AfterTorture("");
			return;
			Seq_ActivateTortureChamber("");	
			return;
//			cLux_SetScriptDebugOn(false);
//			cLux_SetHideDebugOutputOn(true);
			Player_Teleport("Start_TortureChamber");
			SetupHappyRoomWraithIntro1();
//			Seq_ActivateHappyRoom("");
		}
		
		if(alAction == eAction_Test2)
		{
			bTest = !bTest;
			
			if (bTest)
			{
				Wraith_ModeWraithPatrol_ClearNodes("Wraith_Test");
				Wraith_ModeWraithPatrol_AddNode("Wraith_Test", "PathNode_RnD_302");
				Wraith_ModeWraithPatrol_AddNode("Wraith_Test", "PathNode_RnD_331");
				Wraith_ModeWraithPatrol_AddNode("Wraith_Test", "PathNode_RnD_318");
				Wraith_ModeWraithPatrol_Setup("Wraith_Test", false, false);
//				Wraith_ModeWraithPatrol_SetBurstTime("Wraith_ExtenderEncounter", 20.0f);
				Wraith_ModeWraithPatrol_SetLookAroundTime("Wraith_Test", 15.0f);
				Wraith_Mode_Set("Wraith_Test", eWraithMode_WraithPatrol, true);
			}
			else
			{
				Wraith_Mode_Set("Wraith_Test", eWraithMode_Idle, true);
			}
		}
		
		if(alAction == eAction_Test3)
		{
			return;
//			Item_AddToInventory("VitaeCanister");
//			Player_Teleport("Start_ShuttleObservation");
//			cLux_SetScriptDebugOn(false);
			cLux_SetHideDebugOutputOn(true);
			Player_Teleport("Start_TortureChamber");
			OnTimer_SetupTortureToExitEncounter("");
		}
		
		if (alAction == eAction_Test4)
		{
//			return;
			++lTest;
			SetBurnerState("TortureTool_Burner_1", lTest);
			lTest %= 4;
			return;
		}
		
		if (alAction == eAction_Test5)
		{
//			SetDrownerState("TortureTool_Drowner", lTest, 0.5);
//			++lTest;
//			lTest %= 3;
//			return;
//			++lTest;
//			SetBurnerState("TortureTool_Burner_1", lTest);
//			lTest %= 4;
//			return;
			if (lTest == 0)
			{
				SetShuttleControlPanelActive(false);
				Lamp_SetLit("Lamp_ShuttleStation*", false, true);
				Lamp_SetLit("Lamp_ShuttlePlatform*", false, true);
				Lamp_SetLit("Lamp_ShuttleGate*", false, true);
			}
			else if (lTest == 1)
			{
				SetShuttleControlPanelActive(true);
				Lamp_SetLit("Lamp_ShuttleStation*", false, true);
//				Lamp_SetLit("Lamp_ShuttlePlatform*", true, true);
			}
			else if (lTest == 2)
			{
				Lamp_SetLit("Lamp_ShuttleStation*", true, true);
				Lamp_SetLit("Lamp_ShuttlePlatform*", true, true);
			}
			else if (lTest == 3)
			{
				Lamp_SetLit("Lamp_ShuttleGate*", true, true);
				OnTimer_ActivateRailLights("");
			}
			
			lTest++;
			lTest %= 4;
		}
		
		if(alAction == eAction_Test6)
		{	
			bTest = !bTest;
			OnPower_PowerReceiver_TortureRoom(bTest, "");
