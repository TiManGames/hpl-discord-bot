		{
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_BottomFloor_1");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_154");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_156");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_151");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_150");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_170");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_172");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_138");
			
			Wraith_ModeWraithPatrol_Setup("Wraith_BottomFloor_1", false, false);
			
			Wraith_ModeWraithPatrol_SetBurstTime("Wraith_BottomFloor_1", 20);
			Wraith_ModeWraithPatrol_SetLookAroundTime("Wraith_BottomFloor_1", 60);
