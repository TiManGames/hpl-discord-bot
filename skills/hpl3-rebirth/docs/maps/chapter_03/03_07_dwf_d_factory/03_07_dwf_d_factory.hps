	////////////////////////////
	// Set up map environment
	void Setup()
	{
		cLux_GetCurrentMap().GetPhysicsWorld().SetWorldSize(Map_GetEntity("Target_PhysicsMin").GetPosition(), Map_GetEntity("Target_PhysicsMax").GetPosition());
		
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("03-07-dwf-d-factory");
		
		Player_SetCameraFarPlane(8192.0f);

		// Reset effects
		Effect_Bloom_FadeBrightPass(0.3f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(1.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		// Set up color grading etc.
		Pregnancy_SetStage(ePregStage_Stage2);
		Pregnancy_SetBarksActive(true);
	
		// GREGOR This is where the stage needs to be set depending on whether torture was done or not.
		if (cScript_GetGlobalVarBool("DWF_RnD_UsedVitaeChair"))
			Pregnancy_SetBabyTalkStage(eBabyTalkStage_DWF_Tortured);
		else
			Pregnancy_SetBabyTalkStage(eBabyTalkStage_DWF_NotTortured);
			
		Pregnancy_SetBabyKicksEnabled(true);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(true);
		Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_Initial");
		FearHandler_SetWhisperStage(eFearWhisperStage_DWFCToTown);
		
		Map_Preset_SetupDirLight("Preset_LightningOn", true, cColor(1,1.5,2,1), 20, cVector3f(-0.913, -0.407, -0.009), cColor(0.092,0.069,0.069,1), cColor(0.092,0.069,0.069,1));
//		Map_Preset_SetupColorGrading("Preset_LightningOn", "grading_lightning_flash");
//		Map_Preset_SetupBloom("Preset_LightningOn", 10, 0.02f, 1.5f, cColor(1, 2, 2, 1));
		
		Map_Preset_SetupDirLight("Preset_LightningOff", false, cColor(1,0.851,0.629,0.588), 0.1f, cVector3f(-0.366, -0.884, 0.29), cColor(0.031,0.031,0.031,1), cColor(0.295,0.26,0.228,0.588));
//		Map_Preset_SetupColorGrading("Preset_LightningOff", "grading_darkworld_ledge");
//		Map_Preset_SetupBloom("Preset_LightningOff", 128.f, 0.75f, 0.5f, cColor(1.f));
		
		Map_Preset_Fade("Preset_LightningOff", 1.0f);	

		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(2);
		StruggleFlashHandler_SetProgression(2);
		
		cScript_SetGlobalVarBool("Global_LanternLost", true);
	}
	
