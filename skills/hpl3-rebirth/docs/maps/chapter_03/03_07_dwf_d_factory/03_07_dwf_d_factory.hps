		//-------------------------------------------------------
		
		bool OnCollide_Player_PrepareMiddleFloorEncounter(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("[Map] Prepare middle floor encounter");
			
			Entity_SetActive("Wraith_MiddleFloorGround", true);
			Wraith_SetHearing("Wraith_MiddleFloorGround", false);
			Wraith_SetVolumeMul("Wraith_MiddleFloorGround", 0, true);
			
			Entity_PlaceAtEntity("Wraith_MiddleFloorGround", "Target_Wraith_MiddleFloorGround_1");
			iLuxEntity@ pEnt = Map_GetEntity("Target_Wraith_MiddleFloorGround_1");
			CharMover_TurnInstantlyToPos("Wraith_MiddleFloorGround", pEnt.GetPosition() + pEnt.GetBaseMatrix().GetTranspose().GetForward());
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartMiddleFloorGround(const tString &in asParent, const tString &in asChild, int alState)
		{
			StartMiddleFloorGround();
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartMiddleFloorGround(const tString &in asEntity, int alState)
		{
			StartMiddleFloorGround();
			Map_AddTimer("Timer_StartMiddleFloorMusic", 1.5, "OnTimer_StartMiddleFloorMusic");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartMiddleFloorMusic(const tString &in asTimer)
		{
			Music_Play("A2_3_6_GhoulNestEvent_Alt.ogg", 0.5, true, eMusicPrio_SceneAmb);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StopMiddleFloorEncounterMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_Stop(2.0, eMusicPrio_SceneAmb);
			return false;
		}
		
		//-------------------------------------------------------
		
		void StartMiddleFloorGround()
		{
			if (mbMiddleFloorPosSelected) return;
			mbMiddleFloorPosSelected = true;
			
			cLux_AddDebugMessage("[Map] Start middle floor encounter");
			
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_MiddleFloorGround");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_83");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_10");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_41");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_46");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_31");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_21");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_57");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_64");
			Wraith_ModeWraithPatrol_AddNode("Wraith_MiddleFloorGround", "PathNode_MiddleFloor_30");

			Wraith_ModeWraithPatrol_Setup("Wraith_MiddleFloorGround");
			Wraith_Mode_Set("Wraith_MiddleFloorGround", eWraithMode_WraithPatrol);
			
			Wraith_SetHearing("Wraith_MiddleFloorGround", true);
			Wraith_SetVolumeMul("Wraith_MiddleFloorGround", 1);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_MiddleFloorSwitch(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbMiddleFloorPosSelected) return false;
			
			iLuxEntity@ pTrigger = Map_GetEntity(asParent);
			if (alState == 1)
			{
				pTrigger.SetVarVector3f("PlayerPos", Player_GetPosition());
			}
			else
			{
				cVector3f vOldPos = pTrigger.GetVarVector3f("PlayerPos");
				cVector3f vDir = Player_GetPosition() - vOldPos;
				vDir.Normalize();
				float fDot = cMath_Vector3Dot(vDir, pTrigger.GetMatrix().GetTranspose().GetForward());
				
				iLuxEntity@ pEnt;
				if (fDot > 0)
				{
					cLux_AddDebugMessage("[Map] Middle floor switch 2");
					@pEnt = Map_GetEntity("Target_Wraith_MiddleFloorGround_2");
				}
				else
				{
					cLux_AddDebugMessage("[Map] Middle floor switch 1");
					@pEnt = Map_GetEntity("Target_Wraith_MiddleFloorGround_1");
				}
				Entity_PlaceAtEntity("Wraith_MiddleFloorGround", pEnt.GetName());
				CharMover_TurnInstantlyToPos("Wraith_MiddleFloorGround", pEnt.GetPosition() + pEnt.GetBaseMatrix().GetTranspose().GetForward());
			}
			return true;
		}
		
		//-------------------------------------------------------

		//} END Event C *Avoid a FLYING WRAITH and a PATROLLING WRAITH on the middle floor*
		
