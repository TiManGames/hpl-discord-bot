	//-------------------------------------------------------
	
	int mlWraithPermafailCount_WaterEncounter = 0;
	int mlWraithPermafailCount_MiddleEncounter = 0;
	bool OnPermaFail(const tString &in asSource)
	{	
		FearHandler_ClearPermaFailScenes();
		SetupGenericPermaFail();
		
		if (mlPermaFailStage == eFactoryDPermaFailStage_SafeRoom)
		{
			++mlWraithPermafailCount_MiddleEncounter;
		}
		else if (mlPermaFailStage == eFactoryDPermaFailStage_VitaePuzzle)
		{
			
		}
		else if (mlPermaFailStage == eFactoryDPermaFailStage_Water || mlPermaFailStage == eFactoryDPermaFailStage_Elevator)
		{
			++mlWraithPermafailCount_WaterEncounter;
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	int mlWraithAttackCount_WaterEncounter = 0;
	int mlWraithAttackCount_MiddleEncounter = 0;
	void OnDamageTaken(const tString&in asSource, int alType)
	{
		if (alType == eDamageType_Silent)
		{
			if (mlPermaFailStage == eFactoryDPermaFailStage_SafeRoom)
			{
				++mlWraithAttackCount_MiddleEncounter;
			}
			else if (mlPermaFailStage == eFactoryDPermaFailStage_Water || mlPermaFailStage == eFactoryDPermaFailStage_Elevator)
			{
				++mlWraithAttackCount_WaterEncounter;
			}
		}	
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFailRespawn()
	{		
		if (mlPermaFailStage == eFactoryDPermaFailStage_SafeRoom)
		{
			if ((mlWraithPermafailCount_MiddleEncounter <= 1 && mlWraithAttackCount_MiddleEncounter >= 3) || mlWraithPermafailCount_MiddleEncounter >= 2)
			{
				Wraith_CommandDash_Execute("Wraith_MiddleFloorGround", Map_GetEntity("Target_WraithDisappear_Middle_1").GetPosition(), true, true, true);
			}
		}
		else if (mlPermaFailStage == eFactoryDPermaFailStage_Water)
		{
			Player_SetForceNightVision(true);
			Map_AddTimer("Timer_DisableForcedNV", 20, "OnTimer_DisableForcedNV");
			
			if ((mlWraithPermafailCount_WaterEncounter <= 1 && mlWraithAttackCount_WaterEncounter >= 3) || mlWraithPermafailCount_WaterEncounter >= 2)
			{
				if (mbElevatorPatrolActive == false) Seq_StartElevatorPatrol("");
				Wraith_CommandDash_Execute("Wraith_BottomFloor_1", Map_GetEntity("Target_WraithDisappear_Water_1").GetPosition(), true, true, true);
			}
		}
		else if (mlPermaFailStage == eFactoryDPermaFailStage_Elevator)
		{
			Player_SetForceNightVision(true);
			Map_AddTimer("Timer_DisableForcedNV", 20, "OnTimer_DisableForcedNV");
			
			if (mbElevatorPatrolActive == false) Seq_StartElevatorPatrol("");
			Wraith_CommandDash_Execute("Wraith_BottomFloor_1", Map_GetEntity("Target_WraithDisappear_Water_1").GetPosition(), true, true, true);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DisableForcedNV(const tString &in asTimer)
	{
		Player_SetForceNightVision(false);
	}
	
	//-------------------------------------------------------
	
	array<int> mvUnplayedGenericPermaFails = { 1, 2 };
	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 3; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);
			
		tString sAreaBase = "Area_PermaFail_Generic";	
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_2", sAreaBase + "_1_End_2", 4.f, 2.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_3", sAreaBase + "_1_End_3", 3.f, 2.5f);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 3.f, 3.0);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_1", sAreaBase + "_3_End_1", 4.f, 3.0f);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_2", sAreaBase + "_3_End_2", 5.f, 3.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_3", sAreaBase + "_3_End_3", 4.f, 2.5);
				break;
		}
	}
	
