		/////////////////////////////////////////
		// Event D *Calm down in the safe room between the top and middle floors*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void InitTopFloorSafeRoom()
		{
			SwingDoor_SetOpenAmount("SafeRoomDoor_TopFloor_1", 0.2);
			SwingDoor_SetBlocked("SafeRoomDoor_TopFloor_2", true, false);
			Entity_SetVarBool("DoorLock_TopFloor_2", "Locked", true);
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_DoorLockTopFloor(const tString &in asEntity, int alState)
		{
			iLuxEntity@ pLock = Map_GetEntity(asEntity);
			if (pLock is null) return;
			tString sDoorName = pLock.GetVarString("");
			
			bool bLocked = alState == -1 && SwingDoor_GetOpenAmount(sDoorName) <= 0.075;
			FearArea_SetLocked("Fear_SafeTopFloor_1", bLocked);
			FearArea_SetLocked("Fear_SafeTopFloor_2", bLocked);
			if (bLocked)
			{
				SwingDoor_SetBlocked(sDoorName, true, true);
				pLock.SetVarBool("Locked", true);
				Pregnancy_SetBabyTalkRoomSpecificSubject("BabyTalk_SafeRoom", true);
			}
			else
			{
				SwingDoor_SetBlocked(sDoorName, false, true);
				pLock.SetVarBool("Locked", false);
				Pregnancy_ClearBabyTalkRoomSpecificSubject();
			}
		}
		
		//-------------------------------------------------------
		
		void OnInteract_SafeRoomDoor_TopFloor_2(const tString &in asEntity)
		{
			bool bLock2 = Entity_GetVarBool("DoorLock_TopFloor_2", "Locked");
			if (bLock2 == false)
			{
				Map_AddTimer("Timer_EnterMiddleFloorDialogue", 0.3, "OnTimer_EnterMiddleFloorDialogue");
			}
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_SafeRoomDoor_TopFloor_2(const tString &in asEntity)
		{
			Map_RemoveTimer("Timer_EnterMiddleFloorDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnterMiddleFloorDialogue(const tString &in asTimer)
		{
			Voice_Play("Dialogue_EnterMiddleFloor");
		}
		
		//-------------------------------------------------------
		
		//} END Event D *Calm down in the safe room between the top and middle floors*
		
		/////////////////////////////////////////
		// Event C *Avoid a FLYING WRAITH and a PATROLLING WRAITH on the middle floor*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbMiddleFloorFlyPatrolStarted = false;
		bool mbMiddleFloorEncounterStarted = false;
		bool mbMiddleFloorActive = false;
		int mlMiddleFloorStage = 0;
		bool mbMiddleFloorPosSelected = false;
		
		//-------------------------------------------------------
		
		void InitMiddleFloor()
		{
			Entity_PlayAnimation("Ghoul_MiddleFloor", "eat_lizard", 0, true);
			
			TorturePod_SetVolume("Pod_Working_9", 0, 0);
			TorturePod_SetVolume("Pod_Working_8", 0, 0);
			TorturePod_SetVolume("Pod_Working_10", 0, 0);
		}
		
		//-------------------------------------------------------
		
		bool OnColide_Player_EnterMiddleFloor(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) Sound_CreateAtEntity("GhoulEating", "creatures/vocalisations/creature/ghoul/ghoul_eating", "Ghoul_MiddleFloor", 1, true, 1, 5, 18);
			else Sound_Stop("GhoulEating", 1);
			return true;
		}
		
