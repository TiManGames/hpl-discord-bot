		//-------------------------------------------------------
		
		array<cVitaePipeCrack> mvPipeCracks(0);
		
		int mlVitaeValveToDestroy = 0;
		int mlPrevVitaeValveToDestroy = -1;
		int mlVitaeValveToUpdate = -1;
		float[] mfVitaeValveT = {0.f};
		bool mbTowerUnstable = false;
		bool mbDestructionCutsceneStarted = false;
		int mlInjectedAccessPoint = 1;
		int mlUnstableTowerShakeId = -1;
		bool mbAllowStallDestruction = false;
		bool mbTinHinanDamaged = false;
		bool mbTowerQuakeActive = false;
		bool mbLeftCeilingFleshSpawned = false;
		bool mbRightCeilingFleshSpawned = false;
		int mlOutsidePipeId = 1;
		int[] mlVitaeMapFlashCount = {0};
		bool mbAllowCeilingBreak = true;
		tString msCurrentVitaeValve = "";
		array<int> mvActiveVitaeValveIds = { 1};
		array<int> mvVitaeValveIdsWithSolidifier = { };
		array<int> mvVitaeValveIdsPastHalfway = { };
		cScriptStringSet m_setPipeCracks;
		bool mbInjectingShadowFlesh = false;
	
		
		//-------------------------------------------------------
		
		void SetupAccessPointUvAnimation(const tString &in asAccessPoint)
		{
			Prop_SetUvAnimationTime(asAccessPoint, "vitae_pipe_glow_low", 0.f);
			Prop_SetUvAnimationTime(asAccessPoint, "vitae_pipe2_glow_low", 0.f);
			Prop_SetUvAnimationSpeed(asAccessPoint, "vitae_pipe_glow_low", 0.f);
			Prop_SetUvAnimationSpeed(asAccessPoint, "vitae_pipe2_glow_low", 0.f);
		}
		
		//-------------------------------------------------------
		
		bool CanUse_ShadowFleshCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{
			for (int i = 1; i < 2; ++i)
			{
				if (asPickedEntity == "VitaeAccessPoint_" + i && mfVitaeValveT[i - 1] < 0.43f)
				{
					Item_ShowShadowFleshVialCount(ShadowFleshVials_GetCount() == 0, false);
					return true;
				}
			}			
			return false;
		}
		 
		//-------------------------------------------------------
		 
		bool OnUse_ShadowFleshCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, 
									   const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			if (mbInjectingShadowFlesh) return false;
			if (ShadowFleshInjector_GetAmount() <= 0)
			{
				Item_FlashItemCount(2);
				return false;
			}
			
			int lId = cString_GetNumericSuffixInt(asTargetEntity);
			if (mvVitaeValveIdsWithSolidifier.find(lId) != -1)
				return true;	
			
			////////////////////
			// Only allow once per valve
			mvVitaeValveIdsWithSolidifier.push_back(lId);
			Entity_SetInteractionDisabled(asTargetEntity, true);
			
			ShadowFleshInjector_ReduceAmount();
			Item_Unequip(asItemID);
			
			////////////////////
			// Bark!
//			if (mvActiveVitaeValveIds.size() == 1)
//			{
//				Voice_StopScenesWithCharacter("Player");
//				Voice_Play("Dialogue_AboutToTurnFinalValve");
//			}
				
			////////////////////
			// Inject pipe!
			mlInjectedAccessPoint = lId;
			Seq_InjectAccessPoint("");
			return true;
		}
		
		//-------------------------------------------------------
				
		cSequenceStatesData mSeqDataInjectAccessPoint;
		void Seq_InjectAccessPoint(const tString &in asTimer)
		{
			tString sAccessPoint = "VitaeAccessPoint_" + mlInjectedAccessPoint;
			tString sInjector = "Injector_" + mlInjectedAccessPoint;
			tString sInjectorOrigin = "InjectorOrigin_" + mlInjectedAccessPoint;
			tString sInjectorTarget = "InjectorTarget_" + mlInjectedAccessPoint;
			
			Sequence_Begin("Seq_InjectAccessPoint", mSeqDataInjectAccessPoint);
			if (Sequence_DoStepAndWait(1.f))
			{
				mbInjectingShadowFlesh = true;
				
				// TODO: Remove this stuff when we have proper animations!
				iLuxEntity@ pEnt = Map_GetEntity(sAccessPoint, eLuxEntityType_Prop);
			
				cVector3f vInjectorRot = cVector3f(3.12f, -0.420f, 2.936f);
				cVector3f vInjectorRofOffset = cVector3f(0.f, -0.25f, 3.14f);
				cVector3f vInjectorPos = cVector3f(0.165f, -0.0275f, 0.25f);
				
				cMatrixf mtxInjector = cMath_MatrixMul(cMath_MatrixRotateXYZ(vInjectorRot), cMath_MatrixRotateXYZ(vInjectorRofOffset));
				mtxInjector.SetTranslation(vInjectorPos);			
				mtxInjector = cMath_MatrixMul(pEnt.GetMatrix(), mtxInjector);
				
				mBaseObj.CreateEntity(sInjectorOrigin, "dw_solidifier_syringe_rigid_filled.ent", mtxInjector, cVector3f(0.25f));
				Entity_SetActive(sInjectorOrigin,false);
				
				mBaseObj.CreateEntity(sInjector, "dw_solidifier_syringe_rigid_filled.ent", mtxInjector, cVector3f(0.25f));
				Entity_SetActive(sInjector,false);
				Prop_SetActiveAndFade(sInjector,true,0.5f);
				Entity_StopAnimation(sInjector);
				
				cMatrixf mtxInjectorTarget = mtxInjector;
				mtxInjectorTarget = cMath_MatrixMul(mtxInjector, cMath_MatrixTranslate(cVector3f_Forward * 0.1f));
				
				mBaseObj.CreateEntity(sInjectorTarget, "dw_solidifier_syringe_rigid_filled.ent", mtxInjectorTarget, cVector3f(0.25f));
				Entity_SetActive(sInjectorTarget, false);
				
				Prop_MoveLinearTo(sInjector, sInjectorTarget, 0.05f, 0.2f, 0.1f, false);				
			}
			else if (Sequence_DoStepAndWait(0.75f))
			{
				Entity_PlayAnimation(sInjector, "interact");
				Map_AddTimer(sInjector, 1.f / 60.f, "OnTimer_KillSyringeEffects");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				ParticleSystem_CreateAtEntity("PS_Powder_" + mlInjectedAccessPoint, "dark_world_vitae_inject_shadow_powder.ps", "Area_AccessPointCloud_" + mlInjectedAccessPoint, false);
				Sound_CreateAtEntity("Sound_PlacePowder", "02_03_arsenal/temp/coal_powder", sAccessPoint);
			}
			else if (Sequence_DoStepAndWait(0.4))
			{
				Prop_StopMovement(sInjector);
				Prop_MoveLinearTo(sInjector, sInjectorOrigin, 1.f, 0.2f, 0.1f, false);
			}
			else if (Sequence_DoStepAndWait(0.4))
			{
				Prop_SetActiveAndFade(sInjector,false,0.3f);
				Sound_CreateAtEntity("Sound_DrawInjector","new_sounds/animations/draw_holser/holster_injection","player");
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				iLuxEntity@ pInjector = Map_GetEntity(sInjector, eLuxEntityType_Prop);
				iLuxEntity@ pInjectorTarget = Map_GetEntity(sInjectorTarget, eLuxEntityType_Prop);
				
				if (pInjector !is null)
					mBaseObj.DestroyEntity(pInjector);					
				if (pInjectorTarget !is null)
					mBaseObj.DestroyEntity(pInjectorTarget);

				mbInjectingShadowFlesh = false;
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_KillSyringeEffects(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asTimer, eLuxEntityType_Prop);
			if (pEnt is null)
				return;
				
			cParticleSystem@ pPS = pEnt.GetParticleSystemFromName("PS_1");
			if (pPS is null)
				return;
			
			float fBrightness = pPS.GetBrightness() - 3.f * (1.f / 60.f);
			if (fBrightness < 0.f)
				fBrightness = 0.f;
			
			pPS.SetBrightness(fBrightness);
			
			if (fBrightness <= 0.f)
				return;
				//cLux_AddTodoMessage("HEJ");
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void OnInteract_VitaeValve(const tString &in asEntity)
		{						
			int lId = cString_GetNumericSuffixInt(asEntity);
			if (mvActiveVitaeValveIds.find(lId) == -1)
				return;
			
			msCurrentVitaeValve = asEntity;
			mlVitaeValveToUpdate = lId;
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_VitaeValve(const tString &in asEntity)
		{						   
			Wheel_SetAngle(asEntity, 0.f, true);
		}
		
		//-------------------------------------------------------
		
		void UpdateVitaeValve(float afTimeStep)
		{	
			if (mlVitaeValveToUpdate == -1)
				return;
				
			///////////////
			// Setup vars
			iLuxEntity@ pEnt = mBaseObj.GetEntityByName(msCurrentVitaeValve, eLuxEntityType_Prop);
			bool bPowderActive = mvVitaeValveIdsWithSolidifier.find(mlVitaeValveToUpdate) != -1;
			tString sAccessPoint = "VitaeAccessPoint_" + mlVitaeValveToUpdate;
			int lValveId = mlVitaeValveToUpdate - 1;
			
			if (pEnt is null)
				return;
			
			///////////////
			// Time
			float fPrevT = mfVitaeValveT[lValveId];
			float fGoal = Wheel_GetRotationAmount(msCurrentVitaeValve);
			
			if (mfVitaeValveT[lValveId] >= 0.43f)
			{
				if (fGoal >= 0.95f)	fGoal = 2.f;
				else 				fGoal = 1.f;
			}
			
			bool bPastHalfway = mvVitaeValveIdsPastHalfway.find(mlVitaeValveToUpdate) != -1;			
			if (bPastHalfway)
			{
				fGoal = 2.f;
				pEnt.SetInteractionDisabled(true);
			}

			mfVitaeValveT[lValveId] = cMath_IncreaseTo(mfVitaeValveT[lValveId], (1.f / 4.f) * afTimeStep, fGoal);
			
			// Point of no return!
			if (mvVitaeValveIdsPastHalfway.find(mlVitaeValveToUpdate) == -1)
			{
				if (bPowderActive && mfVitaeValveT[lValveId] >= 1.3f ||
					bPowderActive == false && mfVitaeValveT[lValveId] > 0.43f)
				{
					mvVitaeValveIdsPastHalfway.push_back(mlVitaeValveToUpdate);
				}
			}
			
			///////////////
			// Sound effects
			tString sSound = "Sound_VitaePressure_" + mlVitaeValveToUpdate;			
			if (Sound_Exists(sSound) == false)
				Sound_CreateAtEntity(sSound, "03_04_pillar_room/pillar_activate/pillar_energy_flow", "VitaeAccessPointWheel_" + mlVitaeValveToUpdate);
				
			cSoundEntity@ pSound = mBaseObj.GetWorld().GetSoundEntity(sSound);
			
			float fSpeed = 1.f + cMath_Clamp(mfVitaeValveT[lValveId] / 1.75f, 0.f, 1.f) * 1.25f;
			float fVolume = cMath_Clamp(mfVitaeValveT[lValveId] / 1.75f, 0.f, 1.f) * 1.25f;
			
			if (bPowderActive == false)
			{
				fSpeed = cMath_Min(fSpeed, 0.5f);
				fVolume = cMath_Min(fVolume, 1.f);
			}
			
			// TODO: Use a param for this when we have the proper sound
			pSound.FadeSpeedMul(fSpeed, 10.f);		
			pSound.FadeVolumeMul(fVolume, 10.f);
			
			///////////////
			// PS color
			cColor psColor = cColor(1.f);
			if (bPowderActive)
			{
				float fColorT = cMath_Clamp((mfVitaeValveT[lValveId] - 0.43f) / (1.f - 0.43f), 0.f, 1.f);
				psColor = cColor_White * (1.f - fColorT) + cColor(4.f, 1.f, 1.f, 1.f) * fColorT;
			}
			
			///////////////
			// Injection PS
			tString sInjectionPS = "PS_VitaeInjection_" + mlVitaeValveToUpdate;
			cParticleSystem@ pInjectionPS = mBaseObj.GetWorld().GetParticleSystem(sInjectionPS);
			
			if (mfVitaeValveT[lValveId] >= 0.43f && mfVitaeValveT[lValveId] < 1.f && fPrevT < mfVitaeValveT[lValveId] || 
				mfVitaeValveT[lValveId] >= 1.f && fPrevT > mfVitaeValveT[lValveId])
			{
				if (pInjectionPS is null)
					@pInjectionPS = ParticleSystem_CreateAtEntity(sInjectionPS, "dark_world_vitae_inject.ps", "Area_AccessPointInjection_" + mlVitaeValveToUpdate, false);
					
				pInjectionPS.SetColor(psColor);
			}
			else
			{
				if (pInjectionPS !is null)
					pInjectionPS.Kill();
			}
			
			///////////////
			// Ejection PS
			tString sEjectionPS = "PS_VitaeEjection_" + mlVitaeValveToUpdate;
			cParticleSystem@ pEjectionPS = mBaseObj.GetWorld().GetParticleSystem(sEjectionPS);
			
			if (mfVitaeValveT[lValveId] >= 1.f && mfVitaeValveT[lValveId] < 1.4f && fPrevT < mfVitaeValveT[lValveId])
			{
				if (pEjectionPS is null)
					@pEjectionPS = ParticleSystem_CreateAtEntity(sEjectionPS, "dark_world_vitae_inject.ps", "Area_AccessPointEjection_" + mlVitaeValveToUpdate, false);
				
				pEjectionPS.SetColor(psColor);
			}
			else
			{
				if (pEjectionPS !is null)
					pEjectionPS.Kill();
			}
			
			///////////////
			// Cloud PS
			tString sCloudPS = "PS_VitaeCloud_" + mlVitaeValveToUpdate;
			cParticleSystem@ pCloudPS = mBaseObj.GetWorld().GetParticleSystem(sCloudPS);
			
			if (mfVitaeValveT[lValveId] >= 0.43f && mfVitaeValveT[lValveId] <= 1.3f)
			{
				if (pCloudPS is null)
					@pCloudPS = ParticleSystem_CreateAtEntity(sCloudPS, "dark_world_vitae_inject_cloud.ps", "Area_AccessPointCloud_" + mlVitaeValveToUpdate, false);
				
				pCloudPS.SetColor(psColor);
			}
			else
			{
				if (pCloudPS !is null)
					pCloudPS.Kill();
			}
			
			///////////////
			// Powder PS
			if (bPowderActive && mfVitaeValveT[lValveId] >= 1.f && fPrevT < 1.f)
			{
				cParticleSystem@ pPowderPS = mBaseObj.GetWorld().GetParticleSystem("PS_Powder_" + mlVitaeValveToUpdate);
				if (pPowderPS !is null)
					pPowderPS.Kill();
				
				Entity_SetEffectBaseColor(sAccessPoint, cColor(3.f, 0.45f, 0.45f, 1.f));
			}
			
			///////////////
			// UV animation
			float fFirstPipeT = cMath_Clamp((mfVitaeValveT[lValveId] - 0.f) / (1.f - 0.f), 0.f, 1.f);
			float fSecondPipeT = cMath_Clamp(1.f - ((mfVitaeValveT[lValveId] - 1.f) / (2.f - 1.f)), 0.f, 1.f);
			
			Prop_SetUvAnimationTime(sAccessPoint, "vitae_pipe2_glow_low", fFirstPipeT);
			Prop_SetUvAnimationTime(sAccessPoint, "vitae_pipe_glow_low", fSecondPipeT);
			
			///////////////
			// Stop effects?
			if (mfVitaeValveT[lValveId] <= 0.05f && pEnt.IsInteractedWith() == false)
			{
				pSound.FadeOut(0.5f);
				mlVitaeValveToUpdate = -1;
				mfVitaeValveT[lValveId] = 0.f;
				return;				
			}
			
			///////////////
			// Start explosion!
			if (bPowderActive && mfVitaeValveT[lValveId] >= 1.5f && fPrevT < 1.5f)
			{								
				mlVitaeValveToDestroy = mlVitaeValveToUpdate;				
				Seq_DestroyVitaeValve("");
			}
			
			///////////////
			// Keep running until it reaches max!
			if (mfVitaeValveT[lValveId] >= 2.f)
			{
				pEnt.SetInteractionDisabled(false);
				
				for (int i = 0; i < mvVitaeValveIdsPastHalfway.size(); ++i)
				{
					if (mvVitaeValveIdsPastHalfway[i] == mlVitaeValveToUpdate)
					{
						mvVitaeValveIdsPastHalfway.removeAt(i);
						break;
					}
				}
				
				mlVitaeValveToUpdate = -1;
				msCurrentVitaeValve = "";
				mfVitaeValveT[lValveId] = 0.f;
				
				if (bPowderActive == false)
					pSound.FadeOut(1.f);
			}
		}
				
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataDestroyVitaeValve;
		void Seq_DestroyVitaeValve(const tString &in asTimer)
		{
			int lId = mlVitaeValveToDestroy;
			tString sPipeBase = "VitaeValvePipe_" + lId;
			
			Sequence_Begin("Seq_DestroyVitaeValve", mSeqDataDestroyVitaeValve);
			if (Sequence_DoStepAndWait(1.5f))
			{
				Map_RemoveTimer("Timer_SpawnCeilingFlesh");				
//				StopEncounterDialogue(false);
				
				// Update active valves
				int lActiveValveId = mvActiveVitaeValveIds.find(mlVitaeValveToDestroy);			 
				if (lActiveValveId != -1)
					mvActiveVitaeValveIds.removeAt(lActiveValveId);
				
				Map_AddTimer("Timer_TurnOffVitaeFlow", 4.5f, "OnTimer_TurnOffVitaeFlow");
				Map_AddTimer("Timer_DestroyAccessPoint", 5.3f, "OnTimer_DestroyAccessPoint");
				
				DestroyVitaePipe(sPipeBase + "_1");
				
				Player_FadeMoveSpeedMulTo(0.4f, 0.5f);
				Map_AddTimer("Timer_SlowDownDuringExplosion", 0.5f, "OnTimer_SlowDownDuringExplosion");
			}
			else if (Sequence_DoStepAndWait(0.8f))
			{
				DestroyVitaePipe(sPipeBase + "_2");
			}
			else if (Sequence_DoStepAndWait(1.2f))
			{
				DestroyVitaePipe(sPipeBase + "_7");
			}
			else if (Sequence_DoStepAndWait(0.7))
			{
				DestroyVitaePipe(sPipeBase + "_4");
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Lamp_SetLit("lamp_crystal_2", false, true);
				Map_AddTimer("Target_PipeExplosion_Flash_1", 4.2, "OnTimer_DoShadowFlash");
				DestroyVitaePipe(sPipeBase + "_5");
			}
			else if (Sequence_DoStepAndWait(5.0))
			{
				Map_AddTimer("Target_PipeExplosion_Flash_2", 4.2, "OnTimer_DoShadowFlash");
				DestroyVitaePipe(sPipeBase + "_6");
			}
			else if (Sequence_DoStepAndWait(1.6))
			{
				Seq_BlowUpVitaePuzzlePod("");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SlowDownDuringExplosion(const tString &in asTimer)
		{
			float fDist = Player_GetDistanceToEntity("Area_AccessPointStandPos_1");
			float fMinDist = 1.0f;
			float fMoveMul = 1.0f - cMath_Clamp((fDist - fMinDist) / (7.0f - fMinDist), 0.0f, 1.0f);
			Player_FadeMoveSpeedMulTo(0.4f * fMoveMul, 0.5f);
			
			cLux_AddDebugMessage("PLAYER MUL " = 0.4f * fMoveMul);
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.4));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoShadowFlash(const tString &in asTimer)
		{
			LightFlash_Add(0.4, 0.3f, 0.7f, Map_GetEntity(asTimer).GetPosition(), cColor(0.5,0.05,0.05,0.4), 8, 5);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TurnOffVitaeFlow(const tString &in asTimer)
		{
			PlayerBody_PlayCutsceneAnimation("regain_balance_dwf_shuttle_sway", false, 0.3f);
			Lamp_SetLit("lamp_crystal_3", false, true);
			Entity_SetEffectsActive("VitaePipeSource*", false, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DestroyAccessPoint(const tString &in asTimer)
		{
			tString sAccessPoint = "VitaeAccessPoint_" + mlVitaeValveToDestroy;
			tString sGrating = "VitaeAccessPointGrate_" + mlVitaeValveToDestroy;
			
			Entity_SetEffectsActive(sAccessPoint, false, false);
			Entity_SetEffectsActive(sAccessPoint + "_*", false, true);
				
			Sound_Stop("Sound_VitaeValve_" + mlVitaeValveToDestroy, 0.5f);
			Sound_Stop("Sound_VitaePressure_" + mlVitaeValveToDestroy, 0.5f);
			
			if (mlVitaeValveToDestroy % 2 != 0)
			{
				if (Entity_IsInteractedWith(sGrating))
					Player_ChangeStateToNormal();
				
				Prop_SetHealth(sGrating, 0.f);				
				ParticleSystem_CreateAtEntity("PS_GrateBreak", "dust_impact_small_oneshot.ps", sGrating, false).SetBrightness(0.25f);
				Sound_CreateAtEntity("Sound_PipeBreak", "03_07_dw_factory/vitae_pump/pipe_burst", sGrating);
//				Sound_CreateAtEntity("Sound_Grating", "level_entity_shared/breakables/relic_room_bars/relic_bars_break", sGrating);
			}
		}
		
		//-------------------------------------------------------
		
		void DestroyVitaePipe(const tString &in asPipe)
		{
			int lPipeId = cString_ToInt(cString_Sub(asPipe, 17, 2), 0);
			
			float fTime = 1.f;
			float fTimeMul = 1.f;
			
			Map_AddTimer(asPipe, fTime, "OnTimer_BreakVitaePipe_Step1");
			Map_SetTimerUserVarFloat(asPipe, fTimeMul);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakVitaePipe_Step1(const tString &in asTimer)
		{			
			tString sCrack = "Decal_" + asTimer + "_Crack_";
			float fTimeMul = Map_GetTimerUserVarFloat(asTimer);
			float fTime = 0.1f * fTimeMul;			

			for (int i = 1; i < 13; ++i)
			{
				tString sTimer = sCrack + i;
				Map_AddTimer(sTimer, fTime, "OnTimer_BreakVitaePipe_Step2");
				Map_SetTimerUserVarFloat(sTimer, fTimeMul);
				
				fTime += 0.25f * fTimeMul;
			}
			
			iLuxEntity@ pPipe = Map_GetEntity(asTimer, eLuxEntityType_Prop);
			if (pPipe !is null)
			{
				iLight@ pLight = pPipe.GetLightFromName("Light_Point_1");
				if (pLight !is null)
					pLight.FadeBrightnessTo(0.5f, 3.7f * fTimeMul, eEasing_SineIn);
			}
				
			Map_AddTimer(asTimer, 3.5f * fTimeMul, "OnTimer_FadeVitaePipeColor_Step_1");
			
			/////////////////
			// Throne Room pipe
			int lId = cString_GetNumericSuffixInt(asTimer);			
			if (lId == 8)
			{
				for (int i = 1; i < 4; ++i)
					Map_AddTimer(asTimer + "_Ceiling_" + i, 2.3f * fTimeMul + i * 0.4f, "OnTimer_BreakPipeCeiling");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakPipeCeiling(const tString &in asTimer)
		{
			if (Entity_Exists(asTimer) == false)
				return;
			
			Entity_SetActive(asTimer, true);
			Entity_SetCollide(asTimer, false);
			Entity_SetCollideCharacter(asTimer, false);
			
			ParticleSystem_CreateAtEntity("PS_PipeCeiling_" + asTimer, "dust_impact_large_oneshot.ps", asTimer, false).SetBrightness(0.1f);
			ParticleSystem_CreateAtEntity("PS_Debris_" + asTimer, "throne_room_ceiling_debris.ps", asTimer, false);
			
			Map_AddTimer(asTimer, 7.f, "OnTimer_DeactivatePipeCeiling");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivatePipeCeiling(const tString &in asTimer)
		{
			Entity_SetActive(asTimer, false);
		}
		
		//-------------------------------------------------------
				
		void OnTimer_FadeVitaePipeColor_Step_1(const tString &in asTimer)
		{			
			Entity_FadeEffectBaseColor(asTimer, cColor(0.f), 0.5f);
			
			if (cString_GetNumericSuffixInt(asTimer) == 6)
			{
				//Entity_SetEffectsActive("Generator_" + mlVitaeValveToDestroy + "_*", false, true);
//				ParticleSystem_CreateAtEntity("PS_CorridorDust", "dust_medium_extra_long_oneshot.ps", "Area_CorridorDust_" + mlVitaeValveToDestroy, false).SetBrightness(0.35f);
			}
			
			Map_AddTimer(asTimer, 0.5f, "OnTimer_FadeVitaePipeColor_Step_2");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeVitaePipeColor_Step_2(const tString &in asTimer)
		{
			Entity_SetEffectsActive(asTimer, false, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakVitaePipe_Step2(const tString &in asTimer)
		{			
			if (m_setPipeCracks.Exists(asTimer) == false)
				return;			
						
			/////////////////
			// Start cracks!
			tString sCrack = asTimer + "_*";
			float fTimeMul = Map_GetTimerUserVarFloat(asTimer);
			mvPipeCracks.push_back(cVitaePipeCrack(asTimer, fTimeMul));
			
			/////////////////
			// Flicker!
			tString sPipe = cString_Sub(asTimer, 6, 18);
			tString sLight = Entity_GetVarString(sPipe, "");
			if (sLight != "")
			{
				if (sLight[0] == 'L')	Light_SetFlickerActive(sLight, true);
				else					Lamp_SetFlickerActive(sLight, true);
				
				Map_AddTimer(sLight, cMath_RandRectf(4.5f, 5.f) * fTimeMul, "OnTimer_StopPipeLightFlicker");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopPipeLightFlicker(const tString &in asTimer)
		{
			if (asTimer[0] == 'L')
			{
				Light_SetFlickerActive(asTimer, false);
				Light_FadeBrightnessTo(asTimer, 0.f, 0.3f, eEasing_SineOut);
			}
			else
			{
				Lamp_SetFlickerActive(asTimer, false);
				Lamp_SetLit(asTimer, false, true);		
			}
		}
		
		//-------------------------------------------------------
		
		void UpdateVitaePipeCrack(float afTimeStep)
		{
			for (int i = 0; i < mvPipeCracks.size(); ++i)
			{
				if (mvPipeCracks[i].Update(afTimeStep))
				{
					mvPipeCracks.removeAt(i);
					--i;
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakVitaePipe_Step3(const tString &in asTimer)
		{
			tString sCrack = cString_Sub(asTimer, 6, -1);
					
			///////////////////
			// Spawn flesh!			
			iLuxEntity@ pFlesh = Map_GetEntity("ShadowFlesh_" + sCrack + "-1", eLuxEntityType_Prop);
			tString sFleshName = "";
			
			if (pFlesh !is null)
			{
				sFleshName = pFlesh.GetName();
				
				ShadowFlesh_Spawn("ShadowFlesh_" + sCrack + "-*", pFlesh.GetVarString(""), 0.1f, 0.1f, false);			
				
				ShadowFlesh_DoFleshEffectsAtPos(pFlesh.GetPosition(), 2.f);
				Effect_Shake_Start(0.025f, 0.5f, 0.05f, 0.25f);
				ParticleSystem_CreateAtEntity("PS_PipeBreak_" + sCrack, "vitae_pipe_splash.ps", sFleshName, false);
				
				// Extra light at pipes leading out
				if (cString_Sub(sCrack, 17, 1) == "4")
					LightFlash_Add(0.3f, 0.25f, 0.125f, sFleshName, cColor_Red, 10.f, 1.f);
				
				// Extra light at pipes leading to TH
				if (cString_Sub(sCrack, 17, 1) == "8")
					LightFlash_Add(0.3f, 0.25f, 0.125f, sFleshName, cColor_Red, 4.f, 1.f);
			}
			
			Map_AddTimer(sCrack, 0.15f, "OnTimer_BreakVitaePipe_SpawnFlesh");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakVitaePipe_SpawnFlesh(const tString &in asTimer)
		{
			ShadowFlesh_Spawn("ShadowFlesh_" + asTimer + "_*", "", 0.15f, 0.3f, false);
		}	
				
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceBlowUpVitaePuzzlePod;;
		void Seq_BlowUpVitaePuzzlePod(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BlowUpVitaePuzzlePod", mSequenceBlowUpVitaePuzzlePod);
			if (Sequence_DoStepAndWait(0.25))
			{
				PlayerBody_PlayCutsceneAnimation("regain_balance_dwf_shuttle_sway", false, 0.3f);
				
				Map_RemoveTimer("Timer_SlowDownDuringExplosion");
				Player_FadeMoveSpeedMulTo(1.0f, 0.5f);
				
				LightFlash_Add(0.5, 0.3, 0.7, Map_GetEntity("Target_PodExplosion_1").GetPosition(), cColor(0.5,0.05,0.05,0.4), 12, 10);
				Lamp_SetLit("lamp_crystal_1", false, true);
				
				Sound_CreateAtEntity("VitaePuzzleBlowUp", "03_07_dw_factory/vitae_pump/wall_break", "Target_PodExplosion_1");
				ParticleSystem_CreateAtEntity("PodBlowUp", "03_07_Vitae_explosion_1", "Target_PodExplosion_1", false);
				
				Effect_Shake_Start(0.2, 1.5f, 0.1, 1, cVector3f_One);
				
				Music_Play("A2_3_8_Shadow_Burst.ogg", 0.18f, false, eMusicPrio_MinorEvent);
				Music_Stop(2.0, eMusicPrio_SceneAmb);
			}
			else if (Sequence_DoStepAndWait(0.25))
			{
				Entity_SetActive("Pod_Working_8", false);
				Entity_SetActive("Pod_Working_9", false);
				Entity_SetActive("Pod_Working_10", false);
				
				Entity_SetActive("FearScaryObject_10", false);
				Entity_SetActive("FearScaryObject_8", false);
				Entity_SetActive("FearScaryObject_9", false);
				
				Entity_SetActive("FearScaryObject_11", true);
				Entity_SetActive("Trigger_ShadowFleshDamage*", true);
				Entity_SetActive("Blocker_VitaePuzzleAfter*", true);
				
				Entity_SetActive("BarTear_3", false);
				
				Entity_SetActive("VitaePuzzle_Before*", false);
				Entity_SetActive("VitaePuzzle_After*", true);
				Entity_SetActive("Window_Broken*", false);
				Decal_SetDynamicVisible("VitaePuzzle_Before*", false);
				Decal_SetDynamicVisible("VitaePuzzle_After*", true);
				
				Light_SetVisible("VitaePuzzle_After*", true);
				Light_SetVisible("VitaePuzzle_Before*", false);
				
				Entity_SetEffectsActive("undercity_vitae_hose_straight_poseable_5", false, true);
				Entity_SetEffectsActive("undercity_vitae_hose_straight_poseable_4", false, true);
				

//				Seq_BottomFloorIntro("");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ShadowFleshDamage(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1) return true;
			if (Map_TimerExists("ShadowFleshCooldown")) return true;
			
			Map_AddTimer("ShadowFleshCooldown", 1.0f, "");
			Player_GiveDamage(0.1f, 0.2f, eDamageType_Guardian, asParent);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartWaterScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_WaterScare("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWaterScare;
		void Seq_WaterScare(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WaterScare", mSequenceWaterScare);
			if (Sequence_DoStepAndWait(1))
			{
				Entity_SetActive("Wraith_WaterScare", true);
				Wraith_SetFly("Wraith_WaterScare", true);
				Agent_SetSensesActive("Wraith_WaterScare", false);
				Wraith_SetCallback_BeamCenterSeen("Wraith_WaterScare", "OnBeamSeen_SeeNewWraithDialogue");
			}
			else if (Sequence_DoStepAndWait(6))
			{
				Wraith_SetSpotlightOn("Wraith_WaterScare", true);
				Wraith_TurnSpotlightToPos("Wraith_WaterScare", Map_GetEntity("Target_WaterScare_LookAt_1").GetPosition(), true, true);
				
				
				Map_AddTimer("Timer_StartWaterEncounterMusic", 2, "OnTimer_StartWaterEncounterMusic");
			}
			else if (Sequence_DoStepAndWait(3))
			{
				Wraith_CommandDash_Execute("Wraith_WaterScare", Map_GetEntity("Target_WaterScare_MoveTo_1").GetPosition(), false, true, true,"");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event D *Break the wall by blowing up the EXPLODING POD*
		
		/////////////////////////////////////////
		// Event D *Avoid two FLYING WRAITHS on the bottom floor*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbBottomFloorEncounterStarted = false;
		int mlWaterEncounterStage = 0;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartWaterEncounter(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_WaterEncounterIntro("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWaterEncounterIntro;
		void Seq_WaterEncounterIntro(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WaterEncounterIntro", mSequenceWaterEncounterIntro);
			if (Sequence_DoStepAndWait(0.2))
			{
				mlWaterEncounterStage = 1;
				
				Pregnancy_SetWhispering(true);
				
				FearHandler_SetPermaFailRespawnArea("PermaFail_Water");
				mlPermaFailStage = eFactoryDPermaFailStage_Water;
				
				Entity_SetActive("Wraith_BottomFloor_1", true);
				Wraith_SetFly("Wraith_BottomFloor_1", true);
				Agent_SetSensesActive("Wraith_BottomFloor_1", false);
				Wraith_SetSpotlightColor("Wraith_BottomFloor_1", "alert");
				
				SetWraithSpotlightMask("Wraith_BottomFloor_1", "Light_LightBoxReference");
				
				Sound_CreateAtEntity("WaterEncounterIntro", "creatures/vocalisations/creature/wraith/start_search", "Wraith_BottomFloor_1");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Wraith_CommandDash_Execute("Wraith_BottomFloor_1", Map_GetEntity("Target_WaterEncounter_MoveTo_1").GetPosition(), false, false, true, "OnCommandEnd_ResumeWaterEncounterIntro");
				SetupWaterEncounterIntroPatrol();
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Agent_SetSensesActive("Wraith_BottomFloor_1", true);
				Wraith_SetCallback_Alerted("Wraith_BottomFloor_1", "OnWraithAlerted_CancelWaterEncounterIntro");
				
				Wraith_SetSpotlightOn("Wraith_BottomFloor_1", true);
				Wraith_SetSpotlightColor("Wraith_BottomFloor_1", "alert");
				Wraith_TurnSpotlightToPos("Wraith_BottomFloor_1", Map_GetEntity("Target_WaterEncounter_LookAt_1").GetPosition(), true);
			}
			else if (Sequence_DoStepAndWait(5.0))
			{
				Wraith_SetSpotlightMovement_SidewaysEight("Wraith_BottomFloor_1", 1, 0.2, 0.05);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Wraith_Mode_Set("Wraith_BottomFloor_1", eWraithMode_WraithPatrol, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void SetupWaterEncounterIntroPatrol()
		{
			// set up patrol
			Wraith_ModeWraithPatrol_ClearNodes("Wraith_BottomFloor_1");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_18");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_103");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_85");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_20");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_18");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_53");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_209");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_194");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_103");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_18");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_20");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_90");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_78");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_55");
			Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_20");
			
			Wraith_ModeWraithPatrol_Setup("Wraith_BottomFloor_1", false, false);
			
			Wraith_ModeWraithPatrol_SetBurstTime("Wraith_BottomFloor_1", 20);
			Wraith_ModeWraithPatrol_SetLookAroundTime("Wraith_BottomFloor_1", 60);
			Wraith_Mode_Set("Wraith_BottomFloor_1", eWraithMode_WraithPatrol, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartWaterEncounterMusic(const tString &in asTimer)
		{
			Music_Play("A2_3_6_GhoulNestEvent_Alt.ogg", 0.6, true, eMusicPrio_SceneAmb);
			Music_Play("A2_2_5_Soldier_Alert.ogg", 0.5, false, eMusicPrio_MinorEvent);
		}
		
		//-------------------------------------------------------
		
		void OnWraithAlerted_CancelWaterEncounterIntro(const tString &in asEntityName)
		{
			Agent_SetSensesActive("Wraith_BottomFloor_1", true);
			SequenceStates_Stop("Seq_WaterEncounterIntro");
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_ResumeWaterEncounterIntro(const tString &in asEntity)
		{
			Wraith_CommandCustom_Execute("Wraith_BottomFloor_1", true);
			SequenceStates_Resume("Seq_WaterEncounterIntro");
		}
		
		//-------------------------------------------------------
		
		int mlPlatformAreaCount = 0;
		bool OnCollide_Player_EnterPlatformArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlPlatformAreaCount += alState;
			
			if (mlPlatformAreaCount >= 1) Player_SetMapDeepShadow(2.0f);
			else if (mlPlatformAreaCount == 0) Player_SetMapDeepShadow(1.0f);
			
			if (mlWaterEncounterStage != 1) return true;
			
			if (mlPlatformAreaCount == 1)
			{
				float fDelay = 0;
				if (Map_TimerExists("WraithPlatformCooldown")) fDelay = 3;
				
				Map_RemoveTimer("Timer_StopWraithPlatform");
				Map_RemoveTimer("Timer_StartWraithPlatform");
				Map_AddTimer("Timer_StartWraithPlatform", fDelay, "OnTimer_StartWraithPlatform");
				
				Map_RemoveTimer("WraithPlatformCooldown");
				Map_AddTimer("WraithPlatformCooldown", 4, "");
			}
			else if (mlPlatformAreaCount == 0)
			{
				float fDelay = 0;
				if (Map_TimerExists("WraithPlatformCooldown")) fDelay = 3;
				
				Map_RemoveTimer("Timer_StartWraithPlatform");
				Map_RemoveTimer("Timer_StopWraithPlatform");
				Map_AddTimer("Timer_StopWraithPlatform", fDelay, "OnTimer_StopWraithPlatform");
				
				Map_RemoveTimer("WraithPlatformCooldown");
				Map_AddTimer("WraithPlatformCooldown", 4, "");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartWraithPlatform(const tString &in asTimer)
		{
			cLux_AddDebugMessage("START WRAITH");
			Seq_StartWraithPlatformSection("");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopWraithPlatform(const tString &in asTimer)
		{
			cLux_AddDebugMessage("STOP WRAITH");
			Wraith_CommandDash_Execute("Wraith_BottomFloor_1", Map_GetEntity("Target_WraithPlatform_MoveTo_3").GetPosition(), false, false, true, "");
			SetupWaterEncounterIntroPatrol();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceStartWraithPlatformSection;
		void Seq_StartWraithPlatformSection(const tString &in asTimer)
		{
			Sequence_Begin("Seq_StartWraithPlatformSection", mSequenceStartWraithPlatformSection);
			if (Sequence_DoStepAndWait(0))
			{
				Wraith_ModeGuardPosition_ClearNodes("Wraith_BottomFloor_1");
				Wraith_ModeGuardPosition_AddNode("Wraith_BottomFloor_1", "Target_WraithPlatform_LookAt_1");
				Wraith_ModeGuardPosition_AddNode("Wraith_BottomFloor_1", "Target_WraithPlatform_LookAt_2");
				Wraith_ModeGuardPosition_AddNode("Wraith_BottomFloor_1", "Target_WraithPlatform_LookAt_3");
				Wraith_ModeGuardPosition_AddNode("Wraith_BottomFloor_1", "Target_WraithPlatform_LookAt_4");
				Wraith_ModeGuardPosition_Setup("Wraith_BottomFloor_1", Map_GetEntity("Target_WraithPlatform_MoveTo_1").GetPosition(), 4, 8);
				Wraith_Mode_Set("Wraith_BottomFloor_1", eWraithMode_GuardPosition, true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlatformRock_WraithPlatformReaction(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mlWaterEncounterStage != 1) return true;
			
			if (alState == -1)
			{
				Seq_WraithPlatformReaction("");
				return false;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWraithPlatformReaction;	
		void Seq_WraithPlatformReaction(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WraithPlatformReaction", mSequenceWraithPlatformReaction);
			if (Sequence_DoStepAndWait(0.5))
			{
				Wraith_SetCallback_Alerted("Wraith_BottomFloor_1", "OnWraithAlerted_CancelPlatformReaction");
				Wraith_CommandCustom_Execute("Wraith_BottomFloor_1", true);
				Wraith_SetHearing("Wraith_BottomFloor_1", false);
				Sound_CreateAtEntity("WraithHearsRock", "creatures/vocalisations/creature/wraith/hears_a_sound", "Wraith_BottomFloor_1");
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Wraith_SetSpotlightOn("Wraith_BottomFloor_1", true);
				Wraith_SetSpotlightColor("Wraith_BottomFloor_1", "alert");
				Wraith_TurnSpotlightToPos("Wraith_BottomFloor_1", Map_GetEntity("Target_WraithPlatform_LookAtPlatform_1").GetPosition(), true);
				CharMover_TurnToEntity("Wraith_BottomFloor_1", "Target_WraithPlatform_LookAtPlatform_1");
			}
			else if (Sequence_DoStepAndWait(5))
			{
				Wraith_SetHearing("Wraith_BottomFloor_1", true);
				Wraith_SetSpotlightMovement_SidewaysEight("Wraith_BottomFloor_1", 1, 0.2, 0.05);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Wraith_Mode_Set("Wraith_BottomFloor_1", eWraithMode_GuardPosition, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnCommandComplete_WraithLookAtPlatform(const tString &in asEntity)
		{
			SequenceStates_Resume("Seq_WraithPlatformReaction");
		}
		
		//-------------------------------------------------------
		
		void OnWraithAlerted_CancelPlatformReaction(const tString &in asEntityName)
		{
			Wraith_SetHearing("Wraith_BottomFloor_1", true);
			SequenceStates_Stop("Seq_WraithPlatformReaction");
		}
		
		//-------------------------------------------------------
		
		int mlWraithNoHearingAreaCount = 0;
		bool OnCollide_Player_NoWraithHearing(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlWraithNoHearingAreaCount += alState;
			if (mlWraithNoHearingAreaCount <= 0)
			{
				Wraith_SetHearing("Wraith_BottomFloor_1", true);
			}
			else
			{
				Wraith_SetHearing("Wraith_BottomFloor_1", false);
			}
			return true;
		}

		//-------------------------------------------------------
		
		bool OnCollide_Player_StartElevatorStage(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_StartElevatorStage("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceStartElevatorStage;
		void Seq_StartElevatorStage(const tString &in asTimer)
		{
			Sequence_Begin("Seq_StartElevatorStage", mSequenceStartElevatorStage);
			if (Sequence_DoStepAndPause(0))
			{
				cLux_AddDebugMessage("[Map] Start elevator stage");
				
				Map_RemoveTimer("Timer_StartWraithPlatform");
				Map_RemoveTimer("Timer_StopWraithPlatform");
				
				mlWaterEncounterStage = 2;
				FearHandler_SetPermaFailRespawnArea("PermaFail_Water_2");
				mlPermaFailStage = eFactoryDPermaFailStage_Elevator;
				
				Agent_SetSensesActive("Wraith_BottomFloor_1", false);
				Wraith_CommandDash_Execute("Wraith_BottomFloor_1", Map_GetEntity("Target_ElevatorStage_MoveTo_2").GetPosition(), true, false, true, "OnCommandComplete_ResumeStartElevatorStage");
				
				if (Entity_IsActive("Wraith_BottomFloor_1") == false) Seq_StartElevatorPatrol("");
				
				SetupElevatorStagePatrol();
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Wraith_CommandCustom_Execute("Wraith_BottomFloor_1", true);
				
				Wraith_SetHearing("Wraith_BottomFloor_1", true);
				Agent_SetSensesActive("Wraith_BottomFloor_1", true);
				Wraith_SetCallback_Alerted("Wraith_BottomFloor_1", "OnWraithAlerted_CancelElevatorStageIntro");
				
				Wraith_SetSpotlightOn("Wraith_BottomFloor_1", true);
				Wraith_SetSpotlightColor("Wraith_BottomFloor_1", "alert");
				Wraith_TurnSpotlightToPos("Wraith_BottomFloor_1", Map_GetEntity("Target_ElevatorStage_LookAt_1").GetPosition(), true);
				CharMover_TurnToEntity("Wraith_BottomFloor_1", "Target_ElevatorStage_LookAt_1");
			}
			else if (Sequence_DoStepAndWait(5.0))
			{
				Wraith_SetSpotlightMovement_SidewaysEight("Wraith_BottomFloor_1", 1, 0.2, 0.05, true, Map_GetEntity("Target_ElevatorStage_LookAt_1").GetPosition());
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Wraith_Mode_Set("Wraith_BottomFloor_1", eWraithMode_WraithPatrol, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnWraithAlerted_CancelElevatorStageIntro(const tString &in asEntityName)
		{
			Agent_SetSensesActive("Wraith_BottomFloor_1", true);
			SequenceStates_Stop("Seq_StartElevatorStage");
		}
		
