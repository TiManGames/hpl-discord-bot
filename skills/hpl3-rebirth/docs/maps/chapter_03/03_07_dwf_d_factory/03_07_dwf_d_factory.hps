				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_18");
				
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_103");
