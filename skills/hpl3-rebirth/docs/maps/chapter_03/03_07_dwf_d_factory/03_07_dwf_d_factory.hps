				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_18");
				
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_20");
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_70");
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_63");
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_103");
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_204");
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_66");
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_20");
				
				Wraith_ModeWraithPatrol_SetBurstTime("Wraith_BottomFloor_1", 20);
				Wraith_ModeWraithPatrol_SetLookAroundTime("Wraith_BottomFloor_1", 60);
				
				Wraith_ModeWraithPatrol_Setup("Wraith_BottomFloor_1", false, false);
				
				Wraith_Mode_Set("Wraith_BottomFloor_1", eWraithMode_WraithPatrol, false);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Wraith_CommandCustom_Execute("Wraith_BottomFloor_1", true);
				Wraith_SetHearing("Wraith_BottomFloor_1", true);
				SetWraithSpotlightMask("Wraith_BottomFloor_1", "Light_LightBoxReference");
				CharMover_SetSpeedMul("Wraith_BottomFloor_1", 1);
				CharMover_TurnToEntity("Wraith_BottomFloor_1", "Target_BottomFloorIntro_Look_1", "");
				
				Wraith_SetSpotlightOn("Wraith_BottomFloor_1", true);
				Wraith_SetSpotlightColor("Wraith_BottomFloor_1", "alert");
				Wraith_TurnSpotlightToPos("Wraith_BottomFloor_1", Map_GetEntity("Target_BottomFloorIntro_Look_1").GetPosition(), true, true, 3);
				Sound_CreateAtEntity("Wraith_BottomFloor_1", "creatures/vocalisations/creature/wraith/wraith_spot", "Wraith_BottomFloor_1", 0, false, 1, 10, 40);
				
				Music_Play("A2_3_6_GhoulNestEvent_Alt.ogg", 0.5, true, eMusicPrio_SceneAmb);
			}
			else if (Sequence_DoStepAndWait(5))
			{
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("Wraith_BottomFloor_1", 0.75, 0.35, 0.05, "Target_BottomFloorIntro_Look_1", true, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Wraith_StopSpotlightMovement("Wraith_BottomFloor_1");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Wraith_SetSpotlightOn("Wraith_BottomFloor_1", false);
				Wraith_SetCallback_Alerted("Wraith_BottomFloor_1", "");
				Wraith_CommandFlyToNode_Execute("Wraith_BottomFloor_1", "Target_BottomFloorIntro_Fly_2", true, 1, false, "OnMoveEnd_DisableBottomFloorHearing");
				
				Wraith_SetCallback_BeamCenterSeen("Wraith_BottomFloor_1", "");
			}
			Sequence_End();
		}
		
