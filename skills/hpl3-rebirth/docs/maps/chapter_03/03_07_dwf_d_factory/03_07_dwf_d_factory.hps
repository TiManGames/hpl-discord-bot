				Wraith_CommandFlyToNode_Execute("Wraith_BottomFloor_1", "Target_BottomFloorIntro_Fly_1", true, 1, false, "OnCommandEnd_ResumeBottomFloorIntro");
				
				// set up patrol
				Wraith_ModeWraithPatrol_ClearNodes("Wraith_BottomFloor_1");
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_18");
				Wraith_ModeWraithPatrol_AddNode("Wraith_BottomFloor_1", "PathNode_Bottom_53");
