	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 13 *Take the elevator up to the rift and walk through it*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are used by many events in Scene X here.*/

		//-------------------------------------------------------

		/*Put any functions that are used in more than one event in Scene X here.*/

		//-------------------------------------------------------

		//} END General	

		/////////////////////////////////////////
		// Event A *Use the elevator to get up to the RIFT and have a moment of reflection*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbPlayerOnElevator = false;
		bool mbElevatorMoving = false;
		float mfElevatorMovingTimer = 0;
		bool mbElevatorAtTop = false;
		int mlElevatorState = -1;
		tID m_idElevator = tID_Invalid;
		tID m_idElevatorMovementSound = tID_Invalid;
		
		//-------------------------------------------------------
		
		void InitElevator()
		{
			SetButtonColor("Indicator_ElevatorLever", mButtonColor_White);
			m_idElevator = Map_GetEntity("Elevator").GetID();
		}
		
		//-------------------------------------------------------
		
		void UpdateElevator(float afTimeStep)
		{
			if (mbElevatorMoving)
			{
				mfElevatorMovingTimer += afTimeStep;
				if (mfElevatorMovingTimer >= 1.0f)
				{ 
					iLuxEntity@ pEnt = cLux_ID_Entity(m_idElevator);
					cSoundEntity@ pMovement = cLux_ID_SoundEntity(m_idElevatorMovementSound);
					if (pMovement !is null) pMovement.SetPosition(pEnt.GetPosition());
					
					Debug_DrawSphere(pMovement.GetWorldPosition(), 0.2f, cColor_Red);
					
					if (cMath_Abs(pEnt.GetMainBody().GetLinearVelocity().y) <= 0.1f)
					{
						if (mlElevatorState != 0)
						{
							mbElevatorMoving = false;
							Sound_Stop("ElevatorSmallMovement", 2.0f);
							Sound_CreateAtEntity("ElevatorSmallStop", "03_07_dw_factory/elevator_small/end", "Elevator");
							Effect_Shake_Start(0.01, 0.4, 0, 0.3);
						}
						
						if (mlElevatorState == -1)
						{
							Lamp_SetFlickerActive("Lamp_ElevatorLever", true);
							Lamp_SetLit("Lamp_ElevatorLever", true, true);
							Lever_SetStuckState("Lever_Elevator", 0, true);
						}
					}
				}
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Elevator_Top(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Entity_SetActive("Rift_2", false);
				Amulet_StartTracking(false, "Rift_3");
				FearHandler_SetPermaFailRespawnArea("PermaFail_Rift");
				mlPermaFailStage = eFactoryDPermaFailStage_Rift;
				Entity_SetActive("Trigger_DeathFall", true);
				mlElevatorState = 1;
			}
			else mlElevatorState = 0;
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Elevator_Bottom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) mlElevatorState = -1;
			else mlElevatorState = 0;
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ExitLevel(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sketchbook_CompleteIdea("cross_factoryrift");
			Sketchbook_NewIdeasPage();
			Effect_Fade_Out(0.5);
			Map_AddTimer("Timer_ChangeLevel", 0.5, "OnTimer_ChangeLevel");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ChangeLevel(const tString &in asTimer)
		{
			Map_ChangeMap("03_07_dw_factory_dream.hpm", "Start_Begin", "", "", false);
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_FactoryElevator(const tString &in asEntity, int alState)
		{
			if (alState == -1)
			{
				mbElevatorMoving = true;
				mfElevatorMovingTimer = 0;
				
				FogArea_SetVisible("FogArea_1", false);
				cLux_GetCurrentMap().GetWorld().SetFogUseSkybox(true);
				cLux_GetCurrentMap().GetWorld().SetFogApplyAfterFogAreas(true);
				
				Pregnancy_SetWhispering(false);
				
				Prop_MoveLinearTo("Elevator", "Target_Elevator_1", 0.35, 1.4, 2, true, "");
				
				Sound_CreateAtEntity("ElevatorSmallStart", "03_07_dw_factory/elevator_small/start", "Elevator");
				
				cSoundEntity@ pMovementLoop = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("ElevatorSmallMovement", "03_07_dw_factory/elevator_small/loop", false);
				if (pMovementLoop !is null)
				{
					pMovementLoop.SetScriptableIsSaved(true);
					m_idElevatorMovementSound = pMovementLoop.GetID();
				}
				
				Sound_CreateAtEntity("ElevatorSmallMovement", "03_07_dw_factory/elevator_small/loop", "Elevator", 0, true);
				
				Lamp_SetFlickerActive("Lamp_ElevatorLever", false);
				Lamp_SetLit("Lamp_ElevatorLever", false, true);
				
				Lever_SetStuckState("Lever_Elevator", -1, true);
				
				Agent_SetSensesActive("Wraith_BottomFloor_1", false);
				Agent_SetSensesActive("Wraith_BottomFloor_2", false);
				
				Prop_MoveLinearTo("ElevatorGrating", "Target_ElevatorGrating_1", 4.0, 6.0, 0, true, "OnMoveEnd_ElevatorGrate");
				Sound_CreateAtEntity("ElevatorDoorClose", "level_entity_shared/doors/DW_elevator/start", "ElevatorGrating");
				
				Entity_SetActive("Blocker_ElevatorGrate", true);
				
				Entity_SetActive("Trigger_RemindGoalDialogue", false);
				
				Prop_RotateToSpeed("ElevatorGear_1", 1, 5, cVector3f_Right, false, "");
				
				Effect_Shake_Start(0.01, 0.4, 0, 3.0);
			}
		}
		
		//-------------------------------------------------------
		
		void OnMoveEnd_ElevatorGrate(const tString& in asPropName)
		{
			Sound_CreateAtEntity("ElevatorDoorCloseEnd", "level_entity_shared/doors/DW_elevator/stop", "ElevatorGrating");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Elevator_PastOpening(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				if (mbPlayerOnElevator == false)
				{
					Prop_StopMovement("Elevator");
					Map_AddTimer("Timer_ElevatorReturn", 0.5, "OnTimer_ElevatorReturn");
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ElevatorReturn(const tString &in asTimer)
		{
			Prop_MoveLinearTo("Elevator", "Target_Elevator_0", 0.2, 1.4, 1, false, "");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlayerOnElevator(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbPlayerOnElevator = alState == 1;
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlayerBellowElevator(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 && Map_GetEntity("Elevator").GetMainBody().GetLinearVelocity().y <= -1.2f)
			{
				FearHandler_TriggerPermaFail(false, "ElevatorCrush", true);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_LiftRisesDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Pregnancy_SetWhispering(false);
			Voice_Play("Dialogue_LiftRises");
			Music_Stop(4, eMusicPrio_SceneAmb);
			
			Wraith_SetVolumeMul("Wraith_BottomFloor_1", 0);
			Wraith_SetVolumeMul("Wraith_ElevatorPatrol", 0);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_TopOfLiftDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Dialogue_TopOfLift");
			
			Wraith_CommandDash_Execute("Wraith_BottomFloor_1", Map_GetEntity("Target_WraithDisappear_Water_1").GetPosition(), true, true, true);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_DeathFall(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
//				FearHandler_TriggerPermaFail(false, "", true);
				FearHandler_TriggerPermaFail_Fall();
			}
			return true;
		}
		
		//-------------------------------------------------------

		//} END Event A *Use the elevator to get up to the RIFT and have a moment of reflection*
		
		/////////////////////////////////////////
		// Event B *Enter the RIFT*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool OnCollide_Player_TowerLightning(const tString &in asParent, const tString &in asChild, int alState)
		{
			DarkWorldLightning(2, Map_GetEntity("Widget_ThunderLightning").GetMatrix().GetTranspose().GetForward(), 0);
			Map_AddTimer("Timer_EnableLightning", 10, "OnTimer_EnableLightning");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableLightning(const tString &in asTimer)
		{
			mlDWLightning_NoAreaCount = 0;
			Entity_SetActive("Trigger_NoLightning_1", false);
		}
		
		//-------------------------------------------------------
		
		void OnRiftStage_RuinsEntranceNormal(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_FactoryVistaDialogue(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_FactoryVista");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_RiftReactionDialogue(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_RiftReaction");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_PortalMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_Play("A2_3_8_Portal_Discover", 0.2, false, eMusicPrio_MinorEvent);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnColide_AmuletHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) Map_AddTimer("Timer_CheckAmuletHint", 0, "OnTimer_CheckAmuletHint");
			else Map_RemoveTimer("Timer_CheckAmuletHint");
			return true;
		}
		
		//-------------------------------------------------------
		
		float mfAmuletHintCounter = 0;
		void OnTimer_CheckAmuletHint(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.2, 0.4);
			if (Amulet_IsHeld())
			{
				Entity_SetActive("Trigger_AmuletHintArea", false);
			}
			
			mfAmuletHintCounter += fNext;
			if (mfAmuletHintCounter >= 13)
			{
				Hint_ShowHint_Hold("Hints", "HintAmulet", true, 2, false);
				Entity_SetActive("Trigger_AmuletHintArea", false);
				return;
			}
			
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------

		//} END Event B *Enter the RIFT*

	//} END SCENE 13
 
}