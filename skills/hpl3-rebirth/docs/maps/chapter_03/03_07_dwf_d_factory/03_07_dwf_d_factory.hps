	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		//sky rotation
		cVector3f vRot = cVector3f(0, cMath_ToRad(143), 0);
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);

		cLux_ClearAllMapSaveData();
		Game_AutoSave();

		//PlayerBody_SetModel("player.ent");
		PlayerBody_SetActive(true);
		FearHandler_SetPermaFailEnabled(true);
        Heat_SetActive(false);
		Player_SetAutoTeleportWhenBelowAltitude(40);
//		Map_Preload("03_07_dw_factory_dream.hpm");
		
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(15);
		
		/////////////////////////
		// Inventory
		if (cLux_ScriptDebugOn())
		{
			Item_AddToInventory("ShadowFleshCanister");
			
			if (ItemType_IsInInventory("Lantern") == false)
			{
				Item_AddToInventory("Lantern");
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
				Item_AddToInventory("HerbertOil");
				Item_SetContent(ItemType_GetFirstInInventory("HerbertOil"), "Oil", 10);
				Item_AddToInventory("Matchbook");
				Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
				Item_AddToInventory("ShadowFleshVial");
				Item_SetContent(ItemType_GetFirstInInventory("ShadowFleshVial"), "ShadowFleshPowder", 4);
			}
		}
		else
		{
			Pregnancy_SetBabyTalkRoomSpecificSubject("BabyTalk_SafeRoom", true);
			Effect_Fade_Out(0);
			Map_AddTimer("Timer_LevelFadeIn", 1.5, "OnTimer_LevelFadeIn");
		}
		
		///////////////////
		// Vitae access setup
		SetupAccessPointUvAnimation("VitaeAccessPoint_1");
		array<cMeshEntity@> vOut;
		Map_GetDecalArray("Decal_VitaeValvePipe_*", vOut);
		for (int i = 0; i < vOut.size(); ++i)
		{
			cMeshEntity@ pMeshEnt = vOut[i];
			pMeshEnt.SetCoverageAmount(0.f);
			
			int lPos = cString_GetFirstStringPos(pMeshEnt.GetName(), "Crack");
			int lLength = lPos == 25 ? 32 : 34;
			
			tString sName = cString_Sub(pMeshEnt.GetName(), 0, lLength);
			if (m_setPipeCracks.Exists(sName) == false)
				m_setPipeCracks.Add(sName);
		}
		ShadowFlesh_SetupDecals("Decal_ShadowFlesh_*");
		
		Light_SetVisible("DebugLight*", false);
		Light_SetVisible("Light_Box_Debug*", false);
		
		/////////////////////////
		// System setup
		Player_SetMapDeepShadow(1.0f);
		FearHandler_SetPermaFailRespawnArea("PermaFail_MiddleFloor");
		Blackboard_AddWraithBillboards("WraithBillboard");
		FearHandler_SetDifficultyMul(0.6f);
		FearHandler_ForceUnderwaterFear(true);
		RiftHandler_SetAllowHint(false);
		Amulet_StartTracking(true);
		if (cLux_ScriptDebugOn() == false) Amulet_StartTracking(true, "Rift_2");
		
		Player_SetNightVisionBrightness(3.5);
		
		Entity_SetActive("RiftEnding_Open*", false);
		
//		cLux_GetPlayer().SetCollideCallbacksActive(false);
		
//		FearHandler_SetActive(false);
		
		/////////////////////////
		// Init scenes
		InitElevator();
		InitTopFloorSafeRoom();
		InitMiddleFloor();
		InitDarkWorldLightning();		
	}

