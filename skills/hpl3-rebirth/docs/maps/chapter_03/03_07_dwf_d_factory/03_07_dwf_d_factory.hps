		bool mbElevatorPatrolActive = false;
		cSequenceStatesData mSequenceStartElevatorPatrol;
		void Seq_StartElevatorPatrol(const tString &in asTimer)
		{
			Sequence_Begin("Seq_StartElevatorPatrol", mSequenceStartElevatorPatrol);
			if (Sequence_DoStepAndWait(0))
			{
				mbElevatorPatrolActive = true;
				
				Entity_SetActive("Wraith_ElevatorPatrol", true);
				Agent_SetSensesActive("Wraith_ElevatorPatrol", false);
				
//				Wraith_SetBillboardRange("Wraith_ElevatorPatrol", cVector2f(1, 2), cVector2f(100, 110));
				
				Wraith_ModeFlyPatrol_ClearNodes("Wraith_ElevatorPatrol");
				for (int i = 1; i <= 8; ++i) Wraith_ModeFlyPatrol_AddNode("Wraith_ElevatorPatrol", "Target_ElevatorPatrol_" + i);
				
				Wraith_ModeFlyPatrol_ClearLookAtFields("Wraith_ElevatorPatrol");
				for (int i = 1; i <= 3; ++i) Wraith_ModeFlyPatrol_AddLookAtfield("Wraith_ElevatorPatrol", "Target_LookAtField_ElevatorPatrol_" + i);
				
				Wraith_ModeFlyPatrol_SetUseRandomNodes("Wraith_ElevatorPatrol", true);
//				Wraith_ModeFlyPatrol_SetPlayerGoalDirection("Wraith_ElevatorPatrol", "Target_Goal_BottomFloorWraith_1");
				
				Wraith_ModeFlyPatrol_SetSweepRange("Wraith_ElevatorPatrol", cVector2f(3,5));
				
				Wraith_ModeFlyPatrol_Setup("Wraith_ElevatorPatrol", false);
				Wraith_Mode_Set("Wraith_ElevatorPatrol", eWraithMode_FlyPatrol, true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
			}
			Sequence_End();
		}
		
