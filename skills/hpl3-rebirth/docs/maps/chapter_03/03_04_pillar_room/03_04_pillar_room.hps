		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayDossierMicroflash(const tString &in asTimer)
		{
			if (Voice_SceneInvolvingCharacterIsActive("Player") || Sketchbook_IsMicroflashActive())
				return;
			
			Sketchbook_Microflash(asTimer);
		}
	
	//} END HANKS NOTES

}