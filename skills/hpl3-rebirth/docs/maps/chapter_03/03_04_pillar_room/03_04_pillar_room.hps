	//-------------------------------------------------------

	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("DEAD : SOURCE = " + asSource);
		// return false for default behaviour
		
		if (asSource == "Ghoul_AlchemistChambers")
		{
			DeathScenario_OnDeath_PlayerLosesConfigNote(asSource);
			Death_SetRespawnCallback("DeathScenario_OnRespawn_PlayerLosesConfigNote");
			return true;
		}
		
		return false;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{
		// return false for default behaviour (fadeout and death area)
		return false;
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			Player_Teleport("Start_AlchemistChambers_CorpseRoom");
			Entity_SetActive("Trigger_ActivateGhoulAlchemistChambers", true);
			Entity_SetActive("Trigger_DeactivateGhoulAlchemistChambers", true);
		}
		if(alAction == eAction_Test2)
		{
			Seq_PowerUpPillars("");
			cScript_SetGlobalVarBool("TTH_PillarRoomComplete", true);
		}
		if(alAction == eAction_Test3)
		{
			Seq_PowerUpPillars("");
			cScript_SetGlobalVarBool("TTH_VitaeCanisterInserted", true);
			//mbOverwriteSolution = true;
		}
		if (alAction == eAction_Test4)
		{
			//iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName("pillar_right");
			Radio_StartCall("Dialogue_CallDoc", "OnEndOfVoice_RadioAway", 5.f, "Radio_Doctor;Radio_Yasmin");
			Map_AddTimer("Timer_PutAwayRadio", 32.f, "OnTimer_PutAwayRadio");
		}

		if (alAction == eAction_Test5)
		{
			Entity_SetActive("CorpsePose_2",false);
			Entity_SetActive("Corpse_Old",false);
		}
		if (alAction == eAction_Test6)
		{
			Prop_MoveLinearTo("ConfigDeviceSelector","PosArea_ConfigDeviceHide",0.5,0.3,1,false,"");
			Prop_MoveLinearTo("pillar_room_configuration_device*","PosArea_ConfigDeviceHide",0.5,0.3,1,false,"");
			Entity_SetEffectsActive("rune_*", false, false);
			Prop_MoveLinearTo("rune_*","PosArea_ConfigDeviceHide",1,0.3,1,false,"");
		    Entity_PlayAnimation("configuration_device_iris", "closing", 0.1f, false, true);
		}
		if (alAction == eAction_Test7)
		{
			//mbSequencePillars = true;
			FearHandler_TriggerPermaFail();
		}
		if (alAction == eAction_Test8)
		{
			Sound_CreateAtEntity("Sound_PlateSolved","03_04_pillar_room/config_device/plate_solve_energy_loop","ConfigRotator");
		}
		
		//////////////////////////////
		// Permafail Test
		if (alAction == eAction_Test9)
		{
			FearHandler_SetPermaFailStruggleEnabled(false);
			FearHandler_SetPermaFailEnabled(true);
			FearHandler_FadeLevelTo(1.f, 1.f);
			FearHandler_SetForcedAddFearRate(0.5f, 10.f, false, -1.f, -1.f, 0.f);
		}
		if (alAction == eAction_TestPlus)
		{
			float lCurrentFearLevel = FearHandler_GetLevel();
			FearHandler_FadeLevelTo(lCurrentFearLevel+0.1f,0,true);
		}
		if (alAction == eAction_TestMinus)
		{
			//Pregnancy_SetBabyKicksEnabled(true);
			Pregnancy_DoBabyKick(true);	
			//Map_AddTimer("Timer_DoBabyNamingSeq", 2.5f, "OnTimer_DoBabyNamingSeq");
		}
	}

