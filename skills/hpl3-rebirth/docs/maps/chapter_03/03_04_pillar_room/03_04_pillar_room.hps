		//{//////////////////////////////////////
	
		//-------------------------------------------------------
	
		/*Put any variables that are only used in Scene 4, Event E here.*/
	
		//-------------------------------------------------------
	
		/*Put any functions that are only used in Scene 4, Event E here.*/
		
		void DeathScenario_OnDeath_PlayerLosesConfigNote(const tString &in asSource)
		{
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			Agent_SetSensesActive(msMonster,false);
//			Ghoul_ForceIdle(msMonster,-1);
			Death_PickRespawnArea("DeathArea_GhoulAlchemistChambers");
			Effect_Fade_Out(1.0f);
			Map_AddTimer("Timer_DelayedRespawn",3.0f,"OnTimer_DelayedRespawn");
		}
		
		//-------------------------------------------------------
		
		bool DeathScenario_OnRespawn_PlayerLosesConfigNote(const tString &in asSource)
		{
			Music_Stop(1, eMusicPrio_SceneAmb);
			
			while (Map_TimerExists("Timer_GhoulAlchemistChambers"))
				Map_RemoveTimer("Timer_GhoulAlchemistChambers");
						
			Entity_SetActive(msMonster, false);
			Entity_SetActive("Trigger_ActivateGhoulAlchemistChambers", false);

			//AlechemistChambers_SetupAfterDeath();
			return false;
		}
		
		//-------------------------------------------------------
		
		void AlechemistChambers_SetupAfterDeath()
		{
			// Vars
			//Sketchbook_RemoveNote("ConfigNote");	
			mbLostNote = true;
		
			// Objects
			Entity_SetActive("Corpse_1",false);
			Entity_SetActive("Corpse_2",true);
			Entity_SetActive("ConfigNote_1",false);
			Entity_SetActive("ConfigNote_2",true);
			
			// Triggers
			Entity_SetActive("Trigger_ActivateGhoulIntro",false);	// Purely debug
			
			// Fog
			FogArea_SetVisible("FogArea_DeathScenario",true);
			
			// Lights
			Light_SetBrightness("PointLight_57",0);
			Light_SetBrightness("PointLight_59",0);
			Light_SetBrightness("BoxLight_19",0);
			Light_SetBrightness("BoxLight_20",0);
			Light_SetBrightness("BoxLight_21",0);
			Light_SetBrightness("BoxLight_27",0);
			Light_SetBrightness("SpotLight_20",0);
		}
		
		//-------------------------------------------------------
		
		void OnPlayerLookAt_ChangeCorpsePose(const tString &in asEntity, int alState)
		{
			Entity_SetActive("Corpse_1", false);
			Entity_SetActive("Corpse_2", true);
		}
		
		//-------------------------------------------------------
		
		bool OnPlayerCollide_ResetAlchemistChambers(const tString &in asParent, const tString &in asChild, int alState)
		{
			AlechemistChambers_Reset();
			return false;
		}
				
		//-------------------------------------------------------
		
		void AlechemistChambers_Reset()
		{
			// Fog
			FogArea_SetVisible("FogArea_DeathScenario",false);
			// Lights
			Light_SetBrightness("PointLight_57",15);
			Light_SetBrightness("PointLight_59",10);
			Light_SetBrightness("BoxLight_19",15);
			Light_SetBrightness("BoxLight_20",4);
			Light_SetBrightness("BoxLight_21",4);
			Light_SetBrightness("BoxLight_27",20);
			Light_SetBrightness("SpotLight_20",2);
		}
		
		//-------------------------------------------------------
	
		//} END Event E
	
		/////////////////////////////////////////
		// Event F - RETURN TO PILLAR ROOM WITH CONFIG DEVICE DIAGRAM AND INPUT THE SYMBOLS
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
	
		/*Put any variables that are only used in Scene 4, Event F here.*/
		
		bool mbOverwriteSolution = false;	//DEBUG! Remove when done!
		bool mbPillarsSolved = false;
		bool mbConfigDeviceSolved = false;
		bool mbVitaeCannisterSolved = false;
	
		//-------------------------------------------------------
	
		/*Put any functions that are only used in Scene 4, Event F here.*/
		
		bool OnCollide_PressurePlate(const tString &in asParent, const tString &in asChild, int alState)
		{
			
			tString sPlate = "pressureplate_"+cString_GetNumericSuffixInt(asParent);
			
			if (alState == 1)
			{
				Entity_SetEffectsActive(sPlate,true,true);
				Effect_Rumble_Start(cMath_RandRectf(0.01f,0.5f),0.2f,0,0);
				//Sound_CreateAtEntity("Sound_Press","level_entity_shared/doors/tin_hinan_lock_door/TH_lock_door_slide_min_max",sPlate);
				Sound_CreateAtEntity("Sound_StarMapStart", "03_04_pillar_room/starmap/starmap_start", "Sound_Starmap");
				Sound_CreateAtEntity("Sound_StarMapLoop", "03_04_pillar_room/starmap/starmap_loop", "Sound_Starmap");				
				Lamp_SetLit("starmap_lamp",true, true);
				cLux_GetPlayer().AutomoveCharBodyTo(100.f, 4.f, 1.f, Map_GetEntity("PosArea_ConfigDevice").GetPosition());
			}
			
			if (alState == -1)
			{
				cLux_GetPlayer().StopAutomoveCharBody();
				//Sound_CreateAtEntity("Sound_Press","level_entity_shared/doors/tin_hinan_lock_door/TH_lock_door_slide_min_max",sPlate);
				Sound_Stop("Sound_StarMapLoop", 1.0f);
				Sound_CreateAtEntity("Sound_StarMapStop", "03_04_pillar_room/starmap/starmap_stop", "Sound_Starmap");
				Entity_SetEffectsActive(sPlate,false,true);
				Lamp_SetLit("starmap_lamp",false, true);
			}
				
			return true;
		}
		
		//-------------------------------------------------------
	
		void EvaluateSolution(float afDelay)
		{
			Map_RemoveTimer("Timer_EvaluateSolution");
			Map_AddTimer("Timer_EvaluateSolution", afDelay, "OnTimer_EvaluateSolution");
		}
		
		//-------------------------------------------------------
		
		int mlConfigAttempts = 0;
		int mlConfigAttemptsMax = 3;
		
		void OnInteract_Player_EvaluateSolution(const tString &in asEntity)
		{
			//Voice_PlayDelayed("Dialogue_PillarsAttempts",0.3f);
			mbPillarsSolved = Evaluate_Pillars();
			mbConfigDeviceSolved = Evaluate_ConfigDevice();
			Debug_Log("PILLARS SOLVED: 			"+mbPillarsSolved);
			Debug_Log("CONFIG DEVICE SOLVED: 	"+mbConfigDeviceSolved);
			
			if (mbOverwriteSolution)
			{
				mbPillarsSolved = true;
				mbConfigDeviceSolved = true;
			}
			
			if (mbConfigDeviceSolved)
			{
				// POSITIVE FEEDBACK
				Billboard_SetVisible("Billboard_ConfigDevice",true);
				Billboard_SetBrightness("Billboard_ConfigDevice",0.5f);
				Light_FadeTo("Light_Point_ConfigDevice", cColor(0.957,0.967,0.812,1),1,1);
				Sound_CreateAtEntity("Sound_PlateSolved","03_04_pillar_room/config_device/plate_solve_energy_loop","ConfigRotator");
				//Sound_CreateAtEntity("Sound_PlateMisaligned","03_04_pillar_room/config_device/plate_energy_misaligned","ConfigRotator");
			}
			else 
			{
				mlConfigAttempts++;
				// NEGATIVE FEEDBACK
				Light_FadeTo("Light_Point_ConfigDevice", cColor(0.955f,0.433f,0.433f,0.205f),1,0.2f);
				Map_AddTimer("Timer_ResetConfigLight",0.2f,"OnTimer_ResetConfigLight");
				Sound_Stop("Sound_PlateSolved",0.5);
				//Sound_CreateAtEntity("Sound_PlateMisaligned","03_04_pillar_room/config_device/plate_energy_misaligned","ConfigRotator");
				Billboard_SetVisible("Billboard_ConfigDevice",false);
				Billboard_SetBrightness("Billboard_ConfigDevice",0);
				
				bool bKnowsAboutPortal = cScript_GetGlobalVarBool("TTH_KnowsAboutPortal");
				
				//if (bKnowsAboutPortal == false && mbPillarsSolved == false) 
					//Voice_PlayDelayed("Dialogue_MessWithMachine",2.4f);
			}	
			
			cLux_AddDebugMessage("ATTEMPTS: "+mlConfigAttempts);
			
			if (mbConfigDeviceSolved && mbPillarsSolved)// && mbVitaeCannisterSolved)
			{
				// PUZZLE IS SOLVED
				EvaluateSolution(0.5f);
			}
			else
			{
				if (Voice_SubjectIsPlaying("Dialogue_CallDoc") == false && mlConfigAttempts >= mlConfigAttemptsMax)
				{
					cLux_AddDebugMessage("HERE");
					
					
					if (Voice_SubjectIsPlaying("Dialogue_PillarsFails") == false)
					{
						if (mbConfigDeviceSolved)
							Voice_PlayDelayed("Dialogue_PillarsFails",2.f,3);
						else
							Voice_PlayDelayed("Dialogue_PillarsFails",2.f);
					}
						
					mlConfigAttempts = 0;
					mlConfigAttemptsMax = cMath_RandRectl(3,5);
				}
					
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetConfigLight(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Sound_PlateMisaligned","03_04_pillar_room/config_device/plate_energy_misaligned","ConfigRotator");
			Light_FadeTo("Light_Point_ConfigDevice", cColor(0,0,0,0),1,1);
			return;
		}
	
		//-------------------------------------------------------
		
		bool Evaluate_Pillars()
		{
			if (Entity_GetVarInt("pillar_middle", "currentRotation")!=1 ||	Entity_GetVarInt("pillar_right", "currentRotation")!=2)
			{
				//Sketchbook_AddSketchImageByPage("tth_hint_pillars", "tth_full", true, "tth_hint_pillars_checked");
				return false;
			}
			else 
			{
				//Sketchbook_AddSketchImageByPage("tth_hint_pillars_checked", "tth_full", true, "tth_hint_pillars");
				return true;
			}
		}
		
		//-------------------------------------------------------
		
		bool Evaluate_ConfigDevice()
		{
			// Check config device rotation
			if (cMath_Abs(mfConfigRotationTarget) > 3.15 || 
				cMath_Abs(mfConfigRotationTarget) < 3.13)  
				{
					//Sketchbook_AddSketchImageByPage("tth_hint_codeblock", "tth_full", true, "tth_hint_codeblock_checked");
					return false;
				}
			
			// Check config device selector
			if (int(mvSelectorCoords.x) != 0 ||
				int(mvSelectorCoords.y) != 1)
				{
					//Sketchbook_AddSketchImageByPage("tth_hint_codeblock", "tth_full", true, "tth_hint_codeblock_checked");
					return false;
				}
					
			//Sketchbook_AddSketchImageByPage("tth_hint_codeblock_checked", "tth_full", true, "tth_hint_codeblock");
			return true;
		}
		
		//------------------------------------------------------- 
		
		bool mbPlayerOnConfigDevice = false;
		
		bool OnCollide_PlayerOnConfigDevice(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (cScript_GetGlobalVarBool("TTH_PillarRoomComplete") == true) return false;
			
			if (alState == -1)
			{
				mbPlayerOnConfigDevice = false;
				Light_FadeTo("starmap_red_path_light", cColor(0,0,0,0), -1, 2);
				Entity_SetEffectsActiveExt("lit_pillar_symbol_*",false,true,2,2);
				//Entity_SetActive("lit_pillar_symbol_*", false);	
			}
			else
			{
				mbPlayerOnConfigDevice = true;	
				mbPillarsSolved = Evaluate_Pillars();
				if (mbPillarsSolved)
					{
						// POSITIVE FEEDBACK
						Light_FadeTo("starmap_red_path_light", cColor(0.872,1,0.789,0), -1, 0.4f);
						Sound_CreateAtEntity("Sound_PillarMisalignedMiddle","03_04_pillar_room/pillar/pillar_misaligned","pillar_middle");
						Sound_CreateAtEntity("Sound_PillarMisalignedRight","03_04_pillar_room/pillar/pillar_misaligned","pillar_right");	
                        Entity_SetActive("lit_pillar_symbol_*", true);	
						Entity_SetEffectsActiveExt("lit_pillar_symbol_*",true,true,0.8f,2);
						//Voice_PlayDelayed("Dialogue_PillarsDone",0.6f);

						//Wheel_SetStuckState("BeltDrive_Right", 1, false);
						//Wheel_SetStuckState("BeltDrive_Mid", 1, false);				
					}
					else
					{
						// NEGATIVE FEEDBACK	
			
						int lSign = cMath_Sign(cMath_RandRectf(-1,1));
						Wheel_SetAngle("BeltDrive_Mid", cMath_ToRad(Wheel_GetCurrentAngle("BeltDrive_Mid"))+cMath_RandRectf(0.2f,0.4f)*lSign,true);
						Map_AddTimer("BeltDrive_Mid", 0.2f, "OnTimer_UpdateAutoRotation");
						Sound_CreateAtEntity("Sound_PillarMisalignedMiddle","03_04_pillar_room/pillar/pillar_misaligned","pillar_middle");
						ParticleSystem_CreateAtEntity("PS_Debris", "pillar_dust.ps","PosArea_DebrisMid",false);
					

						lSign = cMath_Sign(cMath_RandRectf(-1,1));
						Wheel_SetAngle("BeltDrive_Right", cMath_ToRad(Wheel_GetCurrentAngle("BeltDrive_Right"))+cMath_RandRectf(0.2f,0.4f)*lSign,true);
						Map_AddTimer("BeltDrive_Right", 0.2f, "OnTimer_UpdateAutoRotation");
						Sound_CreateAtEntity("Sound_PillarMisalignedRight","03_04_pillar_room/pillar/pillar_misaligned","pillar_right");
						ParticleSystem_CreateAtEntity("PS_Debris", "pillar_dust.ps","PosArea_DebrisRight",false);

					}	
			}

			return true;
		}
		
		void OnLookAt_Player_ConfigDevice(const tString &in asEntity, int alState)
		{
			Sketchbook_AddIdea("fix_pillars");
			//Sketchbook_AddSketchImageByPage("tth_hint_codeblock", "tth_full", true, "");
		}
		
		void OnLookAt_Player_Pillars(const tString &in asEntity, int alState)
		{
			Sketchbook_AddIdea("fix_pillars");
			//Sketchbook_AddSketchImageByPage("tth_hint_pillars", "tth_full", true, "");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EvaluateSolution(const tString &in asTimer)
		{
			// Check pillar alignment
					
			if (!mbOverwriteSolution)	//DEBUG!!! REMOVE WHEN DONE
			{
				if (Evaluate_Pillars() == false) return;
				
				if (Evaluate_ConfigDevice() == false) return;
			}
			
			// Handle entity interactions
			if (Entity_IsInteractedWith("BeltDrive_Right") ||
				Entity_IsInteractedWith("BeltDrive_Mid") ||
				Entity_IsInteractedWith("ConfigDevice_SliderH") ||
				Entity_IsInteractedWith("ConfigDevice_SliderV") ||
				Entity_IsInteractedWith("ConfigRotator"))
			{
				Player_ChangeStateToNormal();
				Player_SetLookSpeedMul(0);
				Player_FadeLookSpeedMulTo(1, 1);
			}
			
			// Disable controllers
			Entity_SetInteractionDisabled("ConfigRotator", true);
			Map_AddTimer("Timer_SetRotatorStuckState", 0.5, "OnTimer_SetRotatorStuckState");
			//Wheel_SetStuckState("BeltDrive_Right", 1, false);
			//Wheel_SetStuckState("BeltDrive_Mid", 1, false);
			//Wheel_SetStuckState("ConfigDevice_SliderH", 1, false);
			//Wheel_SetStuckState("ConfigDevice_SliderV", 1, false);
			Entity_SetActive("Trigger_EvaluateSolution",false);
			Entity_SetActive("Trigger_OnConfigDevice",false);
			Entity_SetInteractionDisabled("button_small_1",true);
			Entity_SetInteractionDisabled("BeltDrive_Right",true);
			Entity_SetInteractionDisabled("BeltDrive_Mid",true);
			Entity_SetInteractionDisabled("ConfigDevice_SliderH",true);
			Entity_SetInteractionDisabled("ConfigDevice_SliderV",true);
			Entity_SetInteractionDisabled("ConfigRotator",true);
			
			//CLOSE CONFIG DEVICE
			Prop_MoveLinearTo("ConfigDeviceSelector","PosArea_ConfigDeviceHide",0.5,0.3,1,false,"");
			Prop_MoveLinearTo("pillar_room_configuration_device*","PosArea_ConfigDeviceHide",0.5,0.3,1,false,"");
			Entity_SetEffectsActive("rune_*", false, false);
			Prop_MoveLinearTo("rune_*","PosArea_ConfigDeviceHide",1,0.3,1,false,"");
		    Entity_PlayAnimation("configuration_device_iris", "closing", 0.1f, false, true);
			Sound_CreateAtEntity("Sound_Iris","03_07_DW_theatre/canister_unplug/small/small_insert","configuration_device_iris");
			
			Light_FadeTo("starmap_red_path_light", cColor(0.872,1,0.789,0), -1, 1);
			
			// Pillars Complete Sequence
			if (!mbSequencePillars)
				Seq_PowerUpPillars("");
				
			Sketchbook_CompleteIdea("fix_pillars");			
			cScript_SetGlobalVarBool("TTH_PillarRoomComplete", true);
			LoadScreen_ProgressStory();
			Voice_PlayDelayed("Dialogue_PillarsDone",8);
		}
		
		void OnTimer_SetRotatorStuckState(const tString &in asTimer)
		{
			Map_RemoveTimer("ConfigRotator");
			Wheel_SetStuckState("ConfigRotator", 1, false);
			Entity_SetInteractionDisabled("ConfigRotator", false);
		}
	
		//-------------------------------------------------------
	
		//} END Event F
	
		/////////////////////////////////////////
		// Event G - WITNESS THE POWERING OF THE PORTAL AND STAR MAP RECONFIGURE IN TO THE DARK WORLD/TIN HINAN SYMBOL
		//{//////////////////////////////////////
	
		//-------------------------------------------------------
	
		/*Put any variables that are only used in Scene 4, Event G here.*/
		
		bool mbSequencePillars = false;
	
		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 4, Event G here.*/

		cSequenceStatesData mPowerUpPillarsSequence;
			
		void Seq_PowerUpPillars(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PowerUpPillars", mPowerUpPillarsSequence);
				
			if (Sequence_DoStepAndWait(0.75))
			{		
				mbSequencePillars = true;
				Sound_CreateAtEntity("Sound_EnergyStart", "03_04_pillar_room/pillar_activate/energy_start", "SoundArea_Pillar");
				Sound_Play("Sound_DebrisLeft", 0.0f);
				Sound_Play("Sound_DebrisMid", 0.0f);
				Sound_Play("Sound_DebrisRight", 0.0f);
				Sound_Play("Sound_Rumble", 0.0f);
				Sound_Play("Sound_ThudStart", 0.0f);
				
				Prop_MoveLinearTo("pillar_middle_filter", "pillar_middle_filter_down", 5, 1, 0.1, true, "Pillar_MoveDone");
				Map_AddTimer("Timer_VitaeLightMiddle", 1.5, "OnTimer_FadeInVitaeLight");
			}
			else if (Sequence_DoStepAndWait(2.5))
			{
				Prop_MoveLinearTo("pillar_right_filter", "pillar_right_filter_down", 5, 1, 0.1, true, "Pillar_MoveDone");
				
				//if (cScript_GetGlobalVarBool("TTH_VitaeCanisterInserted")) 
				Map_AddTimer("Timer_VitaeLightRight", 1.5, "OnTimer_FadeInVitaeLight");
			}
			else if (Sequence_DoStepAndWait(1.1))
			{
				ParticleSystem_SetVisible("PS_PillarActive_Left_*", true);
				//Entity_SetActive("PillarBeam_Left", true);
				Sound_CreateAtEntity("Sound_PillarCharge", "03_04_pillar_room/pillar_activate/pillar_energy_burst", "SoundArea_Pillar");
				Sound_CreateAtEntity("Sound_PillarActivate", "03_04_pillar_room/pillar_activate/pillar_energy_activate", "SoundArea_Pillar");
				Light_FadeTo("Light_PillarPower_Point_1", cColor(0.676,1,0.897,1)*0.333, -1, 0.2);
				Sound_CreateAtEntity("Sound_PillarSound", "03_04_pillar_room/pillar_activate/pillar_energy_flow", "SoundArea_Pillar");
				Effect_Shake_Start(0.2f, 0.25f, 0.5f, 1, 0.2f, 64);
				ParticleSystem_CreateAtEntity("rumble_dust", "debris_falling_huge.ps", "rumble_dust_ps_area_1", false);
				
				Music_Play("A2_3_4_PillarActivate_NEW.ogg", 0.4, false, eMusicPrio_BigEvent);
			}
			else if (Sequence_DoStepAndWait(1.1))
			{
				ParticleSystem_SetVisible("PS_PillarActive_Mid_*", true);
				Sound_CreateAtEntity("Sound_PillarCharge", "03_04_pillar_room/pillar_activate/pillar_energy_burst", "SoundArea_Pillar", 0);
				Light_FadeTo("Light_PillarPower_Point_1", cColor(0.676,1,0.897,1)*0.666, -1, 0.2);
				Effect_Shake_Start(0.2f, 0.25f, 0.5f, 1, 0.2f, 64);
				ParticleSystem_CreateAtEntity("rumble_dust", "debris_falling_huge.ps", "rumble_dust_ps_area_2", false);
				Entity_SetActive("PillarBeam_Mid_weak", true);

				Sound_Fade("Sound_PillarSound", 0.666, 0.15);
			}
			else if (Sequence_DoStepAndWait(1.1))
			{
				ParticleSystem_SetVisible("PS_PillarActive_Right_*", true);
				//Entity_SetActive("Effect_centre_orb", true);
				ParticleSystem_CreateAtEntity("PS_Orb","vitae_orb.ps","PosArea_OrbParticles",true);
				ParticleSystem_CreateAtEntity("PS_Orb_Refraction","vitae_orb_refraction.ps","PosArea_OrbParticles",true);
				Entity_SetActive("PillarBeam_Mid", true);
				Sound_CreateAtEntity("Sound_PillarCharge", "03_04_pillar_room/pillar_activate/pillar_energy_burst", "SoundArea_Pillar", 0);
				Sound_CreateAtEntity("Sound_PillarActivate", "03_04_pillar_room/pillar_activate/pillar_energy_loop_start", "SoundArea_Pillar");
				Light_FadeTo("Light_PillarPower_Point_1", cColor(0.676,1,0.897,1), -1, 0.2);
				Light_FadeTo("Light_PillarPower_Point_2", cColor(0.676,1,0.897,1), -1, 1);
				Light_SetFlickerActive("Light_PillarPower_Point_2", true);
				Effect_Shake_Start(0.3f, 0.5f, 2.5f, 3, 0.2f, 64);
				ParticleSystem_CreateAtEntity("rumble_dust", "debris_falling_huge.ps", "rumble_dust_ps_area_3", false);
				ParticleSystem_CreateAtEntity("rumble_dust", "debris_falling_huge.ps", "rumble_dust_ps_area_4", false);
				ParticleSystem_CreateAtEntity("rumble_dust", "debris_falling_huge.ps", "rumble_dust_ps_area_5", false);
				
				Sound_Fade("Sound_PillarSound", 1, 0.15);
			}
		
			Sequence_End();
		}
	
