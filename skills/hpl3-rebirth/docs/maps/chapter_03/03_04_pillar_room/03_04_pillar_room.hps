		void OnTimer_FadeInVitaeLight(const tString &in asTimer)
		{
			Light_FadeTo(asTimer, cColor(0.309,0.684,1,0), -1, 0.2);
		}
	
		//-------------------------------------------------------
		
		void Pillar_MoveDone(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Sound_PillarSlam", "03_04_pillar_room/pillar_activate/pillar_open", "SoundArea_Pillar");
		}
	
		//-------------------------------------------------------
		
		bool OnCollide_Player_BabyNaming(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 && Entity_PlayerIsInFront(asParent) && Entity_IsInPlayerFOV(asParent) && Voice_SubjectIsPlaying("Dialogue_CallDoc") == false && cScript_GetGlobalVarBool("TTH_PillarRoomComplete") && !mbBabyNamingMoment)
			{
				Player_SetCrouching(false);		
				Player_SetMoveSpeedMul(0.4f);
				Pregnancy_DoBabyKick(true);	 
				Map_AddTimer("Timer_ForceBabyKick",5,"OnTimer_ForceCheckOnBaby");
				return false;
			
			}
			return true;
		}
		
		//------------------------------------------------------- 
		
		bool mbBabyNamingMoment = false;
		
		void OnCheckBaby(int alState)
		{
			if (mbBabyNamingMoment == false && cScript_GetGlobalVarBool("TTH_PillarRoomComplete") && Entity_GetCollide("player","Trigger_EnterAlchemistChambers_1") == false)
			{
				Map_RemoveTimer("Timer_ForceBabyKick");
				Map_AddTimer("Timer_ForceBabyKick",0,"OnTimer_ForceCheckOnBaby");
				mbBabyNamingMoment = true;			
			}
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_ForceCheckOnBaby(const tString &in asTimer)
		{
			Seq_BabyNaming("");
		}
		
		//-------------------------------------------------------
		 
		cSequenceStatesData mSequenceDataBabyNaming;
		void Seq_BabyNaming(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BabyNaming", mSequenceDataBabyNaming);
			if (Sequence_DoStepAndWait(0.9f))
			{			
				mbBabyNamingMoment = true;
				Pregnancy_SetBabyTalkStage(eBabyTalkStage_TTH_AfterName);
				Voice_StopAll();
				Player_SetCrouching(false);
				 
				Effect_BabyKick_Start(0.4f);
				//Voice_PlayWhenPossible("Dialogue_KickPrompt_Short");
				Voice_Play("Dialogue_KickPrompt_Short");
				 
				Item_PutAway(eItemHandlerHand_Left);
				Item_PutAway(eItemHandlerHand_Right);
			}
			else if (Sequence_DoStepAndWait(8.f))
			{				
				Player_SetCrouching(false);
				if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Custom_CheckBaby)
					Player_ChangeStateToNormal();
				Player_SetMoveSpeedMul(0.5f);
				Player_SetRunSpeedMul(0.2f);
				Player_ForceCheckOnBaby(15);
				Music_PlayExt("A2_01_02_Baby_Memory.ogg", false, 0.2f, 1.0f, 0.2f, 0.0f, eMusicPrio_MinorEvent, false);
				 
				 //Pregnancy_SetBabyTalkStage(eBabyTalkStage_TTHAfterKick);				 
			}
			else if (Sequence_DoStepAndWait(3))
			{
				Player_FadeRunSpeedMulTo(1,30);
				Player_FadeMoveSpeedMulTo(1,60);
			}
			Sequence_End();
		}
	
		//} END Event E
	
