		bool OnCollide_Player_AlchemistChamberWhisper(const tString &in asParent, const tString &in asChild, int alState)
		{
			bool bWhisper = (alState == 1) ? true : false;
			Pregnancy_SetWhispering(bWhisper);
		
			return true;
		}
		
		
		
		//-------------------------------------------------------
			
		bool OnCollide_Player_AlchemistChambersRocksFall(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (FearHandler_GetIsPermaFailing()) return true;
			
			FearHandler_SetForcedAddFearRate(0.6f,4,false,0.5f);
			Sound_CreateAtEntity("Sound_RocksFalling", "prototype/cave/rock_wall_pull_scrape", "SoundArea_RocksFall");
			ParticleSystem_CreateAtEntity("PS_Rocks", "dust_impact_simple_oneshot.ps","SoundArea_RocksFall",false);
			return false;
		}
	
