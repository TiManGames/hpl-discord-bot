		bool OnCollide_Player_EnterAlchemistChambers(const tString &in asParent, const tString &in asChild, int alState)
		{
			//Music_PlayExt("A2_Proto_CreepyDesertAmbience.ogg", false, 0.2f, 1.0f, 6.0f, 1.0f, eMusicPrio_SceneAmb, true);
			//Entity_AddImpulse("Pot_Roll", cVector3f(2.f,0,0), true, true);
			//Sound_CreateAtEntity("Sound_PotRoll", "03_04_pillar_room/events/pot_roll_start", "Pot_Roll");
			FearHandler_SetPermaFailEnabled(true);
