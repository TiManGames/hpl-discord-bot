		bool OnDoorTrigger_Player_EncounterReady(const tString &in asArea, const tString &in asEntity, int alState)
		{
			if (alState!=-1)
				return true;

			Entity_SetActive(msMonster, true);
			Ghoul_SetSmellingActive(msMonster,false);
			Pathfinder_Track_Clear(msMonster);
			Pathfinder_Track_Stop(msMonster);
			Entity_SetActive("Trigger_ActivateGhoulAlchemistChambers", true);
			return false;
		}
		
		bool OnCollide_Player_CorpsePose(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (FearHandler_GetIsPermaFailing()) return true;
			
			Entity_SetActive("Trigger_ChangeCorpsePose", true);
			return false;
		}
	
		void OnInteract_GetConfigNote(const tString &in asEntity)
		{
			if (!mbLostNote)
			{
				//////////////////////////
				// First time you find the note
				Entity_SetActive("Trigger_ActivateGhoulAlchemistChambers", true);
				Entity_SetActive("Trigger_DeactivateGhoulAlchemistChambers", true);
			}
			else
			{
				//////////////////////////
				// After death scenario
				Entity_SetActive("Trigger_ResetAlchemistChambers",true);
				Entity_SetActive("Trigger_ChangeCorpsePose",true);
			}
		}
		
