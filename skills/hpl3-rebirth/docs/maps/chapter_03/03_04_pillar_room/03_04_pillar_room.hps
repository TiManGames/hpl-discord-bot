		void OnInteract_BeltDrive(const tString &in asEntity)
		{
			if (cScript_GetGlobalVarBool("TTH_PillarRoomComplete")) return;
			
			Map_AddTimer(asEntity, 0.2f, "OnTimer_UpdateAutoRotation");
			
			/*iPhysicsJoint@ pJoint = cLux_GetCurrentMap().GetPhysicsWorld().GetJoint(asEntity+"_JointHinge_1");
			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
			mfPrevBeltDriveAngle = pHinge.GetAngle();
			
			tString sAssignedPillar = Entity_GetVarString(asEntity,"");
			iPhysicsJoint@ pPillarJoint = cLux_GetCurrentMap().GetPhysicsWorld().GetJoint(sAssignedPillar+"_JointHinge_1");
			iPhysicsJointHinge@ pPillarHinge = cPhysics_ToJointHinge(pPillarJoint);
			mfPrevPillarAngle = pPillarHinge.GetAngle();*/
		}
		
		//-------------------------------------------------------
		
		[nosave] float mfPrevWheelAngVel = 0.f;
		
		void OnTimer_UpdateAutoRotation(const tString &in asTimer)
		{
			// UPDATE ROTATION ON RELEASE
			
			//////////////////////////////
			// Sounds
			bool bInteractedWith = Entity_IsInteractedWith(asTimer);
			bool bJammed = Wheel_GetJammed(asTimer);
			float fAngVel = Map_GetEntity(asTimer).GetBody(1).GetAngularVelocity().Length();
			tString sStartSound = "03_04_pillar_room/pillar/pillar_turn_start";
			tString sStopSound = "03_04_pillar_room/pillar/pillar_turn_end";
			
			tString sPos = (asTimer == "BeltDrive_Right") ? "_Right" : "_Mid";
			
			if (fAngVel > 0.1f && mfPrevWheelAngVel < 0.1f)
				Sound_CreateAtEntity("Sound_PillarStart"+sPos, sStartSound, "SoundArea_Pillar"+sPos);
			if (fAngVel < 0.1f && mfPrevWheelAngVel > 0.1f || bInteractedWith == false && fAngVel > 0.1f)
				Sound_CreateAtEntity("Sound_PillarStop"+sPos, sStopSound, "SoundArea_Pillar"+sPos);
				
			Sound_Fade("Sound_RotatePillar"+sPos, fAngVel > 0.1f && bInteractedWith && bJammed == false ? 1.f : 0.f , 0.5f);
			if (bInteractedWith == false)
				Sound_Stop("Sound_RotatePillar"+sPos, 0.5f);
			
			mfPrevWheelAngVel = fAngVel;
			
			if (bInteractedWith == false)
			{
				mfPrevWheelAngVel = 0.f;
				
				float fAngle = Wheel_GetCurrentAngle(asTimer);
				float fMod = cMath_Abs(cMath_Modulus(fAngle, 90.f));
				float fTar = -1.f;

				if (fMod >= 45.f) fTar = fAngle + (90.f - fMod) * cMath_Sign(fAngle);
				if (fMod < 45.f) fTar = fAngle + fMod * cMath_Sign(-fAngle);

				if (fTar == -1.f) return;
				
				Wheel_SetAngle(asTimer, cMath_ToRad(fTar), true);
				
				tString sCollideArea = "AreaPulleyRight";
				if (asTimer=="BeltDrive_Mid") sCollideArea="AreaPulleyMid";
				tString sPillar = Entity_GetVarString(asTimer, "");
				
				int lAlignmentIx = -1;
				for (int i = 1; Entity_Exists(sCollideArea+"_Align_"+i); i++)
				{
					if (Entity_GetCollide(sCollideArea, sCollideArea+"_Align_"+i))
						lAlignmentIx = i;
						Debug_Log(asTimer + " POSITION: "+lAlignmentIx);
				}
					
				if (lAlignmentIx >= 1)
				{
					Entity_SetVarInt(sPillar, "currentRotation", lAlignmentIx);
					cLux_AddDebugMessage("CURR ROT: "+Entity_GetVarInt(sPillar,"currentRotation"));
					//EvaluateSolution(1);
				}
				else
				{
					Map_AddTimer(asTimer, 0.2f, "OnTimer_UpdateAutoRotation");
				}
				return;
			}
			
			Map_AddTimer(asTimer, 0.2f, "OnTimer_UpdateAutoRotation");
		}
		
		//--------------------------------------------------------
		
		void OnTimer_BeltDriveInteract(const tString &in asTimer)
		{
			
			iPhysicsJoint@ pJoint = cLux_GetCurrentMap().GetPhysicsWorld().GetJoint(asTimer+"_JointHinge_1");
			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
			
			float fDiff = cMath_GetAngleDistanceRad(mfPrevBeltDriveAngle, pHinge.GetAngle());
			float fSpeed = fDiff/mfBeltDriveTimer;
			mfPrevBeltDriveAngle = pHinge.GetAngle();
			
			tString sPillar = Entity_GetVarString(asTimer, "");
			
			Prop_RotateToSpeed(sPillar, 100.0f, fSpeed, false, "");
			
			// Stop matching rotation speed to belt drive and if close enough to a valid alignment, rotate it into position.
			if (cMath_Abs(fSpeed) < 0.001 && Entity_IsInteractedWith(asTimer)==false)
			{
				tString sCollideArea = "AreaPulleyRight";
				if (asTimer=="BeltDrive_Mid") sCollideArea="AreaPulleyMid";
				
				int lAlignmentIx = -1;
				for (int i = 1; Entity_Exists(sCollideArea+"_Align_"+i); i++)
				{
					if (Entity_GetCollide(sCollideArea, sCollideArea+"_Align_"+i))
						lAlignmentIx = i;
						//Debug_Log("POSITION "+lAlignmentIx);
				}
					
				if (lAlignmentIx >= 1)
				{
					Prop_AlignRotation(sPillar, sPillar+"_Align_"+lAlignmentIx, 2.0, 1.0, 0.1, true, "");
					Entity_SetVarInt(sPillar, "currentRotation", lAlignmentIx);
					//EvaluateSolution(1);
				}
				return;
			}
			
			Map_AddTimer(asTimer, mfBeltDriveTimer, "OnTimer_BeltDriveInteract");
		}
	
