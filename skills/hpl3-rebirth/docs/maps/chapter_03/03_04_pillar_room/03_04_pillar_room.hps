		/*Put any functions that are only used in Scene 4, Event D here.*/
		
		bool OnCollide_Player_ActivateGhoulAlchemistChambers(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (FearHandler_GetIsPermaFailing()) return true;
			
			GhoulAlchemistChambers_Activate();
			Seq_AlchemistChambersLights("");
			return false;
		}
		
		//-------------------------------------------------------
		
		void GhoulAlchemistChambers_Activate()
		{
			Sound_CreateAtEntity("Sound_GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_search", msMonster);
			Sound_CreateAtEntity("Sound_WindHowl", "03_04_pillar_room/events/event_wind_howl", "Audio_TunnelWind");
			
			for (int i = 0; i <= 12; i++)
				Ghoul_CommandPatrol_AddNode(msMonster,"PathNode_AlchemistChambersRoute_"+i,0,0,"",false);
			Ghoul_CommandPatrol_Execute(msMonster,true,1,false,eGhoulSpeed_Walk,"OnEndOfTrack_GhoulAlchemistChambers");
				
			Map_AddTimer("Timer_GhoulAlchemistChambers", 4, "OnTimer_ActivateGhoulSenses");
			Hint_ShowHint_Hold("Hints", "HintHideMode", true);
		}
		
		//-------------------------------------------------------		
		
		void OnTimer_ActivateGhoulSenses(const tString &in asTimer)
		{
			Agent_SetSensesActive(msMonster, true);
		}
		
		//-------------------------------------------------------
		
		void OnBreak_Pot(const tString &in asEntity)
        {
			tString sContent = Entity_GetVarString(asEntity,"");
            Prop_RemoveAttachedProp(asEntity,sContent);
			Prop_SetStaticPhysics(sContent,false);
			Entity_AddImpulse(sContent,cVector3f_One*0.1f,true,true);
		}
		
		//------------------------------------------------------- 
		
		cSequenceStatesData mAlchemistChambersLightsSequence;
			
		void Seq_AlchemistChambersLights(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AlchemistChambersLights", mAlchemistChambersLightsSequence);
				
			if (Sequence_DoStepAndWait(10))
			{		
				//Music_FadeVolumeMul(1,0);
				Music_Play("A2_3_4_GhoulEvent.ogg", 0.2, false, eMusicPrio_BigEvent);
				//Sound_CreateAtEntity("Sound_GhoulScream", "prototype/stingers/darkworld_enter", "SoundArea_GhoulSpawn");
				Light_FadeTo("PointLight_59",cColor(0,0,0,0),0,1);
				Light_FadeTo("BoxLight_18",cColor(0,0,0,0),0,1);
				Light_FadeTo("BoxLight_19",cColor(0,0,0,0),0,1);
				Light_FadeTo("BoxLight_20",cColor(0,0,0,0),0,1);
				Light_FadeTo("BoxLight_21",cColor(0,0,0,0),0,1);
				Light_FadeTo("BoxLight_27",cColor(0,0,0,0),0,1);
				Light_FadeTo("SpotLight_20",cColor(0,0,0,0),0,1);
				Light_FadeTo("Light_GhoulAlchemistChambers_*",cColor(0.753,0.92,0.665,0.382),-1,3);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Light_FadeTo("PointLight_59",cColor(1,1,1,1),0,3);
				Light_FadeTo("BoxLight_18",cColor(1,1,1,1),0,6);
				Light_FadeTo("BoxLight_19",cColor(1,1,1,1),0,6);
				Light_FadeTo("BoxLight_20",cColor(1,1,1,1),0,6);
				Light_FadeTo("BoxLight_21",cColor(1,1,1,1),0,6);
				Light_FadeTo("BoxLight_27",cColor(1,1,1,1),0,6);
				Light_FadeTo("Light_GhoulAlchemistChambers_*",cColor(0,0,0,0),0,12);
			}
		
			Sequence_End();
		}
	

		//-------------------------------------------------------
		
		void OnEndOfTrack_GhoulAlchemistChambers(const tString &in asEntity)
		{
//			Ghoul_ForceSniff(msMonster);
			Map_AddTimer("Timer_GhoulLeave",4,"OnTimer_GhoulLeave");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_DeactivateGhoulAlchemistChambers(const tString &in asParent, const tString &in asChild, int alState)
		{		
			if (Entity_IsActive(msMonster))
			{
				//Entity_SetActive(msMonster,false);
				Agent_SetSensesActive(msMonster,false);
				Map_AddTimer("Timer_GhoulLeave",3,"OnTimer_GhoulLeave");
			}
			Prop_MoveLinearTo("temp_pillarcollapse_1","temp_pillarcollapse_2",10,10,1,false);
			Prop_MoveLinearTo("temp_pillarcollapse_3","temp_pillarcollapse_4",10,10,1,false);
			Prop_MoveLinearTo("temp_pillarcollapse_5","temp_pillarcollapse_6",10,10,1,false);
			Sound_CreateAtEntity("Sound_Collapse","prototype/cave/rock_wall_collapse","temp_pillarcollapse_1");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_GhoulLeave(const tString &in asTimer)
		{
			Ghoul_SetHoleNetwork(msMonster,"GhoulHole_AlchemistChambers_*","","");
			Ghoul_Command_Remove(msMonster,true);
			Ghoul_CommandGoToHole_Execute(msMonster,Map_GetEntity(msMonster).GetPosition(),true,false,true,true,eGhoulSpeed_FastWalk);
			//Ghoul_CommandGoToSpecificHole_Execute(msMonster,"GhoulHole_AlchemistChambers_1",true,false,true,eGhoulSpeed_FastWalk);
		}
	

			
