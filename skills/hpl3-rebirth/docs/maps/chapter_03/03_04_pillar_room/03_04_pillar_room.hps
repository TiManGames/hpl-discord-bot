	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("03-04-pillar-room");
		
		// Set up color grading etc.
		
		Pregnancy_SetStage(ePregStage_Stage2);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkMinimumStage(eBabyTalkStage_TTH_BeforeName);
		GhoulProgression_SetBarkMinimumStage(eGhoulBarkStage_BecomingMonster);
		Player_SetAllowCheckBaby(true);
		
		if (cScript_GetGlobalVarBool("TTH_Milked"))
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_MilkingToDWFA);
		}
		else
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_HQAToVitaeStation);
		}
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(1);
		StruggleFlashHandler_SetProgression(1);
		
		Player_SetAutoTeleportWhenBelowAltitude(-6.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("pillar_dust.ps");
		ParticleSystem_Preload("dust_impact_simple_oneshot.ps");
		ParticleSystem_Preload("debris_falling_huge.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		Entity_Preload("radio_receiver_held.ent");
		Sound_PreloadEvent("level_entity_shared/fire/fire_ignite/wall_torch_ignite");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(9);
		// Any general setup of script / entities
		
		Entity_SetEffectsActive("pressureplate*",false,true);
		
		Entity_PlayAnimation("configuration_device_iris", "open", 0.1f, true, true);
					
		SetupPillars();
		SetupConfigDevice();
		
		Entity_SetActive("Corpse_2",false);
		Entity_SetActive("Corpse_Old",false);
		Entity_AddImpulse("pottery_basic_small_grab_10",cVector3f_One,true,true);
		Entity_AddImpulse("pottery_basic_small_grab_13",cVector3f_One,true,true);
		
		
		
		//Player_SetNightVisionEnabled(false);
		Player_SetCanUseLightSource(true);
		Player_SetMapDeepShadow(0.2f);
		
		//cScript_SetGlobalVarBool("TTH_VitaeCanisterInserted", true);
		FogArea_SetVisible("FogArea_DeathScenario",false);
		
		// Setup death areas
		Death_SetActiveDeathAreaForSource(msMonster,"DeathArea_GhoulAlchemistChambers");
		
		// Setup effects
		//ParticleSystem_SetVisible("vitae_beam_initial_*", false);
		
		//if (ItemType_GetCountInInventory("Radio") < 1)
		//	Item_AddToInventory("Radio");
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			if (ItemType_GetCountInInventory("Lantern") < 1)
				Item_AddToInventory("Lantern");
				
			if (ItemType_GetCountInInventory("Radio") < 1)
				Item_AddToInventory("Radio");
				
			Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
		}
		
		Music_Play("A2_3_4_PillarRoomAmbience.ogg", 0.2, true, eMusicPrio_BgAmb);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		PlayerBody_SetActive(true);
		
		Pregnancy_SetBabyKicksEnabled(true);
        
        Heat_SetActive(false);
		
		Entity_SetCollide("gear_right_*", false);
		Entity_SetCollide("gear_middle_*", false);
		
		///////////////////////////////////
		// PF-ing should be off until a PF seq is registered
		FearHandler_SetPermaFailEnabled(false);
		
		Player_SetNightVisionEnabled(false);
		// Updated 200403
		Player_SetNightVisionBrightness(1.5f);
		
		if (mbSequencePillars == false)
			SetupConfigDevice();
		else
		{
			Sound_CreateAtEntity("Sound_PillarSound", "03_04_pillar_room/pillar_activate/pillar_energy_flow", "SoundArea_Pillar");
			ParticleSystem_CreateAtEntity("PS_Orb","vitae_orb.ps","PosArea_OrbParticles",true);
			ParticleSystem_CreateAtEntity("PS_Orb_Refraction","vitae_orb_refraction.ps","PosArea_OrbParticles",true);
			Entity_SetEffectsActiveExt("lit_pillar_symbol_*",true,true,0.8f,2);
		}
		
		Game_AutoSave();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		///////////////////
		// Clear permafails
		FearHandler_ClearPermaFailScenes();
		
		//Pregnancy_SetBabyKicksEnabled(true);
	}
	
