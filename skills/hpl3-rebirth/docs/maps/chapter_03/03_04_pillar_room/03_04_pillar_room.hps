	bool OnCollide_ToggleNightVision(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1) Player_SetNightVisionEnabled(true);
		else if (alState==-1) Player_SetNightVisionEnabled(false);
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnPermaFail()
	{
		// PermaFails
		FearHandler_AddPermaFailScene("Area_Permafail_Run_Point_A", "Area_Permafail_Run_Point_B", 5.f, 3.f, true);
		FearHandler_AddPermaFailScene("Area_Permafail_Run_Point_C", "Area_Permafail_Run_Point_D", 5.f, 0.5f, true);
		FearHandler_AddPermaFailScene("struggle_gnaw_on_fairchild_loop", "Area_Permafail_FeedTarget");
		FearHandler_AddPermaFailScene("cannon_stumble", "Area_Permafail_Run_Point_D","","", 1.25f);
		FearHandler_SetPermaFailRespawnArea("Area_PermaFail_1");
		
		if (Entity_IsActive(msMonster))
			Entity_SetActive(msMonster, false);
			
		FearArea_SetUnsafeMusic("Fear_Global", "");
		FearHandler_SetPermaFailEnabled(false);
		return true;
	}
 
