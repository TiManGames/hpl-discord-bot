		//-------------------------------------------------------
		
		bool OnCollide_Player_AlchemistChambersMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				cLux_AddDebugMessage("Enter MUSIC");
				Map_RemoveTimer("Timer_CreepyMusicOff");
				Map_AddTimer("Timer_CreepyMusicOn", 3.2f, "OnTimer_CreepyMusicOn");
			}
			else
			{
				cLux_AddDebugMessage("Leave MUSIC");
				Map_RemoveTimer("Timer_CreepyMusicOn");
				Map_AddTimer("Timer_CreepyMusicOff", 3, "OnTimer_CreepyMusicOff");
			}
				
			return true;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_PastBlockage(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1)
			{
				if (Entity_IsActive(msMonster))
				{
					//Entity_SetActive(msMonster,false);
					Agent_SetSensesActive(msMonster,false);
					Map_AddTimer("Timer_GhoulLeave",3,"OnTimer_GhoulLeave");
				}
			}
			else
			{
				if (Entity_IsActive(msMonster))
				{
					Agent_SetSensesActive(msMonster,true);
				}
			}
			
			return true;
		}
		
