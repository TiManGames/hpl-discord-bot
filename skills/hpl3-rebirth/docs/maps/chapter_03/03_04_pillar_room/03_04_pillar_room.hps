		{
			cLux_AddDebugMessage("STOP MUSIC");
			Music_Stop(3, eMusicPrio_SceneAmb);
		}
		
		void OnTimer_CreepyMusicOn(const tString &in asTimer)
		{
			cLux_AddDebugMessage("STRART MUSIC");
			Music_PlayExt("A2_Proto_CreepyDesertAmbience.ogg", true, 0.2f, 1.0f, 6.0f, 1.0f, eMusicPrio_SceneAmb, true);
		}
		
		
		
