		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterCattleTunnels(const tString &in asParent, const tString &in asChild, int alState)
		{
			FearHandler_SetPermaFailRespawnArea("PermaFail_CattleTunnels");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SetupWraithCattleScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_StartWraithCattleScare", true);
			Entity_SetActive("Wraith_Cattle", true);
			Wraith_SetVolumeMul("Wraith_Cattle", 0, true);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartWraithCattleScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_WraithCattleScare("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWraithCattleScare;
		void Seq_WraithCattleScare(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WraithCattleScare", mSequenceWraithCattleScare);
			if (Sequence_DoStepAndWait(0))
			{
				Map_AddTimer("Timer_CheckWraithCattleScareDistance", 0, "OnTimer_CheckWraithCattleScareDistance");
			}
			else if (Sequence_DoStepAndWait(2.5))
			{
				Wraith_SetVolumeMul("Wraith_Cattle", 1, false);
				Wraith_SetSpotlightOn("Wraith_Cattle", true);
				Wraith_SetSpotlightColor("Wraith_Cattle", "alert");
				Wraith_TurnSpotlightToPos("Wraith_Cattle", Map_GetEntity("Target_WraithCattle_LookAt_1").GetPosition(), true, false);
				Wraith_SetCallback_BeamCenterSeen("Wraith_Cattle", "OnBeamSeen_WraithCattleScare", 1.5, true);
				Sound_Play("Sound_WraithEmerge", 1.0f);
				Sound_Stop("Sound_WraithRattle", 3.0f);
				Entity_SetActive("Trigger_WraithSounds",false);
				Entity_SetActive("Trigger_StopWraithSounds",false);
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				Wraith_TurnSpotlightToPos("Wraith_Cattle", Map_GetEntity("Target_WraithCattle_LookAt_2").GetPosition(), false, true, 0.8f);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Wraith_SetSpotlightOn("Wraith_Cattle", false);
				Wraith_SetFly("Wraith_Cattle", true);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Map_RemoveTimer("Timer_CheckWraithCattleScareDistance");
				Wraith_CommandDash_Execute("Wraith_Cattle", Map_GetEntity("Target_WraithCattle_Dash_1").GetPosition(), false, true, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnBeamSeen_WraithCattleScare(const tString &in asEntityName, int alState)
		{
			Voice_Play("Dialogue_WraithReaction");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckWraithCattleScareDistance(const tString &in asTimer)
		{
			if (Player_GetDistanceToEntity("Wraith_Cattle") < 10.0f)
			{
				Wraith_CommandDash_Execute("Wraith_Cattle", Map_GetEntity("Target_WraithCattle_Dash_1").GetPosition(), false, true, true);
				SequenceStates_Stop("Seq_WraithCattleScare");
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.1f, 0.3f));
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlayWraithSounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Play("Sound_WraithRattle", 1.0f);
			return true;
		}
		
		//-------------------------------------------------------

		bool OnCollide_StopWraithSounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Stop("Sound_WraithRattle", 3.0f);
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event B *See a WRAITH*
		
		/////////////////////////////////////////
		// Event B *Walk through the cattle tunnel and see signs of previous victims*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		tID m_idCattleCorpse = tID_Invalid;
		tID m_idCattleCorpseStruggleSound = tID_Invalid;
		
		//-------------------------------------------------------
		
		void InitCattleCorpse()
		{
			Entity_AttachToSocket("InteractAux_CattleCorpse", "CattleCorpse", "headNode", true);
			m_idCattleCorpse = Map_GetEntity("CattleCorpse").GetID();
		}
		
		//-------------------------------------------------------
		
		float mfPrevCattleCorpseAngle = 0;
		float mfCattleCorpseAngleMovementCounter = 0;
		float mfCattleCorpseMovementTimer = 0.4f;
		bool mbCattleCorpseInteract = false;
		void UpdateCattleCorpse(float afTimeStep)
		{
			bool bInteract = Entity_IsInteractedWith("CattleCorpse");
			
			// grab
			if (mbCattleCorpseInteract == false && bInteract)
			{
//				cLux_AddDebugMessage("PLAY THIS");
//				if (Sound_Exists("CorpseGrab")) Sound_Stop("CorpseGrab", 0);
				Sound_CreateAtEntity("CorpseGrab", "03_04_pillar_room/helper_corpse/helper_corpse_start", "CattleCorpse");
			}
			
			mbCattleCorpseInteract = bInteract;
			if (bInteract == false)
			{
				mfCattleCorpseAngleMovementCounter = 0;
				mfCattleCorpseMovementTimer = 0.4f;
				return;
			}
			
			iLuxEntity@ pCorpse = cLux_ID_Entity(m_idCattleCorpse);
			if (pCorpse is null) return;
			
			cVector3f vToHead = pCorpse.GetMainBody().GetWorldPosition() - cLux_GetPlayer().GetCamera().GetPosition();
			float fHeadAngle = cMath_ToDeg(cMath_Vector3Angle(cLux_GetPlayer().GetCamera().GetForward(), cMath_Vector3Normalize(vToHead)));
			bool bAwayFromHead = fHeadAngle >= mfPrevCattleCorpseAngle;
			
			// calc movement speed
			float fSpeed = cMath_Abs(fHeadAngle - mfPrevCattleCorpseAngle);
			if (fSpeed < 0.1) fSpeed = 0;
			
			// count how much you wiggle the corpse
			mfCattleCorpseMovementTimer -= afTimeStep;
			if (mfCattleCorpseMovementTimer <= 0) mfCattleCorpseAngleMovementCounter += fSpeed;
			
			if (fSpeed > 0 && Sound_Exists("CorpseStruggle") == false) Sound_CreateAtEntity("CorpseStruggle", "03_04_pillar_room/helper_corpse/helper_corpse_move", "CattleCorpse");
			if (fSpeed <= 0 && Sound_Exists("CorpseStruggle")) Sound_Stop("CorpseStruggle", 0.2);
						
			mfPrevCattleCorpseAngle = fHeadAngle;
			float fAngleMul = 1.0f - cMath_Clamp(fHeadAngle / 12.0f, 0.0f, 1.0f);
			float fLookMul = cMath_Easing(eEasing_CubicIn, fAngleMul);
			
			float fMaxLook = 0.64f;
			float fMinLook = 0.04f;
			float fFinalLookAt = fMinLook + fLookMul * fMaxLook;
			if (bAwayFromHead) Player_FadeLookSpeedMulTo(fFinalLookAt, 0.0f);
			else Player_FadeLookSpeedMulTo(fMaxLook, 0.5f);
			
			float fTearTreshold = cLux_GetInputHandler().GetGamepadWasLastDeviceUsed() ? 10.0f : 13.0f;
			float fWiggleTreshold = cLux_GetInputHandler().GetGamepadWasLastDeviceUsed() ? 18.0f : 25.0f;
			
			// tear
			if (fHeadAngle >= fTearTreshold || mfCattleCorpseAngleMovementCounter >= fWiggleTreshold)
			{
				pCorpse.SetInteractionDisabled(true);
				Player_ChangeStateToNormal();
				
				pCorpse.GetBodyFromName("Body_7").SetMass(0.2f);
				pCorpse.GetBodyFromName("Body_7").SetCollide(false);
				pCorpse.GetBodyFromName("Body_6").SetMass(0.3f);
				pCorpse.GetBodyFromName("Body_6").SetCollide(false);
				
				pCorpse.GetBodyFromName("Body_15").SetMass(0.2f);
				pCorpse.GetBodyFromName("Body_16").SetMass(0.2f);
				
				Player_SetLookSpeedMul(0.6f);
				Player_FadeLookSpeedMulTo(0.1, 0.5f);
				
				Map_AddTimer("Timer_CattleTearSlowLookAt", 0.1f, "OnTimer_CattleTearSlowLookAt");
				
				Map_AddTimer("Timer_DisableCorpse", 0.5f, "OnTimer_DisableCorpse");
				Map_AddTimer("Timer_CalmDownCorpse", 1.5f, "OnTimer_CalmDownCorpse");
				
				Effect_Rumble_Start(4, 0.4f, 0, 0.1);
				
				Sound_Stop("CorpseStruggle", 0.2);
				Sound_CreateAtEntity("CorpseRemove", "03_04_pillar_room/helper_corpse/helper_corpse_remove", "CattleCorpse");
				Map_AddTimer("Timer_CorpseHitGround", 0.3f, "OnTimer_CorpseHitGround");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CorpseHitGround(const tString &in asTimer)
		{
			Sound_CreateAtEntity("CorpseGround", "03_04_pillar_room/helper_corpse/helper_corpse_drop", "CattleCorpse");
		}
		
