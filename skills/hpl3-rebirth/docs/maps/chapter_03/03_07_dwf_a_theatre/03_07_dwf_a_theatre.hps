			Sound_CreateAtEntity("BabyDanger", "new_sounds/theatre/error_beep", "Button_ScanInfo", 0, false, 1.0);
			FlashButton("Button_ScanInfo", Entity_GetEffectBaseColor("Button_ScanInfo"), 4, 0.75f, false);
			
			Hologram_SetImageBrightness(mlHologramImage_ButtonAlert, 2, 0.75f);
			
			Map_AddTimer("Timer_PulseBabyDangerFadeBack", 0.75f, "OnTimer_PulseBabyDangerFadeBack");
			Map_RestartCurrentTimer(5.0f);
		}
		
