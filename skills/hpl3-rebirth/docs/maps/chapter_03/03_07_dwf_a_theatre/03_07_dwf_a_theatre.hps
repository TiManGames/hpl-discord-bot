		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceDiscardEmptyHanger;
		void Seq_DiscardEmptyHanger(const tString &in asTimer)
		{
			tString sHanger = GetHangerName(mlHanger_DiscardEmptyhangerId);
			
			Sequence_Begin("Seq_DiscardEmptyHanger", mSequenceDiscardEmptyHanger);
			if (Sequence_DoStepAndWait(0.5))
			{
				UpdateDiscardHangerCounter();
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				CloseHangerArms(mlHanger_DiscardEmptyhangerId, false, true);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				SetScanbedLeverState(eScanbedLeverState_InactiveLockedBack);
				
				Entity_SetAnimationMessageEventCallback(sHanger, "OnAnimEvent_ResumeDiscardEmptyHanger", false);
				Entity_PlayAnimation(sHanger, "checkpoint_to_pit", 0, false, false, "OnAnimEnd_ResumeDiscardEmptyHanger");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_PlayAnimation("Scanbed", "open", 0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				SlideDoor_SetOpenAmount("Door_Pit", 1);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_PlayAnimation("Scanbed", "close", 0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				SetScanbedLeverState(eScanbedLeverState_InactiveUnlocked);
				SetCheckpointLeverState(true);
				SlideDoor_SetOpenAmount("Door_Pit", 0);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Entity_SetAnimationMessageEventCallback(sHanger, "", false);
				Entity_PlayAnimation(sHanger, "pit_to_end", 0, false, false, "");
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		void OnAnimEvent_ResumeDiscardEmptyHanger(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			SequenceStates_Resume("Seq_DiscardEmptyHanger");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ResumeDiscardEmptyHanger(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("Seq_DiscardEmptyHanger");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTheaterScan;
		void Seq_TheaterScan(const tString &in asTimer)
		{
			tString sHanger = GetHangerName(mlHanger_TheaterScanId);
			
			Sequence_Begin("Seq_TheaterScan", mSequenceTheaterScan);
			if (Sequence_DoStepAndWait(0.5))
			{
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				CloseHangerArms(mlHanger_TheaterScanId, mlHanger_PlayerAttachedId >= 0);
				SetScanbedLeverState(eScanbedLeverState_InactiveLockedBack, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_SetAnimationMessageEventCallback(sHanger, "OnAnimEvent_ResumeTheaterScan", false);
				Entity_PlayAnimation(sHanger, "checkpoint_to_scanbed", 0, false, false, "OnAnimEnd_RemoveRailAttachment");
				cAnimationState@ pAnim = Map_GetEntity(sHanger).GetMeshEntity().GetAnimationStateFromName("checkpoint_to_scanbed");
				pAnim.SetSpeed(1);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_AttachToSocket("RailPart_Scanbed", sHanger, "socket_base", true, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_SetAnimationMessageEventCallback(sHanger, "", true);
				
				// reset hologram
				Entity_SetEffectsActive("TheaterHologramStand", true, true);
				mbHologram_Active = true;
				
				Hologram_StopIdle();
				Hologram_FlickerOutAllImages();
				
				// play scan anim
				Entity_SetAnimationMessageEventCallback("TheaterScanner", "OnAnimEvent_ResumeTheaterScan", false);
				Entity_PlayAnimation("TheaterScanner", "scanner_scan", 0, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// light start
				Entity_SetEffectsActive("TheaterScanner", true, true);
				
				cParticleSystem@ pPS = cLux_GetCurrentMap().GetWorld().CreateParticleSystem("TheaterScanPS", "03_07_theater_scan_effect_1.ps", cVector3f_One, false, false);
				m_idScannerLampPS = pPS.GetID();
				
				OpenHangerArms(mlHanger_TheaterScanId, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				if (Entity_GetVarString(sHanger, "Attached") == "player")
				{
					Effect_Screen_Start("white.mat", cVector2f(0.5, 0.52), cVector2f(1.75, 0.875), 0.2, 0.2, 0.6, 0.2);
				}
			}
			else if (Sequence_DoStepAndPause(0))
			{
				if (Entity_GetVarString(sHanger, "Attached") == "player")
				{
					Effect_Screen_Start("white.mat", cVector2f(0.5, 0.52), cVector2f(1.75, 0.875), 0.2, 0.2, 0.6, 0.2);
				}
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				// light end
				Entity_SetEffectsActive("TheaterScanner", false, true);
				cLux_ID_ParticleSystem(m_idScannerLampPS).Kill();
				
				// change hologram
				if (Entity_GetVarString(sHanger, "Attached") == "corpse") Hologram_FlickerInImage(mlHologramImage_Victim);
				else if (Entity_GetVarString(sHanger, "Attached") == "player") Hologram_FlickerInImage(mlHologramImage_Tasi);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				m_idScannerLampPS = tID_Invalid;
				
				mbTheaterScanUnlockLever = true;
				OpenHangerArms(mlHanger_TheaterScanId, mlHanger_PlayerAttachedId >= 0, false);
				
				if (mlHanger_PlayerAttachedId >= 0 && mbBabyScanMomentDone == false)
				{
					mbTheaterScanUnlockLever = false;
					Seq_BabyMoment("");
				}
			}
			else if (Sequence_DoStepAndWait(5))
			{
				// idle ui anim
				Hologram_ResetIdle();
				Hologram_StartIdle();
				Hologram_FlickerInIdleImages();
			}
			else if (Sequence_DoStepAndWait(0))
			{
				if (mbTheaterScanUnlockLever)
				{
					SetScanbedLeverState(eScanbedLeverState_ActiveUnlocked);
				}
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEvent_ResumeTheaterScan(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			SequenceStates_Resume("Seq_TheaterScan");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_RemoveRailAttachment(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_RemoveEntityAttachment("RailPart_Scanbed");
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_ScanbedLever(const tString &in asEntity, int alState)
		{
			if (alState == -1)
			{
				if (mScanbedLeverState == eScanbedLeverState_ActiveUnlocked)
				{
					SetScanbedLeverState(eScanbedLeverState_InactiveLockedForward);
					mlHanger_DiscardHangerId = mlHanger_TheaterScanId;				
					Seq_DiscardHanger("");
				}
				else if (mScanbedLeverState == eScanbedLeverState_InactiveUnlocked && mbTheaterRoomOn)
				{
					SetScanbedLeverState(eScanbedLeverState_InactiveLockedForward);
					Seq_ScanbedLeverTest("");
				}
			}
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceDiscardHanger;
		void Seq_DiscardHanger(const tString &in asTimer)
		{
			tString sHanger = GetHangerName(mlHanger_DiscardHangerId);
			
			Sequence_Begin("Seq_DiscardHanger", mSequenceDiscardHanger);
			if (Sequence_DoStepAndWait(0.5))
			{
				UpdateDiscardHangerCounter();
				Sound_CreateAtEntity("ScanbedReaction", "03_07_dw_factory/baby_scanner/scan_shield/open", "Scanbed", 0, true, 1, 4, 15);
				
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_SetAnimationMessageEventCallback(sHanger, "OnAnimationMessage_ResumeDiscardHanger", false);
				Entity_PlayAnimation(sHanger, "scanbed_to_pit", 0, false, false, "");
				cAnimationState@ pAnim = Map_GetEntity(sHanger).GetMeshEntity().GetAnimationStateFromName("scanbed_to_pit");
				pAnim.SetSpeed(1);
				
				// attach rail part to hanger, but only move on y
				m_idRailAttachHanger = Map_GetEntity(sHanger).GetID();
				iLuxEntity@ pHanger = cLux_ID_Entity(m_idRailAttachHanger);
				cNode3D@ pHangerSocket = pHanger.GetMeshEntity().GetSocket("socket_base");
				iLuxEntity@ pRail = cLux_ID_Entity(m_idRailPart);
				mvRailPartOffset = pRail.GetPosition() - pHangerSocket.GetWorldPosition();
				mbRailAttachedToHanger = true;
//				Entity_AttachToSocket("RailPart_Scanbed", sHanger, "socket_base", true, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				CloseHangerArms(mlHanger_DiscardHangerId, true, false);
				if (mlHanger_PlayerAttachedId >= 0)
				{
					mbPitOfBodies_Entered = true;
					FearHandler_SetPermaFailRespawnArea("PermaFail_PitOfBodies");
					
					if (mbHanger_GettingIn)
					{
						cAnimationState@ pAnim = Map_GetEntity(sHanger).GetMeshEntity().GetAnimationStateFromName("scanbed_to_pit");
						pAnim.SetPaused(true);
						Map_AddTimer("Timer_DiscardHanger_CheckGettingIn", 0, "OnTimer_DiscardHanger_CheckGettingIn");
					}
					else
					{
						SequenceStates_Resume("Seq_DiscardHanger");
					}
				}
				else
				{
					SequenceStates_Resume("Seq_DiscardHanger");
				}
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Entity_PlayAnimation("Scanbed", "open", 0);
				CloseHangerArms(mlHanger_DiscardHangerId, false, true);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				cAnimationState@ pAnim = Map_GetEntity(sHanger).GetMeshEntity().GetAnimationStateFromName("scanbed_to_pit");
				pAnim.SetPaused(false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				if (mlHanger_PlayerAttachedId >= 0) Voice_Play("Dialogue_OnTheHanger");
			}
			else if (Sequence_DoStepAndWait(3))
			{
				mbRailAttachedToHanger = false;
//				Entity_RemoveEntityAttachment("RailPart_Scanbed");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_PlayAnimation("Scanbed", "close", 0);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				SlideDoor_SetOpenAmount("Door_Pit", 1, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				OpenHangerArms(mlHanger_DiscardHangerId, mlHanger_PlayerAttachedId >= 0, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				SlideDoor_SetOpenAmount("Door_Pit", 0, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				SetScanbedLeverState(eScanbedLeverState_InactiveUnlocked, false);
				SetCheckpointLeverState(true);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				if (Entity_GetVarString(sHanger, "Attached") == "corpse")
				{
					// victim falls into the pit
//					Entity_AttachToSocket("TheaterCorpse", sHanger, "socket_base", true, false);

					Entity_RemoveEntityAttachment("TheaterCorpse");
					Entity_PlayAnimation("TheaterCorpse", "dropped_from_hanger", 0, false, false, "OnAnimEnd_RemoveHangerCorpse");
					Map_GetEntity("TheaterCorpse").GetMeshEntity().GetSubMeshEntityName("m_Harness").SetVisible(false);
					
					
//					Entity_SetActive("TheaterCorpse", false);
//					Entity_SetActive("Blocker_Corpse", false);
//					Entity_RemoveEntityAttachment("TheaterCorpse");
				}
				else if (Entity_GetVarString(sHanger, "Attached") == "player")
				{
					CloseHangerArms(mlHanger_DiscardHangerId, true, false);
					
					FearHandler_SetForcedAddFearRate(1.0f, 99, false, 4);
					
					PlayerBody_PlayCutsceneAtSocket("player_jump_down_hanger", GetHangerName(mlHanger_PlayerAttachedId), "socket_player", false, 0.25f, "OnAnimEnd_DropPlayer");
					
					Voice_PlayDelayed("Dialogue_KickedIntoThePit", 0.3f);
				}
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_PlayAnimation(sHanger, "pit_to_end", 0, false, false, "");
				cAnimationState@ pAnim = Map_GetEntity(sHanger).GetMeshEntity().GetAnimationStateFromName("pit_to_end");
				pAnim.SetSpeed(1);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_SetAnimationMessageEventCallback(sHanger, "", true);
				cAnimationState@ pAnim = Map_GetEntity(sHanger).GetMeshEntity().GetAnimationStateFromName("pit_to_end");
				pAnim.SetPaused(true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_DropPlayer(const tString &in asAnimName)
		{			
			mlHanger_PostExit = mlHanger_PlayerAttachedId;
				
			Entity_SetVarString(GetHangerName(mlHanger_PlayerAttachedId), "Attached", "");
			mlHanger_PlayerAttachedId = -1;
			PlayerBody_DetachFromEntity();

			PlayerBody_PlayAnimation("jump_fall", ePlayerBodyAnimationLayer_FullBody, false, false, true, 0);
				
			Map_GetEntity("Hanger_Collision_" + mlHanger_PostExit).GetMainBody().SetCollideCharacter(false);
			Player_SetJumpDisabled(true);
			Map_AddTimer("Timer_ResetHangerCollision", 1, "OnTimer_ResetHangerCollision");
		}
		
