		void OnTimer_DiscardHanger_CheckGettingIn(const tString &in asTimer)
		{
			if (mbHanger_GettingIn == false)
			{
				SequenceStates_Resume("Seq_DiscardHanger");
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.1, 0.2));
		}
		
