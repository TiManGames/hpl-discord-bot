	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_TestPlus)
		{
			YoungTinHinan_Activate("THGhost_Theatre", 1);
			YoungTinHinan_SetFlying("THGhost_Theatre", true);
			return;
//			Seq_BabyMoment("");
//			return;
//			PlayerBody_PlayCutsceneAtEntity("looks_at_baby_scan", "Target_BabyScanAnims", false, 0);
//			return;
			
			++lTest;
			lTest %= 4;
			return;
//			Map_GetEntity("dashasuidhauish").GetMeshEntity().PlayName("open_arms", false, false);
			Entity_PlayAnimation("dashasuidhauish", "open_arms", 0, false);
//			Map_GetEntity("dashasuidhauish").GetMeshEntity().GetAnimationStateFromName("open_arms").SetWeight(0.1);
			return;
			SlideDoor_SetOpenAmount("Door_Pit", 1, false);
			return;
			mlHanger_CheckpointId = 1;
			Seq_CheckpointScan("");
			return;
			Entity_SetActive("TestCage", true);
			Entity_PlayAnimation("TestCage", "start_to_checkpoint", 0, false);
			return;
			return;
			OnTimer_PulseBabyDanger("");
			return;
			Amulet_StartTracking(true, "Rift_ShuttleStation");
			return;
			return;
			Pathfinder_MoveToNode("Wraith_1", "PathNode_18", "");
			return;
			Sketchbook_UnlockMemory("Memory_ChildIsIll");
			return;
			CameraAnimation_Begin("CameraAnimation_BabyMoment", "", true);
			return;
			cLux_AddDebugMessage("BODY: " + Pregnancy_GetStageBodyModel());
			return;
			SetHologramState(3, true);
			return;
			Entity_PlayAnimation("TheaterHanger_Move_1", "dwf_ht_scan_to_exit", 0.0f);
			return;
			SequenceBringNewHanger("");
			return;
			Entity_PlayAnimation("Target_TheaterHanger_Start_1", "dwf_ht_checkpoint_to_scan", 0.0f);
		}
		
		if(alAction == eAction_TestMinus)
		{
			YoungTinHinan_MoveTo("THGhost_Theatre", "PathNode_THTheater_12", "");
			return;
			PlayerBody_PlayAnimation("idle", ePlayerBodyAnimationLayer_FullBody, true, false, false);
			return;
			PlayerBody_AttachToSocket("TestCage", "socket_root");
			return;
			Entity_PlayAnimation("TheaterHanger_Move_" + 1, "dwf_ht_scan_to_exit", 0, false, false, "");
			Entity_SetAnimationMessageEventCallback("TheaterHanger_Move_" + 1, "OnAnimEvent_DiscardOldHanger", true);
			return;
