	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Button flash
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	[nosave] array<tID> mvFlashTimers;
	[nosave] array<cColor> mvFlashOrigColors;
	[nosave] array<cColor> mvFlashColors;
	[nosave] array<float> mvFlashTimes;
	[nosave] array<bool> mvFlashRepeat;
	
	//-------------------------------------------------------
	
	void BlinkButton(const tString &in asButton)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asButton);
		FlashButton(asButton, pEnt.GetEffectBaseColor(), 1.4f, 0.5f, true);
	}
	
	//-------------------------------------------------------
	
	void StopBlinkButton(const tString &in asButton, bool abReturnColor = false)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asButton);
		for (int i = 0; i < mvFlashTimers.size(); ++i)
		{
			if (mvFlashTimers[i] == pEnt.GetID())
			{
				mvFlashRepeat[i] = false;
				Map_RemoveTimer(asButton);
				if (abReturnColor) OnTimer_StopFlash(asButton);
				else OnTimer_UnblockFlash(asButton);
			}
		}
	}
	
	//-------------------------------------------------------
	
	void FlashButton(const tString &in asButton, float afBrightness = 1.4f)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asButton);
		FlashButton(asButton, pEnt.GetEffectBaseColor(), afBrightness);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_FlashButton(const tString &in asTimer)
	{
		FlashButton(asTimer);
	}
	
	//-------------------------------------------------------
	
	void FlashButton(const tString &in asButton, cColor aColor, float afBrightness = 1.4f, float afTime = 0.5f, bool abRepeat = false)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asButton);
		for (int i = 0; i < mvFlashTimers.size(); ++i)
		{
			if (mvFlashTimers[i] == pEnt.GetID()) return;
		}
								
		mvFlashTimers.push_back(pEnt.GetID());
		mvFlashOrigColors.push_back(pEnt.GetEffectBaseColor());
		mvFlashRepeat.push_back(abRepeat);
		mvFlashTimes.push_back(afTime);
		
		cColor newCol = aColor * afBrightness;
		mvFlashColors.push_back(newCol);
		
		Entity_FadeEffectBaseColor(asButton, newCol, afTime);
		Map_AddTimer(asButton, afTime, "OnTimer_StopFlash");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_StopFlash(const tString &in asTimer)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asTimer);
		for (int i = 0; i < mvFlashTimers.size(); ++i)
		{
			if (mvFlashTimers[i] == pEnt.GetID())
			{
				Entity_FadeEffectBaseColor(asTimer, mvFlashOrigColors[i], mvFlashTimes[i]);
				Map_AddTimer(asTimer, mvFlashTimes[i] + 0.05f, "OnTimer_UnblockFlash");
				return;
			}
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_UnblockFlash(const tString &in asTimer)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asTimer);
		for (int i = 0; i < mvFlashTimers.size(); ++i)
		{
			if (mvFlashTimers[i] == pEnt.GetID())
			{
				bool bRepeat = mvFlashRepeat[i];
				cColor repeatColor = mvFlashColors[i];
				float fTime = mvFlashTimes[i];
				pEnt.StopEffectBaseColorFade();
				pEnt.SetEffectBaseColor(mvFlashOrigColors[i]);
				
				mvFlashTimers.removeAt(i);
				mvFlashOrigColors.removeAt(i);
				mvFlashColors.removeAt(i);
				mvFlashRepeat.removeAt(i);
				mvFlashTimes.removeAt(i);
				if (bRepeat) FlashButton(asTimer, repeatColor, 1.0f, fTime, true);
				return;
			}
		}
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Light flash
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	[nosave] array<tID> mvFlashLightTimers;
	[nosave] array<float> mvFlashLightRadius;
	[nosave] array<float> mvFlashLightOrigBrightness;
	
	//-------------------------------------------------------
	
	void FlashLight(const tString &in asLight, float afBrightness = 2.0f, float afRadius = 1.2f)
	{
		iLight@ pLight = Map_GetLight(asLight);
		for (int i = 0; i < mvFlashLightTimers.size(); ++i)
		{
			if (mvFlashLightTimers[i] == pLight.GetID()) return;
		}
		
		mvFlashLightTimers.push_back(pLight.GetID());
		mvFlashLightRadius.push_back(pLight.GetRadius());
		mvFlashLightOrigBrightness.push_back(pLight.GetBrightness());
		
		pLight.FadeTo(pLight.GetDiffuseColor(), pLight.GetRadius() * afRadius, 0.5f);
		pLight.FadeBrightnessTo(pLight.GetBrightness() * afBrightness, 0.5f);
		Map_AddTimer(asLight, 0.5f, "OnTimer_StopLightFlash");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_StopLightFlash(const tString &in asTimer)
	{
		iLight@ pLight = Map_GetLight(asTimer);
		for (int i = 0; i < mvFlashLightTimers.size(); ++i)
		{
			if (mvFlashLightTimers[i] == pLight.GetID())
			{
				pLight.FadeTo(pLight.GetDiffuseColor(), mvFlashLightRadius[i], 0.5f);
				pLight.FadeBrightnessTo(mvFlashLightOrigBrightness[i], 0.5f);
				Map_AddTimer(asTimer, 0.55f, "OnTimer_UnblockLightFlash");
				return;
			}
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_UnblockLightFlash(const tString &in asTimer)
	{
		iLight@ pLight = Map_GetLight(asTimer);
		for (int i = 0; i < mvFlashLightTimers.size(); ++i)
		{
			if (mvFlashLightTimers[i] == pLight.GetID())
			{
				mvFlashLightTimers.removeAt(i);
				mvFlashLightOrigBrightness.removeAt(i);
				return;
			}
		}
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Hologram UI
	/////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbHologram_Active = true;
	array<cDWHologramImage> mvHologram_Images;
	int mlHologram_AnimationIdCount = 0;
	array<cDWHologramAnimation> mvHologram_Animations;
	float mfHologram_Brightness = 1.0f;
	float mfHologram_FlickerTimer = 0;
	
	//-------------------------------------------------------
	
	int Hologram_CreateImage(const tString&in asImage, const cVector3f&in avPos, const cVector2f&in avSize, float afRotation = 0, cColor aColor = cColor_White, float afBrightness = 1)
	{
		cDWHologramImage newImage;
		newImage.mlId = mvHologram_Images.size();
		newImage.mbActive = false;
		newImage.msImage = asImage;
		newImage.mvPos = avPos;
		newImage.mfRotation = afRotation;
		newImage.mvSize = avSize;
		newImage.mColor = aColor;
		newImage.mfBrightness = afBrightness;
		mvHologram_Images.push_back(newImage);
		
		return newImage.mlId;
	}
	
	//-------------------------------------------------------
	
	void Hologram_SetImageActive(int alId, bool abX)
	{
		if (alId < 0 || alId >= mvHologram_Images.size()) return;
		
		cDWHologramImage@ pImage = mvHologram_Images[alId];
		pImage.mbActive = abX;
	}
	
	//-------------------------------------------------------
	
	int Hologram_CreateAnim(int alId, cDWHologramAnimAttributes aAdd, float afFadeTime = 0, eEasing aEasing = eEasing_Linear, bool abRepeat = false)
	{
		if (alId < 0 || alId >= mvHologram_Images.size()) return -1;
		
		if (afFadeTime <= 0)
		{
			cDWHologramImage@ pImage = mvHologram_Images[alId];
			Hologram_AddAttributes(pImage, aAdd, 1);
			return -1;
		}
		
		cDWHologramAnimation newAnim;
		newAnim.mlId = mlHologram_AnimationIdCount++;
		newAnim.mlImageId = alId;
		newAnim.mfAlpha = 0;
		newAnim.mfTime = afFadeTime;
		newAnim.mEasing = aEasing;
		newAnim.mbRepeat = abRepeat;
		newAnim.mbRepeatDirFwd = true;
		newAnim.mAdd = aAdd;
		
		mvHologram_Animations.push_back(newAnim);
		
		return newAnim.mlId;
	}
	
	//-------------------------------------------------------
	
	void Hologram_StopAnim(int alId)
	{
		for (int i = 0; i < mvHologram_Animations.size(); ++i)
		{
			cDWHologramAnimation@ pAnim = mvHologram_Animations[i];
			if (alId != pAnim.mlId) continue;
			
			mvHologram_Animations.removeAt(i);
			return;
		}
	}
	
	//-------------------------------------------------------
	
	void Hologram_StopImageAnims(int alId)
	{
		for (int i = 0; i < mvHologram_Animations.size(); ++i)
		{
			cDWHologramAnimation@ pAnim = mvHologram_Animations[i];
			if (alId != pAnim.mlImageId) continue;
			
			mvHologram_Animations.removeAt(i);
			return;
		}
	}
	
	//-------------------------------------------------------
	
	int Hologram_SetImagePos(int alId, const cVector3f&in avPos, float afFadeTime = 0, eEasing aEasing = eEasing_Linear, bool abRepeat = false, bool abAdd = false)
	{
		if (alId < 0 || alId >= mvHologram_Images.size()) return -1;
		
		cDWHologramImage@ pImage = mvHologram_Images[alId];
		
		cDWHologramAnimAttributes att;
		if (abAdd) att.mvPos = avPos;
		else att.mvPos = avPos - pImage.mvPos;
		
		return Hologram_CreateAnim(alId, att, afFadeTime, aEasing, abRepeat);
	}
	
	//-------------------------------------------------------
	
	int Hologram_SetImageSize(int alId, const cVector2f&in avSize, float afFadeTime = 0, eEasing aEasing = eEasing_Linear, bool abRepeat = false)
	{
		if (alId < 0 || alId >= mvHologram_Images.size()) return -1;
		
		cDWHologramImage@ pImage = mvHologram_Images[alId];
		
		cDWHologramAnimAttributes att;
		att.mvSize = avSize - pImage.mvSize;
		
		return Hologram_CreateAnim(alId, att, afFadeTime, aEasing, abRepeat);
	}
	
	//-------------------------------------------------------
	
	int Hologram_SetImageRotation(int alId, float afRotation, float afFadeTime = 0, eEasing aEasing = eEasing_Linear, bool abRepeat = false)
	{
		if (alId < 0 || alId >= mvHologram_Images.size()) return -1;
		
		cDWHologramImage@ pImage = mvHologram_Images[alId];
		
		cDWHologramAnimAttributes att;
		att.mfRotation = afRotation - pImage.mfRotation;
		
		return Hologram_CreateAnim(alId, att, afFadeTime, aEasing, abRepeat);
	}
	
	//-------------------------------------------------------
	
	int Hologram_SetImageBrightness(int alId, float afBrightness, float afFadeTime = 0, eEasing aEasing = eEasing_Linear, bool abRepeat = false)
	{
		if (alId < 0 || alId >= mvHologram_Images.size()) return -1;
		
		cDWHologramImage@ pImage = mvHologram_Images[alId];
		
		cDWHologramAnimAttributes att;
		att.mfBrightness = afBrightness - pImage.mfBrightness;
		
		return Hologram_CreateAnim(alId, att, afFadeTime, aEasing, abRepeat);
	}
	
	//-------------------------------------------------------
	
	int Hologram_SetImageColor(int alId, cColor aColor, float afFadeTime = 0, eEasing aEasing = eEasing_Linear, bool abRepeat = false)
	{
		if (alId < 0 || alId >= mvHologram_Images.size()) return -1;
		
		cDWHologramImage@ pImage = mvHologram_Images[alId];
		
		cDWHologramAnimAttributes att;
		att.mColor = aColor - pImage.mColor;
		
		return Hologram_CreateAnim(alId, att, afFadeTime, aEasing, abRepeat);
	}
	
