		//-------------------------------------------------------
		
		void Hologram_FlickerOutAllImages()
		{
			array<int> vImages;
			vImages.push_back(mlHologramImage_Victim);
			vImages.push_back(mlHologramImage_Tasi);
			vImages.push_back(mlHologramImage_Cycles1);
			vImages.push_back(mlHologramImage_Cycles2);
			vImages.push_back(mlHologramImage_Ghoul);
			vImages.push_back(mlHologramImage_Cage1);
			vImages.push_back(mlHologramImage_Cage2);
			Hologram_FlickerOutImage(vImages);
		}
		
		//-------------------------------------------------------
		
		void Hologram_FlickerInIdleImages()
		{
			array<int> vImages;
			vImages.push_back(mlHologramImage_Cycles1);
			vImages.push_back(mlHologramImage_Cycles2);
			vImages.push_back(mlHologramImage_Ghoul);
			vImages.push_back(mlHologramImage_Cage1);
			vImages.push_back(mlHologramImage_Cage2);
			Hologram_FlickerInImage(vImages);
		}
		
		//-------------------------------------------------------
		
		void Hologram_FlickerOutIdleImages()
		{
			array<int> vImages;
			vImages.push_back(mlHologramImage_Cycles1);
			vImages.push_back(mlHologramImage_Cycles2);
			vImages.push_back(mlHologramImage_Ghoul);
			vImages.push_back(mlHologramImage_Cage1);
			vImages.push_back(mlHologramImage_Cage2);
			Hologram_FlickerOutImage(vImages);
		}
		
		//-------------------------------------------------------
		
		void Hologram_StartIdle()
		{
			OnTimer_StartHologramIdle_Cycles1("");
			OnTimer_StartHologramIdle_Cycles2("");
			OnTimer_StartHologramIdle_Ghoul("");
			OnTimer_StartHologramIdle_Cage1("");
			OnTimer_StartHologramIdle_Cage2("");
			
			Sound_CreateAtEntity("Sound_ScreenOn", "03_07_dw_factory/baby_scanner/scan_UI/screen_on", "Target_Hologram");
			Sound_CreateAtEntity("Sound_Circle_loop", "03_07_dw_factory/baby_scanner/scan_UI/circle_move_loop", "Target_Hologram");
			Sound_CreateAtEntity("Sound_ScanEnergy", "03_07_dw_factory/baby_scanner/scan_UI/energy_loop", "Target_Hologram");
		}
		
		//-------------------------------------------------------
		
		void Hologram_StopIdle()
		{
			OnTimer_StopHologramIdle_Cycles1("");
			OnTimer_StopHologramIdle_Cycles2("");
			OnTimer_StopHologramIdle_Ghoul("");
			OnTimer_StopHologramIdle_Cage1("");
			OnTimer_StopHologramIdle_Cage2("");
			
			Sound_Stop("Sound_Circle_loop", 3.0f);
			Sound_Stop("Sound_ScanEnergy", 3.0f);
		}
		
		//-------------------------------------------------------
		
		void Hologram_ResetIdle()
		{
			Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.1, -0.28, 1));
			Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(0.3, 0.35, 1));
			Hologram_SetImagePos(mlHologramImage_Ghoul, cVector3f(0, -0.4, 1));
			Hologram_SetImagePos(mlHologramImage_Cage1, cVector3f(-0.4, -0.4, 1));
			Hologram_SetImagePos(mlHologramImage_Cage2, cVector3f(0.4, -0.4, 1));
			
			Hologram_SetImageSize(mlHologramImage_Cycles1, cVector2f(0.31, 0.31));
			Hologram_SetImageSize(mlHologramImage_Cycles2, cVector2f(0.30, 0.30));
			Hologram_SetImageSize(mlHologramImage_Ghoul, cVector2f(0.16, 0.16));
			Hologram_SetImageSize(mlHologramImage_Cage1, cVector2f(0.05, 0.05));
			Hologram_SetImageSize(mlHologramImage_Cage2, cVector2f(0.05, 0.05));
			
			Hologram_SetImageBrightness(mlHologramImage_Cycles1, 1);
			Hologram_SetImageBrightness(mlHologramImage_Cycles2, 1);
			Hologram_SetImageBrightness(mlHologramImage_Ghoul, 1);
			Hologram_SetImageBrightness(mlHologramImage_Cage1, 1);
			Hologram_SetImageBrightness(mlHologramImage_Cage2, 1);
		}
		
		//-------------------------------------------------------
		
		void UpdateHologramTest(float afTimeStep)
		{
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceHologramTest;
		void Seq_HologramTest(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HologramTest", mSequenceHologramTest);
			if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_SetImageSize(mlHologramImage_Cycles1, cVector2f(1.5, 1.5), 1, eEasing_Linear, true);
			}
			else if (Sequence_DoStepAndWait(2.5))
			{
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Hologram_SetImageActive(0, false);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		array<int> mvHologram_Cycles1_RepeatAnims;
		
		void OnTimer_StartHologramIdle_Cycles1(const tString &in asTimer)
		{
			mvHologram_Cycles1_RepeatAnims.push_back(Hologram_SetImageSize(mlHologramImage_Cycles1, cVector2f(0.35, 0.35), 1.5, eEasing_SineInOut, true));
			mvHologram_Cycles1_RepeatAnims.push_back(Hologram_SetImageRotation(mlHologramImage_Cycles1, 180, 2.0, eEasing_SineInOut, true));
			mvHologram_Cycles1_RepeatAnims.push_back(Hologram_SetImageBrightness(mlHologramImage_Cycles1, 0.5, 0.5, eEasing_SineInOut, true));
			cDWHologramImage@ pImage = mvHologram_Images[mlHologramImage_Cycles1];
			pImage.mfFlickerMul = 8.5;
			pImage.mfFlickerPosDist = 0.005;
			Seq_HologramIdle_Cycles1("");
		}
		
		void OnTimer_StopHologramIdle_Cycles1(const tString &in asTimer)
		{
			cDWHologramImage@ pImage = mvHologram_Images[mlHologramImage_Cycles1];
			pImage.mfFlickerMul = 1;
			pImage.mfFlickerPosDist = 0;
			SequenceStates_Stop("Seq_HologramIdle_Cycles1");
			Map_RemoveTimer("Seq_HologramIdle_Cycles1");
			mSequenceHologramIdle_Cycles1.mlStateCounter = 0;
			for (int i = 0; i < mvHologram_Cycles1_RepeatAnims.size(); ++i) Hologram_StopAnim(mvHologram_Cycles1_RepeatAnims[i]);
			Hologram_StopImageAnims(mlHologramImage_Cycles1);
		}
				
		cSequenceStatesData mSequenceHologramIdle_Cycles1;
		void Seq_HologramIdle_Cycles1(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HologramIdle_Cycles1", mSequenceHologramIdle_Cycles1);
			if (Sequence_DoStepAndWait(1.0))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.1, -0.28, 1), 1, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0.13, 0, 0), 1.5, eEasing_SineInOut, false, true);
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, 0.22, 0), 14, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.12, 0, 0), 1.5, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0.15, 0, 0), 1.5, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.15, 0, 0), 1.5, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0.25, 0, 0), 2, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.25, 0, 0), 2, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0.28, 0, 0), 2, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.28, 0, 0), 2, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1.5)) // move to left arm
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.35, -0.08, 1), 1.5, eEasing_SineInOut, false);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, -0.02, 0), 1, eEasing_SineInOut, false, true);
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0.04, 0, 0), 2, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, 0.04, 0), 1, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, -0.02, 0), 1, eEasing_SineInOut, false, true);
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.04, 0, 0), 2, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, 0.02, 0), 1, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(2.5)) // move to right arm
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0.32, -0.12, 1), 2.5, eEasing_SineInOut, false);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, -0.02, 0), 1, eEasing_SineInOut, false, true);
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0.04, 0, 0), 2, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, 0.04, 0), 1, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, -0.02, 0), 1, eEasing_SineInOut, false, true);
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.04, 0, 0), 2, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, 0.02, 0), 1, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(2)) // to top of head
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(0, -0.2, 0), 2.5, eEasing_SineInOut, false, true);
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.3, 0, 0), 2.5, eEasing_SineInOut, false, true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Map_AddTimer("Seq_HologramIdle_Cycles1", 0.5f, "Seq_HologramIdle_Cycles1");
			}
			Sequence_End();
		}

		//-------------------------------------------------------
		
		array<int> mvHologram_Cycles2_RepeatAnims;
		int mlHologramImage_Cycles2_RepeatAnimLegScan = 0;
		int mlHologramImage_Cycles2_RepeatAnimScale = 0;
		
		void OnTimer_StartHologramIdle_Cycles2(const tString &in asTimer)
		{
			mlHologramImage_Cycles2_RepeatAnimScale = Hologram_SetImageSize(mlHologramImage_Cycles2, cVector2f(0.33, 0.33), 1.7, eEasing_SineInOut, true);
			mvHologram_Cycles2_RepeatAnims.push_back(Hologram_SetImageRotation(mlHologramImage_Cycles2, 145, 2.2, eEasing_SineInOut, true));
			mvHologram_Cycles2_RepeatAnims.push_back(Hologram_SetImageBrightness(mlHologramImage_Cycles2, 0.4, 0.6, eEasing_SineInOut, true));
			cDWHologramImage@ pImage = mvHologram_Images[mlHologramImage_Cycles2];
			pImage.mfFlickerMul = 8.5;
			pImage.mfFlickerPosDist = 0.005;
			Seq_HologramIdle_Cycles2("");
		}
		
		void OnTimer_StopHologramIdle_Cycles2(const tString &in asTimer)
		{
			cDWHologramImage@ pImage = mvHologram_Images[mlHologramImage_Cycles2];
			pImage.mfFlickerMul = 1;
			pImage.mfFlickerPosDist = 0;
			SequenceStates_Stop("Seq_HologramIdle_Cycles2");
			Map_RemoveTimer("Seq_HologramIdle_Cycles2");
			mSequenceHologramIdle_Cycles2.mlStateCounter = 0;
			for (int i = 0; i < mvHologram_Cycles2_RepeatAnims.size(); ++i) Hologram_StopAnim(mvHologram_Cycles2_RepeatAnims[i]);
			Hologram_StopAnim(mlHologramImage_Cycles2_RepeatAnimLegScan);
			Hologram_StopAnim(mlHologramImage_Cycles2_RepeatAnimScale);
			Hologram_StopImageAnims(mlHologramImage_Cycles2);
		}
		
		cSequenceStatesData mSequenceHologramIdle_Cycles2;
		void Seq_HologramIdle_Cycles2(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HologramIdle_Cycles2", mSequenceHologramIdle_Cycles2);
			if (Sequence_DoStepAndWait(1))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(0.3, 0.35, 1), 1, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(2.0)) // move to left leg
			{
				Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(-0.13, 0.4, 1), 2, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(12.0))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(0, -0.32, 0), 12, eEasing_SineInOut, false, true);
				mlHologramImage_Cycles2_RepeatAnimLegScan = Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(0.06, 0, 0), 0.8, eEasing_SineInOut, true, true);
			}
			else if (Sequence_DoStepAndWait(2.0)) // move to baby
			{
				Hologram_StopAnim(mlHologramImage_Cycles2_RepeatAnimLegScan);
				Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(0.03, 0.03, 1), 2.0, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(6))
			{
				Hologram_StopAnim(mlHologramImage_Cycles2_RepeatAnimScale);
				mlHologramImage_Cycles2_RepeatAnimScale = Hologram_SetImageSize(mlHologramImage_Cycles2, cVector2f(0.38, 0.38), 1.0, eEasing_SineInOut, true);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_StopAnim(mlHologramImage_Cycles2_RepeatAnimScale);
				mlHologramImage_Cycles2_RepeatAnimScale = Hologram_SetImageSize(mlHologramImage_Cycles2, cVector2f(0.33, 0.33), 1.7, eEasing_SineInOut, true);
				Hologram_SetImageSize(mlHologramImage_Cycles2, cVector2f(0.30, 0.30), 0.5);
			}
			else if (Sequence_DoStepAndWait(1.5)) // move to right leg
			{
				Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(0.11, 0.1, 1), 1.5, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(9.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(0.09, 0.35, 1), 10, eEasing_SineInOut);
				mlHologramImage_Cycles2_RepeatAnimLegScan = Hologram_SetImagePos(mlHologramImage_Cycles2, cVector3f(0.07, 0, 0), 0.6, eEasing_SineInOut, true, true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Hologram_StopAnim(mlHologramImage_Cycles2_RepeatAnimLegScan);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Map_AddTimer("Seq_HologramIdle_Cycles2", 0.5f, "Seq_HologramIdle_Cycles2");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		array<int> mvHologram_Ghoul_RepeatAnims;
		void OnTimer_StartHologramIdle_Ghoul(const tString &in asTimer)
		{
			mvHologram_Ghoul_RepeatAnims.push_back(Hologram_SetImageBrightness(mlHologramImage_Ghoul, 0.5, 0.5, eEasing_SineInOut, true));
		}
		
		void OnTimer_StopHologramIdle_Ghoul(const tString &in asTimer)
		{
			for (int i = 0; i < mvHologram_Ghoul_RepeatAnims.size(); ++i) Hologram_StopAnim(mvHologram_Ghoul_RepeatAnims[i]);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartHologramIdle_Cage1(const tString &in asTimer)
		{
			mvHologram_Images[mlHologramImage_Cage1].mfFlickerPosDist = 0.004;
			Seq_HologramIdle_Cage1("");
		}
		
		void OnTimer_StopHologramIdle_Cage1(const tString &in asTimer)
		{
			mvHologram_Images[mlHologramImage_Cage1].mfFlickerPosDist = 0;
			SequenceStates_Stop("Seq_HologramIdle_Cage1");
			Map_RemoveTimer("Seq_HologramIdle_Cage1");
			mSequenceHologramIdle_Cage1.mlStateCounter = 0;
			Hologram_StopImageAnims(mlHologramImage_Cage1);
		}
		
		cSequenceStatesData mSequenceHologramIdle_Cage1;
		void Seq_HologramIdle_Cage1(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HologramIdle_Cage1", mSequenceHologramIdle_Cage1);
			if (Sequence_DoStepAndWait(1.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cage1, cVector3f(-0.4, -0.4, 1), 1.5, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cage1, cVector3f(-0.3, -0.42, 1), 1.5, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cage1, cVector3f(-0.4, -0.33, 1), 2, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Map_AddTimer("", 0.5f, "Seq_HologramIdle_Cage1");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartHologramIdle_Cage2(const tString &in asTimer)
		{
			mvHologram_Images[mlHologramImage_Cage2].mfFlickerPosDist = 0.004;
			Seq_HologramIdle_Cage2("");
		}
		
		void OnTimer_StopHologramIdle_Cage2(const tString &in asTimer)
		{
			mvHologram_Images[mlHologramImage_Cage2].mfFlickerPosDist = 0;
			SequenceStates_Stop("Seq_HologramIdle_Cage2");
			Map_RemoveTimer("Seq_HologramIdle_Cage2");
			mSequenceHologramIdle_Cage2.mlStateCounter = 0;
			Hologram_StopImageAnims(mlHologramImage_Cage2);
		}
		
		cSequenceStatesData mSequenceHologramIdle_Cage2;
		void Seq_HologramIdle_Cage2(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HologramIdle_Cage2", mSequenceHologramIdle_Cage2);
			if (Sequence_DoStepAndWait(2.5))
			{
				Hologram_SetImagePos(mlHologramImage_Cage2, cVector3f(0.4, -0.4, 1), 1.5, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Hologram_SetImagePos(mlHologramImage_Cage2, cVector3f(0.3, -0.4, 1), 1.5, eEasing_SineInOut);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Map_AddTimer("", 0.5f, "Seq_HologramIdle_Cage2");
			}
			Sequence_End();
		}
		
