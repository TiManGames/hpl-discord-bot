		//-------------------------------------------------------
		
		bool mbLookingAtPortal = false;
		
		//-------------------------------------------------------
		
		void StartWakeUpScene()
		{
//			PlayerBody_SetInteractiveAnimationRange(0.0f, 1.0f);
			
		}

		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceWakeUpScene;
		void Seq_WakeUpScene(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WakeUpScene", mSequenceWakeUpScene);
			if (Sequence_DoStepAndWait(0.2))
			{
				Effect_Flash_Start(0, 1, 1.0f, 1);
				
				Effect_Rumble_Start(1, 4, 0.5, 2);
				
				Item_PutAway(eItemHandlerHand_Left);
				Item_PutAway(eItemHandlerHand_Right);
			}
			else if (Sequence_DoStepAndWait(0.3))
			{
				PlayerBody_PlayCutsceneAtEntity("fall_and_get_up_slow", "Target_WakeUpAnim", false, 0.0f);
				Sound_CreateAtEntity("Sound_PortalOpen", "03_07_DW_theatre/animations/theatre_wake_teleport", "player");
				Sound_CreateAtEntity("Sound_TheatreWake", "03_07_DW_theatre/animations/theatre_wake", "player");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Voice_Play("Dialogue_TasiWakesUp");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_ExaminePortalDialogue(const tString &in asEntity, int alState)
		{
			mbLookingAtPortal = alState == 1;
			if (alState == 1)
			{
				Voice_PlayWhenPossible("Dialogue_TasiExaminesPortal", "OnVoiceCondition_TasiExaminesPortal", 45, 3);
				Entity_SetActive("Trigger_ExaminePortalDialogue", false);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnVoiceCondition_TasiExaminesPortal(const tString& in asSubject)
		{
			return mbLookingAtPortal;
		}
		
