		void Seq_ScanbedLeverTest(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ScanbedLeverTest", mSequenceScanbedLeverTest);
			if (Sequence_DoStepAndWait(0.5))
			{
				
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Entity_PlayAnimation("Scanbed", "twitch", 0);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				if (mScanbedLeverState == eScanbedLeverState_InactiveLockedForward) SetScanbedLeverState(eScanbedLeverState_InactiveUnlocked, false);
			}
			Sequence_End();
		}
		
