			mlHologramImage_Joint10 = Hologram_CreateImage("hologram_image_joints", cVector3f(0.13, 0.39, 0.8), cVector2f(0.05, 0.05), 0, mHologramColor_Yellow);
			mlHologramImage_MotherHood1 = Hologram_CreateImage("hologram_image_motherhood_1", cVector3f(0.02, 0.017, 0.8), cVector2f(0.65, 0.65), 0, mHologramColor_Yellow);
			mlHologramImage_MotherHood2 = Hologram_CreateImage("hologram_image_motherhood_2", cVector3f(0.02, 0.017, 0.8), cVector2f(0.65, 0.65), 0, mHologramColor_Yellow);
			mlHologramImage_IllnessCircle1 = Hologram_CreateImage("hologram_image_illness_circle_1", cVector3f(-0.23, 0.181, 0.8), cVector2f(0.3, 0.3), 0, mHologramColor_Yellow);
			mlHologramImage_IllnessCircle2 = Hologram_CreateImage("hologram_image_illness_circle_2", cVector3f(0.23, 0.19, 0.8), cVector2f(0.3, 0.3), 0, mHologramColor_Yellow);
			mlHologramImage_IllnessBaby1 = Hologram_CreateImage("hologram_image_illness_baby_1", cVector3f(-0.23, 0.181, 0.8), cVector2f(0.3, 0.3), 0, cColor(1,0.8,0.8) * 1.8);
