			Entity_SetVarString(GetHangerName(mlHanger_PlayerAttachedId), "Attached", "");
			mlHanger_PlayerAttachedId = -1;
			PlayerBody_DetachFromEntity();
			mbHanger_ClimbingOut = false;
				
			SequenceStates_Resume("Seq_BabyMoment");
		}
		
