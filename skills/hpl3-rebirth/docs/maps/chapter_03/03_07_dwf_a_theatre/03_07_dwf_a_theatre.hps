		//-------------------------------------------------------
		
		void OnPower_PowerReciever_MuseumRoom(bool abActive, const tString&in asEntity)
		{
			if (abActive)
			{
				Seq_TurnOnMuseumCorridor("");
			}
			else
			{
				Lamp_SetLit("Lamp_EntranceCorridor_*", false, false);
				Lamp_SetLit("Lamp_EntranceSideRoom_*", false, false);
				Lamp_SetLit("Lamp_SideCorridorDoor_*", false, false);
				MovingButton_SetDisabled("Door_MaintenanceRoom_Button*", true, false);
				SlideDoor_SetOpenAmount("Door_MaintenanceRoom", 0, false);
				
				SequenceStates_Stop("Seq_TurnOnMuseumCorridor");
				mSequenceTurnOnMuseumCorridor.mlStateCounter = 0;
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTurnOnMuseumCorridor;
		void Seq_TurnOnMuseumCorridor(const tString &in asTimer)
		{
			tString sLightSound = "level_entity_shared/lights/dw_light_on";
			
			Sequence_Begin("Seq_TurnOnMuseumCorridor", mSequenceTurnOnMuseumCorridor);
			if (Sequence_DoStepAndWait(0.5))
			{
				MovingButton_SetDisabled("Door_MaintenanceRoom_Button*", false, true);
				MovingButton_SetSwitchedOn("Door_MaintenanceRoom_Button*", true, true);
				SlideDoor_SetOpenAmount("Door_MaintenanceRoom", 1, false);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("Lamp_EntranceSideRoom_*", true, true);
				Lamp_SetLit("Lamp_SideCorridorDoor_*", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "Lamp_EntranceSideRoom_1");
			}
			else if (Sequence_DoStepAndWait(0.75))
			{
				Lamp_SetLit("Lamp_EntranceCorridor_3_*", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "Lamp_EntranceCorridor_3_1");
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "Lamp_EntranceCorridor_3_2");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("Lamp_EntranceCorridor_2_*", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "Lamp_EntranceCorridor_2_1");
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "Lamp_EntranceCorridor_2_2");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Lamp_SetLit("Lamp_EntranceCorridor_1_*", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "Lamp_EntranceCorridor_1_1");
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "Lamp_EntranceCorridor_1_2");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Connect extends and open the MUSEUM*
		
		/////////////////////////////////////////
		// Event B *Explore the MUSEUM*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterMuseumArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) Music_PlayExt("A2_03_05_SafeArea", true, 0.3, 1, 3, 0, eMusicPrio_SceneAmb, true);
			else Music_Stop(3, eMusicPrio_SceneAmb);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnPlayerLookAtCoffeePot(const tString &in asEntity, int alState)
		{
			if (!mbYasminMemoryPlayed)
				Sketchbook_UnlockMemory("Memory_YasminInTheTower", true, "OnYasminMemoryPlayed" );
			mbYasminMemoryPlayed = true;
		}
		
		//-------------------------------------------------------
		
		void OnPlayerInteractCoffeePot(const tString &in asEntity)
		{
			if (!mbYasminMemoryPlayed)
				Sketchbook_UnlockMemory("Memory_YasminInTheTower", true, "OnYasminMemoryPlayed" );
			mbYasminMemoryPlayed = true;
		}
		
		//-------------------------------------------------------
		
		void OnYasminMemoryPlayed(const tString &in asScene, const tString &in asSubject)
		{
			Voice_PlayDelayed("Dialogue_AfterYasminMemory", 3.0f);
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Explore the MUSEUM*
		
		/////////////////////////////////////////
		// Event B *Explore the Theater Room and see the THEATER DOOR*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		//-------------------------------------------------------
		
		//} END Event B *Explore the Theater Room and see the THEATER DOOR*
		
		/////////////////////////////////////////
		// Event C *Move the PORTABLE EXTENDERS to power up the Theater Room*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbTheaterReciever1 = false;
		bool mbTheaterRoomOn = false;
		bool mbTheaterScanActive = true;
		bool mbTheaterHangerPrimed = false;
		bool mbYasminMemoryPlayed = false;
		int mlTheaterCorridor_ReceiversActive = 0;
		
		//-------------------------------------------------------

		void OnPower_PowerReciever_TheaterMain(bool abActive, const tString&in asEntity)
		{
			if (mbTheaterRoomOn) return;
			if (abActive)
			{
				Seq_TurnOnTheater("");
			}
			else
			{
				Lamp_SetLit("TheaterTopLight_*", false, true);
				Lamp_SetLit("TheaterWallLight_*", false, true);
				Light_SetBrightness("LightPoint_TheaterRoom*", 0.0f);
				Light_SetBrightness("Light_Spot_TheaterRoom*", 0.0f);
				
				SequenceStates_Stop("Seq_TurnOnTheater");
				mSequenceTurnOnTheater.mlStateCounter = 0;
			}
		}

		//-------------------------------------------------------
		
		void OnPower_PowerReciever_TheaterCorridor(bool abActive, const tString&in asEntity)
		{
			if (abActive) mlTheaterCorridor_ReceiversActive++;
			else mlTheaterCorridor_ReceiversActive--;
			
			if (mlTheaterCorridor_ReceiversActive > 0) Lamp_SetLit("Lamp_TheaterCorridor*", true, true);
			else Lamp_SetLit("Lamp_TheaterCorridor*", false, true);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTurnOnTheater;
		void Seq_TurnOnTheater(const tString &in asTimer)
		{
			tString sLightSound = "level_entity_shared/lights/dw_light_on";
			
			Sequence_Begin("Seq_TurnOnTheater", mSequenceTurnOnTheater);
			if (Sequence_DoStepAndWait(0.5))
			{
				cLux_AddDebugMessage("HERE1");
				Sound_Play("Sound_PowerStart_1", 0.0f);
				Sound_Play("Sound_PowerStart_2", 0.0f);
				Sound_Play("Sound_PowerStart_3", 0.0f);
				Sound_Play("Sound_PowerLoop", 0.0f);
			
				Lamp_SetLit("TheaterWallLight_1", true, true);
				Lamp_SetLit("TheaterWallLight_6", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_1");
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_6");
				
				Music_Play("A2_3_7_LabPower_Up.ogg", 0.3f, false, eMusicPrio_BigEvent);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("TheaterWallLight_2", true, true);
				Lamp_SetLit("TheaterWallLight_7", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_2");
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_7");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("TheaterWallLight_3", true, true);
				Lamp_SetLit("TheaterWallLight_8", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_3");
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_8");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("TheaterWallLight_4", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_4");
			}
			else if (Sequence_DoStepAndWait(0.75))
			{
				Lamp_SetLit("TheaterWallLight_5", true, true);
				Lamp_SetLit("TheaterWallLight_10", true, true);
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_5");
				Sound_CreateAtEntity("EntranceCorridorLight", sLightSound, "TheaterWallLight_10");
				
				Light_FadeBrightnessToDefault("Light_Spot_TheaterFloorLamp_*", 1.0f);
				Light_FadeBrightnessToDefault("LightPoint_TheaterRoom*", 1.0f);
				Light_FadeBrightnessToDefault("Light_Spot_TheaterRoom*", 1.0f);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Lamp_SetLit("TheaterTopLight_*", true, true);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				mbTheaterRoomOn = true;
				
				Sketchbook_AddIdea("exit_theater");
				Entity_SetActive("Trigger_LookAtScanTable", true);
				Entity_SetActive("Trigger_NoPermafailArea_1", true);
				SetCheckpointLeverState(true);
				SetCheckpointLeverState(true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void SetTheaterRoomState(bool abX)
		{
			if (mbTheaterRoomOn == abX) return;
			mbTheaterRoomOn = abX;
			
			if (mbTheaterRoomOn) Sketchbook_AddIdea("exit_theater");
			
			Light_FadeBrightnessToDefault("LightPoint_TheaterRoom*", 1.0f);
			Light_FadeBrightnessToDefault("Light_Spot_TheaterRoom*", 1.0f);
			
			Light_FadeBrightnessToDefault("Light_Spot_TheaterFloorLamp_*", 1.0f);
			Light_FadeBrightnessToDefault("Light_Point_Theater_*", 1.0f);
			
			Sound_Play("Sound_PowerStart_1", 0.0f);
			Sound_Play("Sound_PowerStart_2", 0.0f);
			Sound_Play("Sound_PowerStart_3", 0.0f);
			Sound_Play("Sound_PowerLoop", 0.0f);
			
			SetCheckpointLeverState(true);
			
			Lever_SetStuckState("Lever_TheaterHanger", 0, false);
			
			Entity_SetActive("Trigger_LookAtScanTable", abX);
			
//			SetHologramState(1);
			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TheaterRoomOn(const tString &in asTimer)
		{
			SetTheaterRoomState(true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_ExtenderAndEmitterDialogue(const tString &in asEntity, int alState)
		{
			Entity_SetActive("Trigger_ExtendersAndEmitterDialogue*", false);
			// This is cut - Ian
			//Voice_Play("Dialogue_ExtendersAndEmitter");
		}
		
		//-------------------------------------------------------
		
		//} END Event C *Move the PORTABLE EXTENDERS to power up the Theater Room*
		
		/////////////////////////////////////////
		// Event D *Use the machinery to scan the THEATER CORPSE*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		int mlHanger_CheckpointId = -1;
		int mlHanger_TheaterScanId = -1;
		int mlHanger_DiscardEmptyhangerId = -1;
		int mlHanger_DiscardHangerId = -1;
		int mlHanger_PlayerAttachedId = -1;
		int mlCheckpointScanCount = 0;
		cColor mCheckpointColor_Scan = cColor(0.23,0.901,1);
		cColor mCheckpointColor_NoCorpse = cColor(1,0.1,0.0);
		bool mbHanger_CanClimbOut = true;
		bool mbHanger_ClimbingOut = false;
		bool mbHanger_GettingIn = false;
		bool mbHanger_CanClimbIn = false;
		bool mbCheckpointExtraPlayerScan = false;
		bool mbCorpseBroughtIn = false;
		bool mbCheckpointScanActive = false;
		cVector3f mvTheaterHangerMove_PlayerDropPos;
		bool mbTheaterScanUnlockLever = false;
		tID m_idScannerLampPS = tID_Invalid;
		eScanbedLeverState mScanbedLeverState = eScanbedLeverState_None;
		tID m_idScanner = tID_Invalid;
		int mlHangersDiscarded = 0;
		bool mbHangerHintEnabled = true;
		int mlHangerAreaCount = 0;
		
		//-------------------------------------------------------
		
		void InitScan()
		{
			m_idScanner = Map_GetEntity("TheaterScanner").GetID();
		}
		
		//-------------------------------------------------------
		
		void UpdateScan(float afTimeStep)
		{
			if (m_idScannerLampPS != tID_Invalid)
			{
				cNode3D@ pSocket = cLux_ID_Entity(m_idScanner).GetMeshEntity().GetSocket("socket_particles");
				if (pSocket !is null) cLux_ID_ParticleSystem(m_idScannerLampPS).SetMatrix(pSocket.GetWorldMatrix());
			}
		}
		
		//-------------------------------------------------------
		
		void UpdateDiscardHangerCounter()
		{
			if (mbHangerHintEnabled == false) return;
			++mlHangersDiscarded;
			if (mlHangersDiscarded >= 4) Map_AddTimer("OnTimer_EnableHangerHints", 300, "OnTimer_EnableHangerHints");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableHangerHints(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_LookAtHanger", true);
		}
		
		//-------------------------------------------------------
		
		tString GetHangerName(int alId)
		{
			return "Hanger_Theater_" + alId;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterHangerArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlHangerAreaCount += alState;
			SetHangerTrigger(1);
			return true;
		}
		
		//-------------------------------------------------------
		
		void SetHangerTrigger(int alId)
		{
			bool bCanEnter = mlHangerAreaCount > 0 && mbHanger_CanClimbIn;			
			Entity_SetActive("Trigger_EnterHanger_" + alId, bCanEnter);
		}
		
		//-------------------------------------------------------
		
		void OpenHangerArms(int alId, bool abChangeState = true, bool abVisual = true)
		{
			if (abVisual) Entity_PlayAnimation(GetHangerName(alId), "open_arms", 0, false, false);
			if (abChangeState) Map_AddTimer("Timer_EnableClimbOut_" + alId, 0.5, "OnTimer_EnableClimbOut");
		}
		
		//-------------------------------------------------------
		
		void SetScanbedLeverState(eScanbedLeverState aState, bool abInstant = false)
		{
			if (mScanbedLeverState == aState) return;
			mScanbedLeverState = aState;
			
			int lLeverState = 0;
			if (mScanbedLeverState == eScanbedLeverState_InactiveLockedBack) lLeverState = 1;
			else if (mScanbedLeverState == eScanbedLeverState_InactiveLockedForward) lLeverState = -1;
			Lever_SetStuckState("Lever_Scanbed", lLeverState, !abInstant);
			Entity_SetEffectsActive("Lever_Scanbed", mScanbedLeverState == eScanbedLeverState_ActiveUnlocked, !abInstant);
			if (mScanbedLeverState == eScanbedLeverState_ActiveUnlocked) Sound_CreateAtEntity("LeverReleased", "level_entity_shared/levers/thatre_lever/lever_start", "Lever_Scanbed", 0, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableClimbOut(const tString &in asTimer)
		{
			mbHanger_CanClimbOut = true;
			mbHanger_CanClimbIn = true;
			SetHangerTrigger(cString_GetNumericSuffixInt(asTimer, -1));
		}
		
		//-------------------------------------------------------
		
		void CloseHangerArms(int alId, bool abChangeState = true, bool abVisual = true)
		{
			if (abVisual) Entity_PlayAnimation(GetHangerName(alId), "close_arms", 0, false, false);
			if (abChangeState)
			{
				mbHanger_CanClimbOut = false;
				mbHanger_CanClimbIn = false;
				SetHangerTrigger(alId);
			}
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Hanger(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			
			Voice_Play("Dialogue_Hanger_Reminder");
		}
		
		//-------------------------------------------------------
		
		bool mbCheckpointLeverActive = true;
		void SetCheckpointLeverState(bool abActive, bool abInstant = false)
		{
			if (mbCheckpointLeverActive == abActive) return;
			mbCheckpointLeverActive = abActive;
			
			Lamp_SetLit("Indicator_Lever_Checkpoint", abActive, !abInstant);
			Lever_SetStuckState("Lever_Checkpoint", abActive ? 0 : 1, !abInstant);
			if (abActive) FlashButton("Indicator_Lever_Checkpoint", Entity_GetEffectBaseColor("Indicator_Lever_Checkpoint"), 1.5, 0.5, true);
			else StopBlinkButton("Indicator_Lever_Checkpoint", true);
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_HangerLever(const tString &in asEntity, int alState)
		{
			if (alState == 1 && mbCheckpointLeverActive)
			{
				SetCheckpointLeverState(false);
				mlHanger_CheckpointId = 1;
				Seq_CheckpointScan("");
			}

		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceCheckpointScan;
		void Seq_CheckpointScan(const tString &in asTimer)
		{
			tString sHanger = GetHangerName(mlHanger_CheckpointId);
			
			Sequence_Begin("Seq_CheckpointScan", mSequenceCheckpointScan);
			if (Sequence_DoStepAndWait(0.5))
			{
				Entity_SetActive("TheaterCorpse", false);
				Entity_SetActive("Blocker_Corpse", false);
				Entity_RemoveEntityAttachment("TheaterCorpse");
				Entity_SetVarString(sHanger, "Attached", "");
				
				// stop sequence if hanger is already being discarded
				SequenceStates_Stop("Seq_DiscardHanger");
				mSequenceDiscardHanger.mlStateCounter = 0;
				SequenceStates_Stop("Seq_DiscardEmptyHanger");
				mSequenceDiscardEmptyHanger.mlStateCounter = 0;
				
				// setup hanger
				{
					Entity_SetActive(sHanger, true);
					Entity_SetActive("Hanger_Collision_" + mlHanger_CheckpointId, true);
					
					Entity_PlayAnimation(sHanger, "start_to_checkpoint", 0, false, false);
					cAnimationState@ pAnim = Map_GetEntity(sHanger).GetMeshEntity().GetAnimationStateFromName("start_to_checkpoint");
					pAnim.SetPaused(true);
					
					CloseHangerArms(mlHanger_CheckpointId, true, true);
					
					cMatrixf mtxLocal = cMatrixf_Identity;
					mtxLocal.SetTranslation(cVector3f(0,0.9,0.25));
					cMatrixf mtxWorld = Map_GetEntity(sHanger).GetMeshEntity().GetSocket("socket_victim").GetWorldMatrix();
					mtxWorld = cMath_MatrixMul(mtxWorld, mtxLocal);
					
					iLuxEntity@ pEnterTrigger = Map_GetEntity("Trigger_EnterHanger_" + mlHanger_CheckpointId);
					pEnterTrigger.SetMatrix(mtxWorld);
					Entity_AttachToSocket("Trigger_EnterHanger_" + mlHanger_CheckpointId, sHanger, "socket_victim", true, false);
					
					iLuxEntity@ pLookAtTrigger = Map_GetEntity("Trigger_LookAtHanger");
					pLookAtTrigger.SetMatrix(mtxWorld);
					Entity_AttachToSocket("Trigger_LookAtHanger", sHanger, "socket_victim", true, false);
				}
				
				// setup corpse
				if (mbCorpseBroughtIn == false)
				{ 
					mbCorpseBroughtIn = true;
					
					Entity_SetVarString(sHanger, "Attached", "corpse");
					Entity_SetActive("TheaterCorpse", true);
					Entity_SetActive("Blocker_Corpse", true);
					Entity_PlayAnimation("TheaterCorpse", "dead_theater", 0, false, false);
					Entity_AttachToSocket("TheaterCorpse", sHanger, "socket_victim", true, true);
//					cAnimationState@ pAnim = Map_GetEntity("TheaterCorpse").GetMeshEntity().GetAnimationStateFromName("temp_torture_defreeze");
//					pAnim.SetPaused(true);
				}
				else
				{
					Entity_SetActive("Victim_PitOfBodies", true);
					Entity_PlayAnimation("Victim_PitOfBodies", "dead_pit", 0);
				}
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("Lamp_CheckpointDoor", true, true);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Lamp_SetFlickerActive("Lamp_CheckpointDoor", true);
				SlideDoor_SetOpenAmount("Door_Checkpoint", 1, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_SetAnimationMessageEventCallback(sHanger, "OnAnimEvent_ResumeCheckpointScan", false);
				Entity_PlayAnimation(sHanger, "start_to_checkpoint", 0, false, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				SlideDoor_SetOpenAmount("Door_Checkpoint", 0, false);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Lamp_SetLit("Lamp_CheckpointDoor", false, true);
				
				Entity_SetAnimationMessageEventCallback(sHanger, "", true);
				bool bHangerEmpty = Entity_GetVarString(sHanger, "Attached") == "";
				
				OpenHangerArms(mlHanger_CheckpointId, bHangerEmpty, true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				mlCheckpointScanCount = 0;
				mbCheckpointExtraPlayerScan = false;
				mbCheckpointScanActive = true;
				Map_AddTimer("Timer_CheckpointScanOn", 0.5, "OnTimer_CheckpointScanOn");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEvent_ResumeCheckpointScan(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			SequenceStates_Resume("Seq_CheckpointScan");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckpointScanOn(const tString &in asTimer)
		{
			if (mbHanger_GettingIn)
			{
				Map_RestartCurrentTimer(0.4f);
				return;	
			}
			
			++mlCheckpointScanCount;
			if (Entity_GetVarString(GetHangerName(mlHanger_CheckpointId), "Attached") == "player")
			{
				if (mbCheckpointExtraPlayerScan == false)
				{
					mbCheckpointExtraPlayerScan = true;
				}
				else if (mlCheckpointScanCount > 1)
				{
					Entity_SetActive("Trigger_LookAtScanTable", false);
					mbCheckpointScanActive = false;
					mlHanger_TheaterScanId = mlHanger_CheckpointId;
					Seq_TheaterScan("");
					return;
				}
				
			}
			else if (mlCheckpointScanCount > 2 && Entity_GetVarString(GetHangerName(mlHanger_CheckpointId), "Attached") == "corpse")
			{
				mbCheckpointScanActive = false;
				mlHanger_TheaterScanId = mlHanger_CheckpointId;
				Seq_TheaterScan("");
				return;
			}
			else if (mlCheckpointScanCount == 5)
			{
				CloseHangerArms(mlHanger_CheckpointId, true, false);
			}
			else if (mlCheckpointScanCount > 5)
			{
				mbCheckpointScanActive = false;
				mlHanger_DiscardEmptyhangerId = mlHanger_CheckpointId;
				Seq_DiscardEmptyHanger("");
				return;
			}
			
			bool bSuccess = mlCheckpointScanCount <= 4 || mbCheckpointExtraPlayerScan;
			cColor aLightColor = bSuccess ? mCheckpointColor_Scan : mCheckpointColor_NoCorpse;
			Map_GetEntity("CheckpointScanner").SetEffectBaseColor(aLightColor);
			
			Lamp_SetLit("CheckpointScanner", true, true);
			Light_SetBrightness("Light_CheckpointScanner*", 0);
			Light_FadeBrightnessToDefault("Light_CheckpointScanner*", 1);
			
			if (bSuccess) Sound_CreateAtEntity("CheckpointScan", "03_07_dw_factory/baby_scanner/scan_check", "CheckpointScanner");
			else Sound_CreateAtEntity("CheckpointScanFailure", "03_07_dw_factory/baby_scanner/scan_check_negative", "CheckpointScanner");
		
			array<iLight@> vLights;
			Map_GetLightArray("Light_CheckpointScanner*", vLights);
			for (int i = 0; i < vLights.size(); ++i)
			{
				iLight@ pLight = vLights[i];
				pLight.SetDiffuseColor(aLightColor);
			}
			
			Map_AddTimer("Timer_CheckpointScanOff", 2, "OnTimer_CheckpointScanOff");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckpointScanOff(const tString &in asTimer)
		{
			Lamp_SetLit("CheckpointScanner", false, true);
			Light_FadeBrightnessTo("Light_CheckpointScanner*", 0, 0.75);
			Sound_Stop("CheckpointScan", 0.5);
			
			Map_AddTimer("Timer_CheckpointScanOn", 0.75, "OnTimer_CheckpointScanOn");
		}
		
		//-------------------------------------------------------
		
