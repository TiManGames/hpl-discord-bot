		}
		else if (Sequence_DoStepAndWait(0.05))
		{
			for (int i = 0; i < mvHologramImage_FlickerInIds.size(); ++i) Hologram_SetImageBrightness(mvHologramImage_FlickerInIds[i], 0.1, 0.05);
		}
		else if (Sequence_DoStepAndWait(0.1))
		{
			for (int i = 0; i < mvHologramImage_FlickerInIds.size(); ++i) Hologram_SetImageBrightness(mvHologramImage_FlickerInIds[i], 0.5, 0.1);
		}
