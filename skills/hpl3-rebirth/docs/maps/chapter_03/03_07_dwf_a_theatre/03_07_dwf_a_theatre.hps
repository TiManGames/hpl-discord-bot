		void OnInteract_ShowScanInfo(const tString &in asEntity)
		{
			if (Entity_GetVarBool(asEntity, "ButtonActive") == false) return;
			SetButtonActive(asEntity, false);
			Map_RemoveTimer("Timer_PulseBabyDanger");
			
			Seq_BabyDanger("");
