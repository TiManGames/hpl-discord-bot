		//-------------------------------------------------------
		
		void UpdateBabyScan(float afTimeStep)
		{
			if (mbHologram_Active == false) return;
			float fSliderValue = 1.0f - Slide_GetSlideAmount("HologramSlider");
			
			if (mbHologram_ResetPosition)
			{
				mfHologram_LeverValue = cMath_IncreaseTo(mfHologram_LeverValue, 1 * afTimeStep, 0.0);
				Slide_SetSlideAmount("HologramSlider", 1.0f - mfHologram_LeverValue);
				if (mfHologram_LeverValue == 0) mbHologram_ResetPosition = false;
			}
			else if (mbHologram_IntroFlicker)
			{
				if (mlHologram_IntroFlickerStage == 0)
				{
					mfHologram_LeverValue = cMath_IncreaseTo(mfHologram_LeverValue, 1 * afTimeStep, 1.0);
					Slide_SetSlideAmount("HologramSlider", 1.0f - mfHologram_LeverValue);
					if (mfHologram_LeverValue == 1.0) mlHologram_IntroFlickerStage = 1;
				}
				else if (mlHologram_IntroFlickerStage == 1)
				{
					mfHologram_LeverValue = cMath_IncreaseTo(mfHologram_LeverValue, 1 * afTimeStep, 0.60);
					Slide_SetSlideAmount("HologramSlider", 1.0f - mfHologram_LeverValue);
					if (mfHologram_LeverValue == 0.60)
					{
//						Map_GetEntity("HologramSlider").GetMainBody().SetLinearVelocity(cVector3f_Zero);
//						Map_GetEntity("HologramSlider").GetMainBody().SetAngularVelocity(cVector3f_Zero);
						mbHologram_IntroFlicker = false;
					}
				}
			}
//			else if (mbHologram_BabyMoment == false)
//			{
//				float fPrevValue = mfHologram_LeverValue;
//				mfHologram_LeverValue = cMath_InterpolateLinear(mfHologram_LeverValue, cMath_Clamp(fSliderValue, 0.0f, 0.99f), 1.5f * afTimeStep);
//				
//				if (cMath_Abs(fPrevValue - mfHologram_LeverValue) <= 0.0001f)
//				{
//					SetHologramStandPulsing(false);
//					cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idHologram_Sound);
//					if (pSound !is null) pSound.FadeVolumeMul(0, 2);
//				}
//				else
//				{
//					SetHologramStandPulsing(true);
//					cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idHologram_Sound);
//					if (pSound !is null) pSound.FadeVolumeMul(1, 2);
//				}
//				
//			}
			
			cVector3f vStandPos = cLux_ID_Entity(m_idHologram_RightEnt0).GetPosition() * (1.0f - mfHologram_LeverValue) + cLux_ID_Entity(m_idHologram_RightEnt1).GetPosition() * mfHologram_LeverValue;
			iLuxEntity@ pRightStand = cLux_ID_Entity(m_idHologram_RightEnt);
			pRightStand.SetPosition(vStandPos);
															
			float fSectionSize = 1.0f / (mlHologram_Images - 1);
			int lSection = cMath_Floor(mfHologram_LeverValue / fSectionSize) + 1;
			float fSectionProgress = cMath_Clamp((mfHologram_LeverValue % fSectionSize) / fSectionSize, 0.0f, 1.0f);
			
			int lImageIndex1 = lSection;
			int lImageIndex2 = lSection + 1;
			float fImageAlpha1 = 1.0f - fSectionProgress;
			float fImageAlpha2 = fSectionProgress;
			
			for (int i = 0; i < mlHologram_Images; ++i)
			{	
				float fTarget = 0.0f;
				if (mbHologramScan_Active == false) fTarget = 0;
				else if (lImageIndex1 - 1 == i) fTarget = fImageAlpha1 * 3;
				else if (lImageIndex2 - 1 == i) fTarget = fImageAlpha2 * 3;
								
				float fTasiTarget = mlHologram_State == 3 ? fTarget : 0;
				float fTasiOldBrightness = mvHologram_Brightness[i];
				float fTasiBrightness = cMath_IncreaseTo(fTasiOldBrightness, 3.0 * afTimeStep, fTasiTarget);
				if (fTasiBrightness != fTasiOldBrightness)
				{
					mvHologram_Brightness[i] = fTasiBrightness;
					cBillboard@ pTasiScan = cLux_ID_Billboard(mvHologram_BillboardsTasi[i]);
					pTasiScan.SetBrightness(fTasiBrightness);
					pTasiScan.SetPosition(pRightStand.GetPosition() + mvHologram_HologramOffset);
				}
				
				float fVictimTarget = mlHologram_State == 2 ? fTarget : 0;
				float fVictimOldBrightness = mvHologram_Brightness[i + mlHologram_Images];
				float fVictimBrightness = cMath_IncreaseTo(fVictimOldBrightness, 3.0 * afTimeStep, fVictimTarget);
				if (fVictimBrightness != fVictimOldBrightness)
				{
					mvHologram_Brightness[i + mlHologram_Images] = fVictimBrightness;
					cBillboard@ pVictimScan = cLux_ID_Billboard(mvHologram_BillboardsVictim[i]);
					pVictimScan.SetBrightness(fVictimBrightness);
					pVictimScan.SetPosition(pRightStand.GetPosition() + mvHologram_HologramOffset);
				}
			}
			
			cBillboard@ pRedSpot = cLux_ID_Billboard(m_idHologram_RedSpot);
			pRedSpot.SetPosition(pRightStand.GetPosition() + mvHologram_RedSpotOffset);
						
//			if (mlHologram_State == 3 && mbHologram_BabyLookedAt && mfHologram_LeverValue >= 0.55f && mfHologram_LeverValue <= 0.80f)
//			{
//				mfHologram_BabyLookCounter += afTimeStep;
//				if (mfHologram_BabyLookCounter >= 0.75f)
//				{
//					StartTheaterBabyMoment();
//				}
//			}
//			else
//			{
//				mfHologram_BabyLookCounter = 0;
//			}
		}
		

		//-------------------------------------------------------
		
		void ResetHologramPosition()
		{
			mbHologram_ResetPosition = true;
		}
		
		void StartHologramFlicker()
		{
			mbHologram_IntroFlicker = true;
			mfHologram_LeverValue = 0;
			mlHologram_IntroFlickerStage = 0;
		}
		
		bool mbHologram_AdjustingFraming = false;
		cColor mHologram_DefaultStandColor;
		
		void OnInteract_HologramSlider(const tString &in asEntity)
		{
			if (Entity_GetVarBool("HologramSlider", "SliderLocked")) return;
			if (mbHologram_AdjustingFraming == false)
			{
				mbHologram_AdjustingFraming = true;
				
				Player_StartLookAt("Target_Hologram", 0.5f, 0.8f, 1.0f, true);
				cLux_GetPlayer().AutomoveCharBodyTo(1.0f, 1.0f, 1.0f, Map_GetEntity("Target_HologramBabyStand").GetPosition());
				Player_SetMoveSpeedMul(0.0f);
				
				Map_AddTimer("Timer_CheckHologramSlider", 0, "OnTimer_CheckHologramSlider");
			}
		}
		
		void OnTimer_CheckHologramSlider(const tString &in asTimer)
		{
			if (Entity_IsInteractedWith("HologramSlider") == false)
			{				
				mbHologram_AdjustingFraming = false;
				Player_StopLookAt(0.5f);
				cLux_GetPlayer().StopAutomoveCharBody();
				Player_SetMoveSpeedMul(1.0f);
				return;
			}
			Map_AddTimer("Timer_CheckHologramSlider", 0.1f, "OnTimer_CheckHologramSlider");
		}
		
		
		//-------------------------------------------------------
		
		void SetHologramState(int alState, bool abInstant = false)
		{
			mlHologram_State = alState;
			
//			mbHologram_Active = alState >= 1;
			mbHologramScan_Active = alState >= 2;
			Entity_SetEffectsActive("TheaterHologramStand", alState >= 1, !abInstant);
			Billboard_SetVisible("Billboard_TheaterHologram_Victim", alState == 2);
			Billboard_SetVisible("Billboard_TheaterHologram_Tasi", alState == 3 || alState == 4);
//			Billboard_SetVisible("Billboard_TheaterHologram_TasiWarning", alState == 4);
			Billboard_SetVisible("Billboard_TheaterHologram_TasiWarning", false);
			Billboard_SetVisible("Billboard_TheaterHologram_TasiBabyIlnessInfo", alState == 5);
		}
		
		//-------------------------------------------------------
		
		bool mbHologram_StandPulsing = false;
		
		void SetHologramStandPulsing(bool abX)
		{
			if (abX == mbHologram_StandPulsing) return;
			mbHologram_StandPulsing = abX;
			
			if (mbHologram_StandPulsing)
			{
				Map_AddTimer("Timer_PulseHologramStandOn", 0, "OnTimer_PulseHologramStandOn");
			}
			else
			{
				Map_RemoveTimer("Timer_PulseHologramStandOn");
				Map_RemoveTimer("Timer_PulseHologramStandOff");
				Map_GetEntity("TheaterHologramStand_Left").StopEffectBaseColorFade();
				Map_GetEntity("TheaterHologramStand_Right").StopEffectBaseColorFade();
				Entity_FadeEffectBaseColor("TheaterHologramStand_*", mHologram_DefaultStandColor, 0.2);
			}
		}
		
		void OnTimer_PulseHologramStandOn(const tString &in asTimer)
		{
			Entity_FadeEffectBaseColor("TheaterHologramStand_*", mHologram_DefaultStandColor * 1.3, 0.4);
			Map_AddTimer("Timer_PulseHologramStandOff", 0.32, "OnTimer_PulseHologramStandOff");
		}
		
		void OnTimer_PulseHologramStandOff(const tString &in asTimer)
		{
			Entity_FadeEffectBaseColor("TheaterHologramStand_*", mHologram_DefaultStandColor, 0.4);
			Map_AddTimer("Timer_PulseHologramStandOn", 0.32, "OnTimer_PulseHologramStandOn");
		}
		
		//-------------------------------------------------------
		
		void SetHologramLeverState(bool abActive, bool abLocked)
		{
			bool bStuck = abActive == false || abLocked;
			Slide_SetSlideAmount("HologramSlider", 0.5);
			Entity_SetEffectsActive("HologramSlider", !bStuck, false);
			Entity_SetVarBool("HologramSlider", "SliderLocked", bStuck);
			Map_AddTimer("Timer_LockHologramSlider", 0.1, "OnTimer_LockHologramSlider");
		}
		
		void OnTimer_LockHologramSlider(const tString &in asTimer)
		{
			Slide_SetJammed("HologramSlider", Entity_GetVarBool("HologramSlider", "SliderLocked"));
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_ScanTable(const tString &in asEntity, int alState)
		{
			if (mbTheaterRoomOn == false) return;
			Voice_Play("Dialogue_ScanTable");
		}
		
		cSequenceStatesData mSeq_TheaterScanFail;
		void Seq_TheaterScanFail(const tString &in asTimer)
		{
			Sequence_Begin("Seq_TheaterScanFail", mSeq_TheaterScanFail);
			if (Sequence_DoStepAndWait(1))
			{
				float fSpeed = 2;
				Prop_MoveLinearTo("TheaterScanner", "Target_TheaterScanner_1", fSpeed, fSpeed, 0.0, true, "");
				Prop_MoveLinearTo("TheaterScannerHolder_Main", "Target_TheaterScannerHolder_1", fSpeed, fSpeed, 0.0, true, "");
			}
			else
			{
				float fSpeed = 2;
				Sound_CreateAtEntity("ScanFail", "03_07_dw_factory/torture_victim/machine_feedback/button_negative", "TheaterScanner_Light");
				Prop_MoveLinearTo("TheaterScanner", "Target_TheaterScanner_0", fSpeed, fSpeed, 0.0, false, "");
				Prop_MoveLinearTo("TheaterScannerHolder_Main", "Target_TheaterScannerHolder_0", fSpeed, fSpeed, 0.0, false, "");
				
				--mlLeverLocks;
				Lever_SetStuckState("Lever_TheaterHanger", 0, false);
				SetHangerLeverState(true, false);
			}
			Sequence_End();
		}

		void OnLookAt_HologramBaby(const tString &in asEntity, int alState)
		{
			mbHologram_BabyLookedAt = alState == 1;
		}
		
		// THIS APPEARS TO NOT BE CALLED ANY MORE
		// SO I MOVED THE SetBabyTalkStage and Sketchbook_ lines to Seq_BabyMoment
		// - Ian
		void StartTheaterBabyMoment()
		{
			if (mbHologram_IntroFlicker) return;
			if (mbHologram_BabyMomentDone) return;
			if (mbHologram_BabyMoment) return;
			mbHologram_BabyMoment = true;
			
			Sketchbook_CompleteIdea("exit_theater");
			Sketchbook_AddIdea("find_babyhelp");
			
			Pregnancy_SetBabyTalkStage(eBabyTalkStage_DWF_AfterScan);
			
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			Player_ChangeStateToNormal();
			mbHologram_AdjustingFraming = false;
			Player_StopLookAt(0.0f);
			cLux_GetPlayer().StopAutomoveCharBody();
			Player_SetMoveSpeedMul(1.0f);
			Map_RemoveTimer("Timer_CheckAjustHologramInteract");
			
			PlayerBody_PlayCutsceneAtEntity("player_babyscan", "Target_BabyScanReactionAnim", false, 1.0f, "OnAnimEnd_BabyMoment");
			Map_AddTimer("Timer_TheaterBabyMoment_2", 0.5f, "OnTimer_TheaterBabyMoment_2");
			
			return;
			Player_SetInteractionAllowed(false);
			Player_ChangeStateToNormal();
			
			Player_SetLookSpeedMul(0.2f);
			Player_StartLookAt("Target_HologramBaby", 0.5f, 0.8f, 1.0f, true);
			
			cLux_GetPlayer().AutomoveCharBodyTo(1.0f, 1.0f, 1.0f, Map_GetEntity("Target_HologramBabyStand").GetPosition());
			Player_SetMoveSpeedMul(0.0f);
			
			Map_RemoveTimer("Timer_CheckAjustHologramInteract");
			Map_AddTimer("Timer_TheaterBabyMoment_2", 0.5f, "OnTimer_TheaterBabyMoment_2");
		}
		
