	//-------------------------------------------------------
	
	void Hologram_FadeInImage(int alId, float afFadeTime, eEasing aEasing = eEasing_Linear)
	{
		Hologram_SetImageActive(alId, true);
		Hologram_SetImageBrightness(alId, 0);
		Hologram_SetImageBrightness(alId, 1, afFadeTime, aEasing);
	}
	
	//-------------------------------------------------------
	
	void Hologram_FadeOutImage(int alId, float afFadeTime, eEasing aEasing = eEasing_Linear)
	{
		Hologram_SetImageBrightness(alId, 0, afFadeTime, aEasing);
		Map_AddTimer(""+alId, afFadeTime, "OnTimer_FadeOutImage");
	}
	
	void OnTimer_FadeOutImage(const tString &in asTimer)
	{
		int lId = cString_ToInt(asTimer, -1);
		Hologram_SetImageActive(lId, false);
	}
	
	//-------------------------------------------------------
	
	void UpdateHologram(float afTimeStep)
	{
		if (mbHologram_Active == false) return;

		//////////////////
		// Update images
		for (int i = 0; i < mvHologram_Animations.size(); ++i)
		{
			cDWHologramAnimation@ pAnim = mvHologram_Animations[i];
			cDWHologramImage@ pImage = mvHologram_Images[pAnim.mlImageId];
			if ((pAnim.mbRepeat == false && pAnim.mfAlpha == 1.0f) || pImage is null)
			{
				mvHologram_Animations.removeAt(i);
				--i;
				continue;
			}
			
			// reverse direction when repeating
			if (pAnim.mbRepeat &&
				((pAnim.mbRepeatDirFwd && pAnim.mfAlpha == 1.0f) ||
				(pAnim.mbRepeatDirFwd == false && pAnim.mfAlpha == 0.0f)))
					pAnim.mbRepeatDirFwd = !pAnim.mbRepeatDirFwd;
						
			// figure how much to add this frame
			float fAddAlpha = 1;
			if (pAnim.mfTime > 0) fAddAlpha = (1.0f / pAnim.mfTime) * afTimeStep;
			
			// don't go over 1
			if (pAnim.mbRepeat == false || (pAnim.mbRepeat && pAnim.mbRepeatDirFwd)) fAddAlpha = cMath_Min(fAddAlpha, 1.0f - pAnim.mfAlpha);
			else fAddAlpha = cMath_Min(fAddAlpha, pAnim.mfAlpha);
			
			// add negative alpha when reversing
			if (pAnim.mbRepeat && pAnim.mbRepeatDirFwd == false) fAddAlpha *= -1;
			
			float fAddEasedAlpha = cMath_Easing(pAnim.mEasing, pAnim.mfAlpha + fAddAlpha) - cMath_Easing(pAnim.mEasing, pAnim.mfAlpha); // apply easing only to effects, not mfAlpha
			pAnim.mfAlpha += fAddAlpha;
									
			// add values to image attributes
			Hologram_AddAttributes(pImage, pAnim.mAdd, fAddEasedAlpha);
		}
		
		//////////////////
		// Flicker
		mfHologram_FlickerTimer -= afTimeStep;
		if (mfHologram_FlickerTimer < 0.0f)
		{
			mfHologram_FlickerTimer = cMath_RandRectf(0.02, 0.08);
			mfHologram_Brightness = cMath_RandRectf(0.9f, 1.0f);
		}
	}
	
	//-------------------------------------------------------
	
	void Hologram_AddAttributes(cDWHologramImage@ apImage, cDWHologramAnimAttributes apAdd, float afAlpha)
	{
		apImage.mvPos += apAdd.mvPos * afAlpha;
		apImage.mvSize += apAdd.mvSize * afAlpha;
		apImage.mfRotation += apAdd.mfRotation * afAlpha;
		apImage.mfBrightness += apAdd.mfBrightness * afAlpha;
		apImage.mColor = apImage.mColor + apAdd.mColor * afAlpha;
	}
	
	//-------------------------------------------------------
	
	void OnGui_Hologram(const tString&in asEntityName, float afTimeStep)
	{
		for (int i = 0; i < mvHologram_Images.size(); ++i)
		{
			cDWHologramImage@ pImage = mvHologram_Images[i];
			if (pImage.mbActive == false) continue;
			
			// flicker pos
			if (pImage.mfFlickerPosDist > 0)
			{
				pImage.mfFlickerPosTimer -= afTimeStep;
				if (pImage.mfFlickerPosTimer < 0.0f)
				{
					pImage.mfFlickerPosTimer = cMath_RandRectf(0.05, 0.12);
					pImage.mvFlickerPosOffset = cMath_RandRectVector2f(cVector2f_One * -pImage.mfFlickerPosDist, cVector2f_One * pImage.mfFlickerPosDist);
				}
			}
			
			cImGuiGfx image = cImGuiGfx(pImage.msImage, eGuiMaterial_Additive, eImGuiGfx_Texture);
			
			float fFlickerDiff = cMath_Clamp((1.0f - mfHologram_Brightness) * pImage.mfFlickerMul, 0.0f, 1.0f);
			float fFlickerMul = 1.0f - fFlickerDiff;
			
			image.mColor = pImage.mColor * pImage.mfBrightness * fFlickerMul;
			
			cVector2f vOffset = ImGui_NrmSize(pImage.mvSize) - ImGui_NrmSize(cVector2f(1,1));
			image.mvOffset = cVector3f(vOffset.x, vOffset.y, 0) * -0.5f;
			
			cVector3f vPos = pImage.mvPos;
			vPos.x += pImage.mvFlickerPosOffset.x;
			vPos.y += pImage.mvFlickerPosOffset.y;
			
			ImGui_SetModRotateAngle(pImage.mfRotation);
			ImGui_DoImageCorrectAspect(image, ImGui_NrmPos(vPos), ImGui_NrmSize(pImage.mvSize));
			ImGui_SetModRotateAngle(0);
		}
	}
	
