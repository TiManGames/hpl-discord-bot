			mlHologramImage_IllnessGlyph1 = Hologram_CreateImage("hologram_image_illness_glyph", cVector3f(-0.32, 0.285, 0.8), cVector2f(0.1, 0.1), 0, cColor(1.0, 0, 0) * 15);
			mlHologramImage_IllnessGlyph2 = Hologram_CreateImage("hologram_image_illness_glyph", cVector3f(0.34, 0.292, 0.8), cVector2f(0.1, 0.1), 0, cColor(1.0, 0, 0) * 15);
