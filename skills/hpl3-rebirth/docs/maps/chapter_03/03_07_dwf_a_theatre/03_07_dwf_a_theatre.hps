		//-------------------------------------------------------
		
		tID m_idBabyMoment_WarninBillboard;
		float mfBabyMoment_WarningBillboardOriginalBrightness = 0;
		bool mbBabyMoment_WarningPulse = false;
		bool mbBabyMoment_WarningPulseForward = true;
		float mfBabyMoment_WarningTimer = 0;
		
		//-------------------------------------------------------
		
		void UpdateBabyMoment(float afTimeStep)
		{
			if (mbBabyMoment_WarningPulse)
			{
				float fSpeed = 1.5f;
				if (mbBabyMoment_WarningPulseForward) mfBabyMoment_WarningTimer += fSpeed * afTimeStep;
				else mfBabyMoment_WarningTimer -= fSpeed * afTimeStep;
				mfBabyMoment_WarningTimer = cMath_Clamp(mfBabyMoment_WarningTimer, 0.0f, 1.0f);
				if (mfBabyMoment_WarningTimer == 1 || mfBabyMoment_WarningTimer == 0) mbBabyMoment_WarningPulseForward = !mbBabyMoment_WarningPulseForward;
				
				float fBrightnessAdd = cMath_Easing(eEasing_QuadInOut, mfBabyMoment_WarningTimer, 0.0f, 1.0f) * 100;
				cLux_ID_Billboard(m_idBabyMoment_WarninBillboard).SetBrightness(mfBabyMoment_WarningBillboardOriginalBrightness + fBrightnessAdd);
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceBabyMoment;
		void Seq_BabyMoment(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BabyMoment", mSequenceBabyMoment);
			if (Sequence_DoStepAndWait(1.4))
			{
				// disable hanger hint
				mbHangerHintEnabled = false;
				Entity_SetActive("Trigger_LookAtHanger", false);
				
				Entity_SetVarString(GetHangerName(mlHanger_PlayerAttachedId), "Attached", "");
				
				Music_Play("A2_3_7_Scan_Reveal.ogg", 0.3f, false, eMusicPrio_BigEvent);
							
				PlayerBody_DetachFromEntity();
				mbHanger_ClimbingOut = false;
				
				PlayerBody_SetCutsceneMaxPitch(20);
				PlayerBody_SetCutsceneMaxYaw(40);
				PlayerBody_PlayCutsceneAtSocket("player_climb_out_hanger", GetHangerName(mlHanger_PlayerAttachedId), "socket_player", false, 0);
				
				mlHanger_PlayerAttachedId = -1;
				
				Voice_PlayDelayed("Dialogue_TheScan", 2);
				
//				PlayerBody_PlayCutsceneAtSocket("player_climb_out_hanger", GetHangerName(mlHanger_PlayerAttachedId), "socket_victim", false, 0.25, "OnAnimEnd_BabyMoment_ClimedOut");
				Sound_CreateAtEntity("Sound_HangerBabyExit", "03_07_dw_factory/animation/hanger_baby_exit", "player");
				
			}
			else if (Sequence_DoStepAndPause(6))
			{
				PlayerBody_PlayCutsceneAtEntity("looks_at_baby_scan", "Target_BabyScanAnims", false, 0.3, "OnAnimEnd_BabyMoment_LooksAtBabyScan");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
//				SetHologramState(4);

				Hologram_StopIdle();
				
				SetButtonActive("Button_ScanInfo", true);
				SetButtonColor("Button_ScanInfo", mButtonColor_Red);
				
				Hologram_FlickerInImage(mlHologramImage_ButtonAlert);
				
				Map_AddTimer("Timer_PulseBabyDanger", 0.0, "OnTimer_PulseBabyDanger");
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Voice_StopAll();
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Voice_Play("Dialogue_LullabyInterrupted");
			}
			Sequence_End();
		}
		
