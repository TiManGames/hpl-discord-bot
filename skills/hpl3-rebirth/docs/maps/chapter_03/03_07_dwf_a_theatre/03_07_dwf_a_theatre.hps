		bool mbTheaterHangerMove_Attached = false;
		bool mbTheaterHangerMove_MovePlayerToDrop = false;
		float mfHanger_ExitInputCounter = 0.0f;
		
		bool mbRailAttachedToHanger = false;
		tID m_idRailAttachHanger = tID_Invalid;
		tID m_idRailPart = tID_Invalid;
		cVector3f mvRailPartOffset = 0;
		
		//-------------------------------------------------------
		
		void UpdateTheaterHanger(float afTimeStep)
		{
			if (mbTheaterHangerMove_Attached)
			{
//				iLuxEntity@ pPlayerPos = Map_GetEntity("Target_TheaterHangerPlayerPos_" + mlTheaterHangerMove_AttachedToId);
//				
//				cVector3f vForward = pPlayerPos.GetMatrix().GetTranspose().GetForward();
//				float fYaw = -cMath_GetAngleFromPoints2D(0, cVector2f(vForward.x, vForward.z));
//				
//				iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
//				pBody.SetYaw(fYaw);
//				
//				cLux_GetPlayer().GetCharacterBody().SetPosition(pPlayerPos.GetPosition(), true);
				
//				if (Entity_GetVarBool("TheaterHanger_Move_" + mlTheaterHangerMove_AttachedToId, "AddFear"))
//				{
//					float fValue = Entity_GetVarBool("TheaterHanger_Move_" + mlTheaterHangerMove_AttachedToId, "AddHighFear") ? 0.6 : 0.3;
//					FearHandler_SetForcedAddFearRate(eFearForcedRateType_Script, fValue, 0.5, false);
//				}
			}
			
			
			
			if (mbRailAttachedToHanger)
			{
				iLuxEntity@ pHanger = cLux_ID_Entity(m_idRailAttachHanger);
				cNode3D@ pHangerSocket = pHanger.GetMeshEntity().GetSocket("socket_base");
				iLuxEntity@ pRail = cLux_ID_Entity(m_idRailPart);
				
				cVector3f vRailPos = pRail.GetPosition();
				vRailPos.y = pHangerSocket.GetWorldPosition().y + mvRailPartOffset.y;
				
				pRail.SetPosition(vRailPos);
			}
		}
		
		//-------------------------------------------------------
		
		void UpdateBracelet(float afTimeStep)
		{
			
			// hack to keep bracelet attached to hand properly
			if (mlHanger_PlayerAttachedId >= 0)
			{
				cNode3D@ pSocket = PlayerBody_GetSocket("AmuletSocket");
				if (pSocket !is null)
				{
					iLuxEntity@ pBracelet = Map_GetEntity("Amulet_Bracelet");
					if (pBracelet !is null)
					{
						cMatrixf newMtx = pBracelet.GetMatrix();
						newMtx.SetTranslation(pSocket.GetWorldPosition());
						pBracelet.SetMatrix(newMtx);
					}
					
					iLuxEntity@ pAmulet = Map_GetEntity(ItemType_GetFirstInInventory("CurseMedallion") + "_Accessory");
					if (pAmulet !is null)
					{
						cMatrixf newMtx = pAmulet.GetMatrix();
						newMtx.SetTranslation(pSocket.GetWorldPosition());
						pAmulet.SetMatrix(newMtx);
					}
				}
				
				cNode3D@ pRingSocket = PlayerBody_GetSocket("RingSocket");
				if (pRingSocket !is null)
				{
					iLuxEntity@ pRing = Map_GetEntity("SalimsRing_Accessory");
					if (pRing !is null)
					{
						cMatrixf newMtx = pRing.GetMatrix();
						newMtx.SetTranslation(pRingSocket.GetWorldPosition());
						pRing.SetMatrix(newMtx);
					}
				}
			}
		}
		
		//-------------------------------------------------------
		
		array<tString> mvTheaterHangers;
		
		int mlLeverLocks = 0;
		int mlTheaterHangerMove_Stage = 0;
		bool mbTheaterHangerMove_Started = false;
		bool mbTheaterHangerMove_CorpseOnHanger = true;
		
		bool mbTheaterHangers_DiscardOldHanger = false;
		int mlTheaterHangers_DiscardOldHangerStage = 0;
		
		int GetFreeTheaterHanger()
		{
			for (int i = 0; i < mvTheaterHangers.size(); ++i)
			{
				if (Entity_GetVarBool(mvTheaterHangers[i], "HangerMoving")) continue;
				return (i + 1);
			}
			return -1;
		}
		
		void OnConnectionStateChange_DiscardOldHanger(const tString &in asEntity, int alState)
		{
			if (alState == -1)
			{
				if (mlTheaterHangers_TableHangerId == -1) DiscardOldHangerFail();
				else  DiscardOldHanger();
			}
		}
		
		void DiscardOldHanger()
		{
			if (mbTheaterRoomOn == false) return;
			if (mbTheaterHangers_DiscardOldHanger) return;
			mbTheaterHangers_DiscardOldHanger = true;
			SequenceDiscardOldHanger("");
		}
		
		void DiscardOldHangerFail()
		{
			if(mbTheaterHangers_DiscardOldHangerFail) return;
			mbTheaterHangers_DiscardOldHangerFail = true;
			SequenceDiscardOldHangerFail("");
		}
		
		bool mbTheaterHangers_DiscardOldHangerFail = false;
		
		cSequenceStatesData mSequenceDiscardOldHangerFail;
		void SequenceDiscardOldHangerFail(const tString &in asTimer)
		{
			Sequence_Begin("SequenceDiscardOldHangerFail", mSequenceDiscardOldHangerFail);
			if (Sequence_DoStepAndWait(5))
			{
				++mlLeverLocks;
				Lever_SetStuckState("Lever_TheaterHanger", -1, false);
				
				Sound_CreateAtEntity("ScanTableMove", "03_03_herberts_hq/orb_room/pillar_room_complete_loop", "Trigger_LookAtScanTable");
				
				float fSpeedMul = 0.2f;
				Prop_MoveLinearTo("TheaterTable_Left", "Target_TheaterTable_Left_1", fSpeedMul * 0.4, fSpeedMul * 0.4, 0, true, "");
				Prop_MoveLinearTo("TheaterTable_Right", "Target_TheaterTable_Right_1", fSpeedMul * 0.4, fSpeedMul * 0.4, 0, true, "");
				Prop_AlignRotation("TheaterTable_Left", "Target_TheaterTable_Left_1", fSpeedMul * 0.1, fSpeedMul * 0.1, 0, true, "");
				Prop_AlignRotation("TheaterTable_Right", "Target_TheaterTable_Right_1", fSpeedMul * 0.1, fSpeedMul * 0.1, 0, true, "");
				
				Prop_MoveLinearTo("HangerArm_Theater", "Target_HangerArm_Theater_1", 0.4, 0.4, 0, true, "");
			}
			else if (Sequence_DoStepAndWait(2))
			{
				SlideDoor_SetOpenAmount("Door_TheaterHangerExit", 1, false);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				SlideDoor_SetOpenAmount("Door_TheaterHangerExit", 0, false);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				float fSpeedMul = 0.2f;
				Prop_MoveLinearTo("TheaterTable_Left", "Target_TheaterTable_Left_0", fSpeedMul * 0.4, fSpeedMul * 0.4, 0, true, "");
				Prop_MoveLinearTo("TheaterTable_Right", "Target_TheaterTable_Right_0", fSpeedMul * 0.4, fSpeedMul * 0.4, 0, true, "");
				Prop_AlignRotation("TheaterTable_Left", "Target_TheaterTable_Left_0", fSpeedMul * 0.1, fSpeedMul * 0.1, 0, true, "");
				Prop_AlignRotation("TheaterTable_Right", "Target_TheaterTable_Right_0", fSpeedMul * 0.1, fSpeedMul * 0.1, 0, true, "");
				
				Prop_MoveLinearTo("HangerArm_Theater", "Target_HangerArm_Theater_0", 0.8, 0.8, 0, true, "");
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Sound_Stop("ScanTableMove", 0.2);
				--mlLeverLocks;
				if (mlLeverLocks <= 0)
				{
					Lever_SetStuckState("Lever_TheaterHanger", 0, false);
				}
				mbTheaterHangers_DiscardOldHangerFail = false;
			}
			Sequence_End();
		}
		
		cSequenceStatesData mSequenceDiscardOldHanger;
		void SequenceDiscardOldHanger(const tString &in asTimer)
		{
			Sequence_Begin("SequenceDiscardOldHanger", mSequenceDiscardOldHanger);
			if (Sequence_DoStepAndWait(7))
			{
				mlTheaterHangers_TableDiscardHangerId = mlTheaterHangers_TableHangerId;
				mlTheaterHangers_TableHangerId = -1;
				
				++mlLeverLocks;
				Lever_SetStuckState("Lever_TheaterHanger", -1, false);
				SetHangerLeverState(true, true);
								
				SetCheckpointLeverState(true);
								
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "HangerMoving", true);
				
				float fSpeedMul = 0.2f;
				Sound_CreateAtEntity("ScanTableMove", "03_03_herberts_hq/orb_room/pillar_room_complete_loop", "Trigger_LookAtScanTable");
				Prop_MoveLinearTo("TheaterTable_Left", "Target_TheaterTable_Left_1", fSpeedMul * 0.4, fSpeedMul * 0.4, 0, true, "");
				Prop_MoveLinearTo("TheaterTable_Right", "Target_TheaterTable_Right_1", fSpeedMul * 0.4, fSpeedMul * 0.4, 0, true, "");
				Prop_AlignRotation("TheaterTable_Left", "Target_TheaterTable_Left_1", fSpeedMul * 0.1, fSpeedMul * 0.1, 0, true, "");
				Prop_AlignRotation("TheaterTable_Right", "Target_TheaterTable_Right_1", fSpeedMul * 0.1, fSpeedMul * 0.1, 0, true, "");
				
				Prop_MoveLinearTo("HangerArm_Theater", "Target_HangerArm_Theater_1", 0.4, 0.4, 0, true, "");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Entity_SetActive("Trigger_EnterHanger_" + mlTheaterHangers_TableDiscardHangerId, false);
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "AddFear", true);
				
				if (Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "AttachedToHanger") == "player") mbHanger_CanClimbOut = false;
				Entity_PlayAnimation("TheaterHangerClamps_" + mlTheaterHangers_TableDiscardHangerId, "dwf_hct_closing", 0, false);
				
				Sound_CreateAtEntity("MoveSoundOld", "03_03_herberts_hq/beam_filter/mechanism/junction_move", "TheaterHangerCollision_" + mlTheaterHangers_TableDiscardHangerId);
				Prop_MoveLinearTo("HangerArm_Theater", "Target_HangerArm_Theater_0", 2, 2, 0, true, "");
				Entity_PlayAnimation("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "dwf_ht_scan_to_exit", 0, false, false, "");
				Entity_SetAnimationMessageEventCallback("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "OnAnimEvent_DiscardOldHanger", false);
				
				if (Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "AttachedToHanger") == "player") Voice_Play("Dialogue_OnTheHanger");
			}
			else if (Sequence_DoStepAndWait(4.0))
			{
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "AddHighFear", true);
				SlideDoor_SetOpenAmount("Door_TheaterHangerExit", 1, false);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				SlideDoor_SetOpenAmount("Door_TheaterHangerExit", 0, false);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				if (Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "AttachedToHanger") == "player") mbHanger_CanClimbOut = true;
				Entity_PlayAnimation("TheaterHangerClamps_" + mlTheaterHangers_TableDiscardHangerId, "dwf_hct_opening", 0, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				float fSpeedMul = 0.2f;
				Prop_MoveLinearTo("TheaterTable_Left", "Target_TheaterTable_Left_0", fSpeedMul * 0.4, fSpeedMul * 0.4, 0, true, "");
				Prop_MoveLinearTo("TheaterTable_Right", "Target_TheaterTable_Right_0", fSpeedMul * 0.4, fSpeedMul * 0.4, 0, true, "");
				Prop_AlignRotation("TheaterTable_Left", "Target_TheaterTable_Left_0", fSpeedMul * 0.1, fSpeedMul * 0.1, 0, true, "");
				Prop_AlignRotation("TheaterTable_Right", "Target_TheaterTable_Right_0", fSpeedMul * 0.1, fSpeedMul * 0.1, 0, true, "");
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Sound_Stop("MoveSoundOld", 0.25f);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Sound_CreateAtEntity("HangerDropLoad", "level_entity_shared/levers/thatre_lever/lever_start", "TheaterHangerCollision_" + mlTheaterHangers_TableDiscardHangerId);
				Map_AddTimer("Timer_DisposalKickForce", 0.0f, "OnTimer_DisposalKickForce");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Map_GetEntity("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId).GetMeshEntity().GetAnimationStateFromName("dwf_ht_scan_to_exit").SetSpeed(0.06f);
				Sound_CreateAtEntity("MoveSoundOld", "03_03_herberts_hq/beam_filter/mechanism/junction_move", "TheaterHangerCollision_" + mlTheaterHangers_TableDiscardHangerId);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Sound_Stop("ScanTableMove", 0.5f);
				Sound_Stop("MoveSoundOld", 0.5f);
				
				mbTheaterHangers_DiscardOldHanger = false;
				if (Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "AttachedToHanger") == "corpse")
				{
					Entity_SetActive("TheaterCorpse", false);
					Entity_SetActive("Blocker_Corpse", false);
					Entity_SetVarString("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "AttachedToHanger", "");
				}
				
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "AddFear", false);
				Entity_SetVarBool("Trigger_EnterHanger_" + mlTheaterHangers_TableDiscardHangerId, "AddHighFear", false);
				
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, "HangerMoving", false);
				
				Entity_SetActive("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId, false);
				Entity_SetActive("TheaterHangerClamps_" + mlTheaterHangers_TableDiscardHangerId, false);
				Entity_SetActive("TheaterHangerCollision_" + mlTheaterHangers_TableDiscardHangerId, false);
				
				mlTheaterHangers_TableDiscardHangerId = -1;
				
				--mlLeverLocks;
				if (mlLeverLocks <= 0)
				{
					Lever_SetStuckState("Lever_TheaterHanger", 0, false);
					SetHangerLeverState(true, true);
				}
			}
			Sequence_End();
		}
		
		void OnAnimEnd_ResumeDiscardOldHanger(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("SequenceDiscardOldHanger");
		}
		
		void OnAnimEvent_DiscardOldHanger(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 0)
			{
				Map_GetEntity("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId).GetMeshEntity().GetAnimationStateFromName("dwf_ht_scan_to_exit").SetSpeed(0.06f);
			}
			else if (alMessageEventID == 1)
			{
				SequenceStates_Resume("SequenceDiscardOldHanger");
			}
			else if (alMessageEventID == 3)
			{
				SequenceStates_Resume("SequenceDiscardOldHanger");
				Map_GetEntity("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId).GetMeshEntity().GetAnimationStateFromName("dwf_ht_scan_to_exit").SetSpeed(0);
			}
			else if (alMessageEventID == 4)
			{
				Map_GetEntity("TheaterHanger_Move_" + mlTheaterHangers_TableDiscardHangerId).GetMeshEntity().GetAnimationStateFromName("dwf_ht_scan_to_exit").SetSpeed(0.4f);
			}
			else if (alMessageEventID == 5)
			{
				SequenceStates_Resume("SequenceDiscardOldHanger");
			}
		}
		
		void OnTimer_DisposalKickForce(const tString &in asTimer)
		{
			if (mbTheaterHangerMove_Attached == false) return;
			if (mlHanger_PlayerAttachedId != mlTheaterHangers_TableDiscardHangerId) return;
						
			Entity_SetVarString("TheaterHanger_Move_" + mlHanger_PlayerAttachedId, "AttachedToHanger", "");
			mbTheaterHangerMove_Attached = false;
			PlayerBody_DetachFromEntity();
			
			cVector3f vPlayerPos = Map_GetEntity("TheaterHanger_Move_" + mlHanger_PlayerAttachedId).GetMeshEntity().GetSocket("socket_player").GetWorldPosition();
			mvTheaterHangerMove_PlayerDropPos = vPlayerPos;
			PlayerBody_StopAnimation("player_idle_hanger", 0.0f);
			PlayerBody_StopAnimation("player_jump_down_hanger", 0.0f);
			PlayerBody_StopAnimation("player_climb_out_hanger", 0.0f);
			FearHandler_SetForcedAddFearRate(1.0f, 99, false, 4);
			mlHanger_PlayerAttachedId = -1;
			
			Voice_PlayDelayed("Dialogue_KickedIntoThePit", 0.3f);
			Map_AddTimer("Timer_MovePlayerToDrop", 0.2f, "OnTimer_MovePlayerToDrop");
		}
		
		void SetHangerLeverState(bool abActive, bool abLocked)
		{
			Entity_SetEffectsActive("Indicator_TheaterHanger", abActive && abLocked == false, false);
		}
		
		tString msTheaterHangerMove_Old;
		tString msTheaterHangerMove_New;
		int mlTheaterHangerMove_OldId = -1;
		int mlTheaterHangerMove_NewId = -1;
		int mlTheaterHangerMove_ActiveHanger = 1;
		
		int mlTheaterHangers_BringNewHangerStage = 0;
		int mlTheaterHangers_BringNewHangerId = -1;
		int mlTheaterHangers_TableHangerId = -1;
		int mlTheaterHangers_CheckpointHangerId = -1;
		int mlTheaterHangers_TableDiscardHangerId = -1;
		
		cSequenceStatesData mSequenceBringNewHanger;
		void SequenceBringNewHanger(const tString &in asTimer)
		{
			Sequence_Begin("SequenceBringNewHanger", mSequenceBringNewHanger);
			if (Sequence_DoStepAndPause(0))
			{
				++mlLeverLocks;
				Lever_SetStuckState("Lever_TheaterHanger", 1, false);
				SetHangerLeverState(true, true);
				
				mlTheaterHangers_BringNewHangerId = GetFreeTheaterHanger();
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_BringNewHangerId, "HangerMoving", true);
				
				Entity_SetActive("TheaterHanger_Move_" + mlTheaterHangers_BringNewHangerId, true);
				Entity_PlaceAtEntity("TheaterHanger_Move_" + mlTheaterHangers_BringNewHangerId, "Target_TheaterHanger_Anim");
				Entity_LookAtDirection("TheaterHanger_Move_" + mlTheaterHangers_BringNewHangerId, Map_GetEntity("Target_TheaterHanger_Anim").GetMatrix().GetTranspose().GetForward());
				
				Entity_SetActive("TheaterHangerClamps_" + mlTheaterHangers_BringNewHangerId, true);
				Entity_PlayAnimation("TheaterHangerClamps_" + mlTheaterHangers_BringNewHangerId, "dwf_hct_closed_idle", 0, true);
				iLuxEntity@ pEnt = Map_GetEntity("TheaterHangerClamps_" + mlTheaterHangers_BringNewHangerId);
				pEnt.GetMeshEntity().GetAnimationStateFromName("dwf_hct_closed_idle").SetPaused(true);
				pEnt.GetMeshEntity().GetAnimationStateFromName("dwf_hct_closed_idle").SetRelativeTimePosition(0);
				
				Entity_SetActive("TheaterHangerCollision_" + mlTheaterHangers_BringNewHangerId, true);
				Map_GetEntity("TheaterHangerCollision_" + mlTheaterHangers_BringNewHangerId).GetMeshEntity().SetVisible(false);
				
				Entity_PlayAnimation("TheaterHanger_Move_" + mlTheaterHangers_BringNewHangerId, "dwf_ht_start_to_checkpoint", 0, false, false, "OnAnimEnd_ResumeBringNewHanger");
				Sound_CreateAtEntity("MoveSoundNew", "03_03_herberts_hq/beam_filter/mechanism/junction_move", "TheaterHanger_Move_" + mlTheaterHangers_BringNewHangerId);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Sound_Stop("MoveSoundNew", 0.2f);
				
				if (Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_BringNewHangerId, "AttachedToHanger") != "corpse")
					Entity_SetActive("Trigger_EnterHanger_" + mlTheaterHangers_BringNewHangerId, true);
					
				Entity_PlayAnimation("TheaterHangerClamps_" + mlTheaterHangers_BringNewHangerId, "dwf_hct_opening", 0, false);
				
//				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_BringNewHangerId, "AddFear", true);
				
				mlTheaterHangers_CheckpointHangerId = mlTheaterHangers_BringNewHangerId;
				mlTheaterHangers_BringNewHangerId = -1;
			}
			// scan hanger multiple times
			else if (Sequence_DoStepAndPause(0))
			{
				mlCheckPointScanCount = 0;
				mbCheckPointScanAttached = false;
				Map_AddTimer("Timer_CheckPointCheck", 0.0f, "OnTimer_CheckPointCheck");
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Entity_SetActive("Trigger_EnterHanger_" + mlTheaterHangers_CheckpointHangerId, false);
				Entity_PlayAnimation("TheaterHangerClamps_" + mlTheaterHangers_CheckpointHangerId, "dwf_hct_closing", 0, false);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Entity_SetEffectsActive("Indicator_CheckpointScan", true, true);
				
				if (mbCheckPointScanAttached)
				{
					Sound_CreateAtEntity("CheckpointSuccess", "03_07_dw_factory/torture_victim/machine_feedback/attach_positive", "Indicator_CheckpointScan");
					SetButtonColor("Indicator_CheckpointScan", mButtonColor_Green);
				}
				else
				{
					Sound_CreateAtEntity("CheckpointFail", "03_07_dw_factory/torture_victim/machine_feedback/button_negative", "Indicator_CheckpointScan");
					SetButtonColor("Indicator_CheckpointScan", mButtonColor_Red);
				}
			}
			else if (Sequence_DoStepAndWait(3))
			{
				if (mbCheckPointScanAttached)
				{
					SequenceNewHangerToTable("");
				}
				else
				{
					Entity_SetActive("Trigger_EnterHanger_" + mlTheaterHangers_CheckpointHangerId, false);
					Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "AddFear", false);
					SequenceDiscardEmptyHanger("");
				}
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Entity_SetEffectsActive("Indicator_CheckpointScan", false, true);
			}
			Sequence_End();
		}
		
		void OnAnimEnd_ResumeBringNewHanger(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("SequenceBringNewHanger");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDiscardEmptyHanger;
		void SequenceDiscardEmptyHanger(const tString &in asTimer)
		{
			Sequence_Begin("SequenceDiscardEmptyHanger", mSeqDiscardEmptyHanger);
			if (Sequence_DoStepAndPause(0))
			{
				Sound_CreateAtEntity("MoveSoundNew", "03_03_herberts_hq/beam_filter/mechanism/junction_move", "TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId);
				Entity_PlayAnimation("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "dwf_ht_checkpoint_to_exit", 0, false, false, "OnAnimEnd_ResumeDiscardEmptyHanger");
				Entity_SetAnimationMessageEventCallback("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "OnAnimEvent_DiscardEmptyHanger", false);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				SlideDoor_SetOpenAmount("Door_TheaterHangerExit", 1, false);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				SlideDoor_SetOpenAmount("Door_TheaterHangerExit", 0, false);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				--mlLeverLocks;
				Lever_SetStuckState("Lever_TheaterHanger", 0, false);
				SetHangerLeverState(true, false);
				
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "HangerMoving", false);
				Entity_SetActive("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, false);
				Entity_SetActive("TheaterHangerClamps_" + mlTheaterHangers_CheckpointHangerId, false);
				Entity_SetActive("TheaterHangerCollision_" + mlTheaterHangers_CheckpointHangerId, false);
				Entity_SetAnimationMessageEventCallback("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "", false);
				if (mlTheaterHangers_TableHangerId == -1) SetCheckpointLeverState(true);
				mlTheaterHangers_CheckpointHangerId = -1;
				Sound_Stop("MoveSoundNew", 0.2);
			}
			Sequence_End();
		}
		
