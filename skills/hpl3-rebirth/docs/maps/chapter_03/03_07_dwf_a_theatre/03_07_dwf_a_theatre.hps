		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceNewHangerToTable;
		void SequenceNewHangerToTable(const tString &in asTimer)
		{
			Sequence_Begin("SequenceNewHangerToTable", mSequenceNewHangerToTable);
			if (Sequence_DoStepAndPause(0))
			{
				if (Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "AttachedToHanger") == "player") mbHanger_CanClimbOut = false;
				
				Sound_CreateAtEntity("MoveSoundNew", "03_03_herberts_hq/beam_filter/mechanism/junction_move", "TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId);
				
				Entity_PlayAnimation("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "dwf_ht_checkpoint_to_scan", 0, false, false, "OnAnimEnd_ResumeNewHangerToTable");
				Entity_SetAnimationMessageEventCallback("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "OnAnimEvent_NewHangerToTable", true);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				float fSpeed = 1.5;
				Prop_MoveLinearTo("HangerArm_Theater", "Target_HangerArm_Theater_1", fSpeed, fSpeed, 0, true, "");
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Prop_MoveLinearTo("HangerArm_Theater", "Target_HangerArm_Theater_0", 3, 3, 0, true, "");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Sound_Stop("MoveSoundNew", 0.2);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				if (Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "AttachedToHanger") != "corpse")
				{
					Entity_SetActive("Trigger_EnterHanger_" + mlTheaterHangers_CheckpointHangerId, true);
				}
				
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "HangerMoving", false);
				Entity_SetVarBool("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "AddFear", false);
				
				mlTheaterHangers_TableHangerId = mlTheaterHangers_CheckpointHangerId;
				mlTheaterHangers_CheckpointHangerId = -1;
				
				if (Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_TableHangerId, "AttachedToHanger") == "")
				{
					Seq_TheaterScanFail("");
				}
				else
				{
					Seq_TheaterScan("");
				}
			}
			Sequence_End();
		}
		
		void OnAnimEnd_ResumeNewHangerToTable(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("SequenceNewHangerToTable");
		}
		
		void OnAnimEvent_NewHangerToTable(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 0)
			{
				SequenceStates_Resume("SequenceNewHangerToTable");
			}
		}
		
		//-------------------------------------------------------
		
		int mlCheckPointScanCount = 0;
		bool mbCheckPointScanAttached = false;
		
		void OnTimer_CheckPointCheck(const tString &in asTimer)
		{
			++mlCheckPointScanCount;
			Lamp_SetLit("Lamp_CheckpointScanner", true, true);
			Sound_CreateAtEntity("CheckpointScan", "03_07_dw_factory/baby_scanner/baby_scan_slider", "Lamp_CheckpointScanner");
			
			Map_AddTimer("Timer_CheckPointCheckOff", 1.0f, "OnTimer_CheckPointCheckOff");
		}
		
		void OnTimer_CheckPointCheckOff(const tString &in asTimer)
		{
			Lamp_SetLit("Lamp_CheckpointScanner", false, true);
			Sound_Stop("CheckpointScan", 0.2);
			
			bool bAttached = Entity_GetVarString("TheaterHanger_Move_" + mlTheaterHangers_CheckpointHangerId, "AttachedToHanger") != "";
			if (bAttached || mlCheckPointScanCount >= 4)
			{
				mbCheckPointScanAttached = bAttached;
				SequenceStates_Resume("SequenceBringNewHanger");
				return;
			}
			
			Map_AddTimer("Timer_CheckPointCheck", 2.0f, "OnTimer_CheckPointCheck");
		}
		
		//-------------------------------------------------------

		//} END Event F *Send yourself to the Disposal Room*
		
		/////////////////////////////////////////
		// Event G *Get into the Pit of Bodies*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		float mfPitOfBodies_MaxNoSlideAngle = 0;
		cVector3f mvPitOfBodies_SlideStart;
		cVector3f mvPitOfBodies_SlideEnd;
		cVector3f mvPitOfBodies_SlideEnd2;
		bool mbPitOfBodies_Sliding = false;
		float mfPitOfBodies_SlideCount = 0;
		float mfPitOfBodies_YawFadeCount = 0;
		float mfPitOfBodies_SlideSpeed = 0;
		bool mbPitOfBodies_Entered = false;
		int mlPitOfBodies_SlideStage = 0;
		bool mbPitOfBodies_SlidingDialoguePlayer = false;
		float mfPitOfBodies_StartYaw = 0;
		float mfPitOfBodies_TargetYaw = 0;
		
		//-------------------------------------------------------
		
		void InitPitOfBodies()
		{
			iLuxEntity@ pAABB = Map_GetEntity("Target_PitAABB");
			array<iPhysicsBody@> vBodies;
			cLux_GetCurrentMap().GetWorld().GetPhysicsWorld().GetBodiesInAABB(pAABB.GetMainBody().GetBoundingVolume().GetMin(), pAABB.GetMainBody().GetBoundingVolume().GetMax(), vBodies);
			for (int i = 0; i < vBodies.size(); ++i)
			{
				iPhysicsBody@ pBody = vBodies[i];
				if (cString_GetFirstStringPos(pBody.GetName(), "bone") < 0 &&
					cString_GetFirstStringPos(pBody.GetName(), "mummified") < 0 &&
					cString_GetFirstStringPos(pBody.GetName(), "corpse") < 0)
					continue;
				pBody.SetCollideCharacter(false);
			}
		}
		
		//-------------------------------------------------------
		
		void UpdatePitOfBodies(float afTimeStep)
		{
			if (mbPitOfBodies_Sliding)
			{
				if (mlPitOfBodies_SlideStage == 1)
				{
					mfPitOfBodies_SlideCount += mfPitOfBodies_SlideSpeed * afTimeStep;
					float fT = cMath_Clamp(mfPitOfBodies_SlideCount, 0.0f, 1.0f);
					cVector3f vPos = mvPitOfBodies_SlideStart * (1.0f - fT) + mvPitOfBodies_SlideEnd * fT;
					
					PlayerBody_SetCameraAnimationPositionAndYaw(true, vPos, mfPitOfBodies_TargetYaw, 0.f);
							
					if (fT >= 1.0f)
					{
						mlPitOfBodies_SlideStage = 2;
						mfPitOfBodies_SlideCount = 0;
						mfPitOfBodies_YawFadeCount = 0;
						
						PlayerBody_PlayAnimation("player_slide_back_end", ePlayerBodyAnimationLayer_FullBody, false, false, false, 0.3f, 0.8f);
						
						cVector3f vSlideDir = mvPitOfBodies_SlideEnd2 - mvPitOfBodies_SlideEnd;
						vSlideDir.Normalize();

						mfPitOfBodies_StartYaw = mfPitOfBodies_TargetYaw;
						mfPitOfBodies_TargetYaw = mfPitOfBodies_StartYaw + cMath_GetAngleDistanceRad(mfPitOfBodies_StartYaw, cMath_GetAngleFromPoints3D(0.f, vSlideDir).y);
					}
				}
				else if (mlPitOfBodies_SlideStage == 2)
				{
					mfPitOfBodies_SlideCount += 1.0f * afTimeStep;
					float fT = cMath_Clamp(mfPitOfBodies_SlideCount, 0.0f, 1.0f);
					fT = cMath_Easing(eEasing_SineOut, fT);
					cVector3f vPos = mvPitOfBodies_SlideEnd * (1.0f - fT) + mvPitOfBodies_SlideEnd2 * fT;
					
					mfPitOfBodies_YawFadeCount += (1.0f / 1.0f) * afTimeStep;
					float fYawT = cMath_Clamp(mfPitOfBodies_YawFadeCount, 0.0f, 1.0f);
					float fYaw = fYawT * mfPitOfBodies_TargetYaw + (1.0f - fYawT) * mfPitOfBodies_StartYaw;
										
					PlayerBody_SetCameraAnimationPositionAndYaw(true, vPos, fYaw, 0.0f);
					
					if (fT >= 1.0f)
					{
						mlPitOfBodies_SlideStage = 3;
					}
				}
				else if (mlPitOfBodies_SlideStage == 3)
				{
					if (PlayerBody_GetAnimationState("player_slide_back_end").GetRelativeTimePosition() >= 1.0f)
					{
						PlayerBody_StopAnimation("player_slide_back_end", 0);
						PlayerBody_StopCustomAnimation();
						
						mbPitOfBodies_Sliding = false;
						mbHologram_Active = false;
						FearHandler_SetForcedAddFearRate(0.0f, 99, false, -1, 0.1f);
					}
				}
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_BodyPitSlide(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbPitOfBodies_Sliding) return true;
			if (alState != 1) return true;
						
			////////////
			// Start pos
			mvPitOfBodies_SlideStart = Player_GetFeetPosition();
			
			////////////
			// End pos
			cVector3f vTarget = Map_GetEntity("Target_BodyPitSlide").GetPosition();
			
			float fDist;
			cVector3f vNrm;
			cLux_GetClosestBody(vTarget, cVector3f_Down, 2.0f, fDist, vNrm);
			if (fDist > 20 || fDist < 0) fDist = 2.0f;
			
//			mvPitOfBodies_SlideEnd = vTarget + cVector3f_Down * fDist;
			mvPitOfBodies_SlideEnd = vTarget;
			mvPitOfBodies_SlideEnd2 = Map_GetEntity("Target_BodyPitSlide_1").GetPosition();
			
			////////////
			// Play anim
			cVector3f vSlideDir = mvPitOfBodies_SlideEnd - mvPitOfBodies_SlideStart;
			float fYaw = cMath_GetAngleFromPoints3D(0.f, vSlideDir).y;
			mfPitOfBodies_TargetYaw = fYaw;
//			PlayerBody_PlayCutsceneAnimation("player_slide_down_loop", true, 0.5f, "", 1.0f, 0.0f, true, cLux_GetPlayer().GetCharacterBody().GetFeetPosition(), fYaw);
			PlayerBody_StartCustomAnimation("", true, 0.5f, true, cLux_GetPlayer().GetCharacterBody().GetFeetPosition(), mfPitOfBodies_TargetYaw);
			PlayerBody_PlayAnimation("player_slide_down_loop", ePlayerBodyAnimationLayer_FullBody, true, false, false, 0.5f);
			
			////////////
			// Start sliding
			mfPitOfBodies_SlideCount = 0;
			
			float fSlideDist = vSlideDir.Length();
			mfPitOfBodies_SlideSpeed = 8.0f / fSlideDist;
			mbPitOfBodies_Sliding = true;
			mlPitOfBodies_SlideStage = 1;
			
			////////////
			// Sfx
			Sound_CreateAtEntity("Sound_PitFall", "03_07_DW_theatre/animations/fall_slide", "player");
			Voice_PlayDelayed("Dialogue_LandInThePit", 0.0f);
			FearHandler_SetForcedAddFearRate(1.0f, 99, false, 4);
			
			////////////
			// Debug
//			DrawTestPoint(mvPitOfBodies_SlideStart, 5.0f, cColor_Green * 5.0f, 0.5f);
//			DrawTestPoint(mvPitOfBodies_SlideEnd, 5.0f, cColor_Green * 5.0f, 0.5f);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_SlideRamp(const tString &in asParent, const tString &in asChild, int alState)
		{
			Player_SetSlidingActive(alState == 1, 25.f, false);
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event G *Get into the Pit of Bodies*
		
		/////////////////////////////////////////
		// Event H *Crawl through the ventilation shafts*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		void OnTorn_TearVentGrate(const tString &in asEntity)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asEntity);
			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pEnt.GetMainBody().GetJoint(0));
			pHinge.SetMaxAngle(120);
			pEnt.GetMainBody().AddImpulse(Map_GetEntity(asEntity).GetMatrix().GetTranspose().GetForward() * 1.0f);
			Entity_SetInteractionDisabled(asEntity, true);
			Entity_SetCollideCharacter(asEntity, false);
			Sound_CreateAtEntity("TearVentGrate", "level_entity_shared/doors/relic_door/relic_door_locked", asEntity);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlayVentMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_PlayExt("A2_01_02_Doll_Ambience.ogg", true, 0.4f, 1.0f, 6.0f, 1.0f, eMusicPrio_SceneAmb, true);
			return false;
		}
		
		//-------------------------------------------------------

		
		bool OnCollide_StopVentMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_Stop(6.0f, eMusicPrio_SceneAmb);
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Event H *Crawl through the ventilation shafts*

		
	//} END SCENE 1
	
