		void OnInteract_CattleCorpse(const tString &in asEntity)
		{
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_CattleCorpse(const tString &in asEntity)
		{
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_CattleCorpse_Cage(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1)
			{
				iLuxEntity@ pCorpse = Map_GetEntity("CattleCorpse");
//				pCorpse.GetBodyFromName("Body_7").SetCollide(true);
//				pCorpse.GetBodyFromName("Body_6").SetCollide(true);
				
				for (int i = 0; i < pCorpse.GetBodyNum(); ++i)
				{
					iPhysicsBody@ pBody = pCorpse.GetBody(i);
					pBody.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-player"));
				}
				
				Map_GetEntity("Blocker_CorpseHanging").GetMainBody().SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("+player"));
				
				return false;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CalmDownCorpse(const tString &in asTimer)
		{
			iLuxEntity@ pCorpse = Map_GetEntity("CattleCorpse");
			for (int i = 0; i < pCorpse.GetBodyNum(); ++i)
			{
				iPhysicsBody@ pBody = pCorpse.GetBody(i);
				pBody.SetMass(0);
			}
		}
		
