			PlayerBody_PlayCutsceneAtSocket("player_idle_hanger", "Target_TheaterHanger_Start_1", "socket_player", true, 0.0f);
			Map_AddTimer("OnTimer_PlayerHanger", cEngine_GetStepSize() + 0.001f, "OnTimer_PlayerHanger");
			return;
			return;
			iLuxEntity@ pEnt = Map_GetEntity("Target_TheaterHanger_Start_1");
			cMeshEntity@ pMesh = pEnt.GetMeshEntity();
			cVector3f vSocket = pMesh.GetSocket("socket_player").GetWorldPosition();
			return;
		}
		
		if(alAction == eAction_Test1)
		{
//			cLux_SetScriptDebugOn(false);
//			cLux_SetHideDebugOutputOn(true);

			Player_Teleport("Start_TheaterHanger");
