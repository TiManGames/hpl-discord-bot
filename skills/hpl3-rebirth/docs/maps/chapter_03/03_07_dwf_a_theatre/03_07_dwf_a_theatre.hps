	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("03-07-dwf-a-theatre");
		
		
		Player_SetCameraFarPlane(8192.0f);

		// Reset effects
		Effect_Bloom_FadeBrightPass(0.3f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(1.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		// Set up color grading etc.
		
		Pregnancy_SetStage(ePregStage_Stage2);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_DWF_BeforeScan);
		Pregnancy_SetBabyKicksEnabled(true);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(true);
		FearHandler_SetWhisperStage(eFearWhisperStage_DWFAToDWFC);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(2);
		StruggleFlashHandler_SetProgression(2);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		//ParticleSystem_Preload("some_particle.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		Sound_PreloadGhost();
		Sound_PreloadEvent("level_entity_shared/fire/fire_ignite/wall_torch_ignite");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{				
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		//PlayerBody_SetModel("player.ent");
		PlayerBody_SetActive(true);
		FearHandler_SetPermaFailEnabled(true);
        Heat_SetActive(false);
		Player_SetAutoTeleportWhenBelowAltitude(-1);
//		Map_Preload("03_07_dwf_b_rnd.hpm");
		
		if (cLux_ScriptDebugOn() == false)
		{
			Seq_WakeUpScene("");
		}
		
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(15);
		
		/////////////////////////
		// Inventory
		if (cLux_ScriptDebugOn())
		{
			
		}
		
		if (ItemType_IsInInventory("Lantern") == false)
		{
			Item_AddToInventory("Lantern");
			Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
			Item_AddToInventory("HerbertOil");
			Item_SetContent(ItemType_GetFirstInInventory("HerbertOil"), "Oil", 10);
			Item_AddToInventory("Matchbook");
			Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
		}
		
		/////////////////////////
		// System setup
		Blackboard_AddWraithBillboards("WraithBillboard");
		
		Player_SetMapDeepShadow(0.15f);
//		cLux_GetCurrentMap().SetMaxInteractDistance(20.0f);
		FearHandler_SetPermaFailRespawnArea("PermaFail_Default");
		FearHandler_FadeLevelTo(0, 2.0f);
		
		Player_SetNightVisionBrightness(3.5);
		Player_SetSlidingUseParticles(false);
		
		Light_SetVisible("Light_Debug", false);
		
		/////////////////////////
		// Init scenes
		InitTheaterRoom();
		InitBabyScan();
		InitPitOfBodies();
		InitHologram();
		InitDarkWorldLightning();
		InitScan();
		InitMuseum();
		InitCattleCorpse();
		
//		Map_AddTimer("OnTimer_Test", 0.2, "OnTimer_Test");
		
		// Reset volume since it was lowered when going through the portal
		Sound_SetGlobalVolume(1.f, eSoundEntryType_AllExceptGui);		
	}

	//-------------------------------------------------------
	
	void OnTimer_Test(const tString &in asTimer)
	{
		Lamp_SetLit("aaasdfsdfs", false, false);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Player_RestoreClipPlane();
	}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("DEAD : SOURCE = " + asSource);
		
		if (asSource == "WraithHappy_1" || asSource == "WraithHappy_2" || asSource == "Wraith_TortureToExit")
		{
			Death_PickRespawnArea("Death_Torture");
		}
		
		if (asSource == "Wraith_HappyToTorture")
		{
			Death_PickRespawnArea("Death_Happy");
		}

		if (asSource == "SomeReason")
		{
			Effect_Fade_Out(1.0f);
			return true; // return true to completely override base behaviour
		}
		
		// return false for default behaviour
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail(const tString &in asSource)
	{
		FearHandler_ClearPermaFailScenes();
		SetupGenericPermaFail();
		return true;
	}
	
	//-------------------------------------------------------
	
	array<int> mvUnplayedGenericPermaFails = { 1, 2 };
	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 2; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);

		tString sAreaBase = "Area_PermaFail_Generic";		
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_1", sAreaBase + "_1_End_1", 6.f, 3.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_2", sAreaBase + "_1_End_2", 4.f, 2.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_3", sAreaBase + "_1_End_3", 3.f, 2.5f);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 4.f, 2.5f);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_2", sAreaBase + "_2_End_2", 5.f, 3.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_3", sAreaBase + "_2_End_3", 4.f, 3.5f, true, true);
				break;
		}
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{		
		// return false for default behaviour (fadeout and death area)
		return false;
	}

