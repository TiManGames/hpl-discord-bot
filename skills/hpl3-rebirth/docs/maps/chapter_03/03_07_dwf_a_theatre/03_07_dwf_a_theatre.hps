		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceBabyDanger;
		void Seq_BabyDanger(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BabyDanger", mSequenceBabyDanger);
			if (Sequence_DoStepAndWait(3.0))
			{
				--mlLeverLocks;
				SetScanbedLeverState(eScanbedLeverState_ActiveUnlocked);
				
				Hologram_FadeOutImage(mlHologramImage_ButtonAlert, 0.5);
				
//				mbBabyMoment_WarningPulse = false;
				mbBabyScanMomentDone = true;
//				SetHologramState(5);

				Hologram_FlickerOutIdleImages();
				
				PlayerBody_PlayCutsceneAtEntity("looks_at_baby_scan_part_2", "Target_BabyScanPart2", false, 0.5f);
				
//				CameraAnimation_Begin("CameraAnimation_BabyDanger", "", true);
				
				Sound_CreateAtEntity("Sound_ScreenOn", "03_07_dw_factory/baby_scanner/scan_UI/screen_on", "Target_Hologram");
				Sound_CreateAtEntity("Sound_ScanEnergy", "03_07_dw_factory/baby_scanner/scan_UI/energy_loop", "Target_Hologram");
				Sound_CreateAtEntity("SoundScanBaby", "new_sounds/theatre/baby_UI", "Target_Hologram");
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Hologram_SetImagePos(mlHologramImage_Cycles1, cVector3f(-0.01, -0.28, 1));
				Hologram_SetImageSize(mlHologramImage_Cycles1, cVector2f(0.35, 0.35));
				Hologram_SetImageColor(mlHologramImage_Cycles1, cColor(1.0, 1.0, 0) * 15);
				
				array<int> vImages = { mlHologramImage_Ghoul, mlHologramImage_Cycles1 };
				Hologram_FlickerInImage(mlHologramImage_Cycles1);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_Eyes, 0.75);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_Joint1, 0.75);
				Hologram_FadeInImage(mlHologramImage_Joint3, 0.75);
				Hologram_FadeInImage(mlHologramImage_Joint5, 0.75);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_Joint2, 0.75);
				Hologram_FadeInImage(mlHologramImage_Joint4, 0.75);
				Hologram_FadeInImage(mlHologramImage_Joint6, 0.75);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_Heart, 0.75);
				Hologram_FadeInImage(mlHologramImage_Joint7, 0.75);
				Hologram_FadeInImage(mlHologramImage_Joint8, 0.75);
				Hologram_FadeInImage(mlHologramImage_Joint9, 0.75);
				Hologram_FadeInImage(mlHologramImage_Joint10, 0.75);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_Lung1, 0.75);
				Hologram_FadeInImage(mlHologramImage_Lung2, 0.75);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Hologram_FadeInImage(mlHologramImage_Hand1, 0.75);
				Hologram_FadeInImage(mlHologramImage_Hand2, 0.75);
				Hologram_FadeInImage(mlHologramImage_Feet1, 0.75);
				Hologram_FadeInImage(mlHologramImage_Feet2, 0.75);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				array<int> vImages = { mlHologramImage_MotherHood1, mlHologramImage_MotherHood2 };
				Hologram_FlickerInImage(vImages);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_Glow, 0.5);
				Hologram_SetImageRotation(mlHologramImage_MotherHood1, 270, 8, eEasing_SineInOut, true);
				Hologram_SetImageRotation(mlHologramImage_MotherHood2, -270, 6, eEasing_SineInOut, true);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				// fade in red glow
				Hologram_SetImageBrightness(mlHologramImage_Glow, 0.7, 1, eEasing_SineInOut, true);
				
				Voice_SetSource("Tin Hinan", "THGhost_Theatre", 6, 25, true);
				Voice_PlayDelayed("Dialogue_ScanInterrupted", 1.0);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_IllnessCircle1, 1);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_IllnessBaby1, 1);
				Hologram_FadeInImage(mlHologramImage_IllnessGlyph1, 1);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Hologram_FadeInImage(mlHologramImage_IllnessCircle2, 1);
			}
			else if (Sequence_DoStepAndWait(6.0))
			{
				Hologram_FadeInImage(mlHologramImage_IllnessBaby2, 1);
				Hologram_FadeInImage(mlHologramImage_IllnessGlyph2, 1);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Voice_PlayDelayed("Dialogue_ScanInterrupted_2", 0.0);
			}
			else if (Sequence_DoStepAndWait(0.1))
			{
				YoungTinHinan_SetCustomCoverage("THGhost_Theatre", 0.5f);
				YoungTinHinan_Activate("THGhost_Theatre", 1);
				Light_FadeBrightnessToDefault("Light_THGhost_Theatre*", 1.0f);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				CharMover_PlayAnimation("THGhost_Theatre", "tinhinan_theatre_baby_moment", 0, false, false, "");
//				Entity_PlayAnimation("THGhost_Theatre", "tinhinan_theatre_baby_moment", 0);
			}
			else if (Sequence_DoStepAndWait(7))
			{
//				CameraAnimationNode_SetAutoMove("CameraAnimation_BabyDanger_5", 1.0f);
			}
			else if (Sequence_DoStepAndWait(16))
			{
				Sketchbook_UnlockMemory("Memory_ChildIsIll", true, "", false);
//				CameraAnimation_End();
				Dialog_StartConversation("Tin Hinan", "THGhost_Theatre", 1.f, cVector3f_Zero, true);
			}
			else if (Sequence_DoStepAndWait(12))
			{
				Dialog_Begin();
				Dialog_AddBranchAndSubject("Dialogue_AfterScanMemory", "", "");
				Dialog_End();
			}
			else if (Sequence_DoStepAndPause(1))
			{
				Light_FadeBrightnessTo("Light_THGhost_Theatre*", 0, 0.5f);
				YoungTinHinan_SetFlying("THGhost_Theatre", true);
				YoungTinHinan_MoveTo("THGhost_Theatre", "PathNode_THTheater_12", "OnMoveEnd_THGhost_Theatre");
				Dialog_StopConversation();
			}
			else if (Sequence_DoStepAndWait(0))
			{
				YoungTinHinan_Deactivate("THGhost_Theatre", 1, false);
			
				Sketchbook_CompleteIdea("exit_theater");
				Sketchbook_AddIdea("find_babyhelp");
				Pregnancy_SetBabyTalkStage(eBabyTalkStage_DWF_AfterScan);
			}
			Sequence_End();
		}
		
