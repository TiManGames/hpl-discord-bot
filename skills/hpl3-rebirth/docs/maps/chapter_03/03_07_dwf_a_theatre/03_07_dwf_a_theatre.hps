		//-------------------------------------------------------
		
		void OnInteract_EnterHanger_1(const tString &in asEntity)
		{
			EnterHanger(1);
		}
		
		//-------------------------------------------------------
		
		void EnterHanger(int alId)
		{
			if (mlHanger_PlayerAttachedId >= 0) return;
			
			if (mbCheckpointScanActive) mbHanger_CanClimbOut = false;
			
			mlHanger_PlayerAttachedId = alId;
			mbHanger_GettingIn = true;
			
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			
			PlayerBody_FadeCutsceneMaxPitch(20, 0.2);
			PlayerBody_FadeCutsceneMaxYaw(45, 0.2);
			PlayerBody_PlayCutsceneAtSocket("player_climb_into_hanger", GetHangerName(mlHanger_PlayerAttachedId), "socket_player", false, 1.0, "OnAnimEnd_StartHangerInteraction", 1, 0, 0, 180);
			PlayerBody_SetCutsceneAutoEnd(false);
			Entity_SetVarString(GetHangerName(mlHanger_PlayerAttachedId), "Attached", "player");
			
			Map_AddTimer("Timer_EnterHangerFadeOut", 4.66, "OnTimer_EnterHangerFadeOut");
		}
		
		void OnTimer_EnterHangerFadeOut(const tString &in asTimer)
		{
			Effect_Fade_Out(0.1);
			Map_AddTimer("Timer_EnterHangerFadeIn", 0.1, "OnTimer_EnterHangerFadeIn");
		}
		
		void OnTimer_EnterHangerFadeIn(const tString &in asTimer)
		{
			Effect_Fade_In(0.1);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_StartHangerInteraction(const tString &in asAnimName)
		{
			EnterHangerIdle();
		}
		
		//-------------------------------------------------------
		
		void EnterHangerIdle(bool abReturnToIdle = false)
		{
			mbHanger_GettingIn = false;
			
			PlayerBody_FadeCutsceneMaxPitch(57, 0.2);
			PlayerBody_FadeCutsceneMaxYaw(44, 0.2);
			PlayerBody_PlayCutsceneAtSocket("player_idle_hanger", GetHangerName(mlHanger_PlayerAttachedId), "socket_player", true, 0, "", 1, 0, 0, 0, true, false, false);
			if (abReturnToIdle == false) PlayerBody_AttachToSocket(GetHangerName(mlHanger_PlayerAttachedId), "socket_player");
			
			iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
			pBody.Cutscene_AutoResetCamera(false);
			pBody.Cutscene_SetMaxPitch(cMath_ToRad(80.0f));
			pBody.Cutscene_SetMaxYaw(cMath_ToRad(80.0f));
		}
		
		//-------------------------------------------------------
		
		void StartExitHanger()
		{
			if (mlHanger_PlayerAttachedId < 0) return;
			if (mbHanger_ClimbingOut) return;
			if (mbHanger_CanClimbOut == false) return;
			if (mbHanger_GettingIn) return;
			mbHanger_ClimbingOut = true;
			
			bool bMoving = mbPitOfBodies_Entered;
			tString sAnim = bMoving ? "player_jump_down_hanger" : "player_climb_out_hanger";
			
			PlayerBody_FadeCutsceneMaxPitch(20, 0.2);
			PlayerBody_FadeCutsceneMaxYaw(45, 0.2);
			PlayerBody_SetInteractiveAnimationRange(0, 0.8, "");
			PlayerBody_PlayInteractiveAnimationAtSocket(sAnim, GetHangerName(mlHanger_PlayerAttachedId), "socket_player", 0.25f, "OnAnimEnd_ClimbOutOfHanger", true, true, true, 0.3f, true, false, true);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ClimbOutOfHanger(const tString &in asAnimName, float afT)
		{			
			mbHanger_ClimbingOut = false;
			if (afT <= 0.0f)
			{
				EnterHangerIdle(true);
			}
			else if (afT >= 1.0f)
			{
				mlHanger_PostExit = mlHanger_PlayerAttachedId;
				
				Entity_SetVarString(GetHangerName(mlHanger_PlayerAttachedId), "Attached", "");
				mlHanger_PlayerAttachedId = -1;
				PlayerBody_DetachFromEntity();
				
				if (mbPitOfBodies_Entered)
				{
					PlayerBody_PlayAnimation("jump_fall", ePlayerBodyAnimationLayer_FullBody, false, false, true, 0);
					
					Map_GetEntity("Hanger_Collision_" + mlHanger_PostExit).GetMainBody().SetCollideCharacter(false);
					Player_SetJumpDisabled(true);
					Map_AddTimer("Timer_ResetHangerCollision", 1, "OnTimer_ResetHangerCollision");
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetHangerCollision(const tString &in asTimer)
		{
			Player_SetJumpDisabled(false);
			Map_GetEntity("Hanger_Collision_" + mlHanger_PostExit).GetMainBody().SetCollideCharacter(true);
		}
		
