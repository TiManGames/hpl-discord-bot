	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource){}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("DEAD : SOURCE = " + asSource);
		
		if (asSource == "SomeReason")
		{
			Effect_Fade_Out(1.0f);
			return true; // return true to completely override base behaviour
		}
		
		// return false for default behaviour
		return false;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{		
		// return false for default behaviour (fadeout and death area)
		return false;
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			FogArea_SetVisible("PostFlood_FogArea", false);
			Entity_SetActive("PostFlood_WaterPlane_*", false);
		}
		
		if(alAction == eAction_Test2)
		{
			FogArea_SetVisible("PostFlood_FogArea", true);
			Entity_SetActive("PostFlood_WaterPlane_*", true);
		}
		
		if(alAction == eAction_Test3)
		{
			
		}
			
		if(alAction == eAction_Test4)
		{
			Player_Teleport("Start_MainRoom", true);
			DreamHandler_SetActive(true);
			ActivateZeroG();
			DoorFlyAway();
		}
			
		if(alAction == eAction_Test5)
		{
			Player_Teleport("Start_Flood", true);
			DreamHandler_SetActive(true);
			ActivateZeroG();
			DoorFlyAway();
		}
			
		if(alAction == eAction_Test6)
		{
			if (DreamHandler_GetIsActive()==false)
				DreamHandler_SetActive(true);
			
			Entity_SetActive("PostFlood_*", true);
			Player_Teleport("Start_PostFlood_0", true);
			Entity_SetActive("GiantInfant", false);
			FogArea_SetVisible("PostFlood_FogArea", true);
			//Sound_PlayGui("02_06_oasis/enviroment/water", 1.f);
			//Sound_CreateAtEntity("WaterSounds", "02_06_oasis/enviroment/water", "player", 0.1);
			Map_Preset_Fade("PostFlood_Preset_On", 0.05f);
			ActivateZeroG();
			Music_PlayExt("03_07_dream_sketch_B.ogg", true, 0.35f, 1.0f, 3.0f, 1.0f, eMusicPrio_BgAmb, true);
			Voice_SetSource("Child", "PostFlood_Child", 2, 60, true);
            PlayerBody_SetSwimStateActive(true, "Area_StartSwimming_0", "PostFlood_Child", "PostFlood_WaterPlane_1");
		}
			
		if(alAction == eAction_Test7)
		{
			Entity_PlayAnimation("Child_1", "idle_1", 0.1f, true);
		}
		
		if(alAction == eAction_Test8)
		{
			Player_SetActive(true);
		}
		
		if(alAction == eAction_Test9)
		{
			
		}
	}

