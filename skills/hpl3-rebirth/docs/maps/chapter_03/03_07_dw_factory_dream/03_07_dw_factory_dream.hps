		//-------------------------------------------------------
		
		void OnTimer_BlockTheWayBack(const tString&in asTimer)
		{
			
			Effect_Shake_Start(0.015f, 0.5f, 2.f, 1.f);
			ParticleSystem_CreateAtEntity("BrokenFloorDustPS", "dust_impact_large_oneshot.ps", "Area_BrokenFloor1_FXSource", false);
			Prop_MoveLinearTo("ds3_apartment_floor_bridge_01_1", "Area_BrokenFloor1_Destination", 1, 0.1, 1, false, "");
			Prop_MoveLinearTo("ds3_apartment_floor_bridge_02_1", "Area_BrokenFloor2_Destination", 1, 0.2, 1, false, "");
			Entity_SetActive("Trigger_FadeProp", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartTheFlood(const tString&in asTimer)
		{
			if (mbFloodSequenceBegan) return;
			
			if (SequenceStates_IsActive("Seq_FloodTheRoom")==false)
				Seq_FloodTheRoom("");
				
			mbFloodSequenceBegan = true;
		}
		
