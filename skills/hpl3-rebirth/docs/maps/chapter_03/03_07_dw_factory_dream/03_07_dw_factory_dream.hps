	////////////////////////////
	// Set up map environment
	void Setup()
	{
		GetBase().SetDisplayNameEntry("03-07-dw-factory-dream");
		
		// Set up color grading etc.
		Pregnancy_SetStage(ePregStage_Stage2);
		Pregnancy_SetBarksActive(false);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_TTH_AfterName);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(false);
		FearHandler_SetWhisperStage(eFearWhisperStage_MilkingToDWFA);
				
		/////////////////
		// Global lighting and PPFx
		Map_Preset_SetupDirLight("SunlightOff", false, cColor(0.417,0.643,0.592,1), 0.05f, cVector3f(-0.287, -0.532, -0.797), cColor(0,0,0), cColor(0,0,0));
		Map_Preset_SetupFog("SunlightOff", true, 50, 100, 1, cColor(0.214,0.365,0.353,1), 1.f, false, false);
		Map_Preset_SetupFog("EnvironmentLightOn", true, 2, 100, 1, cColor(0.224,0.09,0.09,1), 1.f, false, false);
		
		Map_Preset_SetupDirLight("EnvironmentLightOn", true, cColor(1,0.709,0.543,1), 0.5f, cVector3f(-0.287, -0.532, -0.797), cColor(0.138,0.174,0.172,1), cColor(0.064,0.08,0.08,1));
		Map_Preset_SetupDirLight("PostFlood_Preset_On", true, cColor(0.417,0.643,0.592,1), 0.25f, cVector3f(0.87, -0.444, 0.212), cColor(0.137,0.173,0.173,1), cColor(0.137,0.173,0.173,1));
		
		Map_SetSkyboxRotation(cVector3f(-0.5, 2.0, -0.2));
		
		Map_Preset_Fade("SunlightOff", 0.001f);
		
		StruggleFlashHandler_SetActive(false);
		
		Player_SetAutoTeleportWhenBelowAltitude(-8);
	}
	
	//-------------------------------------------------------
		
