			return true;
		}
		
		//-------------------------------------------------------
		
		void ActivateZeroG()
		{
			/////////////////////////////
			// Release any grabbed bodies
			if (Player_GetCurrentStateName()=="State_Interact_Grab")
				Player_ChangeStateToNormal();
				
			////////////////
			// Get all the physics bodies within a specified area.
			array <iPhysicsBody@> vPhysicsBodies;
			cVector3f vMin = Map_GetEntity("ZeroG_Body_Tracker").GetMeshEntity().GetBoundingVolume().GetMin();
			cVector3f vMax = Map_GetEntity("ZeroG_Body_Tracker").GetMeshEntity().GetBoundingVolume().GetMax();
			GetBase().GetPhysicsWorld().GetBodiesInAABB(vMin, vMax, vPhysicsBodies);
			
			for(int i=0; vPhysicsBodies.size()>0 && i<vPhysicsBodies.size(); ++i)
			{
				//////////////////
				// Disable Gravity
				iPhysicsBody@ pCurrentPhysBody = vPhysicsBodies[i];
				if (pCurrentPhysBody is null) continue;
				if (pCurrentPhysBody.GetMass()<=0) continue;
				
				pCurrentPhysBody.SetGravity(false);
			}
		}
		
