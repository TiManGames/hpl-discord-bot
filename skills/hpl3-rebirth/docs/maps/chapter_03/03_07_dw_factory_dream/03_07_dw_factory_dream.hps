	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(15);
		
		// Any general setup of script / entities
		ParticleSystem_SetActive("PS_Window_Water_Fx_*", false);
		ParticleSystem_SetActive("PS_Flood_Water_Fx", false);
		ParticleSystem_SetActive("PS_Window_Water_Splash_Fx_*", false);
		
		//////////////////////////////////
		// Disable the post-flood entities
		Entity_SetActive("PostFlood_*", false);
		ParticleSystem_SetActive("PostFlood_*", false);
		ParticleSystem_SetVisible("PostFlood_*", false);
		FogArea_SetVisible("PostFlood_FogArea", false);
		FogArea_SetVisible("Flood_Water_FogArea", false);
		
		//////////////
		// Attachments
		ParticleSystem_AttachToEntity("PostFlood_Window_Splash_PS", "PostFlood_Window");
		ParticleSystem_AttachToEntity("PostFlood_Window_Splash_PS_1", "PostFlood_BrokenWall_Movable");
		
		Entity_AttachToSocket("BlurFX_Child_1", "Child_1", "Head_Socket", false, false);
		Entity_AttachToSocket("BlurFX_Child_2", "PostFlood_Child", "Head_Socket", false, false);

		
		//////////
		// Ligting
		Effect_Fade_Out(0.001);
		Map_Preset_Fade("SunlightOff", 0.001f);
		
		Map_AddTimer("Timer_FadeFromDarkness", 0.1, "OnTimer_FadeFromDarkness");
		
		Player_SetActive(false);
		
		///////////////
		// Child Idling
		Entity_PlayAnimation("Child_1", "idle_1", 0.1f, true);
		
		 ActivateZeroG();
		 
		Player_SetPregnancyExertionActive(false);

		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			/////////////////////////
			// Inventory
			if (ItemType_GetCountInInventory("Lantern") < 1)
			{
				Item_AddToInventory("Lantern");
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
				Item_AddToInventory("ModernOilFixed");
				Item_AddToInventory("ModernOilFixed");
				Item_AddToInventory("ModernOilFixed");
			}
			
			if (ItemType_GetCountInInventory("Orb") < 1)
				Item_AddToInventory("Orb");
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		PlayerBody_SetModel("player.ent");
		PlayerBody_SetActive(true);
        Heat_SetActive(false);
        
        DreamHandler_SetActive(true);
		//Player_SetNightVisionEnabled(false);
		Player_SetCrouching(false, true, true);
		
		FearHandler_SetActive(false);
        Player_SetVertigoActive(false);
        
        Pregnancy_SetBabyKicksEnabled(false);
		
		Voice_SetSource("Child", "Child_1", 2, 60, true);
		
		if (Entity_IsActive("GiantInfant"))
			Entity_PlayAnimation("GiantInfant", "idle", 0.02, true);
		
		//iTexture@ pSkybox = cResources_CreateTextureCubeMap("flesh_fresnel_gradient.dds",true);
        //cLux_GetCurrentMap().GetWorld().SetFogSkyboxTexture(pSkybox);
		
		cVector3f vRot = cVector3f(0, cMath_ToRad(10), 0);
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);
		
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
	}

