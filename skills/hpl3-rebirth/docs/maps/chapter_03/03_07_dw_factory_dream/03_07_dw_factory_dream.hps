		/////////////////////////////////////////
		// Event C *THE FLOOD*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		cSequenceStatesData mSeq_FloodTheRoom;
		cSequenceStatesData mSeq_InfantGrow;
		cSequenceStatesData mSeq_SoundBabyThunder;
		bool mbBlockingWallFell = false;
		bool mbSoundBabyThunder = false;

		//-------------------------------------------------------
		
		void SetSwimSpeedMul(const float afMul)
		{
			cScript_SetGlobalArgFloat(0, afMul);
			cScript_RunGlobalFunc("MoveState_Swim", "", "_Global_SetSwimSpeedMultiplier");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_StartTheFlood(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			if (mbFloodSequenceBegan) return false;
			
			Map_AddTimer("OnTimer_StartTheFlood", 1.f, "OnTimer_StartTheFlood");
			return false;
		}
		
		//-------------------------------------------------------
		
		void Seq_FloodTheRoom(const tString &in asTimer)
		{
			Sequence_Begin("Seq_FloodTheRoom", mSeq_FloodTheRoom);
			
			if (Sequence_DoStepAndWait(0.5f))
			{
				cLux_AddDebugMessage("FLOOD SCENE STARTED!");
				Entity_PlayAnimation("Child_1", "flooding", 0.15f, false, true, "OnAnimEnd_ChildPlayIdle2");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Sound_CreateAtEntity("Sound_Baby_VocalWater", "level_dreams/baby_vocals/baby_vocal_water", "player");
				Sound_CreateAtEntity("Sound_WindowCreak_1", "level_dreams/window/window_creak_01", "Sound_WaterWindow");
				Sound_CreateAtEntity("Sound_WaterTrickleStart", "level_dreams/water/water_trickle_start", "Sound_WaterFloor");
				Sound_Stop("Sound_RainHeavy", 4.0f);
			}
			else if (Sequence_DoStepAndWait(5.f))
			{
				Voice_Play("ChildDialog4", -1, "", 1);
				Effect_Shake_Start(0.025f, 1.f, 1.f, 3.f);
			}
			else if (Sequence_DoStepAndWait(0.8f))
			{
				// Break upper left part of the window
				
				Effect_Shake_Start(0.083f, 0.5f, 0.1f, 1.f);
				
				Sound_CreateAtEntity("Sound_WaterSplash", "level_dreams/water/water_pour_start", "Sound_WaterFloor");
				Sound_CreateAtEntity("Sound_WaterFloor", "level_dreams/water/water_floor_loop", "Sound_WaterFloor");
				Sound_CreateAtEntity("Sound_WaterPour", "level_dreams/water/water_pour", "Sound_WaterWindow");
				
				ParticleSystem_SetActive("PS_Window_Water_Fx_*", true);
				ParticleSystem_CreateAtEntity("BreakingGlassSmallPS", "grass_breaking_small.ps", "Area_WindowGlassBreakSmallPSSource", false);
				
				DreamHandler_PregnancyContractions();
				
				Entity_SetActive("apartment_window_broken_01", false);
				Entity_SetActive("apartment_window_broken_02", true);
				
				Music_Stop(20.0f, eMusicPrio_BgAmb);
			}
			else if (Sequence_DoStepAndWait(3.f))
			{
				ParticleSystem_SetActive("PS_Window_Water_Splash_Fx_*", true);
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				Player_StartLookAt("Area_LookAtWindow", 1, 4, 8);
				Effect_Shake_Start(0.05f, 0.5f, 0.25f, 1.f);
				
				Sound_Stop("Sound_WaterFloor", 3.0f);
				Sound_Stop("Sound_WaterPour", 3.0f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				ParticleSystem_SetActive("PS_Flood_Water_Fx", true);
				Sound_CreateAtEntity("Sound_WaterFlood", "level_dreams/water/water_flood_burst", "player");
				Sound_Stop("Sound_WaterTrickleSweet", 1.0f);
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				// Break the entire window
				Effect_Shake_Start(0.15f, 0.5f, 0.1f, 1.f);
				
				Entity_SetActive("apartment_window_broken_02", false);
				Entity_SetActive("apartment_window_broken_03", true);
				
				ParticleSystem_CreateAtEntity("BreakingGlassPS", "grass_breaking_full.ps", "Area_WindowFxSource", false);
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Player_StopLookAt(0.2f);
				
				Entity_SetActive("Flood_Water_Plane", true);
				FogArea_SetVisible("Flood_Water_FogArea", true);
				
				/////////////////
				// Flood cutscene
				Player_SetActive(false);
				PlayerBody_PlayCutsceneAtEntity("player_flushed_into_the_sea","Area_FlushedIntoTheSeaAnimStart", false, 0.25f, "", 1.f);
				Sound_Stop("Sound_WaterFlood", 0.60f);
				Sound_CreateAtEntity("Sound_WaterrImpact", "level_dreams/water/water_flood_impact", "player");
				Entity_SetActive("Soundscape_Ocean",true);
				Entity_SetActive("Soundscape_BrokenRoom",false);
				
				///////////////////
				// Cam splash fx ps
				ParticleSystem_CreateAtEntity("Underwater_Camera_PS", "underwater_screen_fx.ps", "player", true);
			}
			else if (Sequence_DoStepAndWait(0.4f))
			{
				Effect_Fade_Out(1.4f);
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				///////////////////////////////////
				// Setup the post-flood environment
				Entity_SetActive("PostFlood_*", true);
				FogArea_SetVisible("PostFlood_FogArea", true);
				Map_Preset_Fade("PostFlood_Preset_On", 0.05f);
				ParticleSystem_SetActive("PS_Window_Water_Fx_*", false);
				ParticleSystem_SetActive("PS_Flood_Water_Fx", false);
				ParticleSystem_SetActive("PostFlood_*", true);
				ParticleSystem_SetVisible("PostFlood_*", true);
				Light_FadeBrightnessTo("GiantInfant_Light", 0.f, 0.01f);
				Entity_SetActive("GiantInfant", false);
				ParticleSystem_SetActive("Underwater_Camera_PS", false);
				ParticleSystem_SetVisible("Underwater_Camera_PS", false);
				
				/////////////////////////
				// Setup the second child
				Voice_SetSource("Child", "PostFlood_Child", 2, 60, true);
				Entity_PlayAnimation("PostFlood_Child", "floating", 0.1f, true);
			}
			else if (Sequence_DoStepAndWait(1.8f))
			{
				Music_PlayExt("A2_3_7_DW_Factory_Dream_B.ogg", true, 0.35f, 1.0f, 3.0f, 1.0f, eMusicPrio_BgAmb, true);
				
				//////////////////
				// Swim to surface
				Effect_Fade_In(0.5f);
				Player_SetActive(true);
				PlayerBody_PlayCutsceneAtEntity("player_swim_to_surface", "Area_StartSwimming_0", false, 0.3f, "", 1, 0.7);
			}
			else if (Sequence_DoStepAndContinue())
			{
				Map_AddTimer("Timer_CallAmari", 2.5f, "OnTimer_CallAmari");
					
				////////////////////////////
				// Switch to swimming state
				PlayerBody_SetSwimStateActive(true, "Area_StartSwimming_0", "PostFlood_Child", "PostFlood_WaterPlane_1", 1.f);				
				cLux_AddDebugMessage("SWIM STATE STARTED!");
				
				///////////////////////
				// Get rid of bubble PS
				ParticleSystem_SetActive("PostFlood_Underwater_Bubbles_*", false);
				ParticleSystem_SetVisible("PostFlood_Underwater_Bubbles_*", false);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CallAmari(const tString&in asTimer)
		{
			Voice_Play("ChildDialog5");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_TriggerSoundThunder(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (SequenceStates_IsActive("Seq_SoundBabyThunder")==false)
				Seq_SoundBabyThunder("");
				
			mbSoundBabyThunder = true;
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void Seq_SoundBabyThunder(const tString &in asTimer)
		{
			Sequence_Begin("Seq_SoundBabyThunder", mSeq_SoundBabyThunder);
			
			if (Sequence_DoStepAndWait(7.f))
			{
				Sound_Play("Sound_FloodThunder_1", 1.0f);
				Sound_CreateAtEntity("Sound_BabyThunderVox_1", "level_dreams/thunder/baby/baby_sweet_01", "GiantInfant");
				
				Sound_CreateAtEntity("Sound_OceanSweet_1", "level_dreams/sweeteners/flood/ocean_sweet", "player");
			}
			else if (Sequence_DoStepAndWait(10.f))
			{
				Sound_Play("Sound_FloodThunder_2", 1.0f);
				Sound_CreateAtEntity("Sound_BabyThunderVox_2", "level_dreams/thunder/baby/baby_sweet_02", "GiantInfant");
			}
			else if (Sequence_DoStepAndWait(9.5f))
			{
				Sound_Play("Sound_FloodThunder_3", 1.0f);
				Sound_CreateAtEntity("Sound_BabyThunderVox_3", "level_dreams/thunder/baby/baby_sweet_03", "GiantInfant");
				
				Sound_CreateAtEntity("Sound_OceanSweet_2", "level_dreams/sweeteners/flood/ocean_sweet_2", "player");
			}
			else if (Sequence_DoStepAndWait(7.0f))
			{
				Sound_Play("Sound_FloodThunder_4", 1.0f);
				Sound_CreateAtEntity("Sound_BabyThunderVox_4", "level_dreams/thunder/baby/baby_sweet_04", "GiantInfant");
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				Sound_Play("Sound_FloodThunder_5", 1.0f);
				Sound_CreateAtEntity("Sound_BabyThunderVox_5", "level_dreams/thunder/baby/baby_sweet_05", "GiantInfant");
				
				Sound_CreateAtEntity("Sound_OceanSweetEnd", "level_dreams/sweeteners/flood/ocean_sweet_end", "player");
			}
			else if (Sequence_DoStepAndWait(4.5f))
			{
				Sound_Play("Sound_FloodThunder_6", 1.0f);
				Sound_CreateAtEntity("Sound_BabyThunderVox_6", "level_dreams/thunder/baby/baby_sweet_06", "GiantInfant");
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				Sound_Play("Sound_FloodThunder_7", 1.0f);
				Sound_CreateAtEntity("Sound_BabyThunderVox_7", "level_dreams/thunder/baby/baby_sweet_07", "GiantInfant");
			}

			Sequence_End();
		}
			
		//-------------------------------------------------------

		//} END Event C *THE FLOOD*
		
		/////////////////////////////////////////
		// Event D *ENDING*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		cSequenceStatesData mSeq_Drowning;
		bool mbPlayerIsDrowning = false;
		
		//-------------------------------------------------------
		
		void PlayEndingDialog()
		{
			Voice_Play("Dialogue_AmariSwimBarks", -1, "OnVoiceEnd_PrepareTasiReply");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_PrepareTasiReply(const tString&in asScene, const tString&in asSubject)
		{
			Map_AddTimer("Timer_TasiReply", 1.f, "OnTimer_TasiReply");
		}
		
		//-------------------------------------------------------
			
		void OnTimer_TasiReply(const tString&in asTimer)
		{
			tString sCallback = "OnVoiceEnd_PregnancyContractions";
			Voice_Play("Dialogue_TasiSwimBarks", -1, sCallback);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PullWindowAway(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			
			if (asParent=="Trigger_PullWindowAway_1")
			{
				Prop_MoveLinearTo("PostFlood_Window", "Area_WindowMoveDestination_2", 1.f, 1.5f, 1.f, true, "");
				Sound_CreateAtEntity("Moving_Debris", "01_02_caves/events/shadow_roar/quake_start_debris_01", "Area_MovingDebrisSoundSource", 1.f);
			}
			else if (asParent=="Trigger_PullWindowAway_3")
			{
				SetSwimSpeedMul(0.6f);
			}

			PlayEndingDialog();
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Prop_EndingFlash(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			
			StartDrowning();
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EndingFlash(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			
			StartDrowning();
			return false;
		}
		
		//-------------------------------------------------------
		
		void StartDrowning()
		{
			if (mbPlayerIsDrowning) return;
			
			if (SequenceStates_IsActive("Seq_Drowning")==false)
				Seq_Drowning("");
			
			mbPlayerIsDrowning = true;
		}
		
		//-------------------------------------------------------
		
		void Seq_Drowning(const tString &in asTimer)
		{
			Sequence_Begin("Seq_Drowning", mSeq_Drowning);
			
			if (Sequence_DoStepAndWait(5.f))
			{
				PlayerBody_PlayCutsceneAnimation("player_swim_drown", false, 0.25f, "", 1.f, 0.45f);
				Sound_CreateAtEntity("Sound_PlayerSwimDrown", "level_dreams/swim/drown", "player");
				Voice_Play("Dialogue_TasiDrowns");
			}
			else if (Sequence_DoStepAndWait(3.5f))
			{
				FearHandler_SetForcedAddFearRate(2, 5.f, false, 3, 0.1f);
				Effect_Flash_Start(3.25f, 0.25f, 0);
			}
			else if (Sequence_DoStepAndContinue())
			{
				PlayerBody_StopAnimationLayer(ePlayerBodyAnimationLayer_FullBody, 0.f);
				Map_ChangeMap("04_01_town.hpm", "Start_Begin", "", "");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------

		//} END Event D *ENDING*
	 
	//} END SCENE 1 *THE HOME*
}