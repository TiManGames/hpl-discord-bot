		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlayDialog_2(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			Voice_Play("ChildDialog2", -1, "", 1);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlayDialog_3(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			Entity_SetActive("Prop_FloorBridge_Blocker", true);
			
			Voice_Play("ChildDialog3", -1, "", 1);
