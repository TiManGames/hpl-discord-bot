		//-------------------------------------------------------
		
		bool OnCollide_Door_DoorFlyAway(const tString &in asParent, const tString &in asChild, int alState)
		{
			DoorFlyAway();
			return false;
		}
		
		//-------------------------------------------------------
		
		void DoorFlyAway()
		{
			Player_SetNightVisionEnabled(false);
			
			FearArea_SetSafe("FearArea_1", true);
			
			//////////
			// Effects
			Effect_DoF_Start(3.5f, 280, 1.5f, 2);
			
			////////////////
			// Get some data
			iLuxEntity@ pSwingDoorEnt = Map_GetEntity("SwingDoor_Intro", eLuxEntityType_Prop);
			iLuxEntity@ pRigidDoorEnt = Map_GetEntity("SwingDoor_Intro_Rigid", eLuxEntityType_Prop);
			iLuxEntity@ pImpulseSourceEnt = Map_GetEntity("Area_DoorImpulseSource", eLuxEntityType_Area);
			if (pSwingDoorEnt==null || pRigidDoorEnt==null || pImpulseSourceEnt==null) return;
			
			////////////////
			// Swap door ent
			pSwingDoorEnt.SetActive(false);
			pRigidDoorEnt.SetActive(true);
			pRigidDoorEnt.SetMatrix(pSwingDoorEnt.GetMatrix());
			
			///////////////////////
			// Transfer angular vel and push door away
			pRigidDoorEnt.GetMainBody().SetGravity(false);
			pRigidDoorEnt.GetMainBody().SetAngularVelocity(pSwingDoorEnt.GetMainBody().GetAngularVelocity());
			
			iPhysicsBody@ pCurrentPhysBody = pRigidDoorEnt.GetMainBody();
			cVector3f vImpulseDir = pCurrentPhysBody.GetWorldPosition() - pImpulseSourceEnt.GetPosition();
			vImpulseDir = cMath_Vector3Normalize(vImpulseDir);
			pCurrentPhysBody.AddImpulse(vImpulseDir * 1.5f);
			
			Entity_SetCollide("SwingDoor_Intro_Rigid", false);
			
			/////////////
			// Handle the surrounding lights
			Light_FadeBrightnessTo("Light_Door_Emition_*", 0.f, 0.1f);
			Light_FadeBrightnessTo("outside_light_*", 0, 4.0f);
			Map_Preset_Fade("EnvironmentLightOn", 0.05f);
			
			///////
			// Reset col properties
			Map_AddTimer("OnTimer_ResetCol", 1.f, "OnTimer_ResetCol");
				
			//////////////
			// Play sounds
			Sound_CreateAtEntity("Sound_DoorFly", "level_dreams/sweeteners/flood/door_fly", "SwingDoor_Intro_Rigid");
			Sound_CreateAtEntity("Sound_DoorStinger", "level_dreams/sweeteners/flood/door_sweet", "player");
			Sound_Play("Sound_RainLight", 1.0f);
			
			Map_AddTimer("OnTimer_PlayerSurprised", 0.2f, "OnTimer_PlayerSurprised");
			
			//////////////////
			// Start the music
			Music_PlayExt("A2_3_7_DW_Factory_Dream_A.ogg", true, 0.15f, 1.0f, 3.0f, 1.0f, eMusicPrio_BgAmb, true);
			
			ActivateZeroG();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetCol(const tString&in asTimer)
		{
			Entity_SetActive("Block_FlyingDoorProtector", false);
		}
		
