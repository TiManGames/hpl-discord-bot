			//Rope_SetTotalLength("CageRope_2",3.f);
			//Rope_StretchToLength("CageRope_2",3,1);
			//MoveObject_SetState("Cage_Test_TopLow",1);
			
		}
		if (alAction == eAction_Test0)
		{	
			Entity_PlayAnimation("Machine","tth_pool_machine_whitebox_chop",0.1f,true); return;
			TortureEncounter_Setup(true);
			Entity_PlayAnimation("Torture_Chains", "tdevice_chains_generic_torture_c", 0.5f);
