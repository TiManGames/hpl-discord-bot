		float mfOrigSlideSlopeAngle = 0.f;

		//-------------------------------------------------------
		
		bool OnTrigger_Player_PlayerSlide(const tString &in asParent, const tString &in asChild, int alState)
		{			
			if (mfOrigSlideSlopeAngle == 0.f)
				mfOrigSlideSlopeAngle = cLux_GetPlayer().GetCharacterBody().GetMaxNoSlideSlopeAngle();
			
			float fAngle = alState == 1 ? 0.f : mfOrigSlideSlopeAngle;
			cLux_GetPlayer().GetCharacterBody().SetMaxNoSlideSlopeAngle(fAngle);		
			return true;
		}
		
		void OnStateChange_UnlockLadder(const tString &in asEntity, int alState)
		{
			if (alState == 0) return;
			if (alState == 1) // UP
			{
				cLux_AddDebugMessage("LADDER UNLOCKED");
				SlideDoor_SetClosed("tin_hinan_slide_floor_up_1",false);
				Lamp_SetLit("lamp_ladder_*", true, true);
			}
		}
			
		//-------------------------------------------------------
		
		bool OnTrigger_SetAreaTunnel(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Stop("Sound_MainLoop", 0.5f);
			Sound_Stop("Sound_CaveLoop", 0.5f);
			
			Sound_Play("Sound_TunnelSweet", 0.05f);
			Sound_Play("Sound_MainLoopTunnel", 0.05f);
			Sound_Play("Sound_TunnelLoop", 0.05f);
			
			Entity_SetActive("Trigger_SoundMachineCave",true);
			Entity_SetActive("Trigger_SoundMachineTunnelEnter",false);
			
			FearHandler_SetActive(false);
			
			mbAreaRoom = false;
			mbAreaTunnel = true;
			mbAreaCave = false;
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_SetAreaCave(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Stop("Sound_TunnelSweet", 0.5f);
			Sound_Stop("Sound_MainLoopTunnel", 0.5f);
			Sound_Stop("Sound_TunnelLoop", 0.5f);
			
			Sound_Play("Sound_CaveLoop", 0.05f);
			Entity_SetActive("Trigger_SoundMachineTunnelEnter",true);
			Entity_SetActive("Trigger_SoundMachineCave",false);
			
			FearHandler_SetActive(true);

			mbAreaRoom = false;
			mbAreaTunnel = false;
			mbAreaCave = true;
			return true;
		}
		
