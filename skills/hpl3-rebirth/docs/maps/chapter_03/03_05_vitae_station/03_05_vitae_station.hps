		void Rail_Collapse(const tString &in asName)
		{
			Prop_SetStaticPhysics(asName,false);
			Entity_AddImpulse(asName,cVector3f(0,-1,0),true,true);
			Map_AddTimer(asName,3,"OnTimer_RemoveRail");
		}
		
