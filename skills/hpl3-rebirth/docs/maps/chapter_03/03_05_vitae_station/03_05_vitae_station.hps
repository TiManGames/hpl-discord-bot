			//Debug_Log("TORTURE GHOUL ACTIVE: "+Entity_IsActive(msTortureGhoul)); return;
			//Debug_Log("DOOR STATE - Blocked: "+SwingDoor_GetBlocked("SwingDoor_TortureCell_1")+", Locked: "+SwingDoor_GetLocked("SwingDoor_TortureCell_1")+", Closed: "+SwingDoor_GetClosed("SwingDoor_TortureCell_1")); return;
			//mbLeonPoolEncounter = true;
			//Player_Teleport("Start_PoolOfBodies_Inside");
			//SlideDoor_SetClosed("Portcullis_MachineExit",false);
