	bool OnCamAnimNodePass_TeleportPlayer(const tString &in asEntity, int alDirection)
	{
		// TODO: Use proper sound for entering the tunnel.
		// Teleport the player outside the ghoul hole to avoid falling outside geometry.
		Player_Teleport("Start_ControlRoom", true);
		return false;
	}
	
