		// Event B - HUNTING GROUNDS (STAGE 1)
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 3, Event B here.*/
		
		int mlConfusedBarks = 0;

		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 3, Event B here.*/
		
		bool OnCollide_Player_ActivateLeonStage1(const tString &in asParent, const tString &in asChild, int alState)
		{
			LeonStage1_Activate();
			FearHandler_SetPermaFailEnabled(true);;
			SlideDoor_SetClosed("Portcullis_HG_AfterTrap_1",true);
			SlideDoor_SetClosed("Portcullis_HG_Trap_1",true);
			SlideDoor_SetClosed("Portcullis_HG_Trap2_1",true);
			
			PressurePlate_ManageTriggersStage(3);
			Map_AddTimer("Timer_ShowLeanHint", 1.f, "OnTimer_ShowLeanHint");
			return false;
		}
		
		//--------------------------------------------------------
		
		void OnTimer_ShowLeanHint(const tString &in asTimer)
		{
			if (cScript_GetGlobalVarInt("Lean_LastLevelUsedIn") <= 21 && 
				cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal)
			{
				Hint_RemoveFromGiven("Hints", "HintLean");
				Hint_ShowHint("Hints", "HintLean", true);
			}
		}

		//--------------------------------------------------------
		
		void LeonStage1_Activate()
		{
			if (mlLeonStage != 0) return;
			
			Entity_SetActive(msLeon,false);
			msLeon = "Ghoul_LeonStage1";
			Entity_SetActive(msLeon,true);
			Voice_SetSource("Leon",msLeon,0,25,true);
			Voice_SetSource("Leon_Unknown",msLeon,0,25,true);
			FearThreatAgent_SetSurpriseFactor(msLeon,0);
			Leon_SetCustomFearValues(true);
			mlLeonStage = 1;
			Ghoul_Mode_Set(msLeon,eGhoulMode_Idle,true);
			Agent_SetSensesActive(msLeon,false);
			Entity_SetVarString(msLeon,"Anim","panic_struggle_banging_head_ls");
			Map_AddTimer("Timer_LeonStage1_Confused", 5, "OnTimer_LeonStage1_Confused");
			Map_AddTimer("Timer_LeonStage1_AnimManager", 0, "OnTimer_LeonStage1_AnimManager");
			Sound_CreateAtEntity("Sound_LeonHuntSweet_P1", "level_amb_shared/amb/sweeteners/03_05_vitae_station/leon_hunting_grounds_sweet", "Ghoul_LeonStage1");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_JumpGates(const tString &in asParent, const tString &in asChild, int alState)
		{
			PressurePlate_ManageTriggersStage(4);
			SlideDoor_SetClosed("Portcullis_HG_JumpGates_*",true);
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool mbLeonStage1ForceBanging = false;
		
		bool OnCollide_Player_ForceLeonStage2Banging(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_RemoveTimer("Timer_LeonStage1_AnimManager");
				mbLeonStage1ForceBanging = true;
				Map_AddTimer("Timer_LeonStage1_AnimManager", 0, "OnTimer_LeonStage1_AnimManager");
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage1_AnimManager(const tString &in asTimer)
		{
			
			
			tString sAnim = Entity_GetVarString(msLeon,"Anim");
			if (mbLeonStage1ForceBanging) 
			{
				sAnim = "panic_struggle_banging_head_ls";
				mbLeonStage1ForceBanging = false;
				FearHandler_SetForcedAddFearRate(.3f,2,false);
			}
			CharMover_PlayAnimation(msLeon, sAnim, 0.3f, true, true, "");
			//Ghoul_PlayCutsceneAtEntity(msLeon,sAnim,"PosArea_LeonStage1",.3f,true,"");
			//Agent_PlayCutsceneAtEntity(msLeon,sAnim,"PosArea_LeonStage1",.3f,true);
			Debug_Log("ANIM: "+sAnim);
			// PICK NEW ANIM
			
			tString sNextAnim = "";
			float fAnimTime = 0;	
			float fRand = cMath_RandRectf(0,1);
			
			if (sAnim == "panic_struggle_hanging_down_ls")		sNextAnim = (fRand > .3f) ? "panic_struggle_rocking_ls" : "panic_struggle_banging_head_ls"; 		// HANG
			else if (sAnim == "panic_struggle_rocking_ls")		sNextAnim = (fRand > .7f) ? "panic_struggle_banging_head_ls" : "panic_struggle_hanging_down_ls";	// ROCK
			else												sNextAnim = (fRand > .4f) ? "panic_struggle_rocking_ls" : "panic_struggle_hanging_down_ls";			// BANG
						
			if (sAnim == "panic_struggle_hanging_down_ls")		fAnimTime = cMath_RandRectf(5,8); 	// HANG
			else if (sAnim == "panic_struggle_rocking_ls")		fAnimTime = cMath_RandRectf(4,6);	// ROCK
			else												fAnimTime = cMath_RandRectf(3,6); 	// BANG
			
			Debug_Log("NEW ANIM: "+sNextAnim);
			
			Entity_SetVarString(msLeon,"Anim",sNextAnim);
			Map_RestartCurrentTimer(fAnimTime);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage1_Confused(const tString &in asTimer)
		{
			if (mlConfusedBarks > 11) return;
			
			float fAnimTime = 0;
			
			Voice_StopAll();
			Voice_Play("Leon_AfterTrap_ConflictIdle");
			mlConfusedBarks++;
			
			fAnimTime = (mlConfusedBarks < 7) ? cMath_RandRectf(10,17) : cMath_RandRectf(18,26);
			
			Map_RestartCurrentTimer(fAnimTime);			
		}
		
		//-------------------------------------------------------
		
		float mfFearLevelBeforeWarn = 0;
		float mfFearLevelWarn = 0.8f;
		float mfFearLevelAfterWarn = 0;
		
		bool OnCollide_Player_LeonStage1_WarnPlayer(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mfFearLevelBeforeWarn = FearHandler_GetLevel();
				//FearHandler_FadeLevelTo(mfFearLevelWarn,1);
				//FearHandler_SetForcedAddFearRate(.6f,10,false);
				Debug_Log("WARN");
				Map_RemoveTimer("Timer_LeonStage1_AnimManager");
				if (Map_TimerExists("Timer_LeonStage1_Confused"))
				{
					Map_RemoveTimer("Timer_LeonStage1_AnimManager");
					//Agent_FaceEntity(msLeon,"player");
					Ghoul_SetPlayerThrowForcedDirection(msLeon,7);
					//CharMover_PlayAnimation(msLeon, "angry_1", 0.3f, true, false, "");
					Map_RemoveTimer("Timer_LeonStage1_Confused");
				}
				//Music_AddDynamicTrack(cLux_GetCurrentMap().GetPlayerEntity().GetID(), 0, eMusicPrio_AgentToAlertTransition, "A2_Proto_GhoulSearch", 0.6f, 3.0f, 3.0f);
				//Sound_CreateAtEntity("Sound_Alert", "player/UI/terror_meter/terror_meter_loop", "player");
				Map_AddTimer("Timer_LeonStage1_Warning", 0, "OnTimer_LeonStage1_Warning");
			}
			else
			{
				Debug_Log("STOP WARN");
				Agent_FaceEntity(msLeon,"tth_pillar_push_11");
				//Music_Stop(3.0f, eMusicPrio_AgentToAlertTransition);
				//Sound_Stop("Sound_Alert", 3.f);
				Entity_SetVarString(msLeon,"Anim","panic_struggle_hanging_down_ls");
				Map_AddTimer("Timer_LeonStage1_AnimManager", 0, "OnTimer_LeonStage1_AnimManager");
				Map_AddTimer("Timer_LeonStage1_Confused", 2, "OnTimer_LeonStage1_Confused");
				Map_RemoveTimer("Timer_LeonStage1_Warning");
				mfFearLevelAfterWarn = FearHandler_GetLevel();
				float fFearLevelDiff = mfFearLevelAfterWarn-mfFearLevelWarn;
				//FearHandler_FadeLevelTo(mfFearLevelBeforeWarn+fFearLevelDiff,2);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_LeonStage1_AttackPlayer(const tString &in asParent, const tString &in asChild, int alState)
		{
			
			if (alState == 1)
			{
				Debug_Log("ATTACK");
				Sound_CreateAtEntity("Sound_GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_spot", msLeon);		
				Agent_SetSensesActive(msLeon,true);
				Ghoul_Mode_Set(msLeon,eGhoulMode_Hunt,true);
				
				Map_RemoveTimer("Timer_LeonStage1_Confused");
				Map_RemoveTimer("Timer_LeonStage1_Warning");
				
				//Entity_SetActive("Trigger_LeonStage1Warning",false);
				//Entity_SetActive("Trigger_LeonStage1Attack",false);
				
				Voice_StopAll();
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage1_Warning(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_Play("Leon_AfterTrap_BackOff");	
			float fNewTime = cMath_RandRectf(4,5);
			Map_RestartCurrentTimer(fNewTime);
		}
		
		//-------------------------------------------------------
		
		void DeathScenario_OnDeath_LeonGoesStage2(const tString &in asSource)
		{
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			Agent_SetSensesActive(asSource,false);
			Ghoul_Mode_Set(asSource,eGhoulMode_Idle,true);
			Death_PickRespawnArea("Death_HG_KilledAtStage1");
			Effect_Fade_Out(0.4f);
			Map_AddTimer("Timer_DelayedRespawn",0.4f,"OnTimer_DelayedRespawn");
		}
		
		//-------------------------------------------------------
		
		bool DeathScenario_OnRespawn_LeonGoesStage2(const tString &in asSource)
		{
			Entity_SetActive(asSource,false);
			Player_SetForceCrawling(false);
			Player_SetMoveSpeedMul(1);
			Player_SetLookSpeedMul(1);
			Map_AddTimer("Timer_DelayedFadeIn",2,"OnTimer_DelayedFadeIn");
			return false;
		}
		
