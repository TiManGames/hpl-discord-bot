			Entity_SetAnimationRelativeTimePosition("Fairchild_Dead","fairchild_milking_machine_attracted",1);
			Entity_SetAnimationPaused("Fairchild_Dead","fairchild_milking_machine_attracted",true);
			Voice_StopAll();
		}
		if (alAction == eAction_Test9)
		{	
			mbFairchildAttacked = true;
			mbMilkingDeviceUsed = true;
			OnCollide_Cage_Move("","",1);
			Player_Teleport("Start_PoolOfBodies_Begin");
			Entity_SetActive("Portcullis_Pool_8",false);
			Seq_PoolOfBodies("");
			//Cage_ChangePosition("Cage_2");
