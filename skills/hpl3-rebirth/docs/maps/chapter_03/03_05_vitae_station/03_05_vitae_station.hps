	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		////////////////////////////
		// First Person Body 
	
		//PlayerBody_SetModel("player.ent");
		PlayerBody_SetActive(true);
        Heat_SetActive(false);
		
		////////////////////////////
		// FMS Setup 
		
		//FearHandler_SetActive(false);
		///////////////////////////////////
		// PF-ing should be off until a PF seq is registered
		//FearHandler_SetPermaFailEnabled(false);
		FearHandler_SetPermaFailEnabled(true);
		FearHandler_SetUpdateInterval(0.4f);
		
		// Updated 200403
		//Player_SetNightVisionBrightness(2.8f);
		
		Lever_SetInteractionDisablesStuck("Lever_Test_1",true);
		
		Entity_SetEffectsActive("pressureplate_*", false, true);
		Entity_SetActive("Block_Player_*",false);
		
		/////////////////////////
		// Fairchild setup
		
		Entity_StopAnimation("Fairchild");
		Entity_PlayAnimation("Fairchild","tdevice_fairchild_idle",0,true);
		cLux_GetCurrentMap().GetEntityByName("Fairchild").GetMeshEntity().SetNormalizeAnimationWeights(false);
		cLux_GetCurrentMap().GetEntityByName("Fairchild").GetMeshEntity().SetNormalizeAnimationLayers(true);
		Entity_PlayAnimation("Torture_Rack","tdevice_idle",0,true);
		Entity_PlayAnimation("Torture_Chains","tdevice_chains_idle",0,true);
		
		///////////////////////////
		// Setup pool and milking machine	
	
		Entity_StopAnimation("Machine");
		Entity_StopAnimation("Engine_1");
		Entity_StopAnimation("Engine_2");
		Entity_StopAnimation("Engine_3");
		Entity_StopAnimation("Engine_4");
		Entity_PlayAnimation("Machine","tth_pool_machine_whitebox_broken",0,true);
		
		Light_SetBrightness("Light_Point_35",0);
		
		ParticleSystem_SetActive("PS_MilkingMachine",false);
		FogArea_SetVisible("FogArea_MilkingMachine_*",false);
		Light_SetVisible("Light_MilkingMachine_*",false);
		Light_SetVisible("Light_GhoulMilking_Spot",false);
		Entity_PlayAnimation("machine_milking_2", "machine_milking_closed", 0.1f, false, false);
		
		ParticleSystem_SetActive("PS_Underwater",false);
		ParticleSystem_SetActive("PS_CrusherEngine",false);
		ParticleSystem_SetActive("PS_Crusher",false);
		ParticleSystem_SetVisible("PS_Crusher",false);
		
		//////////////////////////////
		// Disable expensive particles
		ParticleSystem_SetActive("PS_Attract_*",false);
		ParticleSystem_SetActive("PS_MilkingMachine_Base_*", false);
		ParticleSystem_SetVisible("PS_MilkingMachine_Base_*", false);
		ParticleSystem_SetActive("PS_Back_MilkingMachine_*", false);
		ParticleSystem_SetVisible("PS_Back_MilkingMachine_*", false);
		ParticleSystem_SetActive("PS_milkmachinehighlight_*", false);
		ParticleSystem_SetVisible("PS_milkmachinehighlight_*", false);
		
		ParticleSystem_SetActive("PS_BrokenPassage",false);
		ParticleSystem_SetActive("PS_BrokenMachine",false);
		
		Decal_SetDynamicVisible("Decal_FairchildDead_*",false);
		
		///////////////////////////
		// Setup music and voices
		
		Music_StopAll(0.0f);
		Voice_SetSource("Fairchild","Fairchild",5,120,true);
		
		Entity_SetVarInt("Trigger_HG_Stage1Left","AmountItemsPressing",0);
		Entity_SetVarInt("Trigger_HG_Stage1Right","AmountItemsPressing",0);
		
		PoolOfBodies_RepositionCages();
		PoolOfBodies_CreateRopes();
		PoolOfBodies_SetupCages();
		
		//cLux_AddDebugMessage("Cage_3 Matrix: "+Map_GetEntity("Cage_3").GetMatrix());

		Game_AutoSave();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		FearHandler_SetUpdateInterval(-1.f);
		///////////////////
		// Clear permafails
		FearHandler_ClearPermaFailScenes();
	}
	
	//-------------------------------------------------------
	
	float mfTime = 0;
	
	void Update(float afTimeStep) 
	{	
		mfTime+=afTimeStep;
		
		if (mbResetCages)
		{
			cLux_AddDebugMessage("RESETTING CAGES");
			cLux_GetCurrentMap().GetWorld().DestroyAllRopesAndPhyscisRopes();
			PoolOfBodies_RepositionCages();
			PoolOfBodies_CreateRopes();
			
			if (mbCageDetached)
			{
				Entity_SetActive("Blockage_*",false);
				Entity_SetActive("BlockingCage",true);
				Entity_SetActive("Cage_6",false);
				mlCages = 5;
				Rope_Detach("CageRope_6","Cage_6");
			}
			PoolOfBodies_SetupCages();
			mbResetCages = false;
		}
		
		if (Voice_SubjectIsPlaying("BabyKick"))
		{
			if (Sound_Exists("Machine_AnimEvent"))
			{
				Sound_Fade("Machine_AnimEvent*",0.2,0);
			}
			
			for(int i = 1; i <= 4; i++)
			{
				if (Sound_Exists("Sound_Engine_"+i+"_Run"))
					Sound_Fade("Sound_Engine_"+i+"_Run",0.2f,0.3f);
					
				if (Sound_Exists("Sound_Engine_"+i+"_Start"))
					Sound_Fade("Sound_Engine_"+i+"_Start",0.1f,0.3f);
			}
		}		
		
		if (mbTortureWheelRotationStarted)
		{
			Fairchild_Lower();
		}
		/*if (Entity_IsActive(msLeonPool))
			Agent_FaceEntity(msLeonPool,"player");*/
					
		UpdateEnginesSpeed(afTimeStep);
		if (mbUpdateStarted == false) OnUpdateStart();
	}
	
	//-------------------------------------------------------
	
	// prevents the ghoul from hearing TH doors close on save and load, should be properly fixed later
	[nosave] bool mbUpdateStarted = false;
	void OnUpdateStart()
	{
		mbUpdateStarted = true;
		Agent_SetDeafened("Ghoul_TortureGuy_1", true, 2);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_FadeOutThrown(const tString &in asTimer)
	{
		Effect_Fade_Out(0.4f);
		Map_AddTimer("Timer_FadeInThrown",1.f,"OnTimer_FadeInThrown");
	}
	
	//------------------------------------------------------- 
	
	void OnTimer_FadeInThrown(const tString &in asTimer)
	{
		Effect_Fade_In(0.4f);
	}
	
	void OnTimer_Leon_GoIdle(const tString &in asTimer)
	{
		Ghoul_Mode_Set(msLeon,eGhoulMode_Idle,true);
	}
	
	//-------------------------------------------------------
	
	void OnDamageTaken(const tString&in asSource, int alType)
	{
		cLux_AddTodoMessage("!!! DAMAGED !!! Source: " + asSource);
		
		if (asSource == "Ghoul_LeonStage0")
		{
			// Death Scenarios are triggered on first hit during Hunting Grounds and first backtrack
//			Leon_CatchTasi();
			//Death_Start(asSource);
		}
		else if (asSource == "Ghoul_LeonStage1")
		{
			Agent_SetSensesActive(asSource,false);
			Map_AddTimer("Timer_Leon_GoIdle",1,"OnTimer_Leon_GoIdle");
			Map_AddTimer("Timer_LeonStage1_AnimManager", 1.2f, "OnTimer_LeonStage1_AnimManager");
			Map_AddTimer("Timer_FadeOutThrown",0.3f,"OnTimer_FadeOutThrown");
			mfFearLevelBeforeWarn+=.2;
			Music_Stop(0, eMusicPrio_AgentHunt);
			//FearHandler_SetPermaFailRespawnArea("PermaFail_HG_KilledAtStage1");
			//Effect_Fade_Out(0.4f);
			//Map_AddTimer("Timer_DelayedRespawn",0.4f,"OnTimer_DelayedRespawn");	
			//FearHandler_TriggerPermaFail(false,asSource);
		}
		else if (asSource == "Ghoul_LeonStage2")
		{
			Agent_SetSensesActive(asSource,false);
			Map_AddTimer("Timer_Leon_GoIdle",1,"OnTimer_Leon_GoIdle");
			Map_RemoveTimer("Timer_LeonStage2_ResumeThreaten");
			Map_RemoveTimer("Timer_LeonStage2_RunToPosition");
			Map_AddTimer("Timer_LeonStage2_Banging",1.2f,"OnTimer_LeonStage2_Banging");
			Music_Stop(0, eMusicPrio_AgentHunt);
		}
		else if (asSource == "Ghoul_TortureGuy_1" || asSource == "Ghoul_TortureGuy_2")
		{
			// Player drops the torture wheel if attacked by torture ghoul
			if (Entity_IsInteractedWith("Torture_Wheel"))
			{
				Player_ChangeStateToNormal();
				Map_RemoveTimer("Torture_Wheel");
				Prop_StopMovement("Fairchild");
				Prop_MoveLinearTo("Fairchild", "PosArea_Fairchild_Raised", 2, 1, 0.2f, true, "");
				TortureWheel_Unroll();
				cLux_GetPlayer().StopAutomoveCharBody();
				Player_SetMoveSpeedMul(1.0f);
				Player_SetCrouchDisabled(false);
			}
		}
		else
		{
			
		}
		
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail(const tString &in asSource)
	{
		Debug_Log("SOURCE OF PERMAFAIL: "+asSource);
		if (asSource != "")
		{
			Agent_SetSensesActive(asSource,false);
			
			if (asSource == "Ghoul_LeonStage3")	
			{
				Entity_SetActive("Ghoul_LeonStage3",false);
				SetupPermaFail(eVitaeStationPermaFail_HG_LeonStalking);
				SwingDoor_SetClosed("Portcullis_HG_Stage3Trap_2",true,false);
			}
			else if (asSource == "Ghoul_TortureGuy_1")	
			{
				int lState = (mlPermaFailState == eVitaeStationPermaFail_MilkingRoom) ? eVitaeStationPermaFail_Cell : eVitaeStationPermaFail_MilkingRoom;
				SetupPermaFail(lState);
			}
			else if (asSource == "Ghoul_TortureGuy_2")	
			{
				FearHandler_SetPermaFailRespawnArea("PermaFail_Cell");
				//Map_AddTimer("Timer_CustomRespawn",6,"OnTimer_CustomRespawn");
				//Map_SetTimerUserVarString("Timer_CustomRespawn",asSource);
				//return false;
			}
				
			//Map_AddTimer("Timer_CustomRespawn",6,"OnTimer_CustomRespawn");
			//Map_SetTimerUserVarString("Timer_CustomRespawn",asSource);
		}
		else
		{
			mlPermaFailScene=0;
			FearArea_SetUnsafeMusic("Fear_1", "");
			//FearHandler_SetPermaFailEnabled(false);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_CustomRespawn(const tString &in asTimer)
	{
		Debug_Log("CUSTOM RESPAWN");
		tString asSource = Map_GetTimerUserVarString(asTimer);
		
		if (asSource == "Ghoul_LeonStage1")	DeathScenario_OnRespawn_LeonGoesStage2(asSource);
		else if (asSource == "Ghoul_LeonStage2")	DeathScenario_OnRespawn_LeonGoesStage3(asSource);
		else if (asSource == "Ghoul_LeonStage3")	DeathScenario_OnRespawn_LeonDisappears(asSource);
		else if (asSource == "Ghoul_TortureGuy_1")
		{
			if (!mbTortureGhoulKilledPlayer)
				DeathScenario_OnRespawn_PlayerWakesUpInCell(asSource);
			else
				DeathScenario_OnRespawn_PlayerOnTortureDevice(asSource);
		}
		else if (asSource == "Ghoul_TortureGuy_2")	DeathScenario_OnRespawn_PlayerOnTortureDevice(asSource);
		
		FearHandler_SetForcedAddFearRate(-1,1,false);
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("!!! KILLED !!! Source: " + asSource);
		
		if (asSource == "Ghoul_LeonStage0")
		{
			//DeathScenario_OnDeath_LeonGoesCrazy(asSource);
			//Death_SetRespawnCallback("DeathScenario_OnRespawn_LeonGoesCrazy");
			return true;
		}
		else if (asSource == "Ghoul_LeonStage1")
		{
			DeathScenario_OnDeath_LeonGoesStage2(asSource);
			//Death_SetRespawnCallback("DeathScenario_OnRespawn_LeonGoesStage2");
			return true;
		}
		else if (asSource == "Ghoul_LeonStage2")
		{
			DeathScenario_OnDeath_LeonGoesStage3(asSource);
			//Death_SetRespawnCallback("DeathScenario_OnRespawn_LeonGoesStage3");
			return true;
		}
		else if (asSource == "Ghoul_LeonStage3")
		{
			DeathScenario_OnDeath_LeonDisappears(asSource);
			//Death_SetRespawnCallback("DeathScenario_OnRespawn_LeonDisappears");
			return true;
		}
		
		// return false for default behaviour
		return false;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{		
		// return false for default behaviour (fadeout and death area)
		return false;
	}
	
