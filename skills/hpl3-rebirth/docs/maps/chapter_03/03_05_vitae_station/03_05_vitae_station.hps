		void OnLookAt_CheckMilkingMachine(const tString &in asEntity, int alState)
		{
			if (mbFairchildAttacked) return;
			Sketchbook_AddIdea("extract_vitae");
			Voice_Play("MilkingMachine_See", 0, "OnVoiceEnd_FirstMilkingMachineLine");
		}
		
		void OnVoiceEnd_FirstMilkingMachineLine(const tString&in asScene, const tString&in asSubject)
		{
			Map_AddTimer("Timer_TeethLine", 0.5f, "Timer_TeethLine");
		}
		
		void Timer_TeethLine(const tString& in asTimer)
		{
			if (mbTortureSetup)
				return;
				
			Voice_Play("MilkingMachine_See",1);
		}
		
		int mlRumble1 = -1;
		int mlRumble2 = -1;
		int ml_MachineTrail = -1;
		
		bool OnCollide_Player_MilkingMachineProximity(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (asParent == "Trigger_MilkingMachineProximity_1")
			{
				if (alState == 1) 
				{
					
					//Map_RemoveTimer("Timer_RestartRumble1");
					//Map_AddTimer("Timer_RestartRumble2",0,"OnTimer_RestartRumble2");
					Debug_Log("STRONG START");
					Map_RemoveTimer("Timer_EffectWeak");
					Map_AddTimer("Timer_EffectStrong",0.12,"OnTimer_EffectStrong");
				}
				else
				{
					//Map_RemoveTimer("Timer_RestartRumble2");
					//Map_AddTimer("Timer_RestartRumble1",0,"OnTimer_RestartRumble1");
					Debug_Log("STRONG STOP");
					Map_RemoveTimer("Timer_EffectStrong");
					Map_AddTimer("Timer_EffectWeak",0.12,"OnTimer_EffectWeak");
				}
			}
			else
			{
				if (alState == 1) 
				{
					//Map_AddTimer("Timer_RestartRumble1",0,"OnTimer_RestartRumble1");
					ml_MachineTrail = Effect_ImageTrail_Start(0.8,0.8,-1,1);
					Debug_Log("WEAK START");
					//Map_AddTimer("Timer_EffectWeak",0.12,"OnTimer_EffectWeak");
				}
				else
				{
					//Map_RemoveTimer("Timer_RestartRumble1");
					//Effect_Rumble_Stop(mlRumble1);
					Effect_ImageTrail_FadeOut(ml_MachineTrail,1);
					Debug_Log("WEAK STOP");
					//Map_RemoveTimer("Timer_EffectStrong");
					//Map_RemoveTimer("Timer_EffectWeak");
				}
			}
			return true;
		}
		
		void OnTimer_RestartRumble1(const tString &in asTimer)
		{
			//mlRumble1 = Effect_Rumble_Start(0.1f,3,0,0);
			Map_RestartCurrentTimer(3.1f);
		}
		
		void OnTimer_RestartRumble2(const tString &in asTimer)
		{
			//mlRumble2 = Effect_Rumble_Start(0.3f,3,0,0);
			Map_RestartCurrentTimer(3.1f);
		}
		
