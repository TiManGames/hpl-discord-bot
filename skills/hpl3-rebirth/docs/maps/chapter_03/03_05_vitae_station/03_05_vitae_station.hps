	void TestRope()
	{
		cVector3f vStart = Map_GetEntity("Cage_Test_Top").GetPosition();
		cVector3f vEnd = Map_GetEntity("Cage_Test_TopLow").GetPosition();
		Rope_Create("CageRope_Test",vStart,vEnd,5.f,0.030f,100,1,false,false);
		//Rope_SetTotalLength(sRope,2.3f);
		//Rope_SetStartParticleMass(sRope,0);
		Rope_SetEndParticleMass("CageRope_Test",1);
		Rope_AttachStart("CageRope_Test","Cage_Test_Top");
		Rope_AttachEnd("CageRope_Test","Cage_Test_TopLow");
		Rope_SetSleepParameters("CageRope_Test",.3f,.002,3);
		Map_AddTimer("CageRope_Test",0.2f,"OnTimer_RopeMaterial");
		
		
		cVector3f vStart2 = Map_GetEntity("Cage_Test_TopLow").GetPosition();
		cVector3f vEnd2 = Map_GetEntity("Cage_Test_Bottom").GetPosition();
		Rope_Create("CageRope_Test2",vStart2,vEnd2,5.f,0.030f,100,1,false,false);
		//Rope_SetTotalLength(sRope,2.3f);
		//Rope_SetStartParticleMass(sRope,0);
		Rope_SetEndParticleMass("CageRope_Test2",1);
		Rope_AttachStart("CageRope_Test2","Cage_Test_TopLow");
		Rope_AttachEnd("CageRope_Test2","Cage_Test");
		Rope_SetSleepParameters("CageRope_Test2",.3f,.002,3);
		Map_AddTimer("CageRope_Test2",0.2f,"OnTimer_RopeMaterial");
		
		
	}
	
	void PoolOfBodies_CreateRopes()
	{		
		for (int i = 1; i <= mlCages; i++)
		{
			tString sCage = "Cage_"+i;
			tString sRope = "CageRope_"+i;
			
			if (Entity_IsActive(sCage) == false) continue;
			
			Debug_Log("CREATED ROPE FOR "+sCage);
			cVector3f vStart = Map_GetEntity(sCage+"_Top").GetPosition();
			cVector3f vEnd = Map_GetEntity(sCage+"_Bottom").GetPosition();
			Rope_Create(sRope,vStart,vEnd,5.f,0.030f,100,1,false,false);
			//Rope_SetTotalLength(sRope,2.3f);
			//Rope_SetStartParticleMass(sRope,0);
			Rope_SetEndParticleMass(sRope,1);
			Rope_AttachStart(sRope,sCage+"_Top");
			Rope_AttachEnd(sRope,sCage);
			Rope_SetSleepParameters(sRope,.3f,.002,3);
			
			Map_AddTimer(sRope,0.2f,"OnTimer_RopeMaterial");
			
		}
				
		for (int j = 1; j <= 4; j++)
		{
			tString sCage = "DressingCage_"+j;
			tString sRope = "DressingCageRope_"+j;
			
			if (Entity_IsActive(sCage) == false) continue;
			
			Debug_Log("CREATED DRESSING ROPE");
			cVector3f vStart = Map_GetEntity(sCage+"_Top").GetPosition();
			cVector3f vEnd = Map_GetEntity(sCage+"_Bottom").GetPosition();
			Rope_Create(sRope,vStart,vEnd,5.f,0.030f,100,1,false,false);
			//Rope_SetTotalLength(sRope,2.3f);
			//Rope_SetStartParticleMass(sRope,0);
			Rope_SetEndParticleMass(sRope,1);
			Rope_AttachStart(sRope,sCage+"_Top");
			if (j == 3)
				Rope_AttachEnd(sRope,sCage+"_Bottom");
			else
			{
				Rope_AttachEnd(sRope,sCage);
				cLux_GetCurrentMap().GetEntityByName("DressingCage_"+j).GetMainBody().SetMass(mfCageMass);
				Push_SetThrowImpulse("DressingCage_"+j,2);
			}
			
			Rope_SetSleepParameters(sRope,.3f,.002,3);
			Map_AddTimer(sRope,0.2f,"OnTimer_RopeMaterial");
			
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_RopeMaterial(const tString &in asTimer)
	{
		//Debug_Log("MATERIAL FOR "+asTimer);
		Rope_CreateGfx(asTimer,"entities/tin_hinan/tth_torture_device/torture_rack_shackles.mat",0.025f);
	}
	
	//-------------------------------------------------------
	
	float mfCurrentMul = 1;
	float mfCageMass = 20;
	float mfCageSubmergedMass = 40;
	float mfCageCorpseMul = 1.1;
	
	void PoolOfBodies_RepositionCages()
	{
		for (int i = 1; i <= mlCages; i++)
		{			
			tString sCage = "Cage_"+i;
			tString sCageTarget = "PosArea_Root_"+sCage;
			
			tString sRopeBottom = sCage+"_Bottom";
			tString sRopeBottomTarget = sRopeBottom+"_Root";
			
			if (Entity_IsActive(sCage) == false) continue;
			
			
			// FIND THE RIGHT CAGE POSITION
			
			if (i == 2 && mbLeonPoolEncounter)
			{
				Entity_PlaceAtEntity("Cage_2_Root","Rail_1",cVector3f_Zero,true,true);
				//Prop_MoveLinearTo("Cage_2_Root","Rail_1",30,30,0,true,"");
				sRopeBottomTarget = "Cage_2_Bottom_Root_InPosition";
				sCageTarget = "PosArea_Root_Cage_2_InPosition";
				
				if (mbEngineBroken) 
					sRopeBottomTarget = "Cage_2_Bottom_Root_End";
			}
			
			Entity_PlaceAtEntity(sRopeBottom,sRopeBottomTarget,cVector3f_Zero,true,true);
			
			// MOVE CAGE TO POSITION
			
			if (i == 2 && mbEngineBroken)
			{
				sCageTarget = "Cage_2_Broken_2";
				Entity_SetCollide("Cage_2",false);
				Prop_SetStaticPhysics("Cage_2",true);
				Entity_SetInteractionDisabled("Cage_2",true);
				
			}
			
			Entity_PlaceAtEntity(sCage,sCageTarget,cVector3f_Zero,true,true);
		}
	}
	
	void PoolOfBodies_SetupCages()
	{
		
		Entity_SetVarBool("Cage_1","bCorpse",true);
		Entity_SetVarBool("Cage_2","bCorpse",true);
		Entity_SetVarBool("Cage_3","bCorpse",false);
		Entity_SetVarBool("Cage_4","bCorpse",true);
		Entity_SetVarBool("Cage_5","bCorpse",false);
		Entity_SetVarBool("Cage_6","bCorpse",false);
		
		for (int i = 1; i <= mlCages; i++)
		{
			int lState = Entity_GetVarInt("Cage_"+i,"");
			bool bCorpse = Entity_GetVarBool("Cage_"+i,"bCorpse");
			
			if (i == 2 && mbEngineBroken) continue;
			
			Debug_Log("Cage "+i+" = "+lState);
			
			float fCorpseMul = (bCorpse) ? 1.2f : 1;
			
			if (i != 1)
			{
				bool bSubmerged = (lState == 0) ? true : false;
				//Entity_SetInteractionDisabled("Cage_"+i,bInteractDisabled);
				if (bSubmerged)
				{
					cLux_GetCurrentMap().GetEntityByName("Cage_"+i).GetMainBody().SetMass(mfCageSubmergedMass*fCorpseMul*mfCurrentMul);
					Push_SetThrowImpulse("Cage_"+i,0.3f);
					
					float fLength = (i == 2) ? 3.f : 3.5f;	
					Rope_StretchToLength("CageRope_"+i,fLength,1);
				}
				else
				{
					cLux_GetCurrentMap().GetEntityByName("Cage_"+i).GetMainBody().SetMass(mfCageMass*fCorpseMul);
					Push_SetThrowImpulse("Cage_"+i,2);
					
					float fLength = (i == 2) ? 2.f : 2.6f;	
					Rope_StretchToLength("CageRope_"+i,fLength,1);
				}
				//MoveObject_SetState("Cage_"+i+"_Top",lState);
			}
		}
	}

	//-------------------------------------------------------
	
	bool OnCollide_Player_EnterSafeRoom(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1)
		{
			Pregnancy_ClearBabyTalkRoomSpecificSubject();
			return true;
		}
		
		tString sSubject = "";
		if (asParent == "Safe_ControlRoom")						
		{
			sSubject = "BabyTalk_SafeRoom_Control";
			//Map_AddTimer("Timer_SafeRoomHint", 2.0f, "OnTimer_SafeRoomHint");
			
			Music_Stop(2.f, eMusicPrio_BgAmb);
		}
		else if (asParent == "Safe_PostHG")						
		{
			sSubject = "BabyTalk_SafeRoom_PostHG";
		}
		
		Pregnancy_SetBabyTalkRoomSpecificSubject(sSubject, true);
		return true;
	} 
 
