	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(11);
		
		/////////////////////////
		// Any general setup of script / entities
		
		Player_SetNightVisionEnabled(true);
		Player_SetCanUseLightSource(true);
		Player_SetMapDeepShadow(0.2f);
//		Player_SetNightVisionStrength(1.3f);
		
		Effect_FilmGrain_FadeFilmGrainIntensity(0.1f,3);
		
		/////////////////////////
		// Debug
		
		if(cLux_ScriptDebugOn())
		{
			Item_AddToInventory("ModernOilFixed");
			Item_AddToInventory("Matchbook");
			Item_AddToInventory("Matchbook");
			Item_AddToInventory("Matchbook");
			
			if (ItemType_GetCountInInventory("Lantern") < 1)
			{
				Item_AddToInventory("Lantern");
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
			}
		}
		
		Pregnancy_SetBabyKicksEnabled(true);
		
		PressurePlate_ManageTriggersStage(0);
		
		/////////////////////////
		// Setup double portcullis connection
		
		//SlideDoor_SetOpenAmount("Portcullis_HuntingGrounds_Entrance_2",1,true);
		//Entity_SetActive("Portcullis_HuntingGrounds_Entrance_2",false);
		
		cLuxProp@ pProp = Map_GetProp("Wheel_HuntingGrounds");
		//pProp.AddInteractConnection("Portcullis_HuntingGrounds_Entrance_1", Map_GetProp("Portcullis_HuntingGrounds_Entrance_1"), false, eEasing_Linear);
		pProp.AddInteractConnection("Portcullis_HuntingGrounds_Entrance_1", Map_GetProp("Portcullis_HuntingGrounds_Entrance_2"), true, eEasing_Linear);

	}
	
