	int mlVitaeCanisterStage = 0;
	
	void VitaeCanister_Stage()
	{
		switch (mlVitaeCanisterStage)
		{
			case 0:
				Entity_SetActive("VitaeCanister_Empty",false);
				Entity_SetActive("VitaeCanister_Half",true);
				Entity_SetActive("VitaeCanister",false);
				Lamp_SetLit("Lamp_VitaeCanisterPipe_1",true,true);
				break;
			case 1:
				Entity_SetActive("VitaeCanister_Empty",false);
				Entity_SetActive("VitaeCanister_Half",false);
				Entity_SetActive("VitaeCanister",true);
				Lamp_SetLit("Lamp_VitaeCanisterPipe_2",true,true);
				break;
			case 2:
				Entity_SetActive("VitaeCanister_Empty",true);
				Entity_SetActive("VitaeCanister_Half",false);
				Entity_SetActive("VitaeCanister",false);
				Lamp_SetLit("Lamp_VitaeCanisterPipe_1",false,true);
				Lamp_SetLit("Lamp_VitaeCanisterPipe_2",false,true);
				break;
		}
		
		if (mlVitaeCanisterStage < 2)
			mlVitaeCanisterStage++;
		else
			mlVitaeCanisterStage = 0;
	}
	
	//-------------------------------------------------------
	
	void Light_SetBrightnessIncrease(const tString &in asLight, int alSteps, float afIncreaseAmount, float afTimePerStep)
	{
		if (Light_GetBrightness(asLight) < 0) 
		{
			Light_SetBrightness(asLight,0);
			return;
		}
		
		tString sTimerName = asLight + "_SetBrightnessIncrease";
		
		Map_AddTimer(sTimerName, afTimePerStep, "OnTimer_SetBrightnessIncrease");
		
		Map_SetTimerUserVarInt(sTimerName, alSteps - 1);
		Map_SetTimerUserVarFloat(sTimerName, afIncreaseAmount);
		Map_SetTimerUserVarString(sTimerName, asLight);
	} 
	
	//-------------------------------------------------------

	void OnTimer_SetBrightnessIncrease(const tString &in asTimer)
	{
		int lSteps = Map_GetTimerUserVarInt(asTimer);
		float fIncreaseAmount = Map_GetTimerUserVarFloat(asTimer);
		tString sLightName = Map_GetTimerUserVarString(asTimer);
		
		if (Light_GetBrightness(sLightName) > 0) 
		{
			Light_SetBrightness(sLightName, Light_GetBrightness(sLightName) + fIncreaseAmount);
			return;
		}
		
		
		if (lSteps > 0)
		{
			Map_RestartCurrentTimer();
		
			Map_SetTimerUserVarInt(asTimer, lSteps - 1);
			Map_SetTimerUserVarFloat(asTimer, fIncreaseAmount);
			Map_SetTimerUserVarString(asTimer, sLightName);
		}	
	}
	
	//-------------------------------------------------------
	
	void OnTimer_RemoveForcedFlash(const tString &in asTimer)
	{
		Light_SetBrightnessIncrease("Light_MilkingMachineFlash_Spot",200,-1,0.005f);
		Light_FadeTo("Light_MilkingMachineFlash_Point",cColor_White,0,1);
	}
	
