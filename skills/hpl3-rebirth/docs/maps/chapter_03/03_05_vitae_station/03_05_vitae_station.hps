		//-------------------------------------------------------
		 
		bool MilkingFadeOut(const tString &in asEntity, int alDirection)
		{
			if (alDirection != 1) return true;
			
			MilkingComplete();
	
			return true;
		}
		
		//-------------------------------------------------------
		
		void MilkingComplete()
		{
			Debug_Log("FLASH");
			Effect_Flash_Start(0.2f,2.4f,6.0f);
			if (FearHandler_GetLevel() > 0.85f)
				FearHandler_FadeLevelTo(0.85f,0.3f);
			//FearHandler_FadeLevelTo(mfBeforeMilkingFearLevel,0.3f);
			//FearHandler_SetForcedAddFearRate(0,0,false);
			
			
			SlideDoor_SetClosed("Portcullis_Pool_8",false);
			
			Entity_SetActive("LookAtArea_Canister",false);
			Entity_SetActive("Trigger_CheckMilkingMachine",false);
			Entity_SetActive("FairchildAttack",false);
			Entity_SetActive("Fairchild_Dead",true);
			Entity_SetActive("Torture_Chains",false);
			
			Decal_SetDynamicVisible("Decal_FairchildDead_*",true);
			//Entity_PlayAnimation("Fairchild_Dead","f_gnaw_on_fairchild_outro",0);	
			Entity_SetActive("Trigger_KilledFairchild",true);
			
			Sketchbook_CompleteIdea("extract_vitae");
			//Sketchbook_AddSketchImageByPage("tth_hint_fairchild_checked", "tth_full", true, "tth_hint_fairchild");

			//Map_RemoveTimer("Timer_TasiBreathe");
			Sound_Stop("Sound_TasiBreathe",0.5f);

			Map_AddTimer("Timer_MilkingComplete",0.2f,"OnTimer_MilkingComplete");
			Map_AddTimer("A",1,"OnTimer_PushVitaeLoop");
			Map_AddTimer("B",1,"OnTimer_PushVitaeLoop");
			Map_AddTimer("Timer_PushVitaeEndLoop",15,"OnTimer_PushVitaeEndLoop");
			
			//FearHandler_SetPermaFailEnabled(true);
			FearHandler_FadeLevelTo(0,2);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MilkingComplete(const tString &in asTimer)
		{
			Debug_Log("MILKING FADE OUT");
			tString sPlayer = PlayerBody_GetEntityName();
			Entity_SetEffectsActive(sPlayer,false,true);
			Struggle_Stop(false);
			Light_SetVisible("Light_MilkingMachine_Spot_Flicker",false);
			Light_SetVisible("Light_FairchildCorpse_Point",false);
			//Light_FadeTo("Light_MilkingMachine_Spot_Flicker",cColor(0,0,0,0),5,0);
			//Light_FadeTo("Light_FairchildCorpse_Point",cColor(0,0,0,0),5,0);
			Map_SetFogActive(true);
			Effect_ImageTrail_Clear();
			Seq_ExitMilkingMachine("");
			//Game_AutoSave();
			mbMilkingDeviceUsed = true;
			cScript_SetGlobalVarBool("TTH_Milked", true);
			FearHandler_SetWhisperStage(eFearWhisperStage_MilkingToDWFA);
		}
		
		//-------------------------------------------------------
				
		cSequenceStatesData mSequenceExitMilkingMachine;
		void Seq_ExitMilkingMachine(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ExitMilkingMachine", mSequenceExitMilkingMachine);
			if (Sequence_DoStepAndWait(2.f))
			{
				//Player_ChangeStateToNormal();
				GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetPermafailFadeProgression(), 0.1f);
				
				Player_SetMoveSpeedMul(0.f);
				Effect_ImageTrail_Start(2.2f,0,5,20);
				CameraAnimation_End();
				//Waiting for flash
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				//Voice_Play("Tasi_DoneMilking");
				//CameraAnimation_End();
				Player_Teleport("Start_MilkingRoom_Complete");
				PlayerBody_PlayCutsceneAtEntity("player_milking_machine_getup","PosArea_MilkingMachine",false,0.1f);
				//PlayerBody_PlayCutsceneAtEntity("fall_and_get_up_slow","player",false,0.5f,"");
				FogArea_SetVisible("FogArea_MilkingMachine_*",false);
				Entity_SetActive("VitaeCanister_Empty", false);
				Entity_SetActive("VitaeElevator_Empty",false);
				Entity_SetActive("VitaeCanister_Half",true);
				Entity_SetActive("VitaeElevator_Half",true);
				Entity_SetActive("VitaeElevator_Full",false);
				//Entity_SetActive("VitaeCanister", true);
				VitaePipe_PushVitaeSequence();
				Sound_CreateAtEntity("Sound_VitaeFlowStart", "03_05_vitae_station/vitae_canister/vitae_flow/vitae_flow_start", "player");
				Sound_Play("Sound_VitaeLiquid", 1.0f);
				Sound_Play("Sound_VitaeMachine", 1.0f);
				
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Voice_Play("Tasi_DoneMilking");
				GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetProgression(), 4.0f);
				//Map_AddTimer("Timer_BabyMoment",17,"OnTimer_BabyMoment");
			}
			else if (Sequence_DoStepAndWait(7.f))
			{
				Player_SetLookSpeedMul(0);
				Player_StartLookAt("PosArea_PipesFraming",0.5f,1.f,1.f);
				Entity_SetActive("VitaeCanister_Pickup",true);
				Entity_SetEffectsActive("VitaeCanister_Pickup",false,false);
				//CameraAnimation_Begin("CamAnim_SpitFromMilkingMachine","",true);
			}
			else if (Sequence_DoStepAndWait(3.f))
			{
				Sound_CreateAtEntity("Sound_CanisterFilled","03_05_vitae_station/milking_machine/milking_machine_close","VitaeElevator_Full",1);
				Prop_SetActiveAndFade("VitaeElevator_Full",true,2);
				//Prop_SetActiveAndFade("VitaeCanister_Pickup",true,5);
				Entity_SetEffectsActiveExt("VitaeCanister_Pickup",true,true,2.6f,0);
				Prop_SetActiveAndFade("VitaeElevator_Half",false,5);
				Prop_SetActiveAndFade("VitaeCanister_Half",false,8);
				Sound_Play("Sound_CanisterScream", 1.0f);
				Player_FadeLookSpeedMulTo(1,6);
			}
			else if (Sequence_DoStepAndWait(2))
			{
				//Player_SetCrouching(false,false,true);
				Sound_Stop("Sound_CanisterFilled",1);
				Player_SetCrouchDisabled(false);
				Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_AfterFairchild");
				
				//////////////////////////////
				// Disable expensive particles
				ParticleSystem_SetActive("PS_MilkingMachine_Base_*", false);
				ParticleSystem_SetVisible("PS_MilkingMachine_Base_*", false);
				ParticleSystem_SetActive("PS_Back_MilkingMachine_*", false);
				ParticleSystem_SetVisible("PS_Back_MilkingMachine_*", false);
				ParticleSystem_SetActive("PS_milkmachinehighlight_*", false);
				ParticleSystem_SetVisible("PS_milkmachinehighlight_*", false);
				ParticleSystem_SetActive("PS_Attract_*", false);
				ParticleSystem_SetVisible("PS_Attract_*", false);
				
				cLux_AddDebugMessage("SWAP");
				Player_StopLookAt(2);
				Player_SetMoveSpeedMul(0.3f);
				Player_FadeMoveSpeedMulTo(1,15);
				Player_SetCanUseLightSource(true);
				
			}
			else if (Sequence_DoStepAndWait(5))
			{
				Game_AutoSave();
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BabyMoment(const tString &in asTimer)
		{
			// Entity_SetActive("Trigger_KilledFairchild",false); // Currently look at richard during baby talk will only trigger music. Uncomment if you want Tasi's reaction after baby talk.

			if (Voice_AnySceneIsActive()) 
			{
				Map_RestartCurrentTimer(1);
			}
			else 
			{
				Pregnancy_SetBabyKicksEnabled(true);
				Entity_SetActive("Trigger_KilledFairchild",false); 
				Pregnancy_DoBabyKick(true);
				Map_AddTimer("Timer_ForceBabyKick",3.5f,"OnTimer_ForceCheckOnBaby");
			}
		}
		
		//------------------------------------------------------- 
		
		void OnCheckBaby(int alState)
		{
			if (Map_TimerExists("Timer_BabyMoment")||Map_TimerExists("Timer_ForceBabyKick"))
			{
				Map_RemoveTimer("Timer_BabyMoment");
				Map_RemoveTimer("Timer_ForceBabyKick");
				Seq_BabyKick("");
			}
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_ForceCheckOnBaby(const tString &in asTimer)
		{
			Seq_BabyKick("");
		}
		
		//------------------------------------------------------- 
		
		cSequenceStatesData mSequenceDataBabyKick;
		void Seq_BabyKick(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BabyKick", mSequenceDataBabyKick);
			if (Sequence_DoStepAndWait(0.9f))
			{							 
				Voice_Play("BabyKick",-1,"OnEndOfVoice_EnableFairchildLookAt");
				Item_PutAway(eItemHandlerHand_Left);
				Item_PutAway(eItemHandlerHand_Right);
			}
			else if (Sequence_DoStepAndWait(15.f))
			{				
				Player_SetMoveSpeedMul(0.5f);
				Player_ForceCheckOnBaby(15);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				Player_FadeRunSpeedMulTo(1,30);
				Player_FadeMoveSpeedMulTo(1,60);
			}
			Sequence_End();
		}
		
