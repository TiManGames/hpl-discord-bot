			Map_RestartCurrentTimer(-1);
		}*/
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage2_Banging(const tString &in asTimer)
		{
			if (Player_GetCurrentStateName() == "State_Struggle")
			{
				Map_RestartCurrentTimer(1);
				return;
			}
			
			cLux_AddAIDebugMessage("---- BANGING ----");
			
			Leon_SetCustomFearValues(true);
			
			Ghoul_Command_Remove(msLeon,true);
			Agent_SetSensesActive(msLeon,false);
			CharMover_PlayAnimation(msLeon, "panic_struggle_violent_ls", 0.3f, true, false, "");
			
			Sound_CreateAtEntity("Sound_GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_frustration", msLeon);
			Voice_Play("Leon_AfterTrap_ConflictAngry");
			
			float fLeonBangingTime = cMath_RandRectf(6,9);
			Map_AddTimer("Timer_LeonStage2_RunToPosition", fLeonBangingTime, "OnTimer_LeonStage2_RunToPosition");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage2_RunToPosition(const tString &in asTimer)
		{	
			if (Player_GetCurrentStateName() == "State_Struggle")
			{
				Map_RestartCurrentTimer(1);
				return;
			}
			
			cLux_AddAIDebugMessage("---- RUNNING ----");
			
			Leon_SetCustomFearValues(false);
			Ghoul_Command_Remove(msLeon,true);
			
			if (mbLeonStage2PlayerEscaped)
			{
				Ghoul_CommandPatrol_AddNode(msLeon, "PathNode_LeonStage2_Pos3_2");
			}
			else
			{
				int lPos = cMath_RandRectl(1,5);
				if (Entity_GetCollide("player","Trigger_PlayerAtStage2Entrance") || Entity_GetCollide("player","Trigger_PlayerAtStage2Exit"))
				{
					Ghoul_CommandPatrol_AddNode(msLeon, "PathNode_LeonStage2_Pos2_"+lPos);
					cLux_AddAIDebugMessage("Target Pos: PathNode_LeonStage2_Pos2_"+lPos);
				}
				else
				{
					Ghoul_CommandPatrol_AddNode(msLeon, "PathNode_LeonStage2_Pos3_"+lPos);
					cLux_AddAIDebugMessage("Target Pos: PathNode_LeonStage2_Pos3_"+lPos);
				}
			}
			Ghoul_CommandPatrol_Execute(msLeon,true,1,false,eGhoulSpeed_FastWalk,"OnEndOfTrack_LeonStage2_ResumeThreaten");
			
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_LeonStage2_ResumeThreaten(const tString &in asEntity)
		{
			Voice_StopAll();
			Voice_Play("Leon_AfterTrap_ConflictAngry");
			
			Map_AddTimer("Timer_LeonStage2_ResumeThreaten", 0.2f, "OnTimer_LeonStage2_ResumeThreaten");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage2_ResumeThreaten(const tString &in asTimer)
		{
			if (Player_GetCurrentStateName() == "State_Struggle")
			{
				Map_RestartCurrentTimer(1);
				return;
			}
			
			if (mbLeonStage2PlayerEscaped)
				Map_AddTimer("Timer_LeonStage2_Banging", 0, "OnTimer_LeonStage2_Banging");
			else
			{
				Map_RemoveTimer("Timer_LeonStage2_ResumeThreaten"); // why did i write this?
				Agent_SetSensesActive(msLeon,true);
				Ghoul_CommandThreatenPlayer_Execute(msLeon,3,false,false,-1,-1,true);
				
				float fLeonThreateningTime = 0;
				float fDist = Entity_GetDeltaToEntity("player","Ghoul_LeonStage2").Length();
				
				fLeonThreateningTime = (fDist > 7) ? cMath_RandRectf(7,10) : cMath_RandRectf(4,6);
				
				
				Map_AddTimer("Timer_LeonStage2_Banging", fLeonThreateningTime, "OnTimer_LeonStage2_Banging");
			}
		}
		
		//-------------------------------------------------------
		
		void DeathScenario_OnDeath_LeonGoesStage3(const tString &in asSource)
		{
			Voice_StopAll();
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			Agent_SetSensesActive(asSource,false);
			Ghoul_Mode_Set(asSource,eGhoulMode_Idle,true);
			Death_PickRespawnArea("Death_HG_KilledAtStage2");
			Effect_Fade_Out(0.4f);
			Map_AddTimer("Timer_DelayedRespawn",2,"OnTimer_DelayedRespawn");
		}
		
		//-------------------------------------------------------
		
		bool DeathScenario_OnRespawn_LeonGoesStage3(const tString &in asSource)
		{
			Entity_SetActive(asSource,false);
			Player_SetForceCrawling(false);
			Player_SetMoveSpeedMul(1);
			Player_SetLookSpeedMul(1);
			Map_AddTimer("Timer_DelayedFadeIn",2,"OnTimer_DelayedFadeIn");
			return false;
		}
		
