		{
			cLux_AddDebugMessage("HUNT MUSIC");
			Music_Play("A2_3_5_ghoul_sighting.ogg",0.4f,false,eMusicPrio_AgentHunt);
		}
		
		bool OnCollide_Player_Stage3Trap(const tString &in asParent, const tString &in asChild, int alState)
		{
			SlideDoor_SetClosed("Portcullis_HG_Stage3TrapEarly_1",false);
			Portcullis_Sequence("Portcullis_HG_Stage3Trap_",3,0);
