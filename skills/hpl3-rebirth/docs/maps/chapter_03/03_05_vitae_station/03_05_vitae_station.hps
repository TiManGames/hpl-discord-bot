		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 3, Event C here.*/
		
		void LeonStage2_Activate()
		{
			if (mlLeonStage != 1) return;
			
			Map_RemoveTimer("Timer_LeonStage1_AnimManager");
			Map_RemoveTimer("Timer_LeonStage1_Confused");
			Map_RemoveTimer("Timer_LeonStage1_Warning");
			Map_RemoveTimer("Timer_LeonStage1_Attack");
			Map_RemoveTimer("Timer_LeonStage1_Voice");
			
			Entity_SetActive(msLeon,false);
			msLeon = "Ghoul_LeonStage2";
			Entity_SetActive(msLeon,true);
			Voice_SetSource("Leon",msLeon,0,25,true);
			Voice_SetSource("Leon_Unknown",msLeon,0,25,true);
			Agent_SetSensesActive(msLeon,false);
			Ghoul_SetPlayerThrowForcedDirection(msLeon,-1);
			mlLeonStage = 2;
			Ghoul_Mode_Set(msLeon,eGhoulMode_Idle,false);
			Ghoul_Command_Remove(msLeon,true);
			Ghoul_CommandPatrol_AddNode(msLeon, "PathNode_LeonStage2_Pos2_5");
			Ghoul_CommandPatrol_Execute(msLeon,true,1,false,eGhoulSpeed_Run,"OnEndOfTrack_LeonStage2_Banging");
			Agent_SetDistanceCallback(msLeon,"OnRange_LeonStage2_ActivateSenses",5);
			//Map_AddTimer("Timer_LeonStage2_PlayerDistance", 0.5f,"OnTimer_LeonStage2_PlayerDistance");
			Sound_Stop("Sound_LeonHuntSweet_P1", 2.0f);
			Sound_CreateAtEntity("Sound_LeonHuntSweet_P2", "level_amb_shared/amb/sweeteners/03_05_vitae_station/leon_hunting_grounds_sweet", "Ghoul_LeonStage2");
		}
		
		//-------------------------------------------------------
		
		void OnRange_LeonStage2_ActivateSenses(int alState)
		{
			if (alState != 1) return;
			
			Agent_SetSensesActive(msLeon,true);
			//Ghoul_Command_Remove(msLeon,true);
			
			if (!Map_TimerExists("Timer_LeonStage2_ResumeThreaten")) Map_AddTimer("Timer_LeonStage2_ResumeThreaten",0.1f,"OnTimer_LeonStage2_ResumeThreaten");
			Map_RemoveTimer("Timer_LeonStage2_RunToPosition");
			Map_RemoveTimer("Timer_LeonStage2_Banging");
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_LeonStage2_Banging(const tString &in asEntity)
		{
			Map_AddTimer("Timer_LeonStage2_Banging",0,"OnTimer_LeonStage2_Banging");
		}
		
		//-------------------------------------------------------
		
		/*void OnTimer_LeonStage2_PlayerDistance(const tString &in asTimer)
		{
			float fDist = Entity_GetDeltaToEntity("player","Ghoul_LeonStage2").Length();
									
			if ((mlLeonStage2ForgiveTimes <= 0) || (fDist > 7) || (Map_TimerExists("Timer_LeonStage2_ResumeThreaten")))
			{
				Map_RestartCurrentTimer(-1);
				return;
			}
			
			cLux_AddAIDebugMessage("---- FORGIVING ----");
			mlLeonStage2ForgiveTimes--;

			Ghoul_Command_Remove(msLeon,true);
			Ghoul_Mode_Set(msLeon,eGhoulMode_Idle,true);
			Map_RemoveTimer("Timer_LeonStage2_ResumeThreaten");
			Map_RemoveTimer("Timer_LeonStage2_RunToPosition");
