		bool OnCollide_Player_PoolEscapeEnd(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("WaterArea_Corpses",false);
			Entity_SetActive("WaterArea_Corpses_Under",true);
			Effect_Fade_Out(0.1f);
			Music_Stop(0.5f,eMusicPrio_BigEvent);
			Sound_CreateAtEntity("Sound_FallSplash", "03_05_vitae_station/pool_escape/escape_fall", "player");
			Map_AddTimer("Timer_PlayerWakeupAfterFall",.6f,"OnTimer_PlayerWakeUpAfterFall");
			Map_AddTimer("Timer_LeonUpstairsBarks",3,"OnTimer_LeonUpstairsBarks");
			
			Sound_Stop("Sound_MainLoop", 0.5f);
			Sound_Play("Sound_TunnelSweet", 0.05f);
			Sound_Play("Sound_MainLoopTunnel", 0.05f);
			Sound_Play("Sound_TunnelLoop", 0.05f);
			
			FearHandler_SetActive(false);

			
			mbAreaRoom = false;
			mbAreaTunnel = true;
			mbAreaCave = false;
			
			return false;
		}
		
		//-------------------------------------------------------
		
		int mlLeonUpstairsBark = 0;
		
		void OnTimer_LeonUpstairsBarks(const tString &in asTimer)
		{
			Voice_SetSource("Leon","PosArea_LeonBarks",1,50,true);
			Voice_SetSource("Leon_Unknown","PosArea_LeonBarks",1,50,true);
			Voice_Play("Leon_WayOut_Barks",mlLeonUpstairsBark,"");
			Map_AddTimer("Timer_LeonNextTunnelBark",4,"OnTimer_LeonNextTunnelBark");
			mlLeonUpstairsBark++;
			//Map_RestartCurrentTimer(cMath_RandRectf(10,12));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonNextTunnelBark(const tString &in asTimer)
		{
			if (mlLeonUpstairsBark == 4)
				Sketchbook_UnlockMemory("HankAboutLeon",true,"OnEndOfVoice_RestartLeonUpstairsBark");
			else
			{
				if (mlLeonUpstairsBark == 6)
					Voice_PlayDelayed("Dialogue_Pool_Afterwards",0.5f,-1,"OnEndOfVoice_TasiExitBarks");
				else
				{
					Voice_StopAll();
					Voice_PlayDelayed("Leon_WayOut_Barks",cMath_RandRectf(0.8f,1.6f),mlLeonUpstairsBark,"");
					Map_RestartCurrentTimer(6);
				}				
			}
			
			mlLeonUpstairsBark++;			
		}
		
		//-------------------------------------------------------
		
		void OnEndOfVoice_RestartLeonUpstairsBark(const tString &in asScene, const tString &in asSubject)
		{
			Voice_PlayDelayed("Leon_WayOut_Barks",5,mlLeonUpstairsBark,"OnEndOfVoice_RestartTunnelBarks");
			mlLeonUpstairsBark++;
		}
		
