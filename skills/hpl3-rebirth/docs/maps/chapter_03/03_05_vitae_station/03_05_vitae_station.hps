	/////fairchild torture screams
	
	bool OnCollide_Player_FairchildTortureFromAbove(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFairchildAttacked) return false;
		
		Sound_CreateAtEntity("Sound_FairchildTorture_1","03_05_vitae_station/fairchild/fairchild_torture_01", "Fairchild");
		Map_AddTimer("Timer_TasiHearsFairchild",4,"OnTimer_TasiHearsFairchild");
		return false;
	}
	
	void OnTimer_TasiHearsFairchild(const tString &in asTimer)
	{
		Voice_Play("Dialogue_TasiHearsFairchild");
	}

 
	bool OnCollide_Player_FairchildTorture_2(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFairchildAttacked) return false;
		Sound_CreateAtEntity("Sound_FairchildScream02", "03_05_vitae_station/fairchild/fairchild_torture_02", "PlayerPath_HuntingGrounds_6");
		return false;
	}
	
	bool OnCollide_Player_FairchildTorture_3(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFairchildAttacked) return false;
		Sound_CreateAtEntity("Sound_FairchildScream02", "03_05_vitae_station/fairchild/fairchild_torture_02", "PlayerPath_HuntingGrounds_6");
		return false;
	}
	
	bool OnCollide_Player_FairchildTorture_4(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFairchildAttacked) return false;
		Voice_Play("FairchildScream");

		return false;
	}
	
	int mlScream = 1;
	
	bool OnCollide_Player_FairchildScream(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFairchildAttacked) return false;
		
		Debug_Log("SCREAM");
		tString sSoundSource = Entity_GetVarString(asParent,"");
		
		if (mlScream <= 3)
			Sound_CreateAtEntity("Sound_FairchildScream", "03_05_vitae_station/fairchild/fairchild_torture_0"+mlScream, sSoundSource);
		else
			Sound_CreateAtEntity("Sound_FairchildScream", "03_05_vitae_station/fairchild/fairchild_torture_02", sSoundSource);
		mlScream++;
		return false;
	}
	
	//------------------------------------------------------- 
	
	bool OnCollide_Player_FairchildScreamRoutineStart(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbFairchildAttacked) return false;
		
		Voice_SetSource("Fairchild","Fairchild",5,80,true);
		Voice_Play("FairchildScream");
		//Map_AddTimer("Timer_FairchildScreamFar",0,"OnTimer_FairchildScreamFar");
		Map_AddTimer("Timer_FairchildScreamTasiReact",3.5f,"OnTimer_FairchildScreamTasiReact");
		return false;
	}
	
	//------------------------------------------------------- 
	
	void OnTimer_FairchildScreamFar(const tString &in asTimer)
	{
		if (mbFairchildAttacked) return;
		
		Voice_Play("FairchildScream");
		Voice_PlayDelayed("Dialogue_Fairchild_Reminder",2);
		Map_RestartCurrentTimer(cMath_RandRectf(20,35));
	}
	
	//------------------------------------------------------- 
	
	void OnTimer_FairchildScreamTasiReact(const tString &in asTimer)
	{
		Voice_Play("Dialogue_HearFairchildAlt");
		Music_Play("A2_3_5_richard_found.ogg", 0.2f, false, eMusicPrio_MinorEvent);
	}

