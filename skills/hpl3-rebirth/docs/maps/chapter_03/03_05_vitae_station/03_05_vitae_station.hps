	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 6 *PLAYER ESCAPES THROUGH POOL OF BODIES*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A - LEON EMERGES, PLAYER CAN HIDE AMONG CORPSES
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 6, Event A here.*/

		int m_idPoolShake = -1;
		int m_idPoolTrail = -1;
		int mlCageLeverState = -1;
		bool mbWaterCurrent = false;
		
		bool mbCageDetached = false;
		bool mbLeonPoolEncounter = false;		
		tString msLeonPool = "";
		
		bool mbEnginesStarting = false;
		
		int mlPoolLeverInteractions = 0;
		
		bool mbCrushCageSlide = false;
		
		int mlLeonPoolEmergeAmount = 0;
		int mlPoolHoles = 5;
		
		bool mbAreaRoom = true;
		bool mbAreaTunnel = false;
		bool mbAreaCave = false;
		
		//-------------------------------------------------------
		
		void UpdateEnginesSpeed(float afTimeStep)
		{
			if (mbLeonPoolEncounter == false) return;
			
			if (mbEnginesStarting)
			{
				for(int i = 1; i <= 4; i++)
				{
					cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName("Engine_"+i).GetMeshEntity().GetAnimationStateFromName("tth_pool_turbine_whitebox_spin");
					float fSpeed = pAnim.GetSpeed();

					if (fSpeed < 1) 
						pAnim.SetSpeed(fSpeed+cMath_RandRectf(.002f,.005f));
					else
					{
						if (i == 4) mbEnginesStarting = false;
					}
				}
			}
			else
			{
				if (mbEngineBrokenEffect) // BROKEN / CHOKING
				{
					int lEnginesAmount = (mbEngineBroken) ? 4 : 2;
					
					for (int i = 1; i <= lEnginesAmount; i++)
					{
						cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName("Engine_"+i).GetMeshEntity().GetAnimationStateFromName("tth_pool_turbine_whitebox_spin");
						pAnim.SetActive(true);
						pAnim.SetPaused(false);
						pAnim.SetWeight(1.f);
						
						float fTimeOffset = .3f*i;						
						float fTime = (i == 1) ? mfTime : mfTime+fTimeOffset;
						float fSpeed = (mbEngineBroken) ? 0.05*cMath_Sin(fTime*5) : 0.1f+cMath_Sin(fTime*10)/5;
						pAnim.SetSpeed(fSpeed);
						
						Sound_CreateAtEntity("Sound_CageChoke", "03_05_vitae_station/crusher/main/turbine/jammed", "Sound_TurbineStuck");
					
					}
				}
				else	// NORMAL SPEED UP
				{
					for (int i = 1; i <= 2; i++)	
					{
						cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName("Engine_"+i).GetMeshEntity().GetAnimationStateFromName("tth_pool_turbine_whitebox_spin");
						if (pAnim.GetSpeed() < 1)
						{
							pAnim.SetSpeed(pAnim.GetSpeed()+.02f);
						}
					}
					
					//Sound_CreateAtEntity("Sound_CageUnChoke", "03_05_vitae_station/crusher/main/turbine/start", "Sound_TurbineStuck");
				}
			}
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_MoveThroughMachine(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 && Entity_PlayerIsInFront(asParent) && Entity_IsInPlayerFOV(asParent))
			{
				Item_PutAway(eItemHandlerHand_Left);
				Item_PutAway(eItemHandlerHand_Right);
				
				if (mbLeonPoolEncounter)
				{
					PoolOfBodies_PlayerEscape();
					return false;
				}
				
				int lDir = Entity_GetVarInt(asParent,"");
				tString sAnim = (lDir == 1) ? "move_out_from_pool_under_bodycrusher" : "move_in_to_pool_under_bodycrusher";
				tString sArea = (lDir == 1) ? "PosArea_Machine" : "Machine";
				PlayerBody_PlayCutsceneAtEntity(sAnim,sArea,false,0.3f,"OnEndOfAnim_ForceStand");
				//Player_SetCrouching(false,false,true);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_ForceStand(const tString &in asAnimName)
		{
			Player_SetCrouching(false,true,true);
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_StartPoolSequence(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (!mbMilkingDeviceUsed) return true;
			
			Seq_PoolOfBodies("");
						
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_ResumePoolSequence(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (!mbMilkingDeviceUsed) return true;
			
			Debug_Log("RESUME "+asParent);
			SequenceStates_Resume("Seq_PoolOfBodies");
			
			return false;
		}
			
		//-------------------------------------------------------
		 
		cSequenceStatesData mSequencePoolOfBodies;
		void Seq_PoolOfBodies(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PoolOfBodies", mSequencePoolOfBodies);
			if (Sequence_DoStepAndPause(0))
			{
				//Game_AutoSave();
				Hint_RemoveFromGiven("Hints","HintSwing");
				SlideDoor_SetClosed("Portcullis_Pool_8",false,true);
				cLux_AddDebugMessage("SETUP GATES");
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// Cages swing
				
				cLux_AddDebugMessage("SWING CAGES");
				
				for (int i = 1; i <= mlCages; i++)
				{
					if (i != 2)
						Entity_AddImpulse("Cage_"+i,cVector3f(cMath_RandRectf(-1.2f,1.2f),cMath_RandRectf(-.5f,.5f),cMath_RandRectf(-1.4f,1.4f)),true,true);
					else
						Entity_AddImpulse("Cage_"+i,cVector3f(-1.2f,0,0),true,true);
				}
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// Close Gate Behind
				
				cLux_AddDebugMessage("CLOSE GATE");
				
				SlideDoor_SetClosed("MachineRoomGate_5",true,false);
				Pregnancy_SetWhispering(true);
				FearHandler_SetPermaFailEnabled(false);
				Map_AddTimer("Timer_StartPoolEncounter",3,"OnTimer_StartPoolEncounter");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				cLux_AddDebugMessage("SOUND AND ALL");
				SlideDoor_SetClosed("Portcullis_Pool_10",true,true);
				SlideDoor_SetClosed("Portcullis_Pool_8",true,false);
				m_idPoolTrail = Effect_ImageTrail_Start(1,5,9000,100);
				Entity_SetActive("Trigger_MachineShake",true);
				Entity_SetActive("Trigger_ThroughMachine_1",false);
				Map_AddTimer("Timer_LowerMachineVolume",0,"OnTimer_LowerMachineVolume");
				
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				//cLux_AddDebugMessage("I AM HERE 4");
				//Entity_SetActive(msLeonPool,true);
				Voice_SetSource("Leon","Ghoul_LeonPool_Escape",5,120,true);
				if (Voice_SubjectIsPlaying("BabyKick"))
					Map_AddTimer("Timer_DelayedLeonTaunt",7,"OnTimer_DelayedLeonTaunt");
				FearHandler_SetForcedAddFearRate(0.3f,4,false,-1,-1,0.7f);
				Engines_Spark();
				SlideDoor_SetClosed("Portcullis_MachineExit",false);
				Music_Play("A2_3_5_Leon_Machine.ogg", 0.12f, false, eMusicPrio_MinorEvent);
				//SlideDoor_SetClosed("Portcullis_CrusherGate_*",false);
			}
			else if (Sequence_DoStepAndWait(0.8f))
			{
				Light_SetBrightnessIncrease("Light_Point_35",5,0.1f,0.1f);
				Entity_PlayAnimation("Machine","tth_pool_machine_whitebox_chop",0.1f,true);
				Entity_SetActive("Machine_Blocker",true);
				
				Map_AddTimer("Machine",0,"OnTimer_MachineUnstuck");
				
				Entity_SetActive("Trigger_CageHit",true);
				Entity_SetActive("Trigger_CrusherDamage",true);
				
				Effect_Shake_Start(0.03,1,0.3f,7);
				Map_AddTimer("Timer_CagesCurrent",0,"OnTimer_CagesCurrent");
				//mbWaterCurrent = true;
				//cLux_GetPlayer().AutomoveCharBodyTo(100, 1, 0.45f, Map_GetEntity("Machine").GetPosition());
				mfCurrentMul = 4;
				
				Map_AddTimer("Timer_PulseStart", 0.01f, "OnTimer_PulseDelay");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Map_AddTimer("Timer_EnginesSpark",0,"OnTimer_EnginesSpark");
				Map_AddTimer("Timer_EnginesChoke",3,"OnTimer_EnginesChoke");

				//Entity_SetActive("ObjectHeavy_1",true);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Engines_Spark();
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Seq_LeonPoolIntro("");
				Effect_ImageTrail_FadeOut(m_idPoolTrail,1);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DelayedLeonTaunt(const tString &in asTimer)
		{
			if (Voice_SubjectIsPlaying("BabyKick"))
				Map_RestartCurrentTimer(3);
			else
				Voice_PlayDelayed("Leon_StartsMachine",3);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LowerMachineVolume(const tString &in asTimer)
		{
			Map_AddTimer("Timer_ResumeMachineVolume",5,"OnTimer_ResumeMachineVolume");
			if (Voice_SubjectIsPlaying("BabyKick"))
			{
				Sound_Play("Sound_CrusherStart", 0.0f);
				Sound_Play("Sound_MainLoop", 0.0f);
				Sound_Fade("Sound_CrusherStart",0.1,0);
				Sound_Fade("Sound_MainLoop",0.1,1);
				
				for(int i = 1; i <= 4; i++)
				{
					Sound_Fade("Sound_Engine_"+i+"_Run",0.1f,0.5f);
					Sound_Fade("Sound_Engine_"+i+"_Start",0.1f,0.5f);
				}
			}
			else
			{
				Sound_Play("Sound_CrusherStart", 0.0f);
				Sound_Play("Sound_MainLoop", 5.0f);
			}
		}
		
		void OnTimer_ResumeMachineVolume(const tString &in asTimer)
		{
			if (Voice_SubjectIsPlaying("BabyKick") == false)
			{
				cLux_AddDebugMessage("RESUME VOLUME");
				Sound_Fade("Sound_CrusherStart",1,6);
				Sound_Fade("Sound_MainLoop",1,6);
				
				for(int i = 1; i <= 4; i++)
				{
					Sound_Fade("Sound_Engine_"+i+"_Run",1.f,6.f);
					Sound_Fade("Sound_Engine_"+i+"_Start",1.f,6.f);
				}
				return;
			}
			cLux_AddDebugMessage("VOICE STILL PLAYING");
			Map_RestartCurrentTimer(2);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PulseDelay(const tString &in asTimer)
		{
			Map_AddTimer("Timer_PulseSound", 3.5f, "OnTimer_PlayPulseSound");
		}

		void OnTimer_PlayPulseSound(const tString &in asTimer)
			{
				if (mbAreaRoom == true)
					{
						Sound_CreateAtEntity("Sound_MainPulse", "03_05_vitae_station/crusher/main/main_pulse", "Sound_PulseMain");
						Map_AddTimer("Timer_PulseDelay", 0.01f, "OnTimer_PulseDelay");
					}
				else if (mbAreaTunnel == true)
					{
						Sound_CreateAtEntity("Sound_TunnelPulse", "03_05_vitae_station/crusher/tunnel/tunnel_pulse", "Sound_PulseTunnel");
						Sound_CreateAtEntity("Sound_TunnelMainPulse", "03_05_vitae_station/crusher/tunnel/MainPulseTunnel", "Sound_MainPulseTunnel");
						Map_AddTimer("Timer_PulseDelay", 0.01f, "OnTimer_PulseDelay");
					}
				else if (mbAreaCave == true)
					{
						Sound_CreateAtEntity("Sound_CavePulse", "03_05_vitae_station/crusher/small_cave/cave_pulse", "Sound_PulseCave");
						Map_AddTimer("Timer_PulseDelay", 0.01f, "OnTimer_PulseDelay");
					}
					
				
			}
		
		
		//-------------------------------------------------------
		
		void OnTimer_StartPoolEncounter(const tString &in asTimer)
		{
			for(int i = 1; i <= 4; i++)
				{
					Entity_PlayAnimation("Engine_"+i,"tth_pool_turbine_whitebox_spin",30,true);
					cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName("Engine_"+i).GetMeshEntity().GetAnimationStateFromName("tth_pool_turbine_whitebox_spin");
					pAnim.SetSpeed(0);
					Sound_CreateAtEntity("Sound_Engine_"+i+"_Run","03_05_vitae_station/crusher/main/turbine/turbine_loop","Engine_"+i,2.0f);
					Sound_CreateAtEntity("Sound_Engine_"+i+"_Start","03_05_vitae_station/crusher/main/turbine/first_start","Engine_"+i,0.1f);
					mbEnginesStarting = true;
				}
				
				Engines_Spark();
				
				Prop_MoveLinearTo("Cage_2_Root","Rail_1",2,1,0.2f,true,"");
				Prop_SetActiveAndFade("special_vitae_station_pool_1",true,1);
				
				mbLeonPoolEncounter = true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_MachineShake(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				m_idPoolShake = Effect_Shake_Start(0.015f,100000,1.f,100);
			if (alState == -1)
				Effect_Shake_FadeOut(m_idPoolShake,2);
				
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_PoolOfBodies(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (!mbWaterCurrent) return true;
			
			if (alState == 1)
			{
				cLux_GetPlayer().AutomoveCharBodyTo(100, 1, 0.25f, Map_GetEntity("Machine").GetPosition());
				Debug_Log("CURRENT");
			}
			if (alState == -1)
			{
				cLux_GetPlayer().StopAutomoveCharBody();
				Debug_Log("NO CURRENT");
			}
				
			return true;
		}
		
