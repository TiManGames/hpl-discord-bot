			Voice_Play("Tasi_LeonRecognition");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EscapedHuntingGrounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			/** This appears to be misnamed - actually seems to be as you get into the milking room - IT */
			if (alState != 1) return true;
			
			//Game_AutoSave();
			SetupPermaFail(eVitaeStationPermaFail_TortureArea);
			PressurePlate_ManageTriggersStage(10);
			Map_AddTimer("Timer_FairchildScreamFar",60,"OnTimer_FairchildScreamFar");
			mbHuntingGroundsCompleted = true;
			
			Voice_SetSource("Fairchild","Fairchild",5,40,true);
			
			return false;
		}
		
