			Map_AddTimer("Timer_ResetAirlock",0.8f,"OnTimer_ResetAirlock");
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_ResetAirlock(const tString &in asTimer)
		{
			tString sDoor = "Portcullis_HuntingGrounds_Entrance_1";
			float fOpenAmount = SlideDoor_GetOpenAmount(sDoor);
			(fOpenAmount < 0.35f) ?	SlideDoor_SetClosed(sDoor,true) : SlideDoor_SetClosed(sDoor,false);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ResetAirlock(const tString &in asEntity)
		{
			Map_RemoveTimer("Timer_ResetAirlock");
		}
		
