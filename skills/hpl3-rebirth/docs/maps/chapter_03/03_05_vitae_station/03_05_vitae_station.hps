		//-------------------------------------------------------
		
		void OnTimer_PlayerWakeUpAfterFall(const tString &in asTimer)
		{	
			if (FearHandler_GetLevel() >= .9f)	FearHandler_FadeLevelTo(.85,0,true);
			
			Player_Teleport("Start_UndergroundTunnel");
			Player_SetCrouching(true,true,true);
			//PlayerBody_PlayCutsceneAnimation("wake_up_from_death_1c",false,0);
			//PlayerBody_GetAnimationState("wake_up_from_death_1c").SetSpeed(0.6f);
			Effect_Fade_In(1.f);
			Map_AddTimer("Timer_TasiGetUpFromPoolFall",1.5f,"OnTimer_TasiGetUpFromPoolFall");
			Player_SetRunSpeedMul(0.2f);
			Player_SetMoveSpeedMul(0.6f);
			Player_FadeRunSpeedMulTo(1,15);
			Player_FadeMoveSpeedMulTo(1,12);
			//Map_AddTimer("Timer_TasiBabyMoment",17,"OnTimer_TasiBabyMoment");
			//Voice_Play("Global_Tasi_Bark_Stage2_Fall_Big",2);
		}
		
