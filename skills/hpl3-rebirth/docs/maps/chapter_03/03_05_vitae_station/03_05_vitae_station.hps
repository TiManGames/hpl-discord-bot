		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event B here.*/
		
		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 5, Event B here.*/
		
		//-------------------------------------------------------	

		//} END Event B

		/////////////////////////////////////////
		// Event C PLAYER USES THE MILKING DEVICE
		//{//////////////////////////////////////

		//-------------------------------------------------------

		bool mbVitaeCanisterPushed = false;
				
		//-------------------------------------------------------
		
		void OnTimer_PushVitaeEndLoop(const tString &in asTimer)
		{
			Map_RemoveTimer("Timer_VitaePushOn");
			Map_RemoveTimer("Timer_VitaePushOff");
			Map_RemoveTimer("A");
			Map_RemoveTimer("B");
			SlideDoor_SetClosed("vitae_canister_collection_door_1",false);
			Entity_SetActive("InteractAux_VitaeCanisterPickup",true);
			// Pipes sequentially off (0)
			VitaePipe_PushVitae("A",8,1);
			VitaePipe_PushVitae("B",6,1);
		}
		
		//-------------------------------------------------------	
		
		void OnTimer_PushVitaeLoop(const tString &in asTimer)
		{
			Map_AddTimer("Timer_VitaePushOn", 0, "OnTimer_CreateVitaePush");
			Map_SetTimerUserVarInt("Timer_VitaePushOn",1);
			Map_SetTimerUserVarString("Timer_VitaePushOn",asTimer);
			
			Map_AddTimer("Timer_VitaePushOff", 1.5f, "OnTimer_CreateVitaePush");
			Map_SetTimerUserVarInt("Timer_VitaePushOff",0);
			Map_SetTimerUserVarString("Timer_VitaePushOff",asTimer);
			
			Map_RestartCurrentTimer(2.f);
		}
		
		//-------------------------------------------------------	
		
		void OnTimer_CreateVitaePush(const tString &in asTimer)
		{
			int lStatus = Map_GetTimerUserVarInt(asTimer);
			tString sGroup = Map_GetTimerUserVarString(asTimer);
			
			int lParts;
			
			if (sGroup == "A")
				lParts = 8;
			else if (sGroup == "B")
				lParts = 6;
			else
				lParts = 0;
			
			VitaePipe_PushVitae(sGroup, lParts, lStatus);
		}
			
		//-------------------------------------------------------
		
		void VitaePipe_PushVitae(const tString &in asGroup, int alParts, int alStatus)
		{

			for (int i = 1; i <= alParts; i++)
			{
				tString sTimer = "VitaePipe"+asGroup+"_"+i;
				Map_AddTimer(sTimer, 0.1f*i, "OnTimer_SetVitaePipeStatus");
				Map_SetTimerUserVarInt(sTimer, i);
				tString sStatus = "";
				if (alStatus == 1) 
					Map_SetTimerUserVarString(sTimer,"On");
				else
					Map_SetTimerUserVarString(sTimer,"Off");
			}
		}
		
		//-------------------------------------------------------	
		
		void OnTimer_SetVitaePipeStatus(const tString &in asTimer)
		{
			int lPipePart = Map_GetTimerUserVarInt(asTimer);
			tString sStatus = Map_GetTimerUserVarString(asTimer);
			bool bStatus = (sStatus == "On") ? true : false;
			Lamp_SetLit(asTimer, bStatus, true);
		}
		
		//------------------------------------------------------- 
	 
		bool OnCollide_Player_MilkingDevice(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (!mbFairchildAttacked) return true;
			
			Tasi_EnterMilkingMachine();			
			return false;
		}
		
		//-------------------------------------------------------
		
		void Tasi_EnterMilkingMachine()
		{
			Debug_Log("START MILKING");
			Effect_Shake_Start(.01f,2,2,0.3f);
			CameraAnimation_Begin("CamAnimMilk","",true);
			Map_RemoveTimer("Timer_TasiBreathe");
			Player_SetMoveSpeedMul(1);
			Sound_Stop("Sound_MilkingMachineHum",2.0);
			Music_Stop(4.5f, eMusicPrio_SceneAmb);
			Map_AddTimer("Timer_MilkingMachineSoundDelay",0,"OnTimer_MilkingMachineSoundDelay");
		}
		
		void OnTimer_MilkingMachineSoundDelay(const tString &in asTimer)
		{
			Sound_CreateAtEntity("MilkingMachineWake", "03_05_vitae_station/level/vita_machine_awaken", "player");
			Sound_CreateAtEntity("MilkingMachineWake", "03_05_vitae_station/level/vita_machine_awaken_vocal", "player");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_WhooshSound(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_WhooshFront", "03_05_vitae_station/milking_machine/vitae_player_whoosh/vitae_whoosh_front", "Sound_VitaeWhooshFront");
			Sound_CreateAtEntity("Sound_WhooshRear", "03_05_vitae_station/milking_machine/vitae_player_whoosh/vitae_whoosh_rear", "Sound_VitaeWhooshRear");
			return false;
		}
		
		bool OnCamAnim_Dolly(const tString &in asEntity, int alDirection)
		{
			Debug_Log("DOLLY");
			Effect_DollyZoom_Start(2,1,1.f,2);
