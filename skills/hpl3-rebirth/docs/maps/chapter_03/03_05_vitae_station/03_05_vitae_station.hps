		bool OnTrigger_PlayAmbMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_PlayExt("A2_3_5_sneaking_tension.ogg", true, 0.1f, 1.0f, 45.0f, 1.0f, eMusicPrio_BgAmb, true);
			return true;
		}

		//} END Event A

		/////////////////////////////////////////
		// Event B - PLAYER FINDS STERLINGS CORPSE AND PHOTO OF FAIRCHILD
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event B here.*/
		
		int mlDoorHits = 2;
		float mfThrowHintCount = 0.f;
		bool mbCanBark = true;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event B here.*/
		
		bool OnCollide_Door_PlankBlock(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) 
			{
				Sound_CreateAtEntity("SoundWoodSplinter","02_04_living_quarters/floor_plank/floor_plank_creak","Trigger_WoodBlock",0,false,20,0,3);
				if (mbCanBark == false) return true; 
				
				Voice_PlayDelayed("Dialogue_Plank_Blocked",0.8f);
				mbCanBark = false;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_DoorDamage(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (Map_GetEntity(asChild).GetMainBody().GetMass() == 0 && asChild != "Player") return true;
			if (Entity_IsInteractedWith(asChild)) return true;
			
			float fVel = Map_GetEntity(asChild).GetMainBody().GetVelocityAtPosition(Map_GetEntity(asChild).GetPosition()).Length();
			
			cLux_AddDebugMessage("VEL: "+fVel);

			if (fVel > 2.5f)
			{
				mlDoorHits--;
				Sound_CreateAtEntity("SoundWoodSplinter","03_05_vitae_station/level/wood_splinter","Trigger_WoodBlock");
			}
			else return true;
			
			if (mlDoorHits == 1)
			{
				Entity_SetActive("wooden_brace_intact", false);
				Entity_SetActive("wooden_brace_damaged", true);
			}
			else if (mlDoorHits < 0)
			{
				Prop_SetHealth("wooden_brace_damaged",0);
				SwingDoor_PushOpen("door_braced",1,2);
				return false;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ShowThrowHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_CheckShouldShowThrowHint", 1.f, "OnTimer_CheckShouldShowThrowHint");
			mfThrowHintCount = 0.f;
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckShouldShowThrowHint(const tString &in asTimer)
		{
			bool bShowHint = true;
			
			if (mlDoorHits < 2)
				return;
			
			if (Entity_GetCollide("player", "Trigger_ShowThrowHint") == false)
				bShowHint = false;
			if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Grab)
				bShowHint = false;
			
			iLuxEntity@ pEnt = Map_GetEntity("Trigger_WoodenBrace", eLuxEntityType_Area);
			if (pEnt !is null)
			{
				cCamera@ pCam = cLux_GetPlayer().GetCamera();
				cVector3f vDir = cMath_Vector3Normalize(pEnt.GetPosition() - pCam.GetPosition());
				float fDot = cMath_Vector3Dot(pCam.GetForward(), vDir);
				
				if (fDot < 0.95f)
					bShowHint = false;
			}				
				
			if (bShowHint)
				mfThrowHintCount += 0.5f;			
			
			if (mfThrowHintCount > 7.5f)
			{
				Hint_StopHint();
				Hint_RemoveFromGiven("Hints", "HintGrabThrow");
				Hint_ShowHint_Hold("Hints", "HintGrabThrow", true, 1.5f, true, 10.f);
				return;
			}
			
			Map_AddTimer("Timer_CheckShouldShowThrowHint", 0.5f, "OnTimer_CheckShouldShowThrowHint");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_WoodenBrace(const tString &in asParent, const tString &in asChild, int alState)
        {
			cLux_AddDebugMessage("HJHJHJ");
			if (alState != 1) return true;
			if (Map_GetEntity(asChild).GetMainBody().GetMass() == 0 || asChild == "Player") return true;
			
		    Entity_SetActive("wooden_brace_intact", false);
		    Entity_SetActive("wooden_brace_damaged", true);
			Sound_CreateAtEntity("SoundWoodSplinter","03_05_vitae_station/level/wood_splinter","wooden_brace_damaged");
			
			Map_RemoveTimer("Timer_CheckShouldShowThrowHint");
			Map_RemoveTimer("Timer_ShowThrowHint");
	        return false;
        }
		
		//-------------------------------------------------------
		
		void OnBreak_WoodenBrace(const tString &in asEntity)
        {
            SwingDoor_SetBlocked("door_braced", false, false);
			Sound_CreateAtEntity("SoundWoodSnap", "03_05_vitae_station/level/wood_break", "wooden_brace_damaged");
			Entity_SetActive("Trigger_WoodBlock",false);
			Entity_SetActive("Trigger_DoorDamage",false);
		}
		
		//------------------------------------------------------- 
		
		void OnLookAt_RecognizeSterling(const tString &in asEntity, int alState)
		{
			Voice_Play("Tasi_Recognises_Sterling",-1,"OnRecogniseSterlingComplete");
			Entity_SetActive("Trigger_RecognizeSterling_*",false);
		}
		
		//------------------------------------------------------- 
		
		void OnRecogniseSterlingComplete(const tString&in asScene, const tString&in asSubject)
		{
			Sketchbook_UnlockMemory("Sterling");
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ReleaseScorpion(const tString &in asEntity)
		{
			if (Entity_IsActive("critter_scorpion_scare_fake")) return;
			if (Entity_GetVarBool("critter_scorpion_scare_fake", "bScorpionScareDone")) return;
			
			Prop_SetStaticPhysics("throwable_rock_scorpion_trigger_*", false);
			
			Entity_SetActive("critter_scorpion_scare_fake", true);
			Sound_CreateAtEntity("ScorpionStoneImpact", "physics/stone/stone_bigger/stone_bigger_impact", "throwable_rock_scorpion_trigger_01");
			Entity_SetVarBool("critter_scorpion_scare_fake", "bScorpionScareDone", true);
			
			if (SequenceStates_IsActive("Seq_ScorpionScare")) return;
			Seq_ScorpionScare("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeq_ScorpionScare;
			
		void Seq_ScorpionScare(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ScorpionScare", mSeq_ScorpionScare);
			
			if (Sequence_DoStepAndWait(0.1))
			{
				Entity_PlayAnimation("critter_scorpion_scare_fake", "Move", 0.01f, true);
			}
			else if (Sequence_DoStepAndPause())
			{
				Prop_MoveLinearTo("critter_scorpion_scare_fake", "Area_FakeScorpionDest_1", 5, 2, 0.25, false);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Entity_PlayAnimation("critter_scorpion_scare_fake", "Idle", 0.1f, true);
			}
			else if (Sequence_DoStepAndContinue())
			{
				Entity_PlayAnimation("critter_scorpion_scare_fake", "Move", 0.1f, true);
				Prop_MoveLinearTo("critter_scorpion_scare_fake", "Area_FakeScorpionDest_2", 5, 2, 0.25, false);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_UpdateScorpion(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (asParent=="Area_FakeScorpionDest_1")
				SequenceStates_Resume("Seq_ScorpionScare");
			else if (asParent=="Area_FakeScorpionDest_2")
				Entity_SetActive(asChild, false);
				
			return false;
		}
		
		//-------------------------------------------------------

		//} END Event B
		
		/////////////////////////////////////////
		// Event B - PLAYER FINDS THE HUNTING GROUND
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event C here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event C here.*/
		
		bool OnCollide_Player_LeonGlimpse(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (FearHandler_GetIsPermaFailing()) return true;
			
			int lNum = Entity_GetVarInt(asParent,"");
			
			float fVoiceDelay = 0;
			
			Voice_SetSource("Leon","SoundArea_LeonGlimpse_"+lNum,5,15,true);
			Voice_SetSource("Leon_Unknown","SoundArea_LeonGlimpse_"+lNum,5,15,true);
				
			if (lNum == 1)
			{
				FearHandler_SetForcedAddFearRate(0.41f,8,false,-1,-1,.5f);
				Lamp_SetLit("lamp_spire_20",false,true);
				Lamp_SetLit("lamp_spire_21",false,true);
				Lamp_SetFlickerActive("lamp_spire_22",true);
				Map_AddTimer("Timer_StopFlicker",3,"OnTimer_StopFlicker");
				Light_SetBrightness("Light_Box_18",2);
				Light_SetBrightness("Light_Box_8",4);
				//Sound_CreateAtEntity("Sound_Lamp","03_05_vitae_station/level/leon_entry_scare","lamp_spire_20",0,false,.3f);
				fVoiceDelay = 2.f;
			}	
			else if (lNum == 2)
			{
				Lamp_SetFlickerActive("Lamp_Flicker_*",true);
				//Sound_CreateAtEntity("Sound_Lamp","03_05_vitae_station/level/leon_entry_scare","Lamp_Flicker_1",0,false,0.4f);
				Map_AddTimer("Timer_ResetFlicker",2,"OnTimer_ResetFlicker");
				FearHandler_SetForcedAddFearRate(0.2f,8,false,-1,-1);
				fVoiceDelay = 2.f;
			}
			else if (lNum == 3)
			{
				FearHandler_SetForcedAddFearRate(0.2f,8,false,-1,-1);
			}
								
			Sound_CreateAtEntity("Sound_GhoulMove", "03_05_vitae_station/level/leon_entry_scare", "SoundArea_LeonGlimpse_"+lNum);
			Voice_StopAll();
			Voice_PlayDelayed("Leon_Buildup",fVoiceDelay);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopFlicker(const tString &in asTimer)
		{
			Lamp_SetFlickerActive("lamp_spire_22",false);
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_ResetFlicker(const tString &in asTimer)
		{
			Lamp_SetFlickerActive("Lamp_Flicker_*",false);
			Lamp_SetLit("Lamp_Flicker_*",false,true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_SafeRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 && SwingDoor_GetBlocked("SwingDoor_ControlRoom"))
			{
				FearArea_SetLocked("Safe_ControlRoom",true);
				Debug_Log("SAFE");
			}
			else
			{
				FearArea_SetLocked("Safe_ControlRoom",false);
				Debug_Log("UNSAFE "+asParent+" "+asChild+" "+alState);
			}
			return true;
		}
		
