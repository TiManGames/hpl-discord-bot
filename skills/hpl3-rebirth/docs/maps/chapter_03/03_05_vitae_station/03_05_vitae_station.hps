		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 3, Event D here.*/

		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 3, Event D here.*/
		
		bool OnCollide_Player_LeonStage3_Gating(const tString &in asParent, const tString &in asChild, int alState)
		{
			SlideDoor_SetClosed("Portcullis_HG_ToStage2_5",true);
			PressurePlate_ManageTriggersStage(8);
			return false;
		}
		
		//------------------------------------------------------- 

		bool OnCollide_Player_LeonStage3_Activate(const tString &in asParent, const tString &in asChild, int alState)
		{
			LeonStage3_Activate();
			return false;
		}
		
		//----------------------------------------------------------
		
		void LeonStage3_Activate()
		{
			if (mlLeonStage != 2) return;
			
			Map_RemoveTimer("Timer_LeonStage2_Voice");
			Map_RemoveTimer("Timer_LeonStage2_ResumeThreaten");
			Map_RemoveTimer("Timer_LeonStage2_RunToPosition");
			Map_RemoveTimer("Timer_LeonStage2_Banging");
			
			SlideDoor_SetClosed("Portcullis_HG_Stage3Trap_2",false);
			SlideDoor_SetClosed("Portcullis_HG_Stage3Gating",true);

			Ghoul_Command_Remove(msLeon,true);
			Entity_SetActive(msLeon,false);
			msLeon = "Ghoul_LeonStage3";
			Entity_SetActive(msLeon,true);
			Voice_SetSource("Leon",msLeon,0,25,true);
			Voice_SetSource("Leon_Unknown",msLeon,0,25,true);
			Leon_SetCustomFearValues(true,4);
			Music_Stop(0, eMusicPrio_AgentHunt);
			Agent_SetSensesActive(msLeon,false);
			Ghoul_Mode_Set(msLeon,eGhoulMode_Idle,true);
			Ghoul_SetAllowPlayerThrow(msLeon,true);
			//CharMover_PlayAnimation(msLeon,"ceiling_grate_bang", 0.1f, true, false, "");
			CharMover_PlayAnimation(msLeon, "panic_struggle_violent_ls", 0.3f, true, false, "");
			Map_AddTimer("Timer_LeonStage3BangBarks",2,"OnTimer_LeonStage3BangBarks");
			
			Map_AddTimer("Timer_LeonStage3_ActivateTrap",20,"OnTimer_LeonStage3_ActivateTrap");
			Sound_Stop("Sound_LeonHuntSweet_P2", 3.0f);
			
			mlLeonStage = 3;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage3BangBarks(const tString &in asTimer)
		{
			Voice_Play("Leon_AfterTrap_ConflictIdle");
			Map_RestartCurrentTimer(cMath_RandRectf(5,10));
		}
		
		//----------------------------------------------------------
			
		void OnTimer_LeonStage3_ActivateTrap(const tString &in asTimer)
		{
			mbLeonCanGoToStage3 = true;
			Voice_SetSource("Leon",msLeon,0,25,true);
			Voice_SetSource("Leon_Unknown",msLeon,0,25,true);
			Debug_Log("WAIT FOR TRIGGER");
			Map_AddTimer("Timer_CheckPlayerInTrigger",0.5f,"OnTimer_CheckPlayerInTrigger");
		}
		
		//----------------------------------------------------------
		
		void OnTimer_CheckPlayerInTrigger(const tString &in asTimer)
		{
			iLuxEntity@ pLeon = Map_GetEntity(msLeon);
			if (Entity_GetCollide("player","Trigger_HG_PlayerPosToStage3") && pLeon.CheckIsOnScreen(true))
			{
				LeonStage3_Hunt();
				PressurePlateGroup_In_Sequence("Trigger_PressurePlate_ToStage3_","Portcullis_HG_Stage3_",8,.1f,1);
				Entity_SetActive("Trigger_HG_PlayerPosToStage3",false);
				SlideDoor_SetClosed("Portcullis_HG_Stage3TrapEarly_*",true);
				Map_AddTimer("Timer_PortcullisFearBump",0.6f,"OnTimer_PortcullisFearBump");
			}
			else
				Map_RestartCurrentTimer(0.5f);
		}
		
		//----------------------------------------------------------
		
		void LeonStage3_Hunt()
		{
			Map_RemoveTimer("Timer_LeonStage3_ActivateTrap");
			Map_RemoveTimer("Timer_CheckPlayerInTrigger");
			Map_RemoveTimer("Timer_LeonStage3BangBarks");
			//Entity_SetActive("Trigger_HG_Trap3",false);
			Leon_SetCustomFearValues(false);
			Entity_SetActive("Trigger_HG_ToStage3",false);
			Entity_SetActive("Trigger_RemoveLeonThrow",true);
			
			Ghoul_Command_Remove(msLeon,true);
			CharMover_PlayAnimation(msLeon, "alert", 0.3f, true, false, "");
			Sound_CreateAtEntity("Sound_GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_spot", msLeon);		
			Voice_StopAll();
			Map_AddTimer("Timer_LeonStage3_StartThreaten",1,"OnTimer_LeonStage3_StartThreaten");
			Map_AddTimer("Timer_LeonStage3_HuntForcedMusic",1,"OnTimer_LeonStage3_HuntForcedMusic");
			Map_AddTimer("Timer_LeonStage3_StartHunt",7,"OnTimer_LeonStage3_StartHunt");
		}
		
