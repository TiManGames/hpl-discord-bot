	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 3 *HUNTING GROUNDS*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 3 here.*/
		
		tString msLeon = "";
		bool mbHuntingGroundsCompleted = false;
		bool mbLeonRecognized = false;
		int mlLeonStage = 0;
		int mlPortcullisScares = 3;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 3 here.*/
		
		bool OnCollide_Player_HuntingGroundsSetup(const tString &in asParent, const tString &in asChild, int alState)
		{
			PressurePlate_ManageTriggersStage(1);
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_HuntingGroundsMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_HuntingGroundsMusic",1,"OnTimer_HuntingGroundsMusic");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_HuntingGroundsMusic(const tString &in asTimer)
		{
			Music_Play("A2_3_5_Hunting_Ground_Maze.ogg", 0.07, true, eMusicPrio_SceneAmb);
		}
		
		//-------------------------------------------------------
		
		void Leon_SetCustomFearValues(bool abSetCustomValues, float afCustomValue=1)
		{
			if (!Entity_Exists(msLeon)) return;
			
			if (abSetCustomValues)
			{
				//FearThreatAgent_SetOverrideFactor(msLeon,1);
				FearThreatAgent_SetBaseFearRateMul(msLeon,afCustomValue);
			}
			else
			{
				//FearThreatAgent_SetOverrideFactor(msLeon,0);
				FearThreatAgent_SetBaseFearRateMul(msLeon,0.35f);
			}
		}
		
		//------------------------------------------------------- 
				
		bool OnCollide_PressurePlate(const tString &in asParent, const tString &in asChild, int alState)
		{
			array <tString> vsStrings;
			tString sUserVar = Entity_GetVarString(asParent,"");
			tString sPlate = "";
			tString sDoor = "";
			
			cString_GetStringVec(sUserVar, vsStrings," ");
			if (vsStrings.length() > 0)	sPlate = vsStrings[0];
			if (vsStrings.length() > 1)	sDoor = vsStrings[1];
			
			int lItems = PressurePlate_ItemsCount(asParent,alState);
			
			if (lItems > 1 && alState == 1) return true;
			if (lItems > 0 && alState == -1) return true;
			
			PressurePlate_EventManager(asParent,alState,sDoor,asChild);
			PressurePlate_Effects(asParent,asChild,sPlate,alState);

			return true;
			
		}
		
		//-------------------------------------------------------
		
		void PressurePlate_ManageTriggersStage(int alStage)
		{
			if (alStage == 0)
			{
				Entity_SetActive("Trigger_PressurePlate*", false);
			}
			else if (alStage == 1)
			{
				Entity_SetActive("Trigger_PressurePlate_Entrance*",true);
				Entity_SetActive("Trigger_PressurePlate_IntroSlide",true);
				Entity_SetActive("Trigger_PressurePlate_BlockOffEntrance",true);
				Entity_SetActive("Trigger_PressurePlate_EnterStage0_*",true);
			}
			else if (alStage == 2)
			{
				Entity_SetActive("Trigger_PressurePlate_Entrance*",false);
				Entity_SetActive("Trigger_PressurePlate_IntroSlide",false);
				Entity_SetActive("Trigger_PressurePlate_BlockOffEntrance",false);
				
				Entity_SetActive("Trigger_PressurePlate_Dummy_*",true);
			}
			else if (alStage == 3)
			{
				Entity_SetActive("Trigger_PressurePlate_EnterStage0_*",false);
				Entity_SetActive("Trigger_PressurePlate_Dummy_*",false);
				
				Entity_SetActive("Trigger_PressurePlate_JumpOver_*",true);
			}
			else if (alStage == 4)
			{
				Entity_SetActive("Trigger_PressurePlate_JumpOver_*",false);
	
				Entity_SetActive("Trigger_PressurePlate_PastStage1_*",true);
				Entity_SetActive("Trigger_PressurePlate_Dressing_*",true);
				Entity_SetActive("Trigger_PressurePlate_ToStage2_*",true);
			}
			else if (alStage == 5)
			{
				Entity_SetActive("Trigger_PressurePlate_PastStage1_*",false);
			}
			else if (alStage == 6)
			{
				Entity_SetActive("Trigger_PressurePlate_Dressing_*",false);
				
				Entity_SetActive("Trigger_PressurePlate_Stage2Dummy_*",true);
				Entity_SetActive("Trigger_PressurePlate_CloseStage2_*",true);
			}
			else if (alStage == 7)
			{
				Entity_SetActive("Trigger_PressurePlate_ToStage2_*",false);
				Entity_SetActive("Trigger_PressurePlate_Stage2Dummy_*",false);
			}
			else if (alStage == 8)
			{
				Entity_SetActive("Trigger_PressurePlate_CloseStage2_*",false);
				
				Entity_SetActive("Trigger_PressurePlate_ToStage3_*",true);
				Entity_SetActive("Trigger_PressurePlate_25",true);
			}
			else if (alStage == 9)
			{
				Entity_SetActive("Trigger_PressurePlate*", false);
				Entity_SetActive("Trigger_PressurePlate_ToStage3_*",false);
			}
			else
			{
				Entity_SetActive("Trigger_PressurePlate*", false);
			}
		}
		
		//------------------------------------------------------- 
		
		int PressurePlate_ItemsCount(const tString &in asParent, int alState)
		{
			int lItems = Entity_GetVarInt(asParent,"ItemsPressing");
				
			lItems += alState;

			Entity_SetVarInt(asParent,"ItemsPressing",lItems);
			
			return lItems;
		}
		
		//-------------------------------------------------------		
		
		void PressurePlate_EventManager(const tString &in asParent, int alState, const tString &in asDoor, const tString &in asChild)
		{	
			if (asParent == "Trigger_PressurePlate_Entrance_2")												PressurePlate_In_Sequence(asParent,asDoor,2,1,alState);
			else if (asParent == "Trigger_PressurePlate_IntroSlide" ||
					asParent == "Trigger_PressurePlate_PastStage1_2") 										PressurePlate_InOut_OpenClose(asDoor,alState);
			else if (asParent == "Trigger_PressurePlate_PastStage1_3" 	||
					asParent == "Trigger_PressurePlate_PastStage1_1")										PressurePlate_InOut_OpenClose(asDoor,alState*-1);
			else if (asParent == "Trigger_PressurePlate_BlockOffEntrance" || 
					asParent == "Trigger_PressurePlate_Dummy_1")											PressurePlate_In_Close(asDoor,alState);
			else if (asParent == "Trigger_PressurePlate_Dummy_3")											PressurePlate_In_Sequence(asParent,asDoor,3,3, alState);
			else if (cString_GetFirstStringPos(asParent, "Trigger_PressurePlate_EnterStage0_") == 0)		
			{
				PressurePlate_Event_EnterStage0("Trigger_PressurePlate_EnterStage0_");
				PressurePlateGroup_In_Close("Trigger_PressurePlate_EnterStage0_",asDoor,alState);
				PressurePlate_ManageTriggersStage(2);
			}
			else if (cString_GetFirstStringPos(asParent, "Trigger_PressurePlate_JumpOver_") == 0)			PressurePlate_InOut_JumpOver(asDoor,alState);
			else if (cString_GetFirstStringPos(asParent, "Trigger_PressurePlate_Dressing_") == 0)			
			{
				PressurePlateGroup_In_Sequence("Trigger_PressurePlate_Dressing_",asDoor,5,0.6f,alState);
				PressurePlate_ManageTriggersStage(5);
			}
			else if (cString_GetFirstStringPos(asParent, "Trigger_PressurePlate_ToStage2_") == 0)			
			{
				PressurePlate_ManageTriggersStage(6);
				PressurePlate_Event_LeonStage2("Trigger_PressurePlate_ToStage2_");
				PressurePlateGroup_In_Sequence("Trigger_PressurePlate_ToStage2_",asDoor,2,.8f,alState);
			}
			else if (cString_GetFirstStringPos(asParent, "Trigger_PressurePlate_CloseStage2_") == 0)		
			{
				PressurePlate_ManageTriggersStage(7);
				PressurePlate_Event_LeonStage2End("Trigger_PressurePlate_CloseStage2_");
				PressurePlateGroup_In_Sequence("Trigger_PressurePlate_CloseStage2_",asDoor,8,.2f,alState);
			}
			else if (cString_GetFirstStringPos(asParent, "Trigger_PressurePlate_ToStage3_") == 0)		
			{
				PressurePlate_Event_LeonStage3("Trigger_PressurePlate_ToStage3_");
				PressurePlateGroup_In_Sequence("Trigger_PressurePlate_ToStage3_",asDoor,8,.1f,alState);
			}
			
			if (asChild == "Player") PressurePlate_Event_FearBump(asParent);
		}
		
		//-------------------------------------------------------
		
		void PressurePlate_Event_FearBump(const tString &in asParent)
		{
			if (mlPortcullisScares <= 0 || Entity_GetVarBool(asParent,"FearBumps")) return;
			
			cLux_AddDebugMessage("SCARE"+asParent);

			Map_AddTimer("Timer_PortcullisFearBump",0.6f,"OnTimer_PortcullisFearBump");
			mlPortcullisScares--;
			Entity_SetVarBool(asParent,"StopEvents",true);
		}
		
		//------------------------------------------------------- 
		
		void PressurePlate_Event_EnterStage0(const tString &in asParent)
		{
			if (Entity_GetVarBool(asParent+"1","StopEvents")) return;
			
			if (ItemType_GetCountInInventory("Matchbook") > 7)
				Entity_SetActive("matchbook_16",false);
			
			Pregnancy_SetWhispering(true);
		}
		
		//------------------------------------------------------- 
		
		void PressurePlate_Event_LeonStage2(const tString &in asParent)
		{
			if (Entity_GetVarBool(asParent+"1","StopEvents")) return;
			
			Debug_Log("LEON STAGE 2");
			SetupPermaFail(eVitaeStationPermaFail_HG_LeonStalking);
			LeonStage2_Activate();
			Light_SetBrightness("Light_WayOut_Spot",1);
			SlideDoor_SetClosed("Portcullis_HG_EntranceToStage3",false,false);
			
			if (ItemType_GetCountInInventory("Matchbook") > 5)
			{
				Entity_SetActive("matchbook_12",false);
			}
		}
		
		//-------------------------------------------------------
		
		void PressurePlate_Event_LeonStage2End(const tString &in asParent)
		{
			if (Entity_GetVarBool(asParent+"1","StopEvents")) return;
			
			SlideDoor_SetClosed("Portcullis_HG_Trap2_*",true,false);
			mbLeonStage2PlayerEscaped = true;
		}
		
		//-------------------------------------------------------
		
		void PressurePlate_Event_LeonStage3(const tString &in asParent)
		{
			if (Entity_GetVarBool(asParent+"1","StopEvents")) return;
			
			LeonStage3_Hunt();
			Entity_SetActive("Trigger_HG_Trap3",false);
			SlideDoor_SetClosed("Portcullis_HG_Stage3TrapEarly_*",true);
		}
		
		//-------------------------------------------------------	
		
		//{ PRESSUREPLATE TYPES
		
		void PressurePlate_InOut_OpenClose(const tString asDoor, int alState)
		{
			if (alState == 1)	SlideDoor_SetClosed(asDoor,true);
			if (alState == -1)	SlideDoor_SetClosed(asDoor,false);
		}
		
		//-------------------------------------------------------	
		
		void PressurePlate_InOut_JumpOver(const tString asDoor, int alState)
		{				
			if (alState == 1) 
			{
				Map_RemoveTimer("Timer_PressurePortcullisDelay");
				SlideDoor_SetClosed(asDoor,true);
			}
			if (alState == -1)
			{
				Map_AddTimer("Timer_PressurePortcullisDelay",1.f,"OnTimer_PressurePortcullisDelay");
				Map_SetTimerUserVarInt("Timer_PressurePortcullisDelay",1);
				Map_SetTimerUserVarString("Timer_PressurePortcullisDelay",asDoor);
			}
		}
		
		//-------------------------------------------------------
		
		void PressurePlate_In_Close(const tString asDoor, int alState)
		{
			if (alState == 1) SlideDoor_SetClosed(asDoor,true);
		}
		
		//-------------------------------------------------------
		
		void PressurePlate_In_Sequence(const tString &in asParent, const tString asDoor, int alDoorAmount, float afDelay, int alState)
		{
			if (Entity_GetVarBool(asParent,"StopEvents")) return;
			
			if (alState == 1)
			{
				Portcullis_Sequence(asDoor,alDoorAmount,afDelay);
				Entity_SetVarBool(asParent,"StopEvents",true);
			}
		}
		
		//-------------------------------------------------------
		
		void PressurePlateGroup_In_Close(const tString &in asParent, const tString asDoor, int alState)
		{
			if (Entity_GetVarBool(asParent+"1","StopEvents")) return;
			
			if (alState == 1)
			{
				SlideDoor_SetClosed(asDoor,true);
				Entity_SetVarBool(asParent+"1","StopEvents",true);
			}
		}
		
		//-------------------------------------------------------
		
		void PressurePlateGroup_In_Sequence(const tString &in asParent, const tString asDoor, int alDoorAmount, float afDelay, int alState)
		{
			if (Entity_GetVarBool(asParent+"1","StopEvents")) return;
			if (alState == 1)
			{
				Portcullis_Sequence(asDoor,alDoorAmount,afDelay);
				Entity_SetVarBool(asParent+"1","StopEvents",true);
			}
		}
		
		//}-------------------------------------------------------
		
		//-------------------------------------------------------	
		
		void PressurePlate_Effects(const tString &in asParent, const tString &in asChild, const tString &in asPlate, int alState)
		{
			if (asPlate == "") {Error("No plate assigned to this trigger"); return;}
			
			if (alState == 1)
			{
				if (Map_TimerExists("Timer_DelayedPlateEffectsOff")) Map_RemoveTimer("Timer_DelayedPlateEffectsOff");
				
				if (asChild == "Player")
				{
					(Player_GetRunning() == true) ? Effect_Shake_Start(0.032f,0.1f,0,0) : Effect_Shake_Start(0.014f,0.1f,0,0);
					Effect_Rumble_Start(cMath_RandRectf(0.01f,0.5f),0.2f,0,0);
				}
				
				Entity_SetEffectsActive(asPlate,true,true);
				Sound_CreateAtEntity("Sound_Press","level_entity_shared/doors/tin_hinan_lock_door/TH_lock_door_slide_min_max",asPlate);	
				MovingButton_SetSwitchedOn(asPlate,true,true);
			}
			if (alState == -1)
			{
				if (cString_GetFirstStringPos(asParent, "Trigger_PressurePlate_JumpOver_") == 0)
				{
					Map_AddTimer("Timer_DelayedPlateEffectsOff",1,"OnTimer_DelayedPlateEffectsOff");
					Map_SetTimerUserVarString("Timer_DelayedPlateEffectsOff",asPlate);
					Debug_Log("EFFECTS OFF IN 1s");
				}
				else
					Entity_SetEffectsActive(asPlate,false,true);
					
				Sound_CreateAtEntity("Sound_Press","level_entity_shared/doors/tin_hinan_lock_door/TH_lock_door_slide_min_max",asPlate);
				MovingButton_SetSwitchedOn(asPlate,false,true);
			}
			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DelayedPlateEffectsOff(const tString &in asTimer)
		{
			Debug_Log("EFFECTS OFF");
			tString sPlate = Map_GetTimerUserVarString(asTimer);
			Entity_SetEffectsActive(sPlate,false,true);
		}
		
		//-------------------------------------------------------
		
		void Portcullis_Sequence(const tString &in asDoorNameRoot, int alDoorsAmount, float afDelay)
		{
			Map_AddTimer("Timer_PortcullisSequenceDelay",0.05f,"OnTimer_PortcullisSequenceDelay");
			Map_SetTimerUserVarString("Timer_PortcullisSequenceDelay",asDoorNameRoot);
			Map_SetTimerUserVarInt("Timer_PortcullisSequenceDelay",alDoorsAmount);
			Map_SetTimerUserVarFloat("Timer_PortcullisSequenceDelay",afDelay);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PortcullisSequenceDelay(const tString &in asTimer)
		{
			tString sDoors = Map_GetTimerUserVarString(asTimer);
			int lAmount = Map_GetTimerUserVarInt(asTimer);
			float fDelay = Map_GetTimerUserVarFloat(asTimer);
			
			TogglePortcullis(sDoors,lAmount,0,fDelay);
		}
		
		//-------------------------------------------------------
		
		void TogglePortcullis(tString &in asDoorsRoot, int alDoorsAmount, int alInstant, float afDelay)
		{		
			for (int i=1; i<=alDoorsAmount;i++)
			{
				Map_AddTimer("Timer_TogglePortcullis_"+i,i*afDelay-1,"OnTimer_TogglePortcullis");
				Map_SetTimerUserVarString("Timer_TogglePortcullis_"+i,asDoorsRoot+i);
				Map_SetTimerUserVarInt("Timer_TogglePortcullis_"+i, alInstant);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TogglePortcullis(const tString &in asTimer)
		{
			tString sDoor = Map_GetTimerUserVarString(asTimer);
			int lInstant = Map_GetTimerUserVarInt(asTimer);
			bool bInstant = (lInstant == 0) ? false : true;
			float fOpenAmount = SlideDoor_GetOpenAmount(sDoor);
			bool bClosed = (fOpenAmount == 1) ? true : false;
			SlideDoor_SetClosed(sDoor,bClosed,bInstant);

		}
		
		//-------------------------------------------------------	
		
		void OnTimer_PortcullisFearBump(const tString &in asTimer)
		{
			FearHandler_SetForcedAddFearRate(0.2f*mlPortcullisScares,4,true,1,0.04f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PressurePortcullisDelay(const tString &in asTimer)
		{
			tString sPortcullis = Map_GetTimerUserVarString(asTimer);
			int lState = Map_GetTimerUserVarInt(asTimer);
			
			SlideDoor_SetOpenAmount(sPortcullis,lState,false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_DisablePillarInteract(const tString &in asParent, const tString &in asChild, int alState)
		{
			bool bInteractionDisabled = (alState == 1) ? true : false;
			Entity_SetInteractionDisabled("tth_pillar_push_*",bInteractionDisabled);
			
			return true;
		}
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A - HUNTING GROUNDS (STAGE 0)
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 3, Event A here.*/
		
		tString msDummyLeon = "";
		int mlLeonStage2ForgiveTimes = 4;
		bool mbLeonStage2PlayerEscaped = false;
		bool mbLeonCanGoToStage3 = false;

		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 3, Event A here.*/
			
		bool OnCollide_Player_LeonScream(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (mlLeonStage != 0) return true;
			if (FearHandler_GetIsPermaFailing()) return true;
						
			int lIndex = cString_GetNumericSuffixInt(asParent,0);
			
			tString sLeon = "Ghoul_LeonDummy_"+lIndex;
			
			if (msDummyLeon != "") Entity_SetActive(msDummyLeon,false);
			
			if (Entity_Exists(sLeon))
			{
				// Setup invisible Leon
				FearHandler_SetForcedAddFearRate(0.1f,4,false,1,0.04f);
				
				Entity_SetActive(sLeon,true);
				Map_AddTimer("Timer_LeonDummyVisibility",0.1f,"OnTimer_LeonDummyVisibility");
				Map_SetTimerUserVarString("Timer_LeonDummyVisibility",sLeon);
				Voice_SetSource("Leon",sLeon,0,25,true);
				Voice_SetSource("Leon_Unknown",sLeon,0,25,true);
				Voice_Play("Leon_BeforeTrap");
				
				FearThreatAgent_SetComponentEnabled(sLeon,false);
				FearThreatAgent_SetComponentFearActive(sLeon,false);
				FearThreatAgent_SetSurpriseFactor(sLeon,0);
				cLux_GetCurrentMap().GetEntityByName(sLeon).GetMeshEntity().SetVisible(false);
				
				Agent_SetDistanceCallback(sLeon,"OnRange_RemoveDummyLeon",4);
				Ghoul_CommandPatrol_AddNode(sLeon,"PathNode_LeonDummy"+lIndex);
				Ghoul_CommandPatrol_Execute(sLeon,true,1,false,eGhoulSpeed_FastWalk,"OnEndOfTrack_DummyGate");
				Sound_CreateAtEntity("Sound_DummyGate","03_05_vitae_station/maze/spiked_door_open",sLeon);
				Sound_CreateAtEntity("Sound_LeonHuntSweet_3D","level_amb_shared/amb/sweeteners/03_05_vitae_station/leon_hunting_grounds_sweet_3D",sLeon);	
				msDummyLeon = sLeon;
				
				if (lIndex == 1)
					Map_AddTimer("Timer_ShowHideModeHint", 4.f, "OnTimer_ShowHideModeHint");
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowHideModeHint(const tString &in asTimer)
		{
			// Only show if player hasn't used hide mode since the cistern
			if (cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal && 
				cScript_GetGlobalVarInt("HideMode_LastLevelUsedIn") <= 25)
			{
				Hint_RemoveFromGiven("Hints", "HintHideMode");
				Hint_ShowHint("Hints", "HintHideMode", true);
			}
		}
		
		//-------------------------------------------------------
		
		void OnRange_RemoveDummyLeon(int alState)
		{
			if (alState != 1) return;

			Sound_CreateAtEntity("Sound_DummyGate","03_05_vitae_station/gate/gate_close",msDummyLeon,0,false,50);
			cLux_GetCurrentMap().GetWorld().GetSoundEntity("Sound_DummyGate").SetCustomMaxDistance(80);
			cLux_GetCurrentMap().GetWorld().GetSoundEntity("Sound_DummyGate").SetCustomMaxDistance(100);
			Sound_Stop("Sound_LeonHuntSweet_3D",0.2f);
			Entity_SetActive(msDummyLeon,false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonDummyVisibility(const tString &in asTimer)
		{
			tString sLeon = Map_GetTimerUserVarString(asTimer);
			Ghoul_SetVisibile(sLeon,false);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_DummyGate(const tString &in asEntity)
		{
			Sound_CreateAtEntity("Sound_DummyGate","03_05_vitae_station/gate/gate_close",asEntity,0,false,50);
			cLux_GetCurrentMap().GetWorld().GetSoundEntity("Sound_DummyGate").SetCustomMaxDistance(80);
			cLux_GetCurrentMap().GetWorld().GetSoundEntity("Sound_DummyGate").SetCustomMaxDistance(100);
			Sound_Stop("Sound_LeonHuntSweet_3D",0.2f);
			Entity_SetActive(asEntity,false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_Stage0Trap(const tString &in asParent, const tString &in asChild, int alState)
		{
			Lamp_SetLit("dwf_torch_01_1",false,true);
			Lamp_SetLit("dwf_torch_01_5",false,true);
			Light_FadeBrightnessTo("Light_Box_45",1,2);
			
			Entity_SetActive("Ghoul_LeonDummy_*",false);
			Entity_SetActive("Trigger_HG_LeonStage0_Activate", true);
			Entity_SetActive("Block_Player_*",true);
			SlideDoor_SetClosed("Portcullis_HG_LeonGates_*",true);
			TogglePortcullis("Portcullis_HG_Trap2_",14,0,.3f);
			TogglePortcullis("Portcullis_HG_Trap_",14,0,.3f);

			tString sNodes = (asParent == "Trigger_HG_Trap") ? "PathNode_LeonHGTrap_" : "PathNode_LeonHGTrap2_";
			tString sCutsceneSpot = (asParent == "Trigger_HG_Trap") ? "PosArea_TrapPoint1" : "PosArea_TrapPoint2";
			tString sSafetyGate = (asParent == "Trigger_HG_Trap") ? "Portcullis_HG_Trap2_14" : "Portcullis_HG_Trap_14";
			Entity_SetVarString("Trigger_HG_LeonStage0_Activate","NodesName",sNodes);
			Entity_SetVarString("Trigger_HG_LeonStage0_Activate","CutsceneSpot",sCutsceneSpot);
			
			Map_AddTimer("Timer_LeonStage0_Activate",6,"OnTimer_LeonStage0_Activate");
			
			Entity_SetActive(sSafetyGate,true);
			Entity_SetActive("Trigger_HG_Trap*",false);
			Light_SetFlickerActive("Light_HG_Trap_Point",false);
			Light_SetBrightnessIncrease("Light_HG_Trap_Point",800,-0.01f,0.005f);
			
			SetupPermaFail(eVitaeStationPermaFail_HG_LeonPassive);
			FearHandler_SetPermaFailEnabled(false);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_LeonStage0_Activate(const tString &in asParent, const tString &in asChild, int alState)
		{
			LeonStage0_Activate();
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage0_Activate(const tString &in asTimer)
		{
			if (Entity_IsActive("Ghoul_LeonStage0")) return;
			
			LeonStage0_Activate();
			Entity_SetActive("Trigger_HG_LeonStage0_Activate", false);
		}
		
		//-------------------------------------------------------
		
		void LeonStage0_Activate()
		{
			msLeon = "Ghoul_LeonStage0";
			tString sNodes = Entity_GetVarString("Trigger_HG_LeonStage0_Activate","NodesName");
			tString sCutsceneSpot = Entity_GetVarString("Trigger_HG_LeonStage0_Activate","CutsceneSpot");
			Entity_SetVarString(msLeon,"CutsceneSpot",sCutsceneSpot);
			Ghoul_Mode_Set(msLeon,eGhoulMode_Idle,true);
			Entity_SetActive(msLeon,true);
			Voice_SetSource("Leon",msLeon,0,25,true);
			Voice_SetSource("Leon_Unknown",msLeon,0,25,true);
			//Ghoul_SetAllowPlayerThrow(msLeon,true,true);
			Voice_Play("Leon_BeforeTrap");
			FearThreatAgent_SetBaseFearRateMul(msLeon,0.5f);
			Agent_SetSensesActive(msLeon,false);
			Agent_SetDistanceCallback(msLeon,"OnRange_LeonStage0_ActivateSenses",5);
			Sound_Stop("Sound_LeonHuntSweet_3D", 3.0f);
			Music_Stop(5.0f, eMusicPrio_SceneAmb);
			Music_Play("leon_find_01.ogg", 0.0f, true, eMusicPrio_OverrideAll);
			for (int i = 1; i<=9; i++)
			{
				Ghoul_CommandPatrol_AddNode(msLeon, sNodes+i);
			}
			Ghoul_CommandPatrol_Execute(msLeon,true,1,false,eGhoulSpeed_Run,"LeonStage0_StartThreaten");
			
			Ghoul_SetCanAttack(msLeon, false);
			
			Map_AddTimer("Timer_CheckLeonDistance", 1, "OnTimer_CheckLeonDistance");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckLeonDistance(const tString &in asTimer)
		{
			float fDist = Player_GetDistanceToEntity(msLeon);
			if (fDist <= 3)
			{
				Leon_CatchTasi();
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.1, 0.3));
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Stinger(const tString &in asEntity, int alState)
		{
			Sound_CreateAtEntity("Sound_SeeLeon", "03_06_ghouls_nest/stingers/ghoul_drop_stinger", "player");
		}
		
		//-------------------------------------------------------
		
		void LeonStage0_StartThreaten(const tString &in asEntity)
		{
			CharMover_PlayAnimation(msLeon, "angry_2", 0.5f, false);
			Sound_CreateAtEntity("Sound_GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_spot", asEntity);
			Map_AddTimer("Timer_LeonStage0_Threaten",1,"OnTimer_LeonStage0_Threaten");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonStage0_Threaten(const tString &in asTimer)
		{
			Ghoul_Command_Remove(msLeon,true);
			Agent_SetSensesActive(msLeon,true);
			Ghoul_CommandThreatenPlayer_Execute(msLeon,6,false,false,-1,-1,true);
			Sound_CreateAtEntity("Sound_SeeLeon", "03_06_ghouls_nest/stingers/ghoul_drop_stinger", "player");
		}
		
		//-------------------------------------------------------
		
		void Leon_CatchTasi()
		{
			FearHandler_SetPermaFailEnabled(false);
		
			Ghoul_CancelPlayerThrow(msLeon,true);
			Ghoul_Command_Remove(msLeon,true);
			Ghoul_Mode_Set(msLeon,eGhoulMode_Idle,true);
			Agent_SetSensesActive(msLeon,false);
			
			PlayerBody_StopCustomAnimation();
			PlayerBody_StopAnimationLayer(ePlayerBodyAnimationLayer_FullBody,0);
			
			
			cVector3f vLeonPos = Map_GetEntity(msLeon).GetMeshEntity().GetSocket("j_Collider_Start_Space_Socket_1").GetWorldPosition();
			Map_GetEntity("PosArea_AttackPos").SetPosition(vLeonPos);
			
			Agent_PlayCutsceneAtEntity(msLeon,"leon_knocks_player_down_initial_attack","PosArea_AttackPos",0.3f,false,"");
			PlayerBody_PlayCutsceneAtEntity("player_knocked_down_by_leon_initial_attack","PosArea_AttackPos",false,0.1f,"OnEndOfAnim_AttackBeforeRecognize");
			
			PlayerBody_FadeCutsceneMaxPitch(5,0.5f);
			PlayerBody_FadeCutsceneMaxYaw(5,0.5f);
			
			Agent_SetSensesActive(msLeon,false);
			Voice_StopAll();
			
			Sound_CreateAtEntity("Sound_LeonGrab", "03_05_vitae_station/maze/player_grab_drop", "player");
			Sound_CreateAtEntity("Sound_PreTrapTasi","game_voice/voice/leon_leon_thetrap_start_001_player_001","player", 0.0f, false, 1.0f);
			Sound_CreateAtEntity("Sound_PreTrapLeon","game_voice/voice/leon_leon_thetrap_start_002_leon_001",msLeon,  0.0f, false, 1.0f);
			
			/*Entity_SetActive(msLeon,false);
				
			msLeon = "Ghoul_LeonStage0Cutscene";
			FearThreatAgent_SetComponentEnabled(msLeon,false);
			
			
			Entity_SetActive(msLeon,true);
			Agent_SetSensesActive(msLeon,false);
			cLux_ToAgent(Map_GetEntity(msLeon)).GetCharBody().SetTestCollision(false);
			Debug_Log(sCutsceneSpot);
			Agent_TeleportFeetToEntity(msLeon,"PosArea_TrapPoint3");
			CharMover_PlayAnimation(msLeon, "leon_attacks_player_but_then_recognizes_her", 0.0f, false, true, "OnEndOfAnim_DeactivateLeonStage0");
			PlayerBody_PlayCutsceneAtEntity("player_attacked_by_leon_who_eventually_recognizes_her","PosArea_TrapPoint3",false,0.0f,"",1,0,0,0);*/		
		}
		
		void OnEndOfAnim_AttackBeforeRecognize(const tString &in asAnim)
		{
			Seq_LeonGoesCrazy("");
		}
		
		void OnEndOfAnim_DeactivateLeonStage0(const tString &in asAnim)
		{
			PlayerBody_ResetCutscenePitchYawLimits();
			Entity_SetActive(msLeon,false);
		}
		
		
		
		//-------------------------------------------------------
		
		void OnRange_LeonStage0_ActivateSenses(int alState)
		{
			if (alState != 1) return;

			Ghoul_Command_Remove(msLeon,true);
			Agent_SetSensesActive(msLeon,true);
			Ghoul_Mode_Set(msLeon,eGhoulMode_Hunt,true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_LeonStage0_ActivateSenses(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (msLeon != "Ghoul_LeonStage0") return true;

			Ghoul_Command_Remove(msLeon);
			Agent_SetSensesActive(msLeon,true);
			return false;
		}
		
		//-------------------------------------------------------
		
		float mfFearBeforeTrapSequence;
		int idDoFEffect = -1;
			
		cSequenceStatesData mSequenceLeonGoesCrazy;
		void Seq_LeonGoesCrazy(const tString &in asTimer)
		{
			Sequence_Begin("Seq_LeonGoesCrazy", mSequenceLeonGoesCrazy);
			if (Sequence_DoStepAndWait(.1f))
			{
				tString sCutsceneSpot = Entity_GetVarString(msLeon,"CutsceneSpot");
				Entity_SetVarString("Ghoul_LeonStage0Cutscene","CutsceneSpot",sCutsceneSpot);
				
				Entity_SetActive("Trigger_HG_LeonStage0_Activate",false);
				Entity_SetActive(msLeon,false);
				
				msLeon = "Ghoul_LeonStage0Cutscene";
						
				Entity_SetActive(msLeon,true);
				FearThreatAgent_SetComponentEnabled(msLeon,false);
				Agent_SetSensesActive(msLeon,false);
				cLux_ToAgent(Map_GetEntity(msLeon)).GetCharBody().SetTestCollision(false);
				Debug_Log(sCutsceneSpot);
				Agent_TeleportFeetToEntity(msLeon,"PosArea_TrapPoint3");
				CharMover_PlayAnimation(msLeon, "leon_attacks_player_but_then_recognizes_her", 0.3f, false, true, "OnEndOfAnim_DeactivateLeonStage0");
				PlayerBody_PlayCutsceneAtEntity("player_attacked_by_leon_who_eventually_recognizes_her","PosArea_TrapPoint3",false,0.3f,"",1,0,0,0);
				
				Voice_StopAll();
				Voice_SetSource("Leon",msLeon,1,30,true);
				Voice_SetSource("Leon_Unknown",msLeon,1,30,true);
				Voice_Play("Leon_TheTrap");
				
				Music_Play("A2_3_5_Leon_Recognize.ogg", 0.4f, false, eMusicPrio_OverrideAll);
				
				Entity_AttachToSocket("PosArea_LeonCutsceneVoice", msLeon, "socket_eye_right", true, true);
				Sound_CreateAtEntity("Sound_TrapTasi","game_voice/voice/03_05_vitae_station_leon_trap_TASI_001","player", 0.0f, true, 1.0f);
				Sound_CreateAtEntity("Sound_TrapLeon","game_voice/voice/03_05_vitae_station_leon_trap_LEON_001","PosArea_LeonCutsceneVoice",  0.0f, true, 1.f);
				
				//Light_SetBrightness("spotlight_cinematic_leontrap_*", 3);				
			}
			else if (Sequence_DoStepAndWait(.9f))
			{
				Effect_Fade_In(0.3f);
				Light_FadeBrightnessTo("light_spot_trap",0.7,3);
			}
			else if (Sequence_DoStepAndWait(14.0f))
			{		
				Player_SetLookSpeedMul(0.5);
			}
			else if (Sequence_DoStepAndWait(.4f))
			{
				// Blink 2
				Effect_Fade_Out(0.1f);
				Light_SetBrightness("spotlight_cinematic_leontrap_*", 0);
			}
			else if (Sequence_DoStepAndWait(.2f))
			{
				Effect_Fade_In(0.7f);
			}
			else if (Sequence_DoStepAndWait(.8f))
			{
				SlideDoor_SetClosed("Portcullis_HG_LeonCrazy_*",true);
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				// Blink 2
				//Effect_Fade_Out(0.1f);
			}
			else if (Sequence_DoStepAndWait(2.6f))
			{
				//Turn off lights in hunting grounds
						
				TogglePortcullis("Portcullis_HG_AfterTrap_",3,0,1);
				SlideDoor_SetClosed("Portcullis_HG_Trap_1",true,false);
				SlideDoor_SetClosed("Portcullis_HG_Trap2_1",true,false);
				Player_StopLookAt(1);
			}
			else if (Sequence_DoStepAndWait(0.6f))
			{
				Player_SetMoveSpeedMul(1);
				Player_SetLookSpeedMul(1);
				Player_SetCanUseLightSource(true);
				//Death_Respawn();
				Music_StopAll(0.0f);
				Music_Play("A2_3_5_Hunting_Ground_Maze.ogg", 0.09, true, eMusicPrio_SceneAmb);
				Voice_PlayDelayed("Dialogue_TasiReleasedByLeon",15);
				//Player_Teleport("Start_HG_Leon2");
				//PlayerBody_PlayCutsceneAnimation("wake_up_from_death_1a",false,0.3f);
				
				Light_SetBrightness("Light_HG_Trap_Point",0);
				Player_SetForceCrawling(false);
				Player_SetMoveSpeedMul(1);
				Player_SetLookSpeedMul(1);
				Map_AddTimer("Timer_ResetFearLevel",0.1f,"OnTimer_ResetFearLevel");
			}
			else if (Sequence_DoStepAndWait(0.3))
			{
				Effect_Fade_In(0.7f);
				Effect_DoF_FadeOut(idDoFEffect,5);
			}
			else if (Sequence_DoStepAndWait(3))
			{
				SlideDoor_SetClosed("Portcullis_HG_358",false);
				Light_FadeBrightnessTo("light_spot_trap",0,4);
				
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Entity_SetActive(msLeon,false);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetFearLevel(const tString &in asTimer)
		{
			FearHandler_FadeLevelTo(mfFearBeforeTrapSequence,3.0f,true);
		}
		
		//} END SCENE A
		
