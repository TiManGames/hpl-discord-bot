		void OnTimer_LeonPool_ArmSwap(const tString &in asTimer)
		{
			
			Debug_Log("------------------------------------------------------------ CUT");
			Map_GetEntity("Ghoul_LeonPool_Escape_OneArmed").GetMeshEntity().SetVisible(true);
			Map_GetEntity("Ghoul_LeonPool_Escape_Arm").GetMeshEntity().SetVisible(true);
			Map_AddTimer("Timer_HideArmedLeon", 0.05f, "OnTimer_HideArmedLeon");
			
