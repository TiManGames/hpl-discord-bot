			Item_PutAway(eItemHandlerHand_Right);
			Agent_SetSensesActive(asSource,false);
			Ghoul_Mode_Set(asSource,eGhoulMode_Idle,true);
			Death_PickRespawnArea("Death_HG_KilledAtStage3");
			Effect_Fade_Out(0.4f);
			Map_AddTimer("Timer_DelayedRespawn",2,"OnTimer_DelayedRespawn");
			SwingDoor_SetClosed("Portcullis_HG_Stage3Trap_2",true,false);
		}
		
