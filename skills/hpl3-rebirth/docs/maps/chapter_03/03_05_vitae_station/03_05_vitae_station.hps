		//-------------------------------------------------------
		
		bool mbUnlockedGates = false;
		int mlLeverCount = 0;
		int mlInitialLeverState = 0;
		
		void OnStateChange_UnlockGates(const tString &in asEntity, int alState)
		{		
			if (alState == 0) return;
			
			mlLeverCount++;
			
			if (mlLeverCount == 1) return;
			
			if (mlInitialLeverState == 0) mlInitialLeverState = alState;
			
			bool bGatesState = (alState == mlInitialLeverState) ? false : true;
			
			SlideDoor_SetClosed("MachineRoomGate_1", bGatesState);
			//SlideDoor_SetClosed("MachineRoomGate_2", bGatesState);
			if (!mbUnlockedGates)
			{
				Entity_SetInteractLookAtEntity(asEntity,"");
				mbUnlockedGates = true;
				Entity_SetActive("Trigger_MilkingBabyMoment",true);
			}
		}
		 	 
