		void OnEndOfVoice_EnableFairchildLookAt(const tString &in asScene, const tString &in asSubject)
		{
			Entity_SetActive("Trigger_KilledFairchild",true);
		}
		
		
		//-------------------------------------------------------
		
		void VitaePipe_PushVitaeSequence()
		{
			int lPipeParts = 6;

			for (int i = 1; i <= lPipeParts; i++)
			{
				tString sTimer = "Timer_PushVitaeSeq_"+i;
				Map_AddTimer(sTimer, 0.5f*i, "OnTimer_PushVitaeSequence");
				Map_SetTimerUserVarInt(sTimer, i);
			}
		}
		
		//-------------------------------------------------------	
		
		void OnTimer_PushVitaeSequence(const tString &in asTimer)
		{
			int lPipePart = Map_GetTimerUserVarInt(asTimer);
			Lamp_SetLit("VitaePipe_"+lPipePart, true, true);
			if (lPipePart == 6)
			{
				Lamp_SetLit("Lamp_VitaeCanisterPipe_1",true,true);
				Lamp_SetLit("Lamp_VitaeCanisterPipe_2",true,true);
				
				//Entity_SetActive("VitaeCanister", true);
				//Prop_SetActiveAndFade("VitaeCanister",true,5);
				//Entity_PlayAnimation("VitaeCanister", "idle", 0.1f, false, false);
				
				SlideDoor_SetClosed("MachineRoomGate_1",true);
				SlideDoor_SetClosed("MachineRoomGate_2",true);
				
				Sound_CreateAtEntity("Sound_VitaeFlask", "03_05_vitae_station/vitae_canister/vitae_flow/vitae_flask", "VitaeCanister");
			}
			Debug_Log("PIPE FILLED: "+"VitaePipe_"+lPipePart);
		}
		
