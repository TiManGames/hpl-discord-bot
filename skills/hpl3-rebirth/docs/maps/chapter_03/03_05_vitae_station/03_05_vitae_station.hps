	eVitaeStationPermaFail_None,
	eVitaeStationPermaFail_PreHG,
	eVitaeStationPermaFail_HG_BeforeLeonAttack,
	eVitaeStationPermaFail_HG_LeonPassive,
	eVitaeStationPermaFail_HG_LeonStalking,
