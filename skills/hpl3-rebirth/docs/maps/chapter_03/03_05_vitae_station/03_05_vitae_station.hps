	// TEST KEYS. To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{	
			Effect_Rumble_Start(0.11f,3,0,0); return;
			//mlLeonStage = 0;
			//Player_Teleport("Start_HG_Begin");
			Seq_FairchildAttack("");
			//Voice_StopAll();
			//MilkingComplete();
			//Map_AddTimer("Timer_StruggleMilkingMachine",0,"OnTimer_StruggleMilkingMachine");
		}
		if (alAction == eAction_Test2)
		{		
			Debug_Log("TEST");
			//Effect_Rumble_Start(0.2f,3,0,0); return;
			mlLeonStage = 0;
			Player_Teleport("Start_HG_Leon1");
			SetupPermaFail(eVitaeStationPermaFail_HG_LeonPassive);
		}
		if (alAction == eAction_Test3)
		{
			//Effect_Rumble_Start(3.f,3,0,0); return;
			mlLeonStage = 0;
			Light_SetBrightness("Light_HG_Trap_Point",0);
			Player_Teleport("Start_HG_Leon2");
			TogglePortcullis("Portcullis_HG_Trap_",14,1,0);
			TogglePortcullis("Portcullis_HG_Trap2_",14,1,0); 
			TogglePortcullis("Portcullis_HG_AfterTrap_",3,1,0);
			SlideDoor_SetClosed("Portcullis_HG_AfterTrap_1",true,true);
			SetupPermaFail(eVitaeStationPermaFail_HG_LeonPassive);
			LeonStage1_Activate();
		}
		if (alAction == eAction_Test4)
		{
//			Ghoul_CommandGoToHole_Execute("ghoul_1", Map_GetEntity("GhoulHole_Cell1_1").GetPosition(), true, false, true);
//			cLux_AddDebugMessage("O");
//			return;
			mlLeonStage = 1;
			Light_SetBrightness("Light_HG_Trap_Point",0);
			Player_Teleport("Start_HG_Leon3");
			//TogglePortcullis("Portcullis_HG_Trap_",10,1,0);
			//TogglePortcullis("Portcullis_HG_AfterTrap_",3,1,0);
			LeonStage2_Activate();
			PressurePlate_ManageTriggersStage(4);
			SetupPermaFail(eVitaeStationPermaFail_HG_LeonStalking);
		}
		if (alAction == eAction_Test5)
		{
			mlLeonStage = 2;
			Light_SetBrightness("Light_HG_Trap_Point",0);
			Player_Teleport("Start_HG_Leon4");
			TogglePortcullis("Portcullis_HG_Trap_",14,1,0);
