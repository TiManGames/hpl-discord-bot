		//-------------------------------------------------------------
		
		void PoolOfBodies_PlayerEscape()
		{
			mbEscapedPool = true;
			mbLeonPoolEncounter = false;
			
			Pregnancy_SetWhispering(false);
			Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_AfterPool");
			
			Map_RemoveTimer("Timer_LeonPoolTalk");
			Map_RemoveTimer("Engine_1");
			Map_RemoveTimer("Engine_2");
			Map_RemoveTimer("Timer_MachineUnstuck");
			
			Entity_SetActive(msLeonPool,false); // "" because we removed him from encounter
			Entity_SetActive("Trigger_CrusherDamage",false);
			Entity_SetActive("Trigger_WaterArea",false);
			Entity_SetActive("Ghoul_LeonPool_Escape",true);
			Entity_SetActive("Ghoul_LeonPool_Escape_OneArmed",true);
			Entity_SetActive("Ghoul_LeonPool_Escape_Arm",true);
			Entity_AttachToSocket("Area_LeonVoice", "Ghoul_LeonPool_Escape", "HeadSocket", true, true);
			Map_GetEntity("Ghoul_LeonPool_Escape_OneArmed").GetMeshEntity().SetVisible(false);			
			Map_GetEntity("Ghoul_LeonPool_Escape_Arm").GetMeshEntity().SetVisible(false);

			Voice_StopAll();
			Voice_SetSource("Leon","Ghoul_LeonPool_Escape",5,120,true);
			Voice_Play("Dialogue_Pool_ArmCut_Short");	// Just for subtitles
			Map_AddTimer("Timer_LeonPool_Dialogue",3,"OnTimer_LeonPool_Dialogue");
			
			Music_Play("A2_3_5_Pool_Escape.ogg", 0.2f, false, eMusicPrio_BigEvent);
			
			Map_AddTimer("Timer_LeonPool_ArmSwap",13,"OnTimer_LeonPool_ArmSwap");
			Map_AddTimer("Timer_PoolEscapeEnd",29.f,"OnTimer_PoolEscapeEnd");
			Map_AddTimer("TimerMusic",3,"OnTimer_EscapeMusic");
			Map_AddTimer("Timer_LeonSplash",0.6f,"OnTimer_LeonSplash");
			
			PlayerBody_PlayCutsceneAtEntity("player_grabbed_by_leon_under_bodycrusher","PosArea_Machine",false,0.3f);
			Entity_PlayAnimation("Ghoul_LeonPool_Escape","leon_grabbing_player_under_bodycrusher",0,false);
			Entity_PlayAnimation("Ghoul_LeonPool_Escape_OneArmed","leon_grabbing_player_under_bodycrusher",0,false);
			Entity_PlayAnimation("Ghoul_LeonPool_Escape_Arm","leon_severed_arm_torn_off",0,false);
			Entity_PlayAnimation("Machine","bodycrusher_over_leon_and_player",0,false);
			Light_FadeBrightnessTo("light_cutscene_leon_2", 0.7f, 1);
			Light_FadeBrightnessTo("light_cutscene_leon_1", 1.5f, 1);
		}
		
