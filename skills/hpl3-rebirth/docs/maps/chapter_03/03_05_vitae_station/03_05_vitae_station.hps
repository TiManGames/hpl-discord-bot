		{
			Voice_Play("Leon_AfterTrap_NearlyEscaped");
			Ghoul_Command_Remove(msLeon,true);
			Ghoul_CommandThreatenPlayer_Execute(msLeon,3,true,false,-1,-1,true);
		}
		
		//----------------------------------------------------------
		
		void OnTimer_LeonStage3_StartHunt(const tString &in asTimer)
		{
			Agent_SetSensesActive(msLeon,true);
			Ghoul_Mode_Set(msLeon,eGhoulMode_Hunt,true);
			Ghoul_SetAdjustHuntSpeed(msLeon,true,0.6f);
