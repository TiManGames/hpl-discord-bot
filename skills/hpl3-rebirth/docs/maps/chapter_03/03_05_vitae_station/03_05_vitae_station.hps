	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("03-05-vitae-station");
		
		// post processing
        Effect_Bloom_FadeBrightPass(0.3f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(1.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		// pregnancy setup
		Pregnancy_SetStage(ePregStage_Stage2);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_TTH_AfterName);
		GhoulProgression_SetBarkMinimumStage(eGhoulBarkStage_BecomingMonster);
		Player_SetAllowCheckBaby(true);
		Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_Initial");
		
		if (cScript_GetGlobalVarBool("TTH_Milked"))
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_MilkingToDWFA);
		}
		else
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_VitaeStationToMilking);
		}
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(1);
		StruggleFlashHandler_SetProgression(1);
		
		Player_SetAutoTeleportWhenBelowAltitude(-30.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("dust_impact_simple_oneshot.ps");
		ParticleSystem_Preload("ps_impact_water_med.ps");
		ParticleSystem_Preload("wooden_brace_damage.ps");
		ParticleSystem_Preload("splash_small_broad_oneshot.ps");
		ParticleSystem_Preload("sand_falling_stream_small_oneshot.ps");
		ParticleSystem_Preload("sparks.ps");
		ParticleSystem_Preload("ps_impact_water_high.ps");
		
		Sound_PreloadEvent("level_entity_shared/fire/fire_ignite/wall_torch_ignite");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
	}
	
