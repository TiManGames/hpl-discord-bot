		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A - PLAYER WAKES UP IN THE TORTURE CHAMBER AND SEES WHAT THEY HAVE DONE
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event A here.*/
		
		float mfBeforeMilkingFearLevel;

		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 5, Event A here.*/
		
		void OnTimer_StruggleMilkingMachine(const tString &in asTimer)
		{
			Player_SetLookSpeedMul(1);
			Debug_Log("FADE IN - MILKING START");
			Pregnancy_SetBabyKicksEnabled(false);
			mbFairchildAttacked = true;
			Player_Teleport("Start_MilkingRoom_Abstract", true);
			//Effect_Fade_In(0.3f);
			Struggle_StartMoveTowards("TriggerArea_Milking", "TriggerArea_Milking", "", "", "", 7, false, 3.0f, -1.0f, 1.0f, false, 1.5f);
			Player_StartLookAt("TriggerArea_Milking",1,1,1);
			FogArea_SetVisible("FogArea_MilkingMachine_*",true);
			Entity_SetEffectsActive("brazier_2", false, false);
			Entity_SetEffectsActive("brazier_3", false, false);
			GhoulProgression_Increase(true, true, false);
			GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetProgression(), 0.1f);
			Sound_CreateAtEntity("Sound_PlayerVitaeOpen", "03_05_vitae_station/milking_machine/player_vitae_machine_open", "player");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_KilledFairchild(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			
			Seq_KilledFairchild("");
		}

		//-------------------------------------------------------
		 
		cSequenceStatesData mSequenceKilledFairchild;
		void Seq_KilledFairchild(const tString &in asTimer)
		{
			Sequence_Begin("Seq_KilledFairchild", mSequenceKilledFairchild);
			if (Sequence_DoStepAndWait(3))
			{
				Voice_Play("KilledFairchild");
				Music_Play("A2_3_5_Harvest_Wake.ogg", 0.4f, false, eMusicPrio_MinorEvent);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				// Wait for hands to disappear
				Player_ChangeStateToNormal();
			}
			Sequence_End();
		}
	 
		//-------------------------------------------------------

		//} END Event A

