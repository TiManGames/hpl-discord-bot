			FearHandler_SetForcedAddFearRate(0.6f, 4.f, true, -1.f, 0.05f, 0.3f);
			//Entity_SetActive("NastyChestPart_*", true);
			Prop_SetStaticPhysics("hidden_gib_*", false);
