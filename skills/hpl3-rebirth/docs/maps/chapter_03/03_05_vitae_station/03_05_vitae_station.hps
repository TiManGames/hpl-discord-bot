		{	
			int lArea = cMath_RandRectl(1,mlPoolHoles);
			ParticleSystem_CreateAtEntity("PS_Dust_"+lArea,"sand_falling_stream_small_oneshot.ps","PosArea_PoolHole_"+lArea,false);
			Sound_CreateAtEntity("Sound_LeonMove", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", "PosArea_PoolHole_"+lArea);
			
			float fLeonSpawnTimeLeft = Map_GetTimerTime("Timer_LeonPoolMoveAround");
			if (fLeonSpawnTimeLeft/2 > 6)
			{
