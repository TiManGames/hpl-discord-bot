		{	
			Entity_SetActive(asTimer, false);
		}
		
		//-------------------------------------------------------
		
		void OnStateChange_CagesLever(const tString &in asEntity, int alState)
		{
			if (alState == 0) return;
			
			if (alState == -1) // UP
			{
				Lever_SetStuckState(asEntity,-1,true);
				Lever_SetInteractionDisablesStuck(asEntity,true);
			}
			if (alState == 1) // DOWN
			{
				Lever_SetStuckState(asEntity,1,true);
				Lever_SetInteractionDisablesStuck(asEntity,false);
				Map_AddTimer(asEntity,0.3f,"OnTimer_LeverSnap");
				
				mlPoolLeverInteractions++;
				Debug_Log("LEVER: "+asEntity+" STATE: "+alState);
				Debug_Log("INTER: "+mlPoolLeverInteractions);
				
				if (mlPoolLeverInteractions == 1) return; //Skip first automatic trigger
				if (mlPoolLeverInteractions == 2)
				{
					Prop_MoveLinearTo("Cage_2_Root","Rail_1",2,1,0.2f,true,"");
					mbCrushCageSlide = true;
				}
				
				for (int i = 1; i <= mlCages; i++)
				{						
					Map_AddTimer("Cage_"+i,0.2f,"OnTimer_ChangeCagePosition");
					Entity_AddImpulse("Cage_"+i,cVector3f(0.2f,0,0),true,true);
					Sound_CreateAtEntity("Sound_CagesMove","03_05_vitae_station/cages/raise_lower","Cage_"+i);
					
				}

				Entity_SetInteractionDisabled("Lever_Cage_*",true);
				
				Map_AddTimer(asEntity,1,"OnTimer_LeverUnstuck");
				
				if (!mbCageDetached && mlPoolLeverInteractions >= 2 && mbLeonPoolEncounter)
					Cage_DetachFromRope();
				
			}
			
			if (Sound_Exists("Sound_CagesMove")) Sound_Stop("Sound_CagesMove",1.0f);
			//Sound_CreateAtEntity("Sound_CagesMove","03_05_vitae_station/cages/raise_lower",asEntity);
			Map_AddTimer("Timer_CagesStopMoveSound",2.5f,"OnTimer_CagesStopMoveSound");
				
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CagesStopMoveSound(const tString &in asTimer)
		{
			Sound_Stop("Sound_CagesMove",1);
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_LeverSnap(const tString &in asTimer)
		{
			tString sOtherLever = (asTimer == "Lever_Test_1") ? "Lever_Test_2" : "Lever_Test_1";
			Lever_SetInteractionDisablesStuck(sOtherLever,true);
			Lever_SetStuckState(sOtherLever,0,true);
			//Sound_CreateAtEntity("Sound_UnstuckLever_"+asTimer,"03_04_pillar_room/config_device/config_ring_position_lock","player");
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_LeverUnstuck(const tString &in asTimer)
		{
			Entity_SetInteractionDisabled("Lever_Cage_*",false);
		}
			
		//-------------------------------------------------------
		
		void OnTimer_ChangeCagePosition(const tString &in asTimer)
		{
			cLux_AddDebugMessage("QAAAAAAAAAAAAAAAAAAAAAA");
			Cage_ChangePosition(asTimer);
		}
		
		//-------------------------------------------------------
		
		void Cage_DetachFromRope()
		{
			//cLux_GetCurrentMap().GetEntityByName("Cage_6").GetMainBody().SetMass(mfCageSubmergedMass);
			Entity_AddImpulse("Cage_6",cVector3f(0.5f,0,0),true,true);
			Map_AddTimer("Timer_CageFalls",3.5f,"OnTimer_CageFalls");
			mbCageDetached = true;
			mlCages = 5;
		}
		
		//-------------------------------------------------------
		
		void Cage_ChangePosition(const tString &in asName)
		{
			if (Entity_IsActive(asName) == false) return;
			
			int lState = Entity_GetVarInt(asName,"");
			bool bCorpse = Entity_GetVarBool(asName,"bCorpse");
			int lX = cString_GetNumericSuffixInt(asName,0);
			
			float fCorpseMul = (bCorpse) ? 1.2f : 1;
			
			if (lState == 0) // GO UP
			{
				float fLength;

				if (lX == 2)
					fLength = (mbCrushCageSlide == true) ? 1.7f : 2.6f;	// Shorter if Cage2 is in position
				else if (lX == 6)
				{
					fLength = 1;
				}
				else fLength = 2.6f;
				
				Rope_StretchToLength("CageRope_"+lX,fLength,0.6f);
				cLux_GetCurrentMap().GetEntityByName(asName).GetMainBody().SetMass(mfCageMass*fCorpseMul);
				Push_SetThrowImpulse(asName,2);
				lState = 1;
			}
			else // GO DOWN
			{
				float fLength;

				if (lX == 2)
					fLength = (mbCrushCageSlide == true) ? 3.f : 3.5f;	// Shorter if Cage2 is in position 
				else fLength = 4.f;
				
				Rope_StretchToLength("CageRope_"+lX,fLength,3.f);

				cLux_GetCurrentMap().GetEntityByName(asName).GetMainBody().SetMass(mfCageSubmergedMass*fCorpseMul*mfCurrentMul);
				Push_SetThrowImpulse(asName,0.3f);
				lState = 0;
			}
			Entity_SetVarInt(asName,"",lState);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CageFalls(const tString &in asTimer)
		{
			Debug_Log("FALL");
			Rail_Collapse("RailBroken_2");
			Sound_CreateAtEntity("Sound_Snap1","03_05_vitae_station/cages/break","Cage_6");
			Rope_Detach("CageRope_6","Cage_6");
			Entity_SetActive("Trigger_GhoulPoolEncounter_*",false);
			Entity_SetActive("Trigger_RemoveBlockage",true);
		}
		
