		{
			Voice_Play("Canister_HalfEmpty");
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_LeverActive(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				Entity_SetInteractionDisabled("Lever_MilkingRoom",false);
			else
				Entity_SetInteractionDisabled("Lever_MilkingRoom",true);
				
			return true;
		}
		
		//------------------------------------------------------- 
		
		void OnInteract_VitaeCanister(const tString &in asEntity)
		{
			Entity_SetActive("VitaeElevator_Empty",true);
			Entity_SetActive("VitaeElevator_Full",false);
			Entity_SetActive("VitaeCanister_Empty",false);
			Entity_SetActive("VitaeCanister",false);
			Entity_SetActive("VitaeCanister_Half",false);
			
			Entity_SetInteractLookAtEntity("Lever_MilkingRoom","PosArea_GateLookAt");
			
			Voice_Play("Canister_Pickup");
			Light_SetBrightness("Light_Lever_Point",3);
			Lamp_SetLit("Lamp_VitaeCanisterPipe_*",false,true);
			Lamp_SetLit("VitaePipe_*",false,true);
			VitaePipe_PushVitae("A",8,0);
			VitaePipe_PushVitae("B",6,0);
			Lever_SetStuckState("Lever_MilkingRoom",0,true);
			Lever_SetAutoMoveEnabled("Lever_MilkingRoom",true);
			Map_AddTimer("Timer_RemoveLeverAutoMove",.8f,"OnTimer_RemoveLeverAutoMove");
			Sound_CreateAtEntity("Sound_UnlockLever","level_entity_shared/doors/tin_hinan_lock_door/TH_lock_door_unlock","Lever_MilkingRoom");
			Sound_Stop("Sound_CanisterScream", 1.0f);
			Sound_Stop("Sound_VitaeLiquid", 3.0f);
			Sound_Stop("Sound_VitaeMachine", 5.0f);
			
			cScript_SetGlobalVarBool("TTH_VitaeCanisterCollected", true);
			LoadScreen_ProgressStory();
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_RemoveLeverAutoMove(const tString &in asTimer)
		{
			Lever_SetAutoMoveEnabled("Lever_MilkingRoom",false);
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_CanisterReminder(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (!mbFairchildLowered) return true;
			
			if (!ItemType_IsInInventory("VitaeCanister"))
			{
				Voice_Play("Canister_Reminder");
				return false;
			}
			
			return true;
		}

		//-------------------------------------------------------

		//} END Event A

		
		/////////////////////////////////////////
		// Event B - PLAYER LEAVES THROUHG THE ENTRY HALL WITH CANISTER
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 7, Event B here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 7, Event B here.*/
		
		bool OnCollide_Portcullis_Blocker(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				Entity_SetActive("Blocker_Gate",false);
			else
				Entity_SetActive("Blocker_Gate",true);
			return true;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_UnlockDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			Debug_Log("ADDCALLBACK");
			//Entity_SetPlayerInteractCallback("tin_hinan_single_grating_2","OnInteract_UnlockDoor",true);
			Entity_SetActive("Portcullis_HuntingGrounds_Entrance_2",true);
			SlideDoor_SetClosed("Portcullis_HuntingGrounds_Entrance_1",false,true);
			SlideDoor_SetClosed("Portcullis_HuntingGrounds_Entrance_2",true,true);
			Entity_SetActive("Blocker_Gate",true);
			return false;
		}
		
		//------------------------------------------------------- 
		
		void OnInteract_UnlockDoor(const tString &in asEntity)
		{
			Debug_Log("UNLOCK");
			SlideLock_SetOpenAmount("tin_hinan_door_lock_2",0);
		}
			 
		//-------------------------------------------------------

		//} END Event B
	 
	 //} END SCENE 7
	
