	//------------------------------------------------------------
	
	int mlPermaFailState = eVitaeStationPermaFail_None;
	int mlPermaFailScene = 0;
		
	//------------------------------------------------------------
	
	void OnPermaFailSceneStarted()
	{
		mlPermaFailScene+=1;
	}
	
	//------------------------------------------------------------
	
	void OnPermaFailSceneEnded()
	{
		if (mlPermaFailState==eVitaeStationPermaFail_PostHG && mlPermaFailScene==3)
		{
			// TODO: Use proper sound for passing out.
			Sound_PlayGui("player/foley/damage/player_fall_damage", 1.f, eSoundEntryType_Gui);
		}
		else if (mlPermaFailState==eVitaeStationPermaFail_MilkingRoom && mlPermaFailScene==4)
		{
			Map_AddTimer("Timer_ResumeVoiceScene",6,"OnTimer_ResumeVoiceScene");
			Map_AddTimer("Timer_FairchildSneakMusic", 9.0f, "OnTimer_PlayFairchildMusic");
			Agent_SetSensesActive(msTortureGhoul,true);
		}
		else if (mlPermaFailState==eVitaeStationPermaFail_Cell && mlPermaFailScene==4)
		{
			Map_AddTimer("Timer_ResumeVoiceScene",6,"OnTimer_ResumeVoiceScene");
			Entity_SetActive(msTortureGhoul,false);
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ResumeVoiceScene(const tString &in asTimer)
	{
		Voice_FadeSceneVolumeTo("Fairchild",1,1);
	}
	
	//------------------------------------------------------------
	
	void SetupPermaFail(const int alState)
	{
		FearHandler_ClearPermaFailScenes();
		mlPermaFailState = alState;
		if (alState==eVitaeStationPermaFail_None)
			return;
		
		FearHandler_SetPermaFailEnabled(true);
		
		if (alState==eVitaeStationPermaFail_PreHG)
		{
			FearHandler_AddPermaFailScene("Area_Permafail_1_Run_Point_A", "Area_Permafail_1_Run_Point_B", 5.f, 4.f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_1_Run_Point_C", "Area_Permafail_1_Run_Point_D", 5.f, 1.5f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_1_Run_Point_D", "Area_Permafail_1_Run_Point_E", 5.f, 1.f, true);
			FearHandler_AddPermaFailScene("cannon_stumble", "Area_Permafail_1_Stare","","", 1.25f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_1");
		}
		else if (alState==eVitaeStationPermaFail_HG_BeforeLeonAttack)
		{
			FearHandler_AddPermaFailScene("Area_Permafail_2_Move_Point_A", "Area_Permafail_2_Move_Point_B", 5.f, 1.5f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_2_Move_Point_B", "Area_Permafail_2_Move_Point_C", 6.f, 1.f, true);
			FearHandler_AddPermaFailScene("cannon_stumble", "Area_Permafail_2_Move_Point_C","","", 1.f);
			FearHandler_AddPermaFailScene("struggle_gnaw_on_fairchild_loop", "Area_Permafail_2_Feed","","", 1.f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_2");
		}
		else if (alState==eVitaeStationPermaFail_HG_LeonPassive)
		{
			FearHandler_AddPermaFailScene("Area_Permafail_3_Move_Point_A", "Area_Permafail_3_Move_Point_B", 5.f, 1.5f, true);
			FearHandler_AddPermaFailScene("tf17_exit", "Area_Permafail_3_Move_Climb","","",1.65f);
			FearHandler_AddPermaFailScene("cannon_stumble", "Area_Permafail_3_PreFeed","","",1.f);
			FearHandler_AddPermaFailScene("struggle_gnaw_on_fairchild_loop", "Area_Permafail_3_Feed","","", 1.f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_3");
		}
		else if (alState==eVitaeStationPermaFail_HG_LeonStalking)
		{
			FearHandler_AddPermaFailScene("Area_Permafail_4_Run_Point_A", "Area_Permafail_4_Run_Point_B", 5.f, 1.2f, true);
			FearHandler_AddPermaFailScene("cannon_stumble", "Area_Permafail_4_Run_Point_B","","",1.f);
			FearHandler_AddPermaFailScene("struggle_gnaw_on_fairchild_loop", "Area_Permafail_4_Feed","","", 1.f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_4");
		}
		else if (alState==eVitaeStationPermaFail_PostHG)
		{
			FearHandler_AddPermaFailScene("cannon_stumble", "Area_Permafail_5_Move_A","","",1.f);
			FearHandler_AddPermaFailScene("Area_Permafail_5_Move_B", "Area_Permafail_5_Move_C", 2.f, 3.f, true);
			FearHandler_AddPermaFailScene("CamAnim_PermaFail_5", 4.15f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_5");
		}
		else if (alState==eVitaeStationPermaFail_PoolOfBodies)
		{
			FearHandler_AddPermaFailScene("Area_PermaFail_6_Run_Point_A", "Area_PermaFail_6_Run_Point_B", 5.f, 5.f, true);
			FearHandler_AddPermaFailScene("tf17_exit", "Area_Permafail_6_Climb","","",1.65f);
			FearHandler_AddPermaFailScene("Area_PermaFail_6_Run_Point_C", "Area_PermaFail_6_Run_Point_D", 5.f, 3.f, true);
			FearHandler_AddPermaFailScene("cannon_stumble", "Area_PermaFail_6_Run_Point_E","","",1.f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_6");
		}
		else if (alState==eVitaeStationPermaFail_TortureArea)
		{
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_A", "Area_Permafail_7_Run_Point_B", 5.f, 2.f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_C", "Area_Permafail_7_Run_Point_D", 5.f, 2.f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_D", "Area_Permafail_7_Run_Point_E", 5.f, 1.5f, true);
			FearHandler_AddPermaFailScene("struggle_gnaw_on_fairchild_loop", "Area_Permafail_7_Feed","","", 1.f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_7");
		}
		else if (alState==eVitaeStationPermaFail_MilkingRoom)
		{
			Voice_FadeSceneVolumeTo("Fairchild",0,1);
			cLux_AddDebugMessage("FADE TO 0");
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_E", "Area_Permafail_7_Run_Point_D", 5.f, 2.f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_D", "Area_Permafail_7_Run_Point_C", 5.f, 2.f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_B", "Area_Permafail_7_Run_Point_A", 5.f, 1.5f, true);
			FearHandler_AddPermaFailScene("struggle_gnaw_on_fairchild_loop", "Area_Permafail_7_Feed","","", 1.f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_9");
		}
		else if (alState==eVitaeStationPermaFail_Cell)
		{
			Voice_FadeSceneVolumeTo("Fairchild",0,1);
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_F", "Area_Permafail_7_Run_Point_G", 5.f, 2.f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_E", "Area_Permafail_7_Run_Point_D", 5.f, 2.f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_7_Run_Point_G", "Area_Permafail_7_Run_Point_F", 5.f, 1.5f, true);
			FearHandler_AddPermaFailScene("struggle_gnaw_on_fairchild_loop", "Area_Permafail_7_Feed","","", 1.f);
			FearHandler_SetPermaFailRespawnArea("PermaFail_Cell");
			Entity_SetActive(msTortureGhoul,false);
			mbTortureGhoulLocked = true;
		}
		else if (alState==eVitaeStationPermaFail_PathBack)
		{
			FearHandler_AddPermaFailScene("Area_Permafail_1_Run_Point_E", "Area_Permafail_1_Run_Point_D", 5.f, 1.5f, true);
			FearHandler_AddPermaFailScene("Area_Permafail_1_Run_Point_B", "Area_Permafail_1_Run_Point_F", 5.f, 4.f, true);
			FearHandler_AddPermaFailScene("CamAnim_PermaFail_8", 4.f);
			FearHandler_SetPermaFailRespawnArea("Area_PermaFail_8");
			Entity_SetActive("Portcullis_HuntingGrounds_Entrance_2",false);
		}

		cLux_AddDebugMessage("PermaFailState: "+alState);
	}
	
	//------------------------------------------------------------
	
	bool OnCollide_Player_PermaFail(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState!=1) return true;
		
		if (FearHandler_GetIsPermaFailing()==false)
		{
			if (asParent=="Area_Permafail_1_Activate")
			{
				SetupPermaFail(eVitaeStationPermaFail_PreHG);
			}
			else if (asParent=="Area_Permafail_1_UpdateRespawnPoint")
			{
				FearHandler_SetPermaFailRespawnArea("Area_PermaFail_8");
			}
			else if (asParent=="Area_Permafail_2_Activate")
			{
				SetupPermaFail(eVitaeStationPermaFail_HG_BeforeLeonAttack);
			}
			else if (asParent=="Area_Permafail_8_Activate")
			{
				SetupPermaFail(eVitaeStationPermaFail_PathBack);
			}
			return false;
		}
		else
		{
			if (asParent=="Area_Permafail_6_Climb")
			{
				Player_SetFallDamageActive(false);
				Player_SetGravityEnabled(false);
				Player_StopLookAt(1.f);
			}
			else if (asParent=="Area_PermaFail_6_Run_Point_C")
			{
				Player_SetFallDamageActive(true);
				Player_SetGravityEnabled(true);
				Player_SetCrouching(false);
			}
			else if (asParent=="Area_PermaFail_6_Run_Point_B")
			{
				Player_SetCrouching(true);
				FearHandler_SetPermaFailRandCamRotActive(false);
				Player_StartLookAt("Area_PermaFail_6_PrayTarget", 1.f, 2.f, 6.f);
			}
			return false;
		}
		return true;
	}
	
