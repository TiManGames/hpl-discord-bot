		void OnTimer_EnginesSpark(const tString &in asTimer)
		{
			Engines_Spark();
			Map_RestartCurrentTimer(cMath_RandRectf(3,8));
		}
		
		//-------------------------------------------------------
		
		void Engines_Spark()
		{
			ParticleSystem_CreateAtEntity("PS_EngineSparks1","sparks.ps","PosArea_EngineSparks_1",false);
			ParticleSystem_CreateAtEntity("PS_EngineSparks2","sparks.ps","PosArea_EngineSparks_2",false);
			ParticleSystem_CreateAtEntity("PS_EngineSparks3","sparks.ps","PosArea_EngineSparks_3",false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnginesChoke(const tString &in asTimer)
		{
			if (mbEngineBroken) return;
			
			if (mbEnginesStarting)
			{
				Map_RestartCurrentTimer(1);
				return;
			}
			
			mbEngineBrokenEffect = true;
							
			Engines_Spark();
			
			Sound_Stop("Sound_Engine_1_Run",0.1f);
			Sound_Stop("Sound_Engine_2_Run",0.1f);
			Sound_CreateAtEntity("Sound_Engine_1_Grind","03_05_vitae_station/crusher/main/turbine/grind","Engine_1",0.1f);
			Sound_CreateAtEntity("Sound_Engine_2_Grind","003_05_vitae_station/crusher/main/turbine/grind","Engine_2",0.1f);

			
			float fChokeTime = cMath_RandRectf(0.8f,1.6f);
			
			Map_AddTimer("Timer_EnginesUnlock",fChokeTime,"OnTimer_EnginesUnlock");
			
			Map_RestartCurrentTimer(cMath_RandRectf(5,12));
		}
		
		//-------------------------------------------------------
		
		void Engines_Choke(float afTime)
		{
			mbEngineBrokenEffect = true;
			Debug_Log("CHOKE");
			Engines_Spark();
			
			Sound_Stop("Sound_Engine_1_Run",0.1f);
			Sound_Stop("Sound_Engine_2_Run",0.1f);
			Sound_CreateAtEntity("Sound_Engine_1_Grind","03_05_vitae_station/crusher/main/turbine/grind","Engine_1",0.1f);
			Sound_CreateAtEntity("Sound_Engine_2_Grind","03_05_vitae_station/crusher/main/turbine/grind","Engine_2",0.1f);
						
			Map_AddTimer("Timer_EnginesUnlock",afTime,"OnTimer_EnginesUnlock");
		}
		
		//------------------------------------------------------- 
		
		bool mbCageInPosition = false;
		
		void OnTimer_EnginesUnlock(const tString &in asTimer)
		{
			if (mbEngineBroken) return;
			
			if (mbCageInPosition)
			{
				PoolOfBodies_EnginesBreak();
				return;
			}
			
			Map_RemoveTimer("Timer_EnginesSkip");
			Sound_Stop("Sound_Engine_1_Grind",0.1f);
			
			cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName("Machine").GetMeshEntity().GetAnimationStateFromName("tth_pool_machine_whitebox_chop");
			//pAnim.SetSpeed(1.f);
			pAnim.SetActive(true);
			pAnim.SetPaused(false);
			pAnim.SetWeight(1.f);
			
			for (int i = 1; i <= 2; i++)
			{
				cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName("Engine_"+i).GetMeshEntity().GetAnimationStateFromName("tth_pool_turbine_whitebox_spin");
				//pAnim.SetSpeed(1.f);
				pAnim.SetActive(true);
				pAnim.SetPaused(false);
				pAnim.SetWeight(1.f);
				Sound_CreateAtEntity("Sound_Engine_"+i+"_Run","03_05_vitae_station/crusher/main/turbine/turbine_loop","Engine_"+i,0.1f);
			}
			mbEngineBrokenEffect = false;
		}
		
		//-------------------------------------------------------
		
		int mlCageHits = 2;
		
		bool OnCollide_Cage_BreakMachine(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbEngineBroken) return false;
			
			int lState = Entity_GetVarInt("Cage_2","");
			if (lState == 0) return true;
			
			if (alState != 1) 
			{
				mbCageInPosition = false;
				return true;
			}
			
			mbCageInPosition = true;
			iLuxEntity@ pCage = Map_GetEntity("Cage_2");
			float fVel = pCage.GetMainBody().GetVelocityAtPosition(pCage.GetPosition()).Length();
			
			bool mbEngineStuck = Map_TimerExists("Timer_EnginesSkip");
			
			if (fVel > 0.65f)
			{
				PoolOfBodies_EnginesBreak();
				Sound_CreateAtEntity("Sound_CageImpact", "03_05_vitae_station/crusher/cages/turbine_impact", "Sound_TurbineStuck");
				return false;
			}
			else
			{
				if (mlCageHits <= 0)
				{
					PoolOfBodies_EnginesBreak();
					Sound_CreateAtEntity("Sound_CageImpact", "03_05_vitae_station/crusher/cages/turbine_impact", "Sound_TurbineStuck");
					return false;
				}
				else
				{
					if (!mbEngineStuck) 
					{
						Engines_Spark();
						Player_ChangeStateToNormal();
						Entity_AddImpulse("Cage_2",cVector3f(0.6f,0,2),false,true);
					}
					mlCageHits--;
					Engines_Choke(0.6f);
				}	
			}
			return true;
		}
		
		//-----------------------------------------------
		
		void PoolOfBodies_EnginesBreak()
		{
			Seq_EngineSmash("");
		}
		
		//-------------------------------------------------------
		
		bool mbEngineBrokenEffect = false;
		
		cSequenceStatesData mSequenceEngineSmash;
			
		void Seq_EngineSmash(const tString &in asTimer)
		{
			Sequence_Begin("Seq_EngineSmash", mSequenceEngineSmash);
			if (Sequence_DoStepAndWait(1.2f))
			{
				mbEngineBroken = true;
				mbEngineBrokenEffect = true;
				Map_RemoveTimer("Timer_LeonPoolBark");
				Map_RemoveTimer("Timer_EnginesSkip");
				Map_RemoveTimer("Timer_EnginesChoke");
				Map_RemoveTimer("Timer_EnginesUnlock");
				Map_RemoveTimer("Timer_LeonPoolBark");
				
				Entity_SetActive("Trigger_ThroughMachine_1",true);
				Entity_SetActive("Trigger_ThroughMachine_2",false);
				Entity_SetActive("Trigger_CrusherDamage",false);
				Entity_SetActive("Machine_Blocker",false);
				Entity_SetActive(msLeonPool,false);
				Entity_SetActive("Trigger_MachineShake",false);
				Effect_Shake_FadeOut(m_idPoolShake,2);
				
				ParticleSystem_SetActive("PS_BrokenMachine",true);
				ParticleSystem_SetActive("PS_Crusher",true);
				
				Player_ChangeStateToNormal();
				
				Prop_SetStaticPhysics("Cage_2",true);
				Prop_MoveLinearTo("Cage_2","Cage_2_Broken_1",5,5,0.3f,false);
				Prop_AlignRotation("Cage_2","Cage_2_Broken_1",5,5,0.3f,false);
				Entity_SetInteractionDisabled("Cage_2",true);

				Entity_PlayAnimation("Machine","tth_pool_machine_whitebox_broken",0,false);
				cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName("Machine").GetMeshEntity().GetAnimationStateFromName("tth_pool_machine_whitebox_chop");
				pAnim.SetSpeed(1.f);
				
				Entity_SetAnimationPaused("Engine_*","tth_pool_turbine_whitebox_spin",true);
				
				//Sound
				
				for (int i = 1; i <= 4; i++)
				{
					Sound_Play("Sound_CrusherStop", 0.0f);
					Sound_CreateAtEntity("Sound_EngineJammed", "03_05_vitae_station/crusher/main/turbine/stop", "Trigger_CageHit");
					Sound_CreateAtEntity("Sound_CageJammed", "03_05_vitae_station/crusher/cages/cage_turbine_jam", "Sound_TurbineStuck");
					Sound_CreateAtEntity("Sound_CageJamLoop", "03_05_vitae_station/crusher/main/turbine/jammed_loop", "Sound_TurbineStuck");
					
					Sound_Stop("Sound_Engine_1_Run",0.1f);
					Sound_Stop("Sound_Engine_2_Run",0.1f);
					
					Sound_Stop("Sound_Engine_"+i+"_Run",0.1f);
					Sound_Stop("Sound_Engine_"+i+"_Grind",0.1f);
					Sound_Stop("Sound_Engine_"+i+"_Stop",0.1f);
				}
				
				Voice_PlayDelayed("Leon_SeesTasiLeaving",1);
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				mbEngineBrokenEffect = false;
				for (int i = 1; i <= 2; i++)
				{
					cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName("Engine_"+i).GetMeshEntity().GetAnimationStateFromName("tth_pool_turbine_whitebox_spin");
					pAnim.SetSpeed(.3f);
					pAnim.SetActive(true);
					pAnim.SetPaused(false);
					pAnim.SetWeight(1.f);
					Sound_CreateAtEntity("Sound_Engine_"+i+"_Run","03_05_vitae_station/crusher/main/turbine/turbine_loop","Engine_"+i,0.1f);
				}
				Entity_SetAnimationPaused("Engine_*","tth_pool_turbine_whitebox_spin",false);
				Prop_MoveLinearTo("Cage_2","Cage_2_Broken_2",5,5,0.3f,false);
				Prop_AlignRotation("Cage_2","Cage_2_Broken_2",5,5,0.3f,false);
				
				for (int i = 1; i <= 4; i++)
				{
					Sound_Stop("Sound_Engine_"+i+"_Run",0.1f);
					Sound_Stop("Sound_Engine_"+i+"_Grind",0.1f);
					Sound_Stop("Sound_Engine_"+i+"_Stop",0.1f);
					
					Sound_Stop("Sound_Engine_1_Run",0.1f);
					Sound_Stop("Sound_Engine_2_Run",0.1f);
				}
				Sound_Stop("Sound_MainLoop", 0.5f);
				Map_RemoveTimer("Timer_PulseSound");
				Map_RemoveTimer("Timer_PulseDelay");
				
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Entity_SetAnimationPaused("Engine_*","tth_pool_turbine_whitebox_spin",true);
				mbEngineBrokenEffect = true;
			}
			Sequence_End();
		}
		
