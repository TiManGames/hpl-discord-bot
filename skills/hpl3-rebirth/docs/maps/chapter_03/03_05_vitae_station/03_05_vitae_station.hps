		//----------------------------------------------------------
		
		void OnEndOfTrack_LeonStage3_Hunt(const tString &in asEntity)
		{
			Agent_SetSensesActive(msLeon,true);
			Ghoul_Mode_Set(msLeon,eGhoulMode_Hunt,true);
		}
		
		//----------------------------------------------------------
		
		bool OnCollide_BreakPortcullis(const tString &in asParent, const tString &in asChild, int alState)
		{		
			// There was a flag for the gate broken here. Maybe used if callback was called twice for some reason (Leon triggering anyways?)
			Sound_CreateAtEntity("Sound_PortcullisBreak","03_06_ghouls_nest/chase_sequence/ghoul_chase_grate_open",asParent);
			SlideDoor_SetOpenAmount("Portcullis_HG_Exit",0.6f,false);
			Map_AddTimer("Timer_Portcullis_Breaking",0.4f,"OnTimer_Portcullis_Breaking");
			return false;
		}
		
		//----------------------------------------------------------
		
		void OnTimer_Portcullis_Breaking(const tString &in asTimer)
		{
			float fNewOpenAmount = cMath_RandRectf(0.4f,0.7f);
			float fNextTimer = cMath_RandRectf(0.2f,1.0f);
			SlideDoor_SetOpenAmount("Portcullis_HG_Exit",fNewOpenAmount,false);
			Map_RestartCurrentTimer(fNextTimer);	
		}
		
		//----------------------------------------------------------
		
		bool OnCollide_ExitHuntingGrounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Blocker_HG_Exit", true);
			SetupPermaFail(eVitaeStationPermaFail_PostHG);
			Map_RemoveTimer("Timer_Portcullis_Breaking");
			Map_RemoveTimer("Timer_LeonStage3_StartHunt");
			SlideDoor_SetClosed("Portcullis_HG_Exit",true,false);
			SlideDoor_SetClosed("Portcullis_HG_LeonStage3Retreat",false,false);
			//Sound_CreateAtEntity("Sound_PortcullisBreak","03_06_ghouls_nest/chase_sequence/ghoul_chase_grate_open",msLeon);
			PressurePlate_ManageTriggersStage(9);
			Map_AddTimer("Timer_DeactivateLeon",0.2f,"OnTimer_DeactivateLeon");
			return false;
		}
		
		//----------------------------------------------------------
		
		void OnTimer_DeactivateLeon(const tString &in asTimer)
		{
			if (!Entity_IsActive(msLeon) || !Entity_GetCollide(msLeon,"Trigger_LeonStage3Position"))
			{
				Ghoul_Command_Remove(msLeon,true);
				Entity_SetActive(msLeon,false);
				msLeon = "Ghoul_LeonStage3_BangOnDoor";
				Entity_SetActive(msLeon,true);
			}
			Voice_SetSource("Leon",msLeon,0,25,true);
			Voice_SetSource("Leon_Unknown",msLeon,0,25,true);
			Agent_SetSensesActive(msLeon,false);
			Ghoul_Mode_Set(msLeon,eGhoulMode_Idle,true);
			Ghoul_Command_Remove(msLeon,true);
			Ghoul_CommandPatrol_AddNode(msLeon,"PathNode_HG_ExitGate");
			Ghoul_CommandPatrol_Execute(msLeon,true,1,false,eGhoulSpeed_Run,"OnEndOfTrack_LeonStage3_BangOnDoor");
			
			Voice_StopAll();
			Voice_PlayWhenPossible("Leon_AfterTrap_Escaped");
			if (FearHandler_GetLevel() > 0.8f)
				FearHandler_AddProgressToken();
				
			Music_Stop(10.0f, eMusicPrio_SceneAmb);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_LeonStage3_BangOnDoor(const tString &in asEntity)
		{
			Agent_SetSensesActive(msLeon,false);
			Agent_PlayCutsceneAtEntity(msLeon,"leon_bang_on_gate","PosArea_BangAnimation",0.4f,false,"OnEndOfAnim_LeonGateRetreat",1,0,0,0,true,false,true);
			Sound_CreateAtEntity("Sound_LeonOnGate","03_05_vitae_station/maze/leon_gate_hit",msLeon);
			
			if (!Map_TimerExists("Timer_LeonStage3_BangOnDoor"))
			{
				Map_AddTimer("Timer_LeonStage3_BangOnDoor",0,"OnTimer_LeonStage3_BangOnDoor");
			}
		}
				
		//-------------------------------------------------------
		
		int mlFearPeaks = 1;
			
		void OnTimer_LeonStage3_BangOnDoor(const tString &in asTimer)
		{
			//ParticleSystem_CreateAtEntity("PS_DoorBash_tmp", "dust_impact_simple_oneshot.ps", "Portcullis_HG_Exit", false);
			//Sound_CreateAtEntity("Sound_GhoulDoorHit", "03_06_ghouls_nest/nest_gate/roof_vent_hit", "Portcullis_HG_Exit");
			if (mlFearPeaks > 0)
			{
				FearHandler_SetForcedAddFearRate(0.5f,1,false);
				mlFearPeaks--;
			}
			
			float fNewTime = cMath_RandRectf(1.0f,3.0f);
			Map_RestartCurrentTimer(fNewTime);
			
		}
		
