		//-------------------------------------------------------
		
		void OnTimer_CagesCurrent(const tString &in asTimer)
		{
			for (int i = 1; i < mlCages; i++)
			{
				int lState = Entity_GetVarInt("Cage_"+i,"");
				
				if (lState == 0)
				{
					Entity_AddImpulse("Cage_"+i,cVector3f(0,0,cMath_RandRectf(-0.15f,-0.05)),false,true);
					//ParticleSystem_CreateAtEntity("PS_Current_"+i,"splash_small_broad_oneshot.ps","Cage_"+i+"_PS",false);
				}
			}
			
			Map_RestartCurrentTimer(0.1f);
		}
		
		//-------------------------------------------------------
		
		bool mbEngineBroken = false;
		
		void OnTimer_LeonPoolBark(const tString &in asTimer)
		{
			int lStatus = Map_GetTimerUserVarInt(asTimer);
			
			lStatus = eLeonPoolBark_Movement;
			
			//Debug_Log("BARK TYPE: "+ lStatus);
			
			if (lStatus == eLeonPoolBark_Movement)
			{
				Voice_PlayWhenPossible("Leon_Pool_Movement");
				//Debug_Log("PLAYING MOVEMENT");
			}
			else if (lStatus == eLeonPoolBark_Taunt)
			{
				Voice_Play("Leon_Pool_Taunt");
				//Debug_Log("PLAYING TAUNT");
			}
			else
			{
				float fRand = cMath_RandRectf(0,1);
				if (fRand >= .4f)
					Voice_PlayWhenPossible("Leon_Pool_Taunt");
				else
					Voice_PlayWhenPossible("Leon_Pool_Movement");
					
				//Debug_Log("PLAYING MIXED");
			}

			if (mlLeonPoolEmergeAmount > 1)
			{
				Map_RestartCurrentTimer(cMath_RandRectl(15,20));
				Map_SetTimerUserVarInt(asTimer,eLeonPoolBark_Mixed);
			}
		}
		
		//-------------------------------------------------------
		
		bool mbLeonPoolObserving = false;
		int mlLeonHideStage = eLeonPoolState_Observing;
				
		//-------------------------------------------------------
		
		void LeonPool_TeleportToArea(const tString &in asArea = "")
		{
			
			mlLeonPoolEmergeAmount++;
			
			tString sRandomArea = "";

			do {
				sRandomArea = "PosArea_LeonPool_"+cMath_RandRectl(1,mlPoolHoles);
				//Debug_Log("DIST: "+Entity_GetDeltaToEntity(sRandomArea,"player").Length());
			}
			while (Entity_GetDeltaToEntity(sRandomArea,"player").Length() < 5);
				
			tString sArea = (asArea == "") ? sRandomArea : asArea;

			//Debug_Log("Leon teleported to "+sArea);
			Agent_TeleportFeetToEntity(msLeonPool,sArea);
			Entity_SetPlayerLookAtCallback(msLeonPool,"OnLookAt_LeonPool",false,false);
			
			int lArea = cString_GetNumericSuffixInt(sArea);
			
			Map_AddTimer("Timer_LeonPoolEmerge",0,"OnTimer_LeonPoolEmerge");
			Map_SetTimerUserVarInt("Timer_LeonPoolEmerge",lArea);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonPoolMoveAround(const tString &in asTimer)
		{
			LeonPool_TeleportToArea();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LeonPoolMovement(const tString &in asTimer)
		{	
			int lArea = cMath_RandRectl(1,mlPoolHoles);
			ParticleSystem_CreateAtEntity("PS_Dust_"+lArea,"sand_falling_stream_small_oneshot.ps","PosArea_PoolHole_"+lArea,false);
			
			float fRand = cMath_RandRectf(0,1);
			tString sSound = (fRand < .2) ? "physics/water/water_impact" : "creatures/foley/creature/ghoul/ghoul_tunnel_crawl";
			
			Sound_CreateAtEntity("Sound_LeonMove", sSound, "PosArea_PoolHole_"+lArea);
		
			Map_RestartCurrentTimer(cMath_RandRectf(6,15));

		}
		
