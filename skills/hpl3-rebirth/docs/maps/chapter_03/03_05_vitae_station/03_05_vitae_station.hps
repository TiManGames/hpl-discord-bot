		/*Put any variables that are only used in Scene 4, Event B here.*/
		
		tString msTortureGhoul = "Ghoul_TortureGuy_1";
		bool mbTortureGhoulWithPrisoner = false;
		bool mbTortureGhoulAttacking = false;
		bool mbTortureGhoulLocked = false;
		bool mbTortureGhoulAlerted = false;
		bool mbTortureGhoulCheckingWheel = false;
		bool mbTortureGhoulHasReturnRoutine = false;
		bool mbTortureGhoulEscaped = false;
		bool mbFairchildAttacked = false;
		bool mbPrisonerIsDead = false;
		
		int mlPlayerCell = 0;
		int mlGhoulCell = 0;
		int mlGhoulScreeches = 4;
		bool mbTortureSetup = false;
	 
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 4, Event B here.*/
		
		bool OnCollide_Player_SetupTortureEncounter(const tString &in asParent, const tString &in asChild, int alState)
		 {
			if (alState != 1) return true;
			
			TortureEncounter_Setup(true);
			return false;
		 }
		 
		//-------------------------------------------------------
		
		bool OnCollide_Player_TortureGhoulActivateSenses(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			TortureEncounter_AnimsToIdle();
			TortureGhoul_GoToPrisoner();
			Agent_SetSensesActive(msTortureGhoul,true);
			return false;
		}
		
		//-------------------------------------------------------
		 
		void TortureEncounter_Setup(bool abSpawnGhoul)
		{
			if (mbFairchildAttacked) return;
			
			if (abSpawnGhoul)
			{			
				Entity_SetActive(msTortureGhoul,true);
				Agent_SetSensesActive(msTortureGhoul,false);
			}
			
			Entity_SetActive("Trigger_LookAtFairchild",true);
			
			Entity_PlayAnimation("Torture_Rack","tdevice_idle",0,true); // can nuke this? to test
			Entity_PlayAnimation("Torture_Chains","tdevice_chains_idle",0,true); // can nuke this? to test
			
			Map_RemoveTimer("Timer_FairchildScreamFar");
			Map_AddTimer("Timer_FairchildDelirium", 0.5f, "OnTimer_FairchildDelirium"); 
			Map_AddTimer("Timer_FairchildHeadTracker_PickTarget",2,"OnTimer_FairchildHeadTrackerPickTarget");
			//Entity_AddImpulse("Fairchild", cVector3f(0.5f,0,0), true, false); //avoid body not reacting to lowering motion
			
			mbTortureSetup = true;
		}
		
		//-------------------------------------------------------
		
		void TortureEncounter_AnimsToIdle()
		{
			Entity_PlayAnimation("Fairchild","tdevice_fairchild_idle",0.5f,true);
			Entity_PlayAnimation("Torture_Rack","tdevice_idle",0.5f,true);
			Entity_PlayAnimation("Torture_Chains","tdevice_chains_idle",0.5f,true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FairchildHeadTrackerPickTarget(const tString &in asTimer)
		{
			
			HeadTracker_SetMaxSpeed("Fairchild",1.2f);
			HeadTracker_SetSpeedMul("Fairchild",1);
			
			int lTarget = cMath_RandRectl(1,4);
			HeadTracker_SetTargetEntity("Fairchild","PosArea_FairchildLookTarget_"+lTarget);
			
			Map_RestartCurrentTimer(cMath_RandRectl(1,4));
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_SeenFairchild(const tString &in asEntity, int alState)
		{
			Voice_PlayDelayed("SeeingFairchild",1.2f);
			//Sketchbook_AddSketchImageByPage("tth_hint_fairchild", "tth_full", true, "");
			Music_Play("A2_3_5_Fairchild_Discover.ogg", 0.4f, false, eMusicPrio_MinorEvent);
			Map_AddTimer("Timer_FairchildSneakMusic", 9.0f, "OnTimer_PlayFairchildMusic");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayFairchildMusic(const tString &in asTimer)
		{
			//FearArea_SetSafe("Fear_NoFear_MilkingRoom",false);
			FearArea_SetGivesFear("Fear_NoFear_MilkingRoom",true);
			Music_Stop(3.0f, eMusicPrio_MinorEvent);
			Music_PlayExt("A2_3_5_Fairchild_Detected.ogg", true, 0.25f, 1.0f, 15.0f, 1.0f, eMusicPrio_SceneAmb, true);
		}
	
		//-------------------------------------------------------
		
		bool OnDoorway_ChangeFairchildDistance(const tString &in asArea, const tString &in asEntity, int alState)
		{
			if (alState==1)
				Voice_SetSource("Fairchild", "Fairchild", 0, 25, true);
			else
				Voice_SetSource("Fairchild","Fairchild", 5, 40, true);
			return true;
		}
		
		//-------------------------------------------------------

		bool OnCollide_TortureGhoul_ActivateRoutine(const tString &in asParent, const tString &in asChild, int alState)
		{
			TortureGhoul_TortureFairchildIntro();
			return false;
		}
		
		//-------------------------------------------------------
		
		void TortureGhoul_TortureFairchildIntro()
		{
			/*Entity_PlayAnimation("Torture_Chains", "tdevice_chains_generic_torture_a", 0.5f);
			Entity_PlayAnimation("Torture_Rack", "tdevice_generic_torture_a", 0.5f);
			Entity_PlayAnimation("Fairchild", "tdevice_fairchild_generic_torture_a", 0.5f);
			
			Agent_PlayCutsceneAtEntity(msTortureGhoul,"tdevice_ghoul_generic_torture_a","PosArea_TortureFairchild",0.6f,false,"OnEndOfAnim_TortureGhoulDoneWithFairchild");*/
			
			
			Entity_PlayAnimation("Torture_Chains", "tdevice_chains_torture_reveal", 0.5f);
			Entity_PlayAnimation("Torture_Rack", "tdevice_torture_reveal", 0.5f);
			Entity_PlayAnimation("Fairchild", "fairchild_torture_reveal", 0.5f);
			//CharMover_PlayAnimation(msTortureGhoul, "ghoul_torture_reveal", 0.5f, false,true,"OnEndOfAnim_TortureGhoulGoToPrisoner");
			Agent_PlayCutsceneAtEntity(msTortureGhoul,"ghoul_torture_reveal","PosArea_TortureFairchild",0.6f,false,"OnEndOfAnim_TortureGhoulGoToPrisoner");
			Debug_Log("PLAYED ANIM");
			
			Map_AddTimer("Timer_FairchildDelirium", 0.5f, "OnTimer_FairchildDelirium");	// These won't play until the screams have stopped.
			OnTimer_FairchildScreamsForPain();
			
			mbTorturingFairchild = true;
			
			Ghoul_CommandPatrol_ClearNodes(msTortureGhoul);
			Ghoul_CommandPatrol_AddNode(msTortureGhoul,"PathNode_GhoulGoToPrisoner_13");
		}
		
		//-------------------------------------------------------
		
		int mlLastTorture = 0;
		bool mbTorturingFairchild = false;
		
		void TortureGhoul_TortureFairchild()
		{
			tString sAnim = "";
			int lTorture;	
			
			do 
			{
				lTorture = cMath_RandRectl(1,3);
			}
			while (lTorture == mlLastTorture);
			
			if (lTorture == 1)		sAnim = "a";
			else if (lTorture == 2)	sAnim = "c"; // TO DO: Set it to B
			else 					sAnim = "c";
			
			cLux_AddAIDebugMessage("Torture Fairchild - Anim: "+sAnim,true,false);
			
			Entity_PlayAnimation("Torture_Chains", "tdevice_chains_generic_torture_"+sAnim, 0.5f);
			Entity_PlayAnimation("Torture_Rack", "tdevice_generic_torture_"+sAnim, 0.5f);
			Entity_PlayAnimation("Fairchild", "tdevice_fairchild_generic_torture_"+sAnim, 0.5f);
			
			Agent_PlayCutsceneAtEntity(msTortureGhoul,"tdevice_ghoul_generic_torture_"+sAnim,"PosArea_TortureFairchildGeneric",0.6f,false,"OnEndOfAnim_TortureGhoulDoneWithFairchild");
			
			mbTorturingFairchild = true;
			
			Map_AddTimer("Timer_FairchildScreamsForPain",1,"OnTimer_FairchildScreamsForPain");
			
			mlLastTorture = lTorture;
		}
		
		//-------------------------------------------------------
		
		void TortureGhoul_TorturePrisoner()
		{
			// TO DO: New attack/eat anim
			
			
			
			cLux_AddAIDebugMessage("Attack Prisoner",true,true);
			Agent_PlayCutsceneAtEntity(msTortureGhoul,"ghoul_gnaw_on_victim","PosArea_TorturePrisoner",0.5f,true);
			Sound_CreateAtEntity("Sound_Chew","creatures/vocalisations/creature/ghoul/ghoul_eating",msTortureGhoul);
			//CharMover_PlayAnimation(msTortureGhoul, "attack_close_1", 0.5f, false);
			//Sound_CreateAtEntity("Sound_Pain","03_05_vitae_station/prisoner/prisoner_pain", "SoundArea_Prisoner");
			//if (FearHandler_GetIsPermaFailing()) return;
			//Sound_CreateAtEntity("Sound_GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_spot", msTortureGhoul);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FairchildScreamsForPain(const tString &in asTimer="")
		{
			Voice_Stop("Fairchild"); // Interrupt any delirium
			Map_SetTimerPaused("Timer_FairchildDelirium", true);	// Don't let any more delirium play for the time being.
			
			Voice_Play("Fairchild_WordlessScream", -1, "OnVoiceEnd_FairchildWordlessScream");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_FairchildWordlessScream(const tString&in asScene, const tString&in asSubject)
		{
			Voice_Play("FairchildScream", -1, "OnVoiceEnd_FairchildScream");
		}
		
		//-------------------------------------------------------
		
		 void OnVoiceEnd_FairchildScream(const tString&in asScene, const tString&in asSubject)
		 {
			 if (mbTorturingFairchild)
			 {
				 // Still torturing? Scream again!
				 Map_AddTimer("Timer_FairchildScreamsForPain",cMath_RandRectf(1.0f,2.0f),"OnTimer_FairchildScreamsForPain");
			 }
			 else
			 {
				 // Torturing stopped - restart the delirium
				 Map_SetTimerPaused("Timer_FairchildDelirium", false);
			 }
		 }
		 
		//-------------------------------------------------------
		
		void OnEndOfAnim_TortureGhoulGoToPrisoner(const tString &in asEntityName, const tString &in asAnimName)
		{
			TortureEncounter_AnimsToIdle();
			TortureGhoul_GoToPrisoner();
		}
		
		//-------------------------------------------------------
		
		void TortureGhoul_GoToPrisoner(bool abForce=true)
		{
			Ghoul_CommandPatrol_ClearNodes(msTortureGhoul);
			Ghoul_CommandPatrol_AddNode(msTortureGhoul,"PathNode_GhoulGoToPrisoner_13");
			Ghoul_CommandPatrol_Execute(msTortureGhoul,abForce,1,false,eGhoulSpeed_FastWalk,"OnEndOfTrack_TorturePrisoner");
			cLux_AddAIDebugMessage("Go to Prisoner [Forced: "+abForce+"]",true,true);
			mbTortureGhoulHasReturnRoutine = true;
			mbTorturingFairchild = false;
		}
		
		//-------------------------------------------------------
		
		void TortureGhoul_GoToFairchild(bool abForce=true)
		{
			Ghoul_CommandPatrol_ClearNodes(msTortureGhoul);
			Ghoul_CommandPatrol_AddNode(msTortureGhoul,"PathNode_GhoulGoToPrisoner_1");
			Ghoul_CommandPatrol_Execute(msTortureGhoul,abForce,1,false,eGhoulSpeed_FastWalk,"OnEndOfTrack_TortureFairchild");
			cLux_AddAIDebugMessage("Going to Fairchild",true,true);
			mbTortureGhoulHasReturnRoutine = true;
		}
		
		//-------------------------------------------------------
		
		void TortureGhoul_GoToInterestPoint(bool abForce=true)
		{
			int lX = cMath_RandRectl(1,3);
			Ghoul_CommandPatrol_ClearNodes(msTortureGhoul);
			Ghoul_CommandPatrol_AddNode(msTortureGhoul,"TortureGhoul_InterestPoint_"+lX,2,4);
			Ghoul_CommandPatrol_Execute(msTortureGhoul,abForce,1,false,eGhoulSpeed_FastWalk,"OnEndOfTrack_GoToFairchild");
		}
		
		bool OnCollide_TortureGhoul_UnlockCell1(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) SlideLock_SetOpenAmount("SlideLock_TortureCell_1",0);
			return true;
		}
		
		bool OnCollide_TortureGhoul_UnlockCell3(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) SlideLock_SetOpenAmount("SlideLock_TortureCell_3",0);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_TorturePrisoner(const tString &in asEntity)
		{
			cLux_AddAIDebugMessage("End of Track: Prisoner",true,true);
			
			if (Entity_GetCollide(msTortureGhoul,"Trigger_GhoulWithPrisoner") == false)
			{
				cLux_AddAIDebugMessage("!!!! ACTUALLY NOT WITH THE PRISONER",true,true);
				mbTortureGhoulHasReturnRoutine = false;
				return;
			}

			if (!Map_TimerExists("Timer_TorturePrisoner"))	
				Map_AddTimer("Timer_TorturePrisoner",0,"OnTimer_TorturePrisoner");
				
			if (!Map_TimerExists("Timer_TortureGhoulCheckState"))
			{
				Map_AddTimer("Timer_TortureGhoulCheckState",1.f,"OnTimer_TortureGhoulCheckState");
				cLux_AddAIDebugMessage("Now checking state every second",true,true);
			}
			
			Agent_SetViewRangeMul(msTortureGhoul,0.28f);
			Ghoul_SetSmellingActive(msTortureGhoul,false);
			
			mbTortureGhoulHasReturnRoutine = false;
			mbTortureGhoulWithPrisoner = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TorturePrisoner(const tString &in asTimer)
		{
			if (mbPrisonerIsDead || mbTortureGhoulLocked) return;
			
			TortureGhoul_TorturePrisoner();
			//Map_RestartCurrentTimer(cMath_RandRectf(7,12));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TortureGhoulCheckState(const tString &in asTimer)
		{
			cLux_AddAIDebugMessage("CHECK STATE");
			TortureGhoul_CheckState();
			Map_RestartCurrentTimer(-1);
		}
		
		//-------------------------------------------------------
		
		void TortureGhoul_CheckState()
		{
			//cLux_AddDebugMessage("STATE: "+Ghoul_GetCurrentState(msTortureGhoul));
			if (mbTortureGhoulLocked) return;
			
			if (Ghoul_GetCurrentState(msTortureGhoul) != "Idle")
			{
				// Stop torturing prisoner if the ghoul went onto a different state
				if (Map_TimerExists("Timer_TorturePrisoner"))
				{
					Map_RemoveTimer("Timer_TorturePrisoner");
					cLux_AddAIDebugMessage("Not in idle anymore -> Removed Attack timer",true,true);
					
				}
				
				Sound_Stop("Sound_Chew",0.5f);
				Agent_SetViewRangeMul(msTortureGhoul,0.5f);
				mbTortureGhoulWithPrisoner = false;
					
				if (Map_TimerExists("Timer_CheckFairchildDelay"))
				{
					Map_RemoveTimer("Timer_CheckFairchildDelay");
					cLux_AddAIDebugMessage("Not in idle anymore -> Removed Fairchild delay timer",true,true);
				}
					
				if (Ghoul_GetCurrentState(msTortureGhoul) != "Patrol" && !mbTortureGhoulHasReturnRoutine)
				{
					TortureGhoul_GoToPrisoner(false);
					//TortureGhoul_ReturnToPrisoner(false);
					cLux_AddAIDebugMessage("Not in idle and not in patrol -> Will eventually go back to prisoner", true, true);
				}
			}
			else
			{
				if (!mbTortureGhoulHasReturnRoutine && !mbTortureGhoulCheckingWheel && !mbTortureGhoulWithPrisoner)
				{
					cLux_AddAIDebugMessage("In idle -> Forcing back to prisoner",true,true);
					TortureGhoul_GoToPrisoner(true);
					//TortureGhoul_ReturnToPrisoner(true);
				}
			}
		}
		
		//-------------------------------------------------------
		
		void TortureGhoul_AlertedByWheel()
		{			
			if (mbTortureGhoulAlerted) return;
			if (mbTortureGhoulLocked) return;
			
			mbTortureGhoulAlerted = true;
			
			Agent_SetSensesActive(msTortureGhoul,true);
			Ghoul_CommandPatrol_ClearNodes(msTortureGhoul);
			Ghoul_CommandPatrol_AddNode(msTortureGhoul,"PathNode_GhoulGoToPrisoner_6");
			Ghoul_CommandPatrol_Execute(msTortureGhoul,true,1,false,eGhoulSpeed_FastWalk,"OnEndOfTrack_CheckWheel");
			
			Map_RemoveTimer("Timer_TorturePrisoner");
			Map_AddTimer("Timer_TortureGhoulResetAlerted",2,"OnTimer_TortureGhoulResetAlerted");
			
			Sound_CreateAtEntity("Sound_GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_awaken_scream", msTortureGhoul);
			
			cLux_AddAIDebugMessage("Alerted by Wheel",true,true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TortureGhoulResetAlerted(const tString &in asTimer)
		{
			mbTortureGhoulAlerted = false;
			cLux_AddAIDebugMessage("Can be alerted again",true,true);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_CheckWheel(const tString &in asEntity)
		{			
			mbTortureGhoulCheckingWheel = true;
			cLux_AddAIDebugMessage("End of Track: Check Wheel Delay. Moving to Fairchild",true,true);
			Map_AddTimer("Timer_CheckFairchildDelay",1.5f,"OnTimer_CheckFairchildDelay");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckFairchildDelay(const tString &in asTimer)
		{
			//float fSmell = cMath_RandRectf(0,1);
			//if (fSmell < .3f) Ghoul_SetSmellingActive(msTortureGhoul,true);
			
			//Ghoul_SetSmellingActive(msTortureGhoul,true);
			Agent_SetSensesActive(msTortureGhoul,true);
			
			TortureGhoul_GoToFairchild(true);	
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_TortureFairchild(const tString &in asEntity)
		{	
			cLux_AddAIDebugMessage("End of Track: Fairchild",true,true);
			TortureGhoul_TortureFairchild();
			TortureGhoul_GoToPrisoner(false);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_TortureGhoulDoneWithFairchild(const tString &in asEntityName, const tString &in asAnimName)
		{
			TortureEncounter_AnimsToIdle();
			mbTortureGhoulCheckingWheel = false;
			mbTorturingFairchild = false;
			Map_AddTimer("Timer_DoneWithFairchildDelay",1,"OnTimer_DoneWithFairchildDelay");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoneWithFairchildDelay(const tString &in asTimer)
		{
			
			cLux_AddAIDebugMessage("End of torture. Force back to prisoner.",true,true);
			SwingDoor_GetBlocked("SwingDoor_TortureCell_1") ? TortureGhoul_GoToInterestPoint(true) : TortureGhoul_GoToPrisoner(true);
		}
		
		//-------------------------------------------------------
		
		void TortureGhoul_AttackFairchild()
		{		
			CharMover_PlayAnimation(msTortureGhoul, "attack_close_1", 0.3f, false);
			tString sScream = "fairchild_attack_scream_00"+cMath_RandRectl(1,7)+".ogg";
			Sound_CreateAtEntity("Sound_Pain", sScream, "SoundArea_Fairchild");
			
			mbTortureGhoulAttacking = true;
			Map_SetTimerPaused("Timer_FairchildDelirium",true);
			Map_AddTimer("Timer_TortureGhoulEndAttack",3,"OnTimer_TortureGhoulEndAttack");
		}
		
		//-------------------------------------------------------
	
		void TortureGhoul_KillPrisoner()
		{	
			if (mbTortureGhoulAttacking) return;
			
			Prisoner_Die();
			CharMover_PlayAnimation(msTortureGhoul, "attack_close_1", 0.3f, false);
			Map_AddTimer("Timer_TortureGhoulEndAttack",3,"OnTimer_TortureGhoulEndAttack");
			mbTortureGhoulAttacking = true;
		}
		
		//-------------------------------------------------------
		
		void Prisoner_Die()
		{
			if (mbPrisonerIsDead) return;
				
			Sound_CreateAtEntity("Sound_PrisonerDie", "03_05_vitae_station/prisoner/prisoner_death", "Trigger_PokePrisoner",0);
			Entity_SetActive("Trigger_PokePrisoner", false);
			Sound_Stop("Sound_PrisonerBreathe",0.2f);
			Sound_Stop("Sound_PrisonerCry",0);
			Map_RemoveTimer("Timer_PrisonerWiggle");
			//Entity_PlayAnimation("prisoner", "cage_dead", 0.7f, false, false);
			Entity_SetActive("max_cistern_corpse_alive",false);
			Entity_SetActive("max_cistern_corpse_dead",true);
			FearHandler_SetForcedAddFearRate(0.5f,4,false);
			mbPrisonerIsDead = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TortureGhoulEndAttack(const tString &in asTimer)
		{
			mbTortureGhoulAttacking = false;
			Map_SetTimerPaused("Timer_FairchildDelirium",false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DelayFairchildDelirium(const tString &in asTimer)
		{
			if (mbFairchildLowered) return;
			
			Voice_Play("FairchildDelirium", -1, "VoiceOver_FairchildDelirium");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_TortureGhoul_Retreat(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Ghoul_Mode_Set(msTortureGhoul,eGhoulMode_Patrol);
				TortureGhoul_GoToPrisoner(true);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event B
		 
		/////////////////////////////////////////
		// Event C - PLAYER LOCKS THE GHOUL INTO A CELL
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		/*Put any variables that are only used in Scene 4, Event C here.*/
		
		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 4, Event C here.*/
		
		bool OnCollide_Spear_Sound(const tString &in asParent, const tString &in asChild, int alState)
		{			
			if (Entity_IsInteractedWith(asChild) == false) return true;
			
			tString sSound = (alState == 1) ? "03_05_vitae_station/prisoner/prisoner_spear_remove" : "03_05_vitae_station/prisoner/prisoner_spear_remove";
			FearHandler_SetForcedAddFearRate(0.4f,5,false);
			Sound_CreateAtEntity("Sound_Spear",sSound,asParent);
			
			return true;
		}

		bool OnCollide_TortureCell(const tString &in asParent, const tString &in asChild, int alState)
		{
			////////////////////////////////
			// Checks which entity leaves the main room (cell 0), enters a cell (1, 2, 3), or milking machine (4)
			
			int lCell = Entity_GetVarInt(asParent,"");
			
			if (alState == 1)
			{					
				if (asChild == "Player")	
					mlPlayerCell = lCell;
				else 						
					mlGhoulCell = lCell;
			}
			if (alState == -1) 
			{	
				if (asParent == "Trigger_TortureCell2_1" && Entity_GetCollide("player","Trigger_TortureCell2_2")) return true;
				
				if (asChild == "Player")
					mlPlayerCell = 0;
				else
				{
					mlGhoulCell = 0;
					
					if (Entity_IsInteractedWith("Torture_Wheel"))
					{
						Voice_StopAll();
						Voice_Play("Fairchild_StartWheelWithGhoul");
					}
				}
			}
			//Debug_Log("Player: "+mlPlayerCell+" - Ghoul: "+mlGhoulCell);
			return true;
		}

		//-------------------------------------------------------

		bool OnCollide_LockGhoul(const tString &in asParent, const tString &in asChild, int alState)
		{			
			int lCell = Entity_GetVarInt(asParent,"");
			
			if (alState == 1)
			{
				if (SwingDoor_GetOpenAmount("SwingDoor_TortureCell_"+lCell) <= 0.1f)
				{
					if (mlGhoulCell == lCell)
					{
						//Debug_Log("GHOUL IS LOCKED IN CELL "+lCell);
						LockGhoulInCell();
					}
					else {}
						//Debug_Log("CELL "+lCell+" LOCKED. NO GHOUL IN CELL "+lCell);
				}
			}
			
			if (alState != 1)
			{
				if (mlGhoulCell == lCell && SwingDoor_GetOpenAmount("SwingDoor_TortureCell_"+lCell) <= 0.1f)
				{
					UnlockGhoulInCell();
					Debug_Log("UNLOCK AND HUNT");
				}
			}
			
			return true;
		}

		//-------------------------------------------------------
		
		bool mbLockGhoulStinger = false;

		void LockGhoulInCell()
		{
			if (mlGhoulCell == 0) return;
			if (mbTortureGhoulEscaped) return;
			
			Map_RemoveTimer("Timer_GhoulLockTimeUp");
			Agent_SetSensesActive(msTortureGhoul,false);
			mbTortureGhoulLocked = true;
			
			if (mlGhoulCell == 1)
			{
				Ghoul_CommandPatrol_ClearNodes(msTortureGhoul);
				Ghoul_CommandPatrol_AddNode(msTortureGhoul,"PathNode_GhoulGoToPrisoner_9");
				Ghoul_CommandPatrol_Execute(msTortureGhoul,true,1,false,eGhoulSpeed_Run,"OnEndOfTrack_BangOnDoor");
			}
			else
			{
				Ghoul_CommandPatrol_ClearNodes(msTortureGhoul);
				Ghoul_CommandPatrol_AddNode(msTortureGhoul,"PathNode_Fairchild_84");
				Ghoul_CommandPatrol_Execute(msTortureGhoul,true,1,false,eGhoulSpeed_Run,"OnEndOfTrack_BangOnDoor");
			}
			
			if (mbLockGhoulStinger == false)
			{
				Music_Play("A2_3_5_ghoul_sighting.ogg",0.4f,false,eMusicPrio_AgentHunt);
				mbLockGhoulStinger = true;
			}
		}

		//-------------------------------------------------------
		
		void OnEndOfTrack_BangOnDoor(const tString &in asEntity)
		{
			Map_AddTimer("Timer_GhoulScreechAfterLocked",0,"OnTimer_GhoulScreechAfterLocked");
		}
		
		//-------------------------------------------------------
			
		void OnTimer_GhoulScreechAfterLocked(const tString &in asTimer)
		{
			mlGhoulScreeches--;
			
			CharMover_PlayAnimation(msTortureGhoul, "attack_close_1", 0.3f, false);
			
			if (mlGhoulScreeches > 0)
			{
				Map_AddTimer("Timer_GhoulScreechAfterLocked",cMath_RandRectf(1.5f,2.0f),"OnTimer_GhoulScreechAfterLocked");
				ParticleSystem_CreateAtEntity("PS_DoorBash_tmp", "dust_impact_simple_oneshot.ps", "SwingDoor_TortureCell_"+mlGhoulCell, false);
				Sound_CreateAtEntity("Sound_GhoulDoorHit", "03_05_vitae_station/ghoul_events/ghoul_door_hit_stone", "SwingDoor_TortureCell_"+mlGhoulCell);
			}
			else
			{
				if (mlGhoulCell == 1)
				{
					// Ghoul kills prisoner and leaves
					//Entity_SetActive(msTortureGhoul,false);
					//TortureGhoul_KillPrisoner();
				}
				//TortureGhoul_KillPrisoner();
				if (SwingDoor_GetBlocked("SwingDoor_TortureCell_"+mlGhoulCell) == false)
				{	
					Sound_CreateAtEntity("Sound_GhoulDoorHit", "03_05_vitae_station/ghoul_events/ghoul_door_hit_stone", "SwingDoor_TortureCell_"+mlGhoulCell);
					SwingDoor_PushOpen("SwingDoor_TortureCell_"+mlGhoulCell,3,1);
					mlGhoulScreeches = 4;
				}
				else
				{
					Map_AddTimer("Timer_GhoulEscapeAfterLocked",2,"OnTimer_GhoulEscapeAfterLocked");
				}
				
				Sound_CreateAtEntity("Sound_GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_spot", msTortureGhoul);
				
			}
		}

		//-------------------------------------------------------

		void OnTimer_GhoulEscapeAfterLocked(const tString &in asTimer)
		{
			if (mbTortureGhoulEscaped) return;
			
			mbTortureGhoulEscaped = true;
			FearArea_SetGivesFear("Fear_NoFear_MilkingRoom",false);
			Agent_SetSensesActive(msTortureGhoul,false);
			cLux_AddAIDebugMessage("Ghoul Network: "+"GhoulHole_Cell"+mlGhoulCell+"*");
			Ghoul_SetHoleNetwork(msTortureGhoul,"GhoulHole_Cell"+mlGhoulCell+"*","","");
			Ghoul_Command_Remove(msTortureGhoul,true);
			Ghoul_CommandGoToHole_Execute(msTortureGhoul,Map_GetEntity(msTortureGhoul).GetPosition(),true,false,true,true,eGhoulSpeed_FastWalk);
			Map_RemoveTimer("Timer_TortureGhoulCheckState");
		}

		//-------------------------------------------------------

		void UnlockGhoulInCell()
		{
			if (mbTortureGhoulEscaped) return;
				
			Map_RemoveTimer("Timer_GhoulEscapeAfterLocked");
			Map_RemoveTimer("Timer_GhoulScreechAfterLocked");
			
			if (mlGhoulCell == 0) return;
				
			// Ghoul should now attack the player as they did not wait
			mlGhoulScreeches = 0;
			Agent_SetSensesActive(msTortureGhoul,true);
			//Ghoul_Mode_Set(msTortureGhoul,eGhoulMode_Hunt,true);
			TortureGhoul_GoToFairchild(true);
			//cScript_RunGlobalFunc(msTortureGhoul, "cScrAgentGhoul", "_Global_ForceHunt");
			mbTortureGhoulLocked = false;
		}		 
		
		//-------------------------------------------------------

		void OnTimer_FairchildDelirium(const tString &in asTimer)
		{
			if (mbFairchildLowered || mbFairchildAttacked || (cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Wheel)) return;
			if (Voice_SceneIsActive("Fairchild"))
			{
				VoiceOver_FairchildDelirium();
				return;
			}
			Voice_Play("FairchildDelirium", -1, "VoiceOver_FairchildDelirium");
		}

		//-------------------------------------------------------

		void VoiceOver_FairchildDelirium(const tString&in asScene="", const tString&in asSubject="")
		{		
			if (!mbFairchildLowered && !mbTortureGhoulAttacking && Entity_IsInteractedWith("Torture_Wheel") == false)
			{
				Fairchild_ManageInteraction();
				Map_AddTimer("Timer_FairchildDelirium", cMath_RandRectf(10, 20), "OnTimer_FairchildDelirium");
			}
		}
		 
		//-------------------------------------------------------
	 
		//} END Event C
		 
		/////////////////////////////////////////
		// Event D - PLAYER TRIES TO FREE FAIRCHILD
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
		
		/*Put any variables that are only used in Scene 4, Event D here.*/
		
		float mfMinTortureWheelAngle = -10;
		float mfPrevTortureWheelAngle = -1;
		float mfTortureWheelTimer = 0.01f;
		bool mbTortureWheelInteracted = false;
		bool mbTortureWheelRotationStarted = false;
		bool mbTortureWheelRotating = false;
		bool mbTortureWheelUnrolling = false;
		bool mbFairchildLowered = false;
		bool mbFairchildAwake = false;
		bool mbFairchildLeft = false;		
	 
		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 4, Event D here.*/
		 
		bool OnCollide_Player_FairchildCloseProximity(const tString &in asParent, const tString &in asChild, int alState)
		{	
			// TO DO: Perhaps think of having a LookAt condition, so that it doesn't feel like tasi is talking to nothing?
			
			if (mlGhoulCell == 0) return true;
			if (mbTortureGhoulAlerted) return true;
			
			if (alState == 1)
			{
				if (mbTortureGhoulLocked)
				{
					Voice_Stop("FairchildDelirium");
					if (Map_TimeHasPassed("Timer_Reassure",30))
						Voice_Play("Fairchild_Reassure");
					return true;
				}
				else
				{
					if (!mbFairchildAwake)
					{
						// TO DO: HOW TO MAKE VOICES OVERLAP? DON'T WANNA STOP DELIRIUM ABRUPTLY
						Map_AddTimer("Timer_WakeFairchild",0,"OnTimer_WakeFairchild");	
					}
					else
					{
						if (mbFairchildLeft)
						{
							//Voice_StopAll();
							Voice_Play("Fairchild_TasiReturns",-1,"OnEndOfVoice_FairchildInteractable");
							Entity_SetInteractionDisabled("Fairchild",true);		
						}
					}
				}
				mbFairchildLeft = false;
				Map_RemoveTimer("Timer_FairchildHeadTracker_PickTarget");
				Map_RemoveTimer("Timer_FairchildLeft");
				HeadTracker_SetTargetEntity("Fairchild","player");
				HeadTracker_SetMaxSpeed("Fairchild",15);
				HeadTracker_SetSpeedMul("Fairchild",5);
			}
			else
			{
				Map_RemoveTimer("Timer_WakeFairchild");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_WakeFairchild(const tString &in asTimer)
		{
			if (Entity_IsInPlayerFOV("Fairchild"))
			{
				Voice_StopAll();
				Voice_PlayDelayed("Fairchild_Wakes",.5f,-1,"OnEndOfVoice_FairchildInteractable");
				Entity_SetInteractionDisabled("Fairchild",true);
				mbFairchildAwake = true;
			}
			else
				Map_RestartCurrentTimer(.1f);
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_FairchildFarProximity(const tString &in asParent, const tString &in asChild, int alState)
		{	
			// TO DO: Perhaps think of having a LookAt condition, so that it doesn't feel like tasi is talking to nothing?
			if (mbFairchildLowered) return true;
			if (mlGhoulCell == 0) return true;
			if (mbTortureGhoulAlerted) return true;
			
			if (alState == -1) 
			{
				if (mbFairchildAwake)
				{
					mbFairchildLeft = true;
					Map_AddTimer("Timer_FairchildHeadTracker_PickTarget",6,"OnTimer_FairchildHeadTrackerPickTarget");
					Map_AddTimer("Timer_FairchildLeft",15,"OnTimer_FairchildLeft");
					
					if (mbFairchildInPain == false) 
						Voice_Play("Fairchild_TasiLeaves");
					
				}	
			}
			
			return true;
		}
		
		bool mbFairchildInPain = false;
		
		//---------------------------------------------------
		
		void OnTimer_FairchildLeft(const tString &in asTimer)
		{	
			Debug_Log("TIMER FAIRCHILDLEFT "+asTimer);
			if (mbFairchildLowered) return;
			if (mbFairchildLeft) return;
			
			if (mbFairchildInPain) 
				Map_RestartCurrentTimer(15);
				
			if (mlPlayerCell == 0)
			{
				if (!Entity_IsInteractedWith("Torture_Wheel"))
				{
					Voice_StopAll();
					Voice_Play("Fairchild_TasiHasLeftButNear",-1,"OnEndOfVoice_FairchildInteractable");
				}
			}
			else
			{
				Voice_StopAll();
				Voice_Play("Fairchild_TasiHasLeftButFar",-1,"OnEndOfVoice_FairchildInteractable");
			}
			
			Entity_SetInteractionDisabled("Fairchild",true);
			Map_RestartCurrentTimer(cMath_RandRectf(5,10));
		}
		
		//--------------------------------------------------------
		
		int mlFairchildLines = 0;
		int mlFairchildLinesGhoulLocked = 0;
				
		void OnInteract_FairchildTalk(const tString &in asEntity)
		{
			if ((Voice_SubjectIsPlaying("Dialogue_FairchildInteractDanger")) ||
				(Voice_SubjectIsPlaying("Dialogue_FairchildInteractSafe")) ||
				(Voice_SubjectIsPlaying("Fairchild_Wakes")) ||
				(Voice_SubjectIsPlaying("Fairchild_Reassure")))
				return;
				

			Voice_StopAll();
			if (mbTortureGhoulLocked)
			{
				Voice_Play("Dialogue_FairchildInteractSafe",-1,"OnEndOfVoice_FairchildInteractable");
				mlFairchildLinesGhoulLocked++;
			}
			else
			{
				Voice_Play("Dialogue_FairchildInteractDanger",-1,"OnEndOfVoice_FairchildInteractable");
				mlFairchildLines++;
			}
			Entity_SetInteractionDisabled("Fairchild",true);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfVoice_FairchildInteractable(const tString &in asScene, const tString &in asSubject)
		{
			Fairchild_ManageInteraction();
		}  
		
		void Fairchild_ManageInteraction()
		{
			if (mbTortureGhoulLocked && mlFairchildLinesGhoulLocked >= Voice_GetSubjectLineNumber("Dialogue_FairchildInteractSafe")) return;
			if (!mbTortureGhoulLocked && mlFairchildLines >= Voice_GetSubjectLineNumber("Dialogue_FairchildInteractDanger")) return;
			
			NPC_SetCanBeTalkedTo("Fairchild",true);
			Entity_SetInteractionDisabled("Fairchild",false);
		}
		
		//--------------------------------------------------------
		
		bool OnCollide_Player_TortureWheelActive(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				Entity_SetInteractionDisabled("Torture_Wheel",false);
			else
				Entity_SetInteractionDisabled("Torture_Wheel",true);

			return true;
		}
		
		//--------------------------------------------------------
		
		void Fairchild_PlayIdle()
		{
			// TO DO: Duplicate of TortureEncounter_AnimToIdle
			
			Entity_PlayAnimation("Fairchild","tdevice_fairchild_idle",0.1f,true);
			Entity_PlayAnimation("Torture_Chains","tdevice_chains_idle",0.1f,true);
			Entity_PlayAnimation("Torture_Rack","tdevice_idle",0.1f,true);
		}
		
		//--------------------------------------------------------
		
		void Fairchild_Lower()
		{
			if (mbFairchildLowered) return;
			
			Wheel_SyncEntityAnimation("Torture_Wheel","Fairchild","tdevice_fairchild_lower",1.f);
			Wheel_SyncEntityAnimation("Torture_Wheel","Torture_Rack","tdevice_lower",1.f);
			Wheel_SyncEntityAnimation("Torture_Wheel","Torture_Chains","tdevice_chains_lower",1.f);
		}
		
		//--------------------------------------------------------
		
		void OnInteract_TortureWheel(const tString &in asEntity)
		{
			mbTortureWheelInteracted = true;
			if (Entity_IsActive(msTortureGhoul)) FearHandler_SetPermaFailEnabled(false);
			cLux_GetPlayer().AutomoveCharBodyTo(20.0f, 4.0f, 20.0f, Map_GetEntity("PosArea_WheelInteract").GetPosition());
			Player_StartLookAt("Torture_Wheel", 10.f, 5.f, 10.0f, true);
			Player_SetMoveSpeedMul(0.0f);
			Player_SetCrouching(false);
			Player_SetCrouchDisabled(true);
			
			iPhysicsJoint@ pJoint = cLux_GetCurrentMap().GetPhysicsWorld().GetJoint(asEntity+"_JointHinge_1");
			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
			mfPrevTortureWheelAngle = pHinge.GetAngle();
			
			Map_RemoveTimer("Timer_TortureWheelInteractedReset");
			Map_AddTimer(asEntity, mfTortureWheelTimer, "OnTimer_TortureWheelCheckAngle");
		}
		
		//------------------------------------------------------- 
		
		void OnInteractLeave_TortureWheel(const tString &in asEntity)
		{
			FearHandler_SetPermaFailEnabled(true);
			Player_SetMoveSpeedMul(1.0f);
		}
		
		//--------------------------------------------------------
		 
		void OnTimer_TortureWheelCheckAngle(const tString &in asTimer)
		{			
			
			iPhysicsJoint@ pJoint = cLux_GetCurrentMap().GetPhysicsWorld().GetJoint(asTimer+"_JointHinge_1");
			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
			
			float fTortureWheelMaxAngle = pHinge.GetMaxAngle();
			tString sMax = fTortureWheelMaxAngle;
			
			float fWheelRotationAmount = Wheel_GetRotationAmount(asTimer);
			
			/////////////////////////
			// Calculate angle and difference
			float fTortureWheelAngle = pHinge.GetAngle();
			float fDiff = cMath_GetAngleDistanceRad(fTortureWheelAngle, mfPrevTortureWheelAngle);
			mfPrevTortureWheelAngle = pHinge.GetAngle();
						
			if 	(fDiff == 0)
			{
				// Player Holding the wheel still
				mbTortureWheelRotating = false;
			}
			else
			{
				if (!mbTortureWheelRotationStarted && Entity_IsInteractedWith(asTimer))
				{
					Entity_PlayAnimation("Fairchild","tdevice_fairchild_idle_layer",0.1f,true);
					Entity_StopSpecificAnimation("Fairchild","tdevice_fairchild_idle");
					Entity_StopSpecificAnimation("Torture_Rack","tdevice_idle");
					Entity_StopSpecificAnimation("Torture_Chains","tdevice_chains_idle");
					mbTortureWheelRotationStarted = true;
				}
				
				if (!mbTortureWheelRotating)	//so it triggers once
				{
					Debug_Log("BANG");
					//Sound_CreateAtEntity("Sound_TortureRackStart", "03_05_vitae_station/fairchild/torture_rack/torture_rack_decend_start", "SoundArea_TortureDevice");
					Sound_CreateAtEntity("Sound_TortureRackMove", "03_05_vitae_station/fairchild/torture_rack/torture_rack_move", "SoundArea_TortureDevice");
					Sound_CreateAtEntity("Sound_TortureRackStart2", "03_05_vitae_station/TEMP/stomping_gate_start", "SoundArea_TortureDevice");
					
					Map_SetTimerPaused("Timer_FairchildDelirium",true);
					if (Entity_IsActive(msTortureGhoul))
					{
						if (mbTortureGhoulAlerted && mlGhoulCell != 3)
						{
							//Voice_Play("Fairchild_StartWheelWithGhoul",-1,"OnEndOfVoice_FairchildInteractable");
							Entity_SetInteractionDisabled("Fairchild",true);
						}
						else
						{
							Voice_StopAll();
							if (mbTortureGhoulLocked)
							{
								Voice_Play("Fairchild_StartWheel",-1,"OnEndOfVoice_FairchildInteractable");
							}
							else
							{
								Voice_Play("Fairchild_StartWheelWithGhoul",-1,"OnEndOfVoice_FairchildInteractable");
								Map_AddTimer("Timer_AlertTortureGhoul",2,"OnTimer_AlertTortureGhoul");
								// Alert ghoul
							}
							Entity_SetInteractionDisabled("Fairchild",true);
						}
					}
					
					if (!mbTortureGhoulLocked)
						Entity_SetActive("Fear_WheelTension",true);
						
					mbTortureWheelRotating = true;
				}
				
				Debug_Log("Diff: "+fDiff);
				
				if (fDiff < 0)
				{
					Sound_CreateAtEntity("SoundTortureWheelClunk", "03_05_vitae_station/fairchild/torture_rack/torture_wheel_clunk", "Torture_Wheel");
				}
				else
				{
					if (!Sound_Exists("Sound_TortureRackMove"))
						Sound_CreateAtEntity("Sound_TortureRackMove", "03_05_vitae_station/fairchild/torture_rack/torture_rack_move", "SoundArea_TortureDevice");
				}
				
				if (fWheelRotationAmount < .2f && !Sound_Exists("Sound_TortureRackGrind2"))
				{
					Sound_CreateAtEntity("Sound_TortureRackGrind2", "03_05_vitae_station/TEMP/stomping_gate_grind", "SoundArea_TortureDevice");
					Debug_Log("Sound created");
				}
			}
			
			if (Entity_IsInteractedWith(asTimer))
			{
				/////////////////////////
				// Repeat the angle check
				if (fWheelRotationAmount <= .99)
				{
					mbTortureWheelUnrolling = false;
					Map_RestartCurrentTimer();
				}
				else
				{
					/////////////////////////
					// Fairchild is lowered
					mbFairchildLowered = true;
					mbTortureWheelInteracted = false;
					mbTorturingFairchild = false;
					
					Voice_StopAll();
					Map_RemoveTimer("Timer_FairchildDelirium");
					Map_RemoveTimer("Timer_FairchildScreamsForPain");
					Map_RemoveTimer("Timer_FairchildLeft");
					Sound_Stop("Sound_TortureRackMove", 1.0);
					Sound_Stop("Sound_TortureRackGrind2",0.3f);
					
					Sound_CreateAtEntity("Sound_TortureRackStop", "Sound_CreateAtEntity()03_05_vitae_station/TEMP/stomping_gate_start", "SoundArea_TortureDevice");
					
					
					Entity_SetActive("Trigger_TortureWheelActive",false);
					Player_SetInteractionAllowed(false);
					Entity_SetInteractionDisabled(asTimer,true);
					Map_RemoveTimer(asTimer);
					Player_SetInteractionAllowed(true);
					
					Entity_SetActive(msTortureGhoul,false);
					
					Player_SetCrouching(false);
					FairchildAttack_Start();
					
					return;
				}
			
				///////////////////////////
				// Teleport ghoul if the player lured the Ghoul to the milking area
				if (mlGhoulCell == 4)
				{
					SwingDoor_PushOpen("Door_TortureRoom_Entrance",3,3,0.01f);
					Agent_TeleportFeetToEntity(msTortureGhoul,"PosArea_GhoulTeleportToEntrance");
				}
			}
			else		// Player is not interacting with Wheel
			{		
				cLux_GetPlayer().StopAutomoveCharBody();
				Player_SetMoveSpeedMul(1.0f);
				Player_SetCrouchDisabled(false);
				
				if (mbTortureGhoulAlerted == false) Map_RemoveTimer("Timer_AlertTortureGhoul");
				
				/////////////////////////
				// Stop and Rotate back to original position, if wheel didn't reach Max pos
				if (fWheelRotationAmount <= 0.02f)
				{
					mbTortureWheelRotationStarted = false;
					mbTortureWheelUnrolling = false;
					Debug_Log("Reached MIN");
					Map_RemoveTimer(asTimer);
					Sound_Stop("Sound_TortureRackGrind2",0.3f);
				}
				else
				{
					if (mbTortureWheelUnrolling == false)
					{
						TortureWheel_Unroll();
						Entity_SetActive("Fear_WheelTension",false);
						// TO DO: Sound should be played when the wheel is at min position
						if (Entity_IsActive(msTortureGhoul) && mlGhoulCell == 3 && !Voice_SubjectIsPlaying("Fairchild_TasiStopsRescue") && !Voice_SubjectIsPlaying("Fairchild_StartWheel"))
							Voice_Play("Fairchild_TasiStopsRescue"); 
					}
					Map_RestartCurrentTimer();
				}
				
				
			}
			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_AlertTortureGhoul(const tString &in asTimer)
		{
			TortureGhoul_AlertedByWheel();
		}
		
		//-------------------------------------------------------
		
		void TortureWheel_Unroll()
		{
			tString sWheel = "Torture_Wheel";
			mbTortureWheelUnrolling = true;
			mbTortureWheelInteracted = false;
			mbTortureWheelRotationStarted = false;
			bool bScream = (Wheel_GetRotationAmount(sWheel)) > 0.5f ? true : false;
			
			Fairchild_SnapBack(bScream);
			Entity_StopSpecificAnimation("Fairchild","tdevice_fairchild_idle_layer");
			
			if (mbTortureWheelRotating)
			{
				Sound_CreateAtEntity("TortureRackRelease", "03_05_vitae_station/fairchild/torture_rack/fairchild_wheel_release", "SoundArea_TortureDevice");
				Sound_CreateAtEntity("Sound_HeavyBreathing", "03_05_vitae_station/fairchild/fairchild_hanging_pain", "SoundArea_Fairchild");
				Sound_Stop("Sound_TortureRackMove", 1.0);
				mbTortureWheelRotating = false;
			}
			
			Entity_SetInteractionDisabled("Torture_Wheel",true);
			
			Map_AddTimer("Timer_TortureWheelInteractedReset",5,"OnTimer_TortureWheelInteractedReset");
			Map_SetTimerPaused("Timer_FairchildDelirium",false);
					
			
			iPhysicsJoint@ pJoint = cLux_GetCurrentMap().GetPhysicsWorld().GetJoint(sWheel+"_JointHinge_1");
			iPhysicsJointHinge@ pHinge = cPhysics_ToJointHinge(pJoint);
			float fMinAngle = pHinge.GetMinAngle();
			float fAngle = pHinge.GetAngle();
			Wheel_SetAngle(sWheel,fMinAngle,true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TortureWheelInteractedReset(const tString &in asTimer)
		{
			mbTortureWheelInteracted = false;
		}
		
		//-------------------------------------------------------
		
		void Fairchild_SnapBack(bool abScream)
		{
			mbFairchildInPain = true;
			
			
			if (abScream)
			{
				Entity_PlayAnimation("Fairchild","tdevice_fairchild_snap",0.1f,false,true,"OnEndOfAnimation_FairchildScream");
				Map_AddTimer("Timer_FairchildPastPain",20,"OnTimer_FairchildPastPain");
				Map_AddTimer("Timer_SnapSfx",0.4f,"OnTimer_SnapSfx");
				Map_SetTimerUserVarInt("Timer_SnapSfx",1);
			}
			else
			{
				Entity_PlayAnimation("Fairchild","tdevice_fairchild_snap",0.1f,false,true,"OnEndOfAnimation_FairchildIdle");
				Sound_CreateAtEntity("Sound_ScreamSmall","03_05_vitae_station/fairchild/fairchild_hanging_pain","Fairchild");
				Map_AddTimer("Timer_FairchildPastPain",15,"OnTimer_FairchildPastPain");
				Map_SetTimerUserVarInt("Timer_SnapSfx",0);
			}
			
			Entity_PlayAnimation("Torture_Chains","tdevice_chains_snap",0.1f);
			Entity_PlayAnimation("Torture_Rack","tdevice_snap",0.1f);
			
			
			
		}
		
		void OnTimer_SnapSfx(const tString &in asTimer)
		{
			int lScream = Map_GetTimerUserVarInt(asTimer);
			
			if (lScream == 1)
				Sound_CreateAtEntity("Sound_GoreBig","03_05_vitae_station/fairchild/fairchild_rack_hand_spike_large" ,"Fairchild");
			else
				Sound_CreateAtEntity("Sound_GoreSmall","03_05_vitae_station/fairchild/fairchild_rack_hand_spike_small" ,"Fairchild");
		}
		
		void OnTimer_FairchildPastPain(const tString &in asTimer)
		{
			mbFairchildInPain = false;
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnimation_FairchildScream(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_PlayAnimation("Fairchild","tdevice_fairchild_scream",0.1f,false,true,"OnEndOfAnimation_FairchildIdle");
			Entity_PlayAnimation("Torture_Chains","tdevice_chains_scream",0.1f);
			Entity_PlayAnimation("Torture_Rack","tdevice_scream",0.1f);
			Sound_CreateAtEntity("Sound_ScreamBig","03_05_vitae_station/fairchild/fairchild_rack_pain","Fairchild");
			
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnimation_FairchildIdle(const tString &in asEntityName, const tString &in asAnimName)
		{
			Sound_CreateAtEntity("Sound_ScreamSmall","03_05_vitae_station/fairchild/fairchild_hanging_pain","Fairchild");
			Entity_SetInteractionDisabled("Torture_Wheel",false);
			Fairchild_PlayIdle();
		}
	
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceRevealPisoner;
		void Seq_RevealPrisoner(const tString &in asTimer)
		{
			Sequence_Begin("Seq_RevealPrisoner",mSequenceRevealPisoner);
			if (Sequence_DoStepAndWait(1))
			{
				Sound_CreateAtEntity("Sound_PrisonerSpotted","03_05_vitae_station/prisoner/prisoner_spotted","prisoner",0);
			    Entity_SetActive("prisoner", true);
			    Entity_PlayAnimation("prisoner", "cage_appear", 0, false, false);
			}	
			else if (Sequence_DoStepAndWait(0.5f))
			{
			    Entity_PlayAnimation("prisoner", "cage_loop", 0.7f, true, false);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event D
		 
		/////////////////////////////////////////
		// Event E - FAIRCHILD ATTACKS THE PLAYER, INNER GHOUL TAKES OVER
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		/*Put any variables that are only used in Scene 4, Event E here.*/
		
		float mfBlackScreenTime = 6;
		float mfTasiBreatheAmount = 0;
		float mfTasiBreatheAmountMax = 4;
		
		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 4, Event E here.*/
		
		void FairchildAttack_Start()
		{
			FearHandler_SetPermaFailEnabled(false);
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			Map_AddTimer("Timer_FairchildSequenceDelay",0.0f,"OnTimer_FairchildSequenceDelay");
		}
				
		void OnTimer_FairchildSequenceDelay(const tString &in asTimer)
		{
			Seq_FairchildAttack("");
		}
		
		//--------------------------------------------------------
		
		void OnAnimMessage_FairchildRumble(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			cLux_AddDebugMessage("HJHHJH");
				if (alMessageEventID == 0) // Shackle
				{
					Effect_Rumble_Start(0.1f,0.3f);
				}
				if (alMessageEventID == 10) // Shackle
				{
					Effect_Rumble_Start(0.1f,0.3f);
				}
				else if (alMessageEventID == 1) // Shackle free
				{
					Effect_Rumble_Start(0.3f,0.2f);
				}
				else if (alMessageEventID == 2) // Punch 1
				{
					Effect_Rumble_Start(0.5f,0.3f);
				}
				else if (alMessageEventID == 3) // Push Leg
				{
					Effect_Rumble_Start(0.1f,0.5f);
				}
				else if (alMessageEventID == 4) // Leg down
				{
					Effect_Rumble_Start(0.3f,0.3f);
				}
				else if (alMessageEventID == 5) // Shackle free
				{
					Effect_Rumble_Start(0.5f,0.3f);
				}
				else if (alMessageEventID == 6) // Shackle free
				{
					Effect_Rumble_Start(1.f,0.3f);
				}
			
		}
		
		cSequenceStatesData mSequenceFairchildAttack;
		void Seq_FairchildAttack(const tString &in asTimer)
		{
			Sequence_Begin("Seq_FairchildAttack", mSequenceFairchildAttack);
			if (Sequence_DoStepAndWaitUntil(8.2f))
			{
				Voice_StopAll();
				Music_StopAll(5.0f);
				Voice_Play("Fairchild_Free_Scene");
				
				Sound_CreateAtEntity("Sound_FairchildFreeTasi","game_voice/voice/03_05_vitae_station_kill_fairchild_TASI_001","player");
				Sound_CreateAtEntity("Sound_FairchildFree","game_voice/voice/03_05_vitae_station_kill_fairchild_FAIRCHILD_001","Fairchild");
				
				// From this point onward, show the max ghoul level texure during permafails
				GhoulProgression_SetPermafailFadeProgression(GhoulProgression_GetMaxProgression());
				
				Player_SetCanUseLightSource(false);
				Player_SetLookSpeedMul(0.6f);
				SlideLock_SetOpenAmount("tin_hinan_door_lock_1",0);
				SwingDoor_SetOpenAmount("Door_TortureRoom_Entrance",1);
				Entity_SetActive("Fairchild",false);
				Entity_SetActive("InteractAux_Fairchild",false);
				Entity_SetAnimationMessageEventCallback("FairchildAttack","OnAnimMessage_FairchildRumble",false);
				Entity_SetActive("FairchildAttack",true);
				
				
				//Play animations
				Entity_StopAnimation("Torture_Rack");
				Entity_StopAnimation("Torture_Chains");
				Entity_StopAnimation("FairchildAttack");
				Entity_PlayAnimation("Torture_Rack","tdevice_release",0.1f);
				Entity_PlayAnimation("Torture_Chains","tdevice_chains_release",0.1f, false, false);
				Entity_PlayAnimation("FairchildAttack","vitae_4d_attack_fairchild",0.1f,false,true,"Animation_FairchildEscape");
				
				PlayerBody_PlayCutsceneAtEntity("vitae_4d_attack_player","PosArea_TasiCutscene",false,0.6f,"Animation_TasiEscape",1,0,0,0,true);
				//PlayerBody_PlayCutsceneAnimation("vitae_4d_attack_player",false,0.3f,"Animation_TasiEscape");
				
				Sound_CreateAtEntity("Sound_Shackle", "03_05_vitae_station/fairchild/death/shackle_01", "Fairchild");
				Sound_CreateAtEntity("Sound_Stinger1", "03_05_vitae_station/fairchild/death/stinger/stinger_01", "player");
				
			}
			//FIRST PUNCH
			else if (Sequence_DoStepAndWait(0.1f))
			{
				//Effect_Fade_Out(0.1f);
				
				Sound_CreateAtEntity("Sound_FoleyFairchild1", "03_05_vitae_station/fairchild/death/foley/foley_fairchild_01", "Fairchild");
				Sound_CreateAtEntity("Sound_FoleyTasi1", "03_05_vitae_station/fairchild/death/foley/foley_tasi_01", "player");
				Sound_CreateAtEntity("Sound_Stinger2", "03_05_vitae_station/fairchild/death/stinger/stinger_02", "player");
				Music_Play("A2_3_5_Fairchild_Released.ogg", 0.3f, false, eMusicPrio_MinorEvent);
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				if (FearHandler_GetLevel() < 0.4f)
					FearHandler_FadeLevelTo(0.4f, 0.2f);
				idDoFEffect = Effect_DoF_Start(0, 0.2f, 1.0f, 0.1f);
			}
			else if (Sequence_DoStepAndWaitUntil(14.15f))
			{
				//Effect_Fade_In(0.4f);
				Effect_DoF_FadeOut(idDoFEffect,3.0f);
			}
			//SECOND PUNCH
			else if (Sequence_DoStepAndWait(0.2f))
			{
			    Entity_SetActive("fairchild_attack_rock", true);
				Lamp_SetLit("lamp_outsidetorture",true, true);
				idDoFEffect = Effect_DoF_Start(0, 0.2f, 1.0f, 0.1f);
				Effect_Fade_Out(0.1f);
				
				Sound_CreateAtEntity("Sound_FoleyFairchild2", "03_05_vitae_station/fairchild/death/foley/foley_fairchild_02", "Fairchild");
				Sound_CreateAtEntity("Sound_FoleyTasi2", "03_05_vitae_station/fairchild/death/foley/foley_tasi_02", "player");
				Sound_CreateAtEntity("Sound_Stinger3", "03_05_vitae_station/fairchild/death/stinger/stinger_03", "player");
			}
			else if (Sequence_DoStepAndWaitUntil(17.5f))
			{
				if (FearHandler_GetLevel() < 0.7f)
					FearHandler_FadeLevelTo(0.7f, 0.2f);
				Player_SetLookSpeedMul(0.4f);
				Effect_Fade_In(0.4f);
				Effect_DoF_FadeOut(idDoFEffect,1.5f);
			}
			//ROCK STRIKE
			else if (Sequence_DoStepAndWaitUntil(18.5f))
			{
				idDoFEffect = Effect_DoF_Start(0, 0.2f, 1.0f, 0.1f);
				Effect_Fade_Out(0.05f);
				
				FearHandler_PlayStruggleSoundLoop(3.0f, 0.2f, false);
			}
			//ESCAPE
			else if (Sequence_DoStepAndWait(0.5f))
			{
				FearHandler_SetLevelTo(0.8f);
				FearHandler_FadeLevelTo(0.95f,2);
				//Effect_Fade_In(0.4f);
				FearHandler_SetForcedAddFearRate(1,10,false,-1,-1,2);
				//Entity_PlayAnimation("FairchildAttack","vitae_4d_escape_fairchild");
				//PlayerBody_PlayCutsceneAtEntity("vitae_4d_escape_player","FairchildAttack",false,0.1f);

				Sound_CreateAtEntity("Sound_FoleyFairchild3", "03_05_vitae_station/fairchild/death/foley/foley_fairchild_03", "Fairchild");
				Sound_CreateAtEntity("Sound_Stinger4", "03_05_vitae_station/fairchild/death/stinger/stinger_04", "player");
				Sound_CreateAtEntity("Sound_StingerPlayer1", "03_05_vitae_station/fairchild/death/stinger/stinger_player_01", "player");
			}
			else if (Sequence_DoStepAndWaitUntil(22.0f))
			{
				Effect_ImageTrail_Start(1,0,-1,5);
				Effect_Fade_In(1.3f);
				Effect_DoF_FadeOut(idDoFEffect,1.5f);
				Player_SetLookSpeedMul(0.2f);
				
				Sound_CreateAtEntity("Sound_BrickDrop", "03_05_vitae_station/fairchild/death/brick_drop_01", "player");
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				FearHandler_PlayStruggleSoundLoop(5.0f, 0.4f, false);
				GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetPermafailFadeProgression(), 1.0f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Effect_Fade_Out(0.3f);
				Music_StopAll(5);
				Sound_CreateAtEntity("Sound_Stinger5", "03_05_vitae_station/fairchild/death/stinger/stinger_05", "player");
				Sound_CreateAtEntity("Sound_StingerPlayer2", "03_05_vitae_station/fairchild/death/stinger/stinger_player_02", "player");
				
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Effect_Fade_In(0.3f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Effect_Fade_Out(0.3f);
			}
			else if (Sequence_DoStepAndWait(2.6f))
			{
				Effect_Fade_In(0.3f);	
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				FearHandler_PlayStruggleSoundLoop(1.0f, 1.0f, false);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Seq_ChewAndStruggle("");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceChewAndStruggle;
			
		void Seq_ChewAndStruggle(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ChewAndStruggle", mSequenceChewAndStruggle);
			if (Sequence_DoStepAndWait(0.5f))
			{
				
				Debug_Log("FADEOUT LAST");
				Effect_Fade_Out(0.3f);
				Sound_CreateAtEntity("Sound_Stinger6", "03_05_vitae_station/fairchild/death/stinger/stinger_06", "player");
				Sound_CreateAtEntity("Sound_DeathGore", "03_05_vitae_station/fairchild/death/death_gore_01", "player");
				
				ParticleSystem_SetActive("PS_Attract_*",true);
				ParticleSystem_SetVisible("PS_Attract_*",true);
				ParticleSystem_SetActive("PS_MilkingMachine_Base_*", true);
				ParticleSystem_SetVisible("PS_MilkingMachine_Base_*", true);
				ParticleSystem_SetActive("PS_Back_MilkingMachine_*", true);
				ParticleSystem_SetVisible("PS_Back_MilkingMachine_*", true);
				ParticleSystem_SetActive("PS_milkmachinehighlight_*", true);
				ParticleSystem_SetVisible("PS_milkmachinehighlight_*", true);
				
				FearHandler_PlayStruggleSoundLoop(0.3f, 0.2f, false);
			}
			else if (Sequence_DoStepAndWait(4.f))
			{
				Effect_Rumble_Start(1,0.4f);
				Player_Teleport("Start_MilkingRoom_Abstract", true);
			}
			else if (Sequence_DoStepAndWait(0.9f))
			{
				mbFairchildAttacked = true;
				Map_SetFogActive(false);
				Entity_PlayAnimation("Fairchild_Dead","fairchild_milking_machine_attracted",0.1f,false);
				Entity_PlayAnimation("Fairchild_Chewed","fairchild_milking_machine_attracted",0.1f,false);
				PlayerBody_PlayCutsceneAtEntity("player_milking_machine_attracted","PosArea_Chewing",false,0.6f,"OnEndOfAnim_MilkingStruggle",1,0,0,0,true);
				//Map_AddTimer("Timer_FadeOutBeforeStruggleStarts",12.8f,"OnTimer_FadeOutBeforeStruggleStarts");
				Sound_CreateAtEntity("Sound_VitaeStart", "03_05_vitae_station/milking_machine/player_vitae_start", "player");
				Sound_CreateAtEntity("Sound_TempMachineStart", "03_05_vitae_station/milking_machine/temp_machine_start", "player");
			}
			else if (Sequence_DoStepAndWait(0.6f))
			{
				Effect_Fade_In(0.3f);
				//Entity_PlayAnimation("machine_milking_2", "machine_milking_open", 0.1f, false, false);
				Sound_CreateAtEntity("Sound_TasiBreathe", "player/vocalisations/temp/temp_ghoul_vocal", "player");
				//Struggle_StartMoveTowards("TriggerArea_Milking", "TriggerArea_Milking", "", "", "", 8.6f, false);
				Music_Play("A2_3_5_Tasi_Vitae.ogg", 0.15f, true, eMusicPrio_MinorEvent);
			}
			else if (Sequence_DoStepAndWait(3.5f))
			{
				tString sPlayer = PlayerBody_GetEntityName();
				Entity_SetEffectsActive(sPlayer,true,true);
				Effect_Rumble_Start(0.5f,4.6f,1,3);
			}
			else if (Sequence_DoStepAndWait(3.3f))
			{
				Effect_DollyZoom_Start(-0.6f,3.5f,3,3);
				Entity_PlayAnimation("machine_milking_2", "machine_milking_open", 0.1f, false, false);
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				Effect_Fade_Out(0.2f);
			}
			else if (Sequence_DoStepAndWait(4.6f))
			{
				Effect_Fade_In(0.3f);
			}
			else if (Sequence_DoStepAndWait(0.7f))
			{
				Effect_Fade_Out(0.2f);
			}
			else if (Sequence_DoStepAndWait(3.6f))
			{
				Debug_Log("FADE OUT");
			    ParticleSystem_SetVisible("PS_milkmachinehighlight_*", false);
			    Entity_SetActive("machine_milking_inside_small", false);
			    Entity_SetActive("machine_milking_inside", true);
				
				Effect_Fade_In(0.15f);
				//Effect_DollyZoom_Start(-0.3,10,5);
			}
		
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeOutBeforeStruggleStarts(const tString &in asTimer)
		{
			Effect_Fade_Out(0.3f);
		}
		
		//--------------------------------------------------------
		
		void Animation_FairchildEscape(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_PlayAnimation("FairchildAttack","vitae_4d_escape_fairchild");
		}
		
		//--------------------------------------------------------
		
		void Animation_TasiEscape(const tString &in asAnimName)
		{
			PlayerBody_PlayCutsceneAtEntity("vitae_4d_escape_player","PosArea_TasiCutscene",false,0.3f,"",1,0,0,0,true);
		}
		
		void OnEndOfAnim_MilkingStruggle(const tString &in asAnimName)
		{
			Map_AddTimer("Timer_StruggleMilkingMachine",0.1f,"OnTimer_StruggleMilkingMachine");
		}
		
		//--------------------------------------------------------
	 
		 //} END Event E
		 
		 
		/////////////////////////////////////////
		// EVENT F - PLAYER WAKES UP AMONG CORPSES IN A CELL (DEATH SCENARIO)
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event F here.*/
		
		bool mbTortureGhoulKilledPlayer = false;

		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 4, Event F here.*/
		
		void DeathScenario_OnDeath_PlayerWakesUpInCell(const tString &in asSource)
		{
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			Agent_SetSensesActive(msTortureGhoul,false);
			Death_PickRespawnArea("Death_Cell");
			Effect_Fade_Out(1.0f);
			Map_AddTimer("Timer_DelayedRespawn",1.0f,"OnTimer_DelayedRespawn");
		}
		
		//-------------------------------------------------------
		
		bool DeathScenario_OnRespawn_PlayerWakesUpInCell(const tString &in asSource)
		{
			Entity_SetActive(msTortureGhoul,false);
			msTortureGhoul = "Ghoul_TortureGuy_2";
			Entity_SetActive(msTortureGhoul,true);
			Agent_SetSensesActive(msTortureGhoul,true);
			Ghoul_CommandPatrol_ClearNodes(msTortureGhoul);
			for (int i = 1; i <= 13; i++)
				Ghoul_CommandPatrol_AddNode(msTortureGhoul,"PathNode_GhoulGoToPrisoner_"+i);
			Ghoul_CommandPatrol_Execute(msTortureGhoul,true,1,false,eGhoulSpeed_FastWalk,"OnEndOfTrack_TorturePrisoner");
			Player_SetRunSpeedMul(1);
			mbTortureGhoulKilledPlayer = true;
			return false;
		}

		//-------------------------------------------------------

		//} END EVENT F
		
		/////////////////////////////////////////
		// EVENT G - PLAYER IS STRAPPED TO A TORTURE DEVICE (DEATH SCENARIO)
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event G here.*/
		
		int mlHangingLookAtCount = 0;
		int mlLooksAmount = 6;

		//-------------------------------------------------------
		
		/*Put any functions that are only used in Scene 4, Event G here.*/ //
		
		void DeathScenario_OnDeath_PlayerOnTortureDevice(const tString &in asSource)
		{
			//todo: fall back to default fadeout
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			Effect_Fade_Out(1.0f);
			Map_AddTimer("Timer_DelayedRespawn",1.0f,"OnTimer_DelayedRespawn");
			Death_PickRespawnArea("Death_Trap");
		}
		
		//---------------------------------------------
		
		bool DeathScenario_OnRespawn_PlayerOnTortureDevice(const tString &in asSource)
		{
			Prisoner_Die();
			//Death_ResetPlayerToNormal();
			Map_AddTimer("Timer_DelayHanging",2.0f,"OnTimer_DelayHanging");
			Entity_SetActive(msTortureGhoul,false);
			
			return false;
		}
		
		//---------------------------------------------
		
		void OnTimer_DelayHanging(const tString &in asTimer)
		{
			Effect_Fade_In(2.0);
			Player_SetCrouching(true,true,true);
			SetupHanging();
		}
		
		//---------------------------------------------
		
		void SetupHanging()
		{
			Player_Teleport("Start_TortureRoom_Trap");
			Entity_SetActive(msTortureGhoul,false);
			/*Entity_SetActive("corpse_eaten_static_10",true);
			Entity_AttachToEntity("Camera_Hanging_1","corpse_eaten_static_10","",true);
			Map_AddTimer("Timer_HangingImpulse",2.0f,"OnTimer_HangingImpulse");
			CameraAnimation_Begin("Camera_Hanging","",true);
			Entity_SetActive("PosArea_HangingLookLeft", true);
			Entity_SetActive("PosArea_HangingLookRight", true);*/
		}
		
		//---------------------------------------------
		
		void OnTimer_HangingImpulse(const tString &in asTimer)
		{
			Entity_AddImpulse("corpse_eaten_static_10", cVector3f(0.1f,0.1f,0), true, true);
			Map_RestartCurrentTimer();
		}
		
		//---------------------------------------------
		
		void OnLookAt_Player_HangingLookLeft(const tString &in asEntity, int alState)
		{
			if (alState == -1) return;
			if (mlHangingLookAtCount < mlLooksAmount)
			{
				Sound_CreateAtEntity("Sound_MoveTrap","rope_0"+mlHangingLookAtCount+".ogg","player");
				Entity_SetPlayerLookAtCallback("PosArea_HangingLookRight","OnLookAt_Player_HangingLookRight");
				mlHangingLookAtCount++;
				Debug_Log(cString_ToString(mlHangingLookAtCount));
			}
			else
			{
				Player_Detach();
			}
		}
		
		//---------------------------------------------
		
		void OnLookAt_Player_HangingLookRight(const tString &in asEntity, int alState)
		{
			if (alState == -1) return;
			if (mlHangingLookAtCount < mlLooksAmount)
			{
				Sound_CreateAtEntity("Sound_MoveTrap","rope_0"+mlHangingLookAtCount+".ogg","player");
				Entity_SetPlayerLookAtCallback("PosArea_HangingLookLeft","OnLookAt_Player_HangingLookLeft");
				mlHangingLookAtCount++;
				Debug_Log(cString_ToString(mlHangingLookAtCount));
			}
			else
			{
				Player_Detach();
			}
		}
		
		//---------------------------------------------
		
		void Player_Detach()
		{
			CameraAnimation_End();
			Entity_SetActive("corpse_eaten_static_10",false);
			Entity_SetActive("PosArea_HangingLookLeft", false);
			Entity_SetActive("PosArea_HangingLookRight", false);
			CameraAnimation_Begin("Camera_Fall","",true);
			//CameraAnimationNode_SetInitToCamera("Camera_Fall_1",true);
			Effect_Fade_Out(0.5f);
			Map_RemoveTimer("Timer_HangingImpulse");
			Map_AddTimer("Timer_PlayerFalls",0.5f,"OnTimer_PlayerFalls");
			
		}
		
		//---------------------------------------------
		
		void OnTimer_PlayerFalls(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Sound_FallOnGround","03_04_pillar_room/helper_corpse/helper_corpse_drop","Player");
			Map_AddTimer("Timer_PlayerGetsUp",2.0f,"OnTimer_PlayerGetsUp");
		}
		
		//---------------------------------------------
		
		void OnTimer_PlayerGetsUp(const tString &in asTimer)
		{
			CameraAnimation_End();
			Effect_Fade_In(2.0);
			Player_SetSlowStandupMotion(true);
			Player_SetMoveSpeedMul(0.6f);
			Player_SetLookSpeedMul(0.6f);
			Map_AddTimer("Timer_PlayerBackToNormal",10.0f,"OnTimer_PlayerBackToNormal");
			Player_SetCrouching(true,true,true);
		}
		
		//---------------------------------------------
		
		void OnTimer_PlayerBackToNormal(const tString &in asTimer)
		{
			Player_SetSlowStandupMotion(false);
			Player_SetMoveSpeedMul(1.0f);
			Player_SetLookSpeedMul(1.0f);
		}
		
		bool OnCollide_Player_DeactivateGhoulHearing(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 && mlGhoulCell == 1) Agent_SetSensesActive(msTortureGhoul,false);
			else Agent_SetSensesActive(msTortureGhoul,true);
			return true;
		}

		//-------------------------------------------------------

		//} END EVENT F
	 
	 //} END SCENE 4
	 
