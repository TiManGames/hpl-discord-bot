	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("04-04-paris");
        
        Pregnancy_SetStage(ePregStage_BornRecovered);
		
		Pregnancy_SetBarksActive(true);
        Pregnancy_SetBabyTalkStage(eBabyTalkStage_Carried);
		
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(true);
		
		Map_Preset_SetupDirLight("Interior_Lighting", false, cColor(0.392,0.435,0.471,1), 0.5f, cVector3f(0.387, -0.852, 0.352), cColor(0), cColor(0));
		Map_Preset_SetupDirLight("Exterior_Lighting", true, cColor(0.392,0.435,0.471,1), 0.5f, cVector3f(0.387, -0.852, 0.352), cColor(0), cColor(0));
		
		StruggleFlashHandler_SetActive(false);
		
		Player_SetAutoTeleportWhenBelowAltitude(-10);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		//ParticleSystem_Preload("some_particle.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		Sound_PreloadEvent("04_05_paris/wall/wall_shift");
		Sound_PreloadEvent("04_05_paris/wall/wall_collapse");
		Sound_PreloadEvent("04_05_paris/animation/wall_ghoul_end");
		Sound_PreloadEvent("04_05_paris/animation/wall_end");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		// Any general setup of script / entities
		Map_Preset_Fade("Interior_Lighting", 0.01f);
		
		Item_RemoveFromInventory(ItemType_GetFirstInInventory("CurseMedallion"));
		
		GhoulProgression_SetLimit(20);

        mbHighGhoulLevel = GhoulProgression_GetProgression()>=GHOUL_PROGRESSION_PARIS_HIGH;
		
		///////////////////////
		// Setup pushable wall
		tString sAnim = "wall_break";
		iLuxEntity@ pWallEntity = Map_GetEntity("CollapsingWall", eLuxEntityType_Prop);
		cMeshEntity@ pMeshEntity = pWallEntity.GetMeshEntity();
		cAnimationState@ pAnim = pMeshEntity.GetAnimationStateFromName(sAnim);
		pMeshEntity.PlayName(sAnim, false, false);
		pAnim.SetPaused(true);
        
        /////////////////////////
		// Debug
		if (cLux_ScriptDebugOn())
		{
			Item_AddToInventory("Laudanum");
			Item_AddToInventory("VitaeCanister");
			Item_AddToInventory("Orb");
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
        PlayerBody_SetModel("player6.ent");
		PlayerBody_SetActive(true);
        
        Pregnancy_SetBabyKicksEnabled(false);
        FearHandler_SetActive(false);
		FearHandler_SetPermaFailEnabled(false);
        
        Heat_SetActive(false);
		
        Player_SetMoveSpeedMul(0.6f);
        Player_SetRunSpeedMul(0.6f);
		Player_SetLookSpeedMul(1.f);
		
		Player_SetAllowHideMode(false);
		Player_SetCrouchActionDisabled(true);
		
		Player_SetJumpDisabled(true);
        SetBabyHeld(true, false);
		
		Entity_StopAnimation("EndingAmari");
        
		cLux_ClearAllMapSaveData();
		
		OnTimer_FadeInAfterFlash("");
		
		// Reset volume since it was lowered when going through the portal
		Sound_SetGlobalVolume(1.f, eSoundEntryType_AllExceptGui);
	}
	
	//-------------------------------------------------------
	
	void Update(float afDeltaTime)
	{
		UpdateWallCollapse(afDeltaTime);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}
    
	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("DEAD : SOURCE = " + asSource);
		
		if (asSource == "SomeReason")
		{
			Effect_Fade_Out(1.0f);
			return true; // return true to completely override base behaviour
		}
		
		// return false for default behaviour
		return false;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{		
		// return false for default behaviour (fadeout and death area)
		return false;
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{	
            mbHighGhoulLevel=false;
		}
        
        if(alAction == eAction_Test2)
		{	
            mbHighGhoulLevel=true;
		}
        
        if(alAction == eAction_Test3)
		{	
			BrickWaves();
            OnTimer_StartEndingSeq("");
		}
		
		if (alAction == eAction_Test4)
		{
			mbHighGhoulLevel = true;
			Seq_Ending("");
		}
		
		if (alAction == eAction_Test5)
		{
			mbHighGhoulLevel = false;
			Seq_Ending("");
		}
	}	

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
