		}
		
		//-------------------------------------------------------
		
		bool OnVoiceCondition_Malick(const tString &in asSubject)
		{
			return Map_GetEntity("Trigger_PlayMalickDialogue").CheckIsOnScreen(true) &&
				   Entity_IsActive("Wraith_Stairs") == false;
		}

