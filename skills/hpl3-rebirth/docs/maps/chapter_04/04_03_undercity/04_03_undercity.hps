			Entity_SetActive("Baby_Bottom", false);
			Entity_SetActive("Doctor", false);
			Entity_SetActive("DoctorElevatorLight", false);
			Sound_Stop("Sound_BabyScreamBottom", 1.f);
			Sound_Stop("Sound_DoctorElevatorMove", 1.0f);			
		}
		
