		//} END Event D *Find the SABOTEUR*
		
		/////////////////////////////////////////
		// Event E *Tasi looks at her reflection in the FOUNTAIN*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event E here.*/
		
		bool mbReflectionEnabled = false;
		bool mbFountainDialoguePlayed = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event E here.*/
		
		bool OnTrigger_Play_SetFountainReflectionActive(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("FountainWater_Reflection", alState == 1);
			Entity_SetActive("FountainWater", alState == -1);
			
			if (alState == 1)
				Map_AddTimer("Timer_CheckAllowFountainInteraction", 0.1f, "OnTimer_CheckAllowFountainInteraction");
			else
				Map_RemoveTimer("Timer_CheckAllowFountainInteraction");
				
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckAllowFountainInteraction(const tString &in asTimer)
		{
			Entity_SetInteractionDisabled("Area_FountainInteract_*", Voice_SceneInvolvingCharacterIsActive("Player"));
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void OnInteract_FountainWater(const tString &in asEntity)
		{
			//////////////////
			// Force reflection
			cConfigFile@ config = cLux_GetUserConfig();
			mbReflectionEnabled = config.GetBool("Graphics", "WorldReflection", true);
				 
			if (mbReflectionEnabled == false)
			{
				config.SetBool("Graphics", "WorldReflection", true);
				cLux_ApplyUserConfig();
			}
			
			///////////////////
			// Setup progression
			float fVoiceDelay = 7.5f - 4.03f;			
			tString sModel = "player6_head_ghoul_1.ent";
			tString sAnim = "player_generic_look_at_fountain_reflection_low_ghoul";

			if (mlGhoulLevelOnEnter >= GHOUL_PROGRESSION_MIRROR_HIGH)
			{
				fVoiceDelay = 7.5f - 5.9f;
				sModel = "player6_head_ghoul_3.ent";
				sAnim = "player_generic_look_at_fountain_reflection_high_ghoul";
			}
			else if (mlGhoulLevelOnEnter >= GHOUL_PROGRESSION_MIRROR_MED)
			{
				fVoiceDelay = 7.5f - 5.8f;
				sModel = "player6_head_ghoul_2.ent";
				sAnim = "player_generic_look_at_fountain_reflection_med_ghoul";
			}
			
			if (mbFountainDialoguePlayed)
			{
				sAnim = "player_generic_look_at_fountain_reflection";
			}
			
			///////////////////
			// Setup player
			Player_SetCrouching(false);
			Player_FadeLookSpeedMulTo(0.4f, 0.5f);		 
			PlayerBody_SetModel(sModel);
			
			tString sEnt = PlayerBody_GetEntityName();
			Entity_SetEffectsActive(sEnt, false, false);
			FootPlacement_SetActive(sEnt, false);
			GhoulProgression_ResetArms();
				 
			PlayerBody_AttachProp("Amulet_Bracelet", "AmuletSocket", false, false);
			PlayerBody_AttachProp("SalimsRing_Accessory", "RingSocket", false, false);
			PlayerBody_SetReflectionVisibility(true);
			
			Entity_SetReflectionVisibility(Item_GetItemEntity(ItemType_GetFirstInInventory("CurseMedallion")), true, true);
			Entity_SetReflectionVisibility("Amulet_Bracelet", true, true);
			Entity_SetReflectionVisibility("SalimsRing_Accessory", true, true);
					
			//////////////////
			// Play anim		
			PlayerBody_PlayCutsceneAtEntity(sAnim, "Area_FountainCutscene", false, 0.3f, "OnAnimEnd_FountainMoment");
			PlayerBody_SetCutsceneMaxPitch(15.f);
			PlayerBody_SetCutsceneMaxYaw(15.f);
				 
			Map_AddTimer(sAnim, PlayerBody_GetAnimationState(sAnim).GetLength() - 0.3f, "OnTimer_ResetPlayerModel");
			
			Light_FadeBrightnessTo("Light_Spot_Reflection", 4.f, 1.f);
				
			//////////////////
			// Voice
			if (mbFountainDialoguePlayed == false)
			{
				mbFountainDialoguePlayed = true;
				
				tString sSubject = "Dialogue_FountainMoment_Normal";				
				if (mlGhoulLevelOnEnter >= GHOUL_PROGRESSION_MIRROR_MED)		sSubject = "Dialogue_FountainMoment_SemiGhoulish";
				if (mlGhoulLevelOnEnter >= GHOUL_PROGRESSION_MIRROR_HIGH)		sSubject = "Dialogue_FountainMoment_VeryGhoulish";
				
				Voice_StopAll();
				Voice_PlayDelayed(sSubject, fVoiceDelay);
				
				Achievement_Unlock(eAchievement_Narcissist);
			}
		}
		 
		//-------------------------------------------------------
		 
		void OnTimer_ResetPlayerModel(const tString &in asTimer)
		{
			float fT = PlayerBody_GetAnimationState(asTimer).GetRelativeTimePosition();
			 
			PlayerBody_SetModel("player6.ent");
			 
			tString sEnt = PlayerBody_GetEntityName();
			Entity_SetEffectsActive(sEnt, false, false);
			FootPlacement_SetActive(sEnt, false);
			GhoulProgression_ResetArms();
			
 			PlayerBody_AttachProp("Amulet_Bracelet", "AmuletSocket", false, false);
 			PlayerBody_AttachProp("SalimsRing_Accessory", "RingSocket", false, false);

			PlayerBody_PlayCutsceneAtEntity(asTimer, "Area_FountainCutscene", false, 0.f, "OnAnimEnd_FountainMoment", 1.f, fT);			 
			PlayerBody_SetCutsceneMaxPitch(15.f);
			PlayerBody_SetCutsceneMaxYaw(15.f);
			
			Light_FadeBrightnessTo("Light_Spot_Reflection", 0.f, 1.f);
		}
		 
		//-------------------------------------------------------
		 
		void OnAnimEnd_FountainMoment(const tString &in asAnim)
		{
			if (mbReflectionEnabled == false)
			{
				cLux_GetUserConfig().SetBool("Graphics", "WorldReflection", mbReflectionEnabled);
				cLux_ApplyUserConfig();
			}
			
			Player_FadeLookSpeedMulTo(1.f, 0.5f);		 
			PlayerBody_SetReflectionVisibility(false);
			
			Entity_SetReflectionVisibility(Item_GetItemEntity(ItemType_GetFirstInInventory("CurseMedallion")), false, true);
			Entity_SetReflectionVisibility("Amulet_Bracelet", false, true);
			Entity_SetReflectionVisibility("SalimsRing_Accessory", false, true);
		}

		//-------------------------------------------------------

		//} END Event E *Tasi looks at her reflection in the FOUNTAIN*
		
		/////////////////////////////////////////
		// Event F *Get spooked by another wraith beam*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event F here.*/
		
		float mfFountainScareCount = 0.f;
		bool mbPlayerSeenFountainBeam = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event F here.*/
		
		bool OnTrigger_Player_StartSeqBeamScareFountain(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (Entity_IsInPlayerFOV("Wraith_BeamScareFountain") || Voice_AnySceneIsActive()) 
				return false;
			
			ResetPlayerMoveSpeed(false);
			Seq_BeamScareFountain("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataBeamScareFountain;
		void Seq_BeamScareFountain(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BeamScareFountain", mSeqDataBeamScareFountain);
			if (Sequence_DoStepAndWait(0.01f))
			{
				Entity_SetActive("Wraith_BeamScareFountain", true);
				
				iLuxEntity@ pCrystal = Map_GetEntity("Wraith_BeamScareFountain_crystal", eLuxEntityType_Prop);
				if (pCrystal !is null)
					pCrystal.GetLightFromName("Light_Spot_1").SetBrightness(0.f);
			}
			else if (Sequence_DoStepAndPause(1.5f))
			{
				cVector3f vPos = Map_GetEntity("Area_WraithBeamScareFountainTarget", eLuxEntityType_Area).GetPosition();
				Wraith_CommandLookAtPosition_Execute("Wraith_BeamScareFountain", vPos, false, false, true, "");
				Wraith_SetSpotlightOn("Wraith_BeamScareFountain", true, false, 0.f);
				
				Map_AddTimer("Timer_ResumeFountainScare", 0.1f, "OnTimer_ResumeFountainScare");
				
				FearHandler_SetForcedAddFearRate(0.3f, 5.f, true, -1.f, 0.1f, 0.2f);
				
				Music_Play("A2_4_3_Wraith_Stinger.ogg", 0.18f, false, eMusicPrio_MinorEvent);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Wraith_SetSpotlightOn("Wraith_BeamScareFountain", false);
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{
				if (mbPlayerSeenFountainBeam)
				{
					cVector3f vPos = Map_GetEntity("Area_BeamScareWraithDashGoal", eLuxEntityType_Area).GetPosition();
					Wraith_CommandDash_Execute("Wraith_BeamScareFountain", vPos, false, true, true, "OnDashEnd_WraithFountainBeamScare");
				}
				else
				{
					Entity_SetActive("Wraith_BeamScareFountain", false);
					Map_AddTimer("Timer_BeamScareFountainWraithDisappeared", 1.f, "");
				}				
				
				ResetPlayerMoveSpeed(true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResumeFountainScare(const tString &in asTimer)
		{
			bool bSeeBeam = Map_GetEntity("Area_FountainScareBeam", eLuxEntityType_Area).CheckIsOnScreen(true);
			if (mfFountainScareCount >= 4.f || bSeeBeam)
			{
				mbPlayerSeenFountainBeam = bSeeBeam;
				SequenceStates_Resume("Seq_BeamScareFountain");
				return;
			}
			
			float fTime = 0.1f;
			mfFountainScareCount += fTime;
			Map_AddTimer("Timer_ResumeFountainScare", fTime, "OnTimer_ResumeFountainScare");
		}
		
		//-------------------------------------------------------
		
		void OnDashEnd_WraithFountainBeamScare(const tString &in asEntity)
		{
			Map_AddTimer("Timer_BeamScareFountainWraithDisappeared", 2.f, "");
		}
				
		//-------------------------------------------------------

		//} END Event F *Get spooked by another wraith beam*
		
