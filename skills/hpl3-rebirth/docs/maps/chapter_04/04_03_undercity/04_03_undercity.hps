		void OnDetach_PowerCable1_Right(const tString &in asStickyArea, const tString &in asBodyName)
		{
			SetElevatorActive(1, 1, false);
			SetElevatorCogsActive(false, false);
			SetCableStaticPhysics(false);
		}
		
		//-------------------------------------------------------
		
		void OnDetach_PowerCable1_Left(const tString &in asStickyArea, const tString &in asBodyName)
		{
			SetElevatorActive(2, 1, false);
			SetElevatorCogsActive(false, true);
			SetCableStaticPhysics(false);
		}
		
		//-------------------------------------------------------
		
		void SetCableStaticPhysics(bool abX)
		{
		//	Map_AddTimer("Timer_SetCableStaticPhysics", abX ? 1.f : 0.f, "OnTimer_SetCableStaticPhysics");
		//	Map_SetTimerUserVarInt("Timer_SetCableStaticPhysics", abX ? 1 : 0);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetCableStaticPhysics(const tString &in asTimer)
		{
			Prop_SetStaticPhysics("PowerCable_1", Map_GetTimerUserVarInt(asTimer) == 1);
		}
		
		//-------------------------------------------------------

		//} END Event D *Unplug ELEVATOR POWER CABLEs*
		
		/////////////////////////////////////////
		// Event E *Plug in ELEVATOR POWER CABLES*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event E here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event E here.*/
		
		bool OnAttach_PowerCable1_Right(const tString &in asStickyArea, const tString &in asBodyName)
		{
			SetElevatorActive(1, 1, true);
			SetElevatorCogsActive(true, false);
			SetCableStaticPhysics(true);
			return true;
		}
				
		//-------------------------------------------------------
		
		bool OnAttach_PowerCable1_Left(const tString &in asStickyArea, const tString &in asBodyName)
		{
			SetElevatorActive(2, 1, true);
			SetElevatorCogsActive(true, true);
			SetCableStaticPhysics(true);
			return true;
		}

		//-------------------------------------------------------

		//} END Event E *Plug in ELEVATOR POWER CABLES*
		
		/////////////////////////////////////////
		// Event F *Tear loose the ELEVATOR GRATING*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event F here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event F here.*/
		
		void OnTear_Grating(const tString &in asEntity)
		{
			Sound_CreateAtEntity("Sound_Tear" + asEntity, "level_entity_shared/breakables/relic_room_bars/relic_bars_break", asEntity);
			
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_Sparks", "sparks_tiny.ps", asEntity, false);
			cVector3f vPos = Map_GetProp(asEntity).GetJoint(0).GetPivotPoint();
			pPS.SetWorldPosition(vPos);

			Entity_SetActive("InteractAux_" + asEntity, false);
		}

		//-------------------------------------------------------

		//} END Event F *Tear loose the ELEVATOR GRATING*
		
		/////////////////////////////////////////
		// Event G *Leave HANK*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event G here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event G here.*/
		
		cSequenceStatesData mSeqDataHankReveal;
		void Seq_HankReveal(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HankReveal", mSeqDataHankReveal);
			if (Sequence_DoStepAndWait(0.f))
			{
				ParticleSystem_CreateAtEntity("PS_Sparks", "elevator_sparks.ps", "Area_OutletSparks", false);
				Sound_CreateAtEntity("Sound_OutletSparks", "01_01_wreckage/events/radio_spark", "Area_OutletSparks");
				
				LightFlash_Add(0.05f, 0.05f, 0.05f, "Area_OutletFlash", cColor(1,0.915,0.492,1), 1.f, 25.f);
			}
			else if (Sequence_DoStepAndWait(3.f))
			{
				Player_SetCrouching(false, false, false);
				
				PlayerBody_PlayCutsceneAtEntity("tasi_undercity_fall_on_butt_start", "Area_PuzzleCutscene", false, 0.4f, "OnAnimEnd_FallOnButt");
				PlayerBody_SetCutsceneMaxPitch(10.f);
				PlayerBody_SetCutsceneMaxYaw(10.f);
				
				Map_AddTimer("Timer_PlayHankWakeUpAnim", 1.f, "OnTimer_PlayHankWakeUpAnim");
			}
			else if (Sequence_DoStepAndWait(6.3f))
			{
				FearHandler_SetCanGasp(false);
				
				FearHandler_SetForcedAddFearRate(1.f, 7.f, false, 0.05f, 0.05f, 1.f);
				Entity_SetActive("FearScaryObject_Hank", true);
				Entity_SetActive("FearThreatObject_Hank", true);
				FearScaryObject_SetComponentEnabled("FearScaryObject_Hank", true);
				FearThreat_SetComponentEnabled("FearThreatObject_Hank", true);
				
				Voice_PlayDelayed("Global_Tasi_Bark_Stage2_Climb_Long", 1.1f, 4);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				FearHandler_SetCanGasp(true);
				
				PlayerBody_PlayCutsceneAtEntity("tasi_undercity_fall_on_butt_end", "Area_PuzzleCutscene_Offset", false, 0.75f, "", 1.f, 0.f, 0.f, 0.f, true, false, true);
				PlayerBody_SetCutsceneMaxPitch(10.f);
				PlayerBody_SetCutsceneMaxYaw(10.f);
				
				HeadTracker_SetActive("Hank", true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_FallOnButt(const tString &in asAnim)
		{
			PlayerBody_PlayCutsceneAtEntity("tasi_undercity_fall_on_butt_loop", "Area_PuzzleCutscene", true, 0.3f, "", 1.f, 0.f, 0.f, 0.f, true, false, true);
			PlayerBody_SetCutsceneMaxPitch(10.f);
			PlayerBody_SetCutsceneMaxYaw(10.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayHankWakeUpAnim(const tString &in asTimer)
		{						
			Entity_PlayAnimation("Hank", "look_at_player", 0.3f, true, true);
			Entity_PlayAnimation("HankCable", "cable_hank_look_at_player", 0.3f, true, true);
			Entity_SetAnimationMessageEventCallback("Hank", "OnAnimMessageEvent_Hank", false);
			
			Voice_PlayDelayed("Dialogue_HankBeg", 1.85f);
			Map_AddTimer("Timer_HankTalk", 4.5f, "OnTimer_HankTalk");
			Map_AddTimer("Timer_PlaySorryHankDialogue", 5.35f, "OnTimer_PlaySorryHankDialogue");
			Map_AddTimer("Timer_HankMusicStinger", 2.5f, "OnTimer_HankMusicStinger");
			//Music_Play("Hank_Stinger.ogg", 0.8f, false, eMusicPrio_MinorEvent);
		}
		
		//-------------------------------------------------------
		
		void OnAnimMessageEvent_Hank(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			Sound_CreateAtEntity("Sound_BarGrab_1", "creatures/foley/creature/ghoul/animations/custom/bar_hand_place", "Hank", 0.f, false, 1.f, 3.f, 10.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_HankMusicStinger(const tString &in asTimer)
		{
			Music_Play("Hank_Stinger.ogg", 0.8f, false, eMusicPrio_MinorEvent);
		}
		
		void OnTimer_HankTalk(const tString &in asTimer)
		{
			if (Voice_SceneInvolvingCharacterIsActive("Hank"))
			{
				Map_RestartCurrentTimer();
				return;
			}
			
			if (Entity_GetDeltaToEntity("Hank", "player").Length() > 15.f)
				return;
				
			tString sSubject = GhoulProgression_GetProgression() >= GHOUL_PROGRESSION_UNDERCITYA_HIGH ? "Dialogue_Hank_ToTasi_HighGhoul" : "Dialogue_Hank_ToTasi_LowGhoul";
			Voice_Play(sSubject, -1, "OnVoiceEnd_HankTalk");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_HankTalk(const tString &in asScene, const tString &in asSubject)
		{
			Map_AddTimer("Timer_HankTalk", cMath_RandRectf(4.f, 8.f), "OnTimer_HankTalk");
		}
							
		//-------------------------------------------------------
		
		void OnTimer_PlaySorryHankDialogue(const tString &in asTimer)
		{
			if (Voice_AnySceneIsActive() || 
				cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Normal ||
				Map_GetEntity("Trigger_RecognizeHank").CheckIsOnScreen(true) == false)
			{				
				Map_AddTimer("Timer_PlaySorryHankDialogue", 0.75f, "OnTimer_PlaySorryHankDialogue");
				return;
			}
			
			Voice_Play("Dialogue_Hank", -1, "OnVoiceEnd_HankDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_HankDialogue(const tString &in asScene, const tString &in asSubject)
		{
			Voice_PlayDelayed("Dialogue_SorryHank", 0.1f);
		}

		//-------------------------------------------------------

		//} END Event G *Leave HANK*
	 
	//} END SCENE 2
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 3 *The player avoids a WRAITH coming down the stairs*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 3 here.*/
		
		tString msStairsWraithGoal = "";
		bool mbStairsWraithReachedGoal = false;
		bool mbStairsWraithLeaving = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 3 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
		
		/////////////////////////////////////////
		// Event A *The WRAITH comes down the stairs*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 3, Event A here.*/
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 3, Event A here.*/
		
		bool OnTrigger_Player_PlayWraithScareSound(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_PlayWraithScareSound", 0.5f, "OnTimer_PlayWraithScareSound");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayWraithScareSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Sound_DistantWraith", "creatures/vocalisations/creature/wraith/distant_call_random", "player");
			FearHandler_SetForcedAddFearRate(0.2f, 4.f, false, -1.f, 0.05f, 0.3f);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_SpawnWraith(const tString &in asParent, const tString &in asChild, int alState)
		{
			///////////////
			// Setup wraith encounter
			ResetPlayerMoveSpeed(false);
			
			PhysicsSlideDoor_SetOpenAmount("StairsDoor_*", 1.f);
			Music_Play("A2_4_3_Wraith_Hunt2.ogg", 0.18f, true, eMusicPrio_SceneAmb);
			Entity_SetActive("Wraith_Stairs", true);
			Agent_SetSensesActive("Wraith_Stairs", false);
			
			Map_AddTimer("Timer_CheckDistanceToWraith", 1.f, "OnTimer_CheckDistanceToWraith");
			Map_AddTimer("Timer_EnableWraithSenses", 10.f, "OnTimer_EnableWraithSenses");			
			Map_AddTimer("Timer_UpdateWraithPatrol", 0.f, "OnTimer_UpdateWraithPatrol");
			
			Wraith_SetHearingMul("Wraith_Stairs", 0.75f);
			Wraith_SetCallback_Alerted("Wraith_Stairs", "OnAlerted_WraithStairs");
			
			Map_AddTimer("Timer_PlayStairsWraithIntroScream", 2.5f, "OnTimer_PlayStairsWraithIntroScream");
			
			Voice_StopScenesWithCharacter("Player");
			
			mlPermaFailStage = eUndercityPermaFailStage_BottomFloor;
			
			///////////////
			// Fix so Hank is idling			
			Map_RemoveTimer("Timer_PlaySorryHankDialogue");
			Map_RemoveTimer("Timer_HankTalk");
			
			Entity_PlayAnimation("Hank", "idle_sleep", 0.f, true);
			Entity_PlayAnimation("HankCable", "cable_hank_idle_sleep", 0.f, true);
			
			cLux_AddDebugMessage("Reseting Hank anims!");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayStairsWraithIntroScream(const tString &in asTimer)
		{
			Map_RemoveTimer("Timer_PlayStairsWraithIntroScream");
			Map_GetEntity("Wraith_Stairs").PlaySound("IntroScream", "creatures/vocalisations/creature/wraith/sees_the_player", true, true);
			
			Wraith_SetSpotlightOn("Wraith_Stairs", true);
			Map_AddTimer("Timer_TurnOffStairsWraithSpot", 3.f, "OnTimer_TurnOffStairsWraithSpot");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TurnOffStairsWraithSpot(const tString &in asTimer)
		{
			Wraith_SetSpotlightOn("Wraith_Stairs", false);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StairsWraith(const tString &in asEntity, int alState)
		{
			if (Map_TimerExists("Timer_PlayStairsWraithIntroScream") == false)
				return;
			
			OnTimer_PlayStairsWraithIntroScream("");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckDistanceToWraith(const tString &in asTimer)
		{
			if (Entity_GetDeltaToEntity("player", "Wraith_Stairs").Length() < 10.f && 
				Map_TimerExists("Timer_EnableWraithSenses"))
			{
				OnTimer_EnableWraithSenses("");
			}
			else
			{
				Map_AddTimer("Timer_CheckDistanceToWraith", 0.1f, "OnTimer_CheckDistanceToWraith");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableWraithSenses(const tString &in asTimer)
		{
			Map_RemoveTimer("Timer_TurnOffStairsWraithSpot");
			Map_RemoveTimer("Timer_PlayStairsWraithIntroScream");
			Map_RemoveTimer("Timer_EnableWraithSenses");
			Map_RemoveTimer("Timer_CheckDistanceToWraith");
			
			Agent_SetSensesActive("Wraith_Stairs", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UpdateWraithPatrol(const tString &in asTimer)
		{
			if (mbStairsWraithReachedGoal)
				return;
			
			//////////////////
			// Move to player
			bool bPlayerByCloset = Entity_GetCollide("player", "Area_Closet");
			tString sGoal = bPlayerByCloset ? "PathNode_Closet" : "PathNode_Puzzle";
			
			if (msStairsWraithGoal != sGoal)
			{
				Wraith_CommandPatrol_ClearNodes("Wraith_Stairs");
				Wraith_CommandPatrol_AddNode("Wraith_Stairs", sGoal);
				Wraith_CommandPatrol_Execute("Wraith_Stairs", false, 1, false, false, eWraithSpeed_Slow, "OnPatrolEnd_Wraith");
			}
			
			msStairsWraithGoal = sGoal;
			
			//////////////////
			// Move faster if player is hiding
			if (Wraith_GetAlertState("Wraith_Stairs") == 0)
			{
				tString sDoor = bPlayerByCloset ? "Door_Closet" : "Door_Puzzle";
				if (SwingDoor_GetOpenAmount(sDoor) < 0.1f && Entity_PlayerIsInFront(sDoor) == false)
				{
					CharMover_SetSpeedState("Wraith_Stairs", eWraithSpeed_Run);
				}
				else
				{
					float fDist = Entity_GetDeltaToEntity("player", "Wraith_Stairs").Length();
					int lSpeed = fDist > 20.f ? eWraithSpeed_FastWalk : eWraithSpeed_Slow;
					CharMover_SetSpeedState("Wraith_Stairs", lSpeed);
				}
			}	
			
			Map_AddTimer("Timer_UpdateWraithPatrol", 1.f, "OnTimer_UpdateWraithPatrol");
		}
		
		//-------------------------------------------------------

		//} END Event A *The WRAITH comes down the stairs*
		
		/////////////////////////////////////////
		// Event B *The WRAITH investigates outside the player's hiding spot*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 3, Event B here.*/
		
		int mlEncounterDoorMoveCount = 0;
		float mfEncounterDoorInteractCount = 0.f;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 3, Event B here.*/
		
		void OnInteract_EncounterDoor(const tString &in asEntity)
		{
			OnEncounterDoorInteract(asEntity);
		}
		
		//-------------------------------------------------------
		
		void OnEncounterDoorInteract(const tString &in asDoor)
		{
			if (Entity_IsActive("Wraith_Stairs") == false)
				return;
			
			Map_RemoveTimer(asDoor);
			Map_RemoveTimer("Timer_ResetStairsWraithHearing");
			Map_AddTimer(asDoor, 0.f, "OnTimer_UpdateWraithHearing");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UpdateWraithHearing(const tString &in asTimer)
		{
			if (Entity_IsInteractedWith(asTimer))
			{
				iPhysicsBody@ pBody = Map_GetEntity(asTimer, eLuxEntityType_Prop).GetMainBody();
				if (pBody.GetLinearVelocity().Length() > 0.2f)
					mfEncounterDoorInteractCount += 0.1f;
					
				if (mfEncounterDoorInteractCount >= 2.5f)
					Wraith_SetHearingMul("Wraith_Stairs", 0.75f);
				else
					Wraith_SetHearingMul("Wraith_Stairs", 0.2f);
			}
			else
			{
				mfEncounterDoorInteractCount = 0.f;
				Map_AddTimer("Timer_ResetStairsWraithHearing", 2.f, "OnTimer_ResetStairsWraithHearing");
				return;
			}
			
			Map_RestartCurrentTimer(0.1f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetStairsWraithHearing(const tString &in asTimer)
		{
			Wraith_SetHearingMul("Wraith_Stairs", 0.75f);
		}
		
		//-------------------------------------------------------
		
		void OnAlerted_WraithStairs(const tString &in asEntity)
		{
			if (Map_TimerExists("Timer_CheckIfWraithByHidingSpot"))
				return;
			
			Map_AddTimer("Timer_CheckIfWraithByHidingSpot", 0.1f, "OnTimer_CheckIfWraithByHidingSpot");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckIfWraithByHidingSpot(const tString &in asTimer)
		{
			if (mbStairsWraithLeaving || Wraith_GetAlertState("Wraith_Stairs") == 0)
				return;
				
			///////////////////
			// Leave if it's alerted near player hiding spot
			bool bPlayerByCloset = Entity_GetCollide("player", "Area_Closet");
			tString sArea = bPlayerByCloset ? "Area_Closet" : "Area_Puzzle";
			
			if (Entity_GetCollide("Wraith_Stairs", sArea))
			{
				StairsWraithLeave();
				return;
			}
			
			Map_AddTimer("Timer_CheckIfWraithByHidingSpot", 0.1f, "OnTimer_CheckIfWraithByHidingSpot");
		}
		
		//-------------------------------------------------------
		
		void OnPatrolEnd_Wraith(const tString &in asEntity)
		{
			///////////////////
			// Walk to pos near door
			mbStairsWraithReachedGoal = true;
			
			bool bPlayerByCloset = Entity_GetCollide("player", "Area_Closet");
			tString sGoal = bPlayerByCloset ? "PathNode_ClosetDoor" : "PathNode_PuzzleDoor";
			
			Wraith_CommandPatrol_ClearNodes("Wraith_Stairs");
			Wraith_CommandPatrol_AddNode("Wraith_Stairs", sGoal);
			Wraith_CommandPatrol_Execute("Wraith_Stairs", false, 1, false, true, eWraithSpeed_Slow, "OnPatrolEnd_WraithNear");
		}
		
		//-------------------------------------------------------
		
		void OnPatrolEnd_WraithNear(const tString &in asEntity)
		{
			///////////////////
			// Look at door for a bit
			bool bPlayerByCloset = Entity_GetCollide("player", "Area_Closet");
			tString sDoor = bPlayerByCloset ? "Door_Closet" : "Door_Puzzle";
			cVector3f vPos = Map_GetEntity(sDoor, eLuxEntityType_Prop).GetPosition();
			
			Wraith_ModeIdle_SetResetSpotlight("Wraith_Stairs", false, true);
			Wraith_CommandLookAtPosition_Execute("Wraith_Stairs", vPos, false, false, false, "OnLookAtPos_WraithStairs");
		}
		
		//-------------------------------------------------------
		
		void OnLookAtPos_WraithStairs(const tString &in asEntity)
		{
			StairsWraithLeave();
		}
		
		//-------------------------------------------------------
		
		void StairsWraithLeave()
		{
			mbStairsWraithReachedGoal = true;
			mbStairsWraithLeaving = true;
			
			bool bPlayerByCloset = Entity_GetCollide("player", "Area_Closet");
			tString sGoal = bPlayerByCloset ? "PathNode_LeavePuzzle" : "PathNode_LeaveCloset";
			
			Wraith_ModeIdle_SetResetSpotlight("Wraith_Stairs", false, true);
			
			Wraith_CommandPatrol_ClearNodes("Wraith_Stairs");			
			Wraith_CommandPatrol_AddNode("Wraith_Stairs", sGoal);
			Wraith_CommandPatrol_Execute("Wraith_Stairs", false, 1, false, true, eWraithSpeed_Walk, "OnPatrolEnd_Leave");
		}
		
		//-------------------------------------------------------
		
		void OnPatrolEnd_Leave(const tString &in asEntity)
		{		
			float fDistA = Entity_GetDeltaToEntity("player", "Area_StairsWraithDashGoal_1").SqrLength();
			float fDistB = Entity_GetDeltaToEntity("player", "Area_StairsWraithDashGoal_2").SqrLength();
				
			tString sGoal = fDistA > fDistB ? "Area_StairsWraithDashGoal_1" : "Area_StairsWraithDashGoal_2";
			cVector3f vPos = Map_GetEntity(sGoal, eLuxEntityType_Area).GetPosition();
			
			Wraith_CommandDash_Execute("Wraith_Stairs", vPos, true, true, false, "OnDash_StairsWraith");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopWraithMusic(const tString &in asTimer)
		{
			Music_Stop(5.f, eMusicPrio_SceneAmb);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_LeaveEncounterArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (Entity_IsActive("Wraith_Stairs") == false)
				return true;
			
			Map_AddTimer("OnTimer_WraithForceLeave", 0.1f, "OnTimer_WraithForceLeave");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_WraithForceLeave(const tString &in asTimer)
		{
			if (Struggle_IsActive(true) || FearHandler_GetIsPermaFailing())
			{
				Map_RestartCurrentTimer(0.1f);
				return;
			}
			
			Agent_SetSensesActive("Wraith_Stairs", false);
			Agent_ResetPlayerDetectionState("Wraith_Stairs");
			
			cVector3f vPos = Map_GetEntity("Area_StairsWraithDashGoal_3", eLuxEntityType_Area).GetPosition();
			
			Wraith_Command_Remove("Wraith_Stairs");
			Wraith_CommandDash_Execute("Wraith_Stairs", vPos, true, true, false, "OnDash_StairsWraith");
		}
		
		//-------------------------------------------------------
		
		void OnDash_StairsWraith(const tString &in asAgent)
		{
			Map_AddTimer("Timer_StopWraithMusic", 8.f, "OnTimer_StopWraithMusic");
		}
				
		//-------------------------------------------------------

		//} END Event B *The WRAITH investigates outside the player's hiding spot*
		
		/////////////////////////////////////////
		// Event C *Wake up on the bottom floor (PERMAFAIL)*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 3, Event C here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 3, Event C here.*/
		
		bool OnPermaFail_BottomFloor(const tString &in asSource)
		{
			Entity_SetActive("Wraith_Stairs", false);
			
			Music_Stop(5.0f, eMusicPrio_SceneAmb);
			
			SetupGenericPermaFail();
			FearHandler_SetPermaFailRespawnArea("PermaFail_BottomFloor_*");
			return true;
		}
		
		//-------------------------------------------------------

		//} END Event C *Wake up on the bottom floor (PERMAFAIL)*
	 
	//} END SCENE 3
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 4 *THE PLAYER RIDES THE ELEVATOR TO THE TOP*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 4 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 4 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
		
		/////////////////////////////////////////
		// Event A *The Shadow roars*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event A here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 4, Event A here.*/
		
		//-------------------------------------------------------

		//} END Event A *The Shadow roars*
		
		/////////////////////////////////////////
		// Event B *Enter the ELEVATOR*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event B here.*/
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 4, Event B here.*/
		
		bool OnTrigger_Player_EnterElevator(const tString &in asParent, const tString &in asChild, int alState)
		{			
			if (alState == -1)
				return true;
						
			if (mbElevatorPowerOn || mbElevatorPowerOn == false && mbElevatorCrashed == false)
			{
				SetElevatorDoorOpen(cString_GetNumericSuffixInt(asParent), true);
				MovingButton_SetSwitchedOn("ElevatorButton_1_" + mlElevatorLevel, true, true);
			}
			
			return true;
		}
				
		//-------------------------------------------------------

		//} END Event B *Enter the ELEVATOR*
		
		/////////////////////////////////////////
		// Event C *Pull the ELEVATOR LEVER*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event C here.*/
		
		bool mbElevatorCrashed = false;
		int mlElevatorLevel = 1;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 4, Event C here.*/
		
		void OnConnectionStateChange_ElevatorLever(const tString &in asEntity, int alState)
		{
			if (Entity_IsInteractedWith(asEntity) == false)
				return;
			
			if (mbElevatorCrashed && mbElevatorPowerOn == false)
				Voice_PlayDelayed("Dialogue_ElevatorCrash", 2.f);
				
			if (alState != 1 || mlElevatorLevel == 2) 
				return;
			
			////////////////////
			// Ride to top!
			bool bElevatorAscending = false;
			if (mbElevatorPowerOn)
			{
				bElevatorAscending = true;
				
				Map_AddTimer("Timer_ElevatorRideToTop", 3.f, "OnTimer_ElevatorRideToTop");				
				Voice_PlayDelayed("Dialogue_ElevatorRide", 0.5f);
				
				// So cable physics stops
				Prop_SetStaticPhysics("PowerCable_*", true);
				Entity_SetActive("PowerCable_*", false);
				
				FearHandler_SetPermaFailEnabled(false);
				
				// Hide roof particles that look weird from above
				ParticleSystem_SetVisible("PS_27", false);
				ParticleSystem_SetVisible("PS_3", false);
				ParticleSystem_SetVisible("PS_40", false);
				ParticleSystem_SetVisible("PS_38", false);
				ParticleSystem_SetVisible("PS_39", false);
			}
			
			////////////////////
			// Do crash sequence!
			else if (mbElevatorCrashed == false)
			{
				mbElevatorCrashed = true;
				bElevatorAscending = true;
				
				Seq_ElevatorCrash("");
			}				
			
			if (bElevatorAscending)
			{
				SetElevatorDoorOpen(1, false);
				Prop_SetStaticPhysics("Elevator_1_Hatch", true);

				Lever_SetStuckState("ElevatorLever", alState, true);
				Lever_SetInteractionDisablesStuck("ElevatorLever", false);
			}				
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ElevatorRideToTop(const tString &in asTimer)
		{
			Prop_MoveLinearTo("Elevator_1", "Elevator_1_Goal", 0.5f, 4.f, 1.f, false, "OnMoveLinear_ElevatorPowerOn");
			
			Sound_CreateAtEntity("Sound_ElevatorStart", "04_03_undercity/elevator/elevator_start", "Elevator_1");
			Sound_CreateAtEntity("Sound_ElevatorMove", "04_03_undercity/elevator/elevator_loop", "Elevator_1");
			
			Map_AddTimer("Timer_PlayElevatorMicroflashes", 7.f, "OnTimer_PlayElevatorMicroflashes");
			Map_AddTimer("Timer_FadeInElevatorClouds", 7.f, "OnTimer_FadeInElevatorClouds");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayElevatorMicroflashes(const tString  &in asTimer)
		{
			Sketchbook_Microflash("Dialogue_ElevatorRideWaiting", "OnVoiceEnd_ElevatorRideWaiting", -1, 0.4f);
			Map_AddTimer("Timer_StopMicroflashEffects", 4.f, "OnTimer_StopMicroflashEffects");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeInElevatorClouds(const tString &in asTimer)
		{
			Prop_SetActiveAndFade("ElevatorClouds", true, 8.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopMicroflashEffects(const tString &in asTimer)
		{
			Sketchbook_StopMicroflashEffects();
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_ElevatorRideWaiting(const tString &in asScene, const tString &in asSubject)
		{
			Map_AddTimer("Timer_PlayAfterElevatorRideDialogue", 4.5f, "OnTimer_PlayAfterElevatorRideDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayAfterElevatorRideDialogue(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_Play("Dialogue_AfterElevatorRideWaiting");
		}
				
		//-------------------------------------------------------
		
		bool OnTrigger_SoundElevatorCreak(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_ElevatorCreak", "04_03_undercity/elevator/player_arrive_creak", "Elevator_1");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnMoveLinear_ElevatorPowerOn(const tString &in asProp)
		{
			mlElevatorLevel = 2;
			
			Entity_CallEntityInteract("ElevatorButton_1_2");
			
			Lever_SetStuckState("ElevatorLever", 1, true);
			Lever_SetInteractionDisablesStuck("ElevatorLever", false);
			
			Lamp_SetLit("Elevator_2_Lamp*", false, false);
			
			Sound_Stop("Sound_ElevatorMove", 2.f);
			Sound_CreateAtEntity("Sound_ElevatorEnd", "04_03_undercity/elevator/elevator_stop", "Elevator_1");
			Sound_CreateAtEntity("Sound_ElevatorStop", "04_03_undercity/elevator/player_arrive", "Elevator_1");
			Sound_Play("Sound_ElevatorArriveVerb", 1.0f);
		}
		
		//-------------------------------------------------------

		//} END Event C *Pull the ELEVATOR LEVER*
		
		/////////////////////////////////////////
		// Event D *The ELEVATOR crashes down*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event D here.*/
		
		bool mbAllowOpenElevatorHatch = false;
		bool mbElevatorHatchOpened = false;
		bool mbSetElevatorDoorOpen = false;
		int mlElevatorDoorId = 1;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 4, Event D here.*/
		
		cSequenceStatesData mSeqDataElevatorCrash;
		void Seq_ElevatorCrash(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ElevatorCrash", mSeqDataElevatorCrash);
			Sequence_Wait(3.f);
			if (Sequence_DoStepAndWait(0.3f))
			{
				Sound_CreateAtEntity("Sound_ElevatorDrop", "04_03_undercity/elevator/elevator_drop", "Elevator_1");
			}
			else if (Sequence_DoStepAndWait(4.f))
			{						
				Voice_PlayDelayed("Dialogue_ElevatorStarts", 1.f);
				Prop_MoveLinearTo("Elevator_1", "Elevator_1_Goal", 0.125f, 3.6f, 1.f, false);
				
				FootPlacement_SetActive(PlayerBody_GetEntityName(), false);
			}
			else if (Sequence_DoStepAndPause(0.f))
			{
				Effect_Shake_Start(0.02f, 0.35f, 0.f, 0.25f);
				Sound_CreateAtEntity("Sound_ElevatorStop", "03_05_vitae_station/TEMP/stomping_gate_stop", "Elevator_1");			
				
				Prop_MoveLinearTo("Elevator_1", "Elevator_1_CrashGoal", 10.f, 20.f, 0.5f, true, "OnMoveLinear_ElevatorCrash");
				
				Voice_PlayDelayed("Dialogue_ElevatorFall", 0.5f);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Lamp_SetLit("Elevator_1_*", false, true);
				
				Effect_Shake_Start(0.05f, 0.35f, 0.f, 0.25f);
				
				Player_ChangeStateToNormal();
				
				//////////////////////////
				// Play land anim
				if (Entity_GetCollide("player", "Area_ElevatorInteriorSafe"))
				{
					float fDist = 0.f;
					cVector3f vNrm = 0.f;
					cVector3f vPos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition() + cVector3f(0.f, 0.5f, 0.f);
					 
					cLux_GetClosestBody(vPos, cVector3f_Down, 3.f, fDist, vNrm);
					vPos -= cVector3f(0.f, fDist, 0.f);
					
					if (fDist > 3.f)
						PlayerBody_PlayCutsceneAnimation("fall_and_get_up_slow", false, 0.3f, "OnAnimENd_ElevatorFall");
					else
						PlayerBody_PlayCutsceneAnimation("fall_and_get_up_slow", false, 0.3f, "OnAnimENd_ElevatorFall", 1.f, 0.f, true, vPos, cLux_GetPlayer().GetCharacterBody().GetYaw());
				}
				else
				{
					FootPlacement_SetActive(PlayerBody_GetEntityName(), true);
				}				
				
				Pregnancy_SetStage(ePregStage_BornRecovered);
				
				MovingButton_SetLocked("ElevatorButton_1_1", true, true);
				Lamp_SetLit("ElevatorBottomLamp_1_*", false, true);
				Lamp_SetLit("Lamp_Shaft_Right_*", false, true);
				
				Lamp_SetLit("ElevatorLamp_1_*", false, true);
				Entity_SetEffectsActive("Elevator_1", false, true);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Lamp_SetLit("HatchLamp", true, true);
				Lever_SetInteractionDisablesStuck("HatchLever", true);
				mbAllowOpenElevatorHatch = true;
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimENd_ElevatorFall(const tString &in asAnim)
		{
			FootPlacement_SetActive(PlayerBody_GetEntityName(), true);
		}
		
		//-------------------------------------------------------
		
		void OnMoveLinear_ElevatorCrash(const tString &in asProp)
		{
			Sound_Stop("Sound_ElevatorMove", 1.f);
			Sound_CreateAtEntity("Sound_ElevatorCrash", "03_03_herberts_hq/level_complete_events/pillar_room_complete/pillar_break_land", "Elevator_1");
			
			SequenceStates_Resume("Seq_ElevatorCrash");
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_HatchLever(const tString &in asEntity, int alState)
		{
			if (mbAllowOpenElevatorHatch == false || alState != 1)
				return;
				
			mbAllowOpenElevatorHatch = false;
			
			Lamp_SetLit("HatchLamp", false, true);
			Lever_SetInteractionDisablesStuck("HatchLever", false);
			SetElevatorHatchOpen(true);
		}
		
		//-------------------------------------------------------
		
		void SetElevatorHatchOpen(bool abX)
		{
			if (abX == false && mbElevatorHatchOpened == false)
				return;
			
			mbElevatorHatchOpened = abX;
			
			Entity_SetCollide("Elevator_1_Hatch", !abX);
			Entity_SetCollide("HatchLever", !abX);
			Prop_SetStaticPhysics("HatchLever", abX);
			Entity_SetCollideCharacter("Elevator_1_Hatch", !abX);
			Entity_SetCollideCharacter("HatchLever", !abX);			
			
			tString sTarget = abX ? "Elevator_1_Hatch_Open" : "Elevator_1_Hatch_Closed";
			Prop_AlignRotation("Elevator_1_Hatch", sTarget, 1.f, 1.f, 0.05f, true, "OnElevatorHatchOpen", "Area_HatchRotation");
			
			if (abX == false)
			{
				Entity_PlayProcAnimation("Elevator_1_Hatch", "Open", -1.f, false);
				Entity_SetActive("Ladder_Hatch", false);
				Entity_SetActive("InteractAux_Ladder_Hatch", false);
			}
			
			Sound_CreateAtEntity("Sound_HatchUnlock", "04_03_undercity/elevator_hatch/unlock", "Elevator_1_Hatch");
			Sound_CreateAtEntity("Sound_HatchOpen", "04_03_undercity/elevator_hatch/open", "Elevator_1_Hatch");
		}
		
		//-------------------------------------------------------
		
		void OnElevatorHatchOpen(const tString &in asPropName)
		{
			Map_AddTimer("Timer_StopHatchRotate", 0.f, "OnTimer_StopHatchRotate");
			Map_SetTimerUserVarInt("Timer_StopHatchRotate", mbElevatorHatchOpened ? 1 : -1);
		}
				
		//-------------------------------------------------------
		
		void OnTimer_StopHatchRotate(const tString &in asTimer)
		{
			Prop_StopMovement("Elevator_1_Hatch");
			Sound_Stop("Sound_HatchMove", 1.f);
			
			if (Map_GetTimerUserVarInt(asTimer) == 1)
				Entity_PlayProcAnimation("Elevator_1_Hatch", "Open", 1.f, false);
				
			Entity_SetCollide("Elevator_1_Hatch", true);
			Entity_SetCollide("HatchLever", true);
			Map_AddTimer("Timer_SetHatchCharCollision", 0.f, "OnTimer_SetHatchCharCollision");
			
			Lever_SetStuckState("HatchLever", -1, false);
			
			Entity_SetInteractionDisabled("Ladder_Hatch", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetHatchCharCollision(const tString &in asTimer)
		{
			if (Entity_GetCollide("player", "Area_BelowElevatorHatch") == false)
			{
				Entity_SetCollideCharacter("Elevator_1_Hatch", true);
				Entity_SetCollideCharacter("HatchLever", true);
			}
			else
			{
				Map_AddTimer("Timer_SetHatchCharCollision", 0.1f, "OnTimer_SetHatchCharCollision");
			}
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ElevatorButton(const tString &in asEntity)
		{
			if (mbElevatorCrashed == false)
				Voice_PlayDelayed("Dialogue_ElevatorButton", 0.75f);			
			if (mbElevatorCrashed && mbElevatorPowerOn == false)
				Voice_PlayDelayed("Dialogue_TryBrokenElevator", 2.f);
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_ElevatorButton(const tString &in asEntity, int alState)
		{
			int lId = cString_ToInt(cString_Sub(asEntity, 15, 1), -1);
			SetElevatorDoorOpen(lId, alState == 1);
		}
		
		//-------------------------------------------------------
		
		void SetElevatorDoorOpen(int alId, bool abX, bool abInstant = false)
		{
			mlElevatorDoorId = alId;
			mbSetElevatorDoorOpen = abX;
			
			if (abInstant)
			{
				SlideDoor_SetClosed("Elevator_" + alId + "_Door_*", abX == false, true);
				
				tString sAnim = mlElevatorLevel == 2 ? "OpenBack" : "OpenFront"; 
				float fLength = mbSetElevatorDoorOpen ? 0.01f : -0.01f;
				Entity_PlayProcAnimation("Elevator_" + mlElevatorDoorId, sAnim, fLength);
				return;
			}
			
			float fInnerDoorTime = 1.5f;
			float fOuterDoorTime = 0.f;
			
			Map_RemoveTimer("Timer_SetInnerDoorOpen");
			Map_RemoveTimer("Timer_SetOuterDoorOpen");
			Map_AddTimer("Timer_SetInnerDoorOpen", fInnerDoorTime, "OnTimer_SetInnerDoorOpen");
			Map_AddTimer("Timer_SetOuterDoorOpen", fOuterDoorTime, "OnTimer_SetOuterDoorOpen");
			
			if (abX == false && alId == 1)
			{
				tString sEnt = mlElevatorLevel == 2 ? "Blockbox_Elevator_Back" : "Blockbox_Elevator_Front";
				Entity_SetActive(sEnt, abX == false);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetInnerDoorOpen(const tString &in asTimer)
		{
			tString sAnim = mlElevatorLevel == 2 ? "OpenBack" : "OpenFront"; 
			float fLength = mbSetElevatorDoorOpen ? 1.5f : -1.5f;
			Entity_PlayProcAnimation("Elevator_" + mlElevatorDoorId, sAnim, fLength);
			
			float fAnimTime = Map_GetEntity("Elevator_" + mlElevatorDoorId, eLuxEntityType_Prop).GetMeshEntity().GetProcAnimationFromName(sAnim).GetTime();
			if (mbSetElevatorDoorOpen && fAnimTime < 1.f || mbSetElevatorDoorOpen == false && fAnimTime > 0.f)
			{
				tString sSound = "level_entity_shared/doors/DW_slide_door/" + (mbSetElevatorDoorOpen ? "open" : "close");
				Sound_CreateAtEntity("Sound_ElevatorDoorStart_" + mlElevatorDoorId, sSound, "Elevator_" + mlElevatorDoorId + "_Door_" + mlElevatorLevel + "_1");
				Sound_Stop("Sound_ElevatorDoorStop_" + mlElevatorDoorId, 0.3f);
				
				Map_RemoveTimer("Timer_PlayElevatorDoorStopSound");
				Map_AddTimer("Timer_PlayElevatorDoorStopSound", cMath_Abs(fLength) - 0.3f, "OnTimer_PlayElevatorDoorStopSound");
			}
			
			if (mlElevatorDoorId == 1)
			{
				tString sEnt = mlElevatorLevel == 2 ? "Blockbox_Elevator_Back" : "Blockbox_Elevator_Front";
				Entity_SetActive(sEnt, mbSetElevatorDoorOpen == false);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayElevatorDoorStopSound(const tString &in asTimer)
		{
			tString sSound = "level_entity_shared/doors/DW_slide_door/" + (mbSetElevatorDoorOpen ? "open_stop" : "close_stop");
			Sound_CreateAtEntity("Sound_ElevatorDoorStop_" + mlElevatorDoorId, sSound, "Elevator_" + mlElevatorDoorId + "_Door_" + mlElevatorLevel + "_1");
			Sound_Stop("Sound_ElevatorDoorStart_" + mlElevatorDoorId, 0.3f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetOuterDoorOpen(const tString &in asTimer)
		{
			SlideDoor_SetClosed("Elevator_" + mlElevatorDoorId + "_Door_*", mbSetElevatorDoorOpen == false);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_PlayPipeDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sketchbook_Microflash(Entity_GetVarString(asParent, ""));
			return false;
		}
		
		//-------------------------------------------------------

		//} END Event D *The ELEVATOR crashes down*
	 
	//} END SCENE 4
}