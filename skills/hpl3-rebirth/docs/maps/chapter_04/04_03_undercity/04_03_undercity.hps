		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event B here.*/
		
		bool mbBeamScareTriggered = false;
		bool mbDistantWraithScreamsPlayed = true;
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event B here.*/
		
		bool OnTrigger_Player_EnablePermaFail(const tString &in asParent, const tString &in asChild, int alState)
		{
			FearHandler_SetPermaFailEnabled(true);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartSeqBeamScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			StartBeamScare();
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartSeqBeamScare(const tString &in asEntity, int alState)
		{
			StartBeamScare();
		}
		
		//-------------------------------------------------------
		
		void StartBeamScare()
		{
			if (mbBeamScareTriggered == false)
			{
				mbBeamScareTriggered = true;
				Entity_SetActive("Trigger_StartSeqBeamScare_*", false);
				
				Seq_BeamScare("");
			}			
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataBeamScare;
		void Seq_BeamScare(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BeamScare", mSeqDataBeamScare);
			if (Sequence_DoStepAndWait(0.01f))
			{
				Entity_SetActive("Wraith_BeamScare", true);
				
				iLuxEntity@ pCrystal = Map_GetEntity("Wraith_BeamScare_crystal", eLuxEntityType_Prop);
				if (pCrystal !is null)
					pCrystal.GetLightFromName("Light_Spot_1").SetBrightness(0.f);
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				cVector3f vPos = Map_GetEntity("Area_WraithBeamScareTarget", eLuxEntityType_Area).GetPosition();
				Wraith_CommandLookAtPosition_Execute("Wraith_BeamScare", vPos, true, false, true, "");
				Wraith_SetSpotlightOn("Wraith_BeamScare", true, false, 0.f);
				
				FearHandler_SetForcedAddFearRate(0.4f, 5.f, true, -1.f, 0.1f, 0.2f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Entity_CallEntityInteract("MaintenanceDoor_1_Button_2");
				MovingButton_SetLocked("MaintenanceDoor_1_Button_2", true, true);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Wraith_SetSpotlightOn("Wraith_BeamScare", false);
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{
				Entity_SetActive("Wraith_BeamScare", false);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				mbDistantWraithScreamsPlayed = false;
				MovingButton_SetLocked("MaintenanceDoor_1_Button_2", false, true);
				Sound_CreateAtEntity("Sound_ButtonOn", "03_07_dw_factory/torture_victim/machine_feedback/button_positive", "MaintenanceDoor_1_Button_2");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_MaintenanceDoor(const tString &in asEntity, int alState)
		{
			if (alState == -1 || mbDistantWraithScreamsPlayed)
				return;
			
			mbDistantWraithScreamsPlayed = true;
			Map_AddTimer("Timer_PlayDistantWraithSounds", 3.f, "OnTimer_PlayDistantWraithSounds");
		}
				
		//-------------------------------------------------------
		
		void OnTimer_PlayDistantWraithSounds(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Sound_DistantWraith", "creatures/vocalisations/creature/wraith/distant_call_random", "player");
		}
		
