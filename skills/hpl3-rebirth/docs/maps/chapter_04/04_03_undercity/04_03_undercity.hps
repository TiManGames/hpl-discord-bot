	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	bool mbElevatorPowerOn = false;
	int mlPermaFailStage = eUndercityPermaFailStage_TopFloor;
	int mlGhoulLevelOnEnter = 0;
	array<int> mvUnplayedGenericPermaFails = { 1, 2, 3 };	
	
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	void VariableUpdate(float afDeltaTime)
	{
		UpdateElevatorPuzzleFogAreas(afDeltaTime);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_PlayDialogue(const tString &in asTimer)
	{
		Voice_Play(asTimer);
	}
	
	//-------------------------------------------------------
	
	void ResetPlayerMoveSpeed(bool abFade = false)
	{
		if (abFade)
		{
			Player_FadeRunSpeedMulTo(gfUndercityPlayerRunSpeedMul, 0.5f);
			Player_FadeMoveSpeedMulTo(gfUndercityPlayerMoveSpeedMul, 0.5f);
			return;
		}
		
		Player_SetMoveSpeedMul(gfUndercityPlayerMoveSpeedMul);
		Player_SetRunSpeedMul(gfUndercityPlayerRunSpeedMul);
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SetRespawnArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1)
			return true;
			
		if (Entity_PlayerIsInFront(asParent))
			mlPermaFailStage = eUndercityPermaFailStage_BottomFloor;
		else
			mlPermaFailStage = eUndercityPermaFailStage_TopFloor;
		
		return true;
	}
	
