	//} END MAIN FUNCTIONS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 1 *THE PLAYER FOLLOWS THE DOCTOR TO THE ELEVATOR*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 1 here.*/
		
		bool mbDoctorElevatorLeft = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 1 here.*/
			 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A *Spot the DOCTOR leaving in the ELEVATOR*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event A here.*/
		
		bool mbDoctorLeft = false;
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event A here.*/
		
		bool OnTrigger_Player_PlayObjectiveDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Dialogue_Objective", 1.f, "OnTimer_PlayDialogue");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_OpenEntranceDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			SlideDoor_SetClosed("EntranceDoor_*", alState == -1);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_SetupDoctorLeave(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Doctor", true);
			Entity_SetActive("Baby_Bottom", true);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_DoctorLeave(const tString &in asParent, const tString &in asChild, int alState)
		{			
			DoctorLeave();
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_DoctorBottom(const tString &in asEntity, int alState)
		{
			DoctorLeave();
			Voice_PlayDelayed("Dialogue_SeeDoctor", 0.1f, -1, "OnVoiceEnd_SeeDoctor");
		}
		
		//-------------------------------------------------------
		
		void DoctorLeave()
		{
			if (mbDoctorLeft) 
				return;
				
			Entity_SetActive("Trigger_SetupDoctorLeave", false);
			
			mbDoctorLeft = true;
			
			Sound_CreateAtEntity("Sound_BabyScreamBottom", "04_03_undercity/baby/baby_elevator", "Baby_Bottom");
			mBaseObj.GetWorld().GetSoundEntity("Sound_BabyScreamBottom").SetUseCustomProperties(true);
			mBaseObj.GetWorld().GetSoundEntity("Sound_BabyScreamBottom").SetCustomMaxDistance(40.f);
			Entity_AttachToSocket("Sound_BabyScreamBottom", "Doctor", "socket_righthand_damage", true, true);
			
			Seq_DoctorLeave("");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_SeeDoctor(const tString &in asScene, const tString &in asSubject)
		{
			Voice_SetSource("Doctor", "Doctor", 2.f, 38.f, true);
			Voice_PlayDelayed("Dialogue_DoctorAscent", 0.1f);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataDoctorLeave;
		void Seq_DoctorLeave(const tString &in asTimer)
		{
			Sequence_Begin("Seq_DoctorLeave", mSeqDataDoctorLeave);
			Sequence_Wait(2.5f);
			if (Sequence_DoStepAndWait(1.f))
			{				
				SetElevatorDoorOpen(2, false);
				CharMover_SetUseMoveStateAnimations("Doctor", false);
				
				Voice_PlayDelayed("Dialogue_DoctorAscent", 0.5f);
			
				Map_AddTimer("Timer_DisableDoctor", 20.f, "OnTimer_DisableDoctor");
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{
				Sound_CreateAtEntity("Sound_DoctorGate", "04_03_undercity/elevator/doctor_enter", "Elevator_2");
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{						
				Prop_MoveLinearTo("Elevator_2", "Elevator_2_Goal", 0.5f, 5.f, 1.f, false, "OnMoveLinear_DoctorElevator");
				Sound_CreateAtEntity("Sound_DoctorElevatorMove", "04_03_undercity/elevator/doctor_depart", "Elevator_2");
				
				Map_AddTimer("Dialogue_DoctorAscent", 1.f, "OnTimer_PlayDialogue");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{				
				Map_AddTimer("Timer_DoctorElevatorLeft", 5.f, "OnTimer_DoctorElevatorLeft");
				Map_AddTimer("Timer_ResetPlayerSpeed", 15.f, "OnTimer_ResetPlayerSpeed");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnMoveLinear_DoctorElevator(const tString &in asProp)
		{		
			Sound_Stop("Sound_DoctorElevatorMove", 1.f);
		}
		
		//-------------------------------------------------------
		
