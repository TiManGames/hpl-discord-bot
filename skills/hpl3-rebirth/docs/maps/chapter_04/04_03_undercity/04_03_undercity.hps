	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 2 *THE PLAYER FINDS HANK MITCHELL AND FIXES THE ELEVATOR*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 2 here.*/
		
		int mlElevatorShaftLampId = 1;
		int mlActiveElevatorId = 2;
		bool mbDoorClosed = true;
		bool mbElevatorPuzzleSolved = false;
		bool mbUpdateElevatorPuzzleFogAreas = true;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 2 here.*/
		
		void UpdateElevatorPuzzleFogAreas(float afDeltaTime)
		{
			if (mbUpdateElevatorPuzzleFogAreas == false)
				return;
			
			bool bUpdate = false;			
			for (int i = 1; i < 3; ++i)
			{
				cFogArea@ pFogArea = mBaseObj.GetWorld().GetFogArea("FogArea_Elevator_" + i);
				if (pFogArea is null)
					continue;
				
				float fAlphaGoal = i == mlActiveElevatorId ? 0.3f : 1.f;
				float fAlpha = pFogArea.GetColor().a;
				fAlpha = cMath_IncreaseTo(fAlpha, afDeltaTime, fAlphaGoal);
				pFogArea.SetColor(cColor(0.f, 0.f, 0.f, fAlpha));
				
				if (fAlpha != fAlphaGoal)
					bUpdate = true;
			}
			
			if (bUpdate == false)
				mbUpdateElevatorPuzzleFogAreas = false;
		}
		
		//-------------------------------------------------------
		
		void SetElevatorActive(int alId, int alCableId, bool abX)
		{
			if (abX)
				mlActiveElevatorId = alId;
			else
				mlActiveElevatorId = -1;
				
			mbUpdateElevatorPuzzleFogAreas = true;
			
			tString sSide = (alId == 1 ? "Right" : "Left");
			tString sCableLamp = "CableLamp_" + sSide + "_*";
			Lamp_SetLit(sCableLamp, abX, true);
			Entity_FadeEffectBaseColor(sCableLamp, abX ? cColor(2.f) : cColor(0.f), abX ? 2.f : 0.3f);
			
			if (abX)
				Map_AddTimer(sCableLamp, 2.f, "OnTimer_ResetCableLampBrightness");
				
			Lamp_SetLit("ElevatorBottomLamp_" + alId + "_*", abX, true);
			Lamp_SetLit("ElevatorLamp_" + alId + "_*", abX, true);
			Entity_SetEffectsActive("Elevator_" + alId, abX, true);
			
			tString sShaftLamp = "Lamp_Shaft_" + sSide + "_";
			
			if (abX)
			{
				mlElevatorShaftLampId = 1;
				Map_AddTimer(sShaftLamp, 0.75f, "OnTimer_ActivateElevatorShaftLamps");
			}
			else
			{
				mlElevatorShaftLampId = 0;
				Map_RemoveTimer(sShaftLamp);
				Lamp_SetLit(sShaftLamp + "*", false, true);
			}
			
			tString sSoundArea = "Area_ElevatorFeedbackSound_" + alId;			
			Sound_CreateAtEntity("Sound_ElevatorCableAttach", "03_05_vitae_station/milking_machine/milking_machine_close_metal", sSoundArea);
			
			if (abX)	Sound_Play("Sound_ElevatorEngine_" + alId, 1.f);
			else		Sound_Stop("Sound_ElevatorEngine_" + alId, 1.f);
			
			///////////////////////////
			// Specifics for elevator 1
			if (alId != 1) 
				return;
			
			if (abX)
			{
				mbElevatorPowerOn = true;
				
				MovingButton_SetLocked("ElevatorButton_1_1", false, true);								
				Sound_CreateAtEntity("Sound_ElevatorFeedback", "04_03_undercity/machine/energy_on", sSoundArea);
				
				Light_FadeBrightnessTo("Light_Spot_ElevatorStart", 9.f, 1.f, eEasing_CubicIn);
				Map_AddTimer("Timer_FadeOutElevatorStartLight", 3.f, "OnTimer_FadeOutElevatorStartLight");
				
				Map_AddTimer("Timer_ActivateElevator", 1.5f, "OnTimer_ActivateElevator");
				
				if (mbElevatorPuzzleSolved == false)
				{
					mbElevatorPuzzleSolved = true;
					Seq_HankReveal("");
				}
			}
			else
			{
				mbElevatorPowerOn = false;
				
				Prop_StopMovement("Elevator_1");
				MovingButton_SetLocked("ElevatorButton_1_1", true, true);
				
				Sound_Stop("Sound_ElevatorStart", 2.f);
				Sound_Stop("Sound_ElevatorMove", 2.f);
								
				if (alCableId == 1)
					Sound_CreateAtEntity("Sound_ElevatorFeedback", "04_03_undercity/machine/energy_off", sSoundArea);
				
				Map_RemoveTimer("Timer_ActivateElevator");
			}		
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetCableLampBrightness(const tString &in asTimer)
		{
			Entity_FadeEffectBaseColor(asTimer, cColor(1.f), 1.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateElevator(const tString &in asTimer)
		{
			SetElevatorHatchOpen(false);			
			Sound_CreateAtEntity("Sound_ElevatorActive", "03_03_herberts_hq/alter_open/orb_machine_clunk", "Area_ElevatorSound_1");			
	
			//Voice_PlayDelayed("Dialogue_PuzzleSolved", 3.f);			
			
			Entity_SetActive("Trigger_SpawnWraith", true);
			Entity_SetActive("Trigger_PlayWraithScareSound", true);
			
			if (Entity_GetDeltaToEntity("Elevator_1", "Elevator_1_StartGoal").Length() <= 0.f)
				return;
				
			Effect_Shake_Start(0.01f, 2.f, 0.5f, 0.5f);
			
			Prop_MoveLinearTo("Elevator_1", "Elevator_1_StartGoal", 0.5f, 5.f, 0.f, false, "OnMoveLinear_ElevatorStart");
			
			Sound_CreateAtEntity("Sound_ElevatorStart", "04_03_undercity/elevator/player_depart", "Elevator_1");
			Sound_CreateAtEntity("Sound_ElevatorMove", "04_03_undercity/elevator/doctor_elevator_motor", "Elevator_1");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeOutElevatorStartLight(const tString &in asTimer)
		{
			Light_FadeBrightnessTo("Light_Spot_ElevatorStart", 0.f, 1.f, eEasing_SineOut);
		}
		
		//-------------------------------------------------------
		
		void OnMoveLinear_ElevatorStart(const tString &in asProp)
		{			
			Lever_SetStuckState("ElevatorLever", -1, true);
			Lever_SetInteractionDisablesStuck("ElevatorLever", true);
			
			SetElevatorDoorOpen(1, true);
			MovingButton_SetSwitchedOn("ElevatorButton_1_1", true, true);
			
			Sound_Stop("Sound_ElevatorStart", 2.f);
			Sound_Stop("Sound_ElevatorMove", 2.f);
			
			Effect_Shake_Start(0.01f, 1.f, 0.5f, 0.5f);
			
			Sound_CreateAtEntity("Sound_ElevatorEnd", "04_03_undercity/elevator/elevator_stop", "Elevator_1");
			Sound_CreateAtEntity("Sound_ElevatorStop", "04_03_undercity/elevator/player_arrive", "Elevator_1");
		}
		
		//-------------------------------------------------------
		
		void SetElevatorCogsActive(bool abX, bool abLeft, float afSpeed = 1.f)
		{
			tString sSide = abLeft ? "Left" : "Right";
			tString sCog = "Cog_" + sSide + "_";
			tString sSpinningLight = "CogLight_" + sSide + "_*";
			tString sPipe = "VitaePipe_" + sSide + "_*";
			
			if (abX)
			{				
				Entity_FadeProcAnimationSpeed(sCog + "1", "Spin", afSpeed, 2.f);
				Entity_FadeProcAnimationSpeed(sCog + "2", "Spin", -afSpeed, 2.f);
				Entity_FadeProcAnimationSpeed(sCog + "3", "Spin", afSpeed, 2.f);
				Entity_FadeProcAnimationSpeed(sCog + "4", "Spin", -afSpeed, 2.f);
				Entity_FadeProcAnimationSpeed(sCog + "5", "Spin", afSpeed, 2.f);
				Entity_FadeProcAnimationSpeed(sCog + "6", "Spin", -afSpeed, 2.f);
				Entity_FadeProcAnimationSpeed(sCog + "7", "Spin", afSpeed, 2.f);
				Entity_FadeProcAnimationSpeed(sCog + "8", "Spin", -afSpeed, 2.f);
				
				Lamp_SetLit(sPipe, true, true);
				
				Entity_SetEffectsActive(sSpinningLight, true, true);
				Prop_RotateToSpeed(sSpinningLight, 4.f, 10.f, false, "");
				
				Sound_CreateAtEntity("Sound_CogsStart_" + sSide, "04_03_undercity/elevator_engine/elevator_start", sCog + "1");
				
				Sound_CreateAtEntity("SoundSubstationStart", "04_03_undercity/elevator_engine/substation_start", "Sound_Substation");
				Sound_CreateAtEntity("Sound_SubstationLoop", "04_03_undercity/elevator_engine/substation_loop", "Sound_Substation");

				Map_AddTimer("Timer_ClunkSoundStart", 0.01f, "OnTimer_PlayEngineClunk");
				
				//Sound_Play("Sound_ElevatorClunk_" + sSide, 0.5f);
			}
			else
			{
				Entity_FadeProcAnimationSpeed(sCog + "1", "Spin", 0.f, 5.f);
				Entity_FadeProcAnimationSpeed(sCog + "2", "Spin", 0.f, 5.f);
				Entity_FadeProcAnimationSpeed(sCog + "3", "Spin", 0.f, 5.f);
				Entity_FadeProcAnimationSpeed(sCog + "4", "Spin", 0.f, 5.f);
				Entity_FadeProcAnimationSpeed(sCog + "5", "Spin", 0.f, 5.f);
				Entity_FadeProcAnimationSpeed(sCog + "6", "Spin", 0.f, 5.f);
				Entity_FadeProcAnimationSpeed(sCog + "7", "Spin", 0.f, 5.f);
				Entity_FadeProcAnimationSpeed(sCog + "8", "Spin", 0.f, 5.f);
				
				Lamp_SetLit(sPipe, false, true);
				
				Entity_SetEffectsActive(sSpinningLight, false, true);
				Prop_StopMovement(sSpinningLight);
				
				//Sound_Stop("Sound_ElevatorClunk_" + sSide, 0.5f);
				Sound_Stop("Sound_SubstationLoop", 0.5f);
				Sound_CreateAtEntity("Sound_CogsStop_" + sSide, "04_03_undercity/elevator_engine/elevator_stop", sCog + "1");
				
				Map_RemoveTimer("Timer_ClunkDelaySound");
			}
		}
		
		//-------------------------------------------------------

		bool open(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				{
					mbDoorClosed = false;
					return true;
				}
			else
				{
					mbDoorClosed = true;
					return true;
				}
			
		}
		
		//-------------------------------------------------------

		void OnTimer_PlayEngineClunk(const tString &in asTimer)
		{
			if (mbDoorClosed == true)
				{	
					Sound_Play("Sound_ElevatorClunkOccluded", 0.0f);
					Map_AddTimer("Timer_ClunkDelay", 0.01f, "OnTimer_ClunkDelay");
				}
			else if (mbDoorClosed == false)
				{
					Sound_Play("Sound_ElevatorClunk", 0.0f);
					Map_AddTimer("Timer_ClunkDelay", 0.01f, "OnTimer_ClunkDelay");
				}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ClunkDelay(const tString &in asTimer)
		{
			Map_AddTimer("Timer_ClunkDelaySound", 1.5f, "OnTimer_PlayEngineClunk");
		}
		
		//-------------------------------------------------------
		
		bool OccludeOn(const tString &in asParent, const tString &in asChild, int alState)
			{
				Entity_SetActive("Trigger_DoorOcclusion", true);
				return true;
			}
			
		//-------------------------------------------------------

		bool OccludeOff(const tString &in asParent, const tString &in asChild, int alState)
			{
				Entity_SetActive("Trigger_DoorOcclusion",false);
				return true;
			}
			
		//------------------------------------------------------
		
		void OnTimer_ActivateElevatorShaftLamps(const tString &in asTimer)
		{
			tString sLamp = asTimer + mlElevatorShaftLampId;
			if (Entity_Exists(sLamp + "_1") == false)
				return;
			
			Lamp_SetLit(sLamp + "_*", true, true);			
			Sound_CreateAtEntity("Sound_ElevatorCogLampOn", "03_03_herberts_hq/alter_open/alter_lights_off", sLamp + "_1", 0.f, false, 1.f, 10.f, 150.f);
			
			mlElevatorShaftLampId++;
			Map_AddTimer(asTimer, 0.75f, "OnTimer_ActivateElevatorShaftLamps");
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_SetPermaFailEnabled(const tString &in asParent, const tString &in asChild, int alState)
		{
			FearHandler_SetPermaFailEnabled(alState == -1);
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END General	
		
