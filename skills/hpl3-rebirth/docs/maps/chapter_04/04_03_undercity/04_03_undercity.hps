		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event B here.*/
		
		void OnLookAt_PlayHankMemory(const tString &in asEntity, int alState)
		{
			OnTimer_PlayHankMemory("");
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_PlayHankMemory(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_PlayHankMemory", 0.5f, "OnTimer_PlayHankMemory");
			Entity_SetActive("Trigger_PlayHankMemory_*", false);
			return false;
		}

		//-------------------------------------------------------
		
		void OnTimer_PlayHankMemory(const tString &in asTimer)
		{
			if (Entity_IsActive("Wraith_Stairs"))
				return;
			
			if (Sketchbook_IsFlashbackActive() || Sketchbook_IsMicroflashActive())
			{
				Map_RestartCurrentTimer();
				return;
			}
			
			Sketchbook_UnlockMemory("MitchellTurns", true, "OnMemoryEnd_MitchellTurns");
		}
		
		//-------------------------------------------------------
		
		void OnMemoryEnd_MitchellTurns(const tString &in asScene, const tString &in asSubject)
		{
			Voice_PlayDelayed("Dialogue_AfterMitchellTurns", 0.1f);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_PuzzleDoor(const tString &in asEntity)
		{
			Map_RemoveTimer("Timer_UpdatePuzzleDoorLight");
			Map_AddTimer("Timer_UpdatePuzzleDoorLight", 0.f, "OnTimer_UpdatePuzzleDoorLight");
			
			OnEncounterDoorInteract(asEntity);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UpdatePuzzleDoorLight(const tString &in asTimer)
		{
			if (Entity_IsInteractedWith("Door_Puzzle") == false && Entity_IsSleeping("Door_Puzzle"))
				return;
			
			float fT = cMath_Clamp(1.f - SwingDoor_GetOpenAmount("Door_Puzzle"), 0.f, 1.f);
			cColor color = cColor(0.f) * (1.f - fT) + cColor(0.349,0.703,0.791,0) * fT;
			Light_FadeTo("Light_PuzzleDoor", color, 1.f, 0.1f);
			Billboard_SetBrightness("Billboard_PuzzleDoor", 0.05f * fT);
			
			Map_AddTimer("Timer_UpdatePuzzleDoorLight", 0.1f, "OnTimer_UpdatePuzzleDoorLight");
		}
		
		//-------------------------------------------------------

		//} END Event B *Get a flashback of Hank*
		
