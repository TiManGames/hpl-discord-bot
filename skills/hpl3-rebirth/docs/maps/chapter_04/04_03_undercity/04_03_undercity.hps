//--------------------------------------------------
 
/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/
 
//--------------------------------------------------

const float gfUndercityPlayerMoveSpeedMul = 0.8f;
const float gfUndercityPlayerRunSpeedMul = 0.75f;

//--------------------------------------------------
 
enum eUndercityPermaFailStage
{
	eUndercityPermaFailStage_TopFloor,
	eUndercityPermaFailStage_BottomFloor
};
 
//--------------------------------------------------

class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("04-03-undercity");
		
		// Reset effects
		Effect_Bloom_FadeBrightPass(0.75f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(0.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		Pregnancy_SetStage(ePregStage_Born);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Born);
		Pregnancy_SetBabyKicksEnabled(false);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(true);
		FearHandler_SetWhisperStage(eFearWhisperStage_BirthToThroneRoom);
		
		Player_SetCameraFarPlane(8192.0f);
		
		cScript_SetGlobalVarBool("Global_LanternLost", true);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(2);
		StruggleFlashHandler_SetProgression(2);
		
		Player_SetAutoTeleportWhenBelowAltitude(-200.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("ps_impact_metal_high.ps");
		ParticleSystem_Preload("sparks_small.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		///////////////
		// Preload sounds
		//Sound_PreloadProject("04_03_undercity");
				
		///////////////
		// Preload entities
		Entity_Preload("dw_solidifier_syringe_rigid.ent");
		Entity_Preload("player6.ent");
		
		///////////////v
		// Preload materials
		int lGhoulProgression = GhoulProgression_GetProgression();			
		if (lGhoulProgression >= GHOUL_PROGRESSION_MIRROR_HIGH)
		{
			Entity_Preload("player6_head_ghoul_3.ent");
		}
		else if (lGhoulProgression >= GHOUL_PROGRESSION_MIRROR_MED)
		{
			Entity_Preload("player6_head_ghoul_2.ent");
		}
		else
		{
			Entity_Preload("player6_head_ghoul_1.ent");
		}
		
		Material_Preload("Tasi_Body_Upgrade_hands_ghoul_" + lGhoulProgression + ".mat");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(20);
		
		// Any general setup of script / entities
		
		/////////////////////////
		// Debug
		if (cLux_ScriptDebugOn())
		{
			if (ItemType_GetCountInInventory("ShadowFleshCanister") == 0)
			{
				Item_AddToInventory("ShadowFleshCanister");
				Item_AddToInventory("Matchbook");
				Item_SetAmount(ItemType_GetFirstInInventory("ShadowFleshCanister"), 3);
			}
			
			if (ItemType_GetCountInInventory("VitaeCanister") == 0)
			{
				Item_AddToInventory("VitaeCanister");
			}
		}
		
		Player_SetAllowCheckBaby(false);
		Player_SetVertigoActive(false);
		Player_SetJumpDisabled(false);
		
		///////////////////////////
		// Set up Doctor chase
		Player_SetMoveSpeedMul(gfUndercityPlayerMoveSpeedMul);
		Player_SetRunSpeedMul(0.5f);
		
		Entity_AttachToSocket("Baby_Bottom", "Doctor", "j_R_HandSocket", true, true);
		Entity_PlayAnimation("Baby_Bottom", "baby_held_by_idling_doctor", 0.f, true);
		
		Entity_AttachToEntity("InteractAux_ElevatorLever", "ElevatorLever", "Body_1", true, false, true);
		Entity_AttachToEntity("InteractAux_HatchLever", "HatchLever", "Body_1", true, false, true);
		Entity_AttachToEntity("InteractAux_Ladder_Hatch", "Elevator_1_Hatch", "hatch", true, false, true);
		
		///////////////////////////
		// Set up elevator puzzle
		Entity_SetInteractionDisabled("Ladder_Hatch", true);
		
		cLuxAgent@ pHank = cLux_ToAgent(Map_GetEntity("Hank", eLuxEntityType_Agent));
		if (pHank !is null)
			pHank.GetCharBody().SetTestCollision(false);
		
		Entity_PlayAnimation("Hank", "idle_sleep", 0.f, true);
		Entity_PlayAnimation("HankCable", "cable_hank_idle_sleep", 0.f, true);
		
		StickyArea_AttachBody("Sticky_PowerCable_1_Left", "PowerCable_1_Body_11");
		
		for (int i = 1; i < 9; ++i)
			Entity_PlayProcAnimation("Cog_Left_" + i, "Spin", i % 2 != 0 ? 1.f : -1.f, true, 0.f);
		for (int i = 1; i < 9; ++i)
			Entity_PlayProcAnimation("Cog_Right_" + i, "Spin", i % 2 != 0 ? 1.f : -1.f, true, 0.f);
		
		SetElevatorCogsActive(true, true);		
		SetElevatorCogsActive(false, false);
		
		Entity_AttachToEntity("InteractAux_BrokenBar_1", "BrokenBar_1", "Body_1", true, false, true);
		Entity_AttachToEntity("InteractAux_BrokenBar_2", "BrokenBar_2", "Body_1", true, false, true);
		
		// End of static cable not visible, linking it with another cable
		iLuxEntity@ pCable_1 = Map_GetEntity("undercity_cable_2", eLuxEntityType_Prop); 
		iLuxEntity@ pCable_2 = Map_GetEntity("undercity_cable_3", eLuxEntityType_Prop); 
		if (pCable_1 !is null && pCable_2 !is null)
		{
			pCable_1.GetMeshEntity().GetSubMeshEntityName("plug").SetVisible(false);
			pCable_2.GetMeshEntity().GetSubMeshEntityName("connector").SetVisible(false);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{		
		cVector3f vRot = cVector3f(0, cMath_ToRad(93), 0); //old value 110
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);
		
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		// Setup physics world
		cLuxArea@ pArea = cLux_ToArea(mBaseObj.GetEntityByName("Area_PhysicsWorld", eLuxEntityType_Area));
		cBoundingVolume@ pAreaBounds = pArea.GetAreaBody().GetBoundingVolume();
		mBaseObj.GetPhysicsWorld().SetWorldSize(pAreaBounds.GetMin(), pAreaBounds.GetMax());
		
		Achievement_Unlock(eAchievement_Mother);		
		
		PlayerBody_SetActive(true);		
		Player_SetJumpForceMul(1.f);		
		Player_SetMapDeepShadow(0.2f);
		Player_SetNightVisionBrightness(3.5f);
		Player_SetNightVisionRadius(6.f);
		
		FearHandler_SetPermaFailEnabled(false);
		FearHandler_SetPermafailBabySceneEnabled(false, false);
		
		RiftHandler_SetAllowHint(false);		
        Heat_SetActive(false);
		
		Blackboard_AddWraithBillboards("WraithBillboard");
		
		ItemType_RemoveFromInventory("CurseMedallion");
		
		SetElevatorDoorOpen(2, true, true);
		
		mlGhoulLevelOnEnter = GhoulProgression_GetProgression();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Player_RestoreClipPlane();
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail(const tString &in asSource)
	{
		FearHandler_ClearPermaFailScenes();
		
		///////////////
		// Setup permafail
		switch (mlPermaFailStage)
		{
			case eUndercityPermaFailStage_TopFloor:		return OnPermaFail_TopFloor(asSource);
			case eUndercityPermaFailStage_BottomFloor:	return OnPermaFail_BottomFloor(asSource);
		}		
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 4; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);
		
		tString sAreaBase = "Area_PermaFail";
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_1", sAreaBase + "_1_End_1", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_2", sAreaBase + "_1_End_2", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_3", sAreaBase + "_1_End_3", 3.5f, 2.25f, true);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 2.f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_2", sAreaBase + "_2_End_2", 2.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_3", sAreaBase + "_2_End_3", 2.f, 2.25f, true);
				break;
			case 3:
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_1", sAreaBase + "_3_End_1", 2.f, 2.25f, true, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_2", sAreaBase + "_3_End_2", 3.f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_3", sAreaBase + "_3_End_3", 3.f, 2.25f, true);
				break;
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if (alAction == eAction_Test0)
		{
			cLux_SetScriptDebugOn(false);
			Player_Teleport("Start_Begin");
		}
		
		if (alAction == eAction_Test1)
		{
			cLux_SetScriptDebugOn(false);
			Entity_SetActive("Doctor", false);
			Entity_SetActive("Baby_Bottom", false);
			Entity_SetActive("Trigger_DoctorLeave", false);
			Entity_PlaceAtEntity("Elevator_2", "Elevator_2_Goal");
			MovingButton_SetLocked("ElevatorButton_2_1", true);
			Entity_SetEffectsActive("ElevatorButton_2_1", false, true);
			Player_SetRunSpeedMul(1.f);
			Entity_SetActive("Trigger_PlayFountainMemory", false);
			mbDoctorElevatorLeft = true;
			Player_Teleport("Start_MaintenanceHub");
			
			Pregnancy_SetStage(ePregStage_BornRecovered);
		}
		
		if (alAction == eAction_Test2)
		{
			cLux_SetScriptDebugOn(false);
			Entity_SetActive("Doctor", false);
			Entity_SetActive("Baby_Bottom", false);
			Entity_SetActive("Trigger_DoctorLeave", false);
			Entity_PlaceAtEntity("Elevator_2", "Elevator_2_Goal");
			MovingButton_SetLocked("ElevatorButton_2_1", true);
			Entity_SetEffectsActive("ElevatorButton_2_1", false, true);
			Player_SetRunSpeedMul(1.f);
			mbDoctorElevatorLeft = true;
			OnAttach_PowerCable1_Right("Elevator_1", "");
			Map_RemoveTimer("Timer_ActivateElevator");
			OnTimer_ActivateElevator("");			
			Entity_SetActive("Trigger_PlayFountainMemory", false);
			Player_Teleport("Start_Elevators");
						
			Pregnancy_SetStage(ePregStage_BornRecovered);
		}
		
		if (alAction == eAction_Test3)
		{
			Entity_SetActive("Doctor", false);
			Entity_SetActive("Baby_Bottom", false);
			Entity_SetActive("Trigger_DoctorLeave", false);
			Entity_PlaceAtEntity("Elevator_2", "Elevator_2_Goal");
			MovingButton_SetLocked("ElevatorButton_2_1", true);
			Entity_SetEffectsActive("ElevatorButton_2_1", false, true);
			Player_SetRunSpeedMul(1.f);
			Entity_SetActive("Trigger_PlayFountainMemory", false);
			mbDoctorElevatorLeft = true;
			Player_Teleport("Start_MaintenanceHub");
			
			Pregnancy_SetStage(ePregStage_BornRecovered);
			
			mbElevatorCrashed = true;				
			Seq_ElevatorCrash("");
		}
		
		if (alAction == eAction_Test4)
		{
			ResetPlayerMoveSpeed(false);
			Entity_SetActive("Trigger_SpawnWraith", true);
			Player_Teleport("Start_Encounter");
		}
		
		if (alAction == eAction_Test5)
		{
			cScript_SetGlobalVarBool("SalimsRingVisible", true);
			
			iLuxEntity@ pRing = Map_GetEntity("SalimsRing_Accessory", eLuxEntityType_Prop);
			if (pRing !is null)
				pRing.GetMeshEntity().SetVisible(true);
		}
		
		if (alAction == eAction_Test6)
		{
			Entity_SetActive("Wraith_Stairs", true);
			Wraith_CommandPatrol_AddNode("Wraith_Stairs", "PathNode_141");
			Wraith_CommandPatrol_Execute("Wraith_Stairs", true, 0, false, false);
		}
		
		if (alAction == eAction_Test7)
		{
			cLux_SetScriptDebugOn(false);
			Entity_SetActive("Doctor", false);
			Entity_SetActive("Baby_Bottom", false);
			Entity_SetActive("Trigger_DoctorLeave", false);
			Entity_PlaceAtEntity("Elevator_2", "Elevator_2_Goal");
			MovingButton_SetLocked("ElevatorButton_2_1", true);
			Entity_SetEffectsActive("ElevatorButton_2_1", false, true);
			Player_SetRunSpeedMul(1.f);
			mbDoctorElevatorLeft = true;
			OnAttach_PowerCable1_Right("Elevator_1", "");
			Map_RemoveTimer("Timer_ActivateElevator");
			OnTimer_ActivateElevator("");			
			Entity_SetActive("Trigger_PlayFountainMemory", false);
			Entity_SetActive("Trigger_PlayHankMemory_*", false);
			Player_Teleport("Start_Puzzle");
			SlideLock_SetOpenAmount("tin_hinan_door_lock_1", 1);
			
			Pregnancy_SetStage(ePregStage_BornRecovered);
		}
		
		if (alAction == eAction_Test8)
		{
			//Entity_PlayProcAnimation("Elevator_1", "OpenFront", -1.5f, false);
			//Entity_PlayProcAnimation("Elevator_1", "OpenBack", -1.5f, false);
			//SetElevatorDoorOpen(2, true, true);
			
			//Prop_SetCustomMaterial(PlayerBody_GetEntityName(), "head_ghoul_03.mat", "m_Tasi_Head");
			
			OnAttach_PowerCable1_Right("Elevator_1", "");
		}
		
		if (alAction == eAction_Test9)
		{
			Voice_PlayDelayed("Global_Tasi_Bark_Stage2_Climb_Long", 1.f, 4);
			//Item_AddToInventory("Matchbook");
		}
		
		if (alAction == eAction_TestMinus)
		{
			//Material_Preload("head_ghoul_01.mat");
			//Material_Preload("head_ghoul_02.mat");
			//Material_Preload("head_ghoul_03.mat");
			//Material_Preload("head_ghoul_01_hair.mat");
			//Material_Preload("head_ghoul_02_hair.mat");
			//Material_Preload("head_ghoul_03_hair.mat");
			
			//GhoulProgression_Increase(true, true);
			
			GhoulProgression_SetProgression(GHOUL_PROGRESSION_MIRROR_MED);
			mlGhoulLevelOnEnter = GHOUL_PROGRESSION_MIRROR_MED;
		}
		
		if (alAction == eAction_TestPlus)
		{
			GhoulProgression_SetProgression(GHOUL_PROGRESSION_MIRROR_HIGH);
			mlGhoulLevelOnEnter = GHOUL_PROGRESSION_MIRROR_HIGH;
			
			//FearHandler_FadeLevelTo(1.f, 1.f);
			//FearHandler_SetForcedAddFearRate(1.f, 10.f, false);
		}
	}

