		//-------------------------------------------------------
		
		void OnTimer_PlayDossierMicroflash(const tString &in asTimer)
		{
			if (Voice_SceneInvolvingCharacterIsActive("Player") ||
				Sketchbook_IsMicroflashActive() ||
				Sketchbook_IsFlashbackActive())
				return;
			
			Sketchbook_Microflash("Microflash_HankNote_Hank", "OnVoiceEnd_HankNote");
		}
		
