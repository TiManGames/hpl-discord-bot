		//-------------------------------------------------------
		
		void UnlockFountainMemory()
		{
			if (mbFountainMemoryPlayed)
				return;
				
			mbFountainMemoryPlayed = true;
			
			Voice_StopAll();
			
			Map_RemoveTimer("Timer_CheckShouldPlayCylinderDialogue");
			Map_RemoveTimer("Timer_PlayCylinderDialogue");
			Voice_AbortIfQueued("Dialogue_ReactSaboteur");
			
			Sketchbook_UnlockMemory("TheFountain", true, "OnMemoryEnd_Fountain");
		}
		
