		{
			if (mbPressedDoctorElevatorButton)
				return;
				
			mbPressedDoctorElevatorButton = true;
			
			MovingButton_SetLocked("ElevatorButton_2_1", true);
			Entity_SetEffectsActive("ElevatorButton_2_1", false, true);
			
			ParticleSystem_CreateAtEntity("PS_Sparks", "sparks_tiny.ps", asEntity, false);
			Sound_CreateAtEntity("Sound_ButtonBroken", "01_01_wreckage/events/radio_spark", asEntity);
				
			Voice_PlayDelayed("Dialogue_BrokenElevatorButton", 1.f);
		}
		
