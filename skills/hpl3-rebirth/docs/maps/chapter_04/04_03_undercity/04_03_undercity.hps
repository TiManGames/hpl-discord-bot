		/*Put any functions that are only used in Scene 1, Event D here.*/
		
		void OnInteract_SaboteurMemoryCyliner(const tString &in asEntity)
		{
			Map_AddTimer("Timer_CheckShouldPlayCylinderDialogue", 0.1f, "OnTimer_CheckShouldPlayCylinderDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckShouldPlayCylinderDialogue(const tString &in asTimer)
		{
			if (cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Custom_ReadMemoryCylinder)
			{
				Map_RestartCurrentTimer();
				return;
			}
			
			Map_AddTimer("Timer_PlayCylinderDialogue", 1.f, "OnTimer_PlayCylinderDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayCylinderDialogue(const tString &in asTimer)
		{
			if (cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Custom_ReadMemoryCylinder)
			{
				Map_AddTimer("Timer_CheckShouldPlayCylinderDialogue", 0.1f, "OnTimer_CheckShouldPlayCylinderDialogue");
				return;
			}
			
			Voice_PlayWhenPossible("Dialogue_ReactSaboteur");
		}
		
