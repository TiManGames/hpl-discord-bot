//--------------------------------------------------
 
/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/
 
//--------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	bool mbIsGhoulEnding = true;
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("04-05-darkworld");
		
		// Set up color grading etc.
		Effect_Bloom_FadeBrightPass(0.3f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(1.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
				
		Pregnancy_SetStage(ePregStage_BornRecovered);
		Pregnancy_SetBarksActive(false);
		Pregnancy_SetBabyKicksEnabled(false);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Born);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingMonster);
		Player_SetAllowCheckBaby(false);
		Player_SetCrouching(false, true, true);
		FearHandler_SetWhispersActive(false);
		PlayerBody_ResetCutscenePitchYawLimits();
		
		Map_Preset_SetupDirLight("Preset_LightningOn", true, cColor(1,1.5,2,1), 20, cVector3f(-0.913, -0.407, -0.009), cColor(0.092,0.069,0.069,1), cColor(0.092,0.069,0.069,1));
		Map_Preset_SetupBloom("Preset_LightningOn", 10, 0.02f, 1.5f, cColor(1, 2, 2, 1));
		
		Map_Preset_SetupDirLight("Preset_LightningOff", false, cColor(0.269,0.339,0.35,1), 0.f, cVector3f(-0.644, -0.462, 0.61), cColor(0.222,0.289,0.299,1), cColor(0.101,0.171,0.182,1));
		Map_Preset_SetupBloom("Preset_LightningOff", 128.f, 0.75f, 0.5f, cColor(1.f));
		
		Map_Preset_Fade("Preset_LightningOff", 1.f);
		Map_SetSkyboxRotation(cVector3f(0, 90, 0));
		
		StruggleFlashHandler_SetActive(false);
		StruggleFlashHandler_PreloadFlashGroupTextures(7);
		StruggleFlashHandler_SetProgression(7);
		
		ParticleSystem_SetActive("PS_Destruction*", false);
        ParticleSystem_SetActive("PS_BigExplo*", false);
        ParticleSystem_SetActive("PS_window_explo_*", false);

		Entity_SetEffectsActive("dark_world_tower_debris*", false, false);
		Prop_SetStaticPhysics("dark_world_tower_debris*", true);
		
		Player_SetAutoTeleportWhenBelowAltitude(-50.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		Sound_PreloadEvent("new_sounds/undercity_ending/ghoul_ending");
		Sound_PreloadEvent("04_05_paris/dw_endings/destruction_ending");
		
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		//ParticleSystem_Preload("some_particle.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		GhoulProgression_SetLimit(20);
				
		//cScript_SetGlobalVarBool("HideAmuletBracelet", true);
		Item_RemoveFromInventory(ItemType_GetFirstInInventory("CurseMedallion"));
		
		// Any general setup of script / entities
		Entity_AttachToSocket("Sketchbook_Screen", "Sketchbook_Body", "BookSocket", true, false);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		cLux_ClearAllMapSaveData();
		
		Player_SetVertigoActive(false);
		Player_SetCameraFarPlane(9000.f);		
		
		FearHandler_SetActive(true);
		FearHandler_SetPermaFailEnabled(true);	
		FearHandler_SetWakeUpSoundsAllowed(false);
		
		PlayerBody_SetModel("player6.ent");
		PlayerBody_SetActive(true);
		Heat_SetActive(false);
		
		FearHandler_SetPermafailBabySceneEnabled(false, false);
		Entity_SetActive("Monkey",false);
		Entity_SetActive("Sketchbook_*", false);
		
		mbIsGhoulEnding = !cScript_GetGlobalVarBool("Ending_Destruction");
		
		Player_SetCrossHairEnabled(false);
 
		////////////////////
		// Setup ghoul ending			
		if (cLux_ScriptDebugOn() == false)
		{
			if (mbIsGhoulEnding)
				Seq_FetishEnd();
			else
				Seq_DestructionEnd();
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Player_RestoreClipPlane();
		Player_SetCrossHairEnabled(true);
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail()
	{
		Sound_FadeGlobalVolume(1.f, 1.f, eSoundEntryType_All);
			
		FearHandler_AddPermaFailScene("player_ghoul_ending", "Trigger_FetishAnim", "Sketchbook_Body", "sketchbook_ghoul_ending", 33.266f, false);
		Entity_PlayAnimation("Monkey", "monkey_ghoul_ending", 0.0f, false);
		SequenceStates_Resume("Seq_FetishEnd");
		return true;		
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFailRespawn()
	{
		FearHandler_SetVolumeResetOnCustomPermaFail(false);
		Map_AddTimer("Timer_EndLevel", 0.01f, "OnTimer_EndLevel");
		return false;
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if (abPressed==false) return;
		
		if (alAction == eAction_Test1)
		{
			mbIsGhoulEnding = false;
			Seq_DestructionEnd();
		}
		
		if (alAction == eAction_Test2)
		{
			mbIsGhoulEnding = true;
			Seq_FetishEnd();
		}
		
		if (alAction == eAction_Test3)
		{
			Player_SetCrouching(false, true, true);
		}
		
		if (alAction == eAction_Test4)
		{
			ShadowFlesh_Spawn("Shadowflesh_1", "", 2.0f,2.0f,true,0.0f,0.0f);
		}
		
		if (alAction == eAction_Test5)
		{
			mbIsGhoulEnding = true;
			cScript_SetGlobalVarBool("Undercity_LeftDoll", true);
			OnTimer_EndLevel();
		}
		if (alAction == eAction_Test6)
		{
			mbIsGhoulEnding = true;
			cScript_SetGlobalVarBool("Undercity_LeftDoll", false);
			OnTimer_EndLevel();
		}
		if (alAction == eAction_Test7)
		{
			mbIsGhoulEnding = false;
			OnTimer_EndLevel();
		}
		if (alAction == eAction_Test8)
		{
			Credits_Start("Credits.cfg","OnEndOfCredits", "ending_3", cVector3f(-0.15,-0.1,1.75f), "A2_AlternativeEnding,A2_Ending");
			MainMenu_Sketchbook_SetSketch("ending_3");
		}
		if (alAction == eAction_Test9)
		{
			Credits_Start("Credits.cfg","OnEndOfCredits", "ending_4", cVector3f(-0.15,-0.1,1.75f), "A2_AlternativeEnding,A2_Ending");
			MainMenu_Sketchbook_SetSketch("ending_4");
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
	//-------------------------------------------------------
 
	//} END MAIN CALLBACKS
 
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
