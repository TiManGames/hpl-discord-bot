	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("04-02-sandstorm");
		
		Pregnancy_SetStage(ePregStage_Stage3);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Town);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(true);
		FearHandler_SetWhisperStage(eFearWhisperStage_TownToBirth);
		
		// Set up color grading etc.
		//Map_Preset_Fade("Inside", 0.1f);
		Map_Preset_SetupDirLight("Inside", true, cColor(1,0.931,0.867,0.529), 0.7f, cVector3f(0.446,-0.711,-0.544), cColor(0.088,0.08,0.071,1), cColor(0.381,0.321,0.287,1));
		Map_Preset_SetupFog("Inside", true, 15, 200, 1, cColor(0.459,0.443,0.42,0.959), 1, false, true);
		Map_Preset_SetupDirLight("Outside", true, cColor(1,0.931,0.867,0.529), 0.3f, cVector3f(0.446,-0.711,-0.544), cColor(0.396,0.297,0.2,1), cColor(0.709,0.642,0.604,1));
		//Map_Preset_SetupFog("Outside", true, 1, 40, 1, cColor(0.455,0.441,0.42,1), 1, false, true);
		Map_SetSecondaryFogActive(false);
		Map_Preset_SetupFog("Darkworld", true, 1, 300, 1, cColor(0.057,0.1,0.082,0.85), 1, false, false);
		
		Map_Preset_SetupDirLight("Darkworld", true, cColor(0.578,1,0.827,0.8), 0.5f, cVector3f(0.411, -0.725, -0.553), cColor(0.134,0.194,0.225,1), cColor(0.373,0.352,0.34,1));
		
		Map_Preset_SetupSkybox("Darkworld", cColor(1,1,1,1), 1.0f);
		
		Storm_SetStrength(0,1);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(2);
		StruggleFlashHandler_SetProgression(2);
		
		cScript_SetGlobalVarBool("Global_LanternLost", true);
		
		Prop_SetRenderLayer("sandstorm_wall_layer1",-1);
		Prop_SetRenderLayer("sandstorm_wall_layer2",0);
		Prop_SetRenderLayer("sandstorm_wall_layer2",1);

	    cWorld@ pWorld = mBaseObj.GetWorld();
		cLightMaskBox@ pMask = pWorld.GetLightMask("lightmask_mine");		
		pWorld.GetDirectionalLight().SetMask(pMask);
		
		Player_SetAutoTeleportWhenBelowAltitude(0.f);
		
	}
	
