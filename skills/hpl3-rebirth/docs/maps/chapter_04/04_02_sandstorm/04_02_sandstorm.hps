	//-------------------------------------------------------
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// AFTER BIRTH
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//-------------------------------------------------------
	
	int mlPostBirthBlur = -1;
	cSequenceStatesData seqAfterBirth;
	void Seq_AfterBirth(const tString &in asTimer="")
	{
		Sequence_Begin("Seq_AfterBirth", seqAfterBirth);
		if (Sequence_DoStepAndWait(1))
		{
			if (Sound_Exists("Sound_BabyCry_Newborn")== false)
				Sound_CreateAtEntity("Sound_BabyCry_Newborn","04_02_sandstorm/baby/baby_cry","DoctorAudioSource",1,false,1,-1,60);
			
			Entity_SetAnimationMessageEventCallback("Doctor_Birth", "OnAnimMessage_Doctor", false);
			
			Effect_Fade_Out(0.0f);
			Player_Teleport("Start_Begin");
			Entity_SetActive("Birth_Baby_1", true);
			Entity_SetCollideCharacter("Birth_Baby_1", false);
			Entity_PlaceAtEntity("Birth_Baby_1", "BirthCutscenePos", 0, true, true);
		}
		else if (Sequence_DoStepAndWait(0.5f))
		{
			Effect_Fade_In(3.0f);
			mlPostBirthBlur = Effect_Blur_Start(1, 0);
			PlayerBody_PlayCutsceneAtEntity("player_post_birth_scene_1", "BirthCutscenePos", false, 0);
			PlayerBody_SetCutsceneMaxPitch(0);
			PlayerBody_SetCutsceneMaxYaw(0);
			PlayerBody_SetCutsceneAutoEnd(false);
			Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_post_birth_scene_1", "BirthCutscenePos", 0, true);
			Entity_PlayAnimation("Birth_Baby_1", "newborn_post_birth_scene_1", 0);
			
			Entity_PlaceAtEntity("Stretcher", "BirthCutscenePos", 0, true);
			Entity_PlayAnimation("Stretcher", "stretcher_post_birth_scene_1", 0, false);
			
			Sound_CreateAtEntity("Sound_BornDoc_1", "new_sounds/post_birth/doctor/doctor_born_1", "Doctor_Birth");
			for (int i = 2; i <= 12; i++)
				Map_AddTimer("new_sounds/post_birth/doctor/doctor_born_"+i, 5.0f*(i-1), "OnTimer_PlayBornDocSound");
				
			Sound_CreateAtEntity("Sound_BornTasi_1", "new_sounds/post_birth/player/player_born_1", "Player");
			for (int i = 2; i <= 12; i++)
				Map_AddTimer("new_sounds/post_birth/player/player_born_"+i, 5.0f*(i-1), "OnTimer_PlayBornTasiSound");
			
			Music_Play("baby_born_theme_01.ogg", 0.15f, false, eMusicPrio_MinorEvent);
			
		}
		else if (Sequence_DoStepAndPause(0.5f))
		{
			Voice_Play("Scene_Betrayal", -1, "OnBetrayalPart1Dialogue_Finished");		
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			Effect_Blur_FadeOut(mlPostBirthBlur, 1.75);
		}
		else if (Sequence_DoStepAndPause(3.5f))
		{
			// Backup in case some hickup makes dialog complete before pausing
			if (Voice_SubjectIsPlaying("Scene_Betrayal")==false)
				SequenceStates_Resume("Seq_AfterBirth");
				
			mlPostBirthBlur = Effect_Blur_Start(1, 2);
		}
		else if (Sequence_DoStepAndWait(2.5f))
		{
			Effect_Fade_Out(0.75f);
			Sound_Fade("Sound_BabyCry_Newborn", 0.5, 1.5);
		}
		else if (Sequence_DoStepAndWait(0.05))
		{
			// Change body in a separate step with a tiny delay as there's a slight freeze when it happens
			PlayerBody_SetModel(Pregnancy_GetStageBodyModel());
			PlayerBody_AttachProp("Amulet_Bracelet", "AmuletSocket", false, false);
			PlayerBody_AttachProp("SalimsRing_Accessory", "RingSocket", false, false);
			Entity_SetEffectsActive(PlayerBody_GetEntityName(), false, false);
			PlayerBody_PlayCutsceneAtEntity("player_post_birth_scene_2", "BirthCutscenePos", false, 0, "OnCutsceneOver_TasiBreakFree", 0, 0);
			PlayerBody_SetCutsceneMaxPitch(15);
			PlayerBody_SetCutsceneMaxYaw(15);
			
			Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimMessage_PlayerBody", false);
			FootPlacement_SetActive(PlayerBody_GetEntityName(), false);
		}
		else if (Sequence_DoStepAndWait(2))
		{
			Entity_SetActive("Birth_Baby_1", false);
			Entity_SetActive("Birth_Baby_2", true);
			Entity_SetCollideCharacter("Birth_Baby_2", false);
			Entity_PlaceAtEntity("Birth_Baby_2", "BirthCutscenePos", 0, true, true);
			Entity_PlaceAtEntity("Amulet", "BirthCutscenePos", 0, true, true);
			Entity_SetActive("Bracelet_Birth", true);
			Entity_SetActive("Amulet_Bracelet", false); //Disable the accessory
			Entity_PlaceAtEntity("Bracelet_Birth", "BirthCutscenePos", 0, true, true);
			
			Entity_SetAnimationSpeed(PlayerBody_GetEntityName(), "player_post_birth_scene_2", 1);
			
			Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_post_birth_scene_2", "BirthCutscenePos", 0, false, "OnAnim_DoctorEscapes");
			Entity_PlayAnimation("Birth_Baby_2", "baby_post_birth_scene_2", 0);
			Entity_PlayAnimation("Stretcher", "stretcher_post_birth_scene_2", 0, false);
			Entity_RemoveEntityAttachment("Amulet");
			Entity_PlayAnimation("Amulet", "amulet_post_birth_scene_2", 0, false);
			Entity_PlayAnimation("Bracelet_Birth", "bracelet_birth_sequence_after_birth", 0, false);
			
			Map_AddTimer("Timer_DocMusic", 9.0f, "OnTimer_PlayDocMusic");
			
			Voice_PlayDelayed("Scene_Betrayal_2", 1, -1, "OnBetrayalPart1Dialogue_Finished");
			Light_FadeBrightnessTo("PointLight_8",0,1);
			Effect_Fade_In(2.0f);
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			Effect_Blur_FadeOut(mlPostBirthBlur, 2);
		}
		else if (Sequence_DoStepAndWait(0.5))
		{
			FearArea_SetGivesFear("Fear_Rage",true);
		}
		else if (Sequence_DoStepAndPause(0.9f))
		{
		}
		else if (Sequence_DoStepAndWait(0.9f))
		{
			FearHandler_FadeLevelTo(0.5f,2);
		}
		else if (Sequence_DoStepAndPause(0.5f))
		{
		}
		else if (Sequence_DoStepAndPause(0.5f))
		{
			bool bHighProgression = GhoulProgression_GetProgression()>=GHOUL_PROGRESSION_SANDSTORM_HIGH;
			
			if (bHighProgression) 
				FearHandler_FadeLevelTo(0.9f,3);
			else
				FearHandler_FadeLevelTo(0.75f,3);
			
			tString sVoice = (bHighProgression) ? "Scene_BetrayalMid_Ghoulish" : "Scene_BetrayalMid";
			Voice_Play(sVoice, -1, "OnBetrayalPart1Dialogue_Finished");	
		}
		else if (Sequence_DoStepAndWait(0.3f))
		{
			Seq_TasiRage("");
		}
		Sequence_End();
	}
	
