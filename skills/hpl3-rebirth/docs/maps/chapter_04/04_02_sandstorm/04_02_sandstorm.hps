	void Tasi_ProtectFromStorm(float afTime = 2.f, int alNextTimer = -1)
	{
		Debug_Log("PROTECT");
		PlayerBody_PlayAnimation("player_rarm_protect_from_storm_start",ePlayerBodyAnimationLayer_RightArm,false,false,false);
		Map_AddTimer("Timer_ArmLoop",1.666f,"OnTimer_ArmLoop");
		Map_SetTimerUserVarFloat("Timer_ArmLoop",afTime);
		Map_SetTimerUserVarInt("Timer_ArmLoop",alNextTimer);
	}
	
	//------------------------------------------------------- 
	
	void Tasi_EndProtectFromStorm()
	{
		Map_RemoveTimer("Timer_ArmLoop");
		if (Map_TimerExists("Timer_ArmEnd"))
		{
			Map_RemoveTimer("Timer_ArmEnd");
			Map_AddTimer("Timer_ArmEnd",0,"OnTimer_ArmEnd");
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ArmLoop(const tString &in asTimer)
	{
		float fTime = Map_GetTimerUserVarFloat(asTimer);
		int lNextTimer = Map_GetTimerUserVarInt(asTimer);
		PlayerBody_PlayAnimation("player_rarm_protect_from_storm_loop",ePlayerBodyAnimationLayer_RightArm,true,false,false);
		Map_AddTimer("Timer_ArmEnd",fTime,"OnTimer_ArmEnd");
		Map_SetTimerUserVarInt("Timer_ArmEnd",lNextTimer);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ArmEnd(const tString &in asTimer)
	{
		int lNextTimer = Map_GetTimerUserVarInt(asTimer);
		PlayerBody_PlayAnimation("player_rarm_protect_from_storm_end",ePlayerBodyAnimationLayer_RightArm,false,false,true);
		float fTime = (lNextTimer == -1) ? cMath_RandRectf(25,35) : lNextTimer;
		//Map_AddTimer("Timer_ArmStartDelay",fTime,"OnTimer_ArmStartDelay");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ArmStartDelay(const tString &in asTimer)
	{
		Tasi_ProtectFromStorm(cMath_RandRectf(3,7));
	}

