		bool OnAnim_Struggle(const tString &in asEntity, int alDirection)
		{
			Debug_Log("STRUGGLE");
			//Struggle_Patient();
			return true;
		}
		
		//-------------------------------------------------------
		
		void Struggle_Patient()
		{
			tString sStandTar = "Patient_Anim";
			tString sLight = "Light_Permafail_Barracks";
			
			tString sLoop = "gnaw_on_fairchild_loop";
			tString sIntro = "gnaw_on_fairchild_intro";
			tString sOutro = "gnaw_on_fairchild_outro";
			tString sStruggle = "gnaw_on_fairchild_resist";
			tString sWinCallback = "OnPermaStruggleWinEnd";
			tString sFailCallback = "OnPermaStruggleFailEnd";
			
			//Entity_SetActive("Patient",false);
			Entity_SetActive(sStandTar,true);
			Player_Teleport("Start_Struggle");
			
			Struggle_SetAnimationEntity(sStandTar, "f_"+sLoop, "f_"+sIntro, "f_"+sOutro, "f_"+sStruggle, true);
			Struggle_StartAnimation(sStandTar, "struggle_"+sLoop, "struggle_"+sStruggle, "struggle_"+sIntro, "struggle_"+sOutro, true, sLight, sWinCallback, sFailCallback, "", 4.f);
			Voice_Play("Scene_GhoulTakesOver",3);
		}
		
		//-------------------------------------------------------
		
		void OnPermaStruggleWinEnd()
		{			
			Debug_Log("WIN");
			Player_SetCrouching(false);
			Player_StartLookAt("Trigger_LookAtBaby",5,5,5);
			Sound_PlayGui("03_06_ghouls_nest/stingers/permafail_event", 1.f);
			FearHandler_FadeLevelTo(0.2f,2,true);
			Map_AddTimer("Timer_StruggleLeave",5,"OnTimer_StruggleLeave");
			Voice_StopAll();
			Voice_Play("Scene_TasiWinsStruggle");
		}
		
		//-------------------------------------------------------
		
		void OnPermaStruggleFailEnd()
		{		
			Debug_Log("LOSE");		
			Sound_PlayGui("03_06_ghouls_nest/stingers/permafail_event", 1.f);
			FearHandler_FadeLevelTo(0.5f,2,true);
			Map_AddTimer("Timer_StruggleLeave",4.5f,"OnTimer_StruggleLeave");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StruggleLeave(const tString &in asTimer)
		{
			Tasi_SetFatigueActive(true);
			Player_SetRunSpeedMul(.6f);
			Player_FadeRunSpeedMulTo(0.1f,3);
			Player_FadeMoveSpeedMulTo(0.5f,5);
		}

