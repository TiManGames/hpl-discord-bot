	//-------------------------------------------------------
	
	void Sandstorm_Swipe(int alIntensity, float afTimeMul=1.0f, float afFadeInMul=1.0f)
	{
		if (mbPlayerThroughRift) return;
		
		mbSquint = true;
		float fSquintTime;
		if (alIntensity == 3) // Used when teleporting to correct the player position and when hiding the doctor's rift entrance
		{
			fSquintTime = 5.f;
			Effect_Screen_Start("sandstorm_screen_diffuse.mat", cVector2f(0.5, 0.5), cVector2f(1.3, 0.7), 1, 1.5f*afTimeMul*afFadeInMul, 0.5f*afTimeMul, 1.5f*afTimeMul);
			Effect_Screen_Start("sandstorm_swipe.mat", cVector2f(0.5, 0.5), cVector2f(1.3, 0.7), 1, 0.3f*afTimeMul*afFadeInMul, 4.0f*afTimeMul, 1.0f*afTimeMul);
			Tasi_ProtectFromStorm(2);
		}
		else if (alIntensity == 2)
		{
			fSquintTime = 5.f;
			//Effect_Screen_Start("sandstorm_swipe.mat", cVector2f(0.5, 0.5), cVector2f(1.3, 0.7), 1, 1.0f, 3.0f, 4.0f); 
			Effect_Screen_Start("sandstorm_swipe.mat", cVector2f(0.5, 0.5), cVector2f(1.3, 0.7), 0.7f, 0.8f*afTimeMul*afFadeInMul, 4.0f*afTimeMul, 1.0f*afTimeMul);
			Effect_Screen_Start("sandstorm_swipe.mat", cVector2f(0.5, 0.5), cVector2f(1.3, 0.7), 1, 0.3f*afTimeMul*afFadeInMul, 4.0f*afTimeMul, 1.0f*afTimeMul);
			Tasi_ProtectFromStorm(2);
		}
		else if (alIntensity == 1)
		{
			fSquintTime = 9.f;
			Effect_Screen_Start("sandstorm_swipe.mat", cVector2f(0.5, 0.5), cVector2f(1.3, 0.7), 0.3f, 2.0f*afTimeMul*afFadeInMul, 4.0f*afTimeMul, 6.0f*afTimeMul); 
			Effect_Screen_Start("sandstorm_swipe.mat", cVector2f(0.5, 0.5), cVector2f(1.3, 0.7), 1, 2.0f*afTimeMul*afFadeInMul, 4.0f*afTimeMul, 2.0f*afTimeMul); 
		}
		else
		{
			fSquintTime = 5.f;
			Effect_Screen_Start("sandstorm_swipe.mat", cVector2f(0.5, 0.5), cVector2f(1.3, 0.7), 0.7f, 2.0f*afTimeMul*afFadeInMul, 1.0f*afTimeMul, 2.0f*afTimeMul); 
		}
		
		Map_AddTimer("Timer_StopSquint",fSquintTime*afTimeMul,"OnTimer_StopSquint");
		
		Sound_CreateAtEntity("Sound_WindGust", "04_02_sandstorm/wind/sandstorm_wind_gust", "player");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_StopSquint(const tString &in asTimer)
	{
		mbSquint = false;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_DressingSwipe(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		Sandstorm_StartDressingSwipes();
		return false;
	}
	
	//-------------------------------------------------------
	
	void Sandstorm_StartDressingSwipes()
	{
		//Debug_Log("DRESSING SWIPE");
		Sandstorm_Swipe(0);
		if (Map_TimerExists("Timer_DressingSwipes") == true) return;
		
		Map_AddTimer("Timer_DressingSwipes",cMath_RandRectf(15,35),"OnTimer_DressingSwipes");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DressingSwipes(const tString &in asTimer)
	{
		Sandstorm_StartDressingSwipes();
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_GridTeleport(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbTeleportationActive) return true;
		iLuxEntity@ pTrigger = Map_GetEntity(asParent);
		if (alState == 1)
		{
			cLux_AddDebugMessage("Enter");
			pTrigger.SetVarVector3f("EnterPos", Player_GetPosition());
			pTrigger.SetVarBool("EnteredInFront", Entity_PlayerIsInFront(asParent));
		}
		else
		{
			if (Entity_PlayerIsInFront(asParent) == Entity_GetVarBool(asParent,"EnteredInFront")) 
			{
				Debug_Log("Did not go through"); 
				return true;
			}
			
			cVector3f vEnterPos = pTrigger.GetVarVector3f("EnterPos");
			cVector3f vDir = Player_GetPosition() - vEnterPos;
			vDir.Normalize();
			float fDot = cMath_Vector3Dot(vDir, pTrigger.GetMatrix().GetTranspose().GetForward());
			if (fDot > 0)
			{
				cLux_AddDebugMessage("Player follows trigger direction");
				
				tString sUserVar = Entity_GetVarString(asParent,"");
				StartGridTeleport(asParent, sUserVar);
			}
			else
			{
				cLux_AddDebugMessage("Player in opposite trigger direction");
			}

		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void StartGridTeleport(const tString &in asTrigger, const tString &in asUserVar)
	{
		Sound_CreateAtEntity("Sound_WindGust", "04_02_sandstorm/wind/sandstorm_wind_gust", "player");

		Debug_Log("TELEPORTING IN 1.5s");
		
		Sound_Fade("Sound_BabyCry_1",0,1);
		Sound_Fade("Sound_BabyCry_2",0,1);
		Sound_Fade("Sound_BabySweet_*", 0, 1.5f);
		
		mbTeleportationActive = true;
		
		if (mlTeleportationAmount == 0)
		{
			Sketchbook_Microflash("Microflash_1");
		}
		else if (mlTeleportationAmount == 1) 
		{
			Sketchbook_Microflash("Microflash_3");
		}
		
		if (asUserVar != "")
		{
			Sandstorm_Swipe(2);
		
			//Map_RemoveTimer("OnTimer_DustSwipe");
			Map_AddTimer(asTrigger,1.5f,"OnTimer_GridTeleport");
			Map_SetTimerUserVarString(asTrigger,asUserVar);
		}
		
		// No uservar = player is walking in the wrong direction
		else
		{
			Sandstorm_Swipe(3);
			Map_AddTimer(asTrigger,1.5f,"OnTimer_WrongDirTeleport");
		}
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_GridTeleportOld(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		if (mbTeleportationActive) return true;
		if (!Entity_PlayerIsInFront(asParent)) 
		{
			Debug_Log("NOT IN FRONT");
			return true;
		}
		
		if (cString_GetFirstStringPos(asParent,"Trigger_Teleport_Intro") == 0)
		{
			Sketchbook_Microflash("Microflash_1");
			//Voice_Play("Microflash_1");
		}
		else if (cString_GetFirstStringPos(asParent,"Trigger_Teleport_Second") == 0) 
		{
			Sketchbook_Microflash("Microflash_3");
			//Voice_Play("Microflash_2");
		}
		
		Sound_CreateAtEntity("Sound_WindGust", "04_02_sandstorm/wind/sandstorm_wind_gust", "player");
		
		Debug_Log("TELEPORTING IN 1s");
		
		Sandstorm_Swipe(2);
		
		tString sUserVar = Entity_GetVarString(asParent,"");
		//Map_RemoveTimer("OnTimer_DustSwipe");
		Map_AddTimer(asParent,1.5f,"OnTimer_GridTeleport");
		Map_SetTimerUserVarString(asParent,sUserVar);
		
		Sound_Fade("Sound_BabyCry_1",0,1);
		Sound_Fade("Sound_BabyCry_2",0,1);
		
		mbTeleportationActive = true;
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_GridTeleport(const tString &in asTimer)
	{		
		tString sUserVar = Map_GetTimerUserVarString(asTimer);
		array <tString> vsStrings;
		cString_GetStringVec(sUserVar, vsStrings,",");
		int lX = cString_ToInt(vsStrings[0],0);
		int lY = cString_ToInt(vsStrings[1],0);
		
		mlTeleportationAmount++;
		Grid_Teleport(lX,lY);	
		Grid_Teleport_Event(mlTeleportationAmount);			
		
		if (mlTeleportationAmount > 0) 
		{
			Entity_SetActive(msCurrentDoctor,false);
			msCurrentDoctor = "Doctor_Sandstorm_2";
			Doctor_SetAdaptiveSpeed(msCurrentDoctor,true);
			Doctor_SetCallback_AdaptiveSpeedChanged(msCurrentDoctor,"Doctor_OnAdaptiveSpeedChange");
			Doctor_SetupSounds("Doctor_Sandstorm_2","Baby_2");
		}
		
		StartTimerTeleportChecks();
		
		mbTeleportationActive = false;
		
		//Map_AddTimer("Timer_DustSwipe",12,"OnTimer_DustSwipe");
	}
	
	//-------------------------------------------------------
	
	void Grid_Teleport(int alTilesX, int alTilesY)
	{	
		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
		
		/////////////
		// Player pos
		cVector3f vPlayerPos = pCharBody.GetFeetPosition();
		cVector2f vPlayerTile(0,0);
		cVector2f vPlayerLocalPos(0,0);
		
		vPlayerTile.x = cMath_Floor((vPlayerPos.x+cMath_Abs(mvTileShift.x*mlTileSize))/mlTileSize+1);
		vPlayerTile.y = cMath_Floor((vPlayerPos.z+cMath_Abs(mvTileShift.y*mlTileSize))/mlTileSize+1);
		vPlayerLocalPos = cVector2f(cMath_Abs((vPlayerTile.x-1+mvTileShift.x)*mlTileSize-vPlayerPos.x),cMath_Abs((vPlayerTile.y-1+mvTileShift.y)*mlTileSize-vPlayerPos.z));
		
		/////////////
		// Target pos
		cVector2f vTargetTile(alTilesX,alTilesY);
		cVector2f vTargetTilePos(0,0);
		
		vTargetTile.x += mvTileShift.x-1;
		vTargetTile.y += mvTileShift.y-1;												
		vTargetTile *= mlTileSizeMul;
		vTargetTilePos = vTargetTile*mlTileSize;
		
		/////////////
		// Teleport
		cVector3f vTargetPos(vTargetTilePos.x+vPlayerLocalPos.x,vPlayerPos.y,vTargetTilePos.y+vPlayerLocalPos.y);
		//ParticleSystem_CreateAtEntity("PS_TeleportSwipe2", "storm_dirt_swipe_vortex_full.ps", "Player", true);
		
		//cLux_GetCurrentMap().GetWorld().GetParticleSystem("PS_TeleportSwipe2").SetWorldPosition(vTargetPos);
		pCharBody.SetFeetPosition(vTargetPos, false);
		
		Debug_Log("============================");
		Debug_Log("Teleport from Tile ("+vPlayerTile.x+","+vPlayerTile.y+") to ("+alTilesX+","+alTilesY+")");
		Debug_Log("Teleport from Pos ("+vPlayerPos.x+","+vPlayerPos.z+") to ("+vTargetPos.x+","+vTargetPos.z+")");
		Debug_Log("============================");
	}
	
	//-------------------------------------------------------
	
	int mlWrongDirCount = 0;
	void OnTimer_WrongDirTeleport(const tString &in asTimer)
	{
		mlTeleportationAmount++;
		
		/////////////
		// Teleport
		int lTargetId = cMath_Min(mlTeleportationAmount, 3);
		Player_PlaceAtEntity("CorrectionPos_"+lTargetId, true);
		PlayerBody_AlignLowerBodyToCameraYaw(true);
		
		Grid_Teleport_Event(mlTeleportationAmount);			
		
		if (mlTeleportationAmount > 0) 
		{
			Entity_SetActive(msCurrentDoctor,false);
			msCurrentDoctor = "Doctor_Sandstorm_2";
			Doctor_SetAdaptiveSpeed(msCurrentDoctor,true);
			Doctor_SetCallback_AdaptiveSpeedChanged(msCurrentDoctor,"Doctor_OnAdaptiveSpeedChange");
			Doctor_SetupSounds("Doctor_Sandstorm_2","Baby_2");
			
			// Trigger a shorter glimpse of the doctor
			if (mlTeleportationAmount==1)
			{
				Agent_TeleportFeetToEntity("Doctor_Sandstorm_2","PosArea_DoctorGlimpse_2_Short");
				
				Pathfinder_Track_Clear("Doctor_Sandstorm_2");
				for (int i = 25; i<=52; i++)
					Pathfinder_Track_Add("Doctor_Sandstorm_2","PathNodeGlimpse2_"+i);
				Pathfinder_Track_Start("Doctor_Sandstorm_2");
				CharMover_SetSpeedState("Doctor_Sandstorm_2",eHumanoidSpeed_Walk_Fast);
			}
			
		}
		
		StartTimerTeleportChecks();
		
		mbTeleportationActive = false;
	}
	
	//-------------------------------------------------------
	
	void Grid_Teleport_Event(int alX)
	{
		if (alX == 1)
		{			
			Sound_Fade("Sound_BabyCry_2",0,0);
			Sound_Fade("Sound_BabyCry_2",1,5);
			
			//Voice_StopAll();
			//Voice_Play("Tasi_GiveMeMyBaby");
		}	
	}
	
	//-------------------------------------------------------
	
	float mfWanderTime = 0;
	cVector3f mvWanderPos = cVector3f_Zero;
	void StartTimerTeleportChecks()
	{
		mvWanderPos = Player_GetFeetPosition();
		mfWanderTime = 0;
		
		Map_RemoveTimer("OnTimer_TimerTeleport");
		Map_AddTimer("OnTimer_TimerTeleport", gfTimerTeleportCheckTime, "OnTimer_TimerTeleport");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_TimerTeleport(const tString &in asTimer)
	{
		if (mbPlayerThroughRift || mbTeleportationActive) return;
		
		//Make sure player is actually moving around
		if ((mvWanderPos-Player_GetFeetPosition()).Length() > 0.4*gfTimerTeleportCheckTime)
		{
			mfWanderTime += gfTimerTeleportCheckTime;
			cLux_AddDebugMessage("Wander Time: "+mfWanderTime);
			mvWanderPos = Player_GetFeetPosition();
			//cLux_AddDebugMessage("Player is wandering for "+mfWanderTime+"s");
		}
		
		if (mfWanderTime >= gfTimerTeleportLimit && Entity_GetCollide("Player", "RiftProximity") == false)
		{
			StartGridTeleport("TimerTeleport", "");
			return;
		}
		
		Map_AddTimer("OnTimer_TimerTeleport", gfTimerTeleportCheckTime, "OnTimer_TimerTeleport");
	}
	
