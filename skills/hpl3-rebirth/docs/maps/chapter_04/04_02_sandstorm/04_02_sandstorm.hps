	//-------------------------------------------------------

	/*Put any functions that are only used in Scene 2, Event C here.*/
	
	bool OnTrigger_Player_SlideOnSand(const tString &in asParent, const tString &in asChild, int alState)
	{
		Player_SetSlidingActive(alState == 1, Entity_GetVarFloat(asParent, ""));
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_Scarf(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState != 1) return true;
		
		bool bScarf = Entity_GetVarBool(asParent,"");
		Map_Preset_Fade("Outside", 2);
		
		if ((bScarf && !mbScarf) || (!bScarf && mbScarf))
		{
			mbScarf = bScarf;
			Sound_CreateAtEntity("Sound_Scarf","player/foley/action/scarf","player");
			if (mbScarf) 
			{
				Map_AddTimer("Timer_DelayedSwipe",1,"OnTimer_DelayedSwipe");
				//Tasi_ProtectFromStorm(0.2f,35);
			}
			else
			{
				//Tasi_EndProtectFromStorm();
			}
		}
		
		return true;
	}
	
	void OnTimer_DelayedSwipe(const tString &in asTimer)
	{
		Sandstorm_Swipe(0);
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_PlayChaseMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Game_AutoSave();
			Sound_Stop("Sound_BabyCry_Newborn", 1);
			Doctor_SetupSounds(msCurrentDoctor, "Baby_Intro");
			Music_Stop(5.0f, eMusicPrio_BigEvent);
			Music_PlayExt("A2_4_2_DoctorDesertChase.ogg", true, 0.1f, 1.0f, 5.0f, 1.0f, eMusicPrio_SceneAmb, true);
			return false;
		}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_DoctorGlimpse(const tString &in asParent, const tString &in asChild, int alState)
	{
		msCurrentDoctor = "Doctor_Sandstorm_1";
		
		Sketchbook_AddIdea("hunt_doctor");
		
		Doctor_Setup("Doctor_Sandstorm_1","Baby_1");
		Doctor_SetupSounds("Doctor_Sandstorm_1","Baby_1");
		Doctor_Setup("Doctor_Sandstorm_2","Baby_2");
		
		for (int j = 1; j<=2; j++)
		{
			
			Agent_TeleportFeetToEntity("Doctor_Sandstorm_"+j,"PosArea_DoctorGlimpse_"+j);
			
			Pathfinder_Track_Clear("Doctor_Sandstorm_"+j);
			for (int i = 1; i<=52; i++)
				Pathfinder_Track_Add("Doctor_Sandstorm_"+j,"PathNodeGlimpse"+j+"_"+i);
			Pathfinder_Track_Start("Doctor_Sandstorm_"+j);
			CharMover_SetSpeedState("Doctor_Sandstorm_"+j,eHumanoidSpeed_Walk_Fast);
			
		}
		
		Doctor_SetAdaptiveSpeed(msCurrentDoctor,true);
		Doctor_SetCallback_AdaptiveSpeedChanged(msCurrentDoctor,"Doctor_OnAdaptiveSpeedChange");

		Player_FadeRunSpeedMulTo(0.1f,10);
		Player_FadeMoveSpeedMulTo(mfBaseWalkSpeed,10);
		
		mbVariableFogRadius = true;
		
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_HoldOnRock(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == 1 && Entity_PlayerIsInFront(asParent) && Entity_IsInPlayerFOV(asParent))
		{
			PlayerBody_PlayCutsceneAnimation("herberts_hq_a_stumble_ls",false,0.2f,"OnEndOfAnim_GetBackUp");
			//PlayerBody_PlayCutsceneAtEntity("herberts_hq_a_stumble_ls",asParent,false,0.2f,"OnEndOfAnim_GetBackUp");
			Player_SetMoveSpeedMul(0.5f);
		}
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_PlayAnimation(const tString &in asParent, const tString &in asChild, int alState)
	{
		tString sAnim = Entity_GetVarString(asParent,"");
		PlayerBody_PlayCutsceneAnimation(sAnim,false,0.2f,"OnEndOfAnim_GetBackUpAfterFall",1);
		
		if (asParent == "Trigger_Fall_2A_1")
		{
			Voice_Play("Tasi_Amari");
			Map_RemoveTimer("Timer_ArmLoop");
			Map_RemoveTimer("Timer_ArmEnd");
			//Map_AddTimer("Timer_ArmStartDelay",13,"OnTimer_ArmStartDelay");
		}
		else if (asParent == "Trigger_Fall_2A_4")
		{
			//Player_GiveDamage(0.1f,0.9f,eDamageType_Fall,"Trigger_Fall_2A_4");
		}
		return false;
	}
	
	//-------------------------------------------------------
	
	
	// TO DO: PLUG THOSE IN 
	
	void OnTimer_PlayerLost(const tString &in asTimer)
	{
		Voice_Play("Tasi_LostBarks");
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Doctor_SpeedUp(const tString &in asParent, const tString &in asChild, int alState)
	{
		Doctor_SetAdaptiveSpeed(msCurrentDoctor,false);
		CharMover_SetSpeedState(msCurrentDoctor,eHumanoidSpeed_Run);
		return false;
	}
	
	//} END Event C
	
//} END Scene 2

	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 4 *PLAYER CHASES THE DOCTOR THROUGH THE RIFT INTO THE DARK WORLD*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////

		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 2 here.*/

		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 2 here.*/
		
		//-------------------------------------------------------
		
		//} END General	
		
		/////////////////////////////////////////
		// Event A - Player spots the Doctor, runs towards him and jumps through the Rift
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene X, Event X here.*/
		
		bool mbPlayerThroughRift = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene X, Event X here.*/
		
		bool OnCollide_Player_ResetFog(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("OnCollide_Player_ResetFog");
			if (alState == 1)
			{
				mbVariableFogRadius = false;
				cLux_GetCurrentMap().GetWorld().SetFogEnd(40);
				cLux_GetCurrentMap().GetWorld().SetSecondaryFogEnd(15);
			}
			else
			{
				// Never reset this setting. If the player got this close to the rift, keep the fog at this distance.
			}
			return true;
		}

		//-------------------------------------------------------
		
		bool OnCollide_Player_SetupDoctorRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			msCurrentDoctor = "Doctor_Rift";
			
			//FearThreatAgent_SetComponentEnabled(msCurrentDoctor,false);
			Entity_SetActive(msCurrentDoctor,true);
			Doctor_SetAdaptiveSpeed(msCurrentDoctor,true);
			Sound_CreateAtEntity("Sound_BabyCry_DoctorRift","04_02_sandstorm/baby/baby_cry","Doctor_Rift");
			Pathfinder_Track_Clear(msCurrentDoctor);
			Pathfinder_Track_Add(msCurrentDoctor,"PathNode_DoctorRift_12");
			Pathfinder_Track_Add(msCurrentDoctor,"PathNode_DoctorRift_18");
			Pathfinder_Track_Start(msCurrentDoctor,false,1,"OnEndOfTrack_DoctorToTower");
			CharMover_SetSpeedState(msCurrentDoctor,eHumanoidSpeed_Idle);
			
			Doctor_SetCallback_AdaptiveSpeedChanged(msCurrentDoctor,"");
			Storm_SetStrength(1);

			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_DoctorGoingThroughRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sandstorm_Swipe(3, 1.25f, 0.25f);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_DoctorToTower(const tString &in asEntity)
		{
			//Rift_SetForceOpen("Rift_1",true);
			Doctor_SetAdaptiveSpeed(msCurrentDoctor,false);
			Map_AddTimer("Timer_DoctorRift",2.1f,"OnTimer_DoctorToTower");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoctorToTower(const tString &in asTimer)
		{
			Pathfinder_Track_Clear(msCurrentDoctor);
			for (int i = 1; i <= 48; i++)
				Pathfinder_Track_Add(msCurrentDoctor,"PathNode_DoctorTower_"+i);
			Pathfinder_Track_Start(msCurrentDoctor,false,1,"OnEndOfTrack_DoctorEscape");
			CharMover_SetSpeedState(msCurrentDoctor,eHumanoidSpeed_Run_Slow);
			
			Player_FadeMoveSpeedMulTo(1,10);
			Player_FadeMoveSpeedMulTo(.5f,20);
			mbFatigue = true;
		
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Rift(const tString &in asEntity, int alState)
		{
			Voice_Play("Tasi_BabyFound");
		}
		
		//-------------------------------------------------------
		
		void OnRiftStage_Rift_1(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			if (alStage == 3 && abOpening == false)
			{
				Prop_SetActiveAndFade("sandstorm_rift_rock", true, 1.f);

				Entity_SetActive("Trigger_SoundPortal_1_*",false);
				Sound_CreateAtEntity("Sound_PortalClose", "level_entity_shared/portal/portal_open", "Trigger_SoundPortal_1_1");
				Sound_CreateAtEntity("Sound_PortalClose", "level_entity_shared/portal/portal_open", "Trigger_SoundPortal_1_2");
				Sound_Stop("SoundPortalLoop_1_1", 1.0f);
				Sound_Stop("SoundPortalLoop_1_2", 1.0f);
			}
			else if (alStage == 4 && abOpening)
			{
				Prop_SetActiveAndFade("sandstorm_rift_rock", false, 1.f);

				Entity_SetActive("Trigger_SoundPortal_1_*",true);
				Sound_CreateAtEntity("Sound_PortalOpen", "level_entity_shared/portal/portal_open", "Trigger_SoundPortal_1_1");
				Sound_CreateAtEntity("SoundPortalLoop_1_1", "level_entity_shared/portal/portal_open_loop", "Trigger_SoundPortal_1_1");

				Sound_CreateAtEntity("Sound_PortalOpen", "level_entity_shared/portal/portal_open", "Trigger_SoundPortal_1_2");
				Sound_CreateAtEntity("SoundPortalLoop_1_2", "level_entity_shared/portal/portal_open_loop", "Trigger_SoundPortal_1_2");
			}
		}
		
		//-------------------------------------------------------

		bool OnCollide_Player_Rift(const tString &in asParent, const tString &in asChild, int alState)
		{
		    //iTexture@ bSkybox = cResources_CreateTextureCubeMap("skybox_midday_fog.dds",true);
		    //cLux_GetCurrentMap().GetWorld().SetFogSkyboxTexture(bSkybox);
			mbPlayerThroughRift = true;
			Map_RemoveTimer("Timer_UpdateDoctorSpeed");
			Map_RemoveTimer("Timer_DustSwipe");
			Map_RemoveTimer("Timer_DressingSwipes");
			Map_RemoveTimer("OnTimer_TimerTeleport");
			Entity_SetActive("realworld_*", false);
			Entity_SetActive("darkworld_*", true);
			FogArea_SetVisible("darkworld_fog_*", true);
			ParticleSystem_SetVisible("darkworld_effect_*", true);

			Map_SetSkyBoxTexture("skybox_dwf.dds");
			Map_SetSkyboxRotation(cVector3f(-0.15, 300.4f, 0));

			Map_Preset_Fade("Darkworld", 0.5f);
			Entity_SetEffectsActive("sandstorm_player", false, false);
			mlSandstormStrength = Storm_SetStrength(0,0.1f);
			Map_SetSecondaryFogActive(false);
			CharMover_SetSpeedState(msCurrentDoctor,eHumanoidSpeed_Run_Slow);
			Visibility_SetTerrainActive(false);
			//Player_SetMoveSpeedMul(0.4f);
			//Player_SetRunSpeedMul(0.1f);
			mbScarf = false;
			mbVariableFogRadius = false;
			cLux_GetCurrentMap().GetWorld().SetFogEnd(40);
			cLux_GetCurrentMap().GetWorld().SetSecondaryFogEnd(15);
			Tasi_EndProtectFromStorm();
            Seq_CloseRift("");
			
			Music_Stop(5.0f, eMusicPrio_SceneAmb);
			Music_PlayExt("A2_4_2_DoctorDarkWorldChase.ogg", true, 0.2f, 1.0f, 5.0f, 1.0f, eMusicPrio_BgAmb, false);
			Entity_SetActive("Soundscape_DW",true);
			Tasi_SetFatigueActive(false);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_RiftSound(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_PassthroughPlayer", "level_dreams/anim/final_portal_passthrough", "player");
			Sound_CreateAtEntity("Sound_PassthroughPortal", "level_dreams/anim/portal_passthrough_end", "Trigger_RiftSound");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mCloseRift;
		
        void Seq_CloseRift(const tString &in asTimer)
        {
	        Sequence_Begin("Seq_CloseRift", mCloseRift);
	            if (Sequence_DoStepAndWait(4))
		        {
			        
		        }
		        else if (Sequence_DoStepAndWait(1))
		        {
			        Entity_SetActive("rift_dunes_opening", false);
			        //Entity_SetActive("rift_rock_*", true);
			        Entity_SetActive("rift_replacement_rock_*", true);
		        }
	        Sequence_End();
        }
		
		//} END Event A - Player spots the Doctor, runs towards him and jumps through the Rift
		
		/////////////////////////////////////////
		// Event B - Player follows the Doctor along the long bridge leading to the tower
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene X, Event X here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene X, Event X here.*/
		
		bool OnCollide_Player_FallAndChaseDoctor(const tString &in asParent, const tString &in asChild, int alState)
		{
			tString sAnim = Entity_GetVarString(asParent,"");
			//PlayerBody_PlayCutsceneAnimation(sAnim,false,0.2f,"OnEndOfAnim_ChaseDoctor",1);
			PlayerBody_PlayCutsceneAtEntity(sAnim,"PosArea_LandOnBridge",false,0.2f,"OnEndOfAnim_ChaseDoctor");
			//Player_GiveDamage(0.01f,0.9f,eDamageType_Fall,"Trigger_Fall_2A_4");
			Sound_CreateAtEntity("Sound_FallDamage","player/foley/damage/player_hit","player");
			FearHandler_FadeLevelTo(0.6f,0.3f,true);
			return false;
		}
		
			
		bool OnCollide_Player_RiftClose(const tString &in asParent, const tString &in asChild, int alState)
		{
			Rift_SetForceClose("Rift_1",true);
			return false;
		}
		
		bool OnCollide_Player_Microflash(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sketchbook_Microflash("Microflash_2");
			//Voice_Play("Microflash_3");
			return false;
		}
		
		int mlVisualBlurID = -1;
		
		bool OnCollide_Doctor_Blur(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_VisualBlur",0,"OnTimer_VisualBlur");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_VisualBlur(const tString &in asTimer)
		{
			mlVisualBlurID = Effect_Blur_Start(2,0.5f);
			Map_AddTimer("Timer_StopVisualBlur",1,"OnTimer_StopVisualBlur");
		}
		
		bool OnCollide_Doctor_BlurSlow(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlVisualBlurID = Effect_Blur_Start(2,0.5f);
			Map_AddTimer("Timer_StopVisualBlur",1,"OnTimer_StopVisualBlurSlow");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopVisualBlur(const tString &in asTimer)
		{
			Effect_Blur_FadeOut(mlVisualBlurID,1);
		}
		
		void OnTimer_StopVisualBlurSlow(const tString &in asTimer)
		{
			Sound_CreateAtEntity("DoorClosed","level_entity_shared/level_doors/stone","Trigger_10");
			Effect_Blur_FadeOut(mlVisualBlurID,2.3f);
		}
		
		void OnEndOfTrack_DoctorEscape(const tString &in asEntity)
		{
			Sound_Stop("Sound_BabyCry_DoctorRift",0);
			Entity_SetActive("Doctor_*",false);
			Entity_SetActive("Baby_*",false);
			
			//Sound_Fade("Sound_BabyCry*",0.2,1);
		}
		
		//-------------------------------------------------------
		
		//} END Event B - Player follows the Doctor along the long bridge leading to the tower
		
	//} END Scene 4

	cVector3f mvBaseDir;
 
}