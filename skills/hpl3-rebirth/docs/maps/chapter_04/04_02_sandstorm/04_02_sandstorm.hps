		void OnTimer_PlayChaseMusic(const tString &in asTimer)
		{
			Music_Stop(5.0f, eMusicPrio_MinorEvent);
			Music_PlayExt("A2_4_2_DoctorTunnelChase.ogg", true, 0.2f, 1.0f, 5.0f, 1.0f, eMusicPrio_BigEvent, true);
		}
		
