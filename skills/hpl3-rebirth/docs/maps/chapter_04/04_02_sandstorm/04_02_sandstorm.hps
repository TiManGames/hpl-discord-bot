			Entity_SetActive("Amulet", true);
			Entity_AttachToSocket("Amulet", PlayerBody_GetEntityName(), "AmuletSocket", true, true);
		}
		if (alAction == eAction_TestMinus)
		{
			
			PlayerBody_PlayCutsceneAtEntity("player_post_birth_scene_2", "BirthCutscenePos", false, 0, "", 1, 0);
			Entity_SetCollideCharacter("Amulet", false);
			Entity_PlaceAtEntity("Amulet", "BirthCutscenePos", 0, true, true);
			Entity_RemoveEntityAttachment("Amulet");
			Entity_PlayAnimation("Amulet", "amulet_post_birth_scene_2", 0, false);
		}
		
		
		
	}

