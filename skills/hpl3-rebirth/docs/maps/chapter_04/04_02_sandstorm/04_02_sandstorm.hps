		void Doctor_Setup(const tString &in asDoctor, const tString &in asBaby)
		{			
			iLuxEntity@ pDoctor = Map_GetEntity(asDoctor);
			iLuxEntity@ pBaby = Map_GetEntity(asBaby);

			pBaby.AttachToSocket(pDoctor,"j_R_HandSocket",true,true);
			//pBaby.SetMeshScaleMul(0.3f);
			Entity_SetActive(asDoctor,true);
			Entity_SetActive(asBaby,true);
			//Entity_PlayAnimation(sBaby,"f_gnaw_on_fairchild_loop");
		}

		//-------------------------------------------------------
		
		void Doctor_SetupSounds(const tString &in asDoctor, const tString &in asBaby)
		{
			Sound_Stop("Sound_BabyCry_*", 3.0f);
			Sound_Stop("Sound_BabySweet_*", 5.0f);
			float fRadius = (asDoctor == "Doctor_Intro") ? 45 : 60;
			Sound_CreateAtEntity("Sound_BabyCry_"+asBaby,"04_02_sandstorm/baby_sandstorm/baby_cry_loop",asDoctor,1,false,1,-1,fRadius);
			Sound_CreateAtEntity("Sound_BabySweet_"+asBaby,"04_02_sandstorm/baby_sandstorm/cry_sweet",asDoctor,1,false,1,-1,fRadius);
		}

		//-------------------------------------------------------
		
		

		//-------------------------------------------------------
		
		cSequenceStatesData mTasiRage;
		
        void Seq_TasiRage(const tString &in asTimer)
        {
	        Sequence_Begin("Seq_TasiRage", mTasiRage);
			if (Sequence_DoStepAndWaitUntil(3))
			{		
				cScript_SetGlobalVarBool("Sandstorm_BabyTaken",true);			
				Voice_Play("Scene_BetrayalPart2",-1,"OnEndOfVoice_ResumeRage");
			}
			else if (Sequence_DoStepAndWaitUntil(4.5))
			{
				FearHandler_SetForcedAddFearRate(1, 2, false);
				cLux_AddDebugMessage("RAGE");
				FearHandler_FadeLevelTo(0.95f,1,true);
				Entity_SetAnimationPaused("Doctor_Birth", "doctor_birth_take_amulet_and_run", false);
				Entity_SetAnimationPaused(PlayerBody_GetEntityName(), "player_birth_break_free", false);
				Sound_CreateAtEntity("Sound_Escape", "04_03_undercity/doctor_death/birth_escape", "player");
				Music_Stop(2.0f, eMusicPrio_SceneAmb);
				Music_Play("A2_4_2_DoctorChaseStart.ogg", 0.3f, false, eMusicPrio_MinorEvent);
				Map_AddTimer("Timer_ChaseMusic", 5.0f, "OnTimer_PlayChaseMusic");
			}
			else if (Sequence_DoStepAndWaitUntil(7.0))
			{
			    Light_FadeTo("cutscenelight_birth_*", cColor(0,0,0,0), 0, 4.5f);
				FearHandler_SetForcedAddFearRate(1, 2, false);
				
				Tasi_SetFatigueActive(false);
			}
			else if (Sequence_DoStepAndWaitUntil(9.0))
			{
			}
			else
			{
				FearHandler_FadeLevelTo(0.7f,4,true);
				FootPlacement_SetActive(PlayerBody_GetEntityName(), true);
			}
	        Sequence_End();
        }
		
		bool OnCamAnim_FirstFearBump(const tString &in asEntity, int alDirection)
		{
			FearHandler_FadeLevelTo(0.6f,3,true);
			return true;
		}
		
		bool OnCamAnim_SecondFearBump(const tString &in asEntity, int alDirection)
		{
			FearHandler_FadeLevelTo(0.9f,0.6f,true);
			return true;
		}
		
		void OnEndOfVoice_ResumeRage(const tString &in asScene, const tString &in asSubject)
		{
			SequenceStates_Resume("Seq_TasiRage");
		}
		
