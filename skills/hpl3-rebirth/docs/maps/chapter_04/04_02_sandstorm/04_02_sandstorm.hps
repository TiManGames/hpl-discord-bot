		//-------------------------------------------------------
		
		void OnEndOfAnim_DoctorLeaveMines(const tString &in asAgent, const tString &in asAnim)
		{
			Pathfinder_Track_Clear(msCurrentDoctor);
			for (int i = 17; i<=24; i++)
				Pathfinder_Track_Add(msCurrentDoctor,"PathNode_"+i);
			Pathfinder_Track_Start(msCurrentDoctor,false,1,"OnEndOfTrack_GoPastBlockage");
			CharMover_SetSpeedState(msCurrentDoctor,eHumanoidSpeed_Walk_VeryFast);
		}
		
