	//-------------------------------------------------------
		
	void OnGui(float afTimeStep)
	{
		cImGuiGfx gfxScarf("gui_scarf", eImGuiGfx_Texture);	
		gfxScarf.mColor =  ImGui_GetStateColor("color", cColor(1,1,1,0));
		
		cImGuiGfx gfxSquint("gui_squint", eImGuiGfx_Texture);	
		gfxSquint.mColor =  ImGui_GetStateColor("colorsquint", cColor(1,1,1,0));
				
		cGuiSet@ pSet = cLux_GetCurrentImGui().GetSet();
		
		if (mbScarf)
			ImGui_FadeStateColor("color",cColor(1,1,1,1),1,eEasing_QuadIn,false);
		else
			ImGui_FadeStateColor("color",cColor(1,1,1,0),1,eEasing_QuadIn,false);
			
		//Debug_Log("SCARF: "+mbScarf+" - Squint: "+mbSquint);	
			
		if (mbSquint)
			ImGui_FadeStateColor("colorsquint",cColor(1,1,1,1),1,eEasing_QuadIn,false);
		else
			ImGui_FadeStateColor("colorsquint",cColor(1,1,1,0),1,eEasing_QuadIn,false);
			
		ImGui_DrawGfx(gfxScarf,ImGui_FullScreenPos(1),ImGui_FullScreenSize());
		ImGui_DrawGfx(gfxSquint,ImGui_FullScreenPos(1),ImGui_FullScreenSize());
		
	}

