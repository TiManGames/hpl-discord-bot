		void OnEndOfAnim_Push(const tString &in asAgent, const tString &in asAnim)
		{
			//Map_AddTimer("Timer_Doctor_BangOnDoor",0,"OnTimer_Doctor_BangOnDoor");
			cLux_AddDebugMessage("DOC ANIM: "+"doctor_clear_blockage_rest"+" - CART ANIM: "+"cart_idle");
			Agent_PlayCutsceneAtEntity(msCurrentDoctor,"doctor_clear_blockage_rest","Cart_Rigid",0,true);
			//Entity_PlayAnimation(msCurrentDoctor,"doctor_clear_blockage_rest",0.1f,true,true);
			Entity_PlayAnimation("Cart_Rigid","cart_idle",0.3f,false);
			Map_AddTimer("Timer_DoctorPushCart",cMath_RandRectf(1,2),"OnTimer_DoctorPushCart");
		}
		
		void OnTimer_DoctorPushCart(const tString &in asTimer)
		{
			float fRand = cMath_RandRectf(0,1);
			int lAnim;
			
			if (fRand > 0.6f) lAnim = 1;
			else if (fRand > 0.3f) lAnim = 2;
			else lAnim = 3;
			
			cLux_AddDebugMessage("DOC ANIM: "+"doctor_clear_blockage_push_"+lAnim+" - CART ANIM: "+"cart_pushed_"+lAnim);
			Agent_PlayCutsceneAtEntity(msCurrentDoctor,"doctor_clear_blockage_push_"+lAnim,"Cart_Rigid",0,false,"OnEndOfAnim_Push");
			//Entity_PlayAnimation(msCurrentDoctor,"doctor_clear_blockage_push_"+lAnim,0.1,false,true,"OnEndOfAnim_Push");
			Entity_PlayAnimation("Cart_Rigid","cart_pushed_"+lAnim,0.3f,false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Doctor_BangOnDoor(const tString &in asTimer)
		{
			float fRand = cMath_RandRectf(0,1);
			if (fRand > .7f) Voice_Play("Doctor_Barricade");
			//CharMover_PlayAnimation(msCurrentDoctor, "attack_close_1", 0.0f, false);
			//Entity_PlayAnimation(msCurrentDoctor, "attack_close_1", 0.0f, false);
			ParticleSystem_CreateAtEntity("PS_DoorBash_tmp", "dust_impact_simple_oneshot.ps", "archaeology_cart_1", false);
			Sound_CreateAtEntity("Sound_GhoulDoorHit", "03_05_vitae_station/ghoul_events/ghoul_door_smash", "archaeology_cart_1");
			Map_RestartCurrentTimer(4);
		}
		
