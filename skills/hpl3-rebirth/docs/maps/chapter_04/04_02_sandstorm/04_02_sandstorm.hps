		bool OnCollide_Player_ScreamAtDoctor(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Tasi_ScreamAtDoctor", -1, "OnVoiceEnd_ScreamAtDoctor");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_FallAndCrawl(const tString &in asParent, const tString &in asChild, int alState)
		{
			
			mbFatigue = false;
			Player_SetMoveSpeedMul(0.3f);
			Player_SetRunSpeedMul(0.1f);
			
			tString sAnim = Entity_GetVarString(asParent,"");
			//PlayerBody_SetInteractiveAnimationRange(0.6f,0.61f);
			//PlayerBody_PlayInteractiveAnimation("fall_and_get_up_slow",0.2f,"OnEndOfAnim_GetBackUp",false,false,1,false,0,0,true);
			Effect_ImageTrail_Start(2,0.3f,5,3);
			FearHandler_FadeLevelTo(0.4f,2);
			//float fSpeed = Entity_GetVarFloat(asParent,"");
			//PlayerBody_PlayCutsceneAnimation("fall_and_get_up_slow",false,.8f,"",0.5f,0);
			PlayerBody_AddInteractiveAnimationCheckpoint(4.852f);
			PlayerBody_AddInteractiveAnimationCheckpoint(7.5f);
			//PlayerBody_AddInteractiveAnimationCheckpoint(10.7f);
			Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(),"OnPlayerAnimMessage_DoctorLeave",true);
			PlayerBody_PlayInteractiveAnimationAtEntity("player_saltmine_chase_fall_1","PosArea_CrawlCutscene",0.3f,"OnEndOfAnim_ContinueChase");
			//CameraAnimation_Begin("CameraAnimation_Ground","",true);
			return false;
		}
		
		void OnVoiceEnd_ScreamAtDoctor(const tString &in asScene, const tString &in asLine)
		{
			Map_AddTimer("Timer_DoCrawlSounds", 0.0f,"Timer_DoCrawlSounds");
		}
		
		// Hackety-hack! Last-minute sound added and last minute loop implementation as we
		// can't update the soundbanks right now.
		void Timer_DoCrawlSounds(const tString &in asTimerName="")
		{
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity("PlayerCrawlEmote");
			if (pSound==null||pSound.IsStopped())
			{
				Sound_CreateAtEntity("PlayerCrawlEmote", "player/emotes/ghoul_transition_med", "player");
			}
			Map_AddTimer("Timer_DoCrawlSounds", 0.5f,"Timer_DoCrawlSounds");
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_ContinueChase(const tString &in asAnimName, float afT)
		{
			Sound_Stop("PlayerCrawlEmote", 1.0f);
			Map_RemoveTimer("Timer_DoCrawlSounds");
			FearArea_SetGivesFear("Fear_Rage",false);
			mbFatigue = true;
			Player_FadeMoveSpeedMulTo(0.6f,5);
			Player_FadeRunSpeedMulTo(0.8f,1);
			FearHandler_FadeLevelTo(0.8f,3);
			Map_AddTimer("Timer_FadeGhoulPowers",12,"OnTimer_FadeGhoulPowers");
		}
		
		void OnPlayerAnimMessage_DoctorLeave(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 0)  
			{
				Debug_Log("EVENT");
				Map_RemoveTimer("Timer_DoctorPushCart");
				cLux_AddDebugMessage("DOC ANIM: "+"doctor_clear_blockage_final"+" - CART ANIM: "+"cart_pushed_final");
				Agent_PlayCutsceneAtEntity(msCurrentDoctor,"doctor_clear_blockage_final","Cart_Rigid",0,false,"OnEndOfAnim_DoctorLeaveMines");
				//Entity_PlayAnimation(msCurrentDoctor,"doctor_clear_blockage_rest",0.1f,true,true);
				Entity_PlayAnimation("Cart_Rigid","cart_pushed_final",0.3f,false);
			}
		}

		//-------------------------------------------------------
		
		bool OnEndOfAnim_Crawl(const tString &in asEntity, int alDirection)
		{
			Player_ChangeStateToNormal();
			PlayerBody_AddInteractiveAnimationCheckpoint(3.5f);
			PlayerBody_AddInteractiveAnimationCheckpoint(6.7f);
			PlayerBody_AddInteractiveAnimationCheckpoint(9.2f);
			PlayerBody_AddInteractiveAnimationCheckpoint(11.8f);
			Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimEvent_Crawl", true);
			PlayerBody_PlayInteractiveAnimationAtEntity("player_wake_up_crawl_mines", "PosArea_Crawl", 1.f, "OnEndOfAnim_GetUp", false, true, false, 1.f, false);
			
			return true;
		}
		
		void OnAnimEvent_Crawl(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 0)
			{
				Debug_Log("EVENT");
				Map_RemoveTimer("Timer_DoctorPushCart");
				cLux_AddDebugMessage("DOC ANIM: "+"doctor_clear_blockage_final"+" - CART ANIM: "+"cart_pushed_final");
				Agent_PlayCutsceneAtEntity(msCurrentDoctor,"doctor_clear_blockage_final","Cart_Rigid",0,false,"OnEndOfAnim_DoctorLeaveMines");
				//Entity_PlayAnimation(msCurrentDoctor,"doctor_clear_blockage_rest",0.1f,true,true);
				Entity_PlayAnimation("Cart_Rigid","cart_pushed_final",0.3f,false);
			}
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_GetUp(const tString &in asAnimName, float afTime)
		{
			Map_AddTimer("Timer_EndOfCrawl",.1f,"OnTimer_EndOfCrawl");
			return;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EndOfCrawl(const tString &in asTimer)
		{
			Debug_Log("END");
			CameraAnimation_Begin("CameraAnimation_GetUp","",true);
			OnCollide_Player_DoctorEscape("","",1);
			mbFatigue = true;
			Player_FadeMoveSpeedMulTo(0.6f,5);
			Player_FadeRunSpeedMulTo(.8f,1);
			FearHandler_FadeLevelTo(0.8f,3);
			Map_AddTimer("Timer_FadeGhoulPowers",12,"OnTimer_FadeGhoulPowers");
		}
	
