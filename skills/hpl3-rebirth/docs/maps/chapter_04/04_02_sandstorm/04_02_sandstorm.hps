	bool OnCollide_Player_StopStorm(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbPlayerThroughRift) return false;
		
		if (alState == 1)
		{
			cLux_AddDebugMessage("NO STORM");
			Storm_SetStrength(0,0.1f);
			mbStormActive = false;
		}
		else
		{
			cLux_AddDebugMessage("STORM");
			Storm_SetStrength(2,1);
			mbStormActive = true;
		}
		return true;
	}
	
