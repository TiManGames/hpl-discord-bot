		//-------------------------------------------------------
		
		void OnTimer_DoctorGoPastBlockage(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_Play("Tasi_GiveMeMyBaby",-1,"OnEndOfVoice_ChaseBarks");
			
			Pathfinder_Track_Clear(msCurrentDoctor);
			for (int i = 25; i<=68; i++)
				Pathfinder_Track_Add(msCurrentDoctor,"PathNode_"+i);
			Pathfinder_Track_Start(msCurrentDoctor,false,1,"OnEndOfTrack_DoctorTeleportOutOfMines");
			CharMover_SetSpeedState(msCurrentDoctor,eHumanoidSpeed_Run_Slow);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfVoice_ChaseBarks(const tString &in asScene, const tString &in asSubject)
