	//-------------------------------------------------------
	
	void Tasi_Contractions(float afTime)
	{
		Sound_CreateAtEntity("Sound_ContractionStinger", "04_01_town/contraction_pain/contraction_pain_stingers", "player");
		Sound_CreateAtEntity("Sound_ContractionStingerLoop", "04_02_sandstorm/contractions/birth_push_loop", "player");

		Map_AddTimer("Timer_ContractionsStop",afTime,"OnTimer_ContractionsStop");
		Map_AddTimer("Timer_Contraction",0.3f,"OnTimer_Contraction");
		Effect_ImageTrail_Start(1.5f,afTime/5,afTime+4,4);
		Effect_Shake_Start(.005f,afTime-1,afTime/2,afTime/4);
		Effect_Rumble_Start(.17f,3,0,0.1f);
		
		cLux_AddDebugMessage("Tasi_Contractions!");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ContractionsStop(const tString &in asTimer)
	{
		cLux_AddDebugMessage("Contractions stop");
		if (Sound_Exists("Sound_ContractionStingerLoop"))
			Sound_Stop("Sound_ContractionStingerLoop", 5.0f);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_Contraction(const tString &in asTimer)
	{
		////////////////
		// Pulsating effect
		
		if (Map_TimerExists("Timer_ContractionsStop")  == false) 
		{
			Debug_Log("FINAL");
			Effect_DollyZoom_Start(-.1,.3f,.4f,5);
			return;
		}
		
		float fTime = 0.02f;//cMath_RandRectf(.05f,.2f);
		float fFadeIn = .2f;//cMath_RandRectf(.1f,.3f);
		float fFadeOut = .9f;
		
		float fTotalTime = fTime+fFadeIn+fFadeOut;
		
		Effect_Rumble_Start(0.17f,fTime+fFadeIn,0,0.1f);
		Effect_DollyZoom_Start(cMath_RandRectf(-.15f,-0.05f),fTime,fFadeIn,fFadeOut);
		Map_RestartCurrentTimer(fTotalTime+0.001f);
		FearHandler_SetForcedAddFearRate(1,fTime+fFadeIn+fFadeOut,false,3,0.1f);
		
		cLux_AddDebugMessage("OnTimer_Contraction!");
	}
	
	//-------------------------------------------------------
	
	// ====================== OVERALL BIRTH SEQUENCE ======================
	float mfBirth_fPrevMoveSpeed = 0.f;
	int mlBirth_Stage = 0;
	int mlBirthStruggleFailCount = 0;
	bool mbBirth_FinalPush = false;
	float mfBirth_FadeStruggleDuration = 4.f;
	float mfBirth_PushStruggleDuration = 6.f;
	
	cSequenceStatesData seqBirth;
	
	void Seq_Birth(const tString &in asTimer = "")
	{
		Sequence_Begin("Seq_Birth", seqBirth);
		
		if (Sequence_DoStepAndWait(0.02f))
		{
			Effect_Fade_Out(0.f);
			Player_SetLookSpeedMul(0);
			//PlayerBody_AlignLowerBodyToCameraYaw();
			
		}
		else if (Sequence_DoStepAndWait(0.48f))
		{
			Player_Teleport("Start_Begin");
		}
		else if (Sequence_DoStepAndWait(2.0f))
		{
			Entity_AttachToSocket("DoctorAudioSource", "Doctor_Birth", "VoiceSocket", false, true);
			Voice_SetSource("Doctor","Doctor_Birth",20,35,true);
			
			Tasi_SetFatigueActive(false);
			FearHandler_SetActive(false);
			Effect_FearTentacles_Start();
			
			Player_SetAllowCheckBaby(false);
			cLux_GetPlayer().GetCharacterBody().SetActive(false);			
		}
		else if (Sequence_DoStepAndWait(5.0f))
		{
			Effect_Fade_In(3.0f);
			Player_SetLookSpeedMul(1);
			
			PlayerBody_PlayCutsceneAtEntity("player_pre_birth_scene", "BirthCutscenePos", false, 0, "OnCutsceneOver_BirthSequence");
			PlayerBody_SetCutsceneAutoEnd(false);
			PlayerBody_SetCutsceneMaxPitch(0);
			PlayerBody_SetCutsceneMaxYaw(0);
			Entity_SetActive("Doctor_Birth",true);
			Agent_SetStaticCollider("Doctor_Birth", true);
			
			msNextDoctorAnim = "doctor_birth_pre_focus_idle";
			Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_pre_birth_scene", "BirthCutscenePos", 0, false, "OnAnim_DoctorTransition");
			
			Entity_PlaceAtEntity("Stretcher", "BirthCutscenePos", 0, true);
			Entity_PlayAnimation("Stretcher", "stretcher_pre_birth_scene", 0, false);
			
			//Entity_AttachToSocket("Amulet", PlayerBody_GetEntityName(), "AmuletSocket", true, true);
			Entity_SetActive("Amulet", true);
			Entity_PlaceAtEntity("Amulet", "BirthCutscenePos", 0, true, true);
			Entity_SetActive("Bracelet_Birth", true);
			Entity_SetActive("Amulet_Bracelet", false); //Disable the accessory
			Entity_PlaceAtEntity("Bracelet_Birth", "BirthCutscenePos", 0, true, true);
			Entity_PlayAnimation("Amulet", "amulet_pre_birth_scene", 0, false);
			Entity_PlayAnimation("Bracelet_Birth", "bracelet_pre_birth_scene", 0, false);
		}
		else if (Sequence_DoStepAndPause(0.0f))
		{			
			if (GhoulProgression_GetProgression()>=12)
				Voice_Play("Dialogue_TasiTiedDown_Ghoulish", -1, "");
			else
				Voice_Play("Dialogue_TasiTiedDown", -1, "");
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			PlayerBody_ResetCutscenePitchYawLimits();
			
			BirthState_Start("BirthCutscenePos", "Doctor_Birth", "j_Head", "OnBirth_Push_StruggleWon", "OnBirth_Push_StruggleLost", "OnBirth_Fade_StruggleWon");
			BirthState_PlayAnimation("player_birth_pre_focus_idle", 0.3f);
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			Voice_Play("Dialogue_TasiFirstScream");
			Tasi_Contractions(4);
		}
		else if (Sequence_DoStepAndWait(6.0f))
		{
			Voice_Play("Dialogue_TasiBirthIntro", -1, "", 1);
		}
		else if (Sequence_DoStepAndPause())
		{
			// First contraction
			BirthStageAdvance(true);
		}
		else if (Sequence_DoStepAndPause())
		{
			BirthStageAdvance(mbPushStruggleWon);
		}
		else if (Sequence_DoStepAndPause())
		{
			mbBirth_FinalPush = true;
			BirthStageAdvance(true);
		}
		else if (Sequence_DoStepAndWait(0.f))
		{
			cLux_AddDebugMessage("[Birth] BABY BORN!");
			Sound_CreateAtEntity("Sound_BabyCry_Newborn","04_02_sandstorm/baby/baby_cry","DoctorAudioSource",1,false,1,-1,60);
		}
		else if (Sequence_DoStepAndWait(3.0f))
		{
			Effect_Fade_Out(2.9f);
		}
		else if (Sequence_DoStepAndWait(0.1f))
		{
			
			// Reset
			cLux_GetPlayer().GetCharacterBody().SetActive(true);
			Player_ChangeStateToNormal();
			Player_SetMoveSpeedMul(mfBirth_fPrevMoveSpeed);
			Player_SetLeanDisabled(false);
						
			Player_SetAllowCheckBaby(false);
			
			Effect_FearTentacles_Stop();
			Tasi_SetFatigueActive(true);
			FearHandler_SetActive(true);
			Pregnancy_SetStage(ePregStage_Born);
			Pregnancy_SetBabyTalkStage(eBabyTalkStage_Born);
			
			
		}
		else
		{
			OnBirthComplete();
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void OnVoiceOver_BirthSequence(const tString &in asScene, const tString &in asSubject)
	{
		SequenceStates_Resume("Seq_Birth");
	}
	
	//-------------------------------------------------------
	
	void OnCutsceneOver_BirthSequence(const tString &in asAnim)
	{
		SequenceStates_Resume("Seq_Birth");
	}
	
	//-------------------------------------------------------
	
	void BirthStageAdvance(const bool abStruggleWon=false)
	{
		mlBirth_Stage+=1;
		cLux_AddDebugMessage("Birth Stage: "+ mlBirth_Stage);
		
		//mfBirth_PushStruggleDuration = abStruggleWon ? 6.f : 8.f;
		mfBirth_PushStruggleDuration += 0.5f;
		
		Seq_BirthPhase();
		mbPushStruggleWon=false;
	}
	
	//-------------------------------------------------------
	
	///////////////////////
	// CONTRACTION SEQUENCE
	int BIRTH_SOUND_THRESHOLD = 1;	// How many times must you have failed to start sounding ghoulish? (Note this winds back with each success.)
	cSequenceStatesData seqBirthPhase;
	bool mbPushStruggleWon = false;
	int mlRadialBlur=-1;
	int mlDofID = -1;
	int mlShakeID = -1;
	int mlImageTrailID=-1;
	int mlBirthPushHintID=-1;
	float mfBirthProgressionWait = 0;
	
	void Seq_BirthPhase(const tString &in asTimer = "")
	{
		Sequence_Begin("Seq_BirthPhase", seqBirthPhase);
		
		////////////////
		// Fade out
		if (Sequence_DoStepAndWait(0.25))
		{
			if (mlBirth_Stage > 1)
			{
				Voice_Stop("Comments");
				Voice_Play("Dialogue_TasiBirthDoctorFocusStart");
			}
			msNextDoctorAnim = "doctor_birth_getting_tasi_to_focus";
			msNextTasiAnim = "player_birth_focus_idle";
			Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_birth_getting_tasi_to_focus_start_"+mlBirth_Stage, "BirthCutscenePos", 0.2, false, "OnAnim_DoctorTransition");
			BirthState_PlayAnimation("player_birth_focus_start_"+mlBirth_Stage, 0.3f, "OnAnim_TasiTransition");
		}
		else if (Sequence_DoStepAndPause(0))
		{
			float fDuration = mfBirth_FadeStruggleDuration;
			BirthState_StartFadeOut(fDuration);
		}
		else if (Sequence_DoStepAndPause(cMath_RandRectf(0.5f, 0.75f)))
		{
			cLux_AddDebugMessage("[Birth] Focus struggle ended.");
			Voice_Play("Dialogue_TasiBirthDoctorEncourage", -1, "OnVoiceOver_FadeStruggleWon", 1);
			
			msNextDoctorAnim = "doctor_birth_pre_push_idle";
			msNextTasiAnim = "player_birth_pre_push_idle";
			Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_birth_getting_tasi_to_focus_end", "BirthCutscenePos", 0.2, false, "OnAnim_DoctorTransition");
			BirthState_PlayAnimation("player_birth_focus_end", 0.3f, "OnAnim_TasiTransition");
		}
		else if (Sequence_DoStepAndWait(1.f))
		{
			Effect_BabyKick_Start(0.5f, false, false);
		}
		else if (Sequence_DoStepAndWait(1.f))
		{
			// Last push doctor's comments
			if (mbBirth_FinalPush)
			{
				Voice_Play("Dialogue_DoctorBirthEndNormal_1");
			}
			// Normal push doctor's comments
			else
			{
				Voice_Stop("Comments");
				Voice_Play("Dialogue_TasiBirthDoctorNowPush");
			}
			msNextDoctorAnim = "doctor_birth_helping_tasi_to_push";
			msNextTasiAnim = "player_birth_push_idle";
			Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_birth_helping_tasi_to_push_start", "BirthCutscenePos", 0.2, false, "OnAnim_DoctorTransition");
			BirthState_PlayAnimation("player_birth_push_start", 0.3f, "OnAnim_TasiTransition");
			
			Sound_CreateAtEntity("Sound_ContractionStinger", "04_01_town/contraction_pain/contraction_pain_stingers", "player");
			Sound_CreateAtEntity("Sound_ContractionStingerLoop", "04_02_sandstorm/contractions/birth_push_loop", "player");
		}
		////////////////
		// Push
		else if (Sequence_DoStepAndPause())
		{
			BirthState_StartPush(mfBirth_PushStruggleDuration);
			mfBirthProgressionWait = mbBirth_FinalPush ? 3.0f : cMath_RandRectf(4.0f, 5.0f);
		}
		else if (Sequence_DoStepAndWait(mfBirthProgressionWait))
		{
			msNextDoctorAnim = "doctor_birth_pre_focus_idle";
			msNextTasiAnim = "player_birth_pre_focus_idle";
			Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_birth_helping_tasi_to_push_end_"+cMath_Min(mlBirth_Stage, 2), "BirthCutscenePos", 0.2, false, "OnAnim_DoctorTransition");
			BirthState_PlayAnimation("player_birth_push_end", 0.3f, "OnAnim_TasiTransition");
			
			if (Sound_Exists("Sound_ContractionStingerLoop"))
				Sound_Stop("Sound_ContractionStingerLoop", 5.0f);
		}
		else if (Sequence_DoStepAndContinue())
		{
			SequenceStates_Resume("Seq_Birth");
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void OnBirth_Fade_StruggleWon()
	{
		OnTimer_Fade_WaitForDialog("");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_Fade_WaitForDialog(const tString &in asTimer)
	{
		if (Voice_SceneIsActive("Comments"))
		{
			Map_AddTimer("OnTimer_Fade_WaitForDialog", 0.5, "OnTimer_Fade_WaitForDialog");
			return;
		}
		SequenceStates_Resume("Seq_BirthPhase");
	}
	
	//-------------------------------------------------------
	
	void OnVoiceOver_FadeStruggleWon(const tString &in asScene, const tString &in asSubject)
	{
		SequenceStates_Resume("Seq_BirthPhase");
	}
	
	//-------------------------------------------------------
	
	void OnBirth_Push_StruggleWon()
	{
		cLux_AddDebugMessage("[Birth] Push struggle won.");
		if (mbBirth_FinalPush)
			Voice_PlayDelayed("Dialogue_DoctorBirthEndNormal_2", 0.5f);
		else
			Voice_Play("Dialogue_TasiBirthDoctorEncourage");
		
		mlBirthStruggleFailCount = cMath_Max(mlBirthStruggleFailCount - 1, 0);
		
		mbPushStruggleWon = true;
		SequenceStates_Resume("Seq_BirthPhase");
		
		BirthState_SetGhoulMode(mlBirthStruggleFailCount >= 2);
	}
	
	//-------------------------------------------------------
	
	void OnBirth_Push_StruggleLost()
	{
		cLux_AddDebugMessage("[Birth] Push struggle lost.");
		Voice_Play("Dialogue_TasiBirthDoctorLosing");
		mlBirthStruggleFailCount++;
		
		mbPushStruggleWon = false;
		SequenceStates_Resume("Seq_BirthPhase");
		
		BirthState_SetGhoulMode(mlBirthStruggleFailCount >= 2);
	}
	
