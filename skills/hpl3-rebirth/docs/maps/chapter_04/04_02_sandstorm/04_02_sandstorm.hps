		void OnTimer_ChaseBarks(const tString &in asTimer)
		{
			tString sVoice = (Entity_GetCollide("player","Trigger_Mines")) ? "Tasi_ChaseBarks" : "Tasi_CallOut";
			Voice_Play(sVoice);
			int lRand = cMath_RandRectl(8,16);
			Map_RestartCurrentTimer(lRand);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfTrack_DoctorTeleportOutOfMines(const tString &in asEntity)
		{
			Sound_Stop("Sound_BabyCry_Baby_Intro",0.3f);
			Entity_SetActive(msCurrentDoctor,false);
			Entity_SetActive("Baby_Intro",false);
			
			msCurrentDoctor = "Doctor_Sandstorm_1";
			Agent_TeleportFeetToEntity(msCurrentDoctor,"PosArea_DoctorGlimpse_1");
		}
		
