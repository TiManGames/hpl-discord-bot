	//-------------------------------------------------------
	
	void Tasi_SetFatigueActive(bool abFatigue)
		{
			if (abFatigue)
			{
				m_idBlur = Effect_DoF_Start(0.5f,10,1,1);
				Map_AddTimer("Timer_BlurManager",cMath_RandRectf(2,6),"OnTimer_BlurManager");
			}
			else
			{
				Effect_DoF_FadeOut(m_idBlur,2);
				Map_RemoveTimer("Timer_BlurManager");
			}
		}
	
	//-------------------------------------------------------
	
	void OnTimer_BlurManager(const tString &in asTimer)
	{
		if (!mbFatigue) Map_RestartCurrentTimer(1);
		
		//Debug_Log("BLUR");
		if (mlBlurStatus == -1)
		{
			float fFadeTime = cMath_RandRectf(1,3);
			Effect_DoF_FadeFocus(m_idBlur,0,0.5f,fFadeTime);
			if (!mbPlayerThroughRift) Player_FadeMoveSpeedMulTo(mfBaseWalkSpeed-0.05f,fFadeTime);
			mlBlurStatus = 0;
			
			Map_RestartCurrentTimer(cMath_RandRectf(2,4));
		}
		else if (mlBlurStatus == 1)
		{
			float fFadeTime = cMath_RandRectf(1,3);
			Effect_DoF_FadeFocus(m_idBlur,0.5,10,fFadeTime);
			if (!mbPlayerThroughRift) Player_FadeMoveSpeedMulTo(mfBaseWalkSpeed-0.1f,fFadeTime);
			mlBlurStatus = 0;
			
			Map_RestartCurrentTimer(cMath_RandRectf(1,3));
		}
		else
		{
			Effect_DoF_FadeFocus(m_idBlur,0.5,50,3);
			if (!mbPlayerThroughRift) Player_FadeMoveSpeedMulTo(mfBaseWalkSpeed,5);
			mlBlurStatus = 1*cMath_Sign(cMath_RandRectf(-1,1));
			
			Map_RestartCurrentTimer(cMath_RandRectf(2,6));
		}
		
	}
 
