	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			OnCollide_PlayChaseMusic("","",1);
			Player_Teleport("Start_Rift_Dunes");
			mbStormActive = true;
			Storm_SetStrength(2,0);
		}
		if(alAction == eAction_Test2)
		{
			Doctor_Setup(msCurrentDoctor,"Baby_Intro");		
			Doctor_SetupSounds(msCurrentDoctor, "Baby_Intro");
			Voice_SetSource("Doctor","Doctor_Intro",20,35,true);	
			//CameraAnimation_Begin("CameraAnimation_Rage","",false);
			Pathfinder_Track_Clear(msCurrentDoctor);
			CharMover_SetSpeedState(msCurrentDoctor,eHumanoidSpeed_Walk_Fast);
			Pathfinder_Track_Add(msCurrentDoctor,"PathNode_16");
			Pathfinder_Track_Start(msCurrentDoctor,false,1,"OnEndOfTrack_Blockage");
			
		}
		if (alAction == eAction_Test3)
		{
			/*Entity_SetEffectsActive("sandstorm_player",true,true);	
			Entity_SetActive("storm_radius_small",true);	
			Entity_SetActive("storm_radius_medium",true);	
			Entity_SetActive("storm_radius_large",true);
			Storm_SetStrength(1,0);*/
			FearHandler_SetLevelTo(0.4f);
			Player_Teleport("Start_Rift_Dunes");
		}
		
		if(alAction == eAction_Test4)
		{
			Pregnancy_SetStage(ePregStage_Born);
			PlayerBody_SetModel("player_birth.ent");
			Entity_SetActive("Doctor_Birth", true);
			Agent_SetStaticCollider("Doctor_Birth", true);
			Voice_SetSource("Doctor","Doctor_Birth",20,35,true);
			Entity_SetActive("Amulet", true);
			Entity_AttachToSocket("Amulet", PlayerBody_GetEntityName(), "AmuletSocket", true, true);
			OnBirthComplete();
		}
		if(alAction == eAction_Test5)
		{
			//Item_AddToInventory("Orb");
			Entity_SetActive("Doctor_Sandstorm_1",true);
			Entity_SetActive("Baby_1",true);
			Agent_TeleportFeetToEntity("Doctor_Sandstorm_1","PosArea_Rift");
			Rift_SetForceOpen("Rift_1",true);
			//ParticleSystem_CreateAtEntity("StormDirtSwipe", "storm_dirt_swipe.ps", "Camera", true);
			Map_AddTimer("Timer_DoctorRift",1,"OnTimer_DoctorRift");
		}
		if(alAction == eAction_Test6)
		{
			Sound_PlayGui("player/tools/lantern/lantern_refill", 1); return;
			//Entity_SetActive("Doctor_Birth", true);
			//mBaseObj.PlayAnimation(asAnim, afFadeTime, abLoop, true, asCallback, false, false);
			//Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_birth_idle", "BirthCutscenePos", 1, true);
			mlSandstormStrength = Storm_SetStrength(0,1);
		}
		if(alAction == eAction_Test7)
		{
			Effect_FearTentacles_Start();
		//mBaseObj.StopAllAnimations(afFadeTime);
		//mBaseObj.PlayAnimation(asAnim, afFadeTime, abLoop, true, asCallback, false, false);
			//Agent_PlayCutsceneAtEntity("Doctor_Birth", "doctor_birth_getting_tasi_to_focus_start_1", "BirthCutscenePos", 1, false, "OnAnim_DoctorTransition", 1, 0, 0, 0, true, false, true);
			mlSandstormStrength = Storm_SetStrength(1,1);
		}
		if(alAction == eAction_Test8)
		{
			OnBirthComplete(); return;
			Effect_FearTentacles_Stop();
			//BirthState_StartPush();
			/*mlSandstormStrength = Storm_SetStrength(2,1);
			ParticleSystem_AttachToEntity("PS_4","player");*/
			//Prop_SetActiveAndFade("sandstorm_wall_*", false, 5);
			mlSandstormStrength = Storm_SetStrength(2,1);
		}
		if(alAction == eAction_Test9)
		{
			FearHandler_FadeLevelTo(0,1); return;
			//mlSandstormStrength = Storm_SetStrength(3,1);
			//OnCollide_Player_GridTeleport("Trigger_10","player",1);
			//OnCollide_Player_Rift("", "", 1);
			//Player_Teleport("start_AtTower");
			mlSandstormStrength = Storm_SetStrength(3,1);
		}
		if(alAction == eAction_Test0)
		{
			FearHandler_FadeLevelTo(1,1); return;
			Sketchbook_AddAllIdeas(true);
			//mlSandstormStrength = Storm_SetStrength(0,1);
			//OnCollide_Player_GridTeleport("Trigger_10","player",1);
		}
		if (alAction == eAction_TestPlus)
