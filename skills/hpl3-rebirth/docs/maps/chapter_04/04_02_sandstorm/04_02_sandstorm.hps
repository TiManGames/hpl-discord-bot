	}
	
	//-------------------------------------------------------
	
		
	void UpdatePlayerTripping(float afTimeStep)
	{
		if (!mbFatigue) return;
		if (mbPlayerThroughRift) return;

		if (Player_GetSpeed() > 0 && mbCanTrip && Player_GetRunning() == false)
		{
			
			mbIsTripping = true;
			mbCanTrip = false;
			mlTripDir = 1*cMath_Sign(cMath_RandRectf(-1,1));
			mfTripAmount = cMath_RandRectf(.15f,.25f);
			Map_AddTimer("Timer_Trip",cMath_RandRectf(0.2f,0.4f),"OnTimer_StopTripping");
			Map_AddTimer("Timer_ResetTripping",cMath_RandRectf(1,3),"OnTimer_ResetTripping");	
		}
		
		if (mbIsTripping)
		{
			iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();	
			pBody.Move(eCharDir_Right, mfTripAmount*mlTripDir);
			pBody.Move(eCharDir_Forward, mfTripAmount);
		}
		
	}	
	
	//-------------------------------------------------------
	
	void OnTimer_StopTripping(const tString &in asTimer)
	{
		mbIsTripping = false;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ResetTripping(const tString &in asTimer)
	{
		mbCanTrip = true;
	}
		
