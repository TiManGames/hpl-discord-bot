	tString msCurrentDoctor = "Doctor_Intro";
	
	//-------------------------------------------------------
	
	bool mbDoctorAdaptSpeed = false;
	bool mbVariableFogRadius = false;
	
	
	void UpdateFogRadius(float afTimeStep)
	{
		if (!mbVariableFogRadius) return;
		
		mfTime+=afTimeStep;
		
		float fDist = Entity_GetDeltaToEntity("player",msCurrentDoctor).Length();
		
		float fFogRadius = fDist+10*cMath_Sin(mfTime/2);
		float fSecondaryFogRadius = mfSecondaryFogRadiusMin+10*cMath_Sin(mfTime);
		cLux_GetCurrentMap().GetWorld().SetFogEnd(fFogRadius);
		cLux_GetCurrentMap().GetWorld().SetSecondaryFogEnd(fSecondaryFogRadius);
		//Debug_Log(""+cLux_GetCurrentMap().GetWorld().GetFogEnd()+" - "+cLux_GetCurrentMap().GetWorld().GetSecondaryFogEnd());
	}
	
	//-------------------------------------------------------
	
	void Doctor_OnAdaptiveSpeedChange(const tString &in asDoctor, int alSpeedState)
	{		
		
		switch (alSpeedState)
		{
			case eHumanoidSpeed_Walk_VeryFast:
				Storm_SetStrength(2);
				break;
			case eHumanoidSpeed_Walk_Fast:
			case eHumanoidSpeed_Walk_VerySlow:
				Storm_SetStrength(1);
				// PLAY ANIMATION CHECKING AMULET
				break;
			case eHumanoidSpeed_Idle:
				Storm_SetStrength(1);
				break;
		}
				
		if (asDoctor == "Doctor_Sandstorm_1")	CharMover_SetSpeedState("Doctor_Sandstorm_2",alSpeedState);
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// SANDSTORM EFFECTS
	////////////////////////////////////
	
	bool mbStormActive = true;
	int mlSandstormStrength = 0;
	
	//-------------------------------------------------------
	
	int Storm_SetStrength(int alStrength = 1, float afFadeTime = 1.0f)
	{
		int lStrength = alStrength;
		
		if (!mbStormActive) lStrength = -1;
		
		if (lStrength == 0)
		{
			//Entity_SetEffectsActiveExt("storm_radius_small",false,true,afFadeTime,afFadeTime);
			//Entity_SetEffectsActiveExt("storm_radius_medium",false,true,afFadeTime,afFadeTime);
			//Entity_SetEffectsActiveExt("storm_radius_large",false,true,afFadeTime,afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer1", false, afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer2", false, afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer3", false, afFadeTime);
			Entity_SetEffectsActiveExt("sandstorm_player",false,true,afFadeTime,afFadeTime);
			
		}
		else if (lStrength == 1)
		{
			//Entity_SetEffectsActiveExt("storm_radius_small",false,true,afFadeTime,afFadeTime);
			//Entity_SetEffectsActiveExt("storm_radius_medium",false,true,afFadeTime,afFadeTime);
			//Entity_SetEffectsActiveExt("storm_radius_large",true,true,afFadeTime,afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer1", true, afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer2", false, afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer3", false, afFadeTime);
			Entity_SetEffectsActiveExt("sandstorm_player",true,true,afFadeTime,afFadeTime);
		}
		else if (lStrength == 2)
		{
			//Entity_SetEffectsActiveExt("storm_radius_small",false,true,afFadeTime,afFadeTime);
			//Entity_SetEffectsActiveExt("storm_radius_medium",true,true,afFadeTime,afFadeTime);
			//Entity_SetEffectsActiveExt("storm_radius_large",false,true,afFadeTime,afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer1", true, afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer2", true, afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer3", false, afFadeTime);
			Entity_SetEffectsActiveExt("sandstorm_player",true,true,afFadeTime,afFadeTime);
		}
		else if (lStrength == 3)
		{
			
			//Entity_SetEffectsActiveExt("storm_radius_small",true,true,afFadeTime,afFadeTime);
			//Entity_SetEffectsActiveExt("storm_radius_medium",false,true,afFadeTime,afFadeTime);
			//Entity_SetEffectsActiveExt("storm_radius_large",false,true,afFadeTime,afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer1", true, afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer2", true, afFadeTime);
			Prop_SetActiveAndFade("sandstorm_wall_layer3", true, afFadeTime);
			Entity_SetEffectsActiveExt("sandstorm_player",true,true,afFadeTime,afFadeTime);
		}
		Debug_Log("SANDSTORM STRENGTH: "+lStrength);
		return lStrength;
	}
	
