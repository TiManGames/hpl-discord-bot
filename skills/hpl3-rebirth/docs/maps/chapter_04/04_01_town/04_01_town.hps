			SwingDoor_Push("wooden_board_big_1",-1,0.4,20);
			Player_ChangeStateToNormal();
			//Player_SetInteractionAllowed(false);
			Entity_SetInteractionDisabled(asParent,true);
			Entity_SetInteractionDisabled("InteractAux_Plank",true);
