	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	bool mbRunTimerActive = true;
	bool mbFatigue = false;
	
	int mlBlurMaxDist = 50;
	int mlBlurStatus = 0;
	int m_idBlur = -1;
	
	bool mbContractionAllowed = true;
	bool mbContractions = false;
	int mlContractionAmount = 0;
 
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	void UpdatePlayerSpeed(float afTimeStep)
	{
		if (Player_GetRunning())
		{
			if (mbRunTimerActive) mfPlayerRunTime += afTimeStep;
			//else mfPlayerRunTime -= afTimeStep;
			
			if (mfPlayerRunTime >= mfPlayerRunTime_Max)
			{
				mbRunTimerActive = false;
				mfPlayerRunTime = 0;
				Player_FadeRunSpeedMulTo(0,1);
				Map_AddTimer("Timer_ResetRunSpeed",6,"OnTimer_ResetRunSpeed");
			}
		}
		else
		{
			if (mfPlayerRunTime > 0) mfPlayerRunTime -= afTimeStep; //cooldown
		}
	}
	
	//------------------------------------------------------- 
	
	int m_idAudio_Breathing=-1;
	int m_idAudio_Climbing = -1;
	bool mbBreathingEmotes = false;
	
	void StartBreathing()
	{
		mbBreathingEmotes = true;
	}
	
	//------------------------------------------------------- 
	
	void UpdateBreathing(float afTimeStep)
	{
		if (!mbBreathingEmotes)
			return;
			
		float fSpeed = Player_GetSpeed();

		float fWalkVol = 0.0f;
		float fClimbVol = 0.0f;

		if (Player_GetCurrentStateName() == "State_Ladder")
		{
			if (Player_IsClimbingLadder())
			{
				fClimbVol = 1.0f;
			}
		}
		else if (fSpeed>0.1f)
		{
			fWalkVol= 0.6f;
			if (fSpeed>2.0f)
				fWalkVol=1.0f;
		}
		
		if (fWalkVol>0.0f)
		{
			if (m_idAudio_Breathing==-1)
			{
				m_idAudio_Breathing = PlayerEmotion_PlaySound(eEmotionPlaylistType_Breathing, eEmotionSoundType_Loop, 0, "player/emotes/Tasi_9Mth_Walking", -1, 3.0f, 2.0f);
			}
			PlayerEmotion_SetSoundVolume(eEmotionPlaylistType_Breathing, m_idAudio_Breathing,fWalkVol*0.9f);
		}
		else
		{
			if (m_idAudio_Breathing!=-1)
			{
				PlayerEmotion_StopSound(eEmotionPlaylistType_Breathing, m_idAudio_Breathing);
				m_idAudio_Breathing = -1;
			}
		}
		
		if (fClimbVol>0.0f)
		{
			if (m_idAudio_Climbing==-1)
			{
				m_idAudio_Climbing = PlayerEmotion_PlaySound(eEmotionPlaylistType_Breathing, eEmotionSoundType_Loop, 0, "player/emotes/Tasi_9Mth_Climbing", -1, 0.5f, 1.0f);
			}
			PlayerEmotion_SetSoundVolume(eEmotionPlaylistType_Breathing, m_idAudio_Climbing,fClimbVol*0.8f);
		}
		else
		{
			if (m_idAudio_Climbing!=-1)
			{
				PlayerEmotion_StopSound(eEmotionPlaylistType_Breathing, m_idAudio_Climbing);
				m_idAudio_Climbing = -1;
			}
		}
		
		//Debug_Log("Walk:"+fWalkVol+" Climb:"+fClimbVol);
	}
	
	//------------------------------------------------------- 
	
	void StopBreathing(float afFadeSpeed = -1)
	{
		mbBreathingEmotes = false;
		if (m_idAudio_Breathing!=-1)
		{
			PlayerEmotion_StopSound(eEmotionPlaylistType_Breathing, m_idAudio_Breathing, afFadeSpeed);
			m_idAudio_Breathing=-1;
		}
		if (m_idAudio_Climbing!=-1)
		{
			PlayerEmotion_StopSound(eEmotionPlaylistType_Breathing, m_idAudio_Climbing, afFadeSpeed);
			m_idAudio_Climbing=-1;
		}
	}
	
