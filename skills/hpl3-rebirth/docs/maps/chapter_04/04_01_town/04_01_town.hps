		/*Put any variables that are only used in Scene 5, Event A here.*/
		
		bool mbTasiFar = false;
		
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 5, Event A here.*/
		
		void Tasi_Escape()
		{
			StopBreathing();
			
			Map_Preset_Fade("Outside",1);
		    ParticleSystem_SetVisible("ps_sandstorm_*", true);
			//Player_Teleport("Start_Town_ToMines");
			mlBlurStatus = 0;
			
			Player_StartLookAt("Trigger_CutsceneTeleport_Mines_1",1,1,4);
			FearHandler_SetForcedAddFearRate(0.6f,15,true,100,-1);

			Entity_SetActive("Yasmin",true);
			Entity_SetActive("Yasmin_Trap",false);
			Voice_SetSource("Yasmin", "Yasmin", 2, 30, true);
			
			// Horrible hack for temp sound!
			Sound_Stop("TasiTempEmotes",0.5f);
			Sound_CreateAtEntity("Sound_TasiTempEmotes","game_voice/voice/01_01_intro_crash_TASI","player", 0.5f,true, 0.75f);

			mbRunTimerActive = true;
			mfPlayerRunTime = -3;
			Player_SetRunSpeedMul(.4f);
			Player_FadeRunSpeedMulTo(.6,2);
			//Map_AddTimer("Timer_Yasmin_BangOnDoor",0,"OnTimer_Yasmin_BangOnDoor");
			Map_AddTimer("Timer_BlockDoor",2,"OnTimer_BlockDoor");
			Map_AddTimer("Timer_Yasmin_ForceEscape",15,"OnTimer_Yasmin_ForceEscape");
			//Music_PlayExt("A2_04_01_TasiChase.ogg", true, 0.2f, 1.0f, 5.0f, 1.0f, eMusicPrio_AgentToHuntTransition, true);
			
			Voice_PlayWhenPossible("Dialogue_RunTasi","",30.0f,1.0f);
		}

		//-------------------------------------------------------
		
		void OnTimer_BlockDoor(const tString &in asTimer)
		{
			Player_StopLookAt(2);
			Tasi_SetFatigueActive(true);
			SwingDoor_SetBlocked("wooden_door_rickety_1",true,true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Yasmin_BangOnDoor(const tString &in asTimer)
		{
			ParticleSystem_CreateAtEntity("PS_DoorBash_tmp", "dust_impact_simple_oneshot_noclip.ps", "wooden_door_rickety_1", false);
			Sound_CreateAtEntity("Sound_YasminDoorHit", "04_01_town/level/yasmin_door_hit", "wooden_door_rickety_1");
			Map_RestartCurrentTimer(2);
		}
		
		//-------------------------------------------------------

		void OnTimer_Yasmin_ForceEscape(const tString &in asTimer)
		{
			Yasmin_Escape();
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_YasminChase(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_RemoveTimer("Timer_Yasmin_ForceEscape");
			Yasmin_Escape();
			return false;
		}
		
		//-------------------------------------------------------		
		
		void OnTimer_ForceCatch(const tString &in asTimer)
		{
			cLux_AddDebugMessage("FORCED CATCH");
			Yasmin_CatchPlayer();
		}
		
		//-------------------------------------------------------
		
		tString msYasmin = "Yasmin_Chase";
		int m_idTrail = -1;
		
		void Yasmin_Escape()
		{
			Map_AddTimer("Timer_ForceCatch",20,"OnTimer_ForceCatch");
			FearHandler_SetForcedAddFearRate(1,10,true,100,-1);
			Entity_SetActive("Trigger_YasminChase",false);
			m_idTrail = Effect_ImageTrail_Start(2,10,90,0);
			Map_RemoveTimer("Timer_Yasmin_BangOnDoor");
			Entity_SetActive("Yasmin",false);
			Entity_SetActive("Yasmin_Chase",true);
			Entity_SetActive("arabic_fort_door_01_4",false);
			
			Sound_CreateAtEntity("Sound_YasminDoorBreak","04_01_town/level/yasmin_door_smash","Yasmin_Chase");
			SwingDoor_Push("wooden_door_rickety_1",1,6);
			Ghoul_SetSmellingActive("Yasmin_Chase",false);
			Agent_SetSensesActive("Yasmin_Chase",true);
			Ghoul_CommandThreatenPlayer_Execute("Yasmin_Chase",2,false,false, -1, -1, true);
			//Ghoul_Mode_Set(msYasmin,eGhoulMode_Hunt,false);
			//Ghoul_SetSuperHunt("Yasmin_Chase",true);
			//Map_AddTimer("Timer_YasminSpeed",0.2,"OnTimer_YasminSpeed");
			
			Ghoul_CommandThreatenPlayer_SetAggressiveness("Yasmin_Chase",6);
			CharMover_SetWalkAnimName("Yasmin_Chase", "yasmin_run_fwd");
			
			Map_AddTimer("Timer_PlayerEscapeSpeed",0.5,"OnTimer_PlayerEscapeSpeed");
			Map_AddTimer("Timer_PlayerEscapeContractions",12,"OnTimer_PlayerEscapeContractions");
			Voice_SetSource("Yasmin","Yasmin_Chase",2,30,true);
			Ghoul_SetAllowPlayerThrow("Yasmin_Chase",true);
			Ghoul_CancelPlayerThrow("Yasmin_Chase",true);
			Ghoul_SetCanAttack("Yasmin_Chase", false);
			
			Voice_PlayDelayed("Dialogue_RunTasi",0.5f);
			
			Map_AddTimer("Yasmin_ChaseBarks",2.0f, "OnTimer_YasminChaseBarks");

			Map_AddTimer("Timer_CheckYasminDistance",1.0,"OnTimer_CheckYasminDistance");
		}
		
		//-------------------------------------------------------
	
		void OnTimer_YasminChaseBarks(const tString &in asTimer)
		{
			if (!Voice_SceneInvolvingCharacterIsActive("Yasmin"))
			{
				Voice_Play("Dialogue_RunTasi");
			}
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckYasminDistance(const tString &in asTimer)
		{
			//cLux_AddDebugMessage("NOW "+Ghoul_GetCurrentState("Yasmin_Chase"));
			//if (Ghoul_GetCurrentState(msYasmin) == "Idle" || Ghoul_GetCurrentState(msYasmin) == "PlayerDetected")
			if (Ghoul_GetCurrentState("Yasmin_Chase") != "ThreateningApproach")
				Ghoul_CommandThreatenPlayer_Execute("Yasmin_Chase",2,false,false, -1, -1, true);
				
			Ghoul_CommandThreatenPlayer_SetAggressiveness("Yasmin_Chase",6);
			
			float fDist = Player_GetDistanceToEntity("Yasmin_Chase");
			if (fDist <= 3)
			{
				Debug_Log("Run Catch");
				Yasmin_CatchPlayer();
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.1, 0.3));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayerEscapeSpeed(const tString &in asTimer)
		{
			mfPlayerRunTime = 0;
			mfPlayerRunSpeed_Max = .7f;
			Player_FadeRunSpeedMulTo(mfPlayerRunSpeed_Max,0.5f);
			mfPlayerRunTime_Max = 12;
			mbRunTimerActive = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayerEscapeContractions(const tString &in asTimer)
		{
			mlContractionAmount = 99;
			Tasi_Contractions(3);
		}
		
