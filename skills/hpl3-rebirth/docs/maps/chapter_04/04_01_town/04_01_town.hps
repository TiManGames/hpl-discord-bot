		{
			if(abStartOfLine) return;
			
			//Sound_CreateAtEntity("Sound_RadioStaticIdle", "player/tools/radio/radio_call/radio_static", "player");			
			Sound_CreateAtEntity("Sound_RadioButtonOff", "player/tools/radio/radio_call/tasi_talk_stop", "player");
		}
		
