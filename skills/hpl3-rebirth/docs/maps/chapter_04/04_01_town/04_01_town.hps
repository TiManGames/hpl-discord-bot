		//------------------------------------------------------- 
		
		void OnEndOfAnim_HangLoop(const tString &in asAnimName)
		{
			
			PlayerBody_PlayCutsceneAtEntity("player_hanging_from_hyenatrap","PosArea_TrapCutscene",true,0,"");
			iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
			pBody.Cutscene_AutoResetCamera(false);
			
			Entity_PlayAnimation("town_winch_1","winch_town_trap_idle",0.1f,true);
			Entity_PlayAnimation("town_jaw_trap_1","jaw_trap_town_idle",0.1f,true);
			Seq_YasminReveal("");
		}
		
