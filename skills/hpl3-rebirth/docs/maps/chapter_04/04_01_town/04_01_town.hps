			Tasi_SetFatigueActive(true);
		}
		if(alAction == eAction_Test3)
		{
			//mbRunTimerActive = true;
			Player_Teleport("Start_TowerBuilding_PreTrap");
			Entity_SetActive("Trigger_Trap",true);
			Map_Preset_Fade("Inside",0.5f);
		    //Player_Teleport("Start_Town_ToMines");
			//Tasi_Escape();		
		}
		if(alAction == eAction_Test4)
		{
		    Map_AddTimer("Timer_ForceCatch",30,"OnTimer_ForceCatch");
		}
		if(alAction == eAction_Test5)
		{
			//Seq_DoctorRescue("");
		}
		if (alAction == eAction_Test6)
		{
			Entity_SetActive("Doctor", true);
			Entity_AttachToSocket("Revolver","Doctor","j_R_HandSocket_Socket_1",true);
			Entity_PlayAnimation("Doctor","doctor_picks_up_player");
		}
		if (alAction == eAction_Test7)
		{
			Map_Preset_Fade("TownHall",3);
		}
		if (alAction == eAction_Test8)
		{
			//Map_GetEntity("Doctor").GetMeshEntity().SetVisible(false);
			//Entity_AddImpulse("door_barricade_1",cVector3f_One,true,true);
			Map_Preset_Fade("TownExterior", 6);
			mlContractionAmount = 90;
			Player_Teleport("Start_Town_Entrance");
			
		}
		if (alAction == eAction_Test9)
		{
			Player_Teleport("Start_Town_ToMines");
			Tasi_Escape();
			//msTeleportCutscenePos = "PosArea_Cutscene_Normal_5";
			//Map_Preset_Fade("Outside",1);
			//Yasmin_CatchPlayer();
		}
		if (alAction == eAction_Test0)
		{
			Sound_CreateAtEntity("Sound_OpenDoor", "new_sounds/escape/door/door_open", "wooden_door_rickety_1");
			SwingDoor_Push("wooden_door_rickety_1",1,6); return;
			Sketchbook_AddAllIdeas(); return;
			PlayThroughCrackScene();
		}
		
		if (alAction == eAction_TestPlus)
		{
			FearHandler_SetLevelTo(0.8f);
			FearHandler_SetForcedAddFearRate(1,2,false,3,0.1f);
			//Player_GiveDamage(0.1,0.9,eDamageType_Fall,"");
