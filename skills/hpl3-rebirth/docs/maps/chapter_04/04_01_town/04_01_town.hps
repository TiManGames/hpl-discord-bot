		//-------------------------------------------------------
		
		void Tasi_EndChase()
		{
			Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(),"OnPlayerAnimMessage",false);
			
			Sound_FadeGlobalVolume(1.0f,2.0f,eSoundEntryType_WorldAll);
				
			Entity_SetActive("Doctor_Mines",true);
			Entity_PlayAnimation("Doctor_Mines","doctor_locking_mines_entrance",0.1f);
			Entity_PlayAnimation("Door_Exit","door_doctor_locking_mines_entrance",0.1f);
			PlayerBody_PlayCutsceneAtEntity("player_doctor_locking_mines_entrance","Door_Exit",false,0.1f,"");
			//Map_AddTimer("Timer_DoctorClosesDoor",1,"OnTimer_DoctorClosesDoor");
			Entity_SetActive("Doctor",false);
			Entity_SetActive("Revolver",false);
			Effect_Fade_In(1);
			Voice_FadeSceneVolumeTo("YasminFinal",0.0f,0.5f);
			Achievement_Unlock(eAchievement_Refugee);
			//CameraAnimation_Begin("CameraAnimation_InMines","",true);
			Sound_CreateAtEntity("Sound_DocDoorClose", "04_03_undercity/doctor_death/doc_door_close", "Doctor_Mines");
			
			Map_AddTimer("Timer_GoToSleepByDoor",2.0,"OnTimer_GoToSleepByDoor");
		}
		
		//------------------------------------------------------- 
		
		void OnPlayerAnimMessage(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
/*			if (alMessageEventID == 0)  
			{
				Map_AddTimer("Timer_ChangeMap",0.5f,"OnTimer_ChangeMap");
			}*/
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_GoToSleepByDoor(const tString &in asTimer)
		{
			mlYasminStruggleBlur = Effect_Blur_Start(2.0f,4.0f);
			Map_AddTimer("Timer_CloseYourEyesByDoor",4.0,"OnTimer_CloseYourEyesByDoor");
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_CloseYourEyesByDoor(const tString &in asTimer)
		{
			Effect_Fade_Out(4.0f);
			Map_AddTimer("Timer_ChangeMap",5.0f,"OnTimer_ChangeMap");
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_ChangeMap(const tString &in asTimer)
		{
			PlayerBody_StopAnimation("player_doctor_locking_mines_entrance",0);
			Player_ChangeStateToNormal();
			Effect_Blur_FadeOut(mlYasminStruggleBlur,0.0f);
			if (!cLux_ScriptDebugOn())
				Map_ChangeMap("04_02_sandstorm.hpm", "Start_Begin", "", "", false);
		}
		
