			Entity_PlayAnimation("temp_yasmin_1","yasmin_moving_towards_player",0,false,true,"OnEndOfAnim_YasminOutro");
			Entity_SetAnimationMessageEventCallback("temp_yasmin_1","OnAnimMessage",false);
			Entity_SetAnimationRelativeTimePosition("temp_yasmin_1", "yasmin_moving_towards_player", 30.0f/51.5f);
			
/*			PlayerBody_PlayCutsceneAtEntity("player_yasmin_encounter_outro","PosArea_TrapCutscene",false,0,"OnEndOfAnim_TasiEscape");
					Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(),"OnAnimMessage_Player",false);
					Entity_PlayAnimation("rocks_and_rope_town_trap_1","rocks_and_rope_town_trap_outro");
					Entity_PlayAnimation("town_jaw_trap_1","jaw_trap_town_outro");*/
		}
		if(alAction == eAction_Test2)
		{
			mbRunTimerActive = true;
			mlBlurStatus = 1;
			mlBlurMaxDist = 100;
			mlContractionAmount = 90;
			Map_Preset_Fade("TownExterior", 1);
