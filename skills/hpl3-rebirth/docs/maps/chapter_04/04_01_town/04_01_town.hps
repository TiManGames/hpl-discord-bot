	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(15);
		FearHandler_SetActive(false);
		FearHandler_SetLevelTo(0);
		
		// Any general setup of script / entities

		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			//mfPlayerMoveSpeed_Start = 1;
			mfPlayerRunSpeed_Start = .5f;
			//Entity_SetActive("Trigger_Trap",false);
			
			/*if (ItemType_GetCountInInventory("Orb") < 1)
			Item_AddToInventory("Orb");
			if (ItemType_GetCountInInventory("Radio") < 1)
			Item_AddToInventory("Radio");*/
		}
		
		if (ItemType_GetCountInInventory("Radio") < 1)
			Item_AddToInventory("Radio");
		
		/////////////////////////
		// Player Setup
		
		Player_SetMoveSpeedMul(mfPlayerMoveSpeed_Min);
		//Player_FadeMoveSpeedMulTo(mfPlayerMoveSpeed_Min,10);
		Player_SetRunSpeedMul(mfPlayerRunSpeed_Start);
		//Player_FadeRunSpeedMulTo(mfPlayerRunSpeed_Max,30);
		Player_SetJumpForceMul(mfPlayerJumpMul);
		Player_SetJumpDisabled(true);
		Player_SetHeadBobMul(3);
		Player_SetVertigoActive(false);		
		Pregnancy_SetBabyKicksEnabled(false);
		Player_SetNightVisionEnabled(false);
		
		ParticleSystem_SetActive("PS_Smoke_Close_1",false);
		
		Entity_StopAnimation("GuyBehindHouse");
		Entity_PlayAnimation("RoofGirl", "girl_roof_idle", 0.0f, true);
		Entity_SetActive("RoofWoman", false);
		Entity_PlayAnimation("OldManInWindow", "look_out_window_01", 0.0f, true);
		Entity_StopAnimation("Citizen_5");
	}
	
