	{
		//mfPlayerMoveSpeed_Base = (alState == 1) ? mfPlayerMoveSpeed_Fast : mfPlayerMoveSpeed_Min;
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ResetRunSpeed(const tString &in asTimer)
	{
		Player_FadeRunSpeedMulTo(mfPlayerRunSpeed_Max,1);
		Map_AddTimer("Timer_RunTimerActive",6,"OnTimer_RunTimerActive");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_RunTimerActive(const tString &in asTimer)
	{
		mbRunTimerActive = true;
	}
	
	//-------------------------------------------------------
	
	void Tasi_SetFatigueActive(bool abFatigue)
	{
		if (abFatigue)
		{
			m_idBlur = Effect_DoF_Start(0.5f,10,1,1);
			Map_AddTimer("Timer_BlurManager",cMath_RandRectf(1,2),"OnTimer_BlurManager");
		}
		else
		{
			Effect_DoF_FadeOut(m_idBlur,2);
			Map_RemoveTimer("Timer_BlurManager");
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_BlurManager(const tString &in asTimer)
	{		
		if (mlBlurStatus == -1)
		{
			float fFadeTime = cMath_RandRectf(1,3);
			Effect_DoF_FadeFocus(m_idBlur,0.3f,0.5f,fFadeTime);
			mlBlurStatus = 0;
			
			Map_RestartCurrentTimer(cMath_RandRectf(4,6));
		}
		else if (mlBlurStatus == 1)
		{
			float fFadeTime = cMath_RandRectf(1,3);
			Effect_DoF_FadeFocus(m_idBlur,0.5,10,fFadeTime);
			mlBlurStatus = 0;
			
			Map_RestartCurrentTimer(cMath_RandRectf(2,4));
		}
		else
		{
			Effect_DoF_FadeFocus(m_idBlur,0.5,mlBlurMaxDist,1);
			mlBlurStatus = 1*cMath_Sign(cMath_RandRectf(-1,1));
			
			Map_RestartCurrentTimer(cMath_RandRectf(6,8));
		}
		
	}
 
	//-------------------------------------------------------
	
	void Tasi_Contractions(float afTime)
	{
		mbContractions = true;
		
		Voice_Play("Tasi_Contraction",-1,"",-1);
		Sound_CreateAtEntity("Sound_ContractionStinger", "04_01_town/contraction_pain/contraction_pain_stingers", "player");
		
		if (mlContractionAmount < 1)
		{
			PlayerBody_PlayCutsceneAnimation("player_exhausted",false,0.2f);
			Player_SetMoveSpeedMul(.1f);
			Player_SetRunSpeedMul(0);
		}
		else
		{
			Player_SetMoveSpeedMul(.5f);
			if (Entity_Exists("Yasmin_Chase") == false)
				Player_SetRunSpeedMul(0);
			else
				Player_SetRunSpeedMul(.5f);
		}
			
		Map_AddTimer("Timer_ContractionsStop",afTime,"OnTimer_ContractionsStop");
		Map_AddTimer("Timer_Contraction",0.3f,"OnTimer_Contraction");
		Effect_ImageTrail_Start(1.5f,afTime/5,afTime+4,4);
		Effect_Shake_Start(.005f,afTime-1,afTime/2,afTime/4);
		Effect_Rumble_Start(.2f,3,0,0.1f);
		
		
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_Contractions(const tString &in asParent, const tString &in asChild, int alState)
	{
		
		if (mbContractions) {Debug_Log("ALREADY CONTRACTING!"); return false;}
		
		Map_AddTimer("Timer_ContractionsActive",0,"OnTimer_ContractionsActive");
		return false;
	}
	
	//-------------------------------------------------------
	
	bool mbLabor = true;
	
	void OnTimer_ContractionsActive(const tString &in asTimer)
	{
		int lState = cLux_GetPlayer().GetCurrentStateId();
		
		if (lState == ePlayerState_Ladder || lState == ePlayerState_Grab || lState == ePlayerState_InteractiveCameraAnimation || lState == ePlayerState_Custom_CheckBaby) //lState == ePlayerState_CutsceneAnimation
		{
			Map_RestartCurrentTimer(16);
			return;
		}
		if (Entity_GetCollide("player","Trigger_NoContractions_1") || 
			Entity_GetCollide("player","Trigger_NoContractions_2") || 
			Entity_GetCollide("player","Trigger_NoContractions_3") ||
			Entity_GetCollide("player","Trigger_NoContractions_4"))
		{
			Map_RestartCurrentTimer(2);
			return;
		}
		if (Voice_AnySceneIsActive())
		{
			Map_RestartCurrentTimer(2);
			return;
		}
		
		Tasi_SetFatigueActive(true);
		
		float fContractionsTime = cMath_Clamp(3+mlContractionAmount/2,3,10);
		
		Tasi_Contractions(fContractionsTime);
		mlContractionAmount++;
		Map_AddTimer("Timer_RemoveFatigue",fContractionsTime+5,"OnTimer_RemoveFatigue");

		float fNextContractionsTimer = (mbLabor == false) ? cMath_Clamp(55+5*mlContractionAmount*cMath_Sign(cMath_RandRectf(-1,1)),40,90) : cMath_Clamp(60-5*mlContractionAmount/2,35,60);
		Map_RestartCurrentTimer(fNextContractionsTimer);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_RemoveFatigue(const tString &in asTimer)
	{
		Tasi_SetFatigueActive(false);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ContractionsStop(const tString &in asTimer)
	{
		mbContractions = false;
		
		if (mlContractionAmount < 3)
		{
			Voice_PlayWhenPossible("Tasi_ContractionBarks");
		}
		else
		{
			if (Entity_GetCollide("player","Trigger_NoContractions_1") == false && 
				Entity_GetCollide("player","Trigger_NoContractions_2") == false && 
				Entity_GetCollide("player","Trigger_NoContractions_3") == false && 
				Entity_GetCollide("player","Trigger_NoContractions_4") == false)
			{
				float fRand = cMath_RandRectf(0,1);
				if (fRand < .3) Voice_PlayDelayed("Tasi_ContractionBarks",1);
			}
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_Contraction(const tString &in asTimer)
	{
		////////////////
		// Pulsating effect
		
		if (mbContractions == false) 
		{
			Effect_DollyZoom_Start(-.1,.3f,.4f,5);
			
			Player_SetMoveSpeedMul(.4f);
			Player_SetRunSpeedMul(0);
			Map_AddTimer("OnTimer_Contraction_RestoreSpeed", 7, "OnTimer_Contraction_RestoreSpeed");
			return;
		}
		
		float fTime = 0.02f;//cMath_RandRectf(.05f,.2f);
		float fFadeIn = 0.2f;//cMath_RandRectf(.1f,.3f);
		float fFadeOut = 0.9f;
		
		float fTotalTime = fTime+fFadeIn+fFadeOut;
		
		Effect_Rumble_Start(1,fTime+fFadeIn,0,0.1f);
		Effect_DollyZoom_Start(cMath_RandRectf(-0.15f,-0.05f),fTime,fFadeIn,fFadeOut);
		Map_RestartCurrentTimer(fTotalTime+0.001f);
		FearHandler_SetForcedAddFearRate(1,fTime+fFadeIn+fFadeOut,false,3,0.1f);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_Contraction_RestoreSpeed(const tString &in asTimer)
	{
		Player_FadeMoveSpeedMulTo(mfPlayerMoveSpeed_Min,6);
		Player_FadeRunSpeedMulTo(mfPlayerRunSpeed_Max,6);
	}
	
