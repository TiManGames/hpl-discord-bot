		//-------------------------------------------------------		
		
		void OnAnimMessage_Player(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 10) // No clue why this sound needs to be played earlier but otherwise it goes out of sync
			{
				Sound_CreateAtEntity("Sound_OpenDoor", "new_sounds/escape/door/door_open", "wooden_door_rickety_1");
			}
			if (alMessageEventID == 0) // Push door open
			{
				SwingDoor_Push("wooden_door_rickety_1",1,6);
			}
			else if (alMessageEventID == 1) // Somewhat match player's foot pos before kicking it
				SwingDoor_SetOpenAmount("wooden_door_rickety_1", 0.5);
			else if (alMessageEventID == 2) // Kick door closed
			{
				SwingDoor_SetClosed("wooden_door_rickety_1", true, true);
				Sound_CreateAtEntity("Sound_OpenDoor", "new_sounds/escape/door/door_slam", "wooden_door_rickety_1");
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimMessage_Trap(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 1) // Trap snaps shut
			{
				tString sYasminEntity = "temp_yasmin_1"; // For some reason Yasmin is still called this!
				iLuxEntity@ pYasmin = Map_GetEntity(sYasminEntity);
				cNode3D@ pYasminLegSocket = pYasmin.GetMeshEntity().GetSocket("Socket_Leg");
				
				ParticleSystem_CreateAtEntity("TrapBloodSplat", "trap_blood_splat", sYasminEntity, false);
				cParticleSystem@ pParticles = cLux_GetCurrentMap().GetWorld().GetParticleSystem("TrapBloodSplat");
				pParticles.SetPosition(pYasminLegSocket.GetWorldPosition());
			}
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_TasiEscape(const tString &in asAnimName)
		{
			Tasi_Escape();
		}
		
		//------------------------------------------------------- 
		
		void OnAnimMessage(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (asAnimName == "yasmin_moving_towards_player")
			{
				if (alMessageEventID == 0) // Dialogue_NoticeYasmin ("*sobbing*")
				{
					Voice_StopAll();
					Voice_Play("Dialogue_NoticeYasmin");
					Entity_AttachToSocket("TrapYasmin_Source", "temp_yasmin_1", "VoiceSocket", false, true);
					Voice_SetSource("Yasmin", "TrapYasmin_Source", 2, 60, true);
					FearHandler_SetForcedAddFearRate(1,6);	
				}
				else if (alMessageEventID == 1) // Dialogue_YasminApproaches ("I killed them!")
				{
					Voice_StopAll();
					Voice_Play("Dialogue_YasminApproaches",-1,"OnEndOfVoice_YasminUpClose");
				}
				else if (alMessageEventID == 2) // Event_PlayerOutro
				{
					PlayerBody_PlayCutsceneAtEntity("player_yasmin_encounter_outro","PosArea_TrapCutscene",false,0,"OnEndOfAnim_TasiEscape");
					Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(),"OnAnimMessage_Player",false);
					Entity_PlayAnimation("rocks_and_rope_town_trap_1","rocks_and_rope_town_trap_outro");
					Entity_PlayAnimation("town_jaw_trap_1","jaw_trap_town_outro");
					Entity_SetAnimationMessageEventCallback("town_jaw_trap_1","OnAnimMessage_Trap",true);
				}
			}
			else if (asAnimName == "yasmin_encounter_outro")
			{
				if (alMessageEventID == 0) 
				{
					Voice_StopAll();
					Voice_Play("Dialogue_YasminLoweringTrap");
				}
				else if (alMessageEventID == 1) // Event_YasminPushRock
				{
				}
				else if (alMessageEventID == 2) // Event_YasminStartWinch
				{
					
				}
				else if (alMessageEventID == 3) // Event_YasminLeaveWinch
				{
				}
				else if (alMessageEventID == 4) // Dialogue_YasminSelfInTrap
				{
					Voice_StopAll();
					Voice_Play("Dialogue_YasminSelfInTrap");
				}
				else if (alMessageEventID == 5) // Event_SmashDoor
				{
					Map_Preset_Fade("Outside",1);
					Map_AddTimer("Timer_Yasmin_BangOnDoor",4,"OnTimer_Yasmin_BangOnDoor");
					Map_AddTimer("Timer_TasiEscapeStart",7,"OnTimer_TasiEscapeStart");
				}
				else if (alMessageEventID == 10) // TEMP
				{
					Debug_Log("PLAYING EMOTES");
					// This is a horrible hack to get in some last-minute emotes for Tasi for this scene - IT
					Sound_CreateAtEntity("Sound_TasiTempEmotes","game_voice/voice/01_01_intro_crash_TASI","player", 0.0f,true, 0.75f);
				}
			}
		}
		
		//-------------------------------------------------------
		
		bool OnAnim_MoveCounterweight(const tString &in asEntity, int alDirection)
		{
			Prop_MoveLinearTo("hanging_counterweight", "hanging_counterweight_position_2", 5, 10, 0.1f, false, "");
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCamAnim_Damage(const tString &in asEntity, int alDirection)
		{
			Player_GiveDamage(0.1,0.9,eDamageType_Default,"");
			return true;
		}
		
		//-------------------------------------------------------
		
		/*bool OnCamAnim_YasminAppearance(const tString &in asEntity, int alDirection)
		{
			Seq_YasminReveal("");
			return true;
		}*/
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceYasminReveal;
		void Seq_YasminReveal(const tString &in asTimer)
		{
			Sequence_Begin("Seq_YasminReveal", mSequenceYasminReveal);
			if (Sequence_DoStepAndWait(27.5f))
			{
				Entity_PlayAnimation("temp_yasmin_1","yasmin_moving_towards_player",0,false,true,"OnEndOfAnim_YasminOutro");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Music_PlayExt("A2_04_01_YasminGhoul.ogg", false, 0.14f, 1.0f, 5.0f, 1.0f, eMusicPrio_BigEvent, false);
			}
			Sequence_End();
		}
		
