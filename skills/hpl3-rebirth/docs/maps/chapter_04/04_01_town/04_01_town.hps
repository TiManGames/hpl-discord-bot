		void OnTimer_AskForHelpDoor(const tString &in asTimer)
		{
			int lKnocks = Entity_GetVarInt("arabic_fort_door_01_5","");
			if (lKnocks == 0) Voice_Play("Tasi_Town_HelpMe");
		}
		
		//-------------------------------------------------------
		
		void OnInteract_LookForHelp(const tString &in asEntity)
		{
			if (Map_TimerExists("Timer_AskForHelpDoor"))
			{
				Map_RemoveTimer("Timer_AskForHelpDoor");
				return;
			}
				
			int lKnocks = Entity_GetVarInt(asEntity,"");
			
			if (Voice_SubjectIsPlaying("Tasi_Town_DoorProximity") || lKnocks == 2) return;
			
			if (Map_TimeHasPassed("Timer_DoorBark",3))
			{
				if (lKnocks == 0) Voice_PlayDelayed("Tasi_Town_HelpMe",1.0f);
				Entity_SetVarInt(asEntity,"",lKnocks+1);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_Bark(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			tString sBark = Entity_GetVarString(asParent,"");
			Voice_StopAll();
			Voice_Play(sBark);
			return false;
		}
		
