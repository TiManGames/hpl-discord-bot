		// Event A - Player gets trapped and encounters Yasmin
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 4, Event A here.*/
		
		bool mbHitTrap = false;
		
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 4, Event A here.*/
		
		bool OnCollide_Player_Trap(const tString &in asParent, const tString &in asChild, int alState)
		{
			Pregnancy_SetBarksActive(false);
			StopBreathing();
			Sketchbook_CompleteIdea("reach_tower");
			Sketchbook_NewIdeasPage();
			Map_RemoveTimer("Timer_ContractionsActive");
			Map_Preset_Fade("Inside",0);
			//Entity_SetActive("hyena_trap_1",true);
			Prop_SetActiveAndFade("trap_sand_pile", false, 0.75f);
			ParticleSystem_CreateAtEntityExt("trap_sand_cloud", "trap_sand_cloud.ps", "trap_sand_pile", false, cColor(1,1,1,1), 0.3f, false, 1, 2, 100, 110);
			
			PlayerBody_PlayCutsceneAtEntity("player_yasmin_encounter_intro","PosArea_TrapCutscene",false,0.2f,"OnEndOfAnim_HangLoop");			
			Entity_PlayAnimation("town_winch_1","winch_town_trap_intro");
			Entity_PlayAnimation("rocks_and_rope_town_trap_1","rocks_and_rope_town_trap_intro",0.1f,false,true,"OnEndOfAnim_StopRockSwinging");
			Entity_PlayAnimation("town_jaw_trap_1","jaw_trap_town_intro");
			
			Prop_SetActiveAndFade("temp_yasmin_1",true,2);
			Entity_PlayAnimation("temp_yasmin_1","yasmin_idle_intro",0,true,true,"");
			Entity_SetAnimationMessageEventCallback("temp_yasmin_1","OnAnimMessage",false);
			
			iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
			pBody.Cutscene_AutoResetCamera(false);
			
			//Sound_Play("Sound_Winch", 0.0f);
			Sound_Play("Sound_FloorDebris", 0.0f);
			//Sound_Play("Sound_TrapMed", 0.0f);
			//Sound_Play("Sound_TrapTop", 0.0f);
			Sound_CreateAtEntity("Sound_Winch_1", "new_sounds/capture/winch/winch_01", "Trigger_13");
			Map_AddTimer("Timer_PlayWinchSound", 5.0f, "OnTimer_PlayWinchSound");
			
			Sound_CreateAtEntity("Sound_TrapTop_1", "new_sounds/capture/counterweight/counterweight_1", "Trigger_TrapTop");
			for (int i = 2; i <= 12; i++)
				Map_AddTimer("new_sounds/capture/counterweight/counterweight_"+i, 5.0f*(i-1), "OnTimer_PlayCounterweightSound");
			
			//Sound_CreateAtEntity("Sound_WeightDrop", "04_01_town/trap/catch/player", "player");
			Sound_CreateAtEntity("Sound_WeightDrop_1", "new_sounds/capture/player_body/player_body_01", "player");
			for (int i = 2; i <= 5; i++)
				Map_AddTimer("new_sounds/capture/player_body/player_body_0"+i, 5.0f*(i-1), "OnTimer_PlayWeightDropSound");
			
			Music_Play("A2_04_01_TasiTrapped.ogg", 0.25f, false, eMusicPrio_MinorEvent); 
			Voice_SetSource("Yasmin_Unknown", "temp_yasmin_unknown", 2, 60, true);
			Voice_StopAll();
			Voice_PlayDelayed("Dialogue_TheTrapSprings",0.3f,-1,"OnEndOfVoice_HangingVoice");
			Player_GiveDamage(0.1,0.9,eDamageType_Fall,"");
			FearArea_SetGivesFear("Fear_1",false);
			//FearHandler_SetActive(false);
			mbHitTrap = true;
			Map_AddTimer("Timer_CloseDoor",4,"OnTimer_CloseDoor");

			return false;
		}
		
