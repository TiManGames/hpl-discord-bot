		void OnInteract_LiftingRelease(const tString &in asEntity)
		{
			if (mbPlankRelease) return;
			if (!Entity_GetCollide(asEntity,"Trigger_PlankReleased")) return;
			
			Entity_SetInteractionDisabled(asEntity,true);
			mbPlankRelease = true;
			
			
			if (Voice_SubjectIsPlaying("OnInteract_Lifting")) return;
			Voice_Play("Tasi_LiftingRelease");	
		}
		
