		{
			//CameraAnimation_Begin("CamAnim_Squeeze","",true);
			//Voice_Play("Tasi_ThroughTheRock");
			PlayThroughCrackScene();
			return false;
		}
		
		//------------------------------------------------------- 
		
		void PlayThroughCrackScene()
		{
			Item_PutAway(eItemHandlerHand_Right);
			Item_PutAway(eItemHandlerHand_Left);
				
			// We're cannibalising the animation from the DWL here, so there's some fiddling around going on.
			Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(),"OnPlayerAnimMessage_Crack",true);
			Sound_CreateAtEntity("Sound_CrackSqueeze", "04_01_town/level/town_shimmy", "player");
			PlayerBody_PlayCutsceneAtEntity("squeezes_through_the_crack_at_the_ledge", "Target_CrackAnim_Start", false, 0.5,"", 0.8f);
			
			ParticleSystem_SetVisible("PS_Smoke_Close_2",false);
			ParticleSystem_Destroy("PS_Smoke_Close_2");
			ParticleSystem_SetActive("PS_Smoke_Close_1",true);
				
			Voice_Play("Tasi_ThroughTheRock");
		}
		
		//------------------------------------------------------- 
		
		void OnPlayerAnimMessage_Crack(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 1)  
			{
				PlayerBody_StopAnimation("squeezes_through_the_crack_at_the_ledge", 0.0f);
				iScrPlayerBodyHandler_Interface @pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
				pBody.SetAnimationControlledCamera(false);
			}
		}
		
