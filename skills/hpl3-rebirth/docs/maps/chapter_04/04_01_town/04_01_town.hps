			Entity_PlayAnimation("rocks_and_rope_town_trap_1","rocks_and_rope_town_trap_idle",0.1f,true);
		}
		
		//------------------------------------------------------- 
		
		void OnEndOfAnim_YasminOutro(const tString &in asEntityName, const tString &in asAnimName)
		{
			
			Light_FadeBrightnessTo("Light_CutsceneSupport_Spot",1.5f,5);
			PlayerBody_StopAnimation("player_yasmin_encounter_swing_left",0.3f);
			PlayerBody_StopAnimation("player_yasmin_encounter_swing_right",0.3f);
			Entity_PlayAnimation("temp_yasmin_1","yasmin_encounter_outro",0.2f);
			Entity_PlayAnimation("town_winch_1","winch_town_trap_outro");
			
			//Sound_Play("Sound_DoorSlam", 0.0f);
			Map_AddTimer("Timer_EscapeMusic", 52.0f, "OnTimer_PlayEscapeMusic");
			Map_AddTimer("Timer_TrapEscape", 41.0f, "OnTimer_PlayTrapEscapeSound");
			
			Sound_CreateAtEntity("Sound_ReleaseMed_1", "new_sounds/escape/counterweight/counterweight_1", "Trigger_ReleaseMedSound");
			for (int i = 2; i <= 14; i++)
				Map_AddTimer("new_sounds/escape/counterweight/counterweight_"+i, 5.0f*(i-1), "OnTimer_PlayReleaseMedSound");
			
			Sound_CreateAtEntity("Sound_WinchRelease_1", "new_sounds/escape/winch/winch_1", "Trigger_13");
			for (int i = 2; i <= 9; i++)
				Map_AddTimer("new_sounds/escape/winch/winch_"+i, 5.0f*(i-1), "OnTimer_PlayWinchReleaseSound");
			
		}
		
