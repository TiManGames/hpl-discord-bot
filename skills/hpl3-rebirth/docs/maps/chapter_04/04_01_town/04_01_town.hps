		//-------------------------------------------------------
		
		void DoGunShot()
		{
			// Some stupid code to move the doc's gunshot closer to the cutscene if it's too far away - IT
			iLuxEntity@ pSoundEntity = Map_GetEntity("Sound_Gunshot");
			iLuxEntity@ pYasmin = Map_GetEntity("yasmin_cutscene");
			cVector3f vShotVector = pSoundEntity.GetPosition() - pYasmin.GetPosition();
			float fLength = vShotVector.Length();
			float fMaxDist = 20.0f;
			if (fLength>fMaxDist)
			{
				vShotVector.Normalize();
				pSoundEntity.SetPosition(pYasmin.GetPosition()+vShotVector*fMaxDist);
			}
				
			Sound_CreateAtEntity("Sound_DoctorFire", "04_01_town/gun/doctor_revolver_fire", "Sound_Gunshot");
			Sound_CreateAtEntity("Sound_SplashBackFront", "04_01_town/gun/revolver_splashback_front", "Sound_GunVerbFront");
			Sound_CreateAtEntity("Sound_SplashBackRear", "04_01_town/gun/revolver_splashback_rear", "Sound_GunVerbRear");
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_SlideOnSand(const tString &in asParent, const tString &in asChild, int alState)
		{
			Player_SetSlidingActive(alState == 1, Entity_GetVarFloat(asParent, ""));
			return true;
		}
		
