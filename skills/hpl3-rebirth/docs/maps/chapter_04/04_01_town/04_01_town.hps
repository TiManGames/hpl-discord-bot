		bool OnCamAnim_FadeOut(const tString &in asEntity, int alDirection)
		{
			Effect_Fade_Out(.1f);
			Sound_FadeGlobalVolume(0.0f,2.0f,eSoundEntryType_WorldAll);
			Map_ChangeMap("04_02_sandstorm.hpm", "Start_Begin", "", "", false);
			return true;
		}
		
