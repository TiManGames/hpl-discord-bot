			PlayerBody_FadeCutsceneMaxYaw(30,5);
			Map_AddTimer("Timer_ReduceYaw",30,"OnTimer_ReduceYaw");
			Voice_StopAll();
			Voice_Play("Dialogue_YasminUpClose");
		}
		
