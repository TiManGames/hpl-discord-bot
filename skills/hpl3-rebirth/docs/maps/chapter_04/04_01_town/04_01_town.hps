		}
		
		//-------------------------------------------------------
		
		void OnTimer_PostponeBarkBecauseOfContractions(const tString &in asTimer)
		{
			if (mbContractions || Voice_CharacterIsSpeaking("Player"))
			{
				Map_RestartCurrentTimer(2);
				return;
			}
			else
				Voice_Play(asTimer);	
		}
		
