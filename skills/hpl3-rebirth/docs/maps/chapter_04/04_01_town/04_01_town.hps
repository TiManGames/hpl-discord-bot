		/////////////////////////////////////////
		// Event B - Player witnesses the slaughter
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 3, Event B here.*/
		
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 3, Event B here.*/
		
		bool mbHasSeenCorpses = false;
		
		void OnLookAt_SeeCorpses(const tString &in asEntity, int alState)
		{
			if (mbHasSeenCorpses)
				return;
				
			mbHasSeenCorpses = true;
			Voice_StopAll();
			Voice_Play("Dialogue_SeesBodies");
			FearHandler_SetForcedAddFearRate(0.4f,10,false);
			Music_Play("A2_04_01_Mosque_Enter.ogg", 0.25f, false, eMusicPrio_MinorEvent);
		}
		
		void OnLookAt_SeeCorpsesEarly(const tString &in asEntity, int alState)
		{
			FearHandler_SetActive(true);
			FearScaryObject_SetCanGasp("FearScaryObject_3",false);
			FearScaryObject_SetCanGasp("FearScaryObject_4",false);
			FearScaryObject_SetCanGasp("FearScaryObject_5",false);
			FearScaryObject_SetCanGasp("FearScaryObject_6",false);
			Sound_CreateAtEntity("Sound_Corpses", "03_06_ghouls_nest/stingers/sleeping_hall_stinger", "player");
		}
		
		//} END Event B - Player witnesses the slaughter
	
	//} END SCENE 3 *PLAYER GOES INSIDE THE MOSQUE TO MEET THE DOCTOR*
	
