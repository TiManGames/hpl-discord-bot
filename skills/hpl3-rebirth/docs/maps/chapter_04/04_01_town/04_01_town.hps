		/////////////////////////////////////////
		// Event A - Player wakes up, grabs clothes and calls the doctor
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 1, Event A here.*/
		
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 1, Event A here.*/
				
		cSequenceStatesData mSequenceTownIntro;
		void Seq_TownIntro(const tString &in asTimer)
		{
			Sequence_Begin("Seq_TownIntro",mSequenceTownIntro);
			if (Sequence_DoStepAndWait(1.f))
			{	
				//Sequence_SkipNextSteps(5); return;
				mbRunTimerActive = false;
				Effect_Fade_Out(0);
				Player_Teleport("Start_Begin");
				//Map_Preset_Fade("TownExterior", 0);
				Achievement_Unlock(eAchievement_Castaway);
			}
			else if (Sequence_DoStepAndPause(0))
			{	
				Effect_Fade_In(1);
				Player_SetCrouching(false,false,false);
				PlayerBody_PlayCutsceneAtEntity("wake_up_9_months_pregnant_and_rise_slowly","PosArea_GetUpNew",false,0,"OnEndOfAnim_ResumeAfterAnim",1.f);
				Sound_CreateAtEntity("Sound_TasiWake", "04_01_town/level/desert_wake", "player");
				Voice_Play("Tasi_RealizePregnant");
				Music_Play("A2_04_01_Tasi_Wake_Pregnant.ogg", 0.13f, true, eMusicPrio_MinorEvent);
			}
			else if (Sequence_DoStepAndPause()) // Wait until the player progresses forward
			{
				// Water decal
				iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
				cVector3f vDecalPos = pBody.GetFeetPosition() + pBody.GetRight() * 0.06f + pBody.GetForward() * 0.07f;
				//mBaseObj.GetWorld().GetTerrain().AddDynamicDecal("moss_generic_01_beige.mat", vDecalPos, pBody.GetYaw() + cMath_PiDiv2, cVector2f(0.3f, 0.3f), -1.f, cColor(0.834,0.821,0.661,0.75));
				
				Player_SetMoveSpeedMul(mfPlayerMoveSpeed_Start);
				Player_FadeMoveSpeedMulTo(mfPlayerMoveSpeed_Min,20);
				StartBreathing();
			}
			else if (Sequence_DoStepAndWait(20))
			{				
				Player_StartLookAt("PosArea_LookAtSmoke",1,1,1);		
				Map_AddTimer("Timer_StopLookAt",1.5f,"OnTimer_StopLookAt");
			}
			else if (Sequence_DoStepAndWait(28))
			{
				Radio_StartCall("Tasi_CallDoctor", "", 2.f, "Radio_Doctor");
			}
			else if (Sequence_DoStepAndWait(6.5f))
			{
				Radio_StopCall();
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Map_AddTimer("Timer_ContractionsActive",0,"OnTimer_ContractionsActive");
				mbRunTimerActive = true;
			}
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_SeeSmoke(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceStates_Resume("Seq_TownIntro");
			return false;
		}

		void OnTimer_PlayDesertWalkMusic(const tString &in asTimer)
		{
			Music_Stop(10.0f, eMusicPrio_MinorEvent);
			Music_PlayExt("A2_04_01_Desert_Walk.ogg", true, 0.2f, 1.0f, 20.0f, 1.0f, eMusicPrio_BgAmb, true);
		}
			
		//-------------------------------------------------------
		
		void OnTimer_StopLookAt(const tString &in asTimer)
		{
			Player_StopLookAt(0.1f);
			StopBreathing(1.0f);
			Voice_PlayDelayed("Tasi_SeeSmoke",1, -1, "OnVoiceEnd_SeeSmoke");
		}
		
