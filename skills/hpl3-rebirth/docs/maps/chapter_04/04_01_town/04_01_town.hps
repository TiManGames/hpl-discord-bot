	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("04-01-town");
		
		Pregnancy_SetStage(ePregStage_Stage3);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Town);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(true);
		FearHandler_SetWhisperStage(eFearWhisperStage_TownToBirth);
		
		// Set up color grading etc.
		Map_SetSkyboxRotation(cVector3f(0, 1.3, 0));
		// Inside
		Map_Preset_SetupDirLight("Inside", true, cColor(0,0,0,0), 0.7f, cVector3f(0.446,-0.711,-0.544), cColor(0,0,0,0), cColor(0,0,0,0));
		Map_Preset_SetupFog("Inside", false, 1, 400, 1, cColor(0.412,0.347,0.25,0.959), 1, false, true);
		
		//Outside
		cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
		Map_Preset_SetupFog("Outside", pWorld.GetFogActive(), pWorld.GetFogStart(), pWorld.GetFogEnd(), pWorld.GetFogFalloffExp(), pWorld.GetFogColor(), pWorld.GetFogBrightness(), pWorld.GetFogUnderwater(), pWorld.GetFogUseSkybox());
		Map_Preset_SetupDirLight("Outside", true, 
								cColor(1,0.931,0.867,1), 		//Light color
								0.2f, 							//Light brightness
								cVector3f(0.446,-0.711,-0.544), //Light direction
								cColor(0.088,0.08,0.071,1), 	//Ground color
								cColor(0.561,0.527,0.508,1));	//SKy color
								
		//Town Hall
		Map_Preset_SetupFog("TownHall", pWorld.GetFogActive(), pWorld.GetFogStart()+1, pWorld.GetFogEnd()+20, pWorld.GetFogFalloffExp()+0.4, pWorld.GetFogColor(), pWorld.GetFogBrightness(), pWorld.GetFogUnderwater(), pWorld.GetFogUseSkybox());
        //Start area
		
		//Path to town
		
		//Town exterior
		Map_Preset_SetupColorGrading("TownExterior", "desert_grading_midday_new_red02.dds");
		Map_Preset_SetupFog("TownExterior", true, 1, 75, 1, cColor(0.412,0.347,0.25,0.959), 1, false, false);
		
		// Heat level, additional exposure above base when it gets hot, additional exposure above base when it gets very hot.
		//Heat_SetActive(true, 1.8f);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(2);
		StruggleFlashHandler_SetProgression(2);
		
		Player_SetAutoTeleportWhenBelowAltitude(0.f);
		
		cScript_SetGlobalVarBool("Global_LanternLost", true);
	}
	
