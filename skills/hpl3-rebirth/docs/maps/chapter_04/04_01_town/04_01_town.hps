		void OnTimer_PlayTrapEscapeSound(const tString &in asTimer)
		{			
			Sound_CreateAtEntity("Sound_TrapRelease_1", "new_sounds/escape/trap/escape_trap_1", "Trigger_TrapReleaseSound");
			for (int i = 2; i <= 7; i++)
				Map_AddTimer("new_sounds/escape/trap/escape_trap_"+i, 5.0f*(i-1), "OnTimer_PlayTrapReleaseSound");
				
			Sound_CreateAtEntity("Sound_YasminTrap", "04_01_town/trap/release/trap_release_yasmin", "Yasmin");
		}
		
