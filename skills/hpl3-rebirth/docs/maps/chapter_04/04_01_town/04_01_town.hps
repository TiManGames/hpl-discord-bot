		//-------------------------------------------------------
		
		// This is controlled by progression - as Tasi moves along the chase, this is
		// updated.
		tString msTeleportCutscenePos = "PosArea_Cutscene_TowerBuilding";
		// This is an override if you get into a specific area.
		tString msTeleportCutsceneOverridePos = "";
		int mlShouldUseTeleportCutsceneOverride = 0;
		
		//-------------------------------------------------------
		// This is to set the base progression
		bool OnCollide_Player_SetCutscenePos(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				msTeleportCutscenePos = Entity_GetVarString(asParent, "");
				Debug_Log("Teleport pos set to:"+msTeleportCutscenePos);
			}
			return true;
		}
		
		//-------------------------------------------------------
		// This is to set the override
		bool OnCollide_Player_ShouldTeleportCutscene(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState==1)
			{
				mlShouldUseTeleportCutsceneOverride += 1;
				msTeleportCutsceneOverridePos = Entity_GetVarString(asParent, "");
				Debug_Log("Teleport override pos set to:"+msTeleportCutsceneOverridePos);
			}
			else
			{
				mlShouldUseTeleportCutsceneOverride -= 1;
			}
			return true;
		}
		
