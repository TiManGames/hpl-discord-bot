		//-------------------------------------------------------
		
		tString msCatchCutscenePos;
		
		void Yasmin_CatchPlayer()
		{
			Player_GiveDamage(0.4, 0.5, eDamageType_Default, "");
							
			PlayerBody_StopCustomAnimation();
			PlayerBody_StopAnimationLayer(ePlayerBodyAnimationLayer_FullBody,0);
			Agent_SetSensesActive("Yasmin_Chase",false);
			Voice_StopAll();
			Map_RemoveTimer("Timer_ForceCatch");
			Map_RemoveTimer("Timer_CheckYasminDistance");
			Map_RemoveTimer("Timer_ContractionsActive");
			Map_RemoveTimer("Timer_PlayerEscapeContractions");
			Effect_ImageTrail_FadeOut(m_idTrail,3);
			Tasi_SetFatigueActive(false);
			Sound_CreateAtEntity("Sound_TasiEmotes","game_voice/voice/emote_doctor_rescue_prelude","player");
			
			// We ALWAYS teleport now, so that geometry isn't borked.
//			if (mlShouldUseTeleportCutsceneOverride>0)
//			{
				msCatchCutscenePos = msTeleportCutscenePos;
				if (mlShouldUseTeleportCutsceneOverride>0)
					msCatchCutscenePos = msTeleportCutsceneOverridePos;
				Debug_Log("TELEPORT TO:"+msCatchCutscenePos);
				Seq_YasminCatchesTeleport("");
//			}
			//Seq_YasminCatches("");
		}
		
		//-------------------------------------------------------
		
		/*
		We ALWAYS teleport now.
		cSequenceStatesData mSequenceYasminCatches;
			
		void Seq_YasminCatches(const tString &in asTimer)
		{
			Sequence_Begin("Seq_YasminCatches", mSequenceYasminCatches);
			if (Sequence_DoStepAndWait(.1f))
			{
				Entity_SetActive("yasmin_cutscene",true);
				Entity_TeleportToAgent("yasmin_cutscene",msYasmin);
			}
			else if (Sequence_DoStepAndWait(.01f))
			{
				Entity_SetActive(msYasmin,false);
				Yasmin_PlayCatchCutscene();
			}
		}*/
		
		//------------------------------------------------------- 
		
		cSequenceStatesData mSequenceYasminCatchesPlayerTeleport;
		
		void Seq_YasminCatchesTeleport(const tString &in asTimer)
		{
			Sequence_Begin("Seq_YasminCatchesTeleport", mSequenceYasminCatchesPlayerTeleport);
			if (Sequence_DoStepAndWait(.1f))
			{
				Effect_Fade_Out(0.1f);
			}
			else if (Sequence_DoStepAndWait(.1f))
			{
				Entity_SetActive("yasmin_cutscene",true);
				Entity_SetActive("04_01_town_yasmin_cutscene_lights",true);
				Agent_TeleportFeetToEntity("Yasmin_Chase", msCatchCutscenePos);
			}
			else if (Sequence_DoStepAndWait(.2f))
			{
				Entity_TeleportToAgent("yasmin_cutscene","Yasmin_Chase");
				Entity_SetActive("Yasmin_Chase",false);
			}
			else if (Sequence_DoStepAndWait(.3f))
			{
				Effect_Fade_In(.2f);
				Entity_AlignBaseMatrix("yasmin_cutscene", msCatchCutscenePos);
				Yasmin_PlayCatchCutscene();
			}
		}
		
		//-------------------------------------------------------
		
		void Yasmin_PlayCatchCutscene()
		{
			Map_RemoveTimer("Yasmin_ChaseBarks");
				
			Entity_SetActive("yasmin_cutscene",true);
			//Entity_SetActive("Bullets",true);
			//Entity_TeleportToAgent("Bullets",msYasmin);
			//Entity_AlignBaseMatrix("Bullets", msYasmin);
			
			Entity_PlayAnimation("yasmin_cutscene","yasmin_throwing_the_player_to_the_ground");
			Entity_SetAnimationMessageEventCallback("yasmin_cutscene","OnYasminAnimMessage_LastStruggle",false);
			//Entity_PlayAnimation("Bullets","bullet_trail_doctor_shooting_yasmin");
			
			PlayerBody_SetCutsceneMaxPitch(15.f);
			PlayerBody_SetCutsceneMaxYaw(15.f);
			PlayerBody_PlayCutsceneAtEntity("player_thrown_to_the_ground_by_yasmin","yasmin_cutscene",false,0.5f,
					"OnEndOfAnim_DoctorRescuesTasi");
			//SequenceStates_Stop("Seq_YasminSpeed");
			
			Sound_Stop("Sound_TasiTempEmotes",0.5f);
			Sound_CreateAtEntity("Sound_YasminAttack", "new_sounds/town/yasmin_attack_player", "player");
			Voice_Play("Dialogue_Struggle");
			
			Seq_YasminCatchesPlayer("");
			//Seq_SoundDocShoot("");
		}
		
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceYasminCatchesPlayer;
		int mlYasminStruggleBlur = -1;
			
		void Seq_YasminCatchesPlayer(const tString &in asTimer)
		{
			Sequence_Begin("Seq_YasminCatchesPlayer", mSequenceYasminCatchesPlayer);
			if (Sequence_DoStepAndWait(2.75f))
			{
				mbTasiFar = Entity_GetCollide("player","Trigger_TasiFarFromMines");
				Music_Stop(10.0f, eMusicPrio_AgentToHuntTransition);
				
				mlYasminStruggleBlur = Effect_Blur_Start(0.4,0.3f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				DoGunShot();	
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Player_DoDamageEffects(0.2f);
								
				Effect_Fade_Out(0.1f);
				Sound_Fade("Sound_TasiEmotes",0.0f,0.1f);
				Music_StopAll(0.5f);
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				FinalFight_SkipTime(7.0f);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Effect_Fade_In(1.0f);
				Sound_Fade("Sound_TasiEmotes",1.0f,1.0f);
			}
			else if (Sequence_DoStepAndContinue())
			{
				
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		// Hack hack hack! We can't redo the anim now and it's flawed, so we're skipping the middle. IT
		void FinalFight_SkipTime(float fTime)
		{
			cAnimationState@ animState = PlayerBody_GetAnimationState("player_thrown_to_the_ground_by_yasmin");
			animState.SetTimePosition(animState.GetTimePosition()+fTime);
			
			@animState = Map_GetEntity("yasmin_cutscene").GetMeshEntity().GetAnimationStateFromName("yasmin_throwing_the_player_to_the_ground");
			animState.SetTimePosition(animState.GetTimePosition()+fTime);
		}
		
		//-------------------------------------------------------
		
		void OnYasminAnimMessage_LastStruggle(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{

			if (alMessageEventID == 11)	// Push down
			{
	
			}
			else if (alMessageEventID == 12)	// Claw hit
			{
				Player_DoDamageEffects(0.5f);
				Effect_Blur_FadeAmount(mlYasminStruggleBlur,0.5,0.0f);
			}
			else if (alMessageEventID == 13)	// Claw hit
			{
				Player_DoDamageEffects(0.1f);
				Effect_Blur_FadeAmount(mlYasminStruggleBlur,0.7f,0.0f);
			}
			else if (alMessageEventID == 14)	// Claw hit
			{
				Player_DoDamageEffects(1.0f);
				Effect_Blur_FadeAmount(mlYasminStruggleBlur,0.8f,1.f);

			}
			else if (alMessageEventID == 21)	// Throat Grab
			{
				Effect_Blur_FadeAmount(mlYasminStruggleBlur,1.0f,1.0f);
				if (m_idTrail!=-1)
					Effect_ImageTrail_FadeOut(m_idTrail,1.0f);
				m_idTrail = Effect_ImageTrail_Start(2,10,90,0);
			}
			else if (alMessageEventID == 90)	// Throat Grab
			{
				Effect_Blur_FadeAmount(mlYasminStruggleBlur,1.0f,1.0f);
				if (m_idTrail!=-1)
					Effect_ImageTrail_FadeOut(m_idTrail,1.0f);
				m_idTrail = Effect_ImageTrail_Start(2,10,90,0);
			}
			else if (alMessageEventID == 1)  	// First bullet hit
			{
				Yasmin_DoBulletHit(1);
				
				Effect_Blur_FadeOut(mlYasminStruggleBlur,15.0f);
			}
			else if (alMessageEventID == 2)		// Second bullet hit
			{
				Yasmin_DoBulletHit(2);
			}
			
		}
		
		//-------------------------------------------------------
		
		void Yasmin_DoBulletHit(int anHit)
		{
			iLuxEntity@ pYasmin = Map_GetEntity("yasmin_cutscene");
			cNode3D@ pYasminBulletSocket = pYasmin.GetMeshEntity().GetSocket("Socket_Shot"+anHit);
			ParticleSystem_CreateAtEntity("BulletHit_"+anHit, "yasmin_bullet_hit", "yasmin_cutscene", false);
			cParticleSystem@ pParticles = cLux_GetCurrentMap().GetWorld().GetParticleSystem("BulletHit_"+anHit);
			pParticles.SetPosition(pYasminBulletSocket.GetWorldPosition());
		}
		
		//-------------------------------------------------------
		
		void SnapBlackout()
		{
			Effect_Fade_Out(0.0f);
			Map_AddTimer("SnapBlackout", 0.1f, "OnTimer_SnapBlackout");
		}
	
		//-------------------------------------------------------
	
		void OnTimer_SnapBlackout(const tString& in asTimer)
		{
			Effect_Fade_In(0.2f);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_DoctorRescuesTasi(const tString &in asAnimName)
		{
			Entity_PlayAnimation("yasmin_cutscene","yasmin_roll_over");
			Map_GetEntity("Doctor").GetMeshEntity().SetVisible(false);
			Entity_PlaceAtEntity("Doctor","yasmin_cutscene",cVector3f_Zero,true);
			//Entity_TeleportToAgent("Doctor",msYasmin);
			Entity_SetActive("Doctor",true);
			Entity_AttachToSocket("Doctor_Voice", "Doctor", "HeadSocket", true);
			Voice_SetSource("Doctor", "Doctor_Voice", 2, 60, true);
			
			//Entity_PlaceAtEntity("Revolver","Doctor",cVector3f_Zero,true,false);
			//Entity_PlayAnimation("Revolver","doctor_walk_with_revolver");
			Map_GetEntity("Doctor").GetMeshEntity().SetVisible(false);
			Entity_PlayAnimation("Doctor","doctor_picks_up_player");
			// Remove - we're cutting the walking sections last-minute - IT
			//PlayerBody_PlayCutsceneAtEntity("player_gets_picked_up_by_the_doctor","yasmin_cutscene",false,0.1f,"OnEndOfAnim_DecideEnding");
			PlayerBody_PlayCutsceneAtEntity("player_gets_picked_up_by_the_doctor","yasmin_cutscene",false,0.1f);
			Map_AddTimer("Timer_DoctorVisible",0.2f,"OnTimer_DoctorVisible");
			Effect_Fade_In(1);
			Seq_DoctorRescuesTasi("");
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_DoctorVisible(const tString &in asEntity)
		{
			Map_GetEntity("Doctor").GetMeshEntity().SetVisible(true);
			Entity_AttachToSocket("Revolver","Doctor","j_R_HandSocket_Socket_1",true);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceDoctorRescuesTasi;
			
		void Seq_DoctorRescuesTasi(const tString &in asTimer)
		{
			Sequence_Begin("Seq_DoctorRescuesTasi", mSequenceDoctorRescuesTasi);
			if (Sequence_DoStepAndWait(4))
			{
				Music_Play("A2_04_01_DoctorSave.ogg", 0.23f, false, eMusicPrio_BigEvent);
				Sound_Fade("Sound_TasiEmotes",0.0f,0.5f);
				Voice_Play("Dialogue_Doctor", -1, "OnVoiceEnd_DialogueDoctor");
			}
			else if (Sequence_DoStepAndWait(.3))
			{
				Effect_Fade_Out(.1f);
			}
			else if (Sequence_DoStepAndWait(12.6))
			{
				//Voice_PlayDelayed("Dialogue_YasminFinal",14);
				Voice_PlayDelayed("Dialogue_TasiFinalCries",12);
				Effect_Fade_In(.2f);
			}
			else if (Sequence_DoStepAndWait(4.))
			{
				Sound_Stop("Sound_TasiEmotes",0.5f);
				Effect_Fade_Out(.3f);
			}
			else if (Sequence_DoStepAndContinue())
			{
				Music_FadeVolumeMul(0.0f,5.0f);
				Tasi_EndChase();
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_DialogueDoctor(const tString& in asScene, const tString& in asSubject)
		{
			Sound_Fade("Sound_TasiEmotes",1.0f,0.5f);
		}
		
		//-------------------------------------------------------
		
		void OnDialogue_TasiCryingLine(const tString& in asScene, const tString& in asSubject, int anLineIndex, bool abLineStart)
		{
			if (!abLineStart)
				return;
			Map_AddTimer("Timer_BeforeDocEnd", 1.25f,"OnTimer_BeforeDocEnd");
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_BeforeDocEnd(const tString& in asTimer)
		{
			Voice_Play("Dialogue_DoctorEnd");
		}
		
		//------------------------------------------------------- 
		
	/*	void OnEndOfAnim_DecideEnding(const tString &in asAnimName)
		{
			Chase_DecideEnding();
		}
		
		//------------------------------------------------------- 
		
		void Chase_DecideEnding()
		{
			tString sPos = (mbTasiFar) ? "PosArea_Far" : "PosArea_Mid";
			
			Entity_PlaceAtEntity("Doctor",sPos,cVector3f_Zero,true);
			Entity_SetActive("Doctor",true);
			Entity_PlayAnimation("Doctor","doctor_walk_with_player");
			PlayerBody_PlayCutsceneAtEntity("player_walk_with_doctor",sPos,false,0);
			
			if (mbTasiFar) 	Seq_TasiWalkFar("");
			else			Seq_TasiWalkMid("");
			
			Effect_Fade_In(3.f);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTasiWalkFar;
			
		void Seq_TasiWalkFar(const tString &in asTimer)
		{
			Sequence_Begin("Seq_TasiWalkFar", mSequenceTasiWalkFar);
			if (Sequence_DoStepAndWait(3.4))
			{
				Debug_Log("SEQ FAR");
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Effect_Fade_Out(.3);
				mbTasiFar = false;
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Chase_DecideEnding();
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceTasiWalkMid;
			
		void Seq_TasiWalkMid(const tString &in asTimer)
		{
			Sequence_Begin("Seq_TasiWalkMid", mSequenceTasiWalkMid);
