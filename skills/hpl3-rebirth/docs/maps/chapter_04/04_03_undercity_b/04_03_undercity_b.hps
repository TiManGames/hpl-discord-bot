	// SCENE 4 *THE PLAYER EXPLORES THE PORTAL ROOM*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 4 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 4 here.*/
	 
		//-------------------------------------------------------
		
		//} END General
		
		/////////////////////////////////////////
		// Event A *Spot the PORTAL*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event A here.*/
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 4, Event A here.*/
				
		bool OnTrigger_Player_PlayWheresDoctorDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_PlayDelayed("Dialogue_WheresDoctor", 0.5f);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_PlayParisDialogue(const tString &in asEntity, int alState)
		{
			if (mbTinHinanEncounterStarted)
				return;
			
			Voice_Play("Dialogue_Paris");
		}

		//-------------------------------------------------------

		//} END Event A *Spot the PORTAL*
		
		/////////////////////////////////////////
		// Event B *Press the PORTAL BUTTON*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 3, Event B here.*/
		
		float mfWaterOrbFadeCount = 5.f;
		bool mbFadeInWaterOrb = false;
		float mfLidRotDir = 1.f;
		bool mbAllowPortalDestinationFlicker = false;
		float mfPortalDestinationFlickerTime = 2.f;
		float mfPortalDestinationStrength = 1.f;
		tString msPortalDestination = "Portal_Destination_Paris";
		array<tString> mvPortalDestinations = {"Portal_Destination_Paris", "Portal_Destination_Town", "Portal_Destination_DW"};

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 3, Event B here.*/
		
		void SetWaterOrbActive(bool abX)
		{
			mfWaterOrbFadeCount = 5.f;
			mbFadeInWaterOrb = abX;
			
			if (abX)
			{
				iLuxEntity@ pEnt = mBaseObj.GetEntityByName("Portal_WaterOrb", eLuxEntityType_Prop);
				if (pEnt !is null)
				{
					pEnt.SetActive(true);
					pEnt.GetMeshEntity().SetDiffuseColorMul(cColor(1.f, 1.f, 1.f, 0.f));
				}			
			}
		}
		
		//-------------------------------------------------------
		
		void UpdatePortalEffects(float afDeltaTime)
		{
			if (mfWaterOrbFadeCount > 0.f)
			{
				mfWaterOrbFadeCount -= afDeltaTime;
				float fAlpha = cMath_Clamp(mfWaterOrbFadeCount / 5.f, 0.f, 1.f);
					
				if (mbFadeInWaterOrb)
					fAlpha = 1.f - fAlpha;
						
				iLuxEntity@ pOrb = mBaseObj.GetEntityByName("Portal_WaterOrb", eLuxEntityType_Prop);
				if (pOrb !is null)
				{
					pOrb.GetMeshEntity().SetDiffuseColorMul(cColor(1.f, 1.f, 1.f, fAlpha));
					
					if (mbFadeInWaterOrb == false && fAlpha <= 0.f)
						pOrb.SetActive(false);
				}
			}
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_ActivatePortalFlicker(const tString &in asParent, const tString &in asChild, int alState)
		{			 
			mbAllowPortalDestinationFlicker = alState == 1;
			SetCurrentPortalDestinationActive(alState == 1, 1.f);
			
			Map_AddTimer("Timer_PortalDestinationFlicker", 3.f, "OnTimer_PortalDestinationFlicker");	
			return true;
		}
		 
		//-------------------------------------------------------
		 
		void OnTimer_PortalDestinationFlicker(const tString &in asTimer)
		{			 
			 if (mbAllowPortalDestinationFlicker == false)
				 return;
				 
			 float fTime = cMath_RandRectf(0.15f, 0.2f);
			 mfPortalDestinationFlickerTime -= fTime;
			 
			 if (mfPortalDestinationFlickerTime <= 0.f)
			 {
				 mfPortalDestinationFlickerTime = cMath_RandRectf(2.f, 3.5f);
				 
				 msPortalDestination = "Portal_Destination_Town";
				 SetCurrentPortalDestinationActive(false, cMath_RandRectf(0.15f, 0.25f));
				 msPortalDestination = "Portal_Destination_DW";
				 SetCurrentPortalDestinationActive(false, cMath_RandRectf(0.15f, 0.25f));				 
				 msPortalDestination = "Portal_Destination_Paris";				 
				 SetCurrentPortalDestinationActive(true, cMath_RandRectf(0.4f, 0.7f));
				 
				 Map_AddTimer("Timer_PortalDestinationFlicker", cMath_RandRectf(3.5f, 7.f), "OnTimer_PortalDestinationFlicker");	
				 return;
			 }
			 
			 SetCurrentPortalDestinationActive(false, fTime);
			 
			 int lId = cMath_RandRectl(0, mvPortalDestinations.size() - 1);
			 msPortalDestination = mvPortalDestinations[lId];
			 
			 mvPortalDestinations.removeAt(lId);
			 if (mvPortalDestinations.size() == 0)
			 {
				 mvPortalDestinations.push_back("Portal_Destination_Paris");
				 mvPortalDestinations.push_back("Portal_Destination_Town");
				 mvPortalDestinations.push_back("Portal_Destination_DW");
			 }
			 
			 SetCurrentPortalDestinationActive(true, fTime);
			 
			 Map_AddTimer("Timer_PortalDestinationFlicker", fTime, "OnTimer_PortalDestinationFlicker");	
		}
		 
		//-------------------------------------------------------
		 
		void SetCurrentPortalDestinationActive(bool abX, float afTime = 0.5f, float afMul = 1.5f)
		{
			cColor color = abX ? cColor(mfPortalDestinationStrength) : cColor(0.f, 0.f, 0.f, 0.f);
			Entity_FadeEffectBaseColor(msPortalDestination, color * afMul, afTime);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_PortalButton(const tString &in asEntity)
		{
			 ActivatePortal(true);
		}
		 
		//-------------------------------------------------------
		 
		void OnTimer_GivePortalFeedback(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Sound_OrbMissing_1", "03_03_herberts_hq/beam_filter/beam_filter_misaligned", "Portal");
			
			Map_RemoveTimer("Timer_PortalDestinationFlicker");
			OnTimer_PortalDestinationFlicker("Timer_PortalDestinationFlicker");
			
			if (Entity_IsActive("VitaeCanister_4") == false)
			{
				Light_FadeBrightnessTo("Light_NoCanister_4" + "_*", 8.f, 0.5f, eEasing_SineIn);
				
				Map_AddTimer("Timer_ResetNoCanisterLight_Step1", 0.5f, "OnTimer_ResetNoCanisterLight_Step1");
				Map_SetTimerUserVarInt("Timer_ResetNoCanisterLight_Step1", 4);
			}
		}
		
		//-------------------------------------------------------
		
		void SetVitaeLidOpen(bool abX)
		{
			mfLidRotDir = abX ? 1.f : -1.f;
			RotateVitaeLid(1.5f);			
			Map_AddTimer("Timer_StopLidRotate", 1.5f, "OnTimer_StopLidRotate");
		}
		
		//-------------------------------------------------------
		
		void RotateVitaeLid(float afSpeed)
		{
			cVector3f vAxisA = Map_GetEntity("Area_VitaeSlotLid_1", eLuxEntityType_Area).GetMatrix().GetTranspose().GetUp() * mfLidRotDir;
			cVector3f vAxisB = Map_GetEntity("Area_VitaeSlotLid_2", eLuxEntityType_Area).GetMatrix().GetTranspose().GetUp() * mfLidRotDir;
			
			Prop_RotateToSpeed("VitaeSlotLid_1", 5.f, afSpeed, vAxisA, false, "Area_VitaeSlotLid_1");
			Prop_RotateToSpeed("VitaeSlotLid_2", 5.f, afSpeed, vAxisB, false, "Area_VitaeSlotLid_2");
			
			if (afSpeed > 0.f)
				Sound_CreateAtEntity("Sound_VitaeLidMove", "level_entity_shared/doors/slide/slide", "Area_VitaeSlotLid_1");
			else
				Map_AddTimer("Timer_StopVitaeLidSound", 0.175f, "OnTimer_StopVitaeLidSound");
		}
		
		//-------------------------------------------------------
		 
		void OnTimer_StopLidRotate(const tString &in asTimer)
		{
			RotateVitaeLid(0.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopVitaeLidSound(const tString &in asTimer)
		{
			Sound_Stop("Sound_VitaeLidMove", 0.3f);
			Sound_CreateAtEntity("Sound_VitaeLidStop", "level_entity_shared/doors/slide/impact_max", "Area_VitaeSlotLid_1");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CloseVitaeLid(const tString &in asTimer)
		{
			SetVitaeLidOpen(false);
		}
		
		//-------------------------------------------------------
		
		void SetPortalButtonActive(bool abX, bool abSetup = false)
		{
			Map_RemoveTimer("Timer_MovePortalButtonDoor");
			Map_RemoveTimer("Timer_MovePortalButtonPlate");
			
			if (abX)
			{
				Map_AddTimer("Timer_MovePortalButtonDoor", 0.f, "OnTimer_MovePortalButtonDoor");
				Map_SetTimerUserVarInt("Timer_MovePortalButtonDoor", 1);
			
				Map_AddTimer("Timer_MovePortalButtonPlate", 1.5f, "OnTimer_MovePortalButtonPlate");
				Map_SetTimerUserVarInt("Timer_MovePortalButtonPlate", 1);
			}
			else
			{
				Map_AddTimer("Timer_MovePortalButtonDoor", 2.9f, "OnTimer_MovePortalButtonDoor");
				Map_SetTimerUserVarInt("Timer_MovePortalButtonDoor", 0);
			
				Map_AddTimer("Timer_MovePortalButtonPlate", 0.f, "OnTimer_MovePortalButtonPlate");
				Map_SetTimerUserVarInt("Timer_MovePortalButtonPlate", 0);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MovePortalButtonDoor(const tString &in asTimer)
		{
			bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			MoveObject_SetState("AltarDoor", (bX ? -1.f : 0.f));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MovePortalButtonPlate(const tString &in asTimer)
		{
			bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			MoveObject_SetState("AltarPlate", (bX ? 0.f : -15.5f));
		}
		
		//-------------------------------------------------------

