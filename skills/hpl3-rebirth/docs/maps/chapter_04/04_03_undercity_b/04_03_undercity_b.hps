	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	int mlPermaFailId = 0;
	bool mbTinHinanEncounterStarted = false;
	array<cVitaePipeCrack> mvPipeCracks(0);
	
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	void VariableUpdate(float afDeltaTime)
	{
		UpdatePortalEffects(afDeltaTime);
		UpdateBeamGhostParticles(afDeltaTime);
		UpdateVitaeValve(afDeltaTime);
		UpdateVitaePipeCrack(afDeltaTime);
		UpdatePortalRoomWallLight(afDeltaTime);
	}
		
	//-------------------------------------------------------
	
	void Update(float afDeltaTime)
	{
		if (mbLoaded == false) OnLoad();
	}
	
	//-------------------------------------------------------
	
	void OnCheckBaby(int alState)
	{
		if (alState == -1)
			return;
		
		if (mlBabyCryStage != -1)
		{
			Map_RemoveTimer("Timer_ShowSootheBabyHint");
			Map_AddTimer("Timer_SootheBaby", 1.25f, "OnTimer_SootheBaby");
			return;
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_SootheBaby(const tString &in asTimer)
	{
		if (Player_GetCurrentStateName() == "State_CheckBaby")
			StopEncounterBabyCry(mbPlayerInsideThroneRoom == false);
	}
	
	//-------------------------------------------------------
	
	void StopEncounterBabyCry(bool abStopTimers = false)
	{
		mlBabyCryStage = -1;
		Hint_StopHint();
		
		Baby_SetCryStage("BabyCarried", -1);
		
		if (abStopTimers)
		{
			Map_RemoveTimer("Timer_EncounterBabyCry");
		}			
		else
		{
			Map_RemoveTimer("Timer_EncounterBabyCry");
			Map_AddTimer("Timer_EncounterBabyCry", cMath_RandRectf(40.f, 45.f), "OnTimer_EncounterBabyCry");
		}
	}
	
	//-------------------------------------------------------
	
	void ResetPlayerMoveSpeed(bool abFade = false)
	{
		if (abFade)
		{
			Player_FadeRunSpeedMulTo(gfUndercityPlayerRunSpeedMul, 0.5f);
			Player_FadeMoveSpeedMulTo(gfUndercityPlayerMoveSpeedMul, 0.5f);
			return;
		}
		
		Player_SetMoveSpeedMul(gfUndercityPlayerMoveSpeedMul);
		Player_SetRunSpeedMul(gfUndercityPlayerRunSpeedMul);
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SetVisibilityAreaActive(const tString &in asParent, const tString &in asChild, int alState)
	{
		bool bActive = alState == 1;
		tString sArea = Entity_GetVarString(asParent, "");
		
		if (bActive == false)
		{
			if (sArea == "VisibilityArea_Nursery" && SlideDoor_GetOpenAmount("NurseryDoor_1") > 0)
				bActive = true;
		}
		
		Visibility_SetAreaActive(sArea, bActive);
		mBaseObj.GetWorld().SetDistanceCullActive(alState == -1);
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_ShadowFlesh(const tString &in asParent, const tString &in asChild, int alState)
    {
        if (alState == -1) return true;
        if (Map_TimeHasPassed("Timer_ShadowFleshDamage", 1.f) == false) return true;
        
        Player_GiveDamage(0.1f, 0.2f, eDamageType_Guardian, asParent);
        return cMath_RandRectl(0, 1) == 1;
    }
	
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
	
