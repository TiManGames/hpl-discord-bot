		/////////////////////////////////////////
		// Event D *Leave the Nursery*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 6, Event D here.*/
		
		int mlNurseryChoiceDialogueCount = 0;
		bool mbDelayNurseryChoiceDialogue = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 6, Event D here.*/
		
		void OnAnimEnd_PutBackBaby(const tString &in asAnim)
		{			
			Player_SetCrouching(false, true, true);
			Player_SetAllowCheckBaby(false);
			Player_SetRunSpeedMul(0.f);
			Player_SetCrouchDisabled(false);
			Player_SetJumpDisabled(false);
			
			PlayerBody_SetArmAnimationPitch(true, true, true);
			PlayerBody_SetArmAnimationYaw(true, true, true);
			
			Entity_PlayAnimation("BabyCarried", "baby_idle_crib_post_pickup", 0.f, true);
			Entity_PlayAnimation("Monkey", "monkey_idle_crib", 0.f, true);
			
			Entity_SetAnimationMessageEventCallback("BabyCarried", "OnAnimEvent_LeftBeby", false);
				
			Sketchbook_CompleteIdea("leave_baby");
			Sketchbook_CompleteIdea("meet_tinhinan");
				
			SetCribOpen(false);	
			mbAllowCribOpen = false;
			
			Entity_SetCollideCharacter("BlockBox_CribMiddle", false);

			Entity_SetActive("BabyMobile", false);
			Entity_SetActive("BabyMobile_Closed", true);			
			Sound_CreateAtEntity("Sound_BabyMobileClose", "level_entity_shared/doors/metal_wall_hatch/wall_hatch_max", "VitaeCanister_5", 0.f, false, 1.f, 5.f, 15.f);
			
			Entity_SetActive("Trigger_PickUpBaby", false);
			Entity_SetActive("Trigger_AllowBabyInteraction", false);
			
			FearHandler_SetPermaFailTriggerAnimation("");
			
			// TODO: Close the door to the canister here so you can't get it.
			Entity_SetInteractionDisabled("VitaeCanister_5", true);
			Entity_SetInteractionDisabled("InteractArea_PlaceVitaeCanister_5", true);
			Entity_SetActive("InteractArea_PlaceVitaeCanister_5", false);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEvent_LeftBeby(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (Sound_Exists("Sound_LeftBaby") == false)
			{
				Sound_CreateAtEntity("Sound_LeftBaby", "game_voice/voice/baby/baby_idle_crib_post_pickup", "Area_CribCry", 0.f, false, 1.f, 2.f, 11.f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_PutBabyDown(const tString &in asScene, const tString &in asSubject)
		{
			Voice_StopAll();
			Voice_Play("Dialogue_GiveMonkey");
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_PlayChoiceDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_PlayChoiceDialogue", 0.5f, "OnTimer_PlayChoiceDialogue");				
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayChoiceDialogue(const tString &in asTimer)
		{
			bool bPlay = Voice_SceneInvolvingCharacterIsActive("Tin Hinan") == false && 
						 Entity_PlayerIsInFront("Trigger_PlayChoiceDialogue") &&
						 Entity_GetCollide("Area_StopChoiceDialogue", "player") == false;
						 
			float fTime = mbDelayNurseryChoiceDialogue == false ? 0.5f : 2.f;
			
			if (bPlay)
			{
				mbDelayNurseryChoiceDialogue = true;
				
				tString sSubject = Player_GetHoldingBaby() ? "Dialogue_LeaveWithBaby" : "Dialogue_LeaveWithoutBaby";
				
				Voice_StopAll();
				Voice_PlayDelayed(sSubject, fTime);					
				
				Map_AddTimer("Timer_PlayChoiceDialogue", fTime + 0.5f, "OnTimer_PlayChoiceDialogue");
				
				if (Player_GetHoldingBaby() == false && SlideDoor_GetOpenAmount("NurseryEntranceGrate_Door") <= 0.f)
				{
					SlideDoor_SetClosed("NurseryEntranceGrate_Door", false);
					Sound_CreateAtEntity("Sound_NurseryBigGate", "level_entity_shared/doors/DW_slide_door/open", "NurseryEntranceGrate_Door", 0.f, false, 1.f, 5.f, 25.f);
				}
					
				return;
			}
						
			Map_AddTimer("Timer_PlayChoiceDialogue", 0.1f, "OnTimer_PlayChoiceDialogue");
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_ExitNursery(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_ClearQueued();
			
			Map_RemoveTimer("Timer_PlayChoiceDialogue");
			Entity_SetActive("Trigger_PlayChoiceDialogue", false);
			
			Light_SetCastShadows("Doctor_scene_*", false);
			
			Seq_ScareStruggle("");
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Event D *Leave the Nursery*
	 
	//} END SCENE 6
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 7 *THE PLAYER STRUGGLES AS TIN HINAN TRIES TO MAKE THEM LEAVE THE BABY WITH HER*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 7 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 7 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A *Struggle against giving Tin Hinan the baby*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 7, Event A here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 7, Event A here.*/
		
		cSequenceStatesData mSeqDataScareStruggle;		
		void Seq_ScareStruggle(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ScareStruggle", mSeqDataScareStruggle);
			if (Sequence_DoStepAndWait(0.5f))
			{				
				mbTinHinanEncounterStarted = true;
				
				StruggleFlashHandler_SetProgression(3);
				
				Entity_SetActive("PortalRoomRoot_*", true);
				Entity_SetActive("BlockBox_PortalRoomRoots_*", true);
				Entity_SetActive("Trigger_StartSeqBreakPortalWalls", true);
				Entity_SetActive("Trigger_SetupPortalEndRoots", true);
				
				TinHinan_SetSpotlightSoundVolumeMul("TH_Beam", 1.f);
				
				TinHinan_SetSpotlightOn("TH_Beam", true, false, 1.f);
				TinHinan_TurnSpotlightToPos("TH_Beam", Player_GetCameraPosition() + cVector3f(0.f, 2.f, 0.f), true, true, 2.f);
				TinHinan_StopSpotlightFollow("TH_Beam");
				
				FearThreatAgent_SetComponentEnabled("TH_Beam", true);
				
				YoungTinHinan_Deactivate("TH_Ghost", 1.f, true);
				
				Voice_SetSource("Tin Hinan", "TH_Beam", 10.f, 150.f, true);
				
				Music_Stop(1.f, eMusicPrio_MinorEvent);
				
				/////////////
				// Make sure first covers don't go down
				VineCover_SetIndependant("Cover_36", true);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{				
				float fStruggleTime = 15.f;
				bool bHoldingBaby = Player_GetHoldingBaby();
				
				if (bHoldingBaby)
				{
					Map_AddTimer("Timer_PlayEncounterStartDialogue", 1.5f, "OnTimer_PlayEncounterStartDialogue");
				}
				else
				{					
					mlPermaFailId = 1;
					fStruggleTime = 10.f;
					
					GhoulProgression_SetLimit(20);
					GhoulProgression_SetIncreaseDuringStruggle(true, 9.5f);
				}
				
				Player_SetJumpDisabled(false);
				
				TinHinan_SetSpotlightColor("TH_Beam", "detected");
				
				Struggle_StartTinHinan("TH_Beam", "OnStruggleEnd_Scare", fStruggleTime, bHoldingBaby, true, 2.f, false, 1.f, true, true);
				Struggle_PlayHandsAnimation(true, false, bHoldingBaby == false, true);
				
				Map_AddTimer("Timer_SetDefaultAnimationSet", 1.f, "OnTimer_SetDefaultAnimationSet");
				
				cLux_GetPlayer().AutomoveCharBodyTo(1.f, 1.f, 1.f, Map_GetEntity("Area_ScareStrugglePlayerPos", eLuxEntityType_Area).GetPosition());
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				SlideDoor_SetClosed("NurseryDoor_*", true, false);
				SlideDoor_SetClosed("NurseryEntranceGrate_Door", true, false);
				
				if (Player_GetHoldingBaby() == false)
					SequenceStates_Stop("Seq_ScareStruggle");
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				if (SequenceStates_IsActive("Seq_DarkWorldLightning") == false)
					OnTimer_DoLightning("Timer_DoLightning");
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				cLux_GetPlayer().StopAutomoveCharBody();
				
				mlBabyCryStage = cMath_Max(mlBabyCryStage, 0);			
				Player_SetBabyTalkInitTime(0.6f);
				
				Map_RemoveTimer("Timer_EncounterBabyCry");
				Map_AddTimer("Timer_EncounterBabyCry", 0.1f, "OnTimer_EncounterBabyCry");
				
				Hint_StopHint();
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayEncounterStartDialogue(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_Play("Dialogue_EncounterStart");
		}
				
		//-------------------------------------------------------
		
		void OnStruggleEnd_Scare()
		{			
			cLux_GetPlayer().StopAutomoveCharBody();
			ResetPlayerMoveSpeed();
			
			if (Player_GetHoldingBaby() == false)
				return;
			
			PlayerBody_SetAnimationSet("baby");
			
			Pregnancy_SetWhispering(true);
			Music_PlayExt("A2_4_3_Baby_Escape.ogg", true, 0.4f, 1.0f, 6.0f, 0.0f, eMusicPrio_SceneAmb, true);
			
			Voice_StopAll();
			Voice_PlayDelayed("Dialogue_EncounterStartBreakFree", 0.1f, -1, "OnVoiceEnd_BreakFree");
									
			Map_AddTimer("Timer_PlayEncounterStartAnim", 0.1f, "OnTimer_PlayEncounterStartAnim");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayEncounterStartAnim(const tString &in asTimer)
		{
			PlayerBody_PlayCutsceneAtEntity("player_tin_hinan_encounter_start", "Area_ScareStrugglePlayerPos", false, 0.3f, "OnAnimEnd_EncounterStart");	
			PlayerBody_SetCutsceneMaxPitch(0.f);
			PlayerBody_SetCutsceneMaxYaw(0.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartTinHinanEncounter(const tString &in asTimer)
		{
			TinHinan_SetPassive("TH_Beam", false);			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_HoldBaby(const tString &in asTimer)
		{
			SetHoldBaby(true);			
		}
		
		//-------------------------------------------------------
		
		void SetHoldBaby(bool abX)
		{
			if (abX)
			{
				PlayerBody_SetArmAnimationPitch(false, false, true);
				PlayerBody_SetArmAnimationYaw(false, false, true);
			
				PlayerBody_SetAnimationSet("baby");
			
				Entity_SetActive("BabyCarried", true);
				//Prop_SetRenderLayer("BabyCarried", 1);	
			
				PlayerBody_AttachProp("BabyCarried", "L_Hand", true);
				
				Player_SetHoldingBaby(true, "BabyCarried");				
				Player_SetAllowHideMode(false);
			}
			else
			{
				PlayerBody_SetAnimationSet("");
				PlayerBody_DetachProp("BabyCarried");
				Player_SetHoldingBaby(false, "BabyCarried");
				Player_SetAllowHideMode(true);
				
				Entity_SetActive("BabyCarried", true);
				//Prop_SetRenderLayer("BabyCarried", 0);
			}			
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_BreakFree(const tString &in asScene, const tString &in asSubject)
		{			
			Hint_StopHint();
			
			Voice_PlayDelayed("Dialogue_TinHinanHearBaby", 1.f);
			
			Map_AddTimer("Timer_ShowSootheBabyHint", 1.f, "OnTimer_ShowSootheBabyHint");			
			Map_AddTimer("Timer_PlayEncounterDialogue", 8.f, "OnTimer_PlayEncounterDialogue");
			Map_AddTimer("Timer_StartTinHinanEncounter", 5.f, "OnTimer_StartTinHinanEncounter");
			
			/////////////
			// Reset covers at start
			VineCover_SetIndependant("Cover_36", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowSootheBabyHint(const tString &in asTimer)
		{
			mbEncounterIntroOver = true;
			
			if (mlBabyCryStage != -1)
			{
				// Make sue hint is shown even if hints are disabled
				iScrHintHandler_Interface@ pHintHandler = cast<iScrHintHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_HintHandler));
				pHintHandler.ForceEnabled(true);
				
				Hint_ShowHint("Hints", "SootheBaby", true, 1.5f, true);
				
				Map_AddTimer("Timer_ResetForcedHints", 10.f, "OnTimer_ResetForcedHints");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetForcedHints(const tString &in asTimer)
		{
			iScrHintHandler_Interface@ pHintHandler = cast<iScrHintHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_HintHandler));
			bool bConfigEnabled = cLux_GetUserConfig().GetBool("Gameplay", "ShowHints", true);
			pHintHandler.ForceEnabled(bConfigEnabled);	
		}

		//-------------------------------------------------------

		//} END Event A *Struggle against giving Tin Hinan the baby*
	 
	//} END SCENE 7 
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 8 *THE PLAYER TAKES THE BABY TO THE NURSERY AND BECOMES A GHOUL*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 8 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 8 here.*/
	 
		//-------------------------------------------------------
		
		//} END General
		
		/////////////////////////////////////////
		// Event A *Leave the BABY*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 8, Event A here.*/
		
		int mlPermaFailSceneCount = 0;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 8, Event A here.*/
		
		//-------------------------------------------------------
		
		bool OnPermaFail_EncounterFailure()
		{
			mlPermaFailId = 1;
			
			StopEncounterBabyCry(true);
			FearHandler_SetPermaFailEnabled(false);
			
			Entity_SetActive("Trigger_PickUpBaby", false);
			Entity_SetActive("Trigger_AllowBabyInteraction", false);
			
			Map_RemoveTimer("Timer_BreakPortalRoomWall");
			
			StopEncounterDialogue();
			
			Sound_Stop("Sound_PortalRoomWall*", 1.f);
			Sound_StopGui("04_03_undercity/ending/quake_loop", 1.f);
			
			Map_RemoveTimer("Timer_BreakThroneRoomCeiling");
			Map_RemoveTimer("Timer_TowerShake");
			
			Voice_StopAll();
			
			Entity_SetActive("TH_Beam", false);
			
			SlideDoor_SetClosed("NurseryDoor_*", false, true);
			SlideDoor_SetClosed("NurseryEntranceGrate_Door", false, true);
			
			StruggleFlashHandler_SetActive(false);
			
			FearHandler_AddPermaFailScene("player_corridor_transition_glimpse_1", "Area_BreastfeedScene", "", "", 3.f, false);
			FearHandler_AddPermaFailScene("player_corridor_transition_glimpse_3", "Area_BreastfeedScene", "", "", 3.f, false);
			//FearHandler_AddPermaFailScene("player_corridor_transition_glimpse_4", "Area_BreastfeedScene_Offset", "", "", 2.5f, false);
			FearHandler_AddPermaFailScene("player_leave_amari_in_crib_ghoulish_start", "Area_BreastfeedScene", "", "", 12.f, false);	

			FearHandler_SetStruggleGradingTextureActive(true);
			
			StruggleFlashHandler_SetProgression(6);
			
			Visibility_SetAreaActive("VisibilityArea_Nursery", true);
			
			// Make sure crib is open
			Entity_PlayAnimation("CribLid", "crib_lid_open", 0.f, false);
			cAnimationState@ pState = Map_GetEntity("CribLid", eLuxEntityType_Prop).GetMeshEntity().GetAnimationStateFromName("crib_lid_open");
			if (pState !is null)
			{
				pState.SetSpeed(0.f);
				pState.SetRelativeTimePosition(1.f);
			}
			
			Lamp_SetLit("CanisterLamp_5", false, false);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnPermaFailSceneStarted()
		{
			++mlPermaFailSceneCount;			
			if (mlPermaFailSceneCount == 3)
				Seq_GhoulEnding("");				
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataGhoulEnding;
		void Seq_GhoulEnding(const tString &in asTimer)
		{
			Sequence_Begin("Seq_GhoulEnding", mSeqDataGhoulEnding);
			Sequence_Wait(0.001f);
			if (Sequence_DoStepAndWait(0.001f))
			{
				Sound_CreateAtEntity("Sound_GhoulCrib", "game_voice/voice/baby/baby_put_down_ghoul", "BabyCarried");
				FearHandler_StopPermaFailScenes();
				
				Effect_ImageTrail_Start(2.f, 0.f, 30.f, 0.f);
				Effect_FOV_Shake_Start(0.05f, 30.f, 0.f, 0.f);
				
				SetHoldBaby(false);
				Entity_PlaceAtEntity("BabyCarried", "Area_BreastfeedScene", 0, true);
				
				Struggle_StartAnimation("Area_BreastfeedScene", "player_leave_amari_in_crib_ghoulish_middle", "", 
										"player_leave_amari_in_crib_ghoulish_start", 
										"player_leave_amari_in_crib_ghoulish_end", 
										false, "", "OnStruggleEnd_LeaveAmari", "OnStruggleEnd_LeaveAmari", 
										"OnStruggleOutroEnd_LeaveAmari", 8.f, false, 0.f, 1.f, false, 0.f);
				Struggle_SetAnimationEntity("BabyCarried", "baby_left_in_crib_ghoulish_middle", 
											"baby_left_in_crib_ghoulish_start", 
											"baby_left_in_crib_ghoulish_end", "", false);
				
				Struggle_SetFlashesActive(false);
				Struggle_SetBlurEffectActive(false);
				Struggle_SetReverseAnimWhenStruggling(false);
				
				Music_Play("A2_4_3_Baby_Lost.ogg", 0.35f, false, eMusicPrio_SceneAmb);
			}
			else if (Sequence_DoStepAndWait(12.f))
			{
				FearHandler_FadeLevelTo(1.f, 1.f, true);
				FearHandler_SetForcedAddFearRate(1.f, 30.f, false);
			}
			else if (Sequence_DoStepAndWait(0.01f))
			{				
				YoungTinHinan_Activate("TH_Ghost_Ending", 1.f, true);
				YoungTinHinan_SetAutoTurnTowardPlayer("TH_Ghost_Ending", false);
				FootPlacement_FadeOut("TH_Ghost_Ending", 0.3f);
				CharMover_SetUseMoveStateAnimations("TH_Ghost_Ending", false);
				
				Voice_SetSource("Tin Hinan", "TH_Ghost_Ending", 10.f, 150.f, true);
			}
			else if (Sequence_DoStepAndWait(2.99f))
			{
				Agent_TeleportFeetToEntity("TH_Ghost_Ending", "Area_BreastfeedScene");
				Entity_PlayAnimation("TH_Ghost_Ending", "tinhinan_look_at_amari_in_crib_ghoulish_end", 0.f, false, false);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Voice_Play("Dialogue_GhoulEnding");	
			}
			else if (Sequence_DoStepAndWait(5.f))
			{
				Sound_CreateAtEntity("Sound_BabyHappy", "04_03_undercity/baby/baby_happy", "BabyCarried");
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{
				FearHandler_SetUsePermaFailTriggerAnimation(false);
				
				FearHandler_TriggerPermaFail(true);
								
				Sound_StopGui("player/UI/permafail/permafail_loop", 1.f);
				Sound_StopGui("player/UI/permafail/permafail_ghoul_breathing", 1.f);
				Sound_StopGui("player/UI/permafail/sequence/corridor_loop", 1.f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnStruggleEnd_LeaveAmari()
		{
			FearHandler_SetStruggleGradingTextureActive(true);
			Player_SetCrossHairEnabled(false);
		}
		
		//-------------------------------------------------------
		
		void OnStruggleOutroEnd_LeaveAmari(const tString &in asAnim)
		{
			Player_ChangeStateToNormal();
			PlayerBody_PlayCutsceneAtEntity("player_leave_amari_in_crib_ghoulish_end", "Area_BreastfeedScene", false, 0.f, "", 0.f, 0.9999f);
			
			FearHandler_FadeLevelTo(1.f, 1.f, true);
			FearHandler_SetForcedAddFearRate(1.f, 20.f, false);
		}
		
		//-------------------------------------------------------
		
		bool OnPermaFail_DarkWorld()
		{
			FearHandler_SetVolumeResetOnCustomPermaFail(false);
			Seq_LoadDarkWorldEnding("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataLoadDarkWorldEnding;
		void Seq_LoadDarkWorldEnding(const tString &in asTimer)
		{
			Sequence_Begin("Seq_LoadDarkWorldEnding", mSeqDataLoadDarkWorldEnding);
			if (Sequence_DoStepAndWait(0.3f))
			{
				PlayerEmotion_SetActive(false);				
				Effect_Fade_Out(0.15f);
				Sound_FadeGlobalVolume(0.0f,3.0f, eSoundEntryType_All);
				
				Effect_FOV_Shake_FadeOut(-1, 0.f);
				Effect_Shake_FadeOut(-1, 0.f);
				Effect_Rumble_Stop(-1);
			}
			else if (Sequence_DoStepAndWait(3.f))
			{	
				Struggle_Stop(false);
				PlayerBody_StopCustomAnimation();
				cLux_GetPlayer().ChangeState(ePlayerState_Null);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				cScript_SetGlobalVarBool("Ending_Destruction", false);
				Map_ChangeMap("04_05_darkworld.hpm", "", "", "", false);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------

		//} END Event A *Leave the BABY*
	 
	//} END SCENE 8 
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 9 *THE PLAYER ESCAPES BACK TO THE THRONE ROOM*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 9 here.*/
		
		int mlBabyCryStage = -1;
		int mlPrevBabyCryStage = -1;
		float mfAlertBeamCount = 5.f;
		
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 9 here.*/
		
		bool OnTrigger_Player_LeaveThroneRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				return true;
				 
			mbPlayerInsideThroneRoom = Entity_PlayerIsInFront(asParent) == false;
			
			if (mbTinHinanEncounterStarted == false)
				return true;
				
			if (mbPlayerInsideThroneRoom)
			{
				ResetEncounterDialogue();
				StopEncounterBabyCry(false);
				
				TinHinan_SetSpotlightRadius("TH_Beam", 80.f);
				TinHinan_SetSpotlightSoundVolumeMul("TH_Beam", 1.f);
				TinHinan_SetSpotlightFeedbackActive("TH_Beam", true);
				
				Music_PlayExt("A2_4_3_Baby_Sneak.ogg", true, 0.4f, 1.0f, 6.0f, 0.0f, eMusicPrio_SceneAmb, true);
				Music_FadeVolumeMul(1.f, 3.f);
			}
			else
			{								
				StopEncounterDialogue(false);
				
				if (mlBabyCryStage < 2)
					StopEncounterBabyCry(true);
				
				TinHinan_SetSpotlightRadius("TH_Beam", 37.5f);
				TinHinan_SetSpotlightSoundVolumeMul("TH_Beam", 0.3f);
				TinHinan_SetSpotlightFeedbackActive("TH_Beam", false);
				
				Music_FadeVolumeMul(0.15f, 3.f);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A *Avoid TIN HINAN'S BEAM*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 9, Event A here.*/
		
		bool mbAllowBabyCry = true;
		bool mbEncounterIntroOver = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 9, Event A here.*/
		
		void OnTimer_EncounterBabyCry(const tString &in asTimer)
		{			
			if ((mbAllowBabyCry == false || Player_GetCurrentStateName() == "State_CheckBaby") && mlBabyCryStage < 1)
			{
				Map_RestartCurrentTimer(cMath_RandRectf(40.f, 45.f));
				return;
			}
			
			if (mlBabyCryStage < 1)
			{
				Baby_SetCryStage("BabyCarried", 1);
								
				Hint_StopHint();
				
				mlBabyCryStage = 1;
				mlPrevBabyCryStage = 0;
				mfAlertBeamCount = 5.f;
				
				Map_RestartCurrentTimer(cMath_RandRectf(3.f, 4.f));
				return;
			}
			else if (mlBabyCryStage == 1)
			{
				Baby_SetCryStage("BabyCarried", 2);
								
				mlBabyCryStage = 2;
				mlPrevBabyCryStage = 1;
				mfAlertBeamCount = 5.f;
				
				Map_RestartCurrentTimer(cMath_RandRectf(1.5f, 2.f));
				return;
			}
			else if (mlBabyCryStage == 2)
			{				
				TinHinan_HearBaby("TH_Beam");
				Map_RestartCurrentTimer(mfAlertBeamCount);
				
				if (mbEncounterIntroOver && 
					mlPrevBabyCryStage == 1 && 
					Map_TimeHasPassed("Timer_HeardBabyDialogue", 15.f) &&
					Struggle_IsActive(true) == false)
				{
					Voice_StopAll();
					Voice_Play("Dialogue_TinHinanHearBaby");
				}
				
				mlPrevBabyCryStage = 2;
				mfAlertBeamCount -= 2.f;
				
				if (mfAlertBeamCount <= 0.5f)
					mfAlertBeamCount = 0.5f;								
				return;
			}
			
			Map_RestartCurrentTimer(cMath_RandRectf(40.f, 45.f));
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_DisallowBabyCry(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbAllowBabyCry = alState == -1;
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayEncounterDialogue(const tString &in asTimer)
		{
			// No dialogue if player is failed!
			if (mlPermaFailId > 0)
				return;
			
			if (Voice_AnySceneIsActive() == false)
			{
				tString sDialogue = "Dialogue_TinHinanStruggle";
				if (mvActiveVitaeValveIds.size() < 2 || Map_TimerExists("Timer_FirstValveAnger"))
					sDialogue = "Dialogue_DestructionStruggle";
					
				Voice_Play(sDialogue, -1, "OnVoiceEnd_TinHinanEncounterBark");
				return;
			}
			
			Map_AddTimer("Timer_PlayEncounterDialogue", cMath_RandRectf(2.f, 5.f), "OnTimer_PlayEncounterDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_TinHinanEncounterBark(const tString &in asScene, const tString &in asSubject)
		{
			ResetEncounterDialogue();
		}
		
		//-------------------------------------------------------
		
		void StopEncounterDialogue(bool abStopVoices = true)
		{
			if (abStopVoices)
				Voice_StopAll();
			
			Map_RemoveTimer("Timer_PlayEncounterDialogue");
		}
		
		//-------------------------------------------------------
		
		void ResetEncounterDialogue()
		{
			Map_RemoveTimer("Timer_PlayEncounterDialogue");
			Map_AddTimer("Timer_PlayEncounterDialogue", cMath_RandRectf(18.f, 27.f), "OnTimer_PlayEncounterDialogue");
		}

		//-------------------------------------------------------

		//} END Event A *Avoid TIN HINAN'S BEAM*
		
		/////////////////////////////////////////
		// Event B *Get caught in TIN HINAN'S BEAM*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 9, Event B here.*/
		
		int mlCaughtInBeamTimeStamp = 0;
		bool mbReachedMaxGhoulProgression = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 9, Event B here.*/
		
		void OnPlayerFound_TinHinan(const tString &in asEntity)
		{
			if (cLux_GetGodModeActivated())
				return;			
			if (GhoulProgression_GetProgression() >= 20) 
				return;
			
			///////////////////////
			// Setup ghoul progression increase
			float fTimeSinceLastCaught = mlCaughtInBeamTimeStamp == 0 ? 10.f : mBaseObj.GetElapsedTime(mlCaughtInBeamTimeStamp);			
			
			float fMaxStruggleTime = 50.f;
			if (fTimeSinceLastCaught < 5.f)			fMaxStruggleTime = 10.f;
			else if (fTimeSinceLastCaught < 10.f)	fMaxStruggleTime = 20.f;
			
			GhoulProgression_SetLimit(20);
			GhoulProgression_SetIncreaseDuringStruggle(true, fMaxStruggleTime);
			
			///////////////////////
			// Handle crying
			StopEncounterBabyCry();
			
			///////////////////////
			// Start struggle!
			if (Struggle_IsActive(true))
				Player_ChangeStateToNormal();
			
			Struggle_StartTinHinan("TH_Beam", "OnBeamStruggle_End", 8.f, true, true, 2.f, true, 1.f, true, true);
			Struggle_PlayHandsAnimation(true, true, false, true);
			Struggle_SetCustomArmAnimOutro("player_beam_w_baby_struggle_end");
			
			Map_AddTimer("Timer_SetDefaultAnimationSet", 1.f, "OnTimer_SetDefaultAnimationSet");
			
			//////////////////////
			// Barks!
			if (Voice_SubjectHasUnplayedLines("Dialogue_TinHinanControlTasi"))
			{
				StopEncounterDialogue(false);
				Map_AddTimer("Timer_PlayStruggleBark", 0.5f, "OnTimer_PlayStruggleBark");
			}
		}
		
		//-------------------------------------------------------
		
		// Hack to fix placement of struggle arm anims (works better with default set than baby)
		void OnTimer_SetDefaultAnimationSet(const tString &in asTimer)
		{
			if (Struggle_IsActive(true))
				PlayerBody_SetAnimationSet("");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayStruggleBark(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_Play("Dialogue_TinHinanControlTasi", -1, "OnVoiceEnd_StruggleBark");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_StruggleBark(const tString &in asScene, const tString &in asSubject)
		{
			ResetEncounterDialogue();
		}
		
		//-------------------------------------------------------
		
		void OnPlayerLost_TinHinan(const tString &in asEntity)
		{
			if (cLux_GetGodModeActivated())
				return;
			if (GhoulProgression_GetProgression() >= 20) 
				return;
				
			Struggle_Stop(true);			
		}
		
		//-------------------------------------------------------
		
		void OnStruggleAnimEnd()
		{
			Map_AddTimer("Timer_HoldBaby", 0.1f, "OnTimer_HoldBaby");
		}
		
		//-------------------------------------------------------
		
		void OnGhoulProgressionIncreased(int alProgression)
		{
			if (alProgression < 20 || mbReachedMaxGhoulProgression)
				return;
			
			mbReachedMaxGhoulProgression = true;
			
			FearHandler_SetPermaFailEnabled(true);
			FearHandler_SetPermaFailStruggleEnabled(false);
			FearHandler_TriggerPermaFail(true);
			
			FearHandler_SetWhispersActive(false);
			FearHandler_SetWhispersDecreaseSpeed(0.5f);
			
			Struggle_Stop(false);
			Player_ChangeStateToNormal();
		}
		
		//-------------------------------------------------------
		
		void OnBeamStruggle_End()
		{
			Map_RemoveTimer("Timer_SetDefaultAnimationSet");
			PlayerBody_SetAnimationSet("baby");
			
			ResetPlayerMoveSpeed();			
			mlCaughtInBeamTimeStamp = mBaseObj.GetTimeStamp();
			
			if (GhoulProgression_GetProgression() < 20)
			{
				Voice_PlayWhenPossible("Dialogue_GhoulProgressionIncrease", "", 30.f, 0.1f);
				
				TinHinan_SetSpotlightOn("TH_Beam", false, false, 0.f);
				Map_AddTimer("Timer_ResetBeamAfterStruggle", 6.f, "OnTimer_ResetBeamAfterStruggle");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetBeamAfterStruggle(const tString &in asTimer)
		{
			TinHinan_SetSpotlightOn("TH_Beam", true, false, 0.f);
		}
		
		//-------------------------------------------------------
		
		void OnPlayerRunning_TinHinan(int alStage)
		{
			if (mlBabyCryStage != -1 ||
				Player_GetHoldingBaby() == false ||
				mbPlayerInsideThroneRoom == false)
				return;
			
			if (alStage == 1)
			{				
				Baby_SetCryStage("BabyCarried", 0);				
				Map_AddTimer("Timer_ResetPlayerRunning", 0.1f, "OnTimer_ResetPlayerRunning");
			}				
			else if (alStage == 2)
			{				
				Map_RemoveTimer("Timer_ResetPlayerRunning");
				Map_RemoveTimer("Timer_EncounterBabyCry");
				
				Map_AddTimer("Timer_EncounterBabyCry", 0.1f, "OnTimer_EncounterBabyCry");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetPlayerRunning(const tString &in asTimer)
		{
			if (Player_GetRunning())
			{
				Map_RestartCurrentTimer();
				return;
			}
			
			if (mlBabyCryStage == -1)
				Baby_SetCryStage("BabyCarried", -1);
		}

		//-------------------------------------------------------

		//} END Event B *Get caught in TIN HINAN'S BEAM*
		
		/////////////////////////////////////////
		// Event C *Pick up the THRONE ORB*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 9, Event C here.*/
		
		bool mbAltarActive = false;
		bool mbPlayerInsideThroneRoom = true;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 9, Event C here.*/
		
		void OnInteract_PickUpOrbThrone(const tString &in asEntity)
		{
			Item_AddToInventory("Orb");
			PlaceThroneOrb(false);
		}
		
		//-------------------------------------------------------
		
		void PlaceThroneOrb(bool abX)
		{
			Entity_SetActive("Orb", abX);
			Entity_SetActive("InteractArea_PlaceOrb_2", abX == false);
			
			Entity_SetEffectsActive("Orb", abX == false, false);
			Entity_SetEffectsActive("Orb", abX, true);
			
			Map_GetEntity("Orb").GetMeshEntity().SetVisible(abX);					 
			Map_GetEntity("Orb").GetMeshEntity().SetIlluminationColor(cColor(1.f) * (abX ? 1.f : 0.1f));
			
			Light_FadeBrightnessTo("Light_Point_Orb_ThroneRoom", abX ? 10.f : 0.f, 0.5f);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_PlayForgotOrbDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbTinHinanEncounterStarted == false)
				return true;
			
			if (ItemType_GetCountInInventory("VitaeCanister") == 0)
				Voice_PlayWhenPossible("Dialogue_ForgotVitae", "", 30.f, 1.f);
			
			return false;
		}
		
		//-------------------------------------------------------

		//} END Event C *Pick up the THRONE ORB*
	 
	//} END SCENE 9

	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 10 *THE PLAYER ESCAPES THROUGH THE PORTAL*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 10 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 10 here.*/
		
		void UpdatePortalRoomWallLight(float afDeltaTime)
		{
			if (mbPortalRoomDoorsOpen == false)
				return;
			
			///////////////////
			// Move the Throne Room light so it looks less weird when getting close to it
			iLuxEntity@ pEnt = Map_GetEntity("WallLight_ThroneRoom", eLuxEntityType_Prop);
			cVector3f vStartPos = pEnt.GetOnLoadTransform().GetTranslation();
			
			float fDist = cMath_Abs(vStartPos.z - cLux_GetPlayer().GetCharacterBody().GetFeetPosition().z);
			float fAdd = 20.f - cMath_Min(fDist, 20.f);
			pEnt.SetPosition(vStartPos - cVector3f(0.f, 0.f, fAdd));
		}
	 
		//-------------------------------------------------------
		
		//} END General
		
		/////////////////////////////////////////
		// Event A *The entrance to the Portal Room breaks*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 10, Event A here.*/
		
		bool mbBreakPortalRoomWall = false;
		bool mbPortalRoomDoorsOpen = false;
		tString msPortalRoomWallTarget = "";
		tString msPrevPortalRoomWallTarget = "";
		array<int> mvWallBreakSequenceIds = 		{ 1, 	 6,     8, 	  5, 	4,    7, 	 2, 	7, 	   3, 	  2, 	 6,    3, 	 4,    2 };
		array<bool> mvWallBreakSequenceFlags = 		{ false, false, true, true, false, false, false, true, false, false, true, true, true, true};
		array<float> mvWallBreakSequenceDelays = 	{ 4.0f,  3.5f, 4.5f, 4.0f,  2.5f, 3.0f,  2.0f,  3.5f,  3.5f,  4.0f,  2.0f, 3.5f, 4.0f, 4.5f};

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 10, Event A here.*/	
		
		bool OnTrigger_Player_SetupPortalEndRoots(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (ItemType_GetCountInInventory("VitaeCanister") <= 0)
				return true;
			
			array<iLuxEntity@> vOut;
			Map_GetEntityArray("PortalRoomEndRoot_*", vOut);
			for (int i = 0; i < vOut.size(); ++i)
			{
				iLuxEntity@ pEnt = vOut[i];
				cAnimationState@ pState = pEnt.GetMeshEntity().GetAnimationStateFromName("open");
				
				pEnt.SetActive(true);
				pState.FadeIn(0.f);
				pState.SetLoop(false);
				pState.SetRelativeTimePosition(0.85f);
				pState.SetSpeed(0.f);
				
				pEnt.GetMeshEntity().SetVariableAnimationUpdate(true);
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartSeqBreakPortalWalls(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (ItemType_GetCountInInventory("VitaeCanister") <= 0)
				return true;
			
			////////////////
			// Setup event
			Entity_SetActive("Trigger_ForcePortalRoomDoorBreak_*", true);
			Entity_SetActive("Trigger_OpenPortalRoomDoor_*", false);
			
			StopEncounterDialogue();
			StruggleFlashHandler_SetProgression(5);
			
			Seq_BreakPortalRoomWalls("");
			Map_AddTimer("Timer_PlayPortalDialogue", 2.f, "OnTimer_PlayPortalDialogue");
			
			////////////////
			// Setup ghost
			YoungTinHinan_Activate("TH_Ghost_Portal", 1.f, false);
			Sound_CreateAtEntity("Sound_GhostAppear", "creatures/foley/creature/tin_hinan/appear", "TH_Ghost_Portal", 0.f, false, 1.f, 10.f, 50.f);
			
			Map_AddTimer("Timer_FadeOutPortalGhost", 6.5f, "OnTimer_FadeOutPortalGhost");
			
			Voice_SetSource("Tin Hinan", "TH_Ghost_Portal", 10.f, 150.f, true);
			
			Player_FadeRunSpeedMulTo(0.f, 0.5f);
			
			////////////////
			// Roots!
			Map_AddTimer("Timer_StartPortalEndRoots", 7.f, "OnTimer_StartPortalEndRoots");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartPortalEndRoots(const tString &in asTimer)
		{
			FadePortalEndRootSpeed(0.05f, 0.075f, 0.1f, 0.1f, true, true);
		}
		
		//-------------------------------------------------------
		
		void FadePortalEndRootSpeed(float afMin, float afMax, float afFadeMin, float afFadeMax, bool abPlaySound, bool abSpurts)
		{
			array<iLuxEntity@> vOut;
			Map_GetEntityArray("PortalRoomEndRoot_*", vOut);
			
			for (int i = 0; i < vOut.size(); ++i)
			{
				iLuxEntity@ pEnt = vOut[i];
				cAnimationState@ pState = pEnt.GetMeshEntity().GetAnimationStateFromName("open");
					
				pState.FadeSpeed(cMath_RandRectf(afMin, afMax), cMath_RandRectf(afFadeMin, afFadeMax));
				
				if (i % 2 == 0)
				{
					if (abSpurts)
					{
						Map_RemoveTimer(pEnt.GetName());
						Map_AddTimer(pEnt.GetName(), 0.f, "OnTimer_FadeEndRootAnimSpeed");
					}
					
					if (abPlaySound)
						pEnt.PlaySound("Sound_" + pEnt.GetName(), "04_03_undercity/roots/root_movement", true, false, 3.f, 20.f);
				}
			}
		}
				
		//-------------------------------------------------------
		
		void OnTimer_FadeEndRootAnimSpeed(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asTimer, eLuxEntityType_Prop);
			if (pEnt !is null)
			{
				cAnimationState@ pState = pEnt.GetMeshEntity().GetAnimationStateFromName("open");
				int lCount = pEnt.GetVarInt("GrowthCount");
				
				bool bFast = lCount % 2 == 0;
				float fSpeed = bFast ? cMath_RandRectf(0.125f, 0.15f) : cMath_RandRectf(0.05f, 0.075f);
				float fTime = cMath_RandRectf(0.5f, 1.f);
				
				if (lCount == 0)
				{
					fSpeed = cMath_RandRectf(0.3f, 0.4f);
					fTime = cMath_RandRectf(2.f, 2.5f);
				}
				
				pEnt.SetVarInt("GrowthCount", lCount + 1);				
				pState.FadeSpeed(fSpeed, fTime);
				
				Map_AddTimer(pEnt.GetName(), fTime * 2.f, "OnTimer_FadeEndRootAnimSpeed");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayPortalDialogue(const tString &in asTimer)
		{
			Voice_PlayWhenPossible("Dialogue_THPortal");
			
			if (Voice_SubjectHasUnplayedLines("Dialogue_THPortal"))
				Map_AddTimer("Timer_PlayPortalDialogue", 10.f, "OnTimer_PlayPortalDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeOutPortalGhost(const tString &in asTimer)
		{
			YoungTinHinan_Deactivate("TH_Ghost_Portal", 1.f);
			ResetPlayerMoveSpeed(true);
			
			Voice_SetSource("Tin Hinan", "TH_Beam", 10.f, 150.f, true);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_ForcePortalRoomDoorBreak(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbPortalRoomDoorsOpen)
				return false;
			
			if (alState == -1 && Entity_PlayerIsInFront(asParent) == false)
			{
				mvWallBreakSequenceIds[0] = 8;
				mvWallBreakSequenceFlags[0] = true;
				mvWallBreakSequenceDelays[0] = 4.f;
				
				Entity_SetActive("Trigger_ForcePortalRoomDoorBreak_*", false);
				return false;
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataBreakPortalRoomWalls;
		void Seq_BreakPortalRoomWalls(const tString &in asTImer)
		{
			Sequence_Begin("Seq_BreakPortalRoomWalls", mSeqDataBreakPortalRoomWalls);
			Sequence_Wait(6.f);
			if (Sequence_DoStepAndWait(1.f))
			{			
				GhoulProgression_SetLimit(20);
				GhoulProgression_SetIncreaseDuringStruggle(true, 20.f);
				
				TinHinan_SetPassive("TH_Beam", true);
				TinHinan_SetSpotlightColor("TH_Beam", "alert");
				
				Map_AddTimer("Timer_WallBreakSequence", 0.1f, "OnTimer_WallBreakSequence");
				Map_AddTimer("Timer_CheckPlayerInWallBreakBeam", 0.5f, "OnTimer_CheckPlayerInWallBreakBeam");
				
				Entity_SetActive("WallLight_Spot", true);
				Entity_SetActive("WallLight_Moving", true);
				
				Light_FadeBrightnessTo("Light_PortalRoomBreak", 15.f, 0.4f, eEasing_SineIn);
				//Sound_PlayGui("04_03_undercity/ending/quake_loop", 1.f, eSoundEntryType_GuiWorld);
				
				Effect_Shake_Start(0.005f, 60.f, 0.2f, 0.2f);
				Effect_Rumble_Start(0.05f, 60.f, 0.25f, 0.25f);
				
				Music_FadeVolumeMul(1.f, 3.f);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Light_FadeBrightnessTo("Light_PortalRoomBreak", 0.f, 0.6f, eEasing_SineOut);
				Sound_PlayGui("04_03_undercity/ending/quake_loop", 1.f, eSoundEntryType_GuiWorld);
				
				Music_PlayExt("A2_4_3_Portal_Open.ogg", false, 0.7f, 1.0f, 3.0f, 1.0f, eMusicPrio_BigEvent, false);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_WallBreakSequence(const tString &in asTimer)
		{
			tString sTarget = "";
			bool bBreak = false;
			bool bForced = false;
			bool bPlayerByThroneRoomEntrance = Entity_GetCollide("Area_ThroneRoomEntrance", "player");		
			
			////////////////
			// Stay put if player is struggling
			if (Struggle_IsActive(true))
			{
				Map_RestartCurrentTimer();
				return;
			}
			/////////////////
			// Look for player at the door!
			else if (mbPortalRoomDoorsOpen &&
					 Entity_GetCollide("Player", "Area_PortalArea") == false &&
					 (bPlayerByThroneRoomEntrance || Map_TimerExists("Timer_DisallowBeamAtCorridor") == false))
			{
				sTarget = "PortalRoomWall_8";
				Map_RemoveTimer("Timer_DisallowBeamAtCorridor");
				Map_AddTimer("Timer_DisallowBeamAtCorridor", cMath_RandRectf(9.f, 12.f), "");
			}
			/////////////////
			// Player by the portal, continue break sequence!
			else if (mvWallBreakSequenceIds.size() > 0)
			{
				sTarget = "PortalRoomWall_" + mvWallBreakSequenceIds[0];
				bBreak = mvWallBreakSequenceFlags[0];
				
				mvWallBreakSequenceIds.pop_front();
				mvWallBreakSequenceFlags.pop_front();
			}
			/////////////////
			// All walls broken, look for player at the portal!
			else
			{
				sTarget = "PortalRoomWall_2";
			}
			
			BreakPortalRoomWall(sTarget, bBreak);
		}
		
		//-------------------------------------------------------
		
		void BreakPortalRoomWall(const tString &in asWall, bool abBreak = false)
		{	
			if (mlPermaFailId > 0)
				return;
			
			/////////////////
			// Set up vars
			int lId = cString_GetNumericSuffixInt(asWall);
			tString sLookTarget = "Area_WallLight_" + lId;
			
			msPortalRoomWallTarget = asWall;
			mbBreakPortalRoomWall = abBreak;

			/////////////////
			// Look at the target!
			if (msPortalRoomWallTarget != cString_Sub(msPrevPortalRoomWallTarget, 0, 16))
			{
				Entity_SetEffectsActive("WallLight_Spot", false, true);
				Entity_SetEffectsActive("WallLight_Moving", false, true);
				Entity_SetEffectsActive("WallLight_ThroneRoom", false, true);
			}
			
			Prop_MoveLinearTo("WallLight_Moving", sLookTarget, 10.f, 20.f, 3.f, true, "OnMoveLinear_WallLight");
			TinHinan_TurnSpotlightToPos("TH_Beam", Map_GetEntity(sLookTarget).GetPosition(), true, true, 1.f);
			
			//////////////////
			// Specifics
			if (lId == 8 && mbBreakPortalRoomWall && mbPortalRoomDoorsOpen == false)
			{
				mbPortalRoomDoorsOpen = true;
				Entity_SetActive("DoorBlockerRoot_*", true);
				Entity_SetActive("BlockBox_DoorBlockerRoot", true);
				SlideDoor_SetClosed("PortalRoomDoor_2_*", false, true);
			}
		}
		
		//-------------------------------------------------------
		
		void OnBreak_PortalRoomWall(const tString &in asEntity)
		{
			/////////////////
			// Freeze pieces - just want cracks
			Prop_SetStaticPhysics(asEntity + "_broken", true);
			
			/////////////////
			// Specifics
			if (cString_GetNumericSuffixInt(asEntity) == 8)
				Entity_SetActive(asEntity + "_broken", false);
		}
				
		//-------------------------------------------------------
		
		void OnMoveLinear_WallLight(const tString &in asPropName)
		{
			//////////////////////
			// Break the wall!
			if (Entity_Exists(msPortalRoomWallTarget))
				Prop_SetHealth(msPortalRoomWallTarget, 0.f);
				
			Map_AddTimer("Timer_BreakPortalRoomWall", 0.1f, "OnTimer_BreakPortalRoomWall");
		}

		//-------------------------------------------------------
		
		void OnTimer_BreakPortalRoomWall(const tString &in asTimer)
		{
			//////////////////////
			// Set up vars
			int lId = cString_GetNumericSuffixInt(msPortalRoomWallTarget);			
			tString sWall = msPortalRoomWallTarget + "_broken";
			tString sSpotTarget = sWall;			
			iLuxEntity@ pWall = Map_GetEntity(sWall, eLuxEntityType_Prop);
			
			if (mbPortalActivated)
				mbBreakPortalRoomWall = false;
			
			bool bFlareActive = true;
			bool bBreakWall = mbBreakPortalRoomWall;
			mbBreakPortalRoomWall = false;
						
			///////////////////////
			// Specifics
			if (lId == 8)
			{
				sSpotTarget = "Area_WallLight_8";
				bFlareActive = false;
				
				SlideDoor_SetClosed("PortalRoomDoor_*", false);
				Entity_SetActive("WallLight_ThroneRoom", true);
				Entity_SetEffectsActive("WallLight_ThroneRoom", false, false);
				Entity_SetEffectsActive("WallLight_ThroneRoom", true, true);
			}
			
			//////////////////////
			// Enable physics!	
			if (bBreakWall)
			{		
				/////////////////
				// Root grows out of wall
				iLuxEntity@ pRoot = Map_GetEntity("PortalRoomWallRoot_" + lId, eLuxEntityType_Prop);
				if (pRoot !is null)
				{
					cAnimationState@ pState = pRoot.GetCurrentAnimationState();
					pRoot.SetActive(true);
					pState.SetRelativeTimePosition(1.f);
					pState.SetLoop(false);
				}
				
				/////////////////
				// Wall breaks
				Prop_SetStaticPhysics(pWall.GetName(), false);
				
				for (int i = 0; i < pWall.GetBodyNum(); ++i)
				{
					iPhysicsBody@ pBody = pWall.GetBody(i);
					if (pBody.GetMass() > 0.f)
					{
						pBody.AddImpulse(cVector3f(0.f, cMath_RandRectf(-3.f, 3.f), cMath_RandRectf(3.f, 5.f)));
						pBody.AddTorque(cMath_RandomSphereSurfacePoint(70.f));
						
						// First wall breaks over the stairs, so let that collide
						if (i != 0)
							pBody.SetCollide(false);
					}
				}
				
				ParticleSystem_CreateAtEntity("PS_WallBreak" + sWall, "dust_medium_extra_long_oneshot.ps", sWall, false);
			}
			
			//////////////////////
			// Place spot if wall is broken!
			iLuxEntity@ pSpotEnt = Map_GetEntity("WallLight_Spot", eLuxEntityType_Prop);
			iLuxEntity@ pBillboardEnt = Map_GetEntity("WallLight_Moving", eLuxEntityType_Prop);
			
			if (pWall !is null)
			{
				cLightSpot@ pSpot = cast<cLightSpot>(pSpotEnt.GetLightFromName("Light_Spot_1"));
				
				pSpotEnt.SetPosition(pWall.GetOnLoadTransform().GetTranslation());
				Entity_LookAtDirection("WallLight_Spot", Map_GetEntity("Area_WallLight_" + lId).GetMatrix().GetTranspose().GetForward());
				
				float fRadius = cLux_ToProp(pWall).GetStaticPhysics() == false ? 70.f : 30.f;
				pSpot.SetRadius(fRadius);
			}
			
			//////////////////////
			// Visual effects		
			if (Entity_GetEffectsActive("WallLight_Moving") == false && lId != 8)
				Entity_SetEffectsActive("WallLight_Moving", true, true);
			if (Entity_GetEffectsActive("WallLight_Spot") == false)
				Entity_SetEffectsActive("WallLight_Spot", true, true);
				
			pSpotEnt.GetLensFlareFromName("LensFlare_1").SetVisible(bFlareActive);
			
			cVector2f vBillboardSize = cVector2f(15.f, 15.f);
			
			if (lId == 4)			vBillboardSize = cVector2f(13.f, 13.f);
			else if (lId == 3)		vBillboardSize = cVector2f(9.f, 9.f);
				
			pBillboardEnt.GetBillboardFromName("Billboard_1").SetSize(vBillboardSize);
				
			if (msPrevPortalRoomWallTarget != sWall)
			{
				Effect_Shake_Start(0.04f, 1.f, 0.1f, 0.4f);
				
				if (lId != 8)
				{
					tString sDebrisPS = bBreakWall ? "debris_portal_room_wall.ps" : "debris_portal_room_wall_small.ps";
					ParticleSystem_CreateAtEntity("PS_WallDebris" + sWall, sDebrisPS, sWall, false);
				}
			}
			
			//////////////////////
			// Ceiling debris
			array<iLuxEntity@> vOut;
			Map_GetEntityArray("Area_PortalCeilingDebris_*", vOut, eLuxEntityType_Area);
			
			int lAreaCount = cMath_RandRectl(15, 25);			
			for (int i = 0; i < lAreaCount; ++i)
			{
				int lId = cMath_RandRectl(0, vOut.size() - 1);
				iLuxEntity@ pEnt = vOut[lId];
				vOut.removeAt(lId);
				
				Map_AddTimer(pEnt.GetName(), i * cMath_RandRectf(0.3f, 0.6f), "OnTimer_BreakPortalRoomCeilingDebris");
			}
			
			//////////////////////
			// Sound effects
			if (msPrevPortalRoomWallTarget != sWall)
			{
				tString sSound = lId % 2 == 0 ? "04_03_undercity/ending/rock_impacts" : 
												"04_03_undercity/ending/rock_impacts";
				Sound_CreateAtEntity("Sound_" + msPortalRoomWallTarget + "_Break", sSound, sWall);
				
				// TODO: remove when we get proper sounds
				cSoundEntity@ pBreakSound = mBaseObj.GetWorld().GetSoundEntity("Sound_" + msPortalRoomWallTarget + "_Break");
				if (pBreakSound !is null)
				{
					pBreakSound.SetUseCustomProperties(true);
					pBreakSound.SetCustomMinDistance(100.f);
					pBreakSound.SetCustomMaxDistance(200.f);
				}
			}
			
			msPrevPortalRoomWallTarget = sWall;
			
			///////////////////////
			// Continue the sequence if the player isn't caught in the beam!
			float fTime = 1.f;			
			if (mvWallBreakSequenceDelays.size() > 0 && Struggle_IsActive(true) == false)
			{
				fTime = mvWallBreakSequenceDelays[0];
				mvWallBreakSequenceDelays.pop_front();
			}		
			
			Map_AddTimer("Timer_WallBreakSequence", fTime, "OnTimer_WallBreakSequence");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckPlayerInWallBreakBeam(const tString &in asTimer)
		{
			if (mbReachedMaxGhoulProgression)
				return;		
			
			/////////////////
			// Setup vars
			iLuxEntity@ pEnt = Map_GetEntity("WallLight_Spot", eLuxEntityType_Prop);
			cLightSpot@ pSpot = cast<cLightSpot>(pEnt.GetLightFromName("Light_Spot_1"));
			cVector3f vCamPos = Player_GetCameraPosition();
			
			/////////////////
			// Check again if player isn't struggling
			if (Struggle_IsActive(true) == false)
				Map_AddTimer("Timer_CheckPlayerInWallBreakBeam", 0.5f, "OnTimer_CheckPlayerInWallBreakBeam");
			
			/////////////////
			// Struggle conditions
			if (cLux_GetGodModeActivated() ||
				mbPortalActivated ||
				Map_GetProp("WallLight_Moving").IsMoving() ||
				Map_GetEntity("WallLight_Spot").GetEffectsActive() == false)
				return;
			
			// Only allow struggline when at the door, or if the final wall crack has been opened
			int lPosId = cString_GetNumericSuffixInt(msPortalRoomWallTarget);
			if (lPosId != 2 && lPosId != 8)
				return;
				
			/////////////////
			// Player in Los?
			if (pSpot.GetFrustum().CollidePoint(vCamPos) == false)
				return;
			if (cLux_CheckLineOfSight(pEnt.GetPosition(), vCamPos, false, false) == false)
				return;
			
			cVector3f vLightPos = pSpot.GetWorldPosition();
			cMatrixf mtxLightTranspose = pSpot.GetWorldMatrix().GetTranspose();
	
			cVector3f vPointDir = cMath_Vector3Normalize(vCamPos - vLightPos);
			cVector3f vPosDirV = cMath_Vector3ProjectOnPlane(vPointDir, mtxLightTranspose.GetRight());
			cVector3f vPosDirH = cMath_Vector3ProjectOnPlane(vPointDir, mtxLightTranspose.GetUp());
			float fVAngle = cMath_Vector3Angle(cVector3f_Zero - mtxLightTranspose.GetForward(), cMath_Vector3Normalize(vPosDirV));
			float fHAngle = cMath_Vector3Angle(cVector3f_Zero - mtxLightTranspose.GetForward(), cMath_Vector3Normalize(vPosDirH));
			float fFov = cMath_ToDeg(pSpot.GetFOV());
			
			/////////////////
			// In beam?
			if (fVAngle <= cMath_ToRad(fFov + 2.f) * 0.5f && 
				fHAngle <= cMath_ToRad((fFov + 2.f) * pSpot.GetAspect()) * 0.5f)
			{
				float fTime = 8.f;
				bool bWinnable = true;
				
				if (mvWallBreakSequenceIds.size() == 0)
				{
					bWinnable = false;
					fTime = 10.f;
					GhoulProgression_SetIncreaseDuringStruggle(true, 8.f);
				}
				
				Struggle_StartTinHinan("TH_Beam", "OnPortalRoomStruggle_End", fTime, bWinnable, true, 2.f, false, 1.f, true, true);
				Struggle_PlayHandsAnimation(true, true, false, true);
								
				Map_RemoveTimer("Timer_CheckPlayerInWallBreakBeam");
			}
		}
		
		//-------------------------------------------------------
		
		void OnPortalRoomStruggle_End()
		{
			ResetPlayerMoveSpeed();
			
			Map_RemoveTimer("Timer_DisallowBeamAtCorridor");
			Map_AddTimer("Timer_DisallowBeamAtCorridor", cMath_RandRectf(9.f, 12.f), "");
			
			Map_AddTimer("Timer_CheckPlayerInWallBreakBeam", 6.5f, "OnTimer_CheckPlayerInWallBreakBeam");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakPortalRoomCeilingDebris(const tString &in asTimer)
		{
			cLuxArea@ pArea = cLux_ToArea(Map_GetEntity(asTimer, eLuxEntityType_Area));
			tString sArea = pArea.GetName();
			
			bool bClose = (Player_GetCameraPosition() - pArea.GetPosition()).SqrLength() < 30.f * 30.f;
			tString sPS = bClose ? "debris_falling_portal_room.ps" : "debris_falling_portal_room_large.ps";
			ParticleSystem_CreateAtEntity("PS_Debris_" + asTimer, sPS, asTimer, false);
		}
		
		//-------------------------------------------------------

		//} END Event A *The entrance to the Portal Room breaks*
	 
		/////////////////////////////////////////
		// Event B *Activate the PORTAL*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 10, Event B here.*/
		
		bool mbPlacedOrb = false;
		bool mbPortalActivated = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 10, Event B here.*/
		
		 bool CanUse_Orb(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
         {
			 return asPickedEntity == "InteractArea_PlaceOrb_1" || asPickedEntity == "InteractArea_PlaceOrb_2";
         }
         
         //-------------------------------------------------------
         
         bool OnUse_Orb(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, 
					    const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
         {
			 Item_Unequip(asItemID);
			 Item_RemoveFromInventory(asItemID);
			 
			 if (asTargetEntity == "InteractArea_PlaceOrb_1")
				 PlacePortalOrb(true);
			 else
				PlaceThroneOrb(true);
				
             return true;
         }
		
		 //-------------------------------------------------------
		
		 void OnInteract_PickUpOrbPortal(const tString &in asEntity)
		 {
			 Item_AddToInventory("Orb");
			 PlacePortalOrb(false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void PlacePortalOrb(bool abX)
		 {
			 mbPlacedOrb = abX;
			  
			 Lamp_SetLit("VitaePipe_*", true, true);
			 Entity_SetActive("Portal", abX);
			
			 if (abX)
			 {
				 Sound_CreateAtEntity("Sound_PortalPowerUp", "03_03_herberts_hq/orb_activate/orb_activate_power_up", "Portal");
				 Sound_PlayGui("03_04_pillar_room/pillar_activate/pillar_energy_burst", 1.f, eSoundEntryType_GuiWorld);
			 }
			 else
			 {				 
				 Sound_Stop("Sound_PortalPowerUp", 0.5f);
			 }
			 
			 mfPortalDestinationStrength = abX ? 2.f : 1.f;
			 SetCurrentPortalDestinationActive(true);
		 }
		
		//-------------------------------------------------------
		
		void ActivatePortal(bool abActivate)
		{
			if (abActivate && mbPlacedOrb && mbPortalActivated == false)
			{
				mbPortalActivated = true;
				Sketchbook_CompleteIdea("activate_portal");
				Sketchbook_CompleteIdea("meet_tinhinan");
				Seq_EnlargePortal("");
				Entity_SetInteractionDisabled("VitaeCanister_4", true);
				return;
			}
			 
			if (abActivate == false) 
				return;

			Map_RemoveTimer("Timer_GivePortalFeedback");
			Map_AddTimer("Timer_GivePortalFeedback", 0.5f, "OnTimer_GivePortalFeedback");
		 }
         
         //-------------------------------------------------------
         
         cSequenceStatesData mSequenceEnlargePortalData;
         void Seq_EnlargePortal(const tString &in asTimer)
         {
             Sequence_Begin("Seq_EnlargePortal", mSequenceEnlargePortalData);
			 if (Sequence_DoStepAndWait(1.f))
			 {
				 // Preload Paris
				 Map_Preload("04_04_paris.hpm");
				 
				 Map_RemoveTimer("Timer_PlayPortalDialogue");
				 
				 Sound_CreateAtEntity("Sound_AlterOrbExpand", "03_03_herberts_hq/alter_open/alter_portal_open", "Portal");
				 
				 StopEncounterBabyCry(true);
				 
				 Rift_SetForceOpen("Portal", true);
				 Rift_SetOpenSpeed("Portal", 0.1f);
				 
				 Prop_SetActiveAndFade("Portal_Cubemap", true, 5.f);
				 
				 Entity_SetInteractionDisabled("Portal_Button", true);
				 				 
				 Player_FadeMoveSpeedMulTo(0.1f, 0.f);
				 Player_FadeLookSpeedMulTo(0.6f, 5.f);
				
				 Sound_PlayGui("03_03_herberts_hq/beam_filter/beam_filter_correct", 1.0f);
				 Sound_PlayGui("03_03_herberts_hq/orb_activate/orb_activate_debris", 1.0f);
				 Sound_PlayGui("03_03_herberts_hq/alter_open/alter_open_quake", 1.0f);
				 
				 //////////////////
				 // Make sure paris is shown
				 Map_RemoveTimer("Timer_PortalDestinationFlicker");
				 
				 mbAllowPortalDestinationFlicker = false;
				 SetCurrentPortalDestinationActive(false, 0.15f);
				 msPortalDestination = "Portal_Destination_Paris";
				 SetCurrentPortalDestinationActive(true, 5.f, 2.5f);
				 
				 //////////////////
				 // Faster roots!
				 FadePortalEndRootSpeed(0.1f, 0.15f, 2.f, 4.f, false, false);
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				 SetPortalButtonActive(false);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
             {				
				 Sound_CreateAtEntity("Sound_PortalStartScream", "03_03_herberts_hq/alter_open/alter_shadow_scream", "player");
				 
				 SetWaterOrbActive(true);
				 
                 Effect_ImageTrail_Start(0.4f, 0.5f, 5.f, 0.f);
                 //Effect_Sway_FadeIn(0.25f, 10.f, 2.f, -2.5f, 1.f, 0.25f, 0.995f, 0.f);
				 
				 Player_FadeMoveSpeedMulTo(0.1f, 1.f);
				 Player_FadeLookSpeedMulTo(0.2f, 1.f);
             }
             else if (Sequence_DoStepAndWait(0.5f))
             {                 					 
				 Light_FadeTo("Light_Portal", cColor(0.511,0.822,0.782,1) * 0.4f, 10.f, 5.f);
			 
                 Effect_Shake_Start(0.025f, 5.f, 0.5f, 0.f);
                 Effect_ImageTrail_Start(0.6f, 0.5f, 5.f, 0.f);
             }
			 else if (Sequence_DoStepAndWait(1.f))
             {
                 Player_StartLookAt("Orb_Pedestal", 0.125f, 1.f, 5.f);
				 
				 Player_ChangeStateToNormal();
				 Player_SetAllowCheckBaby(false);
             }
             else if (Sequence_DoStepAndWait(2.5f))
             {				 
				 Effect_Shake_Start(0.025f, 5.f, 0.5f, 0.f);
                 Effect_ImageTrail_Start(0.6f, 0.5f, 5.f, 0.f);
				 
				 FearHandler_SetForcedAddFearRate(0.8f, 10.f, false, -1.f, 0.1f);
             }
             else if (Sequence_DoStepAndWait(2.3f))
             {				                  
				 Effect_Shake_Start(0.03f, 5.f, 0.5f, 0.f);
                 Effect_ImageTrail_Start(1.5f, 0.5f, 5.f, 0.f);
             }
             else if (Sequence_DoStepAndWait(2.f))
             {
				 Voice_PlayWhenPossible("Dialogue_THGoThroughPortal");
				 
                 Effect_Shake_Start(0.09f, 1.f, 0.5f, 1.f);
                 Effect_ImageTrail_Start(1.5f, 0.5f, 4.f, 0.f);
				 
				 Map_RemoveTimer("Timer_UpdateTHPortal");
				 YoungTinHinan_Deactivate("TH_Ghost_Portal", 1.f);
             }
             else if (Sequence_DoStepAndWait(1.5f))
             {				 
				 Effect_Shake_Start(0.12f, 2.f, 1.f, 0.5f);
				 Effect_ImageTrail_Start(1.5f, 0.5f, 2.f, 0.f);                 			 				 

				 Sound_CreateAtEntity("SoundOrbActivatedScreams", "03_03_herberts_hq/orb_activate/orb_activated_energy_scream", "player");
				 Sound_Stop("SoundOrbDebris", 0.5f);
			 }
			 else if (Sequence_DoStepAndWait(0.7f))
			 {
				 Sound_StopGui("04_03_undercity/ending/quake_loop", 1.f);				 
				 Sound_CreateAtEntity("Sound_AlterOpenEnd", "03_03_herberts_hq/alter_open/alter_end_open", "player");		
			 }
             else if (Sequence_DoStepAndWait(0.4f))
             {				 				 
                 Effect_Shake_Start(0.045f, 5.f, 0.5f, 0.f);
                 Effect_ImageTrail_Start(1.0f, 0.5f, 5.f, 0.f);
				 Effect_Flash_Start(0.7f, 4.3f, 1.f, 2.f);	

				 FearHandler_SetForcedAddFearRate(0.f, 1.f, false, 1000.f, 1000.f);
             }
			 else if (Sequence_DoStepAndWait(3.f))
			 {		
				 Effect_Shake_FadeOut(-1, 0.25f);
				 Effect_Rumble_Stop(-1);
				 Map_RemoveTimer("Timer_BreakPortalRoomWall");
				 
				 Sound_FadeGlobalVolume(0.f, 1.f, eSoundEntryType_AllExceptGui);
				 Music_StopAll(1.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {				 
				 LoadScreen_SetUseAltFadeColor(true); // All endings share the same load screen. Need to use the white fade here, and black in other endings.
				 Player_SetAllowCheckBaby(true);
				 Map_ChangeMap("04_04_paris.hpm", "Start_Begin", "", "");
			 }
             Sequence_End();
         }

