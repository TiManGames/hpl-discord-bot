		}
		
		//-------------------------------------------------------
		
		void OnLineStart_SicknessReveal(const tString &in asScene, const tString &in asSubject, int alLineIndex, bool abStartOfLine)
		{
			if (abStartOfLine == false)
				return;
			
			Map_AddTimer("Timer_GhostStartMove", 2.f, "OnTimer_GhostStartMove");
		}
		
		//-------------------------------------------------------
		
