		//-------------------------------------------------------
		
		void OnAnimEnd_BreastfeedOutro(const tString &in asAnim)
		{						
			SetHoldBaby(true);
			
			Player_SetCrouchDisabled(false);
			Player_SetCrouching(false);
			Player_SetAllowCheckBaby(true);
			
			Player_SetMoveSpeedMul(gfUndercityPlayerMoveSpeedMul);
			Player_SetRunSpeedMul(0.f);
			
			Entity_PlayAnimation("BabyCarried", "baby_idle_stand");
			
			Entity_SetActive("Trigger_PickUpBaby", true);
			Entity_SetActive("Cover_Blocker_*", false);	
			
			Entity_SetActive("Trigger_PlayChoiceDialogue", true);
			Entity_SetActive("Trigger_ExitNursery", true);
			
			Map_AddTimer("Timer_SetContemplationDialoguePossible", 1.f, "OnTimer_SetContemplationDialoguePossible");
			
			// Ghost wait for player
			Agent_TeleportFeetToEntity("TH_Ghost", "Area_PostChoiceGhostPos", true);
			YoungTinHinan_Activate("TH_Ghost", 1.f, false);
			
			Sketchbook_AddIdea("meet_tinhinan");
			Sketchbook_AddIdea("activate_portal");
			Sketchbook_AddIdea("leave_baby");
		}
				
		//-------------------------------------------------------
		
		void OnTimer_SetContemplationDialoguePossible(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_PlayChoiceContemplationDialogue_*", true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_PlayChoiceContemplationDialogue(const tString &in asEntity, int alState)
		{
			if (alState == -1 || Player_GetHoldingBaby() == false || Player_GetCurrentStateName() != "State_Normal")
				return;
			 			
			int lId = cString_GetNumericSuffixInt(asEntity);			
			if (mvChoiceContemplationLinesPlayed.find(lId) == -1)
			{
				tString sSubject = lId == 2 ? "Dialogue_ContemplateCribAlt" : "Dialogue_ContemplateDoorAlt";
				
				int lSize = mvChoiceContemplationLinesPlayed.size();
				if (lSize == 0)		sSubject += "First";
				else				sSubject += "Second";
				
				Voice_Play(sSubject, -1, "OnVoiceEnd_ChoiceContemplation");				
				Entity_SetActive("Trigger_PlayChoiceContemplationDialogue_*", false);
				
				mvChoiceContemplationLinesPlayed.push_back(lId);
			}
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_ChoiceContemplation(const tString &in asScene, const tString &in asSubject)
		{
			Entity_SetActive("Trigger_PlayChoiceContemplationDialogue_*", true);
			
			if (mvChoiceContemplationLinesPlayed.size() == 2)
				Map_AddTimer("Timer_PlayThirdChoiceDialogue", 1.f, "OnTimer_PlayThirdChoiceDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayThirdChoiceDialogue(const tString &in asTimer)
		{
			return;
			
			// Cut for review - IT
			// OnVoiceEnd_ThirdChoice doesn't seem to exist so should be safe to cut.
			
			/*bool bPlay = Voice_SceneInvolvingCharacterIsActive("Tin Hinan") == false && 
						 Entity_PlayerIsInFront("Trigger_PlayChoiceDialogue") == false;
			
			if (bPlay)
			{
				Voice_StopAll();
				Voice_Play("Dialogue_ContemplateCribThird", -1, "OnVoiceEnd_ThirdChoice");
			}*/
		}
		
