		{
			YoungTinHinan_MoveTo("TH_Ghost", "PathNode_13", "OnPathfinderEnd_InitialGhostMovement", -1, true);
			Map_AddTimer("Timer_LeaveConversationState", 4.f, "OnTimer_LeaveConversationState");
		}
		
