	//-------------------------------------------------------
	
	void TempSetupThroneRoomEncounter()
	{
		ItemType_RemoveFromInventory("Lantern");
		
		if (ItemType_GetCountInInventory("ShadowFleshCanister") == 0)
		{
			Item_AddToInventory("ShadowFleshCanister");
			Item_AddToInventory("Matchbook");
			Item_SetAmount(ItemType_GetFirstInInventory("ShadowFleshCanister"), 3);
			Item_AddToInventory("ShadowFleshVial");
			Item_AddToInventory("ShadowFleshVial");
			Item_AddToInventory("ShadowFleshVial");
		}
		//return;
		if (ItemType_GetCountInInventory("VitaeCanister") == 0)
		{
			Item_AddToInventory("VitaeCanister");
		}
		
		Pregnancy_SetWhispering(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Carried);
		Player_SetAllowCheckBaby(true);
			
		PlayerBody_SetArmAnimationPitch(false, false, true);
		PlayerBody_SetArmAnimationYaw(false, false, true);
		
		SetHoldBaby(true);
				
		Entity_SetActive("Cover_Blocker_*", false);
		Entity_SetActive("Trigger_StartSeqDoctorConfrontation_*", false);
		Entity_SetActive("Trigger_PlayDoctorBegDialogue", false);
		
		Entity_SetActive("Trigger_PickUpBaby", true);
				
		SlideDoor_SetClosed("NurseryEndDoor_1", false, true);
		SlideDoor_SetClosed("NurseryDoor_*", false, true);
		SlideDoor_SetClosed("NurseryEntranceGrate_Door", true, true);
		MovingButton_SetLocked("NurseryEntranceGrate_Button", false);
		//Entity_SetCustomInteractIcon("Trigger_PickUpBaby", eCrossHairState_UseOnWorld);
		
		Player_Teleport("Start_ThroneRoomSneak");
		
		Entity_SetActive("Trigger_ExitNursery", true);
		
		Entity_SetActive("TH_Beam", true);
		Map_AddTimer("Timer_TempSetupBeam", 0.1f, "OnTimer_TempSetupBeam");
		Map_AddTimer("Timer_TempSetupBeamPassive", 1.f, "OnTimer_TempSetupBeamPassive");
		Map_AddTimer("Timer_TempBeamLookUp", 1.5f, "OnTimer_TempBeamLookUp");
		Map_AddTimer("Timer_TempBeamLookAtNursery", 1.f, "OnTimer_TempBeamLookAtNursery");
		
		Entity_SetActive("Trigger_PlayChoiceDialogue", true);
		
		MoveObject_SetState("Crib_Lid_1", 1.f);
		Entity_SetActive("Trigger_PickUpBaby", true);
		Entity_SetActive("Trigger_DoValveFlicker", false);
			
		Player_SetMoveSpeedMul(gfUndercityPlayerMoveSpeedMul);
		Player_SetRunSpeedMul(gfUndercityPlayerRunSpeedMul);
									
		Agent_TeleportFeetToEntity("TH_Ghost", "Area_PostChoiceGhostPos", true);
		YoungTinHinan_Activate("TH_Ghost", 1.f, false);
					
		Pregnancy_SetStage(ePregStage_BornRecovered);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_TempSetupBeam(const tString &in asTimer)
	{	
		TinHinan_Setup("TH_Beam", "Cover_*", "Area_Cover_*", "TH_Ghost");
		Entity_SetActive("TH_Beam_Closed", false);
		TinHinan_TurnSpotlightToPos("TH_Beam", Map_GetEntity("Area_BeamStart").GetPosition());
	}
	
	//-------------------------------------------------------
	
	void OnTimer_TempSetupBeamPassive(const tString &in asTimer)
	{		
		TinHinan_SetPassive("TH_Beam", true);				
		TinHinan_SetSpotlightColor("TH_Beam", "idle");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_TempBeamLookUp(const tString &in asTimer)
	{
		TinHinan_SetSpotlightOn("TH_Beam", false);
		TinHinan_StartSpotlightFollow("TH_Beam", "player");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_TempBeamLookAtNursery(const tString &in asTimer)
	{
		TinHinan_TurnSpotlightToPos("TH_Beam", Map_GetEntity("Area_BeamStart").GetPosition());
	}

