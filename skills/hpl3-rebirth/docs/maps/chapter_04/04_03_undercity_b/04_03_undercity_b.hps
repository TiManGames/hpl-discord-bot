		//-------------------------------------------------------

		//} END Event B *Tasi and the DOCTOR fight*
		
		/////////////////////////////////////////
		// Event C *Follow YOUNG TIN HINAN to the Nursery*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event C here.*/
		
		bool mbGhostAtEnd = false;
		bool mbNurseryWalkEndDialoguePlayed = false;
		int mlWalkToNurseryDialogueStage = 0;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 5, Event C here.*/
		
		void OnPathfinderEnd_InitialGhostMovement(const tString &in asEntityName, bool abReachedEnd)
		{
			OnTimer_UpdateGhostPath("Timer_UpdateGhostPath");
			FootPlacement_FadeIn("TH_Ghost", 0.3f);
			YoungTinHinan_SetAutoTurnTowardPlayer("TH_Ghost", true);
		}
		
		//-------------------------------------------------------
		
		bool mbPlayedFinalNurseryDialogue = false;
		
		void OnTimer_UpdateGhostPath(const tString &in asTimer)
		{
			float fDist = Entity_GetDeltaToEntity("player", "TH_Ghost").Length();
			float fDistToEnd = Entity_GetDeltaToEntity("TH_Ghost", "Area_GhostOutsideNurseryTarget").Length();
			
			///////////////////////////
			// Wait for player if far away, otherwise walk towards Nursery!			
			if (mbGhostAtEnd == false)
			{
				bool bIsMoving = Pathfinder_IsMoving("TH_Ghost");
				
				if (fDist > 13.f && fDistToEnd > 5.f && bIsMoving)
				{			
					Pathfinder_Stop("TH_Ghost");
					CharMover_StopTurning("TH_Ghost");
					cLux_ToAgent(Map_GetEntity("TH_Ghost", eLuxEntityType_Agent)).GetCharBody().StopMovement();
				}					
				else if (fDist < 9.f && bIsMoving == false)
				{
					Map_RemoveTimer("Timer_PlayFollowPromptDialogue");
					YoungTinHinan_MoveTo("TH_Ghost", "Area_GhostOutsideNurseryTarget", "OnPathEnd_Ghost", -1, true);
				}
			}
			
			////////////////////////////
			// Play follow prompt if player is far away!
			if (fDist > 15.f && mbGhostAtEnd == false)
			{
				if (Voice_SceneInvolvingCharacterIsActive("Tin Hinan") == false && 
					Map_TimerExists("Timer_PlayFollowPromptDialogue") == false)
				{
					Map_AddTimer("Timer_PlayFollowPromptDialogue", cMath_RandRectf(8.f, 11.f), "OnTimer_PlayFollowPromptDialogue");	
				}
			}
			
			///////////////////////////
			// Adjust player speed
			if (fDist < 14.f)
			{
				Player_FadeRunSpeedMulTo(0.f, 0.5f);
				Player_FadeMoveSpeedMulTo(0.8f, 0.5f);
			}
			else if (fDist > 15.f)
			{
				ResetPlayerMoveSpeed(true);
			}
			
			///////////////////////////
			// Play dialogue
			if (fDist < 12.f)
			{
				bool bPlayGhoulishDialogue = GhoulProgression_GetProgression() >= GHOUL_PROGRESSION_UNDERCITYB_HIGH;
				tString sNurseryEndSubject = bPlayGhoulishDialogue ? "Dialogue_WalkToNurseryEnd_Ghoulish" : 
																     "Dialogue_WalkToNurseryEnd";
				
				if (Voice_SubjectHasUnplayedLines("Dialogue_WalkToNursery"))
				{
					bool bPlayLine = false;					
					switch (mlWalkToNurseryDialogueStage)
					{
						case 0:		bPlayLine = fDistToEnd <= 71.f;		break;
						case 1:		bPlayLine = fDistToEnd <= 45.f;		break;
						case 2:		bPlayLine = fDistToEnd <= 43.f;		break;
						case 3:		bPlayLine = fDistToEnd <= 38.f; 	break;
						case 4:		bPlayLine = fDistToEnd <= 28.f;		break;
						case 5:		bPlayLine = fDistToEnd <= 28.f;		break;
					}
					
					if (bPlayLine && Voice_AnySceneIsActive() == false)
					{
						Voice_PlayWhenPossible("Dialogue_WalkToNursery");
						mlWalkToNurseryDialogueStage++;
					}
				}
				else if (Voice_SubjectHasUnplayedLines(sNurseryEndSubject))
				{
					if (mbGhostAtEnd && Voice_AnySceneIsActive() == false)
					{
						if (!mbPlayedFinalNurseryDialogue)
						{
							mbPlayedFinalNurseryDialogue = true;
						
							Voice_PlayDelayed(sNurseryEndSubject, 2.0f, -1, "OnVoiceEnd_NurseryWalkEnd");
						
							if (bPlayGhoulishDialogue)
								Map_AddTimer("Timer_PlayLookAtHandsAnim", 3.f, "OnTimer_PlayLookAtHandsAnim");
						}
					}
				}
			}
			
			Map_AddTimer("Timer_UpdateGhostPath", 0.25f, "OnTimer_UpdateGhostPath");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayFollowPromptDialogue(const tString &in asTimer)
		{
			float fDist = Entity_GetDeltaToEntity("player", "TH_Ghost").Length();
			bool bPlay = fDist > 15.f && Entity_PlayerIsInFront("Area_ThroneRoomStart");
			
			if (bPlay)
				Voice_PlayWhenPossible("Dialogue_TinHinanFollowPrompt", "", 30.f, 1.f, "OnVoiceEnd_TinHinanFollowPrompt");
			else
				Map_AddTimer("Timer_PlayFollowPromptDialogue", cMath_RandRectf(15.f, 20.f), "OnTimer_PlayFollowPromptDialogue");
		}
		
		//-------------------------------------------------------s
		
		void OnVoiceEnd_TinHinanFollowPrompt(const tString &in asScene, const tString &in asSubject)
		{
			Map_AddTimer("Timer_PlayFollowPromptDialogue", cMath_RandRectf(15.f, 20.f), "OnTimer_PlayFollowPromptDialogue");
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_DoValveFlicker(const tString &in asParent, const tString &in asChild, int alState)
		{
			Lamp_SetFlickerActive("Generator_3_1", true);			
			Map_AddTimer("Timer_StopValveFlicker", 8.f, "OnTimer_StopValveFlicker");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopValveFlicker(const tString &in asTimer)
		{
			Lamp_SetFlickerActive("Generator_3_1", false);
			Lamp_SetLit("Generator_3_1", true, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayLookAtHandsAnim(const tString &in asTimer)
		{
			if (cLux_GetPlayer().GetCharacterBody().IsOnGround() == false)
			{
				Map_RestartCurrentTimer(0.01f);
				return;
			}
			
			PlayerBody_PlayCutsceneAnimation("player_look_at_hands", false, 0.3f);
			PlayerBody_SetCutsceneMaxPitch(10.f);
			PlayerBody_SetCutsceneMaxYaw(10.f);
			//Map_AddTimer("Timer_StopLookAtHandsAnim", 4.f, "OnTimer_StopLookAtHandsAnim");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopLookAtHandsAnim(const tString &in asTimer)
		{
			PlayerBody_StopAnimation("permafail_trigger", 1.5f);
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_NurseryWalkEnd(const tString &in asScene, const tString &in asSubject)
		{
			mbNurseryWalkEndDialoguePlayed = true;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_OpenNurseryOuterDoors(const tString &in asParent, const tString &in asChild, int alState)
		{
			SlideDoor_SetClosed("NurseryDoor_*", false);
			SlideDoor_SetClosed("NurseryEntranceGrate_Door", false);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnPathEnd_Ghost(const tString &in asEntity, bool abReachedEnd)
		{
			if (abReachedEnd == false)
				return;
			
			cLux_ToAgent(Map_GetEntity("TH_Ghost", eLuxEntityType_Agent)).GetCharBody().StopMovement();
			
			mbGhostAtEnd = true;
			SlideDoor_SetClosed("NurseryEntranceGrate_Door", true);
			Sound_CreateAtEntity("Sound_NurseryBigGate", "level_entity_shared/doors/DW_slide_door/close", "NurseryEntranceGrate_Door", 0.f, false, 1.f, 5.f, 25.f);
			
			Entity_FadeEffectBaseColor("TH_Ghost", cColor(1.5f, 1.5f, 1.5f, 1.5f), 2.f);
			
			Map_AddTimer("Timer_PlayFinalWalkDialogue", 0.1f, "OnTimer_PlayFinalWalkDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayFinalWalkDialogue(const tString &in asTimer)
		{
			if (mbNurseryWalkEndDialoguePlayed == false)
			{
				Map_RestartCurrentTimer();
				return;
			}
			
			Map_AddTimer("Timer_PlayNurseryDialogue", 1.5f, "OnTimer_PlayNurseryDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayNurseryDialogue(const tString &in asTimer)
		{			
			if (Map_GetEntity("TH_Ghost").CheckIsOnScreen(false) == false ||
				Entity_GetDeltaToEntity("TH_Ghost", "player").Length() > 15.f)
			{
				Map_AddTimer("Timer_PlayNurseryDialogue", 0.25f, "OnTimer_PlayNurseryDialogue");
				return;
			}
			
			Voice_Play("Dialogue_NurseryOpen");			
			Map_AddTimer("Timer_OpenNurseryDoors", 0.5f, "OnTimer_OpenNurseryDoors");
		}

		//-------------------------------------------------------

		//} END Event C *Follow YOUNG TIN HINAN to the Nursery*
	 
	//} END SCENE 5

	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 6 *THE PLAYER FINDS THE BABY IN THE NURSERY AND BREASTFEEDS IT*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 6 here.*/
		
		int mlSootheHintId = -1;
		bool mbAllowCribOpen = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 6 here.*/
		
		void SetCribOpen(bool abX)
		{
			if (mbAllowCribOpen == false)
				return;
			
			Entity_PlayAnimation("CribLid", "crib_lid_open", 0.f, false);
			
			cAnimationState@ pState = Map_GetEntity("CribLid", eLuxEntityType_Prop).GetMeshEntity().GetAnimationStateFromName("crib_lid_open");
			if (abX)
			{
				pState.SetRelativeTimePosition(0.f);
				pState.SetSpeed(1.f);
			}
			else
			{
				pState.SetRelativeTimePosition(1.f);
				pState.SetSpeed(-2.f);
			}
			
			Sound_CreateAtEntity("Sound_CribLidOpen", "level_dreams/anim/crib_open", "CribLid", 0.f, false, 1.f, 2.f, 20.f);
			Map_AddTimer("Timer_StopCribLidSound", abX ? 5.5f : 3.f, "OnTimer_StopCribLidSound");
			
			Map_AddTimer("Timer_AllowPickUpBaby", abX ? 3.f : 0.f, "OnTimer_AllowPickUpBaby");
			Map_SetTimerUserVarInt("Timer_AllowPickUpBaby", (abX ? 1 : 0));
			
			Map_AddTimer("Timer_ResetNurseryCanisterInteraction", abX ? 5.75f : 3.25f, "OnTimer_ResetNurseryCanisterInteraction");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetNurseryCanisterInteraction(const tString &in asTimer)
		{
			if (mbAllowCribOpen == false)
				return;
			
			Entity_SetInteractionDisabled("InteractArea_PlaceVitaeCanister_5", false);
			Entity_SetInteractionDisabled("VitaeCanister_5", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopCribLidSound(const tString &in asTimer)
		{
			Sound_Stop("Sound_CribLidOpen", 0.3f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_AllowPickUpBaby(const tString &in asTimer)
		{
			bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			Entity_SetActive("Trigger_PickUpBaby", bX);
			Entity_SetActive("Trigger_AllowBabyInteraction", bX);
		}
	 
		//-------------------------------------------------------
		
		//} END General	
		
		/////////////////////////////////////////
		// Event A *Hear the BABY*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 7, Event A here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 7, Event A here.*/
		
		void OnTimer_OpenNurseryDoors(const tString &in asTimer)
		{
			YoungTinHinan_Deactivate("TH_Ghost", 1.f);
			
			SlideDoor_SetClosed("NurseryEndDoor_1", false);
			
			Map_RemoveTimer("Timer_UpdateGhostPath");
			ResetPlayerMoveSpeed(true);
						
			Sound_CreateAtEntity("Sound_NurseryBaby", "04_03_undercity/baby/baby_cry_soft", "Area_CribCry", 0.f, false, 1.f, 3.f, 13.f);
			
			Map_AddTimer("Timer_OpenCrib", 0.5f, "OnTimer_OpenCrib");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_OpenCrib(const tString &in asTimer)
		{
			mbAllowCribOpen = true;
			SetCribOpen(true);
		}
				
		//-------------------------------------------------------

		//} END Event A *Hear the BABY*
		
		/////////////////////////////////////////
		// Event B *Breastfeed the baby*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 6, Event B here.*/
		
		int mlPutBabyBackInteractCount = 0;
		bool mbAllowBreastfeed = false;
		tString msBreastFeedMaterial = "";

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 6, Event B here.*/
		
		bool OnTrigger_Player_AllowBabyInteraction(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetInteractionDisabled("Trigger_PickUpBaby", alState == -1);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_Baby(const tString &in asEntity)
		{	
			//////////////////////
			// Pick up baby!
			if (Player_GetHoldingBaby() == false)
			{
				Sound_Stop("Sound_NurseryBaby", 0.3f);
				
				FearHandler_SetWhisperStage(eFearWhisperStage_ThroneRoomToEnd);
				
				PlayerBody_PlayCutsceneAtEntity("player_breastfeed_intro", "Area_BreastfeedScene", false, 0.3f, "OnAnimEnd_BreastfeedIntro");
				PlayerBody_SetCutsceneMaxPitch(5.f);
				PlayerBody_SetCutsceneMaxYaw(5.f);
				
				Entity_PlayAnimation("BabyCarried", "baby_breastfeed_intro", 0.3f, false);
				
				Voice_StopAll();
				Voice_Play("Dialogue_SeeBaby", -1, "OnVoiceEnd_SeeBaby");
				
				Music_Play("A2_4_3_Discover_Baby.ogg", 0.2f, false, eMusicPrio_MinorEvent);
				Sound_CreateAtEntity("Sound_BabyPickUp", "04_03_undercity/animations/baby_pickup", "player");
				
				cScript_SetGlobalVarBool("Undercity_FoundBaby", true);
				
				Map_AddTimer("Timer_PlayPreBreastfeedDialogue", 420.f / 30.f, "OnTimer_PlayPreBreastfeedDialogue");
				
				Player_SetCrouchDisabled(true);
				Player_SetJumpDisabled(true);
				Player_SetCrouching(false, true, true);
							
				Entity_SetActive("Trigger_PickUpBaby", false);
				
				Pregnancy_SetBabyTalkStage(eBabyTalkStage_Carried);
				
				FearHandler_FadeLevelTo(0.f, 5.f);
				
				// Removing these for now, might add support for disabling properly later
				ItemType_RemoveFromInventory("Matchbook"); 
				
				///////////////////
				// TH waiting on player!
				SlideDoor_SetClosed("NurseryDoor_*", false);
				TinHinan_TurnSpotlightToPos("TH_Beam", Map_GetEntity("Area_BeamStart").GetPosition());
			}
			//////////////////////
			// Put down baby!
			else
			{			
				++mlPutBabyBackInteractCount;
				
				if (mlPutBabyBackInteractCount == 1)
				{
					Voice_StopAll();
					Voice_Play("Dialogue_PutBackBabyContemplate");
					
					Entity_SetActive("Trigger_PlayChoiceContemplationDialogue_2", false);
					
					Player_ForceCheckOnBaby(6.f);
					Music_Play("A2_4_3_Baby_Put_Back_Check_ALT.ogg", 0.2f, false, eMusicPrio_MinorEvent);
					Sound_CreateAtEntity("Sound_BabyContemplate", "04_03_undercity/animations/baby_contemplate", "player");
					Sound_CreateAtEntity("Sound_BabyContemplateVocals", "game_voice/voice/baby/baby_return_contemplate", "BabyCarried");
				}
				else if (mlPutBabyBackInteractCount == 2)
				{					
					float fTime = cLux_GetPlayer().GetCamera().GetPitch() <= -1.f ? 0.3f : 0.5f;
					
					PlayerBody_PlayCutsceneAtEntity("player_leave_amari_in_crib", "Area_BreastfeedScene", false, fTime, "OnAnimEnd_PutBackBaby");
					PlayerBody_SetCutsceneMaxPitch(5.f);
					PlayerBody_SetCutsceneMaxYaw(5.f);
					
					Map_AddTimer("Timer_PlayLeaveBabyAnim", fTime, "OnTimer_PlayLeaveBabyAnim");
					
					Voice_StopAll();
					Voice_Play("Dialogue_PutBabyDown", -1, "OnVoiceEnd_PutBabyDown");
					
					Sound_CreateAtEntity("Sound_BabyContemplateVocals", "game_voice/voice/baby/baby_put_down_vocals", "BabyCarried");
					
					Pregnancy_SetBabyTalkStage(eBabyTalkStage_Born);
					
					// Preload DW
					Map_Preload("04_05_darkworld.hpm");
				}								
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayLeaveBabyAnim(const tString &in asTimer)
		{
			SetHoldBaby(false);
			
			float fTime = Map_GetEntity(PlayerBody_GetEntityName()).GetMeshEntity().GetAnimationStateFromName("player_leave_amari_in_crib").GetTimePosition();
			
			Entity_PlaceAtEntity("BabyCarried", "Area_BreastfeedScene", 0.f, true);
			Entity_PlayAnimation("BabyCarried", "baby_left_in_crib", 0.f);
			Map_GetEntity("BabyCarried", eLuxEntityType_Prop).GetMeshEntity().GetAnimationStateFromName("baby_left_in_crib").SetTimePosition(fTime);
					
			Entity_SetActive("Monkey", true);	
			Entity_SetCollide("Monkey", false);
			Entity_SetCollideCharacter("Monkey", false);
			Entity_PlayAnimation("Monkey", "monkey_left_in_crib", 0.f, false);
			Map_GetEntity("Monkey", eLuxEntityType_Prop).GetMeshEntity().GetAnimationStateFromName("monkey_left_in_crib").SetTimePosition(fTime);
			
			Item_RemoveFromInventory(ItemType_GetFirstInInventory("AlysDoll"));
			cScript_SetGlobalVarBool("Undercity_LeftDoll", true);
			
			Music_Play("A2_4_3_Baby_Leave.ogg", 0.3f, false, eMusicPrio_BigEvent);
			Sound_CreateAtEntity("Sound_BabyPlaceBack", "04_03_undercity/animations/baby_place_back", "player");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_SeeBaby(const tString &in asScene, const tString &in asSubject)
		{
			Voice_PlayDelayed("Dialogue_ShushBaby", 1.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayPreBreastfeedDialogue(const tString &in asTimer)
		{
			Entity_SetEffectBaseColor("TH_Ghost", cColor(1.f, 1.f, 1.f, 1.f));
			
			Agent_TeleportFeetToEntity("TH_Ghost", "Area_GhostBreastfeeding", true);
			YoungTinHinan_Activate("TH_Ghost", 1.f, false);
			
			HeadTracker_SetTargetEntity("TH_Ghost", "Area_GhostBreastFeedLookAt");
			
			Map_AddTimer("Timer_NurseyGhostLeave", 5.f, "OnTimer_NurseryGhostLeave");
			
			Voice_Play("Dialogue_PreBreastFeed");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_NurseryGhostLeave(const tString &in asTimer)
		{
			Map_AddTimer("Timer_CloseNurseryEndDoor", 3.f, "OnTimer_CloseNurseryEndDoor");
			
			YoungTinHinan_MoveTo("TH_Ghost", "Area_NurseryGhostFinalGoal", "", 3, false);
			Map_AddTimer("Timer_DeactivateNurseryGhost", 7.f, "OnTimer_DeactivateNurseryGhost");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CloseNurseryEndDoor(const tString &in asTimer)
		{
			SlideDoor_SetClosed("NurseryEndDoor_*", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivateNurseryGhost(const tString &in asTimer)
		{
			YoungTinHinan_Deactivate("TH_Ghost", 1.f, false);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_BreastfeedIntro(const tString &in asAnim)
		{
			PlayerBody_PlayCutsceneAtEntity("player_breastfeed_calming_loop", "Area_BreastfeedScene", true, 0.f, "", 1.f, 0.f, 0.f, 0.f, true, false, true);
			PlayerBody_SetCutsceneMaxPitch(2.5f);
			PlayerBody_SetCutsceneMaxYaw(2.5f);
					
			Entity_PlayAnimation("BabyCarried", "baby_breastfeed_calming_loop", 0.f, true);
			
			Map_AddTimer("Timer_ShowBreastFeedHint", 1.f, "OnTimer_ShowBreastFeedHint");
			
			Sound_CreateAtEntity("Sound_BabyCalming", "04_03_undercity/baby/baby_cry_soft", "BabyCarried");
			cSoundEntity@ pSound = mBaseObj.GetWorld().GetSoundEntity("Sound_BabyCalming");
			if (pSound !is null)
			{
				cVector3f vPos = Map_GetEntity("BabyCarried", eLuxEntityType_Prop).GetMeshEntity().GetSocket("Voice_Socket").GetWorldPosition();
				pSound.SetWorldPosition(vPos);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowBreastFeedHint(const tString &in asTimer)
		{
			mbAllowBreastfeed = true;
			
			// Make sue hint is shown even if hints are disabled
			iScrHintHandler_Interface@ pHintHandler = cast<iScrHintHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_HintHandler));
			pHintHandler.ForceEnabled(true);
			
			mlSootheHintId = Hint_ShowHint_Hold("Hints", "SootheBaby", true, 100.f, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartBreastfeed(const tString &in asTimer)
		{
			if (mbAllowBreastfeed && cInput_IsTriggered(eAction_CheckBaby))
			{			
				Sound_Stop("Sound_BabyCalming", 0.3f);
				
				PlayerBody_PlayCutsceneAtEntity("player_breastfeed_outro", "Area_BreastfeedScene", false, 0.f, "", 1.f, 0.f, 0.f, 0.f, true, false, true);
				PlayerBody_SetCutsceneMaxPitch(0.f);
				PlayerBody_SetCutsceneMaxYaw(0.f);
				
				Entity_PlayAnimation("BabyCarried", "baby_breastfeed_outro", 0.f, false);
				
				Map_AddTimer("Timer_SwitchToBreastfeedPlayerModel", 6.5f, "OnTimer_SwitchToBreastfeedPlayerModel");
				Map_AddTimer("Timer_SwitchToNormalPlayerModel", 79.f, "OnTimer_SwitchToNormalPlayerModel");
				
				Map_AddTimer("Timer_PlayBreastfeedStartDialogue", 30.f / 30.f, "OnTimer_PlayBreastfeedStartDialogue");
				Map_AddTimer("Timer_PlayBreastfeedEndDialogue", 2262.f / 30.f, "OnTimer_PlayBreastfeedEndDialogue");
					
				Hint_StopHint();
				Hint_Release(mlSootheHintId);
				
				// Reset hints
				Map_AddTimer("Timer_ResetForcedHints", 5.f, "OnTimer_ResetForcedHints");
				
				mbAllowBreastfeed = false;
							
				MovingButton_SetLocked("NurseryEndDoor_Button_*", false);
				MovingButton_SetLocked("NurseryEntranceGrate_Button", false);
				
				Music_Play("A2_4_3_Baby_Feed.ogg", 0.4f, false, eMusicPrio_MinorEvent);
				Sound_CreateAtEntity("Sound_BabyFeed", "04_03_undercity/animations/baby_feed", "player");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SwitchToBreastfeedPlayerModel(const tString &in asTimer)
		{
			float fT = PlayerBody_GetAnimationState("player_breastfeed_outro").GetRelativeTimePosition();
			
			PlayerBody_SetModel("player_breastfeed.ent");
			PlayerBody_AttachProp("Amulet_Bracelet", "AmuletSocket", false, false);
			PlayerBody_AttachProp("SalimsRing_Accessory", "RingSocket", false, false);
			
			tString sEnt = PlayerBody_GetEntityName();
			Entity_SetEffectsActive(sEnt, false, false);
			FootPlacement_SetActive(sEnt, false);
			GhoulProgression_ResetArms();
						
			PlayerBody_PlayCutsceneAtEntity("player_breastfeed_outro_nude", "Area_BreastfeedScene", false, 0.f, "", 1.f, fT, 0.f, 0.f, true, false, true);
			PlayerBody_SetCutsceneMaxPitch(0.f);
			PlayerBody_SetCutsceneMaxYaw(0.f);
			
			Prop_SetCustomMaterial(PlayerBody_GetEntityName(), msBreastFeedMaterial, "m_Tasi_Body");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SwitchToNormalPlayerModel(const tString &in asTimer)
		{
			float fT = PlayerBody_GetAnimationState("player_breastfeed_outro_nude").GetRelativeTimePosition();
			
			PlayerBody_SetModel("player6.ent");
			PlayerBody_AttachProp("Amulet_Bracelet", "AmuletSocket", false, false);
			PlayerBody_AttachProp("SalimsRing_Accessory", "RingSocket", false, false);
			
			tString sEnt = PlayerBody_GetEntityName();
			Entity_SetEffectsActive(sEnt, false, false);
			FootPlacement_SetActive(sEnt, false);
			GhoulProgression_ResetArms();
			
			PlayerBody_PlayCutsceneAtEntity("player_breastfeed_outro", "Area_BreastfeedScene", false, 0.f, "OnAnimEnd_BreastfeedOutro", 1.f, fT, 0.f, 0.f, true, false, true);
			PlayerBody_SetCutsceneMaxPitch(0.f);
			PlayerBody_SetCutsceneMaxYaw(0.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayBreastfeedStartDialogue(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_Play("Dialogue_BreastfeedStart");
		}
		
