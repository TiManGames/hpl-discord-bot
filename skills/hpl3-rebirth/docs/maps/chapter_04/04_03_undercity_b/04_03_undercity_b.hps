			Entity_SetActive("Doctor_ThroneRoom_Dead", true);
			Entity_PlayAnimation("Doctor_ThroneRoom_Dead", "doctor_doc_confrontation", 0.f, false);
			Entity_SetUpdateBonesWhenCulled("Doctor_ThroneRoom_Dead", true);
			Map_GetEntity("Doctor_ThroneRoom_Dead", eLuxEntityType_Prop).GetMeshEntity().GetAnimationStateFromName("doctor_doc_confrontation").SetRelativeTimePosition(1.f);
		}
		
		//-------------------------------------------------------
		
		void StartBeamGhostParticleMove(float afTime, const cVector3f &in avP0, const cVector3f &in avP1, const cVector3f &in avP2, const cVector3f &in avP3)
		{
			mbUpdateBeamGhostParticles = true;
			mfBeamGhostParticleTime = afTime;
			mfBeamGhostParticleCount = 0.f;
			
			mvBeamGhostParticleGoals.resize(0);				
			mvBeamGhostParticleGoals.push_back(avP0);
			mvBeamGhostParticleGoals.push_back(avP1);
			mvBeamGhostParticleGoals.push_back(avP2);
			mvBeamGhostParticleGoals.push_back(avP3);
			
			Entity_SetActive("Ghost_Particles", true);
			Map_GetEntity("Ghost_Particles", eLuxEntityType_Prop).SetPosition(avP0);
			Entity_SetEffectsActive("Ghost_Particles", false, false);
			Entity_SetEffectsActive("Ghost_Particles", true, true);
			
			Sound_CreateAtEntity("Sound_GhostParticlesStart", "creatures/foley/creature/tin_hinan/phase/start", "Ghost_Particles", 0.f, false, 1.f, 20.f, 50.f);
			Sound_CreateAtEntity("Sound_GhostParticlesMove", "creatures/foley/creature/tin_hinan/phase/loop", "Ghost_Particles", 0.f, false, 1.f, 20.f, 50.f);
		}
		
		//-------------------------------------------------------
		
		void UpdateBeamGhostParticles(float afDeltaTime)
		{
			if (mbUpdateBeamGhostParticles == false || mvBeamGhostParticleGoals.size() != 4)
				return;
			
			///////////////////
			// Time
			mfBeamGhostParticleCount += afDeltaTime;
			float fT = cMath_Clamp(mfBeamGhostParticleCount / mfBeamGhostParticleTime, 0.f, 1.f);
			
			///////////////////
			// Move along spline
			iLuxEntity@ pEnt = Map_GetEntity("Ghost_Particles", eLuxEntityType_Prop);			
			
			// Cubic bezier
			cVector3f v0 = mvBeamGhostParticleGoals[0];
			cVector3f v1 = mvBeamGhostParticleGoals[1];
			cVector3f v2 = mvBeamGhostParticleGoals[2];
			cVector3f v3 = mvBeamGhostParticleGoals[3];
			cVector3f vPos = v0 * cMath_Pow(1.f - fT, 3.f) + v1 * 3.f * cMath_Pow(1.f - fT, 2.f) * fT + v2 * 3.f * (1.f - fT) * cMath_Pow(fT, 2.f) + v3 * cMath_Pow(fT, 3.f);
			
			pEnt.SetPosition(vPos);
			
			if (fT >= 1.f)
			{
				mbUpdateBeamGhostParticles = false;
				mfBeamGhostParticleCount = 0.f;
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_GhostReveal(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_PlayAnimation("TH_Ghost", "idle", 0.f, true);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEvent_DoctorConfrontation(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 0)
			{
				cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_DocDust", "dust_impact_small_oneshot.ps", asEntityName, false);
				pPS.SetPosition(Map_GetEntity(asEntityName, eLuxEntityType_Agent).GetMeshEntity().GetBoneStateFromName("j_Spine_3").GetWorldPosition());
				pPS.SetBrightness(0.2f);	

				Effect_Rumble_Start(0.5f, 0.5f, 0.05f, 0.25f);
			}
			else if (alMessageEventID == 1)
			{
				cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_DocDust", "dust_impact_small_oneshot.ps", asEntityName, false);
				pPS.SetPosition(Map_GetEntity(asEntityName, eLuxEntityType_Agent).GetMeshEntity().GetSocket("VoiceSocket").GetWorldPosition());
				pPS.SetMatrix(cMath_MatrixMul(pPS.GetLocalMatrix(), cMath_MatrixScale(0.5f)));
				pPS.SetBrightness(0.05f);

				++mlDocDecalId;
				if (mlDocDecalId > 0)
					Decal_SetDynamicVisible("Decal_DoctorBlood_" + mlDocDecalId + "_*", true);
					
				Effect_Rumble_Start(0.5f, 0.2f, 0.05f, 0.1f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimEvent_TinHinanOpenUp(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 0)
			{
				Entity_SetEffectsActive("TH_Beam_OpenEffects", true, false);
				
				Light_SetBrightness("TH_Beam_OpenEffects_Light_*", 0.f);
				
				TinHinan_SetSpotlightColor("TH_Beam", "detected");				
				TinHinan_SetSpotlightOn("TH_Beam", true, false, 2.f);
				TinHinan_StartSpotlightFollow("TH_Beam", "player");
				
				Map_AddTimer("Timer_SetTinHinanBillboardActive", 0.5f, "OnTimer_SetTinHinanBillboardActive");
				Map_SetTimerUserVarInt("Timer_SetTinHinanBillboardActive", 0);
			}
			else if (alMessageEventID == 1)
			{
				Light_FadeBrightnessTo("TH_Beam_OpenEffects_Light_Spot_3", 500.f, 0.5f, eEasing_ExpoIn);
				Map_AddTimer("TH_Beam_OpenEffects_Light_Spot_3", 2.25f, "OnTimer_FadeOutOpenUpLight");
				
				ParticleSystem_SetActive("PS_OpenUp_1", true);
				
				Effect_Shake_Start(0.025f, 1.f, 0.f, 0.3f);	
				Sound_CreateAtEntity("Sound_THLightCrack", "creatures/foley/creature/wraith/animations/idle_twitch", "TH_Beam");
			}
			else if (alMessageEventID == 2)
			{
				Light_FadeBrightnessTo("TH_Beam_OpenEffects_Light_Spot_1", 500.f, 0.5f, eEasing_ExpoIn);
				Map_AddTimer("TH_Beam_OpenEffects_Light_Spot_1", 1.75f, "OnTimer_FadeOutOpenUpLight");
				
				ParticleSystem_SetActive("PS_OpenUp_2", true);
				
				Effect_Shake_Start(0.025f, 1.f, 0.f, 0.3f);				
				Sound_CreateAtEntity("Sound_THLightCrack", "creatures/foley/creature/wraith/animations/idle_twitch", "TH_Beam");
			}
			else if (alMessageEventID == 3)
			{
				Light_FadeBrightnessTo("TH_Beam_OpenEffects_Light_Spot_2", 500.f, 0.5f, eEasing_ExpoIn);
				Map_AddTimer("TH_Beam_OpenEffects_Light_Spot_2", 1.f, "OnTimer_FadeOutOpenUpLight");
				
				ParticleSystem_SetActive("PS_OpenUp_3", true);
				
				Effect_Shake_Start(0.025f, 1.f, 0.f, 0.3f);				
				Sound_CreateAtEntity("Sound_THLightCrack", "creatures/foley/creature/wraith/animations/idle_twitch", "TH_Beam");
			}
			else if (alMessageEventID == 8)
			{
				Map_GetEntity("TH_Beam", eLuxEntityType_Agent).GetMeshEntity().GetAnimationStateFromName("open_up").FadeSpeed(0.25f, 0.3f);
			}
			else if (alMessageEventID == 9)
			{
				Map_AddTimer("Timer_SetTinHinanBillboardActive", 1.2f, "OnTimer_SetTinHinanBillboardActive");
				Map_SetTimerUserVarInt("Timer_SetTinHinanBillboardActive", 1);
				
				Map_GetEntity("TH_Beam", eLuxEntityType_Agent).GetMeshEntity().GetAnimationStateFromName("open_up").FadeSpeed(1.f, 0.3f);
			}
		}
		
