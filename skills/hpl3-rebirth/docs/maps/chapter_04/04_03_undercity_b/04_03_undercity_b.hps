			Map_AddTimer("Timer_TempSetupBeam", 0.1f, "OnTimer_TempSetupBeam");
			Map_AddTimer("Timer_TempSetupBeamPassive", 1.f, "OnTimer_TempSetupBeamPassive");
			Map_AddTimer("Timer_TempBeamLookUp", 1.5f, "OnTimer_TempBeamLookUp");
						
			YoungTinHinan_Activate("TH_Ghost", 1.f);
			Agent_TeleportFeetToEntity("TH_Ghost", "Area_GhostStartPos");
			OnTimer_UpdateGhostPath("Timer_UpdateGhostPath");
			
			Player_Teleport("Start_PostConfrontation");
			
			Pregnancy_SetStage(ePregStage_BornRecovered);
			
			FearThreatAgent_SetComponentEnabled("TH_Beam", false);
		}
		
		if (alAction == eAction_Test6)
		{			
