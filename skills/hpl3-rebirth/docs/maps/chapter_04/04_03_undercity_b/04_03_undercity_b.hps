			PlayerBody_PlayCutsceneAtEntity("tasi_undercity_fall_on_butt_end", "Area_FallOnButtAnim", false, 0.3f, "OnAnimEnd_StandUpAfterReveal", 1.f, 0.f, 0.f, 0.f, true, false, true);
			PlayerBody_SetCutsceneMaxPitch(15.f);
			PlayerBody_SetCutsceneMaxYaw(15.f);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_StandUpAfterReveal(const tString &in asAnim)
		{
			Player_FadeLookSpeedMulTo(1.f, 1.f);
			Player_FadeMoveSpeedMulTo(0.8f, 1.f);
			Map_AddTimer("Timer_EnterConversationState", 0.01f, "OnTimer_EnterConversationState");
		}
		
		//-------------------------------------------------------
		
