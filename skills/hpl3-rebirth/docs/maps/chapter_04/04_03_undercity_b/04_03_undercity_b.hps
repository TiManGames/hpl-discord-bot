/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/
 
//--------------------------------------------------

const float gfUndercityPlayerMoveSpeedMul = 0.8f;
const float gfUndercityPlayerRunSpeedMul = 0.75f;

//--------------------------------------------------

class cVitaePipeCrack
{	
	//--------------------------------------------------
	
	cVitaePipeCrack()
	{
		mlState = 1;
		mfFadeCount = 0.f;
		mfFadeTimeMul = 1.f;
		msName = "";
		m_idPS = tID_Invalid;
	}
	
	//--------------------------------------------------
	
	cVitaePipeCrack(const tString &in asName, float afTimeMul)
	{
		mlState = 1;
		mfFadeCount = 0.f;
		msName = asName;
		mfFadeTimeMul = afTimeMul;
		
		array<cMeshEntity@> vOut;
		Map_GetDecalArray(asName + "_*", vOut);

		float fTimeMul = 1.f / cMath_Max(vOut.size(), 1.f);
		for (int i = 0; i < vOut.size(); ++i)
		{
			mvIds.push_back(vOut[i].GetID());
			mvFadeTimeMuls.push_back((i + 1) * fTimeMul);
		}
				
		if (vOut.size() > 0)
		{			
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_" + asName, "smoke_steam_continuos_short.ps", "player", false);
			pPS.SetWorldPosition(vOut[0].GetBoundingVolume().GetWorldCenter());
			pPS.SetColor(cColor(0.2,0.631,0.604,1));
			
			m_idPS = pPS.GetID();
		}
	}
	
	//--------------------------------------------------
	
	bool Update(float afTimeStep)
	{		
		//////////////////
		// Fade
		float fSpeed = 1.f;
		float fFadeTime = 3.f * mfFadeTimeMul;
		float fGoal = fFadeTime;
		float fMinT = 0.f;
		
		if (mlState == 0)
		{
			fSpeed = 10.f;
			fGoal = 0.f;
			fMinT = 0.15f;
		}
		
		float fPrevFadeCount = mfFadeCount;
		mfFadeCount = cMath_IncreaseTo(mfFadeCount, afTimeStep * fSpeed, fGoal);		
		
		//////////////////
		// Update coverage & illum
		bool bFadeOut = true;
		bool bStop = true;
		bool bColorPS = true;
		
		for (int i = 0; i < mvIds.size(); ++i)
		{
			cMeshEntity@ pMeshEnt = cLux_ID_MeshEntity(mvIds[i]);		
			
			float fDecalFadeTime = fFadeTime * mvFadeTimeMuls[i];			
			float fDecalFadeCount = mfFadeCount;	
	
			if (fDecalFadeCount > fDecalFadeTime)
				fDecalFadeCount = fDecalFadeTime;
			
			float fT = fDecalFadeCount / fDecalFadeTime;
			fT = cMath_Easing(eEasing_CubicIn, fT);
			fT = cMath_Max(fT, fMinT);
			
			pMeshEnt.SetCoverageAmount(fT * 0.1f);
			pMeshEnt.SetIlluminationColor((cColor(0.f) * (1.f - fT) + cColor_White * fT) * 1.8f);
			
			if (fT < 1.f)
				bFadeOut = false;
			if (fT > fMinT)
				bStop = false;
			if (fT < 0.3f)
				bColorPS = false;				
		}
		
		//////////////////
		// Fade PS color
		if (mlState == 1 && bColorPS)
		{
			cParticleSystem@ pPS = cLux_ID_ParticleSystem(m_idPS);
			if (pPS !is null)
				pPS.SetColor(pPS.GetColor() * (1.f - afTimeStep) + cColor(1,0.1,0.1,0.3) * afTimeStep);
		}
		
		//////////////////
		// At max, spawn flesh and fade back down!
		if (mlState == 1 && bFadeOut)
		{
			mlState = 0;
			
			cParticleSystem@ pPS = cLux_ID_ParticleSystem(m_idPS);
			if (pPS !is null)
				pPS.Kill();
				
			Map_AddTimer(msName, 0.f, "OnTimer_BreakVitaePipe_Step3");
		}		
		
		//////////////////
		// Stop?
		if (mlState == 0 && bStop)
		{				
			mvIds.resize(0);
			mvFadeTimeMuls.resize(0);
			return true;
		}
		
		return false;
	}
	
	//--------------------------------------------------
	
	int mlState;
	float mfFadeCount;
	float mfFadeTimeMul;
	
	tID m_idPS;
	tString msName;
	
	array<tID> mvIds(0);
	array<float> mvFadeTimeMuls(0);
	
	//--------------------------------------------------
}

//--------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("04-03-undercity-b");
		
		// Reset effects
		Effect_Bloom_FadeBrightPass(0.75f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(0.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		Pregnancy_SetStage(ePregStage_BornRecovered);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Born);
		Pregnancy_SetBabyKicksEnabled(false);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingGhoul);
		Player_SetAllowCheckBaby(true);
		FearHandler_SetWhisperStage(eFearWhisperStage_BirthToThroneRoom);
		
		Player_SetCameraFarPlane(8192.0f);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(2);
		StruggleFlashHandler_PreloadFlashGroupTextures(3);
		StruggleFlashHandler_PreloadFlashGroupTextures(4);
		StruggleFlashHandler_PreloadFlashGroupTextures(5);
		StruggleFlashHandler_PreloadFlashGroupTextures(6);
		StruggleFlashHandler_SetProgression(2);
		
		cScript_SetGlobalVarBool("Global_LanternLost", true);
		
		Player_SetAutoTeleportWhenBelowAltitude(-50.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("ps_impact_metal_high.ps");
		ParticleSystem_Preload("sparks_small.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		///////////////
		// Preload sounds
		//Sound_PreloadProject("04_03_undercity");
				
		///////////////
		// Preload entities
		Entity_Preload("dw_solidifier_syringe_rigid_filled.ent");
		Entity_Preload("player_breastfeed.ent");
		Entity_Preload("player6.ent");
		
		///////////////
		// Preload materials
		int lProgression = GhoulProgression_GetProgression();
		Material_Preload("Tasi_Body_Upgrade_hands_ghoul_" + lProgression + ".mat");
		
		if (lProgression >= GHOUL_PROGRESSION_MIRROR_HIGH)
			msBreastFeedMaterial = "tasi_breastfeed_v2_03.mat";
		else if (lProgression >= GHOUL_PROGRESSION_MIRROR_MED)
			msBreastFeedMaterial = "tasi_breastfeed_v2_02.mat";
		else
			msBreastFeedMaterial = "tasi_breastfeed_v2.mat";
		
		Material_Preload(msBreastFeedMaterial);
		
		Sound_PreloadGhost();
		
		Sound_PreloadEvent("03_07_DW_theatre/canister_unplug/small/small_insert");
		Sound_PreloadEvent("03_07_DW_theatre/canister_unplug/small/small_remove");
		Sound_PreloadEvent("04_03_undercity/machine/energy_off");
		Sound_PreloadEvent("creatures/foley/creature/wraith/Turns_on_light");
		Sound_PreloadEvent("creatures/foley/creature/wraith/Turns_off_light");
		Sound_PreloadEvent("player/foley/damage/player_shadow_hit");
		Sound_PreloadEvent("03_04_pillar_room/pillar_activate/pillar_energy_burst");
		Sound_PreloadEvent("03_03_herberts_hq/beam_filter/beam_filter_correct");
		Sound_PreloadEvent("03_03_herberts_hq/beam_filter/beam_filter_misaligned");
		Sound_PreloadEvent("04_03_undercity/ending/rock_impacts");
		Sound_PreloadEvent("04_03_undercity/doctor_death/doctor_death_anim");
		Sound_PreloadEvent("04_03_undercity/doctor_death/doctor_death_player");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(20);
		
		// Any general setup of script / entities
		
		/////////////////////////
		// Debug
		if (cLux_ScriptDebugOn())
		{
			GhoulProgression_SetPermafailFadeProgression(GhoulProgression_GetMaxProgression());
			
			if (ItemType_GetCountInInventory("ShadowFleshCanister") == 0)
			{
				Item_AddToInventory("ShadowFleshCanister");
				Item_AddToInventory("Matchbook");
				Item_AddToInventory("ShadowFleshVial");
				Item_SetContent(ItemType_GetFirstInInventory("ShadowFleshVial"), "ShadowFleshPowder", 4);
			}
			
			if (ItemType_GetCountInInventory("VitaeCanister") == 0)
			{
				Item_AddToInventory("VitaeCanister");
			}
		}
		
		Player_SetAllowCheckBaby(false);
		Player_SetVertigoActive(false);
		Player_SetJumpDisabled(false);
		
		Visibility_SetAreaActive("*", false); // Manually activating these in this level
		Visibility_SetAreaActive("VisibilityArea_ThroneRoom", true); 
								
		////////////////////////////
		// Set up Portal Room				
		Entity_SetEffectBaseColor("Portal_Destination_Paris", cColor(0.f));
		Entity_SetEffectBaseColor("Portal_Destination_Town", cColor(0.f));
		Entity_SetEffectBaseColor("Portal_Destination_DW", cColor(0.f));
		
		SetVitaeLidOpen(true);
		SetPortalButtonActive(true, true);
		
		////////////////////////////
		// Set up Throne Room		
		Entity_SetActive("Cover_*", true);
		
		Entity_PlayAnimation("TH_Beam_Closed", "open_up", 0.f, false);
		Map_GetEntity("TH_Beam_Closed").GetMeshEntity().GetAnimationStateFromName("open_up").SetPaused(true);
		
		for (int i = 1; i < 4; ++i)
		{
			SetupAccessPointUvAnimation("VitaeAccessPoint_" + i);				
			Billboard_SetVisible("Billboard_VitaeMap_Off_" + i + "_*", false);
			Billboard_SetVisible("Billboard_VitaeMap_TH_Off_" + i, false);
		}
		
		// Setup crack decals
		array<cMeshEntity@> vOut;
		Map_GetDecalArray("Decal_VitaeValvePipe_*", vOut);
		for (int i = 0; i < vOut.size(); ++i)
		{
			cMeshEntity@ pMeshEnt = vOut[i];
			pMeshEnt.SetCoverageAmount(0.f);
			
			int lPos = cString_GetFirstStringPos(pMeshEnt.GetName(), "Crack");
			int lLength = lPos == 25 ? 32 : 34;
			
			tString sName = cString_Sub(pMeshEnt.GetName(), 0, lLength);
			if (m_setPipeCracks.Exists(sName) == false)
				m_setPipeCracks.Add(sName);
		}
		
		Entity_PlayProcAnimation("Cog_Canister_1_1", "Spin", 1.f, true, 0.f);
		Entity_PlayProcAnimation("Cog_Canister_2_1", "Spin", 1.f, true, 0.f);
		Entity_PlayProcAnimation("Cog_Canister_3_1", "Spin", 1.f, true, 0.f);
		
		SetCanisterActive(1, true, true);
		SetCanisterActive(2, true, true);		
		SetCanisterActive(3, false, true);		
		SetCanisterActive(4, false, true);
		
		////////////////////////////
		// Set up flesh
		Decal_SetDynamicVisible("Decal_DoctorBlood_*", false);
		ShadowFlesh_SetupDecals("Decal_ShadowFlesh_*");
		
		for (int i = 1; i < 4; ++i)
		{
			for (int j = 1; j < 8; ++j)
			{
				if (j == 4)
					continue;
				
				Entity_AddCollideCallback("player", "ShadowFlesh_VitaeValvePipe_" + i + "_" + j + "_*", "OnCollide_Player_ShadowFlesh");
			}
		}
		
		Entity_AddCollideCallback("player", "ShadowFlesh_VitaeValveExterior_*", "OnCollide_Player_ShadowFlesh");
		Entity_AddCollideCallback("player", "ShadowFlesh_Ground_*", "OnCollide_Player_ShadowFlesh");
				
		////////////////////////////
		// Set up Nursery		
		SetCanisterActive(5, true, true);
		Entity_PlayAnimation("BabyCarried", "baby_idle_crib_crying_pre_pickup", 0.f, true);
		Entity_StopAnimation("CribLid");
		
		Entity_AttachToSocket("BlockBox_CribMiddle", "CribLid", "MiddleSocket", true, false);
		Entity_AttachToSocket("BlockBox_CribLeft", "CribLid", "LeftSocket", true, false);
		Entity_AttachToSocket("BlockBox_CribRight", "CribLid", "RightSocket", true, false);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		//sky rotation
		cVector3f vRot = cVector3f(0, cMath_ToRad(123), 0); //old value 110
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);
		
		// Setup physics world
		cLuxArea@ pArea = cLux_ToArea(mBaseObj.GetEntityByName("Area_PhysicsWorld", eLuxEntityType_Area));
		cBoundingVolume@ pAreaBounds = pArea.GetAreaBody().GetBoundingVolume();
		mBaseObj.GetPhysicsWorld().SetWorldSize(pAreaBounds.GetMin(), pAreaBounds.GetMax());
		
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		PlayerBody_SetActive(true);
		
		Player_SetJumpForceMul(1.f);		
		Player_SetMapDeepShadow(0.f);
		
		ResetPlayerMoveSpeed();
		
		FearHandler_SetPermaFailEnabled(false);
		FearHandler_SetPermaFailTriggerAnimation("permafail_trigger_baby");
		FearHandler_SetPermaFailPlayVocals(false);
		FearHandler_SetPermafailBabySceneEnabled(false, false);
		
		RiftHandler_SetAllowHint(false);
		
        Heat_SetActive(false);
		
		Blackboard_AddWraithBillboards("WraithBillboard");
		
		ParticleSystem_SetActive("PS_OpenUp_*", false);
		
		ItemType_RemoveFromInventory("CurseMedallion");
	}

	//-------------------------------------------------------
	
	[nosave] bool mbLoaded = false;
	void OnLoad()
	{
		mbLoaded = true;
		for (int i = 1; i < 4; ++i) SetupAccessPointUvAnimation("VitaeAccessPoint_" + i);	
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Player_RestoreClipPlane();
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail()
	{
		// Preload DW
		Map_Preload("04_05_darkworld.hpm");
		
		if (mlPermaFailId == 0)			return OnPermaFail_EncounterFailure();
		else if (mlPermaFailId == 1)	return OnPermaFail_DarkWorld();
		
		return true;		
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		///////////////////
		// Breastfeed baby!
		if (alAction == eAction_CheckBaby)
		{
			if (Map_TimerExists("Timer_StartBreastfeed") == false)
				Map_AddTimer("Timer_StartBreastfeed", 0.4f, "OnTimer_StartBreastfeed");
		}
		
		if (alAction == eAction_Test0)
		{
			Player_Teleport("Start_Begin");
		}
		
		if (alAction == eAction_Test1)
		{			
			Entity_SetEffectsActive("VitaeValvePipe_2_*", false, false);
			Entity_SetEffectsActive("VitaeValvePipe_3_*", false, false);
			
			Entity_SetActive("ShadowFlesh_Ceiling_2_*", true);
			Light_FadeBrightnessTo("Light_ShadowFleshCeiling_1_*", 0.5f, 3.f);
			Entity_SetActive("ShadowFlesh_Ceiling_3_*", true);
			Light_FadeBrightnessTo("Light_ShadowFleshCeiling_3_*", 0.5f, 3.f);
			
			TempSetupThroneRoomEncounter();
			SlideDoor_SetClosed("NurseryDoor_*", true, false);
			
			TinHinan_SetSpotlightSoundVolumeMul("TH_Beam", 1.f);
			TinHinan_SetSpotlightOn("TH_Beam", true);
			TinHinan_StopSpotlightFollow("TH_Beam");
			TinHinan_SetPassive("TH_Beam", false);	
			
			Player_Teleport("Start_VitaeValve_1");
			SlideDoor_SetClosed("AccessPointDoor_*", false, true);
			Entity_SetActive("AccessPointDoorBlocker_*", false);
			mlVitaeValveToDestroy = 1;
			mvActiveVitaeValveIds.resize(0);
			Seq_DestroyVitaeValve("");
		}
		
		if (alAction == eAction_Test2)
		{
			Entity_SetEffectsActive("VitaeValvePipe_1_*", false, false);
			Entity_SetEffectsActive("VitaeValvePipe_3_*", false, false);
			
			Entity_SetActive("ShadowFlesh_Ceiling_1_*", true);
			Light_FadeBrightnessTo("Light_ShadowFleshCeiling_1_*", 0.5f, 3.f);
			Entity_SetActive("ShadowFlesh_Ceiling_3_*", true);
			Light_FadeBrightnessTo("Light_ShadowFleshCeiling_3_*", 0.5f, 3.f);
			
			TempSetupThroneRoomEncounter();
			SlideDoor_SetClosed("NurseryDoor_*", true, false);
			
			TinHinan_SetSpotlightSoundVolumeMul("TH_Beam", 1.f);
			TinHinan_SetSpotlightOn("TH_Beam", true);
			TinHinan_StopSpotlightFollow("TH_Beam");
			TinHinan_SetPassive("TH_Beam", false);	
			
			Player_Teleport("Start_VitaeValve_2");
			SlideDoor_SetClosed("AccessPointDoor_*", false, true);
			Entity_SetActive("AccessPointDoorBlocker_*", false);
			mlVitaeValveToDestroy = 2;
			mvActiveVitaeValveIds.resize(0);
			Seq_DestroyVitaeValve("");
		}
		
		if (alAction == eAction_Test3)
		{
			Entity_SetEffectsActive("VitaeValvePipe_1_*", false, false);
			Entity_SetEffectsActive("VitaeValvePipe_2_*", false, false);
			
			Entity_SetActive("ShadowFlesh_Ceiling_1_*", true);
			Light_FadeBrightnessTo("Light_ShadowFleshCeiling_1_*", 0.5f, 3.f);
			Entity_SetActive("ShadowFlesh_Ceiling_2_*", true);
			Light_FadeBrightnessTo("Light_ShadowFleshCeiling_2_*", 0.5f, 3.f);
			
			TempSetupThroneRoomEncounter();
			SlideDoor_SetClosed("NurseryDoor_*", true, false);
			
			TinHinan_SetSpotlightSoundVolumeMul("TH_Beam", 1.f);
			TinHinan_SetSpotlightOn("TH_Beam", true);
			TinHinan_StopSpotlightFollow("TH_Beam");
			TinHinan_SetPassive("TH_Beam", false);	
			
			Player_Teleport("Start_VitaeValve_3");
			SlideDoor_SetClosed("AccessPointDoor_*", false, true);
			Entity_SetActive("AccessPointDoorBlocker_*", false);
			mlVitaeValveToDestroy = 3;
			mvActiveVitaeValveIds.resize(0);
			Seq_DestroyVitaeValve("");
		}
		
		if (alAction == eAction_Test4)
		{
			cLux_SetScriptDebugOn(false);
			
			Player_SetMoveSpeedMul(gfUndercityPlayerMoveSpeedMul);
			Player_SetRunSpeedMul(gfUndercityPlayerRunSpeedMul);
			
			Player_Teleport("Start_PortalRoomEnd");
			
			Pregnancy_SetStage(ePregStage_BornRecovered);
			
			cScript_SetGlobalVarBool("DWF_TasiHasTortured", true);
		}
		
		if (alAction == eAction_Test5)
