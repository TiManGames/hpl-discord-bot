		//-------------------------------------------------------
		
		void OnVoiceEnd_GhostAppear(const tString &in asScene, const tString &in asSubject)
		{
			if (mlGhostAppearLineId == 5)
			{
				Map_AddTimer("Timer_PlaySickChildMicroflash", 0.1f, "OnTimer_PlaySickChildMicroflash");
				return;
			}
			
			Voice_PlayDelayed("Dialogue_GhostAppear", mlGhostAppearLineId == 2 ? 2.f : 0.1f, mlGhostAppearLineId, "OnVoiceEnd_GhostAppear");
			mlGhostAppearLineId++;			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlaySickChildMicroflash(const tString &in asTimer)
		{
			Sketchbook_Microflash("Microflash_SickChild", "OnMicroflashEnd_SickChild");
