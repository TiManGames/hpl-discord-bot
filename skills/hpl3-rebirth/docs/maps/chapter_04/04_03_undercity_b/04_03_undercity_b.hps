				Map_AddTimer("Timer_MusicYesTorture", 33.2f, "OnTimer_PlayDialougeMusic");
			}
			else
			{
				Dialog_AddBranchAndSubject("Dialogue_AfterSicknessRevealNotTortured");
				Map_AddTimer("tinhinan_throne_room_no_torture", 8.f, "OnTimer_PlayGhostDialogueAnim");
				Map_AddTimer("Timer_MusicNoTorture", 28.3f, "OnTimer_PlayDialougeMusic");
			}
			
			Dialog_End();
			
			Map_AddTimer("Timer_StopConfrontationEndAnimation", 2.f, "OnTimer_StopConfrontationEndAnimation");
		}
		
