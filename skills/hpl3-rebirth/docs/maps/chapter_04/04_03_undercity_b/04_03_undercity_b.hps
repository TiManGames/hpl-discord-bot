		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 11, Event A here.*/
		
		void OnInteract_AccessPointDoorButton(const tString &in asEntity)
		{
			int lId = cString_ToInt(cString_Sub(asEntity, 16, 1), 0);
			if (Entity_IsActive("VitaeCanister_" + lId) == false)
			{
				float fBrightness = lId != 4 ? 4.f : 12.f;				
				Light_FadeBrightnessTo("Light_NoCanister_" + lId + "_*", fBrightness, 0.5f, eEasing_SineIn);
				
				Map_AddTimer("Timer_ResetNoCanisterLight_Step1", 0.5f, "OnTimer_ResetNoCanisterLight_Step1");
				Map_SetTimerUserVarInt("Timer_ResetNoCanisterLight_Step1", lId);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetNoCanisterLight_Step1(const tString &in asTimer)
		{
			int lId = Map_GetTimerUserVarInt(asTimer);
			Sound_CreateAtEntity("Sound_NoCanister", "03_07_dw_factory/torture_victim/machine_feedback/button_negative", "VitaeCanister_" + lId);
			
			Map_AddTimer("Timer_ResetNoCanisterLight_Step2", 0.5f, "OnTimer_ResetNoCanisterLight_Step2");
			Map_SetTimerUserVarInt("Timer_ResetNoCanisterLight_Step2", lId);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetNoCanisterLight_Step2(const tString &in asTimer)
		{
			int lId = Map_GetTimerUserVarInt(asTimer);
			
			float fBrightness = lId != 4 ? 1.f : 2.f;
			Light_FadeBrightnessTo("Light_NoCanister_" + lId + "_*", fBrightness, 0.5f, eEasing_SineOut);
		}
		
		//-------------------------------------------------------
				
		bool CanUse_VitaeCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
         {
			 for (int i = 1; i < 6; i++)
			 {
				 tString sArea = "InteractArea_PlaceVitaeCanister_" + i;
				 if (asPickedEntity == sArea)
					 return true;
					 
				 tString sBrokenCanister = "BrokenVitaeCanister_" + i;
				 if (Entity_GetCollide(sBrokenCanister, sArea) && asPickedEntity == sBrokenCanister)
					 return true;
			 }
			 
			 return false;
         }
         
         //-------------------------------------------------------
         
         bool OnUse_VitaeCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, 
                                  const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
         {			 
			 ////////////////////
			 // Other canisters
			 int lId = cString_GetNumericSuffixInt(asTargetEntity);			 
			 SetCanisterActive(lId, true);
			 
			 Item_Unequip(asItemID);
			 Item_RemoveFromInventory(asItemID);
			 
			 tString sBrokenCanister = "BrokenVitaeCanister_" + lId;
			 if (Entity_GetCollide(sBrokenCanister, asTargetEntity))
			 {
				 Prop_SetStaticPhysics(sBrokenCanister, false);				 
				 Body_AddImpulse(sBrokenCanister + "_Body_1", cVector3f(0.f, 0.5f, -1.5f), true);
			 }
             return true;
         }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_PickUpVitaeCanister(const tString &in asEntity)
		 {
			 int lId = cString_GetNumericSuffixInt(asEntity);
			 SetCanisterActive(lId, false);
			 
			 Item_AddToInventory("VitaeCanister", true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetCanisterActive(int alId, bool abX, bool abOnLoad = false)
		 {
			 Entity_SetActive("VitaeCanister_" + alId, abX);
			 Entity_SetActive("InteractArea_PlaceVitaeCanister_" + alId, abX == false);
			 
			 if (abX)
			 {
				 Entity_SetCollide("VitaeCanister_" + alId, false);
				 Map_AddTimer("VitaeCanister_" + alId, 1.f, "OnTimer_ActivateCanisterCollision");
			 }
			 
			 if (abOnLoad == false)
			 {
				 if (abX)
					Sound_PlayGui("03_07_DW_theatre/canister_unplug/small/small_insert", 1.f, eSoundEntryType_GuiWorld);
				 else
					 Sound_PlayGui("03_07_DW_theatre/canister_unplug/small/small_remove", 1.f, eSoundEntryType_GuiWorld);
			 }
			 
			 tString sTimerA = "Timer_DoCanisterEffects_Step_1_" + alId;
			 tString sTimerB = "Timer_DoCanisterEffects_Step_2_" + alId;
			 tString sTimerC = "Timer_DoCanisterEffects_Step_3_" + alId;
			 tString sTimerD = "Timer_DoCanisterEffects_Step_4_" + alId;
			 tString sLock = "CanisterLock_" + alId;
			 
			 Map_RemoveTimer(sTimerA);
			 Map_RemoveTimer(sTimerB);
			 Map_RemoveTimer(sTimerC);
			 Map_RemoveTimer(sTimerD);
			 Map_RemoveTimer("CanisterPipe_" + alId + "_1");
			 Map_RemoveTimer("CanisterPipe_" + alId + "_2");
			 Map_RemoveTimer("Timer_ResetNoCanisterLight_Step1");
			 Map_RemoveTimer("Timer_ResetNoCanisterLight_Step2");
			 
			 for (int i = 1; i < 5; ++i)
				 Map_RemoveTimer(sLock + "_" + i);
			 
			 if (abX)
			 {
				 Map_AddTimer(sTimerA, 0.001f, "OnTimer_DoCanisterEffects_Step1");
				 Map_AddTimer(sTimerB, 0.9f, "OnTimer_DoCanisterEffects_Step2");
				 Map_AddTimer(sTimerC, 1.6f, "OnTimer_DoCanisterEffects_Step3");
				 Map_AddTimer(sTimerD, 2.1f, "OnTimer_DoCanisterEffects_Step4");
				 
				 for (int i = 1; i < 5; ++i)
				 {
					 tString sLockTimer = sLock + "_" + i;
					 Map_AddTimer(sLockTimer, i * 0.2f, "OnTimer_PlayLockAnim");
					 Map_SetTimerUserVarInt(sLockTimer, 1);
				 }
				 
				 ///////////////////////
				 // Portal specifics
				 if (alId == 4)
				 {
					 PlacePortalOrb(true);
					 Map_AddTimer("Timer_CloseVitaeLid", 1.f, "OnTimer_CloseVitaeLid");
				 }
			 }
			 else
			 {
				 Map_AddTimer(sTimerA, 0.001f, "OnTimer_DoCanisterEffects_Step1");
				 Map_AddTimer(sTimerB, 0.3f, "OnTimer_DoCanisterEffects_Step2");
				 Map_AddTimer(sTimerC, 0.001f, "OnTimer_DoCanisterEffects_Step3");
				 Map_AddTimer(sTimerD, 0.001f, "OnTimer_DoCanisterEffects_Step4");
				 
				 for (int i = 1; i < 5; ++i)
				 {
					 tString sLockTimer = sLock + "_" + i;
					 Map_AddTimer(sLockTimer, (4.f - (i - 1.f)) * 0.2f, "OnTimer_PlayLockAnim");
					 Map_SetTimerUserVarInt(sLockTimer, 0);
				 }
			 }
			 
			  Map_SetTimerUserVarInt(sTimerA, alId);
			  Map_SetTimerUserVarInt(sTimerB, alId);
			  Map_SetTimerUserVarInt(sTimerC, alId);
			  Map_SetTimerUserVarInt(sTimerD, alId);
			  Map_SetTimerUserVarString(sTimerA, abX ? "on" : "off");
			  Map_SetTimerUserVarString(sTimerB, abX ? "on" : "off");
			  Map_SetTimerUserVarString(sTimerC, abX ? "on" : "off");
			  Map_SetTimerUserVarString(sTimerD, abX ? "on" : "off");
			  
			  if (alId == 5)
			  {
				  Entity_SetInteractionDisabled("InteractArea_PlaceVitaeCanister_5", true);
				  Entity_SetInteractionDisabled("VitaeCanister_5", true);
			  }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ActivateCanisterCollision(const tString &in asTimer)
		 {
			 Entity_SetCollide(asTimer, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayLockAnim(const tString &in asTimer)
		 {
			  bool bX = Map_GetTimerUserVarInt(asTimer) == 1;
			  Entity_PlayProcAnimation(asTimer, "Close", 0.3f * (bX ? 1.f : -1.f));
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoCanisterEffects_Step1(const tString &in asTimer)
		 {
			 int lId = Map_GetTimerUserVarInt(asTimer);
			 bool bX = Map_GetTimerUserVarString(asTimer) == "on";
			 
			 float fNoCanisterLight = 1.f;
			 if (lId == 4 || lId == 5)	
				 fNoCanisterLight = 2.f;
				 
			 Light_FadeBrightnessTo("Light_NoCanister_" + lId + "_*", bX ? 0.f : fNoCanisterLight, 0.3f, bX ? eEasing_SineOut : eEasing_SineIn);	 
			 
			 if (lId < 4)
			 {
				 tString sSound = "Sound_CanisterActive_" + lId;
				 if (bX)	Sound_CreateAtEntity(sSound, "04_03_undercity/machine/energy", "VitaeCanister_" + lId, 4.f);
				 else		Sound_Stop(sSound, 1.f);
			 }			 
					 
			 Sound_PlayGui("level_entity_shared/doors/undercity_door/stop", 0.5f, eSoundEntryType_GuiWorld);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoCanisterEffects_Step2(const tString &in asTimer)
		 {
			 int lId = Map_GetTimerUserVarInt(asTimer);
			 bool bX = Map_GetTimerUserVarString(asTimer) == "on";
			 
			 if (bX == false && lId == 5)
			 {
				 Lamp_SetLit("CanisterLamp_" + lId, bX, true);
				 SetCribOpen(bX);
				 ParticleSystem_SetBrightness("PS_17", 1.f);
			 }
			 
			  if (lId > 3)
				  return;
			 
			 if (bX == false)
				 Lamp_SetLit("CanisterLamp_" + lId, bX, true);
			 			 
			 tString sPipe = "CanisterPipe_" + lId + "_";
			 Map_AddTimer(sPipe + 1, cMath_RandRectf(0.f, 0.3f), "OnTimer_SetCanisterPipeState");
			 Map_AddTimer(sPipe + 2, cMath_RandRectf(0.f, 0.3f), "OnTimer_SetCanisterPipeState");
			 Map_SetTimerUserVarInt(sPipe + 1, bX ? 1 : 9);
			 Map_SetTimerUserVarInt(sPipe + 2, bX ? 1 : 9);
			 
			 tString sCog = "Cog_Canister_" + lId + "_1";
			 if (bX)	Entity_FadeProcAnimationSpeed(sCog, "Spin", 0.75f, cMath_RandRectf(1.5f, 2.5f));
			 else		Entity_FadeProcAnimationSpeed(sCog, "Spin", 0.f, cMath_RandRectf(2.f, 5.f));
			 
			 if (bX == false)
				 SlideDoor_SetClosed("AccessPointDoor_" + lId + "_1", true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetCanisterPipeState(const tString &in asTimer)
		 {
			 Lamp_SetLit(asTimer, Map_GetTimerUserVarInt(asTimer) == 1, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoCanisterEffects_Step3(const tString &in asTimer)
		 {
			 int lId = Map_GetTimerUserVarInt(asTimer);
			 bool bX = Map_GetTimerUserVarString(asTimer) == "on";
			 
			 //////////////////
			 // Access point canisters
			 if (lId < 4 || lId == 5)
			 {
				 if (bX)
				 {
					 Lamp_SetLit("CanisterLamp_" + lId, bX, true);
					 Sound_CreateAtEntity("Sound_SpotOn", "03_07_dw_factory/spotlight/on", "CanisterLamp_" + lId);
					 
					 if (lId == 5)
					 {
						 SetCribOpen(bX);
						 ParticleSystem_SetBrightness("PS_17", 2.f);
					 }
				 }
			 } 
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoCanisterEffects_Step4(const tString &in asTimer)
		 {
			 int lId = Map_GetTimerUserVarInt(asTimer);
			 bool bX = Map_GetTimerUserVarString(asTimer) == "on";
			 
			 if (lId > 3)
				 return;
			 
			 tString sButton = "AccessPointDoor_" + lId + "_Button";
			 MovingButton_SetLocked(sButton + "_*", bX == false, true);
			 Entity_SetActive("AccessPointDoorBlocker_" + lId, bX == false);
			 
			 if (bX)
				Sound_CreateAtEntity("Sound_CanisterButtonOn", "03_07_dw_factory/torture_victim/machine_feedback/button_positive", sButton + "_1");
		 }
		
		//-------------------------------------------------------
		
		void SetupAccessPointUvAnimation(const tString &in asAccessPoint)
		{
			Prop_SetUvAnimationTime(asAccessPoint, "vitae_pipe_glow_low", 0.f);
			Prop_SetUvAnimationTime(asAccessPoint, "vitae_pipe2_glow_low", 0.f);
			Prop_SetUvAnimationSpeed(asAccessPoint, "vitae_pipe_glow_low", 0.f);
			Prop_SetUvAnimationSpeed(asAccessPoint, "vitae_pipe2_glow_low", 0.f);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_SpotVitaeValve(const tString &in asEntity, int alState)
		{
			Sketchbook_AddIdea("destroy_darkworld");
			Entity_SetActive("Trigger_SpotVitaeValve_*", false);
		}
		
		//-------------------------------------------------------
		
		bool CanUse_ShadowFleshCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{
			for (int i = 1; i < 4; ++i)
			{
				if (asPickedEntity == "VitaeAccessPoint_" + i && mfVitaeValveT[i - 1] < 0.43f)
				{
					Item_ShowShadowFleshVialCount(ShadowFleshVials_GetCount() == 0, false);
					return true;
				}
			}			
			return false;
		}
		 
		//-------------------------------------------------------
		 
		bool OnUse_ShadowFleshCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, 
									   const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			if (mbInjectingShadowFlesh) return false;
			if (ShadowFleshInjector_GetAmount() <= 0)
			{
				Item_FlashItemCount(2);
				return false;
			}
			
			int lId = cString_GetNumericSuffixInt(asTargetEntity);
			if (mvVitaeValveIdsWithSolidifier.find(lId) != -1)
				return true;		
			
			////////////////////
			// Only allow once per valve
			mvVitaeValveIdsWithSolidifier.push_back(lId);
			Entity_SetInteractionDisabled(asTargetEntity, true);
			
			ShadowFleshInjector_ReduceAmount();
			Item_Unequip(asItemID);
			
			////////////////////
			// Bark!
			if (mvActiveVitaeValveIds.size() == 1)
			{
				Voice_StopScenesWithCharacter("Player");
				Voice_Play("Dialogue_AboutToTurnFinalValve");
			}
			
			////////////////////
			// Inject pipe!
			mlInjectedAccessPoint = lId;
			Seq_InjectAccessPoint("");
			return true;
		}
		
		//-------------------------------------------------------
				
		cSequenceStatesData mSeqDataInjectAccessPoint;
		void Seq_InjectAccessPoint(const tString &in asTimer)
		{
			tString sAccessPoint = "VitaeAccessPoint_" + mlInjectedAccessPoint;
			tString sInjector = "Injector_" + mlInjectedAccessPoint;
			tString sInjectorOrigin = "InjectorOrigin_" + mlInjectedAccessPoint;
			tString sInjectorTarget = "InjectorTarget_" + mlInjectedAccessPoint;
			
			Sequence_Begin("Seq_InjectAccessPoint", mSeqDataInjectAccessPoint);
			if (Sequence_DoStepAndWait(1.f))
			{
				mbInjectingShadowFlesh = true;
				
				// TODO: Remove this stuff when we have proper animations!
				iLuxEntity@ pEnt = Map_GetEntity(sAccessPoint, eLuxEntityType_Prop);
			
				cVector3f vInjectorRot = cVector3f(3.12f, -0.420f, 2.936f);
				cVector3f vInjectorRofOffset = cVector3f(0.f, -0.25f, 3.14f);
				cVector3f vInjectorPos = cVector3f(0.165f, -0.0275f, 0.25f);
				
				cMatrixf mtxInjector = cMath_MatrixMul(cMath_MatrixRotateXYZ(vInjectorRot), cMath_MatrixRotateXYZ(vInjectorRofOffset));
				mtxInjector.SetTranslation(vInjectorPos);			
				mtxInjector = cMath_MatrixMul(pEnt.GetMatrix(), mtxInjector);
				
				mBaseObj.CreateEntity(sInjectorOrigin, "dw_solidifier_syringe_rigid_filled.ent", mtxInjector, cVector3f(0.25f));
				Entity_SetActive(sInjectorOrigin,false);
				
				Sound_CreateAtEntity("Sound_DrawInjector","new_sounds/animations/draw_holser/draw_injection","player");
				
				mBaseObj.CreateEntity(sInjector, "dw_solidifier_syringe_rigid_filled.ent", mtxInjector, cVector3f(0.25f));
				Entity_SetActive(sInjector,false);
				Prop_SetActiveAndFade(sInjector,true,0.5f);
				Entity_StopAnimation(sInjector);
				
				cMatrixf mtxInjectorTarget = mtxInjector;
				mtxInjectorTarget = cMath_MatrixMul(mtxInjector, cMath_MatrixTranslate(cVector3f_Forward * 0.1f));
				
				mBaseObj.CreateEntity(sInjectorTarget, "dw_solidifier_syringe_rigid_filled.ent", mtxInjectorTarget, cVector3f(0.25f));
				Entity_SetActive(sInjectorTarget, false);
				
				Prop_MoveLinearTo(sInjector, sInjectorTarget, 0.05f, 0.2f, 0.1f, false);				
			}
			else if (Sequence_DoStepAndWait(0.75f))
			{
				Entity_PlayAnimation(sInjector, "interact");
				Map_AddTimer(sInjector, 1.f / 60.f, "OnTimer_KillSyringeEffects");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				ParticleSystem_CreateAtEntity("PS_Powder_" + mlInjectedAccessPoint, "dark_world_vitae_inject_shadow_powder.ps", "Area_AccessPointCloud_" + mlInjectedAccessPoint, false);
				Sound_CreateAtEntity("Sound_PlacePowder", "02_03_arsenal/temp/coal_powder", sAccessPoint);
				
				///////////////
				// Screen starts flashing
				Map_AddTimer("Timer_VitaeMapFlash_" + mlInjectedAccessPoint, 0.f, "OnTimer_VitaeMapFlash");
			}
			else if (Sequence_DoStepAndWait(0.4))
			{
				Prop_StopMovement(sInjector);
				Prop_MoveLinearTo(sInjector, sInjectorOrigin, 1.f, 0.2f, 0.1f, false);
			}
			else if (Sequence_DoStepAndWait(0.4))
			{
				Prop_SetActiveAndFade(sInjector,false,0.3f);
				Sound_CreateAtEntity("Sound_DrawInjector","new_sounds/animations/draw_holser/holster_injection","player");
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				iLuxEntity@ pInjector = Map_GetEntity(sInjector, eLuxEntityType_Prop);
				iLuxEntity@ pInjectorTarget = Map_GetEntity(sInjectorTarget, eLuxEntityType_Prop);
				
				if (pInjector !is null)
					mBaseObj.DestroyEntity(pInjector);					
				if (pInjectorTarget !is null)
					mBaseObj.DestroyEntity(pInjectorTarget);
				
				mbInjectingShadowFlesh = false;
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_KillSyringeEffects(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asTimer, eLuxEntityType_Prop);
			if (pEnt is null)
				return;
				
			cParticleSystem@ pPS = pEnt.GetParticleSystemFromName("PS_1");
			if (pPS is null)
				return;
			
			float fBrightness = pPS.GetBrightness() - 3.f * (1.f / 60.f);
			if (fBrightness < 0.f)
				fBrightness = 0.f;
			
			pPS.SetBrightness(fBrightness);
			
			if (fBrightness <= 0.f)
				return;
				
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void OnInteract_VitaeValve(const tString &in asEntity)
		{						
			int lId = cString_GetNumericSuffixInt(asEntity);
			if (mvActiveVitaeValveIds.find(lId) == -1)
				return;
			
			msCurrentVitaeValve = asEntity;
			mlVitaeValveToUpdate = lId;
			
			ResetEncounterDialogue();
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_VitaeValve(const tString &in asEntity)
		{						   
			Wheel_SetAngle(asEntity, 0.f, true);
		}
		
		//-------------------------------------------------------
		
		void UpdateVitaeValve(float afTimeStep)
		{	
			if (mlVitaeValveToUpdate == -1)
				return;
				
			///////////////
			// Setup vars
			iLuxEntity@ pEnt = mBaseObj.GetEntityByName(msCurrentVitaeValve, eLuxEntityType_Prop);
			bool bPowderActive = mvVitaeValveIdsWithSolidifier.find(mlVitaeValveToUpdate) != -1;
			tString sAccessPoint = "VitaeAccessPoint_" + mlVitaeValveToUpdate;
			int lValveId = mlVitaeValveToUpdate - 1;
			
			if (pEnt is null)
				return;
			
			///////////////
			// Time
			float fPrevT = mfVitaeValveT[lValveId];
			float fGoal = Wheel_GetRotationAmount(msCurrentVitaeValve);
			
			if (mfVitaeValveT[lValveId] >= 0.43f)
			{
				if (fGoal >= 0.95f)	fGoal = 2.f;
				else 				fGoal = 1.f;
			}
			
			bool bPastHalfway = mvVitaeValveIdsPastHalfway.find(mlVitaeValveToUpdate) != -1;			
			if (bPastHalfway)
			{
				fGoal = 2.f;
				pEnt.SetInteractionDisabled(true);
			}

			mfVitaeValveT[lValveId] = cMath_IncreaseTo(mfVitaeValveT[lValveId], (1.f / 4.f) * afTimeStep, fGoal);
			
			// Point of no return!
			if (mvVitaeValveIdsPastHalfway.find(mlVitaeValveToUpdate) == -1)
			{
				if (bPowderActive && mfVitaeValveT[lValveId] >= 1.3f ||
					bPowderActive == false && mfVitaeValveT[lValveId] > 0.43f)
				{
					mvVitaeValveIdsPastHalfway.push_back(mlVitaeValveToUpdate);
				}
			}
			
			///////////////
			// Sound effects
			tString sSound = "Sound_VitaePressure_" + mlVitaeValveToUpdate;			
			if (Sound_Exists(sSound) == false)
				Sound_CreateAtEntity(sSound, "03_04_pillar_room/pillar_activate/pillar_energy_flow", "VitaeAccessPointWheel_" + mlVitaeValveToUpdate);
				
			cSoundEntity@ pSound = mBaseObj.GetWorld().GetSoundEntity(sSound);
			
			float fSpeed = 1.f + cMath_Clamp(mfVitaeValveT[lValveId] / 1.75f, 0.f, 1.f) * 1.25f;
			float fVolume = cMath_Clamp(mfVitaeValveT[lValveId] / 1.75f, 0.f, 1.f) * 1.25f;
			
			if (bPowderActive == false)
			{
				fSpeed = cMath_Min(fSpeed, 0.5f);
				fVolume = cMath_Min(fVolume, 1.f);
			}
			
			// TODO: Use a param for this when we have the proper sound
			pSound.FadeSpeedMul(fSpeed, 10.f);		
			pSound.FadeVolumeMul(fVolume, 10.f);
			
			///////////////
			// PS color
			cColor psColor = cColor(1.f);
			if (bPowderActive)
			{
				float fColorT = cMath_Clamp((mfVitaeValveT[lValveId] - 0.43f) / (1.f - 0.43f), 0.f, 1.f);
				psColor = cColor_White * (1.f - fColorT) + cColor(4.f, 1.f, 1.f, 1.f) * fColorT;
			}
			
			///////////////
			// Injection PS
			tString sInjectionPS = "PS_VitaeInjection_" + mlVitaeValveToUpdate;
			cParticleSystem@ pInjectionPS = mBaseObj.GetWorld().GetParticleSystem(sInjectionPS);
			
			if (mfVitaeValveT[lValveId] >= 0.43f && mfVitaeValveT[lValveId] < 1.f && fPrevT < mfVitaeValveT[lValveId] || 
				mfVitaeValveT[lValveId] >= 1.f && fPrevT > mfVitaeValveT[lValveId])
			{
				if (pInjectionPS is null)
					@pInjectionPS = ParticleSystem_CreateAtEntity(sInjectionPS, "dark_world_vitae_inject.ps", "Area_AccessPointInjection_" + mlVitaeValveToUpdate, false);
					
				pInjectionPS.SetColor(psColor);
			}
			else
			{
				if (pInjectionPS !is null)
					pInjectionPS.Kill();
			}
			
			///////////////
			// Ejection PS
			tString sEjectionPS = "PS_VitaeEjection_" + mlVitaeValveToUpdate;
			cParticleSystem@ pEjectionPS = mBaseObj.GetWorld().GetParticleSystem(sEjectionPS);
			
			if (mfVitaeValveT[lValveId] >= 1.f && mfVitaeValveT[lValveId] < 1.4f && fPrevT < mfVitaeValveT[lValveId])
			{
				if (pEjectionPS is null)
					@pEjectionPS = ParticleSystem_CreateAtEntity(sEjectionPS, "dark_world_vitae_inject.ps", "Area_AccessPointEjection_" + mlVitaeValveToUpdate, false);
				
				pEjectionPS.SetColor(psColor);
			}
			else
			{
				if (pEjectionPS !is null)
					pEjectionPS.Kill();
			}
			
			///////////////
			// Cloud PS
			tString sCloudPS = "PS_VitaeCloud_" + mlVitaeValveToUpdate;
			cParticleSystem@ pCloudPS = mBaseObj.GetWorld().GetParticleSystem(sCloudPS);
			
			if (mfVitaeValveT[lValveId] >= 0.43f && mfVitaeValveT[lValveId] <= 1.3f)
			{
				if (pCloudPS is null)
					@pCloudPS = ParticleSystem_CreateAtEntity(sCloudPS, "dark_world_vitae_inject_cloud.ps", "Area_AccessPointCloud_" + mlVitaeValveToUpdate, false);
				
				pCloudPS.SetColor(psColor);
			}
			else
			{
				if (pCloudPS !is null)
					pCloudPS.Kill();
			}
			
			///////////////
			// Powder PS
			if (bPowderActive && mfVitaeValveT[lValveId] >= 1.f && fPrevT < 1.f)
			{
				cParticleSystem@ pPowderPS = mBaseObj.GetWorld().GetParticleSystem("PS_Powder_" + mlVitaeValveToUpdate);
				if (pPowderPS !is null)
					pPowderPS.Kill();
				
				Entity_SetEffectBaseColor(sAccessPoint, cColor(3.f, 0.45f, 0.45f, 1.f));
			}
			
			///////////////
			// UV animation
			float fFirstPipeT = cMath_Clamp((mfVitaeValveT[lValveId] - 0.f) / (1.f - 0.f), 0.f, 1.f);
			float fSecondPipeT = cMath_Clamp(1.f - ((mfVitaeValveT[lValveId] - 1.f) / (2.f - 1.f)), 0.f, 1.f);
			
			Prop_SetUvAnimationTime(sAccessPoint, "vitae_pipe2_glow_low", fFirstPipeT);
			Prop_SetUvAnimationTime(sAccessPoint, "vitae_pipe_glow_low", fSecondPipeT);
			
			///////////////
			// Stop effects?
			if (mfVitaeValveT[lValveId] <= 0.05f && pEnt.IsInteractedWith() == false)
			{
				pSound.FadeOut(0.5f);
				mlVitaeValveToUpdate = -1;
				mfVitaeValveT[lValveId] = 0.f;
				return;				
			}
			
			///////////////
			// Start explosion!
			if (bPowderActive && mfVitaeValveT[lValveId] >= 1.5f && fPrevT < 1.5f)
			{								
				mlVitaeValveToDestroy = mlVitaeValveToUpdate;				
				Seq_DestroyVitaeValve("");
			}
			
			///////////////
			// Keep running until it reaches max!
			if (mfVitaeValveT[lValveId] >= 2.f)
			{
				pEnt.SetInteractionDisabled(false);
				
				for (int i = 0; i < mvVitaeValveIdsPastHalfway.size(); ++i)
				{
					if (mvVitaeValveIdsPastHalfway[i] == mlVitaeValveToUpdate)
					{
						mvVitaeValveIdsPastHalfway.removeAt(i);
						break;
					}
				}
				
				mlVitaeValveToUpdate = -1;
				msCurrentVitaeValve = "";
				mfVitaeValveT[lValveId] = 0.f;
				
				if (bPowderActive == false)
					pSound.FadeOut(1.f);
			}
		}
				
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataDestroyVitaeValve;
		void Seq_DestroyVitaeValve(const tString &in asTimer)
		{
			int lId = mlVitaeValveToDestroy;
			tString sPipeBase = "VitaeValvePipe_" + lId;
			
			Sequence_Begin("Seq_DestroyVitaeValve", mSeqDataDestroyVitaeValve);
			if (Sequence_DoStepAndWait(1.f))
			{
				Map_RemoveTimer("Timer_SpawnCeilingFlesh");				
				StopEncounterDialogue(false);
				
				// Update active valves
				int lActiveValveId = mvActiveVitaeValveIds.find(mlVitaeValveToDestroy);			 
				if (lActiveValveId != -1)
					mvActiveVitaeValveIds.removeAt(lActiveValveId);
				
				if (mvActiveVitaeValveIds.size() == 2)
					Map_AddTimer("Timer_FirstValveAnger", 60.f, "");
				
				Entity_SetActive("Trigger_DestroyTinHinanPipes_" + mlVitaeValveToDestroy, true);
				
				Entity_FadeEffectBaseColor("VitaeAccessPoint_" + mlVitaeValveToDestroy + "_Flow_1", cColor(1.f, 0.f, 0.f, 1.f), 5.3f);
				Map_AddTimer("Timer_DestroyAccessPoint", 5.3f, "OnTimer_DestroyAccessPoint");
				
				DestroyVitaePipe(sPipeBase + "_1");				
				
				mbAllowStallDestruction = true;
				mlOutsidePipeId = 1;
				
				if (mlPrevVitaeValveToDestroy != -1)
				{
					Entity_SetActive("ShadowFlesh_Ceiling_" + mlPrevVitaeValveToDestroy + "_*", true);
					Light_FadeBrightnessTo("Light_ShadowFleshCeiling_" + mlPrevVitaeValveToDestroy + "_*", 0.5f, 3.f);
					
					if (mlPrevVitaeValveToDestroy == 1)
						mbLeftCeilingFleshSpawned = true;
					if (mlPrevVitaeValveToDestroy == 3)
						mbRightCeilingFleshSpawned = true;
				}
				
				mlPrevVitaeValveToDestroy = mlVitaeValveToDestroy;
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				DestroyVitaePipe(sPipeBase + "_2");
				DestroyVitaePipe(sPipeBase + "_3");
				DestroyVitaePipe(sPipeBase + "_7");
				
				////////////////////
				// Kill TH
				if (mbDestructionCutsceneStarted == false && mvActiveVitaeValveIds.size() == 0)
				{
					mbDestructionCutsceneStarted = true;
					Seq_KillTinHinan("");
					
					if (mlVitaeValveToDestroy == 2)
					{
						VineCover_SetIndependant("Cover_78", true);
						VineCover_SetIndependant("Cover_79", true);
						VineCover_Open("Cover_78");						
						VineCover_Open("Cover_79");
					}
				}
				
				// Make sure vines are out so we can see TH clearly!
				tString sCovers = "Cover_Shielding_" + mlVitaeValveToDestroy + "_*";
				VineCover_SetIndependant(sCovers, true);
				VineCover_Open(sCovers);
			}
			else if (Sequence_DoStepWaitAndRepeat(6, 2.f / 6.f))
			{				
				DestroyVitaePipe(sPipeBase + "_4_" + mlOutsidePipeId);
				++mlOutsidePipeId;
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				for (int i = 1; i < 40; ++i)
					Map_AddTimer("FactoryPipe_" + mlVitaeValveToDestroy + "_" + i, (i / 40.f) * 2.f, "OnTimer_DestroyFactories_Step1");
				
				Map_AddTimer("Timer_TinHinanLookAtExplosion", 4.f, "OnTimer_TinHinanLookAtExplosion");
				TinHinan_SetSpotlightOn("TH_Beam", false, false, 1.f); // Spotlight off for a little while
			}
			else if (Sequence_DoStepAndWait(1.2f))
			{			
				Map_AddTimer("Timer_DoStallDestruction", 8.2f, "OnTimer_DoStallDestruction");
				
				///////////////
				// Look at vista on first destruction
				iLuxEntity@ pArea = Map_GetEntity("Area_VistaLookAt_" + mlVitaeValveToDestroy, eLuxEntityType_Area);				
				cVector3f vDir = cMath_Vector3Normalize(pArea.GetPosition() - Player_GetCameraPosition());
				float fDot = cMath_Vector3Dot(cLux_GetPlayer().GetCamera().GetForward(), vDir);
				
				if (mvActiveVitaeValveIds.size() == 2 &&
					fDot > 0.3f &&
					Entity_GetDeltaToEntity("player", "VitaeAccessPoint_" + mlVitaeValveToDestroy).Length() < 3.5f)
				{
					Player_StopLookAt(0.f);
					Player_ChangeStateToNormal();
					
					Player_StartLookAt(pArea.GetName(), 0.025f, 1.f, 0.75f);
					Player_FadeLookSpeedMulTo(0.1f, 0.5f);
					Player_FadeMoveSpeedMulTo(0.5f, 0.5f);					
					Map_AddTimer("Timer_StopVistaLookAt", 2.5f, "OnTimer_StopVistaLookAt");
				}
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				DestroyVitaePipe(sPipeBase + "_5");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				DestroyVitaePipe(sPipeBase + "_6");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DestroyFactories_Step1(const tString &in asTimer)
		{
			if (Entity_Exists(asTimer) == false)
				return;
			
			Entity_FadeEffectBaseColor(asTimer, cColor(7.f, 7.f, 7.f, 1.f), 2.f);
			
			tString sExtraPipe = Entity_GetVarString(asTimer, "");
			if (sExtraPipe != "")
				Entity_FadeEffectBaseColor(sExtraPipe, cColor(7.f, 7.f, 7.f, 1.f), 2.f);
			
			Map_AddTimer(asTimer, 3.f, "OnTimer_DestroyFactories_Step2");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DestroyFactories_Step2(const tString &in asTimer)
		{
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_Factory_" + asTimer, "smoke_oneshot_vitae_pipe_burst_cloud.ps", asTimer, false);
			pPS.SetFadeAtDistance(false);
			pPS.SetBrightness(2.f);
			pPS.SetMatrix(cMath_MatrixMul(pPS.GetLocalMatrix(), cMath_MatrixScale(50.f)));
			
			Entity_FadeEffectBaseColor(asTimer, cColor(2.5f * 7.f, 0.5f * 7.f, 0.5f * 7.f, 1.f), 0.3f);
			
			if (Map_TimeHasPassed("Timer_FactoryExplosionSound", 0.3f))
				Map_AddTimer("Timer_PlayFactoryExplosionSound", 0.75f, "OnTimer_PlayFactoryExplosionSound");
						
			tString sExtraPipe = Entity_GetVarString(asTimer, "");
			if (sExtraPipe != "")
				Entity_FadeEffectBaseColor(sExtraPipe, cColor(2.5f * 7.f, 0.5f * 7.f, 0.5f * 7.f, 1.f), 0.3f);
			
			Map_AddTimer(asTimer, 0.3f, "OnTimer_DestroyFactories_Step3");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayFactoryExplosionSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Sound_Explosion_" + asTimer, "new_sounds/undercity/distant_explosions", "Area_VistaLookAt_" + mlVitaeValveToDestroy, 0.f, false, 1.f, 200.f, 500.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DestroyFactories_Step3(const tString &in asTimer)
		{
			Entity_FadeEffectBaseColor(asTimer, cColor(3.5f, 0.5f, 0.5f, 1.f), 0.25f);
			
			tString sExtraPipe = Entity_GetVarString(asTimer, "");
			if (sExtraPipe != "")
				Entity_FadeEffectBaseColor(sExtraPipe, cColor(3.5f, 0.5f, 0.5f, 1.f), 0.25f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopVistaLookAt(const tString &in asTimer)
		{
			ResetPlayerMoveSpeed();
			Player_FadeLookSpeedMulTo(1.f, 1.f);
			Player_StopLookAt(0.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DestroyAccessPoint(const tString &in asTimer)
		{
			/////////////////
			// Access point
			tString sAccessPoint = "VitaeAccessPoint_" + mlVitaeValveToDestroy;
			tString sGrating = "VitaeAccessPointGrate_" + mlVitaeValveToDestroy;
			
			Entity_SetEffectsActive(sAccessPoint, false, false);
			Entity_SetEffectsActive(sAccessPoint + "_*", false, true);
				
			Sound_Stop("Sound_VitaeValve_" + mlVitaeValveToDestroy, 0.5f);
			Sound_Stop("Sound_VitaePressure_" + mlVitaeValveToDestroy, 0.5f);
			
			if (mlVitaeValveToDestroy % 2 != 0)
			{
				if (Entity_IsInteractedWith(sGrating))
					Player_ChangeStateToNormal();
				
				Prop_SetHealth(sGrating, 0.f);				
				ParticleSystem_CreateAtEntity("PS_GrateBreak", "dust_impact_small_oneshot.ps", sGrating, false).SetBrightness(0.25f);
				Sound_CreateAtEntity("Sound_Grating", "level_entity_shared/breakables/relic_room_bars/relic_bars_break", sGrating);
			}
			
			/////////////////
			// Vitae map
			Map_RemoveTimer("Timer_VitaeMapFlash_" + mlVitaeValveToDestroy);
			Billboard_SetVisible("Billboard_VitaeMap_On_" + mlVitaeValveToDestroy + "_*", false);
			Billboard_SetVisible("Billboard_VitaeMap_Off_" + mlVitaeValveToDestroy + "_*", true);
			
			if (mvActiveVitaeValveIds.size() == 0)
				Map_AddTimer("Timer_TurnOffScreens", 0.5f, "OnTimer_TurnOffScreens");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_VitaeMapFlash(const tString &in asTimer)
		{
			int lId = cString_GetNumericSuffixInt(asTimer);				
			int lCount = mlVitaeMapFlashCount[lId - 1];
			
			Billboard_SetVisible("Billboard_VitaeMap_On_" + lId + "_*", lCount % 2 == 0);
			Billboard_SetVisible("Billboard_VitaeMap_Off_" + lId + "_*", lCount % 2 != 0);
			
			if (lCount % 2 != 0)
				Sound_CreateAtEntity("Sound_ScreenFlash", "03_07_dw_factory/torture_victim/machine_feedback/button_negative", "Area_ScreenFlashSound_" + lId, 0.f, false, 1.f, 1.f, 5.f);
			
			++mlVitaeMapFlashCount[lId - 1];
			
			Map_AddTimer(asTimer, 0.5f, "OnTimer_VitaeMapFlash");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TurnOffScreens(const tString &in asTimer)
		{
			Billboard_SetVisible("Billboard_VitaeMap_TH_On_*", false);
			Billboard_SetVisible("Billboard_VitaeMap_TH_Off_*", true);
		}
		
		//-------------------------------------------------------
		
		void DestroyVitaePipe(const tString &in asPipe)
		{
			int lPipeId = cString_ToInt(cString_Sub(asPipe, 17, 2), 0);
			bool bThroneRoomPipe = lPipeId > 7;
			
			float fTime = 1.f;
			float fTimeMul = 1.f;
			if (bThroneRoomPipe)
			{
				fTime = 0.f;
				fTimeMul = 0.6f;
			}
			
			Map_AddTimer(asPipe, fTime, "OnTimer_BreakVitaePipe_Step1");
			Map_SetTimerUserVarFloat(asPipe, fTimeMul);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakVitaePipe_Step1(const tString &in asTimer)
		{			
			tString sCrack = "Decal_" + asTimer + "_Crack_";
			float fTimeMul = Map_GetTimerUserVarFloat(asTimer);
			float fTime = 0.1f * fTimeMul;			

			for (int i = 1; i < 13; ++i)
			{
				tString sTimer = sCrack + i;
				Map_AddTimer(sTimer, fTime, "OnTimer_BreakVitaePipe_Step2");
				Map_SetTimerUserVarFloat(sTimer, fTimeMul);
				
				fTime += 0.25f * fTimeMul;
			}
			
			iLuxEntity@ pPipe = Map_GetEntity(asTimer, eLuxEntityType_Prop);
			if (pPipe !is null)
			{
				iLight@ pLight = pPipe.GetLightFromName("Light_Point_1");
				if (pLight !is null)
					pLight.FadeBrightnessTo(0.5f, 3.7f * fTimeMul, eEasing_SineIn);
			}
				
			Map_AddTimer(asTimer, 3.5f * fTimeMul, "OnTimer_FadeVitaePipeColor_Step_1");
			
			/////////////////
			// Throne Room pipe
			int lId = cString_GetNumericSuffixInt(asTimer);			
			if (lId == 8)
			{
				for (int i = 1; i < 4; ++i)
					Map_AddTimer(asTimer + "_Ceiling_" + i, 2.3f * fTimeMul + i * 0.4f, "OnTimer_BreakPipeCeiling");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakPipeCeiling(const tString &in asTimer)
		{
			if (Entity_Exists(asTimer) == false)
				return;
			
			Entity_SetActive(asTimer, true);
			Entity_SetCollide(asTimer, false);
			Entity_SetCollideCharacter(asTimer, false);
			
			ParticleSystem_CreateAtEntity("PS_PipeCeiling_" + asTimer, "dust_impact_large_oneshot.ps", asTimer, false).SetBrightness(0.1f);
			ParticleSystem_CreateAtEntity("PS_Debris_" + asTimer, "throne_room_ceiling_debris.ps", asTimer, false);
			
			Map_AddTimer(asTimer, 5.f, "OnTimer_DeactivatePipeCeiling");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivatePipeCeiling(const tString &in asTimer)
		{
			Entity_SetActive(asTimer, false);
		}
		
		//-------------------------------------------------------
				
		void OnTimer_FadeVitaePipeColor_Step_1(const tString &in asTimer)
		{			
			Entity_FadeEffectBaseColor(asTimer, cColor(0.f), 0.5f);
			
			if (cString_GetNumericSuffixInt(asTimer) == 6)
			{
				//Entity_SetEffectsActive("Generator_" + mlVitaeValveToDestroy + "_*", false, true);
				ParticleSystem_CreateAtEntity("PS_CorridorDust", "dust_medium_extra_long_oneshot.ps", "Area_CorridorDust_" + mlVitaeValveToDestroy, false).SetBrightness(0.35f);
			}
			
			Map_AddTimer(asTimer, 0.5f, "OnTimer_FadeVitaePipeColor_Step_2");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeVitaePipeColor_Step_2(const tString &in asTimer)
		{
			Entity_SetEffectsActive(asTimer, false, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakVitaePipe_Step2(const tString &in asTimer)
		{			
			if (m_setPipeCracks.Exists(asTimer) == false)
				return;			
				
			/////////////////
			// Start cracks!
			tString sCrack = asTimer + "_*";
			float fTimeMul = Map_GetTimerUserVarFloat(asTimer);
			mvPipeCracks.push_back(cVitaePipeCrack(asTimer, fTimeMul));
			
			/////////////////
			// Flicker!
			tString sPipe = cString_Sub(asTimer, 6, 18);
			tString sLight = Entity_GetVarString(sPipe, "");
			if (sLight != "")
			{
				if (sLight[0] == 'L')	Light_SetFlickerActive(sLight, true);
				else					Lamp_SetFlickerActive(sLight, true);
				
				Map_AddTimer(sLight, cMath_RandRectf(4.5f, 5.f) * fTimeMul, "OnTimer_StopPipeLightFlicker");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopPipeLightFlicker(const tString &in asTimer)
		{
			if (asTimer[0] == 'L')
			{
				Light_SetFlickerActive(asTimer, false);
				Light_FadeBrightnessTo(asTimer, 0.f, 0.3f, eEasing_SineOut);
			}
			else
			{
				Lamp_SetFlickerActive(asTimer, false);
				Lamp_SetLit(asTimer, false, true);		
			}
		}
		
		//-------------------------------------------------------
		
		void UpdateVitaePipeCrack(float afTimeStep)
		{
			for (int i = 0; i < mvPipeCracks.size(); ++i)
			{
				if (mvPipeCracks[i].Update(afTimeStep))
				{
					mvPipeCracks.removeAt(i);
					--i;
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakVitaePipe_Step3(const tString &in asTimer)
		{
			tString sCrack = cString_Sub(asTimer, 6, -1);
					
			///////////////////
			// Spawn flesh!			
			iLuxEntity@ pFlesh = Map_GetEntity("ShadowFlesh_" + sCrack + "-1", eLuxEntityType_Prop);
			tString sFleshName = "";
			
			if (pFlesh !is null)
			{
				sFleshName = pFlesh.GetName();
				
				ShadowFlesh_Spawn("ShadowFlesh_" + sCrack + "-*", pFlesh.GetVarString(""), 0.1f, 0.1f, false);			
				
				ShadowFlesh_DoFleshEffectsAtPos(pFlesh.GetPosition(), 2.f);
				Effect_Shake_Start(0.025f, 0.5f, 0.05f, 0.25f);
				ParticleSystem_CreateAtEntity("PS_PipeBreak_" + sCrack, "vitae_pipe_splash.ps", sFleshName, false);
				
				// Extra light at pipes leading out
				if (cString_Sub(sCrack, 17, 1) == "4")
					LightFlash_Add(0.3f, 0.25f, 0.125f, sFleshName, cColor_Red, 10.f, 1.f);
				
				// Extra light at pipes leading to TH
				if (cString_Sub(sCrack, 17, 1) == "8")
					LightFlash_Add(0.3f, 0.25f, 0.125f, sFleshName, cColor_Red, 4.f, 1.f);
			}
			
			Map_AddTimer(sCrack, 0.15f, "OnTimer_BreakVitaePipe_SpawnFlesh");	
			
			///////////////
			// Final pipe, damage TH!
			if (sFleshName != "" && Entity_GetVarString(sFleshName, "") == "DamageTinHinan")
				Map_AddTimer(sFleshName, 0.25f, "OnTimer_DamageTinHinan");	
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakVitaePipe_SpawnFlesh(const tString &in asTimer)
		{
			ShadowFlesh_Spawn("ShadowFlesh_" + asTimer + "_*", "", 0.15f, 0.3f, false);
		}	
		
		//-------------------------------------------------------
		
		void OnTimer_DoStallDestruction(const tString &in asTimer)
		{
			if (mbAllowStallDestruction == false)
				return;
				
			tString sLightFlashArea = "Area_StallDestruction_" + mlVitaeValveToDestroy + "_" + cMath_RandRectl(1, 3);
			
			Effect_Shake_Start(0.015f, 0.75f, 0.25f, 0.5f);
			LightFlash_Add(0.5f, 0.25f, 0.5f, sLightFlashArea, cColor_Red, 12.f, 1.f);
			
			if (cMath_RandRectl(0, 2) > 0 || Sound_Exists("Sound_StallFlesh") == false)
			{
				Sound_CreateAtEntity("Sound_StallFlesh", "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", sLightFlashArea);
				Sound_CreateAtEntity("Sound_Shake", "04_03_undercity/ending/destruction_sweet", sLightFlashArea);
			}
			
			if (mvActiveVitaeValveIds.size() > 0)
			{
				tString sFlesh = "ShadowFlesh_VitaeValveExterior_" + mlVitaeValveToDestroy + "_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 1.f, true);
				Map_AddTimer("Timer_SpawnGroundFlesh", 1.f, "OnTimer_SpawnGroundFlesh");
			}
			
			float fTime = cMath_RandRectf(1.f, 2.5f);
			if (cMath_RandRectl(0, 2) == 2)
				fTime = 0.5f;
				
			Map_AddTimer("Timer_DoStallDestruction", fTime, "OnTimer_DoStallDestruction");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SpawnGroundFlesh(const tString &in asTimer)
		{
			tString sFlesh = "ShadowFlesh_Ground_" + mlVitaeValveToDestroy + "_*";
			ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 1.f, true);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_DestroyTinHinanPipes(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbAllowStallDestruction = false;			
			
			///////////////
			// Destroy pipes leading to TH
			DestroyVitaePipe("VitaeValvePipe_" + mlVitaeValveToDestroy + "_8");
			
			if (mvActiveVitaeValveIds.size() == 2)
			{
				Player_StartLookAt("Area_THPipeLookAt_" + mlVitaeValveToDestroy, 0.025f, 1.f, 0.75f);
				Player_FadeLookSpeedMulTo(0.1f, 0.5f);
				Player_FadeMoveSpeedMulTo(0.5f, 0.5f);
					
				Map_AddTimer("Timer_StopTHPipeLookAt", 2.f, "OnTimer_StopTHPipeLookAt");
			}
			
			///////////////
			// Final cutscene?
			if (mvActiveVitaeValveIds.size() == 0)
				SequenceStates_Resume("Seq_KillTinHinan");
			
			return false;
		}
				
		//-------------------------------------------------------
		
		void OnTimer_StopTHPipeLookAt(const tString &in asTimer)
		{
			ResetPlayerMoveSpeed();
			Player_FadeLookSpeedMulTo(1.f, 1.f);
			Player_StopLookAt(0.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DamageTinHinan(const tString &in asTimer)
		{
			//////////////
			// Damage TH effects
			mbTinHinanDamaged = true;
			
			cVector3f vLightPos = Map_GetEntity("TH_Beam").GetMeshEntity().GetSocket("Socket_LightFlash").GetWorldPosition();
			LightFlash_Add(0.15f, 0.25f, 0.125f, vLightPos, cColor_Red, 15.f, 2.5f);
			Effect_Shake_Start(0.075f, 0.5f, 0.1f, 2.f);
			Sound_CreateAtEntity("Sound_TinHinanDamage", "04_03_undercity/machine/energy_off", asTimer, 0.f, false, 1.f, 1.f, 100.f);
			
			int lDamageStage = 3 - mvActiveVitaeValveIds.size();			
			for (int i = 1; i < 5; ++i)
			{
				tString sFlesh = "ShadowFlesh_TinHinan_Stage_" + lDamageStage + "_" + i;
				Entity_AttachToSocket(sFlesh, "TH_Beam", "Socket_FleshStage_" + lDamageStage + "_" + i, true, true);
				ShadowFlesh_Spawn(sFlesh, "", 0.75f, 1.f, false);
				ShadowFlesh_Spawn(sFlesh + "_Web", "", 0.75f, 1.f, false);
			}
			
			Light_FadeBrightnessTo("Light_ShadowFleshMiddle_" + mlVitaeValveToDestroy, 0.5f, 1.f);			
			ResetTowerShake(true);
								
			if (mvActiveVitaeValveIds.size() != 0)
			{
				//////////////
				// Spawn flesh at access point entrance
				tString sFlesh = "ShadowFlesh_VitaeValveExterior_" + mlVitaeValveToDestroy + "_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 1.f, true);
				Map_AddTimer("Timer_SpawnGroundFlesh", 1.f, "OnTimer_SpawnGroundFlesh");
				
				//////////////
				// Setup TH
				Map_AddTimer("Timer_PlayExplosionDialogue", 1.f, "OnTimer_PlayExplosionDialogue");
				Map_AddTimer("Timer_ResetTinHinanAfterDamage", 6.f, "OnTimer_ResetTinHinanAfterDamage");
				
				StruggleFlashHandler_SetProgression(4);
				
				//////////////
				// TH gets more and more damaged
				TinHinan_SetAnimationState("TH_Beam", 4 - mvActiveVitaeValveIds.size());
				
				//////////////
				// Move covers back up again!
				tString sCovers = "Cover_Shielding_" + mlVitaeValveToDestroy + "_*";
				VineCover_SetIndependant(sCovers, false);
				VineCover_Close(sCovers);
				
				//////////////
				// Shut down outside of access point
				Billboard_SetVisible("Billboard_VitaeValve_" + mlVitaeValveToDestroy + "_*", false);
				Entity_SetEffectsActive("VitaeValvePipe_" + mlVitaeValveToDestroy + "_9", false, true);
				Lamp_SetLit("Generator_" + mlVitaeValveToDestroy + "_*", false, true);
				
				iLight@ pLight = mBaseObj.GetWorld().GetLight("Light_AccessPointEntrance_" + mlVitaeValveToDestroy);
				cBillboard@ pBillboard = mBaseObj.GetWorld().GetBillboard("Billboard_AccessPoint_" + mlVitaeValveToDestroy);
				
				if (pLight !is null && pBillboard !is null)
				{
					pBillboard.SetColor(cColor_Red);
					pLight.SetDiffuseColor(cColor_Red);
					pLight.SetSpecularColor(cColor_Red);
					pLight.SetFlicker(cColor(0.854,0.503,0.503,1), 2.f, 
									  pLight.GetFlickerOnMinLength(), pLight.GetFlickerOnMaxLength(), 
									  "", "", pLight.GetFlickerOffMinLength(), pLight.GetFlickerOffMaxLength(), 
									  "", "", true, 0.01f, 0.01f, 0.01f, 0.01f);
					
					pLight.RemoveBillboard(pBillboard);
					pLight.AttachBillboard(pBillboard, pBillboard.GetColor(), pBillboard.GetBrightness());
				}
			}
			else
			{
				Entity_PlayAnimation("TH_Beam", "death", 0.3f, false, true);
				Entity_SetAnimationMessageEventCallback("TH_Beam", "OnAnimEvent_TinHinanDeath", true);
				Map_AddTimer("Timer_SpawnCeilingFlesh", 1.f, "OnTimer_SpawnCeilingFlesh");
				
				Effect_DollyZoom_Start(-0.25f, 7.f, 2.f, 4.f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimEvent_TinHinanDeath(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			iLuxEntity@ pCrystal = mBaseObj.GetEntityByName("TH_Beam_crystal", eLuxEntityType_Prop);
			pCrystal.RemoveEntityAttachment();
			
			iPhysicsBody@ pBody = pCrystal.GetMainBody();
			pBody.SetCollide(true);
			pBody.SetMass(1.f);
			pBody.AddImpulse(cVector3f_Down + pCrystal.GetMatrix().GetTranspose().GetRight());
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SpawnCeilingFlesh(const tString &in asTimer)
		{		
			ShadowFlesh_Spawn("ShadowFlesh_Ceiling_" + mlVitaeValveToDestroy + "_*", "", 1.5f, 3.f, true);
			ShadowFlesh_Spawn("ShadowFlesh_Ceiling_Middle_*", "", 1.5f, 3.f, false);
			Light_FadeBrightnessTo("Light_ShadowFleshCeiling_" + mlVitaeValveToDestroy + "_*", 0.5f, 3.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TinHinanLookAtExplosion(const tString &in asTimer)
		{
			TinHinan_StartSpotlightFollow("TH_Beam", "Area_TinHinanLookAtExplosion_" + mlVitaeValveToDestroy);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_BreakableWall(const tString &in asEntity, int alState)
		{
			if (alState == 1 && mvActiveVitaeValveIds.size() < 3 && mbTinHinanDamaged && mbTowerQuakeActive)
			{
				Prop_SetHealth(asEntity, 0.f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnBreak_Wall(const tString &in asEntity)
		{
			tString sBrokenEnt = asEntity + "_broken";
			iLuxEntity@ pEnt = Map_GetEntity(sBrokenEnt, eLuxEntityType_Prop);
			
			if (pEnt !is null)
			{
				Entity_SetCollide(sBrokenEnt, false);
				Map_AddTimer(sBrokenEnt, 0.3f, "OnTimer_SetBrokenWallCollide");
				
				ParticleSystem_CreateAtEntity("PS_Debris_" + sBrokenEnt, "throne_room_wall_debris.ps", sBrokenEnt, false);
				
				tString sUserVar = Entity_GetVarString(asEntity, "");
				if (sUserVar == "static")
				{
					Prop_SetStaticPhysics(sBrokenEnt, true);
					return;
				}
				
				cVector3f vImpulse = cString_ToVector3f(sUserVar, cVector3f(0.f, -2.f, 0.f));				
				for (int i = 0; i < pEnt.GetBodyNum(); ++i)
				{
					iPhysicsBody@ pBody = pEnt.GetBody(i);
					if (pBody.GetMass() <= 0)
						continue;
					
					pBody.SetCollideCharacter(false);
					pBody.AddImpulse(cMath_MatrixMul(pBody.GetLocalMatrix().GetRotation(), vImpulse));
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetBrokenWallCollide(const tString &in asTimer)
		{
			Entity_SetCollide(asTimer, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayExplosionDialogue(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_PlayDelayed("Dialogue_DestroyVitae", 1.f, -1, "OnVoiceEnd_DestroyVitae");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_DestroyVitae(const tString &in asScene, const tString &in asSubject)
		{
			Voice_PlayWhenPossible("Dialogue_TasiReactsToPipeDamage", "", 20.0f, 1.5f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetTinHinanAfterDamage(const tString &in asTimer)
		{
			TinHinan_SetSpotlightOn("TH_Beam", true, false, 1.f);
			TinHinan_StopSpotlightFollow("TH_Beam");
			
			TinHinan_HearBaby("TH_Beam");
			
			ResetEncounterDialogue();
		}
		
		//-------------------------------------------------------
		
		void ResetTowerShake(bool abShake)
		{
			mbTowerUnstable = abShake;
			
			if (mlUnstableTowerShakeId != -1)
				Effect_Shake_FadeOut(mlUnstableTowerShakeId, 5.f);
				
			Sound_StopGui("04_03_undercity/ending/quake_loop", 5.f);
				
			Map_RemoveTimer("Timer_BreakThroneRoomCeiling");
			Map_RemoveTimer("Timer_TowerShake");
			Map_AddTimer("Timer_TowerShake", 0.f, "OnTimer_TowerShake");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TowerShake(const tString &in asTimer)
		{		
			int lVitaeValvesDestroyed = 3 - mvActiveVitaeValveIds.size();
			
			float fTime = 0.f;
			float fIntensity = mbTowerUnstable ? 0.5f + 0.5f * (1.66f * lVitaeValvesDestroyed) : 0.f;
			
			if (mbTowerUnstable)
			{
				if (lVitaeValvesDestroyed == 1)			fTime = cMath_RandRectf(3.f, 6.f);
				else if (lVitaeValvesDestroyed == 2)	fTime = cMath_RandRectf(6.f, 9.f);
				else if (lVitaeValvesDestroyed == 3)	fTime = 40.f;
				
				Sound_PlayGui("04_03_undercity/ending/quake_loop", fIntensity, eSoundEntryType_GuiWorld);
				
				mlUnstableTowerShakeId = Effect_Shake_Start(0.015f * fIntensity * 0.3f, fTime, 0.25f, 3.f);
				mbTowerQuakeActive = true;
				
				Effect_Rumble_Start(0.1f, fTime, 0.5f, 0.5f);
				
				OnTimer_BreakThroneRoomCeiling("Timer_BreakThroneRoomCeiling");				
			}
			else
			{
				if (lVitaeValvesDestroyed == 1)			fTime = cMath_RandRectf(12.f, 17.f);
				else if (lVitaeValvesDestroyed == 2)	fTime = cMath_RandRectf(7.f, 12.f);
				else if (lVitaeValvesDestroyed == 3)	fTime = 30.f;
				
				Sound_StopGui("04_03_undercity/ending/quake_loop", 5.f);
				
				mlUnstableTowerShakeId = -1;
				mbTowerQuakeActive = false;
				
				Map_RemoveTimer("Timer_BreakThroneRoomCeiling");
			}
			
			mbTowerUnstable = !mbTowerUnstable;			

			Map_RestartCurrentTimer(fTime);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakThroneRoomCeiling(const tString &in asTimer)
		{	
			if (mbAllowCeilingBreak == false)
				return;
			
			bool bFinalValve = mvActiveVitaeValveIds.size() == 0;
			int lMaxAreas = mvActiveVitaeValveIds.size() < 2 ? 5 : 2;
			
			array<tString> vAreas;
			cVector3f vCamPos = Player_GetCameraPosition();	
			
			cVector3f vFwd = cLux_GetPlayer().GetCamera().GetForward();
			vFwd.y = 0.f;
			vFwd.Normalize();		
			
			for (int i = 43; i > 0; --i)
			{
				cLuxArea@ pArea = cLux_ToArea(Map_GetEntity("Area_CeilingDebris_" + i, eLuxEntityType_Area));
				if (pArea is null)
					continue;
					
				cVector3f vDelta = pArea.GetPosition() - vCamPos;				
				vDelta.y = 0.f;
					
				float fDistSqr = vDelta.SqrLength();				
				float fDot = cMath_Vector3Dot(vFwd, cMath_Vector3Normalize(vDelta));
					
				if (fDistSqr < 40.f * 40.f && fDot >= 0.9f)
				{
					if (bFinalValve == false || fDistSqr > 20.f * 20.f)
						vAreas.push_back(pArea.GetName());
				}
					
				if (vAreas.size() > lMaxAreas)
					break;
			}
			
			for (int i = 0; i < vAreas.size(); ++i)
				Map_AddTimer(vAreas[i], i * cMath_RandRectf(0.3f, 0.6f), "OnTimer_BreakCeilingDebris");
			
			if (Map_GetTimerUserVarInt(asTimer) != 1)
			{
				float fTime = cMath_RandRectf(3.f, 6.f);
				Map_RemoveTimer("Timer_BreakThroneRoomCeiling");
				Map_AddTimer("Timer_BreakThroneRoomCeiling", fTime, "OnTimer_BreakThroneRoomCeiling");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakCeilingDebris(const tString &in asTimer)
		{
			if (mbAllowCeilingBreak == false)
				return;
				
			cLuxArea@ pArea = cLux_ToArea(Map_GetEntity(asTimer, eLuxEntityType_Area));
			tString sArea = pArea.GetName();
			
			bool bClose = (Player_GetCameraPosition() - pArea.GetPosition()).SqrLength() < 30.f * 30.f;
			tString sPS = bClose ? "debris_falling_throne_room.ps" : "debris_falling_throne_room_large.ps";
			
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_Debris_" + asTimer, sPS, asTimer, false);
			
			int lId = Effect_Shake_Start(0.05f, 1.f, 0.5f, 0.5f, 0.f, 0);
			Effect_Shake_SetSourceEntity(lId, sArea, 25.f, 60.f);
			
			Effect_Rumble_Start(0.35f, 2.f, 0.5f, 0.5f);
			
			Sound_CreateAtEntity("Sound_CeilingBreak", "04_03_undercity/ending/rock_impacts", sArea, 0.f, false, 1.f, 15.f, 60.f);
		}
				
		//-------------------------------------------------------

		//} END Event A *Destroy the vitae pipes*
		
		/////////////////////////////////////////
		// Event B *Tin Hinan dies*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 11, Event B here.*/
		
		int mlFootFleshCount = 1;
		array<tID> mvVineCoversToDisable(0);
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 11, Event B here.*/	
		
		cSequenceStatesData mSeqDataKillTinHinan;
		void Seq_KillTinHinan(const tString &in asTimer)
		{
			Sequence_Begin("Seq_KillTinHinan", mSeqDataKillTinHinan);
			if (Sequence_DoStepAndWait(0.1f))
			{			
				// Preload DW
				Map_Preload("04_05_darkworld.hpm");
				
				StopEncounterBabyCry(true);
				
				Sketchbook_CompleteIdea("destroy_darkworld");
				Sketchbook_CompleteIdea("meet_tinhinan");
				
				StopEncounterDialogue();
				
				TinHinan_SetPassive("TH_Beam", true);				
				TinHinan_SetDying("TH_Beam", true);					
				TinHinan_SetSpotlightColor("TH_Beam", "detected");
				
				StopEncounterDialogue(true);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				TinHinan_TurnSpotlightToPos("TH_Beam", Player_GetCameraPosition() + cVector3f(0.f, 1.5f, 0.f), true, true, 2.f);
				
				Sound_Stop("Sound_ThroneRoomCreak_*", 3.0f);
				Sound_Stop("Sound_ThroneRoomSweet_*", 3.0f);
				Sound_Play("Sound_DestructionStart", 0.0f);
				Sound_Play("Sound_Quake", 6.0f);
				
				// Call this again to make sure they go down if the player is really quick
				if (mlVitaeValveToDestroy == 2)
				{
					VineCover_SetIndependant("Cover_78", true);
					VineCover_SetIndependant("Cover_79", true);
					VineCover_Open("Cover_78");						
					VineCover_Open("Cover_79");
				}
				
				tString sCovers = "Cover_Shielding_" + mlVitaeValveToDestroy + "_*";
				VineCover_SetIndependant(sCovers, true);
				VineCover_Open(sCovers);
			}
			else if (Sequence_DoStepAndPause(0.f))
			{			
				Map_AddTimer("Timer_PlayDestroyVitaeDialogue", 5.f, "OnTimer_DestroyVitaeDialogue");				
			}
			else if (Sequence_DoStepAndWait(5.f))
			{
				tString sArea = "Area_DestructionEndingCutscene_" + mlVitaeValveToDestroy;
				float fFadeTime = mlVitaeValveToDestroy == 2 ? 0.8f : 0.5f;
				
				PlayerBody_PlayCutsceneAtEntity("player_destruction_ending", sArea, false, fFadeTime);
				PlayerBody_SetCutsceneMaxPitch(5.f);
				PlayerBody_SetCutsceneMaxYaw(5.f);
				Player_FadeLookSpeedMulTo(fFadeTime, 1.f);
				
				Sound_Stop("Sound_Quake", 1.0f);
				Sound_Stop("Sound_ThroneRoomSweet_*", 6.0f);
				Sound_Play("Sound_Destruction", 0.0f);
				Sound_Play("Sound_DestructionRumble", 1.0f);
				//Sound_PlayGui("new_sounds/undercity_ending/destruction_player", 1.0);
				
				float fMusicDelay = Platform_IsPS4() ? 5.f : 0.f; // Fix so it doesn't become too out of sync on PS4
				Map_AddTimer("Timer_PlayDestructionEndingMusic", fMusicDelay, "OnTimer_PlayDestructionEndingMusic");
				
				Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimEvent_DestructionEnding", false);
				
				SetHoldBaby(false);
				Entity_PlaceAtEntity("BabyCarried", sArea, 0.f, true);
				Entity_PlayAnimation("BabyCarried", "baby_destruction_ending", fFadeTime);
				Entity_SetUpdateBonesWhenCulled("BabyCarried", true);
				
				Map_AddTimer("Timer_DoFinalDestruction", 4.f, "OnTimer_DoFinalDestruction");
				
				FadeEndingCutsceneAnimSpeed(0.7f, 1.f);				
				StopEncounterDialogue(true);
				
				Seq_DestructionEndingFlesh("");
				
				Light_FadeBrightnessTo("Light_EndingSequence_" + mlVitaeValveToDestroy, 0.5f, 2.f, eEasing_SineIn);
				
				///////////////////
				// Start shutting down room
				mBaseObj.GetEntityArrayID("Cover_*", eLuxEntityType_Prop, "", mvVineCoversToDisable);
				OnTimer_DisableVineCovers("");
			}
			else if (Sequence_DoStepAndWait(4.5f))
			{
				Voice_StopAll();
				Voice_Play("Dialogue_DyingTH");
			}
			else if (Sequence_DoStepAndWait(3.5f))
			{
				Entity_FadeEffectBaseColor("TH_Beam", cColor(0.f), 3.f);
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				FadeEndingCutsceneAnimSpeed(1.f, 1.f);
				
				ShadowFlesh_Spawn("ShadowFlesh_Death_" + mlVitaeValveToDestroy + "_*", "", 0.5f, 1.f, false, 0.f);
			}
			else if (Sequence_DoStepAndWait(3.64f))
			{			
				Effect_Shake_FadeOut(mlUnstableTowerShakeId, 2.f);
				Effect_Shake_Start(0.002f, 30.f, 1.f, 1.f);
				
				Voice_StopAll();
			}
			else if (Sequence_DoStepAndWait(5.5f))
			{			
				Voice_Play("Dialogue_TasiReactsToPipeDamage", 2);
			}
			else if (Sequence_DoStepAndWait(11.f))
			{
				// Fade up volume
				Music_PlayExt("A2_Undercity_Death_Ending_FIN.ogg", false, 0.6f, 1.0f, 11.0f, 1.0f, eMusicPrio_BigEvent, false);
				
				Seq_FleshWave("");				
				Light_FadeBrightnessTo("Light_FootFlesh_" + mlVitaeValveToDestroy + "_*", 0.f, 1.f); // So the light doesn't bleed through the player body
				
				Map_AddTimer("Timer_PlayDestructionEndingStinger", 8.96f, "OnTimer_PlayDestructionEndingStinger");
			}
			else if (Sequence_DoStepAndWait(10.f))
			{
				Effect_Fade_Out(0.05f);
				cLux_GetPlayer().SetActive(false);
				
				Voice_StopAll();				
				
				Music_StopAll(0.1f);
				Sound_FadeGlobalVolume(0.f, 1.0f, eSoundEntryType_WorldAll);
				
				Effect_Shake_FadeOut(-1, 0.25f);
				Effect_Rumble_Stop(-1);
				
				Sound_PlayGui("new_sounds/undercity_ending/death_stinger", 1.0);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				cScript_SetGlobalVarBool("Ending_Destruction", true);
				Map_ChangeMap("04_05_darkworld.hpm", "", "", "", false);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayDestructionEndingStinger(const tString &in asTimer)
		{
			Sound_PlayGui("new_sounds/undercity_ending/death_buildup", 1.0);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayDestructionEndingMusic(const tString &in asTimer)
		{
			Music_PlayExt("A2_Undercity_Death_Ending_FIN.ogg", false, 0.4f, 1.0f, 0.0f, 1.0f, eMusicPrio_BigEvent, false);
		}
		
		//-------------------------------------------------------
		
		void OnBreak_EndingDebris(const tString &in asEntity)
		{
			iLuxEntity@ pEnt = mBaseObj.GetEntityByName(asEntity, eLuxEntityType_Prop);
			if (pEnt is null)
				return;
			
			float fImpulseMul = pEnt.GetVarFloat("");
			
			iLuxEntity@ pBrokenEnt = mBaseObj.GetEntityByName(asEntity + "_broken", eLuxEntityType_Prop);
			if (pBrokenEnt is null)
				return;
			
			for (int i = 0; i < pBrokenEnt.GetBodyNum(); ++i)
			{
				iPhysicsBody@ pBody = pBrokenEnt.GetBody(i);
				
				cVector3f vImpulse = cVector3f(cMath_RandRectf(-2.f, 2.f), cMath_RandRectf(4.f, 6.f), cMath_RandRectf(-2.f, 2.f));
				vImpulse *= fImpulseMul;
				pBody.AddImpulse(cMath_MatrixMul(pBody.GetLocalMatrix().GetRotation(), vImpulse));
				
				pBody.SetCollideFlags(mBaseObj.GetCollideFlag("-flesh"));
			}
			
			ParticleSystem_CreateAtEntity("PS_EndingSplash", "vitae_pipe_splash_oneshot.ps", pBrokenEnt.GetName(), false);
			Sound_CreateAtEntity("Sound_EndingWallBreak", "04_03_undercity/ending/rock_impacts", asEntity);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableVineCovers(const tString &in asTimer)
		{			
			int lCount = 0;
			for (int i = 0; i < mvVineCoversToDisable.size(); ++i)
			{
				++lCount;
				if (lCount > 10)
					break;
				
				cLuxProp@ pProp = cLux_ID_Prop(mvVineCoversToDisable[i]);
				if (pProp !is null)
					pProp.SetEffectsActive(false, true);
				
				mvVineCoversToDisable.removeAt(i);
				--i;
			}
						
			if (mvVineCoversToDisable.size() > 0)
				Map_AddTimer("Timer_DisableVineCovers", cMath_RandRectf(1.f, 2.f), "OnTimer_DisableVineCovers");
		}
		
		//-------------------------------------------------------
		
		void FadeEndingCutsceneAnimSpeed(float afSpeed, float afTime)
		{
			PlayerBody_GetAnimationState("player_destruction_ending").FadeSpeed(afSpeed, afTime);
			Map_GetEntity("BabyCarried", eLuxEntityType_Prop).GetMeshEntity().GetAnimationStateFromName("baby_destruction_ending").FadeSpeed(afSpeed, afTime);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataDestructionEndingFlesh;
		void Seq_DestructionEndingFlesh(const tString &in asTimer)
		{
			tString sFlesh = "ShadowFlesh_End_" + mlVitaeValveToDestroy + "_";
			
			Sequence_Begin("Seq_DestructionEndingFlesh", mSeqDataDestructionEndingFlesh);
			Sequence_Wait(4.f);
			if (Sequence_DoStepAndWait(2.5f))
			{				
				sFlesh += "1_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 0.75f, true);
				Light_FadeBrightnessTo("Light_ShadowFleshEnd_" + mlVitaeValveToDestroy + "_1", 0.5f, 3.f);
				
				tString sLight = "Light_EndingFleshFlicker_" + mlVitaeValveToDestroy;
				Light_SetFlickerActive(sLight, true);
				Light_SetBrightness(sLight, 1.f);
			}
			else if (Sequence_DoStepAndWait(13.f))
			{
				sFlesh += "2_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 0.75f, true); 
				Light_FadeBrightnessTo("Light_ShadowFleshEnd_" + mlVitaeValveToDestroy + "_2", 1.f, 3.f);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEvent_DestructionEnding(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			//////////////////
			// Foot flesh
			if (alMessageEventID == 0)
			{
				Effect_Shake_FadeOut(mlUnstableTowerShakeId, 0.f);
				
				tString sFlesh = "ShadowFlesh_Foot_" + mlVitaeValveToDestroy + "_" + mlFootFleshCount + "_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_ShadowFlesh_Foot_" + mlVitaeValveToDestroy + "_" + mlFootFleshCount, 0.5f, 0.5f, true, 0.01f);
				
				if (mlFootFleshCount == 1 || mlFootFleshCount == 3)
					Map_AddTimer("Timer_DoFootDamageEffects", 0.05f, "OnTimer_DoFootDamageEffects");
					
				if (mlFootFleshCount == 2)
					Map_AddTimer("Timer_SpawnExtraFootFlesh", 1.f, "OnTimer_SpawnExtraFootFlesh");
				
				//if (mlFootFleshCount == 1)
				//	Prop_SetHealth("Floor_FootFlesh_1", 0.f);
				
				Light_FadeBrightnessTo("Light_FootFlesh_" + mlVitaeValveToDestroy + "_" + mlFootFleshCount, 0.5f, 0.5f);
				
				++mlFootFleshCount;
				
				Effect_Rumble_Start(0.6f, 1.f, 0.25f, 0.25f);
			}
			//////////////////
			// Ground flesh
			else if (alMessageEventID == 1)
			{
				Seq_GroundFlesh("");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SpawnExtraFootFlesh(const tString &in asTimer)
		{
			ShadowFlesh_Spawn("ShadowFlesh_Foot_" + mlVitaeValveToDestroy + "_4_*", "Decal_ShadowFlesh_Foot_" + mlVitaeValveToDestroy + "_4", 0.5f, 0.6f, true);
			Effect_Rumble_Start(0.6f, 1.f, 0.25f, 0.25f);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataGroundFlesh;
		void Seq_GroundFlesh(const tString &in asTimer)
		{
			tString sFlesh = "ShadowFlesh_Ground_" + mlVitaeValveToDestroy + "_";
			
			Sequence_Begin("Seq_GroundFlesh", mSeqDataGroundFlesh);
			Sequence_Wait(0.5f);
			if (Sequence_DoStepAndWait(0.2f))
			{
				sFlesh += "1_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 0.75f, true, 0.005f);
				
				Entity_SetActive("DestructionEndingPipe_" + mlVitaeValveToDestroy + "_1", true);
				Entity_FadeEffectBaseColor("DestructionEndingPipe_" + mlVitaeValveToDestroy + "_1", cColor(0.f), 2.f);
				
				Map_AddTimer("Timer_DoEndingDebris_1", 3.75f, "OnTimer_DoEndingDebris");
				
				tString sDebris = "EndingCeilingDebris_" + mlVitaeValveToDestroy;
				Map_AddTimer(sDebris + "_1_1", 4.f, "OnTimer_DoEndingCeilingDebris");
				Map_AddTimer(sDebris + "_1_2", 8.f, "OnTimer_DoEndingCeilingDebris");
				Map_AddTimer(sDebris + "_2_1", 7.f, "OnTimer_DoEndingCeilingDebris");
				Map_AddTimer(sDebris + "_2_2", 9.5f, "OnTimer_DoEndingCeilingDebris");
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(5.3f))
			{
				sFlesh += "2_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 0.75f, true, 0.005f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
				
				Map_AddTimer("Timer_DoEndingDebris_4", 5.1, "OnTimer_DoEndingDebris");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				sFlesh += "3_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 0.75f, true, 0.005f);
				
				sFlesh = "ShadowFlesh_VitaeValveExterior_" + mlVitaeValveToDestroy + "_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 0.75f, true);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				sFlesh += "4_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 0.75f, true, 0.005f);
				
				Map_AddTimer("Timer_DoEndingDebris_3", 0.f, "OnTimer_DoEndingDebris");
				Map_AddTimer("Timer_DoEndingDebris_2", 3.75f, "OnTimer_DoEndingDebris");
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				sFlesh += "5_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.5f, 0.75f, true, 0.005f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoEndingCeilingDebris(const tString &in asTimer)
		{
			Entity_SetActive(asTimer, true);
			Entity_SetCollide(asTimer, false);
			Entity_SetCollideCharacter(asTimer, false);
			
			Effect_Rumble_Start(0.6f, 1.f, 0.25f, 0.25f);
			
			Map_AddTimer(asTimer, 5.f, "OnTimer_DeactivateEndingCeilingDebris");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivateEndingCeilingDebris(const tString &in asTimer)
		{
			Entity_SetActive(asTimer, false);			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoEndingDebris(const tString &in asTimer)
		{
			tString sDebris = "EndingDebris_" + mlVitaeValveToDestroy + "_" + cString_GetNumericSuffixInt(asTimer);
			Entity_SetActive(sDebris, true);
			Prop_SetHealth(sDebris, 0.f);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataFleshWave;
		void Seq_FleshWave(const tString &in asTimer)
		{
			tString sFlesh = "ShadowFlesh_Wave_" + mlVitaeValveToDestroy + "_";
			
			Sequence_Begin("Seq_FleshWave", mSeqDataFleshWave);
			if (Sequence_DoStepAndWait(4.f))
			{
				Map_RemoveTimer("Timer_DoFinalDestruction");
				Map_RemoveTimer("Timer_DoStallDestruction");
				
				Entity_SetActive("DestructionEndingPipe_" + mlVitaeValveToDestroy + "_2", true);
				Entity_FadeEffectBaseColor("DestructionEndingPipe_" + mlVitaeValveToDestroy + "_2", cColor(0.f), 2.f);
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				sFlesh += "1_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.4f, 0.5f, true, 0.005f, 1.f);
				Light_FadeBrightnessTo("Light_Wave_" + mlVitaeValveToDestroy + "_1", 0.5f, 3.f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				sFlesh += "2_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh,0.4f, 0.5f, true, 0.005f, 1.f);
				Light_FadeBrightnessTo("Light_Wave_" + mlVitaeValveToDestroy + "_2", 0.5f, 3.f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				sFlesh += "3_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.4f, 0.5f, true, 0.005f, 1.f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				sFlesh += "4_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.4f, 0.5f, true, 0.005f, 0.5f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(0.8f))
			{
				mbAllowCeilingBreak = false;
				
				sFlesh += "5_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.4f, 0.5f, true, 0.005f, 0.5f);
				Light_FadeBrightnessTo("Light_Wave_" + mlVitaeValveToDestroy + "_5", 0.5f, 0.3f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
				
				FadeEndingCutsceneAnimSpeed(0.75f, 1.f);
			}
			else if (Sequence_DoStepAndWait(0.85f))
			{
				sFlesh += "6_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.4f, 0.5f, true, 0.005f, 0.2f);
				Light_FadeBrightnessTo("Light_Wave_" + mlVitaeValveToDestroy + "_6", 0.5f, 0.3f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(0.7f))
			{
				sFlesh += "7_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.4f, 0.5f, true, 0.005f, 0.f);
				Light_FadeBrightnessTo("Light_Wave_" + mlVitaeValveToDestroy + "_7", 0.5f, 0.3f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(0.6f))
			{
				sFlesh += "8_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.4f, 0.5f, true, 0.f, 0.f);
				Light_FadeBrightnessTo("Light_Wave_" + mlVitaeValveToDestroy + "_8", 0.5f, 0.3f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(0.6f))
			{
				sFlesh += "9_*";
				ShadowFlesh_Spawn(sFlesh, "Decal_" + sFlesh, 0.4f, 0.5f, false, 0.f, 0.f);
				Light_FadeBrightnessTo("Light_Wave_" + mlVitaeValveToDestroy + "_9", 0.5f, 0.3f);
				
				Effect_Rumble_Start(0.5f, 0.75f, 0.25f, 0.25f);
				
				tString sSoundFlesh = sFlesh;
				sSoundFlesh[sSoundFlesh.length() - 1] = '1';				
				iLuxEntity@ pEnt = mBaseObj.GetEntityByName(sSoundFlesh, eLuxEntityType_Prop);
				
				if (pEnt !is null)
					ShadowFlesh_DoFleshEffectsAtPos(pEnt.GetPosition(), 0.f, 0.f);
			}
			else if (Sequence_DoStepAndWait(0.15f))
			{
				tString sLight = "Light_EndingFleshFlicker_" + mlVitaeValveToDestroy;
				Light_SetFlickerActive(sLight, false);
				Light_FadeBrightnessTo(sLight, 0.f, 0.1f, eEasing_SineIn);
				Light_FadeTo(sLight, cColor_Red, 55.f, 0.1f);
			}
			else if (Sequence_DoStepAndWait(0.05f))
			{
				tString sLight = "Light_EndingFleshFlicker_" + mlVitaeValveToDestroy;
				Light_FadeBrightnessTo(sLight, 3.f, 0.6f, eEasing_SineIn);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				ShadowFlesh_DoFleshEffectsAtPos(Player_GetCameraPosition(), 0.f, 0.f);
				
				Effect_Rumble_Start(1.f, 1.f, 0.25f, 0.25f);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoFootDamageEffects(const tString &in asTimer)
		{
			Player_DoDamageEffects(0.1f, 0.02f);
			Sound_PlayGui("player/foley/damage/player_shadow_hit", 1.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DestroyVitaeDialogue(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_Play("Dialogue_DestroyVitae", 2);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoFinalDestruction(const tString &in asTimer)
		{	
			tString sLightFlashArea = "Area_StallDestruction_" + mlVitaeValveToDestroy + "_" + cMath_RandRectl(1, 3);
			
			Effect_Shake_Start(0.002f, 0.75f, 0.25f, 0.5f);
			LightFlash_Add(0.5f, 0.25f, 0.5f, sLightFlashArea, cColor_Red, 12.f, 0.5f);
			
			if (cMath_RandRectl(0, 2) > 0 || Sound_Exists("Sound_StallFlesh") == false)
			{
				Sound_CreateAtEntity("Sound_StallFlesh", "03_03_herberts_hq/shadow_guardian/shadow_guardian_appear", sLightFlashArea, 0.f, false, 0.75f);
				Sound_CreateAtEntity("Sound_Shake", "04_03_undercity/ending/destruction_sweet", sLightFlashArea);
			}
			
			float fTime = cMath_RandRectf(1.f, 2.5f);
			if (cMath_RandRectl(0, 2) == 2)
				fTime = 0.5f;
				
			Map_AddTimer("Timer_DoFinalDestruction", fTime, "OnTimer_DoFinalDestruction");
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Tin Hinan dies*
	 
	//} END SCENE 11 
}