			//Visibility_SetAreaActive("vis_entrance", false);
			
			//Entity_SetActive("PowerCable_*", false);
			//Prop_SetStaticPhysics("PowerCable_*", true);
			
			YoungTinHinan_Activate("TH_Ghost", 1.f);
			Map_GetEntity("TH_Ghost").GetMeshEntity().SetCoverageAmount(1.f);
			Agent_TeleportFeetToEntity("TH_Ghost", "Area_GhostOutsideNurseryTarget");
			
			Player_Teleport("Start_NurseryCorridorEnd");
			Voice_Play("Dialogue_NurseryOpen", -1, "");			
			Map_AddTimer("Timer_OpenNurseryDoors", 0.5f, "OnTimer_OpenNurseryDoors");
			
			Entity_SetActive("Trigger_StartSeqDoctorConfrontation_*", false);
			Entity_SetActive("Trigger_PlayDoctorBegDialogue", false);
			SlideDoor_SetClosed("NurseryDoor_*", false);
			SlideDoor_SetClosed("NurseryEntranceGrate_Door", true);
			
			Entity_SetActive("TH_Beam", true);
			Map_AddTimer("Timer_TempSetupBeam", 0.1f, "OnTimer_TempSetupBeam");
			Map_AddTimer("Timer_TempSetupBeamPassive", 1.f, "OnTimer_TempSetupBeamPassive");
			Map_AddTimer("Timer_TempBeamLookUp", 1.5f, "OnTimer_TempBeamLookUp");
		}
		
		if (alAction == eAction_Test7)
		{
			//Entity_SetActive("Cover_*", !Entity_IsActive("Cover_15"));
			/*Light_SetCastShadows("Light_Spot_18", false);
			Light_SetCastShadows("Light_VitaeValve_1_4", false);
			Light_SetCastShadows("Light_VitaeValve_2_7", false);
			Light_SetCastShadows("Light_VitaeValve_3_7", false);
			Light_SetCastShadows("cage_flash_light_front_1", false);*/
			
			//Entity_SetActive("Cover_*", !Entity_IsActive("Cover_11"));
			
			//Seq_DoctorConfrontation("");
			
			//Entity_FadeEffectBaseColor("TH_Beam_1", cColor(1,0.855,0.639,1), 0.5f);
			
