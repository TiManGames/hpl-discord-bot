		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 5 here.*/
		
		bool OnTrigger_Player_StartThroneRoomThunder(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_RemoveTimer("Timer_DoLightning");
			Map_AddTimer("Timer_DoLightning", 0.5f, "OnTimer_DoLightning");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoLightning(const tString &in asTimer)
		{
			if (mbLeftCeilingFleshSpawned && mbRightCeilingFleshSpawned)
				return;
			
			bool bDoLightning = true;
			for (int i = 1; i < 4; ++i)
			{
				if (Entity_GetCollide("Area_DisallowLightning_" + i, "player"))
				{
					bDoLightning = false;
					break;
				}
			}
			
			if (Entity_GetCollide("Area_ThroneRoomThunder", "player") == false)
				bDoLightning = false;
							
			if (bDoLightning)
			{
				Seq_DarkWorldLightning("");
				
				++mlLightningCount;
				if (mlLightningCount > 1)
					mbLightningLeft = cMath_RandRectl(0, 1) == 0;
					
				if (mbLeftCeilingFleshSpawned)
					mbLightningLeft = false;
				if (mbRightCeilingFleshSpawned)
					mbLightningLeft = true;
			}
			
			Map_RemoveTimer("Timer_DoLightning");
			
			float fTime = cMath_RandRectl(0, 3) > 0 ? cMath_RandRectf(15.f, 25.f) : cMath_RandRectf(2.f, 4.f);
			Map_AddTimer("Timer_DoLightning", fTime, "OnTimer_DoLightning");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataDarkWorldLightning;	
		void Seq_DarkWorldLightning(const tString &in asTimer)
		{
			tString sArea = mbLightningLeft ?  "Area_ThunderSound_Left" : "Area_ThunderSound_Right"; 
			tString sLights = mbLightningLeft ?  "Light_Lightning_Left_*" : "Light_Lightning_Right_*"; 
			
			Sequence_Begin("Seq_DarkWorldLightning", mSeqDataDarkWorldLightning);
			if (Sequence_DoStepAndWait(0.1f))
			{
				Sound_CreateAtEntity("Sound_Thunder", "level_amb_shared/amb/sweeteners/thunder/thunder_strike_inside", sArea, 0.0f, false, 0.5f);
			}
			else if (Sequence_DoStepAndWait(0.06f))
			{
				Light_FadeBrightnessTo(sLights, 150.f, 0.1f, eEasing_SineIn);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Light_FadeBrightnessTo(sLights, 0.f, 1.f, eEasing_SineOut);
			}
			Sequence_End();
		}
			 
		//-------------------------------------------------------
		
		//} END General
	 
		/////////////////////////////////////////
		// Event A *Spot the DOCTOR by Tin Hinan*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event A here.*/
		
		bool mbDoctorConfrontationSeqStarted = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 5, Event A here.*/
		
		bool OnTrigger_Player_OpenPortalRoomDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbPortalRoomDoorsOpen)
				return false;
			
			int lId = cString_GetNumericSuffixInt(asParent);
			SlideDoor_SetClosed("PortalRoomDoor_" + lId + "_*", alState == -1);
			cScript_SetGlobalVarBool("Undercity_OpenedThroneRoomDoors", true);
			return true;
		}
				
		//-------------------------------------------------------
		
		bool OnTrigger_Player_PlayDoctorBegDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_PlayDoctorBegDialogue", 0.25f, "OnTimer_PlayDoctorBegDialogue");
			return false;
		}

		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartSeqDoctorConfrontation(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbDoctorConfrontationSeqStarted)
				return false;
				
			Seq_DoctorConfrontation("");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartSeqDoctorConfrontation(const tString &in asEntity, int alState)
		{
			if (mbDoctorConfrontationSeqStarted)
				return;
				
			Seq_DoctorConfrontation("");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayDoctorBegDialogue(const tString &in asTimer)
		{
			Entity_SetActive("Doctor_ThroneRoom", true);
			Agent_PlayCutsceneAtEntity("Doctor_ThroneRoom", "doctor_doc_confrontation", "Area_ConfrontationAnim", 0.f, false);
			Map_GetEntity("Doctor_ThroneRoom").GetMeshEntity().GetAnimationStateFromName("doctor_doc_confrontation").SetSpeed(0.f);
			
			Entity_AttachToSocket("Area_DocVoiceSource", "Doctor_ThroneRoom", "VoiceSocket", true, true);
			Voice_SetSource("Doctor", "Doctor_ThroneRoom", 2.f, 38.f, true);
			Voice_Play("Dialogue_DoctorShoutingAtTinHinan");
			
			Map_AddTimer("Timer_PlayDoctorBegDialogue", 3.f, "OnTimer_PlayDoctorBegDialogue");
		}
		
		//-------------------------------------------------------

		//} END Event A *Spot the DOCTOR by Tin Hinan*
		
		/////////////////////////////////////////
		// Event B *Tasi and the DOCTOR fight*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event B here.*/
		
		int mlGhostAppearLineId = 0;
		float mfPreConfrontationFear = 0.f;
		int mlThroneParticleGoalId = 0;
		int mlDocDecalId = 0;
		float mfBeamGhostParticleCount = 0.f;
		float mfBeamGhostParticleTime = 0.f;
		bool mbUpdateBeamGhostParticles = false;
		array<cVector3f> mvBeamGhostParticleGoals;
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 5, Event B here.*/
		
		cSequenceStatesData mSeqDataDoctorConfrontation;
		void Seq_DoctorConfrontation(const tString &in asTimer)
		{
			Sequence_Begin("Seq_DoctorConfrontation", mSeqDataDoctorConfrontation);
			if (Sequence_DoStepAndWait(1.2f))
			{					
				mbDoctorConfrontationSeqStarted = true;
							
				Map_RemoveTimer("Timer_PlayDoctorBegDialogue");
				
				Voice_StopAll();
				Voice_Play("Dialogue_DoctorConfrontation", -1, "OnVoiceEnd_DoctorConfrontation");
				
				Entity_AttachToSocket("Area_DocVoiceSource", "Doctor_ThroneRoom", "VoiceSocket", true, true);
				Voice_SetSource("Doctor", "Doctor_ThroneRoom", 2.f, 38.f, true);
				Voice_SetSource("Tin Hinan", "TH_Ghost", 10.f, 150.f, true);
				
				mfPreConfrontationFear = FearHandler_GetLevel();				
				FearHandler_SetForcedAddFearRate(0.5f, -1.f, false);
				
				/////////////////////////
				// Start anims
				Entity_SetActive("Doctor_ThroneRoom", true);
				CharMover_SetUseMoveStateAnimations("Doctor_ThroneRoom", false);
				Agent_PlayCutsceneAtEntity("Doctor_ThroneRoom", "doctor_doc_confrontation", "Area_ConfrontationAnim", 0.f, false, "OnAnimEndAgent_DoctorConfrontation");
				Map_GetEntity("Doctor_ThroneRoom").GetMeshEntity().GetAnimationStateFromName("doctor_doc_confrontation").SetSpeed(1.f);
				Entity_SetAnimationMessageEventCallback("Doctor_ThroneRoom", "OnAnimEvent_DoctorConfrontation", false);
				Sound_CreateAtEntity("Sound_DoctorDeath", "04_03_undercity/doctor_death/doctor_death_anim", "Doctor_ThroneRoom");
				Sound_CreateAtEntity("Sound_DoctorDeathPlayer", "04_03_undercity/doctor_death/doctor_death_player", "player");

				
				PlayerBody_PlayCutsceneAtEntity("player_doc_confrontation", "Area_ConfrontationAnim", false, 0.3f, "OnAnimEnd_DoctorConfrontation");
				PlayerBody_SetCutsceneMaxPitch(5.f);
				PlayerBody_SetCutsceneMaxYaw(5.f);
				
				Music_Play("A2_4_3_Doctor_Catch.ogg", 0.2f, false, eMusicPrio_MinorEvent);
			}
			else if (Sequence_DoStepAndWait(2.2f))
			{
				if (SequenceStates_IsActive("Seq_DarkWorldLightning") == false)
					OnTimer_DoLightning("Timer_DoLightning");
			}
			else if (Sequence_DoStepAndWait(3.5f))
			{
				FearHandler_PlayStruggleSoundLoop(2.5f, 0.2f, false);
				FearHandler_FadeLevelTo(1.f, 4.f);
				FearHandler_SetForcedAddFearRate(1.f, 14.f, false);
				
				Player_SetLookSpeedMul(1.f);
				Player_SetMoveSpeedMul(0.8f);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetPermafailFadeProgression(), 2.0f);
			}
			else if (Sequence_DoStepAndWait(4.5f))
			{
				FearHandler_PlayStruggleSoundLoop(2.5f, 0.75f, false);
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				Entity_SetActive("TH_Beam", true);
				
				cLux_ToAgent(Map_GetEntity("TH_Beam")).GetCharBody().SetGravityActive(false);
				Entity_SetActive("TH_Beam_Closed", false);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				TinHinan_SetSpotlightOn("TH_Beam", false);
				TinHinan_Setup("TH_Beam", "Cover_*", "Area_Cover_*", "TH_Ghost");				
			}
			else if (Sequence_DoStepAndWait(3.f))
			{
				FearThreatAgent_SetComponentEnabled("TH_Beam", false);
				
				TinHinan_SetPassive("TH_Beam", true);				
				
				Entity_PlayAnimation("TH_Beam", "open_up", 0.f, false, true, "OnAnimEnd_THOpenUp");
				Entity_SetAnimationMessageEventCallback("TH_Beam", "OnAnimEvent_TinHinanOpenUp", false);
			}
			else if (Sequence_DoStepAndWait(9.f))
			{
				FearHandler_PlayStruggleSoundLoop(3.0f, 0.5f, false);
				Effect_DollyZoom_Start(-0.45f, 10.f, 0.5f, 5.f);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				FearHandler_StopStruggleSoundLoop(3.0f);
				TinHinan_SetSpotlightColor("TH_Beam", "idle");
				TinHinan_SetSpotlightOn("TH_Beam", false, false, 4.f);				
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{		
				GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetPermafailFadeProgression(), 0.1f);
				
				FearHandler_FadeLevelTo(mfPreConfrontationFear, 3.f);
				FearHandler_SetForcedAddFearRate(0.f, 1.f, false, -1.f, 0.025f);
			}
			else if (Sequence_DoStepAndWait(0.49f))
			{
				GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetProgression(), 3.0f);
			}
			else if (Sequence_DoStepAndWait(2.5f))
			{
				StartBeamGhostParticleMove(2.5f, Map_GetEntity("TH_Beam_crystal", eLuxEntityType_Prop).GetPosition(),
												 Map_GetEntity("Area_ThroneParticleGoal_1", eLuxEntityType_Area).GetPosition(),
												 Map_GetEntity("Area_ThroneParticleGoal_2", eLuxEntityType_Area).GetPosition(),
												 Map_GetEntity("Area_ThroneParticleGoal_3", eLuxEntityType_Area).GetPosition());
			}
			else if (Sequence_DoStepAndWait(0.01f))
			{
				YoungTinHinan_Activate("TH_Ghost", 1.f);
				YoungTinHinan_SetAutoTurnTowardPlayer("TH_Ghost", false);
				FootPlacement_FadeOut("TH_Ghost", 0.3f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Entity_PlayAnimation("TH_Ghost", "tinhinan_throne_room_reveal", 0.f, false, true, "OnAnimEnd_GhostReveal");
				Map_GetEntity("TH_Ghost", eLuxEntityType_Agent).GetMeshEntity().GetAnimationStateFromName("tinhinan_throne_room_reveal").SetSpeed(0.f);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Entity_SetEffectsActive("Ghost_Particles", false, true);
				OnVoiceEnd_GhostAppear("", "");
				
				//Sound_CreateAtEntity("Sound_GhostParticlesStop", "creatures/foley/creature/tin_hinan/phase/end", "Ghost_Particles", 0.f, false, 1.f, 20.f, 50.f);
				Sound_Stop("Sound_GhostParticlesMove", 0.3f);
			}
			else if (Sequence_DoStepAndWait(4.f))
			{
				Entity_SetActive("Ghost_Particles", false);
				Map_GetEntity("TH_Ghost", eLuxEntityType_Agent).GetMeshEntity().GetAnimationStateFromName("tinhinan_throne_room_reveal").SetSpeed(1.f);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_THOpenUp(const tString &in asEntity, const tString &in asAnim)
		{
			Entity_PlayAnimation("TH_Beam", "idle_1", 0.3f);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEndAgent_DoctorConfrontation(const tString &in asAgent, const tString &in asAnim)
