	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(1);
		Player_SetMapDeepShadow(mfDeepShadowLevel);
//		Player_SetNightVisionStrength(1.15f);
		//Player_SetNightVisionEnabled(false);
		// Any general setup of script / entities
		
		if (ItemType_GetCountInInventory("CurseMedallion") < 1)
		{
			Item_AddToInventory("CurseMedallion");
		}
			
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			if (ItemType_GetCountInInventory("Lantern") < 1)
			{
				Item_AddToInventory("Lantern");
				Lantern_SetAmount(10);
			}
			
			Item_AddToInventory("ModernOilFixed");
			Item_AddToInventory("ModernOilFixed");
			//Item_AddToInventory("Matchbook", true);
			Item_AddToInventory("Matchbook");
			Item_AddToInventory("Matchbook");
		}
		else
		{
		}
		
		//cExposureArea@ pExpo = cLux_GetCurrentMap().GetWorld().GetExposureArea("ExposureArea_Camp");
		//pExpo.ConnectExposureAreaWindow(cLux_GetCurrentMap().GetWorld().GetExposureArea("ExposureArea_Camp_LookAt"));
		Entity_PlayAnimation("ghoulscare_1_test","leans_around_corner_right_slow",0,true);
		Entity_PlayAnimation("ghoulscare_2_test","crouch_idle_ledge",0,true);
		Entity_SetAnimationPaused("ghoulscare_2_test","crouch_idle_ledge",true);
		Slide_SetSlideAmount("arabic_fort_door_lock_01_1",0);
		Entity_SetAnimationMessageEventCallback("Player","OnAnimMessage_Player",false);
		
		ParticleSystem_SetActive("sandfalling_01", false);
		//Music_Play("A2_Proto_CreepyDesertAmbience", 0.2, false, eMusicPrio_BigEvent);
		
		//Lamp_SetupFlicker("torch_lamp_11",0.5f,1,0.5f,1,true);
		//Light_SetupFlicker("torch_light_78",cColor(1,0.863,0.678,0.298),10,0.5f,1,"","",0.5f,1,"","",false,0.5f,1,0.5f,1);
		//Lamp_SetFlickerActive("torch_lamp_11",true);
		
		Effect_FearTentacles_SetVignetteMul(0.82f);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		PlayerBody_SetActive(true);
		FearHandler_SetUpdateInterval(0.4f);
		FearHandler_SetPermaFailEnabled(false);
        Heat_SetActive(false);
		
		// Updated 200403
		Player_SetNightVisionBrightness(2.3f);
		Player_SetNightVisionRadius(5.5f);
		
		if(cLux_ScriptDebugOn() == false)
		{
			//Player_Teleport("Start_Begin");
			Player_SetMoveSpeedMul(0.8f);
			Player_SetRunSpeedMul(0.3f);
			Player_FadeMoveSpeedMulTo(1,15);
		}
		
		Hint_Block("Hints", "HintPermafail");		
		RiftHandler_SetAllowHint(false);
		
		Item_SetHidden(ItemType_GetFirstInInventory("CurseMedallion"), true);
		
		Achievement_Unlock(eAchievement_Amnesiac);
		
		cLux_ClearAllMapSaveData();
		Game_AutoSave();	
	}
	
	void Update(float afTimeStep) 
	{	
		UpdateLightLevelBarks(afTimeStep);
		//UpdateFearLevelBarks();
		//Debug_Log("RUN SPEED: "+Player_GetRunSpeedMul());
	}
	
