			FearHandler_SetPermaFailPlayVocals(true);
			Map_AddTimer("Timer_PainIsGone",5,"OnTimer_PainIsGone");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PainIsGone(const tString &in asTimer)
		{
			Voice_Play("Dialogue_FeelBetter");
		}
		
		//-------------------------------------------------------
		
