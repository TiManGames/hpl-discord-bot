		bool OnCollide_Player_SlowWalk(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Player_SetRunSpeedMul(0.5f);
				Player_SetMoveSpeedMul(0.5f);
				Player_SetJumpForceMul(0.6f);
			}
			else
			{
				Player_SetRunSpeedMul(1);
				Player_SetMoveSpeedMul(1);
				Player_SetJumpForceMul(1);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_Fall(const tString &in asParent, const tString &in asChild, int alState)
		{
			tString sLength = Entity_GetVarString(asParent,"");
			CameraAnimation_Begin("CamAnim_"+sLength,"",true);
			FearHandler_FadeLevelTo(0.75f,0.2f);
			//Sound_CreateAtEntity("Sound_Fall","Global_Tasi_Bark_Stage3_Fall_Start","player");
			Voice_Play("Global_Tasi_Bark_Stage3_Fall_Start");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_PlankCreak(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) 
			{
				if (asParent == "Trigger_Creak_3") Voice_PlayDelayed("Dialogue_CrossingPlankBarks",0.3f,4);
				else	Voice_PlayDelayed("Dialogue_CrossingPlankBarks",0.3f);
			}
			
			Debug_Log("SOUND"+cMath_RandRectl(0,10));
			Sound_CreateAtEntity("Sound_PlankCreak","02_04_living_quarters/floor_plank/floor_plank_creak",asChild);
			Sound_AddClosedCaption("01_02_caves","CC_WoodCreak",0.8f);
			
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_PlayNestSounds(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Play("Sound_SweetGhoul_1", 0.0f);
			Sound_Play("Sound_RockSlideSweet", 0.0f);
			return false;
		}
		
		//-------------------------------------------------------
			bool OnTrigger_PlayFeetScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Play("Sound_FeetScare", 0.0f);
			Sound_Play("Sound_WindSweet_1", 0.0f);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_BreakPlank(const tString &in asParent, const tString &in asChild, int alState)
		{
			//FearHandler_SetPermaFailEnabled(true);
			Sound_CreateAtEntity("Sound_PlankBreak","02_04_living_quarters/floor_plank/floor_plank_splinter",asChild);
			Entity_SetActive("Plank_2",false);
			Entity_SetActive("Plank_Broken_1",true);
			FearHandler_SetForcedAddFearRate(1,5);
			FearHandler_FadeLevelTo(0.75f,0.2f);
			//CameraAnimation_Begin("CamAnim_Fall2","",true);
			Voice_StopAll();
			Voice_Play("Dialogue_TheFall_Start");
			//Voice_Play("Global_Tasi_Bark_Stage3_Fall_Start");
			
			Music_Stop(1.0f, eMusicPrio_BgAmb);
			Music_Play("A2_01_02_FallingDown_Stinger.ogg", 0.3f, false, eMusicPrio_BigEvent);
			
			Sound_CreateAtEntity("Sound_PlayerFall","01_02_caves/scare_events/tasi_cave_fall", "player");
			Sound_Stop("Sound_RockSlideSweet", 2.0f);
			Sound_Stop("Sound_FeetScare", 1.0f);
			Sound_Stop("Sound_CritterSweet", 1.0f);
			Sound_Stop("Sound_GoreSweet_1", 1.0f);
			
			PlayerBody_PlayCutsceneAtEntity("fall_from_collapsed_plankbridge","PosArea_BridgeCollapseAnim",false,1);
			Map_AddTimer("Timer_HitGround",11.3f,"OnTimer_HitGround");
			Map_AddTimer("Timer_GhoulSound",4.5f,"OnTimer_PlayGhoulSound");
			
			Seq_PlankFallRumbles();
			
			mbFearBarksAllowed = false;
			
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqPlankFallRumbles;
		
		void Seq_PlankFallRumbles(const tString& in asTimer="")
		{
			Sequence_Begin("Seq_PlankFallRumbles", mSeqPlankFallRumbles);
		
			if (Sequence_DoStepAndWait(1.f))
			{
				Effect_Rumble_Start(0.5f, 0.5f, 0.1f, 0.2f);
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				Effect_Rumble_Start(0.75f, 0.75f, 0.1f, 1.0f);
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				Effect_Rumble_Start(0.5f, 5.f, 0.1f, 0.3f);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Effect_Rumble_Start(1.0f, 0.25f, 0.1f, 0.1f);
			}
			else if (Sequence_DoStepAndWait(7.5f))
			{
				Effect_Rumble_Start(1.0f, 0.25f, 0.1f, 0.1f);
			}
			else if (Sequence_DoStepAndContinue())
			{
				Effect_Rumble_Start(1.0f, 0.5f, 0.0f, 0.0f);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_HitGround(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_HitGround",false);
			Effect_Fade_Out(0.1f);
			Map_AddTimer("Timer_PlayStruggleSound",0.75f,"OnTimer_PlayStruggleSound");
			Map_AddTimer("Timer_PlayerWakeupAfterFall",1,"OnTimer_PlayerWakeUpAfterFallNew");
			Music_Play("A2_01_02_PitAmbience.ogg", 0.5f, false, eMusicPrio_BgAmb);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayGhoulSound(const tString &in asTimer)
		{
			Sound_Play("Sound_GhoulPit", 0.0f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_HitsGround(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbFearBarksAllowed = false;
			Voice_StopAll();
			cLux_AddDebugMessage("GROUND");
			Effect_Fade_Out(0.1f);
			//Sound_CreateAtEntity("Sound_FallImpact","player/foley/damage/player_fall_damage","player");
			//Sound_CreateAtEntity("Sound_FallDamage","player/foley/damage/player_hit","player");
			Map_AddTimer("Timer_PlayStruggleSound",3.75f,"OnTimer_PlayStruggleSound");
			Map_AddTimer("Timer_PlayerWakeupAfterFall",4,"OnTimer_PlayerWakeUpAfterFallNew");
			Music_Play("A2_01_02_PitAmbience.ogg", 0.5f, false, eMusicPrio_BgAmb);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayStruggleSound(const tString &in asTimer)
		{
			FearHandler_PlayStruggleSoundLoop(2.0f, 0.75f, false);
		}
		
