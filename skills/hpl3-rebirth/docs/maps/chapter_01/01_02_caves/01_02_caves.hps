		/////////////////////////////////////////
		// Event C *Player finds the Shrine Room and creates a safe room
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event C here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event C here.*/
		
		bool OnCollide_Player_EnterSafeRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			//Hint_ShowHint_Hold("Hints", "SafeRoom", true);
			Voice_PlayDelayed("Dialogue_TheShrine",1);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnBreak_Pot(const tString &in asEntity)
        {
			tString sContent = Entity_GetVarString(asEntity,"");
            Prop_RemoveAttachedProp(asEntity,sContent);
			Prop_SetStaticPhysics(sContent,false);
		}
		
		//-------------------------------------------------------
		
		void OnStateChange_SlideLock_Shrine(const tString &in asEntity, int alState)
		{
			if (SwingDoor_GetOpenAmount("Door_SafeRoom") > .1f) return;
			
			if (alState == 1)
			{
				Entity_SetActive("Safe_Room",true);
				Map_AddTimer("Timer_ShrineStory",3,"OnTimer_ShrineStory");
				Debug_Log("SAFE");
				cLux_AddDebugMessage("yoooooooooooooooooooooooooooooo");
			}
			if (alState == -1)
			{
				Entity_SetActive("Safe_Room",false);
				Debug_Log("UNSAFE");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_InSafeRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				if (Map_TimerExists("Timer_IsInSafeRoom") == false)
					Map_AddTimer("Timer_IsInSafeRoom", 1, "OnTimer_IsInSafeRoom");
			}
			else
			{
				Map_RemoveTimer("Timer_IsInSafeRoom");
			}
				
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_IsInSafeRoom(const tString &in asTimer)
		{
			cLux_AddDebugMessage("CHECK DOOR");
			if (SwingDoor_GetOpenAmount("Door_SafeRoom") > .1f)
			{
				Map_RestartCurrentTimer();
				return;
			}
			
			if (Map_TimerExists("Timer_ShrineStory") == false)
				Map_AddTimer("Timer_ShrineStory",2.5f,"OnTimer_ShrineStory");
				
			Map_RestartCurrentTimer();
			
		}

		//------------------------------------------------------- 
		
		bool OnCollide_Lock_SafeRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (SwingDoor_GetOpenAmount("Door_SafeRoom") > .1f) return true;
			
			if (alState == 1)
			{
				//Entity_SetActive("Safe_Room",true);
				FearArea_SetLocked("Safe_Room", true);
				Map_AddTimer("Timer_ShrineStory",3,"OnTimer_ShrineStory");
				Debug_Log("SAFE");
			}
			if (alState == -1)
			{
				//Entity_SetActive("Safe_Room",false);
				FearArea_SetLocked("Safe_Room", false);
				Debug_Log("UNSAFE");
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShrineStory(const tString &in asTimer)
		{
			if (Voice_CharacterIsSpeaking("Player"))
				Map_RestartCurrentTimer(2);
			else
				Voice_Play("Dialogue_ShrineStory");
		}
		
		//} END Event C *Player finds the Shrine Room and creates a safe room*
		
	//} END SCENE 2
	
