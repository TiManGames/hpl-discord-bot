	//-------------------------------------------------------
	
	int mlPermaFailStage = eCavesPermaFail_DeepCaves;
	
	bool OnCollide_Player_SetPermaFail(const tString &in asParent, const tString &in asChild, int alState)
	{		
		if (alState != 1) return true;
		
		if (asParent == "Trigger_SetPermaFail_DeepCaves")			mlPermaFailStage = eCavesPermaFail_DeepCaves;
		else if (asParent == "Trigger_SetPermaFail_Bridges") 		mlPermaFailStage = eCavesPermaFail_Bridges;
		else if (asParent == "Trigger_SetPermaFail_PreDarkWorld") 	mlPermaFailStage = eCavesPermaFail_PreDarkWorld;
		else if (asParent == "Trigger_SetPermaFail_DarkWorld") 		mlPermaFailStage = eCavesPermaFail_DarkWorld;
		else if (asParent == "Trigger_SetPermaFail_PostDarkWorld") 	mlPermaFailStage = eCavesPermaFail_PostDarkWorld;
	
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail()
	{		
		switch (mlPermaFailStage)
		{
			case eCavesPermaFail_DeepCaves:		PermaFail_Default("DeepCaves_*"); 		return true;
			case eCavesPermaFail_Bridges:		PermaFail_Default("Bridges_*"); 		return true;
			case eCavesPermaFail_Nest: 			PermaFail_Nest(); 						return true;
			case eCavesPermaFail_PreDarkWorld: 	PermaFail_Default("PreDarkWorld_*"); 	return true;
			case eCavesPermaFail_DarkWorld: 	PermaFail_Default("DarkWorldFall_*"); 	return true;
			case eCavesPermaFail_PostDarkWorld: PermaFail_Default("PostDarkWorld_*"); 	return true;
		}
		
		return true;
	}
	
	bool OnPermaFailRespawn()
	{
		if (mlPermaFailStage == eCavesPermaFail_Nest) 	
		{
			cLux_AddDebugMessage("NOEEEEEEEEEEEEEEEE");
			Voice_StopAll();
			mlBlurID = Effect_Blur_Start(2,0);
			mlTrailID = Effect_ImageTrail_Start(3,0,5,3);
			Map_AddTimer("Timer_WakeUpBark",0,"OnTimer_WakeUpBark");
			Entity_SetActive("Trigger_WakeUpBark",false);
			Effect_Blur_FadeOut(mlBlurID,3);
			Seq_PermaFailRespawn_Nest("");
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void PermaFail_Default(const tString &in asArea)
	{
		FearHandler_SetPermaFailRespawnArea("PermaFail_"+asArea);
	}
	
	//-------------------------------------------------------
	
	void PermaFail_Nest()
	{
		mbFearBarksAllowed = false;
		FearHandler_AddPermaFailScene("PosArea_PermaFail_A_Start", "PosArea_PermaFail_A_End", 5.f, 1.5f, true);
		FearHandler_AddPermaFailScene("PosArea_PermaFail_B_Start", "PosArea_PermaFail_B_End", 8.f, 1.5f, true);
		FearHandler_AddPermaFailScene("PosArea_PermaFail_C_Start", "PosArea_PermaFail_C_End", 3, 3.f, true);
		FearHandler_SetPermaFailRespawnArea("PermaFail_PostNest");
		//Map_AddTimer("Timer_PermafailRespawn",16,"OnTimer_PermafailRespawn");
		FearHandler_SetPermaFailPlayVocals(false);
		
	}
	
	void OnTimer_PermafailRespawn(const tString &in asTimer)
	{
		Seq_PermaFailRespawn_Nest("");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequencePermaFailRespawnNest;
	void Seq_PermaFailRespawn_Nest(const tString &in asTimer)
	{
		Sequence_Begin("Seq_PermaFailRespawn_Nest", mSequencePermaFailRespawnNest);
		if (Sequence_DoStepAndWait(3.f))
		{			
			Player_SetMoveSpeedMul(0.f);
            Player_SetLookSpeedMul(0.f);			
			//Music_Stop(0.5f, eMusicPrio_BgAmb);
		}
		else if (Sequence_DoStepAndWait(3.f))
		{
			//Effect_ImageTrail_Start(1.2f,0,10,5);
			//PlayerBody_PlayAnimation("wake_up_from_death_1a",ePlayerBodyAnimationLayer_FullBody,false,false,true);
			//PlayerBody_PlayCutsceneAtEntity("wake_up_from_death_1a","player",false,0.3f,"");
			Effect_Fade_In(2.f);
			Map_Preset_Fade("Wakeup", 0.5f);
		}
		else if (Sequence_DoStepAndWait(1.f))
		{
			Player_SetMoveSpeedMul(.6f);
            Player_SetLookSpeedMul(1.f);
			Player_SetRunSpeedMul(.4f);
		}
		else if (Sequence_DoStepAndWait(1.f))
		{
			Player_FadeMoveSpeedMulTo(1.f,5.f);
			Player_FadeMoveSpeedMulTo(1.f,10);
			Map_Preset_Fade("OutsideRift", 6.0f);
			ParticleSystem_SetActive("sandfalling_01", true);
			
			FearHandler_SetAllowDarknessReminderHint(true);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequencePermaFailDarkWorldFall;
	void Seq_PermaFail_DarkWorldFall(const tString &in asTimer)
	{
		Sequence_Begin("Seq_PermaFail_DarkWorldFall", mSequencePermaFailDarkWorldFall);
		if (Sequence_DoStepAndWait(3.f))
		{			
			Player_SetMoveSpeedMul(0.f);
            Player_SetLookSpeedMul(0.f);			
			Player_Teleport("Start_PostPermafail");
			Music_Stop(1.5f, eMusicPrio_BgAmb);
		}
		else if (Sequence_DoStepAndWait(3.f))
		{
			Effect_ImageTrail_Start(1.2f,0,10,5);
			//PlayerBody_PlayAnimation("wake_up_from_death_1a",ePlayerBodyAnimationLayer_FullBody,false,false,true);
			//PlayerBody_PlayCutsceneAtEntity("wake_up_from_death_1a","player",false,0.3f,"");
			PlayerBody_PlayCutsceneAnimation("wake_up_from_death_1a",false,0.3f);
			Effect_Fade_In(2.f);
		}
		else if (Sequence_DoStepAndWait(1.f))
		{
			Player_SetMoveSpeedMul(1.f);
            Player_SetLookSpeedMul(1.f);
			Player_SetRunSpeedMul(1.f);
		}
		Sequence_End();
	}
	
