		//-------------------------------------------------------
		
		void DeepCaves_WindGust()
		{
			mbFearBarksAllowed = true;
			Sound_CreateAtEntity("Sound_TunnelWind", "01_02_caves/scare_events/wind_scare_flame", "SoundArea_Wind");
			Sound_AddClosedCaption("01_02_caves","CC_WindFlame");
			Map_AddTimer("Timer_TorchOff",0.9f,"OnTimer_TorchOff");
			//Map_AddTimer("Timer_SoundAnimalsDelay",1.5f,"OnTimer_SoundAnimalsDelay");
			ParticleSystem_CreateAtEntity("windgust", "wind_scare.ps", "SoundArea_Wind", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TorchOff(const tString &in asTimer)
		{
			
			FearHandler_FadeLevelTo(0.6f,2.f);
			FearHandler_SetForcedAddFearRate(0.7f,3);
			Lamp_SetLit("brazier_5",false,true);
			Lamp_SetLit("torch_lamp_5",false,true);
			Lamp_SetLit("torch_lamp_9",false,true);
		}
		
