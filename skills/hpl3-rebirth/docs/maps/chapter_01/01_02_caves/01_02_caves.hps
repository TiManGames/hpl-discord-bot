		/*Put any variables that are only used in Scene 4, Event B here.*/
		
		bool mbShowedAmuletHint = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ShowUnequipAmuletHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbShowedAmuletHint == false && Amulet_IsHeld())
			{
				mbShowedAmuletHint = true;
				Hint_ShowHint_Hold("Hints", "HintAmulet", true, 1.5f, false, 10.f);
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_Memory(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sketchbook_UnlockMemory("LeavingSalim");
			return false;
		}

