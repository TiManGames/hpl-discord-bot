		/////////////////////////////////////////
		// Event A *Player explores the caves and finds the overlap*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event A here.*/
		
		bool mbRiftOpen = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 4, Event A here.*/
				
		int mlBlurID = -1;
		int mlTrailID = -1;
		
		void Player_WakeUp(const tString &in asAnim, float afFadeTime)
		{
			mlBlurID = Effect_Blur_Start(4,0);
			mlTrailID = Effect_ImageTrail_Start(3,0,5,3);
			PlayerBody_PlayAnimation(asAnim,ePlayerBodyAnimationLayer_FullBody,false,false,false);
			Effect_Fade_In(afFadeTime);
			Map_AddTimer("Timer_WakeUpBark",0,"OnTimer_WakeUpBark");
			Entity_SetActive("Trigger_WakeUpBark",false);
			Effect_Blur_FadeOut(mlBlurID,3);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_WakeUpBark(const tString &in asTimer)
		{	
			Voice_StopAll();
			Voice_PlayDelayed("Dialogue_PostPermafail",3,-1,"OnEndOfVoice_PainIsGone");
			
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_WakeUpBark(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_WakeUpBark",0,"OnTimer_WakeUpBark");
			return false;
		}
		
		//-------------------------------------------------------
		
