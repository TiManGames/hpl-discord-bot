	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 1 *PLAYER EXPLORES THE CAVES AND THE SURVIVOR'S CAMP*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 1 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 1 here.*/
		
		bool OnCollide_ShimmyEnter(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;

			Hint_StopHint();
			Player_FadeNightVisionStrength(0,3);
			PlayerBody_PlayInteractiveAnimationAtEntity("squeeze_through_crack_ghoul_encounter","PosArea_Shimmy",0.2f,"",false);
			Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(),"OnAnimMessage_Player",false);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnAnimMessage_Player(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 0) // Push door closed
			{
				OnCollide_Player_Scare("","",1);
			}
			if (alMessageEventID == 852) // Look at hands, magic number to avoid collision with generic events
			{
				GhoulScare_LookAtHands();
			}
		}
		
		//------------------------------------------------------- 
		
	    bool OnCollide_Player_Scare(const tString &in asParent, const tString &in asChild, int alState)
        {
		   // Entity_PlayAnimation("ghoulscare", "sniff_long_2", 0.1, true, false, "");
	        Prop_MoveLinearTo("ghoulscare_2_test","ghoulscare_2_test_target",1,7,0,false,"");
			//Entity_PlayAnimation("ghoulscare_1_test","leans_around_corner_right_exit",0,false);
			Map_AddTimer("Timer_GhoulGetUp",0.5f,"OnTimer_GhoulGetUp");
			Map_AddTimer("Timer_GhoulGetUpSound",1.5f,"OnTimer_GhoulGetUpSound");
			Map_AddTimer("Timer_BackAway",2.0f,"OnTimer_BackAway");
			Map_AddTimer("Timer_BackAwayPermafail",8.3f,"OnTimer_BackAwayPermafail");
			Sound_CreateAtEntity("Sound_Movement","01_02_caves/scare_events/ghoul_nest_movement_02","ghoulscare_2_test");
		    cLux_AddDebugMessage("ghoul on the move");
	        return false;
        }
		
		//-------------------------------------------------------
		
		void OnTimer_GhoulGetUp(const tString &in asTimer)
		{
			//Prop_SetActiveAndFade("fetish_light_2",true,1);
			//Prop_SetActiveAndFade("fetish_light_1",false,1);
			FearHandler_SetPermaFailEnabled(true);
			FearHandler_FadeLevelTo(1,0.5f);
			FearHandler_SetForcedAddFearRate(1,15,false);
			Entity_PlayAnimation("ghoulscare_2_test","eat_ground_tr_idle_stand_slow",0.7f,false);
			Map_AddTimer("Timer_SlowDownAnim",0.4,"OnTimer_SlowDownAnim");
			Entity_SetAnimationSpeed("ghoulscare_2_test","eat_ground_tr_idle_stand_slow",3);
			Sound_CreateAtEntity("Sound_GhoulEmerge", "01_02_caves/events/ghoul_nest_scare", "ghoulscare_2_test");
		}
		
		void OnTimer_SlowDownAnim(const tString &in asTimer)
		{
			Entity_SetAnimationSpeed("ghoulscare_2_test","eat_ground_tr_idle_stand_slow",0.5);
		}
		
		void OnTimer_GhoulGetUpSound(const tString &in asTimer)
		{
			Sound_PlayGui("02_02_courtyard/window_scare/window_stinger",1);
			Sound_PlayGui("02_05_cistern/lizard/lizard_stinger",1);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BackAway(const tString &in asTimer)
		{
			Player_FadeNightVisionStrength(1,3);
			Light_FadeBrightnessTo("Light_Spot_3",1,2);
			//Entity_SetEffectsActiveExt("fetish_light_rigid_1",false,true,1,3);
			//Sound_PlayGui("tasi_scream_temp.ogg", 1.f);	
			Voice_Play("Dialogue_CrackScare", -1, "OnVoiceEnd_CrackScare");
			PlayerBody_PlayCutsceneAtEntity("spooked_fall_back_permafail_ghoul_encounter", "PosArea_Shimmy", false, 0.3f, "");
			Sound_CreateAtEntity("Sound_TasiSpooked", "new_sounds/animations/ghoul_scare", "player");
			PlayerBody_SetCutsceneMaxPitch(20.f);
			PlayerBody_SetCutsceneMaxYaw(20.f);
			
			FearHandler_PlayStruggleSoundLoop(3.0f, 0.5f, false);
		}
		
		//------------------------------------------------------- 
		
		void OnVoiceEnd_CrackScare(const tString& in asScene, const tString& in asLine)
		{
			Sound_CreateAtEntity("Sound_TransformEmotes", "new_sounds/player/ghoul_transition_high", "player");
		}
		
		//------------------------------------------------------- 
		
