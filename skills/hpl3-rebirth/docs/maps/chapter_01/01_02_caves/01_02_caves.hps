		/*Put any functions that are only used in Scene 3, Event C here.*/
		
		void OnTimer_PlayerWakeUpAfterFall(const tString &in asTimer)
		{
			Player_Teleport("Start_Nest",true);
			FearHandler_FadeLevelTo(0.70f,0.1f);
			FearHandler_SetPermaFailStruggleEnabled(false);
			FearHandler_SetPermaFailTriggerAnimation("kneels_down_and_permafails");
			Effect_ImageTrail_Start(1.6f,0.1f,15,5);
			Player_SetMoveSpeedMul(0.6f);
			Player_SetRunSpeedMul(0.1f);
			Music_Play("A2_01_02_PitLand.ogg", 0.2f, false, eMusicPrio_BigEvent);
			Map_AddTimer("Timer_FadeInAfterFall",0.2f,"OnTimer_FadeInAfterFall");
			Map_AddTimer("Timer_MusicDeepCaves", 14.0f, "OnTimer_PlayMusicDeepCaves");
			Map_AddTimer("Timer_TasiInNest",1,"OnTimer_TasiInNest");
			Map_AddTimer("Timer_PrePermafailBark",8,"OnTimer_PrePermafailBark");
			Map_AddTimer("Timer_NestSounds",10,"OnTimer_NestSounds");
			Map_AddTimer("Timer_ShowFearHint", 14.f, "OnTimer_ShowFearHint");
			
			PlayerBody_PlayCutsceneAtEntity("get_up_after_fall_from_plankbridge","PosArea_NestAnim",false,0);
						
			mlPermaFailStage = eCavesPermaFail_Nest;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayerWakeUpAfterFallNew(const tString &in asTimer)
		{
			
			/*int lMatches = ItemType_GetCountInInventory("Matchbook");
			for (int i = 1; i <= lMatches; i++)
			{
				Item_RemoveFromInventory(ItemType_GetFirstInInventory("Matchbook"));
			}*/
			
			Player_SetMoveSpeedMul(0);
			FearHandler_FadeLevelTo(1.f,0);
			Player_Teleport("Start_Nest",true);
			//Struggle_StartStationary("PosArea_StruggleTarget","","OnSuccess_ExploreNest","",8);
			FearHandler_SetPermaFailTriggerAnimation("kneels_down_and_permafails");
			
			
			tString sAnimLoop = "permafail_struggle1_high_crouch_loop";
			tString sAnimStruggle = "permafail_struggle1_low_crouch_loop";
			tString sAnimIntro = "permafail_struggle1_high_crouch_start";
			tString sAnimOutro = "permafail_struggle1_high_crouch_end";
			Struggle_StartAnimation("", sAnimLoop, sAnimStruggle, sAnimIntro, sAnimOutro, true, "", "OnSuccess_ExploreNest", "", "", 6.f, true, 2.f, 1.0f, true, 0.3f, false, true);

			
			Map_AddTimer("Timer_FadeInAfterFall",0.2f,"OnTimer_FadeInAfterFall");
			
			mlPermaFailStage = eCavesPermaFail_Nest;
		}
		
		//------------------------------------------------------- 
		
		void OnSuccess_ExploreNest()
		{
			FearHandler_FadeLevelTo(0.8f,0);
			FearHandler_SetPermaFailStruggleEnabled(false);
			FearHandler_SetPermaFailEnabled(true);
			Player_SetMoveSpeedMul(0.3f);
			Player_SetRunSpeedMul(0.3f);
			Player_FadeMoveSpeedMulTo(0.7f,6);
			Player_FadeRunSpeedMulTo(0.7f,10);
			Music_Play("A2_01_02_PitLand.ogg", 0.2f, false, eMusicPrio_BigEvent);
			Map_AddTimer("Timer_MusicDeepCaves", 5.0f, "OnTimer_PlayMusicDeepCaves");
			Voice_PlayDelayed("Dialogue_TheNest",2,1,"OnEndOfVoice_LastLine");
			//Map_AddTimer("Timer_PrePermafailBark",10,"OnTimer_PrePermafailBark");
			Map_AddTimer("Timer_NestSounds",10,"OnTimer_NestSounds");
			Map_AddTimer("Timer_ShowFearHint", 19.f, "OnTimer_ShowFearHint");
			Effect_ImageTrail_Start(1.2f,4,10,10);
			
			FearHandler_StopStruggleSoundLoop(1.25f);
		}
		
