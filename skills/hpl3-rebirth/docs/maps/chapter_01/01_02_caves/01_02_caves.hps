	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			Entity_SetAnimationMessageEventCallback("Player","OnAnimMessage_Player",false);
			Player_SetMoveSpeedMul(0.5);
		}
		if(alAction == eAction_Test2)
		{
			cLux_AddDebugMessage(cString_To8Char(cLux_TranslatePlatformSpecific("LoadScreen","PressToStart")));
			//cLux_AddDebugMessage("UNLOCKED? :"+Achievement_GetUnlocked(eAchievement_Amnesiac));
			//Item_RemoveFromInventory("Matchbook"); return; Map_AddTimer("Test",0,"OnTimer_PlayerWakeUpAfterFallNew"); return;
			//PlayerHands_PlayAnimation("tool_match_idle_larm", true,false,0.2f,"", false, 1, -1, false);
			//Amulet_StartTracking(true, "Rift_Goal", 300.f);
		}
		if(alAction == eAction_Test3)
		{
			Achievement_Unlock(eAchievement_Amnesiac);
		}
		if(alAction == eAction_Test4)
		{
			for (int i = 0; i <= 39; i++)
				Achievement_Unlock(i);
		}
		if(alAction == eAction_Test5)
		{
			Player_Teleport("Start_PostNest");
			Effect_Fade_Out(0);
			Seq_PermaFailRespawn_Nest("");
			PlayerBody_PlayCutsceneAnimation("wake_up_from_death_1a",false,0.3f);
		}
		if (alAction == eAction_Test6)
		{
			//Sound_CreateAtEntity("Sound_FinalWhisper", "player/UI/memory_sketch/whisper_flash", "player");
			Credits_Start("Credits.cfg","");
		}
		
		if (alAction == eAction_Test7)
		{
		}
		
		if (alAction == eAction_Test8)
		{
			Entity_SetActive("CurseMedallion_0_Held", false);
		}
		
		if (alAction == eAction_Test9)
		{
			Sketchbook_AddAllIdeas(false);
			//cLux_AddDebugMessage("Match out and burning? "+Match_IsHeldAndBurning());
		}
		if (alAction == eAction_Test0)
		{			
			Sketchbook_AddIdea("find_salim");
			//Sketchbook_AddAllIdeas(true);
			//Amulet_StartTracking(true, "Rift_Goal");
		}
		if(alAction == eAction_TestPlus)
		{
			//ItemType_RemoveFromInventory("Lantern", 10);
			//return;
			float fCurrentFearLevel = FearHandler_GetLevel();
			FearHandler_FadeLevelTo(fCurrentFearLevel+0.1f,0,true);
		}
		
	}
	
	void OnEndOfCredits()
	{
		Map_ChangeMap("main_menu.hpm","PlayerStartArea_1","","",false);
	}

