		bool OnColllide_MusicCave_3(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_Stop(2.0f, eMusicPrio_SceneAmb);
			Entity_SetActive("Trigger_DeepcaveMusic_3",false);
			Music_PlayExt("A2_01_02_Deep_Cave_C_New.ogg", true, 0.06f, 1.0f, 2.0f, 1.0f, eMusicPrio_SceneAmb, true);
			return true;
		}
		
