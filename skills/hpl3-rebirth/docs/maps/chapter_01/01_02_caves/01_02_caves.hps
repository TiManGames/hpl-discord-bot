	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
 
	//-------------------------------------------------------
	
	int mlNotesHintId = -1;
	
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_SpeedFade(const tString &in asParent, const tString &in asChild, int alState)
	{
		float fTarget = Entity_GetVarFloat(asParent,"");
		(alState == 1) ? Player_FadeRunSpeedMulTo(fTarget,0.8f) : Player_FadeRunSpeedMulTo(1,1.2f);
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnSketchbookStateChange(int alState)
	{									
		if (alState == -1 && mlNotesHintId > -1)
		{
			Hint_StopHint();
			Hint_Release(mlNotesHintId);
			mlNotesHintId = -2;
		}
	}
	
	//-------------------------------------------------------
	
	void OnClose_ShowNotesHint(const tString &in asEntity)
	{
		if (mlNotesHintId == -1)
			mlNotesHintId = Hint_ShowHint_Hold("Hints", "HintNotes", true);
	}
	
	//-------------------------------------------------------
	
	void OnPutAwayItem(const tString &in asItemType, const tString &in asItemID)
	{
		if (mbShowedAmuletHint == false && asItemType == "CurseMedallion")
		{
			mbShowedAmuletHint = true;
			Hint_ShowHint_Hold("Hints", "HintAmulet", true, 1.5f, false, 10);
		}
	}
 
