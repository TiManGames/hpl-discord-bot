	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("01-02-caves");
		
		// Set up color grading etc.
		Effect_Bloom_FadeBrightPass(0.25f, 2);
		Effect_Bloom_FadeBloomWidth(128, 0.6);
		Effect_Bloom_FadeBloomFalloff(1.5f, 2);
		Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		Map_Preset_Fade("OutsideRift", 2.0f);
		
		Map_Preset_SetupColorGrading("InsideRift","grading_inside_rift.dds");
		Map_Preset_SetupColorGrading("OutsideRift","grading_default.dds");
		Map_Preset_SetupBloom("LightningFlashOn",4,0.02f,1.5f,cColor(1, 2, 2, 1));
		Map_Preset_SetupBloom("LightningFlashOff",32,0.07f,1.5f,cColor(1, 1, 1, 1));
		Map_Preset_SetupToneMapping("OutsideRift", 0.5, 0.5, 3.5);
		Map_Preset_SetupToneMapping("Wakeup", 1, 1, 0.5);
		
		Pregnancy_SetStage(ePregStage_Unknown);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyKicksEnabled(false);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Unknown);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_Ill);
		Player_SetAllowCheckBaby(false);
		FearHandler_SetWhisperStage(eFearWhisperStage_StartToSalim);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(0);
		StruggleFlashHandler_SetProgression(0);
		
		Player_SetAutoTeleportWhenBelowAltitude(-30.f);
	}
	
