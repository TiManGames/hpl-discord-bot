		int mlJumpHintId = -1;
		int mlCrouchHintId = -1;
		
		bool OnCollide_Player_JumpHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Hint_StopHint();
				mlJumpHintId = Hint_ShowHint_Hold("Hints","HintJump",true,100.f,false);
			}
			else
			{
				Hint_StopHint();
				Hint_Release(mlJumpHintId);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ShowDarknessHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			Player_SetNightVisionEnabled(true);
			Hint_StopHint();
			Hint_ShowHint_Hold("Hints", "HintDarkness", true, 1.5f, true, 10.f);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_CrouchHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				if (Player_GetCrouching() == false)
				{
					Hint_StopHint();
					mlCrouchHintId = Hint_ShowHint_Hold("Hints","HintCrouch",true,100.f,false);
				}
			}
			else
			{
				Hint_StopHint();
				Hint_Release(mlCrouchHintId);
				
				if (Entity_PlayerIsInFront(asParent))
					return false;
			}
						
			return true;
		}
		
