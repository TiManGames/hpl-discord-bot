enum eCavesPermaFail
{
	eCavesPermaFail_DeepCaves,
	eCavesPermaFail_Bridges,
	eCavesPermaFail_Nest,
	eCavesPermaFail_PreDarkWorld,
	eCavesPermaFail_DarkWorld,
	eCavesPermaFail_PostDarkWorld,
