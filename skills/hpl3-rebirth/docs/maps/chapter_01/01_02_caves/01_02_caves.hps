			Sound_Play("Sound_DWCaveSweet", 0.0f);
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Player explores the caves and finds the overlap*
		
		/////////////////////////////////////////
		// Event B *Player opens the rift and crosses through the resulting overlap*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 4, Event B here.*/
		
		int mfTransitionFear = 0;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 4, Event B here.*/
		
		bool OnCollide_Player_EquipAmulet(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbRiftOpen) return false;
			
			Seq_AmuletTutorial("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataAmuletTutorial;
		void Seq_AmuletTutorial(const tString &in asTimer)
		{
			Sequence_Begin("Seq_AmuletTutorial", mSeqDataAmuletTutorial);
			if (Sequence_DoStepAndWait(2.f))
			{
				Amulet_StartTracking(true, "Rift_Goal");				
				
				Player_FadeRunSpeedMulTo(0.f, 1.f);
				Player_SetJumpDisabled(true);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{				
				Player_SetCrouching(false);
				
				cScript_SetGlobalVarBool("Caves_TakenOutAmulet", true);
				
				Item_TakeOut(ItemType_GetFirstInInventory("CurseMedallion"));
				
				PlayerBody_SetUnequipItemsOnCutscene(false);
				
				Item_PutAway(eItemHandlerHand_Left);
			
				PlayerBody_SetArmAnimationPitch(false, true, false);
				PlayerBody_SetCutsceneMaxPitch(5.f);
				PlayerBody_SetCutsceneMaxYaw(5.f);
				PlayerBody_PlayCutsceneAnimation("tasi_first_time_amulet_equip", false, 0.3f, "OnAnimEnd_AmuletTutorial");			
				
				tString sEnt = Item_GetHeldEntity(eItemHandlerHand_Right);
				Entity_PlayAnimation(sEnt, "amulet_first_time_amulet_equip", 0.3f, false);
				
				Voice_StopAll();
				Voice_Play("Dialogue_TheAmulet1");
				
				Amulet_SetTutorialActive(true);
				Item_SetHidden(ItemType_GetFirstInInventory("CurseMedallion"), false);
			}
			else if (Sequence_DoStepAndWait(8.25f))
			{
				Amulet_StartTracking(true, "Rift_Goal");
			}
			else if (Sequence_DoStepAndPause(1.f))
			{
				Amulet_StartTracking(true, "Rift_Goal");
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Hint_StopHint();
				mbShowedAmuletHint = true;
				Hint_ShowHint_Hold("Hints", "HintAmulet", true, 1.5f, false, 10);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				//if (Amulet_IsHeld())
				//	Voice_Play("Dialogue_TheAmulet2");				
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_AmuletTutorial(const tString &in asAnim)
		{
			Amulet_SetTutorialActive(false);
			
			PlayerBody_SetArmAnimationPitch(true, true, false);
			PlayerHands_PlayAnimation("tool_amulet_idle", true, false, 0.f, Item_GetHeldEntity(eItemHandlerHand_Right), true, 1.f, -1.f, true, true);
			
			SequenceStates_Resume("Seq_AmuletTutorial");
			
			Player_FadeRunSpeedMulTo(1.f, 1.f);
			Player_SetJumpDisabled(false);
		}
				
		//-------------------------------------------------------
		
		void RiftRock_Dressing_Move(int alRockNumber, int alDirection)
		{
			tString sRock = "riftrock_dressing_"+alRockNumber;
			tString sTarget = (alDirection == 1) ? sRock+"_end" : sRock+"_start";
			
			Prop_MoveLinearTo(sRock,sTarget,30,20,2,false);
			Prop_AlignRotation(sRock,sTarget,30,10,2,false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_DWWhispers(const tString &in asParent, const tString &in asChild, int alState)
		{
			(alState == 1) ? DarkWorldWhispers_Play(1) : DarkWorldWhispers_Stop();
			return true;
		}
						
		//-------------------------------------------------------
		
		void OnRiftStage_FirstRift(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			Debug_Log("RIFT: "+alStage+" "+afOpenAmount+" "+abOpening);
			
			if (alStage == 0)
			{
				if (abOpening)
				{
					//ParticleSystem_CreateAtEntityExt("rift_implosion", "rift_opening.ps", "position_particle_rift_exit", false, cColor(1,1,1,1), 1, false, 1, 2, 100, 100);
				}
				else
				{
					RiftRock_Dressing_Move(1,-1);
				}
			}
			if (alStage == 1)
			{
				if (abOpening)
				{
					RiftRock_Dressing_Move(1,1);
				}
				else
				{
					RiftRock_Dressing_Move(2,-1);
					//Prop_SetActiveAndFade("riftrock_entrance_*",true,1);
				}
			}
			if (alStage == 2)
			{
				if (abOpening)
				{
					RiftRock_Dressing_Move(2,1);
					Voice_PlayWhenPossible("Dialogue_RiftOpen", "VoiceCondition_OutsideOfRift");
					//Prop_SetActiveAndFade("riftrock_entrance_*",false,1);
					
					if (Sound_Exists("Sound_DWCaveSweet"))
					{
						Sound_Stop("Sound_DWCaveSweet", 3.0f);
					}
					
				}
				else
				{
					RiftRock_Dressing_Move(3,-1);
				}
			}
			if (alStage == 3)
			{
				if (abOpening)
				{
					RiftRock_Dressing_Move(3,1);
				}
				else
				{
					if (!Entity_IsActive("rift_1_entrance_1"))
					{
						
						Prop_SetActiveAndFade("rift_1_entrance_*",true,1);
						Prop_SetActiveAndFade("rift_1_exit_*",true,1);
						ParticleSystem_CreateAtEntityExt("rift_implosion", "rift_opening.ps", "position_particle_rift_entrance", false, cColor(1,1,1,1), 1, false, 1, 2, 100, 100);
						
					}
				}
			}
			else if (alStage == 4)
			{
				if (abOpening)
				{
					
					Prop_SetActiveAndFade("rift_1_entrance_*",false,1);
					Prop_SetActiveAndFade("rift_1_exit_*",false,1);
					ParticleSystem_CreateAtEntityExt("rift_implosion", "rift_opening.ps", "position_particle_rift_entrance", false, cColor(1,1,1,1), 1, false, 1, 2, 100, 100);
					ParticleSystem_CreateAtEntityExt("rift_implosion", "rift_opening.ps", "position_particle_rift_exit", false, cColor(1,1,1,1), 1, false, 1, 2, 100, 100);
					Prop_SetStaticPhysics("riftrock_irratic_*", false);
					Entity_AddImpulse("riftrock_irratic_*", cVector3f_Down * 0.25, true, true);
				}
				else
				{
					
				}
			}
		}
		
        bool InsideRift(const tString &in asParent, const tString &in asChild, int alState)
        {
		    if (alState == 1)
			{
		        Map_Preset_Fade("InsideRift", 1);
				Effect_Screen_Start("ripple_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 1.0f, 3, 1.0f); 
			}
		    if (alState == -1)
			{
		        Map_Preset_Fade("OutsideRift", 1);
				Effect_Screen_Start("ripple_screen.mat", cVector2f(0.5, 0.5), cVector2f(1.8, 1.8), 1, 0.5f, 1, 0.5f); 
			}
			return true;
        }
		
		//-------------------------------------------------------
		
		bool VoiceCondition_OutsideOfRift(const tString &in asSubject)
		{
			return (Entity_GetCollide("player","rift_1_bounds") == false);
		}
		
		void OnRiftStage_Caves(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			//Debug_Log(alStage+" "+afOpenAmount+" "+abOpening);
			if (alStage == 1)
			{
				if (!abOpening)
					RiftStage_EntranceWall(abOpening);
			}
			else if (alStage == 2)
					Prop_SetActiveAndFade("rift_1_entrance_*",false,1);
					Prop_SetActiveAndFade("rift_1_exit_*",false,1);
		}
		
		//-------------------------------------------------------
		
		void RiftStage_EntranceWall(bool abOpening)
		{
			if (abOpening)
			{
				//Prop_SetActiveAndFade("riftwall_entrance_2", false, 2.f);
				//Prop_SetActiveAndFade("riftwall_exit_2", false, 2.f);
				Entity_PlayAnimation("riftwall_exit_*", "sway", 0.8f, false, true, "");
				Entity_PlayAnimation("riftwall_entrance_*", "sway", 0.8f, false, true, "");
				Voice_PlayDelayed("Dialogue_RiftOpen",1);
			}
			else
			{
				//Prop_SetActiveAndFade("riftwall_entrance_2", true, 2.f);
				//Prop_SetActiveAndFade("riftwall_exit_2", true, 2.f);
				Entity_PlayAnimation("riftwall_exit_*", "closed", 0.8f, false, true, "");
				Entity_PlayAnimation("riftwall_entrance_*", "closed", 0.8f, false, true, "");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_PlayWhenPossible("Dialogue_EnterRift");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnEndOfVoice_SurroundingsCheck(const tString &in asScene, const tString &in asSubject)
		{
			//Map_AddTimer("Timer_SurroundingsCheck",0,"OnTimer_SurroundingsCheck");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SurroundingsCheck(const tString &in asTimer)
		{
			if (Entity_GetCollide("player","Trigger_RiftArea"))
				Voice_Play("Dialogue_InsideRift");
			else
				Map_RestartCurrentTimer(1);
		}

		//-------------------------------------------------------
		
		void OnRiftOpened_RiftGoal(const tString &in asRift)
		{
			Entity_SetActive("Rift_Goal",false);
			Entity_SetActive("cave_module_side_ribbed_1",false);
			Entity_SetActive("Trigger_ActivateAmulet",false);
			Amulet_StopTracking();
			FearHandler_SetForcedAddFearRate(0.4f, 7.f, false, -1.f, 0.1f);	
			Map_AddTimer("Timer_UnequipAmulet",1,"OnTimer_UnequipAmulet");
			mbRiftOpen = true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_DarkWorldFall(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1)	return true;
			
			mlPermaFailStage = eCavesPermaFail_DarkWorld;
			Player_GiveDamage(0,0.9f,eDamageType_Fall,asParent);
			FearHandler_TriggerPermaFail();
			Debug_Log("TRIGGER PERMAFAIL MAP SCRIPT");
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UnequipAmulet(const tString &in asTimer)
		{
			tString sAmulet = ItemType_GetFirstInInventory("CurseMedallion");
			Item_Unequip(sAmulet);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_InsideRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				if (mfTransitionFear == 0)
				{
					FearHandler_SetForcedAddFearRate(0.3f, 2.0f, false, 1.0f, 0.08f);
					mfTransitionFear++;
				}
				//Effect_ChromaticAberration_StartAnim(1.5f, 0.08f, 0.2f, cVector2f_Zero);
				Effect_Shake_Start(0.01f, 0.5f, 0.2f, 0.2f);
				Sound_CreateAtEntity("Sound_DarkworldEnterPulse_1", "01_04_dark_world_ledge/darkworld_pulse/darkworld_enter_pulse", "player");
			}
			if (alState == -1)
			{
				if (mfTransitionFear == 1)
				{
					FearHandler_SetForcedAddFearRate(0.3f, 2.0f, false, 1.0f, 0.08f);	
					mfTransitionFear++;
				}
				//Effect_ChromaticAberration_StartAnim(1.5f, 0.08f, 0.2f, cVector2f_Zero);
				Effect_Shake_Start(0.01f, 0.5f, 0.2f, 0.2f);
				Sound_CreateAtEntity("Sound_DarkworldEnterPulse_1", "01_04_dark_world_ledge/darkworld_pulse/darkworld_exit_pulse", "player");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
