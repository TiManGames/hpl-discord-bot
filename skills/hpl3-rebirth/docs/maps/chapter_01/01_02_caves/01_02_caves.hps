        void OnLookAt_DeepCavesEntranceWind(const tString &in asEntity, int alState)
        {	
		    ParticleSystem_CreateAtEntityExt("wind_scare_deepcave_entrance", "wind_scare.ps", "windscare_deepcave_entrance", false, cColor(1,1,1,1), 1, false);
			//Seq_TorchWind("");
			Entity_SetPlayerLookAtCallback(asEntity,"");
        }
		
		//------------------------------------------------------- 
		
		cSequenceStatesData mSeq_TorchWind;
		
        void Seq_TorchWind(const tString &in asTimer)
        {
	        Sequence_Begin("Seq_TorchWind", mSeq_TorchWind);
	            if (Sequence_DoStepAndWait(0.5f))
		        {
					Sound_Play("Sound_WindScare_2", 0.0f);
		        }
		        else if (Sequence_DoStepAndWait(1.5f))
		        {
				    Entity_SetActive("torch_pilgrim_wood_2", false);
				    Entity_SetActive("torch_pilgrim_wood_wind", true);
		        }
		        else if (Sequence_DoStepAndWait(0))
		        {
				    Entity_SetActive("torch_pilgrim_wood_wind", false);
				    Entity_SetActive("torch_pilgrim_wood_2", true);
		        }
	        Sequence_End();
        }
		
