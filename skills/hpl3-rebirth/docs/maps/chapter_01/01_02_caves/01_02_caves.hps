	// ==============
	// SCENE 2 *PLAYER FOLLOWS THE PILGRIMS' PATH AND DETOURS THROUGH THE DEEP CAVES TO OVERCOME THE BLOCKAGE*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 2 here.*/
		
		int mlSalimJacketStage = 0;
		bool mbReadFirstNote = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 2 here.*/
		
		void OnLookAt_SalimTrail(const tString &in asEntity, int alState)
		{
			mlSalimJacketStage++;
			
			if (mlSalimJacketStage == 1)
			{
				if (mbReadSalimsNote) 
				{
					Voice_Play("Dialogue_SalimsTrail", -1, "OnEndOfVoice_SeeScarf");
				}
				else
				{
					//Voice_Play("Dialogue_TasiSeesTorch");
				}
				SuppressLightLevelBarks();
				//Music_Play("A2_01_02_DiscoverSurvivors.ogg", 0.2f, false, eMusicPrio_BigEvent);
			}
			else if (mlSalimJacketStage == 2)
			{
				SuppressLightLevelBarks();
				Voice_Play("Dialogue_SalimsTrail");
			}
			else
			{
				SuppressLightLevelBarks();
				Voice_Play("Dialogue_TrailBarks");
			}
		}
		
		//-------------------------------------------------------
		
		void OnEndOfVoice_SeeScarf(const tString &in asScene, const tString &in asSubject)
		{
			Voice_PlayDelayed("Dialogue_SeeScarf_Realise",0.5f);
		}
		
		//-------------------------------------------------------
		
		void OnRead_SalimsNote(const tString &in asEntity)
		{
			int lNote = cString_GetNumericSuffixInt(asEntity);
			
			if (mbReadFirstNote == false)
			{
				Voice_PlayDelayed("Dialogue_CommentDiary_1",0.6f);
				mbReadFirstNote = true;
				return;
			}
			else
			{
				if (lNote == 2)
					Voice_PlayDelayed("Dialogue_CommentDiary_2",0.6f);
				
			}	
		}
		
		//------------------------------------------------------- 
		
		bool mbLightLevelBarkAllowed = true;
		bool mbLightLevelBarksDelay = true;
		
		//-------------------------------------------------------
		
		void OnTimer_LightLevelBarksDelay(const tString &in asTimer)
		{
			mbLightLevelBarksDelay = false;
		}
		
		void UpdateLightLevelBarks(float afTimeStep)
		{			
			if (Entity_GetCollide("Fear_DeepCaves","player") == false && 
				Entity_GetCollide("Fear_DeepCaves_1","player") == false)
					return;
					
			if (Voice_CharacterIsSpeaking("Player")) return;
			
			float fLightLevel = Player_GetLightLevel();
			if (mbInLight)
			{	
				if (fLightLevel <= mfDeepShadowLevel)
				{
					if (mbLightLevelBarksDelay) return;
					mbInLight = false;
					
					cLux_AddDebugMessage("HERE");
					
					if (mbLightLevelBarkAllowed) 
						Map_AddTimer("Timer_LeaveLightBarkDelay",9,"OnTimer_LeaveLightBarkDelay");
					
					if (Map_TimerExists("Timer_EnterLightBarkDelay"))
					{
						mbLightLevelBarkAllowed = false;
						Map_RemoveTimer("Timer_EnterLightBarkDelay");
						Map_AddTimer("Timer_ResetLightBarks",5,"OnTimer_ResetLightBarks");
					}
				}
			}
			else
			{
				if (fLightLevel > mfDeepShadowLevel)
				{
					mbInLight = true;
					
					if (mbLightLevelBarkAllowed)
						Map_AddTimer("Timer_EnterLightBarkDelay",2,"OnTimer_EnterLightBarkDelay");
					
					if (Map_TimerExists("Timer_LeaveLightBarkDelay"))
					{
						mbLightLevelBarkAllowed = false;
						Map_RemoveTimer("Timer_LeaveLightBarkDelay");
						Map_AddTimer("Timer_ResetLightBarks",5,"OnTimer_ResetLightBarks");
					}
				}
			}
		}
		
		//------------------------------------------------------- 
		
		bool mbFearBarksAllowed = false;
		
		/* Moved these to caves B - IT
		void UpdateFearLevelBarks()
		{
			if (Player_GetLightLevel() > mfDeepShadowLevel) return;
			if (FearHandler_GetLevel() < .61f) return;
			if (mbFearBarksAllowed == false) return;
			
			if (Map_TimeHasPassed("FearBark",30))
				Voice_PlayWhenPossible("Dialogue_HighFearBarks");
		}*/
		
		//------------------------------------------------------- 
		
		void OnTimer_EnterLightBarkDelay(const tString &in asTimer)
		{
			if (mbLightLevelBarkAllowed == false) return;
			
			if (Map_TimeHasPassed("LightBark",30))
			{
				float fLightLevel = Player_GetLightLevel();
				if ((fLightLevel>mfDeepShadowLevel)&&(FearHandler_GetRate()<0.1f)&&(!Voice_AnySceneIsActive()))
					Voice_Play("Dialogue_EnteringLightBarks");
			}
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_LeaveLightBarkDelay(const tString &in asTimer)
		{
			if (mbLightLevelBarkAllowed == false) return;
			
			if (Map_TimeHasPassed("DarknessBark",20))
			{
				float fLightLevel = Player_GetLightLevel();
				if ((fLightLevel<mfDeepShadowLevel)&&(!Voice_AnySceneIsActive()))
					Voice_Play("Dialogue_LeavingLightBarks");
			}
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_ResetLightBarks(const tString &in asTimer)
		{
			mbLightLevelBarkAllowed = true;
		}
		
		//------------------------------------------------------- 
		
		void SuppressLightLevelBarks()
		{
			mbLightLevelBarkAllowed = false;
			Map_AddTimer("Timer_ResetLightBarks",10,"OnTimer_ResetLightBarks");
			Map_RemoveTimer("Timer_EnterLightBarkDelay");
			Map_RemoveTimer("Timer_LeaveLightBarkDelay");
		}
		
		//-------------------------------------------------------
		
		//} END General
		
