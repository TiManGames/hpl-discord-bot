			if (alState == 1)			
				Voice_PlayWhenPossible("Dialogue_WeirdShit");
			else
				Voice_StopCheckTimer("Dialogue_WeirdShit");
		}
					 
		//-------------------------------------------------------
		
		bool OnCollide_PlayDWBoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Play("Sound_DWBoom",0.0f);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_PlayDWSweet(const tString &in asParent, const tString &in asChild, int alState)
