	{
		ImGui_SetAlignment(eImGuiAlign_CenterCenter);
		ImGui_GroupBegin(ImGui_NrmPosGroup(0.0,0.0,0.5), ImGui_NrmSizeGroup(1));
		Sketchbook_RenderCrewSketchPageGUI(msCrewPage,mfSketchAlpha,0.75f, false);
		ImGui_GroupEnd();
	}
	
	//-------------------------------------------------------

	void DrawGuiSketchbookCover(const tString&in asEntityName, float afTimeStep)
	{
		ImGui_SetAlignment(eImGuiAlign_CenterCenter);
		ImGui_GroupBegin(ImGui_NrmPosGroup(0.0,0.0,0.5), ImGui_NrmSizeGroup(1));
		Sketchbook_RenderBookCoverLabel();
		ImGui_GroupEnd();
	}
		
	//-------------------------------------------------------
	
	cVector3f mvMoveStartCamPos = cVector3f_Zero;
	float mfMoveStartCamRotZ = 0.0f;
	cVector3f mvMoveDestCamPos = cVector3f_Zero;
	float mfMoveDestCamRotZ = 0.0f;
	cVector3f mvMoveCurrentCamPos = cVector3f_Zero;
	float mfMoveCurrentCamRotZ = 0.0f;
	float mfMoveTime = 0.0f;
	float mfMoveCurrentTime = 0.0f;
	eEasing mMoveEasingType = eEasing_Linear;
	float mfStartHoldTime=0.0f;
  
	//-------------------------------------------------------
  
	void ClearCameraMove()
	{
		mvMoveCurrentCamPos = cVector3f_Zero;
		mfMoveCurrentCamRotZ = 0.0f;
	}
	
	//-------------------------------------------------------
  
	void SetCameraOffset(float afPosX, float afPosY, float afPosZ, float afRotZ=0.0f, cVector3f fix = ANIM_FIX_OFFSET)
	{
		mvMoveCurrentCamPos = cVector3f(afPosX, afPosY, afPosZ)+fix;
		mfMoveCurrentCamRotZ = cMath_ToRad(afRotZ);
		mfMoveTime = 0.0f;
		mfMoveCurrentTime = 0.0f;
		mfStartHoldTime = 0.0f;
		PlayerBody_SetCustomAnimCameraAdd(mvMoveCurrentCamPos);
		PlayerBody_SetCustomAnimCameraRot(cVector3f(0.0f,0.0f,mfMoveCurrentCamRotZ));
	}
	
	//-------------------------------------------------------
	
	void DoCameraMove(float afDestX, float afDestY, float afDestZ, float afTime, float afRotZ=0.0f, eEasing aEasingType=eEasing_Linear, float afStartHoldTime = 0.0f, cVector3f fix = ANIM_FIX_OFFSET)
	{
		mfStartHoldTime = afStartHoldTime;
		mvMoveStartCamPos = mvMoveCurrentCamPos;
		mfMoveStartCamRotZ = mfMoveCurrentCamRotZ;
		mvMoveCurrentCamPos = mvMoveStartCamPos;
		mvMoveDestCamPos = cVector3f(afDestX, afDestY, afDestZ)+fix;
		mfMoveDestCamRotZ = cMath_ToRad(afRotZ);
		mfMoveCurrentTime = afTime;
		mfMoveTime = afTime;
		mMoveEasingType = aEasingType;
	}
	
	//-------------------------------------------------------
	
	void UpdateCameraMove(float afTimeStep)
	{
		if (mfMoveCurrentTime<0.0f)
			return;
			
		if (mfStartHoldTime>0.0f)
		{
			mfStartHoldTime-=afTimeStep;
			if (mfStartHoldTime<=0.0f)
			{
				mfStartHoldTime=0.0f;
				afTimeStep+=mfStartHoldTime;
			}
			else
				return;
		}
		
		mfMoveCurrentTime-=afTimeStep;
		float fProgress = 1.0f;
		if (mfMoveCurrentTime>0.0f)
		{
			fProgress = (mfMoveTime-mfMoveCurrentTime)/mfMoveTime;
		}
		
		mvMoveCurrentCamPos = cVector3f(
			cMath_Easing(mMoveEasingType, fProgress, mvMoveStartCamPos.x, mvMoveDestCamPos.x),
			cMath_Easing(mMoveEasingType, fProgress, mvMoveStartCamPos.y, mvMoveDestCamPos.y),
			cMath_Easing(mMoveEasingType, fProgress, mvMoveStartCamPos.z, mvMoveDestCamPos.z)
			);
		mfMoveCurrentCamRotZ = cMath_Easing(mMoveEasingType, fProgress, mfMoveStartCamRotZ, mfMoveDestCamRotZ);
	
		PlayerBody_SetCustomAnimCameraAdd(mvMoveCurrentCamPos);
		PlayerBody_SetCustomAnimCameraRot(cVector3f(0.0f,0.0f,mfMoveCurrentCamRotZ));

		//cLux_AddDebugMessage("L:"+mvMoveCurrentCamPos+" P:"+fProgress);
	}
	
	//-------------------------------------------------------

}