// Issue introduced by Tasi body changes means everything is slightly
// out of position - this is the fix. 
cVector3f ANIM_FIX_OFFSET = cVector3f(0.0, -0.015f, 0);
		
enum eSkyBoxStage
{
	eSkyBoxStage_Paused,
	eSkyBoxStage_Flying,
	eSkyBoxStage_Blackout,
	eSkyBoxStage_Crashing
}

class cScrMap : iScrMap
{
	//--------------------------------------------
	cVector3f m_skyBoxRotation;
	cVector3f m_skyBoxRotationVel;
	cVector3f m_skyBoxBaseRotation;
	float m_towerOffsetRotationY;
	float m_fFlyingTime = 0.0f;
	int m_nConstShake=-1;
	eSkyBoxStage m_skyBoxStage = eSkyBoxStage_Paused;
	cVector3f m_towerPos;
	bool mbPassengersCrashAnim = false;

	//--------------------------------------------
 
