	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("01-00-intro");
		
		Pregnancy_SetStage(ePregStage_Unknown);
		Pregnancy_SetBarksActive(false);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Unknown);
		Pregnancy_SetBabyKicksEnabled(false);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_Ill);
		Player_SetAllowCheckBaby(false);
		FearHandler_SetWhisperStage(eFearWhisperStage_StartToSalim);
		
		StruggleFlashHandler_SetActive(false);
		
		Player_SetNightVisionEnabled(false);
		
		// Set up color grading etc.
		//Effect_ToneMapping_FadeWorldGrading("grading_default", 0.0f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		ImGui_PreloadImage("grading_intro_glimpse_desert.dds");
		ImGui_PreloadImage("grading_intro_glimpse_sandstorm.dds");
		ImGui_PreloadImage("grading_intro_glimpse_dw.dds");
		ImGui_PreloadImage("grading_intro_glimpse_fire.dds");

		///////////////
		// Preload particles
		//ParticleSystem_Preload("some_particle.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		//////////////
		// Preload sounds
		Sound_PreloadGroup("01_01_intro", true);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(0);
		
		Entity_AttachToSocket("SketchbookScreen", "Sketchbook", "BookSocket", true, true);
		Entity_AttachToSocket("SketchbookCover", "Sketchbook", "BookSocket", true, true);
		
		// Any general setup of script / entities
		
		m_skyBoxRotation = cVector3f_Zero;
		m_skyBoxRotationVel = cVector3f_Zero;
		m_skyBoxBaseRotation = cVector3f_Zero;
		m_skyBoxStage = eSkyBoxStage_Paused;
		m_fFlyingTime = 0.0f;
		
		iLuxEntity@ pTower = cLux_GetCurrentMap().GetEntityByName("Tower_1");
		m_towerPos = pTower.GetPosition();
	
		Map_SetSkyboxRotation(m_skyBoxRotation);
		
		Entity_AttachToEntity("Tower_*", "Tower_1",  "",  true, false, true);
		Entity_AttachToEntity("SandStorm_*", "SandStorm_Backdrop", "", true, false, true);
		
		Light_SetVisible("StormLight_*",false);
		Entity_SetActive("Tower_*",false);
		Entity_PlayAnimation("Passenger_04", "idle_nobaby", 0.1f, true);
		Entity_SetAnimationRelativeTimePosition("Passenger_04","idle_nobaby", 3.0f);
		
		cScript_SetGlobalVarBool("HideAmuletBracelet", true);
						
		Effect_Fade_Out(0.0f);
		
		mbPassengersCrashAnim = false;
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		// Tasi in the intro shouldn't have the amulet.
		Item_RemoveFromInventory(ItemType_GetFirstInInventory("CurseMedallion"));

		PlayerBody_SetModel("player_intro.ent");
		PlayerBody_SetActive(true);
		cLux_GetPlayer().GetCharacterBody().SetTestCollision(false);
		PlayerBody_PlayCutsceneAtEntity("player_intro_sequence", "AnimOrigin", false, 0.0f);
		PlayerBody_StopAnimation("player_intro_sequence",0.0f);
		
		Player_SetNightVisionEnabled(false);
		Entity_StopAnimation("Salim");
		Entity_StopAnimation("monkey");
		Entity_StopAnimation("Sketchbook");
		
		Decal_SetDynamicVisible("decal_wing_01", false);
		Decal_SetDynamicVisible("decal_wing_02", false);
		Entity_SetActive("Wing_Wrecked", false);
		Entity_SetActive("plane_passenger_light_red_*",false);
		ParticleSystem_SetActive("PS_Engine_smoke*",false);
		ParticleSystem_SetActive("PS_Engine_trail*",false);
		ParticleSystem_SetActive("PS_Engine_failure*", false);
		ParticleSystem_SetActive("PS_Sandstorm_Particles_*", true);
		ParticleSystem_SetVisible("PS_Sandstorm_Particles_*", false);
		ParticleSystem_SetActive("PS_Engine",false);
		Entity_SetEffectsActive("Wing_Wrecked",false,true);
		Light_SetVisible("Fire_light_*", false);
		
		// TEMP
		//Light_SetVisible("Fire_light_dinamic_caustics",true);
		//Light_SetVisible("window_caustics",false);
		
		Seq_Book();
		
        Heat_SetActive(false);
		
		Map_Preload("01_01_plane_wreckage.hpm");
		Sound_FadeGlobalVolume(1.f, 0.0f, eSoundEntryType_All);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Effect_ToneMapping_FadeWorldGrading("grading_default", 0.0f);
		Effect_ToneMapping_RemoveGradingTexture("grading_intro_glimpse_desert.dds");
		Effect_ToneMapping_RemoveGradingTexture("grading_intro_glimpse_sandstorm.dds");
		Effect_ToneMapping_RemoveGradingTexture("grading_intro_glimpse_dw.dds");
		
		if (m_nConstShake!=-1)
		{
			Effect_Shake_FadeOut(m_nConstShake,0.0f);
			m_nConstShake=-1;
		}	
		
		if(cLux_GetPlayer().GetCharacterBody() !is null)	
			cLux_GetPlayer().GetCharacterBody().SetTestCollision(true);
		Item_AddToInventory("CurseMedallion");
		cLux_EnableSaving();
		
		cScript_SetGlobalVarBool("HideAmuletBracelet", false);
	}
	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		// return false for default behaviour
		return false;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{		
		// return false for default behaviour (fadeout and death area)
		return false;
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			iLuxEntity@ pPassenger4 = cLux_GetCurrentMap().GetEntityByName("Passenger_04");
			cVector3f position = pPassenger4.GetPosition();
			cMatrixf matrix = cMath_MatrixRotateXYZ(cVector3f(0,cMath_ToRad(125),0));
			matrix.SetTranslation(position);
			pPassenger4.SetMatrix(matrix);
		}
		else if (alAction == eAction_Test2)
		{
			Sequence_Stop();
			Voice_StopAll();
			Seq_Intro();
		}
		else if (alAction == eAction_Test3)
		{
			ParticleSystem_SetActive("PS_Engine_smoke*",true);
			ParticleSystem_SetActive("PS_Engine_failure*", true);
		}
		else if (alAction == eAction_Test4)
		{
			
		}
	}
	
	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		cLux_DisableSaving(1.0f);
		
		UpdateCameraMove(afTimeStep);	
	}
	
	//-------------------------------------------------------
	
	float mfBladesSpeed=-0.5f;
	float mfBladesJitter=0.05f;
	cVector2f mvPlaneSandWindowZMove = cVector2f(-2.594, -2.67);
	float mfPlaneSandWindowDuration=10.0f;
	float mfPlaneSandWindowTime = 0.0f;
	
	void PostUpdate(float afTimeStep)
	{
		if (mfSketchAlpha!=mfSketchAlphaTarget)
		{
			if (mfSketchFadeSpeed==0.0f)
				mfSketchAlpha = mfSketchAlphaTarget;
			else
				mfSketchAlpha = cMath_IncreaseTo(mfSketchAlpha, afTimeStep/mfSketchFadeSpeed, mfSketchAlphaTarget);
		}

		if (m_skyBoxStage == eSkyBoxStage_Paused)
			return;
		
		m_fFlyingTime+=afTimeStep;
		
		if (m_skyBoxStage==eSkyBoxStage_Flying)
		{
			m_skyBoxRotationVel.x=(cMath_Sin(m_fFlyingTime))/20.0f;
			m_skyBoxRotationVel.y=0.1f;
			m_skyBoxRotation+=m_skyBoxRotationVel*afTimeStep;
			m_skyBoxBaseRotation.y+=cMath_ToRad(1.0f)*afTimeStep;
		}
		else if (m_skyBoxStage==eSkyBoxStage_Blackout)
		{
			m_skyBoxRotationVel.x=(cMath_Sin(m_fFlyingTime*2.0f))/5.0f;	// Rougher ride
			m_skyBoxRotationVel.y=0.15f;
			m_skyBoxRotation+=m_skyBoxRotationVel*afTimeStep;
			m_skyBoxBaseRotation.y+=cMath_ToRad(1.0f)*afTimeStep;
		}
		else if (m_skyBoxStage==eSkyBoxStage_Crashing)
		{
			m_skyBoxBaseRotation.x=cMath_InterpolateLinear(m_skyBoxBaseRotation.x, cMath_ToRad(7.0f), afTimeStep);
			m_skyBoxBaseRotation.y=cMath_InterpolateLinear(m_skyBoxBaseRotation.y, cMath_ToRad(90.0f), afTimeStep);
			m_skyBoxBaseRotation.z=cMath_InterpolateLinear(m_skyBoxBaseRotation.z, cMath_ToRad(0.0f), afTimeStep);
			
			m_skyBoxRotationVel.x=(cMath_Sin(m_fFlyingTime*3.0f))/10.0f;
			m_skyBoxRotationVel.y=(cMath_Sin(m_fFlyingTime*2.5f))/10.0f+0.2f;
			m_skyBoxRotation+=m_skyBoxRotationVel*afTimeStep;
		}

		Map_SetSkyboxRotation(m_skyBoxRotation+m_skyBoxBaseRotation);
		
		// Update the tower to match the Skybox rotation.
		iLuxEntity@ pTower = cLux_GetCurrentMap().GetEntityByName("Tower_1");
		cVector3f towerRot = m_skyBoxRotation+m_skyBoxBaseRotation;
		towerRot.y-=m_towerOffsetRotationY;
		cMatrixf rotMatrix = cMath_MatrixRotateXYZ(towerRot);
		cMatrixf towerMatrix = cMath_MatrixMul(rotMatrix,cMath_MatrixTranslate(m_towerPos));
		pTower.SetMatrix(towerMatrix);
		
		iLuxEntity@ pSandstorm = cLux_GetCurrentMap().GetEntityByName("Sandstorm_Backdrop");
		pSandstorm.SetMatrix(towerMatrix);
		
		iLuxEntity@ pDesert = cLux_GetCurrentMap().GetEntityByName("Desert_Backdrop");
		pDesert.SetMatrix(towerMatrix);
		
		iLuxEntity@ pBlades = cLux_GetCurrentMap().GetEntityByName("plane_blades_on_1");
		float rotation=m_fFlyingTime*mfBladesSpeed+cMath_RandRectf(-mfBladesJitter,mfBladesJitter);
		cVector3f position = pBlades.GetPosition();
		cMatrixf matrix = cMath_MatrixRotateXYZ(cVector3f(0,0,rotation));
		matrix.SetTranslation(position);
		pBlades.SetMatrix(matrix);
		@pBlades = cLux_GetCurrentMap().GetEntityByName("plane_blades_off_1");
		pBlades.SetMatrix(matrix);		
		
		// Fake some passenger animation by just moving a bunch of rigids.
		float fCrashMul = 1.0f;
		if (mbPassengersCrashAnim)
			fCrashMul = 2.0f;
		iLuxEntity@ pPassenger3 = cLux_GetCurrentMap().GetEntityByName("Passenger_03");
		float charRotateX = cMath_Sin(m_fFlyingTime*fCrashMul)*0.04f*fCrashMul;
		float charRotateZ = cMath_Sin(m_fFlyingTime*0.5f+3.75f)*0.025f;
		position = pPassenger3.GetPosition();
		matrix = cMath_MatrixRotateXYZ(cVector3f(charRotateX,cMath_ToRad(180),charRotateZ));
		matrix.SetTranslation(position);
		pPassenger3.SetMatrix(matrix);
		
		iLuxEntity@ pPassenger2 = cLux_GetCurrentMap().GetEntityByName("Passenger_02");
		charRotateX = cMath_Sin(m_fFlyingTime*0.7f*fCrashMul+0.5f)*0.03f*fCrashMul;
		charRotateZ = cMath_Sin(m_fFlyingTime*0.4f-3.15f)*0.005f;
		position = pPassenger2.GetPosition();
		matrix = cMath_MatrixRotateXYZ(cVector3f(charRotateX,cMath_ToRad(180),charRotateZ));
		matrix.SetTranslation(position);
		pPassenger2.SetMatrix(matrix);
		
		iLuxEntity@ pMasson = cLux_GetCurrentMap().GetEntityByName("Masson");
		charRotateX = cMath_Sin(m_fFlyingTime*fCrashMul*1.1f)*0.03f*fCrashMul;
		charRotateZ = cMath_Sin(m_fFlyingTime*0.8f-3.15f)*0.025f;
		position = pMasson.GetPosition();
		matrix = cMath_MatrixRotateXYZ(cVector3f(charRotateX,cMath_ToRad(180),charRotateZ));
		matrix.SetTranslation(position);
		pMasson.SetMatrix(matrix);
		
		iLuxEntity@ pSandWindow = cLux_GetCurrentMap().GetEntityByName("plane_sand_window");
		if (pSandWindow.IsActive())
		{
			mfPlaneSandWindowTime+=afTimeStep;
			float fProgress = cMath_Clamp(mfPlaneSandWindowTime/mfPlaneSandWindowDuration,0.0f,1.0f);
			position = pSandWindow.GetPosition();
			position.z = cMath_Easing(eEasing_SineOut, fProgress, mvPlaneSandWindowZMove.x, mvPlaneSandWindowZMove.y);
			pSandWindow.SetPosition(position);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
