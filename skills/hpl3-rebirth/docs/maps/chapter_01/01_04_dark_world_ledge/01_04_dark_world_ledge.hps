		/////////////////////////////////////////
		// Event D *Go down the ramp and find the hidden tunnel in the thick mist*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msTargetRift_Tunnel = "Target_Rift_Tunnel";
		int mlNormalRift_AreaCount = 0;

		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterThickFogDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Amulet_StartTracking(false, "Rift_RuinsEntranceNormal");
			
			Entity_SetActive("Trigger_EnterThickFogDialogue*", false);
			
			mvDWLightning_LoopDir = Map_GetEntity("Widget_LightningDir_2").GetMatrix().GetTranspose().GetForward();
			mfDWLightning_LoopAngleOffset = 160;
			
			Effect_DoF_Start(0, 20, 1, 2.0);
			Voice_Play("Dialogue_EnterThickFog");
			
			if (Amulet_IsHeld() == false) Map_AddTimer("Timer_ShowAmuletHint", 60.f * 5.f, "OnTimer_ShowAmuletHint");
				
			Map_AddTimer("Timer_ShowAmuletGuideHint", 60.f * 4.f, "OnTimer_ShowAmuletGuideHint");
			Map_AddTimer("Timer_CheckThickFogAmuletDialogue", 5, "OnTimer_CheckThickFogAmuletDialogue");
			return false;
		}
		
		//-------------------------------------------------------
		
		float mfTickFogAmuletDialogueRepeatTime = 12.5;
		float mfTickFogAmuletDialogueTimer = 0;
		float mfTickFogAmuletDialogueDownTimer = 0;
		void OnTimer_CheckThickFogAmuletDialogue(const tString &in asTimer)
		{
			if (Voice_SubjectHasUnplayedLines("Dialogue_AmuletBarks") == false) return;
			
			float fNext = cMath_RandRectf(0.5f, 1.0f);
			if (Amulet_IsHeld() == false)
			{
				mfTickFogAmuletDialogueDownTimer += fNext;
				mfTickFogAmuletDialogueTimer += fNext;
				if (mfTickFogAmuletDialogueTimer >= mfTickFogAmuletDialogueRepeatTime && mfTickFogAmuletDialogueDownTimer > 3)
				{
					mfTickFogAmuletDialogueRepeatTime = 15;
					mfTickFogAmuletDialogueTimer = 0;
					Voice_Play("Dialogue_AmuletBarks");
				}
			}
			else
			{
				mfTickFogAmuletDialogueDownTimer = 0;
			}
			
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowAmuletGuideHint(const tString &in asTimer)
		{
			Hint_ShowHint("Hints", "HintAmuletGuide", false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ActivateAmulet(const tString &in asParent, const tString &in asChild, int alState)
		{
			FearHandler_SetPermaFailRespawnArea("PermaFail_Herbert");
			Map_AddTimer("Timer_ActivateAmulet", 1, "OnTimer_ActivateAmulet");
			return false;
		}
		
		void OnTimer_ActivateAmulet(const tString &in asTimer)
		{
			Amulet_StartTracking(true, "Rift_RuinsEntranceNormal");
			Voice_PlayDelayed("Dialogue_AmuletBarks", 1.5);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ChangeAmuletTarget(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_RemoveTimer("Timer_ShowAmuletGuideHint");
			
			Amulet_StartTracking(false, "", -1.f);
			return false;
		}
		
		//-------------------------------------------------------
		
		void InitRuinsEntranceNormalRift()
		{
			Entity_SetActive("RiftRuinsEntranceNormal_Open*", false);
			Light_SetBrightness("RiftRuinsEntranceNormal_Open*", 0);			
			Entity_SetActive("RiftRuinsEntranceNormal_Closed*", true);
		}
		
		//-------------------------------------------------------
		
		void OnRiftStage_RuinsEntranceNormal(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			cLux_AddDebugMessage("[Map] " + asRift + " " + alStage + " " + abOpening + " " + afOpenAmount);
			if (alStage == 4 && abOpening)
			{				
				Voice_Play("Dialogue_EnterRealWorldRift", 0.5);
				Map_RemoveTimer("Timer_CheckThickFogAmuletDialogue");
				
				Prop_SetActiveAndFade("RiftRuinsEntranceNormal_Open*", true, 1.0);
				Prop_SetActiveAndFade("RiftRuinsEntranceNormal_Closed*", false, 1.0);
				Light_FadeBrightnessToDefault("RiftRuinsEntranceNormal_Open*", 2.0);
				Light_FadeBrightnessTo("RiftRuinsEntranceNormal_Closed*", 0, 0.5);
				
				//Sound_CreateAtEntity("Sound_PortalOpen", "level_entity_shared/portal/portal_open", "Rift_RuinsEntranceNormal");
				//Sound_CreateAtEntity("Sound_PortalLoop", "level_entity_shared/portal/portal_open_loop", "Rift_RuinsEntranceNormal");
			}
			else if (alStage == 3 && abOpening == false)
			{
				Prop_SetActiveAndFade("RiftRuinsEntranceNormal_Open*", false, 1.0);
				Prop_SetActiveAndFade("RiftRuinsEntranceNormal_Closed*", true, 1.0);
				Light_FadeBrightnessTo("RiftRuinsEntranceNormal_Open*", 0, 0.5);
				Light_FadeBrightnessToDefault("RiftRuinsEntranceNormal_Closed*", 2.0);
				
				//Sound_CreateAtEntity("Sound_PortalClose", "level_entity_shared/portal/portal_open", "Rift_RuinsEntranceNormal");
//				Sound_Stop("Sound_PortalLoop", 1.0);
			}
		}

		//-------------------------------------------------------
		
		bool OnCollide_Player_CloseEntranceNormalRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Dialogue_LeaveRealWorldRift");
			
			FearHandler_SetPermaFailRespawnArea("PermaFail_Ruins");
			
			Rift_SetForceClose("Rift_RuinsEntranceNormal", true);
			Amulet_StopTracking();
			Sound_CreateAtEntity("RiftClose", "level_entity_shared/portal/portal_close", "Target_NormalRiftCloseSound");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterRealWorldRiftDialogue(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Dialogue_EnterRealWorldRift");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterNormalRftArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlNormalRift_AreaCount += alState;
			
			if (alState == 1 && mlNormalRift_AreaCount >= 1)
			{
				FadeDarkWorldFog(0.5f, 3.0f);
			}
			else if (alState == -1 && mlNormalRift_AreaCount <= 0)
			{
				FadeDarkWorldFog(1.0f, 3.0f);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void InitRuinsEntranceDarkRift()
		{
			Entity_SetActive("RiftRuinsEntranceDark_Open*", false);
			Light_SetBrightness("RiftRuinsEntranceDark_Open*", 0);			
			Entity_SetActive("RiftRuinsEntranceDark_Closed*", true);
		}
		
		//-------------------------------------------------------

		//} END Event D *Go down the ramp and find the hidden tunnel in the thick mist*
	 
	//} END SCENE 3
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 4 *Navigate through the city ruins and catch a glimpse of the wraith*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
		
		bool mbWraithSightingsEnabled = true;
	 
		//-------------------------------------------------------
		
		bool StartWraithSighting()
		{
			if (mbWraithSightingsEnabled == false) return false;
			mbWraithSightingsEnabled = false;
			
			SetWraithSoundsActive(false);
			return true;
		}
		
		//-------------------------------------------------------
		
		void EnableWraithSightings(float afDelay)
		{
			if (mbWraithSightingsEnabled) return;
			if (Map_TimerExists("Timer_EnableWraithSightings")) return;
			
			Map_AddTimer("Timer_EnableWraithSightings", afDelay, "OnTimer_EnableWraithSightings");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableWraithSightings(const tString &in asTimer)
		{
			cLux_AddDebugMessage("[Map] Enable wraith sightings");
			mbWraithSightingsEnabled = true;
			
			SetWraithSoundsActive(true);
		}
		
		//-------------------------------------------------------
		
		//} END General
		
		/////////////////////////////////////////
		// Event A *Navigate the paths in the city ruins by following the amulet*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_RuinsBeamCrack(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_RuinsBeamCrack_*", false);
			
			Effect_Shake_Start(0.2f, 1.0f, 0.5f, 0.5f);
			FearHandler_SetForcedAddFearRate(0.4f, 3.0f, true, -1.0f, -1.0f, 1.0f);
			Music_Play("A2_1_4_Wraith_Appear.ogg", 0.5f, false, eMusicPrio_MinorEvent );
			Map_AddTimer("Timer_WraithHuntMusic", 4.0f, "OnTimer_PlayWraithMusic");
			return false;
		}
		
		//-------------------------------------------------------

		void OnTimer_PlayWraithMusic(const tString &in asTimer)
			{
			 Music_Stop(3.0f, eMusicPrio_SceneAmb);
			 Music_Play("A2_1_4_Wraith_Hunt.ogg", 0.3f, true, eMusicPrio_SceneAmb);
			}
		
		//-------------------------------------------------------
		
		void OnLookAt_SeeAshFiguresDialogue(const tString &in asEntity, int alState)
		{
			if (Map_TimerExists("AshFigureCooldown")) return;
			if (Voice_SubjectIsPlaying("Dialogue_SeeWraithLight")) return;
						
			Voice_Play("Dialogue_SeeAshFigures");
			
			Map_AddTimer("AshFigureCooldown", 8, "");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_SeeFirstAshFiguresDialogue(const tString &in asEntity, int alState)
		{
			FearHandler_SetForcedAddFearRate(0.6f, 2.0f, false, 1.5, 0.08, 0.0f);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_SeeAshCrowdDialogue(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_SeeAshCrowd");
		}
		
