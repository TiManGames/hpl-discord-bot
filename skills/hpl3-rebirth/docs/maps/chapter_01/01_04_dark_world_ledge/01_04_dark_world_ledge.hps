		bool OnTrigger_Player_ShowAmuletHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_CheckCaveAmuletHint", 5, "OnTimer_CheckCaveAmuletHint");
