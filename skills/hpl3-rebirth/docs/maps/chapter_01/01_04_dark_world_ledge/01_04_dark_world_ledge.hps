	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------

	bool mbInDarkWorld = false;
	array<cColor> mvEnvironementParticlesOriginalColors;
	bool mbTransitionEnvironmentParticlesColor = false;
	bool mbTransitionEnvironmentParticlesColorToOriginal = false;
	float mfEnvironmentParticlesTransitionTime = 1.0f;
	float mfEnvironmentParticlesTransitionTimer = 0.0f;
	int mlDisableGlobalFogAreas = 0;
	bool mbParticlesStopped = false;
	int mlStopParticleVelocityAreas = 0;
	array<cVector3f> mvOriginalParticleVelocities;
	float mfStopParticleTransitionTime = 0.0f;
	float mfStopParticleTransitionTimer = 0.0f;
	int mlPermafailStage = eDarkWorldLegePermafailStage_Default;
	int mlPermaFailScene = 0;
	
	//-------------------------------------------------------
	
	void UpdateGlobalFog(float afTimeStep)
	{
		if (mbTransitionEnvironmentParticlesColor)
		{
			for (int i = 0; i < cLux_GetCurrentMap().GetWorld().GetEnvironmentParticleNum(); ++i)
			{
				cColor envCol = cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i).GetColor();
				cColor tarCol = mvEnvironementParticlesOriginalColors[i];
				tarCol.a = 0.0f;
				
				envCol.a = cMath_InterpolateLinear(mvEnvironementParticlesOriginalColors[i].a, tarCol.a, mfEnvironmentParticlesTransitionTimer / mfEnvironmentParticlesTransitionTime);
				cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i).SetColor(envCol);
			}
			
			mfEnvironmentParticlesTransitionTimer += 1.0f / mfEnvironmentParticlesTransitionTime * afTimeStep;
			if (mfEnvironmentParticlesTransitionTimer >= mfEnvironmentParticlesTransitionTime) mbTransitionEnvironmentParticlesColor = false;
		}
		
		if (mbTransitionEnvironmentParticlesColorToOriginal)
		{
			for (int i = 0; i < cLux_GetCurrentMap().GetWorld().GetEnvironmentParticleNum(); ++i)
			{
				cColor envCol = cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i).GetColor();
				
				envCol.a = mfEnvironmentParticlesTransitionTimer / mfEnvironmentParticlesTransitionTime * mvEnvironementParticlesOriginalColors[i].a;
				cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i).SetColor(envCol);
			}
			
			mfEnvironmentParticlesTransitionTimer += afTimeStep;
			if (mfEnvironmentParticlesTransitionTimer >= mfEnvironmentParticlesTransitionTime) mbTransitionEnvironmentParticlesColorToOriginal = false;
		}
		
		if (mfStopParticleTransitionTimer > 0.0f)
		{
			mfStopParticleTransitionTimer -= afTimeStep;
			for (int i = 0; i < cLux_GetCurrentMap().GetWorld().GetEnvironmentParticleNum(); ++i)
			{
				float fT = cMath_Clamp(mfStopParticleTransitionTimer / mfStopParticleTransitionTime, 0.0f, 1.0f);
				if (mbParticlesStopped == false) fT = 1.0f - fT;
				cVector3f vNewVel = mvOriginalParticleVelocities[i] * fT;
				cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i).SetWindVelocity(vNewVel);
			}
		}
	}
	
	//-------------------------------------------------------
	
	void SetEnironmentalParticlesAlpha(float alAlpha)
	{
		for (int i = 0; i < cLux_GetCurrentMap().GetWorld().GetEnvironmentParticleNum(); ++i)
		{
			cColor envCol = cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i).GetColor();
			envCol.a = alAlpha;
			cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i).SetColor(envCol);
		}
	}
	
	//-------------------------------------------------------
	
	void DisableEnvironmentParticles(float afFadeTime)
	{
		mbTransitionEnvironmentParticlesColor = true;
		mfEnvironmentParticlesTransitionTime = afFadeTime;
		mfEnvironmentParticlesTransitionTimer = 0.0f;
	}
	
	//-------------------------------------------------------
	
	void EnableEnvironmentParticles(float afFadeTime)
	{
		mbTransitionEnvironmentParticlesColorToOriginal = true;
		mfEnvironmentParticlesTransitionTime = afFadeTime;
		mfEnvironmentParticlesTransitionTimer = 0.0f;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_DisableGlobalFog(const tString &in asParent, const tString &in asChild, int alState)
	{
		mlDisableGlobalFogAreas += alState;
		if (alState == 1)
		{
//			DisableEnvironmentParticles(2.0f);
		}
		
		if (mlDisableGlobalFogAreas == 0 && alState == -1)
		{
//			SetDarkWorldFogVisible(true);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_StopParticles(const tString &in asParent, const tString &in asChild, int alState)
	{
		mlStopParticleVelocityAreas += alState;
		if (mlStopParticleVelocityAreas > 0) StopGlobalParticles(0.5f);
		else ResumeGlobalParticles(0.5f);
		return true;
	}
	
	//-------------------------------------------------------
	
	void StopGlobalParticles(float afTransitionTime)
	{
		if (mbParticlesStopped) return;
		mbParticlesStopped = true;
		mfStopParticleTransitionTime = afTransitionTime;
		mfStopParticleTransitionTimer = afTransitionTime;
		for (int i = 0; i < cLux_GetCurrentMap().GetWorld().GetEnvironmentParticleNum(); ++i)
		{
			mvOriginalParticleVelocities.push_back(cLux_GetCurrentMap().GetWorld().GetEnvironmentParticles(i).GetWindVelocity());
		}
	}
	
	//-------------------------------------------------------
	
	void ResumeGlobalParticles(float afTransitionTime)
	{
		if (mbParticlesStopped == false) return;
		mbParticlesStopped = false;
		mfStopParticleTransitionTime = afTransitionTime;
		mfStopParticleTransitionTimer = afTransitionTime;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DeactivateEntity(const tString &in asTimer)
	{
		Entity_SetActive(asTimer, false);
	}
	
