/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/

enum eDarkWorldLegePermafailStage
{
	eDarkWorldLegePermafailStage_Default = 0,
	eDarkWorldLegePermafailStage_Wraiths = 1,
}
 
//--------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		cLux_GetCurrentMap().GetPhysicsWorld().SetWorldSize(Map_GetEntity("Target_PhysicsMin").GetPosition(), Map_GetEntity("Target_PhysicsMax").GetPosition());
		
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("01-04-dark-world-ledge");
		
		// Reset effects
		Effect_Bloom_FadeBrightPass(0.3f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(1.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		//Set up view distance for Ledge vista
		
		Player_SetCameraFarPlane(8192.0f);
				
		Pregnancy_SetStage(ePregStage_Unknown);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyKicksEnabled(false);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Unknown);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_Ill);
		Player_SetAllowCheckBaby(false);
		FearHandler_SetWhisperStage(eFearWhisperStage_StartToSalim);
		
		Map_Preset_SetupDirLight("Preset_LightningOn", true, cColor(1,1.5,2,1), 20, cVector3f(-0.913, -0.407, -0.009), cColor(0.092,0.069,0.069,1), cColor(0.092,0.069,0.069,1));
//		Map_Preset_SetupColorGrading("Preset_LightningOn", "grading_lightning_flash");
		Map_Preset_SetupBloom("Preset_LightningOn", 10, 0.02f, 1.5f, cColor(1, 2, 2, 1));
		
		Map_Preset_SetupDirLight("Preset_LightningOff", false, cColor(0.269,0.339,0.35,1), 0.f, cVector3f(-0.644, -0.462, 0.61), cColor(0.222,0.289,0.299,1), cColor(0.101,0.171,0.182,1));
//		Map_Preset_SetupColorGrading("Preset_LightningOff", "grading_darkworld_ledge");
		Map_Preset_SetupBloom("Preset_LightningOff", 128.f, 0.75f, 0.5f, cColor(1.f));
		
		Map_Preset_Fade("Preset_LightningOff", 1.0f);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(0);
		StruggleFlashHandler_SetProgression(0);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		//ParticleSystem_Preload("some_particle.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		//////////////
		// Preload sound
		Sound_PreloadGroup("level_entity_shared/portal", true);
		Sound_PreloadEvent("01_04_dark_world_ledge/level_events/ledge_rockslide");
		Sound_PreloadEvent("level_entity_shared/fire/fire_ignite/campfire_ignite");
		Sound_PreloadEvent("level_entity_shared/fire/fire_ignite/wall_torch_ignite");
