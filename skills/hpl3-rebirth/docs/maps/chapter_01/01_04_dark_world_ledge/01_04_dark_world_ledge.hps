	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 5 *Open the rift and return to the normal world*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene X here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene X here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
		
		/////////////////////////////////////////
		// Event A *Open the rift*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msProp_Rift = "Prop_Rift";
		bool mbOpenRift_MovingPlayer = false;
		cVector3f mvOpenRift_PlayerStartPos;
		cVector3f mvOpenRift_PlayerEndPos;
		float mfOpenRift_MovePlayerTimer = 0.0f;
		bool mbOpenRift_Open = false;
		bool mbOpenRift_OnStopLevitateTrigger = false;
		bool mbRift_DistortionSphereActive = false;
		bool mbRift_DistortionSphereClosing = false;
		int mlRuinsRift_StageCount = 10;
		int mlRuinsRift_Stage = 0;
		
		int mlRuinsRift_GravityStage = 0;
		float mfRuinsRift_GravityTimer = 0;
		cVector3f mvRuinsRift_GravityStart = 0;
		cVector3f mvRuinsRift_OriginalGravity;
		
		array<array<tID>> mvRuinsRift_Lights;
		array<array<float>> mvRuinsRift_LightsBrightness;
		
		array<array<tID>> mvRuinsRift_Billboards;
		array<array<float>> mvRuinsRift_BillboardsBrightness;
		
		array<tID> mvBillBoardFades;
		array<float> mvBillBoardFadesDest;
		array<float> mvBillBoardFadesAdds;
		array<float> mvBillBoardFadesTimes;
		
		//-------------------------------------------------------
		
		void InitRuinsRift()
		{
			Entity_SetActive("RiftRuins_NW*", false);
			Light_SetBrightness("Light_Open_RiftRuins*", 0);		
			Entity_SetActive("RiftRuins_DW*", true);
//			Billboard_SetVisible("Billboard_Rift_*", false);
			
//			Entity_AddImpulse("rift_rock_fall_RiftRuins_*", cVector3f_Down * 0.1, true, true);
			
//			Prop_SetStaticPhysics("rift_rock_RiftRuins_*", true);
//			Entity_SetCollideCharacter("rift_rock_RiftRuins_*", false);
//			Entity_SetCollide("rift_rock_RiftRuins_*", false);	
		}
		
		//-------------------------------------------------------
		
		void UpdateRift(float afTimeStep)
		{
			if (mlRuinsRift_GravityStage == 1)
			{
				mfRuinsRift_GravityTimer += afTimeStep;
				float fT = cMath_Clamp(mfRuinsRift_GravityTimer / 2.0f, 0.0f, 1.0f);
				fT = cMath_Easing(eEasing_CubicInOut, fT, 0.0f, 1.0f);
				
				cVector3f vPos = mvRuinsRift_GravityStart * (1.0f - fT) + Map_GetEntity("Target_TunnelThrow_1").GetPosition() * (fT);
				cLux_GetPlayer().GetCharacterBody().SetPosition(vPos, false);
				
				if (fT >= 0.9f)
				{
					++mlRuinsRift_GravityStage;
					mfRuinsRift_GravityTimer = 0;
					mvRuinsRift_GravityStart = Player_GetPosition();
				}
			}
			else if (mlRuinsRift_GravityStage == 2)
			{
				mfRuinsRift_GravityTimer += afTimeStep;
				float fT = cMath_Clamp(mfRuinsRift_GravityTimer / 3.0f, 0.0f, 1.0f);
				fT = cMath_Easing(eEasing_CubicIn, fT, 0.0f, 1.0f);
				
				cVector3f vPos = mvRuinsRift_GravityStart * (1.0f - fT) + Map_GetEntity("Target_TunnelThrow_2").GetPosition() * (fT);
				cLux_GetPlayer().GetCharacterBody().SetPosition(vPos, false);
				if (fT >= 1.0f)
				{
					++mlRuinsRift_GravityStage;
					mfRuinsRift_GravityTimer = 0;
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnLoookAt_SeePlaneEngineDialogue(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_SeePlaneEngine");
		}
		
		//-------------------------------------------------------
		
		void OnRiftStage_RuinsRift(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			if (alStage == 4 && abOpening)
			{
				Prop_SetActiveAndFade("RiftRuins_NW*", true, 0.5);
				Prop_SetActiveAndFade("RiftRuins_DW*", false, 0.5);
				Light_FadeBrightnessToDefault("Light_Open_RiftRuins*", 0.5);
				Light_FadeBrightnessTo("Light_Closed_RiftRuins*", 0, 0.5);
				
				Map_AddTimer("rift_rock_fall_RiftRuins_*", 0, "OnTimer_DropRiftRocks");
				
				//Sound_CreateAtEntity("Sound_PortalOpen", "level_entity_shared/portal/portal_open", "RuinsRift");
				//Sound_CreateAtEntity("Sound_PortalLoop", "level_entity_shared/portal/portal_open_loop", "Trigger_SoundPortal_4");
			}
			else if (alStage == 3 && abOpening == false)
			{
				Prop_SetActiveAndFade("RiftRuins_NW*", false, 0.5);
				Prop_SetActiveAndFade("RiftRuins_DW*", true, 0.5);
				Light_FadeBrightnessTo("Light_Open_RiftRuins*", 0, 0.5);
				Light_FadeBrightnessToDefault("Light_Closed_RiftRuins*", 0.5);
				
				//Sound_CreateAtEntity("Sound_PortalClose", "level_entity_shared/portal/portal_open", "RuinsRift");
				//Sound_Stop("Sound_PortalLoop", 1.0);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DropRiftRocks(const tString &in asTimer)
		{
			array<iLuxEntity@> vEnts;
			Map_GetEntityArray(asTimer, vEnts);
						
			for (int i = 0; i < vEnts.size(); ++i)
			{
				iLuxEntity@ pEnt = vEnts[i];
				Map_AddTimer(pEnt.GetName(), cMath_RandRectf(0, 1.0), "OnTimer_DropRiftRock");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DropRiftRock(const tString &in asTimer)
		{
			Entity_AddImpulse(asTimer, cVector3f_Down * 0.1, true, true);
		}
		
		//-------------------------------------------------------
		
		void FadeBillBoardBrightness(tID a_idBillBoard, float afBrightness, float afTime)
		{
			mvBillBoardFades.push_back(a_idBillBoard);
			mvBillBoardFadesDest.push_back(afBrightness);
			mvBillBoardFadesTimes.push_back(afTime);
			
			float fBrightness = cLux_ID_Billboard(a_idBillBoard).GetBrightness();
			float fAdd = (afBrightness - fBrightness) / afTime;
			mvBillBoardFadesAdds.push_back(fAdd);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ChangeGravity(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_GravityShift("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceGravityShift;
		void Seq_GravityShift(const tString &in asTimer)
		{
			Sequence_Begin("Seq_GravityShift", mSequenceGravityShift);
			if (Sequence_DoStepAndPause(0))
			{
				Amulet_StopTracking();
				
				Item_PutAway(eItemHandlerHand_Right);
				Item_PutAway(eItemHandlerHand_Left);
				
				PlayerBody_PlayCutsceneAtEntity("player_gravity_shift_kicks_in", "Trigger_GravityShiftAnim", false, 0.5);
				Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimationMessage_GravityShift", false);
				
				Voice_PlayDelayed("Dialogue_RiftKicksIn", 0.4);
				Music_Play("A2_1_4_Exit_Fall.ogg", 0.5f, false, eMusicPrio_BigEvent);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Effect_Fade_Out(0.5);
			}
			else if (Sequence_DoStepAndWait(0.7))
			{
				Voice_FadeSceneVolumeTo("Comments", 0, 0.5);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{	
				// Stopping anims here or the anims in the dream will fail to start.
				PlayerBody_StopAnimationLayer(ePlayerBodyAnimationLayer_FullBody, 0.f);
				Map_ChangeMap("01_04_dark_world_ledge_dream.hpm", "Start_Begin", "", "", false);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimationMessage_GravityShift(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			SequenceStates_Resume("Seq_GravityShift");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartDreamSequence(const tString &in asParent, const tString &in asChild, int alState)
		{
			///////////////////////////////////////
			// Change map to Dark world ledge dream
			float fFallDuration = 1.f;
			Effect_Fade_Out(fFallDuration * 0.83f);
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_RuinsRift(const tString &in asEntity, int alState)
		{
			float fDist = cMath_Vector3Dist(Player_GetPosition(), Map_GetEntity(asEntity).GetPosition());
			if (fDist < 56.0f) return;
			Voice_Play("Dialogue_SeeDestination");
//			Music_Play("A2_1_4_Exit_Discover.ogg", 0.3f, true, eMusicPrio_SceneAmb);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ReduceAmuletPushPower(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) Map_AddTimer("Timer_CheckAmuletPower", 0, "OnTimer_CheckAmuletPower");
			else
			{
				Map_RemoveTimer("Timer_CheckAmuletPower");
				PushableFogArea_ResetCustomStartAndEnd("Fog_Ruins_Pushable");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckAmuletPower(const tString &in asTimer)
		{
			float fPlayerDist = Player_GetDistanceToEntity("RuinsRift");
			if (fPlayerDist <= 15.0)
			{
				PushableFogArea_SetCustomStartAndEnd("Fog_Ruins_Pushable", 0, 1);
			}
			else
			{
				PushableFogArea_ResetCustomStartAndEnd("Fog_Ruins_Pushable");
			}
			
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.4));
		}
		
		//-------------------------------------------------------

		//} END Event A *Open the rift*
		
		/////////////////////////////////////////
		// Event D *Exit the level*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		//-------------------------------------------------------

		//} END Event D *Exit the level*
		
		/////////////////////////////////////////
		// Event D *Run away from wraiths (Permafail)*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbPermafail_WraithRun_Played = false;
		
		//-------------------------------------------------------
		
		bool OnPermaFail_WraithRun(const tString &in asSource)
		{
			if (mbPermafail_WraithRun_Played == false)
			{
				mbPermafail_WraithRun_Played = true;
				
				FearHandler_AddPermaFailScene("Area_Permafail_WraithRun_Start_1", "Area_Permafail_WraithRun_End_1", 5.f, 3.5, false);
				FearHandler_AddPermaFailScene("Area_Permafail_WraithRun_Start_2", "Area_Permafail_WraithRun_End_2", 5.f, 3.5, false);
				FearHandler_AddPermaFailScene("Area_Permafail_WraithRun_Start_3", "Area_Permafail_WraithRun_End_3", 5.f, 4, false);
				return true;
			}
			
			SetupGenericPermaFail();
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnPermaFailSceneStarted_WraithRun()
		{
			if (mlPermaFailScene == 2)
			{
				Seq_PermafailWraithRun_Scene_2("");
			}
			else if (mlPermaFailScene == 3)
			{
				Seq_PermaFailWraithRun_Scene_3("");
			}
		}
		
		//-------------------------------------------------------
		
		void OnPermaFailSceneEnded_WraithRun()
		{
			if (mlPermaFailScene == 2)
			{
				Player_StopLookAt(999);
				Entity_SetActive("Wraith_PermafailWraithRun_1", false);
			}
			else if (mlPermaFailScene == 3)
			{
				Player_StopLookAt(999);
				Entity_SetActive("Wraith_PermafailWraithRun_2", false);
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequencePermafailWraithRun_Scene_2;
		void Seq_PermafailWraithRun_Scene_2(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PermafailWraithRun_Scene_2", mSequencePermafailWraithRun_Scene_2);
			if (Sequence_DoStepAndWait(0.2))
			{
				Entity_SetActive("Wraith_PermafailWraithRun_1", true);
				Wraith_SetFly("Wraith_PermafailWraithRun_1", true);
				Player_StartLookAt("Target_WraithRun_2", 1, 1, 2, true);
			}
			else if (Sequence_DoStepAndWait(1.7))
			{
				Wraith_TurnSpotlightToPos("Wraith_PermafailWraithRun_1", Map_GetEntity("Target_WraithRun_1").GetPosition(), true, true, 1.5f);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Player_StartLookAt("Target_WraithRun_3", 0.5, 1, 1.5, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequencePermaFailWraithRun_Scene_3;
		void Seq_PermaFailWraithRun_Scene_3(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PermaFailWraithRun_Scene_3", mSequencePermaFailWraithRun_Scene_3);
			if (Sequence_DoStepAndWait(0.2))
			{
				Entity_SetActive("Wraith_PermafailWraithRun_2", true);
				Wraith_SetFly("Wraith_PermafailWraithRun_2", true);
				Player_StartLookAt("Target_WraithRun_4", 1, 1, 2, true);
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				Wraith_SetSpotlightMovement_FollowEntity("Wraith_PermafailWraithRun_2", "Player", true);
				Wraith_SetSpotlightColor("Wraith_PermafailWraithRun_2", "alert");
			}
			else if (Sequence_DoStepAndWait(0.0))
			{
				Wraith_SetSpotlightColor("Wraith_PermafailWraithRun_2", "detected");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_RiftMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_PlayExt("A2_1_4_Exit_Discover.ogg", true, 0.4f, 1, 3, 0, eMusicPrio_SceneAmb, false);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_FinalRiftHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) Map_AddTimer("Timer_CheckFinalRiftHint", 0, "OnTimer_CheckFinalRiftHint");
			else Map_RemoveTimer("Timer_CheckFinalRiftHint");
			return true;
		}
		
		//-------------------------------------------------------
		
		float mfFinalRiftHintCounter = 0;
		void OnTimer_CheckFinalRiftHint(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.2, 0.4f);
			if (Amulet_IsHeld() == false)
			{
				mfFinalRiftHintCounter += fNext;
				if (mfFinalRiftHintCounter >= 10)
				{
					mfFinalRiftHintCounter = -60;
					Hint_ShowHint_Hold("Hints", "HintAmulet", true, 1.5, false);
					return;
				}
			}
			else
			{
				mfFinalRiftHintCounter = 0;
			}
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------

		//} END Event D *Run away from wraiths (Permafail)*
	 
