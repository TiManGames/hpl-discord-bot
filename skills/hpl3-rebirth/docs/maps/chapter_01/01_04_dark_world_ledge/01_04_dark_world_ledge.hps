	void Sound_CreateAtEntityCustom(const tString &in asName, const tString &in asFile, const tString &in asEntity, float afMaxDist = 2, float afMinDist = 10)
	{
		Sound_CreateAtEntity(asName, asFile, asEntity);
		cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity(asName);
		pSound.SetCustomMaxDistance(afMaxDist);
		pSound.SetCustomMinDistance(afMinDist);
		pSound.SetUseCustomProperties(true);
	}
	
