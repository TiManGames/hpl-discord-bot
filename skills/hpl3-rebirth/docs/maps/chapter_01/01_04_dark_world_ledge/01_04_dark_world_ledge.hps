		/////////////////////////////////////////
		// Event B *Cause a rockslide*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
				
		array<tString> mvRockSlide_EntGroups;
		bool mbRockSlide_InsideDeathArea = false;
		bool mbRockSlide_KillPlayer = false;
		bool mbRockSlide_SlideActive = false;
		bool mbRockSlide_Enabled = false;
		bool mbRockSlide_PullPlayer = false;
		float mfRockSlide_KillPlayerTimer = 10.0f;
		
		//-------------------------------------------------------
		
		void InitRockSlide()
		{
			Entity_SetActive("Rock_RockSlide*", false);
			Map_GetEntity("Rocks_Avalanche").GetMeshEntity().GetAnimationStateFromName("fall").SetRelativeTimePosition(0);
			Map_GetEntity("Rocks_Avalanche").GetMeshEntity().GetAnimationStateFromName("fall").SetPaused(true);
			Map_AddTimer("Timer_EnableRockSlide", 2.0f, "OnTimer_EnableRockSlide");
			Entity_SetCollideCharacter("Blocker_AvalancheRocks*", true);
		}
		
		//-------------------------------------------------------
		
		void UpdateRockSlide(float afTimeStep)
		{
			if (mbRockSlide_SlideActive)
			{
				cVector3f vDir = Map_GetEntity("Trigger_RockSlideDirection").GetMatrix().GetTranspose().GetForward();
				for (int i = 0; i < mvRockSlide_EntGroups.size(); ++i)
				{
					float fForce = 25000;
					if (mvRockSlide_EntGroups[i] == "Rock_Catalyst") fForce = 5000;
					if (cString_GetFirstStringPos(mvRockSlide_EntGroups[i], "Small") >= 0) fForce = 3500;
					Entity_AddForce(mvRockSlide_EntGroups[i], vDir * fForce, false, true);
				}
			}
			
			if (mbRockSlide_PullPlayer && (mbRockSlide_InsideDeathArea || mbRockSlide_KillPlayer))
			{
				mbRockSlide_KillPlayer = true;
				cVector3f vDir = Map_GetEntity("Trigger_PlayerPushDirection").GetMatrix().GetTranspose().GetForward();
				cLux_GetPlayer().GetCharacterBody().AddForce(vDir * 2000);
			}
		}
		
		//-------------------------------------------------------
		
		void OnInteract_LedgeRock(const tString &in asEntity)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asEntity);
			float fMass = pEnt.GetMainBody().GetMass();
			pEnt.GetMainBody().SetMass(fMass * 0.1f);
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_LedgeRock(const tString &in asEntity)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asEntity);
			float fMass = pEnt.GetMainBody().GetMass();
			pEnt.GetMainBody().SetMass(fMass * (1.0f / 0.1f));
		}
		
		//-------------------------------------------------------
		
		void OnInteract_RockCatalyst(const tString &in asEntity)
		{
			OnInteract_LedgeRock(asEntity);
			Map_AddTimer("Timer_StartRockSlide", 1.0f, "OnTimer_StartRockSlide");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_PrepareRockSlide(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_StatRockSlide", true);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartRockSlide(const tString &in asTimer)
		{
			if (mbRockSlide_Enabled == false) return;
			if (mbRockSlide_SlideActive) return;
			
			mbRockSlide_SlideActive = true;
			mbRockSlide_PullPlayer = true;
			
			Entity_PlayAnimation("Rocks_Avalanche", "fall", 0);
			
			Effect_Shake_Start(0.08f, 3.5f, 0.2f, 0.8f);
			FearHandler_SetForcedAddFearRate(0.8f, 4.0f, true, 1.0f, 0.1f, 0.2f);
			Voice_PlayDelayed("Dialogue_RockSlide", 1.0f);
			
			Sound_CreateAtEntity("Sound_Rockslide", "01_04_dark_world_ledge/level_events/ledge_rockslide", "Rock_RockSlide_Group1_1", 0, true);
			
			Entity_SetActive("Blocker_RockCatalyst_*", false);
			
//			Map_GetEntity("Rock_RockSlide_Group1_1").GetMainBody().SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("+catalyst"));
			Map_AddTimer("Rock_Catalyst", 0.0f, "OnTimer_ActivateRockSlideGroup");
//			Map_AddTimer("Rock_RockSlide_Group1_*", 0.0f, "OnTimer_ActivateRockSlideGroup");
//			Map_AddTimer("Rock_RockSlide_Group2_*", 0.3f, "OnTimer_ActivateRockSlideGroup");
//			Map_AddTimer("Rock_RockSlide_Group2Small_*", 0.3f, "OnTimer_ActivateRockSlideGroup");
//			Map_AddTimer("Rock_RockSlide_Group3_*", 0.6f, "OnTimer_ActivateRockSlideGroup");
//			Map_AddTimer("Rock_RockSlide_Group3Small_*", 0.6f, "OnTimer_ActivateRockSlideGroup");
			Map_AddTimer("Timer_DisableBlockers", 1.0f, "OnTimer_DisableBlockers");
			Map_AddTimer("Timer_StopRockSlidePullPlayer", 2.0f, "OnTimer_StopRockSlidePullPlayer");
			Map_AddTimer("Timer_StopRockSlideForce*", 3.0f, "OnTimer_StopRockSlideForce");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableBlockers(const tString &in asTimer)
		{
			Entity_SetActive("Blocker_AvalancheRocks*", false);
		}
		
		void OnTimer_EnableRockSlide(const tString &in asTimer)
		{
			mbRockSlide_Enabled = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateRockSlideGroup(const tString &in asTimer)
		{
			Prop_SetStaticPhysics(asTimer, false);
			mvRockSlide_EntGroups.push_back(asTimer);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopRockSlideForce(const tString &in asTimer)
		{
			mbRockSlide_SlideActive = false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopRockSlidePullPlayer(const tString &in asTimer)
		{
			mbRockSlide_PullPlayer = false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_RockSlideDeath(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbRockSlide_InsideDeathArea = alState == 1;
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Cause a rockslide*
		
		/////////////////////////////////////////
		// Event C *Look at TIN HINAN'S TOWER and experience a microflash*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		float mfTowerMicroFlash_LookAtTimer = 0;
		bool mbTowerMicroFlash_LookAtArea = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_TowerMicroflashArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			// Disabled this as it doesn't work with current art - IT
			return false;
			mbTowerMicroFlash_LookAtArea = alState == 1;
			if (alState == 1)
			{
				Map_AddTimer("Timer_CheckTowerMicroflash", 0.0f, "OnTimer_CheckTowerMicroflash");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckTowerMicroflash");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckTowerMicroflash(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.2f, 0.4f);
			
			if (IsLookingAtTower()) mfTowerMicroFlash_LookAtTimer += fNext;
			else mfTowerMicroFlash_LookAtTimer = 0;
			
			if (mfTowerMicroFlash_LookAtTimer >= 1.0f)
			{
				Sketchbook_Microflash("Microflash_Tower");
				Entity_SetActive("Trigger_TowerMicroflashArea", false);
				return;
			}
			
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		bool IsLookingAtTower()
		{
			if (mbTowerMicroFlash_LookAtArea == false) return false;
			
			cVector3f vPlayerLookDir = cLux_GetPlayer().GetCamera().GetForward();
		
			cVector3f vDir = Map_GetEntity("Trigger_TowerMicroflash").GetPosition() - Player_GetPosition();
			vDir.Normalize();
			
			float fDot = cMath_Vector3Dot(vPlayerLookDir, vDir);
			if (fDot < 0.0f) return false;
			
			cVector3f vLeft = cMath_Vector3Cross(cVector3f_Up, vDir);
			vLeft.Normalize();
			cVector3f vY = cMath_Vector3ProjectOnPlane(vPlayerLookDir, vLeft);
			
			cVector3f vUp = cMath_Vector3Cross(vLeft, vDir);
			vUp.Normalize();
			cVector3f vX = cMath_Vector3ProjectOnPlane(vPlayerLookDir, vUp);
			
			float fY = cMath_ToDeg(cMath_Vector3Angle(vPlayerLookDir, vX));
			float fX = cMath_ToDeg(cMath_Vector3Angle(vPlayerLookDir, vY));
						
			if (fX > 8.0f) return false;
			if (fY > 32.0f) return false;
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event B C *Look at TIN HINAN'S TOWER and experience a microflash*
		
