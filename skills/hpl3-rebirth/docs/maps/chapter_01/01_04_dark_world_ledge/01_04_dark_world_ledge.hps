		/////////////////////////////////////////
		// Event D *Jump into the mist below and return to the path*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlLedgeFallAreaCount = 0;
		bool mbPermafailing = false;
		
		//-------------------------------------------------------
		
		void UpdateLedgeFall(float afTimeStep)
		{
			if (mlLedgeFallAreaCount <= 0) return;
			if (FearHandler_GetIsPermaFailing() == false && cLux_GetPlayer().GetCharacterBody().IsOnGround())
			{
				mbRockSlide_PullPlayer = false;
//				FearHandler_TriggerPermaFail(false);
				FearHandler_TriggerPermaFail_Fall();
				mbPermafailing = true;
			}
		}
		
		//-------------------------------------------------------

		bool OnCollideTrigger_LedgeFallDeath(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlLedgeFallAreaCount += alState;
			return true;
		}
		
