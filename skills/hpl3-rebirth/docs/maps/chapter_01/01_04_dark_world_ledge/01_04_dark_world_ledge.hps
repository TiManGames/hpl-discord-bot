		int mlWraithRuinsFinale_IntrosCompleted = 0;
		bool mbWraithFinaleStarted = false;
		
		void CompleteWraithRuinsFinaleIntro()
		{
			++mlWraithRuinsFinale_IntrosCompleted;
			if (mlWraithRuinsFinale_IntrosCompleted == 4) SequenceStates_Resume("Seq_WraithRuinsFinaleDirector");
		}
		
		bool OnCollide_Player_StartWraithRuinsFinale(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_WraithFinaleLookAt", true);
			return false;
		}
		
		void OnLookAt_WraithFinale(const tString &in asEntity, int alState)
		{
			StartWraithFinale();
		}
		
		bool OnCollide_Player_WraithFinaleBackup(const tString &in asParent, const tString &in asChild, int alState)
		{
			StartWraithFinale();
			return false;
		}
		
		void StartWraithFinale()
		{
			if (mbWraithFinaleStarted) return;
			mbWraithFinaleStarted = true;
			cLux_AddDebugMessage("[Map] Wraith finale");
			Seq_WraithFinale("");
		}
		
		cSequenceStatesData mSequenceWraithFinale;
		void Seq_WraithFinale(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WraithFinale", mSequenceWraithFinale);
			if (Sequence_DoStepAndWait(0))
			{
				Map_AddTimer("Timer_CheckWraithFinaleDistance", 0, "OnTimer_CheckWraithFinaleDistance");
				Map_RemoveTimer("Timer_ShowAmuletGuideHint");
				SetWraithSoundsActive(false);
			}
			else if (Sequence_DoStepAndWait(0.2))
			{
				Entity_SetActive("WraithFinale", true);
//				Wraith_SetVolumeMul("WraithFinale", 0, true);
				Wraith_SetCoverage("WraithFinale", 0, -1, false);
				Wraith_SetCallback_BeamCenterSeen("WraithFinale", "OnBeamCenterSeen_WraithFinale");
				Wraith_SetFearFromBeam("WraithFinale", true);
				FearThreatAgent_SetActivationDistance("WraithFinale", 200);
				FearThreatAgent_SetDeactivationDistance("WraithFinale", 400);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Wraith_SetSpotlightOn("WraithFinale", true);
				Wraith_TurnSpotlightToPos("WraithFinale", Map_GetEntity("Target_WraithFinale_LookAt_1").GetPosition(), true, true, 0.5f);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				FearHandler_SetForcedAddFearRate(0.4, 3, false, 1, 0.05, 0.5);
				Sound_CreateAtEntity("WraithScream", "creatures/vocalisations/creature/wraith/distant_ledge", "WraithFinale", 0, false, 1, 30, 60);
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				Wraith_TurnSpotlightToPos("WraithFinale", Map_GetEntity("Target_WraithFinale_LookAt_2").GetPosition(), true, true, 0.5f);
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				Wraith_TurnSpotlightToPos("WraithFinale", Map_GetEntity("Target_WraithFinale_LookAt_1").GetPosition(), true, true, 0.5f);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Wraith_SetSpotlightOn("WraithFinale", false);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Map_RemoveTimer("Timer_CheckWraithFinaleDistance");
				Entity_SetActive("WraithFinale", false);
			}
			Sequence_End();
		}
		
		void OnBeamCenterSeen_WraithFinale(const tString &in asEntityName, int alState)
		{
			Voice_Play("Dialogue_SeeWraithLightOverCrowd");
			Map_AddTimer("Timer_WraithFinaleStinger", 0.5, "OnTimer_WraithFinaleStinger");
		}
		
		void OnTimer_WraithFinaleStinger(const tString &in asTimer)
		{
			Music_Play("A2_1_4_MistLurkerStinger", 0.8, false, eMusicPrio_BigEvent);
		}
		
		void OnTimer_CheckWraithFinaleDistance(const tString &in asTimer)
		{
			if (Player_GetDistanceToEntity("WraithFinale") <= 15.0f)
			{
				cLux_AddDebugMessage("[Map] Finale cancelled");
				Entity_SetActive("WraithFinale", false);
				SequenceStates_Stop("Seq_WraithFinale");
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.4));
		}
		
		cSequenceStatesData mSequenceWraithRuinsFinaleDirector;
		void Seq_WraithRuinsFinaleDirector(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WraithRuinsFinaleDirector", mSequenceWraithRuinsFinaleDirector);
			if (Sequence_DoStepAndWait(0.5))
			{
				Seq_WraithRuinsFinale4("");
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Seq_WraithRuinsFinale3("");
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Sound_CreateAtEntity("WraithSound", "creatures/vocalisations/creature/wraith/Distant_calls", "WraithRuins_5_1", 0, false, 1, 35, 70);
//				
				
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Music_Play("A2_1_4_Wraith_Appear.ogg", 0.5f, true, eMusicPrio_BigEvent);
				FearHandler_SetForcedAddFearRate(0.3f, 9999, false, -1, -1, 0.5);
//				Hint_ShowHint_Hold("Hints", "HintSneak", true);
			}
			else if (Sequence_DoStepAndWait(6.0))
			{
				Seq_WraithRuinsFinale2("");
			}
			else if (Sequence_DoStepAndPause(2.0))
			{
				Seq_WraithRuinsFinale1("");
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Music_Play("A2_1_4_Wraith_Hunt.ogg", 0.4f, true, eMusicPrio_BigEvent);
				
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("WraithRuinsFinale_1", 0.8, 0.1, 0.02, "player", true, true);
				FearHandler_SetForcedAddFearRate(0.3f, 9999, false, -1, -1, 0.5);
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Sound_CreateAtEntityCustom("WraithAlert_4", "creatures/vocalisations/creature/wraith/wraith_short_alert", "WraithRuinsFinale_4", 100, 40);
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("WraithRuinsFinale_4", 0.5, 0.1, 0.02, "player", true, true);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Sound_CreateAtEntityCustom("WraithAlert_3", "creatures/vocalisations/creature/wraith/wraith_ attack", "WraithRuinsFinale_3", 100, 40);
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("WraithRuinsFinale_3", 0.8, 0.1, 0.02, "player", true, true);
			}
			else if (Sequence_DoStepAndWait(4.0))
			{
				Sound_CreateAtEntityCustom("WraithAlert_2", "creatures/vocalisations/creature/wraith/wraith_idle", "WraithRuinsFinale_2", 100, 40);
				Wraith_SetSpotlightMovement_SidewaysEightAtEntity("WraithRuinsFinale_2", 0.8, 0.1, 0.02, "player", true, true);
			}
			else if (Sequence_DoStepAndWait(2.5))
			{
				Wraith_StopSpotlightMovement("WraithRuinsFinale_2");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Wraith_StopSpotlightMovement("WraithRuinsFinale_3");
			}
			else if (Sequence_DoStepAndWait(3.0))
			{
				Wraith_StopSpotlightMovement("WraithRuinsFinale_4");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Seq_WraithRuinsFinale22("");
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Seq_WraithRuinsFinale12("");
			}
			else if (Sequence_DoStepAndWait(0.75))
			{
				Seq_WraithRuinsFinale32("");
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Seq_WraithRuinsFinale42("");
				FearHandler_SetForcedAddFearRate(0.3f, 0, false, -1, 0.1, 0.5);
			}
			Sequence_End();
		}
		
