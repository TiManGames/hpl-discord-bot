		bool OnCollide_Player_StartWraithRuins5(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (StartWraithSighting() == false) return true;
			
			cLux_AddDebugMessage("[Map] StartWraithRuins5");
			
			Entity_SetActive("Trigger_StartWraithRuins5_*", false);
			
			Map_AddTimer("Timer_WraithRuins5_1_Start", 0.0, "OnTimer_WraithRuins5_1_Start");
			Map_AddTimer("Timer_WraithRuins5_2_Start", 3.0, "OnTimer_WraithRuins5_2_Start");
			Map_AddTimer("Timer_WraithRuins5_3_Start", 6.0, "OnTimer_WraithRuins5_3_Start");
			
			Map_AddTimer("Timer_WraithRuins5_1_Sound", 8.0, "OnTimer_WraithRuins5_1_Sound");
			
			Map_AddTimer("WraithRuins_5_1", 0.0, "OnTimer_WraithRuins5_CheckDistance");
			Map_AddTimer("WraithRuins_5_2", 0.1, "OnTimer_WraithRuins5_CheckDistance");
			Map_AddTimer("WraithRuins_5_3", 0.2, "OnTimer_WraithRuins5_CheckDistance");
						
//			Entity_SetActive("WraithRuins_5_2", true);
//			Entity_SetActive("WraithRuins_5_3", true);
			return false;
		}
		
		void OnTimer_WraithRuins5_CheckDistance(const tString &in asTimer)
		{
			if (Player_GetDistanceToEntity(asTimer) <= 25)
			{
				Wraith_CommandDisappear_Execute(asTimer, true, true);
				return;
			}
			else if (Player_GetDistanceToEntity(asTimer) <= 40)
			{
				CharMover_SetSpeedMul(asTimer, 2);
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.1, 0.4));
		}
		
