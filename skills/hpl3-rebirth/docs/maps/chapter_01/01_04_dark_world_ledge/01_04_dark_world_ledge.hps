	float mfAmuletLightFogReduction = 0.1f;
	float mfAmuletThickFogReduction = 0.1f;
	float mfAmuletFogReduction = 0.20;
	cVector2f mvFogFearRateAreaUpdateRange = cVector2f(0.4f, 0.8f);
	
	float mfLightFogFearRateDefault = 0.0f;
	float mfThickFogFearRateDefault = 0.2f;
	
	tString msLightFogArea = "";
	tString msThickFogArea = "";
	int mlLightFogAreaCount = 0;
	int mlThickFogAreaCount = 0;
	
	//-------------------------------------------------------
	
	void OnTimer_UpdateFearRateAreas(const tString &in asTimer)
	{
		float fLightFogRate = mfLightFogFearRateDefault;
		if (Amulet_IsHeld() && mlLightFogAreaCount > 0) fLightFogRate = cMath_Clamp(fLightFogRate - mfAmuletFogReduction, 0.0f, 1.0f);
		FearRateArea_SetFearRate(msLightFogArea, fLightFogRate);
		
		float fThickFogRate = mfThickFogFearRateDefault;
		if (Amulet_IsHeld() && mlThickFogAreaCount > 0) fThickFogRate = cMath_Clamp(fThickFogRate - mfAmuletFogReduction, 0.0f, 1.0f);
		FearRateArea_SetFearRate(msThickFogArea, fThickFogRate);
		
		Map_AddTimer("Timer_UpdateFearRateAreas", cMath_RandRectf(mvFogFearRateAreaUpdateRange.x, mvFogFearRateAreaUpdateRange.y), "OnTimer_UpdateFearRateAreas");
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_LightFog(const tString &in asParent, const tString &in asChild, int alState)
	{
		mlLightFogAreaCount += alState;
		msLightFogArea = alState == 1 ? asParent : "";
		
//		float fLightFogRate = mfLightFogFearRateDefault;
//		if (Amulet_IsHeld() && mlLightFogAreaCount > 0) fLightFogRate -= mfAmuletLightFogReduction;
//		FearRateArea_SetFearRate(msLightFogArea, fLightFogRate);
		
		return true;
	}

	//-------------------------------------------------------
	
	bool OnCollide_Player_ThickFog(const tString &in asParent, const tString &in asChild, int alState)
	{
		mlThickFogAreaCount += alState;
		msThickFogArea = alState == 1 ? asParent : "";
		
		if (alState == 1) DarkWorldWhispers_Play(3);
		else DarkWorldWhispers_Stop();
		
//		float fThickFogRate = mfThickFogFearRateDefault;
//		if (Amulet_IsHeld() && mlThickFogAreaCount > 0) fThickFogRate -= mfAmuletThickFogReduction;
//		FearRateArea_SetFearRate(msThickFogArea, fThickFogRate);
				
		return true;
	}
	
