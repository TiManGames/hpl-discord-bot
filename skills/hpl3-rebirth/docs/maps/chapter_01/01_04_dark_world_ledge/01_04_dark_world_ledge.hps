		tString msSound_RampSlideLoop = "01_04_dark_world_ledge/level_events/tasi_slide";
		tString msSound_RampSlideEnd = "01_04_dark_world_ledge/level_events/tasi_slide_end";
		float mfRampSlide_DefaultSlopeLimit = 0.0f;
		bool mbRampSlideAmuletHeld = false;

		//-------------------------------------------------------
		
		bool OnCollide_HerbertArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_PlayHerbertPlateauMusic", 1.0f, "OnTimer_PlayHerbertPlateauMusic");
			return false;
		}

		//-------------------------------------------------------
		
		void OnTimer_PlayHerbertPlateauMusic(const tString &in asTimer)
		{
			Music_PlayExt("A2_1_4_Herberts_Camp.ogg", true, 0.5f, 1.0f, 5.0f, 0.0f, eMusicPrio_BgAmb, true);
		}
		
		//-------------------------------------------------------
		
		int mlRampSlideRumble = -1;
		bool OnCollide_Player_RampSlide(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbRampSlideAmuletHeld = Item_GetHeldType(eItemHandlerHand_Right) == "CurseMedallion";
			Voice_Play("Dialogue_Slope");
			Effect_Rumble_Start(0.8, 6.5, 0.5, 0.2);
			Sound_CreateAtEntity("Sound_DreamSlide", "level_dreams/anim/ledge_slide", "player");
			PlayerBody_PlayCutsceneAtEntity("slides_down_the_slope", "Target_SlideDownSlopeAnim", false, 0.5, "OnAnimEnd_AfterSlideDialogue");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_AfterSlideDialogue(const tString &in asAnimName)
		{
			if (mbRampSlideAmuletHeld) Item_TakeOut(ItemType_GetFirstInInventory("CurseMedallion"));
			Voice_Play("Dialogue_SlopeEnd");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SetSlopeLimit(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mfRampSlide_DefaultSlopeLimit = cLux_GetPlayer().GetCharacterBody().GetMaxNoSlideSlopeAngle();
				cLux_GetPlayer().GetCharacterBody().SetMaxNoSlideSlopeAngle(0.04f);
			}
			else
			{
				cLux_GetPlayer().GetCharacterBody().SetMaxNoSlideSlopeAngle(mfRampSlide_DefaultSlopeLimit);
			}
			return true;
		}
		
