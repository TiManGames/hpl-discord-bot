		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterRuins(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_Play("A2_1_4_AncientRuins", 0.4f, true, eMusicPrio_BgAmb);
			Voice_PlayDelayed("Dialogue_LeaveRealWorldRift", 1);
			Map_AddTimer("Timer_WraithSound", 4.0f, "OnTimer_WraithSound");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_TrackRuinsRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("[Map] Track ruins rift");
			Amulet_StartTracking(true, "RuinsRift");
			
			Entity_SetActive("Trigger_CloseEntranceNormalRift", false);
			
			Map_AddTimer("Timer_ShowAmuletGuideHint", 60.f * 10.f, "OnTimer_ShowAmuletGuideHint");
			return false;
		}
		
		bool OnCollide_Player_TrackRuinsRift2(const tString &in asParent, const tString &in asChild, int alState)
		{
			Amulet_StartTracking(false, "RuinsRift");
			return true;
		}
		
		//-------------------------------------------------------
		
		void SetWraithSoundsActive(bool abX)
		{
			if (abX)
			{
				Map_RemoveTimer("Timer_WraithSound");
				Map_AddTimer("Timer_WraithSound", cMath_RandRectf(10, 30), "OnTimer_WraithSound");
			}
			else
			{
				Map_RemoveTimer("Timer_WraithSound");
			}
		}
		
		bool mbFirstWraithReaction = false;
		void OnTimer_WraithSound(const tString &in asTimer)
		{
			cLux_AddDebugMessage("[Map] Wraith sound");
			if (mbFirstWraithReaction == false)
			{
				mbFirstWraithReaction = true;
				Sound_CreateAtEntity("FirstWraithSound", "creatures/vocalisations/creature/wraith/distant_ledge", "Target_FirstWraithSound");
				Voice_PlayDelayed("Dialogue_HearWraith", 2.5);
				FearHandler_SetForcedAddFearRate(0.6, 3, false, 1.0, 0.05);
			}
			else
			{
				Sound_CreateAtEntity("WraithSoundDistant", "creatures/vocalisations/creature/wraith/distant_call_random", "player");
			}			
			Map_AddTimer("Timer_WraithSound", cMath_RandRectf(10, 30), "OnTimer_WraithSound");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_GivePeekHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			Hint_ShowHint("Hints","HintSneak", true, 1.4f, false);
			return false;
		}

		//------------------------------------------------------- 
		
		bool mbWraithRuins1_Stopped = false;
		
		bool OnCollide_Player_StartWraithRuins1(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("WraithRuins_1", true);
			Wraith_SetCoverage("WraithRuins_1", 0.2, -1, false);
			Wraith_SetSpotlightOn("WraithRuins_1", true);
			Wraith_SetFly("WraithRuins_1", true);
			Wraith_SetSpotlightSoundVolumeMul("WraithRuins_1", 0.2);
			Wraith_SetFearFromBeam("WraithRuins_1", true);
			
			Wraith_SetCallback_BeamSeen("WraithRuins_1", "OnBeamSeen_WraithRuins1", 1.5, true);
			Wraith_SetCallback_BeamCenterSeen("WraithRuins_1", "OnBeamCenterSeen_WraithRuins1", 0.5, true);
			
			FearThreatAgent_SetActivationDistance("WraithRuins_1", 200);
			FearThreatAgent_SetDeactivationDistance("WraithRuins_1", 400);
			
			Entity_SetActive("Trigger_LookAtWraithRuins1", true);
			
			Map_AddTimer("Timer_WraithRuins1_LookAround", 0.2f, "OnTimer_WraithRuins1_LookAround");
			Map_AddTimer("Timer_StopWraithRuins1", 10.0f, "OnTimer_StopWraithRuins1");
						
			SetWraithSoundsActive(false);
			
			return false;
			
			
			
		}
		
		void OnBeamCenterSeen_WraithRuins1(const tString &in asEntityName, int alState)
		{
			Voice_Play("Dialogue_SeeWraithLight");
		}
		
		void OnBeamSeen_WraithRuins1(const tString &in asEntityName, int alState)
		{
			Sound_CreateAtEntity("Sound_WraithStinger1", "creatures/vocalisations/creature/wraith/Distant_calls", "player", 0, false, 1, 25, 55);
			Map_AddTimer("Timer_StopWraithRuins1", 4.0f, "OnTimer_StopWraithRuins1");
		}
		
		void OnTimer_WraithRuins1_LookAround(const tString &in asTimer)
		{
			Wraith_SetSpotlightMovement_SidewaysEightAtEntity("WraithRuins_1", 0.35, 0.5, 0.1, "Target_WraithRuins1_LookAt_1", true, true);
		}
		
		void OnTimer_StopWraithRuins1(const tString &in asTimer)
		{
			if (mbWraithRuins1_Stopped) return;
			mbWraithRuins1_Stopped = true;
			Wraith_TurnSpotlightToPos("WraithRuins_1", Map_GetEntity("Target_WraithRuins1_MoveTo_1").GetPosition(), true, true, 1.5f);
			CharMover_TurnToEntity("WraithRuins_1", "Target_WraithRuins1_MoveTo_1");
			Map_AddTimer("Timer_WraithRuins1_MoveAway", 3.0f, "OnTimer_WraithRuins1_MoveAway");
		}
		
		bool OnCollide_Player_StopWraithRuins1(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbWraithRuins1_Stopped = true;
			Wraith_TurnSpotlightToPos("WraithRuins_1", Map_GetEntity("Target_WraithRuins1_MoveTo_1").GetPosition(), true, true, 5.0f);
			Map_AddTimer("Timer_WraithRuins1_Disappear", 2.0, "OnTimer_WraithRuins1_Disappear");
			return false;
		}
		
		void OnTimer_WraithRuins1_Disappear(const tString &in asTimer)
		{
			Wraith_CommandDisappear_Execute("WraithRuins_1", true, true);
		}
		
		void OnTimer_WraithRuins1_MoveAway(const tString &in asTimer)
		{
			Wraith_SetSpotlightMovement_ForwardOffset("WraithRuins_1", 0, 0, true);
			Pathfinder_MoveToEntity("WraithRuins_1", "Target_WraithRuins1_MoveTo_1", "OnMoveEnd_DeactivateWraithRuins1");
			SetWraithSoundsActive(true);
		}
		
		void OnMoveEnd_DeactivateWraithRuins1(const tString& in asEntityName, bool abReachedEnd)
		{
			Wraith_CommandDisappear_Execute("WraithRuins_1", true, true);
		}
		
		//-------------------------------------------------------
		
		bool mbWraithRuins2_LookAt = false;
		bool mbWraithRuins2_Stopped = false;

		bool OnCollide_Player_StartWraithRuins2(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (StartWraithSighting() == false) return true;
			
			cLux_AddDebugMessage("[Map] StartWraithRuins2");
			
			SetPermaFailStage(eDarkWorldLegePermafailStage_Wraiths);
			
			Entity_SetActive("Trigger_StopWraithRuins2_*", true);
			
			Entity_SetActive("WraithRuins_2_1", true);
			Wraith_SetCoverage("WraithRuins_2_1", 0.2, -1, false);
			Wraith_SetSpotlightOn("WraithRuins_2_1", true);
			Wraith_SetFly("WraithRuins_2_1", true);
			Wraith_SetSpotlightSoundVolumeMul("WraithRuins_2_1", 0.2);
			Wraith_SetCallback_BeamSeen("WraithRuins_2_1", "OnBeamSeen_WraithRuins2_1");
			Wraith_SetFearFromBeam("WraithRuins_2_1", true);
			FearThreatAgent_SetActivationDistance("WraithRuins_2_1", 200);
			FearThreatAgent_SetDeactivationDistance("WraithRuins_2_1", 400);
			
			Entity_SetActive("WraithRuins_2_2", true);
			Wraith_SetCoverage("WraithRuins_2_2", 0.2, -1, false);
			Wraith_SetSpotlightOn("WraithRuins_2_2", true);
			Wraith_SetSpotlightSoundVolumeMul("WraithRuins_2_2", 0.2);
			Wraith_SetCallback_BeamSeen("WraithRuins_2_2", "OnBeamSeen_WraithRuins2_2");
			Wraith_SetFearFromBeam("WraithRuins_2_2", true);
			FearThreatAgent_SetActivationDistance("WraithRuins_2_2", 200);
			FearThreatAgent_SetDeactivationDistance("WraithRuins_2_2", 400);
			
			Map_AddTimer("Timer_WraithRuins2_LookAt", 0.2f, "OnTimer_WraithRuins2_LookAt");
			
			Sound_CreateAtEntity("Sound_WraithStinger2", "creatures/vocalisations/creature/wraith/Distant_calls", "player");
			
			Map_AddTimer("Timer_WraithRuins2_1_Disappear", 8.0f, "OnTimer_WraithRuins2_1_Disappear");
			Map_AddTimer("Timer_WraithRuins2_2_Disappear", 8.0f, "OnTimer_WraithRuins2_2_Disappear");			
			return false;
		}
		
		void OnTimer_WraithRuins2_LookAt(const tString &in asTimer)
		{
			Wraith_SetSpotlightMovement_SidewaysEightAtEntity("WraithRuins_2_1", 0.4, 0.3, 0.1, "Target_WraithRuins2_LookAt_1", false, true);
			Wraith_SetSpotlightMovement_SidewaysEightAtEntity("WraithRuins_2_2", 0.4, 0.3, 0.1, "Target_WraithRuins2_LookAt_2", false, true);
		}
		
		void OnBeamSeen_WraithRuins2_1(const tString &in asEntityName, int alState)
		{
			Map_AddTimer("Timer_WraithRuins2_1_Disappear", 5.0f, "OnTimer_WraithRuins2_1_Disappear");
			Map_AddTimer("Timer_WraithRuins2_2_Disappear", 2.0f, "OnTimer_WraithRuins2_2_Disappear");
		}
		
		bool OnColide_Player_StopWraithRuins2_2(const tString &in asParent, const tString &in asChild, int alState)
		{
			EnableWraithSightings(6);
			
			Entity_SetActive("Trigger_StopWraithRuins2_*", false);
			Entity_SetVarBool("WraithRuins_2_2", "Disappear", true);
			Wraith_TurnSpotlightToPos("WraithRuins_2_2", Map_GetEntity("Target_WraithRuins2_MoveTo_2").GetPosition(), true, true, 4);
			Map_AddTimer("WraithRuins_2_2", 1.0f, "OnTimer_DeactivateEntity");
			return false;
		}
		
		void OnBeamSeen_WraithRuins2_2(const tString &in asEntityName, int alState)
		{
			Map_AddTimer("Timer_WraithRuins2_2_Disappear", 5.0f, "OnTimer_WraithRuins2_2_Disappear");
			Map_AddTimer("Timer_WraithRuins2_1_Disappear", 2.0f, "OnTimer_WraithRuins2_1_Disappear");
		}
		
		bool OnColide_Player_StopWraithRuins2_1(const tString &in asParent, const tString &in asChild, int alState)
		{
			EnableWraithSightings(6);
			
			Entity_SetActive("Trigger_StopWraithRuins2_*", false);
			Entity_SetVarBool("WraithRuins_2_1", "Disappear", true);
			Wraith_TurnSpotlightToPos("WraithRuins_2_1", Map_GetEntity("Target_WraithRuins2_MoveTo_1").GetPosition(), true, true, 4);
			Map_AddTimer("WraithRuins_2_1", 1.0f, "OnTimer_DeactivateEntity");
			return false;
		}
		
		void OnTimer_WraithRuins2_1_Disappear(const tString &in asTimer)
		{
			if (Entity_GetVarBool("WraithRuins_2_1", "Disappear")) return;
			cLux_AddDebugMessage("[Map] WraithRuins2 Disappear1");
			
			EnableWraithSightings(6);
			
			Entity_SetVarBool("WraithRuins_2_1", "Disappear", true);
			Wraith_SetSpotlightMovement_Forward("WraithRuins_2_1", true);
			Pathfinder_MoveToEntity("WraithRuins_2_1", "Target_WraithRuins2_MoveTo_1", "");
			Map_AddTimer("WraithRuins_2_1", 4.0f, "OnTimer_DeactivateEntity");			
		}
		
		void OnTimer_WraithRuins2_2_Disappear(const tString &in asTimer)
		{
			if (Entity_GetVarBool("WraithRuins_2_2", "Disappear")) return;
			cLux_AddDebugMessage("[Map] WraithRuins2 Disappear2");
			
			EnableWraithSightings(6);
			
			Entity_SetVarBool("WraithRuins_2_2", "Disappear", true);
			Wraith_SetSpotlightMovement_Forward("WraithRuins_2_2", true);
			Pathfinder_MoveToEntity("WraithRuins_2_2", "Target_WraithRuins2_MoveTo_2", "");
			Map_AddTimer("WraithRuins_2_2", 4.0f, "OnTimer_DeactivateEntity");			
		}
		
		//-------------------------------------------------------
		
		cVector3f mvStartWraithRuins3_Pos;
		bool OnCollide_Player_StartWraithRuins3(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mvStartWraithRuins3_Pos = Player_GetPosition();
			}
			else if (alState == -1)
			{
				cVector3f vDir = Player_GetPosition() - mvStartWraithRuins3_Pos;
				float fDot = cMath_Vector3Dot(cMath_Vector3Normalize(vDir), Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward());
				if (fDot >= 0)
				{
					if (StartWraithSighting() == false) return true;
					
					Entity_SetActive("WraithRuins_3", true);
					Wraith_SetCoverage("WraithRuins_3", 0.2, -1, false);
					Wraith_SetSpotlightOn("WraithRuins_3", true);
					Wraith_SetFly("WraithRuins_3", true);
					CharMover_SetWallAvoidanceActive("WraithRuins_3", false);
					Map_AddTimer("OnTimer_WraithRuins3_MoveTo_1", 0.2, "OnTimer_WraithRuins3_MoveTo_1");
					Map_AddTimer("Timer_WraithRuins3_CheckDistance", 0.2, "OnTimer_WraithRuins3_CheckDistance");
					
					return false;
				}
			}
			return true;
		}
		
		void OnTimer_WraithRuins3_CheckDistance(const tString &in asTimer)
		{
			if (Player_GetDistanceToEntity("WraithRuins_3") <= 50)
			{
				CharMover_SetSpeedMul("WraithRuins_3", 2.0);
			}
			else
			{
				Map_RestartCurrentTimer(cMath_RandRectf(0.1, 0.4));
			}
		}
		
		void OnTimer_WraithRuins3_MoveTo_1(const tString &in asTimer)
		{
			Pathfinder_MoveToEntity("WraithRuins_3", "Target_WraithRuins3_MoveTo_1", "OnMoveEnd_WraithRuins3_MoveTo_2");
