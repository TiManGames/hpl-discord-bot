		bool mbHerbert_SeenBodyBeforeNote = false;
		bool mbHerbert_FearAdded = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_HerbertDialogue(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				FearHandler_SetForcedAddFearRate(0.3, 2.0f, false, -1, 0.05);
				if (mbHerbert_MusicPlayed == false)
				{
					mbHerbert_MusicPlayed = true;
					Music_Play("A2_1_4_Herberts_Corpse.ogg", 0.4f, false, eMusicPrio_BigEvent);
				}
				Voice_Play("Herberts_Body");
				mbHerbert_SeenBodyBeforeNote = true;
			}
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_HerbertDialogue2(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				FearHandler_SetForcedAddFearRate(0.3, 2.0f, false, -1, 0.05);
				if (mbHerbert_SeenBodyBeforeNote) Voice_Play("Herberts_BodySeenNote");
				else Voice_Play("Herberts_BodyNewSeenNote");
			}
		}
		
