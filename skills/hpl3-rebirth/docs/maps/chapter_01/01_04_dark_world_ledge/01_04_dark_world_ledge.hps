		//-------------------------------------------------------
		
		bool OnCollide_Player_StartWraithRuins8(const tString &in asParent, const tString &in asChild, int alState)
		{
			iLuxEntity@ pTrigger = Map_GetEntity(asParent);
			if (alState == 1)
			{
				pTrigger.SetVarVector3f("PlayerPos", Player_GetPosition());
			}
			else
			{
				cVector3f vOldPos = pTrigger.GetVarVector3f("PlayerPos");
				cVector3f vDir = Player_GetPosition() - vOldPos;
				vDir.Normalize();
				float fDot = cMath_Vector3Dot(vDir, pTrigger.GetMatrix().GetTranspose().GetForward());
				if (fDot > 0)
				{
					cLux_AddDebugMessage("[Map] StartWraithRuins 8");
					
					Entity_SetActive("WraithRuins_8", true);
					Wraith_SetCoverage("WraithRuins_8", 0.2, -1, false);
					Wraith_SetSpotlightOn("WraithRuins_8", true);
					Wraith_SetFly("WraithRuins_8", true);
					Wraith_SetCallback_BeamCenterSeen("WraithRuins_8", "OnBeamCenterSeen_WraithRuins8");
					CharMover_SetWallAvoidanceActive("WraithRuins_8", false);
					
					Map_AddTimer("Timer_WraithRuins8_MoveTo1", 0.2, "OnTimer_WraithRuins8_MoveTo1");					
					return false;
				}
			}
			return true;
		}
		
		void OnBeamCenterSeen_WraithRuins8(const tString &in asEntityName, int alState)
		{
			Voice_Play("Dialogue_SeeWraithLight");
		}
		
