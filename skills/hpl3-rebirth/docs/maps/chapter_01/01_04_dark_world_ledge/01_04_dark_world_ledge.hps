		//-------------------------------------------------------
		
		void OnRiftStage_Cave2(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			if (alStage == 4 && abOpening)
			{
				Map_RemoveTimer("Timer_CheckCaveAmuletHint");
				
				Prop_SetActiveAndFade("RiftCave2_Open*", true, 1.0);
				Prop_SetActiveAndFade("RiftCave2_Closed*", false, 1.0);
				Light_FadeBrightnessToDefault("Light_Open_Rift_Cave_2_*", 2.0);
				Light_FadeBrightnessTo("Light_Closed_Rift_Cave_2_*", 0, 0.5);
				
				//Sound_CreateAtEntity("Sound_PortalOpen", "level_entity_shared/portal/portal_open", "Rift_Cave_2");
				//Sound_CreateAtEntity("Sound_PortalLoop", "level_entity_shared/portal/portal_open_loop", "Rift_Cave_2");
				
				Voice_PlayDelayed("Dialogue_OpenFirstRift", 1.0f);
				
				Map_AddTimer("Timer_EnableRocks_Cave2", 0.1, "OnTimer_EnableRocks_Cave2");
			}
			else if (alStage == 3 && abOpening == false)
			{
				Prop_SetActiveAndFade("RiftCave2_Open*", false, 1.0);
				Prop_SetActiveAndFade("RiftCave2_Closed*", true, 1.0);
				Light_FadeBrightnessTo("Light_Open_Rift_Cave_2_*", 0, 0.5);
				Light_FadeBrightnessToDefault("Light_Closed_Rift_Cave_2_*", 2.0);
				
				//Sound_CreateAtEntity("Sound_PortalClose", "level_entity_shared/portal/portal_open", "Rift_Cave_2");
				Sound_Stop("Sound_PortalLoop", 1.0);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableRocks_Cave2(const tString &in asTimer)
		{
			array<iLuxEntity@> vEnts;
			Map_GetEntityArray("rift_rock_fall_RiftCave2_**", vEnts);
						
			for (int i = 0; i < vEnts.size(); ++i)
			{
				iLuxEntity@ pEnt = vEnts[i];
				Map_AddTimer(pEnt.GetName(), cMath_RandRectf(0, 1.5), "OnTimer_EnableRiftRock");
			}
		}
		
		//-------------------------------------------------------

		//} END Event A *Enter the chamber and see the exit*

		/////////////////////////////////////////
		// Event B *Get a hint for lowering the amulet*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_LowerAmuletHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (Item_GetHeldType(eItemHandlerHand_Right) == "CurseMedallion")
			{
				//Hint_ShowHint("Hints", "LowerAmulet", true);
				return false;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Get a hint for lowering the amulet*
		
		/////////////////////////////////////////
		// Event B *Experience various effects while transitioning between worlds*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbBaseCATransition = false;
		float mfBaseCAMaxAmount = 0.012f;
		float mfBaseCATransitionFrom = 0.0f;
		float mfBaseCATransitionTo = 0.0f;
		float mfBaseCACurrentAmount = 0.0f;
		float mfBaseCATimer = 0.0f;
		float mfBaseCATime = 4.0f;
		int mfBaseCAInstance = 0;
		
		bool mbTunnelClosed = false;
		
		array<tID> mvDarkWorldFogAreas;
		array<float> mvDarkWorldFogAlphas;
		cColor mLevelFogColor;
		cColor mSecondaryLevelFogColor;
		int mlFogFadeAreas = 0;
		bool mbDarkWorldFogFading = false;
		float mfDarkWorldFogAlpha = 1;
		float mfDarkWorldFog_FadeSpeed = -1;
		float mfDarkWorldFog_FadeTarget = -1;
		
		bool mbPassedThroughRift = false;

		//-------------------------------------------------------
		
		void UpdateTransitionEffects(float afTimeStep)
		{
			if (mbBaseCATransition == false) return;
			
			mfBaseCATimer += afTimeStep;
			float fT = cMath_Clamp(mfBaseCATimer / mfBaseCATime, 0.0f, 1.0f);
			mfBaseCACurrentAmount = cMath_Easing(eEasing_QuadInOut, fT, mfBaseCATransitionFrom, mfBaseCATransitionTo);
			Effect_ChromaticAberration_SetInstanceValues(mfBaseCAInstance, mfBaseCACurrentAmount, 0.5f);
			if (mfBaseCATimer >= mfBaseCATime)
			{
				mfBaseCATimer = 0.0f;
				mbBaseCATransition = false;
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_CloseDarkWorldRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbPassedThroughRift = true;
			
//			Entity_SetActive("Rift_Ledge", false);
			Entity_SetActive("Rift_Cave_1", false);
			Entity_SetActive("Rift_Cave_2", false);
			
			Map_AddTimer("Timer_CloseLedgeRift ", 1.5, "OnTimer_CloseLedgeRift");
			
			Music_Stop(2.0f, eMusicPrio_MinorEvent);
			Music_PlayExt("A2_1_4_MistLurkerStalk.ogg", true, 0.25f, 1.0f, 5.0f, 1.0f, eMusicPrio_SceneAmb, false);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CloseLedgeRift(const tString &in asTimer)
		{			
//			OnRiftStage_LedgeRift("Rift_Ledge", 3, false, 0);

			Map_GetEntity("Trigger_RiftLedge_Bounds").SetPosition(cVector3f(0, -2000, 0));
			Prop_SetActiveAndFade("RiftLedge_AfterDrop*", true, 0.5);
			
			Light_FadeBrightnessTo("Light_rift_rock_RiftLedge*", 0, 0.5);
			Light_FadeBrightnessTo("Light_Rift_LedgeDrop_*", 0, 0.5);
		}
		
		//-------------------------------------------------------
		
		void OnRiftStage_LedgeRift(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			if (alStage == 4 && abOpening)
			{	
				Map_RemoveTimer("Timer_CheckCaveAmuletHint");
				
				Prop_SetActiveAndFade("RiftLedge_Open*", true, 1.0);
				Prop_SetActiveAndFade("RiftLedge_Closed*", false, 1.0);
				Light_FadeBrightnessToDefault("Light_Open_RiftLedge_*", 0.5);
				Light_FadeBrightnessTo("Light_Closed_RiftLedge_*", 0, 0.5);
				
				Map_AddTimer("rift_rock_fall_RiftLedge_*", 0, "OnTimer_DropRiftRocks");
				Map_AddTimer("Timer_RemoveLedgeRiftBlockers*", 0.3, "OnTimer_RemoveLedgeRiftBlockers");
				
				Entity_SetActive("Blocker_RiftLedge*", true);
				
				Map_AddTimer("OnTimer_StartLedgeFall", 0.5, "OnTimer_StartLedgeFall");
				
				//Sound_CreateAtEntity("Sound_PortalOpen", "level_entity_shared/portal/portal_open", "Rift_Ledge");
				//Sound_CreateAtEntity("Sound_PortalLoop", "level_entity_shared/portal/portal_open_loop", "Rift_Ledge");
				
				Voice_PlayDelayed("Dialogue_FallSecondRift", 0.3f);
				Music_Play("A2_1_4_MistLurkerStinger.ogg", 0.4f, false, eMusicPrio_MinorEvent);
			}
			else if (alStage == 3 && abOpening == false)
			{
				Prop_SetActiveAndFade("RiftLedge_Open*", false, 1.0);
				Prop_SetActiveAndFade("RiftLedge_Closed*", true, 1.0);
				Light_FadeBrightnessTo("Light_Open_RiftLedge_*", 0, 0.5);
				Light_FadeBrightnessToDefault("Light_Closed_RiftLedge_*", 0.5);
				
				//Sound_CreateAtEntity("Sound_PortalClose", "level_entity_shared/portal/portal_open", "Rift_Ledge");
				Sound_Stop("Sound_PortalLoop", 1.0);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartLedgeFall(const tString &in asTimer)
		{
			mfLedgeFallSpeed = 0;
			mbLedgeFall = true;
			mvLedgeFallCurrent = mvLedgeFallStart = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
			mvLedgeFallTarget = Map_GetEntity("Target_LedgeFall").GetPosition();
			Item_PutAway(eItemHandlerHand_Right);
			Player_SetFallDamageActive(false);
		}
		
		//-------------------------------------------------------
		
		bool mbLedgeRiftLandDetection = false;
		bool mbLedgeRiftGrounded = true;
		bool mbLedgeFall = false;
		cVector3f mvLedgeFallTarget;
		cVector3f mvLedgeFallStart;
		cVector3f mvLedgeFallCurrent;
		float mfLedgeFallSpeed = 0;
		void UpdateLedgeRift(float afTimeStep)
		{
			if (mbLedgeFall)
			{
				cVector3f vMoveDir = mvLedgeFallTarget - mvLedgeFallCurrent;
				float fDist = vMoveDir.Length();
												
				mfLedgeFallSpeed += 9.81f * afTimeStep;
				float fAdd = mfLedgeFallSpeed * afTimeStep;
				
				if (fAdd >= fDist)
				{
					fAdd = fDist;
					mbLedgeFall = false;
					
					mbLedgeRiftGrounded = false;
//					mbLedgeRiftLandDetection = true;
					Amulet_StopTracking();
					
					Player_GiveDamage(0.2, 0.6, eDamageType_FallBig, "");
					Effect_Rumble_Start(1, 1.5, 0, 1);
					PlayerBody_PlayCutsceneAnimation("fall_and_get_up_slow", false, 0.2f);
					Player_SetFallDamageActive(true);
				}
				
				mvLedgeFallCurrent += cMath_Vector3Normalize(vMoveDir) * fAdd;
				cLux_GetPlayer().GetCharacterBody().SetPosition(mvLedgeFallCurrent, false);
			}
			
			if (mbLedgeRiftLandDetection)
			{
				bool bGrounded = cLux_GetPlayer().GetCharacterBody().IsOnGround();
				if (bGrounded && mbLedgeRiftGrounded == false)
				{
					mbLedgeRiftLandDetection = false;
					cLux_AddDebugMessage("[Map] Reset fall distances");
					
					Player_GiveDamage(0.2, 0.6, eDamageType_FallBig, "");
					PlayerBody_PlayCutsceneAnimation("fall_and_get_up_slow", false, 0.5f);
					Player_SetFallDamageActive(true);
				}
				mbLedgeRiftGrounded = bGrounded;
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RemoveLedgeRiftBlockers(const tString &in asTimer)
		{
			Entity_SetActive("block_box_RiftLedge_*", false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_FogFadeIn(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlFogFadeAreas += alState;
			mbDarkWorldFogFading = mlFogFadeAreas > 0;
			return true;
		}
		
		//-------------------------------------------------------
		
		void InitDarkWorldFog()
		{
			array<tString> vFogAreas = { "FogArea_close_range", "FogArea_general", "FogArea_horizon_blend" };
			for (int i = 0; i < vFogAreas.size(); ++i)
			{
				cFogArea@ pFog = cLux_GetCurrentMap().GetWorld().GetFogArea(vFogAreas[i]);
				mvDarkWorldFogAreas.push_back(pFog.GetID());
				mvDarkWorldFogAlphas.push_back(pFog.GetColor().a);
			}
			
			mLevelFogColor = cLux_GetCurrentMap().GetWorld().GetFogColor();
			mSecondaryLevelFogColor = cLux_GetCurrentMap().GetWorld().GetSecondaryFogColor();
		}
		
		//-------------------------------------------------------
		
		void UpdateDarkWorldFog(float afTimeStep)
		{
			if (mbDarkWorldFogFading)
			{
				cLuxArea@ pArea = cLux_ID_Area(Map_GetEntity("Widget_StartFogFade").GetID());
				cVector3f vWidgetDir = pArea.GetMatrix().GetTranspose().GetForward();
				cVector3f vWidgetFrom = pArea.GetPosition() - vWidgetDir * pArea.GetSize().z * 0.5f;
				cVector3f vWidgetTo = pArea.GetPosition() + vWidgetDir * pArea.GetSize().z * 0.5f;
				cVector3f vPlayerVector = Player_GetPosition() - vWidgetFrom;
				cVector3f vWidgetVector = vWidgetTo - vWidgetFrom;
				
				float fDot = cMath_Vector3Dot(vPlayerVector, vWidgetVector) / (pArea.GetSize().z * pArea.GetSize().z);
				mfDarkWorldFogAlpha = cMath_IncreaseTo(mfDarkWorldFogAlpha, 0.25f * afTimeStep, cMath_Clamp(fDot, 0.0f, 1.0f));
				SetDarkWorldFogAlpha(mfDarkWorldFogAlpha);
				SetEnironmentalParticlesAlpha(mfDarkWorldFogAlpha);				
			}
			
			if (mfDarkWorldFog_FadeSpeed > 0)
			{
				mfDarkWorldFogAlpha = cMath_IncreaseTo(mfDarkWorldFogAlpha, mfDarkWorldFog_FadeSpeed * afTimeStep, mfDarkWorldFog_FadeTarget);
				SetDarkWorldFogAlpha(mfDarkWorldFogAlpha);
				SetEnironmentalParticlesAlpha(mfDarkWorldFogAlpha);
				if (mfDarkWorldFogAlpha == mfDarkWorldFog_FadeTarget)
				{
					mfDarkWorldFog_FadeSpeed = -1;
				}
			}			
		}
		
		//-------------------------------------------------------
		
		void FadeDarkWorldFog(float afAlpha, float afTime)
		{
			mfDarkWorldFog_FadeTarget = afAlpha;
			if (afTime <= 0)
			{
				mfDarkWorldFog_FadeSpeed = -1;
				SetDarkWorldFogAlpha(mfDarkWorldFog_FadeTarget);
				SetEnironmentalParticlesAlpha(mfDarkWorldFog_FadeTarget);
			}
			else
			{
				mfDarkWorldFog_FadeSpeed = 1.0f / afTime;
			}
		}
		
		//-------------------------------------------------------
		
		void SetDarkWorldFogAlpha(float afAlpha)
		{
			mfDarkWorldFogAlpha = afAlpha;
			for (int i = 0; i < mvDarkWorldFogAreas.size(); ++i)
			{
				cFogArea@ pFog = cLux_ID_FogArea(mvDarkWorldFogAreas[i]);
				cColor col = pFog.GetColor();
				col.a = mvDarkWorldFogAlphas[i] * afAlpha;
				pFog.SetColor(col);
			}
						
			cColor newLevelFogColor = mLevelFogColor;
			newLevelFogColor.a *= afAlpha;
			cLux_GetCurrentMap().GetWorld().SetFogColor(newLevelFogColor);
			
			cColor newSecondaryLevelFogColor = mSecondaryLevelFogColor;
			mSecondaryLevelFogColor.a *= afAlpha;
			cLux_GetCurrentMap().GetWorld().SetSecondaryFogColor(newLevelFogColor);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_ActivateBigVisArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbLedgeFall = false;
			Visibility_SetAreaActive("VisibilityArea_Outside*", true);
			return false;
		}
		
		//-------------------------------------------------------

		//} END Event B *Experience various effects while transitioning between worlds*
		
	 
	//} END SCENE 1
	
