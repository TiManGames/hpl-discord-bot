		//-------------------------------------------------------
		
		void SwitchCave(bool abFirstCave)
		{
			tString sDebug = "Switch cave setup: ";
			sDebug += abFirstCave ? "first cave" : "second cave";
			cLux_AddDebugMessage(sDebug);
			
			mbFirstCave = abFirstCave;
			if (mbFirstCave)
			{
				Entity_SetActive(msFirstCavePrefix, true);
				Entity_SetActive(msSecondCavePrefix, false);
				
				Billboard_SetVisible(msFirstCavePrefix, true);
				Billboard_SetVisible(msSecondCavePrefix, false);
				
				Entity_SetActive("Trigger_MemoryErskineClose", true);
				Entity_SetActive("Trigger_MemoryErskineFar", true);
			}
			else
			{
				Entity_SetActive(msFirstCavePrefix, false);
				Entity_SetActive(msSecondCavePrefix, true);
				
				Billboard_SetVisible(msFirstCavePrefix, false);
				Billboard_SetVisible(msSecondCavePrefix, true);
				
				Entity_SetActive("Trigger_MemoryErskineClose", false);
				Entity_SetActive("Trigger_MemoryErskineFar", false);
			}
			
			Entity_SetActive("transition_block_group_1_*", false);
			Entity_SetActive("ledge_wall_4", false);
			Entity_SetActive("Trigger_EnterReturnCave", !mbFirstCave);
		}
		
