		bool OnCollide_Player_StartWraithRuins4(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mvStartWraithRuins4_Pos = Player_GetPosition();
			}
			else if (alState == -1)
			{
				cVector3f vDir = Player_GetPosition() - mvStartWraithRuins4_Pos;
				float fDot = cMath_Vector3Dot(cMath_Vector3Normalize(vDir), Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward());
				if (fDot >= 0)
				{
					if (StartWraithSighting() == false) return true;
					
					Entity_SetActive("WraithRuins_4", true);
					Wraith_SetCoverage("WraithRuins_4", 0.2, -1, false);
					Wraith_SetSpotlightOn("WraithRuins_4", true);
					Wraith_SetFly("WraithRuins_4", true);
					CharMover_SetWallAvoidanceActive("WraithRuins_4", false);
					CharMover_SetSpeedMul("WraithRuins_4", 2);
					Map_AddTimer("Timer_WraithRuins4_MoveTo_1", 0.2, "OnTimer_WraithRuins4_MoveTo_1");
					return false;
				}
			}
			return true;
		}
		
