//				Map_AddTimer("Timer_ShowAmuletHint", 30.f, "OnTimer_ShowAmuletHint");
			return false;
		}
		
		//-------------------------------------------------------
		
		float mfCaveAmuletHintTimer = 0;
		void OnTimer_CheckCaveAmuletHint(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.5, 1.0);
			if (Amulet_IsHeld() == false &&
				(Player_GetDistanceToEntity("Rift_Cave_1") <= 8 ||
				Player_GetDistanceToEntity("Rift_Cave_2") <= 8 || 
				Player_GetDistanceToEntity("Rift_Ledge") <= 8))
			{
				mfCaveAmuletHintTimer += fNext;
				if (mfCaveAmuletHintTimer >= 7)
				{
					Hint_ShowHint_Hold("Hints", "HintAmulet", true, 1.5, false);
					return;
				}
			}
			else
			{
				mfCaveAmuletHintTimer = 0;
			}			
			Map_RestartCurrentTimer(fNext);
		}
		
