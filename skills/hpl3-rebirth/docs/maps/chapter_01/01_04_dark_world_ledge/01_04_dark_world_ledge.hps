		/*Put any functions that are used in more than one event in Scene X here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
		
		/////////////////////////////////////////
		// Event A *Squeeze through the rocks and see the vista*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbCrackSqueezeAnim = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_CrackSqueezeScene(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 && mbCrackSqueezeAnim == false)
			{
				mbCrackSqueezeAnim = true;
				
				Item_PutAway(eItemHandlerHand_Right);
				Item_PutAway(eItemHandlerHand_Left);
				
				PlayerBody_SetInteractiveAnimationRange(0, 4, "OnAnimationRangeLeave_StartCrackSqueezeScene");
				PlayerBody_AddInteractiveAnimationCheckpoint(0.5);
				PlayerBody_AddInteractiveAnimationCheckpoint(1.3);
				PlayerBody_AddInteractiveAnimationCheckpoint(3.0);
				PlayerBody_PlayInteractiveAnimationAtEntity("squeezes_through_the_crack_at_the_ledge", "Target_SqueezeThroughAnim", 0.75, "OnAnimationEnd_CrackSqueeze", true, true, false, 1, true, false, false);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnAnimationEnd_CrackSqueeze(const tString &in asAnimName, float afT)
		{
			if (afT <= 0)
			{
				mbCrackSqueezeAnim = false;
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimationRangeLeave_StartCrackSqueezeScene(const tString &in asAnim)
		{
			Seq_CrackSqueezeScene("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceRockSqueezeScene;
		void Seq_CrackSqueezeScene(const tString &in asTimer)
		{
			Sequence_Begin("Seq_CrackSqueezeScene", mSequenceRockSqueezeScene);
			if (Sequence_DoStepAndPause(0.0))
			{
				Player_SetFallDamageActive(true);
				
				Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimationMessage_CrackSqueeze", false);
				
				FearHandler_SetPermaFailRespawnArea("PermaFail_Ledge_1");
//				FearHandler_SetDarknessFactorActive(false);
				
			}
			else if (Sequence_DoStepAndWait(0.2))
			{
				DarkWorldLightning(2, Map_GetEntity("Widget_FirstLightningDir").GetMatrix().GetTranspose().GetForward(), 0, "level_amb_shared/amb/sweeteners/thunder/dw_enter");
				
				
				mvDWLightning_LoopDir = Map_GetEntity("Widget_LightningDir_1").GetMatrix().GetTranspose().GetForward();
				mfDWLightning_LoopAngleOffset = 90;
				Map_AddTimer("OnTimer_DarkWorldLightningLoop", 20, "OnTimer_DarkWorldLightningLoop");
				
				Entity_SetActive("Soundscape_LedgeMAP", true);
				
				FearHandler_SetForcedAddFearRate(0.8f, 1.0f, false, 5, 0.04, 0.5);
				
				Voice_PlayDelayed("Emote_Lightning", 0.4f);
			}
			else if (Sequence_DoStepAndWait(3.8))
			{
				Effect_Rumble_Start(1.0, 2, 0, 1);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				Voice_StopAll();
				Voice_Play("At_The_Ledge", 1, "OnVoiceEnd_ResumeCrackSqueeze");
				
				Music_Stop(5.0f, eMusicPrio_SceneAmb);
				Music_Play("A2_1_4_DarkWorldReveal2.ogg", 0.4f, false, eMusicPrio_BigEvent);
				Map_AddTimer("Timer_MusicLedgeAmb", 20.0f, "OnTimer_PlayAmbMusic");
				
				Entity_SetActive("Trigger_ExitBlockedDialogue", true);
				Entity_SetActive("crack_squeeze_wall_*", true);
				Light_FadeBrightnessTo("Light_CrackSqueeze_*", 0, 0.5);
				Billboard_SetVisible("Billboard_CrackSqueeze_*", false);

				Sound_Play("Sound_LedgeWindSweet_*", 3.0f);
				Sound_Play("Sound_WindSweetMed_*", 3.0f);
//				Sound_Play("Sound_WindSweet_*", 3.0f);
				Sound_Play("Sound_LedgeThunder_*", 3.0f);
				Sound_Play("sound_creature_*", 3.0f);
				
				FearHandler_SetPermaFailEnabled(true);
				Visibility_SetAreaActive("VisibilityArea_cave_1", false);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Voice_Play("At_The_Ledge", 2);				
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimationMessage_CrackSqueeze(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			SequenceStates_Resume("Seq_CrackSqueezeScene");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_ResumeCrackSqueeze(const tString&in asScene, const tString&in asSubject)
		{
			SequenceStates_Resume("Seq_CrackSqueezeScene");
		}
		
		//-------------------------------------------------------
		void OnTimer_PlayAmbMusic(const tString &in asTimer)
			{
			 Music_Stop(3.0f, eMusicPrio_BigEvent);
			 Music_Play("A2_1_4_DarkWorldAmbience", 0.2f, true, eMusicPrio_BgAmb);
			}
		
		//-------------------------------------------------------
		
		//} END Event A *Squeeze through the rocks and see the vista*
		
		/////////////////////////////////////////
		// Event A *See lightning strikes*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tID m_idDarkWorldLightning_FlashLight;
		tString msDWLightning_SoundName = "";
		float mfDWLightning_Volume = 1;
		cVector3f mvDir;
		int mlDWLightning_Bolts = 3;
		int mlDWLightning_Index = -1;
		cVector3f mvDWLightning_Dir;
		float mfDWLightning_LoopAngleOffset = 0;
		cVector3f mvDWLightning_LoopDir;
		
		//-------------------------------------------------------
		
		void InitDarkWorldLightning()
		{
			cLightPoint@ pFlashLight = cLux_GetCurrentMap().GetWorld().CreateLightPoint("DWFlash", "", false);
			pFlashLight.SetBrightness(0);
			pFlashLight.SetRadius(200);
			m_idDarkWorldLightning_FlashLight = pFlashLight.GetID();
		}
		
		//-------------------------------------------------------
		
		void RandomDarkWorldLightning(cVector3f &in avDir, float afMaxAngleOffset = 0, float afDelay = 0, const tString&in asSound = "", float afVolume = 1)
		{
			msDWLightning_SoundName = asSound;
			mfDWLightning_Volume = afVolume;
			
			array<int> vIndexCandidates;
			for (int i = 1; i <= mlDWLightning_Bolts; ++i)
			{
				if (mlDWLightning_Index > 0 && i == mlDWLightning_Index) continue;
				vIndexCandidates.push_back(i);
			}
			
			int lIndex = vIndexCandidates[cMath_RandRectl(0, vIndexCandidates.size() - 1)];
			
			cVector3f vDir = avDir;
			vDir.y = 0;
			vDir = cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(cMath_RandRectf(-afMaxAngleOffset, afMaxAngleOffset))), vDir);
			DarkWorldLightning(lIndex, vDir);
		}
		
		//-------------------------------------------------------
		
		void DarkWorldLightning(int alIndex, cVector3f &in avDir, float afDelay = 0, const tString&in asSound = "", float afVolume = 1)
		{
			msDWLightning_SoundName = asSound;
			mfDWLightning_Volume = afVolume;
			
			mlDWLightning_Index = alIndex;
			mvDWLightning_Dir = avDir;
			Map_AddTimer("Timer_DoDarkWorldLightning", afDelay, "OnTimer_DoDarkWorldLightning");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoDarkWorldLightning(const tString &in asTimer)
		{
			Seq_DarkWorldLightning("");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DarkWorldLightningLoop(const tString &in asTimer)
		{
			bool bFront = false;
			if (Map_TimerExists("LightningInFrontCooldown") == false)
			{
				float fFrontToLoopAngleDiff = cMath_Vector3Angle(mvDWLightning_LoopDir, cVector3f(Player_GetForward().x, 0, Player_GetForward().z));
				if (fFrontToLoopAngleDiff <= mfDWLightning_LoopAngleOffset)
				{
					bFront = true;
					RandomDarkWorldLightning(Player_GetForward(), 20);
					Map_AddTimer("LightningInFrontCooldown", cMath_RandRectf(30, 120), "");
//					Map_AddTimer("LightningInFrontCooldown", 10, "");
					cLux_AddDebugMessage("[Map] Lightning in front");
				}
			}
			if (bFront == false)
			{
				RandomDarkWorldLightning(mvDWLightning_LoopDir, mfDWLightning_LoopAngleOffset);
				cLux_AddDebugMessage("[Map] Lightning random");
			}
			Map_RestartCurrentTimer(cMath_RandRectf(15, 45));
//			Map_RestartCurrentTimer(10);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataDarkWorldLightning;	
		void Seq_DarkWorldLightning(const tString &in asTimer)
		{
			Sequence_Begin("Seq_DarkWorldLightning", mSeqDataDarkWorldLightning);
			if (Sequence_DoStepAndWait(0.1f))
			{
//				Map_AddTimer("Timer_DarkWorldThunder", cMath_RandRectf(0.3, 1.0), "OnTimer_DarkWorldThunder");
				Map_AddTimer("Timer_DarkWorldThunder", 0, "OnTimer_DarkWorldThunder");
				
//				cVector3f vLightningDir = cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(cMath_RandRectl(0, 360))), cVector3f_Forward);
				cVector3f vLightningDir = mvDWLightning_Dir;
				
				cVector3f vLightningBolt = Player_GetPosition() + vLightningDir * cMath_RandRectf(1800, 3200);
				vLightningBolt += cVector3f_Up * cMath_RandRectf(500, 1000);
				
				iLight@ pLight = Map_GetLight("Light_Lightning_Point_" + mlDWLightning_Index);
				pLight.SetPosition(vLightningBolt);
				pLight.FadeTo(cColor(0.617,0.951,1,1), pLight.GetRadius(), 0.05f);
				
				cBillboard@ pBillboardBolt = cLux_GetCurrentMap().GetWorld().GetBillboard("Billboard_Lightning_Bolt_" + mlDWLightning_Index);
				pBillboardBolt.SetPosition(vLightningBolt);
				
				cBillboard@ pBillboardGlow = cLux_GetCurrentMap().GetWorld().GetBillboard("Billboard_Lightning_Glow_" + mlDWLightning_Index);
				pBillboardGlow.SetPosition(vLightningBolt);
				
				cVector3f vFlashPos = Player_GetPosition() + vLightningDir * 100 + cVector3f_Up * 75;
				
				iLight@ pFlashLight = cLux_ID_Light(m_idDarkWorldLightning_FlashLight);
				pFlashLight.SetPosition(vFlashPos);
				pFlashLight.SetDiffuseColor(cColor(0.617,0.951,1,1));
				pFlashLight.FadeBrightnessTo(80, 0.05);	
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				iLight@ pLight = Map_GetLight("Light_Lightning_Point_" + mlDWLightning_Index);
				pLight.FadeTo(cColor(0,0,0,1), pLight.GetRadius(), 0.2f);
				
				iLight@ pFlashLight = cLux_ID_Light(m_idDarkWorldLightning_FlashLight);
				pFlashLight.FadeBrightnessTo(0, 0.3f);
			}
			Sequence_End();
		}
		
		void OnTimer_DarkWorldThunder(const tString &in asTimer)
		{
			cVector3f vPos = Player_GetPosition() + mvDWLightning_Dir * cMath_RandRectf(60, 120);
			vPos += cVector3f_Up * cMath_RandRectf(30, 50);
			
			tString sSound = "level_amb_shared/amb/sweeteners/thunder/thunder_strike";
			if (msDWLightning_SoundName != "") sSound = msDWLightning_SoundName;
			
			cSoundEntity@ pThunder = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("Thunder", sSound, true);
			pThunder.SetUseCustomProperties(true);
			pThunder.SetCustomMinDistance(80);
			pThunder.SetCustomMaxDistance(200);
			pThunder.SetPosition(vPos);
			pThunder.SetVolume(mfDWLightning_Volume);
		}
		
