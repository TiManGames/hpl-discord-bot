		//-------------------------------------------------------
		
		bool OnCollide_Player_SlowWalk(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Player_FadeRunSpeedMulTo(0.5f,1.0f);
				Player_FadeMoveSpeedMulTo(0.5f,1.0f);
				Player_SetJumpForceMul(0.6f);
			}
			else
			{
				Player_FadeRunSpeedMulTo(1.0f,3.0f);
				Player_FadeMoveSpeedMulTo(1.0f,3.0f);
				Player_SetJumpForceMul(1);
			}
			return true;
		}
		
