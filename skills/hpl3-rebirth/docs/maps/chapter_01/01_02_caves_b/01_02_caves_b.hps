		//} END Event D *Player follows the light looking for Salim*
		
		/////////////////////////////////////////
		// Event E *Player goes through the crack and finds Salim's body*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event E here.*/
		
		bool mbSalimRevealed = false;
		bool mbProximityComments = false;
		bool mbShimmyLanternOut = false;
		bool mbLeftSalim = false;
		
		bool mbCaveCollapse = false;
		int mlShocks = 0;
		float mfShockDelay = 4;
		
		bool mbHasUsedLantern = false;
		
		float mfKneelFadeTime = 1.0f;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 5, Event E here.*/
		
		void OnTimer_ManageShimmy(const tString &in asTimer)
		{
			if (Entity_GetCollide("player",asTimer))
			{
				Map_RestartCurrentTimer(0.1f);
				Debug_Log("PLAYER COLLIDING WITH "+asTimer);
			}
			else
			{
				Debug_Log("ACTIVATED: "+asTimer);
				Entity_SetActive(asTimer,true);
				if (asTimer == "Trigger_ShimmyExit")
					Entity_SetActive("Trigger_ShimmyEnter",false);
				else
					Entity_SetActive("Trigger_ShimmyExit",false);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_ShimmyEnter(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
						
			if (!mbSalimRevealed)
			{
				Voice_StopAll();
				Voice_PlayDelayed("Scene_SalimsCorpse0",1);
				Music_Stop(2.0f, eMusicPrio_BgAmb);
				//Music_Play("A2_01_02_Discover_Lantern.ogg", 0.2f, false, eMusicPrio_MinorEvent);
			}

			PlayerBody_PlayInteractiveAnimationAtEntity("player_shimmy_in_salim_encounter_slow","PosArea_Shimmy",0.4f,"OnAnimEnd_ShimmyEnter",false);
			PlayerBody_SetCutsceneMaxPitch(20);
			PlayerBody_SetCutsceneMaxYaw(20);
			
			if (mbShimmyLanternOut)
				Item_PutAway(eItemHandlerHand_Left);
				
			cLux_AddDebugMessage("ENTER");
			Player_FadeNightVisionStrength(0,2);
			
			return true;
		}

		//-------------------------------------------------------		
		
		void OnAnimEnd_ShimmyEnter(const tString &in asAnimName, float afT)
		{
			if (!mbSalimRevealed)
			{
				cLux_AddDebugMessage("REVEAL");
				Voice_PlayWhenPossible("Scene_SalimsCorpse1","",30,0);
				Sound_CreateAtEntity("Sound_DiscoverSalim", "01_02_caves/anim/salim_discover", "player");
				PlayerBody_PlayCutsceneAtEntity("player_salim_encounter","PosArea_Shimmy",false,0,"OnAnimEnd_SalimReveal");
				PlayerBody_FadeCutsceneMaxPitch(10, 3);
				PlayerBody_FadeCutsceneMaxYaw(10, 3);
				Entity_SetActive("Trigger_ShimmyExit",false);
				Entity_PlayAnimation("Fairchild_rigid_1","salim_encounter");
				Entity_PlayAnimation("Salim_Ring","ring_salim_encounter");
				Player_SetCrouching(true,true,true);
				Player_SetRunSpeedMul(0.3f);
				Player_SetMoveSpeedMul(0.7f);
					
				Music_PlayExt("A2_01_02_Discover_Salim.ogg", false, 0.2f, 1, 1.0f, 0, eMusicPrio_BigEvent, false);
				Voice_PlayDelayed("Scene_SalimsCorpse2",5.f);
				Voice_PlayDelayed("Scene_SalimsCorpse3",20.f,-1, "",10);
			}
			else
			{
				if (mbShimmyLanternOut)
					Item_Equip("Lantern");
					
				//Map_AddTimer("Trigger_ShimmyExit",0,"OnTimer_ManageShimmy");
			}
		}

		//-------------------------------------------------------
		
		bool OnCollide_ShimmyExit(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			cLux_AddDebugMessage("EXIT");
			PlayerBody_PlayInteractiveAnimationAtEntity("player_shimmy_out_salim_encounter","PosArea_Shimmy",0.2f,"OnAnimEnd_ShimmyExit",false);
			PlayerBody_SetCutsceneMaxPitch(20);
			PlayerBody_SetCutsceneMaxYaw(20);
			Player_FadeNightVisionStrength(1,2);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ShimmyExit(const tString &in asAnimName, float afT)
		{
			//Map_AddTimer("Trigger_ShimmyEnter",0,"OnTimer_ManageShimmy");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_SalimReveal(const tString &in asAnimName)
		{
			mfKneelFadeTime = 1.0f;
			//Map_AddTimer("Timer_Kneel",0,"OnTimer_Kneel");
			Player_SetMoveSpeedMul(0);
			Player_SetStandDisabled(true);
			Entity_SetActive("InteractAux_1",true);
			Player_StartLookAt("PosArea_SalimFaceLookAt",1,1,1);
			Map_AddTimer("Timer_RemoveLanternLookAt",0.5f,"OnTimer_RemoveLanternLookAt");
			Entity_PlayAnimation("Fairchild_rigid_1","salim_encounter_pose_2");
			Entity_PlayAnimation("Salim_Ring","ring_salim_encounter_pose_2");
			mbSalimRevealed = true;
			mbProximityComments = true;
			Sketchbook_CompleteIdea("find_salim");
			Sketchbook_NewIdeasPage();
			cScript_SetGlobalVarBool("Caves_FoundSalim", true);

			Map_AddTimer("Timer_ActivateSalimInteractions",1,"OnTimer_ActivateSalimInteractions");
			Map_AddTimer("Timer_TasiAndSalim",8,"OnTimer_TasiAndSalim");
			
			FearHandler_SetWhisperStage(eFearWhisperStage_SalimToRadio);
			
			OnTimer_Kneel("");
			PlayerBody_SetInteractiveAnimationAllowHint(false);
			Map_AddTimer("Timer_AllowInteractionHint",10,"OnTimer_AllowInteractionHint");
			
			FearHandler_SetPermaFailEnabled(false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_AllowInteractionHint(const tString &in asTimer)
		{
			PlayerBody_SetInteractiveAnimationAllowHint(true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RemoveLanternLookAt(const tString &in asTimer)
		{
			Player_StopLookAt(0.02f);
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_ActivateSalimInteractions(const tString &in asTimer)
		{
			//Entity_SetActive("Trigger_SalimEyes",true);
			Entity_SetActive("Trigger_SalimRing",true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_WalkAway(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (ItemType_GetCountInInventory("Lantern") == 0) return true;
			if (!mbCaveCollapse) return true;
			
			Entity_SetActive("Blocker_4*",true);
			
			if (mbHasUsedLantern == false)
			{
				Map_RemoveTimer("Timer_CheckLantern");
				Hint_ShowHint("Hints", "HintFlashlight", true, 1.5f, true);
			}
			
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnEndAnim_CheckBelly(const tString &in asEntity, int alDirection)
		{
			Map_AddTimer("Timer_belly",0.2f,"OnTimer_Belly");
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Belly(const tString &in asTimer)
		{
			PlayerBody_PlayCutsceneAnimation("react_to_baby_kick",false,1,"");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SalimArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (!mbSalimRevealed) return true;
			
			if (alState == -1)
			{
				Map_RemoveTimer("Timer_TasiAndSalim");
				//Music_Stop(4,eMusicPrio_BigEvent);
				return true;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SalimProximity(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (!mbProximityComments) return true;
			if (!mbSalimRevealed) return true;
			if (alState != 1) return true;
			
			if (!Map_TimerExists("Timer_TasiAndSalim"))
			{
				Map_AddTimer("Timer_TasiAndSalim",1.f,"OnTimer_TasiAndSalim");
			}
			return true;

		}
		
		//------------------------------------------------
		
		void OnTimer_UnpauseTimer(const tString &in asTimer)
		{
			Map_AddTimer("Timer_TasiAndSalim",1.f,"OnTimer_TasiAndSalim");
		}
		
		//------------------------------------------------
		
		void OnTimer_TasiAndSalim(const tString &in asTimer)
		{	
				
			if ((mbLeftSalim == false || Entity_GetCollide("player","Fear_Salim")) && Entity_IsInPlayerFOV("PosArea_SalimFaceLookAt") && !mbCaveCollapse && mbProximityComments)
			{
				Voice_PlayDelayed("Dialogue_TasiSalimProximity",1);
				float fTime = cMath_RandRectf(8,12);
				Map_RestartCurrentTimer(fTime);
			}
			else
			{
				Map_RestartCurrentTimer(0.1f);
			}
		}	
		
		//-------------------------------------------------------
		
		bool mbSalimEyesClosed = false;
		
		void OnInteract_TakeSalimRing(const tString &in asEntity)
		{
			Entity_SetActive("Trigger_Shimmy*", false);
			Entity_PlayAnimation("Fairchild_rigid_1","salim_encounter_take_ring");
			Entity_PlayAnimation("Salim_Ring","ring_salim_encounter_take_ring");
			
			
			Sound_CreateAtEntity("Sound_TakeRing", "01_02_caves/anim/salim_ring", "player");
			
			bool bPlayerStateNormal = cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal;
			PlayerBody_PlayCutsceneAtEntity("player_salim_encounter_take_ring","PosArea_Shimmy",false, bPlayerStateNormal ? 0.5f : 0.2f,"OnEndAnim_RingTaken", 1, 0, 0, 0, true, false, !bPlayerStateNormal);
			PlayerBody_SetCutsceneAutoResetCamera(true);
			PlayerBody_FadeCutsceneMaxPitch(10, 1);
			PlayerBody_FadeCutsceneMaxYaw(10, 1);
			
			MainMenu_SetPhase_Items(eMainMenuPhase_Items_DollRing);
			
			tString sTimer = "Timer_TasiAndSalim";
			if (Map_TimerExists("Timer_TasiAndSalim"))
			{
				Map_RemoveTimer("Timer_TasiAndSalim");
				Map_AddTimer("Timer_UnpauseTimer",10,"OnTimer_UnpauseTimer");
			}
			
			Map_AddTimer("Timer_RemoveRing",10,"OnTimer_RemoveRing");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RemoveRing(const tString &in asTimer)
		{	
			Entity_SetActive("Salim_Ring",false);
			Item_AddToInventory("SalimRing");
			Voice_Play("Scene_SalimsCorpse_Ring");
			
			cScript_SetGlobalVarBool("SalimsRingVisible", true);
			
			iLuxEntity@ pRing = Map_GetEntity("SalimsRing_Accessory", eLuxEntityType_Prop);
			if (pRing !is null)
				pRing.GetMeshEntity().SetVisible(true);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_CloseSalimEyes(const tString &in asEntity)
		{
			Entity_SetActive("Trigger_ShimmyExit",false);

			tString sTimer = "Timer_TasiAndSalim";
			if (Map_TimerExists(sTimer))
			{
				Map_SetTimerPaused(sTimer,true);
				Map_AddTimer("Timer_UnpauseTimer",5,"OnTimer_UnpauseTimer");
			}
			
			mbSalimEyesClosed = true;
				
		}
		
		//-------------------------------------------------------
		
		void OnEndAnim_EyesClosed(const tString &in asAnim)
		{		
			mfKneelFadeTime = 0;
			Map_AddTimer("Timer_Kneel",0.1f,"OnTimer_Kneel");
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_LeaveSalim(const tString &in asAnim, float afT)
		{
			LeaveSalim(true);
		}
		
		//-------------------------------------------------------
		
		void LeaveSalim(bool abUnCrouch)
		{
			Hint_StopHint(0);
			Player_FadeMoveSpeedMulTo(1,3);
			Player_SetStandDisabled(false);
			if (abUnCrouch) Player_SetCrouching(false,true,true);
			
			FootPlacement_SetActive(PlayerBody_GetEntityName(),true);
			Player_ResetCameraLimits();
			
			Entity_SetActive("Blocker_Backtrack",true);
			
			mbLeftSalim = true;
			
			//Map_AddTimer("Trigger_ShimmyExit",10,"OnTimer_ManageShimmy");
			//Shimmy_ResetTrigger();
		}
		
		//-------------------------------------------------------
		
		bool mbLanternHintBlocked = false;
		
		void OnTimer_ShowLanternHint(const tString &in asTimer)
		{
			if (Entity_GetCollide("Player","Trigger_SalimProximity") || (mbLeftSalim == false || cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Normal))
			{
				mbLanternHintBlocked = true;
				Map_RestartCurrentTimer(0.25f);
				return;
			}
			
			// Delay again to ensure a bit of a gap with whatever was blockng the hint before and the hint appearing
			if (mbLanternHintBlocked)
			{
				mbLanternHintBlocked = false;
				Map_RestartCurrentTimer(3.0f);
				return;
			}
			
			Hint_ShowHint("Hints", "HintFlashlight", true, 1.5f, false);
			Map_AddTimer("Timer_CheckLantern", 0.5, "OnTimer_CheckLantern");
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_CheckLantern(const tString &in asTimer)
		{
			if (Item_GetHeldType(eItemHandlerHand_Left) != "Lantern")
			{
				Map_RestartCurrentTimer(0.5);
				return;
			}
			
			mbHasUsedLantern = true;
		}
		
		//------------------------------------------------------- 
		
		void OnEndAnim_RingTaken(const tString &in asAnim)
		{
			Entity_PlayAnimation("Fairchild_rigid_1","ring_salim_encounter_pose_2");
			mfKneelFadeTime = 0.3f;
			Entity_SetActive("Trigger_ShimmyExit",false);
			OnTimer_Kneel("");
			//Map_AddTimer("Trigger_ShimmyExit",2,"OnTimer_ManageShimmy");
		}
		
		void Shimmy_ResetTrigger()
		{
			//Entity_SetActive("Trigger_ShimmyExit",true);
		}
		
		//-------------------------------------------------------
		
		//} END Event E *Player goes through the crack and finds Salim's body*
		
		/////////////////////////////////////////
		// Event F *Player reads Salim's death note*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event F here.*/
		
		bool mbNoteRead = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 5, Event F here.*/
		
		void OnInteract_SalimLastNote(const tString &in asEntity)
		{
			Voice_StopAll();
			mbProximityComments = false;
		}

		//------------------------------------------------------- 
		
		void OnRead_SalimLastNote(const tString &in asEntity)
		{
			mbNoteRead = true;
			cScript_SetGlobalVarBool("Caves_ReadSalimsLastNote",true);
			Voice_StopAll();
			
			if (!mbCaveCollapse)
				Map_AddTimer("Timer_NoteDelay",0.8f,"OnTimer_NoteDelay");
				
			Entity_SetActive("Readable_SalimsLastNote",false);
			
			LeaveSalim(false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_KneelIdle(const tString &in asTimer)
		{
			
			PlayerBody_SetInteractiveAnimationInteractCallback("OnInteract_Stuff");
			PlayerBody_PlayInteractiveAnimationAtEntity("player_salim_encounter_kneel_loop","PosArea_Shimmy",1,"",false,true,true,1,false,true,false);
			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Kneel(const tString &in asTimer)
		{
			PlayerBody_SetInteractiveAnimationInteractCallback("OnInteract_Stuff");
			PlayerBody_AddInteractiveAnimationCheckpoint(0.1f);
			PlayerBody_AddInteractiveAnimationCheckpoint(3.5f);
			PlayerBody_SetInteractiveAnimationRange(0,1,"");
			PlayerBody_PlayInteractiveAnimationAtEntity("player_salim_encounter_tr_idle","PosArea_Shimmy",mfKneelFadeTime,"OnEndOfAnim_LeaveSalim",false,true,true,1,false,false,true,true);				
			PlayerBody_FadeCutsceneMaxPitch(-1, 1);
			PlayerBody_FadeCutsceneMaxYaw(-1, 1);
			Player_SetCrouching(false,true,true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_NoteDelay(const tString &in asTimer)
		{
			Voice_Play("Dialogue_AfterSalimsLastNote");
			mbProximityComments = true;
		}
		
		bool mbCanExit = false;
		
		//-------------------------------------------------------
		
		void OnInteract_Stuff(const tString &in asEntity)
		{
			if (asEntity == "lantern_new_1" || asEntity == "InteractAux_1")
			{
				Entity_CallEntityInteract("lantern_new_1");
			}
			else if (asEntity == "Trigger_SalimRing")
			{
				Entity_CallEntityInteract("Trigger_SalimRing");
			}
			else
			{
				Prop_SetActiveAndFade(asEntity, false, 0.2f);
				//PlayerBody_SetInteractiveAnimationOver();

				PlayerBody_PlayCutsceneAtEntity("crouch_idle", "Trigger_1", false, 0.3f, "OnEndOfAnim_Read", 2);
				Player_SetCrouching(true,true,true);
				//FootPlacement_SetActive(PlayerBody_GetEntityName(),false);
				
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Read(const tString &in asTimer)
		{
			Entity_CallEntityInteract("Readable_SalimsLastNote");
			//PlayerBody_PlayCutsceneAtEntity("kneel_loop", "Trigger_1", true, 0.f, "", 1.f);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_Read(const tString &in asAnimName)
		{
			Map_AddTimer("Timer_Read",0.1f,"OnTimer_Read");
		}
		
		//------------------------------------------------------- 
		
		bool OnCamAnim_Test(const tString &in asEntity, int alDirection)
		{
			Debug_Log("Node 1: Speed: "+CameraAnimationNode_GetBackSpeed("CameraAnimation_1")+", Time: "+CameraAnimationNode_GetBackTime("CameraAnimation_1"));
			CameraAnimationNode_SetBackwardTime("CameraAnimation_1",0);
			if (mbCanExit)
			{
				CameraAnimation_End();
				return true;
			}
			return true;
		}
		
		bool OnCamAnim_Test2(const tString &in asEntity, int alDirection)
		{
			Debug_Log("Node 2: Speed: "+CameraAnimationNode_GetBackSpeed("CameraAnimation_1")+", Time: "+CameraAnimationNode_GetBackTime("CameraAnimation_1"));
			CameraAnimationNode_SetBackwardTime("CameraAnimation_1",2);
			mbCanExit = true;
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event F *Player reads Salim's death note*
		
	//} END SCENE 5
	
