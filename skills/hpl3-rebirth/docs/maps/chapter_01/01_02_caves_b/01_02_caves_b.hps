		void OnTimer_RemoveDollLookAt(const tString &in asTimer)
		{
			Player_StopLookAt(0.02f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_GetMonkey(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_StopAll();
			Player_FadeMoveSpeedMulTo(0.1,3);
			Voice_Play("Memory_TheDoll_Prelude");
			Map_AddTimer("Timer_DollMemory",3.6,"OnTimer_DollMemory");
			PlayerBody_PlayCutsceneAtEntity("player_pickup_doll_start","PosArea_DollCutscene",false,0.5,"OnEndOfAnim_DollLoop",1,0);
			PlayerBody_SetCutsceneMaxPitch(15);
			PlayerBody_SetCutsceneMaxYaw(15);
			Entity_SetAnimationPaused("doll_monkey_2", "monkey_pickup_doll_start", false);
			MainMenu_SetPhase_Items(eMainMenuPhase_Items_Doll);
			mbFlashback = true;
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void Trigger_MusicDoll_OnPlayerLookAt(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_SpotDoll");
			
			Music_PlayExt("A2_01_02_Discover_Doll_C_Alt.ogg", false, 0.21f, 1, 5.0f, 0, eMusicPrio_MinorEvent, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DollMemory(const tString &in asTimer)
		{
			Sketchbook_UnlockMemory("TheDoll", true, "OnEndOfVoice_DollMemory");
			cScript_SetGlobalVarBool("Caves_KnowPregnant", true);
			FearHandler_FadeLevelTo(0,3);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_DollLoop(const tString &in asAnim)
		{
			PlayerBody_PlayCutsceneAtEntity("player_pickup_doll_loop","PosArea_DollCutscene",true,0,"",1,0, 0, 0, true, false, true);
			Entity_PlayAnimation("doll_monkey_2", "monkey_pickup_doll_loop", 0, true);
			Player_SetCrouching(false,true,true);
		}
		
		void OnEndOfVoice_DollMemory(const tString &in asScene, const tString &in asSubject)
		{
			Map_AddTimer("Timer_TasiDoll",1.0f,"OnTimer_TasiDollPutAway");
		}
		
		void OnTimer_TasiDollPutAway(const tString &in asTimer)
		{
			PlayerBody_PlayCutsceneAtEntity("player_pickup_doll_end","PosArea_DollCutscene",false,0.1,"OnEndOfAnim_DollKill",1,0, 0, 0, true, false, true);
			Entity_PlayAnimation("doll_monkey_2", "monkey_pickup_doll_end", 0.1, false);
			Map_AddTimer("Timer_TasiDollAfter",3.f,"OnTimer_TasiDollAfter");
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_DollKill(const tString &in asAnim)
		{
			Item_AddToInventory("AlysDoll", false);
			Entity_SetActive("doll_monkey_2", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TasiDollAfter(const tString &in asTimer)
		{
			Map_AddTimer("Timer_SlowPlayerDown",6,"OnTimer_SlowPlayerDown");
			Voice_StopAll();
			Voice_Play("Memory_TheDoll_After",-1,"OnEndOfVoice_MemoryBarks");
			Player_FadeMoveSpeedMulTo(0.5f, 1);
			Player_FadeRunSpeedMulTo(0.7f, 1);
			Player_FadeLookSpeedMulTo(0.8f, 1);
			Music_Play("A2_01_02_Baby_Memory.ogg", 0.2f, false, eMusicPrio_MinorEvent);
			Map_AddTimer("Timer_MusicBaby", 16.0f, "OnTimer_MusicPlayBabyAmb");
		}
		
		//-------------------------------------------------------
		
		void OnEndOfAnim_PregnancyBellyCheck(const tString &in asAnim)
		{
			PlayerBody_ResetCutscenePitchYawLimits();
			cLux_AddDebugMessage("Reset the limits");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SlowPlayerDown(const tString &in asTimer)
		{
			Player_FadeMoveSpeedMulTo(0.7f, 1);
			Player_FadeRunSpeedMulTo(0.5f, 1);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfVoice_MemoryBarks(const tString &in asScene, const tString &in asSubject)
		{
			Map_AddTimer("Timer_MemoryBark",cMath_RandRectf(1.2f,2),"OnTimer_MemoryBark");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MemoryBark(const tString &in asTimer)
		{
			if (Voice_SubjectHasUnplayedLines("Dialogue_MemoryReturning"))
				Voice_Play("Dialogue_MemoryReturning",-1,"OnEndOfVoice_MemoryBarks");
			else
			{
				Player_FadeMoveSpeedMulTo(1.f, 5);
				Player_FadeRunSpeedMulTo(1.f, 5);
			}
				
		}
		
		//-------------------------------------------------------
		
		bool mbHasSeenLight = false;
		
		void OnLookAt_SeeLight(const tString &in asEntity, int alState)
		{
			//Voice_PlayWhenPossible("Dialogue_TheLantern");
			mbHasSeenLight = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MusicPlayBabyAmb(const tString &in asTimer)
		{
			Music_Stop(4.0f, eMusicPrio_MinorEvent);
			//Music_PlayExt("A2_01_02_Doll_Ambience_B.ogg", true, 0.4f, 1.0f, 6.0f, 1.0f, eMusicPrio_BgAmb, false);
		}
		
		//-------------------------------------------------------
		 
		void OnInteract_GetDoll(const tString &in asEntity)
		{
			if (mbFlashback) return;

			Voice_Play("Memory_TheDoll_Prelude");
			Map_AddTimer("Timer_DollMemory",2,"OnTimer_DollMemory");
			mbFlashback = true;
		}
		
