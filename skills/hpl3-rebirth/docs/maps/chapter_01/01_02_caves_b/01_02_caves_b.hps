		// Event D *Player follows the light looking for Salim*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event D here.*/
		
		int mlGlimpses = 0;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 5, Event D here.*/
		
		void OnLookAt_SalimGlimpse(const tString &in asEntity, int alState)
		{
			Debug_Log("Glimpse");
			Voice_StopAll();
			Voice_Play("Tasi_SalimGlimpse");
			mlGlimpses++;
		}
		
