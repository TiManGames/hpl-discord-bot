			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_DeactivateLadder(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Ladder_Bridge",false);
			Player_SetAmbientLight(0,0,0);
			//Player_SetNightVisionStrength(0.23f);
			
			// Kill rumble sounds
			// We have a bug where some rumble sound seems to constantly play beyond this point
			// so killing everything I can find here - IT
			Sound_Stop("Sound_BigRockLoop",3.0f);
			Sound_Stop("Sound_BigRockCollapse",3.0f);
			Sound_Stop("Sound_PrettyCavesQuakeWarning",3.0f);
			Sound_Stop("Sound_RiftShakeLayerB_1",3.0f);
			Sound_Stop("Sound_RiftShakeLayerB_2",3.0f);
			Sound_Stop("Sound_RiftQuake",3.0f);
			Sound_Stop("Sound_RockImpactFirstScare",3.0f);
			
			return false;
		}
		
