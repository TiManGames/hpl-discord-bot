	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(2);
		
		// Any general setup of script / entities
		
		Player_SetMapDeepShadow(mfDeepShadowLevel);
		
		// Any general setup of script / entities
		Player_Teleport("Start_Begin");
		
		ParticleSystem_SetActive("PS_Dust_*",false);
		ParticleSystem_SetActive("PS_Collapse_*",false);
		ParticleSystem_SetActive("PS_RiftCollapse_*",false);
		
		Entity_PlayAnimation("Fairchild_rigid_1","salim_encounter_pose_1");
		Entity_PlayAnimation("Salim_Ring","ring_salim_encounter_pose_1");
		
		Entity_PlayAnimation("doll_monkey_2", "monkey_pickup_doll_start", 0);
		Entity_SetAnimationPaused("doll_monkey_2", "monkey_pickup_doll_start", true);
		
		Entity_AttachToSocket("Trigger_SalimRing", "Fairchild_rigid_1", "RingSocket", false, true);
		
		Hint_RemoveFromGiven("Hints","HintDarkness");
		Hint_RemoveFromGiven("Hints","HintFear");
		Hint_RemoveFromGiven("Hints","HintDarknessReminder");
		
		Billboard_SetVisible("Billboard_LanternObscured",false);
		
		if (Matches_GetCount() > 3)
			Entity_SetActive("Matches_Start", false);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{			
			Prop_SetStaticPhysics("Prop_Grab_*",false);
			Entity_SetInteractionDisabled("Prop_Grab_*",false);
			//Entity_SetActive("Blocker_1_*",false);
			Item_AddToInventory("ModernOilFixed");
			Item_AddToInventory("Matchbook");
			//Item_AddToInventory("Lantern");
			//Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
			Item_SetAmount("Matchbook",3);
		}
		else
		{
			Effect_Fade_Out(0);
			Map_AddTimer("Timer_WakeUp",0.2f,"OnTimer_WakeUp");
		}
		
		Effect_FearTentacles_SetVignetteMul(0.55f);
		
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		Achievement_Unlock(eAchievement_Dreamer);
		
		PlayerBody_SetActive(true);
		FearHandler_SetUpdateInterval(0.4f);
		FearHandler_SetPermaFailEnabled(true);
        Heat_SetActive(false);
		Music_PlayExt("A2_01_02_CavesAmbience2.ogg", true, 0.1f, 1.0f, 18.0f, 1.0f, eMusicPrio_BgAmb, true);
		PlayerBody_SetModel("player4.ent");
		Entity_SetEffectsActive(PlayerBody_GetEntityName(),false,false);
		//Player_SetNightVisionBrightness(2.8f);
		
		// Updated 200403
		//Player_SetNightVisionBrightness(2.3f);
		//Player_SetNightVisionRadius(5.5f);
		//Player_SetNightVisionStrength(1.f);
		
		Light_FadeBrightnessTo("lantern_collapse_light_*",0.f,0.5);
		
		// Used for checking if we should display run hint
		Map_AddTimer("Timer_UpdatePlayerRunCount", 0.1f, "OnTimer_UpdatePlayerRunCount");
	}

	//-------------------------------------------------------
	
	float mfTime = 0;
	
	void Update(float afTimeStep) 
	{	
		
		//cLux_AddDebugMessage("COLLIDE: "+Entity_GetCollide("player","Fear_Salim")+" - FOV: "+Entity_IsInPlayerFOV("PosArea_SalimFaceLookAt")+" - COLLAPSE: "+mbCaveCollapse+" - COMMENTS: "+mbProximityComments);
		float fNewTime = mfTime+afTimeStep;
		
		UpdateLightLevelBarks(afTimeStep);
		
		if (Entity_Exists("yth_light"))
		{
			cMatrixf mtxYTH = Map_GetEntity("yth_light").GetMatrix();
			mtxYTH = cMath_MatrixMul(mtxYTH, cMath_MatrixRotateXYZ(cVector3f(cMath_Sin(fNewTime)/100-cMath_Sin(mfTime)/100,cMath_Sin(fNewTime)/10-cMath_Sin(mfTime)/10,0)));
			Map_GetEntity("yth_light").SetMatrix(mtxYTH);
		}
		mfTime = fNewTime;
		
		// Ugly way of making the final fade-out of the lantern a bit less smooth
		if (mfFadeOutLanternBrightness > 0)
		{
			mfFadeOutLanternT += afTimeStep/3.62f;
			if (mfFadeOutLanternT > 1.0f)
				mfFadeOutLanternT = 1.0f;

			float fNewBrightness = cMath_Easing(eEasing_Linear, mfFadeOutLanternT, mfFadeOutLanternBrightness, 0);
			
			if (mfFadeOutLanternT == 1.0f)
			{
				mfFadeOutLanternBrightness = -1;
			}
			
			// Apply noise
			else
			{
				float fNoise = cGenerate_GetNoisePerlin1D(cEngine_GetGameTime()*12.5f);
				fNoise *= cMath_Easing(eEasing_ExpoIn, mfFadeOutLanternT, 1.0f, 0);
				fNewBrightness += fNoise*0.6f;
			}
			
			Light_SetBrightness("lantern_collapse_light_*",fNewBrightness);
		}
	}
	
