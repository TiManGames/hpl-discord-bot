	//-------------------------------------------------------
	
	int mlPermaFailStage = eCavesBPermaFail_Entrance;
	
	bool OnPermaFail()
	{	
		Debug_Log("Permafail Stage: "+mlPermaFailStage);
		if (mlPermaFailStage == eCavesBPermaFail_Entrance)			{PermaFail_Default("Entrance_*");	return true;}
		else if (mlPermaFailStage == eCavesBPermaFail_AfterRift)			{PermaFail_Default("AfterRift");		return true;}	
		else if (mlPermaFailStage == eCavesBPermaFail_FallPrettyCave)	{PermaFail_Default("PrettyCave_*");	return true;}
		else return true;
	}
	
	//-------------------------------------------------------
	
	void PermaFail_Default(const tString &in asArea)
	{
		Debug_Log("Permafail Default at: "+"PermaFail_"+asArea);
		FearHandler_SetPermaFailRespawnArea("PermaFail_"+asArea);
	}
		
	//-------------------------------------------------------
	
	void PermaFail_PrettyCave()
	{
		FearHandler_SetPermaFailRespawnArea("PermaFail_PrettyCave_*");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		/////////////////////////
		// Don't show hint if player has crouched
		if (alAction == eAction_Crouch && cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal)
		{
			mbShowCrouchHint = false;
		}
		
		if(alAction == eAction_Test1)
		{
			Effect_Fade_Out(0);
			Player_Teleport("Start_Begin");
			//Player_WakeUpFromDream();
			Seq_WakeUpFromDream("");
		}
		if(alAction == eAction_Test2)
		{
			Item_AddToInventory("AlysDoll", false);
		}
		if(alAction == eAction_Test3)
		{
			Entity_StopAnimation("doll_monkey_2");
		}
		if(alAction == eAction_Test4)
		{
			PlayerBody_PlayCutsceneAtEntity("player_pickup_doll_end","PosArea_DollCutscene",false,0.1,"",1,0, 0, 0, true, false, false);
			Entity_PlayAnimation("doll_monkey_2", "monkey_pickup_doll_end", 0.1, false);
		}
		if(alAction == eAction_Test5)
		{
			Entity_CallEntityInteract("Readable_SalimsLastNote");return;
			Voice_Play("Scene_SalimsCorpse1"); return;
			//iLuxEntity@ pDoll = Map_GetEntity("doll_monkey_1");
			//pDoll.AttachToSocket(Map_GetEntity(PlayerBody_GetEntityName()),"R_Hand",true,true);
			
			iLuxEntity@ pDoll = Map_GetEntity("doll_monkey_1");
		//	pDoll.SetMeshScaleMul(0.5f);
			pDoll.AttachToSocket(Map_GetEntity(PlayerBody_GetEntityName()),"R_Hand",true,true);
			
			
		}
		if(alAction == eAction_Test6)
		{
			PlayerBody_SetInteractiveAnimationOver();return;
			Prop_SetRenderLayer("doll_monkey_1",1);
			PlayerBody_PlayAnimation("look_at_doll_rarm_loop",ePlayerBodyAnimationLayer_RightArm,true,false,false,1,1,0);
			iLuxEntity@ pDoll = Map_GetEntity("doll_monkey_1");
		}
		if (alAction == eAction_Test7)
		{
			OnInteract_GetLantern("lantern_new_1");
			Player_Teleport("Start_Caves_Collapse");
		}
		if (alAction == eAction_Test8)
		{
			//Prop_SetActiveAndFade("",false,2);
			cLux_AddDebugMessage("UNPAUSE");
			Map_SetTimerPaused("Timer_TasiAndSalim",false); return;
			Entity_SetActive("yth_light",true);
			Light_FadeBrightnessTo("Light_Exit_Spot",0,0);
			Entity_SetEffectsActive("yth_light",true,true);
		}
		if (alAction == eAction_Test9)
		{
			cLux_AddDebugMessage("CREATE TIMER");
			Map_AddTimer("Timer_TasiAndSalim",0,"OnTimer_TasiAndSalim"); return;
			Effect_FearTentacles_SetVignetteMul(0.5f);
			//Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 0);
			//Effect_FearTentacles_SetVignetteMul(0.75f);
			//Effect_FearTentacles_SetVignetteStrengthMul(0.75f);
			
		}
		if (alAction == eAction_Test0)
		{
			Lamp_SetLit("torch_pilgrim_wood_5",false,true);
			Light_FadeBrightnessTo("torch_salim_light_*",0,1);
		}
		if (alAction == eAction_TestPlus)
		{
			SetArmsVisible(true);
		}
		if (alAction == eAction_TestMinus)
		{
			SetArmsVisible(false);
		}
	}

