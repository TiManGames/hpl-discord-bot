		//-------------------------------------------------------
		
		void OnTimer_WakeUp(const tString &in asTimer)
		{
			Player_Teleport("Start_Begin");
			Seq_WakeUpFromDream("");
		}
		
		//-------------------------------------------------------

		cSequenceStatesData mSequenceWakeUpFromDream;
			
		void Seq_WakeUpFromDream(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WakeUpFromDream", mSequenceWakeUpFromDream);
			if (Sequence_DoStepAndWait(4.6f))
			{
				PlayerBody_PlayCutsceneAnimation("wake_up_from_death_1c",false,0.2f,"",0.55f);
				Sound_CreateAtEntity("Sound_PlayerStand", "new_sounds/animations/caves_b_wake", "player");
				Effect_Fade_In(2);
				Player_SetMoveSpeedMul(0.6f);
			}
			else if (Sequence_DoStepAndContinue())
			{
				Voice_Play("Dialogue_BackFromTheDream");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Heavy(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Dialogue_BackFromTheDream_Moving");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_GetUsedToIt(const tString &in asParent, const tString &in asChild, int alState)
		{
			Player_FadeMoveSpeedMulTo(1.0f, 10.f);	
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_FirstRockScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_StopAll();
			Prop_SetStaticPhysics("rock_dropscare_*",false);
			Entity_AddImpulse("rock_dropscare_*",cVector3f(0.5f,0.5f,0),true,true);			
			Sound_CreateAtEntity("Sound_RockImpactFirstScare","01_02_caves/quake/quake_3/rock_impact",asParent);
			FearHandler_SetForcedAddFearRate(0.5f,-1,true,-1,-1,0.3f);
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_CrouchHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_LightLevelBarksDelay",12.f,"OnTimer_LightLevelBarksDelay");
				if (mbShowCrouchHint)
					Map_AddTimer("Timer_ShowCrouchHint", 10.f, "OnTimer_ShowCrouchHint");
			}
			else
				Hint_StopHint();
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_DarknessHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (Player_IsInShadow())
			{
				Hint_StopHint();
				Hint_ShowHint("Hints","HintDarkness");
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowCrouchHint(const tString &in asTimer)
		{
			cLux_AddDebugMessage("CROUCH HINT");
			if (Entity_GetCollide("Trigger_CrouchHint", "player") && mbShowCrouchHint)
			{
				Hint_StopHint();
				Hint_ShowHint_Hold("Hints", "HintCrouch", true, 100.f, true, 10.f);
			}
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_Fall(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1) return true;
			
			//Player_GiveDamage(0,0.1f,eDamageType_Fall,asParent);
			FearHandler_TriggerPermaFail_Fall();
			//FearHandler_TriggerPermaFail();
			return true;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_CallSalim(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_CallSalim*",false);
			//Voice_Play("Dialogue_AnybodyHere");
			return false;
		}
		
