		void Sticky_1_Detach(const tString &in asStickyArea, const tString &in asBodyName)
        {
		    Prop_SetHealth("Prop_Grab*", 0);
			Entity_Destroy("sticky_blockage_2");
        }	

		//-------------------------------------------------------
		
		void Quake_Stop()
		{
			Light_FadeBrightnessTo("Light_YTH",0,1);
			Debug_Log("LONG SHAKE STOP: "+m_idQuakeShake);
			
			Sound_Stop("Sound_CaveQuake", 3.0f);
			Sound_Stop("Sound_CaveQuakeDebris", 2.0f);
			Sound_Stop("Sound_Rumble", 4.0f);
			
			Sound_Stop("Sound_NoOilCollapse", 2.0f);
			Sound_Stop("Sound_NoOilRumble", 2.0f);
			
			Sound_Stop("Sound_CaveCollapseQuakeLoop", 2.0f);
			Sound_Stop("Sound_CaveCollapseQuakeDebris", 2.0f);
			
			Sound_Stop("Sound_RoarDebris1", 2.0f);
			Sound_Stop("Sound_RoarDebris2", 3.0f);
			
			
			
			

			Sound_CreateAtEntity("Sound_QuakeCollapseFinal1", "01_02_caves/events/collapse/final_collapse", "player");
			Sound_CreateAtEntity("Sound_QuakeCollapseFinal2", "01_02_caves/events/cave_collapse", "player");
			Effect_Shake_FadeOut(m_idQuakeShake,3);
			Map_RemoveTimer("Timer_ExtraShake");
			Music_Stop(10.0f, eMusicPrio_BigEvent);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EndTunnelScareQuake(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_RockImpactFinalTunnel","01_02_caves/quake/quake_3/rock_impact",asParent);
			Effect_Shake_Start(0.09f,1,0.4f,1);
			return false;
		}
		
