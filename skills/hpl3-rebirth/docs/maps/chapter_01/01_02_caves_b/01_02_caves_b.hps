	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	int m_idQuakeShake = -1;
	float mfPlayerRunCount = 0.f;
	bool mbLightLevelBarkAllowed = true;
	float mfDeepShadowLevel = 0.35f;
	bool mbInLight = true;
	
	bool mbLightLevelBarksDelay = true;
 
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	void OnTimer_LightLevelBarksDelay(const tString &in asTimer)
	{
		mbLightLevelBarksDelay = false;
	}
	
	void UpdateLightLevelBarks(float afTimeStep)
	{			
		if (Entity_GetCollide("Fear_Entrance","player") == false)
				return;
				
		if (Voice_CharacterIsSpeaking("Player")) return;
		
		float fLightLevel = Player_GetLightLevel();
		if (mbInLight)
		{	
			if (fLightLevel <= mfDeepShadowLevel)
			{
				if (mbLightLevelBarksDelay) return;
				mbInLight = false;
				
				cLux_AddDebugMessage("HERE");
				
				if (mbLightLevelBarkAllowed) 
					Map_AddTimer("Timer_LeaveLightBarkDelay",9,"OnTimer_LeaveLightBarkDelay");
				
				if (Map_TimerExists("Timer_EnterLightBarkDelay"))
				{
					mbLightLevelBarkAllowed = false;
					Map_RemoveTimer("Timer_EnterLightBarkDelay");
					Map_AddTimer("Timer_ResetLightBarks",5,"OnTimer_ResetLightBarks");
				}
			}
		}
		else
		{
			if (fLightLevel > mfDeepShadowLevel)
			{
				mbInLight = true;
				
				if (mbLightLevelBarkAllowed)
					Map_AddTimer("Timer_EnterLightBarkDelay",2,"OnTimer_EnterLightBarkDelay");
				
				if (Map_TimerExists("Timer_LeaveLightBarkDelay"))
				{
					mbLightLevelBarkAllowed = false;
					Map_RemoveTimer("Timer_LeaveLightBarkDelay");
					Map_AddTimer("Timer_ResetLightBarks",5,"OnTimer_ResetLightBarks");
				}
			}
		}
	}
	
	void OnTimer_EnterLightBarkDelay(const tString &in asTimer)
	{
		if (mbLightLevelBarkAllowed == false) return;
		
		if (Map_TimeHasPassed("LightBark",30))
		{
			float fLightLevel = Player_GetLightLevel();
			if ((fLightLevel>mfDeepShadowLevel)&&(FearHandler_GetRate()<0.1f)&&(!Voice_AnySceneIsActive()))
				Voice_Play("Dialogue_EnteringLightBarks");
		}
	}
	
	//------------------------------------------------------- 
	
	void OnTimer_LeaveLightBarkDelay(const tString &in asTimer)
	{
		if (mbLightLevelBarkAllowed == false) return;
		
		if (Map_TimeHasPassed("DarknessBark",20))
		{
			float fLightLevel = Player_GetLightLevel();
			if ((fLightLevel<mfDeepShadowLevel)&&(!Voice_AnySceneIsActive()))
			{
				if (FearHandler_GetRate()>0.2f)
				{
					OnTimer_HighFearBarkDelay();
				}
				else
				{
					Voice_Play("Dialogue_TooDarkBarks");
				}
			}
		}
	}
	
	//------------------------------------------------------- 
	
	void OnTimer_HighFearBarkDelay(const tString &in asTimer="")
	{
		if (!mbLightLevelBarkAllowed)
			return;
			
		if (Voice_AnySceneIsActive())
			return;
			
		float fLightLevel = Player_GetLightLevel();
		if (fLightLevel>=mfDeepShadowLevel)
			return;
			
		if (FearHandler_GetRate()<0.2f)
			return;
			
		Voice_Play("Dialogue_HighFearBarks");
		Map_AddTimer("Timer_HighFearBarkDelay",cMath_RandRectf(15.0f,25.0f),"OnTimer_HighFearBarkDelay");
	}
	
	//------------------------------------------------------- 
	
	void OnTimer_ResetLightBarks(const tString &in asTimer)
	{
		mbLightLevelBarkAllowed = true;
	}
	
	//------------------------------------------------------- 
	
	void SuppressLightLevelBarks()
	{
		mbLightLevelBarkAllowed = false;
		Map_AddTimer("Timer_ResetLightBarks",10,"OnTimer_ResetLightBarks");
		Map_RemoveTimer("Timer_EnterLightBarkDelay");
		Map_RemoveTimer("Timer_LeaveLightBarkDelay");
	}
	
	
	bool OnCollide_Player_SetPermafailStage(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (asParent == "Trigger_SetPermafail_AfterRift")			mlPermaFailStage = eCavesBPermaFail_AfterRift;
		else if (asParent == "Trigger_SetPermafail_PrettyCaves")	mlPermaFailStage = eCavesBPermaFail_FallPrettyCave;
		else 														mlPermaFailStage = eCavesBPermaFail_Entrance;
			
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_UpdatePlayerRunCount(const tString &in asTimer)
	{
		if (Player_GetRunning())
			mfPlayerRunCount += 0.1f;
		
		if (mfPlayerRunCount >= 2.f)
			return;
		
		Map_AddTimer("Timer_UpdatePlayerRunCount", 0.1f, "OnTimer_UpdatePlayerRunCount");
	}
 
	//-------------------------------------------------------
	
	bool OnCollide_ToggleNightVision(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1) Player_SetNightVisionEnabled(false);
		else if (alState==-1) Player_SetNightVisionEnabled(true);
		return true;
	}
	
