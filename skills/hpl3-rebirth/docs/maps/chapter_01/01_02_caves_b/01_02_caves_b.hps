		// Event A *Player digs through the rubble to reach the Pretty Cave*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 5, Event A here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 5, Event A here.*/
		
		bool OnCollide_Player_DWWhispers(const tString &in asParent, const tString &in asChild, int alState)
		{
			(alState == 1) ? DarkWorldWhispers_Play(1) : DarkWorldWhispers_Stop();
			return true;
		}

		//-------------------------------------------------------
		
		bool OnCollide_Player_ActivateAmulet(const tString &in asParent, const tString &in asChild, int alState)
		{			
			if (alState == 1)
				Amulet_StartTracking(true, "", -1.f);
			else
				Amulet_StopTracking();
				
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnRiftStage_CaveRift(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			Debug_Log("RIFT: "+alStage+" "+afOpenAmount+" "+abOpening);
			
			if (alStage == 0)
			{
				if (!abOpening)
				{
					//Prop_SetActiveAndFade("rift_1_entrance_*",true,1);
					//Prop_SetActiveAndFade("rift_1_exit_*",true,1);
				}
			}
			else if (alStage == 1)
			{
				if (abOpening)
				{
					Rift_CavesShake();
					//Prop_SetActiveAndFade("rift_1_entrance_*",false,1);
					//Prop_SetActiveAndFade("rift_1_exit_*",false,1);
					Prop_SetStaticPhysics("riftrock_irratic_*", false);
					Entity_AddImpulse("riftrock_irratic_*", cVector3f_Down * 0.25, true, true);
					
					Voice_PlayDelayed("Dialogue_OpenRift",2.0f,-1,"OnEndOfVoice_Rift");
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnEndOfVoice_Rift(const tString& in asScene, const tString& in asSubject)
		{
			if (cScript_GetGlobalVarBool("DWL_ReadHerbertsNote"))
				Voice_PlayDelayed("Dialogue_OpenRift_Herbert",2.0f);
			else
				Voice_PlayDelayed("Dialogue_OpenRift_NoHerbert",2.0f);
		}
		
		//-------------------------------------------------------
		
		bool mbRiftShake = false;

		void Rift_CavesShake()
		{
			if (mbRiftShake) return;
			
			Effect_Shake_Start(0.015f,5,0.6f,1.5f);
			
			Sound_CreateAtEntity("Sound_RiftQuake","01_02_caves/quake/quake_3/loop","player");
			Map_AddTimer("Timer_StopRiftShakeLoop",3,"OnTimer_StopRiftShakeLoop");
			
			Map_AddTimer("Timer_RiftRocksCollapse",0.8f,"OnTimer_RiftRocksCollapse");
			
			mbRiftShake = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopRiftShakeLoop(const tString &in asTimer)
		{
			Sound_Stop("Sound_RiftQuake",5.f);
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_RiftRocksCollapse(const tString &in asTimer)
		{
			Prop_SetStaticPhysics("rock_riftcollapse_*",false);
			Entity_AddImpulse("rock_riftcollapse_*",cVector3f(1,1,0),true,true);
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_RiftShakeLayerB_1(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Play("Sound_Quake1_A", 0.0f);
			Sound_CreateAtEntity("Sound_RiftShakeLayerB_1","01_02_caves/quake/quake_1/layer_B","player");
			Effect_Shake_Start(0.015f,2.0f,4.0f,5.0f);
			return false;
		}
		
		bool OnCollide_Player_RiftShakeLayerB_2(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Play("Sound_Quake1_A_1", 0.0f);
			Sound_CreateAtEntity("Sound_RiftShakeLayerB_2","01_02_caves/quake/quake_1/layer_B","player");
			Effect_Shake_Start(0.015f,2.0f,4.0f,5.0f);
			return false;
		}
		
		bool OnTrigger_PlayPrettyCavesQuakeWarning(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_Play("Sound_PrettyCavesQuakeWarning", 0.0f);
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_RiftBigRocksCollapse(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_BigRockLoop","01_02_caves/quake/quake_3/loop","player");
			Map_AddTimer("Timer_StopBigRockLoop",6,"OnTimer_StopBigRockLoop");
			Sound_CreateAtEntity("Sound_BigRockCollapse","01_02_caves/quake/rock_fall","SoundArea_BigRockCollapse");
			Effect_Shake_Start(0.025f,2,2.f,4.f);
			Map_AddTimer("Timer_RiftBigRocksCollapse",0.5f,"OnTimer_RiftBigRocksCollapse");
		
			Sound_Stop("Sound_PrettyCavesQuakeWarning", 4.0f);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopBigRockLoop(const tString &in asTimer)
		{
			Sound_Stop("Sound_BigRockLoop",5.f);
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_RiftBigRocksCollapse(const tString &in asTimer)
		{
			Prop_SetStaticPhysics("bigrock_riftcollapse_*",false);
			Entity_AddImpulse("bigrock_riftcollapse_*",cVector3f(1,1,0),true,true);
		}
		
