	// ==============
	// SCENE 6 *PLAYER FINDS THEIR WAY OUT OF THE CAVES*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		float mfFadeOutLanternBrightness = 0;
		float mfFadeOutLanternT = 0;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 6 here.*/
		
		void OnTimer_TasiIncreaseSpeed_Start(const tString &in asTimer)
		{
			Player_FadeRunSpeedMulTo(0.6f,10);
			Player_SetMoveSpeedMul(0.9f);
			Player_FadeMoveSpeedMulTo(0.6f,10);
		}
		
		//-------------------------------------------------------
		
		//} END General
		
		/////////////////////////////////////////
		// Event A *Player picks up Salim's lantern and opens their way through the dark chamber*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 6, Event A here.*/
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 6, Event A here.*/
		
		void OnInteract_GetLantern(const tString &in asEntity)
		{
			
			if (ItemType_GetCountInInventory("Lantern") > 0)
			{
				Item_RemoveFromInventory(ItemType_GetFirstInInventory("Lantern"));
			}
			
			Entity_SetActive("Blocker_1_*",false);
			Entity_SetActive("BlockerSmall_*",true);			
			Entity_SetInteractionDisabled("Readable_SalimsLastNote",false);
			
			Prop_SetStaticPhysics("Prop_Grab_*",false);
			Entity_SetInteractionDisabled("Prop_Grab_*",false);
			//Entity_SetActive("LensFlare_1",false);
			//Billboard_SetVisible("Billboard_Lantern_*",false);
			//LensFlare_SetVisible("LensFlare_1",false);
			
			Hint_StopHint();
			Map_AddTimer("Timer_LanternAmount",0.1f,"OnTimer_LanternAmount");
			
			Map_AddTimer("Timer_ShowLanternHint", 3.f, "OnTimer_ShowLanternHint");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LanternAmount(const tString &in asTimer)
		{
			Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 5);
			Map_AddTimer("Timer_RefillOil",1,"OnTimer_RefillOil");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RefillOil(const tString &in asTimer)
		{
			if (Item_GetFullness(ItemType_GetFirstInInventory("Lantern")) <= .2f)
			{
				Lantern_ForceFlicker(1);
				Lantern_SetAmount(2);
			}
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ForceCaveCollapse(const tString &in asTimer)
		{
			if (mbCaveCollapse) return;
			if (Entity_GetCollide("player","Trigger_SalimArea")) 
			{
				Map_RestartCurrentTimer(2);
				return;
			}
			
			Voice_StopAll();
			Entity_SetActive("Trigger_CaveCollapse_*",false);
			Seq_CavesCollapse("");
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_CaveWarningCollapse(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_WarningQuake1","01_02_caves/quake/quake_3/loop","player");
			Effect_Shake_Start(0.015f,1.7f,0.6f,1.2f);
			Map_AddTimer("Timer_CaveWarningCollapseStop",1,"OnTimer_CaveWarningCollapseStop");
			Entity_SetActive("Soundscape_Salim",false);
			return false;
		}
		
		//------------------------------------------------------- 
				
		bool OnCollide_Player_CaveWarningCollapse_2(const tString &in asParent, const tString &in asChild, int alState)
		{
			Sound_CreateAtEntity("Sound_WarningQuake2","01_02_caves/quake/quake_3/loop","player");
			Sound_Play("Sound_Quake2_A", 0.0f);
			Sound_CreateAtEntity("Sound_WarningQuake3","01_02_caves/quake/quake_2/layer_B","player");
			Effect_Shake_Start(0.015f,1.8f,0.6f,1.2f);
			Map_AddTimer("Timer_CaveWarningCollapseStop",1,"OnTimer_CaveWarningCollapseStop");
			Entity_SetActive("Soundscape_Salim",false);
			return false;
		}
		
		//------------------------------------------------------- 
		
		void OnTimer_CaveWarningCollapseStop(const tString &in asTimer)
		{
			Sound_Stop("Sound_WarningQuake1",5);
			Sound_Stop("Sound_WarningQuake2",5);
			Sound_Stop("Sound_WarningQuake3",5);
		}
				
		//-------------------------------------------------------
		
		bool OnCollide_Player_CaveCollapse(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (ItemType_GetCountInInventory("Lantern") == 0) return true;
			if (mbCaveCollapse) return true;
			
/*			Player_SetMoveSpeedMul(0.f);
			cLux_GetPlayer().AutomoveCharBodyTo(100000.f, 10.f, 3.f, Map_GetEntity("PosArea_WalkBack_1").GetPosition());
			Map_AddTimer("Timer_StopAutomove",1,"OnTimer_StopAutomove");*/
			Seq_CavesCollapse("");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopAutomove(const tString &in asTimer)
		{
			cLux_GetPlayer().StopAutomoveCharBody();
			Player_FadeMoveSpeedMulTo(1,4);
		}
		
		//-------------------------------------------------------
		
		int m_idTrail = -1;
		
		cSequenceStatesData mSequenceCavesCollapse;
		void Seq_CavesCollapse(const tString &in asTimer)
		{
			Sequence_Begin("Seq_CavesCollapse", mSequenceCavesCollapse);
			if (Sequence_DoStepAndWait(0.4))
			{	
				//Player_FadeNightVisionStrength(1.f,1);
				Player_FadeNightVisionStrength(0,0.3f);
				FearArea_SetSafe("Fear_Salim",false);
				Entity_SetActive("Fear_Salim",false);
				
				//Light_FadeBrightnessTo("Light_Spot_10",0,1);
				//Light_FadeBrightnessTo("lantern_light_sh_7",0,3);
				//Light_FadeBrightnessTo("lantern_light_sh_16",0,3);
				Entity_SetActive("DummyFlesh*",false);
				Entity_SetActive("Blocker_2",true);
				Entity_SetActive("Blocker_Backtrack",true);
				Entity_SetActive("Trigger_Shimmy*",false);
				Prop_SetStaticPhysics("Prop_Collapse_*",false);
				Entity_AddImpulse("Prop_Collapse_*",cVector3f(1,1,0),true,true);

				ShadowFlesh_Spawn("DummyFlesh_*","",1,3,true);

				Sound_Play("Sound_ShadowDebris", 1.0f);
				Sound_Play("Sound_Roar_1", 1.0f);
				Sound_Play("Sound_Roar_2", 1.0f);
				Sound_CreateAtEntity("Sound_RoarDebris1", "01_02_caves/events/shadow_roar/shadow_roar_debris_02", "player");
				Sound_CreateAtEntity("Sound_RoarDebris2", "01_02_caves/events/collapse/first_impact", "player");
				Music_Play("A2_1_2_ShadowRoar.ogg", 0.6f, false, eMusicPrio_MinorEvent);
				
				Map_AddTimer("Timer_MoreShadowFlesh",2.6f,"OnTimer_MoreShadowFlesh");
				Map_AddTimer("Timer_MusicCaveQuake", 9.0f, "OnTimer_MusicPlayCaveQuake");
				
				Lamp_SetLit("torch_pilgrim_wood_5",false,true);
				Light_FadeBrightnessTo("torch_salim_light_*",0,3);
				//Light_FadeBrightnessTo("Light_EscapeSupport",0.2f,1);
				//Entity_SetActive("torch_pilgrim_wood_dummy",true);
				//Lamp_SetLit("torch_pilgrim_wood_5",false,true);
				//Light_FadeBrightnessTo("SalimTorch_*",0,2);
				
				mbCaveCollapse = true;
			}
			else if (Sequence_DoStepAndWait(5.6f))
			{
				Debug_Log("2");
				FearHandler_SetForcedAddFearRate(0.2f,12);
				ParticleSystem_SetActive("PS_Collapse_*",true);
				Voice_StopAll();
				Voice_PlayDelayed("Dialogue_TasiGetsHerShitTogether",0.8f);
				
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				m_idTrail = Effect_ImageTrail_Start(1,5,9000,100);
				m_idQuakeShake = Effect_Shake_Start(0.008f,100000,0.6f,100);
				Map_AddTimer("Timer_ExtraShake",3,"OnTimer_ExtraShake");
				Sound_Play("Sound_QuakeStartDebris_1", 1.0f);
				Sound_Play("Sound_QuakeStartDebris_2", 1.0f);
				Sound_CreateAtEntity("Sound_CaveCollapseQuakeLoop", "01_02_caves/quake/quake_3/loop", "player");
				Sound_CreateAtEntity("Sound_CaveCollapseQuakeDebris", "01_02_caves/quake/quake_3/rock_sweet", "player");
				
			}
			Sequence_End();
		}
			
		//-------------------------------------------------------
		
		void OnTimer_MoreShadowFlesh(const tString &in asTimer)
		{
			Lantern_ForceFlicker(9);
			ShadowFlesh_Spawn("DummyFlesh2_*","",1,3,true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ExtraShake(const tString &in asTimer)
		{
			float fRand = cMath_RandRectf(0,1);
			Effect_Shake_Start(0.06f,cMath_RandRectf(0.6f,2),0.4f,1);
			Map_RestartCurrentTimer(cMath_RandRectf(8,15));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MusicPlayCaveQuake(const tString &in asTimer)
		{
			Music_Stop(3.0f, eMusicPrio_MinorEvent);
			Music_PlayExt("A2_1_2_CaveRumble.ogg", true, 0.6f, 1.0f, 3.0f, 1.0f, eMusicPrio_BigEvent, false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_NoMoreOil(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (ItemType_GetCountInInventory("Lantern") == 0) return true;
			if (!mbCaveCollapse) return true;
			
			
			Sound_CreateAtEntity("Sound_NoOilCollapse","01_02_caves/events/collapse/rock_collapse",asParent);
			Sound_CreateAtEntity("Sound_NoOilRumble","01_02_caves/events/collapse/quake_rumble",asParent);
			Effect_Shake_Start(0.09f,1,0.4f,1);
			Entity_SetActive("Blocker_3_*",true);
			Lantern_ForceFlicker(2);
			//Sound_CreateAtEntity("Sound_LanternOff","player/tools/lantern/lantern_burn","player");
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_InTunnel(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Blocker_5*",true);
			Sound_CreateAtEntity("Sound_InTunnelCollapse","01_02_caves/events/collapse/rock_collapse",asParent);
			Sound_CreateAtEntity("Sound_InTunnelRumble","01_02_caves/events/collapse/quake_rumble",asParent);
			Effect_Shake_Start(0.09f,1,0.4f,1);
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_OutTunnel(const tString &in asParent, const tString &in asChild, int alState)
		{
			Lantern_ForceFlicker(6);
			Sound_CreateAtEntity("Sound_OutTunnelCollapse","01_02_caves/events/collapse/rock_collapse",asParent);
			Sound_CreateAtEntity("Sound_OutTunnelRumble","01_02_caves/events/collapse/quake_rumble",asParent);
			Effect_Shake_Start(0.09f,1,0.4f,1);

			Prop_SetStaticPhysics("Prop_FinalCollapse_1*",false);
			Entity_AddImpulse("Prop_FinalCollapse_1*",cVector3f(1,1,0),true,true);
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_CaveIn(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_CavesCaveIn("");
			
			if (mfPlayerRunCount < 2.f)
			{
				Hint_StopHint();
				Hint_ShowHint_Hold("Hints", "HintRun", true, 1.5f, false, 10.f);
			}
			
			return false;
		}
		
		//------------------------------------------------------- 
		
		cSequenceStatesData mSequenceCavesCaveIn;
		void Seq_CavesCaveIn(const tString &in asTimer)
		{
			Sequence_Begin("Seq_CavesCaveIn", mSequenceCavesCaveIn);
			if (Sequence_DoStepAndWait(1))
			{	
				Sound_CreateAtEntity("Sound_BoulderShift1","01_02_caves/events/collapse/boulder_slide","Prop_CaveIn_1");
				Effect_Shake_Start(0.09f,1,0.4f,1);
				Prop_AlignRotation("Prop_CaveIn_1","Prop_CaveInTarget_1",1,1,0.3f,false);
				Prop_MoveLinearTo("Prop_CaveIn_1","Prop_CaveInTarget_1",3,2,0.1f,false);
				ParticleSystem_CreateAtEntity("rock_collapse", "rock_collapse_light.ps", "rock_collapse_light_origin_1", false);
			}
			if (Sequence_DoStepAndWait(1.1))
			{	
				Prop_AlignRotation("Prop_CaveIn_2","Prop_CaveInTarget_2",2,1,0.1f,false);
				Prop_MoveLinearTo("Prop_CaveIn_2","Prop_CaveInTarget_2",4,2,0.1f,false);
				Sound_CreateAtEntity("Sound_BoulderShift2","01_02_caves/events/collapse/boulder_slide","Prop_CaveIn_2");
			}
			if (Sequence_DoStepAndWait(0.1))
			{	
				Prop_AlignRotation("Prop_CaveIn_3","Prop_CaveInTarget_3",2,1,0.1f,false);
				Prop_MoveLinearTo("Prop_CaveIn_3","Prop_CaveInTarget_3",4,2,0.1f,false);
				Sound_CreateAtEntity("Sound_BoulderShift3","01_02_caves/events/collapse/boulder_slide","Prop_CaveIn_3");
			}
			if (Sequence_DoStepAndWait(1))
			{	
				Prop_AlignRotation("Prop_CaveIn_4","Prop_CaveInTarget_4",2,1,0.1f,false);
				Prop_MoveLinearTo("Prop_CaveIn_4","Prop_CaveInTarget_4",4,2,0.1f,false);
				ParticleSystem_CreateAtEntity("rock_collapse", "rock_collapse_light.ps", "rock_collapse_light_origin_2", false);
				Sound_CreateAtEntity("Sound_BoulderShift4","01_02_caves/events/collapse/boulder_slide","Prop_CaveIn_4");
			}
			Sequence_End();
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_LanternShimmer(const tString &in asParent, const tString &in asChild, int alState)
		{
			Lantern_ForceFlicker(2);

			Effect_Shake_Start(0.09f,1,0.4f,1);
			Prop_SetStaticPhysics("Prop_UltimateCollapse_*",false);
			Entity_AddImpulse("Prop_UltimateCollapse_*",cVector3f(1,1,0),true,true);
			
			Light_FadeBrightnessTo("Light_Exit_*",0,1);
			
		    ParticleSystem_CreateAtEntity("rock_collapse", "rock_collapse.ps", "rock_collapse_final_origin", false);
			
			//Prop_SetActiveAndFade("bigrock_3",true,1);
			cFogArea@ pFogArea = cLux_GetCurrentMap().GetWorld().GetFogArea("FogArea_8");
			pFogArea.SetVisible(false);
			
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_Trapped(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_PlayerTrappedInCaves("");
			return false;
		}
		
		//------------------------------------------------------- 
		
		cSequenceStatesData mSequencePlayerTrappedInCaves;
			
		void Seq_PlayerTrappedInCaves(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PlayerTrappedInCaves", mSequencePlayerTrappedInCaves);
			if (Sequence_DoStepAndWait(0.1f))
			{
				Quake_Stop();
				//Sound_CreateAtEntity("Sound_Damage","player/foley/damage/player_hit","player");
				Seq_HitByDebris("");
				//Player_GiveDamage(0.1,0.9,eDamageType_Fall,"");	
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Player_SetMoveSpeedMul(0);
				Player_SetRunSpeedMul(0.3f);
				Player_SetCrouching(true,true,true);
				Player_SetStandDisabled(true);
				Player_SetJumpDisabled(true);
				Player_FadeNightVisionStrength(0.01f,2);
				
				Lantern_SetAmount(0);
				Map_RemoveTimer("Timer_RefillOil");
				//Item_Unequip(ItemType_GetFirstInInventory("Lantern"),true);
				//PlayerBody_PlayCutsceneAtEntity("knocked_out_by_debris_in_place","PosArea_Fall",false,1);
				Billboard_SetVisible("Billboard_LanternObscured", true);
				
				//Sound_Play("Sound_Roar_3", 0.0f);
				Player_FadeNightVisionStrength(0.075f,1);	
				
				Sound_CreateAtEntity("Sound_LanternOff","player/tools/lantern/lantern_ignite","player");
				ParticleSystem_CreateAtEntity("rock_collapse", "rock_collapse.ps", "rock_collapse_final_origin_2", false);
				ParticleSystem_CreateAtEntityExt("rock_collapse", "sand_falling_after_collapse.ps", "collapse_scene_dust_origin", false, cColor(0.717,0.677,0.588,1), 0.3f, false, 1, 2, 100, 110);

				Prop_SetActiveAndFade("Blocker_7*",true,1);
				Prop_SetActiveAndFade("Blocker_9*",true,1);
				Entity_SetActive("Prop_FinalCollapse_1*",false);
				Entity_SetActive("Lantern_Collapse",true);
				//Entity_SetEffectsActiveExt("",false,true,1,2);
				Light_FadeBrightnessTo("lantern_collapse_light_*",6.0f,0.5);
				//Light_SetFlickerActive("lantern_collapse_light_spot",true);
			}
			else if (Sequence_DoStepAndWait(11.0f))
			{
				Seq_CollapseLantern("");
				Effect_Shake_Start(0.015f,0.6f,0.4f,1);
				
				PlayerBody_GetAnimationState("die_fall").SetPaused(true);
			}
			else if (Sequence_DoStepAndWait(28.6))
			{
				Map_RemoveTimer("Timer_ExtraShake");
				// LOW POINT
				Prop_SetActiveAndFade("Blocker_SmallRocks*",true,1);
				Voice_StopAll();
				Voice_Play("Dialogue_TasiLowPoint");
			}
			else if (Sequence_DoStepAndWait(2))
			{
				// HIGH POINT
				Entity_SetActive("Lantern_Collapse",false);
				Billboard_SetVisible("Billboard_LanternObscured", false);
				
				// Show arms and bracelet again
				SetArmsVisible(true);
	
				PlayerBody_PlayCutsceneAtEntity("wake_up_from_death_4_crouch","PosArea_GetUp",false,0.3f);
				Voice_StopAll();
				Voice_Play("Dialogue_TasiTurningPoint", -1, "OnTurningPointPart1Played");
				Light_FadeBrightnessTo("Light_Exit_*",0,1);
				Effect_ImageTrail_FadeOut(m_idTrail,3);
			}
			else if (Sequence_DoStepAndWait(12))
			{
				Player_SetMoveSpeedMul(0.3f);
				Player_FadeMoveSpeedMulTo(0.5f,6);
				Player_FadeNightVisionStrength(0.3f,4);	
				Player_SetStandDisabled(false);
				Map_AddTimer("Timer_CheckTriesLantern",0.1,"OnTimer_CheckTriesLantern");
			}
			else if (Sequence_DoStepAndWait(2))
			{
				Map_AddTimer("Timer_DisableBlocker",0,"OnTimer_DisableBlocker");
			}
			Sequence_End();
		}
		
		cSequenceStatesData mSequenceCollapseLantern;
			
		void Seq_CollapseLantern(const tString &in asTimer)
		{
			Sequence_Begin("Seq_CollapseLantern", mSequenceCollapseLantern);
			if (Sequence_DoStepAndWait(1.0f))
			{
			}
			if (Sequence_DoStepAndWait(3.62f))
			{
				mfFadeOutLanternBrightness = 6.0f;
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Player_FadeNightVisionStrength(0.0f,3);	
			}
		}
		
		//-------------------------------------------------------
		
		// Hack to hide arms during fall anim
		void SetArmsVisible(bool abVisible)
		{
			GhoulProgression_SetArmsVisible(abVisible);
			Entity_SetActive("Amulet_Bracelet", abVisible);
			Entity_SetActive("CurseMedallion_*_Accessory", abVisible);
		}
		
		//-------------------------------------------------------
		
		int mlBlurID = -1;
		
		cSequenceStatesData mSequenceHitByDebris;
			
		void Seq_HitByDebris(const tString &in asTimer)
		{
			Sequence_Begin("Seq_HitByDebris", mSequenceHitByDebris);
			if (Sequence_DoStepAndWait(0.3f))
			{
				Light_FadeBrightnessTo("Light_Point_DebrisSupport",0.5f,0.3);
				Player_FadeLookSpeedMulTo(0.f, 0.3f);
			 
				Entity_PlaceAtEntity("PosArea_HitByDebris", "player", cVector3f(0.f, 1.8f, 0.f) + Player_GetForward() * 5.f, false);
				Player_StartLookAt("PosArea_HitByDebris", 10.f, 5.f, 5.f);
			}
			else if (Sequence_DoStepAndWait(0.4f))
			{
				Item_PutAway(eItemHandlerHand_Left);
				Item_PutAway(eItemHandlerHand_Right);
		 
				Player_StopLookAt(1.f);
				
				PlayerBody_PlayCutsceneAtEntity("die_fall","PosArea_Fall",false,1);
				//PlayerBody_PlayCutsceneAnimation("die_fall", false, 0.3f); //die_fall
				
				Entity_SetActive("HeadDebris", true);
				Entity_SetCollide("HeadDebris", false);
				Entity_SetCollideCharacter("HeadDebris", false);
				
				Entity_PlaceAtEntity("HeadDebris", "player", cVector3f(0.f, 1.5f, 0.f) + Player_GetForward() * 0.75f, false);
				Entity_LookAtEntity("HeadDebris", "player");
				
				Body_AddImpulse("HeadDebris_Body_1", cVector3f(0.f, -2.f, 0.f), false);
				
				Sound_CreateAtEntity("SoundAnteRoofDebris1", "03_03_herberts_hq/level_complete_events/vitae_complete/vitae_complete_debris_roof", "player");
				Sound_CreateAtEntity("SoundAnteDustDebris2", "03_03_herberts_hq/level_complete_events/vitae_complete/vitae_complete_debris", "player");
            }
			else if (Sequence_DoStepAndWait(0.2f))
			{
				mlBlurID = Effect_Blur_Start(1,0.1f);
				
				// Hide arms and amulet
				SetArmsVisible(false);
			
				//Player_GiveDamage(0.1,0.9,eDamageType_Default,"");
				FearHandler_SetForcedAddFearRate(0.f, 0.f, false, -1.f, 10.f);
				Effect_Fade_Out(0.2f);
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 0);
				Sound_CreateAtEntity("Sound_KnockedOut", "player/foley/damage/player_fall_death", "player");
			}
            else if (Sequence_DoStepAndWait(1.5f))
            {				 
				//cLux_GetPlayer().SetActive(false);
				//FearHandler_SetPaused(true);
				Light_FadeBrightnessTo("Light_Point_DebrisSupport",0,0);
				//Entity_SetActive("SlabChamberRoo*", false);
				Entity_SetActive("HeadDebris", false);
				
				
				//Entity_SetActive("FearScaryObject_ShadowFlesh_AnteChamber_*", false);
				//Entity_SetActive("FearScaryObject_ShadowFlesh_Collapsed_*", true);
				
				//Sound_FadeGlobalVolume(0.f, 1.f, eSoundEntryType_World);
				//Music_StopAll(1.f);
            }
			else if (Sequence_DoStepAndWait(0))
			{
				Effect_Blur_FadeOut(mlBlurID,5);
				Effect_Fade_In(1.2f);
				Player_FadeLookSpeedMulTo(1.f, 0.6f);
				//Player_SetCrouching(true, true, true);				 
				//Player_SetMoveSpeedMul(1.f);
				//Player_SetLookSpeedMul(1.f);
				//Player_SetStandDisabled(false);
			}
			Sequence_End();
		}
		
		//------------------------------------------------------- 
		
		void OnTurningPointPart1Played(const tString&in asScene, const tString&in asSubject)
		{
			if (cScript_GetGlobalVarBool("Caves_ReadSalimsLastNote"))
				Voice_Play("Dialogue_TasiTurningPoint_ReadLetter", -1, "OnTurningPointMidPlayed");
			else
				Voice_Play("Dialogue_TasiTurningPoint_Part2");
		}
		
		//------------------------------------------------------- 
		
		void OnTurningPointMidPlayed(const tString&in asScene, const tString&in asSubject)
		{
			Voice_Play("Dialogue_TasiTurningPoint_Part2");
		}
			
		//------------------------------------------------------- 
		
		bool mbWaitingForReEquip = false;
		void OnTimer_CheckTriesLantern(const tString &in asTimer)
		{
			if (mbWaitingForReEquip == false && Voice_AnySceneIsActive() == false && 
				Item_GetHeldType(eItemHandlerHand_Left) == "Lantern")
			{
				Voice_PlayDelayed("Dialogue_TasiTriesDeadLantern", 2.0f);
				return;
			}
			
			if (Voice_AnySceneIsActive() && Item_GetHeldType(eItemHandlerHand_Left) == "Lantern")
				mbWaitingForReEquip = true;
			else if (mbWaitingForReEquip && Item_GetHeldType(eItemHandlerHand_Left) != "Lantern")
				mbWaitingForReEquip = false;
				
			Map_RestartCurrentTimer(0.2f);
		}
			
		//------------------------------------------------------- 
		
		bool mbAllowBlockerRemoval = false;
		void OnTimer_DisableBlocker(const tString &in asTimer)
		{
			if (Entity_IsInPlayerFOV("Blocker_SmallRocks") || 
				Voice_SubjectIsPlaying("Dialogue_TasiTurningPoint") || 
				Voice_SubjectIsPlaying("Dialogue_TasiTurningPoint_ReadLetter") || 
				Voice_SubjectIsPlaying("Dialogue_TasiTurningPoint_Part2") || 
				Entity_GetCollide("Player", "Trigger_DisableBlockerRemoval"))
			{
				//cLux_AddDebugMessage("Restarting OnTimer_DisableBlocker");
				Map_RestartCurrentTimer(0.1f);
				mbAllowBlockerRemoval = false;
				return;
			}
			
			// Delay the rock removal for a bit longer to prevent it feeling like it happening the instant you look away
			if (mbAllowBlockerRemoval == false)
			{
				//cLux_AddDebugMessage("Blocker Removal pending...");
				mbAllowBlockerRemoval = true;
				Map_RestartCurrentTimer(2.0f);
				return;
			}
			
			//cLux_AddDebugMessage("Removing blockers!");
			Entity_SetActive("BigTest_*",true);
			Entity_SetActive("Blocker_SmallRocks*",false);
			Entity_SetActive("Prop_UltimateCollapse_*",false);
			Entity_SetActive("Trigger_YTHLight",true);
			Entity_SetActive("Trigger_YTHGoAway",true);
			Light_FadeBrightnessTo("Light_Point_1",0.1f,1,eEasing_SineInOut);
	
			Entity_SetActive("yth_light", true);			 

			Sound_CreateAtEntity("Sound_THAppear", "creatures/foley/creature/tin_hinan/appear", "yth_light");
			Entity_SetEffectsActive("yth_light", true, true);
			
			Light_FadeBrightnessTo("Light_Exit_spot*",0,6);
			//Sound_CreateAtEntity("Sound_Collapse","01_02_caves/quake/quake_3/rock_impact","yth_light");
			Entity_SetInteractionDisabled("Prop_FinalRocks*",false);

		}
		
		//------------------------------------------------------- 

		void OnLookAt_YTHLight(const tString &in asEntity, int alState)
		{
			Prop_SetActiveAndFade("yth_light",true,1);
			Entity_SetEffectsActiveExt("yth_light",true,true,2,4);
			Voice_PlayDelayed("Dialogue_TasiSeesTheLight",1);
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_YTHGoAway(const tString &in asParent, const tString &in asChild, int alState)
		{
			Prop_MoveLinearTo("yth_light","yth_light_target",0.3f,2,1,false,"");
			Prop_AlignRotation("yth_light","yth_light_target",0.3f,2,1,false,"");
			Sound_CreateAtEntity("Sound_THMovement", "creatures/foley/creature/tin_hinan/body_sound", "yth_light");
			return false;
		}
		
		//------------------------------------------------------- 
		
		void OnInteract_SmallRocks_StaticPhysicsOff(const tString &in asEntity)
		{
			Prop_SetStaticPhysics("Prop_FinalRocks*",false);
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_LightsOn(const tString &in asParent, const tString &in asChild, int alState)
		{
			Light_FadeBrightnessTo("Light_Exit_*",1,4);
			Light_FadeBrightnessTo("Light_YTH",0,3);
			Light_FadeBrightnessTo("Light_Point_1",0,3.0f);
			Sound_Stop("Sound_THMovement", 1.f);
			Sound_CreateAtEntity("Sound_GhostDisappear","creatures/foley/creature/tin_hinan/disappear","yth_light");
			Entity_SetEffectsActiveExt("yth_light",false,true,2,2);
			Player_SetJumpDisabled(false);
			Player_FadeMoveSpeedMulTo(0.7f,3);
			//Prop_SetActiveAndFade("bigrock_3",true,1);
			cFogArea@ pFogArea = cLux_GetCurrentMap().GetWorld().GetFogArea("FogArea_8");
			pFogArea.SetVisible(true);
			return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_Relief(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Dialogue_TasiEscapes");
			return false;
		}
		
