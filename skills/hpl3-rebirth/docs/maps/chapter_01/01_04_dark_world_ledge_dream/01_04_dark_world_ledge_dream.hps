	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("01-04-dark-world-ledge-dream");
		
		Pregnancy_SetStage(ePregStage_Unknown);
		Pregnancy_SetBarksActive(false);
		Pregnancy_SetBabyKicksEnabled(false);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_Unknown);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_Ill);
		Player_SetAllowCheckBaby(false);
		FearHandler_SetWhisperStage(eFearWhisperStage_StartToSalim);
		
		// Set up color grading etc.
		Map_Preset_SetupDirLight("Darkness", false, cColor(1,0.664,0.865), 1.f, cVector3f(-0.861, -0.177, 0.477), cColor(0,0,0), cColor(0,0,0));
		Map_Preset_SetupDirLight("Sunlight", true, cColor(1,0.664,0.865), 1.f, cVector3f(-0.861, -0.177, 0.477), cColor(0.2,0.2,0.15), cColor(0.3,0.3,0.25));
		
		StruggleFlashHandler_SetActive(false);
		
		Player_SetAutoTeleportWhenBelowAltitude(-4);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		//ParticleSystem_Preload("dust_large_long_oneshot.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(2);
		// Any general setup of script / entities
		
		Map_Preset_Fade("Darkness", 0.05f);
		
		Light_FadeBrightnessTo("Light_MirrorDoorBack", 0, 0.1);
		Light_FadeBrightnessTo("Light_MirrorDoorBackSpot", 0, 0.1);
		
		/////////////////////////
		// Blur Fx Init
		Entity_AttachToSocket("BlurFX_Baby", "Baby_Room", "Head_Socket", false, false);
		Entity_AttachToSocket("BlurFX_Salim_1", "Salim", "Head_Socket", false, false);
		
		//////////////
		// Setup Salim
		Entity_PlayAnimation("Salim", "sit_by_the_crib", 0.1f, true);

		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			Timer_EndFall("");
			
			if (ItemType_GetCountInInventory("Lantern") < 1)
			{
				Item_AddToInventory("Lantern");		
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
				Item_AddToInventory("HerbertOil");
				Item_AddToInventory("HerbertOil");
				Item_AddToInventory("HerbertOil");
			}
			
			Item_AddToInventory("Matchbook");
			Item_AddToInventory("Matchbook");
			Item_AddToInventory("Matchbook");
			
			if (ItemType_GetCountInInventory("Orb") < 1)
			{
				Item_AddToInventory("Orb");
			}
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		PlayerBody_SetModel("player.ent");
		PlayerBody_SetActive(true);
		FearHandler_SetActive(false);
		DreamHandler_SetActive(true);
        Player_SetVertigoActive(false);
        Pregnancy_SetBabyKicksEnabled(false);
		Player_SetNightVisionEnabled(false);
		Heat_SetActive(false);
		
		cVector3f vRot = cVector3f(0, cMath_ToRad(180), 0);
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);
		
		StartFallSequence();
		Voice_SetSource("Salim", "Area_SalimTarget", 5, 25, true);
			
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave(){}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource){}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("DEAD : SOURCE = " + asSource);
		
		if (asSource == "SomeReason")
		{
			Effect_Fade_Out(1.0f);
			return true; // return true to completely override base behaviour
		}
		
		// return false for default behaviour
		return false;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{
		// return false for default behaviour (fadeout and death area)
		return false;
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test0)
		{
			OnTimer_OpenTheDoor("");
		}
		
		if(alAction == eAction_Test2)
		{
			mbPlayerSawSalim = true;
			mbPlayerEnterRoom = true;
			Entity_SetActive("cave_tunnel_*", false);
			Entity_SetActive("Ceiling_Intro_*", true);
			Voice_StopAll();
			
			if (SequenceStates_IsActive("Seq_SalimFadeAway")==false && mbSalimFadedAway==false)
				Seq_SalimFadeAway("");
				
			if (SequenceStates_IsActive("Seq_BabyFadeAway")==false)
				Seq_BabyFadeAway("");
			
			if (SequenceStates_IsActive("Seq_RoomBreakApart")==false && bRoomBreakingStarted==false)
					Seq_RoomBreakApart("");
		}
		
		if(alAction == eAction_Test3)
		{
			Entity_SetActive("Sky_Infant", true);
		}
		
		if (alAction == eAction_Test4)
		{
			Player_Teleport("Start_OutOfBounds");
		}
		/*
		if (alAction == eAction_Test5)
		{
			SetBabyVoiceMode(-1);
		}
		
		if(alAction == eAction_Test0)
		{
			Map_ChangeMap("01_02_caves_b.hpm", "Start_Begin", "", "", false);
		}
		
		if (alAction==eAction_Test9)
		{
			
		}*/
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
