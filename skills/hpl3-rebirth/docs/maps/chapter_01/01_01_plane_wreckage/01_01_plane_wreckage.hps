			Player_FadeMoveSpeedMulTo(gfWreckagePlayerMoveSpeedMul, 5.f);
			Player_FadeRunSpeedMulTo(gfWreckagePlayerRunSpeedMul, 5.f);
			Player_FadeLookSpeedMulTo(1.f, 5.f);
			
			StartCrashMicroFlashes();
		}
		
