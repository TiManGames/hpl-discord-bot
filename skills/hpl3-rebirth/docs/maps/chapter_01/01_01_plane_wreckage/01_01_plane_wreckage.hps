	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	//-------------------------------------------------------
	
	int mlCrashMicroflashCount = 0;
	bool mbAllowCrashMicroflashes = false;
	bool mbPlayerInsidePlane = true;
	bool mbReachedScorchingHeat = false;
	bool mbHeatIntroPlayed = false;
	bool mbCrashMicroflashActive = false;
	bool mbShowUseItemHint = false;
	cVector3f mvPrevPlayerPos = 0.f;
	bool mbScorpionScareDone = false;
 
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	void Update(float afTimeStep)
	{
		UpdatePlaneLighting(afTimeStep);
	}
	
	//-------------------------------------------------------
	
	void StartCrashMicroFlashes()
	{
		mbAllowCrashMicroflashes = true;
		OnTimer_CheckIfShouldPlayCrashMicroflash("");
	}
	
	//-------------------------------------------------------
	
	void DelayCrashMicroflashes()
	{
		Map_RemoveTimer("Timer_CrashMicroflashActive");
		Map_AddTimer("Timer_CrashMicroflashActive", cMath_RandRectf(9.f, 12.f), "");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_CheckIfShouldPlayCrashMicroflash(const tString &in asTimer)
	{
		bool bPlay = false;
		
		if (Entity_GetCollide("player", "Area_CrashMicroflashes"))
		{
			cVector3f vDir = Map_GetEntity("Area_CrashMicroflashes").GetPosition() - Player_GetCameraPosition();
			float fDist = vDir.Length();
			float fDot = cMath_Vector3Dot(cMath_Vector3Normalize(vDir), cLux_GetPlayer().GetCamera().GetForward());
			
			cVector3f vPos = Player_GetPosition();
			float fDistToPrevPos = (vPos - mvPrevPlayerPos).Length();
			
			if (fDistToPrevPos > 0.1f && (fDot > -0.1f || fDist < 20.f))
				bPlay = true;
				
			mvPrevPlayerPos = vPos;
		}
		
		if (bPlay)
			PlayCrashMicroflash();	
			
		Map_AddTimer("Timer_CheckIfShouldPlayCrashMicroflash", 1.f, "OnTimer_CheckIfShouldPlayCrashMicroflash");			
	}
	
	//-------------------------------------------------------
	
	void PlayCrashMicroflash()
	{
		if (cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Read)
			return;
		if (mbAllowCrashMicroflashes == false)
			return;
		if (Voice_AnySceneIsActive())
			return;
		if (Map_TimerExists("Timer_PlayCrashMicroflash"))
			return;
		if (Map_TimerExists("Timer_CrashMicroflashActive"))
			return;
		if (Sketchbook_IsFlashbackActive())
			return;
		if (mbPlayedMassonDialogue == false)
		{
			float fDist = Entity_GetDeltaToEntity("player", "Trigger_MassonMicroflash").Length();
			if (fDist < 15.f && Entity_IsInPlayerFOV("Trigger_MassonMicroflash"))
				return;
		}
		
		//////////////
		// No more microflashes available?
		if (Voice_SubjectHasUnplayedLines("Microflashes_TheCrash") == false)
		{
			mbAllowCrashMicroflashes = false;
			Map_RemoveTimer("Timer_CheckIfShouldPlayCrashMicroflash");
			return;
		}
		
		mlCrashMicroflashCount++;
		mbAllowCrashMicroflashes = false;
		mbCrashMicroflashActive = true;
		
		Map_AddTimer("Timer_PlayCrashMicroflash", 1.f, "OnTimer_PlayCrashMicroflash");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_PlayCrashMicroflash(const tString  &in asTimer)
	{
		Sketchbook_Microflash("Microflashes_TheCrash", "OnVoiceOver_CrashMicroflash");
	}
	
	//-------------------------------------------------------
	
	void OnVoiceOver_CrashMicroflash(const tString &in asScene, const tString &in asSubject)
	{		
		Voice_PlayWhenPossible("Dialogue_MemoriesOfTheCrash", "", -1.f, 1.f);
		
		mbAllowCrashMicroflashes = true;
		
		Map_AddTimer("Timer_CrashMicroflashActive", cMath_RandRectf(6.f, 9.f), "");
		Map_AddTimer("Timer_CrashMicroflashOver", 2.f, "OnTimer_CrashMicroflashOver");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_CrashMicroflashOver(const tString &in asTimer)
	{
		mbCrashMicroflashActive = false;
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SlideOnSand(const tString &in asParent, const tString &in asChild, int alState)
	{
		Player_SetSlidingActive(alState == 1, Entity_GetVarFloat(asParent, ""));
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTakeOutItem(const tString &in asItemType, const tString &in asItemID)
	{
		if (asItemType == "PlaneDoorHandle")
		{
			mbAllowInventoryHint = false;
			//Entity_SetActive("Trigger_CockpitHint", false);
			Entity_SetActive("InteractArea_PlaneDoorHandle", true);
			
			if (mbShowUseItemHint)
			{
				mbShowUseItemHint = false;
					
				Hint_StopHint();
				
				Map_RemoveTimer("Timer_ShowInventoryHint");
				Map_AddTimer("Timer_ShowUseItemHint", 0.5f, "OnTimer_ShowUseItemHint");
			}
		}
	}
	
	//-------------------------------------------------------
	
	void OnPutAwayItem(const tString &in asItemType, const tString &in asItemID)
	{
		if (asItemType == "PlaneDoorHandle")
		{
			Entity_SetActive("InteractArea_PlaneDoorHandle", false);
			Hint_StopHint();
			
			Map_AddTimer("Timer_ShowInventoryHint", 5.f, "OnTimer_ShowInventoryHint");
			mbShowUseItemHint = true;
			//Map_SetTimerUserVarInt("Timer_ShowUseItemHint", 1);
		}
	}
	
	//-------------------------------------------------------
	
	void OnHeatLevelChange(int alLevel)
	{
		if (alLevel == eHeatLevel_Scorching)
		{
			mbReachedScorchingHeat = true;
			
			if (Voice_SubjectHasUnplayedLines("Dialogue_HeatIntro"))
			{
				Voice_AbortIfQueued("Dialogue_HeatIntro");
				Voice_PlayWhenPossible("Dialogue_HeatIntro", "VoiceCondition_HeatBarks", -1.f, 5.f, "OnVoiceEnd_HeatIntro");
			}
			else
			{
				//Voice_AbortIfQueued("Dialogue_HeatBarks");
				//Voice_PlayWhenPossible("Dialogue_HeatBarks", "VoiceCondition_HeatBarks", 10.f, 10.f, "");
			}
		}
		else if (alLevel <= eHeatLevel_Hot)
		{
			if (mbReachedScorchingHeat)
			{
				//Voice_AbortIfQueued("Dialogue_ShadeBarks");
				//Voice_PlayWhenPossible("Dialogue_ShadeBarks", "VoiceCondition_ShadeBarks", 10.f, 2.f);
			}
		}
	}
	
	//-------------------------------------------------------
	
	bool VoiceCondition_HeatBarks(const tString &in asSubject)
	{
		bool bRet = cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Read &&
					Heat_InShadow() == false &&
					Heat_GetHeatLevel() >= eHeatLevel_VeryHot && 
					Map_TimerExists("Timer_PlayShout") == false &&
					mbCrashMicroflashActive == false;
		
		if (bRet)
			DelayCrashMicroflashes();
		
		return bRet;
	}
	
	//-------------------------------------------------------
	
	bool VoiceCondition_ShadeBarks(const tString &in asSubject)
	{		
		bool bRet = cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Read &&
					mbHeatIntroPlayed &&
					mbReachedScorchingHeat &&
					mbLookingAtCaveEntrance == false && 
					Heat_InShadow() && 
					Map_TimerExists("Timer_ShadeBark") == false &&
					mbCrashMicroflashActive == false;
		
		if (bRet)
		{
			DelayCrashMicroflashes();
			Map_AddTimer("Timer_ShadeBark", 15.f, "");
		}			
		
		return bRet;
	}
	
	//-------------------------------------------------------
	
	void OnVoiceEnd_HeatIntro(const tString &in asScene, const tString &in asSubject)
	{
		mbHeatIntroPlayed = true;
		
		Hint_StopHint();
		Hint_ShowHint_Hold("Hints", "HintHeat", false, 1.5f, true, 10.f);
	}
	
	//-------------------------------------------------------
	
	void OnSketchbookStateChange(int alState)
	{									
		if (cLux_ScriptDebugOn())
			return;
			 
		if (alState == -1 && mbIntroOver == false)
		{
			mbIntroOver = true;
			
			Player_ChangeStateToNormal();	
			PlayerBody_PlayCutsceneAtEntity("player_wake_up_seq_end", "Area_WakeUpAnim", false, 0.3f, "OnAnimEnd_StandUp", 1.f, 0.f, 0.f, 0.f, true, false, true);			
			
			Voice_StopAll();
			Voice_PlayDelayed("Dialogue_ReadSketchbook", 1.f);
		}
		
		if (alState == -1 && mbShowingNotesHint)
		{
			mbShowingNotesHint = false;
			Hint_StopHint();
		}
	}
	 
	//-------------------------------------------------------
	
	void OnInteract_ReleaseScorpion(const tString &in asEntity)
	{
		if (mbScorpionScareDone) return;
		mbScorpionScareDone = true;
		
		bool bCandyBoxEvent = asEntity == "can_food_desert_1";
		
		tString sScorpionEnt = bCandyBoxEvent ? "critter_scorpion_1" : "critter_scorpion_2";
		Entity_SetActive(sScorpionEnt, true);
		
		tString sDustPSTemplate = bCandyBoxEvent ? "dust_impact_small_oneshot.ps" : "dust_impact_simple_oneshot.ps";
		ParticleSystem_CreateAtEntity(asEntity+"_dust", sDustPSTemplate, asEntity, false);
		
		Map_AddTimer(sScorpionEnt, 10, "OnTimer_DisableScorpion");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DisableScorpion(const tString&in asTimer)
	{
		if (Entity_IsInPlayerFOV(asTimer))
		{
			Map_AddTimer(asTimer, 1, "OnTimer_DisableScorpion");
			return;
		}
		
		Entity_SetActive(asTimer, false);
	}
	
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 1 *THE PLAYER WAKES UP AND FINDS LAUDANUM AND THE SKETCHBOOK*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 1 here.*/
		
		bool mbIntroOver = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 1 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A *Tasi wakes up*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event A here.*/
		
		int mlWakeUpImageTrailId = -1;
		bool mbGrabbedLaudanum = false;
		float mfAtBottleCount = 0.f;
		cVector2f mvChairCameraRotation = 0.f;
		cVector3f mvStandUpStartPos = 0.f;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event A here.*/
		
		cSequenceStatesData mSeqDataWakeUp;
		void Seq_WakeUp(const tString &in asTimer)
		{
			Sequence_Begin("Seq_WakeUp", mSeqDataWakeUp);
			if (Sequence_DoStepAndWait(0.1f))
			{
				Effect_Fade_Out(0.f);
				Sound_FadeGlobalVolume(1.f, 5.0f, eSoundEntryType_All);
				Sound_FadeGlobalVolume(0.f, 0.f, eSoundEntryType_World);
				
				Player_ChangeStateToNormal();
				//cLux_GetPlayer().SetActive(false);
				Player_PlaceAtEntity("Area_WakeUpAnim", true, false);
				
				Sketchbook_SetInventoryEnabled(false);
			}
			else if (Sequence_DoStepAndWait(3.9f))
			{
				cLux_GetPlayer().SetActive(false);
			}
			else if (Sequence_DoStepAndWait(0.75f))
			{
				StruggleFlashHandler_DoFlash(0.15f,0.0f);		
			}
			else if (Sequence_DoStepAndWait(4.f))
			{				
				OnVoiceEnd_PreWakeUp("", "");
			}
			else if (Sequence_DoStepAndWait(0.9f))
			{
				Sound_FadeInGui("prototype/tools/player_pencil_loop", 1.f, 1.f);
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				StruggleFlashHandler_DoFlash(0.15f,0.0f);		
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				Sound_StopGui("prototype/tools/player_pencil_loop", 1.f);
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				StruggleFlashHandler_DoFlash(0.15f,0.0f);		
			}
			else if (Sequence_DoStepAndWait(8.25f))
			{
				StruggleFlashHandler_DoFlash(0.25f,0.0f);		
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				StruggleFlashHandler_DoFlash(0.25f,0.0f);	
			}
			else if (Sequence_DoStepAndPause(0.0f))
			{
				// Backup in case some hickup makes dialog complete before pausing
				if (Voice_SubjectHasUnplayedLines("Dialogue_PreWakeUp")==false)
					SequenceStates_Resume("Seq_WakeUp");

				StruggleFlashHandler_DoFlash(0.15f,0.0f);	
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				StruggleFlashHandler_DoFlash(0.35f,0.0f);	
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				FearHandler_SetActive(true);
				FearHandler_FadeLevelTo(1.f, 0.f, true);
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				cLux_GetPlayer().SetActive(true);
				Struggle_StartAnimation("Area_WakeUpAnim", "player_struggle_wake_up_normal_loop", 
										"player_struggle_wake_up_struggle_loop", "player_struggle_wake_up_start", "player_struggle_wake_up_end", true, "", 
										"OnStruggleEnd_WakeUp", "OnStruggleEnd_WakeUp", "OnAnimEnd_StruggleOutro", 20.f, false, 0.1f, 1.f, false, 0.f, false);
				
				Struggle_SetFlashesActive(false);
				Struggle_SetDisallowStruggleTime(13.f);
				
				Sound_CreateAtEntity("Sound_WakeStinger", "01_01_wreckage/wake/stinger", "player");
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				Sound_FadeGlobalVolume(1.f, 0.1f, eSoundEntryType_World);
				Music_PlayExt("A2_1_1_Crash_Wake.ogg", true, 0.3f, 1.0f, 4.0f, 1.0f, eMusicPrio_BgAmb, false);
			}
			else if (Sequence_DoStepAndWait(1.25f))
			{
				Player_Disorient(99999999.f, true);				
				
				Effect_Fade_In(0.35f);
				mlWakeUpImageTrailId = Effect_ImageTrail_Start(1.75f, 0.f, -1.f, 0.f);
				
				FearHandler_SetForcedAddFearRate(1.f, 1000000.f, false);
			}
			else if (Sequence_DoStepAndWait(10.f))
			{				
				FearHandler_PlayStruggleSoundLoop(12.0f, 0.3f, false);
				Voice_Play("Scene_TasiWakesUp");
				Map_AddTimer("Timer_PlayStruggleMicroflashes", 11.f, "OnTimer_PlayStruggleMicroflashes");
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				FearHandler_PlayStruggleSoundLoop(0.75f, 0.75f, false);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Hint_StopHint();
				Hint_ShowHint("Hints", "HintStruggle", true, 1.5f, false);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Struggle_SetFlashesActive(true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_PreWakeUp(const tString &in asScene, const tString &in asSubject)
		{	
			if (Voice_SubjectHasUnplayedLines("Dialogue_PreWakeUp") == false)
			{
				SequenceStates_Resume("Seq_WakeUp");
				return;
			}

			Voice_PlayDelayed("Dialogue_PreWakeUp", 0.1f, -1, "OnVoiceEnd_PreWakeUp");	
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayStruggleMicroflashes(const tString &in asTimer)
		{			
			if (mbGrabbedLaudanum)
				return;
			
			Voice_Play("Microflashes_FightIt",-1,"OnVoiceEnd_FightIt");
			//Sketchbook_Microflash("Microflashes_FightIt", "OnVoiceEnd_FightIt");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_FightIt(const tString &in asScene, const tString &in asSubject)
		{
			Map_AddTimer("Timer_PlayStruggleMicroflashes", 4.f, "OnTimer_PlayStruggleMicroflashes");
		}
		
		//-------------------------------------------------------
		
		void OnStruggleEnd_WakeUp()
		{					
			FearHandler_StopStruggleSoundLoop(3.0f);
				
			FearHandler_FadeLevelTo(0.6f, 1.f, true);
			FearHandler_SetForcedAddFearRate(0.7f, 1000000.f, false);
			
			SequenceStates_Resume("Seq_WakeUp");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_StruggleOutro(const tString &in asAnim)
		{					
			Player_SetLookSpeedMul(0.2f);
			
			Map_AddTimer("Timer_ShowCrawlHint", 1.f, "OnTimer_ShowCrawlHint");
			
			PlayerBody_FadeCutsceneMaxPitch(12.f, 2.f);
			PlayerBody_FadeCutsceneMaxYaw(12.f, 2.f);
			
			PlayerBody_AddInteractiveAnimationCheckpoint(0.1f);
			PlayerBody_AddInteractiveAnimationCheckpoint(4.f);
			PlayerBody_AddInteractiveAnimationCheckpoint(6.8f);
			PlayerBody_AddInteractiveAnimationCheckpoint(9.5f);
			PlayerBody_AddInteractiveAnimationCheckpoint(11.933f);
			
			PlayerBody_SetInteractiveAnimationInteractCallback("OnInteract_Laudanum");
			PlayerBody_PlayInteractiveAnimationAtEntity("player_wake_up_seq_crawl", "Area_WakeUpAnim", 0.f, "", false, false, false, 1.f, false, false, true, false);
			PlayerBody_SetCustomYawBoneAxis(cVector3f(0.f, 0.f, -1.f));
			
			Map_AddTimer("Timer_CheckIfAtBottle", 0.1f, "OnTimer_CheckIfAtBottle");
			Map_AddTimer("Timer_RaiseFear", 0.1f, "OnTimer_RaiseFear");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowCrawlHint(const tString &in asTimer)
		{
			Hint_ShowHint("Hints", "InteractiveAnimationCrawl", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RaiseFear(const tString &in asTimer)
		{
			if (PlayerBody_GetAnimationState("player_wake_up_seq_crawl").GetTimePosition() < 8.f)
			{
				Map_RestartCurrentTimer();
				return;
			}
			
			FearHandler_FadeLevelTo(1.f, 2.f, true);
			FearHandler_SetForcedAddFearRate(1.f, 1000000.f, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckIfAtBottle(const tString &in asTimer)
		{
			if (mbGrabbedLaudanum)
				return;
				
			if (PlayerBody_GetAnimationState("player_wake_up_seq_crawl").GetRelativeTimePosition() > 0.95f)
			{
				mfAtBottleCount += 1.f;
				if (mfAtBottleCount >= 4.f)
				{
					Hint_ShowHint("Hints", "HintInteract", true, 1.5f, false);
					return;
				}
				
				Map_AddTimer("Timer_CheckIfAtBottle", 1.f, "OnTimer_CheckIfAtBottle");
			}
			else
			{
				mfAtBottleCount = 0.f;
				Map_AddTimer("Timer_CheckIfAtBottle", 0.1f, "OnTimer_CheckIfAtBottle");
			}
		}
				
		//-------------------------------------------------------
		
		void OnInteract_Laudanum(const tString &in asEntity)
		{
			if (asEntity != "Trigger_LaudanumInteract")
				return;
			
			mbGrabbedLaudanum = true;
			Entity_SetActive("Trigger_LaudanumInteract", false);
			
			Map_RemoveTimer("Timer_PlayStruggleMicroflashes");
			
			PlayerBody_FadeCutsceneMaxPitch(10.f, 2.f);
			PlayerBody_FadeCutsceneMaxYaw(10.f, 2.f);
			PlayerBody_PlayCutsceneAtEntity("player_wake_up_seq_pick_up_bottle", "Area_WakeUpAnim", false, 0.3f, "OnAnimEnd_PickUpLaudanum", 1.f, 0.f, 0.f, 0.f, true, false, true);
			
			Entity_PlayAnimation("Laudanum", "bottle_wake_up_seq_pick_up_bottle", 0.3f, false);
			Map_GetEntity("Laudanum", eLuxEntityType_Prop).GetCurrentAnimationState().SetSpeed(1.f);
			
			Map_AddTimer("Timer_PlayLaudanumEmote", 1.25f, "OnTimer_PlayLaudanumEmote");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayLaudanumEmote(const tString &in asTimer)
		{
			Voice_StopAll();
			Voice_Play("Emote_TasiPicksUpBottle");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_PickUpLaudanum(const tString &in asTimer)
		{
			Sketchbook_UnlockMemory("TakeTheMedicine", true, "OnMemoryEnd_DrinkLaudanum");
		
			PlayerBody_PlayCutsceneAtEntity("player_wake_up_seq_look_at_bottle_loop", "Area_WakeUpAnim", true, 0.3f, "", 1.f, 0.f, 0.f, 0.f, true, false, true);
			Entity_PlayAnimation("Laudanum", "bottle_wake_up_seq_look_at_bottle_loop", 0.3f, true);
			
			Map_AddTimer("Timer_ResetYawBones", 2.f, "OnTimer_ResetYawBones");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetYawBones(const tString &in asTimer)
		{
			PlayerBody_ResetCustomYawBoneAxis();
		}
		
		//-------------------------------------------------------
		
		void OnMemoryEnd_DrinkLaudanum(const tString &in asScene, const tString &in asSubject)
		{
			Map_AddTimer("Timer_DrinkLaudanum", 2.f, "OnTimer_DrinkLaudanum");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DrinkLaudanum(const tString &in asTimer)
		{			
			PlayerBody_PlayCutsceneAtEntity("player_wake_up_seq_drink_and_sit_up_", "Area_WakeUpAnim", false, 0.3f, "OnAnimEnd_DrinkLaudanum", 1.f, 0.f, 0.f, 0.f, true, false, true);
			Entity_PlayAnimation("Laudanum", "bottle_wake_up_seq_drink_and_sit_up_", 0.3f, false);
			Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimMessage_DrinkLaudanum", true);
			
			Map_AddTimer("Timer_SwitchLaudanumBottle", 10.f, "OnTimer_SwitchLaudanumBottle");
			
			Voice_PlayDelayed("Emote_TasiDrinks", 2.f);
		}
		
		//-------------------------------------------------------
		
		void OnAnimMessage_DrinkLaudanum(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			Map_AddTimer("Timer_LowerFearEffects", 1.0f, "OnTimer_LowerFearEffects");
			
			PlayerEmotion_PlaySound(eEmotionPlaylistType_Breathing, eEmotionSoundType_OneShotEvent, 2, "player/emotes/drink", -1, 0, 0);
			
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LowerFearEffects(const tString &in asTimer)
		{
			FearHandler_FadeLevelTo(0.f, 5.0f, true);
			FearHandler_SetForcedAddFearRate(1.f, 0.1f, false, -1.f, 0.5f);
			
			Effect_ImageTrail_FadeOut(mlWakeUpImageTrailId, 10.f);
			
			Map_AddTimer("Timer_TasiRecovers", 6.5f, "OnTimer_TasiRecovers");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SwitchLaudanumBottle(const tString &in asTimer)
		{
			Entity_SetActive("Laudanum", false);
			Entity_SetActive("Laudanum_PostCutscene", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TasiRecovers(const tString &in asTimer)
		{
			cLux_AddDebugMessage("OnTimer_TasiRecovers");
			Music_Stop(5.0f, eMusicPrio_BgAmb);
			Music_PlayExt("A2_1_1_Tasi_Calmed.ogg", false, 0.3f, 1.f, 0.3f, 0.3f, eMusicPrio_MinorEvent, false);
			Sound_Play("Sound_CabinSand_*", 8.0f);
			Sound_Play("Sound_DebrisSweet_*", 8.0f);
			
			Voice_StopAll();
			Voice_PlayDelayed("Dialogue_TasiRecovers", 2.f, -1);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_DrinkLaudanum(const tString &in asAnim)
		{			
			cLux_AddDebugMessage("OnAnimEnd_DrinkLaudanum");
			PlayerBody_SetInteractiveAnimationInteractCallback("OnInteract_Sketchbook");
			PlayerBody_PlayInteractiveAnimationAtEntity("player_wake_up_seq_sit_loop", "Area_WakeUpAnim", 0.3f, "", false, false, false, 1.f, false, true, true);
			
			PlayerBody_SetCutsceneAutoResetCamera(false);
			PlayerBody_FadeCutsceneMaxPitch(50.f, 10.f);
			PlayerBody_FadeCutsceneMaxYaw(50.f, 10.f);
			
			mvChairCameraRotation = cVector2f(Playerbody_GetCutscenePitch(), Playerbody_GetCutsceneYaw());
			Map_AddTimer("Timer_ShowLookAroundHint", 4.f, "OnTimer_ShowLookAroundHint");
			
			Player_FadeLookSpeedMulTo(gfWreckagePlayerLookSpeedMul, 1.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowLookAroundHint(const tString &in asTimer)
		{		
			if (mbShowedInteractHint == false)
				Entity_SetPlayerLookAtCallback("Sketchbook","OnLookAt_ShowInteractHint",true,true,true,1,4.5f);
				
			if (mvChairCameraRotation == cVector2f(Playerbody_GetCutscenePitch(), Playerbody_GetCutsceneYaw()))
			{
				Hint_ShowHint_Hold("Hints", "HintLookAround", true,1.5f,false);
				Map_RestartCurrentTimer(1);
			}
			else
			{
				Hint_StopHint();
			}
		}
		
		//------------------------------------------------------- 
		
		bool mbShowedInteractHint = false;
		
		void OnLookAt_ShowInteractHint(const tString &in asEntity, int alState)
		{
			if (mbShowedInteractHint) return;
			
			Hint_StopHint();
			Hint_ShowHint_Hold("Hints", "HintInteract", true, 1.5f, false);
			mbShowedInteractHint = true;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_Sketchbook(const tString &in asEntity)
		{
			if (asEntity != "Sketchbook")
				return;
			
			mbShowedInteractHint = true;
			Hint_StopHint();
			Entity_SetActive("Sketchbook", false);			
			Map_AddTimer("Timer_OpenSketchbook", 0.2f, "OnTimer_OpenSketchbook");
		}
		
		//-------------------------------------------------------
		
		void SetUpSketchbook()
		{
			cScript_SetGlobalArgString(0, "nameplate_projection_plane");
			cScript_SetGlobalArgString(1,"DrawGuiSketchbookCover");
			cScript_SetGlobalArgVector2f(2, cVector2f(258,128));
			cScript_RunGlobalFunc("Sketchbook", "", "_Global_SetUpGui");
		}
		
		//-------------------------------------------------------
		
		void DrawGuiSketchbookCover(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetAlignment(eImGuiAlign_CenterCenter);
			ImGui_GroupBegin(ImGui_NrmPosGroup(0.0,0.0,0.5), ImGui_NrmSizeGroup(1));
			Sketchbook_RenderBookCoverLabel();
			ImGui_GroupEnd();
		}
	
		//-------------------------------------------------------
		
		void OnTimer_OpenSketchbook(const tString &in asTimer)
		{
			Player_ChangeStateToNormal();
			Sketchbook_Open(false);
			Sketchbook_SetState(eSketchbookState_Ideas);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_StandUp(const tString &in asAnim)
		{					
			Map_AddTimer("Timer_SetupPlayerSpeed", 0.05f, "OnTimer_SetupPlayerSpeed");
			Entity_SetInteractionDisabled("plate_airplane_1", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetupPlayerSpeed(const tString &in asTimer)
		{
			Player_FadeLookSpeedMulTo(gfWreckagePlayerLookSpeedMul, 1.f);
			Player_FadeMoveSpeedMulTo(0.7f, 0.01f);
			
			mvStandUpStartPos = Player_GetFeetPosition();
			Map_AddTimer("Timer_ShowMoveAroundHint", 4.f, "OnTimer_ShowMoveAroundHint");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowMoveAroundHint(const tString &in asTimer)
		{
			if (mvStandUpStartPos == Player_GetFeetPosition())
				Hint_ShowHint("Hints", "HintMoveAround", true);
		}

		//-------------------------------------------------------

		//} END Event A *Tasi wakes up*
	 
	//} END SCENE 1
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 2 *THE PLAYER EXPLORES THE PLANE*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 2 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 2 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
		
		/////////////////////////////////////////
		// Event A *Hear the PLANE RADIO*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event A here.*/
		
		int mlNextRadioLineId = -1;
		bool mbInteractedWithRadio = false;
		bool mbRadioCallStarted = false;
		bool mbRadioCallOver = false;
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event A here.*/
		
		bool OnTrigger_Player_StumbleTowardsRadio(const tString &in asParent, const tString &in asChild, int alState)
		{
			cVector3f vDir = Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward();
			if (cMath_Vector3Dot(Player_GetForward(), vDir) > 0.3f)			
			{
				PlayerBody_PlayCutsceneAtEntity("plane_stumble", "Area_PlaneStumble", false, 0.3f);
				PlayerBody_SetCutsceneMaxPitch(15.f);
				PlayerBody_SetCutsceneMaxYaw(15.f);
				
				Sound_CreateAtEntity("Sound_PlayerStumble", "01_01_wreckage/animations/cockpit_stumble", "player");
			}
						
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartRadioCall(const tString &in asParent, const tString &in asChild, int alState)
		{				
			StartRadioCall();
			return false;
		}
		
		//-------------------------------------------------------
		
		void StartRadioCall()
		{
			if (mbRadioCallStarted)
				return;
			
			mbRadioCallStarted = true;
						
			Lamp_SetLit("RadioLamp", true, true);
			Sound_Play("Sound_RadioElectricity", 0.f);
			Sound_Play("Sound_Radio", 0.f);
			
			Map_AddTimer("Timer_PlayRadioLine", 1.f, "OnTimer_PlayRadioLine");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayRadioLine(const tString &in asTimer)
		{			
			++mlNextRadioLineId;
			Voice_Play("Radio_TheDoctor", -1, "OnVoiceOver_RadioLine");
			if (mlNextRadioLineId == 0)
				Voice_PlayDelayed("Dialogue_TasiNearsRadio", 3.0f);
		}
		
		//-------------------------------------------------------
		
		void OnVoiceOver_RadioLine(const tString &in asScene, const tString &in asSubject)
		{			
			if (Voice_SubjectHasUnplayedLines("Radio_TheDoctor") == false)
			{
				Map_RemoveTimer("Timer_RadioLampFlicker");
				
				Lamp_SetLit("RadioLamp", false, true);
				Sound_Stop("Sound_Radio", 1.f);
				Sound_Stop("Sound_RadioElectricity", 2.0f);
				
				mbRadioCallOver = true;
				ResetHotPlaneDialogue(30.f);
				
				Map_AddTimer("Timer_RadioFinal", 600.0f, "OnTimer_PlayRadioFinal");
				return;
			}
			
			float fTime = mlNextRadioLineId == 0 ? 8.f : cMath_RandRectf(5.f, 7.f);
			Map_AddTimer("Timer_PlayRadioLine", fTime, "OnTimer_PlayRadioLine");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayRadioFinal(const tString &in asTimer)
		{
			Lamp_SetLit("RadioLamp", true, true);
			Sound_Play("Sound_RadioElectricity", 0.f);
			Sound_Play("Sound_Radio", 0.f);
			
			Voice_Play("Radio_TheDoctor_Final", -1, "OnVoiceOver_RadioFinal");
			OnTimer_RadioLampFlicker("Timer_RadioLampFlicker");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceOver_RadioFinal(const tString &in asScene, const tString &in asSubject)
		{
			Map_RemoveTimer("Timer_RadioLampFlicker");
				
			Lamp_SetLit("RadioLamp", false, true);
			Sound_Stop("Sound_Radio", 1.f);
			Sound_Stop("Sound_RadioElectricity", 2.0f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableRadio(const tString  &in asTimer)
		{			
			Map_AddTimer("Area_RadioSparks", 0.05f, "OnTimer_DoRadioSparks");
			Sound_Play("Sound_RadioSpark", 0.0f);
			
			if (mbRadioCallOver == false)
			{
				Lamp_SetFlickerActive("RadioLamp", false);
				OnTimer_RadioLampFlicker("Timer_RadioLampFlicker");
				Map_AddTimer("Timer_ResetRadioLamp", 0.5f, "OnTimer_ResetRadioLamp");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoRadioSparks(const tString &in asTimer)
		{
			ParticleSystem_CreateAtEntity("PS_RadioSparks_1", "sparks_smaller.ps", asTimer, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RadioLampFlicker(const tString &in asTimer)
		{
			Lamp_SetLit("RadioLamp", Lamp_GetLit("RadioLamp") == false, false);
			Map_AddTimer("Timer_RadioLampFlicker", cMath_RandRectf(0.05f, 0.1f), "OnTimer_RadioLampFlicker");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetRadioLamp(const tString  &in asTimer)
		{
			Map_RemoveTimer("Timer_RadioLampFlicker");
			
			Lamp_SetLit("RadioLamp", true, true);
			Lamp_SetFlickerActive("RadioLamp", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayHotPlaneDialogue(const tString &in asTimer)
		{
			Voice_PlayWhenPossible("Barks_TooHotInPlane", "VoiceCondition_HotPlane", -1.f, 5.f, "OnVoiceOver_HotPlane");
		}
		
		//-------------------------------------------------------
		
		bool VoiceCondition_HotPlane(const tString &in asSubject)
		{
			if (mbPlayerInsidePlane == false || mbRadioCallOver == false)
			{
				Voice_AbortIfQueued("Barks_TooHotInPlane");
				return false;
			}
			
			return mbCrashMicroflashActive == false && cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal;
		}
		
		//-------------------------------------------------------
		
		void OnVoiceOver_HotPlane(const tString &in asScene, const tString &in asSubject)
		{
			ResetHotPlaneDialogue(cMath_RandRectf(15.f, 25.f));
		}
		
		//-------------------------------------------------------
		
		void ResetHotPlaneDialogue(float fTime)
		{
			Map_RemoveTimer("Timer_PlayHotPlaneDialogue");
			Map_AddTimer("Timer_PlayHotPlaneDialogue", fTime, "OnTimer_PlayHotPlaneDialogue");			
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Hear the PLANE RADIO*
		
		/////////////////////////////////////////
		// Event B *Try to answer the radio call*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event B here.*/
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event B here.*/
		
		void OnInteract_Radio(const tString &in asEntity)
		{
			if (Map_TimeHasPassed("Timer_RadioSparks", 4.f) && (Lamp_GetLit("RadioLamp") || mbInteractedWithRadio == false))
				Map_AddTimer("Timer_DisableRadio", 0.2f, "OnTimer_DisableRadio");
			
			if (mbInteractedWithRadio == false)
			{
				Voice_Stop("Comments");
				
				if (mbRadioCallOver == false)
					Voice_PlayDelayed("Dialogue_TasiTriesBrokenRadio", 0.5f, -1, "OnVoiceEnd_TryRadio");		
				else
					Voice_PlayDelayed("Dialogue_TasiExaminesRadio", 0.5f);
			}
			
			mbInteractedWithRadio = true;				
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_TryRadio(const tString &in asScene, const tString &in asSubject)
		{
			Voice_PlayDelayed("Dialogue_TasiExaminesRadio", 0.1f);
		}
		
		//-------------------------------------------------------
		
		//} END Event B *Try to answer the radio call*
		
		/////////////////////////////////////////
		// Event C *Open the COCKPIT DOOR*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event C here.*/
		
		bool mbLimitedRadioLines = false;
		bool mbDesertDialoguePlayed = false;		
		float mfStartExposure = 0.f;
		float mfDoorFogAlpha = 1.f;		
		float mfDoorFogAlphaGoal = 1.f;
		float mfDirLightBrightness = 1.f;
		float mfDirLightBrightnessGoal = 1.f;
		float mfStartDirLightBrightness = 1.f;
		float mfDoorEffectSpeed = 0.2f;
		bool mbDoInitialDoorEffects = true;
		bool mbAllowInventoryHint = true;		
		int mlDoorInteractCount = 0;
		tID m_idPlaneFogId = tID_Invalid;
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event C here.*/
		
		void OnInteract_PlaneDoor(const tString &in asEntity)
		{
			if (Entity_IsActive("PlaneDoorHandle") &&
				Voice_SceneInvolvingCharacterIsActive("Player") == false)
			{
				Voice_PlayDelayed("Dialogue_TryDoor", 0.5f);	
			}
			
			++mlDoorInteractCount;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_PlaneDoorHandle(const tString &in asEntity)
		{
			Entity_SetActive("Trigger_CockpitHint", true);
			
			Hint_StopHint();
			Map_AddTimer("Timer_ShowInventoryHint", 0.5f, "OnTimer_ShowInventoryHint");
			
			Sketchbook_SetInventoryEnabled(true);
			
			mbShowUseItemHint = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowInventoryHint(const tString &in asTimer)
		{			
			Hint_ShowHint("Hints", "HintInventory", true, 100.f, false);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_EnterCockpit(const tString &in asParent, const tString &in asChild, int alState)
		{			
			if (alState == -1)
			{
				Hint_StopHint();
			}
			else
			{
				if (SwingDoor_GetBlocked("PlaneDoor") == false)
					return false;
				
				if (Item_GetHeldType() == "PlaneDoorHandle")
					Map_AddTimer("Timer_ShowUseItemHint", 0.5f, "OnTimer_ShowUseItemHint");		
				else
					Hint_ShowHint("Hints", "HintInventory", true, 100.f, false);								
			}
				
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowUseItemHint(const tString &in asTimer)
		{		
			if (SwingDoor_GetBlocked("PlaneDoor") == false)
				return;
	
			int lVar = Map_GetTimerUserVarInt(asTimer);
			bool bAddAsGiven = lVar == 1;
			float fTimeMul = lVar == 1 ? 1.5f : 5.f;
			Hint_ShowHint("Hints", "HintUseEquippedItem", true, fTimeMul, bAddAsGiven);
		}
		
		//-------------------------------------------------------
		
		bool CanUse_PlaneDoorHandle(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
        {
			return asPickedEntity == "PlaneDoor";
        }
         
        //-------------------------------------------------------
         
        bool OnUse_PlaneDoorHandle(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, 
								   const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
        {
			if (Hint_GetCurrentEntry() == "HintUseEquippedItem")
				Hint_StopHint();
			
			Item_Unequip(asItemID);
			Item_RemoveFromInventory(asItemID);
			
			Entity_SetActive("InteractArea_PlaneDoorHandle", false);
			
			SwingDoor_SetBlocked("PlaneDoor", false, true);
			Entity_SetActive("PlaneDoorHandle_Attached", true);			
			Prop_AlignRotation("PlaneDoorHandle_Attached", "PlaneDoorHandle_Attached_Target", 10.f, 5.f, 0.25f, false, "", "InteractArea_PlaneDoorHandle");			
			
			Billboard_SetVisible("Door_billboard", false);
			
			Sound_CreateAtEntity("Sound_PlacePlaneDoorHandle", "01_01_wreckage/events/handle_attach", "PlaneDoorHandle_Attached");
            return false;
        }

		//-------------------------------------------------------
		
		bool OnTrigger_Player_PlaneDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1)
			{
				Map_RemoveTimer(asParent);
				return true;
			}			
			
			Map_AddTimer(asParent, 0.05f, "OnTimer_EnterOrExitPlane");
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnterOrExitPlane(const tString &in asTimer)
		{
			float fOpenAmount = SwingDoor_GetOpenAmount("PlaneDoor");
			if (fOpenAmount < 0.5f || cLux_GetPlayer().GetCharacterBody().GetFeetPosition().y > 17.f)
			{
				Map_RestartCurrentTimer();
				return;
			}
			
			bool bInFront = Entity_PlayerIsInFront(asTimer);
			bool bMovingFwd = cLux_GetPlayer().GetCharacterBody().GetMoveSpeed(eCharDir_Forward) > 0.75f;
			cVector3f vTriggerFwd = Map_GetEntity("Trigger_PlaneDoor").GetMatrix().GetTranspose().GetForward();
			float fLookDot = cMath_Vector3Dot(Player_GetForward(), vTriggerFwd);
			
			if (bInFront && bMovingFwd && fLookDot < -0.5f)
			{
				Player_ChangeStateToNormal();
				
				SetupLighting(false);
				PlayerBody_PlayCutsceneAtEntity("player_exit_plane", "Area_ExitPlaneAnim", false, 0.3f, "OnAnimEnd_ExitPlane");
				PlayerBody_SetCutsceneMaxPitch(10.f);
				PlayerBody_SetCutsceneMaxYaw(10.f);
				
				Sound_CreateAtEntity("Sound_Exit", "01_01_wreckage/animations/wreckage_exit", "player");
				Entity_SetActive("Soundscape_Plane",false);
				Sound_Stop("Sound_CabinSand_*", 2.0f);
				Sound_Stop("Sound_DebrisSweet_*", 2.0f);
				Sound_Play("Sound_WingCloth", 2.0f);
				
				if (mbHeatActivated)
					Heat_SetActive(true, 0.3f, false, false, true);
				
				if (mbRadioCallOver == false)
				{
					Sound_Fade("Sound_Radio", 0.2f, 1.f);
					Voice_FadeSceneVolumeTo("Radio", 0.2f, 1.f);
				}
				return;
			}
			else if (bInFront == false && bMovingFwd && fLookDot > 0.5f)
			{
				Player_ChangeStateToNormal();
				
				SetupLighting(true);
				PlayerBody_PlayCutsceneAtEntity("player_enter_plane", "Area_EnterPlaneAnim", false, 0.3f, "OnAnimEnd_EnterPlane");
				PlayerBody_SetCutsceneMaxPitch(10.f);
				PlayerBody_SetCutsceneMaxYaw(10.f);
				
				Entity_SetActive("Soundscape_Plane",true);
				Sound_CreateAtEntity("Sound_Enter", "01_01_wreckage/animations/wreckage_enter", "player");
				Sound_Play("Sound_CabinSand_*", 3.0f);
				Sound_Play("Sound_DebrisSweet_*", 3.0f);
				Sound_Stop("Sound_Cloth", 2.0f);
				
				if (mbHeatActivated)
					Heat_SetActive(false);
				
				if (mbRadioCallOver == false)
				{
					Sound_Fade("Sound_Radio", 1.f, 0.5f);
					Voice_FadeSceneVolumeTo("Radio", 1.f, 1.f);
				}
				return;				
			}
			
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void SetupLighting(bool abInside, bool abFirstTime = false)
		{
			if (abInside)
			{
				mfDoorFogAlphaGoal = 1.f;			
				mfDoorEffectSpeed = 0.1f;
				mfDirLightBrightnessGoal = mfStartDirLightBrightness;
				
				Effect_ToneMapping_FadeExposure(0.f, 1.5f);
			}
			else
			{			
				mfDoorFogAlphaGoal = 0.f;			
				mfDoorEffectSpeed = 0.2f;
				mfDirLightBrightnessGoal = mfStartDirLightBrightness;
				
				Effect_ToneMapping_FadeExposure(abFirstTime ? 1.75f : mfStartExposure, 1.5f);
			}	
		}
		
		//-------------------------------------------------------
		
		void UpdatePlaneLighting(float afTimeStep)
		{			
			//////////////////
			// Special values when opening/closing the door
			iPhysicsBody@ pDoorBody = mBaseObj.GetEntityByName("PlaneDoor", eLuxEntityType_Prop).GetBody(0);
			if (mbDoInitialDoorEffects && mlDoorInteractCount > 0 && pDoorBody.GetLinearVelocity().Length() > 0.01f)
			{
				float fOpenAmount = SwingDoor_GetOpenAmount("PlaneDoor");
				float fT = cMath_Clamp(fOpenAmount - 0.025f, 0.f, 0.3f) / 0.3f;

				float fExposure = fT * 1.75f;
				Effect_ToneMapping_FadeExposure(fT * 1.75f, afTimeStep);
					
				mfDirLightBrightness = fT + 2.f;
				mfDirLightBrightnessGoal = mfDirLightBrightness;
					
				/////////////////
				// First plane exit!
				if (fOpenAmount >= 0.3f)
				{
					mbDoInitialDoorEffects = false;	
				
					SetupLighting(false, true);
					mfDoorEffectSpeed = 0.35f;
						
					Entity_SetActive("Trigger_PlaneDoor", true);
					Entity_SetActive("Soundscape_Plane",false);
						
					SwingDoor_PushOpen("PlaneDoor", 1.f, 3, 0.1f);
						
					PlayerBody_PlayCutsceneAtEntity("player_exit_plane_first_time", "Area_ExitPlaneAnim", false, 0.7f, "OnAnimEnd_ExitPlane");
					PlayerBody_SetCutsceneMaxPitch(5.f);
					PlayerBody_SetCutsceneMaxYaw(5.f);
				
					Sound_CreateAtEntity("Sound_FirstExit", "01_01_wreckage/animations/wreckage_first_exit", "player");
					Sound_CreateAtEntity("Sound_FirstExitStinger", "01_01_wreckage/animations/exit_stinger", "player");
					Sound_Play("Sound_WingCloth", 2.0f);
					Sound_Stop("Sound_CabinSand_*", 2.0f);
					Sound_Stop("Sound_DebrisSweet_*", 2.0f);
						
					if (mbRadioCallOver == false)
					{
						Sound_Fade("Sound_Radio", 0.2f, 1.f);
						Voice_FadeSceneVolumeTo("Radio", 0.2f, 1.f);
					}
						
					Map_AddTimer("Timer_FadeInExposureLight", 0.5f, "OnTimer_FadeInExposureLight");					
					Map_AddTimer("Timer_PlayOpenDoorMusic", 0.5f, "OnTimer_PlayOpenDoorMusic");
				}
			}
			
			/////////////////
			// Dir light
			mfDirLightBrightness = cMath_IncreaseTo(mfDirLightBrightness, afTimeStep * mfDoorEffectSpeed, mfDirLightBrightnessGoal);
			mBaseObj.GetWorld().GetDirectionalLight().SetBrightness(mfDirLightBrightness);
			
			/////////////////
			// Fog area	
			mfDoorFogAlpha = cMath_IncreaseTo(mfDoorFogAlpha, afTimeStep * mfDoorEffectSpeed * 2.f, mfDoorFogAlphaGoal);
			
			cFogArea@ pFog = cLux_ID_FogArea(m_idPlaneFogId);
			if (pFog is null)
			{
				@pFog = mBaseObj.GetWorld().GetFogArea("FogArea_1");
				m_idPlaneFogId = pFog.GetID();
			}
			
			cColor fogColor = pFog.GetColor();
			fogColor.a = mfDoorFogAlpha;
			pFog.SetColor(fogColor);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeInExposureLight(const tString &in asTimer)
		{
			Light_FadeTo("light_exposure", cColor(0.982,0.93,0.825,1), -1, 1);
			Map_AddTimer("Timer_FadeOutExposureLight", 1.f, "OnTimer_FadeOutExposureLight");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeOutExposureLight(const tString &in asTimer)
		{
			Light_FadeTo("light_exposure", cColor(0,0,0,0), -1, 12);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayOpenDoorMusic(const tString &in asTimer)
		{
			Music_Play("A2_1_1_Aircraft_Exit.ogg", 0.13f, false, eMusicPrio_MinorEvent);			
			Map_AddTimer("Timer_MusicPlayDesert", 30.f, "OnTimer_PlayDesertMusic");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ExitPlane(const tString &in asAnim)
		{
			mbPlayerInsidePlane = false;
			
			Player_SetCrouching(false, true, true);
			Entity_SetCollide("Minibar", false);
			
			Effect_ToneMapping_FadeExposure(mfStartExposure, 5.f);
			mfDirLightBrightnessGoal = mfStartDirLightBrightness;
			
			Voice_PlayDelayed("Dialogue_TheDesert", 1.5f, -1, "OnVoiceEnd_TheDesert");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_TheDesert(const tString &in asScene, const tString &in asSubject)
		{
			mbDesertDialoguePlayed = true;
			Player_SetRemainingDisorientDuration(30.f);
			
			Map_AddTimer("Timer_StartWreckageMicroflashes", 5.f, "OnTimer_StartWreckageMicroflashes");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_EnterPlane(const tString &in asAnim)
		{
			mbPlayerInsidePlane = true;
			
			Player_SetCrouching(false, true, true);
			Entity_SetCollide("Minibar", true);
			
			ResetHotPlaneDialogue(cMath_RandRectf(20.f, 25.f));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayDesertMusic(const tString &in asTimer)
		{
			Music_Stop(8.0f, eMusicPrio_MinorEvent);
			Music_PlayExt("A2_1_1_Desert_Heat.ogg", true, 0.15f, 1.0f, 5.0f, 1.0f, eMusicPrio_BgAmb, true);
		}
		
		//-------------------------------------------------------
		
		//} END Event C *Open the COCKPIT DOOR*
	 
	//} END SCENE 2
	
