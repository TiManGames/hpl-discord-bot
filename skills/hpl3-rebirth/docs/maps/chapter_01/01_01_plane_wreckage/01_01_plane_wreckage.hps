		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 3, Event C here.*/
		
		bool OnTrigger_Player_ActivateHeat(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 || SwingDoor_GetBlocked("PlaneDoor"))
				return true;

			Heat_SetActive(true, 0.3f, false, false, true);
			Heat_SetHeatLevel(eHeatLevel_VeryHot);
			
			mbHeatActivated = true;
			
			Map_AddTimer("Timer_PlayTimePressureDialogue", 120.f, "OnTimer_PlayTimePressureDialogue");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_TriggerMassonDialogue(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_GraveOfNicholasMasson", -1, "OnVoiceOver_MassonGrave");
			Music_Play("A2_1_1_Desert_Corpse.ogg", 0.2f, false, eMusicPrio_MinorEvent);
		}
		
		//-------------------------------------------------------
		
		void OnVoiceOver_MassonGrave(const tString &in asScene, const tString &in asSubject)
		{
			mbPlayedMassonDialogue = true;
		}
		
