		void OnInteract_Stash(const tString &in asEntity)
		{
			if (Sketchbook_GetIsMemoryUnlocked("KelHananStash"))
				return;
			
			mbStashMemoryActive = true;
			Map_RemoveTimer("Timer_UnlockStashMemory");
			Map_AddTimer("Timer_UnlockStashMemory", 1.f, "OnTimer_UnlockStashMemory");
		}
		
