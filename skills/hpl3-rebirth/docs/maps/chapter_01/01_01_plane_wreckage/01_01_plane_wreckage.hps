		void OnLookAt_SpotCaves(const tString &in asEntity, int alState)
		{
			mbLookingAtCaveEntrance = alState == 1;
			
			if (mbLookingAtCaveEntrance == false)
				return;
				
			if (mbPlayedSpotCaves)
				return;
				
			mbPlayedSpotCaves = true;
			
			if (mbStashMemoryActive)
			{
				Voice_StopCheckTimer("Dialogue_SpotCaves");
				Voice_PlayWhenPossible("Dialogue_SpotCaves", "VoiceCondition_SpotCaves", -1.f, 1.f);
			}
			else
			{
				Voice_StopAll();
				Voice_Play("Dialogue_SpotCaves");
			}
		}
		
		//-------------------------------------------------------
		
		bool VoiceCondition_SpotCaves(const tString &in asSubject)
		{
			return mbLookingAtCaveEntrance && mbStashMemoryActive == false;
		}
		
