	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if (abPressed==false) return;
				
		if (alAction == eAction_Test0)
		{
			Player_Teleport("Start_Begin");
			cLux_SetScriptDebugOn(false);
		}
		
		if (alAction == eAction_Test1)
		{
			Player_Teleport("Start_PlaneDoor");
		}
		
		if (alAction == eAction_Test2)
		{
			//Effect_Sway_FadeIn(2.f, -1.f, 1.5f, 90.f, -1.f, 0.25f, 0.f, 0.4f, 0.5f, 1.f);
			//Effect_Sway_FadeIn(0.75f, 0.75f, 0.5f, -90.f, 1.f, 0.25f, 0.99f, 0.4f, 0.8f, 0.05f, true);
			//Player_Teleport("Start_Tower");
			
			PlayerBody_SetActive(PlayerBody_IsActive() == false);
		}
		
		if (alAction == eAction_Test3)
		{
			Player_SetFootStepDecalFadeOutTime(5.f);
		}
		
		if (alAction == eAction_Test4)
		{
			mfDoorFogAlphaGoal = 0.f;
		}
        
        if (alAction == eAction_Test5)
		{
			Heat_SetActive(true, 1.5f);
		}
        
        if (alAction == eAction_Test6)
		{
			PlayerBody_PlayCutsceneAtEntity("herberts_hq_a_stumble_ls", "Area_PlaneStumble", false, 0.5f);
        }
		
		if (alAction == eAction_Test8)
		{
			//Hint_ShowHint("Hints", "HintJump", true, 1.5f, false);
			//Entity_SetActive("Laudanum", true);
			
			Hint_Unblock("Hints", "HintGrabThrow");
		}
		
		if (alAction == eAction_Test9)
		{
			//PlayerBody_PlayCutsceneAtEntity("player_exit_plane_first_time", "Area_ExitPlaneAnim", false, 0.7f, "OnAnimEnd_ExitPlane");
			PlayerBody_PlayCutsceneAtEntity("plane_stumble", "Area_PlaneStumble", false, 0.3f, "", 1.f);
		}
		
		if (alAction == eAction_TestMinus)
		{
			//SetupLighting(true);
			//PlayerBody_PlayCutsceneAtEntity("player_struggle_wake_up_normal_loop", "Area_WakeUpAnim", false, 0.3f, "");
			
			//PlayerBody_StopAnimation("player_struggle_wake_up_struggle_loop", 0.f);
			
			mbIntroOver = false;
			
			PlayerBody_FadeCutsceneMaxPitch(10.f, 2.f);
			PlayerBody_FadeCutsceneMaxYaw(10.f, 2.f);
			PlayerBody_PlayCutsceneAtEntity("player_wake_up_seq_pick_up_bottle", "Area_WakeUpAnim", false, 0.f, "OnAnimEnd_PickUpLaudanum", 1.f);
			
			Entity_PlayAnimation("Laudanum", "bottle_wake_up_seq_pick_up_bottle", 0.f, false);
			Map_GetEntity("Laudanum", eLuxEntityType_Prop).GetCurrentAnimationState().SetSpeed(1.f);
		}
		
		if (alAction == eAction_TestPlus)
		{
			//PlayerBody_PlayCutsceneAtEntity("player_wake_up_seq_end", "Area_WakeUpAnim", false, 0.3f, "OnAnimEnd_StandUp", 1.f, 0.f, 0.f, 0.f, true, false, false);			
			
			
			//SetupLighting(false);	
			//mbIntroOver = false;	
			OnAnimEnd_StruggleOutro("");

			//iScrPlayerBodyHandler_Interface @pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
			//pBody.PlayAnimationInLayer("player_struggle_wake_up_normal_loop", ePlayerBodyAnimationLayer_FullBody, false, false, true, 0.3f, 1.f, 0.f);
		}
	}
	
