		bool OnTrigger_Player_ForceCavesMemory(const tString &in asParent, const tString &in asChild, int alState)
		{
			TriggerCavesMemory();			
			return false;
		}
		
		//-------------------------------------------------------
		
		void TriggerCavesMemory()
		{
			if (mbCavesMemoryPlayed)
				return;
			
			mbCavesMemoryPlayed = true;
			
			Voice_StopAll();
			Entity_SetActive("Trigger_UnlockCavesMemory_*", false);
			
			Sketchbook_UnlockMemory("GoingToCaves", true, "OnHankMemoryDone");
		}
		
