	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{		
		// Any general setup of script / entities
		
		/////////////////////////
		// Debug
		if (cLux_ScriptDebugOn())
		{
			mbIntroOver = true;
		}
		
		GhoulProgression_SetLimit(0);
		
		/////////////////////////
		// Set up plane
		cWorld@ pWorld = mBaseObj.GetWorld();
		mfStartExposure = pWorld.GetToneMappingExposure();
		mfStartDirLightBrightness = pWorld.GetDirectionalLight().GetBrightness();
		
		Sketchbook_AddIdea("find_salim", false);
		SetUpSketchbook();
		
		Entity_PlayAnimation("Laudanum", "bottle_wake_up_seq_pick_up_bottle", 0.f);
		Entity_SetCurrentAnimationSpeed("Laudanum", 0.f);
		Entity_SetUpdateBonesWhenCulled("Laudanum", true);
		
		if (cLux_ScriptDebugOn() == false)
			Seq_WakeUp("");
			
		SetupLighting(true);
		
		Hint_Block("Hints", "HintGrabThrow");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		FearHandler_SetActive(cLux_ScriptDebugOn());
		FearHandler_SetPermaFailEnabled(false);
		
		PlayerBody_SetActive(true);
		Player_SetNightVisionEnabled(false);
		Player_SetVertigoActive(false);
		
		Player_SetMapDeepShadow(0.f);
		Player_SetRunSpeedMul(mbIntroOver ? gfWreckagePlayerRunSpeedMul : 0.f);
		
		Entity_PlayAnimation("Vulture", "eating_idle", 0.f, true);
		
        //iTexture@ pSkybox = cResources_CreateTextureCubeMap("skybox_crash_fog.dds",true);
        //cLux_GetCurrentMap().GetWorld().SetFogSkyboxTexture(pSkybox);
		
		Item_SetHidden(ItemType_GetFirstInInventory("CurseMedallion"), true);
	}

