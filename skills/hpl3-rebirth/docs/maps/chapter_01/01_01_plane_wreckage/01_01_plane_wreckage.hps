		void OnInteractLeave_HanksNote(const tString &in asEntity)
		{
			mbAllowCrashMicroflashes = false;
			Map_AddTimer(Entity_GetVarString(asEntity, ""), 1.f, "OnTimer_PlayDossierMicroflash");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayDossierMicroflash(const tString &in asTimer)
		{
			if (Voice_SceneInvolvingCharacterIsActive("Player") || Sketchbook_IsMicroflashActive())
				return;
			
			Sketchbook_Microflash(asTimer, "OnVoiceEnd_DossierMicroflash");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_DossierMicroflash(const tString &in asScene, const tString &in asSubject)
		{
			mbAllowCrashMicroflashes = true;
		}
		
