		int mlRiftFallBlurId = -1;
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 5, Event B here.*/
		
		bool OnTrigger_Player_StartSeqSinkThroughSand(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_SinkThroughSand("");
			Sound_CreateAtEntity("Sound_QuickSandSink", "02_06_oasis/events/quicksand_event", "player");
			Sound_CreateAtEntity("Sound_PlayerDebris", "new_sounds/animations/oasis_fall", "player");
			Music_Stop(8.0f, eMusicPrio_SceneAmb);
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataSinkThroughSand;
		void Seq_SinkThroughSand(const tString &in asTimer)
		{
			Sequence_Begin("Seq_SinkThroughSand", mSeqDataSinkThroughSand);
			if (Sequence_DoStepAndWait(0.75f))
			{
				Amulet_StopTracking();
				
				Item_PutAway(eItemHandlerHand_Left);
				Item_PutAway(eItemHandlerHand_Right);
				
				Player_FadeLookSpeedMulTo(0.4f, 1.f);
				
				PlayerBody_SetCutsceneMaxYaw(15.f);
				PlayerBody_SetCutsceneMaxPitch(15.f);
				
				PlayerBody_PlayCutsceneAtEntity("player_sink_hole", "Sinkhole", false, 1.f);
				PlayerBody_SetCutsceneMaxPitch(5.f);
				PlayerBody_SetCutsceneMaxYaw(5.f);
				Entity_PlayAnimation("Sinkhole", "sand_funnel_animation", 1.f, false, false);
				
				ParticleSystem_SetActive("Sinkhole_PS_1", true);
				ParticleSystem_SetVisible("Sinkhole_PS_1", true);
				ParticleSystem_SetActive("PS_RiftSand_*", true);
				ParticleSystem_SetVisible("PS_RiftSand_*", true);
				
				Voice_StopAll();
				Voice_Play("Dialogue_StuckInSand_Alt");
				
				DarkWorldWhispers_Stop();
								
				Map_AddTimer("RiftRock_2", 15.3f, "OnTimer_RiftRockFall");
				Map_AddTimer("RiftRock_1", 15.4f, "OnTimer_RiftRockFall");
				Map_AddTimer("RiftRock_3", 15.7f, "OnTimer_RiftRockFall");
				
				Map_AddTimer("Timer_DoRiftRumble", 0.f, "OnTimer_DoRiftRumble");
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				FearHandler_SetForcedAddFearRate(0.5f, -1.f, true);
			}
			else if (Sequence_DoStepAndWait(5.25f))
			{
				Music_Play("A2_2_6_Quicksand_Event.ogg", 0.3f, false, eMusicPrio_BigEvent);
			}
			else if (Sequence_DoStepAndWait(1.8f))
			{								
				ParticleSystem_SetVisible("PS_Smoke_Close", false);
			}
			else if (Sequence_DoStepAndWait(4.5f))
			{
				DoDarkWorldTransitionEffect(true);
			}
			else if (Sequence_DoStepAndWait(1.95f))
			{				
				DoDarkWorldTransitionEffect(true);				
				Map_GetEntity("Sinkhole").GetParticleSystemFromName("PS_1").Kill();
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Heat_SetActive(false);
				
				Effect_ImageTrail_Start(1.5f, 1.f, 5.f, 3.f);
				
				Light_FadeBrightnessTo("Light_Rift_1_*", 1000.f, 1.25f);
				Light_FadeBrightnessTo("Light_Rift_2_*", 1000.f, 1.25f);
				Effect_ToneMapping_FadeExposure(5.f, 1.25f);
				
				Sound_CreateAtEntity("Sound_RiftOpen", "level_entity_shared/portal/portal_open", "player");
				
				Map_GetEntity("Sinkhole").FadeMeshScaleMul(cVector3f(1.1f, 2.f, 1.1f), 1.2f);
				
				Effect_Rumble_Start(1.f, 1.f, 0.25f, 0.5f);
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				DoDarkWorldTransitionEffect(false);					
				mBaseObj.GetWorld().SetDistanceCullActive(false);
				mBaseObj.GetWorld().SetFogActive(false);
			}
			else if (Sequence_DoStepAndWait(0.55f))
			{
				Effect_Flash_Start(0.1f, 0.25f, 0.3f);
				Player_SetCameraUseSmoothing(false);
			}
			else if (Sequence_DoStepAndWait(0.05f))
			{									
				float fRelT = PlayerBody_GetAnimationState("player_sink_hole").GetRelativeTimePosition();
				PlayerBody_PlayCutsceneAtEntity("player_sink_hole", "Sinkhole_DW", false, 0.f, "OnAnimEnd_SinkHole", 1.f, fRelT);
				PlayerBody_SetCutsceneMaxPitch(5.f);
				PlayerBody_SetCutsceneMaxYaw(5.f);
			}
			else if (Sequence_DoStepAndWait(0.83f))
			{			
				Effect_ToneMapping_FadeExposure(0.f, 1.f);
				
				Player_SetCameraUseSmoothing(true);
				Map_Preset_Fade("Preset_DW_Default", 1.f);
				
				Map_SetSkyBoxActive(true);
				Map_SetSkyBoxTexture("skybox_dwf.dds");
				mBaseObj.GetWorld().SetSkyBoxColor(cColor(0.771,0.669,0.669,1));
				mBaseObj.GetWorld().SetSkyBoxBrightness(1.2f);
				mBaseObj.GetWorld().SetFogUseSkybox(false);
				Visibility_SetTerrainActive(false);
				
				ParticleSystem_SetActive("PS_DW_Land_*", true);
				ParticleSystem_SetVisible("PS_DW_Land_*", true);
				
				ParticleSystem_SetActive("PS_RiftSand_*", false);
				ParticleSystem_SetVisible("PS_RiftSand_*", false);
			}
			else if (Sequence_DoStepAndWait(6.f)) 
			{				
				Light_FadeBrightnessTo("Light_Rift_2_*", 0.f, 5.f);
				
				Player_GiveDamage(0.1f, 0.9f, eDamageType_Fall, "Fall");
				Player_Disorient(12.f);
				Player_SetMapDeepShadow(0.25f);
				
				Sound_CreateAtEntity("Sound_Land", "player/foley/damage/player_fall_damage", "player");
				
				FearHandler_SetForcedAddFearRate(0.5f, 2.f, false, -1.f, 0.1f);
				
				Voice_StopAll();
				Voice_Play("Dialogue_Land");
				
				ParticleSystem_Destroy("PS_DW_RiftSand");
				
				mlRiftFallBlurId = Effect_Blur_Start(0.75f, 0.5f);
				
				Map_RemoveTimer("Timer_DoRiftRumble");
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Sound_CreateAtEntity("Sound_RiftOpen", "level_entity_shared/portal/portal_close", "Sinkhole_DW");
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Effect_Blur_FadeAmount(mlRiftFallBlurId, 2.f, 0.5f);
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{
				Effect_Blur_FadeAmount(mlRiftFallBlurId, 0.4f, 1.f);
			}
			else if (Sequence_DoStepAndWait(4.f))
			{
				Entity_SetActive("DW_Ceiling_*", true);
				
				FearArea_SetSafe("Fear_1", false);
				Music_PlayExt("A2_2_6_Oasis_DarkWorld.ogg", true, 0.2f, 1.0f, 8.0f, 1.0f, eMusicPrio_BgAmb, true);
				
				Heat_SetActive(false);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Effect_Blur_FadeOut(mlRiftFallBlurId, 4.f);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoRiftRumble(const tString &in asTimer)
		{
			Effect_Rumble_Start(0.4f, 1.f, 0.5f, 1.f);
			Map_RestartCurrentTimer(1.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RiftRockFall(const tString &in asTimer)
		{
			Prop_SetStaticPhysics(asTimer, false);
			Entity_SetCollideCharacter(asTimer, false);
			Body_AddImpulse(asTimer + "_Body_1", cVector3f(-0.5f, 0.f, 0.f), false);
		}
				
		//-------------------------------------------------------
		
		void DoDarkWorldTransitionEffect(bool abEnter)
		{
			Effect_Shake_Start(0.01f, 0.5f, 0.2f, 0.2f);
			Effect_ImageTrail_Start(0.75f, 0.5f, 1.f, 2.f);
			
			tString sSound = abEnter ? "level_entity_shared/portal/portal_passthrough" :
										"level_entity_shared/portal/portal_passthrough";										
			Sound_PlayGui(sSound, eSoundEntryType_Gui);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_SinkHole(const tString &in asAnim)
		{
			Player_FadeLookSpeedMulTo(1.f, 1.f);
			
			Visibility_SetAreaActive("VisibilityArea_Vista", true);
			
			Player_SetCameraFarPlane(8192.0f);
			
			Voice_PlayDelayed("Dialogue_GetToFeet", 1.f);
			
			Sketchbook_CompleteIdea("follow_smoke");
			Sketchbook_NewIdeasPage();
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_DoLightningFlash(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_StartDWLightning", 3.0f, "OnTimer_StartDWLightning");
			Map_AddTimer("Timer_PlayDialogueVista", 5.5f, "OnTimer_PlayDialogueVista");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartDWLightning(const tString &in asTimer)
		{
			DarkWorldLightning(3, Map_GetEntity("Target_LightningDir").GetMatrix().GetTranspose().GetForward(), 0, "level_amb_shared/amb/sweeteners/thunder/dw_enter");
			Map_AddTimer("Timer_DarkWorldLightningLoop", 10, "OnTimer_DarkWorldLightningLoop");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DarkWorldLightningLoop(const tString &in asTimer)
		{
			if (Entity_GetCollide("player", "Area_DW_Corridor"))			
				RandomDarkWorldLightning(Player_GetForward(), 90);
			
			Map_RestartCurrentTimer(cMath_RandRectf(15, 45));
//			Map_RestartCurrentTimer(5);
		}
		
