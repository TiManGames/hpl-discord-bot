		bool OnTrigger_Player_ActivateCloseSmoke(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) 
				return true;
			
			bool bInFront = Entity_PlayerIsInFront(asParent);
			ParticleSystem_SetVisible("PS_Smoke", bInFront == false);
			ParticleSystem_SetVisible("PS_Smoke_Close", bInFront);			
			return true;
		}
				
