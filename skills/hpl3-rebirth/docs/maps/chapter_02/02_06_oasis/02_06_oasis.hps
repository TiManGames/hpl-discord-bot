		void OnRiftStage_Cave1(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
		{
			if (alStage == 2 && abOpening)
			{				
				Entity_SetActive("Rift_Cave_1_Blocker_*", false);				
			}
			else if (alStage == 1 && abOpening == false)
			{				
				Entity_SetActive("Rift_Cave_1_Blocker_*", true);
			}
