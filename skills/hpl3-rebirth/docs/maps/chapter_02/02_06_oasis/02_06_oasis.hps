	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("02-06-oasis");
		
		// Set up color grading etc.		
		Map_Preset_SetupDirLight("Preset_DW_Default", false, cColor(0.269,0.339,0.35,1), 0.f, cVector3f(-0.644, -0.462, 0.61), cColor(0.222,0.289,0.299,1), cColor(0.101,0.171,0.182,1));
		Map_Preset_SetupColorGrading("Preset_Default", "grading_default.dds");
		Map_Preset_SetupBloom("Preset_Default", 128.f, 0.75f, 0.5f, cColor(1.f));
		
		Map_Preset_SetupDirLight("Preset_DW_LightningMin", true, cColor(1,1.5,2,1)*0.125, 5, cVector3f(-0.913, -0.407, -0.009), cColor(0.092,0.069,0.069,1), cColor(0.092,0.069,0.069,1));
		Map_Preset_SetupColorGrading("Preset_LightningMin", "grading_default.dds");
		Map_Preset_SetupBloom("Preset_LightningMin", 128.f, 0.75f, 0.5f, cColor(1.f));
		
		Map_Preset_SetupDirLight("Preset_DW_LightningFull", true, cColor(1,1.5,2,1), 5, cVector3f(-0.913, -0.407, -0.009), cColor(0.092,0.069,0.069,1), cColor(0.092,0.069,0.069,1));
		Map_Preset_SetupColorGrading("Preset_LightningFull", "grading_lightning_flash.dds");
		Map_Preset_SetupBloom("Preset_LightningFull", 4.f, 0.02f, 1.5f, cColor(1.f, 2.f, 2.f, 1.f));
		
		Pregnancy_SetStage(ePregStage_Stage1);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkMinimumStage(eBabyTalkStage_OasisToAlchemists);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingMonster);
		Player_SetAllowCheckBaby(true);
		FearHandler_SetWhisperStage(eFearWhisperStage_OasisToBabyKick);
		
		Prop_SetRenderLayer("stream_under_01",-1);
		Prop_SetRenderLayer("stream_under_02",-1);
		Prop_SetRenderLayer("stream_under_03",-1);
		Prop_SetRenderLayer("stream_under_04",-1);
		Prop_SetRenderLayer("stream_over_01",0);	
		Prop_SetRenderLayer("stream_over_02",0);	
		Prop_SetRenderLayer("stream_over_03",0);	
		Prop_SetRenderLayer("stream_over_04",0);	
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(0);
		StruggleFlashHandler_SetProgression(0);
		
		Player_SetAutoTeleportWhenBelowAltitude(-43.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("splash_ripples_oneshot_medium.ps");
		ParticleSystem_Preload("waterbucket_water_splash.ps");
		ParticleSystem_Preload("crawl_chase_bubbles.ps");

		//////////////
		// Preload screen effects
		Material_Preload("oasis_dw_skybox.mat");
		
		/////////////
		// Preload sounds
		//Sound_PreloadProject("02_06_oasis");
		Sound_PreloadGroup("level_entity_shared/portal", true);
		Sound_PreloadGhost();
		
		Entity_Preload("radio_receiver_held.ent");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{		
		// Any general setup of script / entities
		
		////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			if (ItemType_GetCountInInventory("Lantern") < 1)
            {
                Item_AddToInventory("Lantern");
                    
                Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
            
                Item_AddToInventory("HerbertOil");
                Item_AddToInventory("HerbertOil");
            }
            
            if (ItemType_GetCountInInventory("CurseMedallion") < 1)
                Item_AddToInventory("CurseMedallion");
			
			Item_AddToInventory("Match");
		}
		
		if (ItemType_GetCountInInventory("Radio") < 1)
			Item_AddToInventory("Radio");
		
		GhoulProgression_SetLimit(6);
		Heat_SetActive(false, 1.5f);
				
		////////////////
		// Set up stream		
		Player_SetRunSpeedMul(0.6f);
		Player_SetCheckBabyEffectIntensity(0.f);
				
		array<iLuxEntity@> vAreas;
		mBaseObj.GetEntityArray("Area_YoungTinHinanSpawn_*", eLuxEntityType_Area, "", vAreas);
		
		mvTinHinanSpawnPoints.resize(0);
		for (int i = 0; i < vAreas.size(); ++i)
		{
			iLuxEntity@ pArea = vAreas[i];
			mvTinHinanSpawnPoints.push_back(pArea.GetPosition());
		}
		
		////////////////
		// Set up desert
		ParticleSystem_SetVisible("PS_Smoke_Close", false);
		
		Entity_PlayAnimation("Vulture", "circle_and_fly_way", 0.f, false, false);
		Map_GetEntity("Vulture").GetMeshEntity().GetAnimationStateFromName("circle_and_fly_way").SetSpeed(0.f);
		
		////////////////
		// Set up valley
		Entity_StopAnimation("Sinkhole");
		
		ParticleSystem_SetActive("Sinkhole_PS_1", false);
		ParticleSystem_SetVisible("Sinkhole_PS_1", false);
		ParticleSystem_SetActive("PS_RiftSand_*", false);
		ParticleSystem_SetVisible("PS_RiftSand_*", false);
		ParticleSystem_SetActive("PS_DW_Land_*", false);
		ParticleSystem_SetVisible("PS_DW_Land_*", false);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		PlayerBody_SetActive(true);
		
		FearHandler_SetActive(true);
		Pregnancy_SetBabyKicksEnabled(false);
		FearHandler_SetPermaFailEnabled(false);
		
		Player_SetMapDeepShadow(0.f);
		Player_RestoreClipPlane();
		Player_SetVertigoActive(false);
		
		cVector3f vRot = cVector3f(0, cMath_ToRad(115), 0);
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);
		
		Visibility_SetTerrainActive(true);
		Visibility_SetAreaActive("*", false);
		
		InitDarkWorldLightning();
		
		if (cLux_ScriptDebugOn() == false)
			Seq_Emerge("");		
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Player_RestoreClipPlane();
		//Player_SetVertigoActive(true);
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if (alAction == eAction_Test0)
		{
			cLux_SetScriptDebugOn(false);
			Player_Teleport("Start_Begin");
		}
		
		if (alAction == eAction_Test1)
		{
			Player_FadeRunSpeedMulTo(0.15f, 2.f);
			cLux_SetScriptDebugOn(true);
			Player_Teleport("Start_Lullaby");
		}
		
		if (alAction == eAction_Test2)
		{
			cLux_SetScriptDebugOn(true);
			Player_Teleport("Start_Oasis");
			Player_SetRunSpeedMul(1.f);
		}
		
		if (alAction == eAction_Test3)
		{
			cLux_SetScriptDebugOn(true);
			Player_Teleport("Start_VantagePoint");
			Player_SetRunSpeedMul(1.f);
		}
		
		if (alAction == eAction_Test4)
		{
			cLux_SetScriptDebugOn(true);
			Player_Teleport("Start_RiftArea");
			Player_SetRunSpeedMul(1.f);
		}
		
		if (alAction == eAction_Test5)
		{
			Player_Teleport("Start_RiftCave");
			Player_SetRunSpeedMul(1.f);
			//cLux_SetScriptDebugOn(false);
		}
		
		if (alAction == eAction_Test6)
		{
			Player_SetRunSpeedMul(1.f);
			Seq_SinkThroughSand("");
			Entity_SetActive("Trigger_StartSeqSinkThroughSand", false);
		}
		
		if (alAction == eAction_Test7)
		{
			Voice_Play("Dialogue_Lullaby");
			Seq_YoungTinHinanAppear("");
		}
		
		if (alAction == eAction_Test8)
		{
			LevelDoor_SetLocked("door_alchemist_lab_1",true);
			//Entity_SetInteractionDisabled("door_alchemist_lab_1",true);
			return;
			//mBaseObj.GetWorld().GetDirectionalLight().SetCastShadows(!mBaseObj.GetWorld().GetDirectionalLight().GetCastShadows());
			Item_AddToInventory("Matchbook");
		}
		
		if (alAction == eAction_TestMinus)
		{
			//Entity_SetActive("Sinkhole", false);
			
			//Map_SetSkyBoxActive(false);
			//Map_SetSkyBoxTexture("");	
			
			Map_Preset_Fade("Preset_DW_Default", 1.f);
			Map_SetSkyBoxTexture("");
			Map_SetSkyBoxActive(false);
			Visibility_SetAreaActive("VisibilityArea_Vista", true);
			
			Player_SetCameraFarPlane(8192.0f);
		}
		
		if (alAction == eAction_TestPlus)
		{
		//	Visibility_SetAreaActive("VisibilityArea_Desert", Entity_IsActive("VisibilityArea_Desert") == false);
		//	Visibility_SetAreaActive("VisibilityArea_Oasis", Entity_IsActive("VisibilityArea_Oasis") == false);
		//	Visibility_SetAreaActive("VisibilityArea_Stream", Entity_IsActive("VisibilityArea_Stream") == false);
			//Entity_SetActive("FogArea_*", false);
			
			Radio_StartCall("Dialogue_DoctorRadio", "OnDialogueEnd_DoctorCallPart1", 4.f);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
