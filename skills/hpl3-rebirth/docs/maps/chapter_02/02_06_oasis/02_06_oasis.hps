	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	float mfShadowDistanceGoal = 90.f;
	
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	void OnInteractLeave_HanksNote(const tString &in asEntity)
	{
		Map_AddTimer(Entity_GetVarString(asEntity, ""), 1.f, "OnTimer_PlayDossierMicroflash");
	}
		
	//-------------------------------------------------------
	
	void OnTimer_PlayDossierMicroflash(const tString &in asTimer)
	{
		if (Voice_SceneInvolvingCharacterIsActive("Player") || 
			Sketchbook_IsMicroflashActive() ||
			Sketchbook_IsFlashbackActive())
			return;
			
		Sketchbook_Microflash(asTimer);
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SetVisibilityAreasActive(const tString &in asParent, const tString &in asChild, int alState)
	{
		int lId = cString_GetNumericSuffixInt(asParent);
		tString sArea = "";
		
		if (lId == 1)	sArea = "VisibilityArea_Stream";
		if (lId == 2)	sArea = "VisibilityArea_Oasis";
		if (lId == 3)	sArea = "VisibilityArea_Desert";
		
		Visibility_SetAreaActive(sArea, alState == 1);		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SetLiquidAreaActive(const tString &in asParent, const tString &in asChild, int alState)
	{
		int lId = cString_GetNumericSuffixInt(asParent);
		tString sArea = "";
		
		if (lId == 1) sArea = "Liquid_Start";
		if (lId == 2) sArea = "Liquid_Oasis*";
		
		Entity_SetActive(sArea, alState == 1);
		return true;
	}
	
	bool OnTrigger_Player_FadeShadowRange(const tString &in asParent, const tString &in asChild, int alState)
	{
		mfShadowDistanceGoal = alState == 1 ? 120.f : 90.f;
		return true;
	}
	
	//-------------------------------------------------------
	
	void VariableUpdate(float afDeltaTime)
	{
		cLightDirectional@ pLight = mBaseObj.GetWorld().GetDirectionalLight();
		if (pLight is null)
			return;
		
		float fShadowDist = pLight.GetShadowDistance();
		if (fShadowDist != mfShadowDistanceGoal)
		{
			fShadowDist = cMath_IncreaseTo(fShadowDist, afDeltaTime * 15.f, mfShadowDistanceGoal);
			pLight.SetShadowDistance(fShadowDist);
		}
	}
	
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 1 *The player is flushed out of the Cistern and Tasi worries about the baby*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 1 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 1 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A *Emerge from the water*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event A here.*/

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event A here.*/
		
		cSequenceStatesData mSeqDataEmerge;
		void Seq_Emerge(const tString &in asTimer)
		{
			Sequence_Begin("Seq_Emerge", mSeqDataEmerge);
			if (Sequence_DoStepAndWait(0.9f))
			{
				Effect_Fade_Out(0.f);
				
				Player_Disorient(999999.f, true, true);
				Player_SetRunSpeedMul(0.f);
				Player_SetActive(true);
				
				PlayerBody_PlayCutsceneAtEntity("flushed_out_of_the_cistern", "Area_FlushedAnim", false, 0.f, "", 0.f);		
				
				FogArea_SetVisible("FogArea_2", false);
				
				Sound_SetGlobalVolume(0.f, eSoundEntryType_WorldAll);
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				Sound_FadeGlobalVolume(1.f, 0.5f, eSoundEntryType_WorldAll);	
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{							
				PlayerBody_PlayCutsceneAtEntity("flushed_out_of_the_cistern", "Area_FlushedAnim", false, 0.f, "OnAnimEnd_Flushed");		
				PlayerBody_SetCutsceneMaxPitch(0.f);
				PlayerBody_SetCutsceneMaxYaw(0.f);
				Sound_CreateAtEntity("Sound_WaterSlide", "02_06_oasis/events/tasi_water_slide", "player");
				
				Voice_StopAll();
				Voice_Play("Dialogue_TheFalls");
			}
			else if (Sequence_DoStepAndWait(2.8f))
			{
				Effect_Fade_In(2.f);				
				Effect_Rumble_Start(0.4f, 3.f, 0.25f, 0.25f);
			}
			else if (Sequence_DoStepAndWait(4.7f))
			{
				FogArea_SetVisible("FogArea_2", true);
				
				ParticleSystem_CreateAtEntity("PS_Splash", "waterbucket_water_splash.ps", "Area_FlushedSplashPS", false);
				cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_Bubbles", "crawl_chase_bubbles.ps", "Area_FlushedSplashPS", false);
				if (pPS !is null)
					pPS.SetWorldPosition(cVector3f(-57.771, 41.532, 229.349));
				
				ParticleSystem_Destroy("PS_Slide_*");
				
				Effect_Rumble_Start(1.f, 1.5f, 0.1f, 0.5f);
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				ParticleSystem_Destroy("PS_Bubbles");
				ParticleSystem_CreateAtEntity("PS_Ripples", "splash_ripples_oneshot_medium.ps", "Area_RipplePS", false);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Voice_StopAll();
				Voice_Play("Dialogue_BreakingTheSurface");
			}
			else if (Sequence_DoStepAndWait(4.f))
			{		
				Achievement_Unlock(eAchievement_Pathfinder);
				Entity_SetActive("Liquid_Slide_*", false);
			}
			Sequence_End();
		}

		//-------------------------------------------------------

		//} END Event A *Emerge from the water*
		
		/////////////////////////////////////////
		// Event B *Examine the baby*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 1, Event B here.*/
		
		bool mbCheckedBaby = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 1, Event B here.*/
		
		 bool OnTrigger_Player_DoBabyStumble(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Trigger_DoBabyStumble_*", false);
			 Entity_SetActive("Trigger_ForceStumbleDialogue", false);
			
			 int lId = cString_GetNumericSuffixInt(asParent);
			 PlayerBody_PlayCutsceneAtEntity("stumble_after_oasis_pool", "Area_Stumble_" + lId, false, 0.75f);
			 PlayerBody_SetCutsceneMaxPitch(0.f);
			 PlayerBody_SetCutsceneMaxYaw(0.f);
			 Sound_CreateAtEntity("Sound_TasiStumble", "02_06_oasis/events/player_stumble", "player");
			 
			 Map_AddTimer("Timer_PlayStumbleVoice", 0.5f, "OnTimer_PlayStumbleVoice");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ForceStumbleDialogue(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Entity_IsActive("Trigger_DoBabyStumble_1") == false)
				 return false;
			 
			 Entity_SetActive("Trigger_DoBabyStumble_*", false);
			 Entity_SetActive("Trigger_ForceStumbleDialogue", false);
			 
			 Map_AddTimer("Timer_PlayStumbleVoice", 0.5f, "OnTimer_PlayStumbleVoice");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayStumbleVoice(const tString &in asTimer)
		 {
			 Voice_StopAll();
			 Voice_Play("Dialogue_CrawlOutOfPool");
			 
			 if (mbCheckedBaby == false)
			 {		
				Map_AddTimer("Timer_PlayBabyConcernPrompt", 6.5f, "OnTimer_PlayBabyConcernPrompt");
			 }
			 
			 Map_AddTimer("Timer_StopDisorient", 10.f, "OnTimer_StopDisorient");
			 Map_AddTimer("Timer_SoundBird", 15.0f, "OnTimer_PlayBirdSound");
			 
			 Music_PlayExt("A2_2_6_Oasis_Ambience.ogg", true, 0.2f, 1.0f, 10.0f, 1.0f, eMusicPrio_BgAmb, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayBabyConcernPrompt(const tString &in asTimer)
		 {
			 if (mbCheckedBaby)
				 return;
			 
			 Voice_StopAll();
			 Voice_PlayWhenPossible("Dialogue_BabyConcernPrompt", "", 30.f, 1.f);
			 
			 Map_AddTimer("Timer_ShowCheckBabyHint", 1.5f, "OnTimer_ShowCheckBabyHint");
			 Map_AddTimer("Timer_ForceCheckOnBaby", 6.f, "OnTimer_ForceCheckOnBaby");
		 }
		
		//-------------------------------------------------------
		
		void OnTimer_ShowCheckBabyHint(const tString &in asTimer)
		{
			Hint_RemoveFromGiven("Hints", "HintCheckBabyTutorial");
			Hint_ShowHint("Hints", "HintCheckBabyTutorial", true,2.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ForceCheckOnBaby(const tString &in asTimer)
		{
			if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Custom_CheckBaby)
				Player_ForceCheckOnBaby(6.f);			
		}
		
		//-------------------------------------------------------
		
		void OnCheckBaby(int alState)
		{
			if (mbCheckedBaby == false && mlPostRiftBabyKickStage == -1)
			{
				mbCheckedBaby = true;
				
				if (mbSingTinHinanLeave == false)
					Player_FadeRunSpeedMulTo(0.15f, 2.f);
				
				Voice_PlayDelayed("Dialogue_BabyConcernPrompt", 0.5f);
				Pregnancy_SetBabyTalkSpecialSubject("Dialogue_BabyConcern");
				Map_AddTimer("Timer_PlayBabyConcernDialogue", 5.f, "OnTimer_PlayBabyConcernDialogue");							
				
				Map_RemoveTimer("Timer_ForceCheckOnBaby");
			}
			else if (mlPostRiftBabyKickStage == 0)
			{
				OnCheckBabyAfterRift();
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayBabyConcernDialogue(const tString &in asTimer)
		{
			Voice_Play("Dialogue_BabyConcern");	
			Pregnancy_ClearBabyTalkSpecialSubject();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopDisorient(const tString &in asTimer)
		{
			Player_StopDisorient();
		}
		
		//-------------------------------------------------------
				
		void OnTimer_PlayBirdSound(const tString &in asTimer)
		{
			Sound_Play("Sound_StartBird", 1.0f);
		}
		
		//-------------------------------------------------------

		//} END Event B *Examine the baby*
	 
	//} END SCENE 1 
	
