		/*Put any functions that are only used in Scene 2, Event A here.*/
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_SingLullaby(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_StopAll();
			Voice_Play("Dialogue_Lullaby");
			Seq_YoungTinHinanAppear("");
			return false;
		}

		//-------------------------------------------------------

		//} END Event A *Start singing the lullaby*
		
		/////////////////////////////////////////
		// Event B *YOUNG TIN HINAN appears*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event B here.*/
		
		array<cVector3f> mvTinHinanSpawnPoints;
		bool mbSingTinHinanLeave = false;

		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event B here.*/
		
		cSequenceStatesData mSeqDataYoungTinHinanAppear;
		void Seq_YoungTinHinanAppear(const tString &in asTimer)
		{
			Sequence_Begin("Seq_YoungTinHinanAppear", mSeqDataYoungTinHinanAppear);
			Sequence_Wait(12.5f);
			if (Sequence_DoStepAndWait(1.f))
			{				
				Player_SetAllowCheckBaby(false);
				Player_ChangeStateToNormal();
				
				Voice_Play("Dialogue_TinHinanLullaby");
				Voice_SetSource("Tin Hinan", "TH_Ghost_Sing", 10.f, 150.f, true);
				
				SetSingTinHinanActive(true);
				PlaceSingTinHinan(FindBestTHSpawnPoint());				
				Map_AddTimer("Timer_CheckTHDistance", 0.1f, "OnTimer_CheckTHDistance");
						
				FearHandler_SetForcedAddFearRate(0.15f, 12.f, false);

				Music_Play("A2_2_6_Tin_Hinan_Sing.ogg", 0.3f, false, eMusicPrio_BigEvent);

			}
			else if (Sequence_DoStepAndWait(3.2f))
			{
				Voice_Stop("Comments");
				
				Player_FadeRunSpeedMulTo(0.f, 1.f);		
				Player_FadeMoveSpeedMulTo(0.5f, 1.f);
				
				Map_AddTimer("Timer_UpdateSingGhostLookAt", 0.1f, "OnTimer_UpdateSingGhostLookAt");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Seq_YoungTinHinanDisappear("");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UpdateSingGhostLookAt(const tString &in asTimer)
		{
			cLuxAgent@ pAgent = cLux_ToAgent(Map_GetEntity("TH_Ghost_Sing", eLuxEntityType_Agent));
			cVector3f vDir = cMath_Vector3Normalize(pAgent.GetPosition() - Player_GetCameraPosition());
			float fDot = cMath_Vector3Dot(cLux_GetPlayer().GetCamera().GetForward(), vDir);
			
			bool bLookAtActive = cLux_GetPlayer().IsCameraRotateActive();
			if (bLookAtActive && fDot >= 0.95f || pAgent.IsActive() == false)
			{
				Player_StopLookAt(0.f);
				Player_FadeLookSpeedMulTo(1.f, 0.5f);
				return;
			}
			else if (bLookAtActive == false && fDot < 0.8f)
			{
				Player_FadeLookSpeedMulTo(0.05f, 0.5f);
				Player_StartLookAt("TH_Ghost_Sing", 0.025f, 1.5f, 1.5f, false);
			}
			
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataYoungTinHinanDisappear;
		void Seq_YoungTinHinanDisappear(const tString &in asTimer)
		{
			Sequence_Begin("Seq_YoungTinHinanDisappear", mSeqDataYoungTinHinanDisappear);
			Sequence_Wait(1.f);
			if (Sequence_DoStepAndWait(1.f))
			{
				Voice_StopAll();
				SetSingTinHinanActive(false);	

				Voice_PlayWhenPossible("Dialogue_Ghost", "", 30.f, 0.f, "");							
				
				Map_RemoveTimer("Timer_CheckTHDistance");
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{				
				Player_SetAllowCheckBaby(true);				
				Player_FadeRunSpeedMulTo(1.f, 30.f);
				Player_FadeMoveSpeedMulTo(1.f, 1.f);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				//Voice_PlayWhenPossible("Dialogue_Ghost", "", 30.f, 1.f, "");
			}

			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckTHDistance(const tString &in asTimer)
		{
			float fDist = Entity_GetDeltaToEntity("player", "TH_Ghost_Sing").Length();
			if (fDist < 7.f)
			{								
				SetSingTinHinanActive(false);				
				return;
			}
			
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void SetSingTinHinanActive(bool abActive)
		{
			if (abActive)
			{	
				YoungTinHinan_Activate("TH_Ghost_Sing", 1.f);
			}
			else
			{			
				if (mbSingTinHinanLeave == false)
					YoungTinHinan_Deactivate("TH_Ghost_Sing", 1.f);
				
				mbSingTinHinanLeave = true;
			}			
		}
		
		//-------------------------------------------------------
		
		void PlaceSingTinHinan(const cVector3f &in avPos)
		{		
			cLux_ToAgent(Map_GetEntity("TH_Ghost_Sing")).GetCharBody().SetFeetPosition(avPos, true);
			Agent_FaceEntity("TH_Ghost_Sing", "player");
		}
		
		//-------------------------------------------------------
		
		cVector3f FindBestTHSpawnPoint()
		{
			//////////////
			// Set up vars
			const float fMinDistSqr = 15.f * 15.f;
			const float fMaxDistSqr = 27.5f * 27.5f;
			
			array<cVector3f> vBackups;
			array<cVector3f> vCandidates;
			
			cVector3f vSpawnPos = 0.f;
			cVector3f vPlayerPos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
			
			//////////////
			// Find candidates and backups
			for (int i = 0; i < mvTinHinanSpawnPoints.size(); i++)
			{		
				cVector3f vPoint = mvTinHinanSpawnPoints[i];
				
				float fDistSqr = (vPlayerPos - vPoint).SqrLength();					
				if (fDistSqr < fMinDistSqr || fDistSqr > fMaxDistSqr) 
					continue;
				
				// Within dist, save as backup!
				vBackups.push_back(vPoint);
				
				bool bOnScreen = cLux_GetPlayer().GetCamera().GetFrustum().CollidePoint(vPoint);
				if (bOnScreen == false)
					continue;					
				
				vCandidates.push_back(vPoint);
			}		
			
			if (vCandidates.size() > 0)
				vSpawnPos = GetTopScoreSpawnPoint(vCandidates);
			
			////////////////
			// Use backups if no suitable candidate found!
			if (vSpawnPos == 0.f)
			{
				if (vBackups.size() > 0)
					vSpawnPos = GetTopScoreSpawnPoint(vBackups);
				
				if (vSpawnPos == 0)
				{
					int lId = cMath_RandRectl(0, mvTinHinanSpawnPoints.size() - 1);
					vSpawnPos = mvTinHinanSpawnPoints[lId];
				}							
			}
			
			return vSpawnPos;
		}
		
		//-------------------------------------------------------
		
		cVector3f GetTopScoreSpawnPoint(const array<cVector3f> &in avCandidates)
		{
			//////////////
			// Set up vars
			cVector3f vSpawnPos = 0.f;			
			cVector3f vCamPos = Player_GetCameraPosition();
			cVector3f vPlayerFwd = Player_GetForward();
			cVector3f vPlayerFeetPos = Player_GetFeetPosition();
			
			float fTopScore = -1.f;
			
			//////////////
			// Find best candidate!
			for (int i = 0; i < avCandidates.size(); i++)
			{
				cVector3f vPoint = avCandidates[i];
						
				// Don't want a pos not in LoS
				if (cLux_CheckLineOfSight(vCamPos, vPoint, false, false) == false)
					continue;
				
				cVector3f vDir = cMath_Vector3Normalize(vPoint - vPlayerFeetPos);
				float fDot = cMath_Vector3Dot(vPlayerFwd, vDir);
						
				// Score it with a slight bias for height!
				float fDotScore = cMath_Clamp(fDot, 0.f, 1.f) * 0.8f; 
				float fHeightScore = cMath_Clamp((vPoint.y - vCamPos.y) / 1.5f, 0.f, 1.f) * 1.2f;
				float fTotalScore = fDotScore + fHeightScore;
						
				if (fTotalScore > fTopScore)
				{
					fTopScore = fTotalScore;
					vSpawnPos = vPoint;
				}
			}
			
			return vSpawnPos;
		}
		
