	{
		Sketchbook_AddIdea("cross_alchemistrift");
		Voice_Play("Dialogue_SeeTheRift");
		
		// We re done, disable all rift dialog triggers.
		Entity_SetActive("Trigger_RiftVoice_Switcher", false);
		Entity_SetActive("Trigger_LookAtRift_*", false);
		
	}
 
	//-------------------------------------------------------
	
	bool OnCollide_SwitchRiftVoiceTrigger(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1)
		{
			Entity_SetActive("Trigger_LookAtRift_1", false);
			Entity_SetActive("Trigger_LookAtRift_2", true);
		}
		else if (alState==-1)
		{
			Entity_SetActive("Trigger_LookAtRift_1", true);
			Entity_SetActive("Trigger_LookAtRift_2", false);
		}
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_AutoSave(const tString &in asParent, const tString &in asChild, int alState)
	{
		if 
		(
			alState==1 && 
			ItemType_GetCountInInventory("VitaeCanister")==2 || 
			( ItemType_GetCountInInventory("VitaeCanister")==1 && ( Entity_IsActive("VitaeCanister_Placed_1") || Entity_IsActive("VitaeCanister_Placed_2") ) ) 
		)
		{
			Game_AutoSave();
			return false;
		}
		
		return true;
	}
	
