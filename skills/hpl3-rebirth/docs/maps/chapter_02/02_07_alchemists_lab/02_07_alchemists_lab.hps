	//-------------------------------------------------------
	
	int mlExtendersInMedLab=0;
	bool mbPlayerIsInMedLab=false;
	
	//-------------------------------------------------------
	
	bool Trigger_Intro(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(cLux_ScriptDebugOn()) return true;
		Voice_PlayDelayed("Dialogue_Intro", 2);
		return false;
	}
	
	//-------------------------------------------------------
	
	void OnReceiverPower_FirstDoor(bool abActive, const tString&in asEntity)
	{
		if (abActive==false)
		{
			// Don't throw the extender out if it's the only one you have.
			if (mlExtendersInMedLab<=1)
				Entity_SetActive("medical_room_block_box", true);
			
			// Don't lock both extenders inside lab A
			if (mlExtendersInMedLab>1 && mbPlayerIsInMedLab==false)
				return;
		}
		
		Entity_SetActive("medical_room_block_box", !abActive);
		
		SetDoorActive("FirstDoor", abActive);
		Lamp_SetLit("Lamp_Entrance_Group_2*", abActive, true);
		
		float fEnvLightLvl = abActive?1.f:0.f;
		float fTime = abActive?0.5f:0.f;
		Light_FadeBrightnessTo("Light_Box_Entrance_Group_2_*", fEnvLightLvl, fTime);
	}
	
	//-------------------------------------------------------
	
	void OnStateChange_FirstDoorSwitch(const tString &in asEntity, int alState)
	{
		if (alState==-1)
			ClearLabADoorArea("Area_MedLabDoorKeeper", "Area_MedLabDoorPushTarget");
	}
	
	//-------------------------------------------------------
	
	void OnReceiverPower_Start(bool abActive, const tString&in asEntity)
	{
		Lamp_SetLit("Lamp_Entrance_Group_1*", abActive, true);
		
		float fEnvLightLvl = abActive?1:0;
		float fTime = abActive?0.5:0;
		Light_FadeBrightnessTo("Light_Box_Entrance_Group_1_*", fEnvLightLvl, fTime);
	}
		
