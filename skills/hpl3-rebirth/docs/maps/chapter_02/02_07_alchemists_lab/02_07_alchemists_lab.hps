	{
		if (abActive==false && mbPlayerIsInVitaeLab) return;
		
		Lamp_SetLit("Lamp_Corridor_*", abActive, true);
		float fCorridorBrightness = abActive ? 2 : 0;
		Light_FadeBrightnessTo("Corridor_light_*", fCorridorBrightness, 0.2);
		
		SetDoorActive("OfficeDoor", abActive);
		
		Lamp_SetLit("Lamp_Corridor_Group_1*", abActive, true);
		Lamp_SetLit("Lamp_VitaeLab_Group_1*", abActive, true);
	}
	
