	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test0)
		{
			Item_AddToInventory("VitaeCanister");
			Item_AddToInventory("VitaeCanister");
			//Item_AddToInventory("Orb");
			//Player_Teleport("Start_PortalLab_A", true);
		}
		if(alAction == eAction_Test1)
		{
			FearHandler_SetActive(true);
			FearHandler_SetForcedAddFearRate(eFearForcedRateType_Script, 0.5f, 6.f, true, -1.f, 0.1f);
		}
		if (alAction == eAction_Test2)
		{
			
			//SetPortalOn(true);
			//Entity_SetActive("EmitterMask_Corridor_1", !Entity_IsActive("EmitterMask_Corridor_1"));
			//Entity_SetActive("EmitterMask_Corridor_2", !Entity_IsActive("EmitterMask_Corridor_2"));
			//cLux_AddDebugMessage("Active 1" + Entity_IsActive("EmitterMask_Corridor_1"));
			//cLux_AddDebugMessage("Active 2" + Entity_IsActive("EmitterMask_Corridor_2"));
			
			//ClearLabADoorArea("Area_LabADoorKeeper_Front", "Area_LabADoorPushTarget_Front");
			//ClearLabADoorArea("Area_LabADoorKeeper_Back", "Area_LabADoorPushTarget_Back");
			
			//SetAlchemistDyingState(false);
			//SetDoorActive("OfficeDoor", true);
		}
		if (alAction == eAction_Test3)
		{
			//OnTimer_EnableFakeOrbPickup("");
			//SetAlchemistDyingState(false);
			//Seq_TogglePillars("");
			//FearHandler_SetActive(true);
			//FearHandler_SetForcedAddFearRate(eFearForcedRateType_Script, 0.5f, 6.f, true, -1.f, 0.1f);
			Player_Teleport("Start_PortalLab", true);
			OnReceiverPower_FirstDoor(true, "");
		}
		if (alAction == eAction_Test4)
		{
			Player_Teleport("Start_VitaeLab", true);
			OnReceiverPower_FirstDoor(true, "");
			OnReceiverPower_Office(true, "");
			//SetAlchemistDyingState(true);
			//Slide_SetSlideAmount("ConfigSlider_Hor", 0.0f);
		}
		if (alAction == eAction_Test5)
		{
			Player_Teleport("Start_PortalLab", true);
			OnReceiverPower_FirstDoor(true, "");
			OnReceiverPower_LabB(true, "");
			mbExtenderSent=true;
		}
		if (alAction==eAction_Test6)
		{
			Player_Teleport("Start_Rift", true);
			OnReceiverPower_FirstDoor(true, "");
			OnReceiverPower_LabB(true, "");
			Seq_ShadowFleshCorridor("");
			Seq_ShadowFleshLabB_Part1("");
			Seq_ShadowFleshLabB_Part2("");
			mbExtenderSent=true;
		}
		
		if (alAction == eAction_Test7)
		{
			mfTowerBillboardScale = 0;
			cVector3f vPlayerPos = Player_GetFeetPosition();
			cVector3f vOrbPos = Map_GetEntity("OrbAnimPos").GetPosition();
			vOrbPos.y = vPlayerPos.y;
			float fAngle = cMath_GetAngleFromPoints3D(vOrbPos, vPlayerPos).y;
			
			PlayerBody_PlayCutsceneAtEntity("pick_up_and_look_at_orb_pedestal", "OrbAnimPos", false, 0.5, "OnAnimEnd_DisableFakeOrbPickup", 1, 0, 0, cMath_ToDeg(fAngle));
			
			// Delay this so it actually looks like it's been grabbed
			Map_AddTimer("Timer_EnableFakeOrbPickup", 0.5f, "OnTimer_EnableFakeOrbPickup");
			Voice_PlayDelayed("Dialogue_SeeOrbDestination", 3.5);
			Map_AddTimer("Timer_AddPedestalOrbToInventory", 7.f, "OnTimer_AddOrbToInventory");
			
			PlayerBody_SetCutsceneMaxPitch(18);
			PlayerBody_SetCutsceneMaxYaw(25);
		}
		
		if (alAction==eAction_Test8)
		{
			HeadTracker_SetActive("alchemist", true);
		}
		
		if (alAction==eAction_Test9)
		{
			HeadTracker_SetActive("alchemist", false);
		}
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		UpdatePillarPuzzle(afTimeStep);
		
		///////////////////////
		// Fade in the tower billboard when picking up the orb from pedestal.
		if (Map_GetEntity("Orb_Target_Hand").IsActive())
		{
			float fFadeTime = afTimeStep * 0.15;
			mfTowerBillboardScale = cMath_IncreaseTo(mfTowerBillboardScale, fFadeTime, 0.15f);
			iLuxEntity@ pOrbHandEnt1 = Map_GetEntity("Orb_Target_Hand", eLuxEntityType_Prop);
			cBillboard@ pBillboard = pOrbHandEnt1.GetBillboardFromName("Billboard_1");
			pBillboard.SetSize(mfTowerBillboardScale);
		}
		
		/////////////
		// Vitae flow
		if (mPipe01!=null) mPipe01.OnUpdate(afTimeStep);
		if (mPipe02!=null) mPipe02.OnUpdate(afTimeStep);
		if (mPipe03!=null) mPipe03.OnUpdate(afTimeStep);
		if (mAlchemistsPipe!=null) mAlchemistsPipe.OnUpdate(afTimeStep);
	}
 
	//-------------------------------------------------------
 
