	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
	
	bool mbRiftShadowAppeared = false;
	cVitaePipe mPipe01;
	cVitaePipe mPipe02;
	cVitaePipe mPipe03;
	cVitaePipe mAlchemistsPipe;
	
	//-------------------------------------------------------
	
	void SetDoorActive(const tString &in asDoor, bool abActive)
	{
		if (!abActive)
			MovingButton_SetSwitchedOn(asDoor+"_Button*", false, true);
		
		MovingButton_SetLocked(asDoor+"_Button*", !abActive, true);
	}
 
	//-------------------------------------------------------
	
	void OnInteract_DoorBtnFeedback(const tString &in asEntity)
	{
		if (MovingButton_IsLocked(asEntity)==false) return;
		Sound_CreateAtEntity(asEntity+"NegativeFeedback", "03_07_dw_factory/torture_victim/machine_feedback/button_negative", asEntity);
	}
	
	//-------------------------------------------------------
	
	void Timer_LightLamp(const tString &in asTimer)
	{
		Lamp_SetLit(asTimer, true, true);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_SetExtenderStaticPhysics(const tString&in asTimer)
	{
		// Making sure player won't lock himself in the map.
		if (Entity_IsSleeping(asTimer) && Map_GetEntity(asTimer, eLuxEntityType_Prop).GetVarBool("bInsidePortal")==false)
			Prop_SetStaticPhysics(asTimer, true);
		else
			Map_AddTimer(asTimer, 0.5, "OnTimer_SetExtenderStaticPhysics");
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_ShadowFleshDamage(const tString &in asParent, const tString &in asChild, int alState)
    {
        if (alState!=1) return true;
		float fDmgTime = cMath_RandRectf(0.5, 1.5);
		if (Map_TimeHasPassed("Timer_ShadowFleshDamage", fDmgTime) == false) return true;
        Player_GiveDamage(0.1f, 0.2f, eDamageType_Guardian, asParent);
        return true;
    }
	
	//-------------------------------------------------------
		
	bool OnTrigger_PlayLabMusic(const tString &in asParent, const tString &in asChild, int alState)
	{
		Music_PlayExt("A2_02_07_Lab_Ambience.ogg", true, 0.2f, 1.0f, 60.0f, 1.0f, eMusicPrio_BgAmb, true);
		Map_AddTimer("Timer_MusicFade", 360.0f, "OnTimer_FadeLabMusic");
		return false;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_FadeLabMusic(const tString &in asTimer)
	{
		Music_Stop(60.0f, eMusicPrio_BgAmb);
	}
	
	//-------------------------------------------------------
	
	void DropDebris(const tString&in sName)
	{
		array<iLuxEntity@> vEnts;
		Map_GetEntityArray(sName, vEnts, eLuxEntityType_Prop);
		
		for(int i=0;i<vEnts.length();++i)
		{
			Prop_SetStaticPhysics(vEnts[i].GetName(), false);
			vEnts[i].GetMainBody().AddImpulse(cVector3f(0,-1,0) * 0.5);
		}
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_RegisterPlayerAndExtenders(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (asParent == "Area_Register_ExtenderCount_VitaeLab")
		{
			if (alState==1)
				mbPlayerIsInVitaeLab = true;
			else if (alState==-1)
				mbPlayerIsInVitaeLab = false;
			return true;
		}
		
		if (asParent != "Area_Register_ExtenderCount_MedLab") return true;
		
		if (alState==1)
		{
			if (asChild=="Extender_PillarRoom" || asChild=="Extender_Start")
				mlExtendersInMedLab+=1;
			else
				mbPlayerIsInMedLab=true;
		}
		else if (alState==-1)
		{
			if (asChild=="Extender_PillarRoom" || asChild=="Extender_Start")
				mlExtendersInMedLab-=1;
			else
				mbPlayerIsInMedLab=false;
		}
		
		return true;
	}
	
	//-------------------------------------------------------

	void OnTimer_AddOrbToInventory(const tString&in asTimer)
	{
		Item_AddToInventory("Orb", true);
	}
	
	//-------------------------------------------------------
	
	void ClearLabADoorArea(const tString&in asDoorArea, const tString&in asImpulseTar)
	{
		array<iPhysicsBody@> vPhysBodies;
		GetRigidBodiesInArea(asDoorArea, vPhysBodies);
		if (vPhysBodies.length()<=0) return;
		
		iLuxEntity@ pImpulseTar = Map_GetEntity(asImpulseTar, eLuxEntityType_Area);
		if (pImpulseTar==null) return;
		
		for (int i=0; i<vPhysBodies.length(); i++)
		{
			tString sPhysEntName = cLux_GetBodyEntity(vPhysBodies[i]).GetName();// .GetEntityParent().GetName();
			iLuxEntity@ pPhysEnt = Map_GetEntity(sPhysEntName, eLuxEntityType_Prop);
			if (pPhysEnt==null) continue;
			
			cVector3f vImpulseDir = (pPhysEnt.GetPosition() - pImpulseTar.GetPosition()) * -1;
			vImpulseDir.Normalize();
			
			Entity_AddImpulse(sPhysEntName, (vImpulseDir * 8.f), false, false);
			
			//vPhysBodies[i].SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-Door_ColGroup"));
		}
	}
	
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
 
