	//-------------------------------------------------------
	
	void SetAlchemistDyingState(const bool abActive)
	{
		tString sAnimToPlay = abActive ? "dying" : "idle";
		bool bLoop = !abActive;
		Entity_PlayAnimation("alchemist", sAnimToPlay, 3.f, bLoop);
		
		WakeUpAlchemistsHosePhysics();
		
		//The dying anim is too big. 
		if (abActive==false) return;
		
		iLuxEntity@ pEnt = Map_GetEntity("alchemist", eLuxEntityType_Prop);
		cMeshEntity@ pMeshEnt = pEnt.GetMeshEntity();
		cAnimationState@ pAnim = pMeshEnt.GetAnimationStateFromName("dying");
		pAnim.SetRelativeTimePosition(0.3f);
	}
	
	//-------------------------------------------------------
	
	void WakeUpAlchemistsHosePhysics()
	{
		iLuxEntity@ pHose = Map_GetEntity("alchemists_pipe", eLuxEntityType_Prop);
		for (int i=0; i< pHose.GetBodyNum(); i++)
		{
			pHose.GetBody(i).AddImpulse(cVector3f_Down * 0.5);
		}
	}
	
