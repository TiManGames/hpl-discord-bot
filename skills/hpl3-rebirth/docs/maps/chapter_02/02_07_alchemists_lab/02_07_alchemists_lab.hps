class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		//Set far plane far away
		Player_SetCameraFarPlane(8192.0f);
		
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("02-07-alchemists-lab");
		
		//Limit the physics world
		cLux_GetCurrentMap().GetPhysicsWorld().SetWorldSize(Map_GetEntity("Target_PhysicsMin").GetPosition(), Map_GetEntity("Target_PhysicsMax").GetPosition());
		
		Pregnancy_SetStage(ePregStage_Stage1);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkMinimumStage(eBabyTalkStage_Alchemists);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingMonster);
		Player_SetAllowCheckBaby(true);
		Pregnancy_SetBabyKicksEnabled(true);
		
		FearHandler_SetWhisperStage(eFearWhisperStage_BabyKickToHQA);

		ParticleSystem_SetActive("portal_lab_teleport_IN", false);
		ParticleSystem_SetActive("portal_lab_teleport_OUT", false);
		
		// Reset effects
		Effect_Bloom_FadeBrightPass(0.75f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(0.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		// Setup effects
		Map_Preset_SetupDirLight("Preset_Default", false, cColor(0.269,0.339,0.35,1), 0.f, cVector3f(-0.721, -0.597, -0.352), cColor(0.222,0.289,0.299,1), cColor(0.101,0.171,0.182,1));
		Map_Preset_SetupColorGrading("Preset_Default", "grading_default.dds");
		Map_Preset_SetupBloom("Preset_Default", 128.f, 0.75f, 0.5f, cColor(1.f));
		
		Map_Preset_SetupDirLight("Preset_LightningMin", true, cColor(1,1.5,2,1)*0.125, 2, cVector3f(-0.721, -0.597, -0.352), cColor(0.092,0.069,0.069,1), cColor(0.092,0.069,0.069,1));
		Map_Preset_SetupColorGrading("Preset_LightningMin", "grading_default.dds");
		Map_Preset_SetupBloom("Preset_LightningMin", 128.f, 0.75f, 0.5f, cColor(1.f));
		
		Map_Preset_SetupDirLight("Preset_LightningFull", true, cColor(1,1.5,2,1), 2, cVector3f(-0.721, -0.597, -0.352), cColor(0.092,0.069,0.069,1), cColor(0.092,0.069,0.069,1));
		Map_Preset_SetupColorGrading("Preset_LightningFull", "grading_lightning_flash");
		Map_Preset_SetupBloom("Preset_LightningFull", 4, 0.02f, 1.5f, cColor(1, 2, 2, 1));
		
		Map_Preset_Fade("Preset_Default", 0.0f);
		
		StruggleFlashHandler_SetActive(false);
		// Set up color grading etc.

		// Fixing flickering clouds objects.
		Prop_SetRenderLayer("dw_alchemist_glass_dome",-1);
		Prop_SetRenderLayer("Billboard_front_window",-2);
		Prop_SetRenderLayer("dwf_vista_clouds",-3);
		Prop_SetRenderLayer("dwf_vista_clouds_slow",-4);
		Prop_SetRenderLayer("dwf_vista_clouds_slow_1",-5);
		Billboard_SetRenderLayer("Searchlight_tower_15", -6);
		Billboard_SetRenderLayer("Searchlight_tower_16", -7);
		
		Player_SetAutoTeleportWhenBelowAltitude(-8);

	}
	
