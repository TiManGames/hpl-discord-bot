	{
		Prop_SetStaticPhysics(asEntity, false);
	}
	
	//-------------------------------------------------------
	
	void OnInteractLeave_TogglePhysicsOff(const tString &in asEntity)
	{
		Map_AddTimer(asEntity, 0.5, "OnTimer_SetExtenderStaticPhysics");
	}
	
