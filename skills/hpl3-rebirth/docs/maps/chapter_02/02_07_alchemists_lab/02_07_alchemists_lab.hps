	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 8 *THE PLAYER OPENS THE RIFT AND LEAVES THE DARK WORLD*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////

	void OnRiftStage_Exit(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)
	{
		cLux_AddDebugMessage("afOpenAmount " + afOpenAmount);
		
		Prop_SetActiveAndFade("Wall_rift_rock_*", afOpenAmount < 0.55, 1.f);
		
		if (afOpenAmount >= 0.75 && abOpening)
			StartShadowFleshRift();
	}
	 
	//-------------------------------------------------------
	
	void StartShadowFleshRift()
	{
		if (mbRiftShadowAppeared==false && SequenceStates_IsActive("Seq_ShadowFleshRift")==false)
			Seq_ShadowFleshRift("");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeq_ShadowFleshRift;
	void Seq_ShadowFleshRift(const tString &in asTimer)
	{
		Sequence_Begin("Seq_ShadowFleshRift", mSeq_ShadowFleshRift);
		Sequence_Wait(1.f);
		if (Sequence_DoStepAndWait(0.5f))
		{
			mbRiftShadowAppeared=true;
			
			ShadowFlesh_Spawn("ShadowChase_Path_25_*", "Decal_ShadowChase_Path_25_*", 1.5f, 2.5f, true);
			
			ShadowFlesh_Spawn("ShadowChase_Path_28_*", "Decal_ShadowChase_Path_28_*", 1.5f, 3.5f, true);
			DropDebris("Debris_ShadowChase_Path_28_*");
			
			Effect_Shake_Start(0.065f, 2.f, 1.f, 1.f);
			
			Sound_CreateAtEntity("Sound_ShadowRoar", "creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", "player");
			Music_Play("A2_02_07_Shadow_Wake.ogg", 0.3f, false, eMusicPrio_MinorEvent);
			Map_AddTimer("Timer_ShadowMusic", 10.5f, "OnTimer_ShadowAmbMusic");
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			FearHandler_SetForcedAddFearRate(0.5f, 6.f, true, -1.f, 0.1f);
		}
		else if (Sequence_DoStepAndWait(1.0f))
		{
			ShadowFlesh_Spawn("ShadowChase_Path_26_*", "Decal_ShadowChase_Path_26_*", 1.5f, 2.f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_26_*", true);
			
			ShadowFlesh_Spawn("ShadowChase_Path_27_*", "Decal_ShadowChase_Path_27_*", 1.5f, 3.f, true);
            ShadowFlesh_Spawn("ShadowChase_Path_30_*", "Decal_ShadowChase_Path_30_*", 1.5f, 3.f, true);
		}
		else if (Sequence_DoStepAndContinue())
		{
			Voice_PlayDelayed("Dialogue_IntoTheRift", 1.f);
			FearHandler_SetForcedAddFearRate(0.5f, 6.f, true, -1.f, 0.1f);
			
			Music_Play("A2_3_3_Shadow_Guardian_Slime.ogg", 0.6f, false, eMusicPrio_BigEvent);
		}
		
		Sequence_End();
	}
	 
	//-------------------------------------------------------
	
	void OnTimer_ShadowAmbMusic(const tString &in asTimer)
	{
		Music_PlayExt("A2_02_07_Shadow_Exit.ogg", true, 0.3f, 1.0f, 5.0f, 1.0f, eMusicPrio_SceneAmb, true);
	}
	 
	//-------------------------------------------------------
	
	bool OnCollision_FinalShadowEvent(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState!=1) return true;
		
		ShadowFlesh_Spawn("ShadowChase_Path_24_*", "Decal_ShadowChase_Path_24_*", 1.5f, 2.f, true);
		ShadowFlesh_Spawn("ShadowChase_Path_29_*", "Decal_ShadowChase_Path_29_*", 1.5f, 2.f, true);
		Effect_Shake_Start(0.065f, 1.f, 1.f, 1.f);
		Light_FadeBrightnessTo("Light_Point_4", 0, 2);
		Sound_CreateAtEntity("Sound_ShadowRoar", "creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", "player");
		
		//Player_SetNightVisionEnabled(false);
		FearHandler_SetForcedAddFearRate(0.5f, 6.f, true, -1.f, 0.1f);
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_EndMap(const tString &in asParent, const tString &in asChild, int alState)
	{
		Seq_EndMap("");
		return false;
	}
	 
	//-------------------------------------------------------
	
	cSequenceStatesData mSeq_EndMap;
	void Seq_EndMap(const tString &in asTimer)
	{
		Sequence_Begin("Seq_EndMap", mSeq_EndMap);
		
		if (Sequence_DoStepAndWait(1.))
		{
			Effect_Fade_Out(0.5);
		}
		else if (Sequence_DoStepAndContinue())
		{
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			Sketchbook_AddIdea("cross_alchemistrift");
			Sketchbook_NewIdeasPage();

			Map_ChangeMap("02_07_alchemists_lab_dream.hpm", "Start_Begin", "", "", false);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void OnGuiDWNote(const tString&in asEntityName, float afTimeStep)
	{
		DWNote_RenderGUI(asEntityName, afTimeStep);
	}
}