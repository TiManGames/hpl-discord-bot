	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(6);
		
		FearHandler_SetActive(true);
		
		HeadTracker_SetActive("alchemist", true);
		
		Entity_SetEffectsActive("Pillar_*", false, false);
		ParticleSystem_SetActive("PS_PillarBeam_*", false);
		ParticleSystem_SetActive("PortalLabA_Idle_PS", false);
		
		Light_FadeBrightnessTo("PedestalHolder_Light_1", 0, 0.1);
		ParticleSystem_SetActive("PedestalHolder_PS", false);
		ParticleSystem_SetVisible("PedestalHolder_PS", false);
		
		StickyArea_AttachBody("Area_Sticky_MaskSlot", "alchemists_pipe_Body_11");
		
		///////////////////////
		// Init lights
		Lamp_SetLit("Lamp_Entrance_Group_2*", false, true);
		
		Lamp_SetLit("Lamp_Corridor_*", false, true);
		Light_FadeBrightnessTo("Corridor_light_*", 0, 0.2);
		
		//DarkWorldPower_AddMask("Emitter_LabB", "EmitterMask_Corridor_1");
		
		/////////////////////////
		// Setup shadow entities.
		Entity_SetActive("ShadowChase_Path_*", false);
		ShadowFlesh_SetupDecals("Decal_ShadowChase_Path_*");
		Light_SetBrightness("Light_ShadowChase_Path_*", 0);
		Entity_AddCollideCallback("player", "ShadowChase_Path_*", "OnCollide_Player_ShadowFleshDamage");
		
		////////////////////
		// Setup Vitae Pipes
		mPipe01 = cVitaePipe("dwf_minitower_pipe_01", "dwf_minitower_vitae_flow_front");
		mPipe02 = cVitaePipe("dwf_minitower_pipe_02", "dwf_minitower_vitae_flow_right");
		mPipe03 = cVitaePipe("dwf_minitower_pipe_03", "dwf_minitower_vitae_flow_left");
		mAlchemistsPipe = cVitaePipe("alchemists_pipe", "life_support_machine_vitae");
		
		if (mPipe01!=null)
		{
			mPipe01.SetUvTime(0.5f);
			mPipe01.SetUvCoverage(0.5f);
		}
		
		if (mPipe03!=null)
		{
			mPipe03.SetUvTime(0.5f);
			mPipe03.SetUvCoverage(0.5f);
		}
		
		if (mAlchemistsPipe!=null)
		{
			mAlchemistsPipe.SetUvTime(0.5);
			mAlchemistsPipe.SetUvCoverage(0.5f);
		}
		
		/////////////////////
		// Orb pedestal setup
		Entity_StopAnimation("dw_orb_holder_1");
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			if (ItemType_GetCountInInventory("Lantern") < 1)
			{
				Item_AddToInventory("Lantern");		
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
				Item_AddToInventory("HerbertOil");
				Item_AddToInventory("HerbertOil");
				Item_AddToInventory("HerbertOil");
			}
			
			Item_AddToInventory("Matchbook");
			Item_AddToInventory("Matchbook");
			Item_AddToInventory("Matchbook");
			
			if (ItemType_GetCountInInventory("Orb") < 1)
			{
				Item_AddToInventory("Orb");
			}
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		cVector3f vRot = cVector3f(0, cMath_ToRad(52), 0); //old value 110
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);
		
		PlayerBody_SetModel("player4.ent");
		PlayerBody_SetActive(true);
        Heat_SetActive(false);
		
		Amulet_StartTracking(true, "", -1.f);
		
		SetAlchemistDyingState(false);
		
		Map_Preload("02_07_alchemists_lab_dream.hpm");
		
		InitPillarPuzzle();
		InitDarkWorldLightning();
		
		Pregnancy_SetBabyKickRateMul(0.25f);
		FearHandler_SetPermaFailEnabled(false);
		
		/////////////////
		// Setup critters
		Critter_SetGroupEntity("alien_worm_critters_*", "worm_flock_box");
		
		Achievement_Unlock(eAchievement_Nomad);
		
		Player_SetNightVisionEnabled(false);
		
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
	}

	//-------------------------------------------------------

