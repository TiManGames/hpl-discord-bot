	//-------------------------------------------------------
	
	void PlayAlchemistsBreath(const int alType)
	{
		if (Sound_Exists("AlchemistVoice"))
			Sound_Stop("AlchemistVoice", 0.2);
		
		if (mbAlchemistIsDead || alType==-1) return;
		
		if (alType==0)
			Sound_CreateAtEntity("AlchemistVoice", "03_07_dw_factory/torture_victim/victim_reactions/victim_breathe_slow", "alchemist", 0.2, true, 1);
		else if (alType==1)
			Sound_CreateAtEntity("AlchemistVoice", "03_07_dw_factory/torture_victim/victim_reactions/victim_breathe_normal", "alchemist", 0.2, true, 1);
		else if (alType>1)
			Sound_CreateAtEntity("AlchemistVoice", "03_07_dw_factory/torture_victim/victim_reactions/victim_breathe_afraid", "alchemist", 0.2, true, 1);
	}
	
	//-------------------------------------------------------
	
	void DisableAlchemistBreathing()
	{
		//PlayAlchemistsBreath(-1);
		Entity_SetActive("Trigger_LookAtLifeMachineLever", false);
		Entity_SetActive("Trigger_LookAtLifeMachineCanister", false);
	}
	
	//-------------------------------------------------------
	
	void OnInteract_LifeSupportVitaeCanister(const tString &in asEntity)
	{
		Item_AddToInventory("VitaeCanister", true);
		
		Sound_CreateAtEntity("CanisterPickup"+asEntity, "03_07_DW_theatre/canister_unplug/small/small_remove", asEntity, 0, false, 1, 5, 20);
		
		DisableAlchemistBreathing();
		
		Entity_SetActive("VitaeCanister_LifeSupport", false);
		
		Light_SetBrightness("Light_Canister_LifeSupport", 0);
		Entity_SetActive("VitaeSlot_3", true);
		
		if (Sound_Exists("LifeSupportSound"))
			Sound_Stop("LifeSupportSound", 1.f);
			
		Sound_Stop("Sound_LifeSupportFunctioning", 2.0f);
		Sound_CreateAtEntity("LifeSupportStop", "02_07_alchemist_lab/life_support/power_down", "Area_LifeSupportSoundSource");
			
		Lamp_SetLit("lamp_life_support_machine_*", false, false);
		
		mAlchemistsPipe.SetUvTime(0.5);
		mAlchemistsPipe.FadeUvTime(1, 20.f);
		mAlchemistsPipe.SetUvCoverage(0.5);
		mAlchemistsPipe.FadeUvCoverage(0.1, 20.f);
		
		//////////////////////////
		// Start Alchemist's Death
		if (mbAlchemistIsDead) return;
		Seq_DisableLifeSupport("");
		SetAlchemistDyingState(true);
	}
	
	//-------------------------------------------------------
	
	void OnConnectionStateChange_OpenLifeSupportDoor(const tString &in asEntity, int alState)
	{
		if (alState!=1 || SwingDoor_GetClosed("life_support_machine_door")==false) return;
		Map_AddTimer("Timer_OpenLifeSupportDoor", 0.3f, "OnTimer_OpenLifeSupportDoor");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_OpenLifeSupportDoor(const tString&in asTimer)
	{
		SwingDoor_SetBlocked("life_support_machine_door", false, true);
		SwingDoor_PushOpen("life_support_machine_door", 2, 3);
		
		//////////
		// Breathing controls
		Entity_SetActive("Trigger_LookAtLifeMachineLever", false);
		Entity_SetActive("Trigger_LookAtLifeMachineCanister", true);
		
		if (Entity_IsActive("VitaeCanister_LifeSupport"))
			Light_SetBrightness("Light_Canister_LifeSupport", 2);
			
		Sound_CreateAtEntity("LabADoorLock1", "03_07_DW_theatre/canister_unplug/small/small_remove", "life_support_machine_door", 0, false, 1, 5, 20);
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_BlockLifeSupportDoor(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState!=1) return true;
		SwingDoor_SetClosed("life_support_machine_door", true, true);
		SwingDoor_SetBlocked("life_support_machine_door", true, true);
		
		//////////
		// Breathing controls
		Entity_SetActive("Trigger_LookAtLifeMachineLever", true);
		Entity_SetActive("Trigger_LookAtLifeMachineCanister", false);
		
		//PlayAlchemistsBreath(1);
		
		Light_SetBrightness("Light_Canister_LifeSupport", 0);
		
		Sound_CreateAtEntity("LabADoorLock1", "03_07_DW_theatre/canister_unplug/small/small_remove", "life_support_machine_door", 0, false, 1, 5, 20);
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnUse_VitaeCanister_LifeSupport(const tString &in asItemID, const tString &in asTargetEntity)
	{
		////////////////////
		// Breathing control
		//PlayAlchemistsBreath(1);
		Entity_SetActive("Trigger_LookAtLifeMachineCanister", true);
		
		///////////////
		// Canister control
		Entity_SetActive("VitaeCanister_LifeSupport", true);
		Light_SetBrightness("Light_Canister_LifeSupport", 2);
		Entity_SetActive("VitaeSlot_3", false);
		
		Sound_CreateAtEntity("LifeSupportStart", "02_07_alchemist_lab/life_support/power_up", "Area_LifeSupportSoundSource");
		Sound_CreateAtEntity("LifeSupportSound", "02_07_alchemist_lab/life_support/loop_low_function", "Area_LifeSupportSoundSource");
		
		Lamp_SetLit("lamp_life_support_machine_*", true, true);

		mAlchemistsPipe.SetUvTime(0);
		mAlchemistsPipe.FadeUvTime(0.5, 20.f);
		mAlchemistsPipe.SetUvCoverage(0.1);
		mAlchemistsPipe.FadeUvCoverage(0.5, 5.f);
			
		/////////////////////////
		// Stop Alchemist's Death
		if (mbAlchemistIsDead) return true;
		
		SequenceStates_Stop("Seq_DisableLifeSupport");
		SetAlchemistDyingState(false);
		mSequenceDisableLifeSupport.mlStateCounter = 0;
		if (Voice_SubjectIsPlaying("Emote_KitaDies"))
			Voice_Stop("Kita");
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnInteract_VitaeCanister(const tString &in asEntity)
	{
		tString sIndex = cString_GetNumericSuffix(asEntity);
		int lVitaeCanisterSlot = cString_ToInt(sIndex, 4);
		
		Entity_SetActive(asEntity, false);
		Item_AddToInventory("VitaeCanister", true);	
		
		Sound_CreateAtEntity("CanisterPickup"+asEntity, "03_07_DW_theatre/canister_unplug/small/small_remove", asEntity, 0, false, 1, 5, 20);
		
		Lamp_SetLit("VitaeGridPodLamp_"+lVitaeCanisterSlot, false, true);
		Light_FadeBrightnessTo("VitaeGridPod_Light_"+lVitaeCanisterSlot, 0, 0.2);
		
		EvaluateVitaeGridSlotActive(lVitaeCanisterSlot);
		ToggleVitaeGridPipesFlow(lVitaeCanisterSlot, false);
	}
	
	//-------------------------------------------------------
	
	bool OnUse_VitaeCanister_VitaeGrid(const tString &in asItemID, const tString &in asTargetEntity)
	{
		tString sIndex = cString_GetNumericSuffix(asTargetEntity);
		tString sCanister = "VitaeGridCanister_Dummy_"+sIndex;
		int lVitaeCanisterSlot = cString_ToInt(sIndex, 4);
		
		Entity_SetActive(sCanister, true);
		Entity_SetPlayerInteractCallback(sCanister, "OnInteract_VitaeCanister", true);
		
		Lamp_SetLit("VitaeGridPodLamp_"+lVitaeCanisterSlot, true, true);
		Light_FadeBrightnessTo("VitaeGridPod_Light_"+lVitaeCanisterSlot, 1, 0.2);
		
		EvaluateVitaeGridSlotActive(lVitaeCanisterSlot);
		ToggleVitaeGridPipesFlow(lVitaeCanisterSlot, true);

		return true;
	}
	
	//-------------------------------------------------------
	
	void ToggleVitaeGridPipesFlow(int alSlotSuffix, bool abActive)
	{
		/////////////////////
		// Vitae flow Actions 
		const float fFadeTime = 4.f;
		if (alSlotSuffix==3)
		{
			if (abActive==false)
			{
				mPipe02.SetUvTime(0.5f);
				mPipe02.FadeUvTime(1.f, fFadeTime);
				mPipe02.SetUvCoverage(0.5f);
				mPipe02.FadeUvCoverage(0.1f, fFadeTime/2);
			}
			else
			{
				if (mPipe02.mfUvTime <= 0 || mPipe02.mfUvTime >= 1)
					mPipe02.SetUvTime(0.f);
					
				mPipe02.FadeUvTime(0.5f, fFadeTime);
				mPipe02.SetUvCoverage(0.1f);
				mPipe02.FadeUvCoverage(0.5f, fFadeTime/2);
			}
		}
		
		if (alSlotSuffix==4)
		{
			if (abActive==false)
			{
				mPipe03.SetUvTime(0.5f);
				mPipe03.FadeUvTime(1.f, fFadeTime);
				mPipe03.SetUvCoverage(0.5f);
				mPipe03.FadeUvCoverage(0.1f, fFadeTime/2);
			}
			else
			{
				if (mPipe03.mfUvTime <= 0 || mPipe03.mfUvTime >= 1)
					mPipe03.SetUvTime(0.f);
					
				mPipe03.FadeUvTime(0.5f, fFadeTime);
				mPipe03.SetUvCoverage(0.1f);
				mPipe03.FadeUvCoverage(0.5f, fFadeTime/2);
			}
		}
		
		Map_RemoveTimer("Timer_StartTowerMainPipeFlow");
		Map_AddTimer("Timer_StartTowerMainPipeFlow", fFadeTime/2, "OnTimer_StartTowerMainPipeFlow");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_StartTowerMainPipeFlow(const tString&in asTimer)
	{
		bool bVitaeSlot3Active = Map_GetEntity("VitaeGridCanister_Dummy_3", eLuxEntityType_Prop).IsActive();
		bool bVitaeSlot4Active = Map_GetEntity("VitaeGridCanister_Dummy_4", eLuxEntityType_Prop).IsActive();
		const float fFadeTime = 4.f;
		
		float fUVCoverage = 0.1f;
		if (bVitaeSlot3Active) fUVCoverage += 0.7f;
		if (bVitaeSlot4Active) fUVCoverage += 0.7f;
		
		if (bVitaeSlot3Active || bVitaeSlot4Active)
		{
			if (mPipe01.mfUvTime <= 0 || mPipe01.mfUvTime >= 1)
				mPipe01.SetUvTime(0.f);
				
			mPipe01.FadeUvTime(0.5f, fFadeTime);
			mPipe01.FadeUvCoverage(fUVCoverage, fFadeTime/2);
		}
		else
		{
			mPipe01.FadeUvTime(1.0f, fFadeTime);
			mPipe01.FadeUvCoverage(0.1f, fFadeTime/2);
		}
		
		Map_RemoveTimer("Timer_LightUpMiniTower");
		Map_AddTimer("Timer_LightUpMiniTower", 2, "OnTimer_LightUpMiniTower");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_LightUpMiniTower(const tString&in asTimer)
	{
		bool bVitaeSlot3Active = Map_GetEntity("VitaeGridCanister_Dummy_3", eLuxEntityType_Prop).IsActive();
		bool bVitaeSlot4Active = Map_GetEntity("VitaeGridCanister_Dummy_4", eLuxEntityType_Prop).IsActive();
		float fBrightness = 0;
		if (bVitaeSlot3Active) fBrightness += 1;
		if (bVitaeSlot4Active) fBrightness += 1;
		Light_FadeBrightnessTo("VitaeGrid_TowerLight_*", fBrightness, 0.5f);
		Entity_FadeEffectBaseColor("Mask_Eye_Illum_*", cColor(1) * fBrightness, 0.5f);
	}
	
	//-------------------------------------------------------
	
	void EvaluateVitaeGridSlotActive(int alIndex)
	{		
		bool bActive = Entity_GetVarInt("VitaeGridCanisterDetector_"+alIndex, "") < 1;
		Entity_SetActive("VitaeGridSlot_"+alIndex, bActive);
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSequenceDisableLifeSupport;
	void Seq_DisableLifeSupport(const tString &in asTimer)
	{
		Sequence_Begin("Seq_DisableLifeSupport", mSequenceDisableLifeSupport);
		Sequence_Wait(6.f);
		if (Sequence_DoStepAndWait(12.00f))
		{				
			Voice_Play("Emote_KitaDies");
			//PlayAlchemistsBreath(-1);
			WakeUpAlchemistsHosePhysics();
		}
		else if (Sequence_DoStepAndContinue())
		{
			cLux_AddDebugMessage("Alchemist died!");
			
			WakeUpAlchemistsHosePhysics();
			
			mbAlchemistIsDead = true;
			
			HeadTracker_SetActive("alchemist", false);
			
			Map_RemoveTimer("Timer_AlchemistBreathe");
			DisableAlchemistBreathing();
			
			//////////////////
			// Tasi's reaction
			if (Entity_IsInPlayerFOV("AlchemistLookAt")==false || mbPlayerCloseToAlchemist==false) return;
			Voice_Play("Dialogue_AlchemistDies");
			Music_Play("A2_02_07_Alchemist_Death.ogg", 0.5f, false, eMusicPrio_MinorEvent);
			
			cLux_AddDebugMessage("Player reacted on alchemist's death!");
			
			Map_AddTimer("Timer_DisableHosePhysics", 2, "OnTimer_DisableHosePhysics");
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DisableHosePhysics(const tString&in asTimer)
	{
		//this is to avoid shaking from static collisions.
		Prop_SetStaticPhysics("alchemists_pipe", true);
	}
	
