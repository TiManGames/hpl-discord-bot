	//-------------------------------------------------------
	
	void OnBreakPot_ReleaseSlugs(const tString &in asEntity)
	{
		array<iLuxEntity@> vpSlugs;
		Map_GetEntityArray("pot_slug_*", vpSlugs);
		
		if (vpSlugs.length()<=0) return;
		
		for(int i=0; i<vpSlugs.length(); i++)
		{
			iLuxEntity@ pSlug = vpSlugs[i];
			if (pSlug==null) continue;
			cVector3f vRandomPos = cMath_RandRectVector3f(cVector3f(-0.2, 0, -0.2), cVector3f(0.2));
			pSlug.SetPosition(Map_GetEntity(asEntity, eLuxEntityType_Prop).GetPosition() + vRandomPos);
			pSlug.SetActive(true);
		}
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////////////
	// Event A *See lightning strikes*
	//{//////////////////////////////////////
	
	//-------------------------------------------------------
	
	tID m_idDarkWorldLightning_FlashLight;
	tString msDWLightning_SoundName = "";
	float mfDWLightning_Volume = 1;
	cVector3f mvDir;
	int mlDWLightning_Bolts = 3;
	int mlDWLightning_Index = -1;
	cVector3f mvDWLightning_Dir;
	float mfDWLightning_LoopAngleOffset = 0;
	cVector3f mvDWLightning_LoopDir;
	int mlDWLightning_AreaCount = 0;
	int mlDWLightning_NoLightningAreaCount = 0;
	
	//-------------------------------------------------------
	
	void InitDarkWorldLightning()
	{
		cLightPoint@ pFlashLight = cLux_GetCurrentMap().GetWorld().CreateLightPoint("DWFlash", "", false);
		pFlashLight.SetBrightness(0);
		pFlashLight.SetRadius(200);
		m_idDarkWorldLightning_FlashLight = pFlashLight.GetID();
		
		mvDWLightning_LoopDir = Map_GetEntity("Widget_LightningDir").GetMatrix().GetTranspose().GetForward();
		mfDWLightning_LoopAngleOffset = 90;
		Map_AddTimer("OnTimer_DarkWorldLightningLoop", 5, "OnTimer_DarkWorldLightningLoop");
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_FirstLightning(const tString &in asParent, const tString &in asChild, int alState)
	{
		DarkWorldLightning(2, Map_GetEntity("Widget_FirstLightningDir").GetMatrix().GetTranspose().GetForward(), 0.5);
		
		Map_RemoveTimer("OnTimer_DarkWorldLightningLoop");
		Map_AddTimer("OnTimer_DarkWorldLightningLoop", 10, "OnTimer_DarkWorldLightningLoop");
		
		Entity_SetActive("Trigger_DWLightningArea_1", true);
		Entity_SetActive("Trigger_DWNoLightningArea_1", false);
		mlDWLightning_NoLightningAreaCount = 0;
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_DWLightningArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		mlDWLightning_AreaCount += alState;
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_Player_DWNoLightningArea(const tString &in asParent, const tString &in asChild, int alState)
	{
		mlDWLightning_NoLightningAreaCount += alState;
		return true;
	}
	
	//-------------------------------------------------------
	
	void RandomDarkWorldLightning(cVector3f &in avDir, float afMaxAngleOffset = 0, float afDelay = 0, const tString&in asSound = "", float afVolume = 1)
	{
		msDWLightning_SoundName = asSound;
		mfDWLightning_Volume = afVolume;
		
		array<int> vIndexCandidates;
		for (int i = 1; i <= mlDWLightning_Bolts; ++i)
		{
			if (mlDWLightning_Index > 0 && i == mlDWLightning_Index) continue;
			vIndexCandidates.push_back(i);
		}
		
		int lIndex = vIndexCandidates[cMath_RandRectl(0, vIndexCandidates.size() - 1)];
		
		cVector3f vDir = avDir;
		vDir.y = 0;
		vDir = cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(cMath_RandRectf(-afMaxAngleOffset, afMaxAngleOffset))), vDir);
		DarkWorldLightning(lIndex, vDir);
	}
	
	//-------------------------------------------------------
	
	void DarkWorldLightning(int alIndex, cVector3f &in avDir, float afDelay = 0, const tString&in asSound = "", float afVolume = 1)
	{
		msDWLightning_SoundName = asSound;
		mfDWLightning_Volume = afVolume;
		
		mlDWLightning_Index = alIndex;
		mvDWLightning_Dir = avDir;
		Map_AddTimer("Timer_DoDarkWorldLightning", afDelay, "OnTimer_DoDarkWorldLightning");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DoDarkWorldLightning(const tString &in asTimer)
	{
		Seq_DarkWorldLightning("");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DarkWorldLightningLoop(const tString &in asTimer)
	{
		if (mlDWLightning_NoLightningAreaCount <= 0)
		{
			bool bFront = false;
			if (Map_TimerExists("LightningInFrontCooldown") == false)
			{
				float fFrontToLoopAngleDiff = cMath_Vector3Angle(mvDWLightning_LoopDir, cVector3f(Player_GetForward().x, 0, Player_GetForward().z));
				if (fFrontToLoopAngleDiff <= mfDWLightning_LoopAngleOffset)
				{
					bFront = true;
					RandomDarkWorldLightning(Player_GetForward(), 20);
					Map_AddTimer("LightningInFrontCooldown", cMath_RandRectf(30, 120), "");
//					Map_AddTimer("LightningInFrontCooldown", 8, "");
					cLux_AddDebugMessage("[Map] Lightning in front");
				}
			}
			if (bFront == false)
			{
				RandomDarkWorldLightning(mvDWLightning_LoopDir, mfDWLightning_LoopAngleOffset);
				cLux_AddDebugMessage("[Map] Lightning random");
			}
		}
		Map_RestartCurrentTimer(cMath_RandRectf(15, 45));
//		Map_RestartCurrentTimer(8);
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeqDataDarkWorldLightning;	
	void Seq_DarkWorldLightning(const tString &in asTimer)
	{
		Sequence_Begin("Seq_DarkWorldLightning", mSeqDataDarkWorldLightning);
		if (Sequence_DoStepAndWait(0.1f))
		{
			Map_AddTimer("Timer_DarkWorldThunder", 0, "OnTimer_DarkWorldThunder");
			
			// only do visuals inside thunder areas
			if (mlDWLightning_AreaCount > 0)
			{
				cVector3f vLightningDir = mvDWLightning_Dir;
				
				cVector3f vLightningBolt = Player_GetPosition() + vLightningDir * cMath_RandRectf(1500, 2500);
				vLightningBolt += cVector3f_Up * cMath_RandRectf(400, 800);
				
				iLight@ pLight = Map_GetLight("Light_Lightning_Point_" + mlDWLightning_Index);
				pLight.SetPosition(vLightningBolt);
				pLight.FadeTo(cColor(0.617,0.951,1,1), pLight.GetRadius(), 0.05f);
				
				cBillboard@ pBillboardBolt = cLux_GetCurrentMap().GetWorld().GetBillboard("Billboard_Lightning_Bolt_" + mlDWLightning_Index);
				pBillboardBolt.SetPosition(vLightningBolt);
				
				cBillboard@ pBillboardGlow = cLux_GetCurrentMap().GetWorld().GetBillboard("Billboard_Lightning_Glow_" + mlDWLightning_Index);
				pBillboardGlow.SetPosition(vLightningBolt);
			
				cVector3f vFlashPos = Player_GetPosition() + vLightningDir * 100 + cVector3f_Up * 75;
				
				iLight@ pFlashLight = cLux_ID_Light(m_idDarkWorldLightning_FlashLight);
				pFlashLight.SetPosition(vFlashPos);
				pFlashLight.SetDiffuseColor(cColor(0.617,0.951,1,1));
				pFlashLight.FadeBrightnessTo(80, 0.05);	
			}
		}
		else if (Sequence_DoStepAndWait(1.f))
		{
			iLight@ pLight = Map_GetLight("Light_Lightning_Point_" + mlDWLightning_Index);
			pLight.FadeTo(cColor(0,0,0,1), pLight.GetRadius(), 0.2f);
			
			iLight@ pFlashLight = cLux_ID_Light(m_idDarkWorldLightning_FlashLight);
			pFlashLight.FadeBrightnessTo(0, 0.3f);
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DarkWorldThunder(const tString &in asTimer)
	{
		cVector3f vPos = Player_GetPosition() + mvDWLightning_Dir * cMath_RandRectf(50, 100);
		vPos += cVector3f_Up * cMath_RandRectf(20, 40);
		
		Debug_DrawSphere(vPos, 1, cColor_Red, 5);
		
		tString sSound = "level_amb_shared/amb/sweeteners/thunder/thunder_strike_inside";
		if (mlDWLightning_AreaCount > 0) sSound = "level_amb_shared/amb/sweeteners/thunder/thunder_strike";
		if (msDWLightning_SoundName != "") sSound = msDWLightning_SoundName;
		
		cLux_AddDebugMessage("SOME SOUND " + sSound);
		cSoundEntity@ pThunder = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("Thunder", sSound, true);
		pThunder.SetPosition(vPos);

		float fVolume = 1;
		if (mlDWLightning_AreaCount <= 0) fVolume = 0.4;
		pThunder.SetVolume(fVolume);
	}
	
	//-------------------------------------------------------
			
	//} END Event A *See lightning strikes*
	
	//-------------------------------------------------------
	 
	//} END SCENE 4
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 5 *THE PLAYER SETS UP THE THREE PILLARS*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
		
		bool mbConfigCorrect = false;
		ePillarSymbol[] mvSelectedSymbols = {ePS_U, ePS_T, ePS_Y};
		bool mbOrbCageOpen = false;
		bool mbPillarsActive = false;
		cSequenceStatesData mSeq_TogglePillars;
		
		//-------------------------------------------------------
		
		void InitPillarPuzzle()
		{
			float fVerTarget = 0.75f;
			float fHorTarget = 0;
			
			Slide_SetSlideAmount("ConfigSlider_Hor", fHorTarget);
			SetConfigSliderState("ConfigSlider_Hor", fHorTarget, 3.0f);
			Slide_SetSlideAmount("ConfigSlider_Ver", fVerTarget);
			SetConfigSliderState("ConfigSlider_Ver", fVerTarget, 5.0f);
			
			UpdateSelectedSymbols(true);
		}
		
		bool SetConfigSliderState(const tString &in asSlider, float afTarget, float afStateNum)
		{
			Entity_SetVarFloat(asSlider, "Target", afTarget);
			
			int lPrevState = Entity_GetVarInt(asSlider, "SelectState");
			int lState = cMath_RoundToInt(afTarget * (afStateNum-1.0f));
			Entity_SetVarInt(asSlider, "SelectState", lState);
			
			return (lPrevState != lState);
		}
		
		//-------------------------------------------------------
		
		void UpdatePillarPuzzle(float afTimeStep)
		{
			bool bUpdateSelection = false;
			//Horizontal Slider
			if (Entity_IsInteractedWith("ConfigSlider_Hor"))
			{
				tString sEntity = "ConfigSlider_Hor";
				float fSlideAmount = Slide_GetSlideAmount(sEntity);
				
				float fTarget = 1.0f;
				if (fSlideAmount < 0.25)
					fTarget = 0;
				else if (fSlideAmount < 0.75)
					fTarget = 0.5f;
					
				bool bStateChanged = SetConfigSliderState(sEntity, fTarget, 3.0f);
				bUpdateSelection = bUpdateSelection || bStateChanged;
			}
			
			//Vertical Slider
			if (Entity_IsInteractedWith("ConfigSlider_Ver"))
			{
				tString sEntity = "ConfigSlider_Ver";
				float fSlideAmount = Slide_GetSlideAmount(sEntity);
				
				float fTarget = 1.0f;
				if (fSlideAmount < 0.125)
					fTarget = 0;
				else if (fSlideAmount < 0.375)
					fTarget = 0.25f;
				else if (fSlideAmount < 0.625)
					fTarget = 0.5f;
				else if (fSlideAmount < 0.875)
					fTarget = 0.75f;
					
				bool bStateChanged = SetConfigSliderState(sEntity, fTarget, 5.0f);
				bUpdateSelection = bUpdateSelection || bStateChanged;
			}
			
			// Move selector
			cVector3f vSelectorPos_Min = Map_GetEntity("ConfigSelector_Min").GetPosition();
			cVector3f vSelectorPos_Max_Hor = Map_GetEntity("ConfigSelector_Max_Hor").GetPosition();
			cVector3f vSelectorPos_Max_Ver = Map_GetEntity("ConfigSelector_Max_Ver").GetPosition();
			float fVert = Slide_GetSlideAmount("ConfigSlider_Ver");
			float fHori = Slide_GetSlideAmount("ConfigSlider_Hor");
			
			cVector3f vSelectorPos_Target = vSelectorPos_Min+((vSelectorPos_Max_Ver-vSelectorPos_Min)*fVert);
			vSelectorPos_Target += (vSelectorPos_Max_Hor-vSelectorPos_Min)*fHori;
			
			Map_GetEntity("ConfigSelector").SetPosition(vSelectorPos_Target);
			
			if (bUpdateSelection)
				UpdateSelectedSymbols(false);
		}
		
		//-------------------------------------------------------
		
		void OnChange_ConfigButton(const tString &in asEntity, int alState)
		{
			if (alState==-1 || mbPillarsActive) return;
			
			if (mbConfigCorrect)
			{
				if (SequenceStates_IsActive("Seq_TogglePillars")==false)
					Map_AddTimer("Seq_TogglePillars", 0.5f, "Seq_TogglePillars");
					
				Slide_SetJammed("ConfigSlider_*", true);
			}
			else
			{
				PlayNegativeFeedback(asEntity);
			}
		}
		
		//-------------------------------------------------------
	
		void Seq_TogglePillars(const tString &in asTimer)
		{
			Sequence_Begin("Seq_TogglePillars", mSeq_TogglePillars);
			
			if (Sequence_DoStepAndWait(0.6f))
			{
				Sound_CreateAtEntity("PillarBeamActivation", "03_03_herberts_hq/beam_filter/beam_filter_correct", "PillarBeamPos");
			}
			else if (Sequence_DoStepAndWait(0.1))
			{
				ToggleSidePillar(1);
			}
			else if (Sequence_DoStepAndWait(0.1))
			{
				ToggleSidePillar(2);
			}
			else if (Sequence_DoStepAndWait(0.6f))
			{
				ToggleSidePillar(3);
			}
			else if (Sequence_DoStepAndWait(0.1))
			{
				Sound_CreateAtEntity("PillarBeamLoop", "03_04_pillar_room/pillar_activate/pillar_energy_flow", "PillarBeamPos", 1, true, 0.125f, 1.0f, 12.5f);
					
				Light_FadeBrightnessTo("Light_PillarBeam_Center_Env", 1, 0.25f);
				
				ParticleSystem_SetActive("PS_PillarBeam_Middle_OutOfFocus", true);
				ParticleSystem_SetVisible("PS_PillarBeam_Middle_OutOfFocus", true);
				Entity_SetActive("main_ray_collector", true);
				
				if (mbOrbCageOpen==false)
				{
					ParticleSystem_SetActive("PS_PillarBeam_Middle", true);
					ParticleSystem_SetVisible("PS_PillarBeam_Middle", true);
					
					if (Sound_Exists("Orb_Active_Loop_1")==false)
						Sound_CreateAtEntity("Orb_Active_Loop_1", "03_07_dw_factory/baby_scanner/baby_scan_loop", "Orb_Target", 0.f, true, 0.55f);
				}
				
				float fPillarRingLightBrightness = mbOrbCageOpen ? 8.f : 32.f;
				Light_FadeBrightnessTo("Light_PillarRing", fPillarRingLightBrightness, 0.1f);
				
				mbPillarsActive = true;
				ToggleMiddlePillarBeamLight();
				
				Entity_SetEffectBaseColor("Lab_B_Symbol_*", cColor(0));
				Light_FadeBrightnessTo("Light_Lab_B_Symbol_*", 0.f, 0.1f);
			}
			else
			{
				EvaluatePortalOn();
			}

			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnChange_ToggleOrbCage(const tString &in asEntity, int alState)
		{
			if (alState==1) ToggleOrbCage(false);
			else if (alState==-1) ToggleOrbCage(true);
			else return;
		}
		
		//-------------------------------------------------------
		
		void ToggleOrbCage(const bool abOpen)
		{
			cLux_AddDebugMessage("Toggle orb cage");
			if (abOpen == mbOrbCageOpen) return;
			mbOrbCageOpen = !mbOrbCageOpen;
			
			tString sCageAnim = abOpen ? "Open" : "Close";
			
			Entity_PlayAnimation("dw_orb_holder_1", sCageAnim, 0.25, false, true, "");
			
			Entity_AttachToSocket("Orb_Pedestal", "dw_orb_holder_1", "Orb_Socket", false);
			Entity_SetActive("OrbSlot", abOpen && mbOrbInPlace==false);
			
			if (Map_TimerExists("OnTimer_OrbCageToggled"))
				Map_RemoveTimer("OnTimer_OrbCageToggled");
				
			float fTime = abOpen ? 0.2f : 0.5f;
			Map_AddTimer("Timer_OrbCageToggled", fTime, "OnTimer_OrbCageToggled");
			
			if (abOpen==false)
			{
				Entity_SetInteractionDisabled("Orb_Pedestal", true);
				Map_RemoveTimer("Timer_EnableOrbInteraction");
				return;
			}
			
			Map_AddTimer("Timer_EnableOrbInteraction", 1.5f, "OnTimer_EnableOrbInteraction");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableOrbInteraction(const tString&in asTimer)
		{
			Entity_SetInteractionDisabled("Orb_Pedestal", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_OrbCageToggled(const tString&in asTimer)
		{
			bool bFocusedBeamActive = mbPillarsActive && mbOrbCageOpen==false;
			ParticleSystem_SetActive("PS_PillarBeam_Middle", bFocusedBeamActive);
			ParticleSystem_SetVisible("PS_PillarBeam_Middle", bFocusedBeamActive);
			
			if (bFocusedBeamActive && Sound_Exists("Orb_Active_Loop_1")==false)
				Sound_CreateAtEntity("Orb_Active_Loop_1", "03_07_dw_factory/baby_scanner/baby_scan_loop", "Orb_Target", 0.f, true, 0.55f);
			else if (Sound_Exists("Orb_Active_Loop_1"))
				Sound_Stop("Orb_Active_Loop_1", 1.f);
			
			if (mbPillarsActive)
			{
				float fPillarRingLightBrightness = mbOrbCageOpen ? 64.f : 16.f;
				Light_FadeBrightnessTo("Light_PillarRing", fPillarRingLightBrightness, 0.1f);
			}
			else
			{
				Light_FadeBrightnessTo("Light_PillarRing", 0.f, 0.1f);
			}
			
			ToggleMiddlePillarBeamLight();
			EvaluatePortalOn();
			
			Lever_SetAutoMoveEnabled("dw_shutters_lever", false);
			Lever_SetAutoMoveTarget("dw_shutters_lever", 1);
		}
		
		//-------------------------------------------------------
		
		void ToggleMiddlePillarBeamLight()
		{
			float fBeamLightBrightness = 0;
			if (mbPillarsActive)
				fBeamLightBrightness = mbOrbCageOpen ? 3 : 8;
				
			Light_FadeBrightnessTo("Light_PillarBeam_Center", fBeamLightBrightness, 0.25f);
		}
		
		//-------------------------------------------------------
		
		void ToggleShutters(const bool abOpen, const bool abInstant=false)
		{
			Entity_SetActive("portal_room_block_box*", !abOpen);
			SlideDoor_SetClosed("dwf_metal_shutters_*", !abOpen, abInstant);
			
			// Keep the player away from getting stuck between the pillars and the shutters
			Map_RemoveTimer("Timer_UnblockPlayer");
			
			if (abOpen==false)
			{
				Entity_SetActive("BlockBox_DebugStuck", true); 
				return;
			}
			
			Map_AddTimer("Timer_UnblockPlayer", 10, "OnTimer_UnblockPlayer");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UnblockPlayer(const tString&in asTimer)
		{
			Entity_SetActive("BlockBox_DebugStuck", false);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_RaiseDust(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			
			for(int i=0; i<6; ++i)
			{
				cParticleSystem@ pShutterDust = ParticleSystem_CreateAtEntity("Area_ShutterDust_Spawner_"+i+"_PS", "dust_impact_large_oneshot.ps", "Area_ShutterDust_Spawner_"+i, false);
				pShutterDust.SetColor(cColor(0.451,0.438,0.277,0.2));
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void ToggleSidePillar(int alPillarNum)
		{
			tString sPillarName = "Pillar_"+alPillarNum;
			Entity_SetEffectsActive(sPillarName, true, true);
			Entity_FadeEffectBaseColor(sPillarName, cColor(2), 1.f);
			
			tString sBeamName = "PS_PillarBeam_"+alPillarNum;
			ParticleSystem_SetActive(sBeamName, true);
			ParticleSystem_SetVisible(sBeamName, true);
			
			tString sLightName = "Light_PillarBeam_"+alPillarNum;
			float fLighBrightness = true ? 5 : 0;
			Light_FadeBrightnessTo(sLightName + "_1", fLighBrightness * 1.5, 0.25f);
			Light_FadeBrightnessTo(sLightName + "_2", fLighBrightness, 0.25f);
			
			Lamp_SetLit("beam_disk_"+alPillarNum, true, true);
		}
		
		//-------------------------------------------------------
		
		void ToggleOrb()
		{
			float fOrbCausticBrightness = 0;
			bool bOrbActive = mbConfigCorrect && mbOrbInPlace && mbPillarsActive && mbOrbCageOpen==false;
			
			if (bOrbActive)
				fOrbCausticBrightness = mbOrbInPlace ? 30 : 0;
			
			Light_FadeBrightnessTo("Light_Pillar_Center_Caustic", fOrbCausticBrightness, 0.15f);
			
			float fIdleOrbLightBrightness = mbOrbInPlace ? 25 : 0;
			Light_FadeBrightnessTo("PedestalHolder_Light_1", fIdleOrbLightBrightness, 0.5);
			ParticleSystem_SetActive("PedestalHolder_PS", mbOrbInPlace);
			ParticleSystem_SetVisible("PedestalHolder_PS", mbOrbInPlace);

			bool bOn = mbPillarsActive && mbConfigCorrect && mbOrbInPlace;
			ParticleSystem_SetActive("PS_PillarBeam_Flare", bOrbActive);
			ParticleSystem_SetVisible("PS_PillarBeam_Flare", bOrbActive);
			
			Entity_SetActive("Orb_Target", bOrbActive);
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_ConfigSlider_Hor(const tString &in asEntity)
		{
			Slide_AutoMoveTo(asEntity, Entity_GetVarFloat(asEntity, "Target"));
			CheckConfig();
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_ConfigSlider_Ver(const tString &in asEntity)
		{
			Slide_AutoMoveTo(asEntity, Entity_GetVarFloat(asEntity, "Target"));
			CheckConfig();
		}
		
		//-------------------------------------------------------
		
		void CheckConfig()
		{
			mbConfigCorrect = mvSelectedSymbols[0] == gvPillarSolution[0] &&
							mvSelectedSymbols[1] == gvPillarSolution[1] &&
							mvSelectedSymbols[2] == gvPillarSolution[2];
		}
		
		//-------------------------------------------------------

		void UpdateSelectedSymbols(bool abInstant)
		{
			int lX = Entity_GetVarInt("ConfigSlider_Hor", "SelectState");
			int lY = Entity_GetVarInt("ConfigSlider_Ver", "SelectState");
			
			Entity_SetEffectsActive("ConfigDeviceSymbol_*", false, true);
			
			Entity_SetEffectsActive("ConfigDeviceSymbol_"+lX+"_"+lY, true, true);
			Entity_SetEffectsActive("ConfigDeviceSymbol_"+(lX+1)+"_"+lY, true, true);
			Entity_SetEffectsActive("ConfigDeviceSymbol_"+(lX+2)+"_"+lY, true, true);
			
			mvSelectedSymbols[0] = gvPanelArray[lY][lX];
			mvSelectedSymbols[1] = gvPanelArray[lY][lX+1];
			mvSelectedSymbols[2] = gvPanelArray[lY][lX+2];
			
			cScript_SetGlobalArgFloat(0, GetSymbolAngle(mvSelectedSymbols[0]));
			cScript_SetGlobalArgBool(1, abInstant);
			cScript_RunGlobalFunc("Pillar_1", "cScrAlchemistsLabPillar", "_Global_SetAngle");
			cScript_SetGlobalArgFloat(0, GetSymbolAngle(mvSelectedSymbols[1]));
			cScript_SetGlobalArgBool(1, abInstant);
			cScript_RunGlobalFunc("Pillar_2", "cScrAlchemistsLabPillar", "_Global_SetAngle");
			cScript_SetGlobalArgFloat(0, GetSymbolAngle(mvSelectedSymbols[2]));
			cScript_SetGlobalArgBool(1, abInstant);
			cScript_RunGlobalFunc("Pillar_3", "cScrAlchemistsLabPillar", "_Global_SetAngle");
		}
		
		//-------------------------------------------------------
		
		float GetSymbolAngle(ePillarSymbol aSymbol)
		{
			switch (aSymbol)
			{
				case ePS_M:
					return 0;
				case ePS_U:
					return 90;
				case ePS_T:
					return 180;
				case ePS_Y:
					return 270;
			}
			return 0;
		}
		
		//-------------------------------------------------------
	 
	//} END SCENE 5
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 6 *THE PLAYER SENDS THE EMITTER THROUGH THE PORTAL*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbOrbInPlace = false;
	bool mbPortalOn = false;
	int mlPortalBCount = 0;
	bool mbExtenderSent = false;
	bool mbMosqueTowerSeen = false;
	cColor ActiveBtnColor(0.451,0.971,0.819,1);
	cColor FailBtnColor(1,0,0,0);
	float mfTowerBillboardScale = 0;
	
	//-------------------------------------------------------

	bool CanUse_Orb(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
	{
		return asPickedEntity == "OrbSlot";
	}
	
	//-------------------------------------------------------
	
	bool OnUse_Orb(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
	{
		Item_Unequip(asItemID);
		Item_RemoveFromInventory(asItemID);
		
		Entity_SetActive("Orb_Pedestal", true);
		Entity_SetInteractionDisabled("Orb_Pedestal", true);
		mbOrbInPlace = true;
			
		Map_AddTimer("Timer_LockLabADoor", 0.5f, "Timer_LockLabADoor");

		EvaluatePortalOn();

		ToggleShutters(false);
		Lever_SetAutoMoveEnabled("dw_shutters_lever", true);
		Lever_SetAutoMoveTarget("dw_shutters_lever", 1);
		
		Sound_CreateAtEntity("PlaceOrb", "new_sounds/player/orb_put_down", "Orb_Pedestal");
		Sound_CreateAtEntity("Sound_ShutterMechClose", "02_07_alchemist_lab/shutter/shutter_mech_close", "Sound_ShutterMovement");
		
		////////////////////
		// Clear slide doors
		ClearLabADoorArea("Area_LabADoorKeeper_Front", "Area_LabADoorPushTarget_Front");
		ClearLabADoorArea("Area_LabADoorKeeper_Back", "Area_LabADoorPushTarget_Back");
		
		//////////////////
		// Lock down lab A
		MovingButton_SetSwitchedOn("LabADoor_Front_Button_1", false, true);
		MovingButton_SetSwitchedOn("LabADoor_Back_Button_1", false, true);
		MovingButton_SetLocked("LabADoor_Front_Button_*", true, true);
		MovingButton_SetLocked("LabADoor_Back_Button_*", true, true);
		
		return true;
	}
	
	//-------------------------------------------------------
	
	void Timer_LockLabADoor(const tString &in asTimer)
	{
		//Sound_Stop("LabADoorMoveLoop", 0);
		Sound_CreateAtEntity("LabADoorLock1", "level_entity_shared/button/pressure_plate/pressure_plate_on", "LabADoor_Front", 0, false, 1, 5, 20);
		Sound_CreateAtEntity("LabADoorLock2", "level_entity_shared/button/pressure_plate/pressure_plate_on", "LabADoor_Back", 0, false, 1, 5, 20);
	}
	
	//-------------------------------------------------------
	
	void Timer_UnlockLabADoor(const tString &in asTimer)
	{
		//if (Sound_Exists("LabADoorMoveLoop1"))
		//	Sound_Stop("LabADoorMoveLoop1", 0.1);
		if (Sound_Exists("LabADoorMoveLoop2"))
			Sound_Stop("LabADoorMoveLoop2", 0.1);
	}
	
	//-------------------------------------------------------
	
	bool CanUse_VitaeCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
	{		
		return (cString_GetFirstStringPos(asPickedEntity, "VitaeGridSlot") > -1 || 
				asPickedEntity == "VitaeSlot_1" || 
				asPickedEntity == "VitaeSlot_2" || 
				asPickedEntity == "VitaeSlot_3");
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_ClearVitaeSlot(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==-1)
		{
			if (asParent=="VitaeSlot_1") Entity_SetVarString("VitaeSlot_1", "sDummyEntIncluded_1", "");
			if (asParent=="VitaeSlot_2") Entity_SetVarString("VitaeSlot_2", "sDummyEntIncluded_2", "");
		}
		else if (alState==1)
		{
			if (asParent=="VitaeSlot_1") Entity_SetVarString("VitaeSlot_1", "sDummyEntIncluded_1", asChild);
			if (asParent=="VitaeSlot_2") Entity_SetVarString("VitaeSlot_2", "sDummyEntIncluded_2", asChild);
		}
		//cLux_AddDebugMessage("msPortalCannisterSlot_1_Ent: " + Entity_GetVarString("VitaeSlot_1", "sDummyEntIncluded_1"));
		//cLux_AddDebugMessage("msPortalCannisterSlot_2_Ent: " + Entity_GetVarString("VitaeSlot_2", "sDummyEntIncluded_2"));
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnUse_VitaeCanister(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
	{
		Item_Unequip(asItemID);
		Item_RemoveFromInventory(asItemID);
		
		Sound_CreateAtEntity("PlaceVitaeCanister", "03_07_DW_theatre/canister_unplug/small/small_insert", asTargetEntity);
		
		/////////////
		// Vitae Grid
		if (cString_GetFirstStringPos(asTargetEntity, "VitaeGridSlot") > -1)
			return OnUse_VitaeCanister_VitaeGrid(asItemID, asTargetEntity);
		
		///////////////////////
		// Life Support Machine
		if (asTargetEntity == "VitaeSlot_3")
			return OnUse_VitaeCanister_LifeSupport(asItemID, asTargetEntity);
		
		//////////////
		//Portal slots
		tString sNumSuff = cString_GetNumericSuffix(asTargetEntity);

		Entity_SetActive("VitaeCanister_Placed_"+sNumSuff, true);
		Entity_SetActive("VitaeSlot_"+sNumSuff, false);
		Map_AddTimer("Lamp_VitaeCanister_"+sNumSuff, 1, "OnTimer_TogglePortalAVitaeLamp");
		Light_FadeBrightnessTo("FailLight_PortalButton_"+sNumSuff, 0.f, 0.2f);
		
		// Disable any dummy canisters left inside.
		tString sDummyVitaeCanister = Entity_GetVarString("VitaeSlot_"+sNumSuff, "sDummyEntIncluded_"+sNumSuff);
		if (sDummyVitaeCanister!="" ) Entity_SetActive(sDummyVitaeCanister, false);
		
		// and that's about it
		EvaluatePortalOn();
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_TogglePortalAVitaeLamp(const tString&in asTimer)
	{
		Lamp_SetLit(asTimer, true, true);
	}
	
	//-------------------------------------------------------
	
	void OnInteract_TakeOrb(const tString &in asEntity)
	{
		mbOrbInPlace = false;
		Entity_SetActive("OrbSlot", true);
		
		EvaluatePortalOn();
		
		MovingButton_SetLocked("LabADoor_Front_Button*", false, true);
		MovingButton_SetLocked("LabADoor_Back_Button*", false, true);
		
		Map_AddTimer("Timer_UnlockLabADoor", 2.5f, "Timer_UnlockLabADoor");
		Map_RemoveTimer("Timer_EvaluatePortalOn");
		
		ToggleShutters(true);
		
		Sound_CreateAtEntity("Sound_ShutterMechOpen", "02_07_alchemist_lab/shutter/shutter_mech_open", "Sound_ShutterMovement");
		
		/////////////////////////
		// final pick up cutscene
		if (mbExtenderSent && mbMosqueTowerSeen==false)
		{
			mfTowerBillboardScale = 0;
			cVector3f vPlayerPos = Player_GetFeetPosition();
			cVector3f vOrbPos = Map_GetEntity("OrbAnimPos").GetPosition();
			vOrbPos.y = vPlayerPos.y;
			float fAngle = cMath_GetAngleFromPoints3D(vOrbPos, vPlayerPos).y;
			
			PlayerBody_PlayCutsceneAtEntity("pick_up_and_look_at_orb_pedestal", "OrbAnimPos", false, 0.5, "OnAnimEnd_DisableFakeOrbPickup", 1, 0, 0, cMath_ToDeg(fAngle));
			PlayerBody_SetCutsceneMaxPitch(18);
			PlayerBody_SetCutsceneMaxYaw(25);
			
			// Delay this so it actually looks like it's been grabbed
			Map_AddTimer("Timer_EnableFakeOrbPickup", 0.5f, "OnTimer_EnableFakeOrbPickup");
			Voice_PlayDelayed("Dialogue_SeeOrbDestination", 1.5, -1,"", 3);
			
			//Delay pickup
			Map_AddTimer("Timer_AddPedestalOrbToInventory", 7.f, "OnTimer_AddOrbToInventory");
			
			mbMosqueTowerSeen = true;
			cScript_SetGlobalVarBool("Alchemists_TowerSeenInOrb", true);
			return;
		}
		
		//////////////////
		// Regular pick up
		Entity_SetActive("Orb_Pedestal", false);
		Item_AddToInventory("Orb", true);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_EnableFakeOrbPickup(const tString&in asTimer)
	{
		Entity_SetActive("Orb_Pedestal", false);
		Entity_SetActive("Orb_Target_Hand", true);
		
		Entity_SetCollideCharacter("Orb_Target_Hand",false);
		Entity_SetCollide("Orb_Target_Hand",false);
		Prop_SetStaticPhysics("Orb_Target_Hand",true);
		
		////////////////////////
		// Attach to player hand
		iLuxEntity@ pOrbHandEnt1 = Map_GetEntity("Orb_Target_Hand", eLuxEntityType_Prop);
		pOrbHandEnt1.SetPosition(PlayerBody_GetSocket("R_Hand").GetWorldPosition());
		Entity_AttachToSocket("Orb_Target_Hand", PlayerBody_GetEntityName(), "R_Hand", true, false);
	}
	
	//-------------------------------------------------------
	
	void OnAnimEnd_DisableFakeOrbPickup(const tString&in asAnim)
	{
		Entity_SetActive("Orb_Target_Hand", false);
		
		if (mbPortalShadowDone) return;
		mbPortalShadowDone=true;
		Map_AddTimer("Timer_AlertShadowPostLabA", 4, "Seq_AlertShadowPostLabA");
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeqAlertShadowPostLabA;
	void Seq_AlertShadowPostLabA(const tString &in asTimer)
	{
		Sequence_Begin("Seq_AlertShadowPostLabA", mSeqAlertShadowPostLabA);
		if (Sequence_DoStepAndWait(0.5f))
		{
			Sound_CreateAtEntity("shadow_roar", "creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", "Area_StartShadowFleshCorridor_1");
			FearHandler_SetForcedAddFearRate(0.5f, 4.f, true, -1.f, 0.1f, 0.5f);
			Voice_PlayDelayed("Dialogue_TheShadowComes", 2, -1, "", 1);
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			Effect_Shake_Start(0.015f, 6.f, 1.f, 1.f);	
		}
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool mbPortalShadowDone = false;
	void EvaluatePortalOn()
	{
		ToggleOrb();
		TogglePortal();
	}
	
	//-------------------------------------------------------
	
	void TogglePortal()
	{
		bool bVitaeCanistersPlaced = Entity_IsActive("VitaeCanister_Placed_1") && Entity_IsActive("VitaeCanister_Placed_2");
		if (!mbPortalOn && mbConfigCorrect && mbOrbInPlace && mbPillarsActive && bVitaeCanistersPlaced && mbOrbCageOpen==false)
		{
			SetPortalOn(true);
			cScript_SetGlobalVarBool("Alchemists_PortalHasTurnedOn", true);
			
			Effect_Shake_Start(0.015f, 0.f, 0.5f, 1.f);
			
			cVector3f vFlashPos = Map_GetEntity("Orb_Target", eLuxEntityType_Prop).GetPosition();
			LightFlash_Add(0.f, 0.1f, 0.5f, vFlashPos, cColor(0.34,0.76,1), 2.5f, 8.f);
		}
		else if (mbPortalOn && 
			(mbConfigCorrect == false || 
			mbOrbInPlace == false || 
			mbPillarsActive == false || 
			Entity_IsActive("VitaeCanister_Placed_1") == false || 
			Entity_IsActive("VitaeCanister_Placed_2") == false || 
			mbOrbCageOpen))
		{
			SetPortalOn(false);
			Effect_Shake_Start(0.0083f, 0.f, 0.2f, 0.5f);
		}
	}
	
	//-------------------------------------------------------
	
	void SetPortalOn(bool abState)
	{
		mbPortalOn = abState;

		Entity_SetActive("PortalEffect", abState);
		ParticleSystem_SetActive("PortalLabA_Idle_PS", abState);
		ParticleSystem_SetVisible("PortalLabA_Idle_PS", abState);
		Entity_SetEffectsActive("PortalButton", abState, true);
		Lamp_SetLit("pillars_lamp_vitae_pipe_*", abState, abState);
		
		if (abState)
		{
			Sound_CreateAtEntity("PortalStart", "04_03_undercity/machine/energy_on", "Portal_A");
			Sound_CreateAtEntity("PortalLoop", "04_03_undercity/machine/energy", "Portal_A", 0, true, 0.5f);
			
			Light_FadeBrightnessTo("Light_Portal_Ring", 2, 0.1);
		}
		else
		{
			Sound_CreateAtEntity("PortalStop", "04_03_undercity/machine/energy_off", "Portal_A");
			Sound_Stop("PortalLoop", 0);
			
			Light_FadeBrightnessTo("Light_Portal_Ring", 0, 0.1);
		}
	}
	
	//-------------------------------------------------------
	
	void OnChange_PortalButton(const tString &in asEntity, int alState)
	{
		if (alState != 1) return;	
		
		////////////////
		// Fail behavior
		if (mbPortalOn==false)
		{
			PlayNegativeFeedback(asEntity);
			return;
		}
		
		///////////
		// Teleport
		if (Map_TimerExists("Timer_CheckPortalEntities")) return;
		
		Timer_CheckPortalEntities("FirstCheck");
		Prop_SetActiveAndFade("portalcage_suckeffect", true, 0.01f);
		Map_AddTimer("Timer_DisablePoartlSuckFx", 0.1, "OnTimer_DisablePortalTeleportFx");
	}
	
	//-------------------------------------------------------
	
	void PlayNegativeFeedback(const tString&in asEntity)
	{
		if (Map_TimerExists(asEntity)) return;
		Map_AddTimer(asEntity, 0.2f, "OnTimer_StopNegativeFeedback");
		
		///////////////////////
		// Control Panel Button
		if (asEntity=="ControlPanelButton")
		{
			Light_SetBrightness("FailLight_ControlPanelButton", 8.f);
			return;
		}
		
		////////////////
		// Portal Button
		if (asEntity!="PortalButton") return;
		
		Entity_SetEffectsActive("PortalButton", true, true);
		
		if (mbOrbInPlace==false || mbOrbCageOpen)
		{
			Light_SetBrightness("FailLight_OrbCage", 8.f);
			Entity_SetEffectBaseColor("pillars_lamp_vitae_pipe_*", cColor(2,0,0,1));
			Lamp_SetLit("pillars_lamp_vitae_pipe_*", true, true);
		}
		
		if (Entity_IsActive("VitaeCanister_Placed_1")==false)
			Light_SetBrightness("FailLight_PortalButton_1", 12.f);
			
		if (Entity_IsActive("VitaeCanister_Placed_2")==false)
			Light_SetBrightness("FailLight_PortalButton_2", 12.f);
	}
	
	//-------------------------------------------------------
	
	void OnTimer_StopNegativeFeedback(const tString&in asTimer)
	{
		Light_FadeBrightnessTo("FailLight_"+asTimer+"*", 0.f, 0.2f);
		
		float fFailLightBrightness_1 = Entity_IsActive("VitaeCanister_Placed_1")? 0 : 3;
		Light_FadeBrightnessTo("FailLight_PortalButton_1", fFailLightBrightness_1, 0.2);
			
		float fFailLightBrightness_2 = Entity_IsActive("VitaeCanister_Placed_2")? 0 : 3;
		Light_FadeBrightnessTo("FailLight_PortalButton_2", fFailLightBrightness_2, 0.2);
		
		/////////////
		// Fail sound
		Sound_CreateAtEntity(asTimer+"NegativeFeedback", "03_07_dw_factory/torture_victim/machine_feedback/button_negative", asTimer);
		
		////////////////
		// Orb and Pipes
		if (asTimer!="PortalButton") return;
		Entity_SetEffectsActive(asTimer, false, false);
		Light_FadeBrightnessTo("FailLight_OrbCage", 0.f, 0.5f);
		
		Lamp_SetLit("pillars_lamp_vitae_pipe_*", false, true);
		Map_AddTimer("OnTimer_ResetPortalPipeColor", 0.2f, "OnTimer_ResetPortalPipeColor");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ResetPortalPipeColor(const tString&in asTimer)
	{
		Entity_SetEffectBaseColor("pillars_lamp_vitae_pipe_*", cColor(1,1,1,1));
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DisablePortalTeleportFx(const tString&in asTimer)
	{
		Prop_SetActiveAndFade("portalcage_suckeffect", false, 1.f);
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_SetExtenderStaticPhysics(const tString &in asParent, const tString &in asChild, int alState)
	{
		// Making sure that the extender can be teleported.
		iLuxEntity@ pExtender = Map_GetEntity(asChild, eLuxEntityType_Prop);
		if (alState==1)
			pExtender.SetVarBool("bInsidePortal", true);
		else if (alState==-1)
			pExtender.SetVarBool("bInsidePortal", false);
		return true;
	}
	
	//-------------------------------------------------------
	
	void Timer_CheckPortalEntities(const tString &in asTimer)
	{
		if (mbPortalOn==false)
		{
			Map_RemoveTimer("Timer_MoveObjectThroughPortal");
			Map_RemoveTimer("Timer_CheckPortalEntities");
			return;
		}
		
		array<iPhysicsBody@> vBodies;
		GetRigidBodiesInArea("Portal_A", vBodies);
		
		if (vBodies.length() > 0)
		{
			tString sName = cLux_GetBodyEntity(vBodies[0]).GetName();
			bool bIsExtender = cString_GetFirstStringPos(sName, "Extender_")>=0;
			
			if (Entity_IsInteractedWith(sName))
				Player_ChangeStateToNormal();
			cVector3f vOffset = vBodies[0].GetWorldPosition() - Map_GetEntity("Portal_A").GetPosition();
			
			if (bIsExtender)
			{
				vOffset = 0;
				mbExtenderSent = true;
			}
			
			//Effects
			PortalSendEffects(sName);
			
			Entity_SetActive(sName, false);
			Entity_PlaceAtEntity(sName, "Portal_B", vOffset, bIsExtender);
			Prop_ClearVelocity(sName);
			ClearPortalB();
			
			Map_AddTimer(sName, 0.8, "Timer_MoveObjectThroughPortal");
			
			float fTimeBetweenObjects = cMath_RandRectf(0.8, 1.2);
			Map_AddTimer("Timer_CheckPortalEntities", fTimeBetweenObjects, "Timer_CheckPortalEntities");
		}
		else if(asTimer == "FirstCheck")
		{
			PortalSendEffects("Portal_A");
			Map_AddTimer("Portal_B", 0.8, "PortalSendEffects");
		}
	}
	
	//-------------------------------------------------------
	
	void PortalSendEffects(const tString &in asEntity)
	{
		Sound_CreateAtEntity("PortalSend", "04_03_undercity/machine/energy_on", "Portal_A");
		ParticleSystem_CreateAtEntity("teleport_in_ps", "portal_lab_teleport_IN.ps", asEntity, false);
		LightFlash_Add(0.1,0.075,0.075, asEntity, cColor(0.42,0.85,1,1), 3, 8);
	}
	
	//-------------------------------------------------------
	
	void PortalArriveEffects(const tString &in asEntity)
	{
		ParticleSystem_CreateAtEntity("teleport_out_ps", "portal_lab_teleport_OUT.ps", asEntity, false);
		Sound_CreateAtEntity("PortalSend", "04_03_undercity/machine/energy_on", "Portal_B");
		LightFlash_Add(0.1,0.075,0.075, asEntity, cColor(0.42,0.85,1,1), 3, 8);
	}
	
	//-------------------------------------------------------
	
	int mlTeleportedObjects = 0;
	
	void Timer_MoveObjectThroughPortal(const tString &in asTimer)
	{
		if (mlPortalBCount > 0)
		{
			Map_AddTimer(asTimer, 0.8, "Timer_MoveObjectThroughPortal");
			return;
		}
		
		Voice_PlayDelayed("Dialogue_TeleportSomething", 1);
		
		Entity_SetActive(asTimer, true);
		PortalArriveEffects(asTimer);
		
		if (asTimer != "Extender_PillarRoom" && asTimer != "Extender_Start")
		{
			mlTeleportedObjects++;
			if (mlTeleportedObjects == 6)
			{
				Achievement_Unlock(eAchievement_Translocator);
				Voice_PlayDelayed("Dialogue_TeleportLots", 1.0f);
			}
		}
			
		
		//Only add initial impulse to non-extenders to clear the area
		if (cString_GetFirstStringPos(asTimer, "Extender_") < 0)
		{
			Entity_AddImpulse(asTimer, cVector3f_Back, false, false);
		}
		
		if (Voice_SubjectExists("Dialogue_TeleportSomething"))
			{
				Music_PlayExt("A2_02_07_Small_Portal_Activate.ogg", false, 0.3f, 1.0f, 0.0f, 1.0f, eMusicPrio_BigEvent, false);
			}
	}
	
	//-------------------------------------------------------
	
	void ClearPortalB()
	{
		array<iPhysicsBody@> vBodies;
		GetRigidBodiesInArea("Portal_B", vBodies);
		
		mlPortalBCount = vBodies.length();
		if (mlPortalBCount==0) return;
		
		float fTime = 0;
		for (int i = 0; i < vBodies.length(); i++)
		{
			tString sName = cLux_GetBodyEntity(vBodies[i]).GetName();
			Map_AddTimer(sName+"_1", fTime, "Timer_PushObjectOutOfPortal");
			fTime+=0.095;
		}
	}
	
	//-------------------------------------------------------
	
	void Timer_PushObjectOutOfPortal(const tString &in asTimer)
	{
		float fSuffix = cString_GetNumericSuffixFloat(asTimer, 1.f);
		int lSuffixPos = cString_GetLastCharPos(asTimer, '_');
		tString sEntity = cString_Sub(asTimer, 0, lSuffixPos);
		
		if (Entity_GetCollide(sEntity, "Portal_B"))
		{
			//cLux_AddDebugMessage("Strength = "+fSuffix);
			
			// Check if the entity seems to be stuck
			if (fSuffix > 3.5f)
			{
				Map_GetEntity(sEntity).GetMainBody().SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-cage"));
			}
			
			Entity_AddImpulse(sEntity, cVector3f_Back*fSuffix, false, false);
			Map_AddTimer(sEntity+"_"+(fSuffix+0.5f), 0.2, "Timer_PushObjectOutOfPortal");
		}
		else
		{
			//cLux_AddDebugMessage("Enabling collision");
			Map_GetEntity(sEntity).GetMainBody().SetCollideFlags(-1);
			mlPortalBCount--;
		}
	}
	
	//-------------------------------------------------------
	
	void GetRigidBodiesInArea(const tString &in asArea, array<iPhysicsBody@> &out avOutVector)
	{
		iLuxEntity@ pArea = Map_GetEntity(asArea, eLuxEntityType_Area);
		cBoundingVolume boundingVolume = pArea.GetBody(0).GetBoundingVolume();
		cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(boundingVolume.GetMin(), boundingVolume.GetMax(), avOutVector);
		
		for (int i = 0; i < avOutVector.length(); i++)
		{
			iPhysicsBody @pBody = avOutVector[i];
			
			if(pBody.IsActive()==false || pBody.GetMass()==0)
			{
				avOutVector.removeAt(i);
				i--;
				continue;
			}
			
			iLuxEntity @pEntity = cLux_GetBodyEntity(pBody);
			if(pEntity == null || Entity_GetCollide(pEntity.GetName(), asArea)==false)
			{
				avOutVector.removeAt(i);
				i--;
			}
		}
	}
 
	//-------------------------------------------------------
		
	void OnReceiverPower_LabB(bool abActive, const tString&in asEntity)
	{
		if (abActive)
		{
			if (mbLabBShadowFleshSeqStarted) return;
			
			//SetDoorActive("LabBDoor_*", true);
			MovingButton_SetSwitchedOn("LabBDoor_Button_*", true, true);
			
			Map_AddTimer("Timer_EnableLabBButtons", 0.5, "Timer_EnableLabBButtons");
			Map_AddTimer("Timer_PortalLabBPowerOn", 1, "Timer_PortalLabBPowerOn");
			
			float fBlinkSpeedfactor = mbExtenderSent? 1 : 0;
			
			Map_AddTimer("Dynamic_Lamp_LabB_1", fBlinkSpeedfactor + 0.02, "Timer_LightLamp");
			Map_AddTimer("Dynamic_Lamp_LabB_2", fBlinkSpeedfactor + 0.1, "Timer_LightLamp");
			Map_AddTimer("Dynamic_Lamp_LabB_4", fBlinkSpeedfactor + 0.05, "Timer_LightLamp");
			Map_AddTimer("Dynamic_Lamp_LabB_5", fBlinkSpeedfactor + 0.025, "Timer_LightLamp");
			Map_AddTimer("Dynamic_Lamp_LabB_6", fBlinkSpeedfactor + 0.08, "Timer_LightLamp");
			
			Light_FadeBrightnessTo("Lamp_LabB_Area_Light_*", 1, 1.f);
		}
		else
		{
			//SetDoorActive("LabBDoor_*", false);
			MovingButton_SetLocked("LabBDoor_Button*", true, true);
			
			if (Map_TimerExists("Timer_EnableLabBButtons")==false)
				Sound_CreateAtEntity("LabBReceiverOff", "03_04_pillar_room/config_device/plate_energy_misaligned", "Receiver_LabB", 0, false, 1, 15, 40);
			
			Map_RemoveTimer("Timer_EnableLabBButtons");
			Map_RemoveTimer("Timer_PortalLabBPowerOn");
			Map_RemoveTimer("Dynamic_Lamp_LabB_1");
			Map_RemoveTimer("Dynamic_Lamp_LabB_2");
			Map_RemoveTimer("Dynamic_Lamp_LabB_3");
			Map_RemoveTimer("Dynamic_Lamp_LabB_4");
			Map_RemoveTimer("Dynamic_Lamp_LabB_5");
			Map_RemoveTimer("Dynamic_Lamp_LabB_6");
			
			Lamp_SetLit("Dynamic_Lamp_LabB_*", false, true);
			Light_FadeBrightnessTo("Lamp_LabB_Area_Light_*", 0, 0.1f);
			
			if (Sound_Exists("RoomLights"))
				Sound_Stop("RoomLights", 1);
		}
	}
 
	//-------------------------------------------------------
	
	void Timer_EnableLabBButtons(const tString &in asTimer)
	{
		
		MovingButton_SetLocked("LabBDoor_Button*", false, true);
		Sound_CreateAtEntity("LabBReceiverOn", "03_04_pillar_room/config_device/plate_solve_clunk", "Receiver_LabB", 0, false, 1, 15, 40);
	}
	
	//-------------------------------------------------------
	
	void Timer_PortalLabBPowerOn(const tString &in asTimer)
	{
		Sound_CreateAtEntity("RoomLights", "03_07_dw_factory/level/torture_room_lights", "PortalLabBAudio");
	}
		
	//-------------------------------------------------------
	 
	//} END SCENE 6
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 7 *THE PLAYER EXPLORES THE PORTAL LAB B*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
	
	//-------------------------------------------------------
	
	bool mbLabBShadowFleshSeqStarted=false;
	bool mbShadowFleshLabBPart2Done=false;
	
	//-------------------------------------------------------
	
	void DoShadowFleshEffectsAtEntity(const tString&in asName)
	{
		float fRandRadius = cMath_RandRectf(6, 10);
		
		if (cString_GetLastChar(asName)=="*")
		{
			array<iLuxEntity@> vEntities;
			Map_GetEntityArray(asName, vEntities, eLuxEntityType_Area);
			for (int i=0; i<vEntities.length(); ++i)
			{
				cVector3f vShadowFxPos = Map_GetEntity(vEntities[i].GetName(), eLuxEntityType_Area).GetPosition();
				ShadowFlesh_DoFleshEffectsAtPos(vShadowFxPos, fRandRadius);
			}
			return;
		}
		
		cVector3f vShadowFxPos = Map_GetEntity(asName, eLuxEntityType_Area).GetPosition();
		ShadowFlesh_DoFleshEffectsAtPos(vShadowFxPos, fRandRadius);
	}
		
	//-------------------------------------------------------
	
	bool OnCollide_SpawnBasementFleshEffects(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (mbExtenderSent==false) return true;
		
		Pregnancy_SetBabyKicksEnabled(false);
		DoShadowFleshEffectsAtEntity("Area_ShadowFlesh_Effects_Vitae_*");
		return false;
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_StartShadowFleshCorridor(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState!=1) return true;
		if (mbExtenderSent==false) return true;
		
		Pregnancy_SetBarksActive(false);
		
		////////////////////////////
		// Start the shadow sequence
		if (asParent == "Area_StartShadowFleshCorridor_1")
		{
			Seq_ShadowFleshCorridor("");
			return false;
		}
		
		/////////////////////////
		// Break the glass window
		if (asParent != "Area_StartShadowFleshCorridor_2") return true;
		
		Sound_CreateAtEntity("Sound_ShadowGlassBreak", "04_02_sandstorm/critters/glass_break", "PSPos_GlassBreak_1");
		
		Entity_SetActive("Area_Whisper", true);
		
		ShadowFlesh_Spawn("ShadowChase_Path_9_*", "Decal_ShadowChase_Path_9_*", 2.f, 4.f, true);
		
		Effect_Shake_Start(0.05f, 1.f, 0.5f, 1.f);
		Sound_CreateAtEntity("Sound_ShadowRoar", "creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", "player");
		FearHandler_SetForcedAddFearRate(0.5f, 6.f, true, -1.f, 0.1f);
		
		Light_FadeBrightnessTo("Light_ShadowChase_Path_9_*", 1.f, 1.f);
		
		Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_9_*", true);
		
		ShadowFlesh_Spawn("ShadowChase_Path_8_*", "Decal_ShadowChase_Path_8_*", 1.f, 3.f, true);
		Light_FadeBrightnessTo("Light_ShadowChase_Path_8_*", 1.f, 1.f);
		
		ShadowFlesh_Spawn("ShadowChase_Path_13_*", "Decal_ShadowChase_Path_13_*", 1.f, 3.f, true);
		Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_13_*", true);
		
		Entity_SetActive("PortalLabGlassWindow_1", false);
		ParticleSystem_CreateAtEntity("PS_BreakGlass_1", "grass_breaking_full.ps", "PSPos_GlassBreak_1", false);
		ParticleSystem_CreateAtEntity("PS_BreakGlass_2", "grass_breaking_full.ps", "PSPos_GlassBreak_2", false);
		
		return false;
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeq_ShadowFleshCorridor;
	
	void Seq_ShadowFleshCorridor(const tString &in asTimer)
	{
		Sequence_Begin("Seq_ShadowFleshCorridor", mSeq_ShadowFleshCorridor);
		
		if (Sequence_DoStepAndWait(0.5f))
		{
			Music_Play("A2_3_3_Guardian_Warning.ogg", 0.8f, false, eMusicPrio_BigEvent);

			Entity_SetActive("blockbox_shadow_corridor", true);
			DoShadowFleshEffectsAtEntity("Area_ShadowFlesh_Effects_Corridor_1");
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_1_*", true);
			ShadowFlesh_Spawn("ShadowChase_Path_1_*", "Decal_ShadowChase_Path_1_*", 2.f, 4.f, true);
			Light_FadeBrightnessTo("Light_ShadowChase_Path_1_*", 1.f, 1.f);
			
			DropDebris("Debris_ShadowChase_Path_4_*");
			DropDebris("Debris_ShadowChase_Path_7_*");
		}
		else if (Sequence_DoStepAndWait(1.f))
		{
			ShadowFlesh_Spawn("ShadowChase_Path_2_*", "Decal_ShadowChase_Path_2_*", 1.5f, 2.5f, true);
		}
		else if (Sequence_DoStepAndWait(1.5f))
		{
			ShadowFlesh_Spawn("ShadowChase_Path_3_*", "Decal_ShadowChase_Path_3_*", 1.f, 2.f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_3_*", true);
			Light_FadeBrightnessTo("Light_ShadowChase_Path_3_*", 1.f, 1.f);
			Voice_PlayDelayed("Dialogue_TheShadowAppears", 1.f);
		}
		else if (Sequence_DoStepAndWait(2.f))
		{
			Effect_Shake_Start(0.075f, 1.f, 0.5f, 1.f);
			Sound_CreateAtEntity("Sound_ShadowRoar", "creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", "player");
			
			ShadowFlesh_Spawn("ShadowChase_Path_4_*", "Decal_ShadowChase_Path_4_*", 1.f, 2.f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_4_*", true);
			Light_FadeBrightnessTo("Light_ShadowChase_Path_4_*", 1.f, 1.f);
			
			ShadowFlesh_Spawn("ShadowChase_Path_5_*", "Decal_ShadowChase_Path_5_*", 1.f, 2.f, true);
			
			ShadowFlesh_Spawn("ShadowChase_Path_6_*", "Decal_ShadowChase_Path_6_*", 1.f, 2.f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_6_*", true);
			Light_FadeBrightnessTo("Light_ShadowChase_Path_6_*", 1.f, 1.f);
		}
		else if (Sequence_DoStepAndContinue())
		{
			ShadowFlesh_Spawn("ShadowChase_Path_7_*", "Decal_ShadowChase_Path_7_*", 2.f, 4.f, true);
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_StartShadowFleshLabB(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState!=1) return true;
		
		Entity_SetActive("Trigger_LookAtRift*",false);
		
		if (asParent == "Area_StartShadowFleshLabB_Blocker")
		{
			Effect_Shake_Start(0.065f, 2.f, 1.f, 1.f);
			DropDebris("Debris_ShadowChase_Path_23_*");
			ShadowFlesh_Spawn("ShadowChase_Path_LabBlocker_*", "Decal_ShadowChase_Path_LabBlocker_*", 1.5f, 2.5f, true);
			return false;
		}
		
		else if (asParent == "Area_StartShadowFleshLabB_1")
		{
			if (mbLabBShadowFleshSeqStarted) return true;
			Seq_ShadowFleshLabB_Part1("");
			mbLabBShadowFleshSeqStarted = true;
			
			return false;
		}
		
		if (asParent != "Area_StartShadowFleshLabB_2") return true;
		
		if (mbShadowFleshLabBPart2Done) return false;
		if (SequenceStates_IsActive("Seq_ShadowFleshLabB_Part2")) return false;
		
		mbShadowFleshLabBPart2Done = true;
		Seq_ShadowFleshLabB_Part2("");
		return false;
	}
		 
	//-------------------------------------------------------
		
	cSequenceStatesData mSeq_ShadowFleshLabB_Part1;
	void Seq_ShadowFleshLabB_Part1(const tString &in asTimer)
	{
		Sequence_Begin("Seq_ShadowFleshLabB_Part1", mSeq_ShadowFleshLabB_Part1);
		if (Sequence_DoStepAndWait(0.5))
		{
			Entity_SetActive("blockbox_shadow_lab_b", true);
			MovingButton_SetLocked("LabBDoor_Button*", true, true);
			SlideDoor_SetOpenAmount("LabBDoor_1", 0.5, false);
			
			Lamp_SetFlickerActive("Dynamic_Lamp_LabB_*", true);
			Light_SetFlickerActive("Lamp_LabB_Area_Light_*", true);
			
			ShadowFlesh_Spawn("ShadowChase_Path_11_*", "Decal_ShadowChase_Path_11_*", 1.5f, 2.5f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_11_*", true);
			
			ShadowFlesh_Spawn("ShadowChase_Path_12_*", "Decal_ShadowChase_Path_12_*", 1.5f, 2.5f, true);
			
			Effect_Shake_Start(0.065f, 2.f, 1.f, 1.f);
			Sound_CreateAtEntity("Sound_ShadowRoar", "creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", "player");
			FearHandler_SetForcedAddFearRate(0.5f, 6.f, true, -1.f, 0.1f);
			
			DropDebris("Debris_ShadowChase_Path_15_*");
		}
		else if (Sequence_DoStepAndWait(1.5))
		{
			ShadowFlesh_Spawn("ShadowChase_Path_14_*", "Decal_ShadowChase_Path_14_*", 1.5f, 3.f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_14_*", true);
			
			DropDebris("Debris_ShadowChase_Path_21_*");
			DropDebris("Debris_ShadowChase_Path_22_*");

			Light_FadeBrightnessTo("Light_ShadowChase_Path_14_*", 1.f, 1.f);
			
		}
		else if (Sequence_DoStepAndWait(8.f))
		{
			Lamp_SetLit("Dynamic_Lamp_LabB_*", false, true);
			Light_SetBrightness("Lamp_LabB_Area_Light_*", 0);
			
			ShadowFlesh_Spawn("ShadowChase_Path_16_*", "Decal_ShadowChase_Path_16_*", 2.f, 4.f, true);
			ShadowFlesh_Spawn("ShadowChase_Path_18_*", "Decal_ShadowChase_Path_18_*", 2.f, 4.f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_18_*", true);

			Light_FadeBrightnessTo("Light_ShadowChase_Path_18_*", 1.f, 1.f);
		}
		else if (Sequence_DoStepAndContinue())
		{
			if (mbShadowFleshLabBPart2Done==false && SequenceStates_IsActive("Seq_ShadowFleshLabB_Part2")==false)
				Seq_ShadowFleshLabB_Part2("");
		}
		
		Sequence_End();
	}
	
	//-------------------------------------------------------
	
	cSequenceStatesData mSeq_ShadowFleshLabB_Part2;
	void Seq_ShadowFleshLabB_Part2(const tString &in asTimer)
	{
		Sequence_Begin("Seq_ShadowFleshLabB_Part2", mSeq_ShadowFleshLabB_Part2);
		if (Sequence_DoStepAndWait(3.5))
		{
			Effect_Shake_Start(0.065f, 2.f, 1.f, 1.f);
			Sound_CreateAtEntity("Sound_ShadowRoar", "creatures/vocalisations/creature/shadow_guardian/shadow_guardian_activated", "player");
			FearHandler_SetForcedAddFearRate(0.5f, 6.f, true, -1.f, 0.1f);
			
			ShadowFlesh_Spawn("ShadowChase_Path_15_*", "Decal_ShadowChase_Path_15_*", 1.5f, 3.f, true);
			ShadowFlesh_Spawn("ShadowChase_Path_17_*", "Decal_ShadowChase_Path_17_*", 1.f, 2.f, true);
			ShadowFlesh_Spawn("ShadowChase_Path_19_*", "Decal_ShadowChase_Path_19_*", 2.f, 4.f, true);
			ShadowFlesh_Spawn("ShadowChase_Path_20_*", "Decal_ShadowChase_Path_20_*", 2.f, 4.f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_15_*", true);
			
			Light_FadeBrightnessTo("Light_ShadowChase_Path_19_*", 1.f, 1.f);
			Light_FadeBrightnessTo("Light_ShadowChase_Path_15_*", 1.f, 1.f);
			
			
			Music_Play("A2_3_3_Shadow_Spread.ogg", 0.8f, false, eMusicPrio_BigEvent);
		}
		else if (Sequence_DoStepAndWait(8.f))
		{	
			ShadowFlesh_Spawn("ShadowChase_Path_21_*", "Decal_ShadowChase_Path_21_*", 2.5f, 3.5f, true);
			
			ShadowFlesh_Spawn("ShadowChase_Path_22_*", "Decal_ShadowChase_Path_22_*", 1.5f, 2.f, true);
			
			ShadowFlesh_Spawn("ShadowChase_Path_23_*", "Decal_ShadowChase_Path_23_*", 1.5f, 3.f, true);
			Entity_SetActive("FearScaryObject_ShadowFlesh_Corridor_23_*", true);
			
			DropDebris("Debris_ShadowChase_Path_24_*");
		}
		else if (Sequence_DoStepAndContinue())
		{
			StartShadowFleshRift();
		}
		
		Sequence_End();
	}
	
