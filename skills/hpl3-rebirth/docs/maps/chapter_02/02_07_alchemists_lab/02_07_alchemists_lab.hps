	void OnAnimEnd_DisableFakeOrb(const tString&in asAnim)
	{
		Entity_SetActive("Orb_Fake", false);
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_OrbGlowPS(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (Map_GetEntity("Orb", eLuxEntityType_Prop)==null) return true;
		
		if (alState==-1)
		{
			ParticleSystem_SetVisible("OlbHolder_PS_Open", true);
			ParticleSystem_SetActive("OlbHolder_PS_Open", true);
			ParticleSystem_SetVisible("OlbHolder_PS_Closed", false);
			ParticleSystem_SetActive("OlbHolder_PS_Closed", false);
			Light_FadeBrightnessTo("OlbHolder_Light_1", 25, 0.5);
			Light_FadeBrightnessTo("OlbHolder_Light_2", 25, 0.5);
		}
		else if (alState==1)
		{
			ParticleSystem_SetVisible("OlbHolder_PS_Open", false);
			ParticleSystem_SetActive("OlbHolder_PS_Open", false);
			ParticleSystem_SetVisible("OlbHolder_PS_Closed", true);
			ParticleSystem_SetActive("OlbHolder_PS_Closed", true);
			Light_FadeBrightnessTo("OlbHolder_Light_1", 5, 0.5);
			Light_FadeBrightnessTo("OlbHolder_Light_2", 5, 0.5);
		}
		
		return true;
	}
	
