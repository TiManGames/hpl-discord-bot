class cVitaePipe
{
	tString msEntityName;
	tString msLiquidSubMeshName;
	
	float mfUvTime;
	float mfUvTimeTarget;
	float mfUvTimeFadeTime;
	
	float mfVitaeCoverage;
	float mfVitaeCoverageTarget;
	float mfVitaeCoverageFadeTime;
	
	[nosave] bool mbLoaded = false;
	
	cVitaePipe(){}
	
	cVitaePipe(const tString&in asEntityname, const tString&in asLiquidSubMeshName)
	{
		msEntityName = asEntityname;
		msLiquidSubMeshName = asLiquidSubMeshName;
		
		mfUvTime = 0.f;
		mfUvTimeTarget = 0.f;
		mfUvTimeFadeTime = 0.1f;
		
		mfVitaeCoverage = 0.5f;
		mfVitaeCoverageTarget = 0.5f;
		mfVitaeCoverageFadeTime = 0.75f;
		
		iLuxEntity@ vPipeEnt = Map_GetEntity(msEntityName);
		if (vPipeEnt==null) return;
		vPipeEnt.GetMeshEntity().GetSubMeshEntityName(msLiquidSubMeshName).SetCoverageAmount(mfVitaeCoverage);
		
		cMaterial@ pPipeMat = vPipeEnt.GetMeshEntity().GetSubMeshEntityName(msLiquidSubMeshName).GetMaterial();
		if (pPipeMat==null) return;
		pPipeMat.SetUvAnimationSpeed(0, 0);
		pPipeMat.SetUvAnimationTime(mfUvTime, 0.f);
	}
	
	void OnUpdate(float afTimeStep)
	{
		iLuxEntity@ vPipeEnt = Map_GetEntity(msEntityName);
		if (vPipeEnt==null) return;
		
		cMaterial@ pPipeMat = vPipeEnt.GetMeshEntity().GetSubMeshEntityName(msLiquidSubMeshName).GetMaterial();
		if (pPipeMat==null) return;
		
		if (mbLoaded==false)
		{
			mbLoaded = true;
			
			pPipeMat.SetUvAnimationSpeed(0, 0);
			pPipeMat.SetUvAnimationTime(0, mfUvTime);
			vPipeEnt.GetMeshEntity().GetSubMeshEntityName(msLiquidSubMeshName).SetCoverageAmount(mfVitaeCoverage);
		}
		
		if (mfUvTimeTarget != mfUvTime)
		{
			mfUvTime = cMath_IncreaseTo(mfUvTime, 1 / mfUvTimeFadeTime * afTimeStep, mfUvTimeTarget);
			pPipeMat.SetUvAnimationTime(0, mfUvTime);
		}
		
		if (mfVitaeCoverageTarget != mfVitaeCoverage)
		{
			mfVitaeCoverage = cMath_IncreaseTo(mfVitaeCoverage, 1 / mfVitaeCoverageFadeTime * afTimeStep, mfVitaeCoverageTarget);
			vPipeEnt.GetMeshEntity().GetSubMeshEntityName(msLiquidSubMeshName).SetCoverageAmount(mfVitaeCoverage);
		}
	}
	
	void SetUvTime(const float afValue)
	{
		mfUvTime = afValue;
		mfUvTimeTarget = mfUvTime;
		
		iLuxEntity@ vPipeEnt = Map_GetEntity(msEntityName);
		if (vPipeEnt==null) return;
		
		cMaterial@ pPipeMat = vPipeEnt.GetMeshEntity().GetSubMeshEntityName(msLiquidSubMeshName).GetMaterial();
		if (pPipeMat==null) return;
		
		pPipeMat.SetUvAnimationTime(0, mfUvTime);
	}
	
	void FadeUvTime(const float afValue, float afTime=1.f)
	{
		mfUvTimeTarget = afValue;
		if (afTime<=0) afTime = 9999999.f;
		mfUvTimeFadeTime = afTime;
	}
	
	void SetUvCoverage(float afValue)
	{
		iLuxEntity@ vPipeEnt = Map_GetEntity(msEntityName);
		if (vPipeEnt==null) return;
		
		afValue = cMath_Max(afValue, 0.f);
		mfVitaeCoverage = afValue;
		mfVitaeCoverageTarget = mfVitaeCoverage;
		
		vPipeEnt.GetMeshEntity().GetSubMeshEntityName(msLiquidSubMeshName).SetCoverageAmount(mfVitaeCoverage);
	}
	
	void FadeUvCoverage(const float afValue, float afTime=1.f)
	{
		mfVitaeCoverageTarget = cMath_Max(afValue, 0.f);
		if (afTime<=0) afTime = 9999999.f;
		mfVitaeCoverageFadeTime = afTime;
	}
}

