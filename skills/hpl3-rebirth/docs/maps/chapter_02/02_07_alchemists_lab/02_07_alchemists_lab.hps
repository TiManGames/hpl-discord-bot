	//-------------------------------------------------------
	
	void OnTimer_PickupOrbFromItsHolder(const tString&in asTimer)
	{
		tString sEntityName = "Orb_Fake";
		Entity_SetActive(sEntityName, true);
		Entity_SetCollideCharacter(sEntityName,false);
		Entity_SetCollide(sEntityName,false);
		Prop_SetStaticPhysics(sEntityName,true);
		
		////////////////////////
		// Attach to player hand
		iLuxEntity@ pOrbHandEnt = Map_GetEntity(sEntityName, eLuxEntityType_Prop);
		pOrbHandEnt.SetPosition(PlayerBody_GetSocket("R_Hand").GetWorldPosition());
