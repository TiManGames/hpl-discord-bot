		/*Put any functions that are only used in Scene 2, Event B here.*/
		
		bool OnTrigger_Player_StartSeqTinHinanAppear(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_TinHinanAppear("");
			return false;
		}

		//-------------------------------------------------------

		//} END Event B *Tasi sings the lullaby*
		
		/////////////////////////////////////////
		// Event C *YOUNG TIN HINAN APPEARS*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event C here.*/
		
		bool mbSpottedTH = false;
		bool mbTHAtSecondPos = false;
		int mlLookAtTHCount = 0;
		
		//-------------------------------------------------------

		/*Put any functions that are only used in Scene 2, Event C here.*/
		
		cSequenceStatesData mSeqDataTinHinanAppear;
		void Seq_TinHinanAppear(const tString &in asTimer)
		{
			Sequence_Begin("Seq_TinHinanAppear", mSeqDataTinHinanAppear);
			if (Sequence_DoStepAndWait(5.f))
			{
				Voice_StopAll();
				Voice_Play("Dialogue_Quiet_Lullaby");
				
				Map_AddTimer("Timer_FadePlayerRunSpeed", 0.01f, "OnTimer_FadePlayerRunSpeed");
				
				Light_FadeBrightnessTo("light_fort_1", 0, 1);
			}
			else if (Sequence_DoStepAndPause(0.f))
			{
				Sound_CreateAtEntity("Sound_TinHinanNoise_1", "creatures/foley/creature/tin_hinan/appear", "Area_TinHinanNoise_1");
				mBaseObj.GetWorld().GetSoundEntity("Sound_TinHinanNoise_1").FadeVolumeMul(0.3f, 0.f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Light_FadeBrightnessTo("Light_TH_Hint", 2.f, 0.35f);
				Sound_CreateAtEntity("Sound_TinHinanNoise_2", "creatures/foley/creature/tin_hinan/appear", "Area_TinHinanNoise_2");
				Music_Play("A2_2_1_Tin_Hinan_Appear.ogg", 0.16f, false, eMusicPrio_MinorEvent);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Light_FadeBrightnessTo("Light_TH_Hint", 0.f, 0.5f);
			}
			else if (Sequence_DoStepAndPause(0.f))
			{
				Voice_StopAll();
				Voice_Play("Dialogue_LullabyInterrupted");			
	
				Map_AddTimer("Timer_SpawnTH", 0.f, "OnTimer_SpawnTH");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{		
				YoungTinHinan_Activate("TH_Ghost_Path", 1.f);
			}
			else if (Sequence_DoStepAndPause(4.f))
			{
				Entity_SetActive("Trigger_LookAtTH", true);
				
				if (mbTHAtSecondPos == false)
					Map_AddTimer("Timer_ForceLookAtTH", 0.5f, "OnTimer_ForceLookAtTH");
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{				
				YoungTinHinan_Deactivate("TH_Ghost_Path", 1.f);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Map_RemoveTimer("Timer_FadePlayerRunSpeed");
				
				Player_SetJumpDisabled(false);
				Player_FadeRunSpeedMulTo(1.f, 1.f);
				Player_FadeMoveSpeedMulTo(1.f, 1.f);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadePlayerRunSpeed(const tString &in asTimer)
		{
			if (FearHandler_GetIsPermaFailing())
			{
				Map_RestartCurrentTimer(1.f);
				return;
			}
			
			if (Entity_PlayerIsInFront("Trigger_StartSeqTinHinanAppear") == false)
			{
				Player_SetJumpDisabled(true);
				Player_FadeRunSpeedMulTo(0.f, 2.f);
			}
			else
			{
				Player_SetJumpDisabled(false);
				Player_FadeRunSpeedMulTo(1.f, 1.f);
			}
			
			Map_RestartCurrentTimer(1.f);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_DoLightFlash(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceStates_Resume("Seq_TinHinanAppear");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SpawnTH(const tString &in asTimer)
		{
			cCamera@ pCam = cLux_GetPlayer().GetCamera();
			iLuxEntity@ pEnt = Map_GetEntity("Area_SpawnTH_1");
			
			cVector3f vDir = pEnt.GetPosition() - pCam.GetPosition();
			float fDistSqr = vDir.SqrLength();
			float fDot = cMath_Vector3Dot(pCam.GetForward(), cMath_Vector3Normalize(vDir));
			
			if (fDistSqr < 11.f * 11.f)
			{
				mbTHAtSecondPos = true;
				
				SequenceStates_Resume("Seq_TinHinanAppear");
				Agent_TeleportFeetToEntity("TH_Ghost_Path", "Area_SpawnTH_2");
				
				LookAtTH(true);
				return;
			}
			
			if (fDot < 0.75f || cLux_CheckLineOfSight(pCam.GetPosition(), pEnt.GetPosition(), false, false) == false)
				mlLookAtTHCount = -1;
			
			if (fDistSqr > 20.f * 20.f)
				mlLookAtTHCount = -1;
			
			++mlLookAtTHCount;
			if (mlLookAtTHCount < 2)
			{
				Map_RestartCurrentTimer(0.1f);
				return;
			}			
			
			SequenceStates_Resume("Seq_TinHinanAppear");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_PathTH(const tString &in asEntity, int alState)
		{
			mbSpottedTH = true;
			
			Voice_PlayDelayed("Scene_TinHinan", 0.3f);
			
			Player_FadeRunSpeedMulTo(0.f, 1.f);
			Player_FadeMoveSpeedMulTo(0.5f, 1.f);
				
			FearHandler_SetForcedAddFearRate(0.25f, 5.f, true, -1.f, 0.05f, 0.5f);
			
			LookAtTH(false);
			
			SequenceStates_Resume("Seq_TinHinanAppear");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ForceLookAtTH(const tString &in asTimer)
		{
			cCamera@ pCam = cLux_GetPlayer().GetCamera();
			iLuxEntity@ pEnt = Map_GetEntity("Area_SpawnTH_1");
			
			cVector3f vDir = pEnt.GetPosition() - pCam.GetPosition();
			float fDot = cMath_Vector3Dot(pCam.GetForward(), cMath_Vector3Normalize(vDir));
			
			if (mbSpottedTH == false && fDot < 0.9f)
				LookAtTH(true);
		}
		
		//-------------------------------------------------------
		
		void LookAtTH(bool abX)
		{
			if (abX)
			{
				Player_FadeLookSpeedMulTo(0.05f, 1.f);
				Player_StartLookAt("TH_Ghost_Path", 0.01f, 1.f, 1.f, false);
			}
			else
			{
				Player_StopLookAt(0.f);
				Player_FadeLookSpeedMulTo(1.f, 1.f);
			}			
		}
		
		//-------------------------------------------------------

		//} END Event C *YOUNG TIN HINAN APPEARS*
		
