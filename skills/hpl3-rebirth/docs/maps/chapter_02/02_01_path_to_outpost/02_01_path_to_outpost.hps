		{
			Voice_StopAll();
			Sketchbook_UnlockMemory("TheOutpostGate");
		}
		
		//-------------------------------------------------------
		
		void OnTear_GuardPostPlank(const tString &in asEntity)
		{
			Sound_CreateAtEntity("Sound_PlankTear", "03_06_ghouls_nest/wood_pile/wood_pile_remove_plank", asEntity);
			
			int lId = cString_GetNumericSuffixInt(asEntity);
			ParticleSystem_CreateAtEntity("PS_PlankTear", "wooden_brace_damage.ps", "Area_PlankTear_" + lId, false).SetBrightness(0.2f);
			
			Map_GetEntity(asEntity, eLuxEntityType_Prop).GetMainBody().SetCollideFlags(mBaseObj.GetCollideFlag("+plank"));
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_UnblockGuardPostDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			SwingDoor_SetBlocked("GuardPostDoor", false, false);
			return false;
		}
		
		//-------------------------------------------------------

		//} END Event A *Spot the CHECKPOINT GATE*
		
		/////////////////////////////////////////
		// Event B *Tasi sings the lullaby*
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are only used in Scene 2, Event B here.*/

