		//-------------------------------------------------------
		
		tString msBrokenFloor_Ghoul = "Ghoul_BreakFloor";
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_BrokenFloorThrowArm(const tString &in asEntity, int alState)
		{
			iLuxEntity@ pEnt = Map_GetEntity(msBrokenFloor_Arm);
			pEnt.SetActive(true);
			cVector3f vThrowDir = Map_GetEntity("Target_BrokenFloorThrowArm").GetPosition() - pEnt.GetPosition();
			vThrowDir.Normalize();
			Entity_AddImpulse(msBrokenFloor_Arm, vThrowDir * 12.0f, false, false);
			
			Entity_SetActive(msBrokenFloor_Ghoul, true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_BrokenFloorGhoul(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			Map_AddTimer("Timer_BrokenFloor_GhoulSound", 0.5f, "OnTimer_BrokenFloor_GhoulSound");
			Map_AddTimer("Timer_BrokenFloor_GhoulDisappear", 1.2f, "OnTimer_BrokenFloor_GhoulDisappear");
		}
		
