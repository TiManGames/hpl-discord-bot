		bool OnCollide_Player_EnterMapRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Music_PlayExt("A2_2_4_MapSighting.ogg", false, 0.10, 1, 3, 0, eMusicPrio_BgAmb, false);
