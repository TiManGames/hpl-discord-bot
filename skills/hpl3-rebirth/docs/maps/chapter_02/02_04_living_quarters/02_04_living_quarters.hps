		/////////////////////////////////////////
		// Event O *Fix the ELEVATOR and use it to get to the second floor*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbElevator_Fixed = false;
		tString msElevator_InsertWinchTrigger = "Trigger_InsertElevatorWinch";
		tString msElevator_Winch = "ElevatorWinch";
		bool mbElevator_CanOperateWinch = false;
		bool mbElevator_UpdateLowerSpeed = false;
		
		float mfElevator_LowerStartTimer = 0.0f;
		float mfElevator_LowerTimer = 0.0f;
		float mfElevator_LowerCount = 0.0f;
		bool mbElevator_CanLower = true;
		int mlElevator_WinchInteractCount = 0;
		int mlElevator_WinchInteractAreas = 0;
		int mlElevator_SoundState = 0;
		float mfElevator_SoundStateCooldown = 0;
		
		bool mbElevatorSketchSeen = false;
		array<tID> mvElevator_ElevatorAttachObjects;
		
		tID m_idElevator;
		tID m_idElevatorRope;
		
		int mlFirstFloorExplorationAreas = 0;
		
		//-------------------------------------------------------
		
		void InitElevator()
		{
			Wheel_SetLinearAutoMove(msElevator_Winch, true);
			
			Entity_AttachToEntity("InteractAux_ElevatorWinch", "Elevator", "", true);
			if (mbElevator_Fixed) Entity_SetActive("InteractAux_ElevatorWinch", true);
			
			m_idElevator = Map_GetEntity("Elevator").GetID();
			m_idElevatorRope = Map_GetEntity("ElevatorRope").GetID();
			
			for (int i = 1; i <= 4; ++i) mvPlankDetectors.push_back(Map_GetEntity("Trigger_ElevatorPlankDetector_" + i).GetID());
			
			if (mbWinchHighlight) SetNormalWinchPickup(true);
			else
			{
				iLuxEntity@ pEnt = Map_GetEntity("ElevatorWinchPickup");
				pEnt.SetMaxInteractDistance(1.3);
			}
			
			// ballista
			{
				iLuxEntity@ pEnt = Map_GetEntity("02_04_ballista_trap_1");
				pEnt.PlayAnimation("ballista_trap_postfire", 0);
			}
		}
		
		//-------------------------------------------------------
		
		void UpdateElevator(float afTimeStep)
		{
			iLuxEntity@ pElevator = cLux_ID_Entity(m_idElevator);
			iLuxEntity@ pElevatorRope = cLux_ID_Entity(m_idElevatorRope);
			float fElevatorSpeed = pElevator.GetMainBody().GetLinearVelocity().y;
			
			///////////////////
			// Move elevator based on winch speed
			mfElevator_LowerTimer -= afTimeStep;
			if (mbElevator_CanLower && mfElevator_LowerTimer < 0)
			{
				float fNextUpdate = cMath_RandRectf(0.15, 0.3);
				mfElevator_LowerTimer = fNextUpdate;
				mfElevator_LowerCount += fNextUpdate;
				
				Wheel_SetAngle(msElevator_Winch, cMath_ToRad(0.0f), true);

				float fWinch = Wheel_GetRotationAmount("ElevatorWinch");
				float fLowerTimeMul = cMath_Clamp((mfElevator_LowerCount / 1.5f), 0.0f, 1.0f);
				if (fWinch >= 0.85) // slow acceleration at top
				{
					float fWheelMul = 1.0f - fWinch;
					fWheelMul = cMath_Clamp(fWheelMul / 0.4f, 0.0f, 1.0f);					
					float fLowerSpeed = 0.3f + 6.0f * fWheelMul * fLowerTimeMul;
					Wheel_SetAutoRotateMul(msElevator_Winch, fLowerSpeed);
				}
				else if (fWinch >= 0.08) // fast acceleration until the bottom
				{
					float fWheelMul = 1.0f - fWinch;
					fWheelMul = cMath_Clamp(fWheelMul / 0.4f, 0.0f, 1.0f);					
					float fLowerSpeed = 0.3f + 16.0f * fWheelMul * fLowerTimeMul;
					Wheel_SetAutoRotateMul(msElevator_Winch, fLowerSpeed);
				}
				else // slow speed at very bottom, fixes stuttery behavior
				{
					Wheel_SetAutoRotateMul(msElevator_Winch, 2.0f);
				}
			}
			
			///////////////////
			// Stop elevator before lowering
			if (mfElevator_LowerStartTimer > 0)
			{
				mfElevator_LowerStartTimer -= afTimeStep;
				Wheel_SetAutoRotateMul(msElevator_Winch, 0);
				if (mfElevator_LowerStartTimer <= 0)
				{
					mfElevator_LowerCount = 0;
					mbElevator_CanLower = true;
				}
			}
			
			///////////////////
			// Update rope uvs
			if (pElevator !is null && pElevatorRope !is null)
			{
				float fRopeSpeed = -fElevatorSpeed * 3.5;
				pElevatorRope.GetBaseMaterial().SetUvAnimationSpeed(0, fRopeSpeed);
			}

			///////////////////
			// Elevator sounds
			if (mfElevator_SoundStateCooldown > 0) mfElevator_SoundStateCooldown -= afTimeStep;
			else
			{
				if (mlElevator_SoundState == 0) // elevator is still
				{
					if (cMath_Abs(fElevatorSpeed) >= 0.015f)
					{
						mlElevator_SoundState = 1;
						mfElevator_SoundStateCooldown = 0.3f;
						
						Sound_CreateAtEntity("ElevatorMoveLoop", "02_04_living_quarters/elevator/elevator_move", "Target_ElevatorSounds");
						Sound_CreateAtEntity("ElevatorMoveStart", "02_04_living_quarters/elevator/elevator_start", "Target_ElevatorSounds");
						Sound_CreateAtEntity("ElevatorMechanism", "02_04_living_quarters/elevator/elevator_mechanism", "Target_ElevatorMechanismSounds");
						Sound_CreateAtEntity("CounterweightLoop", "02_04_living_quarters/elevator/counterweight_loop", "Target_CounterWeightSounds");
						Sound_CreateAtEntity("WinchMoveStart", "02_04_living_quarters/winch/winch_start", "ElevatorWinch");
						Sound_CreateAtEntity("WinchMoveLoop", "02_04_living_quarters/winch/winch_turn", "ElevatorWinch");
					}
				}
				else if (mlElevator_SoundState == 1) // elevator is moving
				{
					if (cMath_Abs(fElevatorSpeed) < 0.015f)
					{
						mlElevator_SoundState = 0;
						mfElevator_SoundStateCooldown = 0.3f;
						
						Sound_Stop("ElevatorMoveLoop", 2.0);
						Sound_Stop("CounterweightLoop", 1.2);
						Sound_Stop("WinchMoveLoop", 0.5);
						
						Sound_CreateAtEntity("ElevatorMoveStop", "02_04_living_quarters/elevator/elevator_stop", "Target_ElevatorSounds");
						Sound_CreateAtEntity("ElevatorMechanism", "02_04_living_quarters/elevator/elevator_mechanism", "Target_ElevatorMechanismSounds");
						Sound_CreateAtEntity("WinchMoveStop", "02_04_living_quarters/winch/winch_stop", "ElevatorWinch");
					}
				}
			}
			
			if (mbElevator_CanLower)
			{
				if (cMath_Abs(fElevatorSpeed) >= 0.8f)
				{
					Entity_SetActive("Trigger_SoundElevatorHard",true);
					Entity_SetActive("Trigger_SoundElevatorSoft",false);
				}
			
				else if (cMath_Abs(fElevatorSpeed) < 0.8f)
				{
					Entity_SetActive("Trigger_SoundElevatorSoft",true);
					Entity_SetActive("Trigger_SoundElevatorHard",false);
				}
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlayImpactHard(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				{
					Sound_CreateAtEntity("Sound_ElevatorImpactHard", "02_04_living_quarters/elevator/elevator_drop_impact", "Elevator");
					Entity_SetActive("Trigger_SoundElevatorHard",false);
					Entity_SetActive("Trigger_SoundElevatorSoft",false);
					return true;
				}
			else
				{
					return true;
				}
		}
		
		bool OnCollide_PlayImpactSoft(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				{
					Sound_CreateAtEntity("Sound_ElevatorImpactSoft", "02_04_living_quarters/elevator/elevator_drop_impact_soft", "Elevator");
					Entity_SetActive("Trigger_SoundElevatorSoft",false);
					Entity_SetActive("Trigger_SoundElevatorHard",false);
					return true;
				}
			else
				{
					return true;
				}
		}

		//-------------------------------------------------------
		
		bool mbPlankCheck = false;
		int mlPlankCheckIndex = 0;
		int mlPlankDetectorIndex = 0;
		int mlPlankChecksPerFrame = 4;
		array<cPlankCandidate> mvPlankCandidates;
		array<tID> mvPlankDetectors;
		
		void UpdateElevatorPlankCollision(float afTimeStep)
		{
			if (mbPlankCheck == false) return;
			if (mvPlankCandidates.size() == 0)
			{
				if (mvPlankCandidates.size() > 0) mvPlankCandidates.resize(0);
				mbPlankCheck = false;
				return;
			}
			
			for (int i = 0; i < mlPlankChecksPerFrame; ++i)
			{
				cPlankCandidate@ pPlank = mvPlankCandidates[mlPlankCheckIndex];
				iPhysicsBody@ pBody = cLux_ID_Body(pPlank.m_idBody);
				cLuxArea@ pDetector = cLux_ID_Area(mvPlankDetectors[mlPlankDetectorIndex]);
												
				if (pPlank.mlDetectorFailureCount < 3 && pPlank.mlDetectorSuccessCount < 2)
				{
					bool bCollides = pDetector.CheckBodyCollision(pBody, cLux_GetCurrentMap());
					if (bCollides) ++pPlank.mlDetectorSuccessCount;
					else ++pPlank.mlDetectorFailureCount;
				}
				
				++mlPlankDetectorIndex;
				mlPlankDetectorIndex %= mvPlankDetectors.size();
				if (mlPlankDetectorIndex == 0)
				{
					++mlPlankCheckIndex;
					mlPlankCheckIndex %= mvPlankCandidates.size();
					if (mlPlankCheckIndex == 0)
					{
						mvElevator_ElevatorAttachObjects.resize(0);
						for (int i = 0; i < mvPlankCandidates.size(); ++i)
						{
							cPlankCandidate@ pCandidate = mvPlankCandidates[i];
							if (pCandidate.mlDetectorSuccessCount == 2) 
							{
								mvElevator_ElevatorAttachObjects.push_back(pCandidate.m_idBody);
							}
						}
						mbPlankCheck = false;
					}
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartElevatorPlankCollisionUpdate(const tString &in asTimer)
		{
			Map_RestartCurrentTimer(cMath_RandRectf(0.1f, 0.3f));
			if (mbPlankCheck) return;
			if (Player_GetDistanceToEntitySquared("Elevator") > 12 * 12) return;
			
			cLuxArea@ pArea = cLux_ToArea(Map_GetEntity("Trigger_ElevatorAABB"));
			cBoundingVolume@ pVolume = pArea.GetMainBody().GetBoundingVolume();
			mvPlankCandidates.resize(0);
			
			array<iPhysicsBody@> vBodies;
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(pVolume.GetMin(), pVolume.GetMax(), vBodies);
			for (int i = 0; i < vBodies.size(); ++i)
			{
				iPhysicsBody@ pBody = vBodies[i];
				if (pBody is null) continue;
				if (pBody.IsActive() == false) continue;
				if (pBody.GetMass() == 0) continue;
				
				iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
				if (pEnt is null) continue;
				
				if (cLux_GetBodyEntity(pBody).GetEntityType() != eLuxEntityType_Prop) continue;
	
				cPlankCandidate newCandidate;
				newCandidate.m_idBody = pBody.GetID();
				mvPlankCandidates.push_back(newCandidate);
			}
						
			mlPlankCheckIndex = 0;
			mbPlankCheck = true;
			
			
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_HighlightElevator(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_GetProp("Lamp_ElevatorHighlight").SetEffectsOnTime(1.25);
			Map_GetProp("Lamp_ElevatorHighlight").SetEffectsOffTime(1.25);
			Lamp_SetLit("Lamp_ElevatorHighlight", alState == 1, true);
			return true;
		}
		
		//-------------------------------------------------------
		
		int mlElevatorShaftLookAtCount = 0;
		void OnLookAt_SeeElevatorDialogue(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			
			++mlElevatorShaftLookAtCount;
			if (mlElevatorShaftLookAtCount == 1)
			{
				Voice_Play("Dialogue_SeeElevator");
				Sketchbook_AddIdea("fix_elevator");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_ElevatorLid_ElevatorLidClosed(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_InsertElevatorWinch", alState == -1);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_JamWinchArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			Wheel_SetJammed("ElevatorWinch", alState == 1, 0, 250);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ElevatorWheel(const tString &in asEntity)
		{
			++mlElevator_WinchInteractCount;
			mbElevator_CanLower = false;
			
			for (int i = 0; i < mvElevator_ElevatorAttachObjects.size(); ++i)
			{
				iPhysicsBody@ pBody = cLux_ID_Body(mvElevator_ElevatorAttachObjects[i]);
				if (pBody is null) continue;
				iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
				
				bool bAttached = pEnt.GetVarBool("AttachedToElevator");
				if (bAttached == false)
				{
					cLux_AddDebugMessage("[Map] Attach to elevator: " + pBody.GetName());
					
					Entity_AttachToEntity(pEnt.GetName(), "Elevator", "", true, false, false);
					pEnt.SetPlayerInteractCallback("OnInteract_ElevatorPlank", true);
					pEnt.SetVarBool("AttachedToElevator", true);
					pEnt.SetVarFloat("OriginalMass", pEnt.GetMainBody().GetMass());
					pEnt.GetMainBody().SetMass(0);
				}
			}
			
			if (mvElevator_ElevatorAttachObjects.size() == 0 && mlElevator_WinchInteractCount >= 8 &&
				Voice_SubjectHasUnplayedLines("Dialogue_Elevator_NeedPlank"))
			{
				Voice_PlayWhenPossible("Dialogue_Elevator_NeedPlank", "OnVoiceCondition_NeedPlankDialogue", -1, 1);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnVoiceCondition_NeedPlankDialogue(const tString& in asSubject)
		{
			if (Wheel_GetRotationAmount("ElevatorWinch") <= 0.09) return false;
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_ElevatorWheel(const tString &in asEntity)
		{
			float fWheelMul = Wheel_GetRotationAmount("ElevatorWinch");
			mbElevator_UpdateLowerSpeed = false;
			mfElevator_LowerStartTimer = 0.35f + 0.5f * fWheelMul;
			
			Voice_StopCheckTimer("Dialogue_Elevator_NeedPlank");
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ElevatorPlank(const tString &in asEntity)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asEntity);
			if (pEnt is null) return;
			if (pEnt.GetVarBool("AttachedToElevator") == false) return;
			
			cLux_AddDebugMessage("[Map] Detach from elevator: " + asEntity);
			
			pEnt.RemoveEntityAttachment();
			pEnt.SetVarBool("AttachedToElevator", false);
			
			pEnt.GetMainBody().SetMass(pEnt.GetVarFloat("OriginalMass"));
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_ElevatorDialogue(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			if (Map_TimerExists("ElevatorDialogueCooldown")) return;
			Voice_Play("Dialogue_Elevator_MissingPart");
			
			SetNormalWinchPickup(true);
			Sketchbook_AddIdea("fix_elevator");
			
			Map_AddTimer("ElevatorDialogueCooldown", 5.0f, "");
		}
		
		//-------------------------------------------------------
		
		bool mbWinchHighlight = false;
		void SetNormalWinchPickup(bool abX)
		{
			mbWinchHighlight = abX;
			Pickup_SetCanBeHighlighted("ElevatorWinchPickup", true);
			iLuxEntity@ pEnt = Map_GetEntity("ElevatorWinchPickup");
			if (pEnt !is null) pEnt.SetMaxInteractDistance(2.0);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_PickupElevatorWinch(const tString &in asEntity)
		{
			SetCreepyEventsActive(false);
			mbCreepyEventsDone = true;
			
			mbRadio_MessagesActive = false;
			
			Entity_SetPlayerLookAtCallback("Trigger_InsertElevatorWinch", "");
			Entity_SetActive("Trigger_FirstGhoulScare_*", true);
			
			Light_FadeBrightnessTo("Light_FirstGhoulScare*", 0.015, 0.5);
			
			if (mbElevatorSketchSeen == false) Voice_PlayDelayed("Dialogue_Elevator_FoundPart_NoIdea", 0.5);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_GhoulWinchVocal(const tString &in asTimer)
		{
			Music_Stop(1.0f, eMusicPrio_BgAmb);
			Sound_PlayGui("creatures/vocalisations/creature/ghoul/ghoul_spot", 0.4f, eSoundEntryType_World);
			Music_PlayExt("A2_2_4_FearArea.ogg", true, 0.3f, 1.0f, 4.0f, 0.0f, eMusicPrio_BgAmb, true);
		}
		
		//-------------------------------------------------------
		
		bool CanUse_ElevatorWinch(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{
			if (asPickedEntity == msElevator_InsertWinchTrigger) return true;
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnUse_ElevatorWinch(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			if (asTargetEntity == msElevator_InsertWinchTrigger)
			{
				mbElevator_Fixed = true;
				Sketchbook_CompleteIdea("fix_elevator");
				
				Entity_SetActive("Trigger_LookAtElevator", false);
				Entity_SetActive("Trigger_SeeElevatorDialogue", false);
				
				Item_RemoveFromInventory(ItemType_GetFirstInInventory("ElevatorWinch"));
				
				Entity_SetActive("ElevatorWinch", true);
				Entity_SetInteractionDisabled("ElevatorWinch", true);
				
				Entity_SetActive("InteractAux_ElevatorWinch", true);
				
				Entity_SetInteractionDisabled("ElevatorLid_Interact", true);
				SwingDoor_PushOpen("ElevatorLid_Interact", -10, 2, 0.2);
				SwingDoor_SetClosed("ElevatorLid_Interact", true, true);
				Map_GetEntity("ElevatorLid_Interact").GetMainBody().SetCollide(false);
				
				
				Entity_SetActive("Trigger_InsertElevatorWinch", false);
				Entity_SetActive("Trigger_ElevatorLidClosed", false);
				
				Map_AddTimer("Timer_ActivateWinch", 0.75, "OnTimer_ActivateWinch");
				Sound_CreateAtEntity("Sound_PlaceWinch", "02_04_living_quarters/winch/winch_place", "Trigger_SoundLid");
				return true;
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateWinch(const tString &in asTimer)
		{
			SwingDoor_SetOpenAmount("ElevatorLid_Interact", 0);
			Entity_SetInteractionDisabled("ElevatorWinch", mlElevator_WinchInteractAreas <= 0);
			Prop_SetStaticPhysics("ElevatorLid_Interact", true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_CrossbowDialogue(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_Crossbow");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_CanOperateWinch(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlElevator_WinchInteractAreas += alState;
			Entity_SetInteractionDisabled("ElevatorWinch", mlElevator_WinchInteractAreas <= 0);
			if (mlElevator_WinchInteractAreas <= 0) Player_ChangeStateToNormal();
			return true;
		}
		
		//-------------------------------------------------------
		
		void SetElevatorWinchActive(bool abX)
		{
			Entity_SetInteractionDisabled("ElevatorWinch", !abX);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ElevatorSketch(const tString &in asEntity)
		{
			mbElevatorSketchSeen = true;
			
			SetNormalWinchPickup(true);
			Sketchbook_AddIdea("fix_elevator");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_FirstFloorExploration(const tString &in asParent, const tString &in asChild, int alState)
		{
			++mlFirstFloorExplorationAreas;
			if (mlFirstFloorExplorationAreas >= 7)
			{
				Map_AddTimer("Timer_EnableElevatorHints", 480, "OnTimer_EnableElevatorHints");
			}
			Entity_SetActive(asParent, false);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableElevatorHints(const tString &in asTimer)
		{
			if (mbElevator_Fixed == false) Entity_SetActive("Trigger_LookAtElevator", true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Elevator(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			Voice_Play("Dialogue_Elevator_Reminder");
		}
		
		//-------------------------------------------------------
		
		//} END Event O *Fix the ELEVATOR and use it to get to the second floor*
		
		/////////////////////////////////////////
		// Event P *See the ghoul for the first time*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlFirstGhoulScare_Index = 0;
		bool mbSawFirstScare = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_FirstGhoulScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_FirstGhoulScare*", false);
			mlFirstGhoulScare_Index = cString_GetNumericSuffixInt(asParent);
			Seq_FirstGhoulScare("");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_GiveMonsterHint(const tString &in asEntity, int alState)
		{
			mbSawFirstScare = true;
			Hint_StopHint();
			//Hint_ShowHint_Hold("Hints", "HintSneak", true);
			Hint_ShowHint("Hints", "HintMonsterFear", false);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceFirstGhoulScare;
		void Seq_FirstGhoulScare(const tString &in asTimer)
		{
			Sequence_Begin("Seq_FirstGhoulScare", mSequenceFirstGhoulScare);
			if (Sequence_DoStepAndWait(0.3f))
			{				
				Entity_SetActive("Trigger_CommsRoom_Enter", true);
				
				Entity_SetActive("GhoulCrawl", true);
				Entity_SetPlayerLookAtCallback("GhoulCrawl","OnLookAt_GiveMonsterHint",true,true,true,-1,0.f);
				Entity_PlaceAtEntity("GhoulCrawl", "Target_GhoulCrawl_" + mlFirstGhoulScare_Index + "_0", 0, true);
				
				Entity_SetActive("02_04_ghoul_scare_light_" + mlFirstGhoulScare_Index, true);
				Entity_AttachToEntity("02_04_ghoul_scare_light_" + mlFirstGhoulScare_Index, "GhoulCrawl", "", true, false);
				
				Entity_PlayAnimation("GhoulCrawl", "crawl", 0, true);
				Map_GetEntity("GhoulCrawl").GetMeshEntity().GetAnimationStateFromName("crawl").SetSpeed(3.5);
				
				Prop_MoveLinearTo("GhoulCrawl", "Target_GhoulCrawl_" + mlFirstGhoulScare_Index + "_1", 20, 7, 0, true, "OnMoveEnd_CLeanUpFirstGhoulScare");
				Sound_CreateAtEntityCustom("GhoulCrawl", "02_04_living_quarters/ghoul_scare_events/run/ghoul", "GhoulCrawl", 20, 5);
				Sound_Play("Sound_RunScareTunnel", 0.0f);
				
				SetMapSafety(false);
				Entity_SetActive("Trigger_StartCreepyEvents", false);
				
				Lantern_ForceFlicker(1.5, false, true);
				Player_FadeMoveSpeedMulTo(0.75, 0.2);
			}
			else if (Sequence_DoStepAndPause(0.0f))
			{
				Entity_SetActive("Trigger_GhoulCrawlLookAt_" + mlFirstGhoulScare_Index, true);
				AddScareFear(0.4f, 3.0f, false, 1.0f, 0.05f, 0.5f);
			}
			else if (Sequence_DoStepAndWait(5.0f))
			{
				Player_FadeMoveSpeedMulTo(1, 0.5);
				
				Entity_SetActive("Trigger_GhoulCrawlLookAt_" + mlFirstGhoulScare_Index, false);
				
				Entity_SetActive("GhoulCrawl", false);
				Entity_SetActive("02_04_ghoul_scare_light_" + mlFirstGhoulScare_Index, false);
				Light_FadeBrightnessTo("Light_FirstGhoulScare*", 0, 2.0);
			}
			else if (Sequence_DoStepAndWait(0.0f))
			{
				mbRadio_MessagesActive = true;
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_GhoulCrawl(const tString &in asEntity, int alState)
		{
			Music_Play("A2_2_4_Scare_Low_03.ogg", 0.3f, false, eMusicPrio_BigEvent);
			AddScareFear(0.5f, 3.0f, true, 1.0f, 0.05f, 0.5f);
		}
		
		//-------------------------------------------------------
		
		void OnMoveEnd_CLeanUpFirstGhoulScare(const tString& in asPropName)
		{
			SequenceStates_Resume("Seq_FirstGhoulScare");
		}
		
		//-------------------------------------------------------
		
		//} END Event P *See the ghoul for the first time*

	//} END SCENE 1
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 2 *Explore the second floor*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbSecondFloorScaresDone = false;
		bool mbSecondFloorScares_Active = false;
		bool mbSecondFloorScares_Paused = false;
		float mfSecondFloorScares_Cooldown = 0.0f;
		float mfSecondFloorScares_PreviousCooldown = 0.0f;
		float mfSecondFloorScares_BaseCoolDown = 16.0f;

		//-------------------------------------------------------
		
		bool CanStartScare()
		{
			return mfSecondFloorScares_Cooldown <= 0 && mbSecondFloorScares_Paused == false && mbSecondFloorScares_Active;
		}
		
		//-------------------------------------------------------
		
		void EndSecondFloorScare(eSecondFloorScareType aType)
		{
			cLux_AddDebugMessage("[Map] EndSecondFloorScare " + aType);
			
			Pregnancy_SetWhispering(true);
			
			if (mbSawFirstScare == false)
				Hint_ShowHint("Hints", "HintMonsterFear", false);
			
			mbSecondFloorScares_Paused = false;
			
			float fCoolDownMul = 0.0f;
			if (aType == eSecondFloorScareType_Minor) fCoolDownMul = 0.5f;
			if (aType == eSecondFloorScareType_Normal) fCoolDownMul = 2.0f;
			if (aType == eSecondFloorScareType_Major) fCoolDownMul = 4.0f;
			
			mfSecondFloorScares_Cooldown = mfSecondFloorScares_BaseCoolDown * fCoolDownMul;
						
			float fTime = Map_GetTimerTime("Timer_PlaySecondFloorNoise");
			fTime += 10.0f;
			Map_RemoveTimer("Timer_PlaySecondFloorNoise");
			Map_AddTimer("Timer_PlaySecondFloorNoise", fTime, "OnTimer_PlaySecondFloorNoise");
			
			if (Map_GetTimerTime("RadioVoiceCooldown") <= 5)
			{
				Map_RemoveTimer("RadioVoiceCooldown");
				Map_AddTimer("RadioVoiceCooldown", 5, "");
			}
		}
		
		//-------------------------------------------------------
		
		void InitSecondFloorScares()
		{
			InitGhoulChange1();
			Entity_PlayAnimation("Corpse_Regis", "corpse01_scare_pose", 0.0f);
			
			if (mbSecondFloorScares_CorpsePullHappened) Entity_SetActive("Corpse_Regis", false);
		}
		
		//-------------------------------------------------------
		
		void SetSecondFloorScaresActive(bool abX)
		{
			if (mbSecondFloorScares_Active == abX) return;
			mbSecondFloorScares_Active = abX && mbSecondFloorScaresDone == false;

			WallCrack_SetBarrelScareActive(mbSecondFloorScares_Active);
			
			if (mbSecondFloorScares_Active)
			{
				StartSecondFloorNoises();
			}
			else
			{
				StopSecondFloorNoises();
			}
		}
		
		//-------------------------------------------------------
			
		void UpdateSecondFloorScares(float afTimeStep)
		{
			if (mfSecondFloorScares_Cooldown > 0.0f) mfSecondFloorScares_Cooldown -= afTimeStep;
						
			// Cooldown activates
			if (mfSecondFloorScares_PreviousCooldown <= 0 && mfSecondFloorScares_Cooldown > 0)
			{
				cLux_AddDebugMessage("[Map] Second floor scare cooldown active");
				SetCorpsePullScareActive(false);
			}
			// Cooldown is over
			else if (mfSecondFloorScares_PreviousCooldown > 0 && mfSecondFloorScares_Cooldown <= 0)
			{
				cLux_AddDebugMessage("[Map] Second floor scare cooldown over");
				SetCorpsePullScareActive(true);
			}
			
			mfSecondFloorScares_PreviousCooldown = mfSecondFloorScares_Cooldown;
				
//			cLux_AddDebugMessage("A " +mfSecondFloorScares_Cooldown + " " + mbSecondFloorScares_Paused);
		}

		//-------------------------------------------------------

		//} END General	
		
		/////////////////////////////////////////
		// Event A *Hear the ghoul moving around*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		array<tID> mvSecondFloorScares_NoiseTargets;
		int mlSecondFloorScares_NoiseIndex = 0;
		tID m_idSecondFloorScares_ClosestNoise = tID_Invalid;
		tID m_idSecondFloorScares_FarthestNoise = tID_Invalid;
		tID m_idSecondFloorScares_TempClosestNoise = tID_Invalid;
		tID m_idSecondFloorScares_TempFarthestNoise = tID_Invalid;
		cVector2f mvSecondFloor_NoiseTime = cVector2f(30.0f, 60.0f);
		cVector2f mvSecondFloor_FloorBreakCooldown = cVector2f(60.0f, 90.0f);
		float mfSecondFLoorScares_NoiseLastTimer = 0.0f;
		bool mbSecondFloorScares_NextStrongNoise = true;
		bool mbSecondFloor_First = true;
		bool mbSecondFloorNoisesActive = true;
				
		//-------------------------------------------------------
		
		cVector3f mvSecondFloorScares_EnterSecondFloorPos;
		bool OnCollide_Player_EnterSecondFloor(const tString &in asParent, const tString &in asChild, int alState)
		{
			FearHandler_SetPermaFailRespawnArea("PermaFail_SecondFloor");
			Sketchbook_AddIdea("get_radio");
			
			if (alState == 1)
			{
				mvSecondFloorScares_EnterSecondFloorPos = Player_GetPosition();
				if (mbSecondFloor_First)
				{
					mbSecondFloor_First = false;					
				}
			}
			else
			{
				cVector3f vTransitionDir = Player_GetPosition() - mvSecondFloorScares_EnterSecondFloorPos;
				if (cMath_Vector3Dot(vTransitionDir, Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward()) > 0.0f)
				{
					SetCreepyEventsActive(false);
					Entity_SetActive("Trigger_StartCreepyEvents", false);
					
					SetSecondFloorScaresActive(true);
					Map_RemoveTimer("Timer_StartRandomCreepyEvent");
					
					Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_TopFloor");
					
					SwitchFloors(true);
					
//					SetFirstFloorPropsActive(false);
//					SetSecondFloorPropsActive(true);
				}
				else
				{
//					SetFirstFloorPropsActive(true);
//					SetSecondFloorPropsActive(false);
					
					SwitchFloors(false);
					SetSecondFloorScaresActive(false);
					
					if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio")) Pregnancy_ClearBabyTalkSpecialSubject();
					else Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_Initial");
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void SwitchFloors(bool abSecond)
		{
			// enter second floor
			if (abSecond)
			{
				if (Map_GetEntity("Trigger_GhoulChange1").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_GhoulChange1", true);
				if (mbMapRoomAboveDialogueOver == false) Entity_SetActive("Trigger_LookAt_MapRoomAboveDialogue*", true);
//				Entity_SetActive("Sticky_CannonWheel*", true);
				
				Entity_SetActive("Trigger_GhoulChange1", false);
				Entity_SetActive("Trigger_BrickFallLookAt", false);
				Entity_SetActive("Trigger_FirstRadioMessage", false);
				Entity_SetActive("Trigger_LookIntoMapRoom*", false);
				Entity_SetActive("Trigger_LookAtRadioBarks", false);
				Entity_SetActive("Trigger_SeeDoor*", false);
				Entity_SetActive("Trigger_PlankFall", false);
				Entity_SetActive("Trigger_OnLookAt_ExitDialogue*", false);
				Entity_SetActive("Trigger_VaseStairFall", false);
				Entity_SetActive("Trigger_BrickFallLookAt", false);
				Entity_SetActive("Trigger_KitchenDialogue*", false);
				Entity_SetActive("Trigger_StartBucketRoll", false);
				Entity_SetActive("Trigger_CrossbowDialogue", false);
				Entity_SetActive("Trigger_WallPaintingReaction", false);
			}
			// enter first
			else
			{
				Entity_SetActive("Trigger_GhoulChange1", false);
				Entity_SetActive("Trigger_LookAt_MapRoomAboveDialogue*", false);
//				Entity_SetActive("Sticky_CannonWheel*", false);
				
				if (Map_GetEntity("Trigger_MessDrop").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_MessDrop", true);
				if (Map_GetEntity("Trigger_BrickFallLookAt").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_BrickFallLookAt", true);
				if (Map_GetEntity("Trigger_FirstRadioMessage").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_FirstRadioMessage", true);
				if (Map_GetEntity("Trigger_LookIntoMapRoom_1").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_LookIntoMapRoom_1", true);
				if (Map_GetEntity("Trigger_LookIntoMapRoom_3").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_LookIntoMapRoom_3", true);
				if (Map_GetEntity("Trigger_LookIntoMapRoom_4").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_LookIntoMapRoom_4", true);
				if (Map_GetEntity("Trigger_LookAtRadioBarks").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_LookAtRadioBarks", true);
				if (Map_GetEntity("Trigger_SeeDoor_1").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_SeeDoor_1", true);
				if (Map_GetEntity("Trigger_SeeDoor_2").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_SeeDoor_2", true);
				if (Map_GetEntity("Trigger_SeeDoor_3").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_SeeDoor_3", true);
				if (Map_GetEntity("Trigger_PlankFall").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_PlankFall", true);
				if (Map_GetEntity("Trigger_OnLookAt_ExitDialogue_1").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_OnLookAt_ExitDialogue_1", true);
				if (Map_GetEntity("Trigger_OnLookAt_ExitDialogue_4").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_OnLookAt_ExitDialogue_4", true);
				if (Map_GetEntity("Trigger_OnLookAt_ExitDialogue_6").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_OnLookAt_ExitDialogue_6", true);
				if (mbVaseStairFallDone == false) Entity_SetActive("Trigger_VaseStairFall", true);
				if (mbBrickFallDone == false) Entity_SetActive("Trigger_BrickFallLookAt", true);
				if (Voice_SubjectHasUnplayedLines("Dialogue_Kitchen")) Entity_SetActive("Trigger_KitchenDialogue*", true);
				if (Map_GetEntity("Trigger_StartBucketRoll").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_StartBucketRoll", true);
				if (Map_GetEntity("Trigger_CrossbowDialogue").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_CrossbowDialogue", true);
				if (Map_GetEntity("Trigger_WallPaintingReaction").HasPlayerLookAtCallback()) Entity_SetActive("Trigger_WallPaintingReaction", true);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StopScares(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Trigger_StopScares*", false);
			
			SetCreepyEventsActive(false);
			Entity_SetActive("Trigger_StartCreepyEvents", false);
			SetSecondFloorScaresActive(false);
			mbSecondFloorScaresDone = true;
			FearHandler_SetPermaFailRespawnArea("PermaFail_CellarAccess");
			
			Entity_SetActive("Trigger_UpstairsExplored", true);
			Entity_SetActive("Trigger_Memory_WebbsDeath", true);
			Entity_SetActive("Target_PickUpRadio", true);
			
			return false;
			
//			SetFirstFloorPropsActive(true);
//			SetSecondFloorPropsActive(false);
//			SetSecondFloorWorkshopPropsActive(true);
		}
		
		//-------------------------------------------------------
		
		void StartSecondFloorNoises()
		{
			if (mvSecondFloorScares_NoiseTargets.size() == 0)
			{
				array<iLuxEntity@> vEnts;
				if (Map_GetEntityArray("Target_SecondFloorScareSound*", vEnts, eLuxEntityType_Area))
				{
					for (int i = 0; i < vEnts.size(); ++i)
					{
						mvSecondFloorScares_NoiseTargets.push_back(vEnts[i].GetID());
					}
				}
			}
			
			Map_AddTimer("Timer_CheckClosestSecondFloorNoise", 0.0f, "OnTimer_CheckClosestSecondFloorNoise");
			mfSecondFLoorScares_NoiseLastTimer = mvSecondFloor_NoiseTime.y + 10.0f;
			Map_AddTimer("Timer_PlaySecondFloorNoise", cMath_RandRectf(mvSecondFloor_NoiseTime.x, mvSecondFloor_NoiseTime.y), "OnTimer_PlaySecondFloorNoise");
		}
		
		//-------------------------------------------------------
		
		void StopSecondFloorNoises()
		{
			Map_RemoveTimer("Timer_CheckClosestSecondFloorNoise");
			Map_RemoveTimer("Timer_PlaySecondFloorNoise");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckClosestSecondFloorNoise(const tString &in asTimer)
		{
			Map_AddTimer("Timer_CheckClosestSecondFloorNoise", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CheckClosestSecondFloorNoise");
			
			if (mvSecondFloorScares_NoiseTargets.size() == 0) return;
			
			iLuxEntity@ pNoise = cLux_ID_Entity(mvSecondFloorScares_NoiseTargets[mlSecondFloorScares_NoiseIndex]);
			float fNoiseDist = -1.0f;
			if (pNoise !is null) fNoiseDist = cMath_Vector3DistSqr(pNoise.GetPosition(), Player_GetPosition());
			
			iLuxEntity@ pTempClosest = cLux_ID_Entity(m_idSecondFloorScares_TempClosestNoise);
			float fTempDist = -1.0f;
			if (pTempClosest !is null) fTempDist = cMath_Vector3DistSqr(pTempClosest.GetPosition(), Player_GetPosition());
			
			if (fTempDist < 0.0f || fNoiseDist < fTempDist) m_idSecondFloorScares_TempClosestNoise = pNoise.GetID();
			
			iLuxEntity@ pTempFarthest = cLux_ID_Entity(m_idSecondFloorScares_TempFarthestNoise);
			float fTempFarthestDist = -1.0f;
			if (pTempFarthest !is null) fTempFarthestDist = cMath_Vector3DistSqr(pTempFarthest.GetPosition(), Player_GetPosition());
			
			if (fTempFarthestDist < 0.0f || fNoiseDist > fTempFarthestDist) m_idSecondFloorScares_TempFarthestNoise = pNoise.GetID();
			
			++mlSecondFloorScares_NoiseIndex;
			if (mlSecondFloorScares_NoiseIndex >= mvSecondFloorScares_NoiseTargets.size())
			{
				mlSecondFloorScares_NoiseIndex = 0;
				m_idSecondFloorScares_ClosestNoise = m_idSecondFloorScares_TempClosestNoise;
				m_idSecondFloorScares_FarthestNoise = m_idSecondFloorScares_TempFarthestNoise;
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlaySecondFloorNoise(const tString &in asTimer)
		{
			mfSecondFLoorScares_NoiseLastTimer = cMath_RandRectf(mvSecondFloor_NoiseTime.x, mvSecondFloor_NoiseTime.y);
			Map_AddTimer("Timer_PlaySecondFloorNoise", mfSecondFLoorScares_NoiseLastTimer, "OnTimer_PlaySecondFloorNoise");
			cLux_AddDebugMessage("[Map] Second floor noise");
						
			if (mbSecondFloorNoisesActive == false)
			{
				cLux_AddDebugMessage("[Map] Noises inactive");
				return;
			}
			if (mbSecondFloorScares_Paused)
			{
				cLux_AddDebugMessage("[Map] Paused");
				return;
			}
			if (FearHandler_GetFearAreaState() == 1)
			{
				cLux_AddDebugMessage("[Map] Player safe");
				return;
			}
			
			iLuxEntity@ pClosest = cLux_ID_Entity(m_idSecondFloorScares_ClosestNoise);
			iLuxEntity@ pFarthest = cLux_ID_Entity(m_idSecondFloorScares_FarthestNoise);
			
			if (pClosest is null)
			{
				cLux_AddDebugMessage("[Map] No noise area found");
				return;
			}
			
			if (mbSecondFloorScares_NextStrongNoise)
			{
				mbSecondFloorScares_NextStrongNoise = false;
				cLux_AddDebugMessage("[Map] Strong noise");
				Sound_CreateAtEntity("GhoulNoise", "02_04_living_quarters/ghoul_events/ghoul_distant_sweet", pClosest.GetName(), 0.0f, false, 0.7f);
			}
			else
			{	
				float fRand = cMath_RandRectf(0.0f, 1.0f);
				if (fRand <= 0.15)
				{
					cLux_AddDebugMessage("[Map] Normal tunnel noise");
					Sound_CreateAtEntity("GhoulNoise", "02_04_living_quarters/ghoul_events/ghoul_tunnel_sweet", pClosest.GetName());
				}
				else if (fRand <= 0.30)
				{
					cLux_AddDebugMessage("[Map] Normal run noise");
					Sound_CreateAtEntity("GhoulNoise", "02_04_living_quarters/ghoul_events/ghoul_run_sweet", pClosest.GetName());
				}
				else
				{
					cLux_AddDebugMessage("[Map] Normal ceiling noise");
					Sound_CreateAtEntity("GhoulNoise", GetRandomCeilingSound(), pClosest.GetName(), 0, false, 1, 6, 25);
				}
			}
			
			Debug_DrawSphere(pClosest.GetPosition(), 1, cColor_Red * 3, 4);
			Debug_DrawSphere(pClosest.GetPosition(), 5, cColor_Red * 3, 4);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SecondFloorCreak(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				if (Map_TimerExists("FloorCreakCooldown") == false)
				{
					Sound_CreateAtEntity("FloorCreak", "02_04_living_quarters/floor_plank/floor_plank_creak", asParent, 0.0f, false, 1.0f);
					float fDelay = cMath_RandRectf(0.4f, 0.7f);
					Map_AddTimer(asParent, cMath_RandRectf(0.4f, 0.6f), "OnTimer_SecondFloorCreakDelayed");
					Map_AddTimer("FloorCreakCooldown", cMath_RandRectf(mvSecondFloor_FloorBreakCooldown.x, mvSecondFloor_FloorBreakCooldown.y), "");

					float fTimeSinceLastNoise = mfSecondFLoorScares_NoiseLastTimer - Map_GetTimerTime("Timer_PlaySecondFloorNoise");
					if (mbSecondFloorScares_Paused == false && fTimeSinceLastNoise >= 8.0f)
					{
						Map_RemoveTimer("Timer_PlaySecondFloorNoise");
						mbSecondFloorScares_NextStrongNoise = true;
						Map_AddTimer("Timer_PlaySecondFloorNoise", fDelay + 1.5, "OnTimer_PlaySecondFloorNoise");
					}
				}
				else
				{
					Sound_CreateAtEntity("FloorCreak", "02_04_living_quarters/floor_plank/floor_plank_creak", asParent, 0.0f, false, 0.7f);	
				}
			}
			return true;
		}
		
		void OnTimer_SecondFloorCreakDelayed(const tString &in asTimer)
		{
			Sound_CreateAtEntity("FloorBreak", "02_04_living_quarters/ghoul_scare_events/floor_break", "Player", 0.0f, false, 0.5f);
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Hear the ghoul moving around*
		
