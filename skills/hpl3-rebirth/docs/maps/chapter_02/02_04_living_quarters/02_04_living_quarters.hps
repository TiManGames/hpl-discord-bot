//			return;
//			Sequence_ArtilleryRoomScare("");
//			return;
//			Wheel_SetAngle(msElevator_Winch, cMath_ToRad(1800.0f), true);
//			Wheel_SetLinearAutoMove(msElevator_Winch, true);
//			Wheel_SetAutoRotateMul(msElevator_Winch, 10.4f);
//			return;
//			return;
			SwitchFloors(true);
			mvSecondFloor_NoiseTime = cVector2f(4.0f, 8.0f);
			SetSecondFloorScaresActive(true);
//			Player_Teleport("Start_ElevatorTop");
			
//			Player_SetNightVisionEnabled(false);
			
			mfSecondFloorScares_BaseCoolDown = 0.0f;
//			mlSecondFloorScares_TowerShadowArea = 0;
			OnCollide_Player_TowerShadowScare("", "", 0);
			
//			mfSecondFloorScares_BaseCoolDown = 0.0f;
