		//-------------------------------------------------------
		
		bool mbSuicideMicroflashDone = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_SeesSuicideDialogue(const tString &in asEntity, int alState)
		{
			Entity_SetActive("Trigger_SeesSuicideDialogue*", false);
			Voice_Play("Dialogue_SeesSuicide", -1, "OnVoiceEnd_SeesSuicideDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_SeesSuicideDialogue(const tString&in asScene, const tString&in asSubject)
		{
			Map_AddTimer("Timer_SuicideMicroflash", 0.5, "OnTimer_SuicideMicroflash");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SuicideMicroflash(const tString &in asTimer)
		{
			if (mbSuicideMicroflashDone) return;
			mbSuicideMicroflashDone = true;
			
			Sketchbook_Microflash("Microflash_Suicide");
		}
		
