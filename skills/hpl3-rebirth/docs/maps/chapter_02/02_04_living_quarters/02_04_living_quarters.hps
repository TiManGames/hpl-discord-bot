		/////////////////////////////////////////
		// Event B *See the ghoul climbing the grate*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		float mlGrateScare2Count = 0;
		float mfGrateScare2SeenTimer = 0;
		float mfGrateScare2NotSeenTimer = 0;
		bool mbGrateScare2Over = false;
		bool mbGrateScare2Seen = false;
		
		//-------------------------------------------------------
		
		void OnTimer_EnableGrateScare(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_GhoulGrateScare2", true);
		}
		
		//-------------------------------------------------------

		bool OnCollide_Player_StartGrateScare2(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mlGrateScare2Count = 0;
				Map_AddTimer("Timer_CheckGrateScare2", 0.0f, "OnTimer_CheckGrateScare2");
			}
			else
			{
				CancelGrateScare2();
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckGrateScare2(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.1, 0.2);
			if (CanStartScare() && Map_GetEntity("Trigger_LookAtGrateScare2").CheckIsOnScreen(true) == false && Map_GetTimerTime("BrokenFloorHint") < 2)
			{
				mlGrateScare2Count += fNext;
				if (mlGrateScare2Count >= 0.3)
				{
					Map_RemoveTimer("BrokenFloorHint");
					Map_AddTimer("BrokenFloorHint", 6, "");
					
					StartGrateScare2();
					return;
				}
			}
			Map_AddTimer("Timer_CheckGrateScare2", fNext, "OnTimer_CheckGrateScare2");
		}
		
		//-------------------------------------------------------
		
		void StartGrateScare2()
		{
			cLux_AddDebugMessage("[Map] Start grate scare");
			
			mbSecondFloorScares_Paused = true;
			
			mfGrateScare2SeenTimer = 0;
			mfGrateScare2NotSeenTimer = 0;
			
			Entity_SetActive("Ghoul_Grate_1", true);
			Entity_SetActive("Trigger_LookAtGrateScare2", true);
			
			Entity_PlayAnimation("Ghoul_Grate_1", "scare_wall_grate_breathing_look_straight", 0.0f, true, true, "");
			
			Sound_CreateAtEntity("GhoulGrate", "02_04_living_quarters/ghoul_scare_events/grate/grate_grab", "Ghoul_Grate_1", 0, false, 1, 4, 10);
			
			Map_AddTimer("Timer_CheckGrateScare2OnScreen", 0, "OnTimer_CheckGrateScare2OnScreen");
			
			Light_FadeTo("Light_GrateScare_*", cColor(1,0.843,0.609,1), 1.2, 0.2);
		}
		
		//-------------------------------------------------------
		
		void CancelGrateScare2()
		{
			if (mbGrateScare2Over) return;
			cLux_AddDebugMessage("[Map] Cancel grate scare");
			
			EndSecondFloorScare(eSecondFloorScareType_None);
			Entity_SetActive("Ghoul_Grate_1", false);
			Entity_SetActive("Trigger_LookAtGrateScare2", false);
			Map_RemoveTimer("Timer_CheckGrateScare2");
			Map_RemoveTimer("Timer_CheckGrateScare2OnScreen");
			Light_FadeTo("Light_GrateScare_*", cColor(0), 1.2, 0.5);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckGrateScare2OnScreen(const tString &in asTimer)
		{
			if (mbGrateScare2Over) return;
			float fNext = cMath_RandRectf(0.1, 0.2);
			if (Map_GetEntity("Trigger_LookAtGrateScare2").CheckIsOnScreen(true))
			{
				mfGrateScare2SeenTimer += fNext;
				if (mfGrateScare2SeenTimer >= 1.5)
				{
					Map_AddTimer("Timer_GrateScare2Drop", 0.0f, "OnTimer_GrateScare2Drop");
					return;
				}
			}
			
			mfGrateScare2NotSeenTimer += fNext;
			if (mfGrateScare2NotSeenTimer >= 5)
			{
				CancelGrateScare2();
				return;
			}
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_GrateScare2(const tString &in asEntity, int alState)
		{
			mbGrateScare2Seen = true;
			Map_AddTimer("Timer_GrateScare2Drop", 0.0f, "OnTimer_GrateScare2Drop");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CancelGrateScare2(const tString &in asTimer)
		{
			CancelGrateScare2();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_GrateScare2Drop(const tString &in asTimer)
		{
			if (mbGrateScare2Over) return;
			mbGrateScare2Over = true;
			
			cLux_AddDebugMessage("[Map] Grate scare");
			
			Map_RemoveTimer("BrokenFloorHint");
			Map_AddTimer("BrokenFloorHint", 11, "");
			Map_RemoveTimer("BrokenFloorCooldown");
			Map_AddTimer("BrokenFloorCooldown", 11, "");
			
			Entity_SetActive("Trigger_GhoulGrateScare2", false);
			Entity_SetActive("Trigger_LookAtGrateScare2", false);
			
			Sound_CreateAtEntity("Sound_GrateScareGhoul", "02_04_living_quarters/ghoul_scare_events/grate/grate", "Ghoul_Grate_1");
			Sound_Play("Sound_GrateScareSteps", 0.0f);
			if (mbGrateScare2Seen)
			{
				AddScareFear(0.8f, 4.0f, true, 1.0f, 0.1f, 1.0f);
				Music_Play("A2_2_4_Scare_Low_01.ogg", 0.3f, false, eMusicPrio_BigEvent);
				Voice_PlayDelayed("Dialogue_RandomReactionsGhoul", 0.5);
			}
			
			Map_RemoveTimer("Timer_CancelGrateScare2");
			Entity_PlayAnimation("Ghoul_Grate_1", "scare_wall_grate_push_back_jump_look_straight", 0.25f, false, false, "OnAnimationOver_GrateScare2Hide");
			
			Light_FadeTo("Light_GrateScare_*", cColor(0), 1.2, 1.5);
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_GrateScare2Hide(const tString &in asEntityName, const tString &in asAnimName)
		{
			EndSecondFloorScare(eSecondFloorScareType_Major);
			Entity_SetActive("Ghoul_Grate_1", false);
			ActivateCornerGhoulScare(2, true);
		}
		
		//-------------------------------------------------------
		
		//} END Event B *See the ghoul climbing the grate*
		
		/////////////////////////////////////////
		// Event C *See the barrel rolling down the stairs*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbBarrelKick_Over = false;
		bool mbBarrelKick_Setup = false;
		int mlBarrelKick_Areas = 0;
		float mfBarrelKick_StartTimer = 0;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_BarrelKickArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlBarrelKick_Areas += alState;
			if (mlBarrelKick_Areas > 0) Map_AddTimer("Timer_CheckBarrelKickSetup", 0, "OnTimer_CheckBarrelKickSetup");
			else
			{
				Map_RemoveTimer("Timer_CheckBarrelKickSetup");
				CancelBarrelKick();
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool SetupBarrelKick()
		{
			if (Map_GetEntity("Trigger_BarrelKickSetup").CheckIsOnScreen(true)) return false;
			if (mbBarrelKick_Setup) return false;
			if (CanStartScare() == false) return false;
			
			cLux_AddDebugMessage("[Map] Barrel kick set up");
			mbBarrelKick_Setup = true;
			
			mfBarrelKick_StartTimer = 0;
			Entity_SetActive("Barrel_GhoulKick", true);
			
			Map_AddTimer("Timer_CheckBarrelKickStart", 0, "OnTimer_CheckBarrelKickStart");
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void CancelBarrelKick()
		{
			if (mbBarrelKick_Setup == false) return;
			
			cLux_AddDebugMessage("[Map] Cancel barrel kick");
			mbBarrelKick_Setup = false;
			EndSecondFloorScare(eSecondFloorScareType_None);
			
			if (Map_GetEntity("Trigger_BarrelKickVisible").CheckIsOnScreen(true) == false)
			{
				Entity_SetActive("Barrel_GhoulKick", false);
			}
			
			Map_RemoveTimer("Timer_CheckBarrelKickSetup");
			Map_RemoveTimer("Timer_CheckBarrelKickStart");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckBarrelKickSetup(const tString &in asTimer)
		{
			if (SetupBarrelKick()) return;
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.4));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckBarrelKickStart(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.2, 0.4);
			if (Map_GetEntity("Trigger_BarrelKickStart").CheckIsOnScreen(true))
			{
				mfBarrelKick_StartTimer += fNext;
				if (mfBarrelKick_StartTimer >= 0.4 && StartBarrelScare()) return;
			}
			else
			{
				mfBarrelKick_StartTimer = 0;
			}
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		bool StartBarrelScare()
		{
			if (mbBarrelKick_Over) return false;
			if (CanStartScare() == false) return false;
			if (Player_GetDistanceToEntity("Trigger_BarrelKickStart") <= 4.0f) return false;
			if (Map_GetEntity("Trigger_BarrelKickStart").CheckIsOnScreen(true) == false) return false;
			
			cLux_AddDebugMessage("[Map] Barrel kick start");
			
			mbSecondFloorScares_Paused = true;
			mbBarrelKick_Over = true;
			Entity_SetActive("Trigger_BarrelKickArea_*", false);
			
			Entity_SetActive("Ghoul_Barrel", true);
			Entity_PlayAnimation("Ghoul_Barrel", "break_down_door_b", 0.0f, false, false, "OnAnimEnd_GhoulBarrelKick");
			Sound_CreateAtEntity("GhoulKickBarrel", "creatures/vocalisations/creature/ghoul/ghoul_attack", "Ghoul_Barrel");
			Sound_CreateAtEntity("BarrelPush", "new_sounds/living_quaters/barrel_roll", "Ghoul_Barrel");
			
			Entity_SetActive("Barrel_GhoulKick_Level", false);
			Entity_SetActive("Barrel_GhoulKick", true);
			
			Map_RemoveTimer("Timer_CheckBarrelKickSetup");
			Map_RemoveTimer("Timer_CheckBarrelKickStart");
			
			Map_AddTimer("Timer_BarrelScareKick", 0.5f, "OnTimer_BarrelScareKick");
			Map_AddTimer("Timer_PlayBarrelSmash", 1.5f, "OnTimer_PlayBarrelSmash");
			Map_AddTimer("Timer_BarrelScareKickEnd", 3.0f, "OnTimer_BarrelScareKickEnd");
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_GhoulBarrelKick(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive("Ghoul_Barrel", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BarrelScareKick(const tString &in asTimer)
		{
			cVector3f vDir = Map_GetEntity("Target_BarrelPush").GetPosition() - Map_GetEntity("Barrel_GhoulKick").GetPosition();
			vDir.Normalize();
			Entity_AddImpulse("Barrel_GhoulKick", vDir * 15.0f, false, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayBarrelSmash(const tString &in asTimer)
		{
			Sound_CreateAtEntity("BarrelCrash", "new_sounds/living_quaters/barrel_impact", "Target_BarrelPush");
		}
		
		void OnTimer_BarrelScareKickEnd(const tString &in asTimer)
		{
			EndSecondFloorScare(eSecondFloorScareType_Major);
		}
		
		//-------------------------------------------------------
		
		//} END Event C *See the barrel rolling down the stairs*
		
		/////////////////////////////////////////
		// Event E *See the ghoul hit the grated door in the captain's room*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msCaptainsRoom_Ghoul = "Ghoul_CaptainsRoomScare";
		int mlCaptainsRoom_ObjectsThrown = 0;
		bool mbCaptainsRoom_ScareHappened = false;
		
		bool mbGratedDoorScare_DoorLookedAt = false;
		bool mbGratedDoorScare_Happened = false;
		bool mbGratedDoorScare_InsideCaptains = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterCaptainsRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mbGratedDoorScare_InsideCaptains = true;
				Map_AddTimer("Timer_StartGratedDoorEvent", cMath_RandRectf(2.5f, 5.0f), "OnTimer_StartGratedDoorEvent");
			}
			else
			{
				mbGratedDoorScare_InsideCaptains = false;
				Map_RemoveTimer("Timer_StartGratedDoorEvent");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartGratedDoorEvent(const tString &in asTimer)
		{
			if (CanStartScare() == false)
			{
				Map_AddTimer("Timer_StartGratedDoorEvent", cMath_RandRectf(0.5f, 1.0f), "OnTimer_StartGratedDoorEvent");
				return;
			}
			
			StartGratedDoorEvent();
			EndSecondFloorScare(eSecondFloorScareType_Major);
		}
		
		//-------------------------------------------------------
		
		void StartGratedDoorEvent()
		{
			Entity_SetActive("Trigger_GratedDoorLook", true);
			Map_AddTimer("Timer_GratedDoorKnock", 0.0f, "OnTimer_GratedDoorKnock");
			Map_AddTimer("Timer_GratedDoorKnock", 0.3f, "OnTimer_GratedDoorKnock");
			Map_AddTimer("Timer_GratedDoorKnock", 2.3f, "OnTimer_GratedDoorKnock");
			Map_AddTimer("Timer_GratedDoorKnock", 4.3f, "OnTimer_GratedDoorKnock");
			
			Map_AddTimer("Timer_CheckGratedDoorLookAt", 2.0f, "OnTimer_CheckGratedDoorLookAt");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_GratedDoorKnock(const tString &in asTimer)
		{
			Sound_CreateAtEntity("DoorKnock", "physics/wood/wood_trap_door/trap_door_impact", "Door_CaptainsRoom");
//			SwingDoor_AddDoorBodyImpulse("Door_CaptainsRoom", 1);
		}
		
		//-------------------------------------------------------
		
		void OnPlayer_LookAt_GratedDoor(const tString &in asEntity, int alState)
		{
			mbGratedDoorScare_DoorLookedAt = alState == 1;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckGratedDoorLookAt(const tString &in asTimer)
		{
			if (mbGratedDoorScare_InsideCaptains == false)
			{
				CancelGratedDoorScare();
				return;
			}
			
			if (mbGratedDoorScare_DoorLookedAt)
			{
				StartGratedDoorScare();
				return;
			}
			
			Map_AddTimer("Timer_CheckGratedDoorLookAt", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CheckGratedDoorLookAt");
		}
		
		//-------------------------------------------------------
		
		void StartGratedDoorScare()
		{
			if (mbGratedDoorScare_Happened) return;
			mbGratedDoorScare_Happened = true;
			mbSecondFloorScares_Paused = true;
			
			cLux_AddDebugMessage("[Map] StartGratedDoorScare");
			
			Map_RemoveTimer("Timer_GratedDoorKnock");
			Sequence_GratedDoorScare("");
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_GratedDoorScare(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive("Ghoul_GratedDoor", false);
			Entity_SetActive("Trigger_GratedDoorLook", false);
			EndSecondFloorScare(eSecondFloorScareType_Major);
		}
		
		//-------------------------------------------------------
		
		void CancelGratedDoorScare()
		{
			EndSecondFloorScare(eSecondFloorScareType_Minor);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequence_GratedDoorScare;
		void Sequence_GratedDoorScare(const tString &in asTimer)
		{
			Sequence_Begin("Sequence_GratedDoorScare", mSequence_GratedDoorScare);
			
			if (Sequence_DoStepAndWait(0.2f))
			{
				Entity_SetActive("Ghoul_GratedDoor", true);
				Entity_PlayAnimation("Ghoul_GratedDoor", "scare_doorbang", 0.0f, false, false, "OnAnimationOver_GratedDoorScare");
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Sound_CreateAtEntity("GhoulGratedDoor", "creatures/vocalisations/creature/ghoul/ghoul_attack", "Ghoul_GratedDoor");
				Sound_CreateAtEntity("GhoulGratedDoor", "03_05_vitae_station/ghoul_events/ghoul_door_smash", "Ghoul_GratedDoor");
				SwingDoor_AddDoorBodyImpulse("Door_CaptainsRoom", 5.0f);
				
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Music_Play("A2_2_4_Scare_Mid_01.ogg", 0.3f, false, eMusicPrio_BigEvent);
				AddScareFear(0.8f, 4.0f, true, 1.0f, 0.1f, 0.0f);
				Voice_PlayDelayed("Dialogue_RandomReactionsGhoul", 0.5);
			}
			else if (Sequence_DoStepAndWait(3.0f))
			{
				Sound_CreateAtEntity("GhoulRun", "02_04_living_quarters/ghoul_events/ghoul_run_sweet", "Target_GratedDoorExitSound");
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				Sound_CreateAtEntity("GhoulRun", "creatures/foley/creature/ghoul/ghoul_LQ_steps", "Target_GratedDoorExitSound");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event E *See the ghoul hit the grated door in the captain's room*
		
		/////////////////////////////////////////
		// Event F *See and hear stools being rearranged*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------

		bool mbGhoulChange1_SeenBefore = false;
		bool mbGhoulChange1_Cancel = false;
		
		//-------------------------------------------------------
		
		void InitGhoulChange1()
		{
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_GhoulChange1(const tString &in asEntity, int alState)
		{
			mbGhoulChange1_SeenBefore = true;
			Map_AddTimer("Timer_CheckGhoulChange1", 0.5f, "OnTimer_CheckGhoulChange1");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckGhoulChange1(const tString &in asTimer)
		{
			Map_AddTimer("Timer_CheckGhoulChange1", cMath_RandRectf(1.0f, 1.5f), "OnTimer_CheckGhoulChange1");
			if (CanStartScare() == false) return;
			float fDist = cMath_Vector3Dist(Map_GetEntity("Trigger_GhoulChange1").GetPosition(), Player_GetPosition());
			if (fDist < 10.0f || fDist > 20.0f) return;
			bool bLos = cLux_CheckLineOfSight(Map_GetEntity("Trigger_GhoulChange1").GetPosition(), Player_GetPosition(), false, false, null);
			if (bLos) return;
			Map_RemoveTimer("Timer_CheckGhoulChange1");
			Map_AddTimer("Timer_CheckGhoulChange1Cancel", 0.0f, "OnTimer_CheckGhoulChange1Cancel");
			Sequence_GhoulChange1("");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckGhoulChange1Cancel(const tString &in asTimer)
		{
			Map_AddTimer("Timer_CheckGhoulChange1Cancel", cMath_RandRectf(0.2f, 0.4f), "OnTimer_CheckGhoulChange1Cancel");
			float fDist = cMath_Vector3Dist(Map_GetEntity("Trigger_GhoulChange1").GetPosition(), Player_GetPosition());
			if (fDist > 5.0f) return;
			bool bLos = cLux_CheckLineOfSight(Map_GetEntity("Trigger_GhoulChange1").GetPosition(), Player_GetPosition(), false, false, null);
			if (bLos == false) return;
			mbGhoulChange1_Cancel = true;
			Map_RemoveTimer("Timer_CheckGhoulChange1Cancel");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequence_GhoulChange1;
		void Sequence_GhoulChange1(const tString &in asTimer)
		{
			Sequence_Begin("Sequence_GhoulChange1", mSequence_GhoulChange1);
			if (mbGhoulChange1_Cancel)
			{
				EndSecondFloorScare(eSecondFloorScareType_Minor);
				return;
			}
			
			if (Sequence_DoStepAndWait(3.0f))
			{
				cLux_AddDebugMessage("[Map] Scare: StartGhoulChange1");
				mbSecondFloorScares_Paused = true;
				Sound_CreateAtEntity("GhoulCrawl", "creatures/foley/creature/ghoul/ghoul_LQ_steps", "Trigger_GhoulChange1");
				Entity_SetActive("GhoulChange1_Before_NoHalf_*", false);
				Entity_SetActive("GhoulChange1_Half_*", true);
			}
			else if (Sequence_DoStepAndWait(3.2f))
			{
				Sound_CreateAtEntity("GhoulChange1Arrange", "02_04_living_quarters/ghoul_events/chair_arrange", "Trigger_GhoulChange1");
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Sound_CreateAtEntity("GhoulCrawl", "creatures/foley/creature/ghoul/ghoul_LQ_steps", "Trigger_GhoulChange1");
				Entity_SetActive("GhoulChange1_Half_*", false);
				Entity_SetActive("GhoulChange1_Before_*", false);
				Entity_SetActive("GhoulChange1_After_*", true);
				EndSecondFloorScare(eSecondFloorScareType_Normal);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event F *See and hear stools being rearranged*
		
		/////////////////////////////////////////
		// Event F *See and hear stools being rearranged*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbSecondFloorScares_CorpsePullHappened = false;
		
		//-------------------------------------------------------
		
		void SetCorpsePullScareActive(bool abActive)
		{
			if (mbSecondFloorScares_CorpsePullHappened) return;
			iLuxEntity@ pEnt = Map_GetEntity("Trigger_PullCorpse");
			if (pEnt.CheckIsOnScreen(true))
			{
				if (abActive) Map_AddTimer("Timer_CheckCorpsePullVisible", 0.0f, "OnTimer_CheckCorpsePullVisible");
				else Map_AddTimer("Timer_CheckCorpsePullInVisible", 0.0f, "OnTimer_CheckCorpsePullInVisible");
			}
			else
			{
				SetCorpsePullScareVisible(abActive);
			}
		}
		
		//-------------------------------------------------------
		
		void SetCorpsePullScareVisible(bool abVisible)
		{
			Entity_SetActive("FearScaryObject_HoleCorpse", abVisible);
			Entity_SetActive("Corpse_Regis", abVisible);
			if (abVisible) Entity_PlayAnimation("Corpse_Regis", "corpse01_scare_pose", 0.0f);
			Entity_SetActive("Trigger_PullCorpse", abVisible);
			Entity_SetActive("Blocker_PullCorpse", abVisible);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckCorpsePullVisible(const tString &in asTimer)
		{
			if (Map_GetEntity("Trigger_PullCorpse").CheckIsOnScreen(true) == false)
			{
				SetCorpsePullScareVisible(true);
				return;
			}
			Map_AddTimer("Timer_CheckCorpsePullVisible", cMath_RandRectf(0.5f, 1.0f), "OnTimer_CheckCorpsePullVisible");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckCorpsePullInVisible(const tString &in asTimer)
		{
			if (Map_GetEntity("Trigger_PullCorpse").CheckIsOnScreen(true) == false)
			{
				SetCorpsePullScareVisible(false);
				return;
			}
			Map_AddTimer("Timer_CheckCorpsePullInVisible", cMath_RandRectf(0.5f, 1.0f), "OnTimer_CheckCorpsePullInVisible");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequence_CorpsePullScare;
		void Sequence_CorpsePullScare(const tString &in asTimer)
		{
			Sequence_Begin("Sequence_CorpsePullScare", mSequence_CorpsePullScare);
			
			if (Sequence_DoStepAndWait(0.3f))
			{
				cLux_AddDebugMessage("[Map] Scare: CorpsePullScare");
				
				mbSecondFloorScares_CorpsePullHappened = true;
				mbSecondFloorScares_Paused = true;
				
				Entity_SetActive("Ghoul_CorpsePull", true);
				Entity_PlayAnimation("Ghoul_CorpsePull", "corpse_scare_drag", 0.0f);
				
				Entity_PlayAnimation("Corpse_Regis", "corpse01_scare_dragged", 0.0f, false, false, "OnAnimationOver_PullCorpse");
				
				Entity_SetActive("Trigger_PullCorpse", false);
				Entity_SetActive("Blocker_PullCorpse", false);
				
				Sound_Play("Sound_ScareCorpseGrab", 0.0f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Sound_CreateAtEntity("GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_spot", "Ghoul_CorpsePull");
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Music_Play("A2_2_4_Scare_Mid_03.ogg", 0.3f, false, eMusicPrio_BigEvent);
				AddScareFear(0.8f, 4.0f, true, 1.0f, 0.1f, 0.0f);
				Voice_PlayDelayed("Dialogue_RandomReactionsGhoul", 0.5);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_PullCorpse(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive("Ghoul_CorpsePull", false);
			Entity_SetActive("Corpse_Regis", false);
			EndSecondFloorScare(eSecondFloorScareType_Major);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_PullCorpse(const tString &in asEntity)
		{
			Sequence_CorpsePullScare("");
		}
		
		//-------------------------------------------------------
		
		//} END Event F *See and hear stools being rearranged*
		
		/////////////////////////////////////////
		// Event G *Get locked into the artillery room and hear the ghoul scream*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msArtilleryRoom_Ghoul = "Ghoul_ArtilleryRoomScare";
		bool mbSecondFloorScares_ArtilleryRoomNearDoor = false;
		float mfArtilleryCrackLookAtTimer = 0;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterArtilleryRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			iLuxEntity@ pTrigger = Map_GetEntity(asParent);
			if (alState == 1)
			{
				pTrigger.SetVarVector3f("PlayerPos", Player_GetPosition());
			}
			else
			{
				cVector3f vOldPos = pTrigger.GetVarVector3f("PlayerPos");
				cVector3f vDir = Player_GetPosition() - vOldPos;
				vDir.Normalize();
				float fDot = cMath_Vector3Dot(vDir, pTrigger.GetMatrix().GetTranspose().GetForward());
				if (fDot > 0)
				{
					if (mbSuicideMicroflashDone) Entity_SetActive("Trigger_ArtilleryRoomScareArea", true);
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_PreventArtilleryRoomScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbSecondFloorScares_ArtilleryRoomNearDoor = alState == 1;
			return true;
		}
		
		//-------------------------------------------------------
				
		bool OnCollide_Player_EnterArtilleryRoomScareArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_ArtilleryRoomScare_CheckStart", 0.0f, "OnTimer_ArtilleryRoomScare_CheckStart");
			}
			else
			{
				Map_RemoveTimer("Timer_ArtilleryRoomScare_CheckStart");
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ArtilleryRoomScare_CheckStart(const tString &in asTimer)
		{
			if (CanStartScare() && mbSecondFloorScares_ArtilleryRoomNearDoor == false)
			{
				Map_RemoveTimer("Timer_ArtilleryRoomScare_CheckStart");
				Sequence_ArtilleryRoomScare("");
				return;
			}
			Map_AddTimer("Timer_ArtilleryRoomScare_CheckStart", cMath_RandRectf(0.2f, 0.4f), "OnTimer_ArtilleryRoomScare_CheckStart");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequence_ArtilleryRoomScare;
		void Sequence_ArtilleryRoomScare(const tString &in asTimer)
		{
			Sequence_Begin("Sequence_ArtilleryRoomScare", mSequence_ArtilleryRoomScare);
			if (Sequence_DoStepAndWait(0.8f))
			{
				cLux_AddDebugMessage("[Map] Scare: ArtilleryRoomScare");
				
				Map_RemoveTimer("Timer_ArtilleryRoomScare_CheckStart");
				Entity_SetActive("Trigger_ArtilleryRoomScareArea", false);
				Entity_SetActive("Trigger_ArtilleryRoomBlock", true);
				
				mbSecondFloorScares_Paused = true;
				Entity_SetActive("Flashback_Suicide_1", false);
				Entity_SetActive(msArtilleryRoom_Ghoul, true);
				FearThreatAgent_SetComponentEnabled(msArtilleryRoom_Ghoul, false);
				Sound_CreateAtEntity("Sound_ArtilleryScareStart", "02_04_living_quarters/ghoul_scare_events/cannon_room/scare_start", msArtilleryRoom_Ghoul);
			}
			else if (Sequence_DoStepAndWait(1.7f))
			{
				Ghoul_CommandPatrol_ClearNodes(msArtilleryRoom_Ghoul);
				Ghoul_CommandPatrol_AddNode(msArtilleryRoom_Ghoul, "PathNode_98");
				Ghoul_CommandPatrol_Execute(msArtilleryRoom_Ghoul, true, 1, false, eGhoulSpeed_Run);
			}
			else if (Sequence_DoStepAndPause())
			{
				Map_AddTimer("Timer_ArtilleryRoomScare_CheckDoorLookAt", 0.0f, "OnTimer_ArtilleryRoomScare_CheckDoorLookAt");
				Map_AddTimer("Timer_ArtilleryRoomScare_DoorLookAtResume", 4.0f, "OnTimer_ArtilleryRoomScare_DoorLookAtResume");
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Map_AddTimer("Timer_ArtilleryRoomPush", 0.0f, "OnTimer_ArtilleryRoomPush");
				Map_RemoveTimer("Timer_ArtilleryRoomScare_DoorLookAtResume");
				
				Entity_SetActive("Trigger_ArtilleryRoomBlock", false);
				
				SwingDoor_AddDoorBodyImpulse("Door_ArtilleryRoom", -10.0f);
				Sound_CreateAtEntity("DoorSlam", "02_04_living_quarters/ghoul_scare_events/cannon_room/door", "Door_ArtilleryRoom");
				SwingDoor_SetBlocked("Door_ArtilleryRoom", true, false);
			}
			else if (Sequence_DoStepAndWait(0.6f))
			{
				Entity_SetActive(msArtilleryRoom_Ghoul, false);
				SwingDoor_SetOpenAmount("Door_ArtilleryRoom", 0);
				SwingDoor_AddDoorBodyImpulse("Door_ArtilleryRoom", -10.0f);
				Sound_CreateAtEntity("DoorSlam", "02_04_living_quarters/ghoul_scare_events/cannon_room/door", "Door_ArtilleryRoom");
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				SwingDoor_AddDoorBodyImpulse("Door_ArtilleryRoom", -10.0f);
				Sound_CreateAtEntity("DoorSlam", "02_04_living_quarters/ghoul_scare_events/cannon_room/door", "Door_ArtilleryRoom");
			}
			else if (Sequence_DoStepAndWait(2.0f))
			{
				Sound_CreateAtEntity("Sound_ArtilleryPostDoorStep", "02_04_living_quarters/ghoul_scare_events/cannon_room/post_door_step", "Ghoul_ArtilleryCrack", 0, false, 1, 5, 15);
				
				AddScareFear(0.6f, 2.0f, true, 1.0f, 0.1f, 0.0f);
				
			}
			else if (Sequence_DoStepAndPause(0.0f))
			{
				Entity_SetActive("Ghoul_ArtilleryCrack", true);
				Entity_PlayAnimation("Ghoul_ArtilleryCrack", "ghoul_artillery_crack_in_wall_start", 0, false, false, "OnAnimationEnd_ResumeArtilleryRoomScare");
				Sound_CreateAtEntity("Sound_ArtilleryRoomScareGhoul", "02_04_living_quarters/ghoul_scare_events/cannon_room/ghoul", "Ghoul_ArtilleryCrack");
				Sound_Play("Sound_GhoulDebris", 0.0f);
			}
			else if (Sequence_DoStepAndPause(0.0f))
			{
				Entity_PlayAnimation("Ghoul_ArtilleryCrack", "ghoul_artillery_crack_in_wall_waitPose", 0, false, false, "");
				Entity_SetActive("Trigger_LookAtCenterArtilleryCrack", true);
				
				Map_AddTimer("Timer_ArtilleryRoomScare_CheckCrackLookAt", 0.0f, "OnTimer_ArtilleryRoomScare_CheckCrackLookAt");
				Map_AddTimer("Timer_ArtilleryRoomScare_DoorLookAtResume", 3.0f, "OnTimer_ArtilleryRoomScare_DoorLookAtResume");
			}
			else if (Sequence_DoStepAndWait(3.7f))
			{
				Entity_SetActive("Trigger_LookAtCenterArtilleryCrack", false);
				Map_RemoveTimer("Timer_ArtilleryRoomScare_DoorLookAtResume");
				Map_RemoveTimer("Timer_ArtilleryRoomScare_CheckCrackLookAt");
				
				Entity_PlayAnimation("Ghoul_ArtilleryCrack", "ghoul_artillery_crack_in_wall", 0.2, false, false, "");
				
				AddScareFear(0.8f, 6.0f, true, 1.0f, 0.1f, 1.0f);
			}
			else if (Sequence_DoStepAndWait(1.0f))
			{
				Entity_SetActive("Ghoul_ArtilleryCrack", false);
			}
			else if (Sequence_DoStepAndWait(3.5f))
			{
				SwingDoor_SetBlocked("Door_ArtilleryRoom", false, false);
				Sound_Play("Sound_ArtilleryRoomScareHole", 0.0f);
								
				EndSecondFloorScare(eSecondFloorScareType_Major);
			}
		
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ArtilleryRoomPush(const tString &in asTimer)
		{
			cLuxArea@ pArea = cLux_ToArea(Map_GetEntity("Trigger_ArtilleryDoorAABB"));
			cBoundingVolume@ pVolume = pArea.GetMainBody().GetBoundingVolume();
			array<iPhysicsBody@> vBodies;
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(pVolume.GetMin(), pVolume.GetMax(), vBodies);
			for (int i = 0; i < vBodies.size(); ++i)
			{
				iPhysicsBody@ pBody = vBodies[i];
				if (pBody is null) continue;
				if (pBody.IsActive() == false) continue;
				if (pBody.GetMass() < 4) continue;
				
				iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
				if (pEnt is null) continue;
				
				if (cLux_GetBodyEntity(pBody).GetEntityType() != eLuxEntityType_Prop) continue;
				
				cLux_AddDebugMessage("[Map] Push " + pEnt.GetName());
				
				cVector3f vPushDir = pArea.GetMatrix().GetTranspose().GetForward();
				vPushDir.y += 0.5f;
				vPushDir.Normalize();
				
				pBody.AddImpulse(vPushDir * cMath_Max(pBody.GetMass(), 0.5) * 5);
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimationEnd_ResumeArtilleryRoomScare(const tString &in asEntityName, const tString &in asAnimName)
		{
			cLux_AddDebugMessage("WE RESUME 1");
			SequenceStates_Resume("Sequence_ArtilleryRoomScare");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ArtilleryRoomBlock(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("[Map] Close door early to block player");
			SwingDoor_AddDoorBodyImpulse("Door_ArtilleryRoom", -10.0f);
			Sound_CreateAtEntity("DoorSlam", "level_entity_shared/doors/tin_hinan_door/tin_hinan_door_hit", "Door_ArtilleryRoom");
			SwingDoor_SetBlocked("Door_ArtilleryRoom", true, false);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ArtilleryRoomScare_CheckDoorLookAt(const tString &in asTimer)
		{
			if (Map_GetEntity("Door_ArtilleryRoom").CheckIsOnScreen(true))
			{
				Map_RemoveTimer("Timer_ArtilleryRoomScare_DoorLookAtResume");
				Map_AddTimer("Timer_ArtilleryRoomScare_DoorLookAtResume", 0.0f, "OnTimer_ArtilleryRoomScare_DoorLookAtResume");
				return;
			}
			Map_AddTimer("Timer_ArtilleryRoomScare_CheckDoorLookAt", cMath_RandRectf(0.1f, 0.3f), "OnTimer_ArtilleryRoomScare_CheckDoorLookAt");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ArtilleryRoomScare_DoorLookAtResume(const tString &in asTimer)
		{
			cLux_AddDebugMessage("WE RESUME 2");
			SequenceStates_Resume("Sequence_ArtilleryRoomScare");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ArtilleryRoomScare_CheckCrackLookAt(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.1f, 0.3f);
			if (Map_GetEntity("Trigger_LookAtArtilleryCrack").CheckIsOnScreen(true))
			{
				mfArtilleryCrackLookAtTimer += fNext;
				if (mfArtilleryCrackLookAtTimer >= 0.2)
				{
					Map_RemoveTimer("Timer_ArtilleryRoomScare_DoorLookAtResume");
					Map_AddTimer("Timer_ArtilleryRoomScare_DoorLookAtResume", 0.0f, "OnTimer_ArtilleryRoomScare_DoorLookAtResume");
					return;
				}
			}
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_LookAtCenterArtilleryCrack(const tString &in asEntity, int alState)
		{
			Music_Play("A2_2_4_Scare_Mid_02.ogg", 0.6f, false, eMusicPrio_BigEvent);
			Map_RemoveTimer("Timer_ArtilleryRoomScare_DoorLookAtResume");
			Map_AddTimer("Timer_ArtilleryRoomScare_DoorLookAtResume", 0.0f, "OnTimer_ArtilleryRoomScare_DoorLookAtResume");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceArtilleryGhoul;
		void Seq_ArtilleryGhoul(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ArtilleryGhoul", mSequenceArtilleryGhoul);
			if (Sequence_DoStepAndPause(0))
			{
				Entity_SetActive("Ghoul_ArtilleryCrack", true);
				Entity_PlayAnimation("Ghoul_ArtilleryCrack", "ghoul_artillery_crack_in_wall_start", 0, false, false, "OnAnimationEnd_ResumeArtilleryGhoul");
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Entity_PlayAnimation("Ghoul_ArtilleryCrack", "ghoul_artillery_crack_in_wall", 0, false, false, "");
//				Entity_PlayAnimation("Ghoul_ArtilleryCrack", "ghoul_artillery_crack_in_wall_waitPose", 0, false, false, "");
			}
			else if (Sequence_DoStepAndWait(0))
			{
//				Entity_PlayAnimation("Ghoul_ArtilleryCrack", "ghoul_artillery_crack_in_wall", 0, false, false, "");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimationEnd_ResumeArtilleryGhoul(const tString &in asEntityName, const tString &in asAnimName)
		{
			SequenceStates_Resume("Seq_ArtilleryGhoul");
		}
		
		//-------------------------------------------------------
		
		//} END Event G *Get locked into the artillery room and hear the ghoul scream*
		
		/////////////////////////////////////////
		// Event H *See the ghoul jump between pillars*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		float mfSecondFloorScares_PillarScareLookAtTimer = 0.0f;
		bool mbSecondFloorScares_PillarScareSeen = false;
		bool mbSeconFloorScares_PillarScareSetup = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_PillarScare(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				Map_RemoveTimer("Timer_PillarScareJump");
				Map_RemoveTimer("Timer_PillarScare_CheckLookAt");
				mbSecondFloorScares_PillarScareSeen = true;
				Map_AddTimer("Timer_PillarScareJump", 0.0f, "OnTimer_PillarScareJump");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PillarScareJump(const tString &in asTimer)
		{
			mbSecondFloorNoisesActive = true;
			
			Map_RemoveTimer("OnTimer_PillarScare_CheckDistance");
			Map_RemoveTimer("Timer_PillarScare_CheckLookAt");
			Map_RemoveTimer("Timer_PillarScareJump");
			Map_RemoveTimer("Timer_CheckPillarScareStart");
			
			EndSecondFloorScare(eSecondFloorScareType_Normal);
			Entity_SetActive("Trigger_PillarScareArea", false);
			Entity_SetActive("Trigger_PillarScare", false);
			Map_GetEntity("Ghoul_PillarScare").GetMeshEntity().GetAnimationStateFromName("scare_pillarjump").SetPaused(false);
			
			Sound_CreateAtEntity("GhoulJump", "02_04_living_quarters/ghoul_events/ghoul_tunnel_sweet", "Ghoul_PillarScare");
			if (mbSecondFloorScares_PillarScareSeen)
			{
				Map_AddTimer("Timer_PillarScareJumpMusic", 0.3f, "OnTimer_PillarScareJumpMusic");
				Voice_PlayDelayed("Dialogue_RandomReactionsGhoul", 0.8);
			}
			
			Map_AddTimer("Timer_PillarScareCleanup", 0.5, "OnTimer_PillarScareCleanup");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PillarScareCleanup(const tString &in asTimer)
		{
			Light_FadeTo("Light_PillarJump_*", cColor(0,0,0,0), 1.2, 1.0);
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_PillarJump(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive("Ghoul_PillarScare", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PillarScareJumpMusic(const tString &in asTimer)
		{
			Music_Play("A2_3_6_GhoulDropScare", 0.8f, false, eMusicPrio_MinorEvent);
			AddScareFear(0.4f, 4.0f, true, 1.0f, 0.1f, 0.0f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_PillarScareArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mbSecondFloorNoisesActive = false;
				Map_AddTimer("Timer_CheckPillarScareStart", 0, "OnTimer_CheckPillarScareStart");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckPillarScareStart");
				CancelPillarScare();
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckPillarScareStart(const tString &in asTimer)
		{
			StartPillarScare();
			if (mbSecondFloorScares_Paused) CancelPillarScare();
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.4));
		}
		
		//-------------------------------------------------------
		
		bool StartPillarScare()
		{
			if (mbSeconFloorScares_PillarScareSetup) return false;
			if (CanStartScare() == false) return false;
			if (Map_GetEntity("Trigger_PillarScareOnScreen").CheckIsOnScreen(true)) return false;
			
			cLux_AddDebugMessage("[Map] Scare: StartPillarScare");
				
			mbSeconFloorScares_PillarScareSetup = true;
			
			Entity_SetActive("Trigger_PillarScare", true);
			Entity_SetActive("Ghoul_PillarScare", true);
			
			Light_FadeTo("Light_PillarJump_*", cColor(1,0.843,0.609,1), 1.2, 0.2);
			
			Entity_PlayAnimation("Ghoul_PillarScare", "scare_pillarjump", 0.0f, false, false, "OnAnimationOver_PillarJump");
			Map_GetEntity("Ghoul_PillarScare").GetMeshEntity().GetAnimationStateFromName("scare_pillarjump").SetPaused(true);
			Map_GetEntity("Ghoul_PillarScare").GetMeshEntity().GetAnimationStateFromName("scare_pillarjump").SetTimePosition(0.0f);
			
			mfSecondFloorScares_PillarScareLookAtTimer = 0.0f;
			Map_AddTimer("Timer_PillarScare_CheckLookAt", 0.0f, "OnTimer_PillarScare_CheckLookAt");
			return true;
		}
		
		//-------------------------------------------------------
		
		void CancelPillarScare()
		{
			if (mbSeconFloorScares_PillarScareSetup == false) return;
			mbSeconFloorScares_PillarScareSetup = false;
			
			cLux_AddDebugMessage("[Map] Scare: cancel PillarScare");
			
			Light_FadeTo("Light_PillarJump_*", cColor(0,0,0,0), 1.2, 0.2);
			
			mbSecondFloorNoisesActive = true;
						
			Entity_SetActive("Trigger_PillarScare", false);
			Entity_SetActive("Ghoul_PillarScare", false);
			
			Map_RemoveTimer("Timer_PillarScare_CheckLookAt");
			Map_RemoveTimer("Timer_PillarScareJump");
		}
		//-------------------------------------------------------
		
		void OnTimer_PillarScare_CheckLookAt(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.1f, 0.2f);
			Map_AddTimer("Timer_PillarScare_CheckLookAt", fNext, "OnTimer_PillarScare_CheckLookAt");
						
			if (Map_GetEntity("Trigger_PillarScareOnScreen").CheckIsOnScreen(true))
			{
				mfSecondFloorScares_PillarScareLookAtTimer += fNext;
				if (mfSecondFloorScares_PillarScareLookAtTimer >= 2.4f || Player_GetDistanceToEntity("Trigger_PillarScareOnScreen") <= 7)
				{
					Map_AddTimer("Timer_PillarScareJump", 0.0f, "OnTimer_PillarScareJump");
				}
			}
			else
			{
				mfSecondFloorScares_PillarScareLookAtTimer = 0;
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event H *See the ghoul jump between pillars*
		
		/////////////////////////////////////////
		// Event I *See the shadow of a ghoul move*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbShadowScare_Happened = false;
		int mlSecondFloorScares_TowerShadowArea = 0;
		float mfSecondFloorScares_ShadowScareScreenTime = 0;
		bool mbShadowScare_Setup = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_TowerShadowScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlSecondFloorScares_TowerShadowArea += alState;
			if (mbShadowScare_Setup == false && CanStartScare() && mlSecondFloorScares_TowerShadowArea > 0)
			{
				cLux_AddDebugMessage("[Map] Scare: Setup TowerShadowScare");
				
				mbShadowScare_Setup = true;
				mbSecondFloorScares_Paused = true;
				Entity_SetActive("Trigger_TowerShadowScare", true);
				Entity_SetActive("Ghoul_ShadowScare", true);
				FearThreatAgent_SetComponentEnabled("Ghoul_ShadowScare", false);
				
				Map_AddTimer("Timer_CheckShadowOnScreen", 0, "OnTimer_CheckShadowOnScreen");
			}
			else if (mbShadowScare_Setup && mlSecondFloorScares_TowerShadowArea <= 0)
			{
				cLux_AddDebugMessage("[Map] Scare: Cancel TowerShadowScare");
				
				mbShadowScare_Setup = false;
				mfSecondFloorScares_ShadowScareScreenTime = 0;
				EndSecondFloorScare(eSecondFloorScareType_None);
				Entity_SetActive("Trigger_TowerShadowScare", false);
				Entity_SetActive("Ghoul_ShadowScare", false);
				
				Map_RemoveTimer("Timer_CheckShadowOnScreen");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckShadowOnScreen(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.2, 0.4);
			if (Map_GetEntity("Trigger_TowerShadowScareOnScreen").CheckIsOnScreen(true))
			{
				mfSecondFloorScares_ShadowScareScreenTime += fNext;
				if (mfSecondFloorScares_ShadowScareScreenTime > 2.0)
				{
					StartShadowScare();
				}
			}
			else 
			{
				mfSecondFloorScares_ShadowScareScreenTime = 0;
			}
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_TowerShadowScare(const tString &in asEntity, int alState)
		{
			StartShadowScare();
		}
		
		//-------------------------------------------------------
		
		void StartShadowScare()
		{
			if (mbShadowScare_Happened) return;
			mbShadowScare_Happened = true;
			
			cLux_AddDebugMessage("[Map] Scare: Start TowerShadowScare");
			
			Entity_SetActive("Trigger_TowerShadowScareArea*", false);
			Map_AddTimer("Timer_ShadowScareMove", 0.0f, "OnTimer_ShadowScareMove");
			Map_AddTimer("Timer_ShadowScareStinger", 0.7f, "OnTimer_ShadowScareStinger");
			Map_AddTimer("Timer_EndShadowScare", 2.0f, "OnTimer_EndShadowScare");
			
			Entity_SetActive("Trigger_BarrelKickScare", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShadowScareMove(const tString &in asTimer)
		{
			Ghoul_CommandPatrol_ClearNodes("Ghoul_ShadowScare");
			Ghoul_CommandPatrol_AddNode("Ghoul_ShadowScare", "PathNode_130");
			Ghoul_CommandPatrol_Execute("Ghoul_ShadowScare", true, 1, false, eGhoulSpeed_FastRun, "OnCommandEnd_ShadowScareMove");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShadowScareStinger(const tString &in asTimer)
		{
			if (Map_GetEntity("Trigger_TowerShadowScare").CheckIsOnScreen(true))
			{
				Music_Play("A2_3_6_GhoulDropScare", 0.8f, false, eMusicPrio_MinorEvent);
				AddScareFear(0.4f, 4.0f, true, 1.0f, 0.1f, 0.0f);
				Voice_PlayDelayed("Dialogue_RandomReactionsGhoul", 0.25);
			}
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_ShadowScareMove(const tString &in asEntity)
		{
			Sound_CreateAtEntity("GhoulEnterHole", "", "creatures/foley/creature/ghoul/ghoul_LQ_steps");
			Entity_SetActive("Ghoul_ShadowScare", false);
//			Voice_Play("Dialogue_RandomReactionsGhoul");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EndShadowScare(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_BarrelKickArea_*", true);
			EndSecondFloorScare(eSecondFloorScareType_Minor);
		}
		
		//-------------------------------------------------------
		
		//} END Event I *See the shadow of a ghoul move*
		
		/////////////////////////////////////////
		// Event J *See the ghoul's head behind the map room grate*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlSecondFloorScares_GreateStalkAreas = 0;
		bool mbSecondFloorScares_GrateStalkStarted = false;
		bool mbSecondFloorScares_GrateStalkOver = false;
		bool mbSecondFloorScares_GrateStalkSeen = false;
		float mfSecondFLoorScares_GrateStalkTimer = 0;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_GrateStalkScare(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_CheckStalkGrateScareStart", 0.0f, "OnTimer_CheckStalkGrateScareStart");
			}
			else
			{
				CancelGrateStalkScare();
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void CancelGrateStalkScare()
		{
			if (mbSecondFloorScares_GrateStalkStarted)
			{
				cLux_AddDebugMessage("[Map] Scare: cancel StalkGrateScare");
				mbSecondFloorScares_GrateStalkStarted = false;
				mbSecondFloorNoisesActive = true;
				EndSecondFloorScare(eSecondFloorScareType_None);
			}
			
			mfSecondFLoorScares_GrateStalkTimer = 0;
			Entity_SetActive("Trigger_EndfGrateStalk", false);
			
			Entity_SetActive("Ghoul_GrateStalk", false);
//			if (Entity_IsActive("Ghoul_GrateStalk"))
//			{
//				Entity_PlayAnimation("Ghoul_GrateStalk", "scare_wall_grate_glimpse_climb_down", 0.0f, false, false, "");
//				Map_GetEntity("Ghoul_GrateStalk").GetMeshEntity().GetAnimationStateFromName("scare_wall_grate_glimpse_climb_down").SetRelativeTimePosition(0.0f);
//				Map_GetEntity("Ghoul_GrateStalk").GetMeshEntity().GetAnimationStateFromName("scare_wall_grate_glimpse_climb_down").SetSpeed(1.0f);
//			}
			
			Map_RemoveTimer("Timer_CheckStalkGrateScareStart");
			Map_RemoveTimer("Timer_ActivateEndGrateStalk");
			Map_RemoveTimer("Timer_CheckEndGrateStalk");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckStalkGrateScareStart(const tString &in asTimer)
		{
			if (CanStartScare() && mbSecondFloorScares_GrateStalkStarted == false && Map_GetEntity("Trigger_GrateStalk").CheckIsOnScreen(true))
			{
				cLux_AddDebugMessage("[Map] Scare: start StalkGrateScare");
				
				mbSecondFloorScares_GrateStalkStarted = true;
				
				mbSecondFloorScares_Paused = true;
				mbSecondFloorNoisesActive = false;
				
				Entity_SetActive("Ghoul_GrateStalk", true);
				Entity_PlayAnimation("Ghoul_GrateStalk", "scare_wall_grate_glimpse_climb_down", 0.0f, false, false, "");
				Map_GetEntity("Ghoul_GrateStalk").GetMeshEntity().GetAnimationStateFromName("scare_wall_grate_glimpse_climb_down").SetRelativeTimePosition(0.5f);
				Map_GetEntity("Ghoul_GrateStalk").GetMeshEntity().GetAnimationStateFromName("scare_wall_grate_glimpse_climb_down").SetSpeed(-0.8f);
				
				Map_AddTimer("Timer_ActivateEndGrateStalk", 1.75, "OnTimer_ActivateEndGrateStalk");
				Map_AddTimer("Timer_CheckEndGrateStalk", 1.75, "OnTimer_CheckEndGrateStalk");
				return;
			}
					
			Map_AddTimer("Timer_CheckStalkGrateScareStart", cMath_RandRectf(0.2f, 0.4f), "OnTimer_CheckStalkGrateScareStart");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckEndGrateStalk(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.2, 0.4);
			if (Map_GetEntity("Trigger_GrateStalk").CheckIsOnScreen(true))
			{
				mfSecondFLoorScares_GrateStalkTimer += fNext;
				if (mfSecondFLoorScares_GrateStalkTimer >= 3.0)
				{
					EndGrateStalk();
					return;
				}
			}
			Map_RestartCurrentTimer(fNext);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateEndGrateStalk(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_EndfGrateStalk", true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_EndGrateStalk(const tString &in asEntity, int alState)
		{
			mbSecondFloorScares_GrateStalkSeen = true;
			EndGrateStalk();
		}
		
		//-------------------------------------------------------
		
		void EndGrateStalk()
		{
			if (mbSecondFloorScares_GrateStalkOver) return;
			mbSecondFloorScares_GrateStalkOver = true;
			
			mbSecondFloorScares_Paused = true;
			
			Entity_SetActive("Trigger_EndfGrateStalk", false);
			Entity_SetActive("Trigger_GrateStalkArea*", false);
			
			Entity_PlayAnimation("Ghoul_GrateStalk", "scare_wall_grate_glimpse_climb_down", 0.0f, false, false, "");
			Map_GetEntity("Ghoul_GrateStalk").GetMeshEntity().GetAnimationStateFromName("scare_wall_grate_glimpse_climb_down").SetRelativeTimePosition(0.0f);
			Map_GetEntity("Ghoul_GrateStalk").GetMeshEntity().GetAnimationStateFromName("scare_wall_grate_glimpse_climb_down").SetSpeed(1.0f);
			Sound_CreateAtEntity("GhoulTaunt", "creatures/vocalisations/creature/ghoul/ghoul_stalk_singing", "Ghoul_GrateStalk");
			
			if (mbSecondFloorScares_GrateStalkSeen) Map_AddTimer("Timer_StalkGrateStinger", 0.5f, "OnTimer_StalkGrateStinger");
			Map_AddTimer("Timer_StalkGrateEnd", 1.5f, "OnTimer_StalkGrateEnd");
		}

		//-------------------------------------------------------
		
		void OnTimer_StalkGrateStinger(const tString &in asTimer)
		{
			if (Map_GetEntity("Trigger_GrateStalk").CheckIsOnScreen(true))
			{
				Music_Play("A2_3_6_GhoulDropScare", 0.8f, false, eMusicPrio_MinorEvent);
				AddScareFear(0.4f, 4.0f, true, 1.0f, 0.1f, 0.0f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StalkGrateEnd(const tString &in asTimer)
		{
			mbSecondFloorNoisesActive = true;
			EndSecondFloorScare(eSecondFloorScareType_Normal);
				
			Entity_SetActive("Ghoul_GrateStalk", false);
			ActivateCornerGhoulScare(1, true);
		}
		
		//-------------------------------------------------------
		
		bool FirstFloorMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_PlayExt("A2_2_4_LivingQuarters1.ogg", true, 0.06f, 1.0f, 15.0f, 0.0f, eMusicPrio_BgAmb, true);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool SecondFloorMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_PlayExt("A2_2_4_LivingQuarters2.ogg", true, 0.1f, 1.0f, 4.0f, 0.0f, eMusicPrio_BgAmb, true);
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event J *See the ghoul's head behind the map room grate*

		/////////////////////////////////////////
		// Event K *Spot the ghoul’s eyes through a crack in the wall*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msWallCrack_Ghoul = "Ghoul_WallCrack";
		tString msWallCrack_Oil = "Oil_Wallcrack";
		bool mbWallCrack_Missed = false;
		bool mbWallCrack_Done = false;
		
		//-------------------------------------------------------
		
		void WallCrack_SetBarrelScareActive(bool abX)
		{
			if (mbWallCrack_Missed) return;
			if (mbWallCrack_Done) return;
			Entity_SetActive("Trigger_WallCrackEvent", abX);
			Entity_SetActive(msWallCrack_Oil, abX);
			Entity_SetActive("Trigger_BarrelScareBuildup", abX);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_BarrelScareBuildup(const tString &in asParent, const tString &in asChild, int alState)
		{
			float fTimeSinceLastNoise = mfSecondFLoorScares_NoiseLastTimer - Map_GetTimerTime("Timer_PlaySecondFloorNoise");
			if (fTimeSinceLastNoise >= 3.0f)
			{
				iLuxEntity@ pEnt = cLux_ID_Entity(m_idSecondFloorScares_ClosestNoise);
				if (pEnt !is null) Sound_CreateAtEntity("GhoulNoise", "creatures/foley/creature/ghoul/ghoul_LQ_steps", pEnt.GetName());
				float fTime = Map_GetTimerTime("Timer_PlaySecondFloorNoise");
				Map_RemoveTimer("Timer_PlaySecondFloorNoise");
				Map_AddTimer("Timer_PlaySecondFloorNoise", fTime + 5.0f, "OnTimer_PlaySecondFloorNoise");
				Map_AddTimer("FloorCreakCooldown", cMath_RandRectf(mvSecondFloor_FloorBreakCooldown.x, mvSecondFloor_FloorBreakCooldown.y), "");
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_WallCrackEvent(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_CheckWallCrack", 0.0f, "OnTimer_CheckWallCrack");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckWallCrack");
			}
					
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckWallCrack(const tString &in asTimer)
		{
			if (CanStartScare())
			{
				mbWallCrack_Done = true;
				mbSecondFloorScares_Paused = true;
				Entity_SetInteractionDisabled(msWallCrack_Oil, true);
				Map_AddTimer("Timer_WallCrackAnimation", 0.0f, "OnTimer_WallCrackAnimation");
				Map_AddTimer("Timer_WallCrackSound1", 0.0f, "OnTimer_WallCrackSound1");
				Map_AddTimer("Timer_WallCrackSound2", 0.0f, "OnTimer_WallCrackSound2");
				Map_AddTimer("Timer_WallCrackMusic", 0.2f, "OnTimer_WallCrackMusic");
				AddScareFear(0.8f, 2.0f, true, 2.0f, 0.1f, 0.5f);
				Voice_PlayDelayed("Dialogue_RandomReactionsGhoul", 0.8);
				return;
			}
			Map_AddTimer("Timer_CheckWallCrack", cMath_RandRectf(0.2f, 0.4f), "OnTimer_CheckWallCrack");
		}
		
		//-------------------------------------------------------
		
		void OnInteract_PickupWallCrackOil(const tString &in asEntity)
		{
			mbWallCrack_Missed = true;
			EndWallCrack();
		}

		//-------------------------------------------------------
		
		void OnTimer_WallCrackAnimation(const tString &in asTimer)
		{
			Entity_SetActive(msWallCrack_Ghoul, true);
			Entity_PlayAnimation(msWallCrack_Ghoul, "grab_through_hole_in_wall_above", 0.0f, false, false, "OnAnimationOver_WallCrack");
			Map_AddTimer("Timer_WallCrackAnimationPickup", 0.25f, "OnTimer_WallCrackAnimationPickup");
			Sound_Play("Sound_OilScareGhoul", 0.0f);
			Sound_Play("Sound_OilScareOil", 0.0f);  
		}
		
		//-------------------------------------------------------
		
		void OnTimer_WallCrackAnimationPickup(const tString &in asTimer)
		{
			Entity_SetActive(msWallCrack_Oil, false);
//			Entity_AttachToSocket(msWallCrack_Oil, "Ghoul_WallCrack","socket_righthand_damage", true, false);
		}
		
		//-------------------------------------------------------

		void OnTimer_WallCrackSound1(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Target_SoundWallCrack_1", "02_04_living_quarters/ghoul_scare_events/ghoul_wall_scare_01", "Trigger_WallCrackEvent");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_WallCrackSound2(const tString &in asTimer)
		{
			Sound_CreateAtEntity("Target_SoundWallCrack_2", "02_04_living_quarters/ghoul_scare_events/ghoul_wall_scare_02", "Trigger_WallCrackEvent");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_WallCrackMusic(const tString &in asTimer)
		{
			Music_Play("A2_2_4_Scare_Mid_02.ogg", 0.3f, false, eMusicPrio_BigEvent);
		}

		//-------------------------------------------------------
		
		void OnAnimationOver_WallCrack(const tString &in asEntityName, const tString &in asAnimName)
		{
			EndSecondFloorScare(eSecondFloorScareType_Major);
			EndWallCrack();
		}
		
		//-------------------------------------------------------
		
		void EndWallCrack()
		{
			Entity_SetActive(msWallCrack_Ghoul, false);
			Map_RemoveTimer("Timer_CheckWallCrack");
			Entity_SetActive("Trigger_WallCrackEvent", false);
			Entity_SetActive("Trigger_BarrelScareBuildup", false);
			
			Entity_SetActive("Trigger_GrateStalkArea*", true);
		}
		
		//-------------------------------------------------------
		
		//} END Event K *Spot the ghoul’s eyes through a crack in the wall*

		/////////////////////////////////////////
		// Event L *Notice the stalking ghoul*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msCornerGhoul_GhoulEntity = "Ghoul_Corner_";
		array<bool> mvCornerGhouls_DirectionLeft = { true, false };
		array<int> mvCornerGhoul_LookAt;
		array<int> mvCornerGhoul_Area;
		int mlCornerGhoul_Index = -1;
		float mfCornerGhoul_OnScreenTimer = 0;
		int mlCornerGhoul_AreaIndex = -2;
		tString msCornerGhoul_Ghoul = "";
		bool mbCornerGhoul_Active = false;
		
		//-------------------------------------------------------
		
		void ActivateCornerGhoulScare(int alId, bool abActive)
		{
			Entity_SetActive("Trigger_CornerGhoul_" + alId, abActive);
			Entity_SetActive("Trigger_CornerGhoulArea_" + alId, abActive);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_CornerGhoul(const tString &in asEntity, int alState)
		{
			int lIndex = cString_GetNumericSuffixInt(asEntity);
			if (alState == 1)
			{
				mvCornerGhoul_LookAt.push_back(lIndex);
			}
			else
			{
				for (int i = 0; i < mvCornerGhoul_LookAt.size(); ++i)
				{
					if (mvCornerGhoul_LookAt[i] == lIndex)
					{
						mvCornerGhoul_LookAt.removeAt(i);
						break;
					}
				}
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterCornerGhoulArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			int lIndex = cString_GetNumericSuffixInt(asParent);
			if (alState == 1)
			{
				mvCornerGhoul_Area.push_back(lIndex);
				if (Map_TimerExists("Timer_CornerGhoul_CheckLookAt") == false) Map_AddTimer("Timer_CornerGhoul_CheckLookAt", 0.2f, "OnTimer_CornerGhoul_CheckLookAt");
			}
			else
			{
				for (int i = 0; i < mvCornerGhoul_Area.size(); ++i)
				{
					if (mvCornerGhoul_Area[i] == lIndex)
					{
						mvCornerGhoul_Area.removeAt(i);
						if (mvCornerGhoul_Area.size() == 0) Map_RemoveTimer("Timer_CornerGhoul_CheckLookAt");
						break;
					}
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CornerGhoul_CheckLookAt(const tString &in asTimer)
		{
			if (CanStartScare())
			{
				for (int i = 0; i < mvCornerGhoul_Area.size(); ++i)
				{
					for (int j = 0; j < mvCornerGhoul_LookAt.size(); ++j)
					{
						if (mvCornerGhoul_Area[i] == mvCornerGhoul_LookAt[j])
						{
							CornerGhoul_Start(mvCornerGhoul_LookAt[j]);
						}
					}
				}
			}
			Map_AddTimer("Timer_CornerGhoul_CheckLookAt", cMath_RandRectf(0.2f, 0.4f), "OnTimer_CornerGhoul_CheckLookAt");
		}
		
		//-------------------------------------------------------
		
		void CornerGhoul_Start(int alGhoulIndex)
		{
			msCornerGhoul_Ghoul = msCornerGhoul_GhoulEntity + alGhoulIndex;
			mlCornerGhoul_Index = alGhoulIndex - 1;
			mfCornerGhoul_OnScreenTimer = 0;
			
			if (Entity_GetVarBool(msCornerGhoul_Ghoul, "CornerLean")) return;
			if (mbCornerGhoul_Active) return;
			Entity_SetVarBool(msCornerGhoul_Ghoul, "CornerLean", true);
			Entity_SetActive(msCornerGhoul_Ghoul, true);
			mbCornerGhoul_Active = true;
			
			cLux_AddDebugMessage("[Map] Scare: start CornerGhoul" + alGhoulIndex);
			
			mbSecondFloorScares_Paused = true;
			Entity_SetActive(msCornerGhoul_Ghoul, true);
			tString sEnterAnim = "leans_around_corner_";
			sEnterAnim += mvCornerGhouls_DirectionLeft[mlCornerGhoul_Index] ? "left" : "right";
			sEnterAnim += "_enter";
			Entity_PlayAnimation(msCornerGhoul_Ghoul, sEnterAnim, 0.0f, false, false, "OnAnimationOver_CornerGhoul_Enter");
			Map_AddTimer("Timer_CornerGhoul_CheckDistance", 0.75f, "OnTimer_CornerGhoul_CheckDistance");
			Map_AddTimer("Timer_CornerGhoul_TimeOver", 10.0f, "OnTimer_CornerGhoul_TimeOver");
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_CornerGhoul_Enter(const tString &in asEntityName, const tString &in asAnimName)
		{
			tString sEnterAnim = "leans_around_corner_";
			sEnterAnim += mvCornerGhouls_DirectionLeft[mlCornerGhoul_Index] ? "left" : "right";
			Entity_PlayAnimation(msCornerGhoul_Ghoul, sEnterAnim, 0.1f, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CornerGhoul_CheckDistance(const tString &in asTimer)
		{
			float fNextCheck = cMath_RandRectf(0.1, 0.3);
			float fDist = cMath_Vector3Dist(Map_GetEntity(msCornerGhoul_Ghoul).GetPosition(), Player_GetPosition());
			
			if (Map_GetEntity("Trigger_CornerGhoul_" + (mlCornerGhoul_Index + 1)).CheckIsOnScreen(true)) mfCornerGhoul_OnScreenTimer += fNextCheck;
			
			if (fDist <= 10.0f || mfCornerGhoul_OnScreenTimer >= 1.2f)
			{
				CornerGhoul_Leave();
				return;
			}
			Map_AddTimer("Timer_CornerGhoul_CheckDistance", fNextCheck, "OnTimer_CornerGhoul_CheckDistance");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CornerGhoul_TimeOver(const tString &in asTimer)
		{
			CornerGhoul_Leave();
		}
		
		//-------------------------------------------------------
		
		void CornerGhoul_Leave()
		{
			Map_RemoveTimer("Timer_CornerGhoul_CheckDistance");
			Map_RemoveTimer("Timer_CornerGhoul_TimeOver");
			
			tString sEnterAnim = "leans_around_corner_";
			sEnterAnim += mvCornerGhouls_DirectionLeft[mlCornerGhoul_Index] ? "left" : "right";
			sEnterAnim += "_quick_exit";
			Entity_PlayAnimation(msCornerGhoul_Ghoul, sEnterAnim, 0.1f, false, false, "OnAnimationOver_CornerGhoul_Exit");
			
			EndSecondFloorScare(eSecondFloorScareType_Normal);
			Map_AddTimer("Timer_CornerGhoul_ExitNoiseGhoul", 0.0f, "OnTimer_CornerGhoul_ExitNoiseGhoul");
//			Map_AddTimer("Timer_CornerGhoul_ExitStinger", 0.5f, "OnTimer_CornerGhoul_ExitStinger");
			Map_AddTimer("Timer_CornerGhoul_ExitNoiseHole", 1.5f, "OnTimer_CornerGhoul_ExitNoiseHole");
			
			ActivateCornerGhoulScare(mlCornerGhoul_Index, false);
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_CornerGhoul_Exit(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive(msCornerGhoul_Ghoul, false);
			mbCornerGhoul_Active = false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CornerGhoul_ExitStinger(const tString &in asTimer)
		{
			if (Map_GetEntity("Trigger_CornerGhoul_" + (mlCornerGhoul_Index + 1)).CheckIsOnScreen(true))
			{
				Music_Play("A2_3_6_GhoulDropScare", 0.8f, false, eMusicPrio_MinorEvent);
				AddScareFear(0.4f, 4.0f, true, 1.0f, 0.1f, 0.0f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CornerGhoul_ExitNoiseGhoul(const tString &in asTimer)
		{
			Sound_CreateAtEntity("CornerGhoulExit", "creatures/vocalisations/creature/ghoul/ghoul_stalk_singing", msCornerGhoul_Ghoul);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CornerGhoul_ExitNoiseHole(const tString &in asTimer)
		{
			Sound_CreateAtEntity("CornerGhoulExit", "creatures/foley/creature/ghoul/ghoul_LQ_steps", msCornerGhoul_Ghoul);
		}
		
		//-------------------------------------------------------
		
		//} END Event L *Notice the stalking ghoul*
		
		/////////////////////////////////////////
		// Event M *Notice that the trestle has moved*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void OnLookAt_Trestle(const tString &in asEntity, int alState)
		{
			Map_AddTimer("Timer_CheckTrestle", 0, "OnTimer_CheckTrestle");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckTrestle(const tString &in asTimer)
		{
			if (Player_GetDistanceToEntity("MovingTrestle") >= 10 && 
				Player_GetDistanceToEntity("MovingTrestle_Target") >= 8 &&
				Map_GetEntity("MovingTrestle").CheckIsOnScreen(true) == false &&
				Map_GetEntity("Trigger_MovingTrestleLocation").CheckIsOnScreen(true) == false)
			{
				Entity_PlaceAtEntity("MovingTrestle", "MovingTrestle_Target", cVector3f_Zero, true);
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.3, 0.8));
		}
		
		//-------------------------------------------------------
		
		//} END Event M *Notice that the trestle has moved*
		
		/////////////////////////////////////////
		// Event M *Notice weird objects appearing on a table*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void OnLookAt_FloorTableScare(const tString &in asEntity, int alState)
		{
			Map_AddTimer("Timer_FloorTableScare", 0, "OnTimer_FloorTableScare");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FloorTableScare(const tString &in asTimer)
		{
			if (Player_GetDistanceToEntity("Trigger_FloorTableScare") >= 10 && 
				Map_GetEntity("Trigger_FloorTableScare").CheckIsOnScreen(true) == false)
			{
				Entity_SetActive("floor_table_object_*", true);
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.3, 0.8));
		}
		
		//-------------------------------------------------------
		
		//} END Event M *Notice weird objects appearing on a table*
		
		/////////////////////////////////////////
		// Event M *The bed covering the mess hall hole breaks when you step on it*
		//{//////////////////////////////////////
				
		//-------------------------------------------------------
		
		int mlFrenchBedWeakSteppedOn = 0;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_FrenchBedWeakCreak(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				++mlFrenchBedWeakSteppedOn;
				Sound_CreateAtEntity("BedCreak", "02_04_living_quarters/tower/beam_creak", asParent, 0.0f, false, 1.0f);
				if (mlFrenchBedWeakSteppedOn == 2)
				{
					Entity_SetActive("FrenchBedWeak", false);
					Entity_SetActive("Trigger_FrenchBedWeakCreak_1", false);
					Entity_SetActive("FrenchBedWeak_2", true);
					Entity_SetActive("Trigger_FrenchBedWeakCreak_2", true);
					Sound_CreateAtEntity("BedBreak", "02_04_living_quarters/floor_plank/floor_plank_break", asParent, 0.0f, false, 1.0f);
					ParticleSystem_CreateAtEntity("BedBreakParticles", "02_04_cannon_floor_partial_break", asParent, false);
					
					Effect_Shake_Start(0.04, 0.5, 0, 0);
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		//} END Event M *The bed covering the mess hall hole breaks when you step on it*
		
		/////////////////////////////////////////
		// Event M *Notice the map room from above*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		float mfMapRoom_LookAtAboveTimer = 0.0f;
		int mlMapRoom_LookAtGratingAbove = 0;
		bool mbMapRoomAboveDialogueOver = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_MapRoom(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				mfMapRoom_LookAtAboveTimer = 0.0f;
				Map_AddTimer("Timer_MapRoom_CheckLookAtAbove", 0.2f, "OnTimer_MapRoom_CheckLookAtAbove");
			}
			else
			{
				Map_RemoveTimer("Timer_MapRoom_CheckLookAtAbove");
			}
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_MapRoomGrating(const tString &in asEntity, int alState)
		{
			mlMapRoom_LookAtGratingAbove += alState;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MapRoom_CheckLookAtAbove(const tString &in asTimer)
		{
			if (Voice_SubjectHasUnplayedLines("Dialogue_LookingAtMapRoom") == false)
			{
				mbMapRoomAboveDialogueOver = true;
				Entity_SetActive("Trigger_LookAt_MapRoomAboveDialogue*", false);
				return;
			}
			
			if (mlMapRoom_LookAtGratingAbove > 0)
			{
				mfMapRoom_LookAtAboveTimer += 0.2f;
				if (mfMapRoom_LookAtAboveTimer >= 1.5f && Map_TimerExists("Timer_MapRoom_AboveDialogueCooldown") == false)
				{
					Voice_Play("Dialogue_LookingAtMapRoom");
					Map_AddTimer("Timer_MapRoom_AboveDialogueCooldown", 10.0f, "Timer_MapRoom_AboveDialogueCooldown");
				}
			}
			Map_AddTimer("Timer_MapRoom_CheckLookAtAbove", 0.2f, "OnTimer_MapRoom_CheckLookAtAbove");
		}
		
		//-------------------------------------------------------
		
		//} END Event M *Notice the map room from above*

	//} END SCENE 2
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 3 *Get to the second part of the first floor*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are used by many events in Scene X here.*/

		//-------------------------------------------------------

		/*Put any functions that are used in more than one event in Scene X here.*/

		//-------------------------------------------------------

		//} END General	
		
		/////////////////////////////////////////
		// Event A *Walk on the CREAKY FLOOR*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlBrokenFloor_JumpCount = 0;
		int mlBrokenFloor_ContactCount = 0;
		bool mbBrokenFloor_FirstHint = false;
		int mlBrokenFloor_JumpOnFloorHints = 0;
		int mlBrokenFloor_JumpCountAtLastHint = -1;
		int mfBrokenFloor_LastJumpTimestamp = 0;
		
		//-------------------------------------------------------
		
		void InitBrokenFloor()
		{
			Entity_SetActive("BrokenFloor_PartiallyBroken*", mlBrokenFloorStage == 1);
			Entity_SetActive("BrokenFloor_Before*", mlBrokenFloorStage == 0);
			Entity_SetActive("BrokenFloor_After*", mlBrokenFloorStage == 2);
			Entity_SetActive("BrokenFloor_AfterHide*", mlBrokenFloorStage != 2);
				
			Entity_SetActive("Trigger_BrokenFloorCreak_1", mlBrokenFloorStage != 2);
			Entity_SetActive("Trigger_BrokenFloorCreak_2", mlBrokenFloorStage != 2);
			Entity_SetActive("Trigger_BrokenFloorCreak_3", mlBrokenFloorStage != 2);
			
			Entity_SetActive("BrokenFloor_CannonCrashed*", mbBrokenFloor_CannonCrashed && mlBrokenFloorStage == 2);
		}
		
		//-------------------------------------------------------
		
		int mlBrokenFloorHintsGiven = 0;
		bool OnCollide_Player_BrokenFloorCreak(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (Map_TimerExists("BrokenFloorCooldown")) return true;
			Map_AddTimer("BrokenFloorCooldown", 0.2, "");
			if (alState != 1) return true;
			
			++mlBrokenFloor_ContactCount;
			
			bool bJump = Player_GetVelocity().y < -2.0f;
			float fTimeSinceLastJump = 9999;
			if (bJump)
			{
				++mlBrokenFloor_JumpCount;
				fTimeSinceLastJump = Map_GetElapsedTime(mfBrokenFloor_LastJumpTimestamp);
				mfBrokenFloor_LastJumpTimestamp = Map_GetTimeStamp();
			}
			
			int lPrevHintsGiven = mlBrokenFloorHintsGiven;
	
			//////////////
			// voices
			if (mlBrokenFloorStage < 2)
			{
				if (mbBrokenFloor_FirstHint == false)
				{
					if (mlBrokenFloor_ContactCount > 1)
					{
						cLux_AddDebugMessage("h1");
						mbBrokenFloor_FirstHint = true;
						++mlBrokenFloorHintsGiven;
						Sketchbook_AddIdea("break_floor");
						Voice_PlayDelayed("Dialogue_WeakFloor", 0.5);
						Map_AddTimer("BrokenFloorHint", 12, "");
					}
				}
				else if (Map_TimerExists("BrokenFloorHint") == false || mlBrokenFloor_JumpCount == 4)
				{
					Map_RemoveTimer("BrokenFloorHint");
					if (mlBrokenFloor_JumpCount < 4)
					{
						cLux_AddDebugMessage("h2");
						++mlBrokenFloorHintsGiven;
						Voice_PlayDelayed("Dialogue_WeakFloor", 0.5);
						Map_AddTimer("BrokenFloorHint", 12, "");
					}
					else if (bJump && mlBrokenFloor_JumpCount == 4 && mlBrokenFloorStage == 0)
					{
						cLux_AddDebugMessage("h3");
						++mlBrokenFloorHintsGiven;
						CancelGrateScare2();
						Voice_Stop("Comments");
						Voice_PlayDelayed("Dialogue_JumpOnFloor", 0.5);
						Map_AddTimer("BrokenFloorHint", 10, "");
					}
					else if (bJump && fTimeSinceLastJump < 2.5)
					{
						cLux_AddDebugMessage("h4");
						++mlBrokenFloorHintsGiven;
						Voice_PlayDelayed("Dialogue_JumpOnFloor", 0.5);
						++mlBrokenFloor_JumpOnFloorHints;
						if (mlBrokenFloor_JumpOnFloorHints == 4) mlBrokenFloor_JumpCountAtLastHint = mlBrokenFloor_JumpCount;
						Map_AddTimer("BrokenFloorHint", 10, "");
					}
				}
			}
			
			if (lPrevHintsGiven == 1 && mlBrokenFloorHintsGiven == 2)
			{
				Map_AddTimer("Timer_EnableGrateScare", 4, "OnTimer_EnableGrateScare");
			}
			
			//////////////
			// effects
			if (bJump)
			{
				if (mlBrokenFloorStage == 0 && mlBrokenFloor_JumpCount == 4)
				{
					PartialFloorBreak();
					Sound_CreateAtEntity("FloorPartialBreak", "02_04_living_quarters/floor_plank/floor_plank_splinter", asParent);
				}
				else if (mlBrokenFloor_JumpCount >= 50 || (mlBrokenFloor_JumpCountAtLastHint >= 0 && mlBrokenFloor_JumpCount >= mlBrokenFloor_JumpCountAtLastHint + 6))
				{
					OnTimer_BreakFloor("");
				}
				Sound_CreateAtEntity("FloorCreak", "02_04_living_quarters/floor_plank/floor_plank_creak", asParent);
			}
			else
			{
				Sound_CreateAtEntity("FloorCreak", "02_04_living_quarters/floor_plank/floor_plank_creak", asParent);
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void PartialFloorBreak()
		{
			if (mlBrokenFloorStage != 0) return;
			Sketchbook_AddIdea("break_floor");
			mlBrokenFloorStage = 1;
			Entity_SetActive("BrokenFloor_Before*", false);
			Entity_SetActive("BrokenFloor_PartiallyBroken*", true);
			ParticleSystem_CreateAtEntity("BreakFloorPartialParticles", "02_04_cannon_floor_partial_break", "Target_BreakFloorParticles", false);
			Sound_CreateAtEntity("FloorPartialBreak", "02_04_living_quarters/floor_plank/floor_plank_splinter", "Target_BreakFloorParticles", 0, false, 1, 3, 15);
			Effect_Shake_Start(0.04, 0.5, 0, 0);
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Walk on the CREAKY FLOOR*
		
		/////////////////////////////////////////
		// Event A *Find the broken CANNON*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlSecondFloorExplorationAreas = 0;
		bool mbLookedAtCannon = false;
		bool mbLookAtCannonHints = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_BrokenCannon(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			
			if (mbLookedAtCannon == false)
			{
				mbLookedAtCannon = true;
				Map_AddTimer("Timer_ActivateCannonHighlightArea", 30, "OnTimer_ActivateCannonHighlightArea");
			}
			
			if (mbLookAtCannonHints)
			{
				Voice_Play("Dialogue_Cannon_Reminder");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateCannonHighlightArea(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_CannonHighlightArea", true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_CannonHighlightArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			SetCannonHighlightActive(alState == 1);
			return true;
		}
		
		//-------------------------------------------------------
		
		void SetCannonHighlightActive(bool abX, bool abFade = true)
		{
			float fFadeTime = abFade ? 1.5f : 0.0f;
			if (abX)
			{
				Light_FadeBrightnessToDefault("Cannon_highlight_1", fFadeTime);
				Light_FadeBrightnessToDefault("Cannon_highlight_2", fFadeTime);
				Light_FadeBrightnessToDefault("Cannon_highlight_3*", fFadeTime);
			}
			else
			{
				Light_FadeBrightnessTo("Cannon_highlight_1", 0.1, fFadeTime);
				Light_FadeBrightnessTo("Cannon_highlight_2", 0.06, fFadeTime);
				Light_FadeBrightnessTo("Cannon_highlight_3*", 0.03, fFadeTime);
			}
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_CannonStuckDialogue(const tString &in asEntity, int alState)
		{
			Entity_SetActive("Trigger_CannonStuckDialogue*", false);
			if (mlCannon_WheelsAttachedCount == 0) Voice_Play("Dialogue_Cannon_NeedsTwoWheels");
			else if (mlCannon_WheelsAttachedCount == 1) Voice_Play("Dialogue_Cannon_NeedsAWheel");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SecondFloorExploration(const tString &in asParent, const tString &in asChild, int alState)
		{
			++mlSecondFloorExplorationAreas;
			if (mlSecondFloorExplorationAreas >= 5)
			{
				Map_AddTimer("Timer_EnableCannonHints", 480, "OnTimer_EnableCannonHints");
			}
			Entity_SetActive(asParent, false);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableCannonHints(const tString &in asTimer)
		{
			mbLookAtCannonHints = true;
		}
		
		//-------------------------------------------------------
		
		//} END Event *Find the broken CANNON*
		
		/////////////////////////////////////////
		// Event A *Fix the CANNON and use it to break the CREAKY FLOOR*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msBreakFloor_CannonBroken = "Cannon_Broken";
		tString msBreakFloor_CannonFixed = "Cannon_Fixed";
		tString msBreakFloor_CannonFixedNoSlider = "Cannon_FixedNoSlider";
		tString msBreakFloor_CannonBrokenPropUp = "Cannon_PropUp";
		tString msBreakFloor_ThrowArmTrigger = "Trigger_BrokenFloorThrowArm";
		tString msBrokenFloor_Arm = "BreakFloor_Arm";
		
		float mlCannon_WheelsAttachedCount = 0;
		tString msCannon_ForceTarget = "";
		
		bool mbOverrideMoveSpeedMul = false;
		float mfFadeMoveSpeedTarget = 0.0f;
		float mfCurrentMoveSpeedMul = 1.0f;
		bool mbCannonAnimSlowdown = false;
		float mfCannonAnimSpeed = 2.25f;
		cVector3f mvCannonPrevPos;
		
		bool mbBrokenFloor_CanPlayPropUpDialogue = true;
		bool mbBrokenFloor_FixedCannon = false;
		bool mbBrokenFloor_PartiallyBroken = false;
		bool mbBrokenFloor_InsidePlayerStumbleArea = false;
		bool mbCannon_MoveSuccessSoundTried = false;
		array<tID> mvBrokenFloor_AttachedWheels;
		bool mbBrokenFloor_CannonCrashed = false;
		bool mbBrokenFloor_CannonBrokeFloor = false;
				
		//-------------------------------------------------------
		
		void InitCannon()
		{
//			Map_AddTimer("Timer_SetCannonStickyAreas", 2.0f, "OnTimer_SetCannonStickyAreas");
			
			// front pin stickies
			{
				Entity_AttachToSocket("Sticky_FinalCannonWheel_1", "Cannon_Broken", "socket_wheel_left_front", true, true);
				iLuxEntity@ pSticky = Map_GetEntity("Sticky_CannonWheel_1");
				cMatrixf mtxNew = Map_GetEntity("Cannon_Broken").GetMeshEntity().GetSocket("socket_wheel_left_front").GetWorldMatrix();
				mtxNew.SetTranslation(mtxNew.GetTranslation() + mtxNew.GetForward() * 0.25);
				pSticky.SetMatrix(mtxNew);
				Entity_AttachToEntity("Sticky_CannonWheel_1", "Cannon_Broken", "", true);
			}
			
			// back pin stickies
			{
				Entity_AttachToSocket("Sticky_FinalCannonWheel_2", "Cannon_Broken", "socket_wheel_left_back", true, true);
				iLuxEntity@ pSticky = Map_GetEntity("Sticky_CannonWheel_2");
				cMatrixf mtxNew = Map_GetEntity("Cannon_Broken").GetMeshEntity().GetSocket("socket_wheel_left_back").GetWorldMatrix();
				mtxNew.SetTranslation(mtxNew.GetTranslation() + mtxNew.GetForward() * 0.25);
				pSticky.SetMatrix(mtxNew);
				Entity_AttachToEntity("Sticky_CannonWheel_2", "Cannon_Broken", "", true);
			}
			
			SetCannonHighlightActive(false, false);
		}
		
		//-------------------------------------------------------
		
		void UpdateCannon(float afTimeStep)
		{
			if (mbOverrideMoveSpeedMul)
			{
				mfCurrentMoveSpeedMul = cMath_IncreaseTo(mfCurrentMoveSpeedMul, 1.0f * afTimeStep, mfFadeMoveSpeedTarget);
				cLux_GetPlayer().GetCharacterBody().SetMoveSpeedMul(eCharDir_Forward, mfCurrentMoveSpeedMul);
			}
			
			if (mbCannonAnimSlowdown)
			{
				mfCannonAnimSpeed -= 1.5f * afTimeStep;
				if (mfCannonAnimSpeed <= 1.0f)
				{
					mfCannonAnimSpeed = 1.0f;
					mbCannonAnimSlowdown = false;
				}
				iLuxEntity@ pCannon = Map_GetEntity("Cannon_Fixed");
				if (pCannon.GetCurrentAnimationState() !is null)
				{
					pCannon.GetCurrentAnimationState().SetSpeed(mfCannonAnimSpeed);
				}
			}
		}
		
		//-------------------------------------------------------

		void OnInteract_PushCannon(const tString &in asEntity)
		{
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
			
			Entity_AddImpulse("Cannon_PropUp", cVector3f(0, 0, 1) * 0.5, true, true);
			Map_AddTimer("Timer_PropUpBackwardsImpulse", 0.15, "OnTimer_PropUpBackwardsImpulse");
						
			if (mbBrokenFloor_FixedCannon)
			{
				Voice_Play("Dialogue_Cannon_MovingEffort");
				Voice_PlayWhenPossible("Dialogue_Cannon_MovingSuccess", "VoiceCondition_CannonSuccess", 4, 0);
			}
			else
			{
				Sound_CreateAtEntity("CannonPush", "02_04_living_quarters/floor_plank/floor_plank_creak", "Cannon_Broken");
				Voice_Play("Dialogue_Cannon_Stuck");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PropUpBackwardsImpulse(const tString &in asTimer)
		{
			Entity_AddImpulse("Cannon_PropUp", cVector3f(0, 0, 1) * -0.5, true, true);
		}
		
		//-------------------------------------------------------
		
		bool VoiceCondition_CannonSuccess(const tString& in asSubject)
		{
			return Entity_IsInteractedWith(msBreakFloor_CannonFixed);
		}
	
		//-------------------------------------------------------
		
		void OnInteract_CannonPropUpDialogue(const tString &in asEntity)
		{
			if (mbBrokenFloor_FixedCannon) return;
			if (mbBrokenFloor_CanPlayPropUpDialogue == false) return;
			mbBrokenFloor_CanPlayPropUpDialogue = false;
			Map_AddTimer("Timer_CannonPropUpDialogue", 0.0f, "OnTimer_CannonPropUpDialogue");
			Map_AddTimer("Timer_CannonPropUpDialogueCooldown", 10.0f, "OnTimer_CannonPropUpDialogueCooldown");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CannonPropUpDialogue(const tString &in asTimer)
		{
			Voice_Play("Dialogue_Cannon_StoneStuck");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CannonPropUpDialogueCooldown(const tString &in asTimer)
		{
			mbBrokenFloor_CanPlayPropUpDialogue = true;
		}
		
		//-------------------------------------------------------
		
		bool Sticky_CannonWheel_1_Attach(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Cannon_AttachWheel(Body_GetEntityName(asBodyName), asStickyArea);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool Sticky_CannonWheel_2_Attach(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Cannon_AttachWheel(Body_GetEntityName(asBodyName), asStickyArea);
			return true;
		}
		
		//-------------------------------------------------------
		
		void Cannon_AttachWheel(const tString &in asEntity, const tString &in asSticky)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asEntity);
			pEnt.GetMainBody().SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-cannon_broken"));
			mvBrokenFloor_AttachedWheels.push_back(pEnt.GetID());
			
			Map_AddTimer(asSticky, 0.6f, "OnTimer_SwitchCannonWheelSticky");
			Map_SetTimerUserVarString(asSticky, pEnt.GetName());
			Map_AddTimer(pEnt.GetName(), 0.8f, "OnTimer_CannonWheelAttachSound");
			Map_AddTimer(pEnt.GetName(), 1.0f, "OnTimer_DeactivateCannonWheel");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SwitchCannonWheelSticky(const tString &in asTimer)
		{
			int lIndex = cString_GetNumericSuffixInt(asTimer, -1);
			tString sFinalSticky = "Sticky_FinalCannonWheel_" + lIndex;
			StickyArea_Detach(asTimer);
			Entity_SetActive(asTimer, false);
			Entity_SetActive(sFinalSticky, true);
			StickyArea_AttachEntity(sFinalSticky, Map_GetTimerUserVarString(asTimer), "");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CannonWheelAttachSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("CannonWheelAttach", "03_05_vitae_station/fairchild/torture_rack/fairchild_wheel_resume", asTimer);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivateCannonWheel(const tString &in asTimer)
		{
			mlCannon_WheelsAttachedCount++;
			if (mlCannon_WheelsAttachedCount == 2)
			{
				Entity_SetActive("Trigger_CannonStuckDialogue_*", false);
				
				mbBrokenFloor_FixedCannon = true;
				Map_AddTimer("Timer_PushCannonPropup", 0.1f, "OnTimer_PushCannonPropup");
				
				Map_AddTimer("Timer_CannonDrop", 0.4f, "OnTimer_CannonDrop");
				Map_AddTimer("Timer_CannonDropParticles", 0.4f, "OnTimer_CannonDropParticles");
				Map_AddTimer("Timer_CannonDropSound", 0.4f, "OnTimer_CannonDropSound");
				Map_AddTimer("Timer_ActivateFixedCannon", 0.7f, "OnTimer_ActivateFixedCannon");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PropUp_DropCannon(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1)
			{
				Map_AddTimer("Timer_CannonDrop", 0.0f, "OnTimer_CannonDrop");
				Map_AddTimer("Timer_CannonDropParticles", 0.0f, "OnTimer_CannonDropParticles");
				Map_AddTimer("Timer_CannonDropSound", 0.0f, "OnTimer_CannonDropSound");
				Map_AddTimer("Timer_ActivateFixedCannon", 0.3f, "OnTimer_ActivateFixedCannon");
				Entity_SetActive("Trigger_DropCannon", false);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CannonDrop(const tString &in asTimer)
		{
			Entity_SetActive("Blocker_CanonPropUp", false);
			
			for (int i = 0; i < mvBrokenFloor_AttachedWheels.size(); ++i)
			{
				cLux_ID_Entity(mvBrokenFloor_AttachedWheels[i]).SetActive(false);
			}
			
			Entity_AlignBaseMatrix("Cannon_FixedNoSlider", "Cannon_Broken");
			Entity_SetActive("Cannon_FixedNoSlider", true);
			Entity_SetActive("Cannon_Broken", false);
			
			// check area beneath wheels and disable collision on objects
			cLuxArea@ pArea = cLux_ToArea(Map_GetEntity("Trigger_CannonDropAABB"));
			cBoundingVolume@ pVolume = pArea.GetMainBody().GetBoundingVolume();
			array<iPhysicsBody@> vBodies;
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(pVolume.GetMin(), pVolume.GetMax(), vBodies);
			for (int i = 0; i < vBodies.size(); ++i)
			{
				iPhysicsBody@ pBody = vBodies[i];
				if (pBody is null) continue;
				if (pBody.IsActive() == false) continue;
				if (pBody.GetMass() == 0) continue;
				
				iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
				if (pEnt is null) continue;
				
				if (cLux_GetBodyEntity(pBody).GetEntityType() != eLuxEntityType_Prop) continue;
				if (cString_GetFirstStringPos(pEnt.GetName(), "Cannon") == 0) continue;
				
				cLux_AddDebugMessage("Disable cannon collision on: " + pEnt.GetName());
				pBody.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-cannon"));
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PushCannonPropup(const tString &in asTimer)
		{
			Sound_CreateAtEntity("PushPropUp", "level_entity_shared/button/pressure_plate/pressure_plate_on", msBreakFloor_CannonBrokenPropUp);
			
			iLuxEntity@ pPropUp = Map_GetEntity("Cannon_PropUp");
			pPropUp.SetActive(false);
			
			iLuxEntity@ pPropUpGrab = Map_GetEntity("Cannon_PropUpGrab");
			pPropUpGrab.SetMatrix(pPropUp.GetMatrix());
			pPropUpGrab.SetActive(true);
			
			Entity_AddImpulse("Cannon_PropUpGrab", cVector3f(0.0f, 0.0f, -1.0f) * 1.7f, false, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CannonDropParticles(const tString &in asTimer)
		{
			ParticleSystem_CreateAtEntity("CannonDrop", "dust_impact_simple_oneshot", "Target_CannonDropParticles", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CannonDropSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("CannonLower", "02_04_living_quarters/cannon/cannon_lower_temp", "Target_CannonDropParticles");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateFixedCannon(const tString &in asTimer)
		{
			Entity_AlignBaseMatrix("Cannon_Fixed", "Cannon_FixedNoSlider");
			Entity_SetActive("Cannon_Fixed", true);
			Entity_SetActive("Cannon_FixedNoSlider", false);
			
			Entity_SetActive("trigger_floor_break_1", true);
			Entity_SetActive("Trigger_ChangeForceTarget", true);
			Entity_SetActive("Trigger_CannonDisableSlider", true);
			Entity_SetActive("Trigger_CannonBrokenThrough", true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_CannonPlayerSlowdown(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_CheckCannonPlayerSlowdown", 0.0f, "OnTimer_CheckCannonPlayerSlowdown");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckCannonPlayerSlowdown");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckCannonPlayerSlowdown(const tString &in asTimer)
		{
			cVector3f vVel = Player_GetVelocity();
			vVel.y = 0;
			if (vVel.Length() >= 1.5f && Entity_IsInteractedWith(msBreakFloor_CannonFixed))
			{
				mbOverrideMoveSpeedMul = true;
				Player_FadeMoveSpeedMulTo(0.4f, 0.2f);
				Player_FadeRunSpeedMulTo(0.0f, 0.2f);
				mfFadeMoveSpeedTarget = 0.3f;
				
				Entity_SetActive("Trigger_CannonPlayerSlowdown", false);
				
				Map_AddTimer("Timer_Cannon_ApplyForce", 0.0f, "OnTimer_Cannon_ApplyForce");
				Entity_SetInteractionDisabled(msBreakFloor_CannonFixed, true);
				return;
			}
			Map_AddTimer("Timer_CheckCannonPlayerSlowdown", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CheckCannonPlayerSlowdown");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_AreaCannonStumble(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbBrokenFloor_InsidePlayerStumbleArea = alState == 1;
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Cannon_DisableSlider(const tString &in asParent, const tString &in asChild, int alState)
		{
			Cannon_PlayFallAnim();
			
			if (mbBrokenFloor_InsidePlayerStumbleArea)
			{
				mbBrokenFloor_CannonBrokeFloor = mlBrokenFloorStage < 2;
				
				Item_PutAway(eItemHandlerHand_Left);
				Item_PutAway(eItemHandlerHand_Right);
				Player_SetCrouching(false, true, true);
				Player_ChangeStateToNormal();
				
				PlayerBody_PlayCutsceneAtEntity("cannon_stumble", "Target_CannonStumbleAnim", false, 0.5f, "OnAnimationEnd_FloorBroken");
				Map_AddTimer("Timer_CannonPushVoice", 0.0f, "OnTimer_CannonPushVoice");
			}
			
			Map_AddTimer("Timer_BreakFloor", 1.2f, "OnTimer_BreakFloor");
			Map_AddTimer("Timer_Cannon_ResetPlayerSpeed", 2.0f, "OnTimer_Cannon_ResetPlayerSpeed");
			Map_AddTimer("OnTimer_Cannon_FinalResetPlayerSpeed", 3.0f, "OnTimer_Cannon_FinalResetPlayerSpeed");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnAnimationEnd_FloorBroken(const tString &in asAnimName)
		{
			if (mbBrokenFloor_CannonBrokeFloor) Voice_PlayDelayed("Dialogue_Cannon_FloorBroken", 0.5);
		}
		
		//-------------------------------------------------------
		
		void Cannon_PlayFallAnim()
		{
			mbBrokenFloor_CannonCrashed = true;
			
			Prop_SetStaticPhysics("Cannon_Fixed", true);
			cScript_SetGlobalArgBool(0, false);
			cScript_RunGlobalFunc("Cannon_Fixed", "", "_Global_SetPlayLoopAnim");
			Entity_PlayAnimation("Cannon_Fixed", "arabic_cannon_fall_through_floor", 0, false, false, "OnAnimationOver_CannonFloorBreak");
			
			Effect_Shake_Start(0.02, 3.5, 0.7, 1.0);
			
			if (mlBrokenFloorStage < 2) Sound_Play("Sound_CannonFloor", 0.0f);
			Sound_Play("Sound_CannonCrash", 0.0f);
			Sound_CreateAtEntity("Sound_CannonStairs", "02_04_living_quarters/cannon/cannon_stair_descend", "Cannon_Fixed");
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_CannonFloorBreak(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive(msBreakFloor_CannonFixed, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CannonPushVoice(const tString &in asTimer)
		{
			Sound_CreateAtEntity("PushRelease", "player/vocalisations/actions/player_push_release", "player");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Cannon_FinalResetPlayerSpeed(const tString &in asTimer)
		{
			mbOverrideMoveSpeedMul = false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Cannon_ResetPlayerSpeed(const tString &in asTimer)
		{
			Player_FadeMoveSpeedMulTo(1.0f, 4.0f);
			Player_FadeRunSpeedMulTo(1.0f, 4.0f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Cannon_ChangeForceTarget(const tString &in asParent, const tString &in asChild, int alState)
		{
			msCannon_ForceTarget = "Target_CannonForce_2";
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Cannon_ApplyForce(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity(msBreakFloor_CannonFixed);
			if (pEnt is null) return;
			cVector3f vForceDir = Map_GetEntity(msCannon_ForceTarget).GetPosition() - pEnt.GetPosition();
			vForceDir.Normalize();
			
			float fForceAmount = 500.0f;
			if (msCannon_ForceTarget == "Target_CannonForce_2") fForceAmount = 1000.0f;
			if (msCannon_ForceTarget == "Target_CannonForce_3") fForceAmount = 4000.0f;
			
			pEnt.GetMainBody().AddForceAtPosition(vForceDir * fForceAmount, pEnt.GetPosition() + cVector3f(2.6f, 0.43f, 0.0f));
			Map_AddTimer("Timer_Cannon_ApplyForce", 0.2f, "OnTimer_Cannon_ApplyForce");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Cannon_FloorBreak(const tString &in asParent, const tString &in asChild, int alState)
		{
			OnTimer_BreakFloor("");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakFloor(const tString &in asTimer)
		{
			if (mlBrokenFloorStage >= 2) return;
			mlBrokenFloorStage = 2;
			
			Sketchbook_CompleteIdea("break_floor");
			ParticleSystem_CreateAtEntity("BreakFloorParticles", "02_04_cannon_floor_full_break", "Target_BreakFloorParticles", false);
			Map_AddTimer("Timer_BreakFloorSwitchEntities", 0.15f, "OnTimer_BreakFloorSwitchEntities");
			
			Entity_SetActive("Trigger_LookTowardsMapRoom*", false);
			
			Effect_Rumble_Start(1, 1.25);
			
			if (mbBrokenFloor_CannonCrashed == false)
			{
				Sound_CreateAtEntity("FloorBreak", "02_04_living_quarters/cannon/cannon_floor_break_solo", "Target_BreakFloorParticles");
				Sound_CreateAtEntity("FloorBreakDebris", "02_04_living_quarters/cannon/cannon_floor_debris_solo", "Target_BreakFloorParticles");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BreakFloorSwitchEntities(const tString &in asTimer)
		{
			Entity_SetActive("BrokenFloor_PartiallyBroken*", false);
			Entity_SetActive("BrokenFloor_Before*", false);
			Entity_SetActive("BrokenFloor_After*", true);
			Entity_SetActive("BrokenFloor_AfterHide*", false);
			
			Entity_SetActive("Trigger_BrokenFloorCreak_1", false);
			Entity_SetActive("Trigger_BrokenFloorCreak_2", false);
			Entity_SetActive("Trigger_BrokenFloorCreak_3", false);
			
			if (mbBrokenFloor_CannonCrashed)
			{
				Entity_SetActive("BrokenFloor_CannonCrashed*", true);
			}
		}

		//-------------------------------------------------------
		
		bool OnCollide_Cannon_BrokenThrough(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive(msBreakFloor_CannonFixed, false);
			Map_RemoveTimer("Timer_Cannon_ApplyForce");
			return false;
		}

		//-------------------------------------------------------
		
		void OnLookAt_RandomReactionsDialogue(const tString &in asEntity, int alState)
		{
			Entity_SetActive("Trigger_RandomReactionsDialogue*", false);
			Voice_Play("Dialogue_NailedUpSoldier");
		}
		
		//-------------------------------------------------------

		//} END Event A *Fix the CANNON and use it to break the CREAKY FLOOR*
		
		/////////////////////////////////////////
		// Event A *Break the CREAKY FLOOR by stacking heavy objects*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void OnTimer_CheckBrokenFloorWeight(const tString &in asTimer)
		{
			Map_RestartCurrentTimer(cMath_RandRectf(0.1, 0.3));
			
			if (Player_GetDistanceToEntitySquared("Trigger_BrokenFloorDetector") > 15 * 15) return;

			cBoundingVolume@ pVolume = Map_GetEntity("Trigger_BrokenFloorDetector").GetMainBody().GetBoundingVolume();
			array<iPhysicsBody@> vBodies;
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(pVolume.GetMin(), pVolume.GetMax(), vBodies);
			
			int lHeavyObjects = 0;
			for (int i = 0; i < vBodies.size(); ++i)
			{
				iPhysicsBody@ pBody = vBodies[i];
				if (pBody is null) continue;
				if (pBody.GetMass() < 10) continue;
				if (pBody.IsActive() == false) continue;
				
				iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
				if (pEnt is null) continue;
				if (IsBrokenFloorHeavyObject(pEnt.GetName()) == false) continue;
				++lHeavyObjects;
				
				if (lHeavyObjects >= 1)
				{
					PartialFloorBreak();
				}
				
				if (lHeavyObjects >= 3)
				{
					OnTimer_BreakFloor("");
					return;
				}
			}
		}
		
		//-------------------------------------------------------
		
		bool IsBrokenFloorHeavyObject(const tString &in asEnt)
		{
			if (cString_GetFirstStringPos(asEnt, "storage_barrel") >= 0) return true;
			if (cString_GetFirstStringPos(asEnt, "french_vase") >= 0) return true;
			if (cString_GetFirstStringPos(asEnt, "storage_box") >= 0) return true;
			if (cString_GetFirstStringPos(asEnt, "storage_sack") >= 0) return true;
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Break the CREAKY FLOOR by stacking heavy objects*

	//} END SCENE 3
	
