	void SetFirstFloorPropsActive(bool abX, bool abSetup = false)
	{
		cLux_AddDebugMessage("FIRST FLOOR: " + abX);
		SetAABBPropsActive("Trigger_FirstFloorAABB", abX, abSetup);
