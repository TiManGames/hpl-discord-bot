	void Sound_CreateAtEntityCustom(const tString &in asName, const tString &in asFile, const tString &in asEntity, float afMaxDist = 2, float afMinDist = 10)
	{
		Sound_CreateAtEntity(asName, asFile, asEntity);
		cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().GetSoundEntity(asName);
		pSound.SetCustomMaxDistance(afMaxDist);
		pSound.SetCustomMinDistance(afMinDist);
		pSound.SetUseCustomProperties(true);
	}
	
	//-------------------------------------------------------
	
	void InitSafeRooms()
	{
		Entity_AttachToEntity("InteractAux_DoorLock_Corporal", "SafeRoomDoor_Corporal", "Body_3", true);
		SwingDoor_SetOpenAmount("SafeRoomDoor_Corporal", 0.5f);
		
		Entity_AttachToEntity("InteractAux_DoorLock_ArabStorage", "SafeRoomDoor_ArabStorage", "Body_3", true);
		SwingDoor_SetOpenAmount("SafeRoomDoor_ArabStorage", 0.25f);
	}
	
	//-------------------------------------------------------
	
	bool OnCollide_SafeRoomDoorClosed(const tString &in asParent, const tString &in asChild, int alState)
	{
		tString sLock = "DoorLock_" + Entity_GetVarString(asChild, "");
		bool bLocked = Entity_GetVarBool(sLock, "SafeRoomLocked");
		if (bLocked) return true;
		
		bool bClosed = alState == 1;
		Entity_SetVarBool(asChild, "SafeRoomDoorClosed", bClosed);
		Slide_AutoMoveTo(sLock, 0);
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnConnectionStateChange_SafeRoomLock(const tString &in asEntity, int alState)
	{
		tString sDoor = "SafeRoomDoor_" + Entity_GetVarString(asEntity, "");
		bool bClosed = Entity_GetVarBool(sDoor, "SafeRoomDoorClosed");
		if (bClosed == false) return;
		
		bool bLocked = alState == 1;
		Entity_SetVarBool(asEntity, "SafeRoomLocked", bLocked);
		SwingDoor_SetBlocked(sDoor, bLocked, true);
		
		FearArea_SetLocked("Fear_Safe" + Entity_GetVarString(asEntity, ""), bLocked);
		
		if (bLocked) StopSecondFloorNoises();
		else if (mbSecondFloorScares_Active) StartSecondFloorNoises();
	}
	
