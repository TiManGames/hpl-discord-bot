	cSequenceStatesData mSequenceGhoulStruggleTest;
		
	void Seq_GhoulStruggleTest(const tString &in asTimer)
	{
		Sequence_Begin("Seq_GhoulStruggleTest", mSequenceGhoulStruggleTest);
		if (Sequence_DoStepAndWait(0))
		{
			Entity_SetActive("Ghoul_RigidTest", true);
			Entity_PlaceAtEntity("Ghoul_RigidTest", "Trigger_1", cVector3f_Zero, true, true);
			Entity_PlayAnimation("Ghoul_RigidTest", "ghoul_struggle_lift_up", 0, false);
			
			PlayerBody_PlayCutsceneAtEntity("player_ghoul_struggle_lift_up", "Trigger_2", false, 0, "OnAnimationEnd_GhoulStruggleTest2");
		}
		else if (Sequence_DoStepAndWait(0))
		{
		}
		Sequence_End();
	}
	
	void OnAnimationEnd_GhoulStruggleTest2(const tString &in asAnimName)
	{
		Entity_PlayAnimation("Ghoul_RigidTest", "ghoul_struggle_hold_idle", 0, true);
		PlayerBody_PlayCutsceneAtEntity("player_ghoul_struggle_hold_idle", "Trigger_2", true, 0);
	}
	
	//-------------------------------------------------------
	
	bool mbCheckPhysics = true;
	int mlCheckPhysicsCount = 0;
	int mlCheckPhysicsMovedCount = 0;
	array<tID> mvChechPhysicsEnts;
	array<cVector3f> mvCheckPhysicsEntPos;
	
	bool mbNewElevator = false;
	float mfNewElevatorValue = 0;
	void VariableUpdate(float afTimeStep)
	{
		if (gbCheckPropPositionsOnLoad && mbCheckPhysics)
		{
			++mlCheckPhysicsCount;
			if (mlCheckPhysicsCount == 1)
			{
				array<iLuxEntity@> vEnts;
				Map_GetEntityArray("*", vEnts, eLuxEntityType_Prop);
				for (int i = 0; i < vEnts.size(); ++i)
				{
					iLuxEntity@ pEnt = vEnts[i];
					mvChechPhysicsEnts.push_back(pEnt.GetID());
					mvCheckPhysicsEntPos.push_back(pEnt.GetPosition());
				}
			}
			else if (mlCheckPhysicsCount == 120)
			{
				for (int i = 0; i < mvChechPhysicsEnts.size(); ++i)
				{
					iLuxEntity@ pEnt = cLux_ID_Entity(mvChechPhysicsEnts[i]);
					float fDist = cMath_Vector3Dist(mvCheckPhysicsEntPos[i], pEnt.GetPosition());
					if (fDist > 0.001f)
					{
						++mlCheckPhysicsMovedCount;
						Log("ENTITY MOVED " + pEnt.GetName() + "\n");
						Debug_Log("ENTITY MOVED " + pEnt.GetName());
						
						Debug_DrawSphere(pEnt.GetPosition(), 0.1f, cColor_Red * 3, 9999);
//						Debug_DrawSphere(pEnt.GetPosition(), 0.25f, cColor_Red * 3, 9999);
						Debug_DrawSphere(pEnt.GetPosition(), 0.5f, cColor_Red * 3, 9999);
					}
				}
				Log("MOVED ENTITY COUNT: " + mlCheckPhysicsMovedCount + "\n");
				Debug_Log("MOVED ENTITY COUNT: " + mlCheckPhysicsMovedCount);
				mbCheckPhysics = false;
			}
		}
		
		UpdateSecondFloorScares(afTimeStep);
		UpdateCreepyEvents(afTimeStep);
		UpdateCannon(afTimeStep);
		UpdateElevator(afTimeStep);
		UpdateElevatorPlankCollision(afTimeStep);
	}
	
