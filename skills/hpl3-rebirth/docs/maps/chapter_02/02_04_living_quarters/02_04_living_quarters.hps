		{
			AddScareFear(0.5f, 3.0f, false, 2.0f, 0.1f, 0.5f);
			Voice_Play("Dialogue_WebbsHead");
			Music_Play("A2_2_4_Falling_Head.ogg", 0.6f, false, eMusicPrio_BigEvent);
		}
		
