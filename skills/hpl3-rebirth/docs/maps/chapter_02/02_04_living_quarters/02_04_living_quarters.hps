		bool mbWebbHead_PlayedFlashback = false;

		//-------------------------------------------------------

		bool OnCollideTrigger_ThrowHead(const tString &in asParent, const tString &in asChild, int alState)
		{
			iLuxEntity@ pEnt = Map_GetEntity(msProp_WebbHead);
			Entity_SetActive(msProp_WebbHead, true);
			
			cVector3f vThrowDir = Map_GetEntity("Target_WebbHeadThrow").GetPosition() - pEnt.GetPosition();
			vThrowDir.Normalize();
			
			Entity_AddImpulse(msProp_WebbHead, vThrowDir * 10.0f, false, false);
						
			Map_AddTimer("Timer_PlayWorkshopStairsSound", 3.0f, "OnTimer_PlayWorkshopStairsSound");
			
			return false;
		}

		//-------------------------------------------------------
		
