	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	bool mbHadAlreadyAnsweredRadio = false;
	
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("02-04-living-quarters");
		
		// Reset effects
		Effect_Bloom_FadeBrightPass(0.3f, 3);
        Effect_Bloom_FadeBloomWidth(128, 1);
        Effect_Bloom_FadeBloomFalloff(1.5f, 2);
        Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		// Set up color grading etc.
		Pregnancy_SetStage(ePregStage_Stage1);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_CavesToCisternStart);
		Pregnancy_SetBabyKicksEnabled(false);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_Ill);
		Player_SetAllowCheckBaby(true);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(0);
		StruggleFlashHandler_SetProgression(0);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("02_04_lq_impact_above.ps");
		ParticleSystem_Preload("sand_falling_stream_small_oneshot_instant.ps");
		ParticleSystem_Preload("dust_impact_simple_oneshot.ps");
		ParticleSystem_Preload("02_04_cannon_floor_full_break.ps");
		ParticleSystem_Preload("02_04_cannon_floor_partial_break.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		Sound_PreloadGroup("02_04_living_quarters/cannon", true);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{	
		}
		
//		Sketchbook_AddIdea("get_radio");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		Game_AutoSave();
		
		//PlayerBody_SetModel("player.ent");
		Hint_AddAsGiven("Hints", "HintFear");
		
		PlayerBody_SetActive(true);
        Heat_SetActive(false);
		Player_SetAutoTeleportWhenBelowAltitude(3.5);
		
		if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio"))
		{
			mbHadAlreadyAnsweredRadio = true;
			FearHandler_SetWhisperStage(eFearWhisperStage_RadioToBabyKick);
		}
		else
		{
			mbHadAlreadyAnsweredRadio = false;
			FearHandler_SetWhisperStage(eFearWhisperStage_SalimToRadio);
			Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_Initial");
		}
		
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(4);
		
		/////////////////////////
		// Inventory
		if (cLux_ScriptDebugOn())
		{
			Item_AddToInventory("ElevatorWinch", false);
			Item_AddToInventory("HerbertOil");
			Item_SetContent(ItemType_GetFirstInInventory("HerbertOil"), "Oil", 10);
			Item_AddToInventory("Matchbook");
			Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
		}
		
		if (ItemType_IsInInventory("Lantern") == false)
		{
			Item_AddToInventory("Lantern");
			Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
		}
		
		/////////////////////////
		// System setup
		Lantern_SetBrightnessMul(0.7f, true);
		Player_SetMapDeepShadow(0.08f);
		Blackboard_SetDebugMode(false);
		FearHandler_SetPermaFailRespawnArea("PermaFail_Default");
		Player_SetNightVisionBrightness(1.3);
		FearHandler_SetPermaFailEnabled(true);
		FearHandler_SetAllowWarningHint(true);
		FearHandler_SetDefaultState(eFearAreaState_Unsafe);
		Blackboard_SetOverlookedAchievementDetectionActive(false);

		
		/////////////////////////
		// Init scenes
		InitBrokenFloor();
		InitCannon();
		InitElectricPowerSystem();
		InitSafeRooms();
		InitSecondFloorScares();
		InitCreepyEvents();
		InitElevator();
		InitWorkshop();
		InitRadio();
		
		/////////////////////////
		// Timers
		Map_AddTimer("Timer_CheckBrokenFloorWeight", 2.5, "OnTimer_CheckBrokenFloorWeight");
		Map_AddTimer("Timer_StartElevatorPlankCollisionUpdate", 2.2, "OnTimer_StartElevatorPlankCollisionUpdate");
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio"))
		{
			cScript_SetGlobalVarBool("Outpost_LQ_FirstTripComplete", true);
			Entity_SetActive("Ghoul_Workshop", false);
		}
		mbReturnTripActive = false;
	}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource)
	{
	}

	//-------------------------------------------------------
	
	void OnPlayerDead(int aType, const tString&in asSource)
	{
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("DEAD : SOURCE = " + asSource);
		if (asSource == "SomeSourceHere")
        {
            // do something
			return true; // this will override default behaviour
        }	
		
		// return false for default behaviour
		return false;
	}

	//-------------------------------------------------------
	
	bool OnPermaFail(const tString &in asSource)
	{
		Player_SetMoveSpeedMul(1);
		
		tString sRespawn = FearHandler_GetPermFailRespawnArea();
		if (mbFirstEncounter_Started)
		{
			mbFirstEncounter_PlayerPermaFailed = true;
			Entity_SetActive("Ghoul_Workshop", false);
			Entity_SetActive("Trigger_ExitWorkshop", false);
			AddScareFear(0);
			Music_StopAll(2);
		}
		
		if (asSource == "Ghoul_ReturnTrip_2")
		{
			Entity_SetActive("Ghoul_ReturnTrip_2", false);
		}
		
		if (asSource == "Ghoul_ReturnTrip_1")
		{
			Entity_SetActive("Ghoul_ReturnTrip_1", false);
		}
		
		FearHandler_ClearPermaFailScenes();
		SetupGenericPermaFail();
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFailRespawn()
	{
		if (FearHandler_GetPermFailRespawnArea() == "PermaFail_Default")
		{
			Player_SetForceNightVision(true);
			Map_AddTimer("Timer_DisableForcedNV", 20, "OnTimer_DisableForcedNV");
		}
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DisableForcedNV(const tString &in asTimer)
	{
		Player_SetForceNightVision(false);
	}
	
	//-------------------------------------------------------
	
	array<int> mvUnplayedGenericPermaFails = { 1, 2, 3 };
	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 3; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);
					
		tString sAreaBase = "Area_PermaFail_Generic";		
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_1", sAreaBase + "_1_End_1", 4.5f, 2.5f);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_3", sAreaBase + "_1_End_3", 5.f, 3);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_2", sAreaBase + "_1_End_2", 4.f, 2.f);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 3.f, 3.0f);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_2", sAreaBase + "_2_End_2", 5.f, 3.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_3", sAreaBase + "_2_End_3", 3.f, 2.5f);
				break;
			case 3:
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_1", sAreaBase + "_3_End_1", 3.5f, 2.75f);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_2", sAreaBase + "_3_End_2", 3.f, 2.f);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_3", sAreaBase + "_3_End_3", 4.f, 2);
				break;
		}
	}
	
	//-------------------------------------------------------

	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{
		// return false for default behaviour (fadeout and death area)
		return false;
	}
	
	//-------------------------------------------------------
	
	/////////////////////////////////
	// Timer to call a respawn of the player
	void TimerPlayerRespawn(const tString &in asTimer)
	{
		tString sDeathSource = asTimer;	// Passing the name of the entity via the timer, you may want to store in some other var.
		Death_Respawn();	// Pass on the death source in this helper
	}
	
	//-------------------------------------------------------
	
	int mfTest_BrokenFloorStageIndex = 0;
	bool mbTestBool = false;
	int mlTest = 0;
	int mlTest2 = 0;

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
	
		if(alAction == eAction_TestMinus)
		{
			FearHandler_FadeLevelTo(1.f, 1.f);
			AddScareFear(1.f, 5.f);
			return;
			Item_AddToInventory("Lantern");
			return;
			cLux_AddDebugMessage("A " + mlBrokenFloorStage);
			return;
//			Voice_Play("Dialogue_SeeExit");
//			return;
			iLuxEntity@ pEnt = Map_GetEntity("asdasdasd");
			pEnt.GetBody(0).GetJoint(0).Break();
			
			return;
//			Effect_ToneMapping_SetGradingTexture(eColorGradingPrio_WorldGradingTexturePrio, "fear_red", 0.0f);
			Effect_ToneMapping_FadeWorldGrading("fear_red", 1.0f);
			return;
			msBreakFloor_CannonFixed = "Cannon_Fixed_2";
			Cannon_PlayFallAnim();
			return;
			StickyArea_AttachEntity("Sticky_FinalCannonWheel_1", "Cannon_Wheel_5", "");
			return;
			cMatrixf mtxBrokenCannon = Map_GetEntity("Cannon_Broken").GetMatrix();
			cVector3f vTran = mtxBrokenCannon.GetTranslation();
			vTran += Map_GetEntity("Cannon_Broken").GetMatrix().GetTranspose().GetForward() * 0.0912f;
			vTran += Map_GetEntity("Cannon_Broken").GetMatrix().GetTranspose().GetUp() * 0.0431f;
			mtxBrokenCannon.SetTranslation(vTran);
			
			Entity_SetActive("Cannon_Broken", false);
			Entity_SetActive("Cannon_FixedNoSlider", true);
			
			Map_GetEntity("Cannon_FixedNoSlider").SetMatrix(mtxBrokenCannon);
		}
		
		if(alAction == eAction_TestPlus)
		{
			SwingDoor_SetOpenAmount("Door_WorkshopStorage", 0.7f);
			return;
			OnTimer_BreakFloor("");
			return;
			StartCreepyEvent_ImpactAbove();
			return;
			CornerGhoul_Start(2);
			return;
			StartGrateScare2();
			return;
			Lamp_SetLit("Lamp_HangingCreepy_2", false, true);
			return;
			Effect_Shake_Start(2.0f, 0.5f, 0.f, 1.f);
			return;
			Entity_FadeEffectBaseColor("Lamp_Electric_Radio_Room", cColor_White * 2, 1);
			return;
			Entity_SetActive("Lamp_HangingCreepy_3", false);
			iLuxEntity@ pEnt = Map_GetEntity("Lamp_HangingCreepy_3");
			
			iLuxEntity@ pEnt2 = Map_GetEntity("Lamp_HangingCreepy_8");
			pEnt2.SetMatrix(pEnt.GetMatrix());
			return;
			Sound_CreateAtEntity("BallistaSpark", "02_04_living_quarters/ghoul_scare_events/lightbulb", "Lamp_Ballista", 0, false, 1, 10, 50);
			return;
//			Entity_SetActive("Testaaa", true);
//			return;
			Sequence_GhoulChange1("");
			return;
			SetupBarrelKick();
			StartBarrelScare();
			return;
			float fTest = cMath_Modulus(-3.0, 10.0f);
			cLux_AddDebugMessage("OPA " + fTest);
			
			Map_GetEntity("dw_portalcage_suckeffect_rigid_1").GetBaseMaterial().SetUvAnimationSpeed(0, 1);
			return;
			Entity_SetActive("Ghoul_ScareTest", true);
			Entity_PlayAnimation("Ghoul_ScareTest", "crouch_idle_ledge", 0, false);
			Map_GetEntity("Ghoul_ScareTest").GetMeshEntity().GetAnimationStateFromName("scare_wall_grate_climb_down").SetPaused(true);
			return;
			if (mlTest == 0)
			{
				Map_GetEntity("ElevatorRope").GetBaseMaterial().SetUvAnimationSpeed(0, 0);
				cLux_AddDebugMessage("ROPE SPEED: " + 0);
			}
			else if (mlTest == 1)
			{
				Map_GetEntity("ElevatorRope").GetBaseMaterial().SetUvAnimationSpeed(0, 0.5);
				cLux_AddDebugMessage("ROPE SPEED: " + 0.5);
			}
			else if (mlTest == 2)
			{
				Map_GetEntity("ElevatorRope").GetBaseMaterial().SetUvAnimationSpeed(0, 1);
				cLux_AddDebugMessage("ROPE SPEED: " + 1);
			}
			mlTest++;
			mlTest %= 3;
			return;
			Slide_SetSlideAmount("DoorLock_Corporal", 1);
			return;
			Prop_SetStaticPhysics("ElevatorLid_Interact", true);
			return;
			SwingDoor_PushOpen("ElevatorLid_Interact", -10, 2, 0.2);
			Map_GetEntity("ElevatorLid_Interact").GetMainBody().SetCollide(false);
			return;
			cLux_AddDebugMessage("A " + Wheel_GetRotationAmount("ElevatorWinch"));
			return;
//			Wheel_SetMoveMaxSpeed("ElevatorWinch", 0);
			return;
			cLux_AddDebugMessage("A " + ItemType_IsInInventory("Lantern"));
			return;
			Entity_AddImpulse("Cannon_PropUp", cVector3f(0, 0, 1) * 1.5, true, true);
			return;
			++mfTest_BrokenFloorStageIndex;
			return;
			cLux_AddDebugMessage("HERE " + Slide_GetSlideAmount("TestLock"));
			return;
			Pregnancy_SetBabyTalkRoomSpecificSubject("BabyTalk_SafeRoom_Painting");
			return;
			CameraAnimation_Begin("CameraAnimation_RadioConversation", "", true);
			return;
			cVector3f vDiam = cLux_GetCurrentMap().GetPhysicsWorld().GetWorldSizeMax() - cLux_GetCurrentMap().GetPhysicsWorld().GetWorldSizeMin();
			cLux_AddDebugMessage("A " + vDiam.Length());
			return;
			StopRadioVoice();
			return;
			mbTestBool = !mbTestBool;
			SetPowerState(mbTestBool);
			return;
			Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
			return;
//			cLux_ChangeMap("02_02_courtyard.hpm", "Start_LQ_Front", "", "", "");
			return;
			OnInteract_PickupSaltPetre("");
			return;
			Effect_ToneMapping_FadeWorldGrading("grading_default", 1.0f);
			return;
			FearHandler_FadeRateMulTo(0.1f, 0.0f);
			return;
			mbNewElevator = true;
//			MoveObject_SetState("NewElevator_Part_1", 0.0f);
			return;
			FearHandler_FadeLevelTo(0.1, 1.5);
			return;
			cLux_AddDebugMessage("A" +cScript_GetGlobalVarBool("Outpost_AnsweredRadio"));
			return;
			cLux_AddDebugMessage("IT");
			Sketchbook_UnlockMemory("HereBefore", false);
			return;
			array<iLuxEntity@> vEnts;
			Map_GetEntityArray("*", vEnts);
			
			for (int i = 0; i < vEnts.size(); ++i)
			{
				iLuxEntity@ pEnt = vEnts[i];
				if (pEnt.IsSleeping() == false)
				{
					cLux_AddDebugMessage("" + i + " " + pEnt.GetName());
				}
			}
			
			return;
			FearHandler_AddProgressToken();
			FearHandler_FadeLevelTo(0.8f, 1.0f);
		}
		
		if(alAction == eAction_Test1)
		{
//			Player_Teleport("Start_Begin");
			cScript_SetGlobalVarBool("Outpost_AnsweredRadio", true);
			cScript_SetGlobalVarBool("Outpost_LQ_FirstTripComplete", true);
			OnCollide_Player_EnterEntrance("", "", 1);
//			OnCollide_Player_EnterReturnTripArea("", "", 1);
			return;
			Item_AddToInventory("ElevatorWinch", false);
		}
		
		if(alAction == eAction_Test2)
		{
//			Entity_SetActive("Ghoul_ReturnEntrance", true);
//			Entity_PlayAnimation("Ghoul_ReturnEntrance", "ghoul_radioRoom_door_waitIdle", 0, true);
//			return;
			Player_Teleport("Start_Exit");
			cScript_SetGlobalVarBool("Outpost_AnsweredRadio", true);
			cScript_SetGlobalVarBool("Outpost_LQ_FirstTripComplete", true);
//			OnCollide_Player_EnterEntrance("", "", 1);
			OnCollide_Player_EnterReturnTripArea("", "", 1);
			
			return;
			cLux_AddDebugMessage("[Test] Cannon solved");
			
			mlCannon_WheelsAttachedCount = 0;
			OnTimer_DeactivateCannonWheel("");
			
//			OnCollide_PropUp_DropCannon("", "", -1);
//			Entity_SetActive("Cannon_PropUp", false);
		}
		
		if(alAction == eAction_Test3)
		{
			cLux_AddDebugMessage("[Test] Elevator solved");
			OnUse_ElevatorWinch("", "", msElevator_InsertWinchTrigger, "", 0.0f, 0.0f);
			mfSecondFloorScares_BaseCoolDown = 0.0f;
		}
		
		if(alAction == eAction_Test4)
		{
//			SetCreepyEventsActive(true);
//			return;
//			FearHandler_SetForcedAddFearRate(0.5, 1, true, 1, 1);
//			return;
//			SwingDoor_PushOpen("ElevatorLid_Interact", -10, 2, 0.2);
//			SwingDoor_SetOpenAmount("ElevatorLid_Interact", 0);
//			SwingDoor_SetAutoClose("ElevatorLid_Interact", true);
