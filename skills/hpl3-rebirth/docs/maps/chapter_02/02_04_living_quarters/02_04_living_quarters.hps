		/////////////////////////////////////////
		// Event B *Pick up the radio and have a conversation with the doctor*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbPreventOpenStorageDoor = false;
		bool mbStorageUpstairsExplored = false;
		
		//-------------------------------------------------------
		
		void InitRadio()
		{
			Entity_PlayAnimation("Radio_Animated", "radio_talk_over_map", 0);
			iLuxEntity@ pRadio = Map_GetEntity("Radio_Animated");
			pRadio.GetMeshEntity().GetAnimationStateFromName("radio_talk_over_map").SetPaused(true);
			pRadio.GetMeshEntity().GetAnimationStateFromName("radio_talk_over_map").SetRelativeTimePosition(0);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_PickUpRadio(const tString &in asEntity)
		{
			Seq_RadioConversation("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceRadioConversation;
		void Seq_RadioConversation(const tString &in asTimer)
		{
			Sequence_Begin("Seq_RadioConversation", mSequenceRadioConversation);
			if (Sequence_DoStepAndWait(0.5))
			{
				cLux_AddDebugMessage("[Map] Radio answered, set global var");
				
				// update systems
				cScript_SetGlobalVarBool("Outpost_AnsweredRadio", true);
				Entity_SetActive("Target_PickUpRadio", false);
				Sketchbook_CompleteIdea("get_radio");
				FearHandler_SetWhisperStage(eFearWhisperStage_RadioToBabyKick);
				
				// stop power updates
				Map_RemoveTimer("Timer_UpdateElectricPowerSystem");
				Map_RemoveTimer("Timer_TasiRespondToDoctor");
				
				// play dialogue
				Voice_StopAll();
				Voice_PlayDelayed("Radio_Final", 1.5);
				
				// radio anim
				Entity_PlayAnimation("Radio_Animated", "radio_talk_over_map", 0, false, false, "");
				
				// player anim
				Item_PutAway(eItemHandlerHand_Right);
				Item_PutAway(eItemHandlerHand_Left);
				PlayerBody_SetCutsceneMaxPitch(15);
				PlayerBody_SetCutsceneMaxYaw(15);
				PlayerBody_PlayCutsceneAtEntity("player_talk_over_map", "Radio_Animated", false, 0.5, "OnAnimEnd_ResumeRadioConversation");
				Sound_CreateAtEntity("Sound_PlayerCall", "02_04_living_quarters/animation/call", "player");
				Music_Play("A2_Radio_Call_FIN.ogg", 0.2f, false, eMusicPrio_BigEvent);
				
				// effects
				RemoveFlickerLamp("RadioStand");
				Sound_Stop("RadioStaticLoop", 0.1f);
				
				// setup voice sources
				Voice_SetSource("Doctor_Radio", "player", 2.0f, 30.0f, true);
				Voice_SetSource("Yasmin_Radio", "player", 2.0f, 30.0f, true);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				SetPowerState(false);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				// end conversation
				cScript_SetGlobalVarBool("Outpost_TalkedToDoctor", true);
				Entity_SetActive("Trigger_PreventOpenStorageDoorArea", true);
				Entity_SetActive("Radio_Animated", false);
				
				Entity_SetActive("Trigger_UpstairsExplored", false);
				if (mbStorageUpstairsExplored) Map_AddTimer("Timer_CheckOpenWorkShopDoor", 6, "OnTimer_CheckOpenWorkShopDoor");
				else Map_AddTimer("Timer_OpenWorkshopDoor", 0, "OnTimer_OpenWorkshopDoor");
				
				Map_AddTimer("Timer_UpdateElectricPowerSystem", 2, "OnTimer_UpdateElectricPowerSystem");
				Sound_Stop("RadioStaticLoop", 0.1);
				Sketchbook_AddIdea("smash_gates");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Item_AddToInventory("Radio", true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ResumeRadioConversation(const tString &in asAnimName)
		{
			SequenceStates_Resume("Seq_RadioConversation");
		}
		
