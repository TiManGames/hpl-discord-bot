		bool OnEnter_Player_Corporal(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Pregnancy_SetBabyTalkRoomSpecificSubject("BabyTalk_SafeRoom_Corporal", true);
			}
			else
			{
				Pregnancy_ClearBabyTalkRoomSpecificSubject();
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SawAGhoulMemory(const tString &in asParent, const tString &in asChild, int alState)
