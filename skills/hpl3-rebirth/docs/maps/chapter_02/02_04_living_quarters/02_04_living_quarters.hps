				Map_AddTimer("Timer_OpenWorkshopDoor", 2, "OnTimer_OpenWorkshopDoor");
				Map_AddTimer("Timer_OpenWorkshopDoorGhoulRun", 3, "OnTimer_OpenWorkshopDoorGhoulRun");
				return;
			}
			Map_AddTimer("Timer_CheckOpenWorkShopDoor", cMath_RandRectf(0.2, 0.4), "OnTimer_CheckOpenWorkShopDoor");
		}
		
