		cLux_AddDebugMessage("SECOND FLOOR WORKSHOP: " + abX);
		SetAABBPropsActive("Trigger_SecondFloorWorkshopAABB", abX, abSetup);
	}
	
	//-------------------------------------------------------
	
	void SetAABBPropsActive(const tString &in asArea, bool abX, bool abSetup = false)
	{
		cLuxArea@ pArea = cLux_ToArea(Map_GetEntity(asArea));
		cBoundingVolume@ pVolume = pArea.GetMainBody().GetBoundingVolume();
		
		array<iPhysicsBody@> vBodies;
		cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(pVolume.GetMin(), pVolume.GetMax(), vBodies);
		for (int i = 0; i < vBodies.size(); ++i)
		{
			iPhysicsBody@ pBody = vBodies[i];
			if (pBody is null) continue;
			iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
			if (pEnt is null) continue;
			
			if (pEnt.GetEntityType() != eLuxEntityType_Prop) continue;
			if (pEnt.GetClassName() == "cScrPropPickup") continue;
			if (pEnt.GetVarString("") != "") continue;
			
			if (abSetup && pEnt.GetVarBool("SwitchSetup") == false)
			{
				if (pEnt.IsActive() == false) pEnt.SetVarBool("StartInactive", true);
				pEnt.SetVarBool("SwitchSetup", true);
			}
			
			if (pEnt.GetVarBool("StartInactive")) continue;
			pEnt.SetActive(abX);
//			cLux_AddDebugMessage("SET " + pEnt.GetName() + " " + pEnt.GetClassName());
		}
	}
	
