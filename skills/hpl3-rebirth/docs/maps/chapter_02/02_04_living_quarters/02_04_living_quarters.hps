	//-------------------------------------------------------
	
	void OnRead_DanielAchievement(const tString &in asEntity)
	{
		Achievement_Unlock(eAchievement_Historian);
	}
	
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 1 *Explore the first part of the first floor*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////

		//-------------------------------------------------------

		/*Put any variables that are used by many events in Scene X here.*/

		//-------------------------------------------------------

		/*Put any functions that are used in more than one event in Scene X here.*/

		//-------------------------------------------------------

		//} END General	
		
		/////////////////////////////////////////
		// Event A *Enter the level*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterEntrance(const tString &in asParent, const tString &in asChild, int alState)
		{
			InitBrokenFloor();
			if (alState == 1 && cScript_GetGlobalVarBool("Outpost_AnsweredRadio")) SetupReturnTrip(0);
			return true;
		}

		//-------------------------------------------------------
		
		void OnInteract_MapRoomDoor(const tString &in asEntity)
		{
			if (Entity_GetCollide("player","Fear_MapRoom")) return;
			Map_AddTimer("Timer_StartMapRoomDoorDialogue", 0.5, "OnTimer_StartMapRoomDoorDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnInteractLeave_MapRoomDoor(const tString &in asEntity)
		{
			Map_RemoveTimer("Timer_StartMapRoomDoorDialogue");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartMapRoomDoorDialogue(const tString &in asTimer)
		{
			if (mbRadio_FirstMessageOver) Voice_PlayDelayed("Dialogue_TryDoor",0.5f);
		}
		
		//-------------------------------------------------------
		
		//} END Event A *Enter the level*
		
		/////////////////////////////////////////
		// Event B *Hear the radio throughout the living quarters and see the electrical lights flicker*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		tString msRadio_Prop = "Radio_Pickup";
		bool mbRadio_TransmissionsActive = false;
		bool mbRadio_MessagesActive = true;
		bool mbRadio_TasiResponded = false;
		float mfRadio_PauseTimer = 0.0f;
		float mfRadio_NextTransmissionTime = -1.0f;
		float mfRadio_NextMessageTimer = 0.0f;
		int mlRadio_MessageCount = -1;
		float mfRadio_Volume = 0.8f;
		bool mbRadio_FirstMessageStarted = false;
		bool mbRadio_FirstMessageOver = false;
		bool mbRadio_RadioLoopStarted = false;
		bool mbRadio_YasminMessage = false;
		bool mbRadio_FastTrackMessage = false;
		bool mbRadio_MessageDuringPower = false;
		int mlRadio_TweakCount = 0;
		
		array<int> mvPower_ElectricLampGroup;
		bool mbPowerOn = false;
		cVector2f mvPower_OffTime = cVector2f(4, 15);
		cVector2f mvPower_OnTime = cVector2f(5, 25);
		cVector2f mvPower_VoiceTime = cVector2f(50, 70);
		cVector2f mvPower_VoiceDelayTime = cVector2f(1, 8);
		cColor mPower_OrigButtonColor;
		array<tString> mvFlickerLamps;
		int mlFlickerLampsState = 0;
		bool mbFlickerLightsInit = false;

		//-------------------------------------------------------
		
		void InitElectricPowerSystem()
		{
			// set voice source
			Voice_SetSource("Doctor_Radio", "Target_RadioSounds", 1, 26, true, 24);
			Voice_SetSource("Yasmin_Radio", "Target_RadioSounds", 1, 26, true, 24);
			
			if (mbFlickerLightsInit == false)
			{
				mbFlickerLightsInit = true;
				AddFlickerLamp("Electric_RadioRoom");
				AddFlickerLamp("RadioStand");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_TurnOnRadio(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_TurnOnRadio", 0.5, "OnTimer_TurnOnRadio");
			Map_AddTimer("Timer_ActivateFirstRadioMessageArea", 1.5, "OnTimer_ActivateFirstRadioMessageArea");
			Map_AddTimer("Timer_FirstRadioMessage", 4, "OnTimer_FirstRadioMessage");
			Map_AddTimer("Timer_StartRadioBackup", 60, "OnTimer_StartRadioBackup");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TurnOnRadio(const tString &in asTimer)
		{
			SetPowerState(true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateFirstRadioMessageArea(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_FirstRadioMessage", true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_FirstRadioMessage(const tString &in asEntity, int alState)
		{
			Map_AddTimer("Timer_FirstRadioMessage", 0, "OnTimer_FirstRadioMessage");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FirstRadioMessage(const tString &in asTimer)
		{
			if (mbRadio_FirstMessageStarted) return;
			mbRadio_FirstMessageStarted = true;
			
			SetFlickerLampsState(2);
			
			Voice_PlayWhenPossible("Dialogue_Intro", "OnVoiceCondition_FirstRadioMessage", -1, 0.5, "OnVoiceEnd_FirstRadioMessage");
		}
		
		//-------------------------------------------------------
		
		bool OnVoiceCondition_FirstRadioMessage(const tString& in asSubject)
		{
			Map_AddTimer("Timer_FirstRadioMessageOut", 5, "OnTimer_FirstRadioMessageOut");
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FirstRadioMessageOut(const tString &in asTimer)
		{
			SetFlickerLampsState(1);
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_FirstRadioMessage(const tString&in asScene, const tString&in asSubject)
		{
			mbRadio_FirstMessageOver = true;
			cScript_SetGlobalVarBool("Outpost_HeardRadioInLQ", true);
			
			Entity_SetActive("Trigger_LookTowardsMapRoom*", true);
			
			SetFlickerLampsState(1);
			
			Sketchbook_AddIdea("get_radio");
			
			Map_AddTimer("Timer_UpdateElectricPowerSystem", 2, "OnTimer_UpdateElectricPowerSystem");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartRadioBackup(const tString &in asTimer)
		{
			if (mbRadio_RadioLoopStarted == false)
			{
				Error("[Map] Radio started via backup, this should never happen!!!");
				Entity_SetActive("Trigger_LookTowardsMapRoom*", true);
				Map_AddTimer("Timer_UpdateElectricPowerSystem", 0, "OnTimer_UpdateElectricPowerSystem");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UpdateElectricPowerSystem(const tString &in asTimer)
		{
			mbRadio_RadioLoopStarted = true;
			
			float fNextTimer = -1;
			if (mbPowerOn)
			{
				SetPowerState(false);
				fNextTimer = cMath_RandRectf(mvPower_OffTime.x, mvPower_OffTime.y);
				StopRadioVoice();
//				Map_AddTimer("TweakRadioPowerOffCooldown", 5, "");
			}
			else
			{
				SetPowerState(true);
				fNextTimer = cMath_RandRectf(mvPower_OnTime.x, mvPower_OnTime.y);
				
				mbRadio_MessageDuringPower = false;
				
				float fDelay = cMath_RandRectf(mvPower_VoiceDelayTime.x, mvPower_VoiceDelayTime.y);
				if (mbRadio_FastTrackMessage)
				{
					mbRadio_FastTrackMessage = false;
					fDelay = 0.5f;
				}
				
				fDelay = 0;
				Map_AddTimer("Timer_PlayRadioVoice", fDelay, "OnTimer_PlayRadioVoice");
			}
			
			cLux_AddDebugMessage("[Map] Update power: " + mbPowerOn + " next: " + fNextTimer + " voice cooldown: " + Map_GetTimerTime("RadioVoiceCooldown"));
			Map_RestartCurrentTimer(fNextTimer);
		}
		
		//-------------------------------------------------------
		
		void SetPowerState(bool abActive)
		{
			if (mbPowerOn == abActive) return;
			mbPowerOn = abActive;
			
			cLux_AddDebugMessage("[Map] Set power state: " + mbPowerOn);
			
			if (mbPowerOn)
			{
				if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio") == false)
				{
					Sound_CreateAtEntity("RadioStaticLoop", "02_04_living_quarters/radio/static_loop", "Target_RadioSounds", 0, true, 1, 1, 37);
				}
				SetFlickerLampsState(1);
			}
			else
			{
				if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio") == false)
				{
					Sound_Stop("RadioStaticLoop", 0.1f);
				}
				SetFlickerLampsState(0);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayRadioVoice(const tString &in asTimer)
		{
			PlayRadioVoice();
		}
		
		//-------------------------------------------------------
		
		void PlayRadioVoice()
		{
			if (CanPlayRadioVoice() == false) return;
			
			mbRadio_MessageDuringPower = true;
			
			mbRadio_YasminMessage = false;
			Voice_Play("Radio_Calls", -1, "OnVoiceEnd_RadioVoice");
			SetFlickerLampsState(2);
			
			float fVoiceCooldown = cMath_RandRectf(mvPower_VoiceTime.x, mvPower_VoiceTime.y);
			Map_AddTimer("RadioVoiceCooldown", fVoiceCooldown, "");
			
			cLux_AddDebugMessage("[Map] Play voice. Cooldown: " + fVoiceCooldown);
		}
		
		//-------------------------------------------------------
		
		bool CanPlayRadioVoice(bool abIgnoreCooldown = false)
		{
			if (mbRadio_MessagesActive == false) return false;
			if (mbSecondFloorScares_Paused) return false;
			if (mbCreepyEvents_Paused) return false;
			if (abIgnoreCooldown == false && Map_TimerExists("RadioVoiceCooldown")) return false;
			if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio")) return false;
			return true;
		}
		
		//-------------------------------------------------------
		
		void VoiceCallback_OnHearingYasmin(const tString&in asScene, const tString&in asSubject, int alLineNumber, bool abStartofLine)
		{
			if (abStartofLine) mbRadio_YasminMessage = true;
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_RadioVoice(const tString&in asScene, const tString&in asSubject)
		{
			if (mbPowerOn) SetFlickerLampsState(1);
			else SetFlickerLampsState(0);
			
			if (Player_GetDistanceToEntity("Target_RadioSounds") <= 24.2f) Map_AddTimer("Timer_TasiRespondToDoctor", cMath_RandRectf(0.8, 1.2), "OnTimer_TasiRespondToDoctor");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TasiRespondToDoctor(const tString &in asTimer)
		{
			if (FearHandler_GetLevel() > 0.2) return;
			if (Voice_AnySceneIsActive()) return;
			if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio")) return;
			
			if (Entity_IsActive("Trigger_DontRespondToRadio") && Entity_GetCollide("player", "Trigger_DontRespondToRadio"))
				return;
			
			if (mbRadio_YasminMessage) Voice_Play("Dialogue_HeardYasmin",-1,"",-2);
			else Voice_Play("Dialogue_HearsRadioAgain",-1,"",-2);
		}
		
		//-------------------------------------------------------
		
		void StopRadioVoice()
		{
			Map_RemoveTimer("Timer_PlayRadioVoice");
			Voice_Stop("Radio");
		}
		
		//-------------------------------------------------------
		
		void AddFlickerLamp(const tString &in asKey, bool abChangeEffects = true)
		{
			mvFlickerLamps.push_back(asKey);
			if (abChangeEffects)
			{
				Lamp_SetLit("Lamp_" + asKey, true, false);
				Entity_SetEffectBaseColor("Lamp_" + asKey, cColor_White * 0);
				Light_SetBrightness("Light_" + asKey + "*", 0);
			}
		}
		
		//-------------------------------------------------------
		
		void RemoveFlickerLamp(const tString &in asKey)
		{
			int alIndex = mvFlickerLamps.find(asKey);
			if (alIndex < 0) return;
			
			tString sLampKey = mvFlickerLamps[alIndex];
			FadeFlickerLampTo(sLampKey, 0, 0.2, eEasing_CubicOut);
			mvFlickerLamps.removeAt(alIndex);
			Sound_Stop("ElectricLampOn_" + asKey, 0.2);
		}
		
		//-------------------------------------------------------
		
		void SetFlickerLampsState(int alNewState)
		{
			if (mlFlickerLampsState == alNewState) return;
									
			if (alNewState > 0 && mlFlickerLampsState == 0)
			{
				Map_AddTimer("Timer_FlickerLampsOn", 0, "OnTimer_FlickerLampsOn");
				for (int i = 0; i < mvFlickerLamps.size(); ++i)
				{
					tString sLampKey = mvFlickerLamps[i];
					Sound_CreateAtEntity("ElectricLampOn_" + sLampKey, "02_04_living_quarters/scare_events/light_scare/spark_on", "Lamp_" + sLampKey, 0, true, 1, 1, 10);
				}
			}
			else if (alNewState == 0 && mlFlickerLampsState > 0)
			{
				Map_RemoveTimer("Timer_FlickerLampsOn");
				Map_RemoveTimer("Timer_FlickerLampsOff");
				for (int i = 0; i < mvFlickerLamps.size(); ++i)
				{
					tString sLampKey = mvFlickerLamps[i];
					FadeFlickerLampTo(sLampKey, 0, 0.2, eEasing_CubicOut);
					
					Sound_Stop("ElectricLampOn_" + sLampKey, 0.2);
					Sound_CreateAtEntity("ElectricLampOff_" + sLampKey, "02_04_living_quarters/scare_events/light_scare/spark_off", "Lamp_" + sLampKey, 0, true, 1, 1, 10);
				}
			}
			
			mlFlickerLampsState = alNewState;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FlickerLampsOn(const tString &in asTimer)
		{
			float fFadeTime = cMath_RandRectf(0.02, 0.12);
			float fOnTime = cMath_RandRectf(0.01, 0.06);
			float fAlpha = 1.0f;
			
			// flicker settings for doctor talk
			if (mlFlickerLampsState == 2)
			{
				fFadeTime *= 0.75f;
				fOnTime *= 0.75f;
				fAlpha = cMath_RandRectf(1.3, 1.8);
			}
			
			for (int i = 0; i < mvFlickerLamps.size(); ++i)
			{
				tString sLampKey = mvFlickerLamps[i];
				
				// periodically leave lamps on for a longer time
				if (mlFlickerLampsState != 2 && Map_TimerExists("Lamp_" + sLampKey + "_LongCooldown") == false)
				{
					fOnTime = cMath_RandRectf(0.2, 1.5);
					Map_AddTimer("Lamp_" + sLampKey + "_LongCooldown", cMath_RandRectf(1, 5), "");
				}
				
				FadeFlickerLampTo(sLampKey, fAlpha, fFadeTime, eEasing_CubicIn);
			}

			Map_AddTimer("Timer_FlickerLampsOff", fFadeTime + fOnTime, "OnTimer_FlickerLampsOff");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FlickerLampsOff(const tString &in asTimer)
		{
			float fFadeTime = cMath_RandRectf(0.02, 0.12);
			float fOffTime = cMath_RandRectf(0.01, 0.05);
			float fAlpha = cMath_RandRectf(0.6, 0.8);
			
			// flicker settings for doctor talk
			if (mlFlickerLampsState == 2)
			{
				fFadeTime *= 0.75f;
				fOffTime *= 0.75f;
				fAlpha = cMath_RandRectf(1.0, 1.2);
			}
			
			for (int i = 0; i < mvFlickerLamps.size(); ++i)
			{
				tString sLampKey = mvFlickerLamps[i];
				FadeFlickerLampTo(sLampKey, fAlpha, fFadeTime, eEasing_CubicOut);
			}
			
			Map_AddTimer("Timer_FlickerLampsOn", fFadeTime + fOffTime, "OnTimer_FlickerLampsOn");
		}
		
		//-------------------------------------------------------
		
		void FadeFlickerLampTo(const tString &in asLampKey, float afAlpha, float afFadeTime, eEasing aEasing = eEasing_Linear)
		{
			Entity_FadeEffectBaseColor("Lamp_" + asLampKey, cColor_White * afAlpha, afFadeTime);
			
			array<iLight@> vLights;
			Map_GetLightArray("Light_" + asLampKey + "*", vLights);
			for (int j = 0; j < vLights.size(); ++j)
			{
				iLight@ pLight = vLights[j];
				pLight.FadeBrightnessTo(pLight.GetDefaultBrightness() * afAlpha, afFadeTime, aEasing);
			}
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_LookTowardsMapRoom(const tString &in asEntity, int alState)
		{
			if (alState == 1) Map_AddTimer("Timer_CheckMapRoomLookAt", 0, "OnTimer_CheckMapRoomLookAt");
			else Map_RemoveTimer("Timer_CheckMapRoomLookAt");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckMapRoomLookAt(const tString &in asTimer)
		{
			if (Map_TimerExists("TweakRadioCooldown") == false)
			{
				if (mbPowerOn)
				{
					if ((Map_TimerExists("Timer_PlayRadioVoice") || mbRadio_MessageDuringPower == false) && CanPlayRadioVoice(true))
					{
						if (Map_TimerExists("Timer_PlayRadioVoice") == false) SetTweakRadioCooldown();
							
						Map_RemoveTimer("RadioVoiceCooldown");
						
						Map_RemoveTimer("Timer_PlayRadioVoice");
						Map_AddTimer("Timer_PlayRadioVoice", 0, "OnTimer_PlayRadioVoice");
						
						cLux_AddDebugMessage("[Map] Tweak radio to play voice instantly");
						return;
					}
				}
				else
				{
					if (Map_TimerExists("TweakRadioPowerOffCooldown") == false && CanPlayRadioVoice(true))
					{
						Map_RemoveTimer("Timer_UpdateElectricPowerSystem");
						Map_AddTimer("Timer_UpdateElectricPowerSystem", 0, "OnTimer_UpdateElectricPowerSystem");
						
						Map_RemoveTimer("RadioVoiceCooldown");
						
						mbRadio_FastTrackMessage = true;
						SetTweakRadioCooldown();
						
						cLux_AddDebugMessage("[Map] Tweak radio to turn on power instantly and fast track message");
						return;
					}
				}
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.4));
		}
		
		//-------------------------------------------------------
		
		void SetTweakRadioCooldown()
		{
			++mlRadio_TweakCount;
			float fCooldown = 30;
			if (mlRadio_TweakCount >= 4) fCooldown = 120;
			else if (mlRadio_TweakCount == 3) fCooldown = 60;
			else fCooldown = 20;
			Map_AddTimer("TweakRadioCooldown", 40, "");
			
			cLux_AddDebugMessage("[Map] Set radio tweak cooldown to: " + fCooldown);
		}
		
		//-------------------------------------------------------

		//} END Event B *Hear the radio throughout the living quarters*
		
		/////////////////////////////////////////
		// Event C *Look at the blinking radio*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlLoookingIntoMapRoom = 0;
		bool mbLookingAtRadio = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_LookAtRadioBarks(const tString &in asEntity, int alState)
		{
			mbLookingAtRadio = alState == 1;
			if (Voice_SubjectHasUnplayedLines("Dialogue_LookAtRadioBarks") == false)
			{
				Entity_SetActive(asEntity, false);
				return;
			}
			
			if (alState == 1)
			{
				if (Map_TimerExists("LookAtRadioBarkCooldown") == false)
					Voice_PlayWhenPossible("Dialogue_LookAtRadioBarks", "OnVoiceCondition_LookAtRadioBarks", -1, 4, "OnVoiceEnd_LookAtRadioBarks");
			}
			else
			{
				Voice_StopCheckTimer("Dialogue_LookAtRadioBarks");
			}
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_LookAtRadioBarks(const tString&in asScene, const tString&in asSubject)
		{
//			if (mbLookingAtRadio) Map_AddTimer("Timer_PlayLookAtRadioBarks", 1.0, "OnTimer_PlayLookAtRadioBarks");
		}	
		
		//-------------------------------------------------------
		
		bool OnVoiceCondition_LookAtRadioBarks(const tString& in asSubject)
		{
			if (mbRadio_FirstMessageOver == false) return false;
			if (mlLoookingIntoMapRoom <= 0) return false;
			Map_AddTimer("LookAtRadioBarkCooldown", 6, "");
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_LookIntoMapRoom(const tString &in asEntity, int alState)
		{
			mlLoookingIntoMapRoom += alState;
		}
		
		//-------------------------------------------------------
		
		//} END Event C *Look at the blinking radio*
				
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Event C *Experience creepy events*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbCreepyEventsDone = false;
		bool mbCreepyEvents_Active = false;
		bool mbCreepyEvents_Paused = false;
		float mfCreepyEvents_Cooldown = 0.0f;
		float mfCreepyEvents_BaseCooldown = 3.0f;
		bool mbCreepyEvents_RandomActive = true;
		
		int mlCreepyEvents_PreventRandomNoiseAreas = 0;
		int mlCreepyEvents_RandomImpactTargetIndex;
		
		cVector2f mvCreepyEvents_RandomEventFrequency = cVector2f(30.0f, 60.0f);
		cVector2f mvCreepyEvents_RandomImpactFrequency = cVector2f(50.0f, 100.0f);
		array<tID> mvCreepyEvents_RandomImpactTargets;
		
		cVector3f mvImpactAbove_Position;
		tID m_idImpactAbove_target;
		
		//-------------------------------------------------------
		
		void InitCreepyEvents()
		{
			array<iLuxEntity@> vEnts;
			Map_GetEntityArray("Target_ImpactAbove*", vEnts);
			for (int i = 0; i < vEnts.size(); ++i)
			{
				mvCreepyEvents_RandomImpactTargets.push_back(vEnts[i].GetID());
			}						
		}
		
		//-------------------------------------------------------
		
		void UpdateCreepyEvents(float afTimeStep)
		{
			if (mfCreepyEvents_Cooldown > 0) mfCreepyEvents_Cooldown -= afTimeStep;
		}
		
		//-------------------------------------------------------
		
		void SetCreepyEventsActive(bool abX)
		{
			if (mbCreepyEvents_Active == abX) return;
			mbCreepyEvents_Active = abX && mbCreepyEventsDone == false;
			
			cLux_AddDebugMessage("[Map] 1F creepy events: " + mbCreepyEvents_Active);
			
			if (mbCreepyEvents_Active)
			{
				Map_AddTimer("Timer_StartRandomCreepyEvent", 5.0f, "OnTimer_StartRandomCreepyEvent");
			}
			else
			{
				Map_RemoveTimer("Timer_StartRandomCreepyEvent");
			}
		}
		
		//-------------------------------------------------------
		
		cVector3f mvStartCreepyEventsEnterPos;
		bool OnCollide_Player_StartCreepyEvents(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				mvStartCreepyEventsEnterPos = Player_GetPosition();
			}
			else
			{
				cVector3f vTransitionDir = Player_GetPosition() - mvStartCreepyEventsEnterPos;
				if (cMath_Vector3Dot(vTransitionDir, Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward()) > 0.0f)
				{
					SetCreepyEventsActive(true);
				}
				else
				{
					SetCreepyEventsActive(false);
				}
			}
			return true;
		}

		//-------------------------------------------------------
		
		bool OnCollide_Player_LeanHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			Hint_RemoveFromGiven("Hints", "HintLean");
			Hint_ShowHint("Hints", "HintLean", true, 1.5f, false);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool CanStartCreepyEvent()
		{
			return mbCreepyEvents_Active && mbCreepyEvents_Paused == false && mfCreepyEvents_Cooldown <= 0.0f;
		}
		
		//-------------------------------------------------------
		
		void EndCreepyEvent(eCreepyEventType aType)
		{
			mbCreepyEvents_Paused = false;
			
			float fCoolDownMul = 0.0f;
			if (aType == eCreepyEventType_Minor) fCoolDownMul = 0.5f;
			if (aType == eCreepyEventType_Normal) fCoolDownMul = 2.0f;
			if (aType == eCreepyEventType_Major) fCoolDownMul = 4.0f;
			
			mfCreepyEvents_Cooldown = mfCreepyEvents_BaseCooldown * fCoolDownMul;
			
			float fNextRandom = Map_GetTimerTime("Timer_StartRandomCreepyEvent");
			fNextRandom = cMath_Max(fNextRandom, 8.0f);
			Map_RemoveTimer("Timer_StartRandomCreepyEvent");
			Map_AddTimer("Timer_StartRandomCreepyEvent", fNextRandom, "OnTimer_StartRandomCreepyEvent");
			
			if (Map_GetTimerTime("RadioVoiceCooldown") <= 5)
			{
				Map_RemoveTimer("RadioVoiceCooldown");
				Map_AddTimer("RadioVoiceCooldown", 5, "");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartRandomCreepyEvent(const tString &in asTimer)
		{
			if (mbCreepyEvents_RandomActive == false) return;
			
			float fNext = cMath_RandRectf(mvCreepyEvents_RandomEventFrequency.x, mvCreepyEvents_RandomEventFrequency.y);
			
			cLux_AddDebugMessage("[Map] Random creepy event");
			
			if (FearHandler_GetFearAreaState() != 1 && mlCreepyEvents_PreventRandomNoiseAreas <= 0 && CanStartCreepyEvent())
			{
				float fRand = cMath_RandRectf(0.0f, 1.0f);
				if (Map_TimerExists("RandomImpactCooldown") == false && StartCreepyEvent_ImpactAbove())
				{
					cLux_AddDebugMessage("[Map] Random impact");
					Map_AddTimer("RandomImpactCooldown", cMath_RandRectf(mvCreepyEvents_RandomImpactFrequency.x, mvCreepyEvents_RandomImpactFrequency.y), "");
				}
				else if (fRand <= 0.5f && StartCreepyEvent_RandomNoiseAbove("02_04_living_quarters/scare_events/ceiling_creak"))
				{
					cLux_AddDebugMessage("[Map] Random creak");
					fNext *= 0.4f;
				}
				else if (fRand <= 0.75f && StartCreepyEvent_CreepyWallSound())
				{
					cLux_AddDebugMessage("[Map] Random wall sound");
					fNext *= 0.6f;
				}
				else
				{
					cLux_AddDebugMessage("[Map] Random ceiling impact");
					StartCreepyEvent_RandomNoiseAbove(GetRandomCeilingImpactSound());
				}
			}
			else
			{
				cLux_AddDebugMessage("[Map] Creepy event in progress");
				fNext *= 0.33f;
			}
			
			Map_AddTimer("Timer_StartRandomCreepyEvent", fNext, "OnTimer_StartRandomCreepyEvent");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_PreventRandomCreepyNoise(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlCreepyEvents_PreventRandomNoiseAreas += alState;
			if (alState == -1)
			{
				if (Map_TimerExists("Timer_StartRandomCreepyEvent") && mlCreepyEvents_PreventRandomNoiseAreas == 0)
				{
					float fTime = Map_GetTimerTime("Timer_StartRandomCreepyEvent");
					fTime = cMath_Max(10.0f, fTime);
					Map_RemoveTimer("Timer_StartRandomCreepyEvent");
					Map_AddTimer("Timer_StartRandomCreepyEvent", fTime, "OnTimer_StartRandomCreepyEvent");
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		// Wrap the scare fear into a function so we can interrupt Tasi's dialogue if it makes sense to do so.
		void AddScareFear(float afFearRate, float afDuration = -1.0f, bool abGasp = true, float afIncreaseSpeed = -1.0f, 
							float afDecreaseSpeed = -1.0f, float afDelay = 0.0f)
		{
			FearHandler_SetForcedAddFearRate(afFearRate, afDuration, abGasp, afIncreaseSpeed, afDecreaseSpeed, afDelay);
			if (abGasp)
			{
				if (Voice_SceneIsActive("Comments"))
					Voice_Stop("Comments");
			}
		}
		
		//-------------------------------------------------------
		
		bool StartCreepyEvent_ImpactAbove()
		{
			iLuxEntity@ pBestEnt;
			float fBestDist = -1.0f;
			for (int i = 0; i < mvCreepyEvents_RandomImpactTargets.size(); ++i)
			{
				iLuxEntity@ pEnt = cLux_ID_Entity(mvCreepyEvents_RandomImpactTargets[i]);
				if (pEnt is null) continue;
//				if (pEnt.IsActive() == false) continue;
				
				float fDist = cMath_Vector3DistSqr(Player_GetPosition(), pEnt.GetPosition());
				if (fDist < 4.0f * 4.0f || fDist > 10.0f * 10.0f) continue;
				if (pEnt.CheckIsOnScreen(true) == false) continue;
				if (fBestDist < 0.0f || fDist < fBestDist)
				{
					fBestDist = fDist;
					@pBestEnt = pEnt;
				}
			}
			
			if (pBestEnt is null) return false;
			m_idImpactAbove_target = pBestEnt.GetID();
			
			float fY = cLux_ID_Area(pBestEnt.GetID()).GetSize().y;
			mvImpactAbove_Position = pBestEnt.GetPosition();
			mvImpactAbove_Position.y += fY / 2.0f;
			
			Debug_DrawSphere(mvImpactAbove_Position, 1, cColor_Red * 2, 4);
			Debug_DrawSphere(mvImpactAbove_Position, 5, cColor_Red * 2, 4);
			
//			Map_AddTimer("Timer_ImpactAbovePre", 0.0f, "OnTimer_ImpactAbovePre");
			Map_AddTimer("Timer_ImpactAboveImpact", 0.0f, "OnTimer_ImpactAboveImpact");
			ImpactAboveDust(mvImpactAbove_Position, 0);
			ImpactAboveDustFall(mvImpactAbove_Position, 0.2);
			
			AddScareFear(0.2f, 3.0f, true, 1.0f, 0.05f, 0.5f);
			
			EndCreepyEvent(eCreepyEventType_Normal);
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ImpactAbovePre(const tString &in asTimer)
		{
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("PreImpactAbove", "02_04_living_quarters/shaft_fall/shaft_corpse_tumble", true);
			pSound.SetVolume(0.3f);
			pSound.SetPosition(mvImpactAbove_Position);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ImpactAboveImpact(const tString &in asTimer)
		{
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("ImpactAbove", "02_04_living_quarters/scare_events/ceiling_bump", true);
			pSound.SetPosition(mvImpactAbove_Position);
		}
		
		//-------------------------------------------------------
		
		cVector3f mvImpactAboveDust_Position;
		void ImpactAboveDust(const cVector3f &in avPos, float afDelay)
		{
			mvImpactAboveDust_Position = avPos;
			Map_AddTimer("Timer_ImpactAboveDust", afDelay, "OnTimer_ImpactAboveDust");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ImpactAboveDust(const tString &in asTimer)
		{
			cParticleSystem@ pParticles = cLux_GetCurrentMap().GetWorld().CreateParticleSystem("ImpactAboveDust", "02_04_lq_impact_above", cVector3f_One, true, false);
			pParticles.SetColor(cColor(0.9, 0.8, 0.7, 0.08));
			pParticles.SetPosition(mvImpactAboveDust_Position);
		}
		
		//-------------------------------------------------------
		
		cVector3f mvImpactAboveDustFall_Position;
		void ImpactAboveDustFall(const cVector3f &in avPos, float afDelay)
		{
			mvImpactAboveDustFall_Position = avPos;
			Map_AddTimer("Timer_ImpactAboveDustFall", afDelay, "OnTimer_ImpactAboveDustFall");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ImpactAboveDustFall(const tString &in asTimer)
		{
			cParticleSystem@ pParticles = cLux_GetCurrentMap().GetWorld().CreateParticleSystem("ImpactAboveDustFall", "sand_falling_stream_small_oneshot_instant", cVector3f_One, true, false);
			pParticles.SetColor(cColor(0.9, 0.8, 0.7, 0.2));
			pParticles.SetPosition(mvImpactAboveDustFall_Position);			
		}
		
		//-------------------------------------------------------
		
		bool StartCreepyEvent_RandomNoiseAbove(const tString &in asSound)
		{	
			iLuxEntity@ pClosestEnt;
			float fClosestDist = -1.0f;
			for (int i = 0; i < mvCreepyEvents_RandomImpactTargets.size(); ++i)
			{
				iLuxEntity@ pEnt = cLux_ID_Entity(mvCreepyEvents_RandomImpactTargets[i]);
				if (pEnt is null) continue;
//				if (pEnt.IsActive() == false) continue;
				
				float fDist = cMath_Vector3DistSqr(Player_GetPosition(), pEnt.GetPosition());
				if (fClosestDist < 0.0f || fDist < fClosestDist)
				{
					fClosestDist = fDist;
					@pClosestEnt = pEnt;
				}
			}
			
			if (pClosestEnt is null) return false;
						
			float fY = cLux_ID_Area(pClosestEnt.GetID()).GetSize().y;
			cVector3f vAbovePos = pClosestEnt.GetPosition();
			vAbovePos.y += fY / 2.0f;
				
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("RandomNoiseAbove", asSound, true);
			pSound.SetPosition(pClosestEnt.GetPosition());
			
			Debug_DrawSphere(pClosestEnt.GetPosition(), 1, cColor_Red * 2, 4);
			Debug_DrawSphere(pClosestEnt.GetPosition(), 5, cColor_Red * 2, 4);
			
			if (fClosestDist > pSound.GetMaxDistance() * pSound.GetMaxDistance())
			{
				pSound.Stop(false);
				return false;
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		bool StartCreepyEvent_CreepyWallSound()
		{
			array<iLuxEntity@> pEnts;
			Map_GetEntityArray("Target_CreepySound*", pEnts);
			
			iLuxEntity@ pClosest;
			float fClosestDist = -1.0f;
			for (int i = 0; i < pEnts.size(); ++i)
			{
				iLuxEntity@ pEnt = pEnts[i];
				if (pEnt is null) continue;
				if (pEnt.IsActive() == false) continue;
				
				float fDist = cMath_Vector3Dist(Player_GetPosition(), pEnt.GetPosition());
				if (fClosestDist < 0.0f || fDist < fClosestDist)
				{
					@pClosest = pEnt;
					fClosestDist = fDist;
				}
			}
			
			if (pClosest is null) return false;
			
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("CreepyWallSound", "02_04_living_quarters/scare_events/wall_rat", true);
			pSound.SetPosition(pClosest.GetPosition());
			
			Debug_DrawSphere(pClosest.GetPosition(), 1, cColor_Red * 2, 4);
			Debug_DrawSphere(pClosest.GetPosition(), 5, cColor_Red * 2, 4);
			
			if (fClosestDist > pSound.GetMaxDistance() * pSound.GetMaxDistance())
			{
				pSound.Stop(false);
				return false;
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Event D *Get scared by the gust of wind in the kitchen*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbKitchenGustDone = false;
		
		//-------------------------------------------------------
		
		bool OnCollider_KitchenDoor_StartKitchenGust(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (CanStartCreepyEvent())
			{
				StartCreepyEvent_KitchenGust();
				return false;
			}
			Entity_SetActive("Trigger_StartKitchenGust", false);
			return true;
		}
		
		//-------------------------------------------------------
		
		void StartCreepyEvent_KitchenGust()
		{
			if (mbKitchenGustDone) return;
			mbKitchenGustDone = true;
			
			Sound_Play("Sound_ScareMugs", 1.0f);
			Sound_Play("Sound_ScareDebris", 1.0f);
			Sound_Play("Sound_ScareWind", 1.0f);
			
			float fImpulseStrength = 0.8f;
			array<iLuxEntity@> pCups;
			Map_GetEntityArray("Cup_Kitchen_*", pCups);
			cVector3f vGustDir = Map_GetEntity("Target_KitchenGustDirection").GetMatrix().GetTranspose().GetForward();
			for (int i = 0; i < pCups.size(); ++i)
			{
				cVector3f vImpulseDir = cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(cMath_RandRectf(-45.0f, 45.0f))), vGustDir);
				iLuxEntity@ pEnt = pCups[i];
				pEnt.GetMainBody().AddImpulse(vImpulseDir * fImpulseStrength * cMath_RandRectf(0.2f, 0.8f));
			}
			
			AddScareFear(0.2f, 4.0f, true, 1.0f, 0.05f, 0.5f);
			Entity_AddImpulse("Lamp_Kitchen", vGustDir * fImpulseStrength, false, false);
			EndCreepyEvent(eCreepyEventType_Minor);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_KitchenDialogue(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_Kitchen");
			Entity_SetActive("Trigger_KitchenDialogue*", false);
		}
		
		//-------------------------------------------------------

		//} END Event D *Get scared by the gust of wind in the kitchen*
		
		/////////////////////////////////////////
		// Event E *See a stool falling from above*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		float mfMessDrop_LookAtCounter = 0.0f;
		bool mbMessDropDone = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_MessDrop(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				mfMessDrop_LookAtCounter = 0.0f;
				Map_AddTimer("Timer_CheckMessDropStart", 0.0f, "OnTimer_CheckMessDropStart");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckMessDropStart");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckMessDropStart(const tString &in asTimer)
		{
			if (CanStartCreepyEvent() && mfMessDrop_LookAtCounter >= 0.5f)
			{
				StartCreepyEvent_MessDrop();
				return;
			}
			
			float fNext = cMath_RandRectf(0.1f, 0.2f);
			mfMessDrop_LookAtCounter += fNext;
			Map_AddTimer("Timer_CheckMessDropStart", fNext, "OnTimer_CheckMessDropStart");
		}
		
		//-------------------------------------------------------
		
		void StartCreepyEvent_MessDrop()
		{
			if (mbMessDropDone) return;
			mbMessDropDone = true;
			
			mbCreepyEvents_Paused = true;
			Map_AddTimer("Timer_MessDropSound", 0.0f, "OnTimer_MessDropSound");
			Map_AddTimer("Timer_MessDropStart", 0.5f, "OnTimer_MessDropStart");
			Map_AddTimer("Timer_DisableMessDropObjectLookAt", 4.0f, "OnTimer_DisableMessDropObjectLookAt");
			Map_RemoveTimer("Timer_CheckMessDropStart");
			Entity_SetActive("Trigger_MessDrop", false);
		}
		
		//-------------------------------------------------------
	
		void OnTimer_MessDropSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("MessDrop", "02_04_living_quarters/scare_events/chair_scare", "Prop_MessDrop");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MessDropStart(const tString &in asTimer)
		{
			Entity_SetActive("Prop_MessDrop", true);
			cVector3f vThrowDir = Map_GetEntity("Target_MessDrop").GetPosition() - Map_GetEntity("Prop_MessDrop").GetPosition();
			vThrowDir.Normalize();
			Entity_AddImpulse("Prop_MessDrop", vThrowDir * 2.0f, false, false);

			EndCreepyEvent(eCreepyEventType_Minor);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_MessDropObject(const tString &in asEntity, int alState)
		{
			AddScareFear(0.2f, 3.0f, true, 1.0f, 0.05f, 0.5f);
			Voice_PlayDelayed("Dialogue_RandomReactions", 0.5);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableMessDropObjectLookAt(const tString &in asTimer)
		{
			Entity_SetPlayerLookAtCallback("Prop_MessDrop", "");
		}
		
		//-------------------------------------------------------
		
		//} END Event E *See a stool falling from above*
		
		/////////////////////////////////////////
		// Event F *See a gust of wind knock down a plank*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbPlankFallDone = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_PlankFall(const tString &in asEntity, int alState)
		{
			if (alState == 1 && CanStartCreepyEvent())
			{
				StartCreepyEvent_PlankFall();
				Entity_SetActive("Trigger_PlankFall", false);
			}
		}
		
		//-------------------------------------------------------
		
		void StartCreepyEvent_PlankFall()
		{
			if (mbPlankFallDone) return;
			mbPlankFallDone = true;
			
			mbCreepyEvents_Paused = true;
			Map_AddTimer("Timer_PlankFallWindSound", 0.0f, "OnTimer_PlankFallWindSound");
			Map_AddTimer("Timer_PlankFall", 1.0f, "OnTimer_PlankFall");
			
//			Map_AddTimer("Timer_LivingAreaGustLampsOff", 0.2f, "OnTimer_LivingAreaGustLampsOff");
//			mfLivingAreaGust_NextLitCooldown = 10.0f;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlankFallWindSound(const tString &in asTimer)
		{
			Sound_CreateAtEntity("PlankFallWind", "02_04_living_quarters/scare_events/window_plank", "Plank_Fall");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlankFall(const tString &in asTimer)
		{
			Prop_SetStaticPhysics("Plank_Fall", false);
			Entity_SetInteractionDisabled("Plank_Fall", false);
			
			cVector3f vThrowDir = Map_GetEntity("Target_PlankFall").GetPosition() - Map_GetEntity("Plank_Fall").GetPosition();
			vThrowDir.Normalize();
			Entity_AddImpulse("Plank_Fall", vThrowDir * 7.0f, false, false);
			
			cVector3f vTorqueDir = cVector3f(0.6f, 0.08f, 1.4f);
			Entity_AddTorque("Plank_Fall", vTorqueDir * 8.0f, true, true);
			
			Entity_SetActive("Target_ImpactAbove_12", true);
			EndCreepyEvent(eCreepyEventType_Normal);
			AddScareFear(0.2f, 3.0f, true, 1.0f, 0.05f, 0.5f);
		}
		
		//-------------------------------------------------------
		
		//} END Event F *See a gust of wind knock down a plank*
		
		/////////////////////////////////////////
		// Event G *See a vase rolling down the stairs*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		float mfVaseStairFall_LookAtCounter = 0.0f;
		bool mbVaseStairFall_MemorySketched = false;
		bool mbVaseStairFall_LookedAwayAfterSketch = false;
		int mlVaseStairFall_AreaCount = 0;
		cVector3f mvVaseStairFall_AreaPlayerPos;
		bool mbVaseStairFall_InsideEventArea = false;
		bool mbVaseStairFall_ExitedEventAreaAfterSketch = false;
		bool mbVaseStairFallDone = false;
		bool mbDeadSoldierMicroflashDone = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_TriggerMicroflash_DeadSoldier(const tString &in asEntity, int alState)
		{
			if (mbDeadSoldierMicroflashDone) return;
			if (alState == 1)
			{
				Map_AddTimer("Timer_CheckDeadSoldierMicroflash", 0, "OnTimer_CheckDeadSoldierMicroflash");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckDeadSoldierMicroflash");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckDeadSoldierMicroflash(const tString &in asTimer)
		{
			float fLightLevel = cLux_GetLightLevelAtPos(Map_GetEntity("Target_LightLevel_DeadSoldier").GetPosition(), null, 1.0);
			if (fLightLevel >= 0.12)
			{
				Entity_SetActive("Trigger_Microflash_DeadSoldier", false);
				mbDeadSoldierMicroflashDone = true;
				
			
				mbVaseStairFall_MemorySketched = true;
				Entity_SetActive("Trigger_DontRespondToRadio", false);
				Sketchbook_Microflash("Microflash_DeadSoldier");
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.4));
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_VaseStairFall(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_CheckVaseStairFallStart", 0.0f, "OnTimer_CheckVaseStairFallStart");
			}
			else
			{
				if (mbVaseStairFall_MemorySketched) mbVaseStairFall_LookedAwayAfterSketch = true;
				Map_RemoveTimer("Timer_CheckVaseStairFallStart");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StairVaseFallArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlVaseStairFall_AreaCount += alState;
			if (alState == 1)
			{
				mvVaseStairFall_AreaPlayerPos = Player_GetPosition();
			}
			else
			{
				cVector3f vExitDir = Player_GetPosition() - mvVaseStairFall_AreaPlayerPos;
				if (cMath_Vector3Dot(vExitDir, Map_GetEntity(asParent).GetMatrix().GetTranspose().GetForward()) > 0.0f)
				{
					mbVaseStairFall_InsideEventArea = true;
					Map_AddTimer("Timer_CheckVaseStairFallMemory", 0.0f, "OnTimer_CheckVaseStairFallMemory");
				}
				else
				{
					mbVaseStairFall_InsideEventArea = false;
					Map_RemoveTimer("Timer_CheckVaseStairFallMemory");
					if (mbVaseStairFall_MemorySketched) mbVaseStairFall_ExitedEventAreaAfterSketch = true;
				}
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckVaseStairFallMemory(const tString &in asTimer)
		{
			Map_AddTimer("Timer_CheckVaseStairFallMemory", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CheckVaseStairFallMemory");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckVaseStairFallStart(const tString &in asTimer)
		{
			float fNext = cMath_RandRectf(0.1f, 0.2f);
			if (CanStartCreepyEvent() &&
				mlVaseStairFall_AreaCount > 0 &&
				Sketchbook_IsOpen() == false &&
				Map_GetEntity("Trigger_PreventVaseStairFall").CheckIsOnScreen(true) == false)
			{
				mfVaseStairFall_LookAtCounter += fNext;
				if (mbVaseStairFall_LookedAwayAfterSketch && mfVaseStairFall_LookAtCounter > 0.3f)
				{
					Map_RemoveTimer("Timer_CheckVaseStairFallStart");
					StartCreepyEvent_VaseStairRoll();
					return;
				}
			}
			
			Map_AddTimer("Timer_CheckVaseStairFallStart", fNext, "OnTimer_CheckVaseStairFallStart");
		}
		
		//-------------------------------------------------------
		
		void StartCreepyEvent_VaseStairRoll()
		{
			if (mbVaseStairFallDone) return;
			mbVaseStairFallDone = true;
			
			mbCreepyEvents_Paused = true;
			
			Entity_SetActive("Vase_StairRoll", true);
			Entity_SetActive("Vase_BeforeStairRoll", false);
			Entity_SetActive("Trigger_VaseStairFall", false);
			Entity_SetActive("Blocker_VaseStairRoll", true);
			
			cVector3f vThrowDir = Map_GetEntity("Target_VaseStairRoll").GetPosition() - Map_GetEntity("Vase_StairRoll").GetPosition();
			vThrowDir.Normalize();
			Entity_AddImpulse("Vase_StairRoll", vThrowDir * 4.0f, false, false);
			
			cVector3f vTorqueDir = cVector3f(0.0f, 0.1f, 0.0f);
			Entity_AddTorque("Vase_StairRoll", vTorqueDir * 8.0f, true, true);
			
			Map_AddTimer("Timer_VaseStairRollEnd", 2.5f, "OnTimer_VaseStairRollEnd");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_VaseStairFallEntity(const tString &in asEntity, int alState)
		{
			AddScareFear(0.2f, 3.0f, true, 1.0f, 0.05f, 0.0f);
			Voice_PlayDelayed("Dialogue_RandomReactions", 0.5);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_VaseStairRollEnd(const tString &in asTimer)
		{
			Entity_SetActive("Target_ImpactAbove_11", true);
			Entity_SetActive("Blocker_VaseStairRoll", false);
			
			EndCreepyEvent(eCreepyEventType_Minor);
			Entity_SetPlayerLookAtCallback("Vase_StairRoll", "");
		}
		
		//-------------------------------------------------------
		
		//} END Event G *See a vase rolling down the stairs*
		
		/////////////////////////////////////////
		// Event H *Get scared by a spark near the ballista*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbBallistSparkDone = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_BallistaSpark(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_StartBallistaSpark", 0.2f, "OnTimer_StartBallistaSpark");
				Entity_SetActive("Trigger_BallistaSpark", false);
				return false;
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartBallistaSpark(const tString &in asTimer)
		{
			StartCreepyEvent_BallistaSpark();
		}
		
		//-------------------------------------------------------
		
		void StartCreepyEvent_BallistaSpark()
		{
			if (mbBallistSparkDone) return;
			mbBallistSparkDone = true;
			
			Sound_CreateAtEntity("BallistaSpark", "02_04_living_quarters/scare_events/light_scare/spark_scare", "Lamp_Ballista");
			AddScareFear(0.5f, 3.0f, true, 1.0f, 0.1f, 0.2f);
			Voice_PlayDelayed("Dialogue_RandomReactions", 0.5);
			
			Lamp_SetLit("Lamp_Ballista", true, false);
			
			Entity_SetActive("Target_ImpactAbove_10", true);
//			EndCreepyEvent(eCreepyEventType_Normal);
			Map_AddTimer("Timer_EnableBalistaFlicker", 5, "OnTimer_EnableBalistaFlicker");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_EnableBalistaFlicker(const tString &in asTimer)
		{
			AddFlickerLamp("Ballista", false);
		}
		
		//-------------------------------------------------------
		
		//} END Event H *Get scared by a spark near the ballista*
				
		/////////////////////////////////////////
		// Event H *See a brick fall from above*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlBrickFall_AreaCount = 0;
		bool mbBrickFallDone = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_BrickFallArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlBrickFall_AreaCount += alState;
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_BrickFall(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				Map_RemoveTimer("Timer_CheckBrickFallStart");
				Map_AddTimer("Timer_CheckBrickFallStart", 0.0f, "OnTimer_CheckBrickFallStart");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckBrickFallStart");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckBrickFallStart(const tString &in asTimer)
		{
			if (CanStartCreepyEvent() && mlBrickFall_AreaCount > 0)
			{
				StartCreepyEvent_BrickFall();
				Entity_SetActive("Trigger_BrickFallLookAt", false);
				return;
			}
			Map_AddTimer("Timer_CheckBrickFallStart", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CheckBrickFallStart");
		}
		
		//-------------------------------------------------------
		
		void StartCreepyEvent_BrickFall()
		{
			if (mbBrickFallDone) return;
			mbBrickFallDone = true;
			
			Sound_CreateAtEntity("BrickCeilingImpact", "02_04_living_quarters/scare_events/brick_break_scare", "Target_BrickFallFrom");

			Map_AddTimer("Timer_BrickFall", 1.0f, "OnTimer_BrickFall");
			
			Entity_SetActive("Target_ImpactAbove_9", true);
			Entity_SetActive("Trigger_PreventRandomCreepyNoise_1", false);
			Entity_SetActive("Trigger_PreventRandomCreepyNoise", false);
			mlCreepyEvents_PreventRandomNoiseAreas = 0;
			
			EndCreepyEvent(eCreepyEventType_Major);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_BrickFall(const tString &in asTimer)
		{
			Entity_SetActive("Brick_Fall", true);
			
			cVector3f vThrowDir = Map_GetEntity("Target_BrickFall").GetPosition() - Map_GetEntity("Brick_Fall").GetPosition();
			vThrowDir.Normalize();
			Entity_AddImpulse("Brick_Fall", vThrowDir * 4.0f, false, false);
			
			cVector3f vTorqueDir = cVector3f(1.0f, 0.0f, 0.0f);
			Entity_AddTorque("Brick_Fall", vTorqueDir * 4.0f, true, true);
			
			Sound_CreateAtEntity("BrickCeilingImpact", "03_05_vitae_station/ghoul_events/ghoul_door_smash", "Target_BrickFallFrom");
			AddScareFear(0.5f, 3.0f, true, 1.0f, 0.1f, 0.4f);
			Voice_PlayDelayed("Dialogue_RandomReactions", 0.5);
			
			ImpactAboveDust(Map_GetEntity("Target_BrickFallFrom").GetPosition(), 0);
			ImpactAboveDustFall(Map_GetEntity("Target_BrickFallFrom").GetPosition(), 0.3);
		}
		
		//-------------------------------------------------------
		
		//} END Event H *Get scared by a spark near the ballista*
				
		/////////////////////////////////////////
		// Event I *See a gust of wind blow out candles*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlLivingAreaGust_LampLookAtCount = 0;
		int mlLivingAreaGust_LampLitCount = 0;
		float mfLivingAreaGust_NextLitCooldown = 0.0f;
		bool mbLivingAreaGust_FirstLamp = false;
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_LivingAreaLamp(const tString &in asEntity, int alState)
		{
			mlLivingAreaGust_LampLookAtCount += alState;
			if (alState == 1)
			{
				if (Map_TimerExists("Timer_CheckLivingAreaGustStart") == false) Map_AddTimer("Timer_CheckLivingAreaGustStart", 0.5f, "OnTimer_CheckLivingAreaGustStart");
			}
			else
			{
				if (mlLivingAreaGust_LampLookAtCount == 0) Map_RemoveTimer("Timer_CheckLivingAreaGustStart");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckLivingAreaGustStart(const tString &in asTimer)
		{
//			cLux_AddDebugMessage("CHECK " + Map_GetTimerTime("LivingAreaGustCooldown"));
			if (mlLivingAreaGust_LampLitCount > 0 && CanStartCreepyEvent() && Map_TimerExists("LivingAreaGustCooldown") == false)
			{
				mfLivingAreaGust_NextLitCooldown = cMath_RandRectf(60 * 1.5f, 60 * 3.0f);
				StartCreepyEvent_LivingAreaGust();
				Map_AddTimer("LivingAreaGustCooldown", mfLivingAreaGust_NextLitCooldown, "");
			}
			Map_AddTimer("Timer_CheckLivingAreaGustStart", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CheckLivingAreaGustStart");
		}
		
		//-------------------------------------------------------
		
		void OnConnectionChange_LampGust(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			
			++mlLivingAreaGust_LampLitCount;
			
			if (mbLivingAreaGust_FirstLamp == false)
			{
				mbLivingAreaGust_FirstLamp = true;
				Map_AddTimer("LivingAreaGustCooldown", 5.0f, "");
				cLux_AddDebugMessage("HERE");
			}
			else
			{
				if (Map_GetTimerTime("LivingAreaGustCooldown") < 2.0f)
				{
					Map_RemoveTimer("LivingAreaGustCooldown");
					Map_AddTimer("LivingAreaGustCooldown", 2.0f, "");
				}
			}
		}
		
		//-------------------------------------------------------
		
		void StartCreepyEvent_LivingAreaGust()
		{
			cLux_AddDebugMessage("[Map] Wind blows out candles");
			mbCreepyEvents_Paused = true;
			
			cSoundEntity@ pSound = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("LivingAreaGust", "02_04_living_quarters/scare_events/kitchen/kitchen_scare_room", true);
			cVector3f vToWindows = Map_GetEntity("Target_LivingAreaWindows").GetPosition() - Player_GetPosition();
			vToWindows.Normalize();
			pSound.SetPosition(Player_GetPosition() + vToWindows * 4.0f);
			
			Map_AddTimer("Timer_LivingAreaGustLampsOff", 0.8f, "OnTimer_LivingAreaGustLampsOff");
			Map_AddTimer("Timer_LivingAreaGustEnd", 2.0f, "OnTimer_LivingAreaGustEnd");
			
			AddScareFear(0.2f, 4.0f, true, 1.0f, 0.05f, 0.5f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LivingAreaGustEnd(const tString &in asTimer)
		{
			EndCreepyEvent(eCreepyEventType_Normal);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LivingAreaGustLampsOff(const tString &in asTimer)
		{
			array<iLuxEntity@> vEnts;
			Map_GetEntityArray("Lamp_LivingArea_*", vEnts);
			for (int i = 0; i < vEnts.size(); ++i)
			{
				iLuxEntity@ pEnt = vEnts[i];
				if (pEnt is null) continue;
				if (Player_GetDistanceToEntity(pEnt.GetName()) > 8.0f) continue;
				Map_AddTimer(pEnt.GetName(), cMath_RandRectf(0.0f, 1.0f), "OnTimer_LivingAreaGustLampOff");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LivingAreaGustLampOff(const tString &in asTimer)
		{
			if (Lamp_GetLit(asTimer)) --mlLivingAreaGust_LampLitCount;
			Lamp_SetLit(asTimer, false, true);
		}
		
		//-------------------------------------------------------
		
		//} END Event I *See a gust of wind blow out candles*
				
		/////////////////////////////////////////
		// Event J *See a hanging lamp fall down*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlLampFall_Count = 0;
		bool mbLampFall_Done = false;
		
		//-------------------------------------------------------
		
		void OnConnectionChange_LampFall(const tString &in asEntity, int alState)
		{
			return;
			
			Map_AddTimer(asEntity, 0.0f, "OnTimer_LampFallPush");
			++mlLampFall_Count;
			
			if (CanStartCreepyEvent() == false) return;
			if (mlLampFall_Count <= 1) return;
			if (mbLampFall_Done) return;
			
			mbLampFall_Done = true;
			Map_AddTimer(asEntity, 0.4f, "OnTimer_LampFallTurnOff");
			Map_AddTimer(asEntity, 0.6f, "OnTimer_LampFall");
			
			EndCreepyEvent(eCreepyEventType_Normal);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LampFallPush(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asTimer);
			if (pEnt is null) return;
			cVector3f vDir = pEnt.GetPosition() - Player_GetPosition();
			vDir.y = 0;
			pEnt.GetMainBody().AddImpulse(vDir * 0.4f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LampFallTurnOff(const tString &in asTimer)
		{
			Lamp_SetLit(asTimer, false, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LampFall(const tString &in asTimer)
		{
			cLux_AddDebugMessage("AAAAAAAAAAAA");
			iLuxEntity@ pEnt = Map_GetEntity(asTimer);
			if (pEnt is null) return;
			
			Sound_CreateAtEntity("LampChainBreak", "03_04_pillar_room/config_device/plate_solve_clunk", asTimer);
			pEnt.SetActive(false);
			
			cMatrixf mtxLamp = Map_GetEntity(asTimer).GetMainBody().GetWorldMatrix();
			iLuxEntity@ pNewLamp = Map_GetEntity("Lamp_Fallen");
			pNewLamp.SetActive(true);
			pNewLamp.GetMainBody().SetWorldMatrix(mtxLamp);
			
			pNewLamp.GetMainBody().AddImpulse(cVector3f_Zero);
			pNewLamp.GetMainBody().AddTorque(cVector3f(-10.0f, 0.0f, 0.0f));
		}
		
		//-------------------------------------------------------
		
		//} END Event J *See a hanging lamp fall down*
		
		//-------------------------------------------------------
		
		/////////////////////////////////////////
		// Event L *See the ghoul through the crack*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		tString msCommsRoomScare_Ghoul = "Ghoul_CommsRoom";
		bool mbCommsRoomScare_GhoulRunby = false;
		bool mbCommsRoomScare_CrakOnScreen = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterCommsRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_CommsRoomWallNoise", 1.0f, "OnTimer_CommsRoomWallNoise");
			Map_AddTimer("Timer_CommsRoomScare_GhoulStart", 5.0f, "OnTimer_CommsRoomScare_GhoulStart");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CommsRoomWallNoise(const tString &in asTimer)
		{
			Sound_CreateAtEntity("GhoulWallNoise", "creatures/foley/creature/ghoul/ghoul_LQ_steps", "Trigger_SoundCommsRoomScareWall", 0.0f, false, 0.6f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CommsRoomScare_GhoulStart(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_CommsRoomRunby", true);
			
			Entity_SetActive(msCommsRoomScare_Ghoul, true);
			
			FearThreatAgent_SetComponentEnabled(msCommsRoomScare_Ghoul, false);

			Ghoul_CommandPatrol_ClearNodes(msCommsRoomScare_Ghoul);
			Ghoul_CommandPatrol_AddNode(msCommsRoomScare_Ghoul, "PathNode_84");
			Ghoul_CommandPatrol_Execute(msCommsRoomScare_Ghoul, false, 1, false, eGhoulSpeed_Run, "OnCommandEnd_ComsRoomScare_GhoulExit");
			
			Map_AddTimer("Timer_CommsRoomScare_CheckVisible", 0.2f, "OnTimer_CommsRoomScare_CheckVisible");
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_ComsRoomScare_GhoulExit(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_CommsRoomRunby", false);
			
			Entity_SetActive(msCommsRoomScare_Ghoul, false);
			Sound_CreateAtEntity("GhoulCrawlIntoHole", "creatures/foley/creature/ghoul/ghoul_LQ_steps", msCommsRoomScare_Ghoul);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Ghoul_CommsRoomScareRunby(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbCommsRoomScare_GhoulRunby = alState == 1;
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_CommsRoomScareFear(const tString &in asEntity, int alState)
		{
			mbCommsRoomScare_CrakOnScreen = alState == 1;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CommsRoomScare_CheckVisible(const tString &in asTimer)
		{
			if (mbCommsRoomScare_GhoulRunby && mbCommsRoomScare_CrakOnScreen)
			{
				Map_AddTimer("Timer_CommsRoomScare_Scare", 0.5f, "OnTimer_CommsRoomScare_Scare");
				return;
			}
			Map_AddTimer("Timer_CommsRoomScare_CheckVisible", 0.2f, "OnTimer_CommsRoomScare_CheckVisible");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CommsRoomScare_Scare(const tString &in asTimer)
		{
			AddScareFear(0.6f, 5.0f, false, -1.0f, 0.1f, 0.0f);
		}
		
		//-------------------------------------------------------
		
		array<float> mvBallTimes;
		int mlLastBallTime = 0;
		tString msLastball;
		void OnInteract_CannonBall(const tString &in asEntity)
		{
			int lIndex = cString_GetNumericSuffixInt(asEntity);
			BallHit(lIndex);
			
			if (msLastball != asEntity) mvBallTimes.resize(0);
			msLastball = asEntity;
			
			float fDelta = Map_GetElapsedTime(mlLastBallTime);
			mlLastBallTime = Map_GetTimeStamp();
			
			mvBallTimes.push_back(fDelta);
			if (mvBallTimes.size() > 8)
			{
				mvBallTimes.removeAt(0);
				if (BallsInOrder()) Seq_BallFinale("");
			}
		}
		
		int mlBallHitIndex = 0;
		void BallHit(int alIndex, bool abSmall = true)
		{
//			Map_GetEntity("telegraph_key_" + alIndex).GetBodyFromName("Body_1").AddTorque(cVector3f(10,0,0));
			Entity_AddTorque("telegraph_key_" + alIndex, cVector3f(0,0,0.9), true, false);
			if (abSmall) Sound_CreateAtEntity("Key", "02_04_living_quarters/winch/winch_stop", "telegraph_key_" + alIndex, 0, false, 1, 3, 10);
			else Sound_CreateAtEntity("Key", "02_04_living_quarters/winch/winch_stop", "telegraph_key_" + alIndex, 0, false, 1, 3, 10);
		}
		
		void OnTimer_BallHitBig(const tString &in asTimer)
		{
			Entity_AddTorque("telegraph_key_" + mlBallHitIndex, cVector3f(0,0,0.4), true, false);
		}
				
		bool BallsInOrder()
		{
			if (mvBallTimes.size() != 8) return false;
			float fTar = mvBallTimes[0];
			if (fTar > 1.5) return false;
			if (cMath_Abs(mvBallTimes[1] - fTar) / fTar > 0.2) return false;
			if (mvBallTimes[2] > fTar && cMath_Abs(mvBallTimes[2] - fTar) / fTar > 2.0) return false;
			if (cMath_Abs(mvBallTimes[3] - (fTar * 2)) / (fTar * 2) > 0.4) return false;
			if (cMath_Abs(mvBallTimes[4] - (fTar * 2)) / (fTar * 2) > 0.4) return false;
			if (cMath_Abs(mvBallTimes[5] - (fTar * 2)) / (fTar * 2) > 2.0) return false;
			if (cMath_Abs(mvBallTimes[6] - fTar) / fTar > 0.6) return false;
			if (cMath_Abs(mvBallTimes[7] - fTar) / fTar > 0.2) return false;
			return true;
		}
		
		int mlBallIndex = -1;
		cSequenceStatesData mSequenceBallFinale;
		void Seq_BallFinale(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BallFinale", mSequenceBallFinale);
			if (Sequence_DoStepAndWait(0.25))
			{
				mlBallIndex = cString_GetNumericSuffixInt(msLastball) == 2 ? 3 : 2;
				Entity_SetInteractionDisabled("Trigger_Ball_" + mlBallIndex, false);
			}
			else if (Sequence_DoStepAndWait(0.05))
			{
				Sound_CreateAtEntity("BallZap", "02_04_living_quarters/scare_events/light_scare/spark_scare", "telegraph_key_" + mlBallIndex);
				ParticleSystem_CreateAtEntity("Zap", "sparks_tiny", "telegraph_key_" + mlBallIndex, false);
				Light_FadeBrightnessTo("Light_BallF_" + mlBallIndex, 3.0, 0.05f, eEasing_SineOut);
			}
			else if (Sequence_DoStepAndWait(0.9))
			{
				Light_FadeBrightnessTo("Light_BallF_" + mlBallIndex, 0, 0.1f);
			}
			else if (Sequence_DoStepAndWait(0.4)) BallHit(mlBallIndex, false);
			else if (Sequence_DoStepAndWait(0.2)) BallHit(mlBallIndex);
			else if (Sequence_DoStepAndWait(0.4)) BallHit(mlBallIndex, false);
			else if (Sequence_DoStepAndWait(1.0)) BallHit(mlBallIndex, false);
			
			else if (Sequence_DoStepAndWait(0.4)) BallHit(mlBallIndex, false);
			else if (Sequence_DoStepAndWait(0.4)) BallHit(mlBallIndex, false);
			else if (Sequence_DoStepAndWait(1.0)) BallHit(mlBallIndex, false);
			
			else if (Sequence_DoStepAndWait(0.2)) BallHit(mlBallIndex);
			else if (Sequence_DoStepAndWait(0.2)) BallHit(mlBallIndex);
			else if (Sequence_DoStepAndWait(0.8)) BallHit(mlBallIndex, false);
			
			else if (Sequence_DoStepAndWait(0.4)) BallHit(mlBallIndex, false);
			else if (Sequence_DoStepAndWait(0.2)) BallHit(mlBallIndex);
			else if (Sequence_DoStepAndWait(0.8)) BallHit(mlBallIndex);
			
			else if (Sequence_DoStepAndWait(0.2)) BallHit(mlBallIndex);
			else if (Sequence_DoStepAndWait(0.8)) BallHit(mlBallIndex);
			
			else if (Sequence_DoStepAndWait(0.2)) BallHit(mlBallIndex);
			else if (Sequence_DoStepAndWait(1))
			{
				Entity_SetInteractionDisabled("Trigger_Ball_" + mlBallIndex, false);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------

		//} END Event L *See the ghoul through the crack*
		
		/////////////////////////////////////////
		// Event M *A bucket tips over*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		void OnLookAt_StartBucketRoll(const tString &in asEntity, int alState)
		{
			if (CanStartCreepyEvent())
			{
				Seq_BucketRoll("");
			}
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceBucketRoll;
		void Seq_BucketRoll(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BucketRoll", mSequenceBucketRoll);
			if (Sequence_DoStepAndWait(0.2))
			{
				mbCreepyEvents_Paused = true;
				if (Map_GetEntity("Trigger_PreventRandomCreepyNoise_2").CollidesWithPlayer())
				{
					--mlCreepyEvents_PreventRandomNoiseAreas;
				}
				
				Entity_SetActive("Trigger_PreventRandomCreepyNoise_2", false);
				Entity_SetActive("Trigger_StartBucketRoll", false);
				
				Sound_CreateAtEntity("ImpactAbove", "02_04_living_quarters/scare_events/ceiling_bump", "Target_BucketRollAbove", 0, false, 1);
				
				ImpactAboveDust(Map_GetEntity("Target_BucketRollAbove").GetPosition(), 0);
				ImpactAboveDustFall(Map_GetEntity("Target_BucketRollAbove").GetPosition(), 0.2);		
			}
			else if (Sequence_DoStepAndWait(1))
			{
				Prop_SetStaticPhysics("BucketRoll", false);
				Entity_AddTorque("BucketRoll", cVector3f(0, 0, -1) * 10, true, true);
			}
			else if (Sequence_DoStepAndWait(1))
			{
				EndCreepyEvent(eCreepyEventType_Minor);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		//} END Event M *A bucket tips over*
		
		/////////////////////////////////////////
		// Event M *Notice that an open door has been closed*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlDoorsMoved = 0;
		
		//-------------------------------------------------------
		
		void OnLookAt_SeeDoor(const tString &in asEntity, int alState)
		{
			if (mlDoorsMoved >= 3) return;
			
			tString doorEnt = Entity_GetVarString(asEntity, "");
			if (Entity_GetVarBool(doorEnt, "DoorMoved") == false)
			{
				Map_AddTimer(doorEnt, 0, "OnTimer_CheckDoorMove");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckDoorMove(const tString &in asTimer)
		{
			if (mlDoorsMoved >= 3) return;
			
			Map_RestartCurrentTimer(cMath_RandRectf(0.2, 0.6));
			if (Player_GetDistanceToEntity(asTimer) <= 12) return;
			
			float fOpen = SwingDoor_GetOpenAmount(asTimer);
			if (fOpen > 0.25 && fOpen < 0.4) return;
			
			if (Map_GetEntity(asTimer).CheckIsOnScreen(true)) return;
			
			cLux_AddDebugMessage("[Map] Door moved");
			
			++mlDoorsMoved;
			Entity_SetVarBool(asTimer, "DoorMoved", true);
			if (fOpen > 0.5) SwingDoor_PushOpen(asTimer, -1, 3, 0.2);
			else SwingDoor_PushOpen(asTimer, 1, 3, 0.2);
			
			Map_RemoveTimer(asTimer);
		}
		
		//-------------------------------------------------------
		
		//} END Event M *Notice that an open door has been closed*
		
