		/////////////////////////////////////////
		// Event D *Escape the trap set up by the ghoul*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbFirstEncounter_Started = false;
		bool mbFirstEncounter_PlayerPermaFailed = false;
		int mlTrap_BlockCount = 0;
		bool mbFirstEncounter_GhoulReachedDeadEnd = false;
		bool mbGhoulChase_Cancel = false;

		//-------------------------------------------------------
		
		bool OnCollide_Player_TrapCorridor(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_CheckWorkShopDoor", 0.2, "OnTimer_CheckWorkShopDoor");
				Entity_SetActive("Trigger_WorkshopDoorBlockDetector", true);
			}
			else
			{
				Map_RemoveTimer("Timer_CheckWorkShopDoor");
				Entity_SetActive("Trigger_WorkshopDoorBlockDetector", false);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_TrapBlocker_WorkshopDoorBlockDetector(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlTrap_BlockCount += alState;
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckWorkShopDoor(const tString &in asTimer)
		{
			float fDoorAngle = SwingDoor_GetOpenAmount("SafeRoomDoor_Workshop");
			if (fDoorAngle >= 0.26 || mlTrap_BlockCount <= 0)
			{
				StartFirstEncounter();
				return;
			}
			Map_RestartCurrentTimer(cMath_RandRectf(0.1, 0.3));
		}
		
		//-------------------------------------------------------
		
		bool OnCollideTrigger_ExitWorkshop(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_GhoulStairChase("");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_Player_StartFirstEncounter(const tString &in asEntity)
		{
			StartFirstEncounter();
		}
		
		//-------------------------------------------------------
		
		void StartFirstEncounter()
		{
			if (mbReturnTripActive) return;
			if (mbFirstEncounter_Started) return;
			mbFirstEncounter_Started = true;
			
			Seq_GhoulReveal("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceGhoulReveal;
		void Seq_GhoulReveal(const tString &in asTimer)
		{
			Sequence_Begin("Seq_GhoulReveal", mSequenceGhoulReveal);
			if (Sequence_DoStepAndWait(1.0))
			{
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				Entity_SetActive("Trigger_ExitWorkshop", true);
				Entity_SetActive("Trigger_ExitWorkshop", true);
				Entity_SetActive("Trigger_GhoulReachDoor", true);
				Entity_SetActive("Trigger_GhoulEnterDeadEnd", true);
				Entity_SetActive("Trigger_GhoulStopHunt", true);
				Entity_SetActive("Trigger_CancelGhoulChase", true);
				
				Entity_SetActive("Ghoul_Workshop", true);
				Ghoul_SetInstantKill("Ghoul_Workshop", true);
				Ghoul_SetSmellingActive("Ghoul_Workshop", false);
				Agent_SetSensesActive("Ghoul_Workshop", false);
				
//				CharMover_SetDynamicObjectAvoidanceActive("Ghoul_Workshop", false);
				
				Sound_CreateAtEntity("GhoulEmerge", "creatures/vocalisations/creature/ghoul/ghoul_exit_hole", "Ghoul_Workshop");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Ghoul_CommandThreatenPlayer_Execute("Ghoul_Workshop", 9, false, true, 6, 9, true);
			}
			// ghoul opens workshop door
			else if (Sequence_DoStepAndWait(1.0))
			{
				Agent_SetSensesActive("Ghoul_Workshop", true);
				
				Sound_CreateAtEntity("GhoulOpenDoor", "03_05_vitae_station/ghoul_events/ghoul_door_smash", "Ghoul_Workshop");
			
				iPhysicsBody@ pBody = Map_GetEntity("Door_WorkshopStorage").GetMainBody();
				if (pBody !is null) pBody.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-agent"));
				Map_AddTimer("Timer_ResetDoorAgentCollision", 2.5, "OnTimer_ResetDoorAgentCollision");
				
				SwingDoor_SetBlocked("Door_WorkshopStorage", false, false);
				SwingDoor_PushOpen("Door_WorkshopStorage", 1.5, 4, 0.2);
				
				Billboard_SetVisible("Billboard_saltpeter_storage_door_*", false);
				Light_FadeBrightnessTo("Light_saltpeter_storage_door_*", 0, 0.5);
				
				iLuxEntity@ pImpulseArea = Map_GetEntity("Target_GhoulOpenDoorImpulse");
				
				array<iPhysicsBody@> vBodies;
				cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(pImpulseArea.GetMainBody().GetBoundingVolume().GetMin(), pImpulseArea.GetMainBody().GetBoundingVolume().GetMax(), vBodies);
				for (int i = 0; i < vBodies.size(); ++i)
				{
					iPhysicsBody@ pBody = vBodies[i];
					if (pBody is null) continue;
					iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
					if (pEnt is null) continue;
					
					if (pEnt.GetEntityType() != eLuxEntityType_Prop) continue;
					
					Entity_AddImpulseFromEntity(pEnt.GetName(), "Target_GhoulOpenDoorImpulseSource", 10, true);
				}
			}
			else if (Sequence_DoStepAndWait(1.0))
			{
				if (mbGhoulChase_Cancel) Ghoul_Mode_Set("Ghoul_Workshop", eGhoulMode_Hunt, true);
				Music_Play("A2_3_4_GhoulEvent", 0.6, true, eMusicPrio_BigEvent);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_CancelGhoulChase(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbGhoulChase_Cancel = true;
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetDoorAgentCollision(const tString &in asTimer)
		{
			iPhysicsBody@ pBody = Map_GetEntity("Door_WorkshopStorage").GetMainBody();
			if (pBody !is null) pBody.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag(""));
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_WorkShopGhoul(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_SeesGhoul");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceGhoulStairChase;
		void Seq_GhoulStairChase(const tString &in asTimer)
		{
			Sequence_Begin("Seq_GhoulStairChase", mSequenceGhoulStairChase);
			// player leaves the room
			if (Sequence_DoStepAndPause(0))
			{
				Hint_StopHint();
				Map_AddTimer("Timer_ShowRunHint", 2.f, "OnTimer_ShowRunHint");
				
				Entity_SetActive("Trigger_PastWorkshopHole", true);
				Entity_SetActive("Trigger_LookAtWorkShopHole", true);
				
				Music_Stop(1.0, eMusicPrio_BigEvent);
				Music_Play("A2_NPC_Ghoul_Chase", 0.4f, true, eMusicPrio_OverrideAll);
				Sound_CreateAtEntity("StartChaseScream", "creatures/vocalisations/creature/ghoul/ghoul_awaken_scream", "Ghoul_Workshop");
				
				Agent_SetDeafened("Ghoul_Workshop", true, -1);
				Ghoul_Mode_Set("Ghoul_Workshop", eGhoulMode_Hunt, true);
				
				Entity_SetPlayerLookAtCallback("Ghoul_Workshop", "");
				
				Player_FadeMoveSpeedMulTo(0.75, 0.25, ePlayerMoveSpeedMulType_Script);
			}
			// ghoul reaches door
			else if (Sequence_DoStepAndWait(0.25))
			{
				// close door
				SwingDoor_PushOpen("SafeRoomDoor_Workshop", -6);
				
				Ghoul_Command_Remove("Ghoul_Workshop");
				Ghoul_Mode_Set("Ghoul_Workshop", eGhoulMode_Hunt, true);
				
				Ghoul_SetAdjustHuntSpeed("Ghoul_Workshop", true, 0.6);
				
				Player_FadeMoveSpeedMulTo(1, 0.8, ePlayerMoveSpeedMulType_Script);
			}
			else if (Sequence_DoStepAndPause(0))
			{
				// smash door
				Prop_SetHealth("SafeRoomDoor_Workshop", 0);
//				Sound_CreateAtEntity("GhoulSmashDoor", "03_05_vitae_station/ghoul_events/ghoul_door_smash", "SafeRoomDoor_Workshop");
//				ParticleSystem_CreateAtEntity("DoorBreak", "02_04_cannon_floor_partial_break", "SafeRoomDoor_Workshop", false);
			}
			// try to give up on the player
			else if (Sequence_DoStepAndWait(0))
			{
				Agent_SetDeafened("Ghoul_Workshop", false, -1);
				Ghoul_Mode_Set("Ghoul_Workshop", eGhoulMode_Idle, false);
				
				if (cLux_CheckLineOfSight(Player_GetPosition(), Map_GetEntity("Ghoul_Workshop").GetPosition(), false, false) == false)
				{
					cLux_AddDebugMessage("[Map] Lost player");
					Ghoul_Command_Remove("Ghoul_Workshop", false);
					Ghoul_CommandPatrol_ClearNodes("Ghoul_Workshop");
					Ghoul_CommandPatrol_AddNode("Ghoul_Workshop", "PathNode_EndChaseInvestigate");
					Ghoul_CommandPatrol_Execute("Ghoul_Workshop", true, 1, false, eGhoulSpeed_Run, "OnCommandEnd_GhoulGiveUp");
					
					Ghoul_SetCallback_Alerted("Ghoul_Workshop", "OnAlert_ReturnToHoleCommand");
				}
				else
				{
					cLux_AddDebugMessage("[Map] Continue running");
					Seq_GhoulLeavesThroughHole("");
				}
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnBreak_WorkshopDoor(const tString &in asEntity)
		{
			iLuxEntity@ pBrokenEnt = Map_GetEntity(asEntity + "_broken");
			if (pBrokenEnt is null) return;
			for (int i = 0; i < pBrokenEnt.GetBodyNum(); ++i)
			{
				iPhysicsBody@ pBody = pBrokenEnt.GetBody(i);
				if (pBody is null) continue;
				
				pBody.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag("-agent"));
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowRunHint(const tString &in asTimer)
		{
			if (Player_GetRunning() == false)
				Hint_ShowHint("Hints", "HintRun", true, 1.5f, false);
		}
		
		//-------------------------------------------------------
		
		void OnAlert_ReturnToHoleCommand(const tString &in asEntity)
		{
			Seq_GhoulLeavesThroughHole("");
		}
		
		//-------------------------------------------------------
		
		void OnIdle_StopGhoulChaseMusic()
		{
			Music_Stop(1, eMusicPrio_OverrideAll);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Ghoul_StopHunt(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceStates_Resume("Seq_GhoulStairChase");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Ghoul_ReachDoor(const tString &in asParent, const tString &in asChild, int alState)
		{
			SequenceStates_Resume("Seq_GhoulStairChase");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Ghoul_EnterDeadEnd(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbFirstEncounter_GhoulReachedDeadEnd = true;
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_WorkShopHole(const tString &in asEntity, int alState)
		{
			if (mbFirstEncounter_GhoulReachedDeadEnd) return;
			Seq_GhoulRunsPastWorkshopHole("");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_PastWorkshopHole(const tString &in asParent, const tString &in asChild, int alState)
		{
			Player_FadeMoveSpeedMulTo(1, 0.8, ePlayerMoveSpeedMulType_Script);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_GhoulGiveUp(const tString &in asEntity)
		{
			Music_Stop(1, eMusicPrio_OverrideAll);
			Sound_CreateAtEntity("GhoulFrustration", "creatures/vocalisations/creature/ghoul/ghoul_frustration", "Ghoul_Workshop");
			CharMover_PlayAnimation("Ghoul_Workshop", "frustration", 0.3f, false, true, "OnAnimationOver_GhoulReturnToWorkshop");
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_GhoulReturnToWorkshop(const tString &in asEntityName, const tString &in asAnimName)
		{
			Ghoul_SetCallback_Alerted("Ghoul_Workshop", "");
			Seq_GhoulLeavesThroughHole("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceGhoulRunsPastWorkshopHole;
		void Seq_GhoulRunsPastWorkshopHole(const tString &in asTimer)
		{
			Sequence_Begin("Seq_GhoulRunsPastWorkshopHole", mSequenceGhoulRunsPastWorkshopHole);
			if (Sequence_DoStepAndWait(0))
			{
				Entity_SetActive("Ghoul_Workshop", true);
				
				Light_FadeBrightnessTo("Light_GhoulChaseBackdrop*", 0.06, 0.5);
				
				Map_GetEntity("Ghoul_Workshop").GetMainBody().GetCharacterBody().SetFeetPosition(Map_GetEntity("Target_GhoulChaseStart").GetPosition(), false);
				Ghoul_Command_Remove("Ghoul_Workshop", true);
				Ghoul_CommandPatrol_ClearNodes("Ghoul_Workshop");
				Ghoul_CommandPatrol_AddNode("Ghoul_Workshop", "PathNode_22");
				Ghoul_CommandPatrol_Execute("Ghoul_Workshop", true, 1, false, eGhoulSpeed_QuickAccelRun);
			}
			else if (Sequence_DoStepAndWait(0))
			{
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequenceGhoulLeavesThroughHole;
		void Seq_GhoulLeavesThroughHole(const tString &in asTimer)
		{
			Sequence_Begin("Seq_GhoulLeavesThroughHole", mSequenceGhoulLeavesThroughHole);
			if (Sequence_DoStepAndPause(0))
			{
				Music_Stop(1, eMusicPrio_BigEvent);
				
				Ghoul_Command_Remove("Ghoul_Workshop", false);
				Ghoul_CommandPatrol_ClearNodes("Ghoul_Workshop");
				Ghoul_CommandPatrol_AddNode("Ghoul_Workshop", "PathNode_152");
				Ghoul_CommandPatrol_Execute("Ghoul_Workshop", false, 1, false, eGhoulSpeed_FastWalk, "OnCommandEnd_GhoulEnterHole");
				cLux_AddDebugMessage("HAPPENS AGAIN");
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Agent_SetSensesActive("Ghoul_Workshop", false);
				CharMover_TurnToEntity("Ghoul_Workshop", "Target_GhoulHoleDir");
			}
			else if (Sequence_DoStepAndWait(0))
			{
				CharMover_PlayAnimation("Ghoul_Workshop", "idle_to_crawl", 0.3, false, false, "OnAnimationEnd_GhoulDisappears");
				Sound_CreateAtEntity("GhoulHoleExit", "creatures/foley/creature/ghoul/ghoul_hole/ghoul_enter_hole", "Ghoul_Workshop");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_GhoulEnterHole(const tString &in asEntity)
		{
			if (Map_GetEntity("Trigger_GhoulExitZone").CollidesWithPlayer() == false)
			{
				SequenceStates_Resume("Seq_GhoulLeavesThroughHole");
			}
			else
			{
				mSequenceGhoulLeavesThroughHole.mlStateCounter = 0;
				Agent_RevealPlayerPosition("Ghoul_Workshop", true);
				Map_AddTimer("Timer_RestartEnterHole", 1.0f, "OnTimer_RestartEnterHole");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RestartEnterHole(const tString &in asTimer)
		{
			Seq_GhoulLeavesThroughHole("");
		}
		
		//-------------------------------------------------------
		
		void OnAnimationEnd_GhoulDisappears(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive("Ghoul_Workshop", false);
		}
		
		//-------------------------------------------------------

		//} END Event D *Escape the trap set up by the ghoul*
		
		/////////////////////////////////////////
		// Event E *Exit the level*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbExit_CanPlayDialogue = true;
		int mlExit_LookingThroughGrate = 0;
		float mfExit_LookAtExitTimer = 0.0f;

		//-------------------------------------------------------
		
		void OnLookAt_Player_LookThroughGrate(const tString &in asEntity, int alState)
		{
			mlExit_LookingThroughGrate += alState;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_LookAtExit(const tString &in asEntity, int alState)
		{
			if (alState == 1)
			{
				mfExit_LookAtExitTimer = 0.0f;
				Map_AddTimer("Timer_CheckLookAtExit", 0.2f, "OnTimer_CheckLookAtExit");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckLookAtExit");
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckLookAtExit(const tString &in asTimer)
		{
			if (mlExit_LookingThroughGrate > 0)
			{
				mfExit_LookAtExitTimer += 0.2f;
				if (mfExit_LookAtExitTimer >= 1.5f && Map_TimerExists("Timer_Exit_CooldownEnd") == false)
				{
					Map_AddTimer("Timer_Exit_CooldownEnd", 10.0f, "");
					Voice_Play("Dialogue_SeeExit");
				}
			}
			else
			{
				mfExit_LookAtExitTimer = 0.0f;
			}
			Map_AddTimer("Timer_CheckLookAtExit", 0.2f, "OnTimer_CheckLookAtExit");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Player_ExitDialogue(const tString &in asEntity, int alState)
		{
			if (alState != 1) return;
			if (mbExit_CanPlayDialogue == false) return;
			
			mbExit_CanPlayDialogue = false;
			Map_AddTimer("Timer_Exit_PlayVoice", 1.0f, "OnTimer_Exit_PlayVoice");
			Map_AddTimer("Timer_Exit_CooldownEnd", 10.0f, "OnTimer_Exit_CooldownEnd");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Exit_PlayVoice(const tString &in asTimer)
		{
			Voice_PlayWhenPossible("Dialogue_SeeExit");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Exit_CooldownEnd(const tString &in asTimer)
		{
			mbExit_CanPlayDialogue = true;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_ExitDoor(const tString &in asEntity)
		{
			if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio") && !mbHadAlreadyAnsweredRadio)
			{
				if (mbHadAlreadyAnsweredRadio == false)
				{
					mbHadAlreadyAnsweredRadio = true;
					LoadScreen_ProgressStory();
				}
				cScript_SetGlobalVarBool("Outpost_LQ_FirstTripComplete", true);
			}
			
			if (cScript_GetGlobalVarBool("Outpost_GotSaltpeter")==false)
			{
				if (ItemType_GetCountInInventory("Saltpeter_Powder") >= 1)
				{
					cScript_SetGlobalVarBool("Outpost_GotSaltpeter", true);
					LoadScreen_ProgressStory();
				}
			}
			
			mbReturnTripActive = false;
			Entity_SetActive("Ghoul_Workshop", false);
		}
		
		//-------------------------------------------------------
		
		void OnInteract_EntranceDoor(const tString &in asEntity)
		{
			mbReturnTripActive = false;
		}
		
		//-------------------------------------------------------

		//} END Event E *Exit the level*

	//} END SCENE 5
	
