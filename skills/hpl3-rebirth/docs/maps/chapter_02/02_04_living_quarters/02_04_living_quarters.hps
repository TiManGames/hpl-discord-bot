		/////////////////////////////////////////
		// Event A *See the ghoul through the exit grate*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		int mlExitSightingNoiseCount = 0;
		bool mbExitSightingNoisesActive = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_EnterReturnTripArea(const tString &in asParent, const tString &in asChild, int alState)
		{
//			InitBrokenFloor();
			if (alState == 1 && cScript_GetGlobalVarBool("Outpost_AnsweredRadio")) SetupReturnTrip(1);
			return true;
		}
		
		//-------------------------------------------------------
		
		void SetupReturnTrip(int alEntrance)
		{
			if (cScript_GetGlobalVarBool("Outpost_LQ_FirstTripComplete") == false) return;
			
			SwingDoor_SetOpenAmount("Door_FirstCorridor", 0.3);
			Entity_SetActive("ReturnTrip_Before_*", false);
			Entity_SetActive("ReturnTrip_After_*", true);
			
			if (mbReturnTripActive) return;
			if (mbSaltpetrePickedUp) return;
			mbReturnTripActive = true;
			mlReturnTripId = alEntrance;
			
			cLux_AddDebugMessage("[Map] SetupReturnTrip " + alEntrance);
			
			SetMapSafety(false);
			
			FearHandler_SetPermaFailRespawnArea("PermaFail_CellarAccess");
			
			Entity_SetActive("Radio_Pickup", false);
			Entity_SetActive("TrapBlocker_*", false);
			Entity_SetActive("Trigger_Memory_WebbsDeath", false);
			Entity_SetActive("Trigger_WebbersCorpseDialogue", true);
			
			Entity_SetActive("Radio", false);
			Entity_SetActive("Target_PickUpRadio", false);
			Entity_SetActive("Trigger_LookAtRadioBarks", false);
						
			Slide_SetSlideAmount("DoorLock_Workshop", 1);
			SwingDoor_SetBlocked("SafeRoomDoor_Workshop", false, false);
			SwingDoor_SetOpenAmount("SafeRoomDoor_Workshop", 0.9f);
			
			SwingDoor_SetBlocked("Door_WorkshopStorage", false, false);
			SwingDoor_SetOpenAmount("Door_WorkshopStorage", 0.7f);
			
			Entity_SetActive("storage_box_reserves_modern_9", false);
			
			Map_AddTimer("Timer_UpdateElectricPowerSystem", 2, "OnTimer_UpdateElectricPowerSystem");
			
			Light_SetBrightness("Light_saltpeter_storage_door_*", 0);
			
			Light_FadeTo("Light_ReturnTripStorage_*", cColor(1,0.682,0.502,0.196), 3, 0.2);
			
			// front
			if (alEntrance == 0)
			{
				SwingDoor_SetBlocked("Door_MapRoom", false, false);
				SwingDoor_SetOpenAmount("Door_MapRoom", 0.8);
				
				Entity_SetActive("Ghoul_ReturnTrip_1", true);
				Agent_SetSensesActive("Ghoul_ReturnTrip_1", false);
				Entity_SetActive("Trigger_ActivateGhoulSenses_1", true);
				Ghoul_SetCallback_Alerted("Ghoul_ReturnTrip_1", "OnGhoulAlert_Leave_1");
				Ghoul_SetSmellingActive("Ghoul_ReturnTrip_1", false);
				
				Map_AddTimer("Timer_StartReturnTripGhoul1", 1.0f, "OnTimer_StartReturnTripGhoul1");
			}
			
			// back
			else if (alEntrance == 1)
			{
				Entity_SetActive("Ghoul_ReturnTrip_2", true);
				Agent_SetSensesActive("Ghoul_ReturnTrip_2", false);
				Entity_SetActive("Trigger_ActivateGhoulSenses_2", true);
				Ghoul_SetCallback_Alerted("Ghoul_ReturnTrip_2", "OnGhoulAlert_Leave_2");
				Ghoul_SetSmellingActive("Ghoul_ReturnTrip_2", false);
				
				Map_AddTimer("Timer_StartReturnTripGhoul2", 1.0f, "OnTimer_StartReturnTripGhoul2");
			}
			
			Music_Play("A2_2_4_LivingQuarters_Return.ogg", 0.2f, true, eMusicPrio_BgAmb);
			Entity_SetActive("Trigger_MusicStart", false);
			
			SwingDoor_SetBlocked("Door_WorkshopEntrance", false, false);
			SwingDoor_SetOpenAmount("Door_WorkshopEntrance", 0.8);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartReturnTripGhoul1(const tString &in asTimer)
		{
			CharMover_PlayAnimation("Ghoul_ReturnTrip_1", "eat_lizard", 0.5f, true);
			Sound_CreateAtEntityCustom("GhoulEating_1", "creatures/vocalisations/creature/ghoul/ghoul_eating", "Ghoul_ReturnTrip_1", 32, 10);
//			Agent_SetSensesActive("Ghoul_ReturnTrip_1", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartReturnTripGhoul2(const tString &in asTimer)
		{
			CharMover_PlayAnimation("Ghoul_ReturnTrip_2", "eat_lizard", 0.5f, true);
			Sound_CreateAtEntityCustom("GhoulEating_2", "creatures/vocalisations/creature/ghoul/ghoul_eating", "Ghoul_ReturnTrip_2", 38, 10);
//			Agent_SetSensesActive("Ghoul_ReturnTrip_2", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartReturnTripGhoulLeave_1(const tString &in asTimer)
		{
			Ghoul_CommandPatrol_ClearNodes("Ghoul_ReturnTrip_1");
			Ghoul_CommandPatrol_AddNode("Ghoul_ReturnTrip_1", "PathNode_70");
			Ghoul_CommandPatrol_Execute("Ghoul_ReturnTrip_1", false, 1, false, eGhoulSpeed_FasterWalk, "OnCommandComplete_RemoveReturnTripGhoul_1");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartReturnTripGhoulLeave_2(const tString &in asTimer)
		{
			Ghoul_CommandPatrol_ClearNodes("Ghoul_ReturnTrip_2");
			Ghoul_CommandPatrol_AddNode("Ghoul_ReturnTrip_2", "PathNode_202");
			Ghoul_CommandPatrol_Execute("Ghoul_ReturnTrip_2", false, 1, false, eGhoulSpeed_FasterWalk, "OnCommandComplete_RemoveReturnTripGhoul_2");
		}
		
		//-------------------------------------------------------
		
		void OnGhoulAlert_Leave_1(const tString &in asEntity)
		{
			Sound_Stop("GhoulEating_1", 0.5);
			Map_AddTimer("Timer_StartReturnTripGhoulLeave_1", 0, "OnTimer_StartReturnTripGhoulLeave_1");
		}
		
		//-------------------------------------------------------
		
		void OnGhoulAlert_Leave_2(const tString &in asEntity)
		{
			Sound_Stop("GhoulEating_2", 0.5);
			Map_AddTimer("Timer_StartReturnTripGhoulLeave_2", 0, "OnTimer_StartReturnTripGhoulLeave_2");
		}
		
		//-------------------------------------------------------
		
		void OnCommandComplete_RemoveReturnTripGhoul_1(const tString &in asEntity)
		{
			if (cLux_CheckLineOfSight(Player_GetCameraPosition(), Map_GetEntity("Ghoul_ReturnTrip_1").GetPosition(), false, false) == false)
			{
				Entity_SetActive("Ghoul_ReturnTrip_1", false);
			}
			else
			{
				Agent_RevealPlayerPosition("Ghoul_ReturnTrip_1", true);
				Map_AddTimer("Timer_StartReturnTripGhoulLeave_1", 0.5, "OnTimer_StartReturnTripGhoulLeave_1");
			}
		}
		
		//-------------------------------------------------------
		
		void OnCommandComplete_RemoveReturnTripGhoul_2(const tString &in asEntity)
		{
			if (cLux_CheckLineOfSight(Player_GetCameraPosition(), Map_GetEntity("Ghoul_ReturnTrip_2").GetPosition(), false, false) == false)
			{
				Entity_SetActive("Ghoul_ReturnTrip_2", false);
			}
			else
			{
				Agent_RevealPlayerPosition("Ghoul_ReturnTrip_2", true);
				Map_AddTimer("Timer_StartReturnTripGhoulLeave_2", 0.5, "OnTimer_StartReturnTripGhoulLeave_2");
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_ExitGrateSightingArea(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Map_AddTimer("Timer_CheckExitGrateSighting", 0.0f, "OnTimer_CheckExitGrateSighting");
			}
			else
			{
				Map_RemoveTimer("Timer_CheckExitGrateSighting");
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ExitSightingNoises(const tString &in asTimer)
		{
			if (mbExitSightingNoisesActive == false) return;
			++mlExitSightingNoiseCount;
			
			Sound_Play("Sound_GhoulEat", 1.0f);
			
			float fNext = mlExitSightingNoiseCount <= 5 ? cMath_RandRectf(2.0f, 4.0f) : cMath_RandRectf(10.0f, 20.0f);
			Map_AddTimer("Timer_ExitSightingNoises", fNext, "OnTimer_ExitSightingNoises");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckExitGrateSighting(const tString &in asTimer)
		{
			if (mlExit_LookingThroughGrate > 0 && Map_GetEntity("Ghoul_ExitAreaSighting").CheckIsOnScreen(false))
			{
				mbExitSightingNoisesActive = false;
				Ghoul_CommandPatrol_ClearNodes("Ghoul_ExitAreaSighting");
				Ghoul_CommandPatrol_AddNode("Ghoul_ExitAreaSighting", "PathNode_144");
				Ghoul_CommandPatrol_Execute("Ghoul_ExitAreaSighting", true, 1, false, eGhoulSpeed_Walk, "OnCommandEnd_ExitGreatSighting");
				
				Sound_Stop("Sound_GhoulEat", 1.0f);
				
				Entity_SetActive("Trigger_ExitGrateSightingArea", false);
				return;
			}
			Map_AddTimer("Timer_CheckExitGrateSighting", cMath_RandRectf(0.1f, 0.2f), "OnTimer_CheckExitGrateSighting");
		}
		
		//-------------------------------------------------------
		
		void OnCommandEnd_ExitGreatSighting(const tString &in asEntity)
		{
			Entity_SetActive("Ghoul_ExitAreaSighting", false);
		}
		
		//-------------------------------------------------------

		//} END Event A *See the ghoul through the exit grate*
		
		/////////////////////////////////////////
		// Event B *Hear the ghoul while exploring*
		//{//////////////////////////////////////

		//-------------------------------------------------------
		
		bool mbReturnTripNoisesActive = false;
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_StartReturnTripNoises(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Ghoul_ExitAreaSighting", false);
			Entity_SetActive("Trigger_ExitGrateSightingArea", false);
			Entity_SetActive("Trigger_StartReturnTripNoises_*", false);
			Sound_Stop("Sound_GhoulEat", 0.2);
			mbExitSightingNoisesActive = false;
			
			StartReturnTripNoises();
			return false;
		}
		
		//-------------------------------------------------------
		
		void StartReturnTripNoises()
		{
			if (mbReturnTripNoisesActive) return;
			mbReturnTripNoisesActive = true;
			Map_AddTimer("Timer_ReturnTripNoise", 4.0f, "OnTimer_ReturnTripNoise");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ReturnTripNoise(const tString &in asTimer)
		{
			iLuxEntity@ pClosest;
			float fClosestDist = -1.0f;
			array<iLuxEntity@> vEnts;
			Map_GetEntityArray("Target_ReturnTripNoise_*", vEnts);
			for (int i = 0; i < vEnts.size(); ++i)
			{
				float fDist = cMath_Vector3Dist(Player_GetPosition(), vEnts[i].GetPosition());
				if (fClosestDist < 0.0f || fDist < fClosestDist)
				{
					@pClosest = vEnts[i];
					fClosestDist = fDist;
				}
			}
			
			if (pClosest !is null)
			{
				float fRand = cMath_RandRectf(0.0f, 1.0f);
				if (fRand <= 0.5f) Sound_CreateAtEntity("GhoulNoise", "02_04_living_quarters/ghoul_events/vocals/hallway_distant_angry", pClosest.GetName(), 0.0f, false, 0.7f);
				else if (fRand <= 0.75f) Sound_CreateAtEntity("GhoulNoise", "02_04_living_quarters/ghoul_events/ghoul_tunnel_sweet", pClosest.GetName());
				else if (fRand <= 0.75f) Sound_CreateAtEntity("GhoulNoise", "02_04_living_quarters/ghoul_events/ghoul_run_sweet", pClosest.GetName());
			}
			
			Map_AddTimer("Timer_ReturnTripNoise", cMath_RandRectf(10.0f, 30.0f), "OnTimer_ReturnTripNoise");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_ActivateGhoulSenses(const tString &in asParent, const tString &in asChild, int alState)
		{
			Agent_SetSensesActive(Entity_GetVarString(asParent, ""), true);
			return false;
		}
		
		//-------------------------------------------------------
		
		void SetupExitBeamJump()
		{
			Entity_SetActive("Ghoul_ExitBeam", true);
			Entity_PlayAnimation("Ghoul_ExitBeam", "ghoul_radioRoom_beam_waitIdle", 0.0f, true);
			Entity_SetActive("Trigger_StartExitBeamJump", true);
			Entity_SetActive("Trigger_StartExitBeamJumpMusic", true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartExitBeamJump(const tString &in asEntity, int alState)
		{
			Entity_SetActive("Ghoul_ReturnEntrance", false);
			Entity_SetActive("Trigger_ReturnEntranceJump", false);
			Entity_SetActive("Trigger_SetupReturnEntrance", false);
						
			Entity_PlayAnimation("Ghoul_ExitBeam", "ghoul_radioRoom_beam_scream_jump_away", 0.0f, false, false, "OnAnimationOver_ExitBeamJump");
			Map_GetEntity("Ghoul_ExitBeam").GetMeshEntity().GetAnimationStateFromName("ghoul_radioRoom_beam_scream_jump_away").SetSpeed(1.25f);
			
			Sound_CreateAtEntity("GhoulScream", "creatures/vocalisations/creature/ghoul/ghoul_stop_search", "Ghoul_ExitBeam");
			
			Map_AddTimer("Timer_DisableExitBeamJumpLookAt", 0.5, "OnTimer_DisableExitBeamJumpLookAt");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableExitBeamJumpLookAt(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_StartExitBeamJumpMusic", false);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartExitBeamJumpMusic(const tString &in asEntity, int alState)
		{
			Music_Play("A2_2_4_Scare_Mid_03.ogg", 0.3f, false, eMusicPrio_BigEvent);
			AddScareFear(0.8f, 4.0f, true, 1.0f, 0.1f, 1.0f);
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_ExitBeamJump(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive("Ghoul_ExitBeam", false);
		}	
		
		//-------------------------------------------------------
		
		void SetupReturnEntranceScare()
		{
			Entity_SetActive("Trigger_SetupReturnEntrance", true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_SetupReturnEntrance(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("Ghoul_ReturnEntrance", true);
			Entity_PlayAnimation("Ghoul_ReturnEntrance", "ghoul_radioRoom_door_waitIdle", 0.0f, true);
			Entity_SetActive("Trigger_ReturnEntranceJump", true);
			Entity_SetActive("Trigger_ReturnEntranceJumpMusic", true);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartReturnEntranceJump(const tString &in asEntity, int alState)
		{
			Entity_SetActive("Ghoul_ExitBeam", false);
			Entity_SetActive("Trigger_StartExitBeamJump", false);
			
			Entity_PlayAnimation("Ghoul_ReturnEntrance", "ghoul_radioRoom_door_jumpAway", 0.0f, false, false, "OnAnimationOver_ReturnEntranceJump");
			Map_GetEntity("Ghoul_ReturnEntrance").GetMeshEntity().GetAnimationStateFromName("ghoul_radioRoom_door_jumpAway").SetSpeed(1.25f);
			
			Sound_CreateAtEntity("Ghoul_ReturnEntrance", "creatures/vocalisations/creature/ghoul/ghoul_stop_search", "Ghoul_ReturnEntrance");
			
			Map_AddTimer("Timer_DisableEntranceJumpReaction", 0.5f, "OnTimer_DisableEntranceJumpReaction");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableEntranceJumpReaction(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_ReturnEntranceJumpMusic", false);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartReturnEntranceJumpMusic(const tString &in asEntity, int alState)
		{
			Music_Play("A2_2_4_Scare_Mid_03.ogg", 0.3f, false, eMusicPrio_BigEvent);
			AddScareFear(0.8f, 4.0f, true, 1.0f, 0.1f, 1.0f);
		}
		
		//-------------------------------------------------------
		
		void OnAnimationOver_ReturnEntranceJump(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_SetActive("Ghoul_ReturnEntrance", false);
		}	
		
		//-------------------------------------------------------
		
		bool mbSaltpetrePickedUp = false;
		void OnInteract_PickupSaltPetre(const tString &in asEntity)
		{
			// Only check the ideas off if they have been added
			if (Sketchbook_GetSketchActive("find_saltpeter"))
			{
				Sketchbook_CompleteIdea("find_saltpeter");
				Sketchbook_CompleteIdea("find_saltpeterlocation");
			}
			
			mbSaltpetrePickedUp = true;
			
			if (cScript_GetGlobalVarBool("Outpost_LQ_FirstTripComplete"))
			{
				SetupReturnEntranceScare();
				
				Entity_SetActive("Ghoul_ReturnTrip_1", false);
				Sound_Stop("GhoulEating_1", 2.0f);
				
				SetupExitBeamJump();
				
				Entity_SetActive("Ghoul_ReturnTrip_2", false);
				Sound_Stop("GhoulEating_2", 2.0f);
				
				SwingDoor_SetBlocked("Door_MapRoom", false, false);
				SwingDoor_SetOpenAmount("Door_MapRoom", 0.8);
			
				if (mlReturnTripId == 0) Map_AddTimer("Ghoul_ReturnTrip_1", 4, "OnTimer_GhoulReturnTripRun");
				else Map_AddTimer("Ghoul_ReturnTrip_2", 4, "OnTimer_GhoulReturnTripRun");
			}
			else
			{
				if (Entity_IsActive("Ghoul_Workshop") == false)
				{
					SetupExitBeamJump();
				}
			}
			
			if (cScript_GetGlobalVarBool("Outpost_LQ_SeenGunpowderRecipe")) Voice_PlayDelayed("Dialogue_GotSaltpeter", 0.25);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_GhoulReturnTripRun(const tString &in asTimer)
		{
			Sound_CreateAtEntityCustom("GhoulRun", "02_04_living_quarters/ghoul_events/ghoul_run_sweet", asTimer, 35, 15);
		}
		
		//-------------------------------------------------------

		//} END Event B *Hear the ghoul while exploring*	
		
