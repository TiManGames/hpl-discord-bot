	//-------------------------------------------------------
	
	void SetPropStage(eVisibilityAreaStage aStage, bool abSetup = false)
	{
		if (aStage == eVisibilityAreaStage_None)
		{
			cLux_AddDebugMessage("Set entity stage: NONE");
			
			SetAABBPropsActive("Trigger_FirstFloorAABB", true, abSetup);
			SetAABBPropsActive("Trigger_SecondFloorAABB", true, abSetup);
			SetAABBPropsActive("Trigger_SecondFloorWorkshopAABB", true, abSetup);
		}
		else if (aStage == eVisibilityAreaStage_FirstFloor)
		{
			cLux_AddDebugMessage("Set entity stage: FIRST FLOOR");
			
			SetAABBPropsActive("Trigger_FirstFloorAABB", true, abSetup);
			SetAABBPropsActive("Trigger_SecondFloorAABB", false, abSetup);
			SetAABBPropsActive("Trigger_SecondFloorWorkshopAABB", false, abSetup);
		}
		else if (aStage == eVisibilityAreaStage_SecondFloor)
		{
			cLux_AddDebugMessage("Set entity stage: SECOND FLOOR");
			
			SetAABBPropsActive("Trigger_FirstFloorAABB", false, abSetup);
			SetAABBPropsActive("Trigger_SecondFloorAABB", true, abSetup);
			SetAABBPropsActive("Trigger_SecondFloorWorkshopAABB", false, abSetup);
		}
		else if (aStage == eVisibilityAreaStage_AfterBrokenFloor)
		{
			cLux_AddDebugMessage("Set entity stage: AFTER BROKEN FLOOR");
			
			SetAABBPropsActive("Trigger_FirstFloorAABB", true, abSetup);
			SetAABBPropsActive("Trigger_SecondFloorAABB", false, abSetup);
			SetAABBPropsActive("Trigger_SecondFloorWorkshopAABB", true, abSetup);
		}
	}
	
