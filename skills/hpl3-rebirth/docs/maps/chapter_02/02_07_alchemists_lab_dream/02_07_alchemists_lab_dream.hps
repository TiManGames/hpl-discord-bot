			Map_Preset_Fade("Lighting_Stage_3", 5.f);
			Sound_Play("Sound_Quake", 0.0f);
			Sound_CreateAtEntity("Sound_Sweet_1", "level_dreams/sweeteners/park/park_break_02", "player", 0.0f, true);
			
			return false;
		}
		
