		//-------------------------------------------------------
	 
		bool mbPlayerApproachedChild = false;
		bool mbDestructionSeqEnded = false;
		int mlMoveDustParticleSuffix = 0;
		
		float mfCurrParkGroupRelativePosY = 0.f;
		float mfCurrParkGroupMoveSpeedMul = 1.f;
		float mfRandomHeightFactorMul = 0.f;
		
		//-------------------------------------------------------
	
		array<tString> mvChildtoySockets = 
		{
			"L_HandSocket_1", 
			"L_HandSocket_2", 
			"R_HandSocket_1"
		};
		
		//-------------------------------------------------------
		
		void MoveParkGroupToRelativeYPos(const tString&in asGroupBaseName, float afRelativeYPosDestination, float afPSEffectDuration = 5.f, 
										bool abPSPerEntity=true, float afMoveSpeedMul=1.f, float afRandomHeightFactorMul=0.f, 
										float fMaxStartMoveDelay=4.f, bool abPlaySound=true, float afShakeTime=-1, bool abSpawnParticles=true)
		{
			////////////
			// Global Fx
			if (afShakeTime>0)
				Effect_Shake_Start(0.03f, afShakeTime, 1.f, fMaxStartMoveDelay + 4.f);
			
			///////////////
			// Global Sound
			if (abPlaySound)
			{
				Sound_PlayGui("level_dreams/park_dream/rock_break/rock_break_01", 1.f);
				Sound_PlayGui("level_dreams/park_dream/stingers/stinger_post_break_02", 0.3f);
			}
			
			///////////
			// Settings
			mfCurrParkGroupRelativePosY = afRelativeYPosDestination;
			mfCurrParkGroupMoveSpeedMul = afMoveSpeedMul;
			mfRandomHeightFactorMul = afRandomHeightFactorMul;
			
			/////////////
			// Move props
			array<iLuxEntity@> vGroupEntities;
			Map_GetEntityArray(asGroupBaseName + "Prop_*", vGroupEntities, eLuxEntityType_Prop);
				
			for (int i=0; vGroupEntities.size()>0 && i<vGroupEntities.size(); ++i)
			{
				iLuxEntity@ pCurrEntity = vGroupEntities[i];
				if (pCurrEntity==null) continue;
				
				tString sCurrEntName = pCurrEntity.GetName();
				float fMoveStartTime = cMath_RandRectf(0.1f, fMaxStartMoveDelay);
				
				Map_AddTimer(sCurrEntName, fMoveStartTime, "OnTimer_MoveParkGroup");
				
				///////////////////
				// PS Fx per entity
				if (abPSPerEntity && abSpawnParticles)
				{
					tString sPSName = "DebrisPS_"+sCurrEntName;
					CreateParkDebrisPS(sPSName, sCurrEntName, afPSEffectDuration);
				}
			}
			
			//////////////////
			// Area Particles
			if (abPSPerEntity || abSpawnParticles==false) return;
			
			array<iLuxEntity@> vGroupDustPSPosAreas;
			Map_GetEntityArray(asGroupBaseName + "PSPos_*", vGroupDustPSPosAreas, eLuxEntityType_Area);
				
			for (int i=0; vGroupDustPSPosAreas.size()>0 && i<vGroupDustPSPosAreas.size(); ++i)
			{
				iLuxEntity@ pCurrPSArea = vGroupDustPSPosAreas[i];
				if (pCurrPSArea==null) continue;
				
				tString sCurrPSPosAreaName = pCurrPSArea.GetName();
				float fPsStartTime = cMath_RandRectf(1.f, 2.f);
				
				tString sPSName = "DebrisPS_"+sCurrPSPosAreaName;
				CreateParkDebrisPS(sPSName, sCurrPSPosAreaName, afPSEffectDuration);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_MoveParkGroup(const tString&in asPropName)
		{
			if (mfRandomHeightFactorMul <= 0) return;
			cLuxProp @pCurrProp = Map_GetProp(asPropName);
			if (pCurrProp==null) return;
			
			////////
			// Sound
			Sound_CreateAtEntity("rock_break_"+asPropName, "level_dreams/park_dream/rock_break/rock_break", asPropName, 0.0f, true);
			
			///////////////////
			// Calc destination
			cVector3f vCurrPos = pCurrProp.GetPosition();
			cVector3f vDesiredPos = vCurrPos;
			vDesiredPos.y += mfCurrParkGroupRelativePosY;
			float fRandomHeightFactor = vDesiredPos.y * mfRandomHeightFactorMul;
			vDesiredPos.y += cMath_RandRectf(fRandomHeightFactor * 0.25f, fRandomHeightFactor);
			
			///////////////////////////
			// Calc speed and Move prop
			float fMaxSpeed = cMath_RandRectf(0.5f, 1.5f) * mfCurrParkGroupMoveSpeedMul;
			pCurrProp.MoveLinearTo(vDesiredPos, 1, fMaxSpeed, 1, false, "");
		}
		
		//-------------------------------------------------------
		
		void CreateParkDebrisPS(const tString&in asPSName, const tString&in asPSLocationEntName, float afPSEffectDuration)
		{
			tString asPSFileName = afPSEffectDuration > 0 ? "island_debris_up.ps" : "island_debris_up_one_shot.ps";
			ParticleSystem_CreateAtEntity(asPSName, asPSFileName, asPSLocationEntName, true);
			
			if (afPSEffectDuration > 0)
				Map_AddTimer(asPSName, afPSEffectDuration, "OnTimer_DestroyDebrisPS");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DestroyDebrisPS(const tString&in asPSName)
		{
			ParticleSystem_Destroy(asPSName);
		}
		
