	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("02-07-alchemists-lab-dream");
		
		//////////////
		// Fog CubeMap
		iTexture@ pSkybox = cResources_CreateTextureCubeMap("flesh_fresnel_gradient.dds", true);
        cLux_GetCurrentMap().GetWorld().SetFogSkyboxTexture(pSkybox);
		
		Pregnancy_SetStage(ePregStage_Stage1);
		Pregnancy_SetBarksActive(false);
		Pregnancy_SetBabyTalkMinimumStage(eBabyTalkStage_OasisToAlchemists);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_BecomingMonster);
		Player_SetAllowCheckBaby(false);
		FearHandler_SetWhisperStage(eFearWhisperStage_BabyKickToHQA);
		
		// Set up color grading etc.
		
		/////////
		// Skybox
		Map_Preset_SetupSkybox("Lighting_Stage_0", cColor(1), 0.f);
		Map_Preset_SetupSkybox("Lighting_Stage_1", cColor(1), 0.f);
		Map_Preset_SetupSkybox("Lighting_Stage_2", cColor(1), 0.15f);
		Map_Preset_SetupSkybox("Lighting_Stage_3", cColor(1), 0.2f);
		Map_Preset_SetupSkybox("Lighting_Stage_4", cColor(1), 0.25f);
		Map_Preset_SetupSkybox("Lighting_Stage_5", cColor(1), 0.25f);
		
		////////////
		// Dir Light
		Map_Preset_SetupDirLight("Lighting_Stage_0", false, cColor(0,0,0,1), 0.f, cVector3f(-0, -1, 0), cColor(0,0,0,1), cColor(0,0,0,1));
		Map_Preset_SetupDirLight("Lighting_Stage_1", true, cColor(0.791,0.615,0.535,1), 0.05f, cVector3f(0.444, -0.87, -0.212), cColor(0.307,0.351,0.396,1), cColor(0.166,0.173,0.186,1));
		Map_Preset_SetupDirLight("Lighting_Stage_2", true, cColor(0.791,0.615,0.535,1), 0.15f, cVector3f(0.444, -0.87, -0.212), cColor(0.307,0.351,0.396,1), cColor(0.166,0.173,0.186,1));
		Map_Preset_SetupDirLight("Lighting_Stage_3", true, cColor(0.871,0.486,0.31,1), 0.15f, cVector3f(0, -1, 0), cColor(0.2,0.345,0.569,1), cColor(0.166,0.173,0.186,1));
		Map_Preset_SetupDirLight("Lighting_Stage_4", true, cColor(0.871,0.486,0.31,1), 0.2f, cVector3f(0, -1, 0), cColor(0.3,0.445,0.669,1), cColor(0.166,0.173,0.186,1));
		Map_Preset_SetupDirLight("Lighting_Stage_5", false, cColor(0,0,0,1), 0.5f, cVector3f(0, -1, 0), cColor(0,0,0,1), cColor(0,0,0,1));
		
		//////
		// Fog
		Map_Preset_SetupFog("Lighting_Stage_0", true, 3, 15, 1, cColor(0, 0, 0, 1), 1.f, false, true);
		Map_Preset_SetupFog("Lighting_Stage_1", true, 1, 40, 1, cColor(0.107,0.107,0.107,1), 1.f, false, true);
		Map_Preset_SetupFog("Lighting_Stage_2", true, 1, 40, 1, cColor(0.107,0.107,0.107,0.654), 1.f, false, true);
		
		StruggleFlashHandler_SetActive(false);
		
		Player_SetAutoTeleportWhenBelowAltitude(-8);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("dust_large_long_oneshot.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		Sound_PreloadGroup("level_dreams/park_dream/rock_break", true);
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(6);
		
		// Any general setup of script / entities
		Player_SetActive(false);
		Effect_Fade_Out(0.f);
		Map_AddTimer("OnTimer_InitDream", 1, "OnTimer_InitDream");
		Sketchbook_CompleteIdea("cross_alchemistrift");
		
		//////////////////
		// Show the player where to go
		Player_StartLookAt("Area_LookAt_intro", 2, 3, 4);
		Light_FadeBrightnessTo("Light_Guide_*", 0.f, 0.f);
		Map_AddTimer("Timer_FadeGuideLightIn", 2.f, "OnTimer_FadeGuideLightIn");
		
		////////////////////////
		// Setup child for anims
		Prop_SetStaticPhysics("toy_block_*", true);
		Entity_SetInteractionDisabled("toy_block_*", true);
		Prop_SetStaticPhysics("anim_toy_block_*", true);
		
		Entity_AttachToSocket("BlurFX_Child", "Prop_Child", "Head_Socket", false, false);
		
		Entity_PlayAnimation("Prop_Child", "idle_1", 0.1f, true);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			Entity_SetActive("BlurFX_Child", false);
		}
		
		Entity_PlayAnimation("Sky_Infant", "idle", 0.2f, true);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		PlayerBody_SetModel("player.ent");
		PlayerBody_SetActive(true);
		DreamHandler_SetActive(true);
        Player_SetVertigoActive(false);
        FearHandler_SetActive(false);
        Pregnancy_SetBabyKicksEnabled(false);
        Heat_SetActive(false);
		Player_SetNightVisionEnabled(false);
			
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave(){}

	//-------------------------------------------------------

	////////////////////////////
	// The player has died.
	void OnPlayerKilled(int alRecentDeaths, const tString&in asSource){}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player HP reaches 0
	bool OnDeath(const tString &in asSource)
	{
		cLux_AddTodoMessage("DEAD : SOURCE = " + asSource);
		
		if (asSource == "SomeReason")
		{
			Effect_Fade_Out(1.0f);
			return true; // return true to completely override base behaviour
		}
		
		// return false for default behaviour
		return false;
	}
	
	//-------------------------------------------------------
	
	////////////////////////////////////
	// Called when player should respawn (after death)
	bool OnRespawn(const tString &in asSource)
	{		
		// return false for default behaviour (fadeout and death area)
		return false;
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test0)
		{
			PlayerBody_PlayCutsceneAtEntity("kneel_child_disappear_stand_up", "Area_ApproachChildAnimPos", false, 0.5f);
		}
		
		if(alAction == eAction_Test1)
		{
			Player_StopLookAt(0.1f);
			Player_Teleport("Start_Begin_1");
		}
		
		if(alAction == eAction_Test2)
		{
			Player_StopLookAt(0.1f);
			Player_Teleport("Start_Begin_2");

		}
		
		if(alAction == eAction_Test3)
		{
			Map_Preset_Fade("Lighting_Stage_4", 10.f);
			BlowToysAway();
			Player_StopLookAt(0.1f);
			Entity_SetActive("Trigger_StartChildSequence_1", false);
			Entity_SetActive("Prop_Child", false);
			Entity_SetActive("Sky_Infant", true);
			Player_Teleport("Start_Begin_3");
			Seq_DestroyPark("");
			Map_Preset_Fade("Lighting_Stage_4", 0.1f);
		}
		
		if(alAction == eAction_Test4)
		{
			Entity_SetActive("Sky_Infant", true);
			Entity_PlayAnimation("Sky_Infant", "fetus4mgrow_1", 0.0f, true);
		}
		
		if(alAction == eAction_Test5)
		{
		}
			
		if (alAction==eAction_Test0)
		{
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
	
	//-------------------------------------------------------
	
	void Update(float afDeltaTime)
	{
		////////////////////////////
		// Manual attachment of toys
		for(int i=0; i<mvChildtoySockets.size(); i++)
		{
			iLuxEntity@ pAttachProp = Map_GetEntity("anim_toy_block_"+i, eLuxEntityType_Prop);	
			if (pAttachProp==null) continue;
			
			iLuxEntity@ pChild = Map_GetEntity("Prop_Child", eLuxEntityType_Prop);
			if (pChild==null) continue;
			
			cNode3D@ pSocket = pChild.GetMeshEntity().GetSocket(mvChildtoySockets[i]);
			if (pSocket==null) continue;
			
			cNode3D@ pParentBone = pSocket.GetParent();
			if (pParentBone==null) continue;
			
			//////////////////
			// Update rotation
			cMatrixf mtxToyMatrix = pSocket.GetWorldMatrix();
			cMatrixf mtxParentRot = pParentBone.GetWorldMatrix().GetRotation();
			// Parent bone has a default scale of 0.01f, need to normalize it
			const float fCurrAttachmentScale = 0.5f;
			mtxParentRot = cMath_MatrixMul(cMath_MatrixScale(100.f * fCurrAttachmentScale), mtxParentRot);
			mtxToyMatrix.SetRotation(mtxParentRot);
			
			pAttachProp.SetMatrix(mtxToyMatrix);
		}
	}
	
