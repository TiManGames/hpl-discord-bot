		//-------------------------------------------------------
		
		bool OnCollide_ApproachTheChild(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			
			mbPlayerApproachedChild = true;
			
            if (SequenceStates_IsActive("Seq_ApproachingTheChild")==false)
				Seq_ApproachingTheChild("");
				
			return false;
		}
		
		//-------------------------------------------------------
			
		void Seq_ApproachingTheChild(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ApproachingTheChild ", mSeq_ApproachingTheChild );
			
			if (Sequence_DoStepAndWait(2.f))
			{
                PlayerBody_SetAnimatedMoveStateActive(true, "kneel_loop", "Area_ApproachChildAnimPos", 0.5f);
				Entity_PlayAnimation("Prop_Child", "idle_1_tr_idle_2", 0.1f, false, true, "OnAnimEnd_IdleAnim_2");
				
				Voice_Play("ChildLaughing");
				Player_StartLookAt("Prop_Child", 1, 2, 3);
			}
			if (Sequence_DoStepAndWait(2.f))
			{
				Player_StopLookAt(2.f);
			}
			else if (Sequence_DoStepAndWait(3.5f))
			{
				Sound_CreateAtEntity("Sound_BabyBlocks", "level_dreams/park_dream/alys_blocks", "Prop_Child");
				Entity_PlayAnimation("Prop_Child", "placing_blocks", 0.1f, false, true, "OnAnimEnd_IdleAnim_2");
			}
			else if (Sequence_DoStepAndWait(14.f))
			{
				Voice_Play("ChildDialog2");
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Player_StartLookAt("Prop_Child", 1, 2, 3);
				Voice_Play("ChildDialog3");
			}
			else if (Sequence_DoStepAndWait(3.f))
			{
				Player_StopLookAt(3.f);
			}
			else if (Sequence_DoStepAndWait(5.f))
			{
				Lamp_SetFlickerActive("Park_Lamp_3", true);
			}
			else if (Sequence_DoStepAndContinue())
			{
				if (SequenceStates_IsActive("Seq_ChildFadeAway")==false)
					Seq_ChildFadeAway("");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_IdleAnim_2(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_PlayAnimation("Prop_Child", "idle_2", 0.5f, true, true, "");
		}
		
		//-------------------------------------------------------

		//} END Event D *Tasi approaches the child*
		
		////////////////////////////////////////////////
		// Event E *The park breaks apart*
		//{////////////////////////////////////////////

		//-------------------------------------------------------
		
		cSequenceStatesData mSeq_ChildFadeAway;
		void Seq_ChildFadeAway(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ChildFadeAway", mSeq_ChildFadeAway);
			
			if (Sequence_DoStepAndWait(0.83f))
			{
				ParticleSystem_CreateAtEntity("WindPS", "wind_blow.ps", "Area_WindSource", false);
				Sound_CreateAtEntity("WindSound", "01_04_dark_world_ledge/level_events/camp_wind", "Area_WindSource", 0.0f, true);
				Sound_PlayGui("level_dreams/park_dream/stingers/baby_disapper_stinger_01", 1);
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				Player_StartLookAt("Prop_Child", 1, 2, 3);
				
				Lamp_SetFlickerActive("Park_Lamp_3", false);
				Lamp_SetLit("Park_Lamp_3", false, true);
				
				BlowToysAway();
				
				Music_Play("A2_2_8_Alys_Disappear.ogg", 0.2f, false, eMusicPrio_MinorEvent);
				Sound_CreateAtEntity("Sound_Sweet_1", "level_dreams/sweeteners/park/alys_fade", "player", 0.0f, true);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Prop_SetActiveAndFade("Prop_Child", false, 2.f);
			}
			else if (Sequence_DoStepAndWait(9.5f))
			{
				DreamHandler_FadeDreamBlurFx("BlurFX_Child", 1);
				PlayerBody_SetAnimatedMoveStateActive(false);
				DreamHandler_SetActive(true);
				PlayerBody_PlayCutsceneAtEntity("kneel_child_disappear_stand_up", "Area_ApproachChildAnimPos", false, 0.5f);
				Voice_Play("Emote_ChildVanishes");
				Player_StopLookAt(3.f);
			}
			else if (Sequence_DoStepAndContinue())
			{
				if (SequenceStates_IsActive("Seq_DestroyPark")==false)
					Seq_DestroyPark("");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void BlowToysAway()
		{
			////////////////
			// Wind on grass
			cForceField@ pWindSwayForceField = cLux_GetCurrentMap().GetWorld().CreateForceField("WindSway", false, false);
			pWindSwayForceField.SetForce(0.5f);
			pWindSwayForceField.SetRadius(5.f);
			pWindSwayForceField.SetFreq(15.f);
			pWindSwayForceField.SetWorldPosition(Map_GetEntity("WindForceFieldAreaCenter").GetPosition());
			pWindSwayForceField.SetScriptableIsSaved(false);
			pWindSwayForceField.FadeOut(5.f);
			
			/////////////////////////
			// Replace animation toys
			mvChildtoySockets.resize(0);
			array<iLuxEntity@> vAnimatedToyEnts;
			Map_GetEntityArray("anim_toy_block_*", vAnimatedToyEnts, eLuxEntityType_Prop);
			for (int i=0; i<vAnimatedToyEnts.size(); ++i)
			{
				iLuxEntity@ pCurrEnt = vAnimatedToyEnts[i];
				if (pCurrEnt==null) continue;
				
				iLuxEntity@ pReplacementEnt = Map_GetEntity("toy_block_kid_"+i, eLuxEntityType_Prop);
				if (pReplacementEnt==null) continue;
				
				pReplacementEnt.SetActive(true);
				pReplacementEnt.SetPosition(pCurrEnt.GetPosition());
				
				pCurrEnt.SetActive(false);
			}
			
			/////////////////////
			// Push all toys away
			iLuxEntity@ pImpulseSourceEnt = Map_GetEntity("Area_ToyBlocksImpulseSource", eLuxEntityType_Area);
			
			array<iLuxEntity@> vToyEnts;
			Map_GetEntityArray("toy_block_*", vToyEnts, eLuxEntityType_Prop);
			for (int i=0; i<vToyEnts.size(); ++i)
			{
				iLuxEntity@ pCurrEntity = vToyEnts[i];
				if (pCurrEntity==null) continue;
				
				iPhysicsBody@ pCurrentPhysBody = pCurrEntity.GetMainBody();
				if (pCurrentPhysBody==null) return;
				
				pCurrentPhysBody.SetGravity(false);
				
				tString sCurrEntName = pCurrEntity.GetName();
				Map_AddTimer(sCurrEntName, 5.f, "OnTimer_FadeToysAway");
				Prop_SetStaticPhysics(sCurrEntName, false);
				
				ApplyImpulse(pCurrentPhysBody, pImpulseSourceEnt, 0.83);
			}
			
			//////////////////////
			// Make Maka float too
			iPhysicsBody@ pMakaBody = Map_GetEntity("toy_doll_1", eLuxEntityType_Prop).GetMainBody();
			if (pMakaBody==null) return;
			pMakaBody.SetGravity(false);
			ApplyImpulse(pMakaBody, pImpulseSourceEnt, 1.83);
		}
		
		//-------------------------------------------------------
		
		void ApplyImpulse(iPhysicsBody@ apPhysBody, iLuxEntity@ apImpulseSource, cVector3f avImpulseMul)
		{
			cVector3f vImpulseDir = apPhysBody.GetWorldPosition() - apImpulseSource.GetPosition();
			vImpulseDir = cMath_Vector3Normalize(vImpulseDir);
			apPhysBody.AddImpulse(vImpulseDir * avImpulseMul);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeToysAway(const tString&in asTimer)
		{
			Prop_SetActiveAndFade(asTimer, false, 2.f);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeq_DestroyPark;
		void Seq_DestroyPark(const tString &in asTimer)
		{
			Sequence_Begin("Seq_DestroyPark", mSeq_DestroyPark);
			
			if (Sequence_DoStepAndWait(1.5f))
			{
				Map_Preset_Fade("Lighting_Stage_5", 10.f);
				
				DreamHandler_PregnancyContractions();
				
				MoveParkGroupToRelativeYPos("ParkGroup_Distand_", -50, 15.f, true, 16.f, 1.5f, 4.f, true, 15.f, false);
				MoveParkGroupToRelativeYPos("ParkGroup_3_", -50, 15.f, true, 1.f, 1.5f, 4.f, false, 4.f);
				MoveParkGroupToRelativeYPos("ParkGroup_5_", -50, 15.f, true, 8.f, 1.5f, 4.f, true, 15.f, true);
				
				Lamp_SetFlickerActive("Park_Lamp_4", true);
				DestroyTheBridge();
				
				Music_Play("A2_2_7_Alchemists_Lab_Dream_B.ogg", 0.18f, false, eMusicPrio_BigEvent);
			}
			else if (Sequence_DoStepAndWait(5.5f))
			{
				MoveParkGroupToRelativeYPos("ParkGroup_1_", -50, 15.f, true, 1.f, 1.5f, 4.f, false);
				MoveParkGroupToRelativeYPos("ParkGroup_4_", -50, 15.f, true, 1.f, 1.5f, 4.f, false);
				
				Lamp_SetFlickerActive("Park_Lamp_5", false);
			}
			else if (Sequence_DoStepAndWait(5.f))
			{
                DreamHandler_PregnancyContractions();
				
				///////////////////////
				// Turn off the remaining lights
				Lamp_SetFlickerActive("Park_Lamp_4", false);
				Lamp_SetLit("Park_Lamp_4", false, true);
				
				Lamp_SetFlickerActive("Park_Lamp_5", false);
				Lamp_SetLit("Park_Lamp_5", false, true);
				
				Entity_SetActive("Area_LookAtGiantInfant", true);
				
				mbDestructionSeqEnded = true;
			}
			else if (Sequence_DoStepAndContinue())
			{
				//////////////////////////
				// Light up the infant in the sky
				Light_FadeBrightnessTo("Light_Infant_*", 15.f, 8.f);
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_DestroyIslandBridge(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			if (mbPlayerApproachedChild==false) return true;
			if (mbDestructionSeqEnded) return false;
			
			DestroyTheBridge();
			return false;
		}
		
		//-------------------------------------------------------
		
		void DestroyTheBridge()
		{
			Entity_SetActive("BlockBoxChar_PostBridgeCollapse", true);
			MoveParkGroupToRelativeYPos("ParkGroup_MainBridge_", -50, 15.f, true, 1.f, 1.5f, 4.f, true, 4.f, false);
			MoveParkGroupToRelativeYPos("ParkGroup_Bridge_", -50, 15.f, true, 1.f, 1.5f, 4.f, false);
		}
		
		//-------------------------------------------------------

		//} END Event E *The park breaks apart*
		
		////////////////////////////////////////////////////////
		// Event A *Infant is growing up*
		//{/////////////////////////////////////////////////////

		//-------------------------------------------------------
		
		cSequenceStatesData mSeq_InfantGrowingUp;
		
		//-------------------------------------------------------
		
		void Seq_InfantGrowingUp(const tString &in asTimer)
		{
			Sequence_Begin("Seq_InfantGrowingUp", mSeq_InfantGrowingUp);
			
			if (Sequence_DoStepAndWait(2.f))
			{
				Sound_CreateAtEntity("Sound_BabyGrowSweet", "level_dreams/sweeteners/room/grow_sweet", "player");
			}
			else if (Sequence_DoStepAndPause(1.0f))
			{
				Effect_Flash_Start(10.f, 4.f, 0.1f);
				
				Entity_PlayAnimation("Sky_Infant", "fetus4mgrow_1", 0.2f, false, true, "OnFetusGrowAnimComplete");
				Sound_CreateAtEntity("Sound_ContractionStinger", "04_01_town/contraction_pain/contraction_pain_stingers", "player");
				Entity_SetAnimationSpeed("Sky_Infant", "fetus4mgrow_1", 1.5f);
				Map_GetEntity("Sky_Infant").FadeMeshScaleMul(1.2f, 1.f);
			}
			else if (Sequence_DoStepAndPause(0.5f))
			{
				Entity_PlayAnimation("Sky_Infant", "fetus4mgrow_2", 0.2f, false, true, "OnFetusGrowAnimComplete");
				Sound_CreateAtEntity("Sound_ContractionStinger", "04_01_town/contraction_pain/contraction_pain_stingers", "player");
				Entity_SetAnimationSpeed("Sky_Infant", "fetus4mgrow_2", 1.5f);
				Map_GetEntity("Sky_Infant").FadeMeshScaleMul(1.4f, 1.f);
			}
			else if (Sequence_DoStepAndPause(1.0f))
			{
				Entity_PlayAnimation("Sky_Infant", "fetus4mgrow_3", 0.2f, false, true, "OnFetusGrowAnimComplete");
				Sound_CreateAtEntity("Sound_ContractionStinger", "04_01_town/contraction_pain/contraction_pain_stingers", "player");
				Entity_SetAnimationSpeed("Sky_Infant", "fetus4mgrow_3", 1.5f);
				Map_GetEntity("Sky_Infant").FadeMeshScaleMul(1.6f, 1.f);
			}
			else if (Sequence_DoStepAndContinue())
			{
				Player_StopLookAt(0.1f);
				DreamHandler_SetActive(false);
				
				if (cLux_ScriptDebugOn()==false)
					Map_ChangeMap("03_03_herberts_hq_a.hpm", "Start_Begin", "", "");
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnFetusGrowAnimComplete(const tString &in asEntityName, const tString &in asAnimName)
		{
			Entity_PlayAnimation("Sky_Infant", "idle", 0.2f, true);
			SequenceStates_Resume("Seq_InfantGrowingUp");
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_ForceLookAt(const tString &in asEntity, int alState)
		{
			if (SequenceStates_IsActive("Seq_InfantGrowingUp")) return;
			
			Player_StartLookAt("Area_LookAtGiantInfant_Target", 0.5f, 0.5f, 1.f);
			Seq_InfantGrowingUp("");
		}
		
		//-------------------------------------------------------
		
		//} END Event A
	 
	//} END SCENE 1
}