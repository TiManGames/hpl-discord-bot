		//-------------------------------------------------------

		cSequenceStatesData mSeq_RevealWorld;
		bool mbSteppedOutOfDarkness = false;

		//-------------------------------------------------------
		
		void OnTimer_InitDream(const tString&in asTimer)
		{
			Player_SetActive(true);
			Map_Preset_Fade("Lighting_Stage_0", 0.f);
			Effect_Fade_In(2.f);
		}

		//-------------------------------------------------------
		
		void OnTimer_FadeGuideLightIn(const tString &in asTimer)
		{
			Light_FadeBrightnessTo("Light_Guide_*", 1.f, 2.f);
			Map_AddTimer("OnTimer_StopLookAtIntro", 4.f, "OnTimer_StopLookAtIntro");
			Map_AddTimer("Timer_StepOutOfTheDarkness", 6.f, "OnTimer_StepOutOfTheDarkness");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StepOutOfTheDarkness(const tString&in asTimer)
		{
			StepOutOfTheDarkness(10);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopLookAtIntro(const tString &in asTimer)
		{
			Player_StopLookAt(1.f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_TurnOffGuideLight(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			Lamp_SetFlickerActive("Park_Lamp_Intro_1", true);
			Light_FadeBrightnessTo("Light_Guide_*", 0.f, 5.f);
			return false;
		}
		
		//-------------------------------------------------------
		
        bool OnCollide_StepOutOfDarkness(const tString &in asParent, const tString &in asChild, int alState)
        {
			if (mbSteppedOutOfDarkness) return false;
			if (alState!=1) return true;
		    StepOutOfTheDarkness(5);
	        return false;
        }
				
		//-------------------------------------------------------
		
		void StepOutOfTheDarkness(const float afFadeTime)
		{
			mbSteppedOutOfDarkness = true;
			Map_Preset_Fade("Lighting_Stage_1", afFadeTime);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_RevealWorld(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState!=1) return true;
			
			Map_AddTimer("Timer_TurnOnIntroLampNo2", 5.f, "OnTimer_TurnOnIntroLampNo2");
			Map_AddTimer("Timer_LightingStage2", 1.0f, "OnTimer_LightingStage2");
			
			MoveParkGroupToRelativeYPos("ParkGroup_2_", 2, -1, true, 0.5f, 1.f, 3.f);
			Lamp_SetFlickerActive("Park_Lamp_Intro_1", false);
			
			Effect_Shake_Start(0.03f, 4.f, 1.f, 1.f);
			
			Entity_SetActive("Soundscape_Light",true);
			Music_Play("A2_2_7_Alchemists_Lab_Dream_A.ogg", 0.08f, false, eMusicPrio_BgAmb);
			Sound_CreateAtEntity("Sound_Sweet_1", "level_dreams/sweeteners/park/park_break_01", "player", 0.0f, true);
			
			//////////////////////////////////////////
			// This is to fix the dream move speed mul
			DreamHandler_SetActive(true);
				
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LightingStage2(const tString &in asTimer)
		{
		    Map_Preset_Fade("Lighting_Stage_2", 3.0f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TurnOnIntroLampNo2(const tString&in asTimer)
		{
			Lamp_SetLit("Park_Lamp_Intro_2", true, true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_TurnOffParkLamp2(const tString &in asParent, const tString &in asChild, int alState)
		{
			Lamp_SetFlickerActive("Park_Lamp_2", true);
			Map_AddTimer("OnTimer_TurnOffParkLamp2", 3.5f, "OnTimer_TurnOffParkLamp2");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_TurnOffParkLamp2(const tString &in asTimer)
		{
			Lamp_SetLit("Park_Lamp_2", false, true);
			Lamp_SetLit("Park_Lamp_Intro_*", false, true);
			
			Lamp_SetFlickerActive("Park_Lamp_3", true);
			Map_AddTimer("OnTimer_ParkLamp3StopFlicker", 6.f, "OnTimer_ParkLamp3StopFlicker");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ParkLamp3StopFlicker(const tString &in asTimer)
		{
			Lamp_SetFlickerActive("Park_Lamp_3", false);
		}
		
