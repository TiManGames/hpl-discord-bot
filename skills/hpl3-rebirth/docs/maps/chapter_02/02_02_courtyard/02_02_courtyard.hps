			Map_GetEntity("Tank_Animated").GetMeshEntity().GetAnimationStateFromName("tf17_fall_through_ground").SetSpeed(0.f);
			
			iLuxEntity@ pLocker = Map_GetEntity("tank_key_locker_1");
