			cLux_AddTodoMessage(""+(pLocker.GetPosition() - pTank.GetMeshEntity().GetSocket("TurretSocket_Top").GetWorldPosition()));
			
			
			Entity_RemoveEntityAttachment("tank_key_locker_1");
			Entity_AttachToSocket("tank_key_locker_1", "Tank_Animated", "TurretSocket_Locker", false, true);*/
