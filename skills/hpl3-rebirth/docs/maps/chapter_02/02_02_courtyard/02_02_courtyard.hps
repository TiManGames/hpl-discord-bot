	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if (abPressed == false) return;
		
		if (alAction == eAction_Test0)
		{
			Player_Teleport("Start_Begin");
		}
		
		if (alAction == eAction_Test1)
		{
			Effect_Nausea_Stop();
			
			// Went through LQ			
			Player_Teleport("Start_LQ_Back");			
			cScript_SetGlobalVarBool("Outpost_AnsweredRadio", true);
			OnEnter();
			
			cLux_SetScriptDebugOn(false);
		}
		
		if (alAction == eAction_Test2)
		{
			Effect_Nausea_Stop();
			
			// Went through Arsenal, need to go back to LQ!				
			Player_Teleport("Start_Arsenal");			
			cScript_SetGlobalVarInt("Outpost_ArsenalProgress", 2); 
			cScript_SetGlobalVarBool("Outpost_LQDone", false);			
			cScript_SetGlobalVarBool("Outpost_AnsweredRadio", true);			
			OnEnter();
			
			cLux_SetScriptDebugOn(false);
		}
		
		if (alAction == eAction_Test3)
		{
			Effect_Nausea_Stop();
			
			// Got Saltpeter from LQ back door!						
			Player_Teleport("Start_LQ_Back");			
			cScript_SetGlobalVarBool("Outpost_LQDone", true);
			cScript_SetGlobalVarBool("Outpost_AnsweredRadio", true);
			OnEnter();
			
			cLux_SetScriptDebugOn(false);
		}
		
		if (alAction == eAction_Test4)
		{
			Effect_Nausea_Stop();
			
			Player_Teleport("Start_Tank");
			Item_AddToInventory("Bullet");
			cScript_SetGlobalVarBool("Outpost_AnsweredRadio", true);
			OnEnter();
			
			cLux_SetScriptDebugOn(false);
		}
		
