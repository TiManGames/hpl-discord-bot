		//	PlayerBody_PlayCutsceneAnimation("tf17_fire_fail_short", false, 0.3f);
		}
		
		if (alAction == eAction_Test7)
		{
			//Body_AddImpulse("TankShellCasing_Body_1", cVector3f(0.f, 0.f, -10.f), true);
			Seq_TankFire("");
			
			/*Entity_SetActive("Tank_Animated", true);
