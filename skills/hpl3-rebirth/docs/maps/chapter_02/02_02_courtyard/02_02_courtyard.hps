	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("02-02-courtyard");
		
		// Set up color grading etc.
		Pregnancy_SetStage(ePregStage_Stage1);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_CavesToCisternStart);
		Pregnancy_SetBabyKicksEnabled(false);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_Ill);
		Player_SetAllowCheckBaby(true);
		
		if (!cScript_GetGlobalVarBool("Outpost_Visited"))
		{
			Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_Initial");
			cScript_SetGlobalVarBool("Outpost_Visited",true);
		}
		
		if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio"))
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_RadioToBabyKick);
		}
		else
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_SalimToRadio);
		}
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(0);
		StruggleFlashHandler_SetProgression(0);
		
		Player_SetAutoTeleportWhenBelowAltitude(10.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("cannon_smoke.ps");
		ParticleSystem_Preload("cannon_impact_wood.ps");
		ParticleSystem_Preload("cannon_impact_rock.ps");
		ParticleSystem_Preload("dust_medium_long_onehsot.ps");
		
		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		//////////////
		// Preload sounds
		//Sound_PreloadProject("02_02_courtyard");
		//Sound_PreloadGroup("creatures/foley/creature/ghoul", true);
		
		Sound_PreloadEvent("02_02_courtyard/tank/tank_fire");
		Sound_PreloadEvent("02_02_courtyard/tank/tank_internal_debris");
		Sound_PreloadEvent("02_02_courtyard/tank/tank_fall");
		Sound_PreloadEvent("02_02_courtyard/tank/tank_fall_stinger");
		
		//////////////
		// Preload entities
		Entity_Preload("player4.ent");
		Entity_Preload("player4_head.ent");
		
		///////////////
		// Preload materials
		Material_Preload("Tasi_Body_Upgrade_hands_ghoul_" + GhoulProgression_GetProgression() + ".mat");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(4);
		
		// Any general setup of script / entities
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			// TEMP!
			if (ItemType_GetCountInInventory("Lantern") < 1)
			{
				Item_AddToInventory("Lantern");
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
			}
			
			if (ItemType_GetCountInInventory("Matchbook") < 1)
			{
				Item_AddToInventory("Matchbook");
				Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
			}
			
			Item_AddToInventory("HerbertOil");
		}
		
		Sketchbook_CompleteIdea("reach_outpost");
		Sketchbook_NewIdeasPage();
		
		Hint_Unblock("Hints", "HintPermafail");
		FearHandler_SetAllowLanternReminderHint(true);
		FearHandler_SetAllowLanternRefillHint(true);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		Game_AutoSave();
		
		Achievement_Unlock(eAchievement_Pilgrim);
		
		PlayerBody_SetActive(true);
		
		FearHandler_SetActive(true);
		FearHandler_SetPermaFailEnabled(false);
        
        Heat_SetActive(false);
		
		Player_SetMapDeepShadow(0.f);
		Player_SetVertigoActive(false);
		
		cVector3f vRot = cVector3f(0, cMath_ToRad(278), 0);
		cLux_GetCurrentMap().GetWorld().SetSkyboxRotation(vRot);
		
		//////////////////////
		// Set up courtyard
		OnTimer_UpdateTurbine("");		
		ParticleSystem_SetActive("PS_WindowBang", false);		
		Visibility_SetAreaActive("VisibilityArea_TankHole", false);
		
		Prop_SetRenderLayer("FountainWater", -1);
				
		//////////////////////
		// Set up tank
		if (cScript_GetGlobalVarBool("Outpost_InitialTankSetup") == false)
		{
			cScript_SetGlobalVarBool("Outpost_InitialTankSetup", true);	
			SetTurretLocked(true);
		}
		else
		{			
			SetTurretLocked(cScript_GetGlobalVarBool("Outpost_TankTurretLocked"));
		}
		
		ParticleSystem_SetActive("PS_TankGround_*", false);
		ParticleSystem_SetActive("PS_TankHoleDust_*", false);
		
		cLuxProp@ pBreachLever = Map_GetProp("BreachLever");
		if (pBreachLever !is null && pBreachLever.GetInteractConnectionNum() < 2)
			pBreachLever.AddInteractConnection("Main", Map_GetProp("FiringMechanism"), true);
			
		Entity_AttachToEntity("InteractAux_BreachLever", "BreachLever", "Body_1", true, true, true);
		Entity_AttachToEntity("InteractAux_TurretLever", "TurretLever", "Body_1", true, true, true);
		Entity_AttachToEntity("InteractAux_Key", "TurretLever", "Body_1", true, true, true);
		
		////////////////////////
		// Went through LQ?
		bool bAnsweredRadio = cScript_GetGlobalVarBool("Outpost_AnsweredRadio");
		if (bAnsweredRadio)
		{
			if (cScript_GetGlobalVarBool("Outpost_LQDone") == false && mbFrustratedGhoulSoundsPlayed == false)
			{
				mbFrustratedGhoulSoundsPlayed = true;
				Entity_SetInteractionDisabled("LevelDoor_LQ_Back", true);
				Entity_SetActive("Trigger_PlayFrustratedGhoulSounds", true);
			}
			
			if (cScript_GetGlobalVarBool("Outpost_LQDone"))
			{
				Achievement_Unlock(eAchievement_Communicator);
			}
			
			LevelDoor_SetLocked("LevelDoor_LQ_Back", false);
				
			Voice_StopAll();
			Sound_Stop("Sound_RadioStatic", 0.f);
			
			Entity_SetActive("Trigger_ActivateRadioSignal_*", false);
			Entity_SetActive("Trigger_PlayRadioVoice", false);
			Entity_SetActive("Trigger_ShowRadioCC", false);
			Entity_SetActive("Trigger_PlayDoorMemory", true);
		}
		
		ParticleSystem_SetActive("PS_DoorBang_*", false);
		
		SetupRadioLight(bAnsweredRadio == false);
		SetRadioLampState(bAnsweredRadio ? 0 : 1);
		
		////////////////////////
		// Player needs to go back to LQ!
		if (cScript_GetGlobalVarInt("Outpost_ArsenalProgress") == 2 && 
			cScript_GetGlobalVarBool("Outpost_LQDone") == false &&
			cScript_GetGlobalVarBool("Outpost_AnsweredRadio") &&
			cScript_GetGlobalVarBool("Outpost_SilhouetteScarePlayed") == false)
		{
			Entity_SetActive("Trigger_WindowScareStart", true);
			
			Map_AddTimer("Timer_ShowRemindersHint", 60.f * 2.f, "OnTimer_ShowRemindersHint");
			Map_SetTimerUserVarInt("Timer_ShowRemindersHint", 1);
		}
		
		////////////////////////
		// Player needs to go back to Arsenal!
		if (cScript_GetGlobalVarBool("Outpost_LQDone") &&
			cScript_GetGlobalVarBool("Outpost_VultureScarePlayed") == false &&
			Entity_GetCollide("Area_BackDoor", "player"))
		{
			Entity_SetActive("vulture", true);
			Entity_PlayAnimation("vulture", "tank_fly_way", 0.f, false, false);
			Map_GetEntity("vulture").GetMeshEntity().GetAnimationStateFromName("tank_fly_way").SetSpeed(0.f);
			
			Entity_SetActive("Trigger_VultureScare_*", true);
			SwingDoor_SetOpenAmount("TurretHatch_*", 1.f);
			
			Sound_Play("Sound_VultureInsideLoop", 1.0f);
		}

		Music_PlayExt("A2_2_2_Courtyard_Ambience.ogg", true, 0.15f, 1.0f, 5.0f, 1.0f, eMusicPrio_BgAmb, true);
	}

