		if (alAction == eAction_TestPlus)
		{
			Entity_SetActive("InteractArea_ClimbOutTankFake", false);				 
			Entity_SetActive("Tank", false);
			Entity_SetActive("Turret", false);
			Entity_SetActive("TurretHatch_*", false);
