	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 2 *PLAYER REACHES THE STORAGE ROOM AND FINDS A WAY INSIDE THE RELIC ROOM*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 2 here.*/
		
		bool mbGrenadePulled = false;
		bool mbGrenadeActivated = false;
		int mpDOF = 0;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 2 here.*/
		
		bool OnCollide_GateVisibility(const tString &in asParent, const tString &in asChild, int alState)
		{
			tString sEnt = Entity_GetVarString(asParent,"");
			iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(sEnt);
			
			if (alState == 1)
			{
				mpDOF = Effect_DoF_Start(0.4f,30,0.1f,0.5f);
				pEnt.GetMeshEntity().SetCoverageAmount(0.75f);
			}
			if (alState == -1)
			{
				Effect_DoF_FadeOut(mpDOF,0.2f);
				pEnt.GetMeshEntity().SetCoverageAmount(1.f);
				
			}
			return true;
		}
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// Event A *Player explores the Storage Room and observes the Relic Room*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 2, Event A here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functionsthat are only used in Scene 2, Event A here.*/
		
		void OnLookAt_Grenade(const tString &in asEntity, int alState)
		{
			if (ItemType_GetCountInInventory("RelicRoomKey") != 0) return;
			
			Voice_Play("Dialogue_SeeGrenade");
			//Music_Play("A2_2_3_Grenade_Notice.ogg", 0.25f, false, eMusicPrio_MinorEvent);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Sulfur(const tString &in asEntity, int alState)
		{
			if (mbKnowsAboutIngredients == false) return;
			
			Sketchbook_AddIdea("find_sulfurlocation");
			Voice_Play("Dialogue_SeeSulfur");
			Entity_SetPlayerLookAtCallback(asEntity,"");
		}
		 
		//-------------------------------------------------------
	 
		//} END Event A *Player explores the Storage Room and observes the Relic Room*
		
		/////////////////////////////////////////
		// Event B *Player throws up while exploring the Storage Room*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 2, Event B here.*/
			 
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 2, Event B here.*/
		
		//-------------------------------------------------------
		
		bool OnCollide_ActivateWhatHappenedHere(const tString &in asParent, const tString &in asChild, int alState)
		{
			//Voice_Play("Dialogue_SeeTortureScene");
			Entity_SetActive("Trigger_WhatHappenedHere",true);
		    return false;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_WhatHappenedHere(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Dialogue_SeeTortureScene");
			Music_Play("A2_2_3_Corpse_Discover.ogg", 0.25f, false, eMusicPrio_MinorEvent);
			Map_AddTimer("Timer_CorpseRoomMusic", 17.0f, "OnTimer_CorpseMusicRoom");
			return false;
		}
		
		//------------------------------------------------------- 
		
		void OnLookAt_WhatHappenedHere(const tString &in asEntity, int alState)
		{
			Voice_Play("Dialogue_SeeTortureScene");
			Music_Play("A2_2_3_Corpse_Discover.ogg", 0.25f, false, eMusicPrio_MinorEvent);
			Map_AddTimer("Timer_CorpseRoomMusic", 17.0f, "OnTimer_CorpseMusicRoom");
		}
		 
		//-------------------------------------------------------
		
		void OnTimer_CorpseMusicRoom(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_CorpseMusic", true);
			Music_Stop(6.0f, eMusicPrio_MinorEvent);
		}
		
		//-------------------------------------------------------

		bool OnTrigger_PlayCorpseMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Music_PlayExt("A2_2_3_Corpse_Ambience.ogg", true, 0.15f, 1.0f, 10.0f, 0.0f, eMusicPrio_SceneAmb, true);
				return true;
			}
			else
			{
				Music_Stop(10.0f, eMusicPrio_SceneAmb);
				return true;
			}
		}
		
		//-------------------------------------------------------
	 
		//} END Event B *Player throws up while exploring the Storage Room*
		
		/////////////////////////////////////////
		// Event C *Player obtains the RELIC ROOM KEY and unlocks the RELIC ROOM DOOR*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 2, Event C here.*/		
			 
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 2, Event C here.*/
		
		void OnLookAt_ActivateKeyPickup(const tString &in asEntity, int alState)
		{
			Entity_SetActive("InteractAux_Key",true);
			Entity_SetInteractionDisabled("temp_key",false);
		}
		
		//-------------------------------------------------------
		
		bool CanUse_RelicKey(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{
			return (asPickedEntity == "door" || (asPickedEntity == "InteractAux_Hook" && mbDisarmedTrap == false));
		}
		
		//-------------------------------------------------------
		
		bool OnUse_RelicKey(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			if (Entity_GetCollide("player","Trigger_RelicRoom"))
			{
				Entity_SetActive("key_attached_inside",true);
				Prop_AlignRotation("key_attached_inside","key_attached_inside_end",10,8,1,true,"RelicRoom_Unlock");
			}
			else
			{
				Entity_SetActive("key_attached_outside",true);
				Prop_AlignRotation("key_attached_outside","key_attached_outside_end",10,8,1,true,"RelicRoom_Unlock");
			}
			
			Sound_CreateAtEntity("Sound_DoorUnlock","level_entity_shared/doors/relic_door/relic_door_unlock","door",0,true);
			Item_RemoveFromInventory(ItemType_GetFirstInInventory("RelicRoomKey"));
			Entity_SetActive("Trigger_KeyHole_*", false);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_RelicDoor(const tString &in asEntity)
		{			
			if (mbGrenadeActivated) return;
			
			//if (Sound_Exists("Sound_DoorUnlock") == false) Sound_CreateAtEntity("Sound_DoorUnlock","level_entity_shared/doors/relic_door/relic_door_locked","door");	

			if (Map_TimeHasPassed("Timer_SwingRope",0.5f))
				Map_AddTimer("Timer_SwingRope",0,"OnTimer_SwingRope");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SwingRope(const tString &in asTimer)
		{
			iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(msRelicRope);
			pRope.GetParticle(4).AddForce(cVector3f(0,100,50));	
			//pRope.GetParticle(6).AddForce(cVector3f(0,200,50));		
			//Map_GetEntity("door").GetBodyFromName("Body_2").AddImpulse(cVector3f_Left);
			Map_GetEntity("door").GetBodyFromName("Body_2").AddImpulse(cVector3f(0.04f,0,0));
		}
		
		//-------------------------------------------------------
		
		void RelicRoom_Unlock(const tString &in asPropName)
		{
			SwingDoor_SetLocked("door",false,false);
			Entity_SetActive("Trigger_OpenDoor",true);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_InsideRelicRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			bool bDisableCabinet = (alState == 1) ? false : true;
			Entity_SetInteractionDisabled("arab_cabinet_door_right_1",bDisableCabinet);

			return true;
		}
 
		//-------------------------------------------------------
	 
		//} END Event C *Player obtains the RELIC ROOM KEY and unlocks the RELIC ROOM DOOR*
		
		/////////////////////////////////////////
		// Event D *Player disarms the WIRE TRAP from the RELIC ROOM DOOR*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 2, Event D here.*/
		
		bool mbDisarmedTrap = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 2, Event D here.*/
		
		void OnInteractLeave_Player_Grenade(const tString &in asEntity)
		{
			Sound_Stop("Sound_RopeCreak",0.3f);
			Sound_Stop("Sound_GrenadeRattleLoop",0.3f);
			Player_ResetCameraLimits();		
			Map_AddTimer("Timer_RemoveFearFromGrenade",2,"OnTimer_RemoveFearFromGrenade");
			Prop_MoveLinearTo("grenade_1","PosArea_GrenadeStart",1,1.5f,2,true);
			Player_FadeLookSpeedMulTo(1, 0.5f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_HookInteractable(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				Entity_SetInteractionDisabled("hook",false);
			}
			else
			{
				if (!mbDisarmedTrap)
				{
					Entity_SetInteractionDisabled("hook",true);
				}
			}	
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_GrenadeInteractable(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbGrenadeActivated) return false;
			
			if (alState == 1)
			{
				Entity_SetInteractionDisabled("grenade_1",false);
			}
			else
			{
				if (!mbDisarmedTrap)
					Entity_SetInteractionDisabled("grenade_1",true);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_Player_Hook(const tString &in asEntity)
		{
			if (mbGrenadePulled) return;
			if (mbGrenadeActivated) return;
			
			Map_AddTimer("Timer_CheckHookPulled",0.01f,"OnTimer_CheckHookPulled");
			Map_AddTimer("Timer_CheckHoldingHook",0.0f,"OnTimer_CheckHoldingHook");
			
			if (mbDisarmedTrap) return;

			Player_StartLookAt("Trigger_HookLookAt",5,1,1,false);
			Sound_CreateAtEntity("Sound_RopeCreak","02_03_arsenal/trap/rope_creak",asEntity,0.1f,false,2);
			Sound_CreateAtEntity("Sound_GrenadeRattleLoop","02_03_arsenal/trap/grenade_rattle_loop",asEntity);
		}
		
		void OnInteractLeave_Player_Hook(const tString &in asEntity)
		{
			
			if (mbDisarmedTrap) return;
			
			Sound_Stop("Sound_RopeCreak",0.3f);
			Sound_Stop("Sound_GrenadeRattleLoop",0.3f);
			Player_StopLookAt(1);
			Player_StartLookAt("hook",5,1,1,true);
			Map_AddTimer("Timer_RemoveHookLookAt",0.5f,"OnTimer_RemoveHookLookAt");
			Map_AddTimer("Timer_RemoveFearFromGrenade",2,"OnTimer_RemoveFearFromGrenade");
			//Player_FadeFOVMulTo(mfFOV,2.f);
			mbTensionFOV = false;
		}
		
		//-------------------------------------------------------
		
		float mfYawLimit = 10;
		float mfPitchLimit = 10;
				
		void OnInteract_Player_Grenade(const tString &in asEntity)
		{		
			cCamera@ pCam = cLux_GetPlayer().GetCamera();
			float fYaw = cMath_ToDeg(pCam.GetYaw());
			float fPitch = cMath_ToDeg(pCam.GetPitch());		
			Player_SetYawLimits(fYaw-mfYawLimit,fYaw+mfYawLimit);
			Player_SetPitchLimits(fPitch,fPitch);
			
			Map_AddTimer("Timer_StartCheckingGrenade",0.2,"OnTimer_StartCheckingGrenade");
			Player_SetLookSpeedMul(0.f);
			
			Sound_CreateAtEntity("Sound_RopeCreak","02_03_arsenal/trap/rope_creak",asEntity,0.1f,false,2);
			Sound_CreateAtEntity("Sound_MetalCreak","prototype/doors_hinges/metal/metal_latch/metal_latch_creak",asEntity,0.1f,false,1);
			Sound_CreateAtEntity("Sound_GrenadeRattle","02_03_arsenal/trap/grenade_rattle",asEntity);
		}
		
		//-------------------------------------------------------
		
		bool mbCheckGrenade = false;
		
		void OnTimer_StartCheckingGrenade(const tString &in asTimer)
		{
			mbCheckGrenade = true;
		}
		
		bool OnCollide_Player_PullRope(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbDisarmedTrap) return false;

			Grenade_Torn();
			return false;
		}
		
		void OnTimer_CheckHookPulled(const tString &in asTimer)
		{
			if (mbGrenadePulled) return;
			
			//TO DO: This timer keeps on running after the player releases the grab. Needs to be fixed.
			
			if (Entity_GetCollide("hook","Trigger_PullRopeBorder_1") || Entity_GetCollide("hook","Trigger_PullRopeBorder_2") || 
				Entity_GetCollide("hook","Trigger_PullRopeBorder_3") || Entity_GetCollide("hook","Trigger_PullRopeBorder_4") || 
				Entity_GetCollide("hook","Trigger_PullRopeBorder_5") || Entity_GetCollide("hook","Trigger_PullRopeBorder_6") ||
				Entity_GetCollide("hook","Trigger_PullRopeBorder_7") || Entity_GetCollide("hook","Trigger_PullRopeBorder_8")) 
			{
				//Player_ChangeStateToNormal(); // drop hook
				//Entity_AddImpulse("hook",cVector3f(0,0.1f,0),true,true);
				Sound_CreateAtEntity("Sound_RopeBreak","02_03_arsenal/trap/rope_break","hook");
				mbGrenadePulled = true;
				
				Rope_Detach(msRelicRope,"grenade_1");
				Rope_SetCollide(msRelicRope,true,false);
				Rope_SetStartParticleMass(msRelicRope,1);
				Grenade_Activate();
			}
			else
			{
				//Debug_Log("Check Pull");
				Map_RestartCurrentTimer();
				return;
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckHoldingHook(const tString &in asTimer)
		{
			cLux_AddDebugMessage("CHEDK");
			if (Entity_IsInteractedWith("hook"))
			{
				//if (!mbTensionFOV)
				//	Player_FadeFOVMulTo(mfFOV+0.1f,1.f);

				FearHandler_SetForcedAddFearRate(0.5f,1,false,2,10,-10);
				mbTensionFOV = true;
				Map_RestartCurrentTimer();
				
				if (Map_TimerExists("Timer_RemoveFearFromGrenade"))
					Map_RemoveTimer("Timer_RemoveFearFromGrenade");
				
			}
			else
			{
				Sound_Stop("Sound_RopeCreak",0.3f);
				Sound_Stop("Sound_GrenadeRattleLoop",0.3f);
				Player_StopLookAt(1);
				Player_StartLookAt("hook",5,1,1,true);
				Map_AddTimer("Timer_RemoveHookLookAt",0.5f,"OnTimer_RemoveHookLookAt");
				Map_AddTimer("Timer_RemoveFearFromGrenade",2,"OnTimer_RemoveFearFromGrenade");
				//Player_FadeFOVMulTo(mfFOV,2.f);
				mbTensionFOV = false;
			}
		}
		
		//-------------------------------------------------------
		
		bool mbPullGrenade = false;
		
		void UpdateGrenade(float afTimeStep)
		{
			
			iCharacterBody@ pPlayerBody = cLux_GetPlayer().GetCharacterBody();
			cCamera@ pCamera = cLux_GetPlayer().GetCamera();
			
			if (Entity_IsInteractedWith("grenade_1") && mbCheckGrenade)
			{
				FearHandler_SetCameraRollActive(false);
				///////////////////////
				// Align body
				if (pPlayerBody.GetYaw() > pCamera.GetYawMaxLimit())
					pPlayerBody.SetYaw(pCamera.GetYawMaxLimit());
				if (pPlayerBody.GetYaw() < pCamera.GetYawMinLimit())
					pPlayerBody.SetYaw(pCamera.GetYawMinLimit());	
					
				//if (!mbTensionFOV)
				//	Player_FadeFOVMulTo(mfFOV-.4f,1.f);
					
				//cLux_AddDebugMessage("DIFF MAX: "+(pCamera.GetYawMaxLimit() - pCamera.GetYaw())+" DIFF MIN: "+(pCamera.GetYawMinLimit() - pCamera.GetYaw()));
					
				if (!mbPullGrenade)
				{
					if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed())
						Player_FadeLookSpeedMulTo(0.08f, 0.2f);
					else
						Player_FadeLookSpeedMulTo(0.013f, 0.2f);
					cLux_AddDebugMessage("LOKK SPEED: "+Player_GetLookSpeedMul());
					
					if (pCamera.GetYawMaxLimit() - pCamera.GetYaw() > 0.3f)// ||
						//pCamera.GetYawMinLimit() - pCamera.GetYaw() < -0.3f )
					{
						//cLux_AddDebugMessage("DIFF MAX: "+(pCamera.GetYawMaxLimit() - pCamera.GetYaw())+" DIFF MIN: "+(pCamera.GetYawMinLimit() - pCamera.GetYaw()));
						cLux_AddDebugMessage("PULLING");
						if (Sound_Exists("Sound_GrenadeRattle"))
							Sound_Stop("Sound_GrenadeRattle",0);
						Sound_CreateAtEntity("Sound_Warning","02_03_arsenal/trap/grenade_rattle","grenade_1");
						
						//Player_SetLookSpeedMul(1);
						//Player_ChangeStateToNormal();
						cLux_AddDebugMessage("TORN!");
						Grenade_Torn();
						//Prop_MoveLinearTo("grenade_1","PosArea_GrenadeEnd",0.5f,1,0,false,"OnEndOfMove_TearGrenade");
						//Prop_AlignRotation("grenade_1","PosArea_GrenadeEnd",0.5f,1,0.5f,true,"");
						mbPullGrenade = true;
					}
					
				}
				else
				{
					Player_FadeLookSpeedMulTo(0.3f, 0.5f);
					Prop_MoveLinearTo("grenade_1","PosArea_GrenadeEnd",0.2f,1,0,false,"OnEndOfMove_TearGrenade");
				}

				if (pCamera.GetYaw() < pCamera.GetYawMaxLimit()-cMath_ToRad(1) &&
					pCamera.GetYaw() > pCamera.GetYawMinLimit()+cMath_ToRad(1))
				{
					//cLux_AddDebugMessage("NOT PULLING");
					Prop_MoveLinearTo("grenade_1","PosArea_GrenadeStart",1,1.5f,0.5f,true);
					//Prop_AlignRotation("grenade_1","grenade_0",0.5f,1,0.5f,true,"");
					mbPullGrenade = false;
				}
				
				
					
				FearHandler_SetForcedAddFearRate(0.8f,1,false,2,10,-10);
				mbTensionFOV = true;
				Map_RestartCurrentTimer();
				
				if (Map_TimerExists("Timer_RemoveFearFromGrenade"))
					Map_RemoveTimer("Timer_RemoveFearFromGrenade");
			}
			else
			{
				mbCheckGrenade = false;
				mbPullGrenade = false;
				mbTensionFOV = false;
				FearHandler_SetCameraRollActive(true);
			}
		}
		
