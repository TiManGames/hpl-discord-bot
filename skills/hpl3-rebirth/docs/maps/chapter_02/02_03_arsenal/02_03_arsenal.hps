		void OnTimer_RemoveHookLookAt(const tString &in asTimer)
		{
			Player_StopLookAt(0.02f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RemoveFearFromGrenade(const tString &in asTimer)
		{
			FearHandler_SetForcedAddFearRate(-10,4,false);			
		}
		
		//-------------------------------------------------------
		
		void OnTorn_Release(const tString &in asEntity)
		{
			Entity_SetActive("Sticky_Rope",false);
			Entity_SetActive("InteractAux_Hook",false);
			Entity_SetPlayerInteractCallback(asEntity,"",true);
			Entity_RemoveEntityAttachment("hook");
			Player_StopLookAt(1);
			Sound_Stop("Sound_RopeCreak",0.5f);
			Sound_CreateAtEntity("Sound_Unhook","03_04_pillar_room/config_device/config_ring_position_lock",asEntity);
			mbDisarmedTrap = true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Grenade_PulledFromHand(const tString &in asParent, const tString &in asChild, int alState)
		{
			cLux_AddDebugMessage("PULLED");
			Grenade_Torn();
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnEndOfMove_TearGrenade(const tString &in asEntity)
		{
			Player_ChangeStateToNormal();
			cLux_AddDebugMessage("TORN!");
			Grenade_Torn();
		}
		
		//-------------------------------------------------------
		
		void Grenade_Torn()
		{
			if (mbGrenadeActivated || mbGrenadePulled) return;
			
			FearHandler_SetForcedAddFearRate(1,5,false,10,-10);
			cLux_GetCurrentMap().GetEntityByName("hook").GetMainBody().SetMass(0);
			Rope_Detach(msRelicRope,"grenade_1");
			Rope_SetStartParticleMass(msRelicRope,1);
			Rope_SetEndParticleMass(msRelicRope,1);
			Rope_SetCollide(msRelicRope,true,false);
			mbAttachRopeToHook = true;
			
			//Player_ResetCameraLimits();
			//Entity_RemoveEntityAttachment("hook");
			Entity_SetActive("Sticky_Grenade",false);
			Entity_SetActive("InteractAux_Hook",false);
			Player_StopLookAt(1);
			Grenade_Activate();
		}
				
		//-------------------------------------------------------
				
		void OnDetach_TriggerGrenade(const tString &in asStickyArea, const tString &in asBodyName)
		{
			Grenade_Torn();
		}
 
