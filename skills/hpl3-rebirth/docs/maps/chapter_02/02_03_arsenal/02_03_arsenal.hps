	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		
	}
	
	bool mbCheckBoost = false;
	
	void Player_Boost(float afTimeStep)
	{
		iCharacterBody @pPlayerBody = cLux_GetPlayer().GetCharacterBody();
		if (pPlayerBody.IsOnGround()) return;
		if (pPlayerBody.GetMoveSpeed(eCharDir_Forward) <= 0) return;
		
		float fSpeed = pPlayerBody.GetVelocity(afTimeStep).Length();
		Debug_Log("Player Speed: "+fSpeed);
		
		if (fSpeed < 3.8f)
		{
			pPlayerBody.AddForce(pPlayerBody.GetForward()*8000);
			Debug_Log("ADD FORCE");
		}
		
		mbCheckBoost = false;
	}

	//-------------------------------------------------------
	
	void Update(float afTimeStep) 
	{	
		if (mbCheckBoost) Player_Boost(afTimeStep);
				
		UpdateWindows();
		UpdateGrenade(afTimeStep);
		UpdateGrinder(afTimeStep);
			
		if (Entity_IsInteractedWith("brandon_corpse_1"))
		{
			if ((cLux_GetPlayer().GetCharacterBody().GetYaw() > cLux_GetPlayer().GetCamera().GetYawMaxLimit())) 
				cLux_GetPlayer().GetCharacterBody().SetYaw(cLux_GetPlayer().GetCamera().GetYawMaxLimit());
			if ((cLux_GetPlayer().GetCharacterBody().GetYaw() < cLux_GetPlayer().GetCamera().GetYawMinLimit()))
				cLux_GetPlayer().GetCharacterBody().SetYaw(cLux_GetPlayer().GetCamera().GetYawMinLimit());		
		}
		if (mbAttachRopeToHook)
		{
			iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope("RelicRope");
			if (Rope_Exists("RelicRope"))
				pRope.GetEndParticle().SetPosition(Map_GetEntity("hook").GetMainBody().GetJoint(0).GetPivotPoint(),true);
		}
		
		//if (Entity_GetCollide("player","Trigger_CaptainRadius"))
		//{
		//	cLux_AddDebugMessage("GRENADE: "+Entity_IsActive("grenade_2"));// "HEHEJEH"+cMath_RandRectf(0,100));
		//}
	}
	
