		//-------------------------------------------------------
		
		void Grenade_Activate()
		{
			if (mbGrenadeActivated) return;
			
			FearArea_SetGivesFear("Fear_1",true);
			Map_AddTimer("Timer_ResetFearAreas",10,"OnTimer_ResetFearAreas");
			
			Entity_SetActive("Trigger_LookAtGrenade",false);
			Entity_SetActive("Trigger_Shake",false);
			Entity_SetActive("grenade_1",false);
			Entity_SetActive("grenade_2",true);
			Map_GetEntity("grenade_2").GetBodyFromName("handle").SetMass(0.5f);
			
			Music_PlayExt("A2_2_3_Grenade_Activate.ogg", false, 0.5f, 1.0f, 3.0f, 0.0f, eMusicPrio_BigEvent, false);
			Sound_CreateAtEntity("Sound_GrenadePin", "02_03_arsenal/grenade/grenade_pin", "grenade_2");
			
			Voice_StopAll();
			Voice_PlayDelayed("Dialogue_GrenadeFizzing",0.6f);
			
			if (mbDisarmedTrap)
				Entity_AddImpulse("grenade_2",cVector3f(0,-6,2),true,true);
			else
			{
				if (SwingDoor_GetLocked("door"))
					Entity_AddImpulse("grenade_2",cVector3f(0,-6,2),true,true); //Entity_AddImpulse("grenade_2",cVector3f(-2.1,1,2),true,true);
				else
					Entity_AddImpulse("grenade_2",cVector3f(0,-12,2),true,true);
				
			}
			//FearHandler_SetForcedAddFearRate(0.6,3,false);
			Map_AddTimer("Timer_Explosion",4.3f,"OnTimer_Explosion");
			
			cScript_SetGlobalVarBool("Outpost_Arsenal_GrenadeTriggered", true);
			mbGrenadeActivated = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ResetFearAreas(const tString &in asTimer)
		{
			FearArea_SetGivesFear("Fear_1",false);
			FearArea_SetGivesFear("Fear_1",false);
		}
		
		//-------------------------------------------------------
		
		void Entity_ExplodeSurrounding(const tString &in asEntity, float afDist, float afImpulse)
		{
			cLux_ProfileStart("EXPLODE");
			
			cVector3f vPos = cLux_GetCurrentMap().GetEntityByName(asEntity).GetPosition();
			
			array<iPhysicsBody@> vNearbyBodies;
			array<iPhysicsBody@> vClosestBodies;
			array<iLuxEntity@> vNearbyEntities;
			
			cVector3f vMin = vPos - cVector3f_One*afDist*0.6f;
			cVector3f vMax = vPos + cVector3f_One*afDist*0.6f;
			
			vMin = vPos - cVector3f_One*afDist/2;
			vMax = vPos + cVector3f_One*afDist/2;
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(vMin,vMax,vClosestBodies);
			cLux_AddDebugMessage("BODIES: "+vClosestBodies.length());
			for (int i = 0; i < vClosestBodies.length(); i++)
			{
				// PUSH
				iPhysicsBody@ pBody = vClosestBodies[i];
				if (pBody is null) continue;
				iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
				if (pEnt is null) continue;
				if (pEnt.GetEntityType() != eLuxEntityType_Prop) continue;		
				if (pEnt.GetClassName() == "cScrPropPickup" ||
					pEnt.GetClassName() == "cScrPropReadable")
				{
					continue;
				}
				
				cVector3f vDir = pBody.GetWorldPosition() - cLux_GetCurrentMap().GetEntityByName(asEntity).GetPosition();
				float fDist = vDir.Length();
				vDir.Normalize();
				float fDistMul = 1 - (fDist/afDist);
				fDistMul = cMath_Clamp(fDistMul, 0.1f, 1);
				float fMassMul = 1 - cMath_Clamp(pBody.GetMass(),0,1);
				fMassMul = cMath_Clamp(fMassMul, 0.5f,1);
				cVector3f vFinalImpulse = vDir*afImpulse*fDistMul*fMassMul;
				//cLux_AddDebugMessage("PREIMPULSE: "+pEnt.GetName());
				pBody.AddImpulse(vFinalImpulse);
				//cLux_AddDebugMessage("IMPULSED: "+pEnt.GetName());
				
				
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Explosion(const tString &in asTimer)
		{
			if (Entity_GetCollide(msGrenade,"Trigger_SulfurDud"))
			{
				Grenade_RadiusDud();
			}
			else
			{
				float fDist = Entity_GetDeltaToEntity(msGrenade,"player").Length();
				
				if (fDist < 1.5f)
				{
					Grenade_RadiusDud();
				}
				else
				{
					// EXPLODE
					
					Effect_Shake_Start(0.5f, 0.5f, 0.2f, 0.75f, 0.75f, 0);
					
					if (fDist < 6)
					{		
						bool bLOS1 = cLux_CheckLineOfSight(Map_GetEntity(msGrenade).GetPosition(), cLux_GetPlayer().GetCamera().GetPosition(), false, false, null);
						bool bLOS2 = cLux_CheckLineOfSight(Map_GetEntity(msGrenade).GetPosition(), cLux_GetPlayer().GetCharacterBody().GetFeetPosition()+cVector3f(0,0.05f,0), false, false, null);
						
						Debug_Log("HEAD: "+bLOS1+" FEET "+bLOS2);
						
						if (bLOS1 == false && bLOS2 == false) 
							Grenade_RadiusSafe();
						else
							Grenade_RadiusDamage();
						
					}
					else
						Grenade_RadiusSafe();
						
					iPhysicsBody@ pGrenade = Map_GetEntity(msGrenade).GetMainBody();
					
					cLuxArea@ pCaptainArea = cLux_ID_Area(Map_GetEntity("Trigger_CaptainRadius").GetID());
					cLuxArea@ pRightArea = cLux_ID_Area(Map_GetEntity("Trigger_RightSide").GetID());
					cLuxArea@ pLeftArea = cLux_ID_Area(Map_GetEntity("Trigger_LeftSide").GetID());
					
					
					
					if (pCaptainArea.CheckBodyCollision(pGrenade,cLux_GetCurrentMap()))
					{
						
						// Give tiny extra push to the door to make it look open in case it bounces closed
						Map_AddTimer("Timer_OpenDoor",1.5f,"OnTimer_OpenDoor");
						SwingDoor_PushOpen("door",1,1);
						SwingDoor_SetLocked("door",false,true);
						
						mbAttachRopeToHook = false;
						Prop_SetStaticPhysics("Captain_Chair",false);
						Entity_SetInteractionDisabled("Captain_Chair",false);
						Entity_SetActive("Captain_Flag",false);
						Entity_SetActive("Captain_Oil_*",false);
						Entity_SetActive("bottle_laudanum_2",false);
						Entity_SetActive("brandon_corpse_1",false);
						Entity_SetActive("arab_pillow_01_1",false);
						//Entity_SetActive("Captain_Exploded",true);
						Prop_SetHealth("relicroom_wall_breakable",0);
						OnBreak_WallExit("relicroom_wall_breakable");
						Entity_SetActive("intact_*", false);
						Entity_SetActive("destroyed_*", true);
						Decal_SetDynamicVisible("decal_destroyed_*",true);
						Decal_SetDynamicVisible("decal_cpt_vomit_*",false);
						Entity_SetActive("keyguy_*", true);
						Decal_SetDynamicVisible("decal_keyguy_*",true);
						Decal_SetDynamicVisible("decal_keyguyinout_*",true);
						Entity_SetActive("Readable_LefevresNote_1",false);
						Entity_SetActive("Readable_LefevresNote_2",true);
						Entity_SetActive("bottle_laudanum_empty_*",false);
						Entity_SetActive("pen_fancy_1", false);
						Entity_SetActive("candle_gate_left", false);
						Entity_SetActive("candle_gate_right", false);
						Entity_SetActive("blown_candle_gate_*", true);
						Rope_SetActive(msRelicRope,false,false);
						Entity_SetActive("hook",false);
						//cLux_GetCurrentMap().GetEntityByName("hook").GetMainBody().SetMass(1);
						//Entity_RemoveEntityAttachment("hook");
						//Tear_ForceTear("hook");
						Entity_SetActive("Trigger_HookInteractable",false);
						//Entity_SetInteractionDisabled("hook", false);
						
						cScript_SetGlobalVarBool("Outpost_Arsenal_CaptainExploded",true);
						cScript_SetGlobalVarBool("Outpost_Arsenal_KeyGuyExploded",true);
						
						// TO DO: Swap key corpse
						//Entity_SetActive("lq_corpse_drag",false);
						//Entity_SetActive("deadcaptain_2",true);
						
						if (Entity_Exists("temp_key"))
						{
							if (SwingDoor_GetLocked("door"))
								Entity_SetActive("temp_key_exploded", true);
							else
								Entity_SetActive("temp_key_exploded_grab", true);
							Entity_SetActive("temp_key", false);
						}
						
					}
					
					if (pRightArea.CheckBodyCollision(pGrenade,cLux_GetCurrentMap()))
					{					
						Prop_SetHealth("relicroom_wall_breakable",0);
						OnBreak_WallExit("relicroom_wall_breakable");
						Entity_SetActive("candle_storage_right*", false);
						Entity_SetActive("blown_candle_right*",true);
						
						if (Entity_GetCollide("french_wine_1","Trigger_RightSide"))
							Prop_SetHealth("french_wine_1",0);
					}
					
					if (pLeftArea.CheckBodyCollision(pGrenade,cLux_GetCurrentMap()))
					{
						Prop_SetStaticPhysics("box",false);
						Entity_SetActive("candle_storage_left_1", false);
						Entity_SetActive("blown_candle_left_1",true); 
						Entity_SetActive("keyguy_*", true);
						Decal_SetDynamicVisible("decal_keyguy_*",true);
						
						cScript_SetGlobalVarBool("Outpost_Arsenal_KeyGuyExploded",true);
						
						// TO DO: Swap key corpse
						//Entity_SetActive("lq_corpse_drag",false);
						//Entity_SetActive("deadcaptain_2",true);
						
						Entity_SetActive("InteractAux_Key",false);
						Entity_SetActive("lantern_stairs",false);
						Entity_SetActive("archaeology_lamp_broken_rigid_1", true);
						
						Entity_SetActive("beduin_carpet_tent_door_2", false);
						Entity_SetActive("beduin_carpet_tent_door_1", true);
						
						if (Entity_Exists("temp_key"))
						{
							if (SwingDoor_GetLocked("door"))
								Entity_SetActive("temp_key_exploded", true);
							else
								Entity_SetActive("temp_key_exploded_grab", true);
							Entity_SetActive("temp_key", false);
						}
						
					}
											
					if (Entity_GetCollide(msGrenade,"Trigger_GrenadeOutside_1") || Entity_GetCollide(msGrenade,"Trigger_GrenadeOutside_2"))
					{
						PlankFall(1);
						PlankFall(2);
					}
				}
			}
		}
		
		//-------------------------------------------------------
		
		void Grenade_RadiusDamage()
		{
			// DAMAGE
			Debug_Log("DAMAGE");
			ParticleSystem_CreateAtEntity("PS_Explode","grenade_explosion.ps",msGrenade,true);
			//Effect_Flash_Start(.1f,0.2,.2f);
			FearHandler_SetForcedAddFearRate(1,10,false);
			Entity_ExplodeSurrounding(msGrenade,10,10);
			Seq_PlayerExplode("");
			Entity_SetActive(msGrenade,false);
			Sound_CreateAtEntity("Sound_GrenadeDamage", "02_03_arsenal/grenade/grenade_near", "player");
			//Music_Play("A2_2_3_Grenade_Detonated.ogg", 0.4f, false, eMusicPrio_BigEvent);
			Entity_SetActive("Trigger_CorpseMusic", false);
		}
		
		//-------------------------------------------------------
		
		void Grenade_RadiusSafe()
		{
			// SAFE
			ParticleSystem_CreateAtEntity("PS_Explode","grenade_explosion.ps",msGrenade,true);
			Entity_SetActive(msGrenade,false);
			FearHandler_SetForcedAddFearRate(1,10);
			Entity_ExplodeSurrounding(msGrenade,15,10);
			Debug_Log("SAFE");
			if (cLux_GetPlayer().GetCharacterBody().IsOnGround())
			{
				Player_ChangeStateToNormal();
				Player_SetCrouching(false,true,true);
				PlayerBody_PlayCutsceneAnimation("protects_herself_from_the_explosion",false,0.3f);
			}
			//PlayerBody_PlayCutsceneAtEntity("fall_and_get_up_slow","player",false,0.1f,"",1,0,cVector3f(0,-0.6f,0),0,true);
			Effect_ImageTrail_Start(1.5,0.8f,10,5);
			Sound_CreateAtEntity("Sound_GrenadeExplode", "02_03_arsenal/grenade/grenade_explode", msGrenade);
			Sound_CreateAtEntity("Sound_GrenadeExplodeDebris", "02_03_arsenal/grenade/grenade_debris", msGrenade);
			Music_Play("A2_2_3_Grenade_Detonated.ogg", 0.4f, false, eMusicPrio_BigEvent);
			Entity_SetActive("Trigger_CorpseMusic", false);
			
			Voice_PlayDelayed("Global_Tasi_Bark_Stage1_Hurt_Major",2.0);
		}
		
		//-------------------------------------------------------
		
		void Grenade_RadiusDud()
		{
			// DUD
			Debug_Log("DUD");
			Map_AddTimer("Timer_DudReaction",2.6f,"OnTimer_DudReaction");
			Sound_Stop("Sound_GrenadeFuse", 0.2f);
			Sound_CreateAtEntity("Sound_GrenadeDud", "02_03_arsenal/grenade/grenade_dud", "grenade_2");
			Entity_SetActive("Trigger_CorpseMusic", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DudReaction(const tString &in asTimer)
		{
			Voice_Play("Dialogue_Dud");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_OpenDoor(const tString &in asTimer)
		{
			if (SwingDoor_GetOpenAmount("door") < 0.1f)
				SwingDoor_PushOpen("door",.3f,3);
		}
		 
		//-------------------------------------------------------
	 
		//} END Event H *Player triggers the GRENADE trap*
		
		/////////////////////////////////////////
		// Event I *DEATH: Player is too close to the GRENADE when it explodes*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 2, Event I here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 2, Event I here.*/
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSequencePlayerExplode;
		void Seq_PlayerExplode(const tString &in asTimer)
		{
			Sequence_Begin("Seq_PlayerExplode", mSequencePlayerExplode);
			if (Sequence_DoStepAndWait(0.2f))
			{
				Effect_ImageTrail_Start(2,0,3,0);
				//PlayerBody_PlayCutsceneAtEntity("thrown_forward_by_ghoul","player",false,0.1f);
				/*cVector3f vDist = Entity_GetDeltaToEntity("player","").Normalize();
				cVector3f vForce = cVector3f(20000,20000,0)*vDist;
				Player_AddBodyForce(vForce,false);
				PlayerBody_PlayCutsceneAnimation("knocked_back_by_explosion",false,0.6f);*/
				
				Player_SetMoveSpeedMul(0);
				Voice_StopAll();
				
				Map_AddTimer("Timer_ResetPlayerSpeed",3,"OnTimer_ResetPlayerSpeed");			
				Player_AddContinuosBodyForceAwayFromEntity("door",1,2000,true,4);
				tString sAnim = (Entity_IsInPlayerFOV("door")) ? "knocked_back_by_explosion" : "knocked_forward_by_explosion";
				PlayerBody_PlayAnimation(sAnim,ePlayerBodyAnimationLayer_FullBody,false,false,true);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Player_GiveDamage(0.01,0.5,eDamageType_Default,"Explosion");
				Voice_Play("Dialogue_LedgeFall",2);
			}
			else if (Sequence_DoStepAndWait(4.5f))
			{
				Effect_Fade_Out(0.05f);
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				PlayerBody_StopAnimation("thrown_forward_by_ghoul",0);
				PlayerBody_StopAnimation("knocked_back_by_explosion",0);
				mlPermaFailStage = eArsenalPermaFail_Explosion;
				FearHandler_TriggerPermaFail();
				//Death_Start("Explosion",true);
			}
			else if (Sequence_DoStepAndWait(0))
			{
				Entity_SetActive("Rock_PostExplosion_*",true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_FallScream(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			Voice_Play("Dialogue_LedgeFall");
			return true;
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Falling(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (FearHandler_GetIsPermaFailing()) return true;
			
			if (asChild == "Player")
			{
				Voice_StopAll();
				Debug_Log("FALL");
				Effect_Fade_Out(0.1f);
				Map_AddTimer("Timer_FallImpact",1.f,"OnTimer_FallImpact");
			}
			else
			{
				Map_AddTimer("Timer_DeactivateFallingInstance",5.f,"OnTimer_DeactivateFallingInstance");	
				Map_SetTimerUserVarString("Timer_DeactivateFallingInstance",asChild);
			}			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FallImpact(const tString &in asTimer)
		{
			Debug_Log("TRIGGER PERMAFAIL");
			mlPermaFailStage = eArsenalPermaFail_BalconyFall;
			FearHandler_TriggerPermaFail_Fall();
			//Death_Start("Falling",true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivateFallingInstance(const tString &in asTimer)
		{
			tString sEnt = Map_GetTimerUserVarString(asTimer);
			if (!Entity_Exists(sEnt)) return;

			Debug_Log(sEnt+" deactivated after falling");
			Entity_SetActive(sEnt,false);
		}

		//-------------------------------------------------------
	 
		//} END Event I *DEATH: Player is too close to the GRENADE when it explodes*
		
