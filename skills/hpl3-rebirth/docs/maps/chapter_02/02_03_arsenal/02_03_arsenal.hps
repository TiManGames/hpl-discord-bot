		void OnInteract_Player_Sulfur(const tString &in asEntity)
		{
			if (Sketchbook_GetSketchActive("find_sulfur"))
			{
				Sketchbook_CompleteIdea("find_sulfur");
				Sketchbook_CompleteIdea("find_sulfurlocation");
			}
			Entity_SetActive("Interact_AddSulfur",true);
			Entity_SetActive("Trigger_Puke",true);
			
			Entity_SetActive("Trigger_LookAtMeds",false);
			Voice_StopAll();
			Voice_Play("Dialogue_FoundSulfur");
		}
		
		bool OnCollide_Player_ExitRelicRoom(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != -1) return true;
			if (ItemType_GetCountInInventory("Sulfur_Solid") == 0) return true;
			if (mbGrenadeActivated) return true;			
			
			Achievement_Unlock(eAchievement_EscapeArtist);
			return false;
		}
 
