		/////////////////////////////////////////
		// Event A *Player processes the CHARCOAL BRICK into CHARCOAL*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 4, Event A here.*/
		
		int mlGrindAmount = 8;
		bool mbPutCharcoal = false;
		bool mbGroundedCharcoal = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 4, Event A here.*/
		
		//-------------------------------------------------------
		
		void UpdateGrinder(float afTimeStep)
		{
			if (Item_GetHeldType() == "Charcoal_Solid" && PhysicsSlideDoor_GetOpenAmount("grinder_door") > 0.5f)
				Entity_SetActive("Interact_AddCharcoal",true);
			else
				Entity_SetActive("Interact_AddCharcoal",false);
		}
		
		//------------------------------------------------------- 
		
		bool CanUse_Charcoal(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{				
			return (asPickedEntity == "Interact_AddCharcoal" && PhysicsSlideDoor_GetOpenAmount("grinder_door") > 0.5f);
		}
		
		//-------------------------------------------------------
		
		bool OnUse_Charcoal(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			Sound_CreateAtEntity("Sound_UseCharcoal","02_03_arsenal/level_items/coal_grinder/coal_add",asTargetEntity);
			
			Item_Unequip(asItemID);
			Item_RemoveFromInventory(asItemID);
			Entity_SetActive("charcoal_pot",true);		
			Entity_SetInteractionDisabled("charcoal_pot",true);
			Entity_SetActive(asTargetEntity,false);
			Wheel_SetMoveMaxSpeed("grinder_wheel",1.8);
			mbPutCharcoal = true;
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Grinder_Grind(const tString &in asParent, const tString &in asChild, int alState)
		{
			
			if (PhysicsSlideDoor_GetOpenAmount("grinder_door") > 0.1f)
				{
					Sound_CreateAtEntity("Sound_UnlockDoor","03_04_pillar_room/config_device/config_ring_position_lock",asParent);
					PhysicsSlideDoor_AutoMoveToState("grinder_door",-1);
				}

			if (alState != -1) return true;
			if (mlGrindAmount < 0) return true;
			if (Entity_IsActive("charcoal_pot") == false) return true;
			
			if (mlGrindAmount > 0)
			{
				
				Sound_CreateAtEntity("Sound_Grind","02_03_arsenal/level_items/coal_grinder/coal_grind","grinder_door");
			}
			else
			{
				cColor pColCharcoal = cColor(0.109f, 0.113f, 0.086f); // #1c1d16
				ParticleSystem_CreateAtEntity("PS_Charcoal","dust_impact_simple_dark_oneshot.ps","charcoal_powder",false);
				ParticleSystem_SetColor("PS_Charcoal",pColCharcoal);
			
				Wheel_SetMoveMaxSpeed("grinder_wheel",5);
				Map_AddTimer("Timer_CharcoalToPowder",0.2f,"OnTimer_CharcoalToPowder");
				return false;
			}
			
			mlGrindAmount--;
			
			return true;
		}
		
		//------------------------------------------------------- 
		
		void OnInteract_StartGrinding(const tString &in asEntity)
		{
			if (mbPutCharcoal == false || mbGroundedCharcoal) return;
			
			Map_AddTimer("Timer_CheckGrinding", 0.1f, "OnTimer_CheckGrinding");
			//ParticleSystem_CreateAtEntity("PS_CharcoalGrinding","charcoal_ground.ps","PosArea_CharcoalParticles",false);
			//ParticleSystem_SetColor("charcoal_grinding",cColor(1,1,1,1));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckGrinding(const tString &in asTimer)
		{
			if (mbPutCharcoal == false || mbGroundedCharcoal) return;
			
			bool bInteractedWith = Entity_IsInteractedWith("grinder_wheel");
			float fAngVel = Map_GetEntity("grinder_wheel").GetBody(0).GetAngularVelocity().Length();
			
			if (bInteractedWith && fAngVel >= 0.5f && ParticleSystem_Exists("PS_CharcoalGrinding") == false)
				ParticleSystem_CreateAtEntity("PS_CharcoalGrinding","charcoal_ground.ps","PosArea_CharcoalParticles",false);
			else
				ParticleSystem_Destroy("PS_CharcoalGrinding");
			
			if (bInteractedWith)
				Map_RestartCurrentTimer(0.5f);
		}
		
		//------------------------------------------------------- 
		
		void OnInteractLeave_StopGrinding(const tString &in asEntity)
		{
			//if(ParticleSystem_Exists("PS_CharcoalGrinding"))
			//	ParticleSystem_Destroy("PS_CharcoalGrinding");
			//ParticleSystem_SetColor("charcoal_grinding",cColor(1,1,1,0));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CharcoalToPowder(const tString &in asTimer)
		{
			mbGroundedCharcoal = true;
			if(ParticleSystem_Exists("PS_CharcoalGrinding"))
				ParticleSystem_Destroy("PS_CharcoalGrinding");
			Prop_SetActiveAndFade("charcoal_pot",false,2);
			Prop_SetActiveAndFade("charcoal_powder",true,2);
			//ParticleSystem_SetColor("charcoal_grinding",cColor(1,1,1,0));
			Sound_CreateAtEntity("Sound_GrindComplete","02_03_arsenal/level_items/coal_grinder/coal_grind_end","grinder_door");
			Sound_CreateAtEntity("Sound_GrindPowder","02_03_arsenal/temp/coal_powder","charcoal_powder");
			Voice_PlayDelayed("Dialogue_GroundCharcoal",1);
		}
 
		//-------------------------------------------------------
	 
		//} END Event A *Player processes the CHARCOAL BRICK into CHARCOAL*
		
		/////////////////////////////////////////
		// Event B *Player boils the SULFUR SOLUTION and obtains SULFUR*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 4, Event B here.*/
		
		float mfBoilingTime = 22;
		float mfBoilingVolume = 1;
		float mfBoilingMoveSpeed = 0.002f;
		bool mbHasBoiled = false;
		int mlLidState = 0;
		bool mbLidOn = false;
		bool mbLidOff = true;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 4, Event B here.*/
		
		bool CanUse_Sulfur(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{
			return (asPickedEntity == "Interact_AddSulfur");
		}
		
		//-------------------------------------------------------
		
		bool OnUse_Sulfur(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			Item_Unequip(asItemID);
			Item_RemoveFromInventory(asItemID);
			Entity_SetActive("Interact_AddSulfur",false);
			Prop_SetActiveAndFade("sulfur_liquid",true,0.5f);
			Prop_MoveLinearTo("sulfur_liquid","AreaPos_SulfurStart",0.1f,0.3f,0,false);
			
			if (Lamp_GetLit("pot_fire"))
			{
				Map_AddTimer("Timer_StartBoiling",4,"OnTimer_StartBoiling");
				Sound_CreateAtEntity("Sound_Boiling","02_03_arsenal/temp/sulphur_boil","AreaPos_BoilingSound",6,true,mfBoilingVolume);
			}
			
			cScript_SetGlobalVarBool("Outpost_Arsenal_SulfurInPot",true);
			
			Sound_CreateAtEntity("Sound_AddSulphurLiquid", "02_03_arsenal/level_items/boiler/liquid_pour", "sulfur_liquid_boiling");
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartBoiling(const tString &in asTimer)
		{
			Prop_SetActiveAndFade("sulfur_liquid_boiling",true,30.f);
			Prop_MoveLinearTo("sulfur_liquid","AreaPos_SulfurBoiled",0.001f,mfBoilingMoveSpeed,0,false);
			Prop_MoveLinearTo("sulfur_liquid_boiling","AreaPos_SulfurBoiled",0.001f,mfBoilingMoveSpeed,0,false);
			Map_AddTimer("Timer_SulfurToPowder",mfBoilingTime,"OnTimer_SulfurToPowder");
		}
		
		//-------------------------------------------------------
		
		bool mbPotTorchUsed = false;
		
		bool OnCollide_Player_RespawnMatch(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != -1) return true;
			
			if (ItemType_GetCountInInventory("Matchbook") == 0 && mbPotTorchUsed == false && Entity_Exists("matchbook_4") == false)
			{
				// Add matchbook
				cMatrixf mtxMatchbook = cLux_GetCurrentMap().GetEntityByName("PosArea_Matchbook").GetMatrix();
				cLux_GetCurrentMap().CreateEntity("Matchbook_Respawned","matchbook.ent",mtxMatchbook,1);
				Debug_Log("ADDED EXTRA MATCH");
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_SulfurToPowderTorch(const tString &in asEntity)
		{
			if (Item_GetHeldType(eItemHandlerHand(Match_GetHand())) != "Match") return;
			
			mbPotTorchUsed = true;
			
			if (mbHasBoiled) return;
						
			if (cScript_GetGlobalVarBool("Outpost_Arsenal_SulfurInPot") == false) return;
			
			//Item_KillHeldItem(eItemHandlerHand_Left);
			ItemType_RemoveFromInventory("Sulfur_Solid");
			Entity_SetActive("Interact_AddSulfur",false);
			Entity_SetActive("Sticky_Lid*",true);
			Map_AddTimer("Timer_StartBoiling",4,"OnTimer_StartBoiling");
			Sound_CreateAtEntity("Sound_Boiling","02_03_arsenal/temp/sulphur_boil","AreaPos_BoilingSound",6,true,mfBoilingVolume);
		}
		
		//-------------------------------------------------------
		
		bool OnAttach_Lid(const tString &in asStickyArea, const tString &in asBodyName)
		{
			
			if (Map_TimerExists("Timer_SulfurToPowder"))
			{
				mfBoilingTime = Map_GetTimerTime("Timer_SulfurToPowder");
				Map_RemoveTimer("Timer_SulfurToPowder");
				Map_AddTimer("Timer_SulfurToPowder",mfBoilingTime/1.5f,"OnTimer_SulfurToPowder");
				Prop_MoveLinearTo("sulfur_liquid_boiling","AreaPos_SulfurBoiled",0.001f,mfBoilingMoveSpeed,0,false);
				Debug_Log("Boiling Time Left: "+Map_GetTimerTime("Timer_SulfurToPowder"));
				mfBoilingVolume = 0.4f;
				Sound_Fade("Sound_Boiling",mfBoilingVolume,1);
			}
			else
			{
				mfBoilingTime /= 1.5f;
				mfBoilingVolume = 0.4f;
				Debug_Log("LID ON! Boiling Time: "+mfBoilingTime);
				StickyArea_SetInteractionRequired("Sticky_Lid",true);
			}
			
			Sound_CreateAtEntity("Sound_LidOn", "02_03_arsenal/level_items/boiler/lid_on", "stove_lid");
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnDetach_Lid(const tString &in asStickyArea, const tString &in asBodyName)
		{
			if (Map_TimerExists("Timer_SulfurToPowder"))
			{
				mfBoilingTime = Map_GetTimerTime("Timer_SulfurToPowder");
				Map_RemoveTimer("Timer_SulfurToPowder");
				Map_AddTimer("Timer_SulfurToPowder",mfBoilingTime*1.5f,"OnTimer_SulfurToPowder");
				Prop_MoveLinearTo("sulfur_liquid_boiling","AreaPos_SulfurBoiled",0.001f,mfBoilingMoveSpeed,0,false);
				Debug_Log("Boiling Time Left: "+Map_GetTimerTime("Timer_SulfurToPowder"));
				mfBoilingVolume = 1;
				Sound_Fade("Sound_Boiling",mfBoilingVolume,1);
			}
			else
			{
				StickyArea_SetInteractionRequired("Sticky_Lid",true);
				mfBoilingTime *= 1.5f;
				mfBoilingVolume = 1;
				Debug_Log("REMOVE LID! Boiling Time: "+mfBoilingTime+" INTERACTION NOW REQUIRED TO ATTACH");
			}
			
			Sound_CreateAtEntity("Sound_LidOff", "02_03_arsenal/level_items/boiler/lid_off", "stove_lid");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SulfurToPowder(const tString &in asTimer)
		{
			Entity_SetActive("InteractAux_PickupSulfurPowder",true);
			Prop_SetActiveAndFade("sulfur_liquid",false,2);
			Prop_SetActiveAndFade("sulfur_liquid_boiling",false,4);
			Prop_SetActiveAndFade("sulfur_powder",true,2);
			Light_FadeBrightnessTo("Light_Sulfur_Point",0.3f,2,eEasing_SineInOut);
			Map_AddTimer("Timer_PutBoilerOff",3,"OnTimer_PutBoilerOff");
			Sound_Stop("Sound_Boiling",3);
			mbHasBoiled = true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PutBoilerOff(const tString &in asTimer)
		{
			Lamp_SetLit("pot_fire",false,true);
		}
		
		//------------------------------------------------------- 
		
		bool OnCollide_Player_ForceBoil(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			if (Map_TimerExists("Timer_SulfurToPowder"))
			{
				Map_RemoveTimer("Timer_SulfurToPowder");
				Entity_SetActive("InteractAux_PickupSulfurPowder",true);
				Entity_SetActive("sulfur_liquid",false);
				Entity_SetActive("sulfur_liquid_boiling",false);
				Entity_SetActive("sulfur_powder",true);
				Light_FadeBrightnessTo("Light_Sulfur_Point",0.3f,0,eEasing_Linear);
				Map_AddTimer("Timer_PutBoilerOff",0,"OnTimer_PutBoilerOff");
				Sound_Stop("Sound_Boiling",3);
				mbHasBoiled = true;
				return false;
			}
			
			return true;
		}
 
		//-------------------------------------------------------
	 
		//} END Event B *Player boils the SULFUR SOLUTION and obtains SULFUR*
		
		/////////////////////////////////////////
		// Event C *Player uses the SHELL PRESS to craft the TANK SHELL*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 4, Event C here.*/
		
		int mlPressStage = 1;
		bool mbPressHasBullet = true;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 4, Event C here.*/	
		
		void OnInteract_BulletPress(const tString &in asEntity)
		{
			Sketchbook_AddIdea("make_bullet");
		}
		
		bool CanUse_SingleIngredients(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{
			return (asPickedEntity == "Interact_Bullet" && Lever_GetPulledAmount("reloading_press_base_1") < 0.5f);
		}
		
		//-------------------------------------------------------
		
		bool OnUse_SingleIngredients(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			/*if (Map_TimeHasPassed("Timer_WaitForMixBark",8))
				Voice_Play("Dialogue_NeedGunpowderMix");
			return true;*/
			Debug_Log(asItemType+" "+asItemID+" "+asItemEntity);
			Item_RemoveFromInventory(asItemID);		
			//ParticleSystem_SetActive("PS_Gunpowder",true);
			
			cColor pColSaltpeter = cColor(0.949f, 0.956f, 0.862f); // #f2f4dc
			cColor pColSulfur = cColor(0.768f, 0.811f, 0.262f); // #c4cf43
			cColor pColCharcoal = cColor(0.949f, 0.956f, 0.862f); // #1c1d16
			//cColor pColCharcoal = cColor(0.274f, 0.282f, 0.203f); // #464835
			
			cColor pCol;
			
			if (asItemType == "Charcoal_Powder") pCol = pColCharcoal;
			else if (asItemType == "Sulfur_Powder") pCol = pColSulfur;
			else if (asItemType == "Saltpeter_Powder") pCol = pColSaltpeter;
			else if (asItemType == "CharcoalSulfur_Powder") pCol = (pColCharcoal+pColSulfur)/2;
			else if (asItemType == "SaltpeterSulfur_Powder") pCol = (pColSaltpeter+pColSulfur)/2;
			else if (asItemType == "CharcoalSaltpeter_Powder") pCol = (pColCharcoal*pColSaltpeter)/2;
			
			ParticleSystem_CreateAtEntity("PS_Sulfur"+asItemType,"dust_impact_simple_dark_oneshot.ps","PosArea_IngredientsParticles",false);
			ParticleSystem_SetColor("PS_Sulfur"+asItemType,pCol);
			
			if (asItemType == "Charcoal_Powder" || asItemType == "Sulfur_Powder" || asItemType == "Saltpeter_Powder")
			{
				Bullet_AddIngredient(asItemType);
				Sound_CreateAtEntity("Sound_BulletAddCoal", "level_entity_shared/levers/bullet_press/add_coal", "Interact_Bullet");
			}
			else if (asItemType == "CharcoalSulfur_Powder")
			{
				Bullet_AddIngredient("Charcoal_Powder");
				Bullet_AddIngredient("Sulfur_Powder");
				Sound_CreateAtEntity("Sound_BulletAddPowder", "level_entity_shared/levers/bullet_press/add_powder", "Interact_Bullet");
			}
			else if (asItemType == "SaltpeterSulfur_Powder")
			{
				Bullet_AddIngredient("Saltpeter_Powder");
				Bullet_AddIngredient("Sulfur_Powder");
				Sound_CreateAtEntity("Sound_BulletAddPowder", "level_entity_shared/levers/bullet_press/add_powder", "Interact_Bullet");
			}
			else if (asItemType == "CharcoalSaltpeter_Powder")
			{
				Bullet_AddIngredient("Charcoal_Powder");
				Bullet_AddIngredient("Saltpeter_Powder");
				Sound_CreateAtEntity("Sound_BulletAddPowder", "level_entity_shared/levers/bullet_press/add_powder", "Interact_Bullet");
			}
			
			if (Entity_GetVarBool("Interact_Bullet","HasCharcoal") && Entity_GetVarBool("Interact_Bullet","HasSulfur") && Entity_GetVarBool("Interact_Bullet","HasSaltpeter"))
				cScript_SetGlobalVarBool("Outpost_Arsenal_GunpowderInShell",true);
				
			return true;
		}
		
		void Bullet_AddIngredient(const tString asIngredient)
		{
			if 			(asIngredient == "Charcoal_Powder")		Entity_SetVarBool("Interact_Bullet","HasCharcoal",true);
			else if 	(asIngredient == "Sulfur_Powder")		Entity_SetVarBool("Interact_Bullet","HasSulfur",true);
			else if 	(asIngredient == "Saltpeter_Powder")	Entity_SetVarBool("Interact_Bullet","HasSaltpeter",true);
			
			mlPressStage++;
			mbPressTried = true;
			
			if (Map_TimerExists("Timer_WaitForIngredientsBark"))
				Map_RemoveTimer("Timer_WaitForIngredientsBark");
		}
		
		//-------------------------------------------------------
		
		bool CanUse_GunpowderMix(const tString &in asItemType, const tString &in asItemID, const tString &in asPickedEntity)
		{
			return (asPickedEntity == "Interact_Bullet" && Lever_GetPulledAmount("reloading_press_base_1") < 0.5f);
		}
		
		//-------------------------------------------------------
		
		bool OnUse_GunpowderMix(const tString &in asItemType, const tString &in asItemID, const tString &in asTargetEntity, const tString &in asItemEntity, float afTimeElapsed, float afTimeStep)
		{
			if (asTargetEntity == "Interact_Bullet")
			{
				Item_RemoveFromInventory(ItemType_GetFirstInInventory("GunpowderMix"));
				ItemType_RemoveFromInventory(asItemEntity);				
				//ParticleSystem_SetActive("PS_Gunpowder",true);
				Sound_CreateAtEntity("Sound_BulletAddPowder", "level_entity_shared/levers/bullet_press/add_powder", "Interact_Bullet");
				cColor pCol = cColor(0.949f, 0.956f, 0.862f);
				ParticleSystem_CreateAtEntity("PS_GunpowderFinal","dust_impact_simple_dark_oneshot.ps","PosArea_IngredientsParticles",false);
				ParticleSystem_SetColor("PS_GunpowderFinal",pCol);
				cScript_SetGlobalVarBool("Outpost_Arsenal_GunpowderInShell",true);
				mlPressStage = 4;
				return true;
			}
			return false;
		}
		
		//-------------------------------------------------------
		
		bool mbPressTried = false;
		
		bool OnCollide_Shell_Press(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			if (cScript_GetGlobalVarBool("Outpost_Arsenal_GunpowderInShell") == false)
			{
				if (mlPressStage != 4) 
				{
					if (Entity_IsActive("bullet_empty") && Entity_IsInteractedWith("reloading_press_base_1"))		
					{
						if (Map_TimeHasPassed("Timer_WaitForIngredientsBark",16))
						{
							tString sVoice = "";
							
							switch(mlPressStage)
							{
								case 2:
									sVoice = "Dialogue_MixWrong_OnlyOneIngredient"; break;
								case 3:
									if (Entity_GetVarBool("Interact_Bullet","HasSulfur") == false)
										sVoice = "Dialogue_MixWrong_MissingSulfur";
									else if (Entity_GetVarBool("Interact_Bullet","HasSaltpeter") == false)
										sVoice = "Dialogue_MixWrong_MissingSalpeter";
									else if (Entity_GetVarBool("Interact_Bullet","HasCharcoal") == false)
										sVoice = "Dialogue_MixWrong_MissingCharcoal";
									break;
								default:
									sVoice = "Dialogue_NeedIngredients";
							}
							
							if (mbPressTried == false)
							{
								mbPressTried = true;
								// Cut out out because this line now feels redundant - IT
								//bool bUsedTankGun = cScript_GetGlobalVarBool("Outpost_HasUsedTankGun");
								//sVoice = (bUsedTankGun) ? "Dialogue_SeesPressTriedGun" : "Dialogue_SeesPress";
								sVoice = "";
							}
							
							if (sVoice!="")
								Voice_Play(sVoice);
						}
						return true;
					}
					else return true;
				}
			
			}
			
			Entity_SetActive("Interact_Bullet", false);
			Entity_SetActive("tank_shell_casing_1",false);
			Entity_SetActive("bullet_empty",false);
			Entity_SetActive("tank_bullet_2",true);
			Entity_SetActive("Interact_BulletReady", true);
			Sound_CreateAtEntity("Sound_BulletCreate", "02_03_arsenal/level_items/bullet_press/shell_create", "Interact_Bullet");
			Music_Play("A2_2_3_Puzzle_Solved.ogg", 0.12f, false, eMusicPrio_MinorEvent);
			mlPressStage++;
			
			return false;
		}
		
		void OnInteract_PickupShell(const tString &in asEntity)
		{
			Sound_CreateAtEntity("Sound_BulletCreate", "player/UI/menu/add_inventory", "Interact_Bullet");
			Entity_SetActive("tank_shell_casing_1",false);
			Entity_SetActive("tank_bullet_2",false);
			Entity_SetActive(asEntity,false);
			//Item_AddToInventory("Bullet");
			LoadScreen_ProgressStory();
			Voice_PlayDelayed("Dialogue_ShellCompleted",0.6f);
			Entity_SetActive("Trigger_NotTheBestIdea",true);
			Sketchbook_CompleteIdea("make_bullet");
			//Music_Play("A2_2_3_Puzzle_Solved.ogg", 0.25f, false, eMusicPrio_MinorEvent);
		}
		
		bool OnCollide_Player_NotTheBestIdea(const tString &in asParent, const tString &in asChild, int alState)
		{
			//if (ItemType_IsInInventory("Bullet") == false) return true;
			
			Voice_Play("Dialogue_OutOnTheLedge");
			return true;
		}
 
		//-------------------------------------------------------
	 
		//} END Event C *Player uses the SHELL PRESS to craft the TANK SHELL*
	
	//} END SCENE 4

}