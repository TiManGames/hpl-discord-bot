	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if(abPressed==false) return;
		
		if(alAction == eAction_Test1)
		{
			Item_AddToInventory("Saltpeter_Powder");
			cScript_SetGlobalVarBool("Outpost_HasUsedTankGun", true);
		}
		else if(alAction == eAction_Test2)
		{
			Item_AddToInventory("Charcoal_Solid");
			Entity_SetActive("Interact_AddCharcoal",true);
		}
		else if(alAction == eAction_Test3)
		{
			Item_AddToInventory("Sulfur_Solid");
			Entity_SetActive("Interact_AddSulfur", true);
		}
		else if(alAction == eAction_Test4)
		{
			Item_AddToInventory("Charcoal_Powder");
		}
		else if(alAction == eAction_Test5)
		{
			Item_AddToInventory("Sulfur_Powder");
		}
		else if(alAction == eAction_Test6)
		{
			Item_AddToInventory("Bullet_Empty");
		}
		else if (alAction == eAction_Test7)
		{
			cLux_AddDebugMessage("SULFUR: "+ItemType_GetCountInInventory("Sulfur_Solid")); return;
			Prop_SetHealth("relicroom_wall_breakable",0);
			OnBreak_WallExit("relicroom_wall_breakable");
		}
		else if (alAction == eAction_Test8)
		{
			cColor pColSaltpeter = cColor(0.949f, 0.956f, 0.862f); // #f2f4dc
			cColor pColSulfur = cColor(0.768f, 0.811f, 0.262f); // #c4cf43
			cColor pColCharcoal = cColor(0.274f, 0.282f, 0.203f); // #464835
			
			ParticleSystem_CreateAtEntity("PS_Sulfur","dust_impact_simple_dark_oneshot.ps","Interact_BulletReady",false);
			ParticleSystem_SetColor("PS_Sulfur",pColSulfur);
			//ParticleSystem_SetActive("PS_Saltpeter",true);
		}
		else if (alAction == eAction_Test9)
		{
			//cLux_AddDebugMessage(Item_GetHeldType(eItemHandlerHand_Left));
			Entity_SetActive("bottle_laudanum_2",false);
			Entity_SetActive("Captain_Oil_3",false);
			
			//Grenade_Torn();
		}
		else if (alAction == eAction_Test0)
		{
			FearHandler_SetForcedAddFearRate(1,10,false); return;
			//Entity_AddImpulse("player",cVector3f(100,100,0),true,false);
			//Entity_AddForce("player",cVector3f(100,100,0),true,false);
			Player_SetMoveSpeedMul(0);
			//cVector3f vPlayerVel = Player_GetVelocity();
			//Player_AddBodyForce(vPlayerVel,false);
			//Effect_ImageTrail_Start(3,0,3,0);
			Map_AddTimer("Timer_ResetPlayerSpeed",3,"OnTimer_ResetPlayerSpeed");
			//cVector3f vDist = Entity_GetDeltaToEntity("player","door").Normalize();
			//cVector3f vForce = cVector3f(60000,0,0)/vDist;
			
			Player_AddContinuosBodyForceAwayFromEntity("door",1,3000,true,4);
			
			//Player_AddBodyForceAwayFromEntity("door",vForce.Length(),false);
			tString sAnim = (Entity_IsInPlayerFOV("door")) ? "knocked_back_by_explosion" : "knocked_forward_by_explosion";
			PlayerBody_PlayAnimation(sAnim,ePlayerBodyAnimationLayer_FullBody,false,false,true);
			//PlayerBody_PlayCutsceneAnimation("knocked_back_by_explosion",false,0.6f);
			//Player_AddContinuosBodyForce(vForce,10);
			//
			//PlayerBody_PlayCutsceneAnimation("knocked_back_by_explosion",false,0.6f);
			//PlayerBody_PlayCutsceneAtEntity("protects_herself_from_the_explosion_larm","player",false,4);
			//PlayerBody_PlayAnimation("protects_herself_from_the_explosion_rarm",ePlayerBodyAnimationLayer_FullBody,false,true,true);
		}
		else if (alAction == eAction_TestPlus)
		{
			Sketchbook_AddAllIdeas(false);
		}
		else if (alAction == eAction_TestMinus)
		{
			Entity_SetActive("candle_storage_right*", false);
						Entity_SetActive("blown_candle_right*",true);
			//Rope_Detach(msRelicRope,"hook");
			//Rope_Detach(msRelicRope,msGrenade);
			//Rope_SetTotalLength(msRelicRope,0);
			//Rope_SetActive(msRelicRope,false,false);
		}
	}

