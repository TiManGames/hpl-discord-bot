		//-------------------------------------------------------
		
		void OnInteract_ExtendTimer(const tString &in asEntity)
		{
			if (Map_TimerExists("Timer_Explosion"))
			{
				Map_RemoveTimer("Timer_Explosion");
				Map_AddTimer("Timer_ExplosionExtend",3.f,"OnTimer_Explosion");
			}
