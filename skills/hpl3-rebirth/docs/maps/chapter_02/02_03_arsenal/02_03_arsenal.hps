	////////////////////////////
	// Set up map environment
	void Setup()
	{
	    // Set up entities
		Entity_PlayAnimation("ballista_trap","ballista_trap_loaded", 0.0, true);
	
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("02-03-arsenal");
		
		// Set up color grading etc.
		Effect_Bloom_FadeBrightPass(0.1f, 2);
		Effect_Bloom_FadeBloomWidth(128, 0.6);
		Effect_Bloom_FadeBloomFalloff(1.5f, 2);
		Effect_Bloom_FadeBloomTint(1, 1, 1, 2);
		
		Pregnancy_SetStage(ePregStage_Stage1);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_CavesToCisternStart);
		Pregnancy_SetBabyKicksEnabled(false);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_Ill);
		Player_SetAllowCheckBaby(true);
		Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_Initial");
		
		if (cScript_GetGlobalVarBool("Outpost_AnsweredRadio"))
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_RadioToBabyKick);
		}
		else
		{
			FearHandler_SetWhisperStage(eFearWhisperStage_SalimToRadio);
		}
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(0);
		StruggleFlashHandler_SetProgression(0);
		
		Player_SetAutoTeleportWhenBelowAltitude(-25.f);
		
	    //mask level light
		cWorld@ pWorld = mBaseObj.GetWorld();
		cLightMaskBox@ pMask = pWorld.GetLightMask("lightmask_inside");		
		pWorld.GetDirectionalLight().SetMask(pMask);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		ParticleSystem_Preload("grenade_explosion.ps");
		ParticleSystem_Preload("wooden_brace_damage.ps");
		ParticleSystem_Preload("wood_collapse.ps");
		
		//////////////
		// Preload screen effects
		Material_Preload("player_damage_screen.mat");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//FearHandler_SetActive(false);
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(4);
		
		// Any general setup of script / entities
		
		Player_SetAmbientLight(0,0,0);
//		Player_SetNightVisionStrength(0.30f);
		Player_SetMapDeepShadow(0.10f);

		Decal_SetDynamicVisible("Decal_Arrow_*",false);
		//ParticleSystem_SetActive("PS_Gunpowder",false);
		//ParticleSystem_SetActive("PS_Charcoal",false);
		//ParticleSystem_SetActive("PS_Saltpeter",false);
		
		Entity_AddForce("brandon_corpse_1",cVector3f(0,0,0.1f),true,true);
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
			if (ItemType_GetCountInInventory("Lantern") < 1)
			{
				Item_AddToInventory("Lantern");
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 8);
			}
			
			Entity_SetActive("WorkshopDoor_Blockage_*",false);
			Item_AddToInventory("ModernOilFixed");
			Item_AddToInventory("Matchbook");
			Item_AddToInventory("RelicRoomKey");
			Item_AddToInventory("AlysDoll");
			Item_AddToInventory("PocketFairchild");
			
			//Lamp_SetLit("arab_lamp_oil_hanging_01_1",true,true);
			
			SwingDoor_SetClosed("Win3_Shutter",true,false);
		}
		
		
		mlPermaFailStage = eArsenalPermaFail_Workshops;
		
		
		Entity_SetVarBool("Interact_Bullet","HasCharcoal",false);
		Entity_SetVarBool("Interact_Bullet","HasSulfur",false);
		Entity_SetVarBool("Interact_Bullet","HasSaltpeter",false);
		
		Map_AddTimer("Timer_GrinderOpenDelay",.4f,"OnTimer_GrinderOpenDelay");
		
		Decal_SetDynamicVisible("Corpse_Impaled_*",false);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		
		Game_AutoSave();
		
		Player_SetNightVisionEnabled(false);
		// Updated 200403
		Player_SetNightVisionBrightness(1.3f);
		//Player_SetNightVisionRadius(5.5f);
		
		Music_PlayExt("A2_2_3_Arsenal_Ambience.ogg", true, 0.1f, 1.0f, 2.0f, 1.0f, eMusicPrio_BgAmb, true);

		cLux_GetCurrentMap().GetEntityByName("corridor_stick_1").GetMainBody().SetCollide(false);
		cLux_GetCurrentMap().GetEntityByName("corridor_stick_2").GetMainBody().SetCollide(false);
		
		if (cScript_GetGlobalVarBool("Outpost_Arsenal_CorridorTrapTriggered") == false)
			Corridor_CreateRope();
		else
		{
			Entity_SetActive("Trigger_Wire",false);
		}
		
		if (cScript_GetGlobalVarBool("Outpost_Arsenal_GrenadeTriggered") == false)	
			RelicRoom_CreateRope();
		else	
			Entity_SetInteractionDisabled("InteractAux_Hand",true);
		
		PlayerBody_SetActive(true);
		FearHandler_SetPermaFailEnabled(true);
		FearHandler_SetUpdateInterval(0.4f);
        Heat_SetActive(false);
		
		if (cScript_GetGlobalVarBool("Outpost_Arsenal_CaptainExploded") == false)	
		{
			Decal_SetDynamicVisible("decal_destroyed_*",false);
			Decal_SetDynamicVisible("decal_keyguy*",false);
			Decal_SetDynamicVisible("decal_keyguyinout_*",false);
		}
		else
		{
			Decal_SetDynamicVisible("decal_cpt_vomit_*",false);
		}
		if (cScript_GetGlobalVarBool("Outpost_Arsenal_KeyGuyExploded") == false)	
		{
			Decal_SetDynamicVisible("decal_keyguy*",false);
			Decal_SetDynamicVisible("decal_keyguyinout_*",false);
		}
		
		
		Entity_AddImpulse("stove_lid",cVector3f(.01f,0,0),true,true);
		
		//ParticleSystem_SetColor("charcoal_grinding",cColor(1,1,1,0));
		
		if (Entity_IsActive("sulfur_powder")) Entity_SetActive("InteractAux_PickupSulfurPowder",true);
	}
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		//cVector3f vImpulse = cVector3f(-1,1,-0.7);
		//apFunctions.GetLowLevelGfx().DrawLine(Map_GetEntity("grenade_1").GetPosition(),Map_GetEntity("grenade_1").GetPosition() + vImpulse*1,cColor(5,5,20));
