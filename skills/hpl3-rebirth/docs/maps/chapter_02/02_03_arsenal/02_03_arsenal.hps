		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 2, Event f here.*/
		
		bool mbPlankCollapse1 = false;
		bool mbPlankCollapse2 = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functionsthat are only used in Scene 2, Event F here.*/
	
		//-------------------------------------------------------
		
		bool OnCollide_Player_CanInteractWindow(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == -1 && SwingDoor_GetOpenAmount("Win3_Shutter") > 0.5f)
				Entity_SetInteractionDisabled("Win3_Shutter",true);
				
			if (alState == 1)
				Entity_SetInteractionDisabled("Win3_Shutter",false);

			return true;
		}
		
		bool OnCollide_UnlockWindow(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != -1) return true;
			SwingDoor_SetBlocked("Win2_Shutter",false,true);
			return false;
		}
		
		bool OnCollide_Player_PlankCreak(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			
			Sound_CreateAtEntity("Sound_PlankCreak","02_04_living_quarters/floor_plank/floor_plank_creak",asChild);
			Sound_AddClosedCaption("01_02_caves","CC_WoodCreak",0.8f);
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_PlanksFall(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbPlankCollapse1) return false;
			
			Entity_SetInteractionDisabled("ab_debris_brick01_*",false);
			FearHandler_SetForcedAddFearRate(.5f,5.f,false,2);
			PlankFall(1);
			return false;
		}
		
		bool OnCollide_Player_PlankPressure(const tString &in asParent, const tString &in asChild, int alState)
		{
			bool bSound = (Entity_GetVarInt(asParent, "") == 1) ? true : false;
			if (alState == 1)
			{
				
				if (bSound)
				{
					cLux_AddDebugMessage("COLLIDE: "+asParent);
					Sound_CreateAtEntity("Sound_PlankCreak","02_04_living_quarters/floor_plank/floor_plank_creak",asChild);
					Sound_AddClosedCaption("01_02_caves","CC_WoodCreak",0.8f);
				}
				Prop_AlignRotation(asParent,asParent+"_end",10,5,0,true);
			}
			else
			{

				Prop_AlignRotation(asParent,asParent+"_start",10,5,0,true);
			}
			return true;
		}
		
		//-------------------------------------------------------
		
				
		bool OnCollide_PlankFall2(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbPlankCollapse2) return false;
			if (!mbPlankCollapse1) return false;
			
			FearHandler_SetForcedAddFearRate(.8f,5.f,false,2);
			PlankFall(2);
			Voice_Play("Dialogue_LandLedge");
			Entity_SetActive("Trigger_JumpBoost",false);
			return false;
		}
		
		bool OnCollide_PlayerBoost(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (SwingDoor_GetOpenAmount("") > .2f) return true;
			mbCheckBoost = (alState == 1) ? true : false;
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void PlankFall(int alStage)
		{
			if (alStage == 1)
			{
				//ParticleSystem_CreateAtEntity("Pfx_Dust","wood_collapse.ps","plank_fall_5",false);
				//Sound_CreateAtEntity("Sound_PlankBreak","02_04_living_quarters/floor_plank/floor_plank_splinter","plank_fall_5");
				//Prop_SetStaticPhysics("plank_fall_5",false);
				//Entity_AddImpulse("plank_fall_5",cVector3f_One,false,false);
				mbPlankCollapse1 = true;
			}
			else
			{
				ParticleSystem_CreateAtEntity("Pfx_Dust","wood_collapse.ps","plank_fall2_21",false);
				Sound_CreateAtEntity("Sound_PlankBreak","02_04_living_quarters/floor_plank/floor_plank_splinter","plank_fall2_21");
				Prop_SetStaticPhysics("plank_fall2_*",false);
				Entity_AddImpulse("plank_fall2_*",cVector3f(0.1f,0.1f,0.1f),false,false);
				mbPlankCollapse2 = true;
			}
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_BlockWindow(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
				SwingDoor_SetBlocked("window_2_shutter_1",true,false);
			else
				SwingDoor_SetBlocked("window_2_shutter_1",false,false);	
				
			return true;
		}
	 
