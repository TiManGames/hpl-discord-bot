		/////////////////////////////////////////
		// Event E *Player enters the RELIC ROOM from the RELIC ROOM DOOR*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 2, Event E here.*/
		
		tString msRelicRope = "RelicRope";
		bool mbAttachRopeToHook = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functionsthat are only used in Scene 2, Event E here.*/
		
		void RelicRoom_CreateRope()
		{
			cVector3f vStart = Map_GetEntity("grenade_1").GetPosition()+cVector3f(0,0.05,0);
			iPhysicsBody@ pBody = cLux_GetCurrentMap().GetEntityByName("hook").GetBody(0);
			iPhysicsJoint@ pJoint = pBody.GetJoint(0);

			cVector3f vEnd = pBody.GetWorldPosition();
			if(pJoint !is null) vEnd = pJoint.GetPivotPoint();
			
			Rope_Create(msRelicRope,vStart,vEnd,0.1f,0.1f,100,0.5f,false,false);
			Rope_SetTotalLength(msRelicRope,1.1f);
			Rope_AttachStart(msRelicRope,"grenade_1");
			Rope_AttachEnd(msRelicRope,"hook");
			Rope_SetEndParticleMass(msRelicRope,0);
			OnTimer_RopeMaterial(msRelicRope);//Map_AddTimer(msRelicRope,0.2f,"OnTimer_RopeMaterial");
			//Rope_SetCollideGroup(msRelicRope,"+hook");
		}

		//-------------------------------------------------------
	
		void OnTimer_RopeMaterial(const tString &in asTimer)
		{
			Rope_CreateGfx(asTimer,"entities/arabic_fort/ab_interior_tileable_rope_01.mat",0.005f);
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Door_Open(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbDisarmedTrap) return false;
			
			//cLux_GetCurrentMap().GetEntityByName("hook").GetMainBody().GetJoint(0).Break();
			cLux_GetCurrentMap().GetEntityByName("hook").GetMainBody().SetMass(0);
			Rope_Detach(msRelicRope,"grenade_1");
			Rope_SetStartParticleMass(msRelicRope,1);
			Rope_SetEndParticleMass(msRelicRope,1);
			Rope_SetCollide(msRelicRope,true,false);
			mbAttachRopeToHook = true;
			
			Grenade_Activate();
			return false;
		}
 
