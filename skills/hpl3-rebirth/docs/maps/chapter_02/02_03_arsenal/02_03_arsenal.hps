	bool OnCollide_ToggleNightVision(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState==1) Player_SetNightVisionEnabled(true);
		else if (alState==-1) Player_SetNightVisionEnabled(false);
		return true;
	}
	
	//-------------------------------------------------------
	
	void UpdateWindows()
	{
		if (Entity_IsSleeping("Win1_Shutter_Left") == false || Entity_IsSleeping("Win1_Shutter_Right") == false)
			Light_SetBrightness("light_win1_*", 1.0f*(SwingDoor_GetOpenAmount("Win1_Shutter_Left")+SwingDoor_GetOpenAmount("Win1_Shutter_Right"))/2);
			
		if (Entity_IsSleeping("Win2_Shutter") == false)
			Light_SetBrightness("light_win2_*", 1.0f*(SwingDoor_GetOpenAmount("Win2_Shutter")));
			
		if (Entity_IsSleeping("Win3_Shutter") == false)
			Light_SetBrightness("light_win3_*", 1.0f*(SwingDoor_GetOpenAmount("Win3_Shutter")));
			
		if (Entity_IsSleeping("Win4_Shutter_Left") == false || Entity_IsSleeping("Win4_Shutter_Right") == false)
			Light_SetBrightness("light_win4_*", 1.0f*(SwingDoor_GetOpenAmount("Win4_Shutter_Left")+SwingDoor_GetOpenAmount("Win4_Shutter_Right"))/2);
	}
	
