		bool On_Trigger_Intro(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_Play("Dialogue_Intro");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_OilTutorial(const tString &in asEntity)
		{
			bool bOilTutorialized = cScript_GetGlobalVarBool("Outpost_LQ_OilTutorialized");
			
			if (bOilTutorialized) return;
			
			Hint_ShowHint_Hold("Hints", "HintOil", true);
			cScript_SetGlobalVarBool("Outpost_LQ_OilTutorialized", true);
		}
 
		//-------------------------------------------------------
	 
		//} END Event A *Player explores the entrance and finds the LEDGER*
		
		/////////////////////////////////////////
		// Event B *Player finds the SHELL PRESS in the workshop*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 1, Event B here.*/
		
		bool mbKnowsAboutIngredients = false;
		
		//-------------------------------------------------------
	 
		/*Put any functions that are only used in Scene 1, Event B here.*/
		
		void OnLookAt_Ingredients(const tString &in asEntity, int alState)
		{
			if (mbKnowsAboutIngredients==false)
			{
				Sketchbook_AddIdea("find_charcoal");
				Sketchbook_AddIdea("find_saltpeter");
				Sketchbook_AddIdea("find_sulfur");
				
				if (mbKnowsSaltpeterLocation)
					Sketchbook_AddIdea("find_saltpeterlocation");
				
				// Check if player already checked off some ideas
				if (Entity_IsActive("pickup_inv_item_1")==false) //charcoal
					Sketchbook_CompleteIdea("find_charcoal");
					
				if (Entity_IsActive("sulphur_solution_1")==false)
				{
					Sketchbook_CompleteIdea("find_sulfurlocation");
					Sketchbook_CompleteIdea("find_sulfur");
				}
				
				// Saltpeter, would be better to do with global variable but wanna avoid adding variables at this point
				if (ItemType_GetCountInInventory("Saltpeter_Powder") > 0 ||
					ItemType_GetCountInInventory("SaltpeterSulfur_Powder") > 0 ||
					ItemType_GetCountInInventory("CharcoalSaltpeter_Powder") > 0 ||
					ItemType_GetCountInInventory("GunpowderMix") > 0 ||
					Entity_GetVarBool("Interact_Bullet","HasSaltpeter"))
				{
					Sketchbook_CompleteIdea("find_saltpeterlocation");
					Sketchbook_CompleteIdea("find_saltpeter");
				}
			}
			
			mbKnowsAboutIngredients = true;
			
			bool bShellGoalSet = cScript_GetGlobalVarBool("Outpost_HasUsedTankGun");
			if (!bShellGoalSet) return;
			
			cScript_SetGlobalVarBool("Outpost_LQ_SeenGunpowderRecipe",true);
			Voice_Play("Dialogue_ReadsGunpowerMix");
			Entity_SetPlayerLookAtCallback(asEntity,"");
		}
 
		//-------------------------------------------------------
	 
		//} END Event B *Player finds the SHELL PRESS in the workshop*
		
		/////////////////////////////////////////
		// Event C *Player obtains information on where to find the ingredients*
		//{//////////////////////////////////////
	 
		//-------------------------------------------------------
	 
		/*Put any variables that are only used in Scene 1, Event C here.*/
		
		tString msCorridorRope = "CorridorRope";
		bool mbKnowsSaltpeterLocation = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functionsthat are only used in Scene 1, Event C here.*/
		
		void OnRead_SaltpeterNote(const tString &in asEntity)
		{
			mbKnowsSaltpeterLocation = true;
			if (mbKnowsAboutIngredients && Sketchbook_GetSketchActive("find_saltpeterlocation_complete")==false)
				Sketchbook_AddIdea("find_saltpeterlocation");
		}
		
		//------------------------------------------------------- 
		
		void Corridor_CreateRope()
		{
			cVector3f vStart = Map_GetEntity("corridor_stick_1").GetPosition();
			cVector3f vEnd = Map_GetEntity("corridor_stick_2").GetPosition();
			
			Rope_Create(msCorridorRope,vStart,vEnd,.3f,.1f,100,.5f,true,false);
			Rope_SetTotalLength(msCorridorRope,2.f);
			Rope_AttachStart(msCorridorRope,"corridor_stick_1");
			Rope_AttachEnd(msCorridorRope,"corridor_stick_2");
			Rope_SetEndParticleMass(msCorridorRope,0);
			OnTimer_RopeMaterial(msCorridorRope);// Map_AddTimer(msCorridorRope,0.2f,"OnTimer_RopeMaterial");
			Rope_SetCollideGroup(msCorridorRope,"rope");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_TriggerCorridorTrap(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;
			if (Map_GetEntity(asChild).GetMainBody().GetMass() == 0 && asChild != "Player") return true;
			
			if (asChild == "Player")
				Effect_Rumble_Start(0.1,0.1);
			
			cScript_SetGlobalVarBool("Outpost_Arsenal_CorridorTrapTriggered",true);
			//Rope_SetCollide(msCorridorRope,true,false);
			//Prop_SetStaticPhysics("corridor_stick_1",false);
			Rope_Detach(msCorridorRope,"corridor_stick_1");
			Rope_SetStartParticleMass(msCorridorRope,1);
			
			
			iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(msCorridorRope);
			pRope.GetParticle(0).AddForce(cVector3f_Forward*300);	
			pRope.GetParticle(1).AddForce(cVector3f_Forward*300);	
			pRope.GetParticle(2).AddForce(cVector3f_Forward*300);	
			pRope.GetParticle(3).AddForce(cVector3f_Forward*300);	
				
			Map_AddTimer("Timer_ActivateTrap",0.6f,"OnTimer_ActivateTrap");
			Map_AddTimer("Timer_ActivateTrap",0.7f,"OnTimer_ArrowHitWall");
			Map_AddTimer("Timer_ActivateTrap",0.8f,"OnTimer_RemoveArrowCollide");
			FearHandler_SetForcedAddFearRate(1,5,true,10,-10,0.5f);
			Sound_Play("Sound_CrossbowTrigger_*", 1.0f);
			Sound_Play("Sound_verb_trigger", 1.0f);
			
			Entity_SetActive(asParent,false);
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateTrap(const tString &in asTimer)
		{
			Entity_AddCollideCallback("player","spear_extractright_1","OnCollide_Player_Hit");
			Map_AddTimer("Timer_ArrowDidntHit",1,"OnTimer_ArrowDidntHit");
			Prop_MoveLinearTo("spear_extractright_1","spear_extractright_End",100,50,0,true);
			Sound_CreateAtEntity("Sound_ArrowFire", "02_03_arsenal/crossbow/arrow_fire", "02_04_ballista_trap_1");
			Sound_Play("Sound_ArrowWhoosh", 1.0f);
			Sound_Play("Sound_verb_fire", 1.0f);
			Entity_PlayAnimation("ballista_trap","ballista_trap_fire", 0.0, false);
			Map_AddTimer("Timer_Trapfired",0.8f,"OnTimer_Trapfired");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_Trapfired(const tString &in asTimer)
		{
		    Entity_PlayAnimation("ballista_trap","ballista_trap_postfire", 0.0, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ArrowHitWall(const tString &in asTimer)
		{
			ParticleSystem_CreateAtEntity("PS_Hit","wooden_brace_damage.ps","PosArea_TrapPfx",false);
			Decal_SetDynamicVisible("Decal_Arrow_*",true);
			Sound_CreateAtEntity("Sound_ArrowHit", "02_03_arsenal/crossbow/arrow_wall_hit", "PosArea_TrapPfx");
			Music_Play("A2_2_3_Crossbow.ogg", 0.7f, false, eMusicPrio_MinorEvent);
			Sound_Play("Sound_verb_impact", 1.0f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ArrowDidntHit(const tString &in asTimer)
		{
			Voice_Play("Dialogue_TrapFiresAndMisses");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RemoveArrowCollide(const tString &in asTimer)
		{
			Entity_RemoveCollideCallback("player","spear_extractright_1");
		}
		
		//-------------------------------------------------------
		
		bool OnCollide_Player_Hit(const tString &in asParent, const tString &in asChild, int alState)
		{
			Player_GiveDamage(0.1f, 0.35f, eDamageType_Default, asParent);
			Player_AddBodyForceAwayFromEntity(asParent, 15000.f, true);
			Voice_Play("Dialogue_TrapFiresAndHits",1);
			Map_RemoveTimer("Timer_ArrowDidntHit");
			return false;
		}
	 
		//} END Event C *Player obtains information on where to find the ingredients*
		
