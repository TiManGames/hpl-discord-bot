	//-------------------------------------------------------
	
	int mlPermaFailStage = eArsenalPermaFail_Explosion;
	
	bool OnCollide_Player_SetPermaFail(const tString &in asParent, const tString &in asChild, int alState)
	{		
		if (alState != 1) return true;
		
		if (asParent == "Trigger_SetPermaFail_Workshops")			mlPermaFailStage = eArsenalPermaFail_Workshops;
		else if (asParent == "Trigger_SetPermaFail_Storage") 		mlPermaFailStage = eArsenalPermaFail_Storage;
		else if (asParent == "Trigger_SetPermaFail_Relic") 			mlPermaFailStage = eArsenalPermaFail_Relic;
	
		return true;
	}
	
	bool OnPermaFail()
	{	
		switch (mlPermaFailStage)
		{
			case eArsenalPermaFail_Workshops:		PermaFail_Default("Workshops_*"); 		return true;
			case eArsenalPermaFail_Storage:			PermaFail_Default("Storage_*"); 		return true;
			case eArsenalPermaFail_Relic: 			PermaFail_Default("RelicRoom_*");		return true;
			case eArsenalPermaFail_Explosion: 		PermaFail_Explosion();				 	return true;
			case eArsenalPermaFail_BalconyFall: 	PermaFail_BalconyFall();			 	return true;
		}

		return true;
	}
	
	//-------------------------------------------------------
	
	void PermaFail_Default(const tString &in asArea)
	{
		FearHandler_SetPermaFailRespawnArea("PermaFail_"+asArea);
	}
	
	//-------------------------------------------------------
	
	void PermaFail_Explosion()
	{
		tString sPermaFailArea = "";
		
		if (Entity_GetCollide("player","Trigger_RelicRoom"))
			sPermaFailArea = Entity_GetClosestTo("player","PermaFail_RelicRoom_*").GetName();
		else
			sPermaFailArea = Entity_GetClosestTo("player","PermaFail_Storage_*").GetName();
		
		FearHandler_SetPermaFailRespawnArea(sPermaFailArea);
	}
	
	//-------------------------------------------------------
	
	void PermaFail_BalconyFall()
	{
		tString sPermaFailArea = "";
		
		if (mbPlankCollapse2)		sPermaFailArea = "PermaFail_RelicRoom_4";
		else if (mbPlankCollapse1)	sPermaFailArea = "PermaFail_Balcony";
		else						sPermaFailArea = "PermaFail_Storage_6";
		
		FearHandler_AddPermaFailScene("PosArea_PermaFail_B_Start", "PosArea_PermaFail_B_End", 8.f, 1.5f, true);
		FearHandler_AddPermaFailScene("PosArea_PermaFail_A_Start", "PosArea_PermaFail_A_End", 5.f, 1.5f, true);
		FearHandler_AddPermaFailScene("CamAnim_Climb", 5);
		//FearHandler_AddPermaFailScene("PosArea_PermaFail_C_Start", "PosArea_PermaFail_C_End", 3, 3.f, 1., 0.025f, 0.05f, true);
		//Map_AddTimer("Timer_ChangeCorpse",22,"OnTimer_ChangeCorpse");
		FearHandler_SetPermaFailRespawnArea(sPermaFailArea);
	}
	
