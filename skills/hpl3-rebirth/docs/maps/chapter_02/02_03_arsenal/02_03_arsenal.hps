	void OnTimer_ChangeCorpse(const tString &in asTimer)
	{
		Decal_SetDynamicVisible("Corpse_Impaled*",true);
		Decal_SetDynamicVisible("Corpse_Hanging*",false);
		Entity_SetActive("Corpse_Hanging*",false);
		Entity_SetActive("Corpse_Impaled*",true);
	}
		
