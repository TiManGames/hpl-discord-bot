			Sound_CreateAtEntity("Sound_TurretDebris_1", "02_05_cistern/turret_stuck/move_debris/move_1_debris", "player");
			Sound_Play("Sound_DebrisWater_1", 1.0f);
			Entity_SetActive("Trigger_SoundDebris_3", true);
			Entity_SetActive("Trigger_TurretHatchSound", false);
			return false;
		}
		
		//-------------------------------------------------------
		 
