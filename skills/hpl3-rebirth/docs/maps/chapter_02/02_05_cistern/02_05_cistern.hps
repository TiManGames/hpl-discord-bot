			Sound_CreateAtEntity("Sound_TurretDebris_2", "02_05_cistern/turret_stuck/move_debris/move_2_debris", "player");
			Sound_Play("Sound_DebrisWater_2", 1.0f);
			Sound_Stop("Sound_TurretDebris_1", 0.5f);
			return false;
		}
		
		//-------------------------------------------------------
		 
