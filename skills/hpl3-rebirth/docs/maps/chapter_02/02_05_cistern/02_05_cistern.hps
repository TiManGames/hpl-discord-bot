	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	int mlPermaFailStage;
 
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	void Update(float afTimeStep)
	{						
		UpdateChainCorpse(afTimeStep);		
		UpdateWaterTank(afTimeStep);		
		UpdateTankTurret(afTimeStep);
		UpdateClimbingOutOfTank(afTimeStep);
	}
	
	//-------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
		PostUpdateTankTurret(afTimeStep);
		
		/////////////////////
		// Position player in tank
		if (mbBabyKickSeqTriggered)
			return;
		
		int lState = cLux_GetPlayer().GetCurrentStateId();
		if (lState == ePlayerState_CutsceneAnimation || lState == ePlayerState_InteractiveCutsceneAnimation)
		{
			int lMovePosId = -1;
			tString[] sAnims = {"player_tf17_push_cannon_end", "tf17_enter" };
			float[] fTimeOffsets = { 1.f, 1.5f };
			
			for (int i = 0; i < sAnims.length(); ++i)
			{
				cAnimationState@ pState = PlayerBody_GetAnimationState(sAnims[i]);
				if (pState !is null && pState.IsActive() && pState.GetTimePosition() > pState.GetLength() - fTimeOffsets[i])
				{
					lMovePosId = i;
					break;
				}
			}
			
			if (lMovePosId != -1)
			{				
				cVector3f[] vEndPos = { cVector3f(52.606f, 2.465f, -27.444f), cVector3f(52.443f, 2.436f, -27.447f) };
				tString[] sAreas = {"Area_WakeUpAnim", "Area_ClimbInAnim" };
				
				iLuxEntity@ pStartEnt = mBaseObj.GetEntityByName(sAreas[lMovePosId], eLuxEntityType_Area);
				iLuxEntity@ pGoalEnt = mBaseObj.GetEntityByName("Area_TankBase", eLuxEntityType_Area);
				
				cVector3f vDelta = pGoalEnt.GetPosition() - vEndPos[lMovePosId];				
				float fAngle = cMath_GetAngleFromPoints3D(0.f, pStartEnt.GetMatrix().GetTranspose().GetForward()).y;
				
				PlayerBody_SetCameraAnimationPositionAndYaw(true, pStartEnt.GetPosition() + vDelta, fAngle, 0.f);
			}
		}
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_FallPermafail(const tString &in asParent, const tString &in asChild, int alState)
	{
		if (alState == -1 || FearHandler_GetIsPermaFailing())
			return true;
			
		mlPermaFailStage = eCisternPermaFailStage(Entity_GetVarInt(asParent, ""));
		
		Voice_StopAll();
		Music_StopAll(1.f);
		
		FearHandler_TriggerPermaFail_Fall();
		
		StopTHEntranceSeq();
		StopVertigoSeq();
		return true;
	}
	
	//-------------------------------------------------------
	
	void OnInteract_FlowRegulator(const tString &in asEntity)
	{
		PhysicsSlideDoor_SetJammed(asEntity, true);
		if (asEntity == "FlowRegulator_Chase_1")
			PhysicsSlideDoor_SetJammed("FlowRegulator_Chase_2", true);
		
		Map_RemoveTimer(asEntity);
		
		float fTime = 2.f;
		if (asEntity == "FlowRegulator_FlowConnection")
			fTime = 0.01f;
		
		Map_AddTimer(asEntity, fTime, "OnTimer_JamRegulator");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_JamRegulator(const tString &in asTimer)
	{
		if (Entity_IsInteractedWith(asTimer) == false)
		{
			tString sProp = asTimer;
			Map_GetEntity(sProp).GetMainBody().SetLinearVelocity(0.f);
			
			if (sProp == "FlowRegulator_Chase_1")
				sProp = "FlowRegulator_Chase_*";
			
			PhysicsSlideDoor_SetJammed(sProp, false);
			return;
		}
			 
		Map_RestartCurrentTimer();
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SetLiquidAreasActive(const tString &in asParent, const tString &in asChild, int alState)
	{
		array<tString> vAreas;
		cString_GetStringVec(Entity_GetVarString(asParent, ""), vAreas, ";");
		
		for (int i = 0; i < vAreas.size(); ++i)
			Entity_SetActive(vAreas[i], alState == 1);
			
		if (vAreas.size() > 0 && vAreas[0] == "Liquid_CisternBottom")
			Entity_SetActive("Liquid_CisternBottom_Fake", alState == -1);
			
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_Player_SetWhispering(const tString &in asParent, const tString &in asChild, int alState)
	{
		Pregnancy_SetWhispering(alState == -1 && Entity_PlayerIsInFront(asParent));
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnTrigger_ActivateShutterBlockBox(const tString &in asParent, const tString &in asChild, int alState)
	{
		Entity_SetActive(Entity_GetVarString(asParent, ""), alState == 1);
		return true;
	}
 
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
	 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 2 *THE PLAYER WAKES UP AFTER THE FALL AND MAKES THEIR WAY TO THE CISTERN*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 2 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 2 here.*/
		
		 void OnTimer_PlaceInTankCenter(const tString &in asTimer)
		 {			 
			 PlayerBody_SetAnimationSet("tank");
		 }
	 
		//-------------------------------------------------------
		
		 void Trigger_SkylightSound_OnPlayerLookAt(const tString &in asEntity, int alState)
		 {
			 Sound_Play("Sound_AnimalAmb", 1.0f);
		 }
		
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Wake up in the FRENCH TANK*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event A here.*/
		 
		 int mlWakeUpDofId = -1;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event A here.*/
		 
		 cSequenceStatesData mSeqDataWakeUp;
		 void Seq_WakeUp(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_WakeUp", mSeqDataWakeUp);
			 if (Sequence_DoStepAndWait(1.f))
			 {
				 FootPlacement_SetActive(PlayerBody_GetEntityName(), false);
				 
				 Effect_Fade_Out(0.f);
				 Player_Teleport("Start_Begin");
				 Player_SetActive(false);
				 
				 Sound_SetGlobalVolume(0.f, eSoundEntryType_AllExceptGui);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {				 
				 Light_SetBrightness("Light_RainwaterHub", 15.f);
				 
				 Player_SetActive(true);
				 Player_SetLeanDisabled(true);
				 Player_SetJumpDisabled(true);				 
				 Player_SetCrouching(false, true, true);
				 
				 FearHandler_SetPaused(true);				 
				 
				 Entity_SetActive("Gun_Animated", true);
				 
				 Entity_PlayAnimation("Gun_Animated", "tf17_gun_player_push_cannon_start", 0.f, false, false);
				 PlayerBody_PlayCutsceneAtEntity("player_tf17_push_cannon_start", "Area_WakeUpAnim", false, 0.f, "OnAnimEnd_PushCannon_1");				 
				 
				 Map_GetEntity("Gun_Animated").GetMeshEntity().GetAnimationStateFromName("tf17_gun_player_push_cannon_start").SetSpeed(0.f);
				 PlayerBody_GetAnimationState("player_tf17_push_cannon_start").SetSpeed(0.f);
				 
				 PlayerBody_SetCutsceneMaxPitch(10.f);
				 PlayerBody_SetCutsceneMaxYaw(10.f);
			 }
			 else if (Sequence_DoStepAndWait(0.25f))
			 {
				 Sound_Stop("Sound_WaterHiding_Emerge", 0.f);
				 Sound_SetGlobalVolume(1.f, eSoundEntryType_AllExceptGui);
			 }
			 else if (Sequence_DoStepAndWait(0.25f))
			 {				 
				 Player_SetMoveSpeedMul(0.f);			 
				 Player_SetLookSpeedMul(0.05f);				 
				 
				 Effect_Fade_In(2.f);
				 Effect_ImageTrail_Start(1.2f, 0.f, 16.f, 4.f);
				 mlWakeUpDofId = Effect_DoF_Start(0.f, 0.f, 0.025f, 0.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Light_FadeBrightnessTo("Light_TH_WakeUp", 50.f, 1.25f, eEasing_QuadIn);
				 Sound_Play("Sound_TinHinanDisappear", 0.0f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Effect_Fade_Out(1.5f);
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 Light_FadeBrightnessTo("Light_TH_WakeUp", 0.f, 0.5f, eEasing_QuadOut);
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 Effect_Fade_In(3.f);				 
				 Light_FadeBrightnessTo("Light_TH_WakeUp", 50.f, 0.5f, eEasing_QuadIn);
				 Sound_Play("Sound_TinHinanAppear", 0.0f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Light_FadeBrightnessTo("Light_TH_WakeUp", 0.f, 0.5f, eEasing_QuadOut);
				 
				 Map_GetEntity("Gun_Animated").GetMeshEntity().GetAnimationStateFromName("tf17_gun_player_push_cannon_start").SetSpeed(1.f);
				 PlayerBody_GetAnimationState("player_tf17_push_cannon_start").SetSpeed(1.f);
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {		 
				 Voice_PlayDelayed("Dialogue_Intro_1", 0.5f);				 
			 }
			 else if (Sequence_DoStepAndPause(1.5f))
			 {
				 FearHandler_SetPaused(false);
				 FearHandler_SetMaxLevel(0.15f);
				
				 Effect_DoF_FadeOut(mlWakeUpDofId, 1.f);
				 
				 Player_FadeLookSpeedMulTo(0.5f, 5.f);
			 }
			 else if (Sequence_DoStepAndWait(5.f))
			 {				 
				 Player_FadeLookSpeedMulTo(1.f, 3.f);
				 Voice_PlayWhenPossible("Dialogue_Intro_2", "", 30.f, 1.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {				 
				 Light_FadeBrightnessTo("TurretLight_Light_Spot_1", 0.25f, 6.f);
				 Billboard_SetBrightness("tank_door_rift_halo", 0.f);
				 Billboard_SetBrightness("tank_door_rift_godray", 0.f);
				 ParticleSystem_Destroy("PS_TurretGodRay");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Wake up in the FRENCH TANK*
		 
		 /////////////////////////////////////////
		 // Event B *Move the CANNON PIPE*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event B here.*/
		 
		void OnAnimEnd_PushCannon_1(const tString &in asAnim)
		{
			PlayerBody_SetInteractiveAnimationEntity("Gun_Animated", "tf17_gun_player_push_cannon_idle1_tr_idle2");
			PlayerBody_SetInteractiveAnimationStartIdleAnimation("player_tf17_push_cannon_idle1");
			PlayerBody_PlayInteractiveAnimationAtEntity("player_tf17_push_cannon_idle1_tr_idle2", "Area_WakeUpAnim", 0.f, "OnAnimEnd_PushCannon_2", false, true, true);
			PlayerBody_SetCutsceneMaxPitch(10.f);
			PlayerBody_SetCutsceneMaxYaw(10.f);
		}
		
		//-------------------------------------------------------
	
		void OnAnimEnd_PushCannon_2(const tString &in asAnim, float afT)
		{
			if (afT < 1.f) 
				return;
			
			PlayerBody_SetInteractiveAnimationRange(0.f, 4.f, "OnInteractiveRangeEnd_PushCannonEnd");
			PlayerBody_SetInteractiveAnimationEntity("Gun_Animated", "tf17_gun_player_push_cannon_end");
			PlayerBody_SetInteractiveAnimationStartIdleAnimation("player_tf17_push_cannon_idle2");
			PlayerBody_PlayInteractiveAnimationAtEntity("player_tf17_push_cannon_end", "Area_WakeUpAnim", 0.f, "OnAnimEnd_PushCannonEnd", false, true, true);
			PlayerBody_SetCutsceneMaxPitch(10.f);
			PlayerBody_SetCutsceneMaxYaw(10.f);
		}
		
		//-------------------------------------------------------
		
		void OnInteractiveRangeEnd_PushCannonEnd(const tString &in asAnim)
		{
			SequenceStates_Resume("Seq_WakeUp");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_PushCannonEnd(const tString &in asAnim, float afT)
		{
			if (afT < 1.f)
				return;
			
			Map_AddTimer("Timer_PlaceInTankCenter", 1.f, "OnTimer_PlaceInTankCenter");
		}
		
		//-------------------------------------------------------
		 
