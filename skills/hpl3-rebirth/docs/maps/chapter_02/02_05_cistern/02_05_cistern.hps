		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event E here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event E here.*/
		 
		 bool OnTrigger_Player_SetTreasureTroveExitLightActive(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1)
				 return true;
				 
			 bool bInFront = Entity_PlayerIsInFront(asParent);
			 Billboard_SetVisible("Billboard_TreasureTroveTunnel", bInFront == false);
			 Light_SetBrightness("Light_Spot_TreasureTroveGrating", (bInFront == false) ? 1.5f : 0.f);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_SetSniffingGhoulThrowActive(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Ghoul_SetAllowPlayerThrow("Ghoul_Sniffing", alState == -1);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_EndTreasureTroveEncounter(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
			 Agent_SetSensesActive("Ghoul_Sniffing", false);
			 
			 Ghoul_SetHoleNetwork("Ghoul_Sniffing", "Hole_TreasureTrove_Bottom_*", "", "");
			 Ghoul_Command_Remove("Ghoul_Sniffing", true);
			 Ghoul_CommandGoToHole_Execute("Ghoul_Sniffing", Map_GetEntity("Ghoul_Sniffing").GetPosition(), true, false, true, true, eGhoulSpeed_Run);
			 
			 Voice_StopCheckTimer("Dialogue_SniffTutorial");
			 Music_StopAll(10.f);
			 
			 SetTunnelScareSoundsActive(false);
			 
			 Player_SetCrouchSpeedMul(1.36f);
			 
			 Map_RemoveTimer("Timer_CheckShouldShowSneakHint");
			 
			 if (FearHandler_GetLevel() > 0.5f)
				Map_AddTimer("Timer_DoPostEncounterBabyKick", 4.f, "OnTimer_DoPostEncounterBabyKick");
			 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoPostEncounterBabyKick(const tString &in asTimer)
		 {
			 Pregnancy_DoBabyKick(false);
		 }

		 //-------------------------------------------------------
	 
		 //} END Event E *Exit the area*
		 
		 /////////////////////////////////////////
		 // Event F *Wake up outside of the Treasure Trove (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event F here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event F here.*/
		 
		 bool OnPermaFail_AfterPuzzle(const tString &in asSource)
		 {			 
			 SetupGenericPermaFail();			 
			 FearHandler_SetPermaFailRespawnArea("PermaFail_AfterPuzzle");
			 return true;
		 }

		 //-------------------------------------------------------
	 
		 //} END Event F *Wake up outside of the Treasure Trove (PERMAFAIL)*
		 
		 /////////////////////////////////////////
		 // Event G *Wake up in a dirty ghoul tunnel (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event G here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event G here.*/
		 
		 bool OnPermaFail_NastyTunnel(const tString &in asSource)
		 {
			 mlPermaFailStage = eCisternPermaFailStage_EerieQuiet;
			 		 
			 Ghoul_Command_Remove("Ghoul_Sniffing", true);
			 Ghoul_Mode_Set("Ghoul_Sniffing", eGhoulMode_Idle, true);
			 			 
			 Pathfinder_Stop("Ghoul_Sniffing");
			 Pathfinder_Track_Clear("Ghoul_Sniffing");
			 Pathfinder_Track_Stop("Ghoul_Sniffing");
			 
			 Entity_SetActive("Ghoul_Sniffing", false);
			 Agent_ResetPlayerDetectionState("Ghoul_Sniffing");
			 cLux_ToAgent(Map_GetEntity("Ghoul_Sniffing")).GetCharBody().StopMovement();
			 CharMover_StopTurning("Ghoul_Sniffing");
			 
			 SetTunnelScareSoundsActive(true);
			 
			 SequenceStates_Stop("Seq_SniffingGhoulEmerge");
			 
			 Map_RemoveTimer("Timer_SetupBottomFloor");
			 Map_RemoveTimer("Timer_EnableSniffingGhoulSmelling");
			 Map_RemoveTimer("Timer_BottomFloorSmellPatrol");
			 Map_RemoveTimer("Timer_SniffingGhoulLeave");
			 
			 tString sAreaBase = "Area_PermaFail_NastyTunnel";
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_1", sAreaBase + "_End_1", 3.f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_2", sAreaBase + "_End_2", 3.f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_3", sAreaBase + "_End_3", 2.f, 2.f, true);
			 
			 FearHandler_SetPermaFailRespawnArea("PermaFail_NastyTunnel");
			 return true;
		 }

		 //-------------------------------------------------------
	 
		 //} END Event G *Wake up in a dirty ghoul tunnel (PERMAFAIL)*
		 
		 /////////////////////////////////////////
		 // Event H *Wake up to an eerie quiet (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event H here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event H here.*/
		 
		 bool OnPermaFail_EerieQuiet(const tString &in asSource)
		 {
			 Entity_SetActive("Ghoul_Sniffing", false);
			 Entity_SetActive("Trigger_StartSeqSniffingGhoulEmerge_*", false);
			 Entity_SetActive("Trigger_EnterFirstTreasureTroveFloor", false);
			 
			 SetTunnelScareSoundsActive(true);
			 
			 tString sAreaBase = "Area_PermaFail_EerieQuiet";
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_1", sAreaBase + "_End_1", 3.f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_2", sAreaBase + "_End_2", 2.f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_3", sAreaBase + "_End_3", 3.f, 2.f, true);
			 
			 FearHandler_SetPermaFailRespawnArea("PermaFail_EerieQuiet");
			 return true;
		 }

		 //-------------------------------------------------------
	 
		 //} END Event H *Wake up to an eerie quiet (PERMAFAIL)*
	 
	 //} END SCENE 6 *THE PLAYER AVOIDS A SNIFFING GHOUL AND SEES A LIVE FRENCH SOLDIER*
	 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 7 *THE PLAYER IS CHASED THROUGH UNDERWATER TUNNELS BY A GHOUL*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 7 here.*/
		
		bool mbForceCrawlChaseSplashOffset = false;
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 7 here.*/
		
		void OnTimer_DoSplashParticles(const tString &in asTimer)
		{
			 DoChaseSplashParticles("Area_CrawlChaseSplash");
			 Map_AddTimer("Timer_DoSplashParticles", cMath_RandRectf(0.3f, 0.5f), "OnTimer_DoSplashParticles");
		}
		
		//-------------------------------------------------------
		
		void DoChaseSplashParticles(const tString &in asArea, bool abAllowOffset = true, bool abBig = false)
		{
			cParticleSystem@ pPS = mBaseObj.GetWorld().CreateParticleSystem("PS_ChaseSplash", "splash_ripples_oneshot_small.ps", cVector3f(1.f), true, false);
			iLuxEntity@ pArea = Map_GetEntity(asArea, eLuxEntityType_Area);
			
			tString sCutscene = Agent_GetActiveCutscene("Ghoul_CrawlChase");
			bool bUseOffset = false;
			if (abAllowOffset && sCutscene !=  "")
			{
				float fT = Map_GetEntity("Ghoul_CrawlChase").GetMeshEntity().GetAnimationStateFromName(sCutscene).GetRelativeTimePosition();
				bUseOffset = fT > 0.05f && fT < 0.85f;
			}
			
			if (mbForceCrawlChaseSplashOffset)
				bUseOffset = true;
			
			cVector3f vOffset = bUseOffset ? pArea.GetMatrix().GetTranspose().GetForward() * 0.75f : 0.f;
			cVector3f vPos = pArea.GetPosition() + vOffset;
			vPos += vOffset;
			vPos.y = -37.567f; // Water level!
			
			pPS.SetWorldPosition(vPos);
			
			tString sSecondParticles = abBig ? "crawl_chase_splash_big.ps" : "crawl_chase_splash.ps";
			cParticleSystem@ pPS_2 = ParticleSystem_CreateAtEntity("PS_Splash", sSecondParticles, asArea, false);
			pPS_2.SetPosition(vPos);
			pPS_2.SetBrightness(0.1f);
		}
	 
		//-------------------------------------------------------
		
		//} END General	
		 
		 /////////////////////////////////////////
		 // Event A *Get spooked by the PIPE CORPSE*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event A here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event A here.*/
		 
		 bool OnTrigger_FlushPipeCorpse(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 PhysicsSlideDoor_AutoMoveToState("FlowRegulator_FlowConnection", 1.f);
			 Map_AddTimer("Timer_DoFlushPipeScare", 0.1f, "OnTimer_DoFlushPipeScare");
			 Map_AddTimer("Timer_FlushAchievement", 5.f, "OnTimer_FlushAchievement"); 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoFlushPipeScare(const tString &in asTimer)
		 {
			 Prop_SetStaticPhysics("PipeScarePart_*", false);
			 for (int i = 1; i<= 13; i++)
				Body_AddImpulse("PipeScarePart_"+i+"_Body_1", cVector3f_Right * -1.f, false);
			 
			 FearHandler_SetForcedAddFearRate(0.5f, 4.f, true, -1.f, 0.1f, 0.5f);
			 Sound_CreateAtEntity("Sound_PipeCorpseStinger", "02_05_cistern/level/corpse_tube_stinger", "player");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_FlushAchievement(const tString &in asTimer)
		 {
			 Achievement_Unlock(eAchievement_Canopener);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Get spooked by the pipe corpse*
		 
		 /////////////////////////////////////////
		 // Event B *The CHASE GHOUL emerges*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event B here.*/
		 
		 int mlCrawlChaseStartId = -1;
		 float mfCrawlChaseGratingRoarTime = 1.5f;
		 bool mbCrawlChaseGhoulEmerged = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event B here.*/
		 
		 bool OnTrigger_Player_PlayPreChaseScare(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_AddTimer("Timer_PlayPreChaseScare", 0.3f, "OnTimer_PlayPreChaseScare");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayPreChaseScare(const tString &in asTimer)
		 {			 
			 DoChaseSplashParticles("Area_PreChaseScare");
			 Sound_CreateAtEntity("Sound_PreChaseScare", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", "Area_PreChaseScare", 0.f, false, 0.5f);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_LandAtChaseStart(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 FearHandler_SetPermaFailEnabled(false);
			 Player_SetCrouching(false);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_ChaseGrating(const tString &in asEntity)
		 {
			 if (mlCrawlChaseStartId != -1)
				 return;
			 
			 mlCrawlChaseStartId = Entity_GetVarInt(asEntity, "");
			 Entity_SetActive("CrawlChaseGratingBlocker_" + mlCrawlChaseStartId, false);
			 
			 Tear_SetCanBeTorn("LooseGrating_" + mlCrawlChaseStartId, false);
			 
			 // Disable the anim triggers for the path not chosen!
			 if (mlCrawlChaseStartId == 1)
			 {
				 Entity_SetActive("Trigger_DoCrawlChaseTunnelAnim_1", false);
				 Entity_SetActive("Trigger_StartCrawlChase_2", true);
			 }
			 else if (mlCrawlChaseStartId == 2)
			 {
				 Entity_SetActive("Trigger_DoCrawlChaseTunnelAnim_3", false);
				 Entity_SetActive("Trigger_StartCrawlChase_1", true);
			 }
			 
			 Seq_ChaseGhoulAppear("");
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqCrawlChaseStart;
		 void Seq_ChaseGhoulAppear(const tString &in asTimer)
		 {
			 tString sSplashArea = "Area_EmergeSplashScare_" + mlCrawlChaseStartId;
			 
			 Sequence_Begin("Seq_ChaseGhoulAppear", mSeqCrawlChaseStart);
			 Sequence_Wait(1.f);
			 if (Sequence_DoStepAndWait(0.9f))
			 {
				 mlPermaFailStage = eCisternPermaFailStage_CrawlChase;
				 
				 Sound_CreateAtEntity("Sound_SplashScare", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", sSplashArea + "_1");				 
				 Sound_CreateAtEntity("Sound_SplashScareImpact", "physics/water/water_impact", sSplashArea + "_1");				 
				 
				 FearHandler_SetForcedAddFearRate(0.4f, 6.f, false, -1.f, 0.1f);
			 }
			 else if (Sequence_DoStepAndWait(0.7f))
			 {				 
				 Entity_SetActive("Ghoul_CrawlChase", true);
				 Ghoul_SetAllowPlayerThrow("Ghoul_CrawlChase", false);
				 Ghoul_SetCanAttack("Ghoul_CrawlChase", false);
				 
				 Entity_AttachToSocket("Area_CrawlChaseSplash", "Ghoul_CrawlChase", "socket_root", true, true);
				 ParticleSystem_CreateAtEntity("PS_GhoulBubbles", "crawl_chase_bubbles.ps", "Area_CrawlChaseSplash", true);
				 
				 Agent_PlayCutsceneAtEntity("Ghoul_CrawlChase", "crawl_chase_pipe4", "Area_CrawlChaseAppearAnim_" + mlCrawlChaseStartId, 0.f, false, "", 1.f, 0.f, 0.f, 0.f, true, false, true);
				 
				 Sound_CreateAtEntity("Sound_SplashScare", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", sSplashArea + "_1");				 
				 Sound_CreateAtEntity("Sound_SplashScareImpact", "physics/water/water_impact", sSplashArea + "_1");
				 
				 mbForceCrawlChaseSplashOffset = true;
				 Map_AddTimer("Timer_DoSplashParticles", 0.1f, "OnTimer_DoSplashParticles");
				 
				 FearHandler_SetForcedAddFearRate(0.4f, 6.f, false, -1.f, 0.1f);
				 Music_Play("A2_2_5_Ghoul_Emerge_02.ogg", 0.4f, false, eMusicPrio_MinorEvent);
			 }
			 else if (Sequence_DoStepAndWait(0.6f))
			 {
				 Sound_CreateAtEntity("Sound_SplashScare", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", sSplashArea + "_2");
				 Sound_CreateAtEntity("Sound_SplashScareGrowl", "creatures/vocalisations/creature/ghoul/permafail_scream", sSplashArea + "_3");				 
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 Sound_CreateAtEntity("Sound_SplashScare", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", sSplashArea + "_3");
			 }
			 else if (Sequence_DoStepAndWait(0.7f))
			 {
				 Sound_CreateAtEntity("Sound_SplashScare", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", sSplashArea + "_4");
				 Sound_CreateAtEntity("Sound_SplashScareImpact", "physics/water/water_impact", sSplashArea + "_4");
			 }
			 else if (Sequence_DoStepAndWait(0.2f))
			 {
				 mbForceCrawlChaseSplashOffset = false;
			 }
			 else if (Sequence_DoStepAndWait(0.1f))
			 {
				//ParticleSystem_CreateAtEntity("PS_GhoulBubblesEmerge", "crawl_chase_bubbles_oneshot.ps", "Area_AnimSwitchParticles_" + mlCrawlChaseStartId, true);
				// Sound_CreateAtEntity("Sound_EmergeSplash", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", "Area_AnimSwitchParticles_" + mlCrawlChaseStartId);
				// Sound_CreateAtEntity("Sound_EmergeSplash", "physics/water/water_impact", "Area_AnimSwitchParticles_" + mlCrawlChaseStartId);
			 }
			 else if (Sequence_DoStepAndContinue())
			 {				 
				 Map_RemoveTimer("Timer_DoSplashParticles");
				 
				 Agent_PlayCutsceneAtEntity("Ghoul_CrawlChase", "temp_water_grating_bang", "Area_GhoulGratingAnim_" + mlCrawlChaseStartId, 0.f, true);
				 Entity_SetAnimationMessageEventCallback("Ghoul_CrawlChase", "OnAnimMessage_GhoulCrawlChase", false);
				 
				 Map_AddTimer("Timer_ForceTearGrating", 20.f, "OnTimer_ForceTearGrating");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimMessage_GhoulCrawlChase(const tString &in asEntityName, const tString &in asAnimName, int alMessageId)
		 {
			 tString sArea = "Trigger_StartCrawlChase_" + mlCrawlChaseStartId;			 
			 Sound_CreateAtEntity("Sound_BangGrating", "03_06_ghouls_nest/nest_gate/roof_vent_hit", sArea);
			 Sound_CreateAtEntity("Sound_GratingSplash", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", sArea);
			 
			 tString sParticleArea = "Area_GratingBang_" + mlCrawlChaseStartId + "_" + cMath_RandRectl(1, 2);
			 DoChaseSplashParticles(sParticleArea, false);
			 
			 if (Map_TimeHasPassed("Timer_GratingRoar", mfCrawlChaseGratingRoarTime))
			 {
				 mfCrawlChaseGratingRoarTime = cMath_RandRectf(1.5f, 3.f);
				 Sound_CreateAtEntity("Sound_GratingRoar", "creatures/vocalisations/creature/ghoul/ghoul_attack", sArea);
			 } 
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ForceTearGrating(const tString &in asTimer)
		 {
			 Tear_ForceTear("LooseGrating_" + mlCrawlChaseStartId);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTear_DamangedGrating(const tString &in asProp)
		 {			 
			 //////////////
			 // Spawn ghoul if the grating is at it!			
			 Entity_SetCollideCharacter("CrawlChaseFrame_" + (mlCrawlChaseStartId == 1 ? 2 : 1), false);

			 if (mbCrawlChaseGhoulEmerged == false && mlCrawlChaseStartId == cString_GetNumericSuffixInt(asProp))
			 {
				 mbCrawlChaseGhoulEmerged = true;
				 OnTimer_ChaseGhoulEmerge("Timer_ChaseGhoulEmerge");
			 }
			 
			 //////////////
			 // Tear effects!
			 Sound_CreateAtEntity("Sound_Tear" + asProp, "level_entity_shared/breakables/relic_room_bars/relic_bars_break", asProp);
			 
			 ParticleSystem_CreateAtEntity("PS_Sparks", "sparks_tiny.ps", asProp, false);
			 
			 Map_GetEntity(asProp).GetBody(0).SetCollideFlags(mBaseObj.GetCollideFlag("-player"));
			 Entity_SetActive("InteractAux_" + asProp, false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ChaseGhoulEmerge(const tString &in asTimer)
		 {
			 // Check if the emerge animation is over here instead!
			 if (SequenceStates_IsActive("Seq_ChaseGhoulAppear"))
			 {
				 Map_AddTimer("Timer_ChaseGhoulEmerge", 0.1f, "OnTimer_ChaseGhoulEmerge");
				 return;
			 }
			 
			 StartCrawlChase();
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_StartCrawlChase(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 StartCrawlChase();
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void StartCrawlChase()
		 {
			 Player_SetOxygenCount(12.f);
			 Player_SetCrouchSpeedMul(1.36f);
			 
			 Entity_SetActive("Trigger_StartCrawlChase_*", false);
			 Map_RemoveTimer("Timer_ChaseGhoulEmerge");
			 
			 Seq_ChaseGhoulEmerge("");
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataChaseGhoulEmerge;
		 void Seq_ChaseGhoulEmerge(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_ChaseGhoulEmerge", mSeqDataChaseGhoulEmerge);
			 if (Sequence_DoStepAndWait(1.95f))
			 {
				 mbCrawlChaseGhoulEmerged = true;
				 
				 // Emerge anim
				Agent_PlayCutsceneAtEntity("Ghoul_CrawlChase", "temp_water_grating_bang", "Area_GhoulGratingAnim_" + mlCrawlChaseStartId, 0.f, true, "", 0.f);
			 }
			 else if (Sequence_DoStepAndWait(0.05f))
			 {
				 DoChaseSplashParticles("Area_EmergeSplashParticles_" + mlCrawlChaseStartId, false, true);
				 Sound_CreateAtEntity("Sound_EmergeSplash", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", "Area_EmergeSplashParticles_" + mlCrawlChaseStartId);
				 Sound_CreateAtEntity("Sound_EmergeSplash", "physics/water/water_impact", "Area_EmergeSplashParticles_" + mlCrawlChaseStartId);
			 }
			 else if (Sequence_DoStepAndWait(0.1f))
			 {
				 Entity_SetAnimationMessageEventCallback("Ghoul_CrawlChase", "", true);
				 Entity_StopAnimation("Ghoul_CrawlChase");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Agent_SetSensesActive("Ghoul_CrawlChase", true);
				 Agent_TeleportFeetToEntity("Ghoul_CrawlChase", "Area_ChaseStartPos_" + mlCrawlChaseStartId);
				 Agent_RevealPlayerPosition("Ghoul_CrawlChase", false);
				 Ghoul_Mode_Set("Ghoul_CrawlChase", eGhoulMode_Hunt, true);
				 
				 Map_AddTimer("Timer_ChaseGhoulHuntPlayer", 0.1f, "OnTimer_ChaseGhoulHuntPlayer");
				 Map_AddTimer("Timer_DoSplashParticles", 0.1f, "OnTimer_DoSplashParticles");
				 
				 Entity_SetActive("Trigger_CrawlChaseDamage", true);
				 Entity_AttachToSocket("Trigger_CrawlChaseDamage", "Ghoul_CrawlChase", "socket_root", true, true);
				 
				 Sound_CreateAtEntity("Sound_CrawlChaseStart", "creatures/vocalisations/creature/ghoul/ghoul_spot", "Ghoul_CrawlChase");
				 
				 Music_PlayExt("A2_2_5_Ghoul_Water_Chase.ogg", true, 0.5f, 1.0f, 2.0f, 1.0f, eMusicPrio_AgentToAlertTransition, false);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *The CHASE GHOUL emerges*
		 
		 /////////////////////////////////////////
		 // Event C *Run through the underwater pipes*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event C here.*/
		 	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event C here.*/
		 
		 bool OnTrigger_DoCrawlChaseTunnelAnim(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1)
				 return true;
			 
			 Agent_ResetPlayerDetectionState("Ghoul_CrawlChase");
			 Agent_SetSensesActive("Ghoul_CrawlChase", false);
			 
			 Ghoul_Mode_Set("Ghoul_CrawlChase", eGhoulMode_Idle, true);
			 Map_RemoveTimer("Timer_ChaseGhoulHuntPlayer");
			 
			 int lId = cString_GetNumericSuffixInt(asParent);			 
			 tString sAnim = "crawl_chase_pipe" + lId;
			 tString sArea = "Area_CrawlChaseTunnelAnim_" + lId;			 
			 Agent_PlayCutsceneAtEntity("Ghoul_CrawlChase", sAnim, sArea, 0.3f, false, "OnAnim_CrawlChasePipe", 0.85f, 0.f, 0.f, 0.f, true, false, true);
			 
			 Map_AddTimer("Timer_PlayChaseSplash", 1.f, "OnTimer_PlayChaseSplash");
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayChaseSplash(const tString &in asTimer)
		 {
			 tString sSplashSound = Player_GetUnderwater() ? "creatures/foley/creature/ghoul/water/underwater/ghoul_run_water_below" :
															 "creatures/foley/creature/ghoul/water/ghoul_run_water_above";
			 Sound_CreateAtEntity("Sound_GratingSplash", sSplashSound, "Area_CrawlChaseSplash");
			 
			 if (cMath_RandRectl(0, 1) == 1 && Map_TimeHasPassed("Timer_ChaseGrowl", 4.f))
				 Sound_CreateAtEntity("Sound_ChaseGrowl", "creatures/vocalisations/creature/ghoul/ghoul_spot", "Area_CrawlChaseSplash");

			 Map_RestartCurrentTimer(cMath_RandRectf(0.55f, 0.8f));
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnim_CrawlChasePipe(const tString &in asAgent, const tString &in asAnim)
		 {
			 Map_RemoveTimer("Timer_PlayChaseSplash");
			 
			 Agent_SetSensesActive("Ghoul_CrawlChase", true);			 
			 Ghoul_Mode_Set("Ghoul_CrawlChase", eGhoulMode_Hunt, true);
			 
			 Map_AddTimer("Timer_ChaseGhoulHuntPlayer", 0.1f, "OnTimer_ChaseGhoulHuntPlayer");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ChaseGhoulHuntPlayer(const tString &in asTimer)
		 {
			 // Have to do this since we don't have any pathnodes here!
			 Pathfinder_MoveToEntity("Ghoul_CrawlChase", "player", "");
			 CharMover_SetSpeedState("Ghoul_CrawlChase", 6);
			 Map_RestartCurrentTimer();
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ResetOxygenCount(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1) 
				 return true;
			 
			 Player_SetOxygenCount(12.f);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_CrawlChaseDamage(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1)
				 return true;
			 if (SequenceStates_IsActive("Seq_PipeSlip"))
				 return false;
			 if (FearHandler_GetIsPermaFailing())
				 return true;
			 
			 // TODO: Fix this when we have default behaviour for the ghoul attacking when it can't throw
			 // Only give instant dmg if the player is inside the tunnels!
			 //cScript_RunGlobalFunc("MoveState_Normal", "", "_Global_GetCrawlAreaCount");
			 //int lCount = cScript_GetGlobalReturnInt();
			 //if (lCount > 0)			 
			 
			 Sound_CreateAtEntity("Sound_GhoulHit", "creatures/vocalisations/creature/ghoul/ghoul_attack", asParent);
			 Player_GiveDamage(1.f, 0.9f, eDamageType_Default, "Ghoul_CrawlChase");
			 
			 FearHandler_TriggerPermaFail(false, "Ghoul_CrawlChase", true);
			 
			 Prop_SetStaticPhysics("ChaseWheel", true);
			 Prop_SetStaticPhysics("FlowRegulator_Chase_1", true);
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *Run through the underwater pipes*
		 
		 /////////////////////////////////////////
		 // Event E *Slip into the Cistern*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event E here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event E here.*/
		 
		 void OnInteract_ChaseWheel(const tString &in asEntity)
		 {
			 Map_AddTimer("ChaseWheel", 0.1f, "OnTimer_UpdateChaseWheel");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_StartPipeSlipSeq(const tString &in asParent, const tString &in asChild, int alState)
		 {			 
			 Player_ChangeStateToNormal();
			 PlayerBody_PlayCutsceneAtEntity("flushed_out_of_pipe", "Area_PipeFlushAnim", false, 1.f, "OnAnimEnd_PipeSlip", 0.8f, 0.f, 0.f, 0.f, true, true);
			 Sound_CreateAtEntity("Sound_PipeFlush", "02_05_cistern/level/chase_flush", "player");
			 
			 Entity_SetActive("Ghoul_CrawlChase", false);
			 Entity_SetActive("Trigger_DoCrawlChaseTunnelAnim_*", false);
			 Entity_SetActive("Trigger_CrawlChaseDamage", false);
			 
			 Entity_SetActive("Liquid_CisternBottom", true);
			 Entity_SetActive("Liquid_CisternBottom_Fake", false);
			 
			 Seq_PipeSlip("");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataPipeSlip;
		 void Seq_PipeSlip(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_PipeSlip", mSeqDataPipeSlip);
			 if (Sequence_DoStepAndWait(1.5f))
			 {
				 Entity_SetActive("WaterTank_Fallen_*", true);
				 Entity_SetActive("WaterTank", false);
				 Entity_SetActive("WaterTankChain_Bottom", false);
				 
				 Prop_SetStaticPhysics("ChaseWheel", true);
				 
				 Map_GetProp("ChaseWheel").RemoveAllInteractConnections();
				 Map_GetProp("FlowRegulator_Chase_1").RemoveAllInteractConnections();
				 Map_GetProp("FlowRegulator_Chase_2").RemoveAllInteractConnections();
				 
				 PhysicsSlideDoor_SetOpenAmount("FlowRegulator_Chase_1", 0.525f);				 
				 PhysicsSlideDoor_SetOpenAmount("FlowRegulator_Chase_2", 1.f);
			 }
			 else if (Sequence_DoStepAndWait(3.f))
			 {
				 Music_Stop(3.f, eMusicPrio_AgentToAlertTransition);
				 Music_PlayExt("A2_2_5_Ghoul_Water_Chase_End.ogg", false, 0.7f, 1.f, 1.f, 1.f, eMusicPrio_BigEvent, false);
				 
				 Entity_SetActive("Ghoul_CrawlChase", true);
				 Agent_PlayCutsceneAtEntity("Ghoul_CrawlChase", "crawl_chase_pipe4", "Area_CrawlChaseEnd", 0.f, false, "", 0.8f);
				 
				 Map_RemoveTimer("Timer_PlayChaseSplash");
				 Map_AddTimer("Timer_PlayChaseSplash", 0.5f, "OnTimer_PlayChaseSplash");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				  PhysicsSlideDoor_AutoMoveToState("FlowRegulator_Chase_1", -1);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 PhysicsSlideDoor_AutoMoveToState("FlowRegulator_Chase_2", -1);
				 
				 Entity_SetActive("Ghoul_CrawlChase", false);
				 Entity_SetActive("Trigger_CrawlChaseDamage", false);
				 
				 Map_RemoveTimer("Timer_PlayChaseSplash");
				 Map_RemoveTimer("Timer_DoSplashParticles");
				 
				 ParticleSystem_Destroy("PS_GhoulBubbles");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_PipeSlip(const tString &in asAnim)
		 {
			 mlPermaFailStage = eCisternPermaFailStage_Passage;
			 FearHandler_SetPermaFailEnabled(true);
			 
			 Player_SetCrouching(false, true, true);
			 Player_SetCrouchSpeedMul(1.f);
			 Pregnancy_SetWhispering(false);	

			 PlayerEmotion_PlaySound(eEmotionPlaylistType_Breathing, eEmotionSoundType_OneShotEvent, 10, "player/emotes/Tasi_Cistern_Escape");
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event E *Slip into the Cistern*
		 
		 /////////////////////////////////////////
		 // Event F *Wake up in chase tunnel*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event F here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event F here.*/
		 
		 bool OnPermaFail_CrawlChase(const tString &in asSource)
		 {	
			 Prop_SetStaticPhysics("ChaseWheel", false);
			 Prop_SetStaticPhysics("FlowRegulator_Chase_1", false);
		 
			 Music_Stop(3.f, eMusicPrio_AgentToAlertTransition);
			 
			 Map_RemoveTimer("Timer_PlayChaseSplash");
			 Map_RemoveTimer("Timer_DoSplashParticles");
			 
			 Entity_SetActive("Trigger_ResumeCrawlChase", true);
			 Entity_SetActive("CrawlChaseGratingBlocker_*", true);
			 Entity_SetActive("Trigger_DoChaseResumeBuildUp", true);
			 
			 ParticleSystem_Destroy("PS_GhoulBubbles");
			 
			 Entity_RemoveEntityAttachment("Trigger_CrawlChaseDamage");
			 Entity_PlaceAtEntity("Trigger_CrawlChaseDamage", "Area_CrawlChaseTunnelAnim_1");
			 Entity_SetActive("Trigger_CrawlChaseDamage", false);
			 
			 Pathfinder_Stop("Ghoul_CrawlChase");
			 cLux_ToAgent(Map_GetEntity("Ghoul_CrawlChase")).GetCharBody().StopMovement();
			 Entity_StopAnimation("Ghoul_CrawlChase");
			 
			 Agent_TeleportFeetToEntity("Ghoul_CrawlChase", "Area_CrawlChaseTunnelAnim_1", true);
			 Agent_ResetPlayerDetectionState("Ghoul_CrawlChase");
			 Ghoul_Mode_Set("Ghoul_CrawlChase", eGhoulMode_Idle, true);
			 
			 Entity_StopAnimation("Ghoul_CrawlChase");
			 Entity_SetActive("Ghoul_CrawlChase", false);
			 
			 tString sAreaBase = "Area_PermaFail_CrawlChase";
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_1", sAreaBase + "_End_1", 1.f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_2", sAreaBase + "_End_2", 2.f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_3", sAreaBase + "_End_3", 2.5f, 2.f, true, true);
			 
			 FearHandler_SetPermaFailRespawnArea("PermaFail_CrawlChase");
			 return true;
		 }		
		 
		 //-------------------------------------------------------
		 
		 bool OnPermaFailRespawn_CrawlChase()
		 {
			 mlPermaFailStage = eCisternPermaFailStage_CrawlChaseEnd;
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_DoChaseResumeBuildUp(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Map_AddTimer("Timer_DoChaseResumeBuildUp", 1.5f, "OnTimer_DoChaseResumeBuildUp");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoChaseResumeBuildUp(const tString &in asTimer)
		 {
			 Sound_CreateAtEntity("Sound_SplashScare", "creatures/foley/creature/ghoul/water/ghoul_run_water_above", "Area_EmergeSplashScare_1_4");				 
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ResumeCrawlChase(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Ghoul_CrawlChase", true);
			 Entity_StopAnimation("Ghoul_CrawlChase");
			 
			 Entity_SetActive("Trigger_CrawlChaseDamage", true);
			 Entity_AttachToSocket("Trigger_CrawlChaseDamage", "Ghoul_CrawlChase", "socket_root", true, true);
			 
			 Agent_ResetPlayerDetectionState("Ghoul_CrawlChase");
			 Agent_SetSensesActive("Ghoul_CrawlChase", true);
			 
			 Map_AddTimer("Timer_ResumeCrawlChase", 0.2f, "OnTimer_ResumeCrawlChase");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ResumeCrawlChase(const tString &in asTimer)
		 {
			 Agent_TeleportFeetToEntity("Ghoul_CrawlChase", "Area_CrawlChaseGhoulRespawn", true);				 
			 Ghoul_Mode_Set("Ghoul_CrawlChase", eGhoulMode_Hunt, true);
			 
			 Sound_CreateAtEntity("Sound_CrawlChaseStart", "creatures/vocalisations/creature/ghoul/ghoul_spot", "Ghoul_CrawlChase");
			 
			 Map_AddTimer("Timer_ChaseGhoulHuntPlayer", 0.1f, "OnTimer_ChaseGhoulHuntPlayer");
			 Map_AddTimer("Timer_DoSplashParticles", 0.1f, "OnTimer_DoSplashParticles");
			 
			 ParticleSystem_CreateAtEntity("PS_GhoulBubbles", "crawl_chase_bubbles.ps", "Area_CrawlChaseSplash", true);
			 
			 Music_PlayExt("A2_2_5_Ghoul_Water_Chase.ogg", true, 0.5f, 1.0f, 2.0f, 1.0f, eMusicPrio_AgentToAlertTransition, false);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event F *Wake up in chase tunnel (PERMAFAIL)*
		 
		 /////////////////////////////////////////
		 // Event G *Wake up at the Cistern bottom (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event G here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event G here.*/
		 
		 bool OnPermaFail_CrawlChaseEnd(const tString &in asSource)
		 {
			 Pregnancy_SetWhispering(false);
			 Player_SetMapDeepShadow(0.f);
			 
			 Map_RemoveTimer("Timer_PlayChaseSplash");
			 Map_RemoveTimer("Timer_DoSplashParticles");
			 
			 ParticleSystem_Destroy("PS_GhoulBubbles");
			 
			 Entity_SetActive("Ghoul_CrawlChase", false);			 
			 
			 Entity_SetActive("WaterTank_Fallen_*", true);
			 Entity_SetActive("WaterTank", false);
			 Entity_SetActive("WaterTankChain_Bottom", false);
			 
			 Music_Stop(3.f, eMusicPrio_AgentToAlertTransition);
			 			 
			 tString sAreaBase = "Area_PermaFail_CrawlChaseEnd";
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_1", sAreaBase + "_End_1", 2.f, 2.f, true, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_2", sAreaBase + "_End_2", 3.f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_3", sAreaBase + "_End_3", 3.f, 2.f, true);
			 
			 FearHandler_SetPermaFailRespawnArea("PermaFail_CrawlChaseEnd");			 
			 FearHandler_SetPermaFailEnabled(true);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnPermaFailRespawn_CrawlChaseEnd()
		 {
			 mlPermaFailStage = eCisternPermaFailStage_Passage;
			 Player_SetCrouchSpeedMul(1.f);
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event G *Wake up at the Cistern bottom (PERMAFAIL)*
		 
		 /////////////////////////////////////////
		 // Event H *Wake up in the Flow Connection Area (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 7, Event H here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 7, Event H here.*/
		 
		 bool OnPermaFail_FlowConnection(const tString &in asSource)
		 {		
			 SetupGenericPermaFail();
			 FearHandler_SetPermaFailRespawnArea("PermaFail_FlowConnection");
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event H *Wake up in the Flow Connection Area (PERMAFAIL)*
	 
	 //} END SCENE 7 *THE PLAYER IS CHASED THROUGH UNDERWATER TUNNELS BY A GHOUL*
	 
	 //////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 8 *THE PLAYER FOLLOWS YOUNG TIN HINAN INTO AN UNDERWATER PASSAGE AND GETS FLUSHED OUT OF THE CISTERN*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 8 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 8 here.*/

		//-------------------------------------------------------
		
		//} END General	
		 
		 //------------------------------------------------------
		 
		 /////////////////////////////////////////
		 // Event A *Get spooked by water splashes*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event A here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event A here.*/	
		 
		 /*bool OnTrigger_Player_StartSeqWaterScare(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Seq_WaterScare("");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataWaterScare;
		 void Seq_WaterScare(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_WaterScare", mSeqDataWaterScare);
			 if (Sequence_DoStepAndWait(0.75f))
			 {
				 Entity_SetCollide("WaterScareWood_*", false);
				 
				 Prop_SetHealth("WaterScareWood_1", 0.f);				 
				 FearHandler_SetForcedAddFearRate(0.4f, 5.f, false, -1.f, 0.05f, 0.5f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Prop_SetHealth("WaterScareWood_2", 0.f);
			 }
			 else if (Sequence_DoStepAndWait(3.f))
			 {
				 Sound_CreateAtEntity("Sound_GirderCreak", "02_04_living_quarters/tower/beam_creak", "WaterScare_Girder");				 
				 mBaseObj.GetWorld().GetSoundEntity("Sound_GirderCreak").SetUseCustomProperties(true);
				 mBaseObj.GetWorld().GetSoundEntity("Sound_GirderCreak").SetCustomMinDistance(10.f);
				 mBaseObj.GetWorld().GetSoundEntity("Sound_GirderCreak").SetCustomMaxDistance(80.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Sound_CreateAtEntity("Sound_GirderSnap", "02_04_living_quarters/tower/beam_snap", "WaterScare_Girder");
				 mBaseObj.GetWorld().GetSoundEntity("Sound_GirderSnap").SetUseCustomProperties(true);
				 mBaseObj.GetWorld().GetSoundEntity("Sound_GirderSnap").SetCustomMinDistance(10.f);
				 mBaseObj.GetWorld().GetSoundEntity("Sound_GirderSnap").SetCustomMaxDistance(80.f);
				 
				 ParticleSystem_CreateAtEntity("PS_GirderSnap", "dust_impact_large_oneshot.ps", "WaterScare_Girder", false).SetBrightness(0.05f);
				 
				 Entity_SetCollide("WaterScare_Girder", false);
				 Prop_SetStaticPhysics("WaterScare_Girder", false);
				 Body_AddImpulse("WaterScare_Girder_Body_1", cVector3f_Right * -0.5f, false);
				 Map_GetEntity("WaterScare_Girder").GetBody(0).AddTorque(cVector3f(0.f, 0.f, 300.f));
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Entity_SetCollide("WaterScare_Girder", true);
			 }
			 Sequence_End();
		 }*/
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Get spooked by water splashes*
		 
		 /////////////////////////////////////////
		 // Event B *YOUNG TIN HINAN guides the player toward the passage*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event B here.*/
		 
		 bool mbAllowTHPointSeq = false;
		 int mlEndGhostMoveTarget = 0;
		 bool mbSpottedEndTH = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event B here.*/
		 
		 bool OnTrigger_Player_PreloadOasis(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 //Map_Preload("02_06_oasis.hpm");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_DisableDarknessFear(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Player_SetMapDeepShadow(0.f);
			 
			 if (FearHandler_GetLevel() > 0.8f)
				 FearHandler_FadeLevelTo(0.8f, 10.f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_TH_PlayPointAnim(const tString &in asEntity, int alState)
		 {
			 if (SequenceStates_IsActive("Seq_THPoint") || mbAllowTHPointSeq == false) 
				 return;
			 
			 mbSpottedEndTH = true;
			 Seq_THPoint("");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ForceTHPointAnim(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (mbAllowTHPointSeq == false && alState == -1 && Entity_PlayerIsInFront(asParent))
			 {
				 mbAllowTHPointSeq = true;
				 Entity_SetActive("Trigger_PlayTHPointAnim", true);
				 
				 YoungTinHinan_Activate("TH_End", 1.f);
				 ParticleSystem_CreateAtEntity("PS_GhostRipples", "ripples_impact_small.ps", "Area_GhostWaterParticles", false);
				 return true;
			 }
			 
			 if (mbAllowTHPointSeq && alState == 1)
			 {
				 mbSpottedEndTH = false;
				 Entity_SetActive("Trigger_PlayTHPointAnim", false);
				 Seq_THPoint("");
				 return false;
			 }			 
			 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataTHPoint;
		 void Seq_THPoint(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_THPoint", mSeqDataTHPoint);
			 Sequence_Wait(0.25f);
			 if (Sequence_DoStepAndWait(mbSpottedEndTH ? 4.5f : 0.1f))
			 {
				 mbAllowTHPointSeq = false;
				 
				 if (mbSpottedEndTH)
				 {
					 Player_SetCrouching(false);
				
					 Player_FadeRunSpeedMulTo(0.f, 1.f);
					 Player_FadeMoveSpeedMulTo(0.5f, 1.f);
					 Player_FadeLookSpeedMulTo(0.75f, 1.f);
					
					 Voice_PlayDelayed("Dialogue_SeeTinHinanAtExit", 1.f, 1);
					 
					 CharMover_SetUseMoveStateAnimations("TH_End", false);
					 Entity_PlayAnimation("TH_End", "point", 0.3f);
				 
					 FearHandler_SetForcedAddFearRate(0.3f, 8.f, false, -1.f, -1.f, 0.4f);
				 }
				 
				 Entity_SetActive("Trigger_ForceTHPointAnim", false);
				 Entity_SetActive("Trigger_PlayTHPointAnim", false);
			 }
			 else if (Sequence_DoStepAndWait(3.5f))
			 {			 
				 YoungTinHinan_SetFlying("TH_End", true);
				 OnPathEnd_EndGhost("TH_Ghost", true);
				 
				 ParticleSystem_Destroy("PS_GhostRipples");
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				 Light_FadeBrightnessTo("Light_Point_EndTunnel_*", 5.f, 2.f);
				 Light_SetFlickerActive("Light_Point_EndTunnel_*", true);
				 
				 Player_FadeLookSpeedMulTo(1.f, 3.f);
				 Player_FadeMoveSpeedMulTo(1.f, 3.f);
				 Player_FadeRunSpeedMulTo(1.f, 3.f);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnPathEnd_EndGhost(const tString &in asEntityName, bool abReachedEnd)
		 {
			 mlEndGhostMoveTarget++;
			 tString sTarget = "Area_GhostEndTarget_" + mlEndGhostMoveTarget;
	 
			 if (Entity_Exists(sTarget) == false)
			 {
				 YoungTinHinan_Deactivate("TH_End", 1.f);
				 return;
			 }
			 
			 YoungTinHinan_MoveTo("TH_End", sTarget, "OnPathEnd_EndGhost", 2);
		 }
		 		 
		 //-------------------------------------------------------
	 
		 //} END Event B *YOUNG TIN HINAN guides the player toward the passage*
		 
		 /////////////////////////////////////////
		 // Event C *Crawl into the passage*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event C here.*/
		 
		 float mfPrevDistToTunnelStart = 0.f;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event C here.*/	
		 
		 bool OnTrigger_Player_EnterUnderwaterTunnel(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1)
			 {
				 Map_AddTimer("Timer_GivePlayerOxygen", 1.f, "OnTimer_GivePlayerOxygen");
				 Light_FadeBrightnessTo("Light_Point_EndTunnel_1", 0.f, 2.f);
				 Light_FadeBrightnessTo("Light_WaterTunnelEntrance_*", 5.f, 2.f);
			 }
			 else
			 {
				 Light_FadeBrightnessTo("Light_WaterTunnelEntrance_*", 0.f, 1.f);
				 Map_RemoveTimer("Timer_GivePlayerOxygen");
			 }
		 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_GivePlayerOxygen(const tString &in asTimer)
		 {
			 cVector3f vDelta = Entity_GetDeltaToEntity("player", "Area_UnderwaterTunnelStart");
			 float fDist = vDelta.Length();
			 
			 if (Player_GetOxygenCount() < 2.f && fDist < mfPrevDistToTunnelStart ||
				 Player_GetCurrentStateName() == "State_Interact_Tear")
			 {
				 Player_SetOxygenCount(2.f); 
			 }
			 
			 mfPrevDistToTunnelStart = fDist;			 
			 Map_RestartCurrentTimer(0.25f);			 
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *Crawl into the passage*
		 
		 /////////////////////////////////////////
		 // Event D *Remove the PASSAGE RUBBLE*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event D here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event D here.*/	
		 
		 void OnInteract_PassageRubble(const tString &in asEntity)
		 {			 
			 if (Map_TimeHasPassed("Timer_ReducePlayerOxygen", 5.f))
				 Player_SetOxygenCount(8.f);
			 
			 Map_AddTimer("Timer_ForcePassageDebrisCrumble", 2.f, "OnTimer_ForcePassageDebrisCrumble");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ForcePassageDebrisCrumble(const tString &in asTimer)
		 {				
			 cScript_SetGlobalArgInt(0, Map_GetEntity("PassageRubble_1").GetMainBody().GetUniqueID());
			 cScript_SetGlobalArgVector3f(1, Map_GetEntity("PassageRubble_1").GetMainBody().GetWorldPosition());
			 cScript_RunGlobalFunc("PassageRubble_1", "cScrPropTear", "_Global_Tear");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTear_PassageRubble(const tString &in asEntity)
		 {			 
			 OnTimer_PassageDebrisCrumble(asEntity);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PassageDebrisCrumble(const tString &in asTimer)
		 {	
			 Map_RemoveTimer("Timer_GivePlayerOxygen");
			 Map_RemoveTimer("Timer_ForcePassageDebrisCrumble");
			 
			 Sketchbook_CompleteIdea("exit_cistern");
			 
			 Effect_Shake_Start(0.015f, 0.3f, 0.1f, 0.5f);
			 //ParticleSystem_CreateAtEntity("PS_DebrisSplash", "splash_medium_oneshot.ps", "Area_FlushLookAt", false);
			 Sound_Play("Sound_DebrisMove", 1.0f);
			 
			 Player_SetOxygenCount(15.f);
			 Player_ChangeStateToNormal();
			 Player_FadeLookSpeedMulTo(0.1f, 0.1f);
			 Player_FadeMoveSpeedMulTo(0.1f, 0.5f);
			 Player_StartLookAt("Area_FlushLookAt", 1.f, 1.f, 1.f);
			 		 
			 Map_RemoveTimer("Timer_PassageDebrisCrumble");			 
			 
			 array<iLuxEntity@> vOut;
			 Map_GetEntityArray("TunnelDebris_*", vOut, eLuxEntityType_Prop);
			 
			 for (int i = 0; i < vOut.size(); ++i)
			 {
				 Prop_SetStaticPhysics(vOut[i].GetName(), false);
				 
				 iPhysicsBody@ pBody = vOut[i].GetMainBody();
				 if (pBody is null)
					 continue;
					
				 pBody.SetUseSurfaceEffects(false);
			 }

			 // TEMP! Just so the debris doesn't clip through the head. Will be fixed when we have an animation for the clog
			 Entity_SetActive("HeadBlocker", true);
			 Entity_SetCollideCharacter("HeadBlocker", false);
			 Entity_AttachToSocket("HeadBlocker", PlayerBody_GetEntityName(), "CameraSocket", true);
			 
			 Sound_CreateAtEntity("Sound_FlushPipe", "02_05_cistern/animations/cistern_flood_exit", "player");
			 ParticleSystem_CreateAtEntity("PS_Flushed", "crawl_chase_bubbles.ps", "HeadBlocker", true);
			 
			 Seq_Flushed("");	 			 
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event D *Remove the PASSAGE RUBBLE*
		 
		 /////////////////////////////////////////
		 // Event E *Get flushed out of the Cistern*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event E here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event E here.*/	
		 
		 cSequenceStatesData mSeqDataFlushed;
		 void Seq_Flushed(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_Flushed", mSeqDataFlushed);
			 Sequence_Wait(0.75f);
			 if (Sequence_DoStepAndWait(7.f))
			 {
				 Player_StopLookAt(0.25f);
				 Player_SetCrouching(true, true, true);
				 PlayerBody_PlayCutsceneAtEntity("flushed_to_oasis", "Area_FlushAnim", false, 1.5f, "OnAnimEnd_Flushed", 0.8f, 0.f, 0.f, 0.f, true, true);
				 PlayerBody_SetCutsceneMaxPitch(0.f);
				 PlayerBody_SetCutsceneMaxYaw(0.f);
			 }
			 else if (Sequence_DoStepAndWait(2.f))
			 {
				 //if (cLux_ScriptDebugOn() == false)
				 {
					 Effect_Fade_Out(0.5f);
					 Sound_FadeGlobalVolume(0.f, 1.f, eSoundEntryType_WorldAll);
				 }
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 PlayerBody_StopAnimation("flushed_to_oasis", 0.f);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Player_SetOxygenCount(15.f);

				 //if (cLux_ScriptDebugOn() == false)
					 Map_ChangeMap("02_06_oasis.hpm", "", "", "");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_Flushed(const tString &in asAnim)
		 {
			 Player_SetActive(false);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event E *Get flushed out of the Cistern*
		 
		 /////////////////////////////////////////
		 // Event F *Wake up by the underwater passage (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 8, Event F here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 8, Event F here.*/	
		 
		 bool OnPermaFail_Passage(const tString &in asSource)
		 {
			 SetupGenericPermaFail();
			 FearHandler_SetPermaFailRespawnArea("PermaFail_Passage");
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event F *Wake up by the underwater passage (PERMAFAIL)*
	 
	 //} END SCENE 8 *THE PLAYER FOLLOWS YOUNG TIN HINAN INTO AN UNDERWATER PASSAGE AND GETS FLUSHED OUT OF THE CISTERN*
}