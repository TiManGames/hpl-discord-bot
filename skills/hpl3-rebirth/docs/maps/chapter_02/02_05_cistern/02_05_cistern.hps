		 //} END Event D *Turn the VERTICAL WATER TANK WHEEL*
		 
		 /////////////////////////////////////////
		 // Event E *Release the CORPSE CHAIN*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event E here.*/
		 
		 bool mbPuzzleRegulatorUnjammed = false;
		 tID m_idCorpseChainTarget = tID_Invalid;
		 array<tID> mvCorpseChainBodyIds;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event E here.*/
		 
		 void UpdateChainCorpse(float afTimeStep)
		 {
			 if (mbPuzzleRegulatorUnjammed)
				 return;
			 
			 //////////////////
			 // Setup IDs
			 if (m_idCorpseChainTarget == tID_Invalid)
				 m_idCorpseChainTarget = Map_GetEntity("Area_ChainCorpseAttach", eLuxEntityType_Area).GetID();
				 
			 if (mvCorpseChainBodyIds.size() == 0)
			 {
				 for (int i = 16; i < 19; ++i)
					mvCorpseChainBodyIds.push_back(Map_GetEntity("ChainCorpse").GetBodyFromName("Body_" + i).GetID());
			 }
			 
			 //////////////////
			 // Get delta
			 iLuxEntity@ pChainTarget = cLux_ID_Entity(m_idCorpseChainTarget);
			 iPhysicsBody@ pChainBody = cLux_ID_Body(mvCorpseChainBodyIds[mvCorpseChainBodyIds.size() - 1]);
			 cVector3f vDelta = (pChainTarget.GetPosition() - pChainBody.GetLocalPosition());
			 
			 //////////////////
			 // Move bodies
			 if (vDelta.SqrLength() > 0.f)
			 {
				 for (int i = 0; i < mvCorpseChainBodyIds.size(); ++i)
					 cLux_ID_Body(mvCorpseChainBodyIds[i]).StaticLinearMove(vDelta / afTimeStep);
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_ChainCorpse(const tString &in asEntity, int alState)
		 {
			 if (alState == -1 || Entity_PlayerIsInFront("Area_ChainCorpse") == false)
				 return;
			 
			 //Voice_Play("Dialogue_CorpseInPipe");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTear_ChainPipe(const tString &in asProp)
		 {
			 mbPuzzleRegulatorUnjammed = true;
			 
			 //////////////////////////////
			 // Break the pipe!
			 Entity_SetActive("ChainPipe", false);			 
			 Entity_SetActive("InteractAux_ChainPipe", false);
			 Entity_SetCollide("BlockBox_Regulator_6", false);
			 
			 Entity_SetActive("ChainPipe_Broken", true);
			 Entity_SetCollide("ChainPipe_Broken", false);
			 Entity_PlaceAtEntity("ChainPipe_Broken", "ChainPipe", Map_GetEntity("ChainPipe").GetMatrix().GetTranspose().GetUp() * 0.6f, true);
			 
			 Body_AddImpulse("ChainPipe_Broken_Body_1", cVector3f(0.7f, 0.f, 0.2f), false);
			 Body_AddImpulse("ChainPipe_Broken_Body_2", cVector3f(1.f, 0.f, 0.4f), false);
			 Map_GetEntity("ChainPipe_Broken").GetBodyFromName("Body_1").AddTorque(cVector3f(-6.f, 0.f, 0.f));
			 
			 Map_AddTimer("Timer_SetBrokenPipeCollide", 0.15f, "OnTimer_SetBrokenPipeCollide");
			 Map_AddTimer("Timer_SetRegulatorHandleCollide", 1.f, "OnTimer_SetRegulatorHandleCollide");
			 
			 Map_GetEntity("FlowRegulator_Middle_1").GetBodyFromName("Body_2").SetCollideFlags(mBaseObj.GetCollideFlag("-pipe"));
			 ParticleSystem_CreateAtEntity("PS_Sparks", "sparks_tiny.ps", asProp, false);
			 
			 Sound_CreateAtEntity("Sound_Tear" + asProp, "level_entity_shared/breakables/relic_room_bars/relic_bars_break", asProp);
			 
			 //////////////////////////////
			 // Chain is loose!
			 for (int i = 0; i < mvCorpseChainBodyIds.size(); ++i)
				 cLux_ID_Body(mvCorpseChainBodyIds[i]).SetMass(3.f);
			 
			 Map_GetEntity("ChainCorpse").GetBodyFromName("Body_15").AddImpulse(cVector3f(-5.f, 10.f, 0.f));
			 
			 //////////////////////////////
			 // Open flow regulator!
			 cLux_ToProp(Map_GetEntity("FlowPipeWheel_Middle")).RemoveInteractConnection("FlowRegulator_Middle_1");
			 
			 PhysicsSlideDoor_SetJammed("FlowRegulator_Middle_1", false);			 
			 PhysicsSlideDoor_SetMaxOpenAmount("FlowRegulator_Middle_1", 1.f);
			 PhysicsSlideDoor_AutoMoveToState("FlowRegulator_Middle_1", 1.f);
			 Entity_SetInteractionDisabled("FlowRegulator_Middle_1", true);
			 Entity_SetCollideCharacter("FlowRegulator_Middle_1", false);
			 
			 Wheel_SetAngle("FlowPipeWheel_Middle", cMath_ToRad(90.f), true);
			 
			 Map_AddTimer("Timer_ReconnectStuckFlowRegulator", 3.f, "OnTimer_ReconnectStuckFlowRegulator");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetBrokenPipeCollide(const tString &in asTimer)
		 {
			 Entity_SetCollide("ChainPipe_Broken", true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetRegulatorHandleCollide(const tString &in asTimer)
		 {
			 Entity_SetCollide("BlockBox_Regulator_6", true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ReconnectStuckFlowRegulator(const tString &in asTimer)
		 {
			 cLux_ToProp(Map_GetEntity("FlowPipeWheel_Middle")).AddInteractConnection("FlowRegulator_Middle_1", cLux_ToProp(Map_GetEntity("FlowRegulator_Middle_1")), false);
			 Entity_SetInteractionDisabled("FlowRegulator_Middle_1", false);
			 Entity_SetCollideCharacter("FlowRegulator_Middle_1", true);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event E *Release the CORPSE CHAIN*
		 
		 /////////////////////////////////////////
		 // Event F *Hear movement around you*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event F here.*/
	 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_GhoulSoundStart(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Sound_Play("Sound_GhoulTunnelSweet", 1.0f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event F here.*/
		 
		 bool OnTrigger_Player_PlayTunnelScare(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Sound_Stop("Sound_GhoulTunnelSweet", 0.5f);
			 Sound_Play("Sound_GhoulScare_1", 1.0f);
			 
			 ParticleSystem_CreateAtEntity("PS_TunnelNoise", "dust_impact_simple_oneshot.ps", "Area_TunnelScare", false).SetBrightness(0.6f);
			 FearHandler_SetForcedAddFearRate(0.3f, 4.f, true, -1.f, 0.1f, 0.1f);
			 
			 Map_GetEntity("Ghoul_TunnelScare").GetMeshEntity().GetAnimationStateFromName("crawl").SetSpeed(1.f);
			 Prop_MoveLinearTo("Ghoul_TunnelScare", "Area_TunnelScareCrawlTarget", 3.f, 3.f, 0.f, false, "OnMoveLinear_TunnelScareGhoul");
			 
			 Map_AddTimer("Timer_TunnelScare", 60.f, "");
			 
			 ////////////////////////
			 // Disable TH
			 if (SequenceStates_IsActive("Seq_PuzzleTHSighting") == false)
			 {
				 Entity_SetActive("TH_Puzzle", false);
				 Entity_SetActive("Trigger_SpotPuzzleTH", false);
			 }
			 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnMoveLinear_TunnelScareGhoul(const tString &in asProp)
		 {
			 Entity_SetActive("Ghoul_TunnelScare", false);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_PlayTunnelNoise(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Map_TimerExists("Timer_TunnelScare")) 
				 return true;
			 
			 Entity_SetActive("Trigger_PlayTunnelNoise_*", false);
			 
			 int lId = cString_GetNumericSuffixInt(asParent);
			 Sound_CreateAtEntity("Sound_TunnelScareBuildUp", "02_05_cistern/tunnel_ghoul/cistern_tunnel_sweet", "Area_TunnelNoise_" + lId, 0.f, false, 1.f, 1.f, 15.f);
			 
			 Map_AddTimer("Timer_PlayTunnelNoise_" + lId, 2.f, "OnTimer_PlayTunnelNoise");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayTunnelNoise(const tString &in asTimer)
		 {
			 Sound_Stop("Sound_TunnelScareBuildUp", 0.5f);
			 
			 int lId = cString_GetNumericSuffixInt(asTimer);			 
			 Sound_CreateAtEntity("Sound_TunnelScare", "creatures/foley/creature/ghoul/ghoul_hole/ghoul_enter_hole_above", "Area_TunnelNoise_" + lId);
			 
			 FearHandler_SetForcedAddFearRate(0.3f, 4.f, true, -1.f, 0.1f, 0.1f);
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event F *Hear movement around you*
		 
		 /////////////////////////////////////////
		 // Event G *The WATER TANK falls*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event G here.*/
		 
		 int mlJumpedFromWaterTankTimeStamp = 0;
		 bool mbTakeOutItemAfterFall = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event G here.*/
		 		 
		 void DoWaterTankFallSequence()
		 {		 
			 if (mbWaterTankFallen || mbWaterTankStuck == false) 
				 return;
				
			 Map_AddTimer("Timer_DoWaterTankFallSequence", 0.2f, "OnTimer_DoWaterTankFallSequence");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoWaterTankFallSequence(const tString &in asTimer)
		 {
			 tString sArea = "Trigger_WaterTankFall";
			 
			 cVector3f vVel = Player_GetVelocity();
			 cVector3f vVelXZ = cMath_Vector3Normalize(cVector3f(vVel.x, 0.f, vVel.z));
			 float fDot = cMath_Vector3Dot(vVelXZ, Map_GetEntity(sArea).GetMatrix().GetTranspose().GetForward());
			 
			 if (vVel.Length() > 1.f && fDot > 0.8f && Entity_GetCollide("player", sArea))
			 {
				 mbWaterTankFallen = true;
				 mlJumpedFromWaterTankTimeStamp = mBaseObj.GetTimeStamp();
				 Map_AddTimer("Timer_StartWaterTankFallSequence", 0.1f, "OnTimer_StartWaterTankFallSequence");
				 Sound_CreateAtEntity("Sound_WaterTankFall", "02_05_cistern/water_bucket/bucket_drop", "WaterTank");
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StartWaterTankFallSequence(const tString &in asTimer)
		 {
			 if (cLux_GetPlayer().GetCharacterBody().IsOnGround() == false && 
				 mBaseObj.GetElapsedTime(mlJumpedFromWaterTankTimeStamp) < 0.1f)
			 {
				 Map_RestartCurrentTimer();
				 return;
			 }
			 
			 Seq_WaterTankFall("");
			 cLux_GetPlayer().GetCharacterBody().SetTestCollision(false);
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataWaterTankFall;
		 void Seq_WaterTankFall(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_WaterTankFall", mSeqDataWaterTankFall);
			 if (Sequence_DoStepAndWait(0.25f))
			 {
				 Entity_SetActive("Trigger_WaterTankFall", false);
				 Map_RemoveTimer("Timer_CheckJumpedFromBucket");
				 
				 if (Item_IsHeld(eItemHandlerHand_Left))
					 mbTakeOutItemAfterFall = true;
					 
				 Item_PutAway(eItemHandlerHand_Left);
				 PlayerBody_PlayCutsceneAtEntity("player_land_on_beam_bucket_fall", "Area_BucketFallAnim", false, 0.5f, "OnAnimEnd_BucketFall");
				 
				 Wheel_SetAngle("WaterTankWheel_Vertical", 720.f, true);
				 Prop_SetStaticPhysics("BucketChain_2", true);
				 Entity_SetCollideCharacter("BucketChain_2", true);
			 }
			 else if (Sequence_DoStepAndWait(0.75f))
			 {
				 cLux_GetPlayer().GetCharacterBody().SetTestCollision(true);
				 
				 Entity_SetActive("FlowPipe_Middle_2", false);
				 Entity_SetActive("FlowPipe_Broken", true);
				 
				 Wheel_StopAutoMove("WaterTankWheel_Vertical");				 
				 
				 iPhysicsRope@ pRope = mBaseObj.GetPhysicsWorld().GetRopeFromUniqueID(mlRopeId);
				 pRope.SetAttachedEndBody(null);
				 
				 iLuxEntity@ pChainPart = cLux_ID_Entity(mvChainPartIds[1]);
				 for (int i = 0; i < pChainPart.GetBodyNum(); ++i)
				 {
					 iPhysicsBody@ pChainPartBody = pChainPart.GetBody(i);	
					 cVerletParticle@ pParticle = pRope.GetParticle(i + 13);
					 
					 pParticle.SetPosition(pChainPartBody.GetWorldPosition(), true);
				}
				 
				 pRope.GetEndParticle().SetInvMass(1.f);
				 pRope.GetEndParticle().AddForce(cVector3f(-1000.f, 0.f, 0.f));
				  				  
				 mbWaterTankStuck = false;
				 Entity_SetActive("WaterTank_Weight", false);
				  
				 Entity_SetActive("Trigger_StopFlowPipe_*", false);
				 Entity_SetActive("Trigger_StopWaterTank_*", false);
				 
				 Entity_SetCollide("WaterTank", false);
				 Entity_RemoveEntityAttachment("WaterTank");
				 Entity_RemoveEntityAttachment("WaterTankChain_Bottom");
				 Entity_AttachToEntity("WaterTankChain_Bottom", "WaterTank", "Body_1", true, false, true);
				 Prop_SetStaticPhysics("WaterTank", false);
				 
				 Map_GetEntity("WaterTank").GetBody(0).AddTorque(cVector3f(22000.f, 5000.f, 0.f));
				 Body_AddImpulse("WaterTank_Body_1", cVector3f(-1.5f, 0.f, -1.f), false);
				 
				 FearHandler_SetForcedAddFearRate(0.3f, 4.f, false, -1.f, 0.1f);			 
				 Voice_PlayDelayed("Dialogue_BucketFall", 0.25f);
			 }
			 else if (Sequence_DoStepAndWait(0.25f))
			 {
				 iPhysicsRope@ pRope = mBaseObj.GetPhysicsWorld().GetRopeFromUniqueID(mlRopeId);
				 pRope.GetEndParticle().AddForce(cVector3f(0.f, 0.f, -2000.f));
				 
				 ParticleSystem_CreateAtEntity("PS_TankDust", "dust_impact_med_oneshot.ps", "WaterTankChain_Bottom", false).SetBrightness(0.05f);
				 ParticleSystem_CreateAtEntity("PS_TankSparks", "sparks_small.ps", "WaterTankChain_Bottom", false);
				 

			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {				 
				 Entity_SetCollide("WaterTank", true);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_BucketFall(const tString &in asAnim)
		 {
			 Game_AutoSave();
			 
			 if (mbTakeOutItemAfterFall)
				 Item_TakeOutLast(eItemHandlerHand_Left);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_PositionWaterTank(const tString &in asParent, const tString &in asChild, int alState)
		 {
			cVector3f vPos = Map_GetEntity("WaterTank").GetPosition();
			vPos.y = -42.f; // Water level
			
			cParticleSystem@ pPS_1 = mBaseObj.GetWorld().CreateParticleSystem("PS_WaterTankSplash_1", "waterbucket_water_splash.ps", cVector3f(1.5f), true, false);
			pPS_1.SetFadeAtDistance(false);
			pPS_1.SetWorldPosition(cVector3f(vPos.x - 1.f, vPos.y, vPos.z));
			
			cParticleSystem@ pPS_2 = mBaseObj.GetWorld().CreateParticleSystem("PS_WaterTankSplash_2", "waterbucket_water_splash.ps", cVector3f(1.5f), true, false);
			pPS_2.SetFadeAtDistance(false);
			pPS_2.SetWorldPosition(cVector3f(vPos.x + 1.f, vPos.y, vPos.z));
			
			cParticleSystem@ pPS_3 = mBaseObj.GetWorld().CreateParticleSystem("PS_WaterTankSplash_3", "waterbucket_water_splash.ps", cVector3f(1.5f), true, false);
			pPS_3.SetFadeAtDistance(false);
			pPS_3.SetWorldPosition(cVector3f(vPos.x, vPos.y, vPos.z - 1.f));
			
			cParticleSystem@ pPS_4 = mBaseObj.GetWorld().CreateParticleSystem("PS_WaterTankSplash_4", "waterbucket_water_splash.ps", cVector3f(1.5f), true, false);
			pPS_4.SetFadeAtDistance(false);
			pPS_4.SetWorldPosition(cVector3f(vPos.x, vPos.y, vPos.z + 1.f));
			 
			 Map_GetEntity("WaterTank").GetBody(0).SetLinearDamping(1.f);
			 Map_GetEntity("WaterTank").GetBody(0).SetAngularDamping(1.f);
			 
			 Map_AddTimer("Timer_PositionWaterTank", 7.f, "OnTimer_PositionWaterTank");
			 Sound_CreateAtEntity("Sound_WaterTankLand", "02_05_cistern/water_bucket/bucket_land", "WaterTank");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PositionWaterTank(const tString &in asTimer)
		 {
			 Prop_SetStaticPhysics("WaterTank", true);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event G *The WATER TANK falls*
		 
		 /////////////////////////////////////////
		 // Event H *Wake up in different locations (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event H here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event H here.*/
		 
		 bool OnPermaFail_FallMiddle(const tString &in asSource)
		 {			 
			 SetupGenericPermaFail();
			 
			 tString sArea = "PermaFail_FallMiddle_" + cMath_RandRectl(1, 2);
			 if (mbWaterTankFallen)
				 sArea = "PermaFail_FallMiddle_" + cMath_RandRectl(4, 5);
			 else if (mbPuzzleRegulatorUnjammed && Wheel_GetRotationAmount("FlowPipeWheel_Middle") > 0.75f)
				 sArea = "PermaFail_FallMiddle_" + cMath_RandRectl(1, 3);
				 
			 FearHandler_SetPermaFailRespawnArea(sArea);
			 
			 Entity_SetActive("TH_Puzzle", false);
			 Entity_SetActive("Trigger_SpotPuzzleTH", false);
			 return true;
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event H *Wake up in different locations (PERMAFAIL)*
	 
	 //} END SCENE 5 *THE PLAYER SOLVES A PUZZLE TO PASS OVER THE CISTERN AGAIN*
	 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 6 *THE PLAYER AVOIDS A SNIFFING GHOUL*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 6 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 6 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Disturb the FRENCH SOLDIER*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event A here.*/
		 
		 int mlTreasureTroveHitCount = 0;
		 int mlPlayerTreasureTroveFloor = 2;
		 bool mbHuntPlayer = false;
		 bool mbSniffingGhoulEmerged = false;
		 bool mbSmellDialogueTriggered = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event A here.*/
		 
		 bool OnTrigger_Player_StartRandomTunnelSounds(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mbUpdateWaterTank = false;
			 SetTunnelScareSoundsActive(true, 5.f);
			 return false; 
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayRandomTunnelScareSound(const tString &in asTimer)
		 {			 
			 bool bPlayedSound = false;
			 tString sAreaBase = mlPlayerTreasureTroveFloor == 2 ? "Area_TunnelScareSound_Top_" : "Area_TunnelScareSound_Bottom_";
			 
			 for (int i = 1; i < 8; ++i)
             {            
				 tString sArea = sAreaBase + i;
                 if (Map_TimerExists(sArea + "_RecentlyUsed")) 
					 continue;
                
                 float fSqrLength = Entity_GetDeltaToEntity(sArea, "player").SqrLength();
                 if (fSqrLength > 18.f * 18.f || fSqrLength < 3.f * 3.f || Entity_IsInPlayerFOV(sArea))
					 continue;
                 
				 bPlayedSound = true;
				 
				 tString sSound = cMath_RandRectl(0, 2) == 2  ? "creatures/foley/creature/ghoul/ghoul_hole/ghoul_wall_sound_sweet" : 
															    "03_06_ghouls_nest/collapsed_tunnel_sweet/ghoul_tunnel_rock";
				
				 Sound_CreateAtEntity("Sound_RandomTunnelScare", sSound, sArea, 0.f, false, 0.5f, 1.f, 20.f);				 
                 Map_AddTimer(sArea + "_RecentlyUsed", 60.f, "");
				
				 FearHandler_SetForcedAddFearRate(0.1f, 5.f, false, -1.f, -1.f);
				 break;
             }
			 
			 float fTime = bPlayedSound ? cMath_RandRectf(10.f, 25.f) : cMath_RandRectf(3.f, 6.f);
			 Map_AddTimer("Timer_PlayRandomTunnelScareSound", fTime, "OnTimer_PlayRandomTunnelScareSound");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_PlayTunnelScareSound(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Trigger_PlayTunnelScareSound_*", false);
			 Map_AddTimer(asParent, 0.25f, "OnTimer_PlayTunnelScare");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayTunnelScare(const tString &in asTimer)
		 {
			 tString sArea = "Area_TunnelScareSound_Top_" + cString_GetNumericSuffixInt(asTimer);
			 Sound_CreateAtEntity("Sound_TunnelScare", "creatures/foley/creature/ghoul/ghoul_tunnel_crawl", sArea);
			 ParticleSystem_CreateAtEntity("PS_TunnelScare", "dust_impact_small_oneshot.ps", sArea, false).SetBrightness(0.4f);
			 
			 FearHandler_SetForcedAddFearRate(0.3f, 5.f, false, -1.f, 0.04f, 0.5f);
			 
			 SetTunnelScareSoundsActive(true, 8.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetTunnelScareSoundsActive(bool abX, float afTime = 8.f)
		 {
			 Map_RemoveTimer("Timer_PlayRandomTunnelScareSound");
			 
			 if (abX)
				 Map_AddTimer("Timer_PlayRandomTunnelScareSound", afTime, "OnTimer_PlayRandomTunnelScareSound");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_OpenBoneChest(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 int lId = cString_GetNumericSuffixInt(asParent);
			 
			 int lBonesToDeactivate = lId == 1 ? 2 : 1;
			 Entity_SetActive("ChestBones_" + lBonesToDeactivate + "_*", false);
			 Entity_SetActive("Trigger_OpenBoneChest_*", false);
			 
			 SwingDoor_PushOpen(asChild, 2.f, 2);
			 
			 Prop_SetStaticPhysics("ChestBones_*", false);
			 
			 float fImpulse = lId == 1 ? -1.f : -2.f;
			 Body_AddImpulse("ChestBones_" + lId + "_1_Body_1", cVector3f(0.f, 0.f, fImpulse), false);
			 Body_AddImpulse("ChestBones_" + lId + "_2_Body_1", cVector3f(0.f, 0.f, fImpulse), false);
			 Body_AddImpulse("ChestBones_" + lId + "_3_Body_1", cVector3f(0.f, 0.f, fImpulse), false);
			 Body_AddImpulse("ChestBones_" + lId + "_4_Body_1", cVector3f(0.f, 0.f, fImpulse), false);
			 Body_AddImpulse("ChestBones_" + lId + "_5_Body_1", cVector3f(0.f, 0.f, fImpulse), false);
			 Body_AddImpulse("ChestBones_" + lId + "_6_Body_1", cVector3f(0.f, 0.f, fImpulse), false);
			 
			 FearHandler_SetForcedAddFearRate(0.4f, 5.f, true, -1.f);
			 Effect_DollyZoom_Start(-0.15f, 0.3f, 0.85f, 2.f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_StartSeqSniffingGhoulEmerge(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 SniffingGhoulEmerge();
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_StartSniffingGhoulEmerge(const tString &in asEntity, int alState)
		 {
			 SniffingGhoulEmerge();
		 }
		 
		 //-------------------------------------------------------
		 
		 void SniffingGhoulEmerge()
		 {
			 if (mbSniffingGhoulEmerged)
				 return;
				
			 mbSniffingGhoulEmerged = true;			
		 	 Seq_SniffingGhoulEmerge("");
		 }
		
		 //-------------------------------------------------------
		
		 cSequenceStatesData mSeqDataSniffingGhoulEmerge;
		 void Seq_SniffingGhoulEmerge(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_SniffingGhoulEmerge", mSeqDataSniffingGhoulEmerge);
			 if (Sequence_DoStepAndWait(0.25f))
			 {
				 SlideDoor_SetClosed("portcullis_3", true);
				 
				 Blackboard_SetOverlookedAchievementDetectionActive(true);
				 SetTunnelScareSoundsActive(false);
				 
				 Light_SetBrightness("Light_Spot_TreasureTroveGrating", 1.5f);
				 
				 Sound_CreateAtEntity("Sound_SniffingGhoulEntrance", "02_05_cistern/soldier/ghoul_emerge", "Ghoul_Sniffing");
				 Music_Play("A2_2_5_Ghoul_Emerge_01.ogg", 0.6f, false, eMusicPrio_BigEvent);
				 Map_AddTimer("Timer_GhoulTreasureMusic", 6.0f, "OnTimer_PlayGhoultreasureMusic");
			 }
			 else if (Sequence_DoStepAndWait(0.25f))
			 {
				 Entity_SetActive("GhoulEmergeBone_2", true);
				 Body_AddImpulse("GhoulEmergeBone_2_Body_1", cVector3f(2.f, 0.5f, 0.f), false);
				 ParticleSystem_CreateAtEntity("PS_EmergeDust", "dust_impact_small_oneshot.ps", "Area_SniffingGhoulEmerge", false).SetBrightness(0.5f);
				 
				 // So the ghoul won't care about the bones falling out
				 Map_AddTimer("Timer_NoDebrisNoise", 5.f, "");
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {		
				 Entity_SetActive("Trigger_SpotPuzzleTH", false);
				 
				 mlPermaFailStage = eCisternPermaFailStage_NastyTunnel;
		 
				 //////////////////
				 // Ghoul drop down
				 Entity_SetActive("Ghoul_Sniffing", true);
				 cLux_ToAgent(Map_GetEntity("Ghoul_Sniffing")).GetCharBody().SetTestCollision(false);
				 
				 CharMover_SetUseMoveStateAnimations("Ghoul_Sniffing", false);
				 Entity_PlayAnimation("Ghoul_Sniffing", "crouch_idle_ledge_tr_fall", 0.f, false, true);
				 
				 Agent_SetSensesActive("Ghoul_Sniffing", false);
				 Ghoul_SetSmellingActive("Ghoul_Sniffing", false);
			 }
			 else if (Sequence_DoStepAndWait(0.5f))
			 {
				 Entity_SetActive("GhoulEmergeBone_1", true);
				 Entity_SetCollideCharacter("GhoulEmergeBone_1", false);
				 Body_AddImpulse("GhoulEmergeBone_1_Body_1", cVector3f(1.5f, 0.25f, 0.f), false);				 
			 }
			 else if (Sequence_DoStepAndWait(0.2f))
			 {
				 cLux_ToAgent(Map_GetEntity("Ghoul_Sniffing")).GetCharBody().SetFeetPosition(cVector3f(16.033f, -29.564f, 47.708f), true);
				 cLux_ToAgent(Map_GetEntity("Ghoul_Sniffing")).GetCharBody().SetTestCollision(true);
				 Entity_PlayAnimation("Ghoul_Sniffing", "fall_controlled", 0.f, false, false);
				 
				 Entity_SetCollideCharacter("GhoulEmergeBone_*", true);
			 }
			 else if (Sequence_DoStepAndWait(1.1f))
			 {
				 Entity_PlayAnimation("Ghoul_Sniffing", "fall_controlled_land", 0.f, false, true);
			 }
			 else if (Sequence_DoStepAndWait(0.6f))
			 {				 
				 //////////////////
				 // Ghoul landed
				 Agent_SetSensesActive("Ghoul_Sniffing", true);
				 CharMover_SetUseMoveStateAnimations("Ghoul_Sniffing", true);
				 
				 //////////////////////
				 // Setup patrol
				 Ghoul_ModePatrol_ClearNodes("Ghoul_Sniffing");
				 Ghoul_ModePatrol_Setup("Ghoul_Sniffing", true, eGhoulSpeed_Walk);
				 Ghoul_ModePatrol_AddNode("Ghoul_Sniffing", "PathNode_58", 1.f, 3.f);
				 Ghoul_ModePatrol_AddNode("Ghoul_Sniffing", "PathNode_89", 1.f, 3.f);
				 Ghoul_ModePatrol_AddNode("Ghoul_Sniffing", "PathNode_64", 1.f, 3.f);
				 Ghoul_ModePatrol_AddNode("Ghoul_Sniffing", "PathNode_61", 1.f, 3.f);
				 Ghoul_Mode_Set("Ghoul_Sniffing", eGhoulMode_Patrol, false);			 			 
				 
				 Map_AddTimer("Timer_SniffingGhoulLeave", 60.f, "OnTimer_SniffingGhoulLeave");
			 }
			 else if (Sequence_DoStepAndContinue())
			 {				
				 Map_AddTimer("Timer_CheckShouldShowSneakHint", 5.f, "OnTimer_CheckShouldShowSneakHint");
 
				 // Did player just run past?
				 if (mbHuntPlayer)
				 {
					 SequenceStates_Stop("Seq_SniffingGhoulEmerge");
					 Agent_RevealPlayerPosition("Ghoul_Sniffing");
					 Ghoul_SetSmellingActive("Ghoul_Sniffing", true);
					 OnTimer_SetupBottomFloor("");
					 return;
				 }
				 
				 Map_AddTimer("Timer_SetSmellingActive", 30.f, "OnTimer_SetSmellingActive");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayGhoultreasureMusic(const tString &in asTimer)
		 {
			Music_Stop(4.0f, eMusicPrio_BigEvent);
			Music_PlayExt("A2_2_5_Cistern_Sneak_02.ogg", true, 0.09f, 1.0f, 2.0f, 1.0f, eMusicPrio_AgentToAlertTransition, true);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_GhoulSmell(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive(asParent, false);			 
			 Ghoul_SetSmellingActive("Ghoul_Sniffing", true);
			 
			 if (Ghoul_IsAggressive("Ghoul_Sniffing") || 
				 Agent_PlayerDetected("Ghoul_Sniffing") || 
				 Ghoul_IsSuspicious("Ghoul_Sniffing")) 
				 return false;
			 
			 Ghoul_CommandSmell_Execute("Ghoul_Sniffing", true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnGhoulSmell(const tString &in asGhoul)
		 {
			 if (mbSmellDialogueTriggered)
				 return;
			 
			 mbSmellDialogueTriggered = true;
			 Map_AddTimer("Timer_PlaySmellDialogue", 4.f, "OnTimer_PlaySmellDialogue");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlaySmellDialogue(const tString &in asTimer)
		 {
			 if (mlPlayerTreasureTroveFloor == 2)
				 Voice_PlayWhenPossible("Dialogue_SniffTutorial", "VoiceCondition_Smell", 5.f, 0.5f);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool VoiceCondition_Smell(const tString &in asSubject)
		 {
			 return Ghoul_IsAggressive("Ghoul_Sniffing") == false && Agent_PlayerDetected("Ghoul_Sniffing") == false;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Disturb the FRENCH SOLDIER*
		 
		 /////////////////////////////////////////
		 // Event B *Sneak past the SNIFFING GHOUL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event B here.*/
		 
		 float mfShowSneakHintCount = 0.f;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event B here.*/
		 
		 void OnTimer_CheckShouldShowSneakHint(const tString &in asTimer)
		 {
			 if (cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal && 
				 Entity_IsActive("Ghoul_Sniffing") &&
				  (Player_GetRunning() || (Player_GetCrouching() == false && Player_GetSpeed() > 0.f)))
			 {
				 mfShowSneakHintCount += 0.5f;
			 }
			 
			 if (mfShowSneakHintCount >= 7.5f && cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Normal)
			 {
				 if (Ghoul_IsAggressive("Ghoul_Sniffing") == false && Ghoul_IsAggressive("Ghoul_Sniffing") == false)
				 {
					 Hint_RemoveFromGiven("Hints", "HintSneak");
					 Hint_ShowHint("Hints", "HintSneak", true, 1.5f, true);
				 }				 
				 return;
			 }
			 
			 Map_AddTimer("Timer_CheckShouldShowSneakHint", 0.5f, "OnTimer_CheckShouldShowSneakHint");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SniffingGhoulLeave(const tString &in asTimer)
		 {		
			 tString sHoles = mlPlayerTreasureTroveFloor == 2 ? "Hole_TreasureTrove_Top_*" : "Hole_TreasureTrove_Bottom_*";
			 Ghoul_SetHoleNetwork("Ghoul_Sniffing", sHoles, "", "");
			 
			 Ghoul_CommandGoToHole_Execute("Ghoul_Sniffing", Map_GetEntity("Ghoul_Sniffing").GetPosition(), false, 
										   false, true, true, eGhoulSpeed_FastWalk, -1.f, -1.f, false, false, "OnEnterHole_SniffingGhoul");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnEnterHole_SniffingGhoul(const tString &in asEntity)
		 {
			  Ghoul_SetHoleNetwork("Ghoul_Sniffing", "", "", "");
			  SetTunnelScareSoundsActive(true, 3.f);
			  
			  if (mlPlayerTreasureTroveFloor == 2)
				  Map_AddTimer("Timer_DoTopFloorHoleCrawl", 4.f, "OnTimer_DoTopFloorHoleCrawl");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoTopFloorHoleCrawl(const tString &in asTimer)
		 {
			 float fTime = 6.f;
			 
			 Area_PlaceAtEntity("Area_SniffingGhoulCrawlSound", "Area_TopFloorHoleCrawl_1");
			 float fDist = Entity_GetDeltaToEntity("Area_SniffingGhoulCrawlSound", "Area_TopFloorHoleCrawl_2").Length();
			 Area_MoveLinearTo("Area_SniffingGhoulCrawlSound", "Area_TopFloorHoleCrawl_2", 100.f, fDist / fTime, 0.f, false, "");
			 Sound_CreateAtEntity("Sound_SniffingGhoulCrawl", "creatures/foley/creature/ghoul/ghoul_hole/inside_wall_loop", "Area_SniffingGhoulCrawlSound");
			 
			 Map_AddTimer("Timer_StopTopFloorHoleCrawl", fTime, "OnTimer_StopTopFloorHoleCrawl");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StopTopFloorHoleCrawl(const tString &in asTimer)
		 {
			 Sound_Stop("Sound_SniffingGhoulCrawl", 0.5f);
		 }

		 //-------------------------------------------------------
	 
		 //} END Event B *Sneak past the SNIFFING GHOUL*
		 
		 ////////////////////////////////////////
		 // Event C *Reach the bottom floor*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 6, Event C here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 6, Event C here.*/
		 
		 bool OnTrigger_Player_EnterFirstTreasureTroveFloor(const tString &in asParent, const tString &in asChild, int alState)
		 {	
			 Map_RemoveTimer("Timer_SniffingGhoulLeave");			 
			 Ghoul_Command_Remove("Ghoul_Sniffing", false);	
			 
			 mlPlayerTreasureTroveFloor = 1;
			 mlPermaFailStage = eCisternPermaFailStage_EerieQuiet;
			 
			 bool bSeqActive = SequenceStates_IsActive("Seq_SniffingGhoulEmerge");			 
			 
			 if (Entity_EntityIsInFront("Ghoul_Sniffing", "Area_TreasureTroveTopFloorPos") == false ||
				 Map_GetEntity("Ghoul_Sniffing").CheckIsOnScreen(true) ||
				 Ghoul_IsAggressive("Ghoul_Sniffing") ||
				 Agent_PlayerDetected("Ghoul_Sniffing") || 
				 bSeqActive) 
			 {
				 if (bSeqActive)
				 {
					 mbHuntPlayer = true;
					 return false;
				 }				 					 
				 
				 OnTimer_SetupBottomFloor("");
				 SequenceStates_Stop("Seq_SniffingGhoulEmerge");
				 return false;
			 }
			 
			 SequenceStates_Stop("Seq_SniffingGhoulEmerge");			 
			 Agent_SetSensesActive("Ghoul_Sniffing", false);			 			 
			 
			 bool bGoInstantlyToBottom = Entity_IsActive("Ghoul_Sniffing") == false || 
										 Entity_GetDeltaToEntity("player", "Ghoul_Sniffing").Length() > 15.f;
			 
			 GoToBottomHole(bGoInstantlyToBottom);		 	
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void GoToBottomHole(bool abInstant)
		 {
			 if (abInstant)
			 {
				 Ghoul_CommandGoToSpecificHole_Execute("Ghoul_Sniffing", "Hole_TreasureTrove_Top_2", true, true, true);
				 
				 if (Entity_IsActive("Ghoul_Sniffing"))
					Sound_CreateAtEntity("Sound_SniffingGhoulEnterHole", "creatures/foley/creature/ghoul/ghoul_hole/ghoul_enter_hole_above", "Ghoul_Sniffing");
				 
				 Map_AddTimer("Timer_GoToBottomHole", 2.f, "OnTimer_GoToBottomHole");
			 }
			 else
			 {
				 Ghoul_SetHoleNetwork("Ghoul_Sniffing", "Hole_TreasureTrove_Top_*", "", "");				 
				 Ghoul_CommandGoToHole_Execute("Ghoul_Sniffing", Map_GetEntity("Ghoul_Sniffing").GetPosition(), 
											   true, false, true, true, eGhoulSpeed_Run, -1.f, -1.f, false, 
											   false, "OnEnterHole_SniffingGhoulTop");
			 }
			 
			 Music_PlayExt("A2_2_5_Cistern_Sneak_02.ogg", true, 0.09f, 1.0f, 2.0f, 1.0f, eMusicPrio_AgentToAlertTransition, true);
			 
			 SetTunnelScareSoundsActive(false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnEnterHole_SniffingGhoulTop(const tString &in asEntity)
		 {
			 Sound_CreateAtEntity("Sound_SniffingGhoulEnterHole", "creatures/foley/creature/ghoul/ghoul_hole/ghoul_enter_hole_above", "Ghoul_Sniffing");
			 OnTimer_GoToBottomHole("");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_GoToBottomHole(const tString &in asTimer)
		 {
			 Map_RemoveTimer("Timer_DoTopFloorHoleCrawl");
			 Sound_Stop("Area_SniffingGhoulCrawlSound", 0.f);
			 
			 float fTime = 4.f;
			 
			 if (Map_TimerExists("Timer_StopTopFloorHoleCrawl") == false)
				 Area_PlaceAtEntity("Area_SniffingGhoulCrawlSound", "Ghoul_Sniffing");
			 
			 float fDist = Entity_GetDeltaToEntity("Area_SniffingGhoulCrawlSound", "Hole_TreasureTrove_Bottom_1").Length();
			 Area_MoveLinearTo("Area_SniffingGhoulCrawlSound", "Hole_TreasureTrove_Bottom_1", 100.f, fDist / fTime, 0.f, false, "");
			 Sound_CreateAtEntity("Sound_SniffingGhoulCrawl", "creatures/foley/creature/ghoul/ghoul_hole/inside_wall_loop", "Area_SniffingGhoulCrawlSound");
			 
			 Map_AddTimer("Timer_SetupBottomFloor", fTime, "OnTimer_SetupBottomFloor");
		 }
		 		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetupBottomFloor(const tString &in asTimer)
		 {
			 Sound_Stop("Sound_SniffingGhoulCrawl", 0.5f);
			 SetTunnelScareSoundsActive(false);
			 
			 bool bWasActive = Entity_IsActive("Ghoul_Sniffing");
			 
			 Entity_SetActive("Ghoul_Sniffing", true);
			 Agent_SetSensesActive("Ghoul_Sniffing", true);
			 Ghoul_SetSmellingActive("Ghoul_Sniffing", false);
			 Map_AddTimer("Timer_SetSmellingActive", 15.f, "OnTimer_SetSmellingActive");
			 
			 //////////////////////
			 // Setup patrol
			 Ghoul_ModePatrol_ClearNodes("Ghoul_Sniffing");
			 Ghoul_ModePatrol_Setup("Ghoul_Sniffing", false, eGhoulSpeed_Walk);
			 Ghoul_ModePatrol_AddNode("Ghoul_Sniffing", "PathNode_167", 1.f, 3.f);
			 Ghoul_ModePatrol_AddNode("Ghoul_Sniffing", "PathNode_147", 1.f, 3.f);
			 Ghoul_ModePatrol_AddNode("Ghoul_Sniffing", "PathNode_165", 1.f, 3.f);
			 Ghoul_Mode_Set("Ghoul_Sniffing", eGhoulMode_Patrol, false);
			 			 
			 Map_RemoveTimer("Timer_SniffingGhoulLeave");
			 Map_AddTimer("Timer_SniffingGhoulLeave", 90.f, "OnTimer_SniffingGhoulLeave");
			 
			 //////////////////////
			 // Emerge
			 if (bWasActive == false)
				Ghoul_CommandEmergeFromHole_Execute("Ghoul_Sniffing", "Hole_TreasureTrove_Bottom_1", true);
			 
			 Ghoul_SetHoleNetwork("Ghoul_Sniffing", "", "", "");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetSmellingActive(const tString &in asTimer)
		 {
			 Ghoul_SetSmellingActive("Ghoul_Sniffing", true);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event C *Reach the bottom floor*
		 
