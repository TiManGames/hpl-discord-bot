		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event E here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event E here.*/
		 
		 bool OnPermaFail_Workshop(const tString &in asSource)
		 {
			 SetupGenericPermaFail();
			 FearHandler_SetPermaFailRespawnArea("PermaFail_Workshop");
			 Entity_SetActive("BlockBox_WorkshopEntrance", false);
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event E *Wake up at the LIZARD GHOUL’s eating spot (PERMAFAIL)*
		 
		 /////////////////////////////////////////
		 // Event F *Wake up at the LIZARD GHOUL’s eating spot (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event F here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event F here.*/
		 
		 bool OnPermaFail_Lizard(const tString &in asSource)
		 {
			 Entity_SetActive("Ghoul_Lizard", false);
			 Entity_SetActive("Lizard", false);
			 Sound_Stop("Sound_EatLizard", 1.f);
			 Entity_SetActive("BlockBox_WorkshopEntrance", false);
			 
			 mlPermaFailStage = eCisternPermaFailStage_Workshop;
			 
			 tString sAreaBase = "Area_PermaFail_Lizard";
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_1", sAreaBase + "_End_1", 3.f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_2", sAreaBase + "_End_2", 4.5f, 2.f, true);
			 FearHandler_AddPermaFailScene(sAreaBase + "_Start_3", sAreaBase + "_End_3", 3.f, 2.f, false, true);
			 
			 FearHandler_SetPermaFailRespawnArea("PermaFail_Lizard");
			 return true;
		 }
		 
