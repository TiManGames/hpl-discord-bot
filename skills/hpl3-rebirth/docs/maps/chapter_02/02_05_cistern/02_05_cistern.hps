			Entity_SetActive("Trigger_TurretHatchSound", false);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_DoTurretDust(const tString &in asParent, const tString &in asChild, int alState)
		{
			ParticleSystem_SetActive("PS_Turret_*", true);
			return false;
		}
		
		//-------------------------------------------------------
		 
		void TurretHatch_OnPlayerInteract(const tString &in asEntity)
		{
			Sound_CreateAtEntity("Sound_TurretBlocked", "02_05_cistern/turret_stuck/hatch_open/hatch_open", "TurretHatch_1");
		}
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *Move the CANNON PIPE*
		 
		 /////////////////////////////////////////
		 // Event C *Pull the TANK TURRET LEVER*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event C here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event C here.*/
		 
		 void OnConnectionStateChange_TurretLever(const tString &in asEntity, int alState)
		 {
			 if (alState == 0 || cLux_GetCurrentMap() is null) 
				 return;
			 
			 if (alState == -1)
				 SetTurretLocked(true);
			 else if (alState == 1)
				 SetTurretLocked(false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetTurretLocked(bool abX)
		 {
			 float fAngle = Wheel_GetCurrentAngle("Turret");
			 mfTurretAngle = fAngle;
			 
			 if (abX)
			 {
				 mfMinTurretAngle = fAngle - 1.f;
				 mfMaxTurretAngle = fAngle + 1.f;
				 
				 Wheel_SetJammed("Turret", true, mfMinTurretAngle, mfMaxTurretAngle);
				 Sound_CreateAtEntity("SoundTurretLock", "02_02_courtyard/tank/turret/clamp_lock", "TurretLockMechanism");
			 }
			 else
			 {
				 mfMinTurretAngle = -60.f;
				 mfMaxTurretAngle = 5.f;
				 
				 Wheel_SetJammed("Turret", false, mfMinTurretAngle, mfMaxTurretAngle);
				 Sound_CreateAtEntity("SoundTurretUnlock", "02_02_courtyard/tank/turret/clamp_unlock", "TurretLockMechanism");
			 }
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event C *Pull the TANK TURRET LEVER*
		 
		 /////////////////////////////////////////
		 // Event D *Rotate the TANK TURRET*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 2, Event D here.*/
		 
		 bool mbPullingTurretHandle = false;
		 float mfTurretAngle = 0.f;
		 float mfPrevTurretAngle = 0.f;
		 float mfMinTurretAngle = -60.f;
		 float mfMaxTurretAngle = 5.f;
		 float mfTurretLookAmount = 0.f;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 2, Event D here.*/
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_TurretHandle(const tString &in asEntity)
		 {
			 Item_PutAway(eItemHandlerHand_Left);
			 Item_PutAway(eItemHandlerHand_Right);
			 
			 Player_ChangeStateToCustomControls("TurretHandle_Look", "", "TurretHandle_Action", "");
			 Player_StartLookAt("InteractArea_TurretHandle", 20.f, 2.f, 5.f, true);
			 
			 Entity_SetCollide("Turret", false);
			 Wheel_SetAutoRotateMul("Turret", 5.f);	
			 
			 mbPullingTurretHandle = true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool TurretHandle_Look(const cVector2f &in avLookAmount)
		 {			 
			 mfTurretLookAmount = cMath_Clamp(cMath_Abs(avLookAmount.x) / 0.25f, 0.f, 0.25f) * -cMath_Sign(avLookAmount.x);
			 
			 mfTurretAngle += mfTurretLookAmount;
			 mfTurretAngle = cMath_Clamp(mfTurretAngle, mfMinTurretAngle, mfMaxTurretAngle);
			 
			 Wheel_SetAngle("Turret", cMath_ToRad(mfTurretAngle), true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool TurretHandle_Action(int alAction, bool abPressed)
		 {			 
			 if (abPressed == true) return false;
			 
			 if (alAction == eAction_Interact)
			 {				 
				 Player_ChangeStateToNormal();
				 Player_StopLookAt(1.f);
				 
				 Entity_SetCollide("Turret", true);
				 
				 mbPullingTurretHandle = false;;
			 }			 
			
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void UpdateTankTurret(float afTimeStep)
		 {
			 if (mbPullingTurretHandle == false && mbClimbingOutOfTank == false)
				 return;
				
			 float fAngle = Wheel_GetCurrentAngle("Turret");
			 
			 if (fAngle <= -20.f && mfPrevTurretAngle > -20.f)
				 SwingDoor_SetBlocked("TurretHatch_*", false, false);
			 else if (fAngle > -20.f && mfPrevTurretAngle <= -20.f)
				 SwingDoor_SetBlocked("TurretHatch_*", true, false);
			 
			 bool bLimitReached = fAngle >= mfMaxTurretAngle - 0.5f && mfPrevTurretAngle < mfMaxTurretAngle - 0.5f || 
								  fAngle <= mfMinTurretAngle + 0.5f && mfPrevTurretAngle > mfMinTurretAngle + 0.5f;
			 
			 if (bLimitReached)
			 {
				 Effect_Shake_Start(0.00075f, 0.15f, 0.1f, 0.f);
				 Sound_CreateAtEntity("Sound_TurretLimit", "02_02_courtyard/tank/turret/turret_max", "Turret");	
			 }				 		 
			 
			 mfPrevTurretAngle = fAngle;
			 mfTurretLookAmount = 0.f;
			 
			 if (mbClimbingOutOfTank)
				 mfTurretAngle = fAngle;
		 }
		 
		 //-------------------------------------------------------
		 
		 void PostUpdateTankTurret(float afTimeStep)
		 {
			 if (mbPullingTurretHandle == false)
				 return;
				
			 Player_SetCrossHairState(eCrossHairState_None);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event D *Rotate the TANK TURRET*
		 
		 /////////////////////////////////////////
		 // Event E *Climb out of the FRENCH TANK*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event E here.*/
		 
		 bool mbInsideTank = true;
		 bool mbClimbingOutOfTank = false;
		 int mlTankHatchOpenCount = 0;
		 tID m_idClimbOutAnimAreaId = tID_Invalid;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event E here.*/
		 
		 void UpdateClimbingOutOfTank(float afTimeStep)
		 {
			 if (mbClimbingOutOfTank == false)
				 return;
			 
			 ///////////////////
			 // Update anim pos/rot (since turret might be moving)
			 if (m_idClimbOutAnimAreaId == tID_Invalid)
				 m_idClimbOutAnimAreaId = mBaseObj.GetEntityByName("Area_ClimbOutAnim", eLuxEntityType_Area).GetID();
				 
			 cLuxArea@ pArea = cLux_ID_Area(m_idClimbOutAnimAreaId);				 
			 cVector3f vPos = pArea.GetPosition();
			 float fAngle = cMath_GetAngleFromPoints3D(0.f, pArea.GetMatrix().GetTranspose().GetForward()).y;
				 
			 PlayerBody_SetCameraAnimationPositionAndYaw(true, vPos, fAngle, 0.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_OpenTurretHatch(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 mlTankHatchOpenCount += alState;
			 int lOpenCountRequired = mbInsideTank ? 1 : 2;
			 
			 tString sClimbArea = mbInsideTank ? "InteractArea_ClimbOutTank" : "InteractArea_ClimbIntoTank";
			 Entity_SetActive(sClimbArea, mlTankHatchOpenCount >= lOpenCountRequired);				 
			 Entity_SetEffectsActive("TurretLight", mlTankHatchOpenCount == 0, true);
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_TurretHatchBlocked(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1) return true;
			 
			 Sound_CreateAtEntity("Sound_HatchBlocked", "level_entity_shared/doors/tank_hatch/tank_hatch_max_stuck", asParent);
			 return true;
		 }		 
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_ClimbOutTank(const tString &in asEntity)
		 {
			 Lever_SetStuckState("TurretLever", 1, true); // Make sure it's unloccked
			 Wheel_SetAngle("Turret", cMath_ToRad(mfMinTurretAngle), true);
			 
			 Item_PutAway(eItemHandlerHand_Left);
			 Item_PutAway(eItemHandlerHand_Right);
			 
			 FearHandler_ResetMaxLevel();
			 
			 Player_SetCrouching(false, true, true);
			 
			 PlayerBody_PlayCutsceneAtEntity("player_tf17_exit_after_fall", "Area_ClimbOutAnim", false, 0.5f, "OnAnimEnd_ExitTank");
			 Sound_CreateAtEntity("Sound_TankExit", "02_05_cistern/animations/cistern_tank_exit", "player");
			 Sound_Play("Sound_TrickleTankRoom_*", 1.0f);
			 
			 Entity_SetActive("Soundscape_TankInside", false);
			 Entity_SetActive("Soundscape_WakeRoom", true);
			 
			 mbClimbingOutOfTank = true;
			 
			 Light_FadeBrightnessToDefault("Light_RainwaterHub", 2.f);
			 
			 Map_AddTimer("Timer_PushOpenTurretDoors", 0.25f, "OnTimer_PushOpenTurretDoors");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PushOpenTurretDoors(const tString &in asTimer)
		 {
			 if (SwingDoor_GetOpenAmount("TurretHatch_1") < 1.f)	
				 SwingDoor_PushOpen("TurretHatch_1", 3.f, 10, 0.05f);
			 if (SwingDoor_GetOpenAmount("TurretHatch_2") < 1.f)	
				 SwingDoor_PushOpen("TurretHatch_2", 3.f, 10, 0.05f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_ExitTank(const tString &in asAnim)
		 {
			 Entity_SetCollideCharacter("Turret", true);
			 Entity_SetInteractionDisabled("ft17_tank_front_door_*", false);
				 
			 Entity_SetActive("InteractArea_ClimbOutTank", false);
			 Entity_SetActive("InteractArea_ClimbIntoTank", true);
				 
			 Player_SetMoveSpeedMul(1.f);
			 Player_SetJumpDisabled(false);
			 Player_SetLeanDisabled(false);
			
			 PlayerBody_SetAnimationSet("");
			 
			 FootPlacement_SetActive(PlayerBody_GetEntityName(), true);
			 
			 Music_PlayExt("A2_2_5_Cistern_Ambience.ogg", true, 0.2f, 1.0f, 2.0f, 1.0f, eMusicPrio_BgAmb, true);
			 Entity_SetActive("Trigger_SkylightSound", true);
				 
			 mbInsideTank = false;
			 mbClimbingOutOfTank = false;
				 
			 Voice_PlayDelayed("Dialogue_OutOfTank", 2.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 //} END Event E *Climb out of the FRENCH TANK*
		 
		 /////////////////////////////////////////
		 // Event E *Climb into the FRENCH TANK*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event E here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event E here.*/
		 
		 void OnInteract_ClimbIntoTank(const tString &in asEntity)
		 {
			 Item_PutAway(eItemHandlerHand_Left);
			 Item_PutAway(eItemHandlerHand_Right);
			 
			 Player_SetCrouching(false, true, true);
			 
			 FootPlacement_SetActive(PlayerBody_GetEntityName(), false);
			 
			 PlayerBody_PlayCutsceneAtEntity("tf17_enter", "Area_ClimbInAnim", false, 0.5f, "OnAnimEnd_EnterTank");
			 Sound_CreateAtEntity("Sound_TankEnter", "02_05_cistern/animations/cistern_tank_enter", "player");
			 Sound_Stop("Sound_TrickleTankRoom_*", 1.0f);
			 
			 Entity_SetActive("Soundscape_TankInside", true);
			 Entity_SetActive("Soundscape_WakeRoom", false);
			 
			 Light_FadeBrightnessTo("Light_RainwaterHub", 15.f, 2.f);
			 
			 Map_AddTimer("Timer_PushOpenTurretDoors", 0.01f, "OnTimer_PushOpenTurretDoors");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_EnterTank(const tString &in asAnim)
		 {	
			 Entity_SetCollideCharacter("Turret", false);
			 Entity_SetInteractionDisabled("ft17_tank_front_door_*", true);
				 
			 Entity_SetActive("InteractArea_ClimbIntoTank", false);
			 Entity_SetActive("InteractArea_ClimbOutTank", true);
				 
			 Player_SetMoveSpeedMul(0.f);
			 Player_SetJumpDisabled(true);
			 Player_SetLeanDisabled(true);
				 
			 Map_AddTimer("Timer_PlaceInTankCenter", 0.1f, "OnTimer_PlaceInTankCenter");
			 
			 Entity_SetActive("Trigger_SkylightSound", false);			 
			
			 mbInsideTank = true;
		 }
		 
		 //-------------------------------------------------------
		 
		 //} END Event E *Climb out of the FRENCH TANK*
		 
		 /////////////////////////////////////////
		 // Event F *Turn the RAINWATER WHEEL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event F here.*/
		 
		 bool mbRainwaterDebrisShifted = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event F here.*/
		 
		 void OnInteract_RainwaterWheel(const tString &in asEntity)
		 {
			 Item_PutAway(eItemHandlerHand_Left);
			 Wheel_StopAutoMove("PipeWheel_1");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteractLeave_RainwaterWheel(const tString &in asEntity)
		 {
			 if (Wheel_GetCurrentAngle("PipeWheel_1") > 290.f)
				 Wheel_SetAngle("PipeWheel_1", cMath_ToRad(360.f), true);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_DrainRainwaterHub(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == 1)
			 {				 
				 LiquidArea_MoveLinearTo("Liquid_RainwaterHub_1", "Area_LiquidRainwaterHubTar_1", 0.1f, 0.1f, 0.f, false, "OnMoveLinear_RainWater");
				 LiquidArea_MoveLinearTo("Liquid_RainwaterHub_2", "Area_LiquidRainwaterHubTar_2", 0.2f, 0.3f);
				 
				 Prop_SetActiveAndFade("RainwaterPoolStream", true, 2.f);
				 
				 if (Entity_GetCollide("Area_RainWaterLimit", "Liquid_RainwaterHub_1"))
					 Map_AddTimer("Timer_StartRainwaterSplashEffects", 1.f, "OnTimer_StartRainwaterSplashEffects");
				 
				 Map_AddTimer("Timer_StopRubbleSplash", 0.1f, "OnTimer_StopRubbleSplash");
				 
				 Sound_CreateAtEntity("Sound_WaterDrain", "02_05_cistern/water_drain/water_flow", "Sound_WaterDrain");
				 Sound_CreateAtEntity("Sound_WaterDrainPipe", "02_05_cistern/water_drain/water_drain_pipe", "Sound_WaterDrainPipe");
			 }				 
			 else
			 {
				 StopRainWaterDrain(true);
				 Sound_Stop("Sound_WaterDrain", 3.0f);
				 Sound_Stop("Sound_WaterDrainPipe", 6.0f);
			 }
				 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StartRainwaterSplashEffects(const tString &in asTimer)
		 {
			 Sound_Play("Sound_RubbleSplash", 1.f);
					 
			 for (int i = 1; i < 6; ++i)
				 ParticleSystem_CreateAtEntity("PS_RubbleSplash_" + i, "cistern_rainwaterhub_splash.ps", "Area_RainwaterSplash_" + i, true);
				 
			 if (mbRainwaterDebrisShifted == false && Entity_GetCollide("Area_RainwaterDebris", "RainwaterWaterBlocker"))
			 {
				 mbRainwaterDebrisShifted = true;
				 Map_AddTimer("Timer_ShiftRainwaterDebris", 0.5f, "OnTimer_ShiftRainwaterDebris");
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ShiftRainwaterDebris(const tString &in asTimer)
		 {
			 Body_AddImpulse("RainwaterWaterBlocker_Body_1", cVector3f(0.f, 0.f, 1.f) * 0.15f, false);
			 Map_RestartCurrentTimer(0.15f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void StopRainWaterDrain(bool abWheelStop)
		 {
			 if (abWheelStop)
				LiquidArea_StopMovement("Liquid_RainwaterHub_*");
			 else
				LiquidArea_StopMovement("Liquid_RainwaterHub_1");
				 
			 Prop_SetActiveAndFade("RainwaterPoolStream", false, 5.f);
				 
			 Sound_Stop("Sound_RubbleSplash", 1.f);		 
			 ParticleSystem_Destroy("PS_RubbleSplash_*");
			  
			 Map_RemoveTimer("Timer_StartRainwaterSplashEffects");
			 Map_RemoveTimer("Timer_ShiftRainwaterDebris");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_StopRubbleSplash(const tString &in asTimer)
		 {
			 if (Entity_GetCollide("Area_RainWaterLimit", "Liquid_RainwaterHub_1"))
			 {
				 Map_RestartCurrentTimer();
				 return;
			 }
			 
			 Sound_Stop("Sound_RubbleSplash", 1.f);
			 Sound_Stop("Sound_WaterDrain", 3.0f);
			 Sound_Stop("Sound_WaterDrainPipe", 6.0f);
			 ParticleSystem_Destroy("PS_RubbleSplash_*");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnMoveLinear_RainWater(const tString &in asAreaName)
		 {
			 StopRainWaterDrain(false);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_RubbleSplash(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 cParticleSystem@ pPS_1 = mBaseObj.GetWorld().CreateParticleSystem("PS_DebrisSplash", "splash_ripples_oneshot_medium.ps", cVector3f(1.f), true, false);
			 pPS_1.SetBrightness(0.2f);
			 
			 cVector3f vPos = Map_GetEntity(asChild, eLuxEntityType_Area).GetPosition();
			 vPos.y = cLux_ToArea(Map_GetEntity(asParent, eLuxEntityType_Area)).GetAreaBody().GetBoundingVolume().GetMax().y;
			 pPS_1.SetPosition(vPos);

			 Sound_CreateAtEntity("Sound_DebrisSplash", "physics/water/water_impact", asChild);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
			bool OnCollide_Sound_GhoulPipe_1(const tString &in asParent, const tString &in asChild, int alState)
			{
				Sound_Play("Sound_GhoulPipe_1", 0.0f);
				return false;
			}
		 
		 //-------------------------------------------------------
	 
		 //} END Event F *Turn the RAINWATER WHEEL*
		 
		 /////////////////////////////////////////
		 // Event G *The baby kicks*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event G here.*/
		 
		 bool mbBabyKickSeqTriggered = false;
		 bool mbCheckOnFirstBabyKick = false;
		 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event G here.*/
		 
		 bool OnTrigger_Player_DoBabyKick(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (mbBabyKickSeqTriggered == false)
				Player_SetAllowCheckBaby(false);
			 
			 Map_AddTimer("Timer_DoBabyKick", Entity_GetVarFloat(asParent, ""), "OnTimer_DoBabyKick");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoBabyKick(const tString &in asTimer)
		 {			 
			 if (mbBabyKickSeqTriggered)
				 return;
			 
			 mbBabyKickSeqTriggered = true;
			 mbCheckOnFirstBabyKick = true;
			 
			 Player_ChangeStateToNormal();
			 
			 Player_SetCrouching(false);
			 Pregnancy_ClearBabyTalkSpecialSubject();
			 Pregnancy_SetBabyKicksEnabled(true);
			 Pregnancy_DoBabyKick(true);
			 Player_SetAllowCheckBaby(true);
			 FearHandler_SetPermaFailEnabled(false);
			 
			 Pregnancy_SetBabyTalkStage(eBabyTalkStage_CisternStartToOasis);
			 FearHandler_SetWhisperStage(eFearWhisperStage_BabyKickToOasis);
				 
			 Voice_StopAll();
			 Voice_PlayDelayed("Dialogue_TheBabyKicks", 0.3f);
				 
			 Map_AddTimer("Timer_DoSecondBabyKick", 4.f, "OnTimer_DoSecondBabyKick");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DoSecondBabyKick(const tString &in asTimer)
		 {			 
			 if (Player_GetCurrentStateName() == "State_CheckBaby")
				 return;
			 
			 Player_ChangeStateToNormal();
			 Pregnancy_DoBabyKick(true);				 
			 
			 Voice_StopAll();
			 Voice_PlayDelayed("Dialogue_TheBabyKicks_Part2", 0.3f, 0, "");		
			 
			 Map_AddTimer("Timer_ShowCheckBabyHint", 2.f, "OnTimer_ShowCheckBabyHint");				 
			 Map_AddTimer("Timer_ForceCheckOnBaby", 6.f, "OnTimer_ForceCheckOnBaby");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ShowCheckBabyHint(const tString &in asTimer)
		 {
			 Hint_RemoveFromGiven("Hints", "HintCheckBabyTutorial");
			 Hint_ShowHint_Hold("Hints", "HintCheckBabyTutorial", true, 1.5f, false, 10.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ForceCheckOnBaby(const tString &in asTimer)
		 {
			 if (Player_GetCurrentStateName() == "State_CheckBaby")
				 return;
			 
			 if (cLux_GetPlayer().GetCharacterBody().IsOnGround() == false)
			 {
				 Map_AddTimer("Timer_ForceCheckOnBaby", 0.25f, "OnTimer_ForceCheckOnBaby");
				 return;
			 }
			 
			 Player_ForceCheckOnBaby(19.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnCheckBaby(int alState)
		 {
			 if (alState == 1 && mbCheckOnFirstBabyKick)
			 {
				 mbCheckOnFirstBabyKick = false;
				 
				 Player_ForceCheckOnBaby(19.f);
				 
				 Map_AddTimer("Timer_PlayBabyKickAudio", 0.9f, "OnTimer_PlayBabyKickAudio");
				 Map_AddTimer("Timer_SetPostKickRunSpeed", 13.f, "OnTimer_SetPostKickRunSpeed");
				 
				 FearArea_SetSafe("Fear_1", true);
				 Map_AddTimer("Timer_ResetFearArea", 19.f, "OnTimer_ResetFearArea");
				 
				 Pregnancy_SetBabyKicksEnabled(false);
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ResetFearArea(const tString &in asTimer)
		 {
			 FearArea_SetSafe("Fear_1", false);
			 FearHandler_SetPermaFailEnabled(true);
			 Pregnancy_SetBabyKicksEnabled(true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayBabyKickAudio(const tString &in asTimer)
		 {
			 Voice_StopAll();
			 Voice_Play("Dialogue_TheBabyKicks_Part2", 1, "OnVoiceEnd_BabyKick");
			 Music_PlayExt("A2_3_3_Baby_Kick.ogg", false, 0.2f, 1.0f, 0.2f, 0.0f, eMusicPrio_MinorEvent, false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetPostKickRunSpeed(const tString &in asTimer)
		 {
			 Player_SetRunSpeedMul(0.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnVoiceEnd_BabyKick(const tString &in asScene, const tString &in asSubject)
		 {
			 Hint_ShowHint_Hold("Hints", "HintBabyKickFear", false, 1.5f, false, 10.f);
			 Player_FadeRunSpeedMulTo(1.f, 4.f);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event G *The baby kicks*
		 
		 /////////////////////////////////////////
		 // Event H *Wake up in the rainwater pipes (PERMAFAIL)*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 1, Event H here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 1, Event H here.*/
		 
		 bool OnPermaFail_TopFloor(const tString &in asSource)
		 {			 
			 SetupGenericPermaFail();
			 
			 tString sArea = "PermaFail_RainwaterHub";
			 if (Entity_GetCollide("RainwaterRegulator", "Trigger_DrainRainwaterHub"))
				 sArea = "PermaFail_RainwaterPipe";
			
			 if (sArea == "PermaFail_RainwaterPipe")
			 {
				 // TODO: Need damaged version of this
				 Entity_SetActive("RainwaterPipeBars", false);
			 }
			 
			 FearHandler_SetPermaFailRespawnArea(sArea);
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event H *Wake up in the rainwater pipes (PERMAFAIL)*
	 
	 //} END SCENE 2 *THE PLAYER WAKES UP AFTER THE FALL AND MAKES THEIR WAY TO THE CISTERN*
	 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 3 *THE PLAYER SEES YOUNG TIN HINAN AND THE GOAL OF THE LEVEL*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 3 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 3 here.*/
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Spot YOUNG TIN HINAN heading downwards*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event A here.*/
		 
		 int mlStartGhostMoveTarget = 1;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event A here.*/
		 
		 bool OnTrigger_Player_StartSeqTinHinanGlimpseTop(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 StartTHGlimpseTop();
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_TH_Start(const tString &in asEntity, int alState)
		 {		
			 StartTHGlimpseTop();
		 }
		 
		 //-------------------------------------------------------
		 
		 void StartTHGlimpseTop()
		 {
			 Entity_SetActive("Trigger_TH_Entrance_*", false);
			 Seq_TinHinanGlimpseTop("");
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataTinHinanGlimpseTop;
		 void Seq_TinHinanGlimpseTop(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_TinHinanGlimpseTop", mSeqDataTinHinanGlimpseTop);
			 if (Sequence_DoStepAndWait(0.5f))
			 {
				YoungTinHinan_Activate("TH_Start", 1.f);				
			 }
			 else if (Sequence_DoStepAndWait(2.5f))
			 {				 
				 Music_Play("A2_2_5_Tin_Hinan_Sighting_01", 0.5f, false, eMusicPrio_BigEvent);
				 Map_AddTimer("Timer_CisternMusic", 22.5f, "OnTimer_PlayCisternMusic");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {			
				 //Voice_Play("Dialogue_SeesTinHinan");
				 Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_AfterGhost");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 YoungTinHinan_MoveTo("TH_Start", "Area_GhostFlyTarget_1", "OnPathEnd_StartGhost", 3);
				 Map_GetEntity("TH_Start").GetLightFromName("Light_Point_1").FadeTo(cColor(0.f), 3.f, 2.f);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnPathEnd_StartGhost(const tString &in asEntityName, bool abReachedEnd)
		 {
			 mlStartGhostMoveTarget++;
			 tString sTarget = "Area_GhostFlyTarget_" + mlStartGhostMoveTarget;
			 
			 if (mlStartGhostMoveTarget == 6)
				 Map_AddTimer("Timer_FadeBottomLight", 1.f, "OnTimer_FadeBottomLight");
			 
			 if (Entity_Exists(sTarget) == false)
			 {
				 Map_AddTimer("Timer_DeactivateStartTH", 10.f, "OnTimer_DeactivateStartTH");
				 return;
			 }
			 
			 YoungTinHinan_MoveTo("TH_Start", sTarget, "OnPathEnd_StartGhost", 3);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_FadeBottomLight(const tString &in asTimer)
		 {
			 cColor lightColor = cColor(0.573*4,0.834*4,0.752*4,1);
			 Light_FadeTo("Light_Point_Bottom", lightColor, 9.f, 2.f);
			 
			 Sketchbook_AddIdea("exit_cistern");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DeactivateStartTH(const tString &in asTimer)
		 {
			 YoungTinHinan_Deactivate("TH_Start", 1.f);
		 }
	 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayCisternMusic(const tString &in asTimer)
		 {			 
			 Music_Play("A2_2_5_Cistern_Theme.ogg", 0.25f, false, eMusicPrio_BgAmb);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_DisableBottomLight(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Light_FadeTo("Light_Point_Bottom", cColor(0.f), 0.f, 1.f);
			 return false;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Spot YOUNG TIN HINAN heading downwards*
		 
		 /////////////////////////////////////////
		 // Event C *Tasi gets vertigo*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event B here.*/
		 
		 void OnLookAt_StartSeqVertigoEvent(const tString &in asEntity, int alState)
		 {
			 Seq_VertigoEvent("");
			 Entity_SetActive(asEntity, false);
			 Map_AddTimer("Timer_AllowVertigoDialogue", 4.5f, "OnTimer_AllowVertigoDialogue");
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataVertigoEvent;
		 void Seq_VertigoEvent(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_VertigoEvent", mSeqDataVertigoEvent);
			 if (Sequence_DoStepAndWait(0.75f))
			 {
				 Player_SetVertigoActive(true);
				 Player_FadeVertigoIntensity(2.f, 1.f);
				 
				 FearHandler_SetForcedAddFearRate(0.2f, 5.f, false);
			 }
			 else if (Sequence_DoStepAndWait(1.75f))
			 {				 				 
				 Voice_Play("Dialogue_Vertigo");				 
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {
				 Player_FadeVertigoIntensity(1.f, 2.f);
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void StopVertigoSeq()
		 {
			 Entity_SetActive("Trigger_StartVertigoEvent", false);
			 SequenceStates_Stop("Seq_VertigoEvent");
			 
			 Player_SetVertigoActive(true);
			 Player_FadeVertigoIntensity(1.f, 1.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_AllowVertigoDialogue(const tString  &in asTimer)
		 {
			Entity_SetActive("Trigger_VertigoDialogue", true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_PlayVertigoDialogue(const tString &in asEntity, int alState)
		 {
			 if (alState == 1 && 
				 Entity_GetCollide("player", "Area_VertigoDialogueCheck") && 
				 cLux_GetPlayer().GetCharacterBody().IsOnGround())	 
			 {
				 Voice_Play("Dialogue_LookDownCistern");
				 Entity_SetActive(asEntity, false);
			 }
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event B *Tasi gets vertigo*
		 
		 /////////////////////////////////////////
		 // Event C *Turn the UPPER FLOW PIPE WHEEL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event C here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event C here.*/
		 
		 void OnInteract_FlowPipeWheel(const tString &in asEntity)
		 {
			 Wheel_StopAutoMove(asEntity);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteractLeave_FlowPipeWheel(const tString &in asEntity)
		 {
			 float fMaxAngle = Entity_GetVarFloat(asEntity, "");
			 if (Wheel_GetRotationAmount(asEntity) >= 0.65f)
				 Wheel_SetAngle(asEntity, cMath_ToRad(fMaxAngle), true);
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event C *Turn the UPPER FLOW PIPE WHEEL*
		 
		 /////////////////////////////////////////
		 // Event D *Balance across the WOODEN STRUCTURE*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event D here.*/
		 
		 cVector3f mvPrevPlayerWoodStructurePos;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event D here.*/
		 
		 bool OnTrigger_Player_StartBalancing(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Trigger_StartVertigoEvent", false);
			 Player_SetVertigoActive(true);
			 
			 Map_RemoveTimer("Timer_PlayWoodCreak_1");
			 Map_RemoveTimer("Timer_PlayWoodCreak_2");
			 
			 if (alState == 1)
			 {
				 mvPrevPlayerWoodStructurePos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();
				 OnTimer_PlayWoodCreak("Timer_PlayWoodCreak_" + cString_GetNumericSuffixInt(asParent));
				 
				 if (Entity_GetVarInt(asParent, "") == 1)
				 {
					 Player_SetRunSpeedMul(0.5f);
					 Player_SetMoveSpeedMul(0.5f);
				 }				 
			 }
			 else
			 {
				 if (Entity_GetVarInt(asParent, "") == 1)
				 {
					 Player_SetRunSpeedMul(1.f);
					 Player_SetMoveSpeedMul(1.f);
				 }				 
			 }
			 
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayWoodCreak(const tString &in asTimer)
		 {
			 if (cLux_GetPlayer().GetCharacterBody().IsOnGround())
			 {				 
				 cVector3f vPos = cLux_GetPlayer().GetCharacterBody().GetFeetPosition();			 
				 if ((vPos - mvPrevPlayerWoodStructurePos).Length() > 0.05f)
				 {
					 int lId = cString_GetNumericSuffixInt(asTimer);
					 Sound_CreateAtEntity("Sound_WoodCreak", "02_04_living_quarters/floor_plank/floor_plank_creak", "Area_WoodCreak_" + lId);
				 }
			 
				 mvPrevPlayerWoodStructurePos = vPos;
			 }
			 
			 Map_AddTimer(asTimer, cMath_RandRectf(0.5f, 0.75f), "OnTimer_PlayWoodCreak");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_BreakBeam(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Prop_AlignRotation("LooseBeam", "LooseBeam_Target", 5.f, 3.f, 0.f, false, "", "Area_BeamRotationOffset");
			 
			 ParticleSystem_CreateAtEntity("PS_BeamSettle", "wooden_brace_damage.ps", "Area_BeamEffects", false).SetBrightness(0.1f);
			 ParticleSystem_CreateAtEntity("PS_BeamDust", "dust_impact_simple_oneshot.ps", "Area_BeamEffects", false).SetBrightness(0.4f);
			 
			 Sound_CreateAtEntity("Sound_BeamSettle", "02_04_living_quarters/floor_plank/floor_plank_splinter", "Area_BeamEffects");
			 
			 Effect_Shake_Start(0.01f, 0.5f, 0.25f, 0.25f);
			 
			 FearHandler_SetForcedAddFearRate(0.1f, 5.f, false);	

			 Map_AddTimer("Timer_PlayBeamDialogue", 0.05f, "OnTimer_PlayBeamDialogue");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayBeamDialogue(const tString &in asTimer)
		 {
			 Voice_Play("Dialogue_BeamBreaks");
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event D *Balance across the WOODEN STRUCTURE*
		 
		 /////////////////////////////////////////
		 // Event E *Spot the CLIMB GHOUL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event E here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event E here.*/
		 
		 bool OnTrigger_Player_StartGhoulClimb(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Ghoul_Climb", true);
			 Entity_SetActive("Trigger_SpotGhoulClimb", true);
			 Entity_PlayAnimation("Ghoul_Climb", "climb_on_wall_cistern", 0.f, false, false, "OnAnimEnd_GhoulClimb");
			 Map_GetEntity("Ghoul_Climb").GetMeshEntity().GetAnimationStateFromName("climb_on_wall_cistern").SetTimePosition(3.2f);
			 
			 Sound_Play("Sound_GhoulClimbDebris_1", 0.0f);
			 Sound_Play("Sound_GhoulClimbDebris", 0.0f);
			 
			 Map_AddTimer("Timer_DisableGhoulClimbFear", 3.f, "OnTimer_DisableGhoulClimbFear");
			 Map_AddTimer("Timer_DoGhoulClimbEffects", 0.5f, "OnTimer_DoGhoulClimbEffects");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 
		 bool OnCollide_Sound_GhoulPipe_2(const tString &in asParent, const tString &in asChild, int alState)
			{	
				Sound_Play("Sound_GhoulPipe_2", 0.0f);
				return false;
			}
		 
		 bool OnCollide_Sound_GhoulPipe_3(const tString &in asParent, const tString &in asChild, int alState)
			{
				Sound_Play("Sound_GhoulPipe_3", 0.0f);
				return false;
			} 

		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_ClimbGhoul(const tString &in asEntity, int alState)
		 {
			 FearHandler_SetForcedAddFearRate(0.6f, 4.f, true, -1.f, 0.05f, 0.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DisableGhoulClimbFear(const tString &in asTimer)
		 {
			 Entity_SetActive("Trigger_SpotGhoulClimb", false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_GhoulClimb(const tString &in asEntityName, const tString &in asAnimName)
		 {
			 Entity_SetActive("Ghoul_Climb", false);
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event E *Spot the CLIMB GHOUL*
		 
		 /////////////////////////////////////////
		 // Event F *Wake up in different locations in the Climb Ghoul Tunnel*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 3, Event F here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 3, Event F here.*/
		 
		 bool OnPermaFail_FallTop(const tString &in asSource)
		 {			 
			 SetupGenericPermaFail();
			 FearHandler_SetPermaFailRespawnArea("PermaFail_FallTop_*");
			 return true;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event F *Wake up in different locations in the Climb Ghoul Tunnel*
	 
	 //} END SCENE 3 *THE PLAYER SEES YOUNG TIN HINAN AND THE GOAL OF THE LEVEL*
	 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 4 *THE PLAYER AVOIDS A GHOUL COMING OUT OF A GHOUL HOLE*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 4 here.*/
	 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 4 here.*/
	 
		//-------------------------------------------------------
		
		//} END General
		
		 /////////////////////////////////////////
		 // Event A *Spot the LIZARD moving down the stairs*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event A here.*/
		 
		 bool mbLizardMoved = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event A here.*/
		 
		 bool OnTrigger_SetPermaFailStage(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (FearHandler_GetIsPermaFailing())
				 return true;
				
			 mlPermaFailStage = eCisternPermaFailStage(Entity_GetVarInt(asParent, ""));
			 return true;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ActivateLizard(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Trigger_LizardMove_*", true);
			
			 Entity_SetActive("Lizard", true);
			 Map_GetEntity("Lizard").GetMeshEntity().SetUpdateBonesWhenCulled(true);
			 
			 // Show the grab hint the next time you interact with a grab prop
			 Hint_RemoveFromGiven("Hints", "HintGrabThrow");
			 Grab_SetSpecificHint("HintGrabThrow");
			 
			 if (Oil_GetCount("HerbertOil") > 0)
				 Entity_SetActive("oil_flask_herbert_1", false);
			 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_LizardMove(const tString &in asEntity, int alState)
		 {
			 LizardMove();
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_LizardMove(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 LizardMove();
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void LizardMove()
		 {
			 if (mbLizardMoved)
				 return;
				 
			 mbLizardMoved = true;
			 
			 Entity_PlayAnimation("Lizard", "run_to_hole", 0.1f, false, true, "OnAnimEnd_LizardHole");
			 Sound_CreateAtEntity("Sound_LizardRun1", "02_05_cistern/lizard/lizard_run_1", "Trigger_LizardMove_1");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_LizardHole(const tString &in asEntityName, const tString &in asAnimName)
		 {			 
			 Entity_StopAnimation("Lizard");
			 Entity_PlaceAtEntity("Lizard", "Area_LizardGrabbed", 0.f, true);
			 Entity_PlayAnimation("Lizard", "grabbed_by_ghoul", 0.f, false, true, "");
			 
			 Map_GetEntity("Lizard").GetMeshEntity().GetAnimationStateFromName("grabbed_by_ghoul").SetSpeed(0.f);
			 Map_GetEntity("Lizard").GetMeshEntity().GetAnimationStateFromName("grabbed_by_ghoul").SetRelativeTimePosition(0.001f);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_CloseWorkshopPortcullis(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 bool bInFront = Entity_PlayerIsInFront(asParent);
			 if (alState == 1 || bInFront == false) 
				 return true;
			 
			 Entity_SetActive("Trigger_StartSeqEatLizard_*", true);
			 
			 Entity_SetActive("BlockBox_WorkshopEntrance", true);
			 SlideDoor_SetClosed("Portcullis_Workshop", true);		
			 
			 Map_AddTimer("Timer_MovePortcullisBlockers", 0.4f, "OnTimer_MovePortcullisBlockers");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_MovePortcullisBlockers(const tString &in asTimer)
		 {
			 cLuxArea@ pArea = cLux_ToArea(Map_GetEntity("Area_WorkshopPortcullis", eLuxEntityType_Area));
			 if (pArea !is null)
			 {
				 cBoundingVolume@ pBounds = pArea.GetAreaBody().GetBoundingVolume();
				 array<iPhysicsBody@> vBodies;				 
				 mBaseObj.GetPhysicsWorld().GetBodiesInAABB(pBounds.GetMin(), pBounds.GetMax(), vBodies);
				 
				 for (int i = 0; i < vBodies.size(); ++i)
				 {
					 iPhysicsBody@ pBody = vBodies[i];
					 if (pBody.IsActive() == false || pBody.GetMass() == 0.f)
						 continue;
					 iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
					 if (pEnt is null)
						 continue;
					 
					 pBody.SetCollideFlags(mBaseObj.GetCollideFlag("-gate"));
					 pBody.AddImpulse(cVector3f_Forward * -5.f);
				 }
			 }
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event A *Spot the LIZARD moving down the stairs*
	 
		 /////////////////////////////////////////
		 // Event B *The LIZARD GHOUL crawls out of a ghoul hole*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 4, Event B here.*/
		 
		 bool mbAllowHideTutorialBark = false;
		 bool mbLizardGhoulLeavingAfterThrow = false;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 4, Event B here.*/
		 
		 void OnLookAt_LizardHole(const tString &in asEntity, int alState)
		 {
			 Entity_SetActive("Trigger_StartSeqEatLizard_*", false);
			 Map_AddTimer("Timer_EatLizard", 0.3f, "OnTimer_EatLizard");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_StartSeqEatLizard(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Trigger_StartSeqEatLizard_*", false);
			 Map_AddTimer("Timer_EatLizard", 0.01f, "OnTimer_EatLizard");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_EatLizard(const tString &in asTimer)
		 {			 
			 mlPermaFailStage = eCisternPermaFailStage_Lizard;
			 
			 Entity_PlaceAtEntity("Lizard", "Area_LizardGrabbed", 0.f, true);
			 Entity_PlayAnimation("Lizard", "grabbed_by_ghoul", 0.f, false, true, "OnAnimEnd_LizardGrabbed");
			 Map_GetEntity("Lizard").GetMeshEntity().GetAnimationStateFromName("grabbed_by_ghoul").SetSpeed(1.f);
			 
			 Entity_SetActive("Ghoul_Lizard", true);				 
			 Agent_SetSensesActive("Ghoul_Lizard", false);
			 
			 Ghoul_SetSmellingActive("Ghoul_Lizard", false);
			 Ghoul_SetCallback_EnterHunt("Ghoul_Lizard", "OnEnterHunt_LizardGhoul");
			 Ghoul_SetCallback_ThrowAnimationOver("Ghoul_Lizard", "OnThrowAnimEnd_LizardGhoul", true);
			 
			 Blackboard_SetOverlookedAchievementDetectionActive(false);
			 
			 Agent_PlayCutsceneAtEntity("Ghoul_Lizard", "emerge_grab_lizard", "Area_LizardGrabbed", 0.f, false, "OnAnimEnd_GrabLizard");
			 
			 FearHandler_SetForcedAddFearRate(0.6f, 4.f, true, -1.f, -1.f, 0.7f);
			 
			 Light_FadeBrightnessTo("Light_Lizard", 0.f, 5.f);
			 
			 Player_SetAllowHideModeHint(false);
			 FearHandler_SetAllowMonsterHint(false);
			 
			 Map_AddTimer("Timer_PlayLizardStinger", 0.25f, "OnTimer_PlayLizardStinger");
			 
			 Map_AddTimer("Timer_SetLizardGhoulSensesActive", 7.f, "OnTimer_SetLizardGhoulSensesActive");
			 Map_AddTimer("Timer_LizardSneakMusic", 5.0f, "OnTimer_PlayLizardSneakMusic");
			 
			 Map_AddTimer("Timer_ShowHideHint", 5.f, "OnTimer_ShowHideHint");
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_ForceGhoulAttack(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Entity_IsActive("Ghoul_Lizard") && Agent_GetCutsceneActive("Ghoul_Lizard"))
				 Agent_RevealPlayerPosition("Ghoul_Lizard");
				
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_LeaveLizardGhoulArea(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (Entity_IsActive("Ghoul_Lizard") == false)
				 return false;
				 
			 Ghoul_Command_Remove("Ghoul_Lizard");
			 Ghoul_CommandGoToSpecificHole_Execute("Ghoul_Lizard", "Hole_Lizard_2", false, false, true, eGhoulSpeed_Run);
				 
			 Map_AddTimer("Timer_ClearHints", 1.f, "OnTimer_ClearHints");
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_GrabLizard(const tString &in asGhoul, const tString &in asAnim)
		 {
			 Ghoul_ModeGuard_Setup("Ghoul_Lizard", "Area_EatLizardLook", "Area_EatLizardStand", "eat_lizard", "", "eat_lizard_react_to_sound", eGhoulSpeed_Walk);
			 Ghoul_Mode_Set("Ghoul_Lizard", eGhoulMode_Guard);
			 Ghoul_SetCustomWalkAnim("Ghoul_Lizard", "ghoul_wlk_lizard");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayLizardStinger(const tString &in asTimer)
		 {
			 Sound_PlayGui("02_05_cistern/lizard/lizard_stinger", 1.0);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ShowHideHint(const tString &in asTimer)
		 {
			 if (IsPlayerHidingFromLizardGhoul() == false)
			 {
				 Hint_StopHint();
				 Hint_ShowHint("Hints", "HintHide", true);
			 }			 

			 Map_AddTimer("Timer_LizardGhoulLeave", 3.f, "OnTimer_LizardGhoulLeave");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_LizardGhoulLeave(const tString  &in asTimer)
		 {
			 if (IsPlayerHidingFromLizardGhoul() && mbLizardGhoulLeavingAfterThrow == false)
			 {
				 Ghoul_Command_Remove("Ghoul_Lizard");
			     Ghoul_CommandGoToSpecificHole_Execute("Ghoul_Lizard", "Hole_Lizard_2", false, false, true, eGhoulSpeed_Walk);
				 
				 Map_AddTimer("Timer_ClearHints", 1.f, "OnTimer_ClearHints");
				 Map_AddTimer("Timer_ShowHideModeHint", 1.5f, "OnTimer_ShowHideModeHint");
				 return; 
			 }

			 Map_RestartCurrentTimer();
		 }
		 
		 //-------------------------------------------------------
		 
		 bool IsPlayerHidingFromLizardGhoul()
		 {
			 for (int i = 1; i < 4; ++i)
			 {
				 if (Entity_GetCollide("Area_HideSpot_" + i, "player"))
					 return true;
			 }
			 
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ClearHints(const tString &in asTimer)
		 {
			  Hint_StopHint();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_ShowHideModeHint(const tString &in asTimer)
		 {
			 if (Ghoul_IsAggressive("Ghoul_Lizard") && Agent_PlayerDetected("Ghoul_Lizard") == false)
				 return;
			 
			 Hint_ShowHint("Hints", "HintHideMode", true);
					 
			 mbAllowHideTutorialBark = true;
			 Map_AddTimer("Timer_DisableHideTutorialBark", 6.f, "OnTimer_DisableHideTutorialBark");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnPlayerEnterHide()
		 {
			 if (mbAllowHideTutorialBark == false)
				 return;
				 
			 mbAllowHideTutorialBark = false;
			 
			 if (Ghoul_IsAggressive("Ghoul_Lizard") == false && Agent_PlayerDetected("Ghoul_Lizard") == false)
				 Voice_PlayDelayed("Dialogue_HideTutorial", 1.f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DisableHideTutorialBark(const tString &in asTimer)
		 {
			 mbAllowHideTutorialBark = false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnAnimEnd_LizardGrabbed(const tString &in asEntityName, const tString &in asAnimName)
		 {
			 Entity_AttachToSocket("Lizard", "Ghoul_Lizard", "socket_righthand_damage", true, true);
			 Entity_PlayAnimation("Lizard", "lizard_dead", 0.f, true);
		 }
	 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetLizardGhoulSensesActive(const tString &in asTimer)
		 {
			 Agent_SetSensesActive("Ghoul_Lizard", true);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnEnterHunt_LizardGhoul()
		 {
			 Entity_SetActive("Lizard", false);
			 Entity_SetActive("Lizard_Dead", true);
			 
			 CharMover_PlayAnimation("Lizard_Dead", "lizard_dead", 0.f, true, false);
			 
			 cLuxAgent@ pAgent = cLux_ToAgent(Map_GetEntity("Lizard_Dead"));
			 pAgent.GetCharBody().SetTestCollision(false);
			 pAgent.GetCharBody().SetActive(false);
			 
			 cVector3f vGoalPos = Map_GetEntity("Lizard").GetMeshEntity().GetBoneStateFromName("j_Lizard_Root").GetWorldPosition();
			 pAgent.GetCharBody().SetPosition(vGoalPos, false);		 
			 
			 cVector3f vCurrentPos = Map_GetEntity("Lizard_Dead").GetMeshEntity().GetBoneStateFromName("j_Lizard_Root").GetWorldPosition();
			 cVector3f vOffset = vGoalPos - vCurrentPos;
			 
			 pAgent.GetCharBody().SetPosition(pAgent.GetCharBody().GetPosition() + vOffset, false);	 
			 
		     Map_AddTimer("Timer_DropLizard", 0.01f, "OnTimer_DropLizard");
		 }
		 
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_DropLizard(const tString &in asTimer)
		 {
			 cLuxAgent@ pAgent = cLux_ToAgent(Map_GetEntity("Lizard_Dead"));
			 pAgent.GetCharBody().SetTestCollision(true);
			 pAgent.SetRagdollActive(true);
			 pAgent.GetRagdollBodyFromName("Body_2").AddImpulse(cVector3f(0.f, -1.f, 0.f));
			 
			 CharMover_SetUseMoveStateAnimations("Lizard_Dead", false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnThrowAnimEnd_LizardGhoul()
		 {
			 mbLizardGhoulLeavingAfterThrow = true;			 
			 Agent_SetSensesActive("Ghoul_Lizard", false);
			 
			 ///////////////////
			 // Move to hole that's not past the player
			 cLuxAgent@ pGhoul = cLux_ToAgent(Map_GetEntity("Ghoul_Lizard"));
			 cVector3f vFromGhoulToPlayer = pGhoul.GetPlayerDir();
			 cVector3f vGhoulPos = pGhoul.GetCharBody().GetPosition();
			 
			 float fDot1 = cMath_Vector3Dot(vFromGhoulToPlayer, cMath_Vector3Normalize(Map_GetEntity("Hole_Lizard_1").GetPosition() - vGhoulPos));
			 float fDot2 = cMath_Vector3Dot(vFromGhoulToPlayer, cMath_Vector3Normalize(Map_GetEntity("Hole_Lizard_2").GetPosition() - vGhoulPos));
			 
			 tString sHole = fDot1 < fDot2 ? "Hole_Lizard_1" : "Hole_Lizard_2";
			 
			 Ghoul_Command_Remove("Ghoul_Lizard");
			 Ghoul_CommandGoToSpecificHole_Execute("Ghoul_Lizard", sHole, true, false, true, eGhoulSpeed_Run);
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_DeactivateLizardGhoul(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("Ghoul_Lizard", false);
			 Entity_SetActive("Lizard", false);
			 
			 Player_SetAllowHideModeHint(true);
			 FearHandler_SetAllowMonsterHint(true);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_PlayLizardSneakMusic(const tString &in asTimer)
		 {
			Music_PlayExt("A2_2_5_Cistern_Sneak_01.ogg", true, 0.3f, 1.0f, 5.0f, 1.0f, eMusicPrio_AgentToAlertTransition, true);
		 }
		 		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_SparePartsStopMusic(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Blackboard_SetOverlookedAchievementDetectionActive(true);
			Music_StopAll(10.0f);
			return false;
		 }
		 
		 //-------------------------------------------------------
	 
		 //} END Event B *The LIZARD GHOUL crawls out of a ghoul hole*
		 
