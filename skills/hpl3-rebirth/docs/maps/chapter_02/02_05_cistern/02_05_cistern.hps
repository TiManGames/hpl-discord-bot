	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE 5 *THE PLAYER SOLVES A PUZZLE TO PASS OVER THE CISTERN AGAIN*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		 /////////////////////////////////////////
		 // General
		 //{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene 5 here.*/
		
		bool mbWaterTankTopCollide = false;
			 
		//-------------------------------------------------------
	 
		/*Put any functions that are used in more than one event in Scene 5 here.*/
		
		bool OnTrigger_WaterTank_Collide(const tString &in asParent, const tString &in asChild, int alState)
		{			
			tString sDir = Entity_GetVarString(asParent, "");
			int lId = cString_GetNumericSuffixInt(asChild);
			
			if (sDir == "up")
			{		
				mbWaterTankTopCollide = alState == 1;
				
				float fAngle = Wheel_GetCurrentAngle("WaterTankWheel_Vertical");
				Wheel_SetJammed("WaterTankWheel_Vertical", alState == 1, 0.f, fAngle - 2.f);
			}
			else if (sDir == "down")
			{				
				if (alState == 1)
				{
					if (Wheel_GetRotationAmount("FlowPipeWheel_Middle") >= 0.9f)
					{														 
						float fTankWheelAngle = Wheel_GetCurrentAngle("WaterTankWheel_Horizontal");
						Wheel_SetJammed("WaterTankWheel_Horizontal", true, fTankWheelAngle - 2.f, fTankWheelAngle + 2.f);
						
						SetWaterTankStuck(true);			
						
						iLuxEntity@ pWeight = Map_GetEntity("WaterTank_Weight");
						pWeight.GetBody(0).SetLinearVelocity(0.f);
						pWeight.GetBody(0).SetAngularVelocity(0.f);
						
						Prop_SetStaticPhysics("WaterTank_Weight", true);
						
						if (Wheel_GetRotationAmount("WaterTankWheel_Horizontal") > 0.5f)
							Entity_SetActive("BlockBox_TankBridge", true);
					}
				}		
			}
			
			///////////////////////////////////
			// Feedback!
			if (alState == 1 && 
				Map_TimeHasPassed("Timer_WaterTankStuckEffects", 1.f) &&
				 (sDir == "down" || Entity_IsInteractedWith("WaterTankWheel_Vertical")))
			{
				tString sArea = sDir == "up" ? "Trigger_StopWaterTank_2" : "Trigger_StopWaterTank_3";
				Sound_CreateAtEntity("Sound_TankBlocked", "02_05_cistern/water_bucket/bucket_stuck", sArea);
				ParticleSystem_CreateAtEntity("PS_TankBlocked", "dust_impact_simple_oneshot.ps", sArea, false);
			}			
			return true;
		}
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		 /////////////////////////////////////////
		 // Event A *Spot YOUNG TIN HINAN at the bottom of the Cistern*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event A here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event A here.*/
		 
		 bool OnTrigger_ActivatePuzzleTH(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 Entity_SetActive("TH_Puzzle", true);
			 Entity_SetActive("Trigger_SpotPuzzleTH", true);
			 YoungTinHinan_SetFlying("TH_Puzzle", false);
			 return false;
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnLookAt_PuzzleTH(const tString &in asEntity, int alState)
		 {			 
			 Seq_PuzzleTHSighting("");
		 }
		 
		 //-------------------------------------------------------
		 
		 cSequenceStatesData mSeqDataPuzzleTHDissapear;
		 void Seq_PuzzleTHSighting(const tString &in asTimer)
		 {
			 Sequence_Begin("Seq_PuzzleTHSighting", mSeqDataPuzzleTHDissapear);
			 Sequence_Wait(0.5f);
			 if (Sequence_DoStepAndWait(1.f))
			 {
				  Entity_SetActive("TH_Puzzle", true);
				  Entity_SetActive("Trigger_SpotPuzzleTH", false);
				 
				  FearHandler_SetForcedAddFearRate(0.1f, -1.f);
				 
				  Music_Play("A2_2_5_Tin_Hinan_Sighting_02", 0.5f, false, eMusicPrio_BigEvent);
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {			 
				 YoungTinHinan_MoveTo("TH_Puzzle", "PathNode_116", "OnPathEnd_PuzzleTH");
			 }
			 else if (Sequence_DoStepAndWait(1.f))
			 {			 
				 Voice_Play("Dialogue_SeeTinHinanSecond");
			 }
			 Sequence_End();
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnPathEnd_PuzzleTH(const tString &in asEntity, bool abReachedEnd)
		 {
			 YoungTinHinan_Deactivate("TH_Puzzle", 1.f, false);
			 FearHandler_SetForcedAddFearRate(0.1f, 0.5f, false, -1.f, 0.1f);
		 }
		 
		 //-------------------------------------------------------
		 
		 void StopTHEntranceSeq()
		 {
			 if (SequenceStates_IsActive("Seq_PuzzleTHSighting"))
			 {
				 SequenceStates_Stop("Seq_PuzzleTHSighting");
				 
				 Entity_SetActive("TH_Puzzle", false);
				 Entity_SetActive("Trigger_SpotPuzzleTH", false);
				 
				 Voice_StopAll();
				 Music_Stop(1.f, eMusicPrio_BigEvent);
			 }
		 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_Player_DeactivatePuzzleTH(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1)
				 return true;
			 
			 if (mbPuzzleRegulatorUnjammed && mbWaterTankStuck)
			 {
				 Entity_SetActive("TH_Puzzle", false);
				 Entity_SetActive("Trigger_SpotPuzzleTH", false);
				 return false;
			 }
			 		 
			 return true;
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event A *Spot YOUNG TIN HINAN at the bottom of the Cistern*
		 
		 /////////////////////////////////////////
		 // Event B *Turn the LOWER FLOW PIPE WHEEL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event B here.*/
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event B here.*/
		 
		 bool OnTrigger_FlowPipe_Collide(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 float fAngle = Wheel_GetCurrentAngle("FlowPipeWheel_Middle");
			 bool bAbove = Map_GetEntity("Trigger_StopWaterTank_3").GetPosition().y > Map_GetEntity(asParent).GetPosition().y;
			 Wheel_SetJammed("FlowPipeWheel_Middle", alState == 1, bAbove ? fAngle - 1.f : 0.f, fAngle + 1.f);
			 
			 if (Wheel_GetRotationAmount("FlowPipeWheel_Middle") < 0.9f)
				 Wheel_SetAngle("FlowPipeWheel_Middle", 0.f, true);
				
			 if (alState == -1)
				 Wheel_StopAutoMove("FlowPipeWheel_Middle");
			 
			 return true;
		 }
	 
		 //-------------------------------------------------------
	 
		 //} END Event B *LOWER FLOW PIPE WHEEL*
		 
		 /////////////////////////////////////////
		 // Event C *Turn the HORIZONTAL WATER TANK WHEEL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event C here.*/
		 
		 int mlRopeId = -1;
		 float mfPrevWaterTankWheelHorizontalT = 0.f;
		 float mfPrevWaterTankWheelVerticalT = 0.f;
		 bool mbWaterTankStuck = false;
		 bool mbWaterTankFallen = false;
		 bool mbUpdateWaterTank = true;
		 cVector3f mvWaterTankArmAttachPos = 0.f;
		 tID m_idWaterTankArm = tID_Invalid;
		 tID m_idWaterTankWeightBody = tID_Invalid;
		 tID m_idWaterTankChainTopBody = tID_Invalid;
		 tID m_idWaterTankSound = tID_Invalid;
		 array<tID> mvChainPartIds;
		 array<cVector3f> mvWaterTankPoints;
	 
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event C here.*/		 
	
		 void SetupWaterTank()
		 {
			 /////////////////////
			 // Setup vars
			 iLuxEntity@ pArm = Map_GetEntity("WaterTank_Arm");
			 iPhysicsBody@ pTop = Map_GetEntity("WaterTankChain_Top").GetMainBody();
			 iPhysicsBody@ pBottom = Map_GetEntity("WaterTankChain_Bottom").GetMainBody();
			 iPhysicsBody@ pWeight = Map_GetEntity("WaterTank_Weight").GetMainBody();			 
			 
			 m_idWaterTankArm = pArm.GetID();
			 m_idWaterTankWeightBody = pWeight.GetID();
			 m_idWaterTankChainTopBody = pTop.GetID();
			 
			 for (int i = 1; i < 3; ++i)
			 {
				 iLuxEntity@ pChainPart = Map_GetEntity("BucketChain_" + i);
				 pChainPart.GetMeshEntity().SetUpdateBonesWhenCulled(true);
				 
				 mvChainPartIds.push_back(pChainPart.GetID());
			 }
			
			 /////////////////////
			 // Create rope
			 cVector3f vStart = pTop.GetWorldPosition();
			 cVector3f vEnd = pBottom.GetWorldPosition();
			 
			 iPhysicsRope@ pRope = mBaseObj.GetPhysicsWorld().CreateRope("Chain", vStart, vEnd);	
			 mlRopeId = pRope.GetUniqueID();
			
			 pRope.SetActive(true);
			 pRope.SetPhysicsActive(true);
			 pRope.SetSegmentLength(0.38f);
			 pRope.SetDamping(0.005f);
			 pRope.SetStrength(500.f);
			 pRope.SetStiffness(1.f);
			 pRope.SetCollide(false);
			 pRope.SetCollideAttachments(false);			
			 pRope.SetAttachedStartBody(pTop);
			 pRope.SetAttachedEndBody(pWeight);
			 
			 /////////////////////
			 // Get arm attach pos
			 cMatrixf mtxInvWorld = cMath_MatrixInverse(pArm.GetMatrix());
			 mvWaterTankArmAttachPos = cMath_MatrixMul(mtxInvWorld, pTop.GetWorldPosition());
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_SetupWaterTankChain(const tString &in asTimer)
		 {
			 SetWaterTankStuck(false);
		 }
		 
		 //-------------------------------------------------------
		 
		 void UpdateWaterTank(float afTimeStep)
		 {			
			if (mbUpdateWaterTank == false)
				return;
 
			////////////////////////
			// Set up vars
			iLuxEntity@ pTankArm = cLux_ID_Prop(m_idWaterTankArm);
			iPhysicsBody@ pChainTop = cLux_ID_Body(m_idWaterTankChainTopBody);
			iPhysicsRope@ pRope = mBaseObj.GetPhysicsWorld().GetRopeFromUniqueID(mlRopeId);
			 
			///////////////////////
			// Get chain position on spline
			float fHorizontalT = Wheel_GetRotationAmount("WaterTankWheel_Horizontal");
			float fVerticalT = Wheel_GetRotationAmount("WaterTankWheel_Vertical");
			
			int lSegments = mvWaterTankPoints.size() > 4 ? 1 + (mvWaterTankPoints.size() - 4) : 0;
			float fSegmentChainT = cMath_Clamp(lSegments * fHorizontalT, 0.f, lSegments - 0.000001f);
			
			int lId1 = 0 + fSegmentChainT;
			int lId2 = 1 + fSegmentChainT;
			int lId3 = 2 + fSegmentChainT;
			int lId4 = 3 + fSegmentChainT;
			
			float fCurrSegmentT = fSegmentChainT % 1;			
			cVector3f vPos = cMath_Vector3CatmullRom(mvWaterTankPoints[lId1], mvWaterTankPoints[lId2], mvWaterTankPoints[lId3], mvWaterTankPoints[lId4], fCurrSegmentT);			
			
			cVector3f vOffset = pTankArm.GetMatrix().GetTranspose().GetUp() * (fHorizontalT > 0.5f ? 1.1f : 1.5f);			
			vOffset *= cMath_Easing(eEasing_ExpoOut, fVerticalT);
			vOffset.y += 8.f * fVerticalT + 0.35f;
			vPos += vOffset;
			
			///////////////////////
			// Set chain position
			cVector3f vChainDelta = vPos - pChainTop.GetWorldPosition();
			pChainTop.StaticLinearMove(vChainDelta / afTimeStep);
			
			////////////////////////
			// Bucket sound
			float fChainDeltaSqrLength = vChainDelta.SqrLength();			
			if (fChainDeltaSqrLength > 0.f && m_idWaterTankSound == tID_Invalid)
			{
				if (Sound_Exists("Sound_BucketMove") == false)
				{
					Sound_CreateAtEntity("Sound_BucketStart", "02_05_cistern/water_bucket/bucket_start", "WaterTank_Arm");
					Sound_CreateAtEntity("Sound_BucketMove", "02_05_cistern/water_bucket/bucket_move", "WaterTank_Arm");
					
					cSoundEntity@ pSound = mBaseObj.GetWorld().GetSoundEntity("Sound_BucketMove");
					if (pSound !is null)
						m_idWaterTankSound = pSound.GetID();
				}
				else
				{
					Sound_Stop("Sound_BucketMove", 0.f);
				}
			}
			else if (fChainDeltaSqrLength <= 0.f && m_idWaterTankSound != tID_Invalid)
			{
				Sound_CreateAtEntity("Sound_BucketStop", "02_05_cistern/water_bucket/bucket_stop", "WaterTank_Arm");
				
				cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idWaterTankSound);
				if (pSound is null)
					@pSound = mBaseObj.GetWorld().GetSoundEntity("Sound_BucketMove");
				if (pSound !is null)
					pSound.Stop(true);
					
				m_idWaterTankSound = tID_Invalid;
			}

			///////////////////////
			// Set arm pos and rot
			cMatrixf mtxArm = pTankArm.GetMatrix();			
			cVector3f vArmAttachPos = cMath_MatrixMul(mtxArm, mvWaterTankArmAttachPos);
			cVector3f vArmDelta = vPos - vArmAttachPos;
			cVector3f vArmPos = pTankArm.GetPosition() + vArmDelta;
			
			float fMinArmRotY = cMath_ToRad(240.f);
			float fMaxArmRotY = cMath_ToRad(290.f);
			float fArmRotY = fMinArmRotY + fHorizontalT * (fMaxArmRotY - fMinArmRotY);
			cVector3f vArmRot = cVector3f(cMath_ToRad(90.f), fArmRotY, cMath_ToRad(180.f));
			
			mtxArm.SetRotation(cMath_MatrixRotateXYZ(vArmRot));
			mtxArm.SetTranslation(vArmPos);
			pTankArm.SetMatrix(mtxArm);
			
			///////////////////////
			// Put chain at rope links
			// TODO: Can we fix so we can bind a rigged mesh to the verlet rope instead?
			int lRopeParticleId = 1;
			for (int i = 0; i < mvChainPartIds.size(); ++i)
			{
				iLuxEntity@ pChainPart = cLux_ID_Entity(mvChainPartIds[i]);
				
				for (int j = 0; j < pChainPart.GetBodyNum(); ++j)
				{
					iPhysicsBody@ pChainPartBody = pChainPart.GetBody(j);
					
					if (i == mvChainPartIds.size() - 1 && j == 0)
						lRopeParticleId--;
						
					cVerletParticle@ pParticle = pRope.GetParticle(lRopeParticleId);
					lRopeParticleId++;
					
					if (pParticle is null)
						continue;
					
					if (i == 0 || (mbWaterTankStuck == false || j < 2))
					{
						cVector3f vLinDelta = pParticle.GetPosition() - pChainPartBody.GetWorldPosition();
						pChainPartBody.StaticLinearMove(vLinDelta / afTimeStep);
						
						cVector3f vAngDelta = cMath_GetAngleDistanceVector3fRad(cMath_MatrixToEulerAngles(pChainPartBody.GetWorldMatrix().GetRotation()), cVector3f(0.f, cMath_PiDiv4, 0.f));
						pChainPartBody.StaticAngularMove(vAngDelta / afTimeStep);
					}
				}
			}
			
			///////////////////////
			// Handle stuck tank
			iPhysicsBody@ pWeight = cLux_ID_Body(m_idWaterTankWeightBody);
			cVector3f vRopeStart = pRope.GetStartParticle().GetPosition();
			cVector3f vRopeEnd = pRope.GetEndParticle().GetPosition();
			float fRopeDistSqr = (vRopeStart - vRopeEnd).SqrLength();
			float fMaxRopeDistSqr = 10.5f * 10.5f;
				
			if (mbWaterTankStuck)
			{
				if (fVerticalT <= 0.001f)
				{
					Prop_SetStaticPhysics("BucketChain_2", true);
					Entity_SetCollideCharacter("BucketChain_2", false);
				}
				
				//////////////////
				// Position bucket on the flow pipe
				cVector3f vPosGoal = cVector3f(22.302f, -26.26f, -7.234f);
				cVector3f vAngGoal = cVector3f(-0.007f, -1.407f, 0.07f);
				
				cVector3f vLinDelta = vPosGoal - pWeight.GetWorldPosition();
				cVector3f vAngDelta = cMath_GetAngleDistanceVector3fRad(cMath_MatrixToEulerAngles(pWeight.GetWorldMatrix().GetRotation()), vAngGoal);
				pWeight.StaticLinearMove(vLinDelta * afTimeStep * 100.f);
				pWeight.StaticAngularMove(vAngDelta * afTimeStep * 100.f);				
								
				//////////////////
				// Chain stectched, no longer stuck!
				if (fRopeDistSqr > fMaxRopeDistSqr)
				{
					SetWaterTankStuck(false);
					return;
				}
			}
			else
			{
				// Add a constant small downward force to make the bucket behave better
				pWeight.AddImpulse(cVector3f(0.f, -0.35f, 0.f));
			}
			
			///////////////////////
			// Fix so the tank doesn't bounce when hitting the pipes
			if (mbWaterTankTopCollide)
			{
				iPhysicsBody@ pWeight = cLux_ID_Body(m_idWaterTankWeightBody);
				cVector3f vVel = pWeight.GetLinearVelocity();
				vVel.y = cMath_Min(vVel.y, 0.f);
				pWeight.SetLinearVelocity(vVel);
			}
			
			///////////////////
			// Ease in strength after unstuck for smoother movement
			float fChainStrength = (cMath_Clamp(500.f * (fRopeDistSqr / fMaxRopeDistSqr), 100.f, 500.f));
			pRope.SetStrength(fChainStrength);
		 }
		 
		 //-------------------------------------------------------
		 
		 void SetWaterTankStuck(bool abX)
		 {
			 mbWaterTankStuck = abX;			
			 
			 Prop_SetStaticPhysics("WaterTank_Weight", abX);
			 Entity_SetActive("BlockBox_TankBridge", abX);			 
			 Entity_SetCollide("BucketChain_*", abX);
			 
			 iLuxEntity@ pChain = cLux_ID_Entity(mvChainPartIds[1]);
			 for (int i = 0; i < pChain.GetBodyNum(); ++i)
			 {
				 iPhysicsBody@ pBody = pChain.GetBody(i);
				 if (i > 1 && i != pChain.GetBodyNum() - 1)
					 pBody.SetMass(abX ? 1.f : 0.f);
			 }			 
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnInteract_WaterTankWheelHorizontal(const tString &in asEntity)
		 {		
			 Map_RemoveTimer(asEntity);
			 Map_AddTimer(asEntity, 0.1f, "OnTimer_UpdateWaterTankWheelHorizontal");
			 
			 //Sound_CreateAtEntity("Sound_BucketStart", "02_05_cistern/water_bucket/bucket_start", "WaterTank_Arm");
			 //Sound_CreateAtEntity("Sound_BucketMove", "02_05_cistern/water_bucket/bucket_move", "WaterTank_Arm");
		 }
		 
		 //-------------------------------------------------------
		 
		 void OnTimer_UpdateWaterTankWheelHorizontal(const tString &in asTimer)
		 {
			 //////////////
			 // Limit horizontal movement if elevated!
			 if (Entity_IsInteractedWith(asTimer))
			 {
				 float fVerticalT = Wheel_GetRotationAmount("WaterTankWheel_Vertical");
				 bool bIsJammed = Wheel_GetJammed(asTimer);
				 bool bJam = fVerticalT > 0.05f || mbWaterTankStuck;
				 
				 if (bJam != bIsJammed)
				 {
					 float fAngle = Wheel_GetCurrentAngle(asTimer);
					 Wheel_SetJammed(asTimer, bJam, fAngle - 2.5f, fAngle + 2.5f);
				 }
				 
				 float fHorizontalT = Wheel_GetRotationAmount("WaterTankWheel_Horizontal");
				 if (fHorizontalT >= 1.f && mfPrevWaterTankWheelHorizontalT < 1.f ||
					 fHorizontalT <= 0.f && mfPrevWaterTankWheelHorizontalT > 0.f)
				 {
					 Sound_CreateAtEntity("Sound_TankBlocked", "02_05_cistern/water_bucket/bucket_stop", "WaterTank_Arm");
					 tString sArea = fHorizontalT >= 1.f ? "Area_TankBlockedRight" : "Area_TankBlockedLeft";
					 ParticleSystem_CreateAtEntity("PS_TankBlocked", "dust_impact_simple_oneshot.ps", sArea, false);
				 }
				 
				 mfPrevWaterTankWheelHorizontalT = fHorizontalT;
				 
				 Map_RestartCurrentTimer();
				 return;
			 }
			 
			 //////////////
			 // Align to regulator positions!
			 float fT = Wheel_GetRotationAmount(asTimer);
			 if (fT <= 0.1f)						Wheel_SetAngle(asTimer, cMath_ToRad(-360.f), true);
			 else if (fT > 0.475f && fT < 0.65f)	Wheel_SetAngle(asTimer, cMath_ToRad(-360.f + 0.55f * 360.f), true);
		 }
	 
		 //-------------------------------------------------------
		 
		 void OnInteract_WaterTankWheelHorizontalStop(const tString &in asEntity)
		 {			 
			//Sound_Stop("Sound_BucketMove", 0.0f);
			//Sound_CreateAtEntity("Sound_BucketStop", "02_05_cistern/water_bucket/bucket_stop", "WaterTank_Arm");
		 }
	 
		 //-------------------------------------------------------
		 
		 //} END Event C *Turn the HORIZONTAL WATER TANK WHEEL*
		 
		 /////////////////////////////////////////
		 // Event D *Turn the VERTICAL WATER TANK WHEEL*
		 //{//////////////////////////////////////
	 
		 //-------------------------------------------------------
	 
		 /*Put any variables that are only used in Scene 5, Event D here.*/
		 
		 float mfPrevWaterTankWheelVerticalAngle = 0.f;	
		
		 //-------------------------------------------------------
	 
		 /*Put any functions that are only used in Scene 5, Event D here.*/
		 
		 void OnInteract_WaterTankWheelVertical(const tString &in asEntity)
		 {		
			 Map_RemoveTimer(asEntity);
			 Map_AddTimer(asEntity, 0.1f, "OnTimer_UpdateWaterTankWheelVertical");
			 
			 //Sound_CreateAtEntity("Sound_BucketStart", "02_05_cistern/water_bucket/bucket_start", "WaterTank_Arm");
			 //Sound_CreateAtEntity("Sound_BucketMove", "02_05_cistern/water_bucket/bucket_move", "WaterTank_Arm");			 
		 }
		 
		 //-------------------------------------------------------
		
		 void OnTimer_UpdateWaterTankWheelVertical(const tString &in asTimer)
		 {
			 //////////////
			 // Limit vertical movement if not by regulators!
			 if (Entity_IsInteractedWith(asTimer))
			 {				 
				 float fHorizontalT = Wheel_GetRotationAmount("WaterTankWheel_Horizontal");
				 float fVerticalT = Wheel_GetRotationAmount(asTimer);
				 float fVerticalAngle = Wheel_GetCurrentAngle(asTimer);
				 
				 bool bIsJammed = Wheel_GetJammed(asTimer);				 
				 bool bJam = false;
				 
				 float fMaxAngle = 720.f;
				 
				 if (cMath_Abs(fHorizontalT - 0.f) > 0.01f && cMath_Abs(fHorizontalT - 0.55f) > 0.01f && fVerticalT >= 0.015f || // Not at regulators
					fHorizontalT <= 0.01f && fVerticalT >= 0.3f)  // At blocker by first regulator
				 {
					bJam = true;
					fMaxAngle = fVerticalAngle;
				 }
				 
				 if (bJam != bIsJammed && mbWaterTankTopCollide == false)
					 Wheel_SetJammed(asTimer, bJam, 0.f, fMaxAngle);	 
				 
				 Prop_SetStaticPhysics("BucketChain_2", false);
				 Entity_SetCollideCharacter("BucketChain_2", true);
				 
				 //////////////
				 // Feedback if at limit!
				 if (bJam && bIsJammed == false)
				 {					 
					 Sound_CreateAtEntity("Sound_TankBlocked", "02_05_cistern/water_bucket/bucket_stuck", "WaterTank_Arm");
					 ParticleSystem_CreateAtEntity("PS_TankBlocked", "dust_impact_simple_oneshot.ps", "Area_ArmBlockedTop", false);
				 }
				 
				 if (fVerticalT >= 1.f && mfPrevWaterTankWheelVerticalT < 1.f ||
					 fVerticalT <= 0.f && mfPrevWaterTankWheelVerticalT > 0.f)
				 {
					 Sound_CreateAtEntity("Sound_TankBlocked", "02_05_cistern/water_bucket/bucket_stop", "WaterTank_Arm");
				 }
				 
				 mfPrevWaterTankWheelVerticalT = fVerticalT;
				 mfPrevWaterTankWheelVerticalAngle = fVerticalAngle;
				 
				 Map_RestartCurrentTimer();
				 return;
			 }
			 			 
			 //////////////
			 // Auto move to lowest position!
			 Wheel_SetAngle(asTimer, cMath_ToRad(-360.f), true);
	 	 }
		 
		 //-------------------------------------------------------
		 
		 bool OnTrigger_SetChainBoneInteractable(const tString &in asParent, const tString &in asChild, int alState)
		 {
			 if (alState == -1)
			 {
				 Entity_SetInteractionDisabled("ChainBone", false);
				 Prop_SetStaticPhysics("ChainBone", false);
			 }
			 else if (Entity_GetCollide("ChainBone", asParent))
			 {
				 Entity_SetInteractionDisabled("ChainBone", true);
				 Prop_SetStaticPhysics("ChainBone", true);
			 }
			 return true;
		 }
	 
		 //-------------------------------------------------------
		 
		 void OnInteract_WaterTankWheelVerticalStop(const tString &in asEntity)
		 {			 
			//Sound_Stop("Sound_BucketMove", 0.0f);
			//Sound_CreateAtEntity("Sound_BucketStop", "02_05_cistern/water_bucket/bucket_stop", "WaterTank_Arm");
		 }
