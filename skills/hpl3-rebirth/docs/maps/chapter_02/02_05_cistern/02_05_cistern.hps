//--------------------------------------------------

enum eCisternPermaFailStage
{
	eCisternPermaFailStage_TopFloor = 0,
	eCisternPermaFailStage_FallTop = 1,
	eCisternPermaFailStage_Workshop = 2,
	eCisternPermaFailStage_Lizard = 3,
	eCisternPermaFailStage_FallMiddle = 4,
	eCisternPermaFailStage_AfterPuzzle = 5,
	eCisternPermaFailStage_NastyTunnel = 6,
	eCisternPermaFailStage_EerieQuiet = 7,
	eCisternPermaFailStage_CrawlChase = 8,
	eCisternPermaFailStage_CrawlChaseEnd = 9,
	eCisternPermaFailStage_FlowConnection = 10,
	eCisternPermaFailStage_Passage = 11
};

//--------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("02-05-cistern");
		
		// Set up color grading etc.
		
		Pregnancy_SetStage(ePregStage_Stage1);
		Pregnancy_SetBarksActive(true);
		Pregnancy_SetBabyTalkStage(eBabyTalkStage_CavesToCisternStart);
		Pregnancy_SetBabyKicksEnabled(false);
		GhoulProgression_SetBarkStage(eGhoulBarkStage_Ill);
		Player_SetAllowCheckBaby(true);
		FearHandler_SetWhisperStage(eFearWhisperStage_RadioToBabyKick);
		
		StruggleFlashHandler_SetActive(true);
		StruggleFlashHandler_PreloadFlashGroupTextures(0);
		StruggleFlashHandler_SetProgression(0);
		
		Player_SetAutoTeleportWhenBelowAltitude(-60.f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		//ParticleSystem_Preload("some_particle.ps");
		ParticleSystem_Preload("dust_impact_simple_oneshot.ps");
		ParticleSystem_Preload("splash_small_oneshot.ps");
		ParticleSystem_Preload("splash_medium_oneshot.ps");
		ParticleSystem_Preload("crawl_chase_bubbles.ps");
		ParticleSystem_Preload("ripples_impact_small.ps");
		ParticleSystem_Preload("sparks_tiny.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
		
		//////////////
		// Preload sounds
		//Sound_PreloadProject("02_05_cistern");
		
		Sound_PreloadGhost();
		Sound_PreloadEvent("level_entity_shared/fire/fire_ignite/wall_torch_ignite");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		//Set GhoulProgresison limit
		GhoulProgression_SetLimit(6);
		
		// Any general setup of script / entities
		
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{			
			if (ItemType_GetCountInInventory("Matchbook") < 1)
			{
				Item_AddToInventory("Matchbook");
				Item_SetContent(ItemType_GetFirstInInventory("Matchbook"), "Matches", 10);
			}		
					
			Item_AddToInventory("HerbertOil");
			
			if (ItemType_GetCountInInventory("Lantern") < 1)
			{
				Item_AddToInventory("Lantern");
				Item_SetContent(ItemType_GetFirstInInventory("Lantern"), "Oil", 10);
			}
		}		
		
		//////////////////////
		// Set up permafails
		mlPermaFailStage = eCisternPermaFailStage_TopFloor;
		
		/////////////////////
		// Set up rainwater hub
		Entity_PlayProcAnimation("TurretLockMechanism", "Lock", -1.f);
		Entity_AttachToEntity("InteractAux_TurretLever", "Turret", "Body_1", true);
		Entity_SetCollideCharacter("Turret", false);
		
		Entity_StopAnimation("Gun_Animated");
		
		ParticleSystem_SetActive("PS_Turret_*", false);		
		ParticleSystem_AttachToEntity("PS_RainWaterSplash_*", "Liquid_RainwaterHub_1");
		
		PhysicsSlideDoor_SetIgnoreInteractConnectionIfJammed("RainwaterRegulator", true);
		
		/////////////////////
		// Set up top level
		Player_SetVertigoActive(false);
		
		PhysicsSlideDoor_SetIgnoreInteractConnectionIfJammed("FlowRegulator_Top_1", true);
		PhysicsSlideDoor_SetIgnoreInteractConnectionIfJammed("FlowRegulator_Top_2", true);
		
		/////////////////////
		// Set up lizard encounter
		Entity_PlayAnimation("Lizard", "start_idle", 0.f, true);		
		Ghoul_SetAllowPlayerThrow("Ghoul_Lizard", true);
		
		/////////////////////
		// Set up water tank puzzle		
		Entity_SetActive("Ghoul_TunnelScare", true);
		Entity_PlayAnimation("Ghoul_TunnelScare", "crawl", 0.f, true, false);
		Map_GetEntity("Ghoul_TunnelScare").GetMeshEntity().GetAnimationStateFromName("crawl").SetSpeed(0.f);
		
		cLux_ToProp(Map_GetEntity("FlowPipeWheel_Middle")).AddInteractConnection("FlowRegulator_Middle_1", cLux_ToProp(Map_GetEntity("FlowRegulator_Middle_1")), false);
		PhysicsSlideDoor_SetMaxOpenAmount("FlowRegulator_Middle_1", 0.1f);
		PhysicsSlideDoor_SetMinOpenAmount("FlowRegulator_Middle_1", 0.035f);
		PhysicsSlideDoor_SetOpenAmount("FlowRegulator_Middle_1", 0.035f);
		
		Wheel_SetLinearAutoMove("WaterTankWheel_Vertical", true);
		Wheel_SetAngle("WaterTankWheel_Horizontal", cMath_ToRad(-65.f), true);
				
		Entity_AttachToEntity("InteractAux_ChainPipe", "ChainPipe", "", true);
		
		for (int i = 1; i < 11; i++)
			mvWaterTankPoints.push_back(Map_GetEntity("Area_WaterTankPoint_" + i).GetPosition());
			
		SetupWaterTank();
		Map_AddTimer("Timer_SetupWaterTankChain", 0.1f, "OnTimer_SetupWaterTankChain");
		
		PhysicsSlideDoor_SetIgnoreInteractConnectionIfJammed("FlowRegulator_Middle_1", true);
		PhysicsSlideDoor_SetIgnoreInteractConnectionIfJammed("FlowRegulator_Middle_2", true);
		
		/////////////////////
		// Set up treasure trove encounter		
		Light_SetBrightness("Light_Spot_TreasureTroveGrating", 0.f);
		
		//////////////////////
		// Set up chase
		PhysicsSlideDoor_SetOpenAmount("FlowRegulator_Chase_*", 0.f);
		Entity_AttachToEntity("InteractAux_LooseGrating_1", "LooseGrating_1", "Body_1", true);
		Entity_AttachToEntity("InteractAux_LooseGrating_2", "LooseGrating_2", "Body_1", true);
		
		//////////////////////
		// Set up bottom
		for (int i = 1; i < 4; ++i)
		{
			cFogArea@ pFog = mBaseObj.GetWorld().GetFogArea("FogArea_BottomHole_" + i);
			if (pFog !is null)
				pFog.SetRenderFlagBit(eRenderableFlag_VisibleInReflection, false);
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		cLux_ClearAllMapSaveData();
		Game_AutoSave();
		
		// Setup physics world
		cLuxArea@ pArea = cLux_ToArea(mBaseObj.GetEntityByName("Area_PhysicsWorld", eLuxEntityType_Area));
		cBoundingVolume@ pAreaBounds = pArea.GetAreaBody().GetBoundingVolume();
		mBaseObj.GetPhysicsWorld().SetWorldSize(pAreaBounds.GetMin(), pAreaBounds.GetMax());
		
		Achievement_Unlock(eAchievement_Gunner);
				
        Heat_SetActive(false);
		FearHandler_SetActive(true);
		FearHandler_SetPermaFailEnabled(true);
		
		Player_SetMapDeepShadow(0.1f);
		Player_SetNightVisionBrightness(2.2f);
		
		PlayerBody_SetActive(true);		
		
		Pregnancy_SetBabyTalkSpecialSubject("BabyTalk_AfterTankBeforeKick");
		
		////////////////////
		// Set up wake up
		if (cLux_ScriptDebugOn() == false)
			cScript_SetGlobalVarBool("Outpost_CourtyardComplete", true);
			
		if (cScript_GetGlobalVarBool("Outpost_CourtyardComplete"))
			Seq_WakeUp("");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
	}
	
	//-------------------------------------------------------
	
	void OnDamageTaken(const tString &in asSource, int alType)
	{
		if (alType == eDamageType_Silent && asSource == "Ghoul_Sniffing")
		{
			++mlTreasureTroveHitCount;
		}
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFail(const tString &in asSource)
	{
		FearHandler_ClearPermaFailScenes();
		
		///////////////
		// Despawn Treasure Trove ghoul?
		if (mlTreasureTroveHitCount >= 3 && mlPermaFailStage == eCisternPermaFailStage_NastyTunnel)
			mlPermaFailStage = eCisternPermaFailStage_EerieQuiet;
		
		mlTreasureTroveHitCount = 0;
		
		///////////////
		// Setup permafail
		switch (mlPermaFailStage)
		{
			case eCisternPermaFailStage_TopFloor:			return OnPermaFail_TopFloor(asSource);
			case eCisternPermaFailStage_FallTop:			return OnPermaFail_FallTop(asSource);
			case eCisternPermaFailStage_Workshop:			return OnPermaFail_Workshop(asSource);
			case eCisternPermaFailStage_Lizard:				return OnPermaFail_Lizard(asSource);
			case eCisternPermaFailStage_FallMiddle:			return OnPermaFail_FallMiddle(asSource);
			case eCisternPermaFailStage_AfterPuzzle:		return OnPermaFail_AfterPuzzle(asSource);
			case eCisternPermaFailStage_NastyTunnel:		return OnPermaFail_NastyTunnel(asSource);
			case eCisternPermaFailStage_EerieQuiet:			return OnPermaFail_EerieQuiet(asSource);
			case eCisternPermaFailStage_CrawlChase:			return OnPermaFail_CrawlChase(asSource);
			case eCisternPermaFailStage_CrawlChaseEnd:		return OnPermaFail_CrawlChaseEnd(asSource);
			case eCisternPermaFailStage_FlowConnection:		return OnPermaFail_FlowConnection(asSource);
			case eCisternPermaFailStage_Passage:			return OnPermaFail_Passage(asSource);
		}		
		
		return true;
	}
	
	//-------------------------------------------------------
	
	bool OnPermaFailRespawn()
	{		
		switch (mlPermaFailStage)
		{
			case eCisternPermaFailStage_CrawlChase:				return OnPermaFailRespawn_CrawlChase();
			case eCisternPermaFailStage_CrawlChaseEnd:			return OnPermaFailRespawn_CrawlChaseEnd();
		}
	
		return true;
	}
	
	//-------------------------------------------------------
	
	array<int> mvUnplayedGenericPermaFails = { 1, 2, 3 };	
	void SetupGenericPermaFail()
	{
		if (mvUnplayedGenericPermaFails.size() == 0)
		{
			for (int i = 1; i < 4; i++)
				mvUnplayedGenericPermaFails.push_back(i);
		}
			
		int lId = cMath_RandRectl(0, mvUnplayedGenericPermaFails.size() - 1);
		int lSceneId = mvUnplayedGenericPermaFails[lId];
		mvUnplayedGenericPermaFails.removeAt(lId);
		
		tString sAreaBase = "Area_PermaFail_Generic";		
		switch (lSceneId)
		{
			case 1:
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_1", sAreaBase + "_1_End_1", 3.f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_2", sAreaBase + "_1_End_2", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_1_Start_3", sAreaBase + "_1_End_3", 1.5f, 2.25f, true, true);
				break;
			case 2:
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_1", sAreaBase + "_2_End_1", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_2", sAreaBase + "_2_End_2", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_2_Start_3", sAreaBase + "_2_End_3", 3.f, 2.25f, true);
				break;
			case 3:
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_1", sAreaBase + "_3_End_1", 3.5f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_2", sAreaBase + "_3_End_2", 3.f, 2.25f, true);
				FearHandler_AddPermaFailScene(sAreaBase + "_3_Start_3", sAreaBase + "_3_End_3", 2.f, 2.25f, true);
				break;
		}
	}
	
