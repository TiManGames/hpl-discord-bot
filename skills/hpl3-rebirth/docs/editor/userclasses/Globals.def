		<Component Name="Fullness">
			<TypeVars>
				<Group Name="Fullness">
					<Var Name="UseFullnessAnimation" Type="Bool" DefaultValue="false" Description="Use fullness animations" />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="CurseRadiator">
			<TypeVars>
				<Group Name="CurseRadiator">
					<Var Name="CurseRadiator_Radius" Type="Float" DefaultValue="10" Description="Radius of the radiation. Can be overridden by the entity instance." />
					<Var Name="CurseRadiator_MinRadius" Type="Float" DefaultValue="2" Description="Distance from the center of the entity where radiation is at its max. Can be overridden by the entity instance." />
					<Var Name="CurseRadiator_Intensity" Type="Float" DefaultValue="0.045" Description="Intensity of the radiation. Measured in Lucidity per second at 0 distance." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="CurseRadiator">
					<Var Name="CurseRadiator_Active" Type="Bool" DefaultValue="true" Description="If the entity should radiate curse, reducing the player's lucidity." />
					<Var Name="CurseRadiator_Custom_Radius" Type="Float" DefaultValue="-1" Description="Custom radius of the radiation. -1 uses the radius set in the .ent file." />
					<Var Name="CurseRadiator_Custom_MinRadius" Type="Float" DefaultValue="-1" Description="Custom min radius of the radiation. -1 uses the min radius set in the .ent file." />
					<Var Name="CurseRadiator_IntensityMul" Type="Float" DefaultValue="1" Description="Intensity multiplier for the radiator." />
					<Var Name="CurseRadiator_LowIntensity" Type="Bool" DefaultValue="false" Description="If true, intensity is ignored and only the low radiation zone with a default radiation value is used." />
				</Group>
			</InstanceVars>
		</Component>
    <Component Name="FootPlacement">
      <TypeVars>
        <Group Name="FootPlacement">
          <Var Name="FootPlacement_AlignPelvis" Type="Bool" DefaultValue="true" Description="If the whole body should move closer to the ground. Help with floating"/>
          <Var Name="FootPlacement_MaxPelvisAlign" Type="Float" DefaultValue="0.5" Description="How much the pelvis can be moved downward" /> 
          <Var Name="FootPlacement_AlignToes" Type="Bool" DefaultValue="false" Description="Should the toes rather than the heels be used for foot placement. Useful for weird monsters"/>      
          <Var Name="FootPlacement_FootDepth" Type="Float" DefaultValue="0.05" Description="How far the feet can be placed below the animation pose"/>
          <Var Name="FootPlacement_MaxFootHeight" Type="Float" DefaultValue="0.25" Description="How far below the hips the max placement of the feet is"/>
          <Var Name="FootPlacement_FadeSpeed" Type="Float" DefaultValue="8.0" Description="How fast to fade in and out footplacement"/>
          <Var Name="FootPlacement_LeftFoot" Type="String" DefaultValue=""  	Description="Bone name for the left foot. Select the bone that connects to the knee. It is possible to add a more detailed heirarchy by adding more bones with space in between. Foot -> Knee -> Hip" />
          <Var Name="FootPlacement_RightFoot" Type="String" DefaultValue=""  	Description="Bone name for the right foot. Select the bone that connects to the knee. It is possible to add a more detailed heirarchy by adding more bones with space in between. Foot -> Knee -> Hip " />
          <Var Name="FootPlacement_FrontLeftFoot" Type="String" DefaultValue=""  	Description="Bone name for the front left foot. Only use this for quadped actors. It is possible to add a more detailed heirarchy by adding more bones with space in between. Foot -> Knee -> Hip " />
          <Var Name="FootPlacement_FrontRightFoot" Type="String" DefaultValue=""  	Description="Bone name for the front right foot. Only use this for quadped actors. It is possible to add a more detailed heirarchy by adding more bones with space in between. Foot -> Knee -> Hip" />  
		  <Var Name="FootPlacement_FootOffset" Type="Vector3" DefaultValue="0 0 0" Description="Offset from foot bone"/>
    </Group>
      </TypeVars>
    </Component>
    <Component Name="HandPlacement">
      <TypeVars>
        <Group Name="HandPlacement">
          <Var Name="HandPlacement_FadeSpeed" Type="Float" DefaultValue="4.0" Description="How fast to fade in and out placement"/>
          <Var Name="HandPlacement_MaxAngleToTarget" Type="Float" DefaultValue="180.0" Description="Maxmimum angle between the target and the whole body"/>
          <Var Name="HandPlacement_LeftHand" Type="String" DefaultValue=""  	Description="Bone name for the left wrist. Select the bone that connects to the elbow. It is possible to add a more detailed heirarchy by adding more bones with space in between. Wrist -> Elbow -> Shoulder" />
          <Var Name="HandPlacement_LeftHandOffset" Type="Vector3" DefaultValue="0 0 0"  	Description="Offset from the hand bone to the middle of the palm" />
          <Var Name="HandPlacement_LeftHandRotation" Type="Vector3" DefaultValue="0 0 0"  	Description="Rotation of the hand from (0, 1, 0)" />
          <Var Name="HandPlacement_LeftHandTwist" Type="Vector3" DefaultValue="0 0 0"  	Description="Twist of the hand form (0, 1, 0)" />
          <Var Name="HandPlacement_LeftHandTest" Type="Vector3" DefaultValue="0 0 0"  	Description="" />
		  
		  <Var Name="HandPlacement_RightHand" Type="String" DefaultValue=""  	Description="Bone name for the right wrist. Select the bone that connects to the elbow. It is possible to add a more detailed heirarchy by adding more bones with space in between. Wrist -> Elbow -> Shoulder " />
          <Var Name="HandPlacement_RightHandOffset" Type="Vector3" DefaultValue="0 0 0"  	Description="Offset from the hand bone to the middle of the palm" />
          <Var Name="HandPlacement_RightHandRotation" Type="Vector3" DefaultValue="0 0 0"  	Description="Rotation of the hand from (0, 1, 0)" />
          <Var Name="HandPlacement_RightHandTwist" Type="Vector3" DefaultValue="0 0 0"  	Description="Twist of the hand form (0, 1, 0)" />
		  <Var Name="HandPlacement_RightHandTest" Type="Vector3" DefaultValue="0 0 0"  	Description="" />
      </Group>
      </TypeVars>
    </Component>
		<Component Name="_Temp_Burn">
			<TypeVars>
				<Group Name="_Temp_Burn">
					<Var Name="BurnPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 		Description="The burn components particle system." />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="_Temp_Fire">
			<TypeVars>
				<Group Name="Fire">
					<Var Name="FireParticleSystem" Type="String" DefaultValue="fire_object.ps" Description="Name of the particle system to be used."/>
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Fire">
					<Var Name="TurnOnWhenInteracting" Type="Bool" DefaultValue="false" Description="If true, it will only burst in flames if interacted with."/>
					<Var Name="StartOn" Type="Bool" DefaultValue="true" Description="If true, it will start with on when interacting mode is not on."/>
				</Group>
			</InstanceVars>
		</Component>

		<Component Name="FearScaryObject">
			<TypeVars>
				<Group Name="Fear_ScaryObject">
					<Var Name="ScaryObject_BaseFearRate" Type="Float" DefaultValue="0.1" Description="How much FEAR RATE the object will add once activated." />
					<Var Name="ScaryObject_SurpriseFactor" Type="Float" DefaultValue="-1.0" Description="How much FEAR RATE the object will add when first seen. If the value is negative, 1.0x * BaseFearRate will be used." />
					<Var Name="ScaryObject_LookAtFactor" Type="Float" DefaultValue="-1.0" Description="How much FEAR RATE the object will add when being looked at. If the value is negative, 1.0x * BaseFearRate will be used." />
					<Var Name="ScaryObject_ActivationDelay" Type="Float" DefaultValue="0.2" Description="How long the object will have to be viewed before it starts adding FEAR RATE." />
					<Var Name="ScaryObject_ActivationLightLevel" Type="Float" DefaultValue="0.1" Description="How bright the object needs to be to activate. If the value is negative, light level won't be checked." />

					<Var Name="ScaryObject_ActivationDistance" Type="Float" DefaultValue="3.5" Description="Distance at which the object will start adding FEAR RATE." />
					<Var Name="ScaryObject_DeactivationDistance" Type="Float" DefaultValue="3.5" Description="Distance at which the object will stop adding FEAR RATE." />
					<Var Name="ScaryObject_InteractFactor" Type="Float" DefaultValue="-1.0" Description="How much FEAR RATE the object will add when interacted with. If the value is negative, 1.0x * BaseFearRate will be used." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Fear_ScaryObject">
					<Var Name="ScaryObject_Enabled" Type="Bool" DefaultValue="false" Description="If the entity should behave as a scary object." />
					<Var Name="ScaryObject_BaseFearRateMultiplier" Type="Float" DefaultValue="1.0" Description="Value that the BaseFearRate of the entity type will be multiplied by." />
					<Var Name="ScaryObject_ActivationCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="" Description="Called when the object is activated and starts adding FEAR RATE. Syntax: void Func(const tString &in asEntity)" />
					<Var Name="ScaryObject_DeactivationCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="" Description="Called when the object is deactivated and stops adding FEAR RATE. Syntax: void Func(const tString &in asEntity)" />
				</Group>
			</InstanceVars>
		</Component>

		<Component Name="FearThreat">
			<TypeVars>
				<Group Name="Fear_Threat">
					<Var Name="Threat_BaseFearRate" Type="Float" DefaultValue="0.1" Description="How much FEAR RATE the object will add once activated when at MaxFearDistance or closer." />
					<Var Name="Threat_SurpriseFactor" Type="Float" DefaultValue="-1.0" Description="How much FEAR RATE the object will add when first seen. If the value is negative, 1.0x * BaseFearRate will be used." />
					<Var Name="Threat_LookAtFactor" Type="Float" DefaultValue="-1.0" Description="How much FEAR RATE the object will add when being looked at. If the value is negative, 1.0x * BaseFearRate will be used." />
					<Var Name="Threat_ActivationDelay" Type="Float" DefaultValue="0.2" Description="How long the object will have to be viewed before it starts adding FEAR RATE." />
					<Var Name="Threat_ActivationLightLevel" Type="Float" DefaultValue="0.1" Description="How bright the object needs to be to activate. If the value is negative, light level won't be checked." />

					<Var Name="Threat_MaxFearDistance" Type="Float" DefaultValue="2.0" Description="Distance at which BaseFearRate will be added" />
					<Var Name="Threat_MinFearDistance" Type="Float" DefaultValue="6.0" Description="Distance at which no FEAR RATE will be added" />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Fear_Threat">
					<Var Name="Threat_Enabled" Type="Bool" DefaultValue="false" Description="If the entity should behave as a threat." />
					<Var Name="Threat_BaseFearRateMultiplier" Type="Float" DefaultValue="1.0" Description="Value that the BaseFearRate of the entity type will be multiplied by." />
					<Var Name="Threat_ActivationCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="" Description="Called when the object is activated and starts adding FEAR RATE. Syntax: void Func(const tString &in asEntity)" />
					<Var Name="Threat_DeactivationCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="" Description="Called when the object is deactivated and stops adding FEAR RATE. Syntax: void Func(const tString &in asEntity)" />
				</Group>
			</InstanceVars>
		</Component>

	</Components>
</Globals>