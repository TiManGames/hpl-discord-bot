	<Components>
		<Component Name="CharMover">
			<TypeVars>
				<Group Name="CharMover">
					<Var Name="CharMover_IdleAnim" Type="String" DefaultValue=""  	Description="The animation used when idle. " />
					<Var Name="CharMover_WalkAnim" Type="String" DefaultValue=""  	Description="The animation used when waling. " />
					<Var Name="CharMover_RunAnim" Type="String" DefaultValue=""  	Description="The animation used when running. " />
					<Var Name="CharMover_BackwardAnim" Type="String" DefaultValue=""  	Description="The animation used when moving backwards. " />
					<Var Name="CharMover_IdleExtraAnim" Type="String" DefaultValue=""  	Description="Animation insterted during idle. This is just the base game and the actual animations shall end with suffix '1', '2', etc." />
					<Var Name="CharMover_IdleExtraMinWait" Type="Float" DefaultValue="4"  	Description="The minimum time before an extra animation starts" />
					<Var Name="CharMover_IdleExtraMaxWait" Type="Float" DefaultValue="10"  	Description="The maximum time before an extra animation starts" />
					<Var Name="CharMover_IdleExtraPauseProcedural" Type="Bool" DefaultValue="true"  	Description="If playing an extra animation stops any procedural, like headtracking (Does not apply to lip synch!)" />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="ClimbAnimations">
			<TypeVars>
				<Group Name="ClimbAnimations">
					<Var Name="ClimbAnimations_IdleToClimb" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_ClimbLeft" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_ClimbRight" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_ClimbUpLeft" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_ClimbUpRight" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_IdleToHang" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_HangToFall" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_Fall" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_FallToLand" Type="String" DefaultValue="" Description="" />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="HeadTracker">
			<TypeVars>
				<Group Name="HeadTracker">
					<Var Name="HeadTracker_Bones" Type="String" DefaultValue=""  	Description="A series of node names that will be used when turning head during tracking. Use $ to denote space in the names." />
					<Var Name="HeadTracker_BoneMuls" Type="String" DefaultValue=""	Description="A series of float numbers that are the amount of influence for each bone. Must be same number as bone names." />
					<Var Name="HeadTracker_ChestBone" Type="String" DefaultValue=""	Description="The bone that will be used to determine the direction of the character. If empty, mesh matrix is used." />
					<Var Name="HeadTracker_SpeedMul" Type="Float" DefaultValue="1"	Description="How fast the head will rotate relative to the angle distance of the target." />
					<Var Name="HeadTracker_MaxSpeed" Type="Float" DefaultValue="1"	Description="Max rotation speed." />
					<Var Name="HeadTracker_MaxAngle" Type="Float" DefaultValue="45"	Description="Max angle the head can move." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Headtracker">
					<Var Name="HeadTracker_TargetEntity" Type="String" DefaultValue=""	Description="The target of the head tracking. If '' then 'Player' will be used." />
					<Var Name="HeadTracker_Active" Type="Bool" DefaultValue="true"	Description="If headtracking is on or not." />
				</Group>
			</InstanceVars>
		</Component>
		<Component Name="Listener">
			<InstanceVars>
				<Group Name="Listener">
					<Var Name="Listener_Active" Type="Bool" DefaultValue="true"	Description="If this entity will react to sounds." />
				</Group>
			</InstanceVars>
		</Component>
		<Component Name="BackboneTail">
			<TypeVars>
				<Group Name="BackboneTail">
					<Var Name="Backbone_Bones" Type="String" DefaultValue="" 	Description="A list of strings with the bones that make up the back one. MUST be listed front to back. " />
					<Var Name="Backbone_AddTrailFreq"  Type="Float" DefaultValue="10" Description="How often (times per seconds) a sample of a previous transform is taken." />
					<Var Name="Backbone_Stiffness" Type="Float" DefaultValue="1"  Description="How stiff or loose the bend is." />
					<Var Name="Backbone_MaxTrailSize" Type="Int" DefaultValue="13"  Description="The number of previous transforms that are saved to calculate the bend." />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="Datamine">
			<InstanceVars>
				<Group Name="Datamine_General">
					<Var Type="Float" Name="MaxFocusDistance"   DefaultValue="-1" Description="The max focus distance. If -1 then default (from game.cfg) is used."/>
					<Var Name="FinalSubjectCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asScene, const tString &amp;in asSubject" Suffix="_SubjectOver"		Description="Function called when final voice subject finishes playing. Syntax: void Func(const tString&in asScene, const tString&amp;in asSubject)" />
					<Var Name="DataminingDoneCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_DataminingDone"		Description="Function called after successfully datamining the entity and seeing all pages/images. Syntax: void Func(const tString&amp;in asEntity)" />
					<Var Name="DatamineGlow" Type="Bool" DefaultValue="false"	Description="Glow until the datamine is completed." />
					<Var Name="RangeArea" Type="String"  DefaultValue="" 		Description="This is an area that disables the datamine should the player leave it." />
					<Var Name="StopAllVoices" Type="Bool"  DefaultValue="false" 		Description="Stop all voices before playing datamine?" />
				</Group>
				<Group Name="Datamine_Page_1">
					<Var Name="Page_1_VoiceSubject" Type="String" DefaultValue="" Description="Subject to play on the specified page." />
					<Var Name="Page_1_TextCategory" Type="String" DefaultValue="" Description="Category of the text to be displayed on the specified page." />
					<Var Name="Page_1_TextEntry" Type="String" DefaultValue="" Description="Text entry to be displayed on the specified page." />
					<Var Name="Page_1_Image" Type="String" DefaultValue="" Description="Image to be displayed on the specified page." />
				</Group>
				<Group Name="Datamine_Page_2">
					<Var Name="Page_2_VoiceSubject" Type="String" DefaultValue="" Description="Subject to play on the specified page." />
					<Var Name="Page_2_TextCategory" Type="String" DefaultValue="" Description="Category of the text to be displayed on the specified page." />
					<Var Name="Page_2_TextEntry" Type="String" DefaultValue="" Description="Text entry to be displayed on the specified page." />
					<Var Name="Page_2_Image" Type="String" DefaultValue="" Description="Image to be displayed on the specified page." />
				</Group>
				<Group Name="Datamine_Page_3">
					<Var Name="Page_3_VoiceSubject" Type="String" DefaultValue="" Description="Subject to play on the specified page." />
					<Var Name="Page_3_TextCategory" Type="String" DefaultValue="" Description="Category of the text to be displayed on the specified page." />
					<Var Name="Page_3_TextEntry" Type="String" DefaultValue="" Description="Text entry to be displayed on the specified page." />
					<Var Name="Page_3_Image" Type="String" DefaultValue="" Description="Image to be displayed on the specified page." />
				</Group>
				<Group Name="Datamine_Page_4">
					<Var Name="Page_4_VoiceSubject" Type="String" DefaultValue="" Description="Subject to play on the specified page." />
					<Var Name="Page_4_TextCategory" Type="String" DefaultValue="" Description="Category of the text to be displayed on the specified page." />
					<Var Name="Page_4_TextEntry" Type="String" DefaultValue="" Description="Text entry to be displayed on the specified page." />
					<Var Name="Page_4_Image" Type="String" DefaultValue="" Description="Image to be displayed on the specified page." />
				</Group>
				<Group Name="Datamine_Page_5">
					<Var Name="Page_5_VoiceSubject" Type="String" DefaultValue="" Description="Subject to play on the specified page." />
					<Var Name="Page_5_TextCategory" Type="String" DefaultValue="" Description="Category of the text to be displayed on the specified page." />
					<Var Name="Page_5_TextEntry" Type="String" DefaultValue="" Description="Text entry to be displayed on the specified page." />
					<Var Name="Page_5_Image" Type="String" DefaultValue="" Description="Image to be displayed on the specified page." />
				</Group>
				<Group Name="Datamine_Page_6">
					<Var Name="Page_6_VoiceSubject" Type="String" DefaultValue="" Description="Subject to play on the specified page." />
					<Var Name="Page_6_TextCategory" Type="String" DefaultValue="" Description="Category of the text to be displayed on the specified page." />
					<Var Name="Page_6_TextEntry" Type="String" DefaultValue="" Description="Text entry to be displayed on the specified page." />
					<Var Name="Page_6_Image" Type="String" DefaultValue="" Description="Image to be displayed on the specified page." />
				</Group>
			</InstanceVars>
		</Component>
		<Component Name="Meat">
			<TypeVars>
				<Group Name="Meat">
					<Var Name="IsMeat" Type="Bool" DefaultValue="false" Description="Checking this will make the item use the meat component" />
					<Var Name="MeatAttractDistance" Type="Float" DefaultValue="10" Description="Starting attract distance for the meat" />
					<Var Name="MeatAttractDistanceMax" Type="Float" DefaultValue="20" Description="Final attract distance for the meat" />
				</Group>
			</TypeVars>
		</Component>
