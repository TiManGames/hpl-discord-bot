<UserClassDefinition>
	<Classes>
		<BaseClass Name="Prop">
			<EditorSetupVars>
				<Var Name="AffectShadowsVar" Value="CastShadows" />
				<Var Name="AffectedByDecalVar" Value="IsAffectedByDecal" />
				<Var Name="DiffuseColorMulVar" Value="ColorMul" />
				<Var Name="SubEntityColorMulVar" Value="EffectColorMul" />
				<Var Name="SubEntityBrightnessMulVar" Value="EffectBrightnessMul" />
				<Var Name="IllumColorMulVar" Value="IllumColor" />
				<Var Name="IllumBrightnessVar" Value="IllumBrightness" />
				<Var Name="OccluderVar" Value="IsOccluder" />
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Base">
					<Var Name="Health" Type="Float" DefaultValue="1.0" 		Description="The amount of damamge an entity can take." />
					<Var Name="Toughness" Type="Int" DefaultValue="0" 		Description="If strength of attack is 1 lower than damage is halfed. 2 or more lower damage is 0. If equal or higher, damage stays the same." />
					<Var Name="MaxInteractDistance" Type="Int" DefaultValue="0"  Description="The max distance that interaction can take place. If within player height, then made in 2D (xz). If 0, default is used!" />
					<Var Name="EventTag" Type="String" DefaultValue="" 		Description="A tag string used that is mainly used by the event system to group certain type of objects." />
					<Var Name="ShowHints" Type="Bool" DefaultValue="true"			Description="If it is allowed to show hints upon interaction with entity." />
					<Var Name="LifeLength" Type="Float" DefaultValue="0" 			Description="A time after which the entity automatically breaks. 0=lasts forever." />
				  <Var Name="DissolveDuringLifeDecrease" Type="Bool" DefaultValue="true" Description="If the entity should dissolve when the life count decreases." />
				  <Var Name="QuickSave" Type="Bool" DefaultValue="false" 		Description="Skips saving variables and only saves the transform of this prop type and its sub entities" />
				  <Var Name="FullGameSave" Type="Bool" DefaultValue="false" 			Description="If the all things in the entity should be saved when exiting the level. Only use on few entities!" />
				</Group>
				<Group Name="Physics">
          <Var Name="BlocksLineOfSight" Type="Enum" DefaultValue="MaterialBased" 		Description="If this object should block line of sight tests. If Material Based is selected only solid SubMeshes will be checked" >
            <EnumValue Name="MaterialBased" />
            <EnumValue Name="Off" />
            <EnumValue Name="Always" />
          </Var>
					<Var Name="MainPhysicsBody" Type="String" DefaultValue="" 	Description="This is the name of the most imporant physics body. The body that sounds are played from and objects attached to (attached as results from script!)." />
					<Var Name="NoGravityWhenUnderwater" Type="Bool" DefaultValue="false" 	Description="When this object is in an liquid area and fully submerged it has no gravity." />
					<Var Name="DisableFreezeAtStart" Type="Bool" DefaultValue="false" 	Description="By default (unless skeletalphysics) bodies are frozen at start of a map. This disables that for this entity." />
				</Group>
				<Group Name="Script">
					<Var Name="CustomScriptFile" Type="String" DefaultValue="" 	Description="The file of the custom script." />
					<Var Name="CustomScriptClass" Type="String" DefaultValue="" 	Description="The class name of the custom script. " />
				</Group>
				<Group Name="Appearance">
					<Var Name="ShowMesh" Type="Bool" DefaultValue="true" 		Description="If the mesh should be visible. Having this false might useful for blocker objects." />
					<Var Name="DissolveOnDestruction" Type="Bool" DefaultValue="false" 	Description="If the dissolve effect should used when entity is destroyed." />
					<Var Name="DissolveTime" Type="Float" DefaultValue="1.0" 		Description="The time it takes for the dissolve effect to be over." />
					<Var Name="RandomizeAnimationStart" Type="Bool" DefaultValue="true" 	Description="Should the animation start time be randomized at start. If false all animations of entity are synchronized." />
          <Var Name="RootMotionBone" Type="String" DefaultValue="" Description="Bone to use when setting up root motion. The entity will follow the movement of this bone" />
        </Group>
				<Group Name="Effects">
					<Var Name="EffectsOnSound" Type="File"  ResType="Sound" DefaultValue="" 		Description="Sound made when turned on. (used for lamps lit/unlit, but also other entity types)." />
					<Var Name="EffectsOffSound" Type="File"  ResType="Sound" DefaultValue="" 		Description="Sound made when turned off. (used for lamps lit/unlit, but also other entity types)."/>
					<Var Name="EffectsOnTime" Type="Float" DefaultValue="0.2" 		Description="Time it takes for on effect to be done. (used for lamps lit/unlit, but also other entity types)."/>
					<Var Name="EffectsOffTime" Type="Float" DefaultValue="0.2" 		Description="Time it takes for off effect to be done. (used for lamps lit/unlit, but also other entity types)."/>
				</Group>
				<Group Name="StaticMove">				
					<Var Name="StaticMoveCheckCollision" Type="Bool" DefaultValue="false" 	Description="If a static move should check for collision. (used when static bodies are moved through script of type specific effect.)" />
					<Var Name="StaticMoveStartSound" Type="File"  ResType="Sound" DefaultValue="" 		Description="Sound made at the start of a static move. (used when static bodies are moved through script of type specific effect.)" />
					<Var Name="StaticMoveStopSound" Type="File"  ResType="Sound" DefaultValue="" 		Description="Sound made at the end of a static move. (used when static bodies are moved through script of type specific effect.)"/>
          <Var Name="StaticMoveLoopSound" Type="File"  ResType="Sound" DefaultValue="" 		Description="Sound made during a static move. (used when static bodies are moved through script of type specific effect.)"/>
          <Var Name="StaticMoveLoopSoundFade" Type="Bool" DefaultValue="true" 		Description="If the static move sound should fade in and out or be instant. (used when static bodies are moved through script of type specific effect.)"/>
        </Group>
				<Group Name="Break">				
					<Var Name="BreakActive" Type="Bool" DefaultValue="false" 		Description="If entity is broken when hit hard enough or health is 0." /> 
					<Var Name="CustomBreakBehaviour" Type="Bool" DefaultValue="false" 		Description="If true, void OnCustomBreak() will be called inside the prop script and override the normal break behaviour." /> 
					<Var Name="BreakOnlyOnMainBody" Type="Bool" DefaultValue="false" 		Description="If the entity will only break from impact if the main body is hit." /> 
					<Var Name="BreakDestroyJoints" Type="Bool" DefaultValue="false" 	Description="If all physics joints should be destroyed when broken." />
					<Var Name="BreakMinEnergy" Type="Float" DefaultValue="100" 		Description="The minimum energy needed for breakage. Energy = Object1Speed * Object1Mass + Object2Speed * Object2Mass. Speed = m/s. If Object 2 is floor or something static, its speed is always 0 and does not contribute to total energy!" />
					<Var Name="BreakEntity" Type="File"  Extensions="ent" DefaultValue="" 			Description="The entity this entity turns into when broken." />
					<Var Name="BreakEntityAlignBody" Type="String" DefaultValue="" 		Description="The body BreakEntity uses to align itself when created. ''=no entity is created." />
					<Var Name="BreakSound" Type="File"  ResType="Sound" DefaultValue="" 			Description="The sound made when broken." />
					<Var Name="BreakParticleSystem" Type="File"  ResType="ParticleSystem" DefaultValue="" 		Description="Particle system shown when broken." />
					<Var Name="BreakImpulse" Type="Float" DefaultValue="4" 			Description="Impulse (speed in m/s really) added to all bodies in BreakENtity when created. The direction of impulse is outwards from center of entity." />
				</Group>			
			</TypeVars>
			<InstanceVars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Name="EventInstanceTag" Type="String" DefaultValue="" 		Description="A tag string used that is mainly used by the event system to group certain type of objects." />
					<Var Name="CollideGroup" Type="String"  DefaultValue="" 	Description="This is the name of a collide group that this entity belongs to. Each entity can only belong to ONE collide group. The name must begin with - or +. Collision for this entity is disabled for other entities with the same group name but of the opposite sign.  +player, +agent and +critter are already in use. (Note: The maximum number of collide groups in any given map is 254)." />
					<Var Name="UserVar" Type="String" DefaultValue="" 		Description="Value of a variable. Accessed with  Entity_GetVar[Type](&quot;&quot;) (an empty string as argument). Can be of any type (determined when you choose to access)." />
					<Var Name="DisableBreakable" Type="Bool"  DefaultValue="false" 	Description="If the entity is breakable then having this true will make it unbreakable." />
					<Var Name="FullGameSave" Type="Bool" DefaultValue="false" 			Description="If the all things in the entity should be saved when exiting the level. Only use on few entities!" />
          <Var Name="StaticPhysics" Type="Bool" DefaultValue="false" 			Description="If the mass of all bodies should be 0" />
          <Var Name="QuickSave" Type="Bool" DefaultValue="false" 		Description="Skips saving variables and only saves the transform of this prop and its sub entities" />
		  	</Group>
				<Group Name="Internal State">
					<Var Name="EffectsActive" Type="Bool"  DefaultValue="true" 	Description="If entity should have its effects active." />
					<Var Name="InteractionDisabled" Type="Bool"  DefaultValue="false" 	Description="If interaction with the entity should be disabled." />
				</Group>
				<Group Name="Appearance">
					<Var Name="CastShadows" Type="Bool" DefaultValue="true" 			Description="Should shadows be cast." />
					<Var Name="ColorMul" Type="Color" DefaultValue="1 1 1 1" 		Description="Color the diffuse texture of the prop is multiplied with." />
					<Var Name="EffectColorMul" Type="Color" DefaultValue="1 1 1 1" 		Description="Color any flares, billboards, beams, lights or particle systems are multiplied with." />
					<Var Name="EffectBrightnessMul" Type="Float" DefaultValue="1" Min="0" Max="10" Slider="true" UseLogScale="true" Description="Brightness any flares, billboards, beams, lights or particle systems are multiplied with." />
					<Var Name="IllumColor" Type="Color" DefaultValue="1 1 1 1" 		Description="Color the illumination of the prop is multiplied with." />
					<Var Name="IllumBrightness" Type="Float" DefaultValue="1" Min="0" Max="10" Slider="true" UseLogScale="true"	Description="Value the illumination brightness of the prop is multiplied with." />
					<Var Name="IsAffectedByDecal" Type="Bool" DefaultValue="false" 		Description="If decals can be created on entity." />
					<Var Name="IsOccluder" Type="Bool" DefaultValue="false" Description="If entity blocks can be used when culling." />
				  <Var Name="UpdateBonesWhenCulled" Type="Bool" DefaultValue="false" 	Description="If animations should play even if the object is not in view" />
				</Group>
				<Group Name="Basic Callbacks">		
					<Var Name="OnBreakCallbackFunc" Type="Function" DefaultValue="" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_Callback" Description="Called when the prop breaks, after new entity is created. Syntax: void Func(tString &in EntityName). " />
					<Var Name="ConnectionStateChangeCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity, int alState" Suffix="_OnConnectionStateChange" Description="A callback called when ever the connection state changes (button being switched on). Syntax: void Func(const tString & in EntityName, int alState). alState: -1=off, 0=between 1=on" />
					<Var Name="PlayerLookAtCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity, int alState" Suffix="_OnPlayerLookAt"		Description="Callback called when player looks on entity. Syntax: void Func(tString &in entity, int alState) state: 1=looking, -1=not looking" />
					<Var Name="PlayerLookAtCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should look at callback be removed when entity is looked at and callback called." />
					<Var Name="PlayerLookAtCheckCenterOfScreen" Type="Bool" DefaultValue="true" 	Description="If the entity counts as looked at only when at the center of the screen."/>
					<Var Name="PlayerLookAtCheckRayIntersection" Type="Bool" DefaultValue="true" 	Description="If the entity counts as looked at only if there is a clear line of sight to it. Note that this can return false negatives, especially when not checking center of screen."/>
					<Var Name="PlayerLookAtMaxDistance" Type="Float" DefaultValue="-1" 	Description="How far away the entity can be and still be counted as looked at. If less than 0, the maximum possible value will be used."/>
					<Var Name="PlayerLookAtCallbackDelay" Type="Float" DefaultValue="0" 	Description="How long after looking at or away from the entity the callback should trigger."/>
					<Var Name="PlayerInteractCallback" Type="Function"  ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteract"	Description="Callback called when player interacts with entity. Syntax: void Func(tString &in entity)" />
					<Var Name="PlayerInteractCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should interact callback be removed when entity is interacted with and callback called." />
					<Var Name="PlayerInteractLeaveCallback" Type="Function"  ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteractLeave"	Description="Callback called when player stops interacting with entity. Syntax: void Func(tString &in entity)" />
					<Var Name="PlayerInteractLeaveCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should interact leave callback be removed when entity is interacted with and callback called." />
					<Var Name="RecieveMessageCallback" Type="Function" ReturnType="void" Params="const tString&amp; in asEntityName, int alMessageId, cLuxEntityMessageData @apData"  Suffix="_OnRecieveMessage"	Description="Callback function called when the entity recives a message (of type eLuxEntityMessage or script defined) all the entities. Syntax: void Func(int alMessageId, cLuxEntityMessageData @apDatae). ." />
				</Group>
				<Group Name="Collide callbacks">	
					<Var Name="CC_Entities" Type="String" DefaultValue="" 		Description="The entities that have a callback to this entity, sepperate each with space and/or comma. May use wildcards (*). Having 'player' as entity means that current entity will be attached on player." />
					<Var Name="CC_Funcs" Type="Function" ReturnType="bool" Params="const tString &amp;in asParent, const tString &amp;in asChild, int alState" 		Description="The callback functions for all the collide entities. Syntax: bool Func(const tString &in asParent, const tString &in asChild, int alState). If false is returned callback is removed. states: 1=enter, -1=leave If using several sepperate with comma and/or spaces. If only one function, all entity collision will use, else they are connected following the order. If there are more entities than functions, the last function will be used for the remaining entities." />
				</Group>
				<Group Name="Connections">	
					<Var Name="ConnectedEntity" Type="String"  DefaultValue="" 		Description="The entity to make a connection to. May use wildcards (*). The connection created will be called 'Main'." />
					<Var Name="ConnectedEntityInvertState" Type="Bool"  DefaultValue="false" 		Description="If the state sent to the connected entity should be inverted." />
					<Var Name="ConnectedEntityStatesUsed" Type="Int"  DefaultValue="0" 		Description="What states that should be sent. 0=any value. 1=only 1, -1= only -1." />
				</Group>
				<Group Name="Attachments">		
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this entity is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body or a socket is used." />
					<Var Name="ParentAttachSocket" Type="String"  DefaultValue="" 		Description="Name of socket in the entity that it should be attached to. ''  means a body is used." />
					<Var Name="ParentAttachSnap" Type="Bool"  DefaultValue="false" 		Description="If the prop should get the same position as the parent." />
					<Var Name="ParentAttachLocked" Type="Bool"  DefaultValue="false" 		Description="Will lock the prop to the parent and disable any local movements. Greatly increases precision but doesnt work on dynamic bodies" />
				</Group>
				<Group Name="ConnectedLight">		
					<Var Name="ConnectedLight" Type="String" DefaultValue="" 		Description="Name of a light (not lamp entities!) that will be connected to the this lamp entity and will increase/descrease in color as the lamp is turned on/off. Possible to add many lights by seperating the names with space and/or comma, wild cards can be used." />
					<Var Name="ConnectionLightAmount" Type="Float" DefaultValue="1" 	Description="When lamp is turned multiplied with the lamp's color and added to the light color" />
					<Var Name="ConnectionLightUseOnColor" Type="Bool" DefaultValue="true" 	Description="If the on color should always be used.I false the light color (which might be flickering) is used. Only used for type Add" />
					<Var Name="ConnectionLightUseSpec" Type="Bool" DefaultValue="false" 	Description="If the specular of the lamp color should be used. Only used for type Add" />
					<Var Name="ConnectionLightType" Type="Enum" DefaultValue="Mul" 	Description="How the connection works: Add: light_color + amount*prop_light  Mul: light_color * amount*prop_effect_amount." >
						<EnumValue Name="Add" />
						<EnumValue Name="Mul" />
					</Var>
				</Group>
				<Group Name="ExtraConnectedLight">		
					<Var Name="ExtraConnectedLight" Type="String" DefaultValue="" 		Description="Name of a light (not lamp entities!) that will be connected to the this lamp entity and will increase/descrease in color as the lamp is turned on/off. Possible to add many lights by seperating the names with space and/or comma, wild cards can be used." />
					<Var Name="ExtraConnectionLightAmount" Type="Float" DefaultValue="1" 	Description="When lamp is turned multiplied with the lamp's color and added to the light color" />
					<Var Name="ExtraConnectionLightUseOnColor" Type="Bool" DefaultValue="true" 	Description="If the on color should always be used.I false the light color (which might be flickering) is used. Only used for type Add" />
					<Var Name="ExtraConnectionLightUseSpec" Type="Bool" DefaultValue="false" 	Description="If the specular of the lamp color should be used. Only used for type Add" />
					<Var Name="ExtraConnectionLightType" Type="Enum" DefaultValue="Mul" 	Description="How the connection works: Add: light_color + amount*prop_light  Mul: light_color * amount*prop_effect_amount." >
						<EnumValue Name="Add" />
						<EnumValue Name="Mul" />
					</Var>
				</Group>
			</InstanceVars>
		</BaseClass>
		
		<Class Name="StaticProp">
			<EditorSetupVars>
				<Group Name="Base">
					<Var Name="AffectShadowsVar" Value="CastShadows" />
					<Var Name="AffectedByDecalVar" Value="IsAffectedByDecal" />
					<Var Name="DiffuseColorMulVar" Value="ColorMul" />
					<Var Name="IllumColorMulVar" Value="IllumColor" />
					<Var Name="IllumBrightnessVar" Value="IllumBrightness" />
          <Var Name="OccluderVar" Value="IsOccluder" />
				</Group>
			</EditorSetupVars>
			<TypeVars>
				<Var Name="ShowMesh" Type="Bool" DefaultValue="true"  Description="If the mesh is visible." />
			</TypeVars>
			<InstanceVars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Name="CastShadows" Type="Bool" DefaultValue="true" Description="If entity casts shadows." />
					<Var Name="IsAffectedByDecal" Type="Bool" DefaultValue="true" Description="If decals can be created on entity." />
          <Var Name="ColorMul" Type="Color" DefaultValue="1 1 1 1" 		Description="Color the diffuse texture of the prop is multiplied with." />
          <Var Name="ColorBrightness" Type="Float" DefaultValue="1" 		Description="Brightness multiplier for the diffuse color. (No editor support)" />
					<Var Name="IllumColor" Type="Color" DefaultValue="1 1 1 1" 		Description="Color the illumination of the prop is multiplied with." />
					<Var Name="IllumBrightness" Type="Float" DefaultValue="1" Min="0" Max="10" Slider="true" UseLogScale="true"	Description="Value the illumination brightness of the prop is multiplied with." />
					<Var Name="IsOccluder" Type="Bool" DefaultValue="false" Description="If entity blocks can be used when culling." />
					<Var Name="CollideGroup" Type="String"  DefaultValue="" 	Description="This is the name of a collide group that this entity belongs to. Each entity can only belong to ONE collide group. The name must begin with - or +. Collision for this entity is disabled for other entities with the same group name but of the opposite sign.  +player, +agent and +critter are already in use. (Note: The maximum number of collide groups in any given map is 254)." />
          <Var Name="RenderLayer" Type="Int" DefaultValue="0" Description="Which order or layer this entity should be rendered to. Higher means later. Only works ingame" />
        </Group>
			</InstanceVars>
		</Class>
		
		<Class Name="StaticCollider">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Name="PhysicsMaterial" Type="Enum" EnumType="PhysicsMaterial"  DefaultValue="0" Description="The physics material of the collider." />
					<Var Name="CollideCharacter" Type="Bool"  DefaultValue="true" 		Description="If it will collide with character bodies." />
					<Var Name="CollideNonCharacter" Type="Bool"  DefaultValue="false" 		Description="If it will collide with normal bodies." />
					<Var Name="BlocksLightAndLOS" Type="Bool"  DefaultValue="false" 		Description="If it should block line of sight for enemies and affect brightness calculations. NOTE: Line of sight will only be blocked if CollideNonCharacter is also checked!" />
					<Var Name="CollideGroup" Type="String"  DefaultValue="" 	Description="This is the name of a collide group that this entity belongs to. Each entity can only belong to ONE collide group. The name must begin with - or +. Collision for this entity is disabled for other entities with the same group name but of the opposite sign.  +player, +agent and +critter are already in use. (Note: The maximum number of collide groups in any given map is 254)." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Animated" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="InteractConnection">
					<Var Name="Animation" Type="String" DefaultValue="" Description="Name of the animation to be influenced by the interact connection." />
					<Var Name="AnimationDirection" Type="Enum" DefaultValue="Both" Description="The direction the animation is allowed to move when influenced by the interact connection." >
						<EnumValue Name="Forward" />
						<EnumValue Name="Backward" />
						<EnumValue Name="Both" />
					</Var>
					<Var Name="AnimationStuckState" Type="Int" DefaultValue ="-1" Description="Locks the animation when it reaches the specified state. -1 = can't get stuck." />
				</Group>
			</TypeVars>
			<InstanceVars>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Lamp" InheritsFrom="Prop" UsesComponents="LampComponent">
			<EditorSetupVars>
				<Var Name="AffectLightsVar" Value="Lit" />
				<Var Name="AffectParticlesVar" Value="Lit" />
				<Var Name="AffectIllumVar" Value="Lit" />
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Lamp">
					<Var Name="CanBeLitByPlayer" Type="Bool"  DefaultValue="false" 		Description="If the player can lit this lamp by direct interaction." />
					<Var Name="CanBeSnuffedOutByPlayer" Type="Bool" DefaultValue="false" Description="If the player can snuff out the lamp." />
					<Var Name="CanBeGrabbed" Type="Bool"  DefaultValue="falsDrainCallbacke" 		Description="If it can be grabbed by the player." />
					<Var Name="RequiresMatches" Type="Bool"  DefaultValue="false" 		Description="If matches arerequired to light this lamp." />
					<Var Name="RequiresOil" Type="Bool"  DefaultValue="false" 		Description="If oil is required to light this lamp." />
					<Var Name="LightByDistance" Type="Bool"  DefaultValue="false" Description="If the lamp should light up automatically when the player gets in range." />
					<Var Name="LightDistance" Type="Float" DefaultValue="5.0" Description="The distance from the player at which the lamp should ligth up." />
				</Group>
				<Group Name="Lamp_Flicker">
					<Var Name="FlickerMinOnTime" Type="Float" DefaultValue="0.05" 			Description="The minimum time the lamp will be turned on when flickering." />
					<Var Name="FlickerMaxOnTime" Type="Float" DefaultValue="1" 			Description="The maximum time the lamp will be turned on when flickering." />
					<Var Name="FlickerMinOffTime" Type="Float" DefaultValue="0.025" 			Description="The minimum time the lamp will be turned off when flickering." />
					<Var Name="FlickerMaxOffTime" Type="Float" DefaultValue="0.15" 			Description="The maximum time the lamp will be turned off when flickering." />
					<Var Name="FlickerFade" Type="Bool" DefaultValue="false" 			Description="If the standard on/off effects should be used when flickering on and off." />
					<Var Name="FlickerOnSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when lamp is turned on by flicker." />
					<Var Name="FlickerOffSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when lamp is turned off by flicker." />
					<Var Name="FlickerOnPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 		Description="Particles created when lamp is turned on by flicker." />
					<Var Name="FlickerOffPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 		Description="Particles created when lamp is turned off by flicker." />
					<Var Name="FlickerOffAlpha" Type="Float" DefaultValue="0" 			Description="How bright the light should be when it flickers off." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Lamp">
					<Var Name="Lit" Type="Bool" DefaultValue="true" 			Description="If the lamp is lit or not." />
					<Var Name="ConnectionDelay" Type="Bool" DefaultValue="true" Description="If there should be a delay when lit/unlit through a connection." />
				</Group>
				<Group Name="Lamp_Flicker">
					<Var Name="FlickerActive" Type="Bool" DefaultValue="false" 			Description="If the lamp is flickering or not." />
					
					<Var Name="UseCustomFlickerSettings" Type="Bool" DefaultValue="false" 			Description="If the flicker values set in the ent file should be overridden." />
					<Var Name="FlickerMinOnTime" Type="Float" DefaultValue="0.05" 			Description="The minimum time the lamp will be turned on when flickering." />
					<Var Name="FlickerMaxOnTime" Type="Float" DefaultValue="1" 			Description="The maximum time the lamp will be turned on when flickering." />
					<Var Name="FlickerMinOffTime" Type="Float" DefaultValue="0.025" 			Description="The minimum time the lamp will be turned off when flickering." />
					<Var Name="FlickerMaxOffTime" Type="Float" DefaultValue="0.15" 			Description="The maximum time the lamp will be turned off when flickering." />
					<Var Name="FlickerFade" Type="Bool" DefaultValue="false" 			Description="If the standard on/off effects should be used when flickering on and off." />
					<Var Name="FlickerOnSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when lamp is turned on by flicker." />
					<Var Name="FlickerOffSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when lamp is turned off by flicker." />
					<Var Name="FlickerOnPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 		Description="Particles created when lamp is turned on by flicker." />
					<Var Name="FlickerOffPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 		Description="Particles created when lamp is turned off by flicker." />
					<Var Name="FlickerOffAlpha" Type="Float" DefaultValue="0" 			Description="How bright the light should be when it flickers off." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Grab" InheritsFrom="Prop" UsesComponents="FearScaryObject, FearThreat">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Grab">
					<Var Name="Grab_UseCustomOffset" Type="Bool" DefaultValue="false" Description="If special orientation is always used when object is grabbed." />
					<Var Name="Grab_CustomPositionOffset" Type="Vec3" DefaultValue="0 0 0" Description="custom oritention position offset." />
					<Var Name="Grab_CustomRotationOffset" Type="Vec3" DefaultValue="0 0 0" Description="custom oritention rotational offset." />
					<Var Name="Grab_UseCustomDepth" Type="Bool" DefaultValue="false" Description="If the grabbed object should always be a certain distance from the player." />
					<Var Name="Grab_CustomDepth" Type="Float" DefaultValue="1.2" Description="The custom depth value." />
					<Var Name="Grab_MassMul" Type="Float" DefaultValue="0.1" Description="The amount of mass used when picked up." />
					<Var Name="Grab_MinDepth" Type="Float" DefaultValue="0.8" Description="Min depth from player the object can be moved to." />
					<Var Name="Grab_MaxDepth" Type="Float" DefaultValue="2" Description="Max depth from player the object can be moved to." />
					<Var Name="Grab_ForceMul" Type="Float" DefaultValue="1"  Description="Force multiplier. Use if movements are erratic (lower it) or object is slow (increase)." />
					<Var Name="Grab_TorqueMul" Type="Float" DefaultValue="1" Description="Torque multiplier. Use if rotations are erratic (lower it) or object is slow (increase)." />
					<Var Name="Grab_ThrowImpulse" Type="Float" DefaultValue="5.0" Description="Impulse amount used when throwing the prop" />
					<Var Name="Grab_IsHeavy" Type="Bool" DefaultValue="false" Description="If the object is heavy (like a large crate) this sets up some special restrictions when interacting to make it feel more heavy." />
					<Var Name="Grab_CollisionWithPlayer" Type="Bool" DefaultValue="false" Description="If the object should still check collision with player even while interacting with it." />
					<Var Name="Grab_InteractOnlyWithMainBody" Type="Bool" DefaultValue="false" Description="If the body set as MainPhysicsBody is the only one that can be interacted with." />
					<Var Name="Grab_CanInteractWithNoMass" Type="Bool" DefaultValue="true" Description="If a body can be interacted with if its mass is set to 0" />
					<Var Name="Grab_LowerMass" Type="Bool" DefaultValue="true" Description="Lowers the mass of bodies so they don't push other objects around too much." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Grab">
					<Var Name="InteractDisablesStaticPhysics" Type="Bool" DefaultValue="false" Description="If static physics should be disabled when the prop is interacted with." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Push" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Push">
					<Var Name="PushAtPoint" Type="Bool" DefaultValue="false" 	Description="If the push force should be applied to the point at the object where interaction took place." />
					<Var Name="ForceMul" Type="Float" DefaultValue="1" 		Description="Multplier for force applied. Used to fine tune interaction." />
					<Var Name="ThrowImpulse" Type="Float" DefaultValue="2" 		Description="Impulse made when thrown" />
					<Var Name="LookPushActive" Type="Bool" DefaultValue="true" Description="If pushing by looking around is active." />
					<Var Name="MaxPlayerSpeedMul" Type="Float" DefaultValue="1.0" Description="Multiplier for how fast the player should be able to move with the object." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Push">
					<Var Name="InteractDisablesStaticPhysics" Type="Bool" DefaultValue="false" Description="If static physics should be disabled when the prop is interacted with." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Wheel" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Wheel_Base">
					<Var Name="CanInteractWithStaticBody" Type="Bool"  DefaultValue="true" Description="If by interacting with a static body in the entity, the lever is interacted with. Meaning that interacting with any part of the entity will work." />
					<Var Name="InteractOnlyWithMainBody" Type="Bool" DefaultValue="false" Description="If the body set as MainPhysicsBody is the only one that can be interacted with." />
					<Var Name="IsOneHanded" Type="Bool"  DefaultValue="false" 		Description="If the crank is turned by one hand. (only affects the icon)"/>
					<Var Name="SkipMiddleState" Type="Bool"  DefaultValue="true" 		Description="If the middle state (when not in max or min) should be skipped by script and connections." />
					<Var Name="StuckSound" Type="File"  ResType="Sound"  DefaultValue="" 			Description="Sound played when stuck." />
					<Var Name="SlowDownRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be slowed to 0 when not interacting." />
					<Var Name="MoveSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as wheel is moved. If left empty the value specified in the joint is used." />
					<Var Name="MinMoveSoundSpeed" Type="Float" DefaultValue="-1" 		Description="Min speed the wheel should move at before playing sound. If -1 the value specified in the joint is used." />
				</Group>		
				<Group Name="Wheel_Speed">
					<Var Name="MoveMaxSpeed" Type="Float"  DefaultValue="5.0" 		Description="The maximum speed it can be moved." />
					<Var Name="MoveSlowDownFactor" Type="Float"  DefaultValue="3.0" 	Description="Amount of slowdown applied to object when not moved." />
					<Var Name="MoveSpeedFactor" Type="Float"  DefaultValue="1.0" 		Description="The higher value the more speedgain a mouse movement makes." />
					<Var Name="AdditionalInertia" Type="Float"  DefaultValue="0.0" 		Description="The higher value the higher the longer to get to max speed." />
				</Group>
				<Group Name="Wheel_Limits">
					<Var Name="MinLimitRange" Type="Float"  DefaultValue="5.0" 		Description="The distance from min the joint can be to be considered at min limit." />
					<Var Name="MaxLimitRange" Type="Float"  DefaultValue="5.0" 		Description="The distance from max the joint can be to be considered at max limit." />
					<Var Name="MinLimitSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played at min limit" />
					<Var Name="MaxLimitSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played at max limit" />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Wheel">
					<Var Name="MinLimit" Type="Float"  DefaultValue="-180" 			Description="Min limit of the wheel, should be equal or below 0 but can be as low as wanted. Several revoltuions are supported!" />
					<Var Name="MaxLimit" Type="Float"  DefaultValue="180" 			Description="Max limit of the wheel, should be equal or above 0 but can be as high as wanted. Several revoltuions are supported!" />

					<Var Name="AutoRotateMul" Type="Float"  DefaultValue="10" 		Description="Multiplier that defines how fast the wheel turns if autorotation is called." />
					
					<Var Name="InteractionDisablesStuck" Type="Bool"  DefaultValue="false" 	Description="If stuck is disabled when player interacts." />
					
					<Var Name="MinLimitStuck" Type="Bool"  DefaultValue="true"		Description="If stuck at min limit. " />
					<Var Name="MaxLimitStuck" Type="Bool"  DefaultValue="true"		Description="If stuck at max limit. " />
					
					<Var Name="SpinDir" Type="Enum"  DefaultValue="0" Description="The direction the wheel is spun" >
						<EnumValue Name="BothWays" />
						<EnumValue Name="ToMin" />
						<EnumValue Name="ToMax" />
					</Var>
					<Var Name="JointResetFix" Type="Bool" DefaultValue="false" Description="Reset the props position if it disappears because of a physics bug" />
				</Group>
				<Group Name="InteractConnection">
					<Var Name="ConnectedProp" Type="String" DefaultValue="" Description="Name of the connected prop (SlideDoor, Slider, Wheel, MoveObject, SwingDoor and Rotate supported). Wildcards supported." />
					<Var Name="Invert" Type="Bool" DefaultValue="false" Description="If the connection should be inverted." />
					<Var Name="OneWayConnection" Type="Bool" DefaultValue="false" Description="If the connection should be one-way (the connected prop will have no influence over this props state)." />
				</Group>
				<Group Name="Interact">
					<Var Name="LookAtEntity" Type="String" DefaultValue="" Description="Name of the entity to look at while interacting." />
					<Var Name="LookAtAcc" Type="Float" DefaultValue="0.01" Description="LookAt acceleration." />
					<Var Name="LookAtSpeedMul" Type="Float" DefaultValue="0.5" Description="LookAt speed multiplier." />
					<Var Name="LookAtMaxSpeed" Type="Float" DefaultValue="0.5" Description="LookAt maximum speed." />
					<Var Name="LookAtDec" Type="Float" DefaultValue="0.02" Description="LookAt deceleration (once interaction stops on mouse release)." />
					<Var Name="StandTar" Type="String" DefaultValue="" Description="Name of the entity to move to when interacting." />
					<Var Name="DefaultLookAt" Type="Bool" DefaultValue="true" Description="If the default look at (when no LookAtEntity is chosen) should be active." />
					<Var Name="DisabledIfStuck" Type="Bool" DefaultValue="false" Description="If the look at and stand tar should be disabled if the prop is stuck." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Slide" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Slide">
					<Var Name="SlideMaxSpeed" Type="Float" DefaultValue="4" 	Description="The maximum speed it can be moved." />
					<Var Name="SlideSlowDownFactor" Type="Float" DefaultValue="1" 	Description="Amount of slowdown applied to object when not moved." />
					<Var Name="SlideSpeedFactor" Type="Float" DefaultValue="1" 	Description="The hgiher value the more speedgain a mouse movement makes." />
					<Var Name="AutoOpenAmount" Type="Float" DefaultValue="1" 	Description="When the OpenAmount is larger than this value it will automatically open to 1.0." />
					<Var Name="SlidePadMultiplier" Type="Float" DefaultValue="1" Description="Multiplier for when this prop is used with a gamepad."/>
					<Var Name="CustomInteractIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="None" Description="Overrides the normal icon shown. If None, the normal ones are shown.." />
				</Group>
				<Group Name="Slide_Sound">
					<Var Name="LockOnSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when prop is locked." />
					<Var Name="LockOffSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when prop is unlocked." />
					<Var Name="InteractLockedSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when the player interacts with the prop while it's locked." />
					<Var Name="InteractJammedSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when the player interacts with the prop while it's jammed." />
					<Var Name="MoveSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as prop is moved. If left empty the value specified in the joint is used." />
					<Var Name="MinMoveSoundSpeed" Type="Float" DefaultValue="-1" 		Description="Min speed the prop should move at before playing sound. If -1 the value specified in the joint is used." />
					<Var Name="AtMaxSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when slide is moved to its max (open) position. If left blank, the sound specified in the joint is used." />
					<Var Name="AtMaxSoundMinSpeed" Type="Float" DefaultValue="0.1" 		Description="Min speed the prop should move at to play the sound when reaching max position." />
					<Var Name="AtMinSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when slide is moved to its min (closed) position. If left blank, the sound specified in the joint is used." />
					<Var Name="AtMinSoundMinSpeed" Type="Float" DefaultValue="0.1" 		Description="Min speed the prop should move at to play the sound when reaching min position." />
					<Var Name="GrabStartSound" Type="File" ResType="Sound" DefaultValue="" 		Description="Sound played when the player grabs the door to start to move it." />
					<Var Name="GrabEndSound" Type="File" ResType="Sound" DefaultValue="" 		Description="Sound played when the player releases the door." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Slide">
					<Var Name="JointMinDistance" Type="Float" DefaultValue="-1" 	Description="The minimum distance. If -1 the value specified in the joint is used." />
					<Var Name="JointMaxDistance" Type="Float" DefaultValue="-1" 	Description="The maximum distance. If -1 the value specified in the joint is used." />
					<Var Name="OpenAmount" Type="Float" DefaultValue="-1" 	Description="How open the door is. 0=atmin, 1=at max. if < 0, the placement set in the ent file is used." />
					<Var Name="AutoCloseTime" Type="Float" DefaultValue="0" 	Description="If the door should close when after being opened and there is no character body inside. If 0 or below, no autoclosing happens." />
					<Var Name="AutoOpen" Type="Bool" DefaultValue="false" 	Description="If the door should automatically open when above AutoOpenAmount threshold"/>
					<Var Name="Locked" Type="Bool" DefaultValue="false" 	Description="If the prop is locked."/>
          </Group>
			</InstanceVars>
		</Class>

		<Class Name="Prop_SlideLock" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="SlideLock">
					<Var Name="HandleMaxSpeed" Type="Float" DefaultValue="4" 	Description="The maximum speed the handle can be moved." />
					<Var Name="HandleSlowDownFactor" Type="Float" DefaultValue="1" 	Description="Amount of slowdown applied to object when not moved." />
					<Var Name="HandleSpeedFactor" Type="Float" DefaultValue="1" 	Description="The higher value the more speedgain a mouse movement makes." />
					<Var Name="AutoOpenAmount" Type="Float" DefaultValue="1" 	Description="When the OpenAmount is larger than this value it will automatically open to 1.0." />
					<Var Name="HandlePadMultiplier" Type="Float" DefaultValue="1" Description="Multiplier for when this prop is used with a gamepad."/>
					<Var Name="CustomInteractIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="None" Description="Overrides the normal icon shown. If None, the normal ones are shown.." />
					<Var Name="InteractOnlyWithMainBody" Type="Bool" DefaultValue="false" Description="If the body set as MainPhysicsBody is the only one that can be interacted with." />
				</Group>
				<Group Name="SlideLock_Sound">
					<Var Name="SoundHandleUp" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when prop is locked." />
					<Var Name="SoundHandleDown" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when prop is unlocked." />
					<Var Name="SoundHandleMove" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when prop is unlocked." />
					<Var Name="SoundHandleGrab" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when the player interacts with the prop while it's locked." />
					<Var Name="SoundHandleGrabStuck" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when the player interacts with the prop while it's locked." />
					<Var Name="SoundHandleGrabStart" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when the player interacts with the prop while it's locked." />
					<Var Name="SoundHandleGrabEnd" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when the player interacts with the prop while it's locked." />
					<Var Name="SoundHandleUpMinSpeed" Type="Float" DefaultValue="1" 	Description="When the OpenAmount is larger than this value it will automatically open to 1.0." />
					<Var Name="SoundHandleDownMinSpeed" Type="Float" DefaultValue="1" 	Description="When the OpenAmount is larger than this value it will automatically open to 1.0." />
					<Var Name="SoundTeethOut" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as prop is moved. If left empty the value specified in the joint is used." />
					<Var Name="SoundTeethIn" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when slide is moved to its max (open) position. If left blank, the sound specified in the joint is used." />
					<Var Name="SoundTeethMove" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when slide is moved to its max (open) position. If left blank, the sound specified in the joint is used." />
					<Var Name="SoundTeethInMinSpeed" Type="Float" DefaultValue="1" 	Description="When the OpenAmount is larger than this value it will automatically open to 1.0." />
					<Var Name="SoundTeethOutMinSpeed" Type="Float" DefaultValue="1" 	Description="When the OpenAmount is larger than this value it will automatically open to 1.0." />
					<Var Name="MinMoveSoundSpeed" Type="Float" DefaultValue="1" 		Description="Min speed the door shouls move at before playing sound. If -1 the value specified in the joint is used." />
				</Group>			
			</TypeVars>
			<InstanceVars>
				<Group Name="Lock">
					<Var Name="StartLocked" Type="Bool" DefaultValue="false" 	Description="If the prop starts in locked position (down). DO not confuse with Stuck."/>
					<Var Name="Stuck" Type="Bool" DefaultValue="false" 	Description="If the prop is stuck and cannot be moved."/>
					<Var Name="AutoCloseTime" Type="Float" DefaultValue="0" 	Description="If the door should close when after being opened and there is no character body inside. If 0 or below, no autoclosing happens." />
					<Var Name="AutoOpen" Type="Bool" DefaultValue="false" 	Description="If the door should automatically open when above AutoOpenAmount threshold"/>
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_SwingDoor" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="SwingDoor_Base">
					<Var Name="CanInteractWithStaticBody" Type="Bool"  DefaultValue="false" 	Description="If by interacting with a static body in the entity, the lever is interacted with. Meaning that interacting with any part of the entity will work." />
					<Var Name="HandleBody" Type="String" DefaultValue="" Description="Name of the body that is connected to the handle of the door" />
					<Var Name="LockBody" Type="String" DefaultValue="" Description="Name of the body connected to the lock joint." />
					<Var Name="AgentDoor" Type="Bool" DefaultValue="true" Description="If the agents should treat it as a door." />
					<Var Name="AutoClose" Type="Bool" DefaultValue="false" Description="If the door should close automatically." />
					<Var Name="BlockedMaxAngle" Type="Float" DefaultValue="2.0" Description="How much game the door has when blocked." />
				</Group>		
				<Group Name="SwingDoor_Speed">
					<Var Name="MoveMaxSpeed" Type="Float"  DefaultValue="2.0" 		Description="The maximum speed it can be moved." />
					<Var Name="MoveSlowDownFactor" Type="Float"  DefaultValue="5.0" 	Description="Amount of slowdown applied to object when not moved." />
					<Var Name="MoveSpeedFactor" Type="Float"  DefaultValue="1.0" 		Description="The hgiher value the more speedgain a mouse movement makes." />
				</Group>
				<Group Name="SwingDoor_Sounds">
					<Var Name="CloseOnSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="" />
					<Var Name="CloseOffSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="" />
					<Var Name="LockOnSound" Type="File"  ResType="Sound"  DefaultValue="" 			Description="" />
					<Var Name="LockOffSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="" />
					<Var Name="InteractLockedSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound made when player interacts with a locked door." />
					<Var Name="BlockOnSound" Type="File"  ResType="Sound"  DefaultValue="" 			Description="" />
					<Var Name="BlockOffSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="" />
					<Var Name="InteractBlockedSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound made when player interacts with a blocked door." />
					<Var Name="MoveSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as door is opened or closed. If left empty the value specified in the joint is used." />
					<Var Name="MinMoveSoundSpeed" Type="Float" DefaultValue="-1" 		Description="Min speed the door shouls move at before playing sound. If -1 the value specified in the joint is used." />
					<Var Name="MaxOpenSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when door is fully opened." />
					<Var Name="MaxOpenSoundMinSpeed" Type="Float" DefaultValue="0" 		Description="Min speed the door should be moving when becoming fully opened to play a sound." />
				</Group>
				<Group Name="SwingDoor_Break_Base">				
					<Var Name="Breakable" Type="Bool"  DefaultValue="false" 	Description="Can the door be broken." />
					<Var Name="BreakMinEnergy" Type="Float" DefaultValue="100" 		Description="The minimum energy needed for breakage. Energy = Object1Speed * Object1Mass + Object2Speed * Object2Mass. Speed = m/s. If Object 2 is floor or something static, its speed is always 0 and does not contribute to total energy!" />
					<Var Name="DamageTint" Type="Bool"  DefaultValue="false" 	Description="If the mesh should change tint when in different damage states, useful for debugging." />
					<Var Name="DamageMesh1" Type="File"  Extensions="dae msh mesh"  DefaultValue="" 		Description="Mesh used when health is below HealthDamage1" />
					<Var Name="DamageMesh2" Type="File"  Extensions="dae msh mesh"  DefaultValue="" 		Description="Mesh used when health is below HealthDamage2" />
					<Var Name="BrokenEntity" Type="File"  Extensions="ent"  DefaultValue="" 	Description="When broken, this mesh is destroyed." />
					<Var Name="BreakImpulse" Type="Float"   DefaultValue="3" 	Description="Imuplse set to objects in broken mesh." />
					<Var Name="HealthDamage1" Type="Float"  DefaultValue="0.66" 	Description="Health when damage mesh 1 is used." />
					<Var Name="HealthDamage2" Type="Float"  DefaultValue="0.33" 	Description="Health when damage mesh 1 is used." />
				</Group>
				<Group Name="SwingDoor_Break_Effects">
					<Var Name="DamageSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound made when a new damage mesh is used." />
					<Var Name="DamagePS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 		Description="Particles created when a new damage mesh is used." />
					<Var Name="BreakSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound made when broken." />
					<Var Name="BreakPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 		Description="Particles created when broken." />
				</Group>
		        <Group Name="SwingDoor_Animation">
		          <Var Name="HandleUpAnimation" Type="String"  DefaultValue="" 		Description="The animation to play when the handle is not held down (leave empty for default)" />
		          <Var Name="HandleDownAnimation" Type="String"  DefaultValue="" 	Description="The animation to play when the player is interacting with the door" />
		          <Var Name="HandleLockedAnimation" Type="String"  DefaultValue="" 	Description="The animation to play when the player is interacting with a locked door" />
		          <Var Name="HandleMovingAnimation" Type="String"  DefaultValue="" 	Description="The animation to play when the door is being moved by the player" />
		          <Var Name="HandleMovingRepetitionMin" Type="Float" DefaultValue="0.25" 	Description="How often HandleMovingAnimation should be played. Random Min value"/>
		          <Var Name="HandleMovingRepetitionMax" Type="Float" DefaultValue="0.5" 	Description="How often HandleMovingAnimation should be played. Random Max value"/>
		        </Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="SwingDoor">
					<Var Name="Locked" Type="Bool" DefaultValue="false" 		Description="If the door is locked (will not move at all)" />
					<Var Name="Blocked" Type="Bool" DefaultValue="false" 		Description="If the door is blocked (will move a little)" />
					<Var Name="OpenAmount" Type="Float" DefaultValue="0" 		Description="The amount the door is open. 0 - 1." />
					<Var Name="DisableBreakable" Type="Bool"  DefaultValue="false" 	Description="If the entity is breakable then having this true will make it unbreakable." />
					<Var Name="IsHatch" Type="Bool"  DefaultValue="false" 		Description="If the door is hatch-type and opens up/down"/>
					<Var Name="HatchIgnorePlayersPosition" Type="Bool"  DefaultValue="false" 		Description="If the door is hatch-type and player's position is ignored while opening."/>
					<Var Name="JointResetFix" Type="Bool" DefaultValue="false" Description="Reset the props position if it disappears because of a physics bug" />
					<Var Name="BreakChildEntity" Type="String" DefaultValue="" Description="Name of the entity that should break when this door is broken" />
					<Var Name="OnBreakCallbackFunc" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="" DefaultValue="" Description="Callback function for when the entity is broken." />
					<Var Name="OpenableByAgent" Type="Bool" DefaultValue="true" Description="If agents can open this door."/>
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Lever" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Lever_Base">
					<Var Name="CanInteractWithStaticBody" Type="Bool"  DefaultValue="true" 	Description="If by interacting with a static body in the entity, the lever is interacted with. Meaning that interacting with any part of the entity will work." />
					<Var Name="StuckSound" Type="String"  DefaultValue="" 			Description="Sound played when stuck" />
					<Var Name="InteractIcon" Type="Enum" DefaultValue="PullLever" Description="The icon that is used" >
						<EnumValue Name="PullLever" />
						<EnumValue Name="PullLeverSmall" />
						<EnumValue Name="PullDoor" />
						<EnumValue Name="PullDoorHatch" />
					</Var>
					<Var Name="MoveSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as lever is moved. If left empty the value specified in the joint is used." />
					<Var Name="MinMoveSoundSpeed" Type="Float" DefaultValue="-1" 		Description="Min speed the lever should move at before playing sound. If -1 the value specified in the joint is used." />				
				</Group>
				<Group Name="Lever_Speed">
					<Var Name="MoveMaxSpeed" Type="Float"  DefaultValue="13.5" 		Description="The maximum speed it can be moved." />
					<Var Name="MoveSlowDownFactor" Type="Float"  DefaultValue="3.0" 	Description="Amount of slowdown applied to object when not moved." />
					<Var Name="MoveSpeedFactor" Type="Float"  DefaultValue="1.0"		Description="The higher value the more speedgain a mouse movement makes." />
					<Var Name="MoveThrowImpulse" Type="Float"  DefaultValue="6.0" 		Description="Impulse added when thrown." />
				</Group>
				<Group Name="Lever_Limits">
					<Var Name="MinLimitRange" Type="Float"  DefaultValue="5.0" 		Description="The distance from min the joint can be to be considered at min limit." />
					<Var Name="MaxLimitRange" Type="Float"  DefaultValue="5.0" 		Description="The distance from max the joint can be to be considered at max limit." />
					<Var Name="MinLimitSound" Type="String"  DefaultValue="" 		Description="Sound played when at min limit" />
					<Var Name="MaxLimitSound" Type="String"  DefaultValue="" 		Description="Sound played when at max limit" />
					<Var Name="MinInteractSound" Type="String"  DefaultValue=""		Description="Additional sound played if interacted with when the lever is at Min" />
					<Var Name="MaxInteractSound" Type="String"  DefaultValue=""		Description="Additional sound played if interacted with when the lever is at Max" />
				</Group>
				<Group Name="Lever_AutoMove">
					<Var Name="AutoMoveSpeedFactor" Type="Float"  DefaultValue="2" 		Description="Multplier applied to speed to determine the speed it moves towards wanted postion. The higher the faster it gets to the postion." />
					<Var Name="AutoMoveMaxSpeed" Type="Float"  DefaultValue="8" 		Description="Max speed it can move at to the wanted postion" />
				</Group>
				<Group Name="Lever_InteractConnection">
					<Var Name="InteractConnectionSpeedFactor" Type="Float"  DefaultValue="4" 		Description="Multplier applied to speed to determine the speed it moves towards wanted postion when the state is adjusted by an interact connected prop. The higher the faster it gets to the postion." />
				</Group>			
			</TypeVars>
			<InstanceVars>
				<Group Name="Lever">
					<Var Name="MoveDirection" Type="Enum" DefaultValue="0" 		Description="The way the lever is intended to be moved." >
						<EnumValue Name="Vertical" />
						<EnumValue Name="Horizontal" />
					</Var>
					
					<Var Name="StuckState" Type="Enum" DefaultValue="0" 		Description="The stuck state for the lever." >
						<EnumValue Name="None" />
						<EnumValue Name="Min" />
						<EnumValue Name="Max" />
					</Var>
					
					<Var Name="MinLimitStuck" Type="Bool"  DefaultValue="false" 		Description="If stuck when at min limit" />
					<Var Name="MaxLimitStuck" Type="Bool"  DefaultValue="false" 		Description="If stuck when at max limit" />
					
					<Var Name="InteractionDisablesStuck" Type="Bool"  DefaultValue="false" 	Description="If stuck is disabled when player interacts." />
					<Var Name="MiddleAngleAmount" Type="Float"  DefaultValue="0" Min="-1" Max="1" Slider="true" StrictRange="true"		Description="The amount between min and max that is conisdered middle. -1-1. -1=at min, 0=exactly between min and max, 1=at max" />
					<Var Name="AutoMoveToAngle" Type="Bool"  DefaultValue="True" 		Description="If the lever should move to position when not interacted with." />
					<Var Name="AutoMoveGoal" Type="Enum"  DefaultValue="0" 			Description="Where it should go when auto moving." >
						<EnumValue Name="Middle" />
						<EnumValue Name="Min" />
						<EnumValue Name="Max" />
						<EnumValue Name="Closest" />
					</Var>
          <Var Name="JointResetFix" Type="Bool" DefaultValue="false" Description="Reset the props position if it disappears because of a physics bug" />
				</Group>
				<Group Name="InteractConnection">
					<Var Name="ConnectedProp" Type="String" DefaultValue="" Description="Name of the connected prop (MoveObject, Rotate, SwingDoor and SlideDoor supported). Wildcards supported." />
					<Var Name="Invert" Type="Bool" DefaultValue="false" Description="If the connection should be inverted." />
					<Var Name="OneWayConnection" Type="Bool" DefaultValue="false" Description="If the connection should be one-way (the connected prop will have no influence over this props state)." />
				</Group>
				<Group Name="Interact">
					<Var Name="LookAtEntity" Type="String" DefaultValue="" Description="Name of the entity to look at while interacting." />
					<Var Name="LookAtAcc" Type="Float" DefaultValue="0.01" Description="LookAt acceleration." />
					<Var Name="LookAtSpeedMul" Type="Float" DefaultValue="0.5" Description="LookAt speed multiplier." />
					<Var Name="LookAtMaxSpeed" Type="Float" DefaultValue="0.5" Description="LookAt maximum speed." />
					<Var Name="LookAtDec" Type="Float" DefaultValue="0.02" Description="LookAt deceleration (once interaction stops on mouse release)." />
					<Var Name="StandTar" Type="String" DefaultValue="" Description="Name of the entity to move to when interacting." />
					<Var Name="DisabledIfStuck" Type="Bool" DefaultValue="false" Description="If the look at and stand tar should be disabled if the prop is stuck." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Button" InheritsFrom="Prop">
			<EditorSetupVars>
				<Var Name="AffectLightsVar" Value="SwitchedOn" />
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Button">
					<Var Name="UseColorChange" Type="Bool" DefaultValue="false" 			Description="If the buttons should change effect colors instead of just during them on/off. Effect on/off time will be used for fade speed." />
					<Var Name="ColorChangeOn" Type="Color" DefaultValue="0.1 1 0.1 1" 			Description="If UseColorChange then this color is used when on." />
					<Var Name="ColorChangeOff" Type="Color" DefaultValue="0.75 0.5 0.1 1" 			Description="If UseColorChange then this color is used when off-" />
					<Var Name="ColorChangeLocked" Type="Color" DefaultValue="1 0.1 0.1 1" 			Description="If UseColorChange then this color is used when locked." />
					<Var Name="ColorChangeDisabled" Type="Color" DefaultValue="0 0 0 1" 			Description="If UseColorChange then this color is used when disabled" />
					<Var Name="Sound_InteractOn" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when button is turned on" />
					<Var Name="Sound_InteractOff" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when button is turned off" />
					<Var Name="Sound_InteractLocked" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when button is locked" />
					<Var Name="Sound_InteractDisabled" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when button is disabled" />
					<Var Name="InteractOnWaitTime" Type="Float" DefaultValue="0.5" 		Description="Time until the button can be pressed again when pressed on" />
					<Var Name="InteractOffWaitTime" Type="Float" DefaultValue="0.5" 		Description="Time until the button can be pressed again when pressed off" />
					<Var Name="LockedBlinkCount" Type="Int" DefaultValue="3" 		Description="Number of times the panel blinks when locked." />
					<Var Name="LockedBlinkTime" Type="Float" DefaultValue="0.3" 		Description="The time each blink takes." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Button">
					<Var Name="SwitchedOn" Type="Bool" DefaultValue="false" 			Description="If the button starts as on or off" />
					<Var Name="CanBeSwitchedOn" Type="Bool" DefaultValue="true" 		Description="If player can switch it on." />
					<Var Name="CanBeSwitchedOff" Type="Bool" DefaultValue="true" 		Description="If player can switch if off." />
					<Var Name="Locked" Type="Bool" DefaultValue="false" 				Description="If the button should be locked" />
					<Var Name="Disabled" Type="Bool" DefaultValue="false" 				Description="If the button should be disabled" />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_MovingButton" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="MovingButton_ColorChange">	
					<Var Name="UseColorChange" Type="Bool" DefaultValue="false" 			Description="If the buttons should change effect colors instead of just during them on/off. Effect on/off time will be used for fade speed." />
					<Var Name="ColorChangeOn" Type="Color" DefaultValue="0.1 1 0.1 1" 			Description="If UseColorChange then this color is used when on." />
					<Var Name="ColorChangeOff" Type="Color" DefaultValue="0.75 0.5 0.1 1" 			Description="If UseColorChange then this color is used when off-" />
					<Var Name="ColorChangeLocked" Type="Color" DefaultValue="1 0.1 0.1 1" 			Description="If UseColorChange then this color is used when locked." />
					<Var Name="ColorChangeDisabled" Type="Color" DefaultValue="0 0 0 1" 			Description="If UseColorChange then this color is used when disabled" />
				</Group>
				<Group Name="MovingButton_Sound">	
					<Var Name="Sound_InteractOn" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when button is turned on" />
					<Var Name="Sound_InteractOff" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when button is turned off" />
					<Var Name="Sound_InteractLocked" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when button is locked" />
					<Var Name="Sound_InteractDisabled" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when button is disabled" />
				</Group>
				<Group Name="MovingButton_Misc">	
					<Var Name="InteractOnWaitTime" Type="Float" DefaultValue="0.5" 		Description="Time until the button can be pressed again when pressed on" />
					<Var Name="InteractOffWaitTime" Type="Float" DefaultValue="0.5" 		Description="Time until the button can be pressed again when pressed off" />
					<Var Name="LockedBlinkCount" Type="Int" DefaultValue="3" 		Description="Number of times the panel blinks when locked." />
					<Var Name="LockedBlinkTime" Type="Float" DefaultValue="0.3" 		Description="The time each blink takes." />
				</Group>
				<Group Name="MovingButton_Body">	
					<Var Name="MoveBody" Type="String" DefaultValue=""						Description="If a body (with mass 0) should be moved when switching on/off, this is the name of that body. If empty then animation is used instead (first animation encountered) which is played backward and forward for off/on." />
					<Var Name="OnPosOffset" Type="Vector3" DefaultValue="0 0 0" 			Description="If there is a MoveBody. Local Position Offset when switched on" />
					<Var Name="OnRotOffset" Type="Vector3" DefaultValue="0 30 0" 			Description="If there is a MoveBody. Local Rotation Offset when switched on" />
					<Var Name="CanOnlyInteractWithMainBody"  Type="Bool"  DefaultValue="false" Description="If should only be possible to interact with main body if false then any body in the entity can be interacted with." />	
				</Group>
				<Group Name="MovingButton_AnalogInput">
					<Var Name="MinMoveSpeed" Type="Float" DefaultValue="0.01" 			Description="The minimum speed the mouse needs to move for it to be registered. The lower the less force is used to move the object." />
					<Var Name="MaxMoveSpeed" Type="Float" DefaultValue="0.03" 			Description="Speed that mousemovements will be capped at." />
					<Var Name="MinMoveLength" Type="Float" DefaultValue="0.3" 			Description="The minimum length the mouse needs to move to change state. The smaller the easier it is to move the object." />
					<Var Name="HasInputDirection" Type="Bool" DefaultValue="true" 		Description="If there is a certain direction that needs to be pulled for on/off."/>
					<Var Name="InputDirectionToOn" Type="Vector2" DefaultValue="1 0" 	Description="If HasInputDirection is true, then this is the input direction for on (and off i opposite)."/>
				</Group>
				<Group Name="MovingButton_Interact">
					<Var Name="ChangeStateAmount" Type="Float" DefaultValue="0.3"  		Description="A amount of movement (a value between 0 and 1) when the button goes to the next state."/>
					<Var Name="ChangeStateOffAmount" Type="Float" DefaultValue="-1.0"  		Description="A amount of movement (a value between 0 and 1) when the button goes to the the off state. Negative value means this will be ignored and ChangeStateAmount used for both on and off transitions."/>
					<Var Name="SimplePressInteraction" Type="Bool" DefaultValue="false" 	Description="If the actions is perfomed without any movement, but simply by pressing a button."/>
					<Var Name="CustomInteractIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="None" Description="Overrides the normal icon shown. If None, the normal ones are shown.." />
					<Var Name="CanInteractWithDisabled" Type="Bool" DefaultValue="false" 	Description="If interacting with a disabled button is allowed."/>
				</Group>
				<Group Name="MovingButton_AutoMove">
					<Var Name="StateAmountOnSpeed" Type="Float" DefaultValue="3" 		Description="Speed state amount changes when turned on and not interacted with."/>
					<Var Name="StateAmountOffSpeed" Type="Float" DefaultValue="3" 		Description="Speed state amount changes when turned off and not interacted with."/>
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="MovingButton">
					<Var Name="SwitchedOn" Type="Bool" DefaultValue="false" 			Description="If the button starts as on or off" />
					<Var Name="CanBeSwitchedOn" Type="Bool" DefaultValue="true" 			Description="If player can switch it on." />
					<Var Name="CanBeSwitchedOff" Type="Bool" DefaultValue="true" 			Description="If player can switch if off." />
					<Var Name="ReturnToOffTime" Type="Float" DefaultValue="-1" 			Description="After this time, it goes automatically to off. if 0 or below, it stays in on." />
					<Var Name="Locked" Type="Bool" DefaultValue="false" 				Description="If the button should be locked" />
					<Var Name="Disabled" Type="Bool" DefaultValue="false" 				Description="If the button should be disabled" />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_LevelDoor" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="LevelDoor">
					<Var Name="EnterSound" Type="File" ResType="Sound" DefaultValue="" Description="Sound to play before loading the next level." />
					<Var Name="ExitSound" Type="File" ResType="Sound" DefaultValue="" Description="Sound to play when the player enters the next level." />
					<Var Name="OpenAnim" Type="String" DefaultValue="" Description="The animation that the player will play at the door on interaction." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="LevelDoor">
					<Var Name="MapFile" Type="String" DefaultValue="" Description="Level that the door leads to." />
					<Var Name="StartPos" Type="String" DefaultValue="" Description="Name of the start position of the level." />
					<Var Name="Locked" Type="Bool" DefaultValue="false" Description="If the door starts out as locked." />
					<Var Name="LockedSound" Type="File"  ResType="Sound"  DefaultValue="" Description="Sound to play if the player tries to open the door while locked." />
					<Var Name="LockedTextCat" Type="String" DefaultValue="" Description="Category of the text entry to show if the player tries to open the door while locked." />
					<Var Name="LockedTextEntry" Type="String" DefaultValue="" Description="The text entry to show if the player tries to open the door while locked." />
					<Var Name="OpenAnim" Type="String" DefaultValue="" Description="Overrides the default animation the player will play at the door on interaction." />
          <Var Name="CheckPlayGo" Type="Bool" DefaultValue="false" Description="Should the game wait for PlayGo to finish download before progressing?" />
				</Group>
			</InstanceVars>
