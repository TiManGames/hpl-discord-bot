        <Class Name="Prop_MemoryCylinder" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="Memory_Cylinder">
					<Var Name="VoiceSubject" Type="String" DefaultValue="" 		Description="The subject of the memory cylinder. Should be in scene MemoryCylinder."></Var>
