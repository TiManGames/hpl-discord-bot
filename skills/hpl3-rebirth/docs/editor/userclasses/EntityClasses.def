		<Class Name="Prop_DoorBar" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Grab">
					<Var Name="Grab_UseCustomOffset" Type="Bool" DefaultValue="false" Description="If special orientation is always used when object is grabbed." />
					<Var Name="Grab_CustomPositionOffset" Type="Vec3" DefaultValue="0 0 0" Description="custom oritention position offset." />
					<Var Name="Grab_CustomRotationOffset" Type="Vec3" DefaultValue="0 0 0" Description="custom oritention rotational offset." />
					<Var Name="Grab_UseCustomDepth" Type="Bool" DefaultValue="false" Description="If the grabbed object should always be a certain distance from the player." />
					<Var Name="Grab_CustomDepth" Type="Float" DefaultValue="1.2" Description="The custom depth value." />
					<Var Name="Grab_MassMul" Type="Float" DefaultValue="0.1" Description="The amount of mass used when picked up." />
					<Var Name="Grab_MinDepth" Type="Float" DefaultValue="0.8" Description="Min depth from player the object can be moved to." />
					<Var Name="Grab_MaxDepth" Type="Float" DefaultValue="2" Description="Max depth from player the object can be moved to." />
					<Var Name="Grab_ForceMul" Type="Float" DefaultValue="1"  Description="Force multiplier. Use if movements are erratic (lower it) or object is slow (increase)." />
					<Var Name="Grab_TorqueMul" Type="Float" DefaultValue="1" Description="Torque multiplier. Use if rotations are erratic (lower it) or object is slow (increase)." />
					<Var Name="Grab_ThrowImpulse" Type="Float" DefaultValue="5.0" Description="Impulse amount used when throwing the prop" />
					<Var Name="Grab_IsHeavy" Type="Bool" DefaultValue="false" Description="If the object is heavy (like a large crate) this sets up some special restrictions when interacting to make it feel more heavy." />
					<Var Name="Grab_CollisionWithPlayer" Type="Bool" DefaultValue="false" Description="If the object should still check collision with player even while interacting with it." />
					<Var Name="Grab_InteractOnlyWithMainBody" Type="Bool" DefaultValue="false" Description="If the body set as MainPhysicsBody is the only one that can be interacted with." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Grab">
					<Var Name="InteractDisablesStaticPhysics" Type="Bool" DefaultValue="false" Description="If static physics should be disabled when the prop is interacted with." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Agent_General" InheritsFrom="Agent" UsesComponents="CharMover, HeadTracker, Listener">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="Custom_Senses">
					<Var Name="HearingMul" Type="float" DefaultValue="1"  Description="Multiplier for monsters hearing rage" />
					<Var Name="SightMul" Type="float" DefaultValue="1"  Description="Multiplier for monsters sight range" />
					<Var Name="Deaf" Type="Bool" DefaultValue="false" Description="If the agent is permanently deaf" />
					<Var Name="Blind" Type="Bool" DefaultValue="false" Description="If the agent is permanently blind" />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Agent_Ghoul" InheritsFrom="Agent" UsesComponents="CharMover, ClimbAnimations, HeadTracker, Listener, FootPlacement">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Attack_Animations">
					<Var Name="CloseAttackName" type="string" DefaultValue="Attack" Description="Name of close attack. Usually something like 'Attack' which will turn in to Attack_1 at runtime" />
					<Var Name="NumAttackAnims" type="int" DefaultValue="1" Description="The number of melee attack animations used. Starts at 1" />
					<Var Name="LungeAttackName" type="string" DefaultValue="Attack" Description="Name of lunge attack. Usually something like 'AttackLunge' which will turn in to AttackLunge_1 at runtime" />
					<Var Name="NumAttackLungeAnims" type="int" DefaultValue="1" Description="The number of lunge attack animations used. Starts at 1" />
				</Group>
				<Group Name="Meat_Properties">
					<Var Name="MinEatTime" Type="float" DefaultValue="30"  Description="Minimum (in seconds) to eat meat" />
					<Var Name="MaxEatTime" Type="float" DefaultValue="45"  Description="Maximum (in seconds) to eat meat" />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Custom_Senses">
					<Var Name="HearingMul" Type="float" DefaultValue="1"  Description="Multiplier for monsters hearing rage" />
					<Var Name="SightMul" Type="float" DefaultValue="1"  Description="Multiplier for monsters sight range" />
				</Group>

				<Group Name="Ghoul">
					<Var Name="RetreatAreas" Type="string" DefaultValue=""  Description="The name of the retreat area or group of retreat areas (*). Will not use retreat areas if empty." />
				</Group>

				<Group Name="Hole Network">
					<Var Name="HoleNetwork" Type="string" DefaultValue=""  Description="The name of the group of ghoul holes the ghoul should move between, use wildcard *." />
					<Var Name="PlayerPath" Type="string" DefaultValue=""  Description="The name of the group of nodes that represent the general path the player will take, used to determine if a hole is ahead or behind the player, use wildcard *." />
					<Var Name="HoleConnections" Type="string" DefaultValue=""  Description="The name of a group of areas that represent the connections between holes, the ghoul will move along these areas and make noise, use wildcard *." />
				</Group>

				<Group Name="Voice">
					<Var Name="UseVoice" Type="Bool" DefaultValue="true"	Description="If the ghoul should use voices" />
					<Var Name="VoiceCharacter" type="string" DefaultValue="" Description="The name of the voice character." />
					<Var Name="AlertSubject" Type="String" DefaultValue="" Description="The subject played when the ghoul enters alert" />
					<Var Name="RetreatSubject" Type="String" DefaultValue="" Description="The subject played when the ghoul retreats" />
					<Var Name="EmergeSubject" Type="String" DefaultValue="" Description="The subject played when the ghoul emerges from a hole" />
					<Var Name="SmellSubject" Type="String" DefaultValue="" Description="The subject played when the ghoul tries to smell the player" />
					<Var Name="EndSearchSubject" Type="String" DefaultValue="" Description="The subject played when the ghoul cannot find the player and ends the search" />
					<Var Name="CheckLastKnownPositionSubject" Type="String" DefaultValue="" Description="The subject played when the ghoul has seen a glimpse of the player and checks out that position" />
					<Var Name="HitByObjectSubject" Type="String" DefaultValue="" Description="The subject played when the ghoul is hit by an object" />
					<Var Name="WanderSubject" Type="String" DefaultValue=""	Description="The subject played at random when the ghoul is wandering" />
					<Var Name="WanderMinMaxTime" Type="Vector2" DefaultValue="10 15" Description="Min and Max time between the random patrol barks." />
					<Var Name="SearchSubject" Type="String" DefaultValue=""	Description="The subject played at random when the ghoul is searching for the player" />
					<Var Name="SearchMinMaxTime" Type="Vector2" DefaultValue="10 15" Description="Min and Max time between the random search barks." />
					<Var Name="EatMeatSubject" Type="String" DefaultValue=""	Description="The subject played at random when the ghoul is eating meat" />
					<Var Name="EatMeatMinMaxTime" Type="Vector2" DefaultValue="10 15" Description="Min and Max time between the random eating barks." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Agent_SandLurker" InheritsFrom="Agent" UsesComponents="CharMover, HeadTracker, Listener">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="SandLurker">
					<Var Name="HomeEntity" Type="string" DefaultValue=""  Description="Entity that is at the center of the sand lurker's wander area." />
					<Var Name="HuntArea" Type="string" DefaultValue=""  Description="If the player is in this area they will be hunted by the lurker." />
					<Var Name="MaxWanderDist" Type="float" DefaultValue="125"  Description="Distance from home position that the SandLurker might wander." />
					<!--<Var Name="MinWanderPlayerDist" Type="float" DefaultValue="35"  Description="Closest distance from the player that the sand lurker will go to when in its wander mode." />
					<Var Name="HuntRange" Type="float" DefaultValue="90"  Description="At what distance the lurker will start hunting the player." />-->
					<Var Name="StartState" Type="Enum" DefaultValue="Idle"	Description="State to start out in" >
						<EnumValue Name="Idle" />
						<EnumValue Name="Wander" />
					</Var>
				</Group>
			</InstanceVars>
		</Class>
		
