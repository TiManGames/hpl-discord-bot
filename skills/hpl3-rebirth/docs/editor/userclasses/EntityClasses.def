		<Class Name="Prop_Tear" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Tear">
					<Var Name="Tear_Joint" Type="String" DefaultValue="" Description="Joint that should be tearable. The child body of the joint will be used for all interaction. If no joint name is specified, the joint with index 0 will be used." />
					<Var Name="Tear_MoveMaxSpeed" Type="Float" DefaultValue="1" Description="The max speed at which the prop can be torn." />
					<Var Name="Tear_MoveSpeedFactor" Type="Float" DefaultValue="0.9" Description="How much the mouse movement affects the speed of the prop while torn." />
					<Var Name="Tear_MoveSlowDownSpeed" Type="Float" DefaultValue="0.6" Description="How fast the prop slows down while interacted with." />
					<Var Name="Tear_LoseGripWhenTorn" Type="Bool" DefaultValue="false" Description="If the player should drop the prop when it has been torn loose. If false, the interaction will automatically turn into a grab interaction when torn." />
					<Var Name="Tear_AvoidBreakingJointWhenTorn" Type="Bool" DefaultValue="false" Description="If the joint should not be broken after tearing the entity. Useful for entities with many joints." />
					<Var Name="Tear_VelocityMulWhenTorn" Type="Float" DefaultValue="1" Description="The magnitude of the velocity the prop should have when torn. Affects both angular and linear velocity." />
					<Var Name="Tear_HealthLossFactor" Type="Float" DefaultValue="2" Description="How fast the prop should break from wiggling. A value of 2 means it will take 0.5 seconds of tearing at full speed to reduce health to zero." />
					<Var Name="Tear_MaxSnapBackSpeed" Type="Float" DefaultValue="3" Description="How fast the prop should move back into place when not interacted with." />
					<Var Name="Tear_MainBodyMassMul" Type="Float" DefaultValue="1" Description="Value to multiply the main tear body's mass with. Useful for entites with several joints to reduce jitter." />
					<Var Name="Tear_StressSound" Type="File"  ResType="Sound" DefaultValue="" 	Description="Sound played when under stress" />
					<Var Name="Tear_InteractOnlyWithMainBody" Type="Bool" DefaultValue="false" Description="If the body set as MainPhysicsBody is the only one that can be interacted with." />
					<Var Name="Tear_HealthTearOnly" Type="Bool" DefaultValue="false" Description="If the prop can obly be torn via health loss, and not by reaching the max joint limit." />
					<Var Name="Tear_CanBeTorn" Type="Bool" DefaultValue="true" Description="If the prop can be torn." />
					<Var Name="Tear_PlayerMoveSpeedMul" Type="Float" DefaultValue="1.5" Description="Player move speed multiplier when tearing by moving." />
				</Group>
				<Group Name="Tear_Break">				
					<Var Name="BreakActive" Type="Bool" DefaultValue="true" Description="If entity is broken when hit hard enough or health is 0." /> 
					<Var Name="CustomBreakBehaviour" Type="Bool" DefaultValue="true" Description="If true, void OnCustomBreak() will be called inside the prop script and override the normal break behaviour." /> 
					<Var Name="BreakOnlyOnMainBody" Type="Bool" DefaultValue="false" Description="If the entity will only break from impact if the main body is hit." /> 
					<Var Name="BreakDestroyJoints" Type="Bool" DefaultValue="false" Description="If all physics joints should be destroyed when broken." />
					<Var Name="BreakMinEnergy" Type="Float" DefaultValue="20" Description="The minimum energy needed for breakage. Energy = Object1Speed * Object1Mass + Object2Speed * Object2Mass. Speed = m/s. If Object 2 is floor or something static, its speed is always 0 and does not contribute to total energy!" />
					<Var Name="BreakEntity" Type="File"  Extensions="ent" DefaultValue="" Description="The entity this entity turns into when broken." />
					<Var Name="BreakEntityAlignBody" Type="String" DefaultValue="" Description="The body BreakEntity uses to align itself when created. ''=no entity is created." />
					<Var Name="BreakSound" Type="File"  ResType="Sound" DefaultValue=""	Description="The sound made when broken." />
					<Var Name="BreakParticleSystem" Type="File"  ResType="ParticleSystem" DefaultValue="" 		Description="Particle system shown when broken." />
					<Var Name="BreakImpulse" Type="Float" DefaultValue="4" Description="Impulse (speed in m/s really) added to all bodies in BreakENtity when created. The direction of impulse is outwards from center of entity." />
				</Group>
				<Group Name="Grab">
					<Var Name="Grab_UseCustomOffset" Type="Bool" DefaultValue="false" Description="If special orientation is always used when object is grabbed." />
					<Var Name="Grab_CustomPositionOffset" Type="Vec3" DefaultValue="0 0 0" Description="custom oritention position offset." />
					<Var Name="Grab_CustomRotationOffset" Type="Vec3" DefaultValue="0 0 0" Description="custom oritention rotational offset." />
					<Var Name="Grab_UseCustomDepth" Type="Bool" DefaultValue="false" Description="If the grabbed object should always be a certain distance from the player." />
					<Var Name="Grab_CustomDepth" Type="Float" DefaultValue="1.2" Description="The custom depth value." />
					<Var Name="Grab_MassMul" Type="Float" DefaultValue="0.1" Description="The amount of mass used when picked up." />
					<Var Name="Grab_MinDepth" Type="Float" DefaultValue="0.8" Description="Min depth from player the object can be moved to." />
					<Var Name="Grab_MaxDepth" Type="Float" DefaultValue="2" Description="Max depth from player the object can be moved to." />
					<Var Name="Grab_ForceMul" Type="Float" DefaultValue="1"  Description="Force multiplier. Use if movements are erratic (lower it) or object is slow (increase)." />
					<Var Name="Grab_TorqueMul" Type="Float" DefaultValue="1" Description="Torque multiplier. Use if rotations are erratic (lower it) or object is slow (increase)." />
					<Var Name="Grab_ThrowImpulse" Type="Float" DefaultValue="5.0" Description="Impulse amount used when throwing the prop" />
					<Var Name="Grab_IsHeavy" Type="Bool" DefaultValue="false" Description="If the object is heavy (like a large crate) this sets up some special restrictions when interacting to make it feel more heavy." />
					<Var Name="Grab_CollisionWithPlayer" Type="Bool" DefaultValue="false" Description="If the object should still check collision with player even while interacting with it." />
					<Var Name="Grab_InteractOnlyWithMainBody" Type="Bool" DefaultValue="false" Description="If the body set as MainPhysicsBody is the only one that can be interacted with." />
				</Group>
			</TypeVars>
			<InstanceVars>
            <Group Name="Tear">
					<Var Name="Tear_TornCallback" Type="Function" DefaultValue="" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_TornCallback" Description="Map callback when the prop has been torn. Syntax: void Func(const tString in asEntity)" />
                </Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_PhysicsSlideDoor" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="PhysicsSlideDoor">
					<Var Name="SlideMaxSpeed" Type="Float" DefaultValue="4" 	Description="The maximum speed it can be moved." />
					<Var Name="SlideSlowDownFactor" Type="Float" DefaultValue="1" 	Description="Amount of slowdown applied to object when not moved." />
					<Var Name="SlideSpeedFactor" Type="Float" DefaultValue="1" 	Description="The hgiher value the more speedgain a mouse movement makes." />
					<Var Name="AutoOpenAmount" Type="Float" DefaultValue="0.8" 	Description="When the OpenAmount is larger than this value it will automatically open." />
					<Var Name="AutoCloseAmount" Type="Float" DefaultValue="0.2" 	Description="When the OpenAmount is less than this value it will automatically close." />
					<Var Name="AutoMoveForceMul" Type="Float" DefaultValue="1" 	Description="Controls the force applied to the door when automoving.." />
					<Var Name="AutoMoveMaxSpeed" Type="Float" DefaultValue="3" 	Description="When the OpenAmount is less than this value it will automatically close." />
					<Var Name="AgentColliderBody" Type="String" DefaultValue="" Description="A special body that will only be active when the door is closed and only collide with with agents. Not used if string is empty." />
					<Var Name="AgentColliderBody" Type="String" DefaultValue="" Description="A special body that will only be active when the door is closed and only collide with with agents. Not used if string is empty." />
					<Var Name="MoveDirection" Type="Enum" DefaultValue="Horizontal"	Description="The direction the door is moved in." >
						<EnumValue Name="Horizontal" />
						<EnumValue Name="Vertical" />
					</Var>
					<Var Name="AgentDoor" Type="Bool" DefaultValue="true" Description="If the agents should treat it as a door." />
				</Group>
				<Group Name="PhysicsSlideDoor_Sounds">
					<Var Name="LockOnSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when prop is locked." />
					<Var Name="LockOffSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when prop is unlocked." />
					<Var Name="InteractLockedSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when the player interacts with the prop while it's locked." />
					<Var Name="InteractJammedSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when the player interacts with the prop while it's jammed." />
					<Var Name="MoveSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as prop is moved. If left empty the value specified in the joint is used." />
					<Var Name="MinMoveSoundSpeed" Type="Float" DefaultValue="-1" 		Description="Min speed the prop should move at before playing sound. If -1 the value specified in the joint is used." />
					<Var Name="AtMaxSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when door is fully opened. If left blank, the sound specified in the joint is used." />
					<Var Name="AtMaxSoundMinSpeed" Type="Float" DefaultValue="0.1" 		Description="Min speed the door should move at to play the sound when fully opened." />
					<Var Name="AtMinSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played when door is fully closed. If left blank, the sound specified in the joint is used." />
					<Var Name="AtMinSoundMinSpeed" Type="Float" DefaultValue="0.1" 		Description="Min speed the door should move at to play the sound when fully closed." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Slide">
					<Var Name="OpenableByAgent" Type="Bool" DefaultValue="true" Description="If agents can open this door" />
					<Var Name="OpenAmount" Type="Float" DefaultValue="-1" 	Description="How open the door is. 0=atmin, 1=at max. if < 0, the placement set in the ent file is used." />
					<Var Name="AutoCloseTime" Type="Float" DefaultValue="0" 	Description="The time after which the door should close after being opened and there is no character body inside. If 0 or below, no autoclosing happens." />
					<Var Name="AutoOpen" Type="Bool" DefaultValue="false" 	Description="If the door should automatically open when above AutoOpenAmount (in ent file)  threshold"/>
					<Var Name="AutoClose" Type="Bool" DefaultValue="false" 	Description="If the door should automatically close when above AutoCloseAmount  (in ent file) threshold"/>
					<Var Name="Locked" Type="Bool" DefaultValue="false" 	Description="If the prop is locked."/>
          </Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Meter" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Meter_Base">
					<Var Name="NeedleBodyName" Type="String" DefaultValue=""			Description="Name of the needle body that will be rotated/moved. Needed if Prop has more than one body." />
				</Group>
				<Group Name="Meter_GeneralMovement">
					<Var Name="RotationAtMax" Type="Float" DefaultValue="0" 			Description="The maximum angle offset in the z axis of the needle can be rotated to." />
					<Var Name="TranslationAtMax" Type="Vec3" DefaultValue="0 0 0" 		Description="The maximum position offset (local to the body) restraint for the needle." />
					<Var Name="MaxSpeed" Type="Float" DefaultValue="1" 					Description="The maximum speed for the needle." />
					<Var Name="SpeedMul" Type="Float" DefaultValue="1" 					Description="The speed multiplier for the needle." />
				</Group>
				<Group Name="Meter_Vibration">
					<Var Name="VibrationFrequency" Type="Float" DefaultValue="0" 		Description="If the needle should shake then this is it's frequency. 0 = no shaking" />
					<Var Name="VibrationAmplitude" Type="Float" DefaultValue="0" 		Description="If the needle should shake then this is it's amplitude. 0 = no shaking" />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Meter">
					<Var Name="NeedleState" Type="Float" DefaultValue="0"				Description="The needles start state. A number between 0-1. 0 = min & 1 = max" />
					<Var Name="ShakeMul" Type="Float" DefaultValue="0" 					Description="If the needle should shake then this is it's total shake multiplier. 0 = no shaking" />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_PlayerHands" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_PlayerBody" InheritsFrom="Prop" UsesComponents="FootPlacement, HandPlacement">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="PlayerBody_General">
					<Var Name="PlayerBody_YawSoftLimit" Type="Float" DefaultValue="70" 					Description="The yaw at which the turn animation should start playing and the body starts to turn to align with the camera." />
					<Var Name="PlayerBody_YawHardLimit" Type="Float" DefaultValue="95" 					Description="The maximum yaw offset between the camera and the body. Body rotation will be clamped to this offset if the camera is rotated too fast for the body to catch up in a smooth way." />
					<Var Name="PlayerBody_YawSoftLimit_Crouch" Type="Float" DefaultValue="25" 					Description="Same as YawSoftLimit but only affects the crouch state. If < 0 the standing value will be used." />
					<Var Name="PlayerBody_YawHardLimit_Crouch" Type="Float" DefaultValue="45" 					Description="Same as YawHardLimit but only affects the crouch state. If < 0 the standing value will be used." />
					<Var Name="PlayerBody_MinRunSpeed" Type="Float" DefaultValue="3" 					Description="The minimum speed at which the run animation should kick in." />
				</Group>
				<Group Name="PlayerBody_Bones">
					<Var Name="PlayerBody_YawBones" Type="String" DefaultValue=""			Description="Bones that will turn to match the player's rotation. To keep arms in sync, these should mainly be bones below the shoulder." />
					<Var Name="PlayerBody_YawBoneWeights" Type="String" DefaultValue=""			Description="Weight of each yaw bone separated by spaces. Must be as many weights as there are bones and they must add up to 1." />
					<Var Name="PlayerBody_YawBoneAxes" Type="String" DefaultValue="0 1 0"			Description="The axis each yaw bone will rotate around stated as a sequence of float values separated by spaces. '0 1 0 1 0 0' means the first bone will rotate around the Y axis while the second bone will rotate along X. If fewer values are entered than the number of bones, the last entry will be used for the remaining bones." />
					<Var Name="PlayerBody_PitchBones" Type="String" DefaultValue=""			Description="Bones that will turn to match the pitch of the camera." />
					<Var Name="PlayerBody_PitchBoneWeights" Type="String" DefaultValue=""			Description="Weight of each pitch bone separated by spaces. Must be as many weights as there are bones and they must add up to 1" />
					<Var Name="PlayerBody_PitchBoneAxes" Type="String" DefaultValue="-1 0 0"			Description="The axis each pitch bone will rotate around stated as a sequence of float values separated by spaces. '0 1 0 1 0 0' means the first bone will rotate around the Y axis while the second bone will rotate along X. If fewer values are entered than the number of bones, the last entry will be used for the remaining bones." />
					<Var Name="PlayerBody_ShakeBones" Type="String" DefaultValue=""			Description="Bones that will rotate during screen shakes." />
					<Var Name="PlayerBody_ShakeBoneWeights" Type="String" DefaultValue=""			Description="Weight of each shake bone separated by spaces. Must be as many weights as there are bones and they must add up to 1" />
					<Var Name="PlayerBody_ShakeBoneAxes" Type="String" DefaultValue="-1 0 0"			Description="The axis each shake bone will rotate around stated as a sequence of float values separated by spaces. '0 1 0 1 0 0' means the first bone will rotate around the Y axis while the second bone will rotate along X. If fewer values are entered than the number of bones, the last entry will be used for the remaining bones." />
					<Var Name="PlayerBody_LeftArmControlBone" Type="String" DefaultValue=""			Description="Bone in left arm that will rotate to keep the arm animations in line with the camera." />
					<Var Name="PlayerBody_LeftArmPitchAxis" Type="Vec3" DefaultValue="-1 0 0"  Description="Axis that the left arm is rotated around." />
					<Var Name="PlayerBody_LeftArmYawAxis" Type="Vec3" DefaultValue="0 1 0"  Description="Axis that the left arm is rotated around." />
					<Var Name="PlayerBody_RightArmControlBone" Type="String" DefaultValue=""			Description="Bone in right arm that will rotate to keep the arm animations in line with the camera." />
					<Var Name="PlayerBody_RightArmPitchAxis" Type="Vec3" DefaultValue="1 0 0"  Description="Axis that the right arm is rotated around." />
					<Var Name="PlayerBody_RightArmYawAxis" Type="Vec3" DefaultValue="0 1 0"  Description="Axis that the right arm is rotated around." />
				</Group>
				<Group Name="PlayerBody_Animations">
					<Var Name="PlayerBodyAnim_Idle" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_Walk_Base" Type="String" DefaultValue=""			Description="All actual animations should be named [PlayerBodyAnim_Walk_Base] followed by _fwd, _fwd_right, _right, _back_right, _back, _back_left, _left, _fwd_left." />
					<Var Name="PlayerBodyAnim_CrouchWalk_Base" Type="String" DefaultValue=""			Description="All actual animations should be named [PlayerBodyAnim_CrouchWalk_Base] followed by _fwd, _fwd_right, _right, _back_right, _back, _back_left, _left, _fwd_left." />
					<Var Name="PlayerBodyAnim_Run_Base" Type="String" DefaultValue=""			Description="All actual animations should be named [PlayerBodyAnim_Run_Base] followed by _fwd, _fwd_right, _right, _left, _fwd_left. Note that Run doe not have any Back animations!" />
					<Var Name="PlayerBodyAnim_TurnRight" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_TurnLeft" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_CrouchIdle" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_CrouchTurnRight" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_CrouchTurnLeft" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_StandToCrouch" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_CrouchToStand" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_JumpLaunch" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_JumpFall" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_JumpLand" Type="String" DefaultValue=""			Description="" />
					<Var Name="PlayerBodyAnim_PermafailWakeUpAnims" Type="String" DefaultValue=""			Description="A list of animations for waking up from permafails." />
					<Var Name="PlayerBodyAnim_PermafailCrouchWakeUpAnims" Type="String" DefaultValue=""			Description="A list of animations for waking up from permafails when crouching." />
				</Group>
			</TypeVars>
			<InstanceVars>
			</InstanceVars>
		</Class>
		
		<BaseClass Name="Critter">
			<EditorSetupVars>
				<Var Name="DiffuseColorMulVar" Value="ColorMul" />
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Base">
					<Var Name="Health" Type="Float" DefaultValue="100" 		Description="The amount of damamge an entity can take." />
					<Var Name="Toughness" Type="Int" DefaultValue="0" 		Description="If strength of attack is 1 lower than damage is halfed. 2 or more lower damage is 0. If equal or higher, damage stays the same." />
					<Var Name="EventTag" Type="String" DefaultValue="" 		Description="A tag string used that is mainly used by the event system to group certain type of objects." />
					<Var Name="MaxInteractDistance" Type="Float" DefaultValue="0"  Description="The max distance that interaction can take place. If within player height, then made in 2D (xz). If 0, default is used!" />
					<Var Name="MaxEnabledDistance" Type="Float" DefaultValue="60"  Description="The max distance from the player that the critter is active" />
				</Group>
				<Group Name="Appearance">
					<Var Name="CastShadows" Type="Bool" DefaultValue="true" 			Description="Should shadows be cast." />
					<Var Name="MeshRotationOffset" Type="Vec3" DefaultValue="0 0 0"  Description="The roation of the mesh so it is aligned in Z+ direction." />
					<Var Name="EffectsOnTime" Type="Float" DefaultValue="1" 		Description="Time it takes for on effect to be done. (used for lamps lit/unlit, but also other entity types)."/>
					<Var Name="EffectsOffTime" Type="Float" DefaultValue="1" 		Description="Time it takes for off effect to be done. (used for lamps lit/unlit, but also other entity types)."/>
					<Var Name="MaxAnimationDistance" Type="Float" DefaultValue="10" Description="How close the critter has to be for animations to be used" />
				</Group>
				<Group Name="Critter_Script">
					<Var Name="CustomScriptFile" Type="String" DefaultValue="" 	Description="The file of the custom script." />
					<Var Name="CustomScriptClass" Type="String" DefaultValue="" 	Description="The class name of the custom script. " />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Name="EventInstanceTag" Type="String" DefaultValue="" 		Description="A tag string used that is mainly used by the event system to group certain type of objects." />
					<Var Name="CollideGroup" Type="String"  DefaultValue="" 	Description="This is the name of a collide group that this entity belongs to. Each entity can only belong to ONE collide group. The name must begin with - or +. Collision for this entity is disabled for other entities with the same group name but of the opposite sign.  +player, +agent and +critter are already in use. (Note: The maximum number of collide groups in any given map is 254)." />
					<Var Name="GroupEntityName" Type="String" DefaultValue="" 	Description="The name of an entity that the critter swarm around.(usually, depends on type)" />
					<Var Name="UserVar" Type="String" DefaultValue="" 		Description="Value of a variable. Accessed with  Entity_GetVar[Type](&quot;&quot;) (an empty string as argument). Can be of any type (determined when you choose to access)." />
					<Var Name="FullGameSave" Type="Bool" DefaultValue="false" 			Description="If the all things in the entity should be saved when exiting the level. Only use on few entities!" />
					<Var Name="DisableAtMaxDistance" Type="Bool" DefaultValue="true" 			Description="If the critter should be disabled at the max distance set in the ent file." />
				</Group>
				<Group Name="Internal State">
					<Var Name="EffectsActive" Type="Bool"  DefaultValue="true" 	Description="If entity should have its effects active." />
				</Group>
				<Group Name="Appearance">	
					<Var Name="ColorMul" Type="Color" DefaultValue="1 1 1 1" 		Description="Color the diffuse texture of the prop is multiplied with." />
				</Group>
				<Group Name="Basic Callbacks">	
					<Var Name="ConnectionStateChangeCallback" Type="Function" ReturnType="void" Params="const tString &amp; in asEntity, int alState" Suffix="_OnConnectionStateChange"	Description="A callback called when ever the connection state changes (button being switched on). Syntax: void Func(const tString & in EntityName, int alState). alState: -1=off, 0=between 1=on" />
					<Var Name="PlayerLookAtCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity, int alState"	Suffix="_OnPlayerLookAt"			Description="Callback called when player looks on entity. Syntax: void Func(tString &in entity, int alState) state: 1=looking, -1=not looking" />
					<Var Name="PlayerLookAtCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should look at callback be removed when entity is looked at and callback called." />
					<Var Name="PlayerLookAtCheckCenterOfScreen" Type="Bool" DefaultValue="true" 	Description="If the entity counts as looked at only when at the center of the screen."/>
					<Var Name="PlayerLookAtCheckRayIntersection" Type="Bool" DefaultValue="true" 	Description="If the entity counts as looked at only if there is a clear line of sight to it. Note that this can return false negatives, especially when not checking center of screen."/>
					<Var Name="PlayerLookAtMaxDistance" Type="Float" DefaultValue="-1" 	Description="How far away the entity can be and still be counted as looked at. If less than 0, the maximum possible value will be used."/>
					<Var Name="PlayerLookAtCallbackDelay" Type="Float" DefaultValue="0" 	Description="How long after looking at or away from the entity the callback should trigger."/>
					<Var Name="PlayerInteractCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteract"		Description="Callback called when player interacts with entity. Syntax: void Func(tString &in entity)" />
					<Var Name="PlayerInteractCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should interact callback be removed when entity is interacted with and callback called." />
					<Var Name="PlayerInteractLeaveCallback" Type="Function"  ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteractLeave"	Description="Callback called when player stops interacting with entity. Syntax: void Func(tString &in entity)" />
					<Var Name="PlayerInteractLeaveCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should interact leave callback be removed when entity is interacted with and callback called." />
				</Group>
				<Group Name="Collide Callbacks">	
					<Var Name="CC_Entities" Type="String" DefaultValue="" 		Description="The entities that have a callback to this entity, sepperate each with space and/or comma. May use wildcards (*). Having 'player' as entity means that current entity will be attached on player." />
					<Var Name="CC_Funcs" Type="Function"  ReturnType="bool" Params="const tString &amp;in asParent, const tString &amp;in asChild, int alState" 		Description="The callback fucntions for all the entities. Syntax: bool Func(const tString &in asParent, const tString &in asChild, int alState). If false is returned callback is removev. states: 1=enter, -1=leave If using several sepperate with comma and/or spaces. If only one function, all entity collision will use, else they are connected following the order. If there are more entities than functions, the last function will be used for the remaining entities." />
				</Group>
				<Group Name="Connections">	
					<Var Name="ConnectedEntity" Type="String"  DefaultValue="" 		Description="The entity to make a connection to. May use wildcards (*). The connection created will be called 'Main'." />
					<Var Name="ConnectedEntityInvertState" Type="Bool"  DefaultValue="false" 		Description="If the state sent to the connected entity should be inverted." />
					<Var Name="ConnectedEntityStatesUsed" Type="Int"  DefaultValue="0" 		Description="What states that should be sent. 0=any value. 1=only 1, -1= only -1." />
				</Group>
			</InstanceVars>
		</BaseClass>
		
		<Class Name="Critter_General" InheritsFrom="Critter" UsesComponents="BackboneTail">
			<EditorSetupVars>
				<Var Name="AffectShadowsVar" Value="CastShadows" />
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Critter_General">
					<Var Name="GravityForce" Type="Float" DefaultValue="9" Description="" />
					<Var Name="UseRayCollision" Type="Bool" DefaultValue="false" Description="Use ray or shape collision." />
					<Var Name="AlignToGround" Type="Bool" DefaultValue="false" Description="" />
					<Var Name="CanRunOnWalls" Type="Bool" DefaultValue="false" Description="" />
					<Var Name="WanderMul" Type="Float" DefaultValue="1" Description="How stiff or loose the bend is." />
					<Var Name="WanderLength" Type="Float" DefaultValue="0.5" Description="" />
					<Var Name="WanderRadius" Type="Float" DefaultValue="1" Description="" />
					<Var Name="EscapeMul" Type="Float" DefaultValue="0.1" Description="How stiff or loose the bend is." />
					<Var Name="EscapeDistance" Type="Float" DefaultValue="4" Description="The distance the critter starts fleeing from the player." />
					<Var Name="NormalSpeed" Type="Float" DefaultValue="0.5" Description="Normal speed." />
					<Var Name="EscapeSpeed" Type="Float" DefaultValue="2" Description="Speed when escaping." />
					<Var Name="IdleTime" Type="Float" DefaultValue="5" Description="" />
					<Var Name="MoveTime" Type="Float" DefaultValue="8" Description="" />
					<Var Name="EscapeLength" Type="Float" DefaultValue="0.5" Description="" />
					<Var Name="EscapeRadius" Type="Float" DefaultValue="1" Description="" />
					<Var Name="MaxTurnSpeed" Type="Float" DefaultValue="2" Description="" />
					<Var Name="TurnSpeedMul" Type="Float" DefaultValue="3" Description="" />
				</Group>
				<Group Name="Flocking">
					<Var Name="FlockSeparation" Type="Float" DefaultValue="0.7"  Description="Flocking variable, how much they try to keep away from eachother" />
					<Var Name="FlockAlignment" Type="Float" DefaultValue="1"  Description="Flocking variable, how much they try to keep the same heading" />
					<Var Name="FlockCohesion" Type="Float" DefaultValue="1"  Description="Flocking variable, how much they try to be in the mass center of the group" />
					<Var Name="TowardsCenterMul" Type="Float" DefaultValue="1" Description="The higher the closer the fish will swim to the group entity." />
					<Var Name="MaxFlockMemberChecks" Type="Int" DefaultValue="4" Description="How many flock members are checked (-1 = all). Keep it low." />
				</Group>
				<Group Name="Player_Light_Reaction">
					<Var Name="ReactToPlayerLight" Type="Bool" DefaultValue="false" Description="Doubles the escape distance from the player when the later holds a lightsource." />
					<Var Name="LightEscapeDistMul" Type="Float" DefaultValue="2" Description="Escape distance multiplier to apply when the player holds a lightsource." />
				</Group>
				<Group Name="Backbone_Component">
					<var Name="Backbone_Bones" Type="String" DefaultValue="" Description="A list of bone names used for the backbone component separated by comma." />
					<Var Name="Backbone_AddTrailFreq" Type="Float" DefaultValue="10" Description="" />
					<Var Name="Backbone_Stiffness" Type="Float" DefaultValue="1" Description="" />
					<Var Name="Backbone_MaxTrailSize" Type="Int" DefaultValue="13" Description="" />
				</Group>
				<Group Name="Stuck">
					<Var Name="HandleStuck" Type="Bool" DefaultValue="false" Description="If true the critter will try to handle the situation." />
					<Var Name="DeactivateIfStuckTime" Type="Float" DefaultValue="-1" Description="How much time to wait before deactivating the critter from the time it got stuck. -1 = never." />
					<Var Name="DeactivateWhileInView" Type="Bool" DefaultValue="false" Description="If true and stuck the critter will be deactivated even if in player's view." />
					<Var Name="StopMovingIfStuck" Type="Bool" DefaultValue="true" Description="If true and stuck the critter will stop any attempts to move." />
				</Group>
			</TypeVars>
			<InstanceVars>
			</InstanceVars>
		</Class>
		
		<BaseClass Name="Agent">
			<EditorSetupVars>
				<Var Name="DiffuseColorMulVar" Value="ColorMul" />
				<Var Name="IllumColorMulVar" Value="IllumColor" />
				<Var Name="IllumBrightnessVar" Value="IllumBrightness" />
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Name="Health" Type="Float" DefaultValue="100" 		Description="The amount of damamge an entity can take." />
					<Var Name="Toughness" Type="Int" DefaultValue="0" 		Description="If strength of attack is 1 lower than damage is halfed. 2 or more lower damage is 0. If equal or higher, damage stays the same." />
					<Var Name="EventTag" Type="String" DefaultValue="" 		Description="A tag string used that is mainly used by the event system to group certain type of objects." />
					<Var Name="VoiceSourceBone" Type="String" DefaultValue="" 		Description="The place where a voice will be played in the Agent. If '' then center of character collider is used." />
				</Group>
				<Group Name="Appearance">
					<Var Name="CastShadows" Type="Bool" DefaultValue="true" 			Description="Should shadows be cast." />
					<Var Name="EffectsOnTime" Type="Float" DefaultValue="1" 		Description="Time it takes for on effect to be done. (used for lamps lit/unlit, but also other entity types)."/>
					<Var Name="EffectsOffTime" Type="Float" DefaultValue="1" 		Description="Time it takes for off effect to be done. (used for lamps lit/unlit, but also other entity types)."/>
					<Var Name="RootMotionBone" Type="String" DefaultValue="" Description="Bone to use when setting up root motion. The entity will follow the movement of this bone." />
					<Var Name="CutsceneEndAlignmentBone" Type="String" DefaultValue="" Description="The bone which the character body will be aligned with when a cutscene ends." />
        </Group>
				<Group Name="Body">
					<Var Name="CharBodySize" Type="Vec3" DefaultValue="1 1 1" 		Description="The size of the character body." />
					<Var Name="MeshPositionOffset" Type="Vec3" DefaultValue="0 0 0" 		Description="Positional offset of the mesh in regards to the char body" />
					<Var Name="MeshRotationOffset" Type="Vec3" DefaultValue="0 0 0" 		Description="Rotational offset of the mesh in regards to the char body" />
					<Var Name="MeshScaleOffset" Type="Vec3" DefaultValue="1 1 1" 		Description="Scale offset of the mesh" />
					<Var Name="CharBodyPosBone" Type="String" DefaultValue="Hip" Description="If in global animation mode, this will be used to move the body about." />
					<Var Name="CharBodyBoneIsFeet" Type="Bool" DefaultValue="false" Description="If CharBodyPosBone set as feet postion" />
					<Var Name="CharBodyBoneYOffset" Type="Float" DefaultValue="0" Description="Y-offset for the body when following CharBodyPosBone" />
					<Var Name="CharBodyMaterial" Type="String" DefaultValue="" Description="The physics material of the agent. Leave blank for default material." />
				</Group>
				<Group Name="Script">
					<Var Name="CustomScriptFile" Type="String" DefaultValue="" 	Description="The file of the custom script." />
					<Var Name="CustomScriptClass" Type="String" DefaultValue="" 	Description="The class name of the custom script. " />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Base">
					<Var Name="EventInstanceTag" Type="String" DefaultValue="" 		Description="A tag string used that is mainly used by the event system to group certain type of objects." />
					<Var Name="UserVar" Type="String" DefaultValue="" 		Description="Value of a variable. Accessed with  Entity_GetVar[Type](&quot;&quot;) (an empty string as argument). Can be of any type (determined when you choose to access)." />
					<Var Name="FullGameSave" Type="Bool" DefaultValue="false" 			Description="If the all things in the entity should be saved when exiting the level. Only use on few entities!" />
				</Group>	
				<Group Name="Internal State">
					<Var Name="EffectsActive" Type="Bool"  DefaultValue="true" 	Description="If entity should have its effects active." />
				</Group>
				<Group Name="Auto Disable">
					<Var Name="AutoDisableWhenOutOfSight" Type="Bool" DefaultValue="false" 		Description="If the agent should be disabled, SetActive(false), when out of view from the player." />
					<Var Name="AutoDisableWhenOutOfSightMinDist" Type="Float" DefaultValue="10" 		Description="The minimum distance for DisableWhenOutOfSight to happen." />
					<Var Name="AutoDisableCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity" DefaultValue="" 		Description="Called when the agent is auto disabled because of DisableWhenOutOfSight. Syntax: void f(const tString&in asEntityName)" />
				</Group>
				<Group Name="Appearance">		
					<Var Name="ColorMul" Type="Color" DefaultValue="1 1 1 1" 		Description="Color the diffuse texture of the prop is multiplied with." />
					<Var Name="UpdateWhenInvisible" Type="Bool" DefaultValue="false"	Description="If the character animations, lipsync and visual events should update when the character is invisible" />
					<Var Name="IllumColor" Type="Color" DefaultValue="1 1 1 1" 		Description="Color the illumination of the prop is multiplied with." />
					<Var Name="IllumBrightness" Type="Float" DefaultValue="1" Min="0" Max="10" Slider="true" UseLogScale="true"	Description="Value the illumination brightness of the prop is multiplied with." />
				</Group>
				<Group Name="Agent AI">
					<Var Name="SensesActive" Type="Bool" DefaultValue="true" 		Description="If hearing, sight, etc are active. This is usually implemented on a specfic basis." />
				</Group>
				<Group Name="Basic Callbacks">		
					<Var Name="ConnectionStateChangeCallback" Type="Function" ReturnType="void" Params="const tString &amp; in asEntityName, int alState" Suffix="_OnConnectionStateChange"	Description="A callback called when ever the connection state changes (button being switched on). Syntax: void Func(const tString & in EntityName, int alState). alState: -1=off, 0=between 1=on" />
					<Var Name="PlayerLookAtCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity, int alState" Suffix="_OnPlayerLookAt"		Description="Callback called when player looks on entity. Syntax: void Func(tString &in entity, int alState) state: 1=looking, -1=not looking" />
					<Var Name="PlayerLookAtCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should look at callback be removed when entity is looked at and callback called." />
					<Var Name="PlayerLookAtCheckCenterOfScreen" Type="Bool" DefaultValue="true" 	Description="If the entity counts as looked at only when at the center of the screen."/>
					<Var Name="PlayerLookAtCheckRayIntersection" Type="Bool" DefaultValue="true" 	Description="If the entity counts as looked at only if there is a clear line of sight to it. Note that this can return false negatives, especially when not checking center of screen."/>
					<Var Name="PlayerLookAtMaxDistance" Type="Float" DefaultValue="-1" 				Description="How far away the entity can be and still be counted as looked at. If less than 0, the maximum possible value will be used."/>
					<Var Name="PlayerLookAtCallbackDelay" Type="Float" DefaultValue="0" 			Description="How long after looking at or away from the entity the callback should trigger."/>
					<Var Name="PlayerInteractCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteract"	Description="Callback called when player interacts with entity. Syntax: void Func(tString &in entity)" />
					<Var Name="PlayerInteractCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should interact callback be removed when entity is interacted with and callback called." />
					<Var Name="PlayerInteractLeaveCallback" Type="Function"  ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteractLeave"	Description="Callback called when player stops interacting with entity. Syntax: void Func(tString &in entity)" />
					<Var Name="PlayerInteractLeaveCallbackAutoRemove" Type="Bool" DefaultValue="false" 	Description="Should interact leave callback be removed when entity is interacted with and callback called." />
					<Var Name="RecieveMessageCallback" Type="Function" ReturnType="void" Params="const tString&amp; in asEntityName, int alMessageId, cLuxEntityMessageData @apData"  Suffix="_OnRecieveMessage"	Description="Callback function called when the entity recives a message (of type eLuxEntityMessage or script defined) all the entities. Syntax: void Func(int alMessageId, cLuxEntityMessageData @apDatae). ." />
				</Group>
				<Group Name="Collide Callbacks">	
					<Var Name="CC_Entities" Type="String" DefaultValue="" 		Description="The entities that have a callback to this entity, sepperate each with space and/or comma. May use wildcards (*). Having 'player' as entity means that current entity will be attached on player." />
					<Var Name="CC_Funcs" Type="Function" ReturnType="bool" Params="const tString &amp;in asParent, const tString &amp;in asChild, int alState" 		Description="The callback fucntions for all the entities. Syntax: bool Func(const tString &in asParent, const tString &in asChild, int alState). If false is returned callback is removev. states: 1=enter, -1=leave If using several sepperate with comma and/or spaces. If only one function, all entity collision will use, else they are connected following the order. If there are more entities than functions, the last function will be used for the remaining entities." />
				</Group>	
				<Group Name="Connections">		
					<Var Name="ConnectedEntity" Type="String"  DefaultValue="" 		Description="The entity to make a connection to. May use wildcards (*). The connection created will be called 'Main'." />
					<Var Name="ConnectedEntityInvertState" Type="Bool"  DefaultValue="false" 		Description="If the state sent to the connected entity should be inverted." />
					<Var Name="ConnectedEntityStatesUsed" Type="Int"  DefaultValue="0" 		Description="What states that should be sent. 0=any value. 1=only 1, -1= only -1." />
				</Group>
			</InstanceVars>
		</BaseClass>
		
		<Class Name="Agent_Humanoid" InheritsFrom="Agent" UsesComponents="CharMover">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
			</InstanceVars>
		</Class>
		
		<Class Name="Agent_Humanoid_NPC" InheritsFrom="Agent" UsesComponents="CharMover, HeadTracker">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Humanoid Movement">
					<Var Name="Movement_ForwadSpeed" Type="float" DefaultValue="1"  	Description="The maximum speed forward." />
					<Var Name="Movement_BackwardSpeed" Type="float" DefaultValue="1"  	Description="The maximum speed bakward." />
					<Var Name="Movement_SidewaysSpeed" Type="float" DefaultValue="1"  	Description="The maximum speed sideways." />
					<Var Name="Movement_Acc" Type="float" DefaultValue="1"  	Description="The acceleration when moving toward top speed." />
					<Var Name="Movement_Deacc" Type="float" DefaultValue="1"  	Description="The deacceleration when stopping to a halt." />
				</Group>
				<Group Name="Humanoid General">
					<Var Name="HeadBone" Type="String" DefaultValue="Head" Description="Used to set the position of the head. For instance used to know where to look during dialog."/>
					<Var Name="UsePathfinding" Type="Bool" DefaultValue="true" Description="If the NPC should be using pathfinding."/>
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Humanoid General">
					<Var Name="VoiceName" Type="String" DefaultValue=""	Description="The character, from the voice file, that will be used for this entity." />
					<Var Name="StaticCollider" Type="Bool" DefaultValue="true"	Description="If the character body should not be affected by collisions (other object will still collide with it)." />
					<Var Name="CanBeTalkedTo" Type="Bool" DefaultValue="true"	Description="If the character is possible to talk to." />
					<Var Name="MainAnimation" Type="String" DefaultValue=""	Description="If not '' this animation will loop and no movement animations will be played." />
					<Var Name="MainAnimationGlobalSpace" Type="Bool" DefaultValue="false"	Description="If the main animation takes place in global space." />
				</Group>
				<Group Name="Appearance">
					<Var Name="UpdateWhenInvisible" Type="Bool" DefaultValue="false"	Description="If the character animations, lipsync and visual events should update when the character is invisible" />
				</Group>
				<Group Name="Headtracker">
					<Var Name="HeadTracker_TargetEntity" Type="String" DefaultValue=""	Description="The target of the head tracking. If '' then 'Player' will be used." />
					<Var Name="HeadTracker_Active" Type="Bool" DefaultValue="true"	Description="If headtracking is on or not." />
				</Group>
				<Group Name="Avoidance">
					<Var Name="WallAvoidActive" Type="Bool" DefaultValue="false"	Description="If the NPC should stay away from walls." />
					<Var Name="DynamicObjectAvoidActive" Type="Bool" DefaultValue="false"	Description="If the NPC should avoid dynamic objects" />
				</Group>
			</InstanceVars>
		</Class>
		
		<!-- CUSTOM STUFF -->

		<Class Name="Prop_SleepingGhoul" InheritsFrom="Prop" UsesComponents="Listener, FearThreat">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name ="Sleeping_Ghoul">
					<Var Name="WakeUpAnim" Type="String" DefaultValue="" Description="Name of animation to play when the connected agent wakes up."></Var>
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Sleeping_Ghoul">
					<Var Name="SleeperType" Type="Enum" DefaultValue="Screamer" Description="The kind of sleeping ghoul this is.">
						<EnumValue Name="Screamer"/>
						<EnumValue Name="Alert"/>
						<EnumValue Name="Old"/>
					</Var>
					<Var Name="AgentEntity" Type="String" DefaultValue="" Description="The name of the agent entity that will be activated if the sleeper type is 'Alert'."></Var>
					<Var Name="WakeUpCallback" Type="String" DefaultValue="" Description="Callback when the sleeping ghoul wakes up."></Var>
                    <Var Name="DisturbanceThreshold" Type="Int" DefaultValue="4" Description="Number of times the ghoul can be disturbed before waking up."></Var>
					<Var Name="PlayIdleSound" Type="Bool" DefaultValue="False" Description="If a twitching sound should be played at a random interval."></Var>
					<Var Name="RandDeafness" Type="Bool" Defaultvalue="False" Description="If there's a chance the ghoul won't hear an unimportant sound."></Var>
					<Var Name="RepetetiveIdle" Type="Bool" Defaultvalue="False" Description="If the ghoul should play a repetetive idle animation."></Var>
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Rift" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
			</TypeVars>
			<InstanceVars>
				<Group Name="Rift">
					<Var Name="OpenDist" Type="Float" DefaultValue="3" Description="Distance at which rift will open."></Var>
					<Var Name="StartOpenDist" Type="Float" DefaultValue="10" Description="Distance at which the rift will start to open."></Var>
					<Var Name="TrackingDistance" Type="Float" DefaultValue="40" Description="Distance at which the amulet will start tracking the rift."></Var>
					<Var Name="OpeningStages" Type="String" Defaultvalue="0.33, 0.66, 0.99" Description="Comma separated list of values that reperesent how open the rift is. The StageCallback function will be called when the value is surpassed."></Var>
					<Var Name="StageCallback" Type="Function" ReturnType="void" Params="const tString &amp;in asRift, int alStage, bool abOpening, float afOpenAmount" DefaultValue="" Description="Called when the the stages defined above are activated. Syntax: void Func(const tString &in asRift, int alStage, bool abOpening, float afOpenAmount)" />
					<Var Name="ActivateEntities" Type="String" DefaultValue="" Description="Entities that should be activated when the rift opens. Wildcards supported."></Var>
					<Var Name="DeactivateEntities" Type="String" DefaultValue="" Description="Entities that should be deactivated when the rift opens. Wildcards supported."></Var>
					<Var Name="ActivateDecals" Type="String" DefaultValue="" Description="Decals that should be activated when the rift opens. Wildcards supported."></Var>
					<Var Name="DeactivateDecals" Type="String" DefaultValue="" Description="Decals that should be deactivated when the rift opens. Wildcards supported."></Var>
					<Var Name="ActivateBillboards" Type="String" DefaultValue="" Description="Billboards that should be activated when the rift opens. Wildcards supported."></Var>
					<Var Name="ActivateRimBillboards" Type="String" DefaultValue="" Description="Billboards that should be faded in on the rim of the rift, then faded out completely after a while. Wildcards supported."></Var>
					<Var Name="ActivateRefractionBillboards" Type="String" DefaultValue="" Description="Billboards with a refraction effect that should be faded in/out when the rift opens/closes. Wildcards supported."></Var>
					<Var Name="ShakingLights" Type="String" DefaultValue="" Description="Lights which move around and increase in brightness as you get close. Wildcards supported."></Var>
					<Var Name="GuidingLights" Type="String" DefaultValue="" Description="Lights that increase in brightness as you get closer. Amulet increase the brightness even more. Wildcards supported."></Var>
					<Var Name="RimLights" Type="String" DefaultValue="" Description="Lights that fade in when the rift is open, on the rim of the rift. Wildcards supported."></Var>
					<Var Name="FloatingRocks" Type="String" DefaultValue="" Description="Rocks that float near the rift then fall down when the rift is opened. Wildcards supported."></Var>
					<Var Name="TransformEnt" Type="String" Defaultvalue="" Description="Names of the objects to be transformed to the corresponding TransformTarEnt. Wildcards supported."></Var>
					<Var Name="TransformTarEnt" Type="String" Defaultvalue="" Description="Names of the object the TransformEnt will be transformed to. Wildcards supported."></Var>
					<Var Name="Bounds" Type="String" DefaultValue="" Description="Name of an area that forms the bounds of the rift. If the player is within, the rift won't close."></Var>
					<Var Name="TrackingPoints" Type="String" DefaultValue="" Description="Additional tracking points for the rift. Useful if the rift is big and has more than one opening."></Var>
					<Var Name="VolumeMul" Type="Float" DefaultValue="1.0" Description="Can tweak the overall volume of the rift."></Var>
				</Group>
			</InstanceVars>
		</Class>

		<Class Name="Prop_PushAnimated" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Push">
					<Var Name="PushAtPoint" Type="Bool" DefaultValue="false" 	Description="If the push force should be applied to the point at the object where interaction took place." />
					<Var Name="ForceMul" Type="Float" DefaultValue="1" 		Description="Multplier for force applied. Used to fine tune interaction." />
					<Var Name="ThrowImpulse" Type="Float" DefaultValue="2" 		Description="Impulse made when thrown" />
					<Var Name="LookPushActive" Type="Bool" DefaultValue="true" Description="If pushing by looking around is active." />
					<Var Name="MaxPlayerSpeedMul" Type="Float" DefaultValue="1.0" Description="Multiplier for how fast the player should be able to move with the object." />
				</Group>
				<Group Name ="PushAnimation">
					<Var Name="AnimName" Type="String" DefaultValue="" Description="Name of the animation to be played while the object is moving."></Var>
					<Var Name="AnimSpeedMul" Type="Float" DefaultValue="1.0" Description="Multiplier for animation speed, so that it can be matched to the movement." />
					<Var Name="ForwardDir" Type="Vector3" DefaultValue="0 0 1" Description="Direction of forward movement, so that the animation can be played with positive speeds for forward and negative speeds for backward (wheels rolling in both directions)." />
					<Var Name="SoundName" Type="String" DefaultValue="" Description="Name of the sound loop to be played while the prop is being pushed."></Var>
				</Group>
			</TypeVars>
			<InstanceVars>
			</InstanceVars>
		</Class>

		<Class Name="Prop_Pickup" InheritsFrom="Prop" UsesComponents="Meat, Fullness">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Pickup">
					<Var Name="ItemType" Type="String" DefaultValue="" Description="Item type to put in inventory when this is picked up. Can be overridden in level editor."/>
					<Var Name="ContentSubType" Type="String" DefaultValue="" Description="Item subtype if this is a container."/>
					<Var Name="ContentLevel" Type="Int" DefaultValue="-1" Description="Item content amount if this is a container."/>
					<Var Name="ContentColor" Type="Color" DefaultValue="0 0 0 0" Description="Content effect color if this is oil."/>
					<Var Name="OnlyNeedOne" Type="Bool" DefaultValue="false" Description="If true, the user will only pick up the first one."/>
					<Var Name="PutAwayAfter" Type="Bool" DefaultValue="true" Description="If true, the user will put the item back into their pockets after the pickup animation plays."/>
					<Var Name="AnimationName" Type="String" DefaultValue="" Description="Name of hand animations to use with this pickup. If empty, the default animation will be used."/>
					<Var Name="PickupSound" Type="File"  ResType="Sound"  DefaultValue="" Description="Sound made when player picks the item." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Pickup">
					<Var Name="ItemType" Type="String" DefaultValue="" Description="Item type to put in inventory when this is picked up. Overrides value set in level editor."/>
					<Var Name="ContentSubType" Type="String" DefaultValue="" Description="Item subtype if this is a container."/>
					<Var Name="ContentLevel" Type="Int" DefaultValue="-1" Description="Item content amount if this is a container."/>
					<Var Name="Highlight" Type="Bool" DefaultValue="true" Description="If the prop should be highlighted with a blue shimmer when the player gets close."/>
				</Group>
			</InstanceVars>
		</Class>
		
