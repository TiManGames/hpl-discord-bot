					<Var Name="AttackerDamageCallback" Type="Function" ReturnType="void" Params="const tString&amp;in asEntityName" DefaultValue=""  	Description="Callback called after damage has been given. Syntax: void f(const tString&amp;in asEntityName)" />
					<Var Name="AttackerCustomCallback" Type="Function" ReturnType="void" Params="const tString&amp;in asEntityName" DefaultValue=""  	Description="When attack meter reaches max, this overrides any set behavior. Syntax: void f(const tString&amp;in asEntityName)" />
