		<Class Name="Prop_MoveObject" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="MoveObject_Base">
					<Var Name="MoveObjectType" Type="Enum" DefaultValue="Linear" Description="The type of movement. Can be linear or angular." >
						<EnumValue Name="Linear" />
						<EnumValue Name="Angular" />
					</Var>
					<Var Name="OpenAmount" Type="Float" DefaultValue="1" Description="How open the object should start out as. 1 being open and 0 being closed." />
					<Var Name="MoveAxis" Type="Enum" EnumType="Axis3D" DefaultValue="Y" Description="The axis to move along." />
					<Var Name="LocalAxis" Type="Bool" DefaultValue="false" Description="If the local axis should be used (always the case for angular movement)" />
				</Group>
				<Group Name="MoveObject_Speed">
					<Var Name="OpenAcc" Type="Float" DefaultValue="1" Description="The acceleration while opening." />
					<Var Name="OpenSpeed" Type="Float" DefaultValue="0.8" Description="The speed while opening." />
					<Var Name="CloseAcc" Type="Float" DefaultValue="9" Description="The acceleration while closing." />
					<Var Name="CloseSpeed" Type="Float" DefaultValue="5" Description="The speed while closing." />
				</Group>
				<Group Name="MoveObject_AutoMove">
					<Var Name="AutoMove" Type="Bool" DefaultValue="false" 			Description="" />
					<Var Name="AutoMoveStateGoal" Type="Float" DefaultValue="0" Description="The target state for the auto movement, in the range 0 - 1." />
					<Var Name="AutoMoveAcc" Type="Float" DefaultValue="9" Description="The acceleration of auto movement." />
					<Var Name="AutoMoveSpeed" Type="Float" DefaultValue="4" Description="The speed of auto movement." />
					<Var Name="AutoMoveSlowdownDist" Type="Float" DefaultValue="0.1" Description="The slow down distance of auto movement." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="MoveObject">
					<Var Name="AngularOffsetEntity" Type="String" DefaultValue="" Description="Entity to use as offset for angular movement." />
					<Var Name="CustomInteractIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="PushButton" Description="Icon shown when the prop has a interact callback." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_MultiSlider" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="MultiSlider_Base">
					<Var Name="NumOfStates" Type="Int" DefaultValue="2" Description="" />
					<Var Name="StickToStateMaxDist" Type="Float" DefaultValue="0.1" Description="" />
					<Var Name="CanInteractWithStaticBody" Type="Bool" DefaultValue="true" Description="" />
				</Group>
				<Group Name="MultiSlider_Speed">
					<Var Name="SlideMaxSpeed" Type="Float" DefaultValue="5" Description="" />
					<Var Name="SlideSlowDownFactor" Type="Float" DefaultValue="1" Description="" />
					<Var Name="SlideSpeedFactor" Type="Float" DefaultValue="1" Description="" />
					<Var Name="SlideThrowImpulse" Type="Float" DefaultValue="3" Description="" />
				</Group>
				<Group Name="MultiSlider_AutoMove">
					<Var Name="AutoMoveToCurrentState" Type="Bool" DefaultValue="true" Description="" />
					<Var Name="CheckNewStateType" Type="Enum" DefaultValue="OnEnterStateBoundary" Description="When the state should be updated." >
						<EnumValue Name="OnEnterStateBoundary" />
						<EnumValue Name="OnStopInteraction" />
					</Var>
					<Var Name="AutoMoveSpeedFactor" Type="Float" DefaultValue="2" Description="" />
					<Var Name="AutoMoveMaxSpeed" Type="Float" DefaultValue="8" Description="" />
				</Group>
				<Group Name="MultiSlider_Sounds">
					<Var Name="ChangeStateSound" Type="File"  ResType="Sound" DefaultValue="" Description="The sound to play when changing state." />
					<Var Name="StuckSound" Type="File"  ResType="Sound" DefaultValue="" Description="The sound to play when stuck." />
					<Var Name="MoveSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as prop is moved. If left empty the value specified in the joint is used." />
					<Var Name="MinMoveSoundSpeed" Type="Float" DefaultValue="-1" 		Description="Min speed the prop should move at before playing sound. If -1 the value specified in the joint is used." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="MultiSlider">
					<Var Name="StuckState" Type="Int" DefaultValue="-1" Description="" />
					<Var Name="InteractionDisablesStuck" Type="Bool" DefaultValue="false" Description="If player interaction should disable the stuck state." />
					<Var Name="ChangeStateCallback" Type="Function" ReturnType="void" Params="const tString &amp; in asName, int alState" Suffix="_OnChangeState" Description="Callback function when changing state." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_SlideDoor" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="SlideDoor_Base">
					<Var Name="OpenableByInteraction" Type="Bool" DefaultValue="true" Description="If door can be opened through interaction." />
					<Var Name="AgentColliderBody" Type="String" DefaultValue="" Description="A special body that will only be active when the door is closed and only collide with with agents. Not used if string is empty." />
					<Var Name="AgentDoor" Type="Bool" DefaultValue="true" Description="If the agents should treat it as a door." />
				</Group>
				<Group Name="SlideDoor_DoorParts">
					<Var Name="DoorParts_Body" Type="String" DefaultValue="" Description="Bodies that should move when the door is opened." />
					<Var Name="DoorParts_MoveDir" Type="String" DefaultValue="" Description="Directions these bodies should move (as x and y)." />
					<Var Name="DoorParts_MoveAmount" Type="String" DefaultValue="" Description="The distance these bodies should move." />
				</Group>
				<Group Name="SlideDoor_Speed">
					<Var Name="OpenSpeed" Type="Float" DefaultValue="1" Description="The speed to open the door." />
					<Var Name="CloseSpeed" Type="Float" DefaultValue="1" Description="The speed to close the door." />
					<Var Name="OpenAcc" Type="Float" DefaultValue="1" Description="The acceleration when opening the door." />
					<Var Name="CloseAcc" Type="Float" DefaultValue="1" Description="The acceleration when closing the door." />
					<Var Name="OpenSlowDownDist" Type="Float" DefaultValue="0.1" Description="How close the door should be to it's open position when slowing down." />
					<Var Name="CloseSlowDownDist" Type="Float" DefaultValue="0.1" Description="How close the door should be to it's closed position when slowing down." />
				</Group>
				<Group Name="SlideDoor_Collision">
					<Var Name="CheckCollision" Type="Bool" DefaultValue="true" Description="If the door should check for collisions." />
					<Var Name="PushImpulse" Type="Float" DefaultValue="0.08" Description="The impulse with which to push physics objects in the way of the door." />
					<Var Name="PushMaxMass" Type="Float" DefaultValue="40" Description="The max mass the door can push out of the way." />
				</Group>
				<Group Name="SlideDoor_Sounds">
					<Var Name="OpenSound_Start" Type="File"  ResType="Sound" DefaultValue="" Description="Sound played when opening starts." />
					<Var Name="OpenSound_End" Type="File"  ResType="Sound" DefaultValue="" Description="Sound played when opening ends." />
					<Var Name="CloseSound_Start" Type="File"  ResType="Sound" DefaultValue="" Description="Sound played when closing starts." />
					<Var Name="CloseSound_End" Type="File"  ResType="Sound" DefaultValue="" Description="Sound played when closing ends." />
					<Var Name="OpenSound_Loop" Type="File"  ResType="Sound" DefaultValue="" Description="Sound played while door is opening." />
					<Var Name="CloseSound_Loop" Type="File"  ResType="Sound" DefaultValue="" Description="Sound played while door is closing." />
				</Group>
				<Group Name="SlideDoor_Animation">
					<Var Name="UseAnimations" Type="Bool" DefaultValue="false" Description="If the door movement is made with animations" />
					<Var Name="Animation_Opening" Type="String" DefaultValue="" Description="Animation played when the door is opening" />
					<Var Name="Animation_Closing" Type="String" DefaultValue="" Description="Animation played when the door is open" />
					<Var Name="Animation_Open" Type="String" DefaultValue="" Description="Animation played when the door is opening" />
					<Var Name="Animation_Closed" Type="String" DefaultValue="" Description="Animation played when the door is closed" />
					<Var Name="Animation_ReplaceMovement" Type="Bool" DefaultValue="false" Description="If the animation is used for the door moving around. If trye all the physics movement is skipped." />
					<Var Name="Animation_CollisionOpenBody" Type="String" DefaultValue="" Description="The body used when collision is off. If '', none is used." />
					<Var Name="Animation_CollisionClosedBody" Type="String" DefaultValue="" Description="The body used when collision is on. If '', MainBody is used." />
					<Var Name="Animation_CollisionOpenTime" Type="Float" DefaultValue="0" Description="If Animation_ReplaceMovement is true, at which point in the opening animation is collision turned off?" />
					<Var Name="Animation_CollisionClosedTime" Type="Float" DefaultValue="0" Description="If Animation_ReplaceMovement is true, at which point in the closing animation is collision turned om?" />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="SlideDoor">
					<Var Name="OpenableByAgent" Type="Bool" DefaultValue="true" Description="If agents can open this door" />
					<Var Name="InteractToOpen" Type="Bool" DefaultValue="false" Description="If the door can be interacted with to open/close." />
					<Var Name="AutoCloseTime" Type="Float" DefaultValue="0" Description="The time the door remains open before it auto-closes." />
					<Var Name="OpenAmount" Type="Float" DefaultValue="0" Description="How open the door is at start." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Rigid" InheritsFrom="Prop" UsesComponents="FearScaryObject, FearThreat">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Rigid">
					<Var Name="InteractOnlyWithMainBody" Type="Bool" DefaultValue="false" Description="If the body set as MainPhysicsBody is the only one that can be interacted with." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Rigid">
					<Var Type="Bool" Name="CanInteractWithoutCallback"  DefaultValue="false" 	Description="Allows interaction with prop even if no callback is specified. Used to trigger events." />
					<Var Name="CustomInteractIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="PushButton" Description="Icon shown when the prop has a interact callback." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_Rotate" InheritsFrom="Prop" UsesComponents="FearScaryObject, FearThreat">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Rotate_Base">
					<Var Name="RotateSoundStart" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as the prop starts rotating." />
					<Var Name="RotateSound" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as the prop is rotated." />
					<Var Name="RotateSoundEnd" Type="File"  ResType="Sound"  DefaultValue="" 		Description="Sound played as the prop stops rotating." />
					<Var Name="RotateAxis" Type="Enum" EnumType="Axis3D" DefaultValue="Y" Description="The axis to rotate around." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Rotate">
					<Var Type="Bool" Name="CanInteractWithoutCallback"  DefaultValue="false" 	Description="Allows interaction with prop even if no callback is specified. Used to trigger events." />
					<Var Name="CustomInteractIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="PushButton" Description="Icon shown when the prop has a interact callback." />
				</Group>
			</InstanceVars>
		</Class>
		
		<Class Name="Prop_PowerExtender" InheritsFrom="Prop">
			<EditorSetupVars>
			</EditorSetupVars>
			<TypeVars>
				<Group Name="Grab">
					<Var Name="Grab_UseCustomOffset" Type="Bool" DefaultValue="false" Description="If special orientation is always used when object is grabbed." />
					<Var Name="Grab_CustomPositionOffset" Type="Vec3" DefaultValue="0 0 0" Description="custom oritention position offset." />
					<Var Name="Grab_CustomRotationOffset" Type="Vec3" DefaultValue="0 0 0" Description="custom oritention rotational offset." />
					<Var Name="Grab_UseCustomDepth" Type="Bool" DefaultValue="false" Description="If the grabbed object should always be a certain distance from the player." />
					<Var Name="Grab_CustomDepth" Type="Float" DefaultValue="1.2" Description="The custom depth value." />
					<Var Name="Grab_MassMul" Type="Float" DefaultValue="0.1" Description="The amount of mass used when picked up." />
					<Var Name="Grab_MinDepth" Type="Float" DefaultValue="0.8" Description="Min depth from player the object can be moved to." />
					<Var Name="Grab_MaxDepth" Type="Float" DefaultValue="2" Description="Max depth from player the object can be moved to." />
					<Var Name="Grab_ForceMul" Type="Float" DefaultValue="1"  Description="Force multiplier. Use if movements are erratic (lower it) or object is slow (increase)." />
					<Var Name="Grab_TorqueMul" Type="Float" DefaultValue="1" Description="Torque multiplier. Use if rotations are erratic (lower it) or object is slow (increase)." />
					<Var Name="Grab_ThrowImpulse" Type="Float" DefaultValue="5.0" Description="Impulse amount used when throwing the prop" />
					<Var Name="Grab_IsHeavy" Type="Bool" DefaultValue="false" Description="If the object is heavy (like a large crate) this sets up some special restrictions when interacting to make it feel more heavy." />
					<Var Name="Grab_CollisionWithPlayer" Type="Bool" DefaultValue="false" Description="If the object should still check collision with player even while interacting with it." />
					<Var Name="Grab_InteractOnlyWithMainBody" Type="Bool" DefaultValue="false" Description="If the body set as MainPhysicsBody is the only one that can be interacted with." />
					<Var Name="Grab_CanInteractWithNoMass" Type="Bool" DefaultValue="true" Description="If a body can be interacted with if its mass is set to 0" />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Grab">
					<Var Name="InteractDisablesStaticPhysics" Type="Bool" DefaultValue="false" Description="If static physics should be disabled when the prop is interacted with." />
				</Group>
				<Group Name="PowerExtender">
					<Var Name="Active" Type="Bool" DefaultValue="true" Description="If the entity should be managed by the power system." />
					<Var Name="Broken" Type="Bool" DefaultValue="false" Description="If the extender should start pulsating after being powered." />
					<Var Name="Flickering" Type="Bool" DefaultValue="false" Description="If the extender should flicker on and off." />
					<Var Name="Radius" Type="Float" DefaultValue="10" Description="The radius of power for the entity." />
					<Var Name="Callback" Type="Function" DefaultValue="" ReturnType="void" Params="bool abActive" Suffix="" Description="Callback for when the power entity gets activated and deactivated." />
					<Var Name="PulseCallback" Type="Function" DefaultValue="" ReturnType="void" Params="" Suffix="" Description="Callback for when a broken extender pulses." />
				</Group>
			</InstanceVars>
		</Class>

