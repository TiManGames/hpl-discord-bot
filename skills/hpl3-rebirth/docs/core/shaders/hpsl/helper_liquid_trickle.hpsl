//-----------------------------------------
///////////////////////////////
// Liquid trickle helper

float GetLiquidAmount(in cTexture2D aLiquidMap, in cVector2f avTexCoord, in cVector3f avLiquidFade)
{
	////////////
	// Get the mask value
	cVector4f vLiquid = sample(aLiquidMap, avTexCoord).wzyx;
	cVector2f vWeight = clamp((avLiquidFade.rg + vLiquid.rg) * cVector2f(3.2, -3.2) * avLiquidFade.z, 0, 1);

	/////////
	// Add together fade in and out
	return vWeight.x * (1.0 - vWeight.y) * min(vLiquid.r * 64.0f, 1.0f);
}

//------------------------------------------

cVector4f GetLiquidNormal(in cTexture2D aLiquidMap, in cVector2f avTexCoord, in cVector4f avLiquidFade, in float afInvTextureSize)
{
	//////////////
	// sample the mask in both horizontal and vertical offset stored in avLiquidFade.w
	cVector4f vLiquidHeightX = cVector4f(sample(aLiquidMap, avTexCoord + cVector2f( afInvTextureSize, 0)).wz,
							   sample(aLiquidMap, avTexCoord + cVector2f(-afInvTextureSize, 0)).wz);
	cVector4f vLiquidHeightY = cVector4f(sample(aLiquidMap, avTexCoord + cVector2f( 0, afInvTextureSize)).wz,
							   sample(aLiquidMap, avTexCoord + cVector2f( 0,-afInvTextureSize)).wz);

	///////////
	// Fade the horizontal and then vertical mask
	cVector4f vLiquidNormal;
	cVector4f vNormalFade = clamp((avLiquidFade.rgrg + vLiquidHeightX) * cVector4f(4, -4, 4, -4) * avLiquidFade.z, 0, 1);
	vLiquidNormal.rg = vNormalFade.rb * (1.0 - vNormalFade.ga);
	vNormalFade = clamp((avLiquidFade.rgrg + vLiquidHeightY) * cVector4f(4, -4, 4, -4) * avLiquidFade.z, 0, 1);
	vLiquidNormal.ba = vNormalFade.rb * (1.0 - vNormalFade.ga);

	///////////
	// Generate normal from the delta of the mask
	vLiquidNormal.xyz = normalize(cVector3f(vLiquidNormal.y - vLiquidNormal.x,
									   vLiquidNormal.z - vLiquidNormal.w,
									   0.05 * avLiquidFade.z));

	//////////////
	// Store the weight in .w
	vLiquidNormal.w = vLiquidNormal.z * avLiquidFade.w;

	return vLiquidNormal;
}

//------------------------------------------

float GetLiquidAmount(in cTexture2D aLiquidMap, in cVector2f avTexCoord, in cVector2f avTexCoordDx, in cVector2f avTexCoordDy, in cVector3f avLiquidFade)
{
	////////////
	// Get the mask value
	cVector4f vLiquid = sampleGrad(aLiquidMap, avTexCoord, avTexCoordDx, avTexCoordDy).wzyx;
	cVector2f vWeight = clamp((avLiquidFade.rg + vLiquid.rg) * cVector2f(3.2, -3.2) * avLiquidFade.z, 0, 1);

	/////////
	// Add together fade in and out
	return vWeight.x * (1.0 - vWeight.y) * min(vLiquid.r * 64.0f, 1.0f);
}

//------------------------------------------

cVector4f GetLiquidNormal(in cTexture2D aLiquidMap, in cVector2f avTexCoord, in cVector2f avTexCoordDx, in cVector2f avTexCoordDy, in cVector4f avLiquidFade, in float afInvTextureSize)
{
	//////////////
	// sample the mask in both horizontal and vertical offset stored in avLiquidFade.w
	cVector4f vLiquidHeightX = cVector4f(sampleGrad(aLiquidMap, avTexCoord + cVector2f( afInvTextureSize, 0), avTexCoordDx, avTexCoordDy).wz,
										 sampleGrad(aLiquidMap, avTexCoord + cVector2f(-afInvTextureSize, 0), avTexCoordDx, avTexCoordDy).wz);
	cVector4f vLiquidHeightY = cVector4f(sampleGrad(aLiquidMap, avTexCoord + cVector2f( 0, afInvTextureSize), avTexCoordDx, avTexCoordDy).wz,
										 sampleGrad(aLiquidMap, avTexCoord + cVector2f( 0,-afInvTextureSize), avTexCoordDx, avTexCoordDy).wz);

	///////////
	// Fade the horizontal and then vertical mask
	cVector4f vLiquidNormal;
	cVector4f vNormalFade = clamp((avLiquidFade.rgrg + vLiquidHeightX) * cVector4f(4, -4, 4, -4) * avLiquidFade.z, 0, 1);
	vLiquidNormal.rg = vNormalFade.rb * (1.0 - vNormalFade.ga);
	vNormalFade = clamp((avLiquidFade.rgrg + vLiquidHeightY) * cVector4f(4, -4, 4, -4) * avLiquidFade.z, 0, 1);
	vLiquidNormal.ba = vNormalFade.rb * (1.0 - vNormalFade.ga);

	///////////
	// Generate normal from the delta of the mask
	vLiquidNormal.xyz = normalize(cVector3f(vLiquidNormal.y - vLiquidNormal.x,
									   vLiquidNormal.z - vLiquidNormal.w,
									   0.05 * avLiquidFade.z));

	//////////////
	// Store the weight in .w
	vLiquidNormal.w = vLiquidNormal.z * avLiquidFade.w;

	return vLiquidNormal;
}

//-----------------------------------------

cVector3f BlendWithLiquid(in cVector3f avOriginalColor, in cVector3f avLiquidColor, float afLiquidAlpha, float afLiquidAmount)
{
	// Use LiquidBlendMode for solid and normal BlendMode for translucent
	@ifdef LiquidBlendMode_Alpha || BlendMode_Alpha || BlendMode_PremulAlpha
		return mix(avOriginalColor, avLiquidColor, afLiquidAmount * afLiquidAlpha);
	@elseif LiquidBlendMode_Mul || BlendMode_Mul
		return avOriginalColor * (avLiquidColor + (cVector3f(1.0, 1.0, 1.0) - avLiquidColor) * (1.0-afLiquidAlpha * afLiquidAmount));
	@elseif BlendMode_MulX2
		float fBlendAlpha = afLiquidAmount * afLiquidAlpha;
		return 2.0 * avOriginalColor * (avLiquidColor * fBlendAlpha + cVector3f(0.5, 0.5, 0.5)*(1-min(fBlendAlpha, 1.0)));
	@elseif BlendMode_Add
		return avOriginalColor + avLiquidColor * afLiquidAmount * afLiquidAlpha;
	@else
		return avOriginalColor;
	@endif
}

