////////////////////////////////////////////////////////
// Deferred Terrain Z - Fragment Shader
//
////////////////////////////////////////////////////////

@include helper_type_arguments.hpsl

@ifdef TerrainHoles || TerrainShadowCull
	uniform cTexture2D aTerrainCullMap : 11;
@endif

void main(in cVector4f px_vPosition,
		  in cVector4f px_vWorldPos,
		  out cVector4f out_vColor : 0)
{
	@ifdef TerrainShadowCull
		///////////////
		// Check if this pixels should cast shadow
		cVector2f vUV = px_vWorldPos.xz * avHoleOffsetScale.z + avHoleOffsetScale.xy;
		float fShadow = sample(aTerrainCullMap, vUV)[alHoleChannel];

		if(fShadow < 0.5) discard;
	@endif

	@ifdef TerrainHoles
		///////////////
		// Check if this pixel is at a hole in the terrain
		cVector2f vHoleUV = px_vWorldPos.xz * avHoleOffsetScale.z + avHoleOffsetScale.xy;
		float fHole = sample(aTerrainCullMap, vHoleUV)[alHoleChannel];

		if(fHole > 0.5) discard;
	@endif

	out_vColor = px_vWorldPos;
}

