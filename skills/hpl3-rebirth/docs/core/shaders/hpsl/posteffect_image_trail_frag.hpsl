////////////////////////////////////////////////////////
// PostEffect Image Trail - Fragment Shader
//
// Just set up the texture for a dest blend
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;
uniform cTexture2D prevDiffuseMap : 1;

uniform float afAlpha;

///////////////
// When using dynamic resolution the size can change, this keeps the UV aligned correctly
uniform cVector2f avSizeChange;
uniform cVector2f avOffsetChange; 

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	cVector4f vDiffuseColor = sample(diffuseMap, px_vTexCoord0.xy);
	cVector4f vPrevDiffuseColor = sample(prevDiffuseMap, px_vTexCoord0.xy * avSizeChange + cVector2f(0.0, 1.0 - avSizeChange.y));
	
	out_vColor = cVector4f(mix(vPrevDiffuseColor.rgb, vDiffuseColor.rgb, afAlpha), 1.0);
}