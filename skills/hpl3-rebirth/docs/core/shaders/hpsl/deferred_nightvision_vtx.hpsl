////////////////////////////////////////////////////////
// Deferred NightLight- Vertex Shader
//
//
////////////////////////////////////////////////////////

//---------------------------------------------

//////////////////
// Arguments

cBuffer cNightvisionArguments : 0
{
	float afFarPlane;
	float afNearPlane;
	float afNearByFarPlane;
	float afInvFarPlane;
	
	cVector4f avLightColor;
	cVector4f avScreenToFarPlane;
	cVector2f avInvScreenSize;

	float afFalloffPow;
	float afMinDistance;
	float afMaxDistance;
	float afBuffer[3];
};

//---------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f vtx_vPosition,
	  out cVector4f px_vPosition)
{	
	///////////
	// Quad full screen
	px_vPosition = vtx_vPosition * cVector4f(2.0,-2.0, 0.0, 0.0) + cVector4f(-1.0, 1.0, 0.0, 1.0);
}
