////////////////////////////////////////////////////////
// Deferred G-Buffer Solid - Fragment Shader
//
//
////////////////////////////////////////////////////////

@ifdef UseParallax
	@include helper_parallax.hpsl
@endif

////////////////////
// Input

@ifdef UseTextureBuffer
	
	// This contains all constant buffers and chooses the correct one based on MaterialType
	@include helper_type_arguments.hpsl

@else
	////////////////////
	// Arguments
	uniform cVector4f avIlluminationMul;
	uniform cVector2f avHeightMapScaleAndBias;
@endif

////////////////////
// Material Textures
uniform cTexture2D aIllumMap : 0;

@ifdef UseAlpha
	uniform cTexture2D aAlphaMap : 1;
@endif

uniform cTexture2D aHeightMap : 2;

//------------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
@ifdef UseColor
		  in cVector4f px_vColor,
@endif 
@ifdef UseParallax
		  in cVector3f px_vTangentEyePos,
@endif
		  out cVector4f out_vColor : 0)
{
	//////////////////////////////////
	// Get UV coords
	@ifdef UseParallax
		cVector2f vTexCoord = GetParallaxUV(aHeightMap,3, px_vTexCoord0.xy, px_vTangentEyePos, avHeightMapScaleAndBias);
	@else
		cVector2f vTexCoord = px_vTexCoord0.xy;
	@endif

	cVector2f vUVDx = dFdx(px_vTexCoord0.xy);
	cVector2f vUVDy = dFdy(px_vTexCoord0.xy);

	//////////////////////////////////
	// Alpha
	@ifdef UseAlpha
		float fAlpha = sampleGrad(aAlphaMap, vTexCoord, vUVDx, vUVDy).w;
		if(fAlpha < 0.5) discard;
	@endif

	//////////////////////////////////
	//Illumination 
	cVector4f vIllumination = cVector4f(sampleGrad(aIllumMap, vTexCoord, vUVDx, vUVDy).xyz, 1);

	@ifdef UseColor
		vIllumination.rgb *= px_vColor.rgb * px_vColor.a;
	@endif

	@ifdef UseTextureBuffer
		vIllumination.rgb *= afIlluminationMul;
	@endif
	
	out_vColor = vIllumination * cVector4f(8.0, 8.0, 8.0, 1.0);
}		