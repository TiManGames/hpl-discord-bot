////////////////////////////////////////////////////////
// Terrain  - Fragment Shader
//
//
////////////////////////////////////////////////////////

@include helper_normal_packing.hpsl

////////////////////
// Material Textures
uniform cTexture2D aNormalMap : 0;
uniform cTexture2D aAlphaMap : 1;

//------------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  in cVector4f px_vColor,
		  out cVector4f out_vColor0 : 0)
{
	//////////////////////////////////
	// Get the texture values
	cVector3f vNormal = UnpackNormalmapYW(sample(aNormalMap, px_vTexCoord0.xy));
	float fAlpha = sample(aAlphaMap, px_vTexCoord0.xy).w;
	
	//////////////////////////////////
	// Rotate the normal around z
	cVector2f vCosSin = px_vColor.xy*2 -1;//unpack
	vNormal = normalize(vNormal);
	vNormal.xy = cVector2f(  vCosSin.x * vNormal.x - vCosSin.y * vNormal.y,
							 vCosSin.y * vNormal.x + vCosSin.x * vNormal.y
						);
	
	//////////////////////////////////
	// Set final color
	out_vColor0.xyz = vNormal*0.5+0.5;
	out_vColor0.w = px_vColor.w * fAlpha;
}		