////////////////////////////////////////////////////////
// PostEffect Video Distortion - Fragment Shader
//
// Adds bad video like noise.
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;

uniform cVector2f avScreenSize;
uniform float afAmount;
uniform float afSeed;
uniform float afLineDensity;
uniform float afOffsetMul;
uniform cVector2f avScreenOffset;
uniform cVector2f avScreenBendAmount;

/*float Hash1D( float p )
{
	return fract(sin(127.1*p)*43758.5453123);
}*/

float noise(cVector3f p) //Thx to Las^Mercury
{
	cVector3f i = floor(p);
	cVector4f a = dot(i, cVector3f(1., 57., 21.)) + cVector4f(0., 57., 21., 78.);
	cVector3f f = cos((p-i)*acos(-1.))*(-.5)+.5;
	a = mix(sin(cos(a)*a),sin(cos(1.+a)*(1.+a)), f.x);
	a.xy = mix(a.xz, a.yw, f.y);
	return mix(a.x, a.y, f.z);
}

float sphere(cVector3f p, cVector4f spr)
{
	return length(spr.xyz-p) - spr.w;
}

/*float sampleMusicA() { // https://www.shadertoy.com/view/llB3W1
	return 0.5 * (
		texture2D( iChannel0, cVector2f( 0.15, 0.05 ) ).x + 
		texture2D( iChannel0, cVector2f( 0.30, 0.05 ) ).x)*afAmount;
}*/


float flame(cVector3f p)
{
	float d = sphere(p*cVector3f(.2,.5,1.), cVector4f(0.,-1.,.0,1.));
	return d + (noise(p+cVector3f(.0,(afAmount)*2.,.0)) + noise(p*3.)*.5) ; // noise(p+cVector3f(.0,afAmount*2.,.0))
}

float scene(cVector3f p)
{
	return min(100.-length(p) , abs(flame(p)) );
}

cVector4f raymarch(cVector3f org, cVector3f dir)
{
	float d = 0.0, glow = 0.0, eps = 0.02;
	cVector3f  p = org;
	bool glowed = false;
	
	for(int i=0; i<100; i++)
	{
		d = scene(p) + eps;
		p += d * dir;
		if( d>eps )
		{
			if(flame(p) < 20.)
				glowed=true;
			if(glowed)
       			glow = float(i)/64.;
		}
	}
	return cVector4f(p,glow);
}

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	cVector2f v = -1.0 + 2.0 * px_vPosition.xy / avScreenSize.xy;
	v.x *= avScreenSize.x/avScreenSize.y;
	
	cVector3f org = cVector3f(0., -2., 4.);
	cVector3f dir = normalize(cVector3f(v.x*1.6, -v.y, -1.5));
	
	cVector4f p = raymarch(org, dir);
	float glow = p.w;
	
	cVector4f col = mix(cVector4f(.1,1.5,0.,0.), mix(cVector4f(0.1,.1,1.,1.0),cVector4f(1.,.5,0.,1.0),p.w), p.y*.02+.4);
	
	cVector2f vScreenCoords = px_vTexCoord0.xy;
	vScreenCoords += avScreenOffset;
	cVector4f vColor = sample(diffuseMap, vScreenCoords);
	
	out_vColor = mix(vColor, mix(cVector4f(0.), col, pow(glow*2.,4.)), 0.5*afAmount);
	
	/*///////////////////////////////////
	// Set up coordinates
