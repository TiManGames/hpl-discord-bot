
//--------------------------------------------

uniform cTexture2D colorMap : 0;
uniform cTexture2D diffuseMap : 1;

//--------------------------------------------

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vDiffuse : 0,
		  out cVector4f out_vSpecular : 1)
{	
	///////////////
	// Get the skin amount
	cVector4f vDiffuse = sample(diffuseMap, px_vTexCoord0.xy);
	float fSkinAmount = vDiffuse.w;
	
	if (fSkinAmount > 0.5 && vDiffuse != cVector4f(1.0))	
	{
		fSkinAmount = (fSkinAmount - 0.5) * 2.0;
	}
	else
	{
		fSkinAmount = 0;
		discard; //no need to run this if it has no skin
	}

	///////////////
	// Separate the color into diffuse and spec, this is not perfect
	cVector4f vColor = sample(colorMap, px_vTexCoord0.xy);
	float fTotal = length(vColor.xyz);
	vColor.xyz /= max(1e-5f, fTotal);
	
	///////////////
	// Remove the specular (first step)
	cVector3f vDiffuseLight = vColor.xyz * (fTotal - vColor.a);
	cVector3f vSpecularLight = cVector3f(0, 0, 0);

	///////////////
	// Extract the color of lighting data by removing the diffuse mul
	cVector3f vLightColor = vDiffuseLight / (1.0 / 255.0 + vDiffuse.xyz);
	vLightColor /= max(1e-5f, length(vLightColor));

	///////////////
	// Get specular color and then the "real" diffuse color by removing specular
	vSpecularLight = vLightColor * vColor.a * 0.9;
	vDiffuseLight = max(cVector3f(1e-5f, 1e-5f, 1e-5f), vColor.xyz * fTotal - vSpecularLight);
	vSpecularLight = vColor.xyz * fTotal - vDiffuseLight; //recalculate specular if diffuse ends up negative

	out_vDiffuse = cVector4f(vDiffuseLight, fSkinAmount);
	out_vSpecular = cVector4f(vSpecularLight, 0.0);
}