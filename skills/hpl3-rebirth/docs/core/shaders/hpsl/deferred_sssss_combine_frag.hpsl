
//--------------------------------------------

uniform cTexture2D diffuseMap : 0;
uniform cTexture2D specularMap : 1;

//--------------------------------------------

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{	
	out_vColor = max(cVector4f(1e-6f, 1e-6f, 1e-6f, 1e-6f), sample(diffuseMap, px_vTexCoord0.xy) + sample(specularMap, px_vTexCoord0.xy));
	out_vColor.a = 1.0;
}