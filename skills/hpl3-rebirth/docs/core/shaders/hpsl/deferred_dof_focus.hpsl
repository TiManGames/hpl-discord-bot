////////////////////
// samplers
uniform cTexture2D colorMap : 0;
uniform cTexture2D depthMap : 1;

uniform cVector4f avFocusStartEnd;
uniform cVector4f avScreenToFarPlane;
uniform float afFarPlane;

uniform cVector2f avPoissonCoords[8];

////////////////////
// MAIN
void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	cVector2f vUV = px_vTexCoord0.xy;

	//////////////
	// sample depth and color
	cVector4f vColor = sample(colorMap, vUV);

	float fCoreDepth = sample(depthMap, vUV).x;
	float fDepth = fCoreDepth * afFarPlane;

	//////////////
	// Calculate how blurred this sample should be
	float fNear = max((avFocusStartEnd.y - fDepth) / (avFocusStartEnd.y - avFocusStartEnd.x), 0.0);
	float fFar  = max((fDepth - avFocusStartEnd.z)  / (avFocusStartEnd.w - avFocusStartEnd.z), 0.0);

	float fWeight = fFar - fNear;

	///////////
	// Apply weight
	@ifdef UseBokeh
		vColor.a = 1.0f;
		vColor *= max(0, (1.0 - abs(fWeight) / 2.2));
	@else
		vColor.a = clamp(fWeight, -1.0, 1.0);
	@endif 
	

	////////////
	// Normalize the color and alpha
	out_vColor = vColor;
}