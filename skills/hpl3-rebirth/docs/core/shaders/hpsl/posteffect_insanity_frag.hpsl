////////////////////////////////////////////////////////
// PostEffect Lens Distortion - Fragment Shader
//
// Applies some lens distortion to the image
////////////////////////////////////////////////////////

uniform cTexture2D tex : 0;
uniform cTexture2D amp0 : 1;
uniform cTexture2D amp1 : 2;
uniform cTexture2D zoom : 3;

uniform float afAlpha;
uniform float afT;
uniform cVector2f avScreenSize;
uniform float afAmpT;
uniform float afWaveAlpha;
uniform float afZoomAlpha;

void main(in cVector4f px_vPosition,
          in cVector4f px_vTexCoord0,
          out cVector4f out_vColor : 0)
{
    cVector2f vTexUV = px_vTexCoord0.xy / avScreenSize;
    cVector3f vAmp = sample(amp0, vTexUV).xyz * (1.0 - afAmpT) + sample(amp1, vTexUV).xyz * afAmpT;
    vAmp *= afWaveAlpha * 0.04 * avScreenSize.y;

    cVector3f vZoom = sample(zoom, vTexUV).xyz;

    cVector2f vUV = px_vPosition.xy;

    vUV += (vZoom.xy - cVector2f(0.5, 0.5)) * 2.0 * 0.6 * vZoom.z * avScreenSize.y * afZoomAlpha;

    cVector2f vSinUv = (vUV / avScreenSize.y) * 0.6;
    vUV.x += sin(afT + vSinUv.y) * vAmp.x;
    vUV.y += sin(afT + vSinUv.x * 1.83) * vAmp.y;

    cVector3f vDiffuseColor = sample(tex, vUV / avScreenSize).xyz;

    out_vColor.xyz = vDiffuseColor;
}