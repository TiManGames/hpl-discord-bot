// INPUT

void main(in cVector4f px_vPosition,
		  out cVector4f out_vColor : 0)
{
	out_vColor = cVector4f(1.0f / 128.0f, 1.0f / 128.0f, 1.0f / 128.0f, 1.0f / 128.0f);
}