////////////////////////////////////////////////////////
// Deferred Base - Vertex Shader
//
//
////////////////////////////////////////////////////////

@include helper_type_arguments.hpsl

uniform cTexture2D aHeightMap : 0;
uniform cTextureBuffer aInstanceBuffer : 15;
	
//---------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f vtx_vPosition,
		  in cVector4f vtx_vTexCoord0,
		  in cVector3f vtx_vNormal,
@ifdef TesselationShader
		out cTessData  {
@ifdef UseUv || TesselationShader
			cVector2f vHeightCoord;
@endif
@ifdef TerrainDebug	
			cVector4f vColor;
@endif
			cVector4f vWorldPos;
		} cs,
@else
	@ifdef UseUv
			  out cVector2f px_vHeightCoord,
	@endif
	@ifdef UseLinearDepth
			  out float px_fLinearDepth,
	@endif
			  out cVector4f px_vWorldPos,
	@ifdef TerrainDebug	
			  out cVector4f px_vColor,
	@endif
@endif
		  out cVector4f px_vPosition)
{	
	@ifdef TesselationShader
		// Define the pixel output adn then copy to the struct at the end
		cVector2f px_vHeightCoord;
		cVector4f px_vWorldPos;
		float px_fLinearDepth;
		cVector4f px_vColor;
	@endif

	//////////////////////
	// Height map coord
	int lBaseOffset = int(alInstanceOffset + vtx_lInstanceID * alInstanceStride);
	cVector4f vHeightMapOffsetAndScale = load(aInstanceBuffer, lBaseOffset);
	cVector2f vHeightMapCoord = vtx_vTexCoord0.xy*vHeightMapOffsetAndScale.zw + vHeightMapOffsetAndScale.xy;

	/////////////////////
	// Position
	cVector4f vPatchPositionScale = load(aInstanceBuffer, lBaseOffset+1);
	cVector4f vVtxPos =  cVector4f(vtx_vPosition.xyz * vPatchPositionScale.w + vPatchPositionScale.xyz, 1.0);
	
	lBaseOffset += 2;
	
	float fHeight = sampleLod(aHeightMap,vHeightMapCoord, 0).x;
	vVtxPos.y += fHeight * avHeightMapProperties.x;	
	
	px_vPosition = mul(a_mtxViewProjection, vVtxPos);

	px_vWorldPos = vVtxPos;
	
	/////////////////////
	// Debug
	@ifdef TerrainDebug	
		px_vColor = avDebugColor;
	@endif
	
	//////////////////////
	// Normals
	@ifdef UseUv || TesselationShader
		/////////
		// Send height coords to pixel shader for per pixel normal
		px_vHeightCoord = vHeightMapCoord;
	@endif
	
	//////////////////////
	// Linear depth
	@ifdef UseLinearDepth
		px_fLinearDepth = -mul(a_mtxView, vVtxPos).z * afInvFarPlane; //Do not use near plane! Doing like this will make the calcs simpler in the light shader.
	@endif

	@ifdef TesselationShader
		// Copy output to struct
@ifdef UseUv || TesselationShader
		cs.vHeightCoord = px_vHeightCoord;
@endif
@ifdef TerrainDebug	
		cs.vColor = px_vColor;
@endif
		cs.vWorldPos = px_vWorldPos;
	@endif
}