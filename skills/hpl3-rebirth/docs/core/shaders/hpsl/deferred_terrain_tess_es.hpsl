////////////////////////////////////////////////////////
// Deferred Base - Control Shader
//
//
////////////////////////////////////////////////////////
	
//---------------------------------------------

@include helper_type_arguments.hpsl

uniform cTexture2D aHeightMap : 0;
uniform cTexture2DArray aDiffuseMap : 1;
uniform cTexture2DArray aNormalMap : 2;
uniform cTexture2DArray aSpecularMap : 3;
uniform cTexture2DArray aDetailMap : 4; 
uniform cTexture2DArray aBumpMap : 5;

@include helper_terrain.hpsl

float Interpolate(float a0, float a1, float a2, in cVector3f avUVW) { return a0 * avUVW.x + a1 * avUVW.y + a2 * avUVW.z; }
cVector2f Interpolate(cVector2f a0, cVector2f a1, cVector2f a2, in cVector3f avUVW) { return a0 * avUVW.x + a1 * avUVW.y + a2 * avUVW.z; }
cVector3f Interpolate(cVector3f a0, cVector3f a1, cVector3f a2, in cVector3f avUVW) { return a0 * avUVW.x + a1 * avUVW.y + a2 * avUVW.z; }
cVector4f Interpolate(cVector4f a0, cVector4f a1, cVector4f a2, in cVector3f avUVW) { return a0 * avUVW.x + a1 * avUVW.y + a2 * avUVW.z; }

/////////////////////////////// 
// Main program
[domain = triangle]
[spacing = integer]
[ordering = ccw]
void main(	
		in cTessData  {
@ifdef UseUv || TesselationShader
			cVector2f vHeightCoord;
@endif
@ifdef TerrainDebug	
			cVector4f vColor;
@endif
			cVector4f vWorldPos;
		} es[],
@ifdef UseUv
		  out cVector2f px_vHeightCoord,
@endif
@ifdef UseLinearDepth
		  out float px_fLinearDepth,
@endif
		  out cVector4f px_vWorldPos,
@ifdef TerrainDebug	
		  out cVector4f px_vColor,
@endif
		  out cVector4f px_vPosition)
{	
	//////////////
	// Transfer data
	@ifdef UseUv
		px_vHeightCoord = Interpolate(es[0].vHeightCoord, es[1].vHeightCoord, es[2].vHeightCoord, es_vTesslationCoords);
	@elseif TesselationShader
		cVector2f px_vHeightCoord = Interpolate(es[0].vHeightCoord, es[1].vHeightCoord, es[2].vHeightCoord, es_vTesslationCoords);
	@endif
	@ifdef TerrainDebug	
		px_vColor = Interpolate(es[0].vColor, es[1].vColor, es[2].vColor, es_vTesslationCoords);
	@endif
	
	px_vPosition = Interpolate(es[0].vWorldPos, es[1].vWorldPos, es[2].vWorldPos, es_vTesslationCoords);
	
	///////////
	// Get distance fade
	float fCameraDist = distance(px_vPosition.xyz, avCamera.xyz);
	float fCameraDistFade = clamp((1.0 - pow(fCameraDist / avTesselationRange.x, 4.0)) * 3.0, 0.0, 1.0);
	fCameraDistFade = fCameraDistFade * fCameraDistFade * (3.0 - 2.0 * fCameraDistFade);

	if(fCameraDistFade > 0.0f)
	{
		////////////
		// Get bump amount
		float fBump = GetTerrainBump(px_vPosition.xyz, avCamera.xyz) * fCameraDistFade;

		float fBumpLimit = (0.5f / 255.0f) * afTesselationScale;
	
		if(fBump * fBump > (fBumpLimit * fBumpLimit))
		{
			//////////////
			// Get direction to apply bump
			cVector3f vTangent, vBinormal, vWorldNormal;
			GetTangentSpace(px_vHeightCoord, 0.5, vWorldNormal, vTangent, vBinormal);

			px_vPosition.xyz += vWorldNormal * fBump;
		}
	}
	
	//////////////////////
	// Linear depth
	@ifdef UseLinearDepth
		px_fLinearDepth = -mul(a_mtxView, cVector4f(px_vPosition.xyz, 1.0)).z * afInvFarPlane; //Do not use near plane! Doing like this will make the calcs simpler in the light shader.
	@endif

	px_vWorldPos = px_vPosition;
	 
	/////////////
	// Apply projection matrix
	px_vPosition = mul(a_mtxViewProjection, cVector4f(px_vPosition.xyz, 1.0));

}