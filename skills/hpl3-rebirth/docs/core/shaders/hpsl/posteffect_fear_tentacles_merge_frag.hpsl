////////////////////////////////////////////////////////
// PostEffect Fear Tentacles
// Multiplies source with dest
////////////////////////////////////////////////////////

uniform cTexture2D scene : 0;
uniform cTexture2D tentacles : 1;

uniform float afIntensity;
uniform float afAlpha;
uniform cVector2f avTentacleUvMul;

uniform float afAspect;
uniform float afCircleRadius;
uniform float afCircleAlpha;
uniform float afCircleSoftness;

void main(in cVector4f px_vPosition,
          in cVector4f px_vTexCoord0,
          out cVector4f out_vColor : 0)
{
	////////////////////////////////////////////////////////
	// Color for the tiny vignette near the edges
	const cVector3f vVignetteColor = cVector3f(1, 0.108, 0.108);

    cVector2f vUV = px_vTexCoord0.xy * avTentacleUvMul + cVector2f(0.0, 1.0 - avTentacleUvMul.y);
    cVector4f vTentacles = sampleLod(tentacles, vUV, 0);
    cVector4f vScene = sample(scene, (vUV - cVector2f(0.0, 1.0 - avTentacleUvMul.y)) / avTentacleUvMul);

    ///////////////
    // Calculate vingette
    cVector2f vFalloff = vUV * (1.0 - vUV);
    float fVingette = min(1.0, vFalloff.x * vFalloff.y * 24);
    fVingette = ((1.0 - pow(fVingette, 0.0625)) - (1.0 - afIntensity) * 0.25) * afIntensity;
    fVingette = clamp(fVingette, 0.0, 1.0);

    fVingette *= 0.5;
    fVingette *= afAlpha;

    ///////////////
    // Circular vingette
    cVector2f vPos = vUV - 0.5;
    float fDist = length(vPos * cVector2f(afAspect, 1.0));
    float fCircleVignette = smoothstep(afCircleRadius, afCircleRadius - max(afCircleSoftness, 0.00001), fDist);

    ///////////
    // Mul together
    out_vColor = cVector4f((vScene.xyz + (vVignetteColor * fVingette)) * vTentacles.xyz, vScene.a * afAlpha);
    out_vColor = mix(out_vColor, out_vColor * clamp(fCircleVignette, 0.0, 1.0), afCircleAlpha);
}