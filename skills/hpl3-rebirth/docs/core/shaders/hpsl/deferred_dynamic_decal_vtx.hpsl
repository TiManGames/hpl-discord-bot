////////////////////////////////////////////////////////
// Deferred Base - Vertex Shader
//
//
////////////////////////////////////////////////////////

//---------------------------------------------

cBuffer cDynDecalTypeArguments : 0
{
	cMatrixf a_mtxViewProjection;
	cMatrixf a_mtxProjection;
	cMatrixf a_mtxView;
	cMatrixf a_mtxInvViewProjection;
	cMatrixf a_mtxInvProjection;
	cMatrixf a_mtxInvView;
		
	float afFarPlane;
	float afNearPlane;
	float afNearByFarPlane;
	float afInvFarPlane;
	
	cVector4f avScreenToFarPlane;
	cVector2f avInvScreenSize;
	float afT;
};

cBuffer cDynDecalArguments : 1
{
	cVector4f avClearColor;
	int alBlendMode;
	int alMaterialMask;
	int alInstanceOffset;
	int alInstanceStride;
};


///////////////////////
// Instancing
uniform cTextureBuffer aInstanceBuffer : 15;

//---------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f vtx_vPosition,
		  out cMatrixf px_mtxUV,
		  out cVector3f px_vTangent,
		  out cVector3f px_vBinormal,
		  out cVector4f px_vUvMinMax,
		  out cVector4f px_vColor,
		  out cVector4f px_vPosition)
{	
	/////////////
	// load instance data
	int lBaseOffset = int(alInstanceOffset + vtx_lInstanceID * alInstanceStride);

	cMatrixf mtxModel = cMatrixf(	load(aInstanceBuffer, lBaseOffset + 0),
									load(aInstanceBuffer, lBaseOffset + 1),
									load(aInstanceBuffer, lBaseOffset + 2),
									load(aInstanceBuffer, lBaseOffset + 3));

	cMatrixf mtxUV = cMatrixf(	load(aInstanceBuffer, lBaseOffset + 4),
								load(aInstanceBuffer, lBaseOffset + 5),
								load(aInstanceBuffer, lBaseOffset + 6),
								load(aInstanceBuffer, lBaseOffset + 7));

	px_vColor = load(aInstanceBuffer, lBaseOffset + 8);
	px_vUvMinMax = load(aInstanceBuffer, lBaseOffset + 9);

	////////////
	// Setup uv matrix
	px_mtxUV = mul(mtxUV, a_mtxInvView);

	cMatrixf mtxModelView = mul(a_mtxView, mtxModel);
	px_vTangent = normalize(mul(mtxModelView, cVector4f(1, 0, 0, 0)).xyz); //should use inverse transpose here, hmm
	px_vBinormal = normalize(mul(mtxModelView, cVector4f(0, 0, 1, 0)).xyz); //should use inverse transpose here, hmm

	///////////
	// Apply model matrix for instance
	cVector4f vLocalVertexPos = mul(mtxModel, cVector4f(vtx_vPosition.xyz, 1.0));
	px_vPosition = mul(a_mtxViewProjection,vLocalVertexPos);
}