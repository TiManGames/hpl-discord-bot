////////////////////////////////////////////////////////
// Sway offset helpers
//

//---------------------------------------------

cVector3f GetSwaySingleDirectionOffset(	in float afT, in cVector4f avVtxPos, in cVector3f avSwayProperties, in cVector3f avSwayOctavesMul, in cVector3f avDirection, in cVector3f avSampleDirection)
{
	float fT = afT * avSwayProperties.z;
	float fPosAdd = length(avVtxPos.xyz*avSampleDirection);
	
	cVector3f vAddX =  cVector3f(7.0, 3.0, 1.0) * fPosAdd * avSwayProperties.x + cVector3f(13.0, 17.0, 103.0);
	cVector3f vOffset = avDirection * dot( cVector3f(sin(fT*1.13 + vAddX.x), sin(fT*1.17 + vAddX.y), sin(fT + vAddX.z)), avSwayOctavesMul );
	
	vOffset *= avSwayProperties.y;
	
	return vOffset;
}

cVector3f GetSwayOffset(in float afT, in cVector4f avVtxPos, in cVector3f avSwayProperties, in cVector3f avSwayOctavesMul, float afYFreqMul)
{
	float fT = afT * avSwayProperties.z;
	cVector3f vOffset;
	
	float fYPosAdd = avVtxPos.y*afYFreqMul;
		
	cVector3f vAddX =  cVector3f(7.0, 3.0, 1.0) * (avVtxPos.z+fYPosAdd) * avSwayProperties.x + cVector3f(13.0, 17.0, 103.0);
	vOffset.x = dot( cVector3f(sin(fT*1.13 + vAddX.x), sin(fT*1.17 + vAddX.y), sin(fT + vAddX.z)), avSwayOctavesMul );
		
	vOffset.y = 0.0;
		
	cVector3f vAddZ =  cVector3f(7.0, 3.0, 1.0) * (avVtxPos.x + vOffset.x+fYPosAdd) * avSwayProperties.x + cVector3f(103.0, 13.0, 113.0);;
	vOffset.z = dot( cVector3f(sin(fT*1.13 + vAddZ.x), sin(fT*1.17 + vAddZ.y), sin(fT + vAddZ.z)), avSwayOctavesMul );
		
	vOffset *= avSwayProperties.y;
	
	return vOffset;
}

//---------------------------------------------

cVector2f GetSingleForceFieldOffset(in float afT, in cVector4f avVtxPos, in cVector4f avForceFieldPos, in cVector4f avForceFieldProp)
{
	float fDist = distance(avForceFieldPos.xyz, avVtxPos.xyz);
			
	//Get the amount of force given distance from field.
	float fForce = (1 - (fDist - avForceFieldProp.x)/avForceFieldProp.y) * avForceFieldProp.z;
	fForce = clamp(fForce, 0, avForceFieldProp.w);
			
	float fAngle = afT;
			
	//w = is t for the sway.
	fForce *= sin(avForceFieldPos.w + fAngle);
			
	//Calculate the direction of the force
	cVector2f vDir = cVector2f(sin(fAngle), cos(fAngle));
			
	//Calculate the final offset
	return vDir * fForce;
}

//---------------------------------------------

cVector2f GetFourForceFieldsOffset(	in float afT, in cVector4f avVtxPos,
								in cVector3f avForceFieldPos0, in cVector3f avForceFieldPos1, in cVector3f avForceFieldPos2, in cVector3f avForceFieldPos3, 
								in cVector4f avForceFieldFadeStarts, in cVector4f avForceFieldFadeLengths, in cVector4f avForceFieldForces,
								in cVector4f avForceFieldTs, in float afForceFieldMaxForce)
		
{
	//Get the distances for all force fields.
	cVector4f vDistances = cVector4f(	distance(avForceFieldPos0, avVtxPos.xyz),
							distance(avForceFieldPos1, avVtxPos.xyz),
							distance(avForceFieldPos2, avVtxPos.xyz),
							distance(avForceFieldPos3, avVtxPos.xyz) );
	//Calculate force for all force field in one go.
	cVector4f vForces = max( (cVector4f(1, 1, 1, 1) - (vDistances - avForceFieldFadeStarts) / avForceFieldFadeLengths) * avForceFieldForces, cVector4f(0, 0, 0, 0) );
	
	float fAngle = afT;
	
	//get the force mul for each field.
	cVector4f vForceMul= cVector4f( sin(avForceFieldTs.x + fAngle),
						sin(avForceFieldTs.y + fAngle),
						sin(avForceFieldTs.z + fAngle),
						sin(avForceFieldTs.w + fAngle));
	
	//Combine all forces and clamp it to max.
	float fTotalForce = clamp( dot(vForces, vForceMul), -afForceFieldMaxForce, afForceFieldMaxForce);
	
	//Calculate the direction			
	cVector2f vDir = cVector2f(sin(fAngle), cos(fAngle));
	
	return vDir * fTotalForce;
}

//---------------------------------------------