////////////////////////////////////////////////////////
// PostEffect Bloom Blur - Fragment Shader
//
// Blur effect for the bloom post effect
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;

@ifdef Blur
	uniform float avWeights[$kTotalBlurSamples];
	uniform cVector2f avOffsets[$kTotalBlurSamples];
@endif

@ifdef CombineMip
	uniform cTexture2D secondDiffuseMap : 1;
	uniform float afAlpha;
@endif

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor0 : 0)
{
	cVector2f vCoord = px_vTexCoord0.xy;

	@ifdef Blur
		/////////////
		// Blur final
		cVector4f vAmount = sample(diffuseMap, vCoord) * avWeights[0];
	
		for(int i = 1; i < $kTotalBlurSamples; i++)
		{	
			//////////
			// Sample in both positive and negative direction at the same time
			cVector4f vColor = sample(diffuseMap, vCoord + avOffsets[i]) + 
							   sample(diffuseMap, vCoord - avOffsets[i]);

			vAmount += vColor * avWeights[i];
		}
	@else
		////////////////
		// Sample preblurred map
		cVector4f vAmount = sample(diffuseMap, vCoord);
	@endif
	
	@ifdef CombineMip
		//////////////
		// Sample a second preblurred map
		cVector4f vSecondAmount = sample(secondDiffuseMap, vCoord);
		vAmount = mix(vSecondAmount, vAmount, afAlpha);
	@endif
	
	out_vColor0 = vAmount;
}