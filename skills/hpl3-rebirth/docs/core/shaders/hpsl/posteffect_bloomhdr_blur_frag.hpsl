////////////////////////////////////////////////////////
// PostEffect Bloom Blur - Fragment Shader
//
// Blur effect for the bloom post effect
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;

uniform float avWeights[$kBlurSamples];
uniform float avOffsets[$kBlurSamples];

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor0 : 0)
{
	@ifdef BlurHorisontal
		cVector2f vOffsetMul = cVector2f(1, 0.0);
	@else
		cVector2f vOffsetMul = cVector2f(0.0, 1);
	@endif	
	
	cVector2f vCoord = px_vTexCoord0.xy;
	cVector4f vAmount = sample(diffuseMap, vCoord + avOffsets[0] * vOffsetMul) * avWeights[0];
	
	for(int i=1; i<$kBlurSamples; i+=1)
	{	
		cVector2f vOffset = avOffsets[i] * vOffsetMul;

		//////////
		// sample in both positive and negative direction at the same time
		cVector4f vColor = sample(diffuseMap, vCoord + vOffset) + 
					       sample(diffuseMap, vCoord - vOffset);

		vAmount += vColor * avWeights[i];
	}

	out_vColor0 = vAmount;
}