////////////////////////////////////////////////////////
// Base - Apply color corrections
//
////////////////////////////////////////////////////////

uniform cTexture2D aTexture : 0;

uniform float afGammaCorrection;
uniform float afBrightness;
uniform float afContrast;

void main(in cVector4f px_vPosition,
	      in cVector4f px_vTexCoord0,	
		  out cVector4f out_vColor : 0)
{
	cVector4f vSample = sampleLod(aTexture, px_vTexCoord0.xy, 0);
	cVector3f vColor = vSample.rgb;
	
	// Gamma
	vColor = pow(vColor, cVector3f(afGammaCorrection));

	// Contrast
	vColor = (vColor - 0.5) * afContrast + 0.5;

	// Brightness
	vColor = vColor * afBrightness;

	// Clamp
	out_vColor = cVector4f(clamp(vColor, cVector3f(0.0), cVector3f(1.0)), vSample.a);
}