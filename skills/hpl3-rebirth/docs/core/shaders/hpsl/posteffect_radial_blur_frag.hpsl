////////////////////////////////////////////////////////
// PostEffect Radial Blur - Fragment Shader
//
// Do a blur based on the dist from center
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;

uniform float afSize;
uniform float afBlurStartDist;
uniform float afAlpha;
uniform cVector2f avScreenCenter;

void main(in cVector4f px_vTexCoord0,
		  in cVector4f px_vPosition,
		  out cVector4f out_vColor : 0)
{
	cVector2f vScreenCoord = px_vTexCoord0.xy;
	
	cVector2f vDir = avScreenCenter - vScreenCoord;
	float fDist = length(vDir) / 0.5;
	vDir = normalize(vDir);

	fDist = max(0.0, fDist-afBlurStartDist);
	
	vDir *= fDist * afSize;
			
	cVector3f vDiffuseColor = cVector3f(0.0, 0.0, 0.0);
	
	float fTotalWeight = 0.0;

	for(int i=1; i<4; ++i)
	{
		float fDistance = i / 7.0;

		float fWeight = (1 - fDistance) * (1 - fDistance);
		fTotalWeight += fWeight;

		vDiffuseColor += sample(diffuseMap, vScreenCoord+vDir*fDistance).xyz * fWeight;

		////////////
		// Dont sample if outside of the screen
		cVector2f vMirror = vScreenCoord+vDir*fDistance;
		cVector2f vOutside = abs(vMirror - cVector2f(0.5, 0.5));

		fWeight *= float(max(vOutside.x, vOutside.y) < 1.0);
		fTotalWeight += fWeight;

		vDiffuseColor += sample(diffuseMap, vMirror).xyz * fWeight;
	}
	
	vDiffuseColor = (sample(diffuseMap, vScreenCoord).xyz + vDiffuseColor * afAlpha) / (1.0 + fTotalWeight * afAlpha);
	
	out_vColor.xyz = vDiffuseColor;
	out_vColor.w = 1.0;
}