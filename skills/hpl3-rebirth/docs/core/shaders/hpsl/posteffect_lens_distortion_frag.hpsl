////////////////////////////////////////////////////////
// PostEffect Lens Distortion - Fragment Shader
//
// Applies some lens distortion to the image
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;

uniform cVector2f avScreenSize;
uniform float afAmount;
uniform cVector2f avScreenCenter;

void main(in cVector4f px_vPosition,
          in cVector4f px_vTexCoord0,
          out cVector4f out_vColor : 0)
{
    cVector2f vScreenSize = cVector2f(1.0, 1.0);

    ///////////////////////////////////
    // Set up coordinates
    cVector2f vCoords = px_vTexCoord0.xy;
    cVector2f vHalfScreen = vScreenSize * avScreenCenter;
    cVector2f vOffset = vHalfScreen - vCoords;
    cVector2f vDistortion = vOffset * 2.0 / vHalfScreen.xx;
    float fAmount = afAmount * vScreenSize.x * 0.1;
    // float fDistortion = pow(dot(vDistortion, vDistortion), 1.25) * fAmount;
    float fDistortion = pow(dot(vDistortion, vDistortion), 2.0) * fAmount;

    cVector2f vDistortedCoords = vCoords + vDistortion * fDistortion;
    if(afAmount < 0.0)
    {
        ////////////
        // Zoom in
        cVector2f vCorner = vHalfScreen * 2.0 / vHalfScreen.xx;
        float fMaxDistortion = dot(vCorner, vCorner) * 2.0;
        float fZoom = vHalfScreen.x / (vHalfScreen.x-fMaxDistortion * fAmount);
        vDistortedCoords = (vDistortedCoords - vHalfScreen) * fZoom  + vHalfScreen;
    }

    ///////////////////////////////////
    // Distortion color
    cVector4f vSamp1 = sample(diffuseMap, vDistortedCoords);
    // vSamp1 = cVector4f(0.5 + vOffset.x , 0.5 + vOffset.y, 0.0, 1.0);
    
    ///////////////////////////////////
    // Final Color
    out_vColor = vSamp1;
}