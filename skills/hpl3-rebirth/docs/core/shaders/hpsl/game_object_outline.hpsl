////////////////////////////////////////////////////////
// Base - Fragment Shader
//
// A basic fragment with little fancy stuff.
////////////////////////////////////////////////////////

uniform cVector4f avOutlineColor;
uniform cVector2f avScreenSize;
uniform float afEffectY;
uniform cVector2f avObjectScreenMinAndSize;

uniform cTexture2D aDiffuseMap : 0;

void main(in cVector4f px_vPosition,
		  in cVector3f px_vNormal,
		  out cVector4f out_vColor : 0)
{
	float fY =  1.0f - clamp(abs((px_vPosition.y- avObjectScreenMinAndSize.x)/ (avObjectScreenMinAndSize.y)), 0.0, 1.0);
	float fA = (fY- (afEffectY-0.4))/0.8;
	fA = clamp(1 - abs(2*fA - 1), 0.0, 1.0);
	
	float fDot = abs(dot( cVector3f(0,0,1), px_vNormal));
	float fX = mix(avOutlineColor.w*fA, 1 - fDot, fDot);
	
	out_vColor.xyz = cVector3f(  avOutlineColor.xyz*(fA*fA*fA)*avOutlineColor.w*fX  );
	out_vColor.w = 0.0;
}