		"01-02-caves-b-wake",				"loadscreen_1f",
		"01-02-caves-b-pregnant",			"loadscreen_1f",
		"01-02-caves-b-salim",				"loadscreen_1f",
		"02-01-path-to-outpost",			"loadscreen_2b",
		"02-outpost-before-doctor",			"loadscreen_2d",
		"02-outpost-after-doctor",			"loadscreen_2f",
		"02-05-cistern",					"loadscreen_2i",
		"02-06-oasis",						"loadscreen_2i",
		"02-07-alchemists-lab",				"loadscreen_2m",
		"02-07-alchemists-lab-dream",		"loadscreen_2m",
		"03-03-herberts-hq-a",				"loadscreen_3a",
		"03-03-herberts-hq-b-init",			"loadscreen_3a",
		"03-03-herberts-hq-b-after-pillar",	"loadscreen_3b",
		"03-03-herberts-hq-b-after-vitae",	"loadscreen_3e",
		"03-03-herberts-hq-b-after-ghoul",	"loadscreen_3g",
		"03-04-pillar-room",				"loadscreen_3a",
		"03-05-vitae-station",				"loadscreen_3e",
		"03-06-ghouls-nest",				"loadscreen_3g",
		"03-07-dwf-a-theatre",				"loadscreen_3k",
		"03-07-dwf-b-rnd",					"loadscreen_4a",
		"03-07-dwf-c-factory",				"loadscreen_4b",
		"03-07-dw-factory-dream",			"loadscreen_4c",
		"04-01-town",						"loadscreen_4d",
		"04-02-sandstorm-birth",			"loadscreen_4d",
		"04-02-sandstorm-taken",			"loadscreen_4g",
		"04-03-undercity-chase",			"loadscreen_4g",
		"04-03-undercity-baby",				"loadscreen_4g",
