	void SetLastTimeOn(const tString& in asMapName)
	{
		// Default
		tString lastTimeOnText = asMapName;
		
		// Exceptions
		if (asMapName=="01-02-caves")
		{
			lastTimeOnText="01-02-caves-camp";
			if (cScript_GetGlobalVarBool("Caves_Deeper"))
				lastTimeOnText="01-02-caves-deeper";
		}
		else if (asMapName=="01-04-dark-world-ledge")
		{
			lastTimeOnText="01-02-caves-deeper";
			if (cScript_GetGlobalVarBool("DWL_ReachedVista"))
				lastTimeOnText="01-02-dark-world-ledge-vista";
		}			
		else if (asMapName=="01-02-caves-b")
		{
			lastTimeOnText="01-02-caves-b-wake";
			if (cScript_GetGlobalVarBool("Caves_FoundSalim"))
				lastTimeOnText="01-02-caves-b-salim";
			else if (cScript_GetGlobalVarBool("Caves_KnowPregnant"))
				lastTimeOnText="01-02-caves-b-pregnant";
		}
		else if (asMapName=="02-02-courtyard" || asMapName== "02-03-arsenal" || asMapName=="02-04-living-quarters")
		{
			lastTimeOnText="02-outpost-before-doctor";
			if (cScript_GetGlobalVarBool("Outpost_TalkedToDoctor"))
				lastTimeOnText="02-outpost-after-doctor";
		}
		else if (asMapName=="03-03-herberts-hq-b")
		{
			lastTimeOnText="03-03-herberts-hq-b-init";
			if (cScript_GetGlobalVarBool("TTH_GhoulsNestComplete"))
				lastTimeOnText="03-03-herberts-hq-b-after-ghoul";
			else if (cScript_GetGlobalVarBool("TTH_VitaeCanisterCollected"))
				lastTimeOnText="03-03-herberts-hq-b-after-vitae";
			else if (cScript_GetGlobalVarBool("TTH_PillarRoomComplete"))
				lastTimeOnText="03-03-herberts-hq-b-after-pillar";
		}
		else if (asMapName=="03-07-dwf-b-rnd")
		{
			if (cScript_GetGlobalVarBool("DWF_TasiHasTortured"))
				lastTimeOnText="03-07-dwf-c-factory";
		}
		else if (asMapName=="03-07-dwf-d-factory")
		{
			lastTimeOnText="03-07-dwf-c-factory";
		}
		else if (asMapName=="04-02-sandstorm")
		{
			lastTimeOnText="04-02-sandstorm-birth";
			if (cScript_GetGlobalVarBool("Sandstorm_BabyTaken"))
				lastTimeOnText="04-02-sandstorm-taken";
		}
		else if (asMapName=="04-03-undercity" or asMapName=="04-03-undercity-b")
		{
			lastTimeOnText="04-03-undercity-chase";
			if (cScript_GetGlobalVarBool("Undercity_FoundBaby"))
				lastTimeOnText="04-03-undercity-baby";
		}
		
		// Images
		tString lastTimeOnSketch = "";
		for (int i=0;i<gvPreviouslyOnSketches.size();i+=2)
		{
			if (gvPreviouslyOnSketches[i]==lastTimeOnText)
			{
				lastTimeOnSketch=gvPreviouslyOnSketches[i+1];
				break;
			}
		}

		msLastTimeOnText = lastTimeOnText;
		msLastTimeOnSketch = lastTimeOnSketch;
		
		MainMenu_Sketchbook_SetSketch(msLastTimeOnSketch);
	}
	
