#include "interfaces/UserModule_Interface.hps"
#include "modules/ModuleInterfaces.hps"

//---------------------------------------------------

class cLightFlash
{
	int mlId;
	tID m_idLight;
	float mfFadeInCount;
	float mfFadeInTime;
	float mfCount;
	float mfFadeOutCount;
	float mfFadeOutTime;
	float mfFinalBrightness;
}

//---------------------------------------------------

class cScrLightFlashHandler : iScrUserModule, iScrUserModule_Interface, iScrLightFlashHandler_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	
	}
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	//MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	
	}
	void OnMapLeave(cLuxMap @apMap)
	{
		mvLightFlashes.resize(0);
		mlIdCount=0;
	}
	
	//------------------------------------------------------------
	
	void PreloadData(cLuxMap @apMap)
	{
	}
	
	void CreateWorldEntities(cLuxMap @apMap)
	{
	
	}
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterContainer(const tString&in asOldContainer)
	{
	
	}
	void OnLeaveContainer(const tString&in asNewContainer)
	{
	
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		for(int i=0; i<mvLightFlashes.size(); ++i)
		{
			cLightFlash @pFlash = @mvLightFlashes[i];
			cLightPoint @pLight = cast<cLightPoint>(cLux_ID_Light(pFlash.m_idLight));
			
			/////////////////////
			// Fade in
			if(pFlash.mfFadeInCount > 0)
			{
				pFlash.mfFadeInCount -= afTimeStep;
				if(pFlash.mfFadeInCount<0) pFlash.mfFadeInCount =0;
				
				pLight.SetBrightness( (1.0f - pFlash.mfFadeInCount/ pFlash.mfFadeInTime) * pFlash.mfFinalBrightness);
			}
			/////////////////////
			// Duratation
			else if(pFlash.mfCount > 0)
			{
				pFlash.mfCount -= afTimeStep;
			}
			/////////////////////
			// Fade out
			else if(pFlash.mfFadeOutCount > 0)
			{
				pFlash.mfFadeOutCount -= afTimeStep;
				if(pFlash.mfFadeOutCount<0) pFlash.mfFadeOutCount =0;
				pLight.SetBrightness( (pFlash.mfFadeOutCount/ pFlash.mfFadeOutTime) * pFlash.mfFinalBrightness);
			}
			/////////////////////
			// Destroy
			else 
			{
				cLux_GetCurrentMap().GetWorld().DestroyLight(pLight);
				
				mvLightFlashes[i] = mvLightFlashes[mvLightFlashes.size()-1];
				mvLightFlashes.pop_back();
				--i;
			}
		}
	}
	
	
	//------------------------------------------------------------
		
	void PostUpdate(float afTimeStep)
	{
	}
	
	void VariableUpdate(float afDeltaTime)
	{
	}
	//------------------------------------------------------------
	
	void Reset()
	{
		mvLightFlashes.resize(0);
		mlIdCount=0;
	}
	
	//------------------------------------------------------------
	
	
	void OnDraw(float afFrameTime)
	{
	
	}
	void OnPostRender(float afFrameTime)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LIGHT FLASH
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int Add(float afTime, float afFadeInTime, float afFadeOutTime, const cVector3f &in avPosition,
			const cColor&in aColor, float afRadius, float afBrightness)
	{
		cLightPoint @pLight = cLux_GetCurrentMap().GetWorld().CreateLightPoint("LightFlash_"+mlIdCount,"", false);
		
		pLight.SetDiffuseColor(aColor);
		pLight.SetRadius(afRadius);
		pLight.SetBrightness(0);
		pLight.SetPosition(avPosition);
		
		cLightFlash flash;
		flash.m_idLight = pLight.GetID();
		flash.mfCount = afTime;
		flash.mfFadeInCount = afFadeInTime;
		flash.mfFadeInTime = afFadeInTime;
		flash.mfFadeOutCount = afFadeInTime;
		flash.mfFadeOutTime = afFadeInTime;
		flash.mfFinalBrightness = afBrightness;
		flash.mlId = mlIdCount;
		
		mvLightFlashes.push_back(flash);
		
		mlIdCount++;
				
		return flash.mlId;
	}
	
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
	
	}
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
	
	}
	
	//------------------------------------------------------------
	
	void OnExitPressed()
	{
	
	}
	
	//------------------------------------------------------------
	
	void AppGotInputFocus()
	{
	
	}
	void AppLostInputFocus()
	{
	
	}
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cLightFlash[] mvLightFlashes;
	int mlIdCount;
	
	//------------------------------------------------------------
		
}
