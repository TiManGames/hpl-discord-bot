	//------------------------------------------------------------
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		
		return;
		if (cLux_ScriptDebugOn()==false) return;
		if (!mbActive) return;
		
		//Renders skeleton in front of body
		iLuxEntity@ pEnt = cLux_ID_Entity(m_idHands);
		if (pEnt is null) return;
		
		cVector3f vOffset = cLux_GetPlayer().GetCamera().GetForward();
		vOffset.y = 0;
		vOffset = cMath_Vector3Normalize(vOffset) * 0.5;
		//vOffset += cLux_GetPlayer().GetCamera().GetRight()*0.15;
		
		for (int i = 0; i < pEnt.GetMeshEntity().GetBoneStateNum(); i++)
		{
			cBoneState@ bone = pEnt.GetMeshEntity().GetBoneState(i);
			if (cString_GetFirstStringPos(bone.GetName(), "Grp") > -1 ||
				cString_GetFirstStringPos(bone.GetName(), "Rbn") > -1)
					continue;
			
			float fAxisLength = 0.05f;
			apFunctions.GetLowLevelGfx().DrawSphere(bone.GetWorldPosition()+vOffset,  0.003,  cColor(10,0,0,1));
			apFunctions.GetLowLevelGfx().DrawLine(bone.GetWorldPosition()+vOffset, bone.GetWorldPosition()+vOffset+(bone.GetWorldMatrix().GetTranspose().GetForward()*fAxisLength), cColor(0, 0, 10, 1));
			apFunctions.GetLowLevelGfx().DrawLine(bone.GetWorldPosition()+vOffset, bone.GetWorldPosition()+vOffset+(bone.GetWorldMatrix().GetTranspose().GetRight()*fAxisLength), cColor(10, 0, 0, 1));
			apFunctions.GetLowLevelGfx().DrawLine(bone.GetWorldPosition()+vOffset, bone.GetWorldPosition()+vOffset+(bone.GetWorldMatrix().GetTranspose().GetUp()*fAxisLength), cColor(0, 10, 0, 1));
			cNode3DIterator@ iterator = bone.GetChildIterator();
			while (iterator.HasNext())
			{
				cNode3D@ pNode = iterator.Next();
				apFunctions.GetLowLevelGfx().DrawLine(bone.GetWorldPosition()+vOffset, pNode.GetWorldPosition()+vOffset, cColor(10,10,10,1));
			}
		}
		
		return;
		
		if(mbCameraAttachActive)
		{
			cCamera @pCam = cLux_GetPlayer().GetCamera();

			apFunctions.GetLowLevelGfx().DrawSphere(pCam.GetPosition(), 0.05f, cColor(0.5,0.5,0.5,1));
			apFunctions.GetLowLevelGfx().DrawLine(pCam.GetPosition(), pCam.GetPosition()+pCam.GetForward()*0.3f, cColor(3,1,3,1));
			

			iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
			
			//apFunctions.GetLowLevelGfx().DrawLine(pEntity.GetPosition(), pEntity.GetPosition()+cVector3f(0.3,0,0), cColor(5,0,0,1));
			//apFunctions.GetLowLevelGfx().DrawLine(pEntity.GetPosition(), pEntity.GetPosition()+cVector3f(0,0.3,0), cColor(0,5,0,1));
			//apFunctions.GetLowLevelGfx().DrawLine(pEntity.GetPosition(), pEntity.GetPosition()+cVector3f(0,0,0.3), cColor(0,0,5,1));
			
			//apFunctions.GetLowLevelGfx().DrawLine(pCam.GetPosition(), pCam.GetPosition()+pCam.GetForward()*0.3, cColor(5,5,5,1));
			
			
			cBoneState@ pBone = pEntity.GetMeshEntity().GetBoneStateFromName(msCameraAttachBone);
			if(pBone !is null)
			{
				apFunctions.GetLowLevelGfx().DrawSphere(pBone.GetWorldPosition(), 0.05f, cColor(5,5,0,1));
				
				cMatrixf mtxTrans = pBone.GetWorldMatrix().GetRotation();//cMath_MatrixInverse(pBone.GetWorldMatrix().GetRotation());
				apFunctions.GetLowLevelGfx().DrawLine(pBone.GetWorldPosition(), pBone.GetWorldPosition()+mtxTrans.GetRight()*0.2, cColor(5,0,0,1));
				apFunctions.GetLowLevelGfx().DrawLine(pBone.GetWorldPosition(), pBone.GetWorldPosition()+mtxTrans.GetUp()*0.2, cColor(0,5,0,1));
				apFunctions.GetLowLevelGfx().DrawLine(pBone.GetWorldPosition(), pBone.GetWorldPosition()+mtxTrans.GetForward()*0.2, cColor(0,0,5,1));
			
			}
		}
	}
 	
	
	/////////////////////////////////////////
	// PUBLIC METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetHandModel(const tString& in asFile)
	{
		if(msHandModel == asFile) return;
		
		msHandModel = asFile;
		
		DestroyHandModel(cLux_GetCurrentMap());
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
	}
	
	//------------------------------------------------------------
		
	void PreloadHandModel(const tString& in asFile)
	{
		Entity_Preload(asFile);
	}
	
	//------------------------------------------------------------
	
	void PlayAnimation(const tString &in asAnim, bool abLoop, bool abFullScaleModel, float afFadeTime, const tString &in asAttachedProp, bool abDisableWhenOver, float afSpeed, float afRelTimePos)
	{
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		
		float fFadeTime = afFadeTime;
		if(mbUseFullScaleModel!=abFullScaleModel || pEntity.IsActive()==false)
		{
			fFadeTime=0;
		}
		
		int lAnim = pEntity.PlayAnimation(asAnim,  fFadeTime, abLoop);
		if(lAnim<0)
			return;
		//if(lAnim == mlCurrentAnimation) return;
		mlCurrentAnimation = lAnim;
			
		cMeshEntity@ pMeshEntity = pEntity.GetMeshEntity();
		cAnimationState@ pAnim = pMeshEntity.GetAnimationState(mlCurrentAnimation);
		
		////////////////////////////////////
		// Set up animation state
		pAnim.SetSpeed(afSpeed);
		if(afRelTimePos<0)
		{
			if(afSpeed<0) 	pAnim.SetRelativeTimePosition(1);
			else			pAnim.SetRelativeTimePosition(0);
		}
		else
		{
			pAnim.SetRelativeTimePosition(afRelTimePos);
		}
		
		////////////////////////////////////
		// Set up properties
		if(mbCameraAttachActive && mbCameraAttachFadingIn)
		{
			pAnim.SetPaused(true);
			SetVisible(false);
		}
		
		//cLux_AddDebugMessage("Hand Animation - "+asAnim);
		
		
		////////////////////////////////////
		// Hand animation sounds
		if(cLux_GetUnderwaterEffectsActive())
		{	
			//Underwater hand animation sounds
			Sound_PlayGui("Player/foley/default/hand_animation/underwater/"+asAnim, 1.0f, eSoundEntryType_WorldClean);
		}
		else
		{	
			//Normal hand animation sounds
			Sound_PlayGui("Player/foley/default/hand_animation/"+asAnim, 1.0f, eSoundEntryType_World);
		}
		
		////////////////////////////////////
		// Set up properties
		mbUseFullScaleModel = abFullScaleModel;
		SetActive(true);
		mbDisableWhenAnimOver = abDisableWhenOver;
		
		pEntity.GetMeshEntity().SetVisible(mbEntityVisible);
				
		
		/////////////////////////////
		// Attach a prop
		if(asAttachedProp != "")
		{
			iLuxEntity @pProp = cLux_GetCurrentMap().GetEntityByName(asAttachedProp);
			if(pProp is null)
			{
				Error("Could not find entity '"+asAttachedProp+"' to be attached to player hands");
				return;
			}
			
			iLuxEntity @pPrevProp = null;
			if(m_idCurrentAttachProp!=tID_Invalid) @pPrevProp = cLux_ID_Entity(m_idCurrentAttachProp);
			
			if(pPrevProp !is pProp)
			{
				if(pPrevProp !is null)
				{
					pPrevProp.RemoveEntityAttachment();
					pPrevProp.SetActive(false);
				} 
				
				if(pProp.GetMainBody() !is null)
				{
					pProp.GetMainBody().SetCollideCharacter(false);
					pProp.GetMainBody().SetCollide(false);
				}
				
				pProp.AttachToSocket(pEntity, "R_Hand", true, true);
				pProp.SetActive(true);
				m_idCurrentAttachProp  = pProp.GetID();
			}
		}
		/////////////////////////////
		// If something is attached, remove it.
		else
		{
			if(m_idCurrentAttachProp!=tID_Invalid)
			{
				iLuxEntity @pAttachProp = cLux_ID_Entity(m_idCurrentAttachProp);
				if(pAttachProp !is null)
				{
					pAttachProp.SetActive(false);
					pAttachProp.RemoveEntityAttachment();	
				}
				m_idCurrentAttachProp = tID_Invalid;
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool GetAnimationPlaying()
	{
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		return (pEntity !is null) && pEntity.GetAnimationIsPlaying();
	}
	
	//------------------------------------------------------------
	
	void SetActive(bool abX)
	{
		if(mbActive == abX) return;
		
		CreateHandModelIfNeeded(cLux_GetCurrentMap());
		
		mbActive = abX;
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		pEntity.SetActive(abX);
		
		if(m_idCurrentAttachProp!=tID_Invalid)
		{
			iLuxEntity@ pAttachProp = cLux_ID_Entity(m_idCurrentAttachProp);
			if(pAttachProp !is null)
				pAttachProp.SetActive(false);
			m_idCurrentAttachProp = tID_Invalid;
		}
			
		
		if(abX==false)
		{
			pEntity.StopAllAnimations(0);
		}
					
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		mvCurrentHandRotation = cVector3f(pCam.GetPitch(), pCam.GetYaw(), pCam.GetRoll()*0.5);
	}
	
	//------------------------------------------------------------
	
	bool IsActive()
	{
		return mbActive;
	}
	
	//------------------------------------------------------------
	
	tString GetEntityName()
	{
		iLuxEntity @pEntity = cLux_ID_Entity(m_idHands);
		return pEntity.GetName();
	}
	
