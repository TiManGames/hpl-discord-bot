	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------	
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Reset()
	{
		
	}
	
	//------------------------------------------------------------
	
	void SetActive(bool abX)
	{
	}
	
	//------------------------------------------------------------

	void Update(float afTimeStep)
	{	
	}
	
	//------------------------------------------------------------
	
	void VariableUpdate(float afDeltaTime)
	{
		if (cLux_GetPlayer().GetCharacterBody() is null) return;
		
		UpdateAddObjects(afDeltaTime);
		UpdateHighLightEffect(afDeltaTime);
	}

	//------------------------------------------------------------
	
	void UpdateHighLightEffect(float afTimeStep)
	{
		////////////////////
		// Setup variables
		cLuxPlayer@ pPlayer = cLux_GetPlayer();
		cCamera@ pCam = pPlayer.GetCamera();
		cLuxEffectHandler@ pEffectHandler = cLux_GetEffectHandler();
		cVector3f vPlayerPos = pPlayer.GetCharacterBody().GetPosition();
		
		/////////////////
		// Iterate active objects
		for (int i = 0; i < mvObjects.size(); ++i)
		{
			iLuxEntity@ pEntity = cLux_ID_Entity(mvObjects[i].m_idEntity);			
			if (pEntity is null || pEntity.IsActive() == false)
			{
				mvObjects[i] = mvObjects[mvObjects.size() - 1];
				mvObjects.pop_back();
				i--;
				continue;
			}
			
			/////////////////
			// Calculate glow						
			mvObjects[i].mfGlowCount += afTimeStep * mvObjects[i].mfGlowSpeed;
			
			if (mvObjects[i].mfGlowCount > 3.f)
				mvObjects[i].mfGlowCount = 0.f;
				
			float fY = cMath_Min(mvObjects[i].mfGlowCount, 1.f);
			float fGlow = 1.f - cMath_Abs(2.f * fY - 1.f);
			fGlow = cMath_Easing(eEasing_QuadInOut, fGlow);
			fY = cMath_Easing(eEasing_SineInOut, fY);
			
			/////////////////
			// Apply glow
			cColor GlowColor = mvObjects[i].mbIsLamp ? cColor(0.35,0.15,0.0, 1) : cColor(0.3,0.3,0.3, 1);
			GlowColor.a = fGlow;
			pEffectHandler.AddGlowObject(pEntity, GlowColor, fY);	
			
			/////////////////
			// Stop glowing?
			bool bStopGlow = false;

			//if (mvObjects[i].mbIsLamp) cLux_AddDebugMessage("fEffectDist "+mvObjects[i].mfEffectDist);
			float fMaxDistSqr =  mvObjects[i].mfEffectDist * mvObjects[i].mfEffectDist;		
			//if (mvObjects[i].mbIsLamp) cLux_AddDebugMessage("Player Dist "+(pEntity.GetPosition() - vPlayerPos).Length());	
			bool bWithinDist = (pEntity.GetPosition() - vPlayerPos).SqrLength() < fMaxDistSqr;
			
			cBoundingVolume@ pBounds = pEntity.GetMeshEntity().GetBoundingVolume();			
			
			if (bWithinDist == false && fGlow <= 0.f)
				bStopGlow = true;
			else if (mvObjects[i].mbIsLamp && pEntity.GetEffectsActive())
				bStopGlow = true;
			else if (pCam.GetFrustum().CollideAABB(pBounds.GetMin(), pBounds.GetMax(), 6) == eCollision_Outside)
				bStopGlow = true;
						
			if (bStopGlow)
			{
				mvObjects[i] = mvObjects[mvObjects.size() - 1];
				mvObjects.pop_back();
				i--;
			}	
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateAddObjects(float afTimeStep)
	{
		////////////////////
		// Check interval
		mfCheckAddObjectsCount -= afTimeStep;
		if (mfCheckAddObjectsCount > 0.f) return;
		mfCheckAddObjectsCount = 1.f / 30.f;
		
		////////////////////
		// Setup variables
		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
		
		////////////////////
		// Get current area to check
		mvCheckBoxMin = cVector3f(-gvHighligEffectGridSize.x * 0.5f, -gvHighligEffectGridSize.y * 0.5f, -gvHighligEffectGridSize.z * 0.5f);
		mvCheckBoxMax = cVector3f(gvHighligEffectGridSize.x * 0.5f, gvHighligEffectGridSize.y * 0.5f, gvHighligEffectGridSize.z * 0.5f);
		
		cVector3f vPos = pCharBody.GetPosition() + pCharBody.GetForward() * (gfHightlightEffectMaxDistance * 0.5f);
		vPos += mvCheckBoxMin;
		vPos += mvCurrentGrid;
		
		mvCheckBoxMin += vPos;
		mvCheckBoxMax += vPos;
		
		array<iPhysicsBody@> vBodies;
		cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(mvCheckBoxMin, mvCheckBoxMax, vBodies);
		
		////////////////////
		// Get all entities that need a highlight
		bool bFoundObject = false;
		iPhysicsBody@ pBody = null;
		iLuxEntity@ pEntity = null;
		cVector3f vPlayerPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
		
		for(int i = 0; i < vBodies.size(); ++i)
		{
			@pBody = vBodies[i];
			if (pBody.IsActive() == false) continue;
			
			@pEntity = cLux_GetBodyEntity(pBody);
			if (pEntity is null) continue;
			if (pEntity.GetMeshEntity() is null) continue;			
			if (pEntity.GetInteractionDisabled()) continue;
			if (ObjectExists(pEntity.GetID())) continue;
			
			tString sClass = pEntity.GetClassName();			
			if (sClass != "cScrPropReadable" && 
				sClass != "cScrPropPickup" &&
				sClass != "cScrPropPickupDynamic" &&
				sClass != "cScrPropLantern" &&
				sClass != "cScrPropHandheldTerminal" &&
				sClass != "cScrPropDWReadable" &&
				sClass != "cScrPropMemoryCylinder" &&
				sClass != "cScrPropLamp")
				continue;
			
			if (Item_GetHeldEntity(eItemHandlerHand_Left) == pEntity.GetName() ||
				Item_GetHeldEntity(eItemHandlerHand_Right) == pEntity.GetName())
				continue;
			
			cScript_RunGlobalFunc(pEntity.GetName(), "", "_Global_GetCanBeHighlighted");			
			if (cScript_GetGlobalReturnBool() == false) continue;			
			if (pEntity.CheckIsOnScreen(true) == false) continue;
			
			bool bIsLamp = sClass == "cScrPropLamp";
			if (bIsLamp && pEntity.GetEffectsActive()) continue;
			
			// Skipping the light check for now as it returns false negatives and might just be annoying
			//float fLightLevel = cLux_GetLightLevelAtPos(pEntity.GetPosition(), null, 0.2f);
			//bool bInLight = (fLightLevel > gfHighlightEffectMinLightLevel);
						
			float fMaxDist = bIsLamp ? gfHightlightEffectMaxDistanceLamp : gfHightlightEffectMaxDistance;
				
			if ((pEntity.GetPosition() - vPlayerPos).SqrLength() > fMaxDist*fMaxDist)	continue;
			
			cHighlightObject object;
			object.m_idEntity = pEntity.GetID();
			object.mfEffectDist = fMaxDist + 1.f;
			object.mbIsLamp = bIsLamp;
			mvObjects.push_back(object);
						
			bFoundObject = true;
			break;
		}
		
		if (bFoundObject)
			return;
		
		////////////////
		// Warp around grid and update one part per frame
		mvCurrentGrid.x += gvHighligEffectGridSize.x;
		
		if(mvCurrentGrid.x >= gfHightlightEffectMaxDistance)
		{
			mvCurrentGrid.x = 0.f;
			mvCurrentGrid.z += gvHighligEffectGridSize.z;

			if(mvCurrentGrid.z >= gfHightlightEffectMaxDistance)
			{
				mvCurrentGrid.z = 0.f;
				mvCurrentGrid.y += gvHighligEffectGridSize.y;

				if (mvCurrentGrid.y >= 4.f) 
					mvCurrentGrid.y = 0.f;
			}
		}
	}
	
	
