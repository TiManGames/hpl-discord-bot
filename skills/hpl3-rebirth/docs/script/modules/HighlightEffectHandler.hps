#include "interfaces/UserModule_Interface.hps"
#include "modules/ModuleInterfaces.hps"
#include "custom/helpers/helper_items.hps"

//------------------------------------------------------------

class cHighlightObject
{
	tID m_idEntity = tID_Invalid;
	float mfGlowCount = 0.f;
	float mfGlowSpeed = cMath_RandRectf(0.85f, 1.25f);
	float mfEffectDist = -1.f;
	bool mbIsLamp = false;
}

//------------------------------------------------------------

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

const float gfHightlightEffectMaxDistanceLamp = 3.5f;
const float gfHightlightEffectMaxDistance = 4.5f;
const float gfHighlightEffectMinLightLevel = 0.04f;
const cVector3f gvHighligEffectGridSize(2.25f, 2.25f, 2.25f);

//------------------------------------------------------------

class cScrHighlightEffectHandler : iScrUserModule, iScrUserModule_Interface
{
