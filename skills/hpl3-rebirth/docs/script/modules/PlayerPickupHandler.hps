#include "interfaces/UserModule_Interface.hps"
#include "modules/ModuleInterfaces.hps"
#include "helpers/helper_map.hps"

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

//------------------------------------------------------------

class cScrPickupableProp
{
	cScrPickupableProp()
	{
		
	}
	
	cScrPickupableProp(const tString &in asPropName, const tString &in  asPickedCallback, const float afTimeToPickup, 
						const cMatrixf amtxOriginOrientation)
	{
		mfTimeToPickup = afTimeToPickup;
		msPickedupCallback = asPickedCallback;
		m_mtxOriginOrientation = amtxOriginOrientation;
		mfCurrentTime = 0.0f;
		mbFinished = false;
		m_idProp = Map_GetProp(asPropName).GetID();
	}
	
	tID m_idProp;
	
	cMatrixf  m_mtxOriginOrientation;
	cMatrixf  m_mtxCurrentOrientation;
	cVector3f mvCurrentPosition;
	float     mfTimeToPickup;
	float 	  mfCurrentTime;
	tString   msPickedupCallback;
	bool      mbFinished;
}

//------------------------------------------------------------

class cScrPlayerPickupHandler : iScrUserModule, iScrUserModule_Interface, iScrPlayerPickupHandler_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{

	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// USER SETTINGS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	
	}
	void SaveUserConfig()
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}
	void OnMapLeave(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	void PreloadData(cLuxMap @apMap)
	{

	}

	void CreateWorldEntities(cLuxMap @apMap)
	{
	
	}
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Reset()
	{
	}
	
	void SetActive(bool abX)
	{
	}
	
	//------------------------------------------------------------

	void Update(float afTimeStep)
	{
		cVector3f vTargetPos = cLux_GetPlayer().GetCamera().GetPosition();
		vTargetPos += cLux_GetPlayer().GetCamera().GetForward() * 0.15f;
		
		cVector3f vAngles = cMath_GetAngleFromPoints3D(cVector3f(0,0,0), cLux_GetPlayer().GetCamera().GetForward());
		cMatrixf mtxTarget = cMath_MatrixRotateXYZ(vAngles);
		
		for(int lPropIndex = 0; lPropIndex < mvProps.length(); lPropIndex++)
		{
			cScrPickupableProp@ pProp = mvProps[lPropIndex];
			if(pProp.mbFinished)
			{
				mvProps.removeAt(lPropIndex);
				lPropIndex--;
				continue;
			}
			pProp.mfCurrentTime += cMath_Clamp(afTimeStep, 0.0f, 1.0f);
			
			pProp.m_mtxCurrentOrientation = cMath_MatrixSlerp(cMath_Clamp(pProp.mfCurrentTime / pProp.mfTimeToPickup, 0.0f, 1.0f),
											pProp.m_mtxOriginOrientation, mtxTarget, false);
											
			pProp.mvCurrentPosition = pProp.m_mtxOriginOrientation.GetTranslation() + 
								((vTargetPos - pProp.m_mtxOriginOrientation.GetTranslation()) * cMath_Clamp(pProp.mfCurrentTime / pProp.mfTimeToPickup, 0.0f, 1.0f));
		}
	}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
		for(int lPropIndex = 0; lPropIndex < mvProps.length(); lPropIndex++)
		{
			cScrPickupableProp@ pProp = mvProps[lPropIndex];
			cLuxProp@ pEnt = cLux_ID_Prop(pProp.m_idProp);
			pEnt.SetMatrix(pProp.m_mtxCurrentOrientation);
			pEnt.SetPosition(pProp.mvCurrentPosition);
			if(pProp.mfCurrentTime> pProp.mfTimeToPickup)
			{
				pProp.mbFinished = true;
				
				////////////////////////////////
				// Runs close callback if it exists.
				cLuxMap@ pMap = cLux_GetCurrentMap();
				if(pProp.msPickedupCallback != "" && pMap.ScriptPrepare("void " + pProp.msPickedupCallback + "(const tString &in asEntity)"))
				{
					tString entityName = pEnt.GetName();
					pMap.SetArgString(0, entityName);
					pMap.ScriptExecute();
				}
			}
		}
	}
	void VariableUpdate(float afDeltaTime)
	{
	}
	
	//------------------------------------------------------------
	
	void OnDraw(float){}
	void OnPostRender(float){}
	void OnEnterContainer(const tString&in){}
	void OnLeaveContainer(const tString&in){}
	void AppGotInputFocus(){}
	void AppLostInputFocus(){}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{

	}
	
	//------------------------------------------------------------
	
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
	}
	
	//------------------------------------------------------------
	
	void OnExitPressed()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_PickupProp()
	{
		tString sPropName = cScript_GetGlobalArgString(0);
		tString sCallback = cScript_GetGlobalArgString(1);
		cMatrixf mtxOrigin = cMatrixf_Identity;
		mtxOrigin.SetTranslation(GetCurrentInitPosition());
		
		float fTimeToPickup = cScript_GetGlobalArgFloat(3);
		
		InternalPickupProp(sPropName, sCallback, fTimeToPickup, mtxOrigin);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void InternalPickupProp(const tString &in asPropName, const tString &in asCallback, const float afTimeToPickup, const cMatrixf amtxOrigin)
	{
		mvProps.push_back(cScrPickupableProp(asPropName, asCallback, afTimeToPickup, amtxOrigin));
	}
	
	//------------------------------------------------------------
		
	cVector3f GetCurrentInitPosition()
	{
		cVector3f vInitialPos = cLux_GetPlayer().GetCamera().GetPosition();
		vInitialPos -= cLux_GetPlayer().GetCamera().GetUp();
		return vInitialPos;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	array<cScrPickupableProp> mvProps;

	//------------------------------------------------------------
	
}