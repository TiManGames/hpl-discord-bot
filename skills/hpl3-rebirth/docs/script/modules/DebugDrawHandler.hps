//----------------------------------------------------------------------------------------

#include "interfaces/UserModule_Interface.hps"
#include "modules/ModuleInterfaces.hps"
#include "base/Player_Types.hps"
#include "base/InputHandler_Types.hps"
#include "helpers/helper_modules.hps"
#include "helpers/helper_map.hps"

//----------------------------------------------------------------------------------------

// Command interface

class cDebugDrawCommand
{
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler){}
}


class cDebugDrawCommandContainer
{
	array<cDebugDraw_Line> mvLines;
	array<cDebugDraw_Sphere> mvSpheres;
	array<cDebugDraw_AABB> mvAABBs;
	array<cDebugDraw_MatrixAxis> mvMatrixAxisCmd;
	array<cDebugDraw_PushMatrix> mvPushMtxCmds;
	array<cDebugDraw_PopMatrix> mvPopMtxCmds;
	array<cDebugDraw_PushDepthTest> mvPushDepthTestCmd;
	array<cDebugDraw_PopDepthTest> mvPopDepthTestCmd;
	array<cDebugDrawCommand@> mvCommands;

	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		for(int i = 0; i < mvCommands.size(); ++i)
		{
			mvCommands[i].Execute(apFunctions, aDebugDrawHandler);
		}
	}

	void Reset()
	{
		mvCommands.resize(0);
		mvLines.resize(0);
		mvSpheres.resize(0);
		mvAABBs.resize(0);
		
		
		mvPushMtxCmds.resize(0);
		mvPopMtxCmds.resize(0);
		mvPushDepthTestCmd.resize(0);
		mvPopDepthTestCmd.resize(0);
		mvMatrixAxisCmd.resize(0);
	}

	void PushDepthTest(bool abX)
	{
		cDebugDraw_PushDepthTest depthTest;
		depthTest.mbX = abX;
		mvPushDepthTestCmd.push_back(depthTest);
		mvCommands.push_back(mvPushDepthTestCmd[mvPushDepthTestCmd.size() - 1]);
	}
	
	void PopDepthTest()
	{
		mvPopDepthTestCmd.push_back(cDebugDraw_PopDepthTest());
		mvCommands.push_back(mvPopDepthTestCmd[mvPopDepthTestCmd.size() - 1]);
	}
	
	void PushMatrix(const cMatrixf&in aMtx)
	{
		cDebugDraw_PushMatrix pushMatrix;
		pushMatrix.mMtx = aMtx;
		mvPushMtxCmds.push_back(pushMatrix);
		mvCommands.push_back(mvPushMtxCmds[mvPushMtxCmds.size() - 1]);
	}
	
	void PopMatrix()
	{
		mvPopMtxCmds.push_back(cDebugDraw_PopMatrix());
		mvCommands.push_back(mvPopMtxCmds[mvPopMtxCmds.size() - 1]);
	}
	
	void DrawSphere(const cVector3f&in avPosition, float afRadius, const cColor&in aColor)
	{
		cDebugDraw_Sphere sphere;
		sphere.mvPosition = avPosition;
		sphere.mfRadius = afRadius;
		sphere.mColor = aColor;
		mvSpheres.push_back(sphere);
		mvCommands.push_back(mvSpheres[mvSpheres.size() - 1]);
	}
	
	void DrawLine(const cVector3f&in avStart, const cVector3f&in avEnd, const cColor&in aColor)
	{
		cDebugDraw_Line line;
		line.mvStart = avStart;
		line.mvEnd = avEnd;
		line.mColor = aColor;
		mvLines.push_back(line);
		mvCommands.push_back(mvLines[mvLines.size() - 1]);
	}

	void DrawAABB(const cVector3f&in avMin, const cVector3f&in avMax, const cColor&in aColor)
	{
		cDebugDraw_AABB aabb;
		aabb.mvMin = avMin;
		aabb.mvMax = avMax;
		aabb.mColor = aColor;
		mvAABBs.push_back(aabb);
		mvCommands.push_back(mvAABBs[mvAABBs.size() - 1]);
	}
	
	void DrawMatrixAxis(const cMatrixf&in aMtx, float afSizeMul, float afColorMul)
	{
		cDebugDraw_MatrixAxis command;
		command.mfSizeMul = afSizeMul;
		command.mfColorMul = afColorMul;
		command.mMatrix = aMtx;
		mvMatrixAxisCmd.push_back(command);
		mvCommands.push_back(mvMatrixAxisCmd[mvMatrixAxisCmd.size() - 1]);
	}
}

//----------------------------------------------------------------------------------------

class cDebugDraw_PushMatrix : cDebugDrawCommand
{
	cMatrixf mMtx;
	
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		aDebugDrawHandler.mvMatrixStack.push_back(mMtx);
		apFunctions.SetMatrix(mMtx);
	}
}

//----------------------------------------------------------------------------------------

class cDebugDraw_PopMatrix : cDebugDrawCommand
{
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		cMatrixf mtxNew = cMatrixf_Identity;
		if(aDebugDrawHandler.mvMatrixStack.size() > 0)
		{
			aDebugDrawHandler.mvMatrixStack.pop_back();
		}
		
		if(aDebugDrawHandler.mvMatrixStack.size() > 0)
		{
			mtxNew = aDebugDrawHandler.mvMatrixStack[aDebugDrawHandler.mvMatrixStack.size() - 1];
		}
			
		apFunctions.SetMatrix(mtxNew);
	}
}

//----------------------------------------------------------------------------------------

class cDebugDraw_PushDepthTest : cDebugDrawCommand
{
	bool mbX;
	
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		aDebugDrawHandler.mvDepthTestStack.push_back(mbX);
		apFunctions.SetDepthTest(mbX);
	}
}

//----------------------------------------------------------------------------------------

class cDebugDraw_PopDepthTest : cDebugDrawCommand
{
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		bool bNew = true;
		if(aDebugDrawHandler.mvDepthTestStack.size() > 0)
		{
			aDebugDrawHandler.mvDepthTestStack.pop_back();
		}
			
		if(aDebugDrawHandler.mvDepthTestStack.size() > 0)
		{
			bNew = aDebugDrawHandler.mvDepthTestStack[aDebugDrawHandler.mvDepthTestStack.size() - 1];
		}
			
		apFunctions.SetDepthTest(bNew);
	}
}
//----------------------------------------------------------------------------------------

class cDebugDraw_Line : cDebugDrawCommand
{
	cVector3f mvStart;
	cVector3f mvEnd;
	cColor mColor;
	
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		apFunctions.GetLowLevelGfx().DrawLine(mvStart, mvEnd, mColor);
	}
}

//----------------------------------------------------------------------------------------

class cDebugDraw_Sphere : cDebugDrawCommand
{
	cVector3f mvPosition;
	float mfRadius;
	cColor mColor;
	
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		apFunctions.GetLowLevelGfx().DrawSphere(mvPosition, mfRadius, mColor);
	}
}

//----------------------------------------------------------------------------------------

class cDebugDraw_AABB : cDebugDrawCommand
{
	cVector3f mvMax;
	cVector3f mvMin;
	cColor mColor;
	
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		apFunctions.GetLowLevelGfx().DrawBoxMinMax(mvMin, mvMax, mColor);
	}
}

//----------------------------------------------------------------------------------------


class cDebugDraw_MatrixAxis : cDebugDrawCommand
{
	cMatrixf mMatrix;
	float mfSizeMul = 1.f;
	float mfColorMul = 1.f;
	
	void Execute(cRendererCallbackFunctions@ apFunctions, cScrDebugDrawHandler@ aDebugDrawHandler)
	{
		cVector3f vStart = mMatrix.GetTranslation();
		apFunctions.GetLowLevelGfx().DrawLine(vStart, vStart + mMatrix.GetRight()	* mfSizeMul, cColor_Red 	* mfColorMul);
		apFunctions.GetLowLevelGfx().DrawLine(vStart, vStart + mMatrix.GetUp()		* mfSizeMul, cColor_Green 	* mfColorMul);
		apFunctions.GetLowLevelGfx().DrawLine(vStart, vStart + mMatrix.GetForward()	* mfSizeMul, cColor_Blue 	* mfColorMul);
	}
}


//----------------------------------------------------------------------------------------

class cScrDebugDrawHandler : iScrUserModule, iScrDebugDrawHandler_Interface
{
	/////////////////////////////////////////
	// INIT
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		SetCurrentIfNeeded();
	}
	
	//}-----------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void BeginTimed(float afTime)
	{
		if(ShouldDraw() == false)
			return;
		
		if(mbAddingTimedCmds)
		{
			Error("DebugDrawHandler: Cannot start a timed command within another");
			return;
		}
		
		mbAddingTimedCmds = true;
		mvTimedCommandContainers.push_back(cDebugDrawCommandContainer());
		mvTimers.push_back(afTime);
		@mpCurrentContainer = mvTimedCommandContainers[mvTimedCommandContainers.size() - 1];
	}
	
	//------------------------------------------------------------
	
	void EndTimed()
	{
		if(ShouldDraw() == false)
			return;
		
		mbAddingTimedCmds = false;
		@mpCurrentContainer = mCommandContainer;
	}
	
	//------------------------------------------------------------
	
	void PushDepthTest(bool abX)
	{
		if(ShouldDraw() == false)
			return;
		SetCurrentIfNeeded();
		mpCurrentContainer.PushDepthTest(abX);
	}
	
	//------------------------------------------------------------
	
	void PopDepthTest()
	{
		if(ShouldDraw() == false)
			return;
		SetCurrentIfNeeded();
		mpCurrentContainer.PopDepthTest();
	}
	
	//------------------------------------------------------------
	
	void PushMatrix(const cMatrixf&in aMtx)
	{
		if(ShouldDraw() == false)
			return;
		SetCurrentIfNeeded();
		mpCurrentContainer.PushMatrix(aMtx);
	}
	
	//------------------------------------------------------------
	
	void PopMatrix()
	{
		if(ShouldDraw() == false)
			return;
		SetCurrentIfNeeded();
		mpCurrentContainer.PopMatrix();
	}
	
	//------------------------------------------------------------	
	
	void DrawSphere(const cVector3f&in avPosition, float afRadius, const cColor&in aColor)
	{
		if(ShouldDraw() == false)
			return;
		SetCurrentIfNeeded();
		mpCurrentContainer.DrawSphere(avPosition, afRadius, aColor);
	}
	
	//------------------------------------------------------------
	
	void DrawLine(const cVector3f&in avStart, const cVector3f&in avEnd, const cColor&in aColor)
	{
		if(ShouldDraw() == false)
			return;
		SetCurrentIfNeeded();
		mpCurrentContainer.DrawLine(avStart, avEnd, aColor);
	}
	
	//------------------------------------------------------------
	
	void DrawAABB(const cVector3f&in avMin, const cVector3f&in avMax, const cColor&in aColor)
	{
		if(ShouldDraw() == false)
			return;
		SetCurrentIfNeeded();
		mpCurrentContainer.DrawAABB(avMin, avMax, aColor);
	}
	
	//------------------------------------------------------------
	
	void DrawMatrixAxis(const cMatrixf&in aMtx, float afSizeMul, float afColorMul)
	{
		if(ShouldDraw() == false)
			return;
		SetCurrentIfNeeded();
		mpCurrentContainer.DrawMatrixAxis(aMtx, afSizeMul, afColorMul);
	}
	
	//}-----------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	//{//////////////////////////////////////
	
	//------------------------------------------------------------

	void Reset()
	{
		@mpCurrentContainer = mCommandContainer;
		mCommandContainer.Reset();
		
		mvMatrixStack.resize(0);
		mvDepthTestStack.resize(0);
	
		///////////////////////////
		// Remove old lines
		for(int i = 0 ; i < mvTimers.size(); ++i)
		{
			if(mvTimers[i] == 0.f)
			{
				mvTimers.removeAt(i);
				mvTimedCommandContainers.removeAt(i);
				i--;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		if(ShouldDraw() == false)
			return;
		
		for(int i = 0 ; i < mvTimers.size(); ++i)
		{
			mvTimers[i] = cMath_IncreaseTo(mvTimers[i],afTimeStep, 0.f);
		}
	}
	
	//------------------------------------------------------------
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		if(ShouldDraw() == false)
			return;
		
		mCommandContainer.Execute(apFunctions, this);
		
		for(int i = 0; i < mvTimedCommandContainers.size(); ++i)
		{
			mvTimedCommandContainers[i].Execute(apFunctions, this);
		}
		
		if(cLux_GetGamePaused() == false)
			Reset();
	}
	
	//}-----------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool ShouldDraw()
	{
		return cLux_DebugModeOn() && cLux_ShowEntityInfoOn() && cLux_HideDebugOutputOn() == false;
	}
	
	//------------------------------------------------------------
	
	void SetCurrentIfNeeded()
	{
		if(mpCurrentContainer is null)
			@mpCurrentContainer = mCommandContainer;
	}
	
	//}-----------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	[volatile] array<cMatrixf> mvMatrixStack;
	[volatile] array<bool> mvDepthTestStack;
	
	//------------------------------------------------------------
	
	[volatile] bool mbAddingTimedCmds = false;
	
	[volatile] array<float> mvTimers;
	[volatile] array<cDebugDrawCommandContainer> mvTimedCommandContainers;
	
	//------------------------------------------------------------

	[volatile] cDebugDrawCommandContainer mCommandContainer;
	[volatile] cDebugDrawCommandContainer@ mpCurrentContainer = null;
	
	//}------------------------------------------------------------
	
}