	cVector3f mvAreaPosition;
	
	bool mbCrouch;
	bool mbCrouchCompleted;
	
	float mfTimeCount;
	float mfTimeCountAdd;
	
	cMatrixf m_mtxInvStart;

	cVector3f mvFadePosStart;
