class cScrPlayerState_CutsceneAnimation : iScrPlayerState, iScrPlayerState_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// USER SETTINGS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	
	}
	void SaveUserConfig()
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}
	
	void OnMapLeave(cLuxMap @apMap)
	{
	}
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap @apMap)
	{
	
	}
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{
		mlPreviousState = alPrevStateId;
		//Player_FadeFOVTo(mfCutsceneFOV,1.f);
		float fCutsceneFOV = 1.019819f/cLux_GetPlayer().GetDefaultFOV(); //FOV 90=1.019819f 100=1.184201f
		cLux_GetPlayer().FadeCameraFOVMulTo(ePlayerFOVMul_Cutscene, fCutsceneFOV, 2.f);
		
		Player_ShowCrossHairIcons(false, true);
	}
	
	//------------------------------------------------------------
	
	void OnLeaveState(int alNextStateId)
	{	
		cLux_GetPlayer().FadeCameraFOVMulTo(ePlayerFOVMul_Cutscene, 1.f, 1.f);
		Player_ShowCrossHairIcons(true, true);
		
		////////////////////
		// Crouching
/*		cScript_SetGlobalArgBool(0, mbCrouchOnExit);
		cScript_SetGlobalArgBool(1, true);
		cScript_SetGlobalArgBool(2, true);
		cScript_SetGlobalArgBool(3, true);
		cScript_RunGlobalFunc("MoveState_Normal","","_Global_SetCrouching");*/
		
	}
		
	//------------------------------------------------------------
	
	void Reset()
	{
		mPickBasics.Reset();
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{		
		cCamera @pCam = mBaseObj.mpPlayer.GetCamera();
		
		////////////////////////////
		// Update camera picking.
		if(msInteractCallback != "" && mPickBasics.UpdatePickCheck(pCam, true))
		{
			int lState = mPickBasics.GetFocusedEntity().GetInteractIconId(0, mPickBasics.GetFocusedBody());
			if(lState >=0 )
				Player_SetCrossHairState(eCrossHairState(lState));
			else
				Player_SetCrossHairState(eCrossHairState_Default);
		}
	}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_Setup()
	{			
		mbCrouchOnExit = cScript_GetGlobalArgBool(0);
		msInteractCallback = cScript_GetGlobalArgString(1);
		mbExitOnLastNode = cScript_GetGlobalArgBool(2);
	}
	
	//------------------------------------------------------------
	
	void _Global_LeaveState()
	{
		mBaseObj.mpPlayer.ChangeState(mlPreviousState);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnAction(int alAction, bool abPressed)
	{
		if (alAction == eAction_Crouch || alAction == eAction_Jump)
			return false;
		
		////////////////////////////
		// Physical Interaction
		if(alAction == eAction_Interact)
		{
			if(mPickBasics.GetFocusedEntity() is null) return false;
			
			//Call interact callback
			cLuxMap@ pMap = cLux_GetCurrentMap();
			if(msInteractCallback != "" && pMap.ScriptPrepare("void " + msInteractCallback + "(const tString &in asEntity)"))
			{
				tString entityName = mPickBasics.GetFocusedEntity().GetName();
				pMap.SetArgString(0, entityName);
				pMap.ScriptExecute();
			}
				
			return false;
		}
		
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		///////////////////////////////////
		// Override move
		if(alAnalogId == eAnalogType_GamepadMove)
		{
			return false;
		}
		else if (alAnalogId == eAnalogType_Move)
		{
			return false;
		}
		
		///////////////////////////////////
		// Override look
		else if(alAnalogId == eAnalogType_Look)
		{		
			float fLookSpeedMul = Player_GetLookSpeedMul();
			
			iScrPlayerBodyHandler_Interface @pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
			pBody.Cutscene_AddPitch(avAmount.y*fLookSpeedMul);
			pBody.Cutscene_AddYaw(avAmount.x*fLookSpeedMul);
			return false;
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnExitPressed()
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// SPECIFIC METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// BODY CALLBACKS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool AllowBuoyancy(iPhysicsBody @apBody)
	{
		return false;
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CHARACTER CALLBACK
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CharBody_GravityCollide(iCharacterBody@ apCharBody, iPhysicsBody@ apBody, cCollideData @apCollideData)
	{
		
	}
	
	//------------------------------------------------------------
	
	void CharBody_HitGround(iCharacterBody@ apCharBody,const cVector3f &in avVel)
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void SaveBodyProperties(iPhysicsBody @apBody)
	{
		
	}

	//-----------------------------------------------------------------------


	bool BodyIsAdded(iPhysicsBody @apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbExitOnLastNode;
	bool mbCrouchOnExit = false;
	int mlPreviousState;
	
	tString msInteractCallback;
	cUtility_PickBasics mPickBasics;
	
	//------------------------------------------------------------
		
}