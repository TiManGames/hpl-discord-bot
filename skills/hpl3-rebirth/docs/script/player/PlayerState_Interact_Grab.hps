	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void SaveBodyProperties(iPhysicsBody @apBody)
	{
		//////////////////////////////////
		// Add the body to array
		cGrabbedBodyProperties bodyData;

		bodyData.mBodyID = apBody.GetID();
		bodyData.mbHasGravity = apBody.GetGravity();
		bodyData.mbCollideCharacter = apBody.GetCollideCharacter();
		bodyData.mfMass = apBody.GetMass();
		bodyData.mfMaxLinearSpeed = apBody.GetMaxLinearSpeed();
		bodyData.mfBuoyancyDensityMul = apBody.GetBuoyancyDensityMul();

		mvBodyProperties.insertLast(bodyData);
		
		///////////////////////////////
		// Go through all joints and add any connected bodies too!
		for(int i=0; i<apBody.GetJointNum();++i)
		{
			iPhysicsJoint @pJoint = apBody.GetJoint(i);
			iPhysicsBody @pChild = pJoint.GetChildBody();
			iPhysicsBody @pParent = pJoint.GetParentBody();
			
			if(BodyIsAdded(pChild)==false)  SaveBodyProperties(pChild);
			if(BodyIsAdded(pParent)==false)  SaveBodyProperties(pParent);
		}
	}

	//-----------------------------------------------------------------------

	bool BodyIsAdded(iPhysicsBody @apBody)
	{
		if(apBody is null) return true;
	
		for(uint i=0; i<mvBodyProperties.length(); ++i)
		{
			if(cLux_ID_Body(mvBodyProperties[i].mBodyID) is apBody) return true;
		}
		return false;
	}
	
