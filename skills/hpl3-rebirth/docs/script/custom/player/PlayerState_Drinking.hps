#include "interfaces/PlayerState_Interface.hps"
#include "base/InputHandler_Types.hps"
#include "player/Player_Types.hps"
#include "custom/modules/ModuleInterfaces_Custom.hps"
#include "helpers/helper_map.hps"
#include "helpers/helper_imgui.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "custom/helpers/helper_modules_custom.hps"
#include "custom/helpers/helper_items.hps"

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

// Drink every X seconds
const float gfDrinkInterval = 1.0f;
const float gfExitPadTime = 0.5f;

//------------------------------------------------------------

class cScrPlayerState_Drinking : iScrPlayerState, iScrPlayerState_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_SetupStateFromSource()
	{
		msSourceEntity = cScript_GetGlobalArgString(0);
		msItem="";
		mfTime = 0.0f;
	}

	//------------------------------------------------------------
	
	void _Global_SetupStateFromItem()
	{
		msSourceEntity = "";
		msItem = cScript_GetGlobalArgString(0);
		mfTime = 0.0f;
	}


	//------------------------------------------------------------

	void OnAttachBodyToStickyArea()
	{
		//Do nothing!
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// USER SETTINGS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	
	}
	void SaveUserConfig()
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	
	}
	void OnMapLeave(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap @apMap)
	{
	
	}
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{
		cLux_AddDebugMessage("[DrinkingFromSource] Enter state");
		mbDrunkSomething = false;
		mbQuitRequested = false;
		mfPadExit=0.0f;
	}

	void OnLeaveState(int alNextStateId)
	{
		cLux_AddDebugMessage("[DrinkingFromSource] Leave state");
	}
		
	//------------------------------------------------------------
	
	void Reset()
	{
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		if (mfPadExit>0.0f)
		{
			mfPadExit-=afTimeStep;
			if (mfPadExit<=0.0f)
			{
				OnDrinkCompleted();
			}
			return;
		}
		
		mfTime+=afTimeStep;
		if (mfTime>gfDrinkInterval)
		{
			mfTime-=gfDrinkInterval;
			mbDrunkSomething = true;

			if (msSourceEntity!="")
			{
				iLuxEntity@ pEntity = Map_GetEntity(msSourceEntity);
				iScrLiquidSourceComponent_Interface@ pSource = UserComponent_LiquidSource_Get(pEntity);
				int lDispensed = pSource.DispenseLiquid(1);
				//Heat_Drink(pSource.GetContentSubType(), lDispensed);
				if (pSource.IsEmpty())
				{
					cLux_AddDebugMessage("[DrinkingFromSource] Source drained.");
					mfPadExit = gfExitPadTime;
				}
			}
			else
			{
				int lCount = Item_GetContentLevel(msItem);
				if (lCount==0)
				{
					mfPadExit = gfExitPadTime;
					return;
				}
		
				tString sLiquidType = Item_GetContentSubType(msItem);
				int lUnitsUsed = 0; //Heat_Drink(sLiquidType,1);
				Item_DecreaseAmount(msItem,lUnitsUsed);
				if (Item_GetContentLevel(msItem)==0)
				{
					cLux_AddDebugMessage("[DrinkingFromSource] Item drained.");
					mfPadExit = gfExitPadTime;
				}
			}

			if (mbQuitRequested)
				mfPadExit = gfExitPadTime;
		}
	}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
		
	}

	//------------------------------------------------------------

	void OnDrinkCompleted()
	{
		cLux_GetPlayer().ChangeState(ePlayerState_Normal);
	}

	//------------------------------------------------------------
	
	void OnGui(float afTimeStep)
	{
		float fStepProgress = 1.0f-mfTime/gfDrinkInterval;

		ImGui_SetTransCategory("");

		cImGuiLabelData labelData;
		labelData.mFont.SetFile("sansation_large_bold.fnt");
		labelData.mFont.mvSize = cVector2f(36, 36);
		labelData.mFontAlign = eFontAlign_Center;

		ImGui_DoLabelExt("Drinking!", labelData, ImGui_NrmPos(0.3f,0.4f,1.0f), ImGui_NrmSize(0.4f,0.2f),1.0f);

		// Temp feedback
		iScrSketchbookUIHandler_Interface @pUIHandler = cast<iScrSketchbookUIHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_SketchbookUIHandler) );
		iScrItemHandler_Interface @pItemHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
		tString sItem = pItemHandler.GetHeldItem(eItemHandlerHand_Right);
		if (sItem!="")
			pUIHandler.DrawContainerLevelGui(sItem, ImGui_NrmPos(0.5f,0.6f,1.0f),1.0f,fStepProgress);
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnAction(int alAction, bool abPressed)
	{
		if (alAction == eAction_Interact && !abPressed)
		{
			if (mbDrunkSomething)
				OnDrinkCompleted();
			mbQuitRequested = true;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnExitPressed()
	{
		return true;
	}
	
	/////////////////////////////////////////
	// BODY CALLBACKS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool AllowBuoyancy(iPhysicsBody @apBody)
	{
		return true;
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CHARACTER CALLBACK
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CharBody_GravityCollide(iCharacterBody@ apCharBody, iPhysicsBody@ apBody, cCollideData @apCollideData)
	{
		
	}
	
	//------------------------------------------------------------
	
	void CharBody_HitGround(iCharacterBody@ apCharBody,const cVector3f &in avVel)
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	tString msSourceEntity="";
	tString msItem="";
	float mfTime;
	bool mbDrunkSomething=false;
	bool mbQuitRequested=false;
	float mfPadExit=0.0f;

	//------------------------------------------------------------
		
}