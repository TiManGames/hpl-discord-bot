	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void AddPitch(float afAmount)
	{
		//TODO: Add some way of customizing min and max pitch directly in the player body
		
		iScrPlayerBodyHandler_Interface@ pPlayerBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		
		
		float fCurrPitch = pPlayerBody.Cutscene_GetPitch();
		
		float fSlowDownDist = 0.2;
		
		float fToAdd = afAmount;
		float fNewPitch = (fCurrPitch-fToAdd);
		float fMul = 1.0f;
		if (fNewPitch> gfBirthMaxPitch-fSlowDownDist && fNewPitch > fCurrPitch)
		{
			fMul = 1.0f-((fNewPitch-(gfBirthMaxPitch-fSlowDownDist))/fSlowDownDist);
		}
		else if (fNewPitch < gfBirthMinPitch+fSlowDownDist && fNewPitch < fCurrPitch)
		{
			fMul = (fNewPitch-gfBirthMinPitch)/fSlowDownDist;
		}
		fMul = cMath_Clamp(fMul, 0.f, 1.f);
		fToAdd *= fMul;
		
		pPlayerBody.Cutscene_AddPitch(fToAdd, false);
	}
	
	//------------------------------------------------------------
	
	void AddYaw(float afAmount)
	{
		iScrPlayerBodyHandler_Interface@ pPlayerBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		
		float fCurrYaw = pPlayerBody.Cutscene_GetYaw();
		float fMaxYaw = pPlayerBody.Cutscene_GetMaxYaw();
		float fSlowDownDist = 0.5;
		
		float fToAdd = afAmount;
		float fNewYaw = (fCurrYaw-fToAdd);
		float fMul = 1.0f;
		if (fNewYaw > fMaxYaw-fSlowDownDist && fNewYaw > fCurrYaw)
		{
			fMul = 1.0f-((fNewYaw-(fMaxYaw-fSlowDownDist))/fSlowDownDist);
		}
		else if (fNewYaw < -fMaxYaw+fSlowDownDist && fNewYaw < fCurrYaw)
		{
			fMul = (fNewYaw+fMaxYaw)/fSlowDownDist;
		}
		fMul = cMath_Clamp(fMul, 0.f, 1.f);
		fToAdd *= fMul;
		
		pPlayerBody.Cutscene_AddYaw(fToAdd, false);
	}
	
