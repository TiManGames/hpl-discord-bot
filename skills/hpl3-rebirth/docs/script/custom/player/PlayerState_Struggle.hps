#include "interfaces/PlayerState_Interface.hps"
#include "interfaces/PlayerState_Interface.hps"
#include "base/InputHandler_Types.hps"
#include "player/Player_Types.hps"
#include "helpers/helper_effects.hps"
#include "helpers/helper_player.hps"
#include "helpers/helper_modules_custom.hps"
#include "helpers/helper_audio.hps"
#include "custom/player/Player_Custom.hps"
#include "custom/helpers/helper_effects_custom.hps"

//------------------------------------------------------------

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

const float gfStruggleMaxRightAxisAmount = 0.045f;
const float gfStruggleTentacleSizeAdd = 2.f;
const float gfStruggleLookMul = 0.3f;
const float gfStruggleTransitionLookMul = 0.35f;
const float gfStruggleMinDot = 0.7f;
const float gfStruggleBlurAmount = 0.3f;
const float gfStruggleBlurDelay = 4.5f;
const float gfStruggleMaxCutscenePitch = 0.4f;
const float gfStruggleMaxCutsceneYaw = 0.4f;
const int glStruggleFailCountUntilEasy = 2;

const tString gsStruggleLoopSound = "player/UI/fear_system/struggle_event_loop";
const tString gsStruggleBarkBase = "player/vocalisations/ghoul_struggle/tasi_ghoul_struggle_";

const tString gsStruggleLeftArmAnimIntro = "player_beam_struggle_larm_start";
const tString gsStruggleRightArmAnimIntro = "player_beam_struggle_rarm_start";
const tString gsStruggleLeftArmAnimLoop = "player_beam_struggle_larm_reach_loop";
const tString gsStruggleRightArmAnimLoop = "player_beam_struggle_rarm_reach_loop";
const tString gsStruggleLeftArmAnimResist = "player_beam_struggle_larm_struggle_loop";
const tString gsStruggleRightArmAnimResist = "player_beam_struggle_rarm_struggle_loop";
const tString gsStruggleArmAnimOutro = "player_beam_struggle_end";

//------------------------------------------------------------

class cStruggleEvent_Data
{	
	/////////////////
	// Struggle
	float mfStruggleProgress = 0.f;
	float mfStruggle = 0.f;
	float mfResetStruggleCount = 1.5f;
	float mfDisallowStruggleCount = 0.f;	
	float mfEventDuration = 0.f;
	float mfTimePassed = 0.f;
	float mfActiveStruggleTime = 0.f;
	float mfStartDistToTar = 0.f;
	float mfPrevFear = 0.f;
	bool mbCalculateTimePassed = true;
	bool mbCanStop = true;
	bool mbEventStopped = false;
	bool mbWinnable = true;
	bool mbEndEvent = false;
	bool mbIsPermaFailStruggle = false;
	int mlStruggleFailCount = 0;
	
	/////////////////
	// Input
	float mfLookMul = gfStruggleLookMul;
	float mfLookMulGoal = gfStruggleLookMul;
	float mfLookMulFadeSpeed = 1.f;
	float mfTimeSinceRightAxisActive = 0.f;
	float mfTimeSinceLeftAxisActive = 0.f;	
	float mfMaxCutscenePitch = gfStruggleMaxCutscenePitch;
	float mfMaxCutsceneYaw = gfStruggleMaxCutsceneYaw;
	cVector2f mvLeftAxis = 0.f;
	cVector2f mvRightAxis = 0.f;
	
	/////////////////
	// Effects
	bool mbIsUnderwater = false;
	bool mbEffectsStarted = false;
	bool mbShowHint = true;
	bool mbDoBlurEffect = true;
	bool mbAllowDoubleFlash = true;
	bool mbFlashesActive = true;
	bool mbForceHint = false;
	float mfImageFlashCount = 0.f;
	float mfSnarlEffectMul = 1.f;
	float mfRumbleCount = 0.f;
	float mfLightRadius = 3.f;
	float mfIntensity = 1.f;
	float mfTentacleSizeAdd = gfStruggleTentacleSizeAdd;
	float mfTentacleLevelAdd = 0.f;
	int mlTentacleStage = 1;
	int mlBlurId = -1;
	int mlHintId = -1;
	int mlFOVShakeId = -1;
	float mfBlurDelay = 0;
	eFearTentacleMaterial mTentacleMaterial = eFearTentacleMaterial_Focus;
	float mfStruggleSoundFadeTime = 0.75f;
	float mfStruggleSoundBaseVolume = 0.75f;
	bool mbPlayStruggleLoop = true;
	
	/////////////////
	// Transition
	float mfTransition = 0.f; 
	float mfTransitionTime = 0.f; 
	float mfTransitionCount = 0.f;
	float mfMinTransitionFwdSpeed = 0.f;
	float mfMaxTransitionFwdSpeed = 0.f;
	float mfMinTransitionRightSpeed = 0.f;
	float mfMaxTransitionRightSpeed = 0.f;
	
	/////////////////
	// Camera pulls
	float mfPullCount = 0.f;
	cVector3f mvPullAdd = 0.f;
	
	/////////////////
	// Barks
	float mfStruggleBarkCount = 0.f;
	float mfStruggleBarkParam = 0.f;
	tString msCurrentStruggleBark = "";
	array<int> mvStruggleBarkIds(0);
	
	/////////////////
	// Animation
	bool mbAnimLoop = true;
	bool mbReverseAnimWhenStruggling = true;
	float mfAnimAngle = 0.f;
	float mfAnimFadeTime = 0.3f;
	float mfStruggleAnimWeight = 0.f;
	tString msAnimOutroCallback = "";
	tString msAnim = "";
	tString msAnimIntro = "";
	tString msAnimOutro = "";
	tString msAnimStruggle = "";
	tString msEntAnim = "";
	tString msEntAnimIntro = ""; 
	tString msEntAnimOutro = ""; 
	tString msEntAnimStruggle = "";
	tString msLeftArmAnimIntro = "";
	tString msRightArmAnimIntro = "";
	tString msLeftArmAnimLoop = "";
	tString msRightArmAnimLoop = "";
	tString msArmAnimOutro = gsStruggleArmAnimOutro;
	cVector3f mvAnimPos = 0.f;
	
	/////////////////
	// Callbacks
	tString msSuccessCallback = "";
	tString msFailCallback = "";
	
	/////////////////
	// Targets
	tID m_idTar = tID_Invalid;
	tID m_idLookTar = tID_Invalid;
	tID m_idLight = tID_Invalid;
	tID m_idAnimEnt = tID_Invalid;
	
	////////////////
	// Easy struggle
	bool mbEasyStruggleMode = false;
	bool mbForcedEasyStruggle = false;
}

//------------------------------------------------------------

class cStruggleEvent
{	
	//-------------------------------------------------
	
	void Enter()
	{		
		mpData.mfStruggleProgress = 0.f;
		mpData.mfResetStruggleCount = GetResetStruggleCount();
		mpData.mfPullCount = 0.f;
		mpData.mfDisallowStruggleCount = mpData.mfTransitionTime;
		
		mpData.mfLookMul = gfStruggleLookMul;
		mpData.mfLookMulGoal = gfStruggleLookMul;
		mpData.mfLookMulFadeSpeed = 1.f;
		mpData.mfMaxCutscenePitch = gfStruggleMaxCutscenePitch;
		mpData.mfMaxCutsceneYaw = gfStruggleMaxCutsceneYaw;
				
		mpData.mfTimePassed = 0.f;
		mpData.mfStartDistToTar = -1.f;
		mpData.mfRumbleCount = 0.f;
		mpData.mfPrevFear = FearHandler_GetLevel();
		mpData.mfTentacleSizeAdd = gfStruggleTentacleSizeAdd;
		mpData.mfTentacleLevelAdd = 0;
		mpData.mlTentacleStage = 1;
		mpData.mfActiveStruggleTime = mpData.mfEventDuration;
		
		mpData.mfImageFlashCount = cMath_RandRectf(0.3f, mpData.mfTransitionTime);
		
		mpData.mfTransitionCount = mpData.mfTransitionTime;
		mpData.mfMaxTransitionFwdSpeed = 0.8f;
		mpData.mfMaxTransitionRightSpeed = 0.25f;
		mpData.mfMinTransitionFwdSpeed = 0;
		mpData.mfMinTransitionRightSpeed = 0;
		
		mpData.mbEffectsStarted = false;
		mpData.mbDoBlurEffect = true;
		mpData.mbAllowDoubleFlash = true;
		mpData.mfSnarlEffectMul = 1.f;
		mpData.mfStruggleAnimWeight = 0.f;
		mpData.mTentacleMaterial = eFearTentacleMaterial_Focus;
		mpData.mbIsUnderwater = Player_GetUnderwater();
		mpData.mfBlurDelay = gfStruggleBlurDelay;
		
		mpData.mbEventStopped = false;
		mpData.mbEndEvent = false;
		
		mpData.mbReverseAnimWhenStruggling = true;
		mbPlayHandsAnim = false;		
		mlHandsAnimStage = -1;
		mbPlayLeftHandAnim = true;
		mbPlayRightHandAnim = true;
		mpData.msArmAnimOutro = gsStruggleArmAnimOutro;
		
		mpData.mvLeftAxis = cVector2f(0.f);
		mpData.mvRightAxis = cVector2f(0.f);
		mpData.mvPullAdd = cVector3f(0.f);
		
		mpData.mfStruggleBarkCount = 0.f;
		mpData.mfStruggleBarkParam = 0.f;
		mpData.msCurrentStruggleBark = "";
		
		mpData.mbEasyStruggleMode = false;
		mfEasyStruggleThreshold = 0;
		
		GenerateQuadAdds();
	}
	
	//-----------------------------------------------------------
	
	void Leave() 
	{			
		mpData.m_idTar = tID_Invalid;
		mpData.m_idLookTar = tID_Invalid;
		
		iLight@ pLight = cLux_ID_Light(mpData.m_idLight);
		if (pLight !is null)
			pLight.FadeTo(cColor(0.f), 0.f, 1.f);
			
		mpData.m_idLight = tID_Invalid;
		mpData.m_idAnimEnt = tID_Invalid;
		
		mpData.msAnim = "";
		mpData.msAnimIntro = "";
		mpData.msAnimOutro = "";
		mpData.msAnimStruggle = "";
		
		mpData.msEntAnim = "";
		mpData.msEntAnimIntro = "";
		mpData.msEntAnimOutro = "";
		mpData.msEntAnimStruggle = "";
		
		mpData.mbShowHint = true;
		mpData.mbCanStop = true;
		mpData.mbIsUnderwater = false;
		mpData.mbForceHint = false;
		
		if (mbPlayHandsAnim)
		{
			iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
			pBody.StopAnimation(gsStruggleLeftArmAnimIntro, 0.f);
			pBody.StopAnimation(gsStruggleLeftArmAnimLoop, 0.f);
			pBody.StopAnimation(gsStruggleLeftArmAnimResist, 0.f);
			pBody.StopAnimation(gsStruggleRightArmAnimIntro, 0.f);			
			pBody.StopAnimation(gsStruggleRightArmAnimLoop, 0.f);			
			pBody.StopAnimation(gsStruggleRightArmAnimResist, 0.f);
			
			pBody.SetArmAnimationPitch(false, mbPlayRightHandAnim, mbPlayLeftHandAnim);
			pBody.SetArmAnimationYaw(false, mbPlayRightHandAnim, mbPlayLeftHandAnim);
		}
		
		mbPlayHandsOutroAnim = true;
	}
	
	//-----------------------------------------------------------
	
	void Stop(bool abWin)
	{
		mpData.mfStruggleProgress = abWin ? 1.f : -1.f;
		mpData.mbEventStopped = true;
		mpData.mbEndEvent = true;
		
		mpData.mbFlashesActive = true;
		mpData.mbCalculateTimePassed = true;
		
		///////////////////////////
		// Stop effects
		Effect_FearTentacles_FadeMinVignette(0.f, 2.f);
		Effect_FearTentacles_FadeMaterial(eFearTentacleMaterial_Default, 0.5f);
		
		FearHandler_SetStruggleGradingTextureActive(false);
		
		Sound_Stop("Sound_StruggleLoop", 1.f);
		Sound_StopGui(mpData.msCurrentStruggleBark, 0.f);
		
		if (mpData.mbShowHint)
			Hint_StopHint();
	}
	
	//-----------------------------------------------------------
	
	bool StartEffects()
	{
		///////////////////////////
		// Start effects
		if (mpData.mbEffectsStarted == false)
		{
			mpData.mbEffectsStarted = true;
			
			Effect_FearTentacles_FadeMinVignette(1.f, 1.f); // Make sure the tentacles are visible even if it's very dark
			Effect_FearTentacles_FadeMaterial(mpData.mTentacleMaterial, 0.5f);
				
			mpData.mlFOVShakeId = Effect_FOV_Shake_Start(0.04, -1, 0.5, 0, 0, true, 0.375);
				
			Sound_CreateAtEntity("Sound_StruggleLoop", gsStruggleLoopSound, "player", 1.f, true);
			
			if (mpData.mbPlayStruggleLoop)
				FearHandler_PlayStruggleSoundLoop(mpData.mfStruggleSoundFadeTime, mpData.mfStruggleSoundBaseVolume, false);
			
			//if (mpData.mbIsPermaFailStruggle)
			//	Sound_FadeInGui("player/UI/permafail/hands_loop", 1.f, mpData.mfTransitionTime);		
			
			if (mpData.mbShowHint)
			{
				Hint_StopHint();
				if (mpData.mbForceHint)
				{
					iScrHintHandler_Interface@ pHintHandler = cast<iScrHintHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_HintHandler));
					pHintHandler.ForceEnabled(true);
				}
				mpData.mlHintId = Hint_ShowHint_Hold("Hints", GetHint(), true, mpData.mbForceHint ? 9999.0f : 1.5f, false);
			}
		}
		
		if (mpData.mfBlurDelay <= 0) return true; //Return early so the below code is only run once per struggle
		
		mpData.mfBlurDelay -= cEngine_GetFrameTime();
		if (mpData.mfBlurDelay <= 0)
		{
			FearHandler_SetStruggleGradingTextureActive(true);
			
			if (mpData.mbDoBlurEffect && mpData.mlBlurId < 0)
				mpData.mlBlurId = Effect_Blur_Start(gfStruggleBlurAmount, mpData.mfTransitionTime);
		}
		
		return true;
	}
	
	//-----------------------------------------------------------
	
	float UpdateRightAxisResistanceMul()
	{
		if (mpData.mfStruggle <= 0.6)			return 4.f;
		else if (mpData.mfStruggle <= 0.7f) 	return 2.f;
		else if (mpData.mfStruggle <= 0.9f)		return 1.f;
		else if (mpData.mfStruggle <= 1.4f)		return 0.5f;
		else									return 0.f;
	}
	
	//------------------------------------------------------------
	
	float UpdateEffectShakeMul()
	{ 
		return cMath_Clamp(cMath_Easing(eEasing_QuadIn, mpData.mfStruggle) * 2.f, 0.3f, 2.f);
	}
	
	//------------------------------------------------------------
	
	float GetEffectMul()
	{		
		float fMul = 1.f - cMath_Easing(eEasing_QuadOut, cMath_Max(mpData.mfStruggle - 0.4f, 0.f) / 0.6f);
		if (mpData.mfDisallowStruggleCount > 0.f)
			fMul = 1.f;

		return fMul;
	}
	
	//-----------------------------------------------------------
	
	float GetMinTentacleAmount()
	{
		int lStageCount = cMath_Max(cMath_CeilToInt(mpData.mfActiveStruggleTime / 4.f), 1);
		int lCurrentStage = cMath_Min(mpData.mlTentacleStage, lStageCount);
		return cMath_Easing(eEasing_QuadIn, 1.f - (float(lCurrentStage) / float(lStageCount)));
	}
	
	//-----------------------------------------------------------
	
	float GetMaxTentacleAmount()
	{
		float fAmount = 1.f;
		
		if (mpData.mlTentacleStage > 1)
		{
			int lStageCount = cMath_Max(cMath_CeilToInt(mpData.mfActiveStruggleTime / 4.f), 1);
			fAmount = GetMinTentacleAmount() + (1.f / float(lStageCount) * 1.33f);
		}
		
		return fAmount;
	}
	
	//-----------------------------------------------------------
	
	void UpdateFlashes(float afTimeStep)
	{
		float fFlashTimeMul = (1.f - mpData.mfStruggle);		
		mpData.mfImageFlashCount -= afTimeStep * fFlashTimeMul;
			
		if (mpData.mfImageFlashCount <= 0.f)
		{
			StruggleFlashHandler_DoFlash(0.1f);
				
			float fDelay = 0.f;
			if (cMath_RandRectl(0, 1) == 0 && mpData.mbAllowDoubleFlash)
			{
				fDelay = cMath_RandRectf(0.5f, 0.8f);
				StruggleFlashHandler_DoFlash(0.1f, fDelay);
			}
			
			mpData.mbAllowDoubleFlash = fDelay <= 0.f;
				
			float fFlashTimeMul = mpData.mfTimePassed / (mpData.mfEventDuration + mpData.mfTransitionTime);
			fFlashTimeMul = 1.f - cMath_Easing(eEasing_CubicIn, cMath_Clamp(fFlashTimeMul, 0.f, 1.f)) * 0.25f;
			mpData.mfImageFlashCount = cMath_Max(cMath_RandRectf(1.5f + fDelay, 3.5f) * fFlashTimeMul, 1.f);
		}
	}
	
	//-----------------------------------------------------------
	
	cVector3f GetLookTargetPos()
	{		
		tID idTar = mpData.m_idLookTar != tID_Invalid ? mpData.m_idLookTar : mpData.m_idTar;
		return cLux_ID_Entity(idTar).GetPosition();
	}
	
	//------------------------------------------------------------
	
	cVector3f UpdateRightAxis(cVector3f avAmount)
	{			
		mpData.mvRightAxis = cVector2f(avAmount.x, -avAmount.y);
		mpData.mfTimeSinceRightAxisActive = 0.f;
		return avAmount;
	}
	
	//------------------------------------------------------------
	
	cVector3f UpdateLeftAxis(cVector3f avAmount)
	{			
		mpData.mvLeftAxis = cVector2f(avAmount.x, avAmount.y);
		mpData.mfTimeSinceLeftAxisActive = 0.f;
		return cVector3f(0.f);
	}
	
	//------------------------------------------------------------
	
	float GetLeftAxisStruggle()
	{
		return cMath_Clamp(mpData.mvLeftAxis.Length() / gfStruggleMaxRightAxisAmount, 0.f, 1.f);
	}
		
	//------------------------------------------------------------
	
	float GetRightAxisStruggle()
	{
		return cMath_Clamp(mpData.mvRightAxis.Length() / gfStruggleMaxRightAxisAmount, 0.f, 1.f);
	}
	
	//------------------------------------------------------------
	
	void DoSnarlEffect(float afEffectMul = 1.f)
	{
		Effect_Shake_Start(0.1f * afEffectMul, 0.5f * afEffectMul, 0.f, 0.2f * afEffectMul);  
		Effect_ImageTrail_Start(1.5f * afEffectMul, 0.f, 0.3f * afEffectMul, 0.4f * afEffectMul);
		
		StruggleFlashHandler_Clear();		
		mpData.mfImageFlashCount = cMath_RandRectf(0.1f, 0.3f);
	}
	
	//------------------------------------------------------------
	
	float UpdateStruggle(float afTimeStep)
	{		
		/////////////////////
		// Get axis values		
		float fLeftAxisStruggle = GetLeftAxisStruggle();
		float fRightAxisStruggle = GetRightAxisStruggle();
		
		cVector2f vNrmRightAxisDir = cMath_Vector2Normalize(mpData.mvRightAxis);
		
		bool bUsingGamepad = cLux_GetInputHandler().GetGamepadWasLastDeviceUsed();
		float fStruggleRateMul = bUsingGamepad ? 1.4f : 1.75f;
		
		/////////////////////
		// Calculate axis quad adds
		const float fLeftAxisStruggleMul = 0.25f;
		float fLeftRateAdd = fLeftAxisStruggle * fLeftAxisStruggleMul;
		
		float fRightRateAdd = 0.f;		
		float fCurrRightAngle = cMath_Pi - cMath_ATan2(vNrmRightAxisDir.y, vNrmRightAxisDir.x);
			
		if 	(fCurrRightAngle <= cMath_Pi * 0.5f)		fRightRateAdd = mfQuadAdds[0];
		else if (fCurrRightAngle <= cMath_Pi * 1.f) 	fRightRateAdd = mfQuadAdds[1];
		else if (fCurrRightAngle <= cMath_Pi * 1.5f)	fRightRateAdd = mfQuadAdds[2];
		else if (fCurrRightAngle <= cMath_Pi * 2.f)		fRightRateAdd = mfQuadAdds[3];
		
		fRightRateAdd *= fRightAxisStruggle;
		
		////////////////
		// Easy Struggle
		mpData.mbEasyStruggleMode = (mpData.mlStruggleFailCount >= glStruggleFailCountUntilEasy) || mpData.mbForcedEasyStruggle;
		
		bool bNotStruggling = mpData.mbEasyStruggleMode ? 
							(fLeftAxisStruggle <= 0.f && fRightAxisStruggle <= 0.f) : 
							(mpData.mfDisallowStruggleCount > 0.f || fLeftAxisStruggle <= 0.f || fRightAxisStruggle <= 0.f);
		
		if(bNotStruggling==false)
			mfEasyStruggleThreshold += afTimeStep;
			
		mbEasyStruggle = mpData.mbEasyStruggleMode ? mfEasyStruggleThreshold > 1 : false;
		
		//////////////////
		// Calculate rate
		float fStruggleRate = mbEasyStruggle ? 1.f : (fRightRateAdd * fStruggleRateMul) + fLeftRateAdd;
		if (bNotStruggling && mbEasyStruggle==false)
			fStruggleRate = 0.f;
		
		/////////////////
		// Reset struggling with a pull after a while
		if (fStruggleRate > 0.6f)
		{
			mpData.mfResetStruggleCount -= afTimeStep;
			if (mpData.mfResetStruggleCount <= 0.f)
			{
				++mpData.mlTentacleStage;
				
				mpData.mfDisallowStruggleCount = GetStrugglePauseAfterPull();
				mpData.mfResetStruggleCount = GetResetStruggleCount();
				
				GenerateQuadAdds();				
				DoSnarlEffect(mpData.mfSnarlEffectMul);
			}
		}
						
		/////////////////////
		// Calculate progress
		if (mpData.mbEventStopped == false && mpData.mbWinnable)
		{	
			// Takes longer to win if the event is longer
			float fProgressRate = 1.f / (mpData.mfEventDuration * 0.5f) + (1.f - mpData.mfIntensity);			
			mpData.mfStruggleProgress += fProgressRate * fStruggleRate * afTimeStep;
			
			// Make sure that the player wins in easy mode
			if (mbEasyStruggle && mpData.mfTimePassed >= mpData.mfEventDuration * 0.83) mpData.mfStruggleProgress = 1;
		}
		
		//Debug
		/*cLux_AddDebugMessage("mfEasyStruggleThreshold: " + mfEasyStruggleThreshold);
		cLux_AddDebugMessage("fStruggleRate: " + fStruggleRate);
		cLux_AddDebugMessage("mfStruggleProgress: " + mpData.mfStruggleProgress);
		cLux_AddDebugMessage("mbEasyStruggle: " + mbEasyStruggle);
		cLux_AddDebugMessage("mbEasyStruggleMode: " + mpData.mbEasyStruggleMode);*/
		
		return cMath_Clamp(fStruggleRate, 0.f, 1.f);
	}
	
	//------------------------------------------------------------
	
	float GetStrugglePauseAfterPull()
	{
		return 1.f;
	}
	
	//------------------------------------------------------------
	
	float GetResetStruggleCount()
	{
		return 1.5f * cMath_Clamp(mpData.mfEventDuration / 8.f, 0.5f, 1.f);
	}
	
	//------------------------------------------------------------
	
	void GenerateQuadAdds()
	{
		array<float> vAdds = {0.9f, 1.f, 1.1f, 1.2f};
		
		for (int i = 0; i < 4; i++)
		{
			int lId = cMath_RandRectl(0, vAdds.length() - 1);	
			mfQuadAdds[i] = vAdds[lId];
			vAdds.removeAt(lId);
		}
	}
	
	//------------------------------------------------------------
	
	float GetPullAddMul() { return 0.5f; }
	
	//------------------------------------------------------------
	
	void UpdateAnimation(float afTimeStep) 
	{
		if (mbPlayHandsAnim == false)
			return;
		
		//////////////////
		// Setup vars
		cCamera@ pCam = cLux_GetPlayer().GetCamera();
		iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		
		//////////////////
		// Setup stage
		if (mlHandsAnimStage == -1 && mpData.mfTimePassed > 0.f)
		{
			cVector3f vLookDir = cMath_Vector3Normalize(GetLookTargetPos() - pCam.GetPosition());
			bool bTurnedTowardTarget = cMath_Vector3Dot(pCam.GetForward(), vLookDir) > 0.6f;
			
			if (bTurnedTowardTarget)
				mlHandsAnimStage = 0;
		}
		
		if (mlHandsAnimStage > -1 && mlHandsAnimStage < 3 && mpData.mbEventStopped)
			mlHandsAnimStage = 3;
		
		//////////////////
		// Intro
		if (mlHandsAnimStage == 0)
		{
			if (mbPlayLeftHandAnim)
				pBody.PlayAnimationInLayer(gsStruggleLeftArmAnimIntro, ePlayerBodyAnimationLayer_LeftArm, false, false, false, 0.3f, 1.f, 0.f);
			if (mbPlayRightHandAnim)
				pBody.PlayAnimationInLayer(gsStruggleRightArmAnimIntro, ePlayerBodyAnimationLayer_RightArm, false, false, false, 0.3f, 1.f, 0.f);	
			
			pBody.SetArmAnimationYaw(true, mbPlayRightHandAnim, mbPlayLeftHandAnim);
			pBody.SetArmAnimationPitch(true, mbPlayRightHandAnim, mbPlayLeftHandAnim);
			
			mlHandsAnimStage = 1;
		}
		
		//////////////////
		// Loop
		else if (mlHandsAnimStage == 1)
		{
			bool bNextStage = false;
			
			cAnimationState@ pIntroL = pBody.GetAnimationState(gsStruggleLeftArmAnimIntro);
			cAnimationState@ pIntroR = pBody.GetAnimationState(gsStruggleRightArmAnimIntro);

			if (mbPlayLeftHandAnim && pIntroL.IsOver())
			{
				pBody.PlayAnimationInLayer(gsStruggleLeftArmAnimLoop, ePlayerBodyAnimationLayer_LeftArm, true, false, true, 0.f, 1.f, 0.f);
				pBody.PlayAdditativeAnimation(gsStruggleLeftArmAnimResist, true, 0.f, 1.f, 0.f);
				
				cAnimationState@ pStruggleL = pBody.GetAnimationState(gsStruggleLeftArmAnimResist);
				pStruggleL.SetWeight(0.f);
				
				bNextStage = true;
			}
	
			if (mbPlayRightHandAnim && pIntroR.IsOver())
			{
				pBody.PlayAnimationInLayer(gsStruggleRightArmAnimLoop, ePlayerBodyAnimationLayer_RightArm, true, false, true, 0.f, 1.f, 0.f);
				pBody.PlayAdditativeAnimation(gsStruggleRightArmAnimResist, true, 0.f, 1.f, 0.f);
				
				cAnimationState@ pStruggleR = pBody.GetAnimationState(gsStruggleRightArmAnimResist);
				pStruggleR.SetWeight(0.f);
				
				bNextStage = true;
			}
			
			if (bNextStage)
				mlHandsAnimStage = 2;
		}
		
		//////////////////
		// Loop/Struggle
		else if (mlHandsAnimStage == 2)
		{			
			mpData.mfStruggleAnimWeight = cMath_IncreaseTo(mpData.mfStruggleAnimWeight, afTimeStep, mpData.mfStruggle);
			
			if (mbPlayLeftHandAnim)
			{
				cAnimationState@ pLoopL = pBody.GetAnimationState(gsStruggleLeftArmAnimLoop);
				cAnimationState@ pStruggleL = pBody.GetAnimationState(gsStruggleLeftArmAnimResist);
				
				pLoopL.SetWeight(1.f - mpData.mfStruggleAnimWeight);
				pStruggleL.SetWeight(mpData.mfStruggleAnimWeight);	
			}
			
			if (mbPlayRightHandAnim)
			{
				cAnimationState@ pLoopR = pBody.GetAnimationState(gsStruggleRightArmAnimLoop);			
				cAnimationState@ pStruggleR = pBody.GetAnimationState(gsStruggleRightArmAnimResist);
				
				pLoopR.SetWeight(1.f - mpData.mfStruggleAnimWeight);			
				pStruggleR.SetWeight(mpData.mfStruggleAnimWeight);
			}			
		}
		
		//////////////////
		// Outro
		else if (mlHandsAnimStage == 3)
		{
			bool bPlayOutro = mpData.mfTransition >= 1.f && ShouldPlayOutroAnim();
			float fAnimStopTime = bPlayOutro ? 0.f : 0.3f;
			
			if (mbPlayLeftHandAnim)
			{
				pBody.StopAnimation(gsStruggleLeftArmAnimLoop, fAnimStopTime);
				pBody.StopAnimation(gsStruggleLeftArmAnimResist, fAnimStopTime);
			}
			if (mbPlayRightHandAnim)
			{
				pBody.StopAnimation(gsStruggleRightArmAnimLoop, fAnimStopTime);
				pBody.StopAnimation(gsStruggleRightArmAnimResist, fAnimStopTime);
			}

			if (bPlayOutro)
			{
				pBody.StartCustomAnimation(mpData.msArmAnimOutro, false, 0.f, false);
				mlHandsAnimStage = 4;
			}
			else
			{
				// hack to restart idle animations
				pBody.StartCustomAnimation("", false, 0);
				pBody.StopCustomAnimation("");	
	
				cLux_GetPlayer().ChangeState(ePlayerState_Normal);
				mlHandsAnimStage = -1;
			}	
		}
		
		//////////////////
		// End
		else if (mlHandsAnimStage == 4)
		{
			cAnimationState@ pOutro = pBody.GetAnimationState(mpData.msArmAnimOutro);
			
			if (pOutro.IsOver())
			{
				pBody.StopCustomAnimation(mpData.msArmAnimOutro);
				cLux_GetPlayer().ChangeState(ePlayerState_Normal);
				
				mlHandsAnimStage = -1;
				
				//////////////////
				// Map callback
				tString sMethodName = "void OnStruggleAnimEnd()";
				cLuxMap@ pMap = cLux_GetCurrentMap();
				if (pMap.ScriptMethodExists(sMethodName) && pMap.ScriptPrepare(sMethodName))
					pMap.ScriptExecute();
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool ShouldPlayOutroAnim() 
	{
		bool bRet = false;
		
		if (mbPlayHandsOutroAnim)
			bRet = mlHandsAnimStage > -1 && FearHandler_GetIsPermaFailing() == false;
			
		return bRet;
	}
	
	//------------------------------------------------------------
	
	bool ShouldResetArmMaterial() { return true; }
	bool ShouldStopStruggleLoopSound() 
	{
		if (mpData.mbIsPermaFailStruggle)
			return mpData.mfStruggleProgress > -1.0f;
		
		return true;
	}
	void UpdateMovement(float afTimeStep) {}
	float UpdateMovementSpeed() { return 0.f; }	
	void UpdateSound(float afTimeStep) {}
	const tString GetHint() {return "HintStruggle";}
		
	//------------------------------------------------------------
	
	int mlHandsAnimStage = -1;
	bool mbPlayHandsAnim = false;
	bool mbPlayHandsOutroAnim = true;
	bool mbPlayLeftHandAnim = true;
	bool mbPlayRightHandAnim = true;
	
	float[] mfQuadAdds = { 0.f, 0.f, 0.f, 0.f };
	[volatile] cStruggleEvent_Data@ mpData = null;
	
	float mfEasyStruggleThreshold = 0;
	bool mbEasyStruggle = false;
	
	//------------------------------------------------------------
}

//------------------------------------------------------------

/////////////////////////////////////////
// MOVE TOWARD
/////////////////////////////////////////

//------------------------------------------------------------

class cStruggleEvent_MoveToward : cStruggleEvent
{	
	//------------------------------------------------------------
	
	void Setup(const tString &in asTar, const tString &in asLookTar, const tString &in asLight, const tString &in asSuccessCallback, 
			   const tString &in asFailCallback, float afDuration, bool abWinnable, float afTransitionTime, float afMoveSpeed, float afIntensity, bool abShowHint, float afSoundFadeTime)
	{
		iLuxEntity@ pTar = cLux_GetCurrentMap().GetEntityByName(asTar);
		mpData.m_idTar = pTar.GetID();
			
		iLuxEntity@ pLookTar = cLux_GetCurrentMap().GetEntityByName(asLookTar);
		if (pLookTar !is null) 
			mpData.m_idLookTar = pLookTar.GetID();
		
		iLight@ pLight = cLux_GetCurrentMap().GetWorld().GetLight(asLight);
		if (pLight !is null)
		{
			mpData.m_idLight = pLight.GetID();
			mpData.mfLightRadius = pLight.GetRadius();
		}
		
		mpData.msSuccessCallback = asSuccessCallback;
		mpData.msFailCallback = asFailCallback;
		mpData.mfEventDuration = afDuration;
		mpData.mbWinnable = abWinnable;
		mpData.mfTransitionTime = cMath_Max(afTransitionTime, 0.001f);
		mpData.mfIntensity = afIntensity;
		mpData.mbShowHint = abShowHint;
		mpData.mfStruggleSoundFadeTime = afSoundFadeTime;
		
		mfMoveSpeed = afMoveSpeed;
	}
	
	//------------------------------------------------------------
	
	float UpdateMovementSpeed() override
	{
		if (mfMoveSpeed == -1.f)
			return mpData.mfStartDistToTar / mpData.mfEventDuration;
		else return mfMoveSpeed * mpData.mfTransition;
	}
		
	//------------------------------------------------------------
	
	void UpdateMovement(float afTimeStep) override
	{
		iLuxEntity@ pTar = cLux_ID_Entity(mpData.m_idTar);
		
		// If collide with tar, lose
		if (cLux_GetCurrentMap().GetPlayerEntity().CheckEntityCollision(pTar) == false)
			return;
		
		Stop(false);
	}
	
	//------------------------------------------------------------
	
	float mfMoveSpeed = 0.f;
	
	//------------------------------------------------------------
}

//------------------------------------------------------------

/////////////////////////////////////////
// ANIMATION
/////////////////////////////////////////

//------------------------------------------------------------

class cStruggleEvent_Animation : cStruggleEvent
{
	//------------------------------------------------------------
	
	void Setup(const tString &in asStandTar, const tString &in asAnim, const tString &in asAnimStruggle,
			   const tString &in asAnimIntro, const tString &in asAnimOutro, bool abLoop, const tString &in asLight, 
			   const tString &in asSuccessCallback, const tString &in asFailCallback, const tString &in asAnimOutroCallback,
			   float afDuration, bool abWinnable, float afTransitionTime, float afIntensity, bool abShowHint, float afFadeTime, 
			   bool abPlayStruggleLoop, bool abForceHint = false)
	{
		/////////////////////////
		// Setup dummy target
		cLuxMap@ pMap = cLux_GetCurrentMap();		
		if (asStandTar == "")
		{
			pMap.CreateEntity("Struggle_DummyTar", "block_box.ent", cMatrixf_Identity, cVector3f_One);
		
			iLuxEntity@ pDummyTar = pMap.GetLatestEntity();		
			pDummyTar.SetActive(false);
			pDummyTar.GetMeshEntity().SetVisible(false);
			pDummyTar.SetMatrix(Player_GetMatrix());
			
			m_idDummyTar = pDummyTar.GetID();
		}		
		
		/////////////////////////
		// Setup event
		iLuxEntity@ pTar = pMap.GetEntityByName(asStandTar);
		mpData.m_idTar = pTar !is null ? pTar.GetID() : m_idDummyTar;	
		mpData.m_idLookTar = tID_Invalid;
		
		iLight@ pLight = pMap.GetWorld().GetLight(asLight);
		if (pLight !is null)
		{
			mpData.m_idLight = pLight.GetID();
			mpData.mfLightRadius = pLight.GetRadius();
		}
		
		mpData.msAnim = asAnim;
		mpData.msAnimIntro = asAnimIntro;
		mpData.msAnimOutro = asAnimOutro;
		mpData.msAnimStruggle = asAnimStruggle;
		mpData.mbAnimLoop = abLoop;
		mpData.mfAnimFadeTime = afFadeTime;
		mpData.msSuccessCallback = asSuccessCallback;
		mpData.msFailCallback = asFailCallback;
		mpData.msAnimOutroCallback = asAnimOutroCallback;
		mpData.mfEventDuration = afDuration;
		mpData.mbWinnable = abWinnable;
		mpData.mfTransitionTime = cMath_Max(afTransitionTime, 0.001f);
		mpData.mfIntensity = afIntensity;
		mpData.mbShowHint = abShowHint;
		mpData.mbPlayStruggleLoop = abPlayStruggleLoop;
		mpData.mbForceHint = abForceHint;
	}
	
	//------------------------------------------------------------
	
	void Enter() override
	{
		//////////////////////
		// Setup state
		cStruggleEvent::Enter();
				
		mpData.mfLookMul = 0.35f;
		mpData.mfLookMulGoal = mpData.mfLookMul;	
		mpData.mfSnarlEffectMul = 0.2f;
		mpData.mbCanStop = mpData.mbAnimLoop;
		
		mlAnimStage = 0;
	}
	
	//------------------------------------------------------------
	
	void Leave() override
	{
		/////////////////////////
		// Stop animations
		iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		pBody.StopAnimation(mpData.msAnim, 0.f);
		pBody.StopAnimation(mpData.msAnimStruggle, 0.f);
		pBody.StopCustomAnimation();
		
		/////////////////////////
		// Destroy dummy
		if (m_idDummyTar != tID_Invalid)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idDummyTar);
			if (pEnt !is null)
				cLux_GetCurrentMap().DestroyEntity(pEnt);
	
			m_idDummyTar = tID_Invalid;
		}
		
		cStruggleEvent::Leave();
	}
	
	//------------------------------------------------------------
	
	bool StartEffects()
	{
		if (GetIntroActive())
			return false;
		
		cStruggleEvent::StartEffects();
		return true;
	}
	
	//------------------------------------------------------------
	
	float UpdateEffectShakeMul()
	{ 
		return cMath_Clamp(cMath_Easing(eEasing_QuadIn, mpData.mfStruggle) * 2.f, 0.3f, 2.f);
	}
	
	//------------------------------------------------------------
	
	float GetStrugglePauseAfterPull()
	{
		return 1.5f;
	}
	
	//------------------------------------------------------------
	
	void UpdateAnimation(float afTimeStep) override
	{								
		//////////////////
		// Setup vars
		iLuxEntity@ pAnimEnt = cLux_ID_Entity(mpData.m_idAnimEnt);
		iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		
		//////////////////
		// Setup stage		
		if (mlAnimStage > -1 && mlAnimStage < 3 && mpData.mbEventStopped)
			mlAnimStage = 3;
		
		//////////////////
		// Intro
		if (mlAnimStage == 0)
		{
			//////////////////
			// Setup position/angle
			iLuxEntity@ pTarget = cLux_ID_Entity(mpData.m_idTar);			
			mpData.mvAnimPos = pTarget.GetPosition();
			mpData.mfAnimAngle = cMath_GetAngleFromPoints3D(0.f, pTarget.GetMatrix().GetTranspose().GetForward()).y;
			
			//////////////////
			// Play intro
			pBody.StartCustomAnimation("", false, mpData.mfAnimFadeTime, true, mpData.mvAnimPos, mpData.mfAnimAngle);
			
			cAnimationState@ pIntro = pBody.GetAnimationState(mpData.msAnimIntro);		
			if (pIntro !is null)
			{			
				pBody.PlayAnimationInLayer(mpData.msAnimIntro, ePlayerBodyAnimationLayer_FullBody, false, false, false, mpData.mfAnimFadeTime, 1.f, 0.f);
							
				if (pAnimEnt !is null)
					pAnimEnt.PlayAnimation(mpData.msEntAnimIntro, mpData.mfAnimFadeTime, false);		
			}
			
			mlAnimStage = 1;
		}
		
		//////////////////
		// Start loop
		else if (mlAnimStage == 1)
		{
			//////////////////
			// Setup states
			cAnimationState@ pIntro = pBody.GetAnimationState(mpData.msAnimIntro);
			cAnimationState@ pStruggle = pBody.GetAnimationState(mpData.msAnimStruggle);
			cAnimationState@ pEntStruggle = pAnimEnt !is null ? pAnimEnt.GetMeshEntity().GetAnimationStateFromName(mpData.msEntAnimStruggle) : null;
			
			if (pIntro is null || pIntro.IsOver())
			{
				//////////////////
				// Player anims
				float fFadeTime = pIntro is null ? 0.3f : 0.f;
				pBody.PlayAnimationInLayer(mpData.msAnim, ePlayerBodyAnimationLayer_FullBody, mpData.mbAnimLoop, false, false, fFadeTime, 1.f, 0.f);
				
				if (pStruggle !is null)
				{
					pBody.PlayAdditativeAnimation(mpData.msAnimStruggle, mpData.mbAnimLoop, 0.f, 1.f, 0.f);
					pStruggle.SetWeight(0.f);
				}				
				
				//////////////////
				// Ent anims
				if (pAnimEnt !is null)
				{
					pAnimEnt.PlayAnimation(mpData.msEntAnim, fFadeTime, mpData.mbAnimLoop);	
					
					if (pEntStruggle !is null)
					{
						pAnimEnt.GetMeshEntity().PlayName(mpData.msEntAnimStruggle, mpData.mbAnimLoop, false);
						pEntStruggle.SetWeight(0.f);
					}
				}
				
				mlAnimStage = 2;
			}	
		}
		
		//////////////////
		// Loop/Struggle
		else if (mlAnimStage == 2)
		{		
			//////////////////
			// Setup states
			cAnimationState@ pLoop = pBody.GetAnimationState(mpData.msAnim);
			cAnimationState@ pStruggle = pBody.GetAnimationState(mpData.msAnimStruggle);
			cAnimationState@ pEntLoop = pAnimEnt !is null ? pAnimEnt.GetMeshEntity().GetAnimationStateFromName(mpData.msEntAnim) : null;
			cAnimationState@ pEntStruggle = pAnimEnt !is null ? pAnimEnt.GetMeshEntity().GetAnimationStateFromName(mpData.msEntAnimStruggle) : null;
			
			if (mpData.mfTransition >= 1.f)
			{
				//////////////////
				// Weight
				mpData.mfStruggleAnimWeight = cMath_IncreaseTo(mpData.mfStruggleAnimWeight, afTimeStep * 1.5f, mpData.mfStruggle);
								
				//////////////////
				// Struggle loop
				if (pStruggle !is null) 
				{
					pLoop.SetWeight(1.f - mpData.mfStruggleAnimWeight);
					pStruggle.SetWeight(mpData.mfStruggleAnimWeight);
					
					if (pEntStruggle !is null)
					{
						pEntLoop.SetWeight(1.f - mpData.mfStruggleAnimWeight);
						pEntStruggle.SetWeight(mpData.mfStruggleAnimWeight);
					}
				}
				
				//////////////////
				// No struggle loop, adjust speed instead!
				else if (mpData.mbReverseAnimWhenStruggling)
				{
					float fSpeed = 1.f - (mpData.mfStruggle * 1.3f);
					pLoop.SetSpeed(fSpeed);
					
					if (pEntLoop !is null)
						pEntLoop.SetSpeed(fSpeed);
				}
			}
			
			//////////////////
			// Lose struggle if no loop and anim at end!
			if (mpData.mbAnimLoop == false && pLoop.IsOver())
				Stop(false);
		}
		
		//////////////////
		// Outro
		else if (mlAnimStage == 3)
		{
			//////////////////
			// Stop loops
			pBody.StopAnimation(mpData.msAnim, 0.3f);
			pBody.StopAnimation(mpData.msAnimStruggle, 0.3f);
					
			if (pAnimEnt !is null)
			{
				pAnimEnt.StopAnimation(mpData.msEntAnim, 0.3f);
				pAnimEnt.StopAnimation(mpData.msEntAnimStruggle, 0.3f);
			}
			
			//////////////////
			// Play outro
			cAnimationState@ pOutro = pBody.GetAnimationState(mpData.msAnimOutro);
			if (pOutro !is null)
			{
				pBody.PlayAnimationInLayer(mpData.msAnimOutro, ePlayerBodyAnimationLayer_FullBody, false, false, true, 0.3f, 1.f, 0.f);	
				
				if (pAnimEnt !is null)
					pAnimEnt.PlayAnimation(mpData.msEntAnimOutro, 0.3f, false);
				
				mlAnimStage = 4;
			}
		}
		
		//////////////////
		// End
		else if (mlAnimStage == 4)
		{
			//////////////////
			// Leave state
			cAnimationState@ pOutro = pBody.GetAnimationState(mpData.msAnimOutro);			
			if (pOutro.IsOver())
			{
				pBody.StopCustomAnimation(mpData.msAnimOutro);
				cLux_GetPlayer().ChangeState(ePlayerState_Normal);
				
				mlAnimStage = -1;
				
				//////////////////
				// Map callback				
				tString sMethodName = "void " + mpData.msAnimOutroCallback + "(const tString &in asAnim)";
				cLuxMap@ pMap = cLux_GetCurrentMap();
				if (pMap.ScriptMethodExists(sMethodName) && pMap.ScriptPrepare(sMethodName))
				{
					pMap.SetArgString(0, mpData.msAnimOutro);
					pMap.ScriptExecute();
				}
				
				mpData.msAnimOutroCallback = "";	
			}
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f GetLookTargetPos() override
	{		
		if (m_idDummyTar != tID_Invalid)
		{
			cCamera@ pCam = cLux_GetPlayer().GetCamera();
			return pCam.GetPosition() + pCam.GetForward();
		}
		
		return cLux_ID_Entity(mpData.m_idTar).GetPosition();
	}
	
	//------------------------------------------------------------
	
	float GetPullAddMul() override { return 0.05f; }
	
	//------------------------------------------------------------
	
	bool ShouldPlayOutroAnim() override
	{
		iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		cAnimationState@ pPlayerOutro = pBody.GetAnimationState(mpData.msAnimOutro);
		return pPlayerOutro !is null && (mpData.mbIsPermaFailStruggle && mpData.mfStruggleProgress < 0.f) == false;
	}
	
	//------------------------------------------------------------
	
	float GetEffectMul() override
	{	
		if (GetIntroActive() || GetOutroActive())
			return 0.f;
	
		float fMul = 1.f - cMath_Easing(eEasing_QuadOut, cMath_Max(mpData.mfStruggle - 0.4f, 0.f) / 0.6f);
		if (mpData.mfDisallowStruggleCount > 0.f)
			fMul = 1.f;
		
		return fMul;
	}
	
	//------------------------------------------------------------
	
	bool GetIntroActive()
	{
		iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		cAnimationState@ pIntro = pBody.GetAnimationState(mpData.msAnimIntro);
		return pIntro !is null && pIntro.IsActive();
	}
	
	//------------------------------------------------------------
	
	bool GetOutroActive()
	{
		iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		cAnimationState@ pOutro = pBody.GetAnimationState(mpData.msAnimOutro);
		return pOutro !is null && pOutro.IsActive();
	}
	
	//------------------------------------------------------------
	
	int mlAnimStage  = -1;
	tID m_idDummyTar = tID_Invalid;
	
	//------------------------------------------------------------
}

//------------------------------------------------------------

/////////////////////////////////////////
// WRAITH
/////////////////////////////////////////

//------------------------------------------------------------

class cStruggleEvent_Wraith : cStruggleEvent
{	
	//------------------------------------------------------------
	
	void Setup(const tString &in asWraith, float afDuration, bool abWinnable, bool abCanStop, float afTransitionTime, 
			   bool abAllowTransitionMovement, float afIntensity, bool abPlayOutro, bool abShowHint)
	{
		iLuxEntity@ pTar = cLux_GetCurrentMap().GetEntityByName(asWraith);
		mpData.m_idTar = pTar.GetID();	
		
		mpData.mfEventDuration = afDuration;
		mpData.mbWinnable = abWinnable;
		mpData.mfTransitionTime = cMath_Max(afTransitionTime, 0.001f);
		mbAllowTransitionMovement = abAllowTransitionMovement;
		mpData.mfIntensity = afIntensity;
		mbPlayHandsOutroAnim = abPlayOutro;
		mpData.mbShowHint = abShowHint;		
		mpData.mbCanStop = abCanStop;
			
		mpData.mfStruggleSoundFadeTime = 0.75f;
	}
	
	//------------------------------------------------------------
	
	void Enter() override
	{
		cStruggleEvent::Enter();
		
		/////////////////////
		// Setup event
		mbPlayHandsAnim = true;
		mlStruggleFlashStage = 0;
		mpData.mbDoBlurEffect = false;
		
		/////////////////////
		// Setup transition movement
		float fMinSpeed = 0.5f;
		float fMaxSpeed = 2.f;
		
		if (mbAllowTransitionMovement == false)
		{
			fMinSpeed = 0.f;
			fMaxSpeed = 0.f;
		}
		
		mpData.mfMinTransitionFwdSpeed = fMinSpeed;
		mpData.mfMaxTransitionFwdSpeed = fMaxSpeed;
		mpData.mfMinTransitionRightSpeed = fMinSpeed;
		mpData.mfMaxTransitionRightSpeed = fMaxSpeed;				
	}
	
	//------------------------------------------------------------
	
	void Leave() override
	{
		cStruggleEvent::Leave();
		
		mlStruggleFlashStage = -1;
	}
	
	//------------------------------------------------------------
	
	void Stop(bool abWin) override
	{
		cStruggleEvent::Stop(abWin);
		
		cScript_RunGlobalFunc(cLux_ID_Entity(mpData.m_idTar).GetName(), "cScrAgentWraith", "_Global_GetStruggleIsPermafail");
		bool bIsPermafail = cScript_GetGlobalReturnBool();
		
		if (abWin && mpData.mbPlayStruggleLoop)
		{
			if (bIsPermafail==false)
				FearHandler_StopStruggleSoundLoop(1.5f);
			
			// The player should be in a permafail state now, but just in case not, stop the sound after a small delay (the permafail state will cancel this delay timer)
			else
				FearHandler_SetStruggleSoundLoopAutoStop(5.0f); 
		}
		else if (mpData.mbPlayStruggleLoop)
		{
			// The player has lost and is about to permafail, but in case something interrupts it, kill the sound after a delay
			FearHandler_SetStruggleSoundLoopAutoStop(15.0f); 
		}
		
		/////////////////////
		// Wraith callback
		tString sCallback = abWin ? "_Global_StruggleSuccess" : "_Global_StruggleFail";
		
		bool bPlayOutro = mpData.mfTransition >= 1.f && ShouldPlayOutroAnim();
		cScript_SetGlobalArgBool(0, bPlayOutro);
		cScript_RunGlobalFunc(cLux_ID_Entity(mpData.m_idTar).GetName(), "cScrAgentWraith", sCallback);
		
		/////////////////////
		// Reset player
		Player_SetCrouchActionDisabled(false);
	}
		 
	//------------------------------------------------------------
	
	void UpdateMovement(float afTimeStep) override
	{
		if (mpData.mfTransition >= 1.f)
		{
			Player_SetCrouchActionDisabled(true);
			Player_SetCrouching(false);
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f GetLookTargetPos() override
	{		
		iLuxEntity@ pTarget = cLux_ID_Entity(mpData.m_idTar);
		cNode3D@ pSocket = pTarget.GetMeshEntity().GetSocket("StruggleLookSocket");
		return pSocket.GetWorldPosition();
	}
	
	//------------------------------------------------------------
	
	void UpdateFlashes(float afTimeStep) override
	{
		if (mlStruggleFlashStage == 0)
		{		
			StruggleFlashHandler_DoFlash(0.1f, cMath_RandRectf(0.2f, 0.3f));
			mlStruggleFlashStage = 1;
		}
		else if (mlStruggleFlashStage == 1)
		{
			if (mpData.mfTimePassed > 2.5f && mpData.mbCalculateTimePassed)
			{
				StruggleFlashHandler_DoFlash(0.1f, cMath_RandRectf(0.f, 0.1f));
				mlStruggleFlashStage = -1;
			}
		}
	}
		
	//------------------------------------------------------------
	
	float GetPullAddMul() override { return 0.35f; }
	
	//------------------------------------------------------------
	
	bool ShouldStopStruggleLoopSound() override
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	int mlStruggleFlashStage = -1;
	bool mbAllowTransitionMovement = true;
	
	//------------------------------------------------------------
}

//------------------------------------------------------------

/////////////////////////////////////////
// TIN HINAN
/////////////////////////////////////////

//------------------------------------------------------------

class cStruggleEvent_TinHinan : cStruggleEvent_Wraith
{		
	//------------------------------------------------------------
	
	void Setup(const tString &in asAgent, const tString &in asEndCallback, float afDuration, bool abWinnable, bool abCanStop, float afTransitionTime, 
			   bool abAllowTransitionMovement, float afIntensity, bool abPlayOutro, bool abShowHint)
	{
		cStruggleEvent_Wraith::Setup(asAgent, afDuration, abWinnable, abCanStop, afTransitionTime, abAllowTransitionMovement,
									 afIntensity, abPlayOutro, abShowHint);

		mpData.msSuccessCallback = asEndCallback;
		mpData.msFailCallback = asEndCallback;
	}
	
	//------------------------------------------------------------
	
	void Stop(bool abWin) override
	{
		cStruggleEvent::Stop(abWin);
		
		if (GhoulProgression_GetProgression()==GhoulProgression_GetMaxProgression() && abWin == false)
		{
			// The player has lost and is about to permafail, but in case something interrupts it, kill the sound after a delay
			FearHandler_SetStruggleSoundLoopAutoStop(10.0f); 
		}
		else
		{
			FearHandler_StopStruggleSoundLoop(1.5f);
		}

		/////////////////////
		// Reset player
		Player_SetCrouchActionDisabled(false);
	}
	
	//------------------------------------------------------------
}

/////////////////////////////////////////
// STATIONARY
/////////////////////////////////////////

//------------------------------------------------------------

class cStruggleEvent_Stationary : cStruggleEvent
{	
	//------------------------------------------------------------
	
	void Setup(const tString &in asTar, const tString &in asLight, const tString &in asSuccessCallback, 
			   const tString &in asFailCallback, float afDuration, bool abWinnable, float afTransitionTime, float afIntensity, bool abShowHint)
	{		
		///////////////////////////
		// Set up event
		cLuxMap@ pMap = cLux_GetCurrentMap();
		iLuxEntity@ pTar = pMap.GetEntityByName(asTar);
		mpData.m_idTar = pTar.GetID();
		
		iLight@ pLight = pMap.GetWorld().GetLight(asLight);
		if (pLight !is null)
		{
			mpData.m_idLight = pLight.GetID();
			mpData.mfLightRadius = pLight.GetRadius();
		}
		
		mpData.msSuccessCallback = asSuccessCallback;
		mpData.msFailCallback = asFailCallback;
		mpData.mfEventDuration = afDuration;
		mpData.mbWinnable = abWinnable;
		mpData.mfTransitionTime = cMath_Max(afTransitionTime, 0.001f);
		mpData.mfIntensity = afIntensity;
		mpData.mbShowHint = abShowHint;
	}
	
	//------------------------------------------------------------
	
	void Leave() override
	{
		cStruggleEvent::Leave();
	}

	//------------------------------------------------------------
}

//------------------------------------------------------------

/////////////////////////////////////////
// GHOUL
/////////////////////////////////////////

//------------------------------------------------------------

class cStruggleEvent_Ghoul : cStruggleEvent_Animation
{
	//------------------------------------------------------------
	
	tID m_idAgent = tID_Invalid;
	tString msAnimSuccessOutro;
	tString msAnimFailureOutro;
	
	//------------------------------------------------------------
	
	void Setup(const tString &in asGhoul, const tString &in asStandTar, const tString &in asAnim, const tString &in asAnimStruggle,
			   const tString &in asAnimIntro, const tString &in asAnimSuccessOutro, const tString &in asAnimFailureOutro, bool abLoop, const tString &in asLight, 
			   const tString &in asSuccessCallback, const tString &in asFailCallback, const tString &in asAnimOutroCallback,
			   float afDuration, bool abWinnable, float afTransitionTime, float afIntensity, bool abShowHint, float afFadeTime)
	{
		cStruggleEvent_Animation::Setup(asStandTar, asAnim, asAnimStruggle, asAnimIntro, asAnimSuccessOutro, abLoop, asLight, asSuccessCallback,
										asFailCallback, asAnimOutroCallback, afDuration, abWinnable, afTransitionTime, afIntensity, abShowHint, afFadeTime, true);
		
		iLuxEntity@ pGhoul = cLux_GetCurrentMap().GetEntityByName(asGhoul);
		m_idAgent = pGhoul.GetID();	
		
		msAnimSuccessOutro = asAnimSuccessOutro;
		msAnimFailureOutro = asAnimFailureOutro;
		
		mpData.mfStruggleSoundFadeTime = 0.75f;
		mpData.mfStruggleSoundBaseVolume = 0.75f;
	}
	
	//------------------------------------------------------------
	
	void Stop(bool abWin) override
	{
		cStruggleEvent_Animation::Stop(abWin);
		
		/////////////////////
		// Ghoul callback
		tString sCallback = abWin ? "_Global_StruggleSuccess" : "_Global_StruggleFail";
		
		cScript_RunGlobalFunc(cLux_ID_Entity(m_idAgent).GetName(), "cScrAgentGhoul", sCallback);
		
		mpData.msAnimOutro = abWin ? msAnimSuccessOutro : msAnimFailureOutro;
		
		/////////////////////
		// Reset player
		Player_SetCrouchActionDisabled(false);
	}
	
	//------------------------------------------------------------
	
	cVector3f GetLookTargetPos() override
	{		
		iLuxEntity@ pTarget = cLux_ID_Entity(m_idAgent);
		cNode3D@ pSocket = pTarget.GetMeshEntity().GetSocket("socket_struggle_lookat");
		return pSocket.GetWorldPosition();
	}
	
	//------------------------------------------------------------
	
	bool ShouldResetArmMaterial() override
	{
		return mpData.mfStruggleProgress > -1.0f;
	}
	
	//------------------------------------------------------------
	
	bool ShouldStopStruggleLoopSound() override
	{
		return mpData.mfStruggleProgress > -1.0f;
	}
}

//------------------------------------------------------------

class cScrPlayerState_Struggle : iScrPlayerState, iScrPlayerState_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////

	//------------------------------------------------------------

	void OnAttachBodyToStickyArea() {}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init() {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// USER SETTINGS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void LoadUserConfig() {}
	void SaveUserConfig() {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap) {}	
	void OnMapLeave(cLuxMap @apMap) {}	
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap @apMap) {}
	void DestroyWorldEntities(cLuxMap @apMap) {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupStruggle()
	{		
		int lEvent = cScript_GetGlobalArgInt(0);
		mlActiveEventType = lEvent;
		
		///////////////////////////
		// Move Toward
		if (lEvent == eStruggleEvent_MoveToward)
		{
			@mpActiveEvent = mEvent_MoveToward;
			@mpActiveEvent.mpData = mData;
		
			tString sTar = cScript_GetGlobalArgString(1);
			tString sLookTar = cScript_GetGlobalArgString(2);
			tString sLight = cScript_GetGlobalArgString(3);
			tString sSuccessCallback = cScript_GetGlobalArgString(4);
			tString sFailCallback = cScript_GetGlobalArgString(5);
			float fDuration = cScript_GetGlobalArgFloat(6);
			bool bWinnable = cScript_GetGlobalArgBool(7);
			float fTransitionTime = cScript_GetGlobalArgFloat(8);
			float fMoveSpeed = cScript_GetGlobalArgFloat(9);
			float fIntensity = cScript_GetGlobalArgFloat(10);
			bool bShowHint = cScript_GetGlobalArgBool(11);
			float fSoundFadeTime = cScript_GetGlobalArgFloat(12);
			
			cast<cStruggleEvent_MoveToward>(mpActiveEvent).Setup(sTar, sLookTar, sLight, sSuccessCallback, sFailCallback, fDuration, bWinnable, fTransitionTime, fMoveSpeed, fIntensity, bShowHint, fSoundFadeTime);
		}
		///////////////////////////
		// Animation
		else if (lEvent == eStruggleEvent_Animation)
		{
			@mpActiveEvent = mEvent_Animation;
			@mpActiveEvent.mpData = mData;
						
			tString sStandTar = cScript_GetGlobalArgString(1);
			tString sAnim = cScript_GetGlobalArgString(2);
			tString sAnimStruggle = cScript_GetGlobalArgString(3);
			tString sAnimIntro = cScript_GetGlobalArgString(4);
			tString sAnimOutro = cScript_GetGlobalArgString(5);
			bool bLoop = cScript_GetGlobalArgBool(6);
			tString sLight = cScript_GetGlobalArgString(7);
			tString sSuccessCallback = cScript_GetGlobalArgString(8);
			tString sFailCallback = cScript_GetGlobalArgString(9);
			tString sAnimOutroCallback = cScript_GetGlobalArgString(10);
			float fDuration = cScript_GetGlobalArgFloat(11);
			bool bWinnable = cScript_GetGlobalArgBool(12);
			float fTransitionTime = cScript_GetGlobalArgFloat(13);
			float fIntensity = cScript_GetGlobalArgFloat(14);
			bool bShowHint = cScript_GetGlobalArgBool(15);
			float fFadeTime = cScript_GetGlobalArgFloat(16);
			bool bPlayStruggleLoop = cScript_GetGlobalArgBool(17);
			bool bForceHint = cScript_GetGlobalArgBool(18);
			
			cast<cStruggleEvent_Animation>(mpActiveEvent).Setup(sStandTar, sAnim, sAnimStruggle, sAnimIntro, sAnimOutro, bLoop, sLight, sSuccessCallback, sFailCallback, sAnimOutroCallback, fDuration, bWinnable, 
																fTransitionTime, fIntensity, bShowHint, fFadeTime, bPlayStruggleLoop, bForceHint);			
		}
		///////////////////////////
		// Ghoul
		else if (lEvent == eStruggleEvent_Ghoul)
		{
			@mpActiveEvent = mEvent_Ghoul;
			@mpActiveEvent.mpData = mData;
						
			tString sStandTar = cScript_GetGlobalArgString(1);
			tString sAnim = cScript_GetGlobalArgString(2);
			tString sAnimStruggle = cScript_GetGlobalArgString(3);
			tString sAnimIntro = cScript_GetGlobalArgString(4);
			tString sAnimOutro = cScript_GetGlobalArgString(5);
			bool bLoop = cScript_GetGlobalArgBool(6);
			tString sLight = cScript_GetGlobalArgString(7);
			tString sSuccessCallback = cScript_GetGlobalArgString(8);
			tString sFailCallback = cScript_GetGlobalArgString(9);
			tString sAnimOutroCallback = cScript_GetGlobalArgString(10);
			float fDuration = cScript_GetGlobalArgFloat(11);
			bool bWinnable = cScript_GetGlobalArgBool(12);
			float fTransitionTime = cScript_GetGlobalArgFloat(13);
			float fIntensity = cScript_GetGlobalArgFloat(14);
			bool bShowHint = cScript_GetGlobalArgBool(15);
			float fFadeTime = cScript_GetGlobalArgFloat(16);
			tString sGhoul = cScript_GetGlobalArgString(17);
			tString sAnimOutroFail = cScript_GetGlobalArgString(18);
			
			cast<cStruggleEvent_Ghoul>(mpActiveEvent).Setup(sGhoul, sStandTar, sAnim, sAnimStruggle, sAnimIntro, sAnimOutro, sAnimOutroFail, bLoop, sLight, sSuccessCallback, sFailCallback, sAnimOutroCallback, fDuration, bWinnable, fTransitionTime, fIntensity, bShowHint, fFadeTime);			
		}
		///////////////////////////
		// Wraith
		else if (lEvent == eStruggleEvent_Wraith)
		{
			@mpActiveEvent = mEvent_Wraith;
			@mpActiveEvent.mpData = mData;
			
			tString sTar = cScript_GetGlobalArgString(1);
			float fDuration = cScript_GetGlobalArgFloat(2);
			bool bWinnable = cScript_GetGlobalArgBool(3);
			float fTransitionTime = cScript_GetGlobalArgFloat(4);
			bool bAllowTransitionMovement = cScript_GetGlobalArgBool(5);
			float fIntensity = cScript_GetGlobalArgFloat(6);
			bool bPlayOutroAnim = cScript_GetGlobalArgBool(7);
			bool bShowHint = cScript_GetGlobalArgBool(8);
			bool bCanStop = cScript_GetGlobalArgBool(9);
			
			cast<cStruggleEvent_Wraith>(mpActiveEvent).Setup(sTar, fDuration, bWinnable, bCanStop, fTransitionTime, bAllowTransitionMovement, fIntensity, bPlayOutroAnim, bShowHint);
		}
		///////////////////////////
		// Tin Hinan
		else if (lEvent == eStruggleEvent_TinHinan)
		{
			@mpActiveEvent = mEvent_TinHinan;
			@mpActiveEvent.mpData = mData;
			
			tString sTar = cScript_GetGlobalArgString(1);
			tString sEndCallback = cScript_GetGlobalArgString(2);
			float fDuration = cScript_GetGlobalArgFloat(3);
			bool bWinnable = cScript_GetGlobalArgBool(4);
			float fTransitionTime = cScript_GetGlobalArgFloat(5);
			bool bAllowTransitionMovement = cScript_GetGlobalArgBool(6);
			float fIntensity = cScript_GetGlobalArgFloat(7);
			bool bPlayOutroAnim = cScript_GetGlobalArgBool(8);
			bool bShowHint = cScript_GetGlobalArgBool(9);
			bool bCanStop = cScript_GetGlobalArgBool(10);
			
			cast<cStruggleEvent_TinHinan>(mpActiveEvent).Setup(sTar, sEndCallback, fDuration, bWinnable, bCanStop, fTransitionTime, bAllowTransitionMovement, fIntensity, bPlayOutroAnim, bShowHint);
		}
		///////////////////////////
		// Stationary
		else if (lEvent == eStruggleEvent_Stationary)
		{
			@mpActiveEvent = mEvent_Stationary;
			@mpActiveEvent.mpData = mData;
		
			tString sTar = cScript_GetGlobalArgString(1);
			tString sLight = cScript_GetGlobalArgString(2);
			tString sSuccessCallback = cScript_GetGlobalArgString(3);
			tString sFailCallback = cScript_GetGlobalArgString(4);
			float fDuration = cScript_GetGlobalArgFloat(5);
			bool bWinnable = cScript_GetGlobalArgBool(6);
			float fTransitionTime = cScript_GetGlobalArgFloat(7);
			float fIntensity = cScript_GetGlobalArgFloat(8);
			bool bShowHint = cScript_GetGlobalArgBool(9);
			
			cast<cStruggleEvent_Stationary>(mpActiveEvent).Setup(sTar, sLight, sSuccessCallback, sFailCallback, fDuration, bWinnable, fTransitionTime, fIntensity, bShowHint);
		}
	}
	
	//------------------------------------------------------------
	
	void SetupAnimationEntity()
	{
		////////////////////////////
		// Setup entity to play animations in sync
		tString sAnimEnt = cScript_GetGlobalArgString(0);
		iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(sAnimEnt);
		mData.m_idAnimEnt = pEnt.GetID();
		
		mData.msEntAnim = cScript_GetGlobalArgString(1);
		mData.msEntAnimIntro = cScript_GetGlobalArgString(2);
		mData.msEntAnimOutro = cScript_GetGlobalArgString(3);
		mData.msEntAnimStruggle = cScript_GetGlobalArgString(4);
		mData.mbAnimLoop = cScript_GetGlobalArgBool(5);
	}
		
	//------------------------------------------------------------
	
	void StruggleActive()
	{
		bool bIncludeTransition = cScript_GetGlobalArgBool(0);
		cScript_SetGlobalReturnBool(mpActiveEvent !is null && (bIncludeTransition || mData.mfTransition >= 1.f));
	}
	
	//------------------------------------------------------------
	
	void ManualStop()
	{
		if (mpActiveEvent is null || mpActiveEvent.mpData.mbEventStopped) return;
		mpActiveEvent.Stop(cScript_GetGlobalArgBool(0));
	}
	
	//------------------------------------------------------------
	
	void SetCannotLose()
	{
		mData.mbCanStop = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------- 
	
	void SetDisallowStruggleTime()
	{
		mData.mfDisallowStruggleCount = cScript_GetGlobalArgFloat(0);
		mData.mfActiveStruggleTime = mData.mfEventDuration - mData.mfDisallowStruggleCount;
	}
	
	//------------------------------------------------------------
	
	void SetTentacleSizeAdd()
	{
		mData.mfTentacleSizeAdd = cScript_GetGlobalArgFloat(0);
	}
	
	//------------------------------------------------------------
	
	void SetTentacleMaterial()
	{
		mData.mTentacleMaterial = eFearTentacleMaterial(cScript_GetGlobalArgInt(0));
	}
	
	//------------------------------------------------------------
	
	void SetIsPermaFailStruggle()
	{
		mData.mbIsPermaFailStruggle = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void SetFlashesActive()
	{
		mData.mbFlashesActive = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void SetWinnable()
	{
		mData.mbWinnable = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void SetCalculateTimePassed()
	{
		mData.mbCalculateTimePassed = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void SetBlurEffectActive()
	{
		mData.mbDoBlurEffect = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void SetReverseAnimWhenStruggling()
	{
		mData.mbReverseAnimWhenStruggling = cScript_GetGlobalArgBool(0);
	}
		
	//------------------------------------------------------------
	
	void _Global_SetForcedEasyStruggle()
	{
		mData.mbForcedEasyStruggle = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void FadeLookMulTo()
	{
		mData.mfLookMulGoal = cScript_GetGlobalArgFloat(0);
		float fTime = cScript_GetGlobalArgFloat(1);
		mData.mfLookMulFadeSpeed = cMath_Abs(mData.mfLookMulGoal - mData.mfLookMul) / cMath_Max(fTime, 0.0001f);
	}
	
	//------------------------------------------------------------
	
	void PlayHandsAnimation()
	{
		bool bPlay = cScript_GetGlobalArgBool(0);
		bool bPlayOutro = cScript_GetGlobalArgBool(1);
		bool bLeftHand = cScript_GetGlobalArgBool(2);
		bool bRightHand = cScript_GetGlobalArgBool(3);
		
		if (bPlay && mpActiveEvent !is null)
		{
			mpActiveEvent.mbPlayHandsAnim = true;
			mpActiveEvent.mlHandsAnimStage = 0;
			mpActiveEvent.mbPlayHandsOutroAnim = bPlayOutro;
			mpActiveEvent.mbPlayLeftHandAnim = bLeftHand;
			mpActiveEvent.mbPlayRightHandAnim = bRightHand;
		}		
	}
	
	//------------------------------------------------------------
	
	void SetCustomArmAnimOutro()
	{
		mData.msArmAnimOutro = cScript_GetGlobalArgString(0);
	}
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{
		mpActiveEvent.Enter();
					
		Item_PutAway(eItemHandlerHand_Right);
		Item_PutAway(eItemHandlerHand_Left);
		
		//Player_SetCrouching(false);
		Player_SetForceNightVision(true);
		
		GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetPermafailFadeProgression(), 4.0f);
	}
	
	//------------------------------------------------------------
	
	void OnLeaveState(int alNextStateId)
	{		
		mpActiveEvent.Leave();
		
		Player_StopLookAt(1.f);
		Player_SetForceNightVision(false);
		
		Player_SetMoveSpeedMul(0.5f, ePlayerMoveSpeedMulType_PlayerState);
		Player_SetLookSpeedMul(0.5f);		
		Player_FadeMoveSpeedMulTo(1.0f, 1.f, ePlayerMoveSpeedMulType_PlayerState);
		Player_FadeLookSpeedMulTo(1.0f, 1.f);
		
		// If mbEventStopped == false here we need to make sure Stop() runs!
		if (mData.mbEventStopped == false)
			mpActiveEvent.Stop(false);
		
		End();
		
		@mpActiveEvent = null;
		mlActiveEventType = -1;
	}
	
	//------------------------------------------------------------
	
	void Reset() {}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		/////////////
		// Make sure we've got an event
		if (mpActiveEvent is null)
			@mpActiveEvent = GetActiveEvent();
		
		/////////////
		// Win!
		if (mData.mfStruggleProgress >= 1.f && mData.mbEventStopped == false)
			mpActiveEvent.Stop(true);
		
		/////////////
		// Update event
		UpdateTimers(afTimeStep);
		UpdateTransition(afTimeStep);
		UpdateStruggle(afTimeStep);
		UpdateMovement(afTimeStep);
		mpActiveEvent.UpdateAnimation(afTimeStep);
		UpdateEffects(afTimeStep);
		
		/////////////
		// End!
		if (mData.mbEndEvent)
			End();
	}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
		// Making sure that the input gets eliminated when using mouse and released.
		if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed()==false)
			mpActiveEvent.UpdateRightAxis(0);
	}
	
	//------------------------------------------------------------
	
	void UpdateTimers(float afTimeStep)
	{
		if (mData.mbEventStopped) return;
		
		////////////////////////////
		// Stop struggle if time limit reached
		if (mData.mbCalculateTimePassed)
			mData.mfTimePassed += afTimeStep;
		
		if (mData.mbCanStop && mData.mfTimePassed - mData.mfTransitionTime >= mData.mfEventDuration)
		{
			mpActiveEvent.Stop(false);
			return;
		}
		
		////////////////////////
		// Update transition
		mData.mfTransitionCount -= afTimeStep;
		if (mData.mfTransitionCount <= 0.f)
			mData.mfTransitionCount = 0.f;        
		
		mData.mfTransition = cMath_Easing(eEasing_QuadIn, (mData.mfTransitionTime - mData.mfTransitionCount) / mData.mfTransitionTime);
		
		/////////////////////////////
		// Reset struggle dirs
		if (mData.mfDisallowStruggleCount > 0.f)
		{
			mData.mfDisallowStruggleCount -= afTimeStep;
			
			mData.mvLeftAxis = cVector2f(0.f);				
			mData.mvRightAxis = cVector2f(0.f);
		}
		
		if (mData.mfTimeSinceRightAxisActive < 999999.f)
			mData.mfTimeSinceRightAxisActive += afTimeStep;
		if (mData.mfTimeSinceLeftAxisActive < 999999.f)
			mData.mfTimeSinceLeftAxisActive += afTimeStep;
		
		if (mData.mbEasyStruggleMode==false)
		{
			if (mData.mfTimeSinceRightAxisActive > 0.05f && cLux_GetInputHandler().GetGamepadWasLastDeviceUsed())
				mData.mvLeftAxis = cVector2f(0.f);			
			if (mData.mfTimeSinceLeftAxisActive > 0.05f)
				mData.mvRightAxis = cVector2f(0.f);
		}
		
		/////////////////////////
		// Camera pull
		mData.mfPullCount -= afTimeStep;
		if (mData.mfPullCount <= 0.f)
		{
			mData.mfPullCount = cMath_RandRectf(0.2f, 1.f);
			
			if (mData.mfStruggle <= 0.9f)
			{
				mData.mvPullAdd = cMath_RandRectVector3f(cVector3f(-1.f), cVector3f(1.f)) * 1.5f;
				mData.mvPullAdd.z = 0.f;				
				mData.mvPullAdd *= mpActiveEvent.GetPullAddMul();
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateTransition(float afTimeStep)
	{
		////////////////
		// Get distance to tar when transition is over
		if (mData.mfTransition >= 1.f && mData.mfStartDistToTar < 0.f)
		{
			iLuxEntity@ pTar = cLux_ID_Entity(mData.m_idTar);
			mData.mfStartDistToTar = cMath_Vector3Dist(cLux_GetPlayer().GetCharacterBody().GetPosition(), pTar.GetPosition());
			return;
		}
		
		if (mData.mbEventStopped)
			return;
		
		//////////////////////////////
		// Limit movement during transition		
		float fMul = (1.f - mData.mfTransition);
		float fFwdDiff = mData.mfMaxTransitionFwdSpeed - mData.mfMinTransitionFwdSpeed;
		float fMaxFwdSpeed = mData.mfMinTransitionFwdSpeed + fFwdDiff * fMul;
		float fRightDiff = mData.mfMaxTransitionRightSpeed - mData.mfMinTransitionRightSpeed;
		float fMaxRightSpeed = mData.mfMinTransitionRightSpeed + fRightDiff * fMul;
		
		iCharacterBody@ pBody = mBaseObj.mpPlayer.GetCharacterBody();				
		if (pBody.GetMoveSpeed(eCharDir_Forward) > fMaxFwdSpeed)
			pBody.SetMoveSpeed(eCharDir_Forward, fMaxFwdSpeed);
		if (pBody.GetMoveSpeed(eCharDir_Forward) < -fMaxFwdSpeed)
			pBody.SetMoveSpeed(eCharDir_Forward, -fMaxFwdSpeed);
		if (pBody.GetMoveSpeed(eCharDir_Right) > fMaxRightSpeed)
			pBody.SetMoveSpeed(eCharDir_Right, fMaxRightSpeed);
		if (pBody.GetMoveSpeed(eCharDir_Right) < -fMaxRightSpeed)
			pBody.SetMoveSpeed(eCharDir_Right, -fMaxRightSpeed);
	}
	
	//------------------------------------------------------------
	
	void UpdateStruggle(float afTimeStep)
	{		
		/////////////////
		// Fade look mul
		mData.mfLookMul = cMath_IncreaseTo(mData.mfLookMul, afTimeStep * mData.mfLookMulFadeSpeed, mData.mfLookMulGoal);		
		
		/////////////////
		// Update struggle vars
		mData.mfStruggle = mpActiveEvent.UpdateStruggle(afTimeStep);
		if (mData.mfTransition < 1.f && mData.mfStruggle > 0.7f)
			mData.mfStruggle = 0.7f;
		
		float fRightAxisResistanceMul = mpActiveEvent.UpdateRightAxisResistanceMul();
		float fRightAxisResistance = 3.f * fRightAxisResistanceMul;
		
		bool bPadActive = cLux_GetInputHandler().GetGamepadWasLastDeviceUsed();
		if (bPadActive == false && mData.mfStruggle >= 0.8)
			fRightAxisResistance = 0.f;
		if (bPadActive && mData.mvLeftAxis.SqrLength() <= 0.f) 
			fRightAxisResistance = 10.f;
			
		/////////////////
		// Apply struggle
		if (mlActiveEventType != eStruggleEvent_Animation && mlActiveEventType != eStruggleEvent_Ghoul)
		{
			cCamera@ pCam = mBaseObj.mpPlayer.GetCamera();
			
			cVector3f vTarPos = mpActiveEvent.GetLookTargetPos();		
			cVector3f vDirToTar = cMath_Vector3Normalize(vTarPos - pCam.GetPosition());
			cVector3f vLookTar = pCam.GetPosition() + (vDirToTar * 10.f) + mData.mvPullAdd;	
			
			float fAcc = 0.6f;
			float fSpeedMul = fRightAxisResistance;
			float fMaxSpeed = 5.f;
			
			if (mData.mbEventStopped)
			{
				fAcc = 1.f;
				fSpeedMul = 1.f;
				fMaxSpeed = 1.f;
			}
			
			fAcc = fAcc * mData.mfTransition * mData.mfIntensity;
			fSpeedMul = fSpeedMul * mData.mfTransition * mData.mfIntensity;
			mBaseObj.mpPlayer.RotateCameraTowards(fAcc, fSpeedMul, fMaxSpeed, vLookTar, false);
		}
		else
		{
			iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
			
			if (mData.mbEventStopped)
			{
				mData.mfMaxCutscenePitch = cMath_IncreaseTo(mData.mfMaxCutscenePitch, afTimeStep * 2.f, 0.f);
				mData.mfMaxCutsceneYaw = cMath_IncreaseTo(mData.mfMaxCutsceneYaw, afTimeStep * 2.f, 0.f);
			}
			
			pBody.Cutscene_SetMaxPitch(mData.mfMaxCutscenePitch);
			pBody.Cutscene_SetMaxYaw(mData.mfMaxCutsceneYaw);
			
			float fPitch = pBody.Cutscene_GetPitch();
			float fYaw = pBody.Cutscene_GetYaw();		
			float fPitchDiff = -cMath_GetAngleDistanceRad(fPitch, mData.mvPullAdd.x);
			float fYawDiff = -cMath_GetAngleDistanceRad(fYaw, mData.mvPullAdd.y);						
			float fStruggle = 1.f - mData.mfStruggle;
			float fAcc = 12.f;
			
			pBody.Cutscene_AddPitch(fPitchDiff * fStruggle * fAcc * mData.mfTransition * afTimeStep);
			pBody.Cutscene_AddYaw(fYawDiff * fStruggle * fAcc * mData.mfTransition * afTimeStep);
		}		
	}
	
	//------------------------------------------------------------
	
	void UpdateMovement(float afTimeStep)
	{
		if (mData.mbEventStopped) return;
		
		mpActiveEvent.UpdateMovement(afTimeStep);
		
		/////////////////////////////
		// Move struggle
		float fMoveSpeed = mpActiveEvent.UpdateMovementSpeed();
		bool bOnGround = mBaseObj.mpPlayer.GetCharacterBody().IsOnGround();	
	
		if (bOnGround && fMoveSpeed > 0.f)
		{			
			iLuxEntity@ pTar = cLux_ID_Entity(mData.m_idTar);			
			cVector3f vDir = cMath_Vector3Normalize(pTar.GetPosition() - cLux_GetPlayer().GetCamera().GetPosition());
			vDir.y = 0.f;

			mBaseObj.mpPlayer.GetCharacterBody().SetForceVelocity(vDir * fMoveSpeed);
		}		
	}
	
	//............................................................
	
	void UpdateEffects(float afTimeStep)
	{
		if (mData.mbEventStopped) 
			return;
		if (mpActiveEvent.StartEffects() == false)
			return;	
			
		/////////////////////
		// Setup vars
		float fSpeed = 20.f * afTimeStep;
		float fEffectIntensity = mpActiveEvent.GetEffectMul() * mData.mfIntensity;
		
		/////////////////////
		// Tentacles
		float fMinTentacleAmount = mpActiveEvent.GetMinTentacleAmount();
		float fMaxTentacleAmount = mpActiveEvent.GetMaxTentacleAmount();
		
		float fTentacleLevelAddGoal = fMaxTentacleAmount - fMinTentacleAmount;
		if (mData.mfTransition >= 1.f && mData.mfDisallowStruggleCount > 0.f) // Stage just increased, fade back up to max
			fTentacleLevelAddGoal = fMaxTentacleAmount;
		
		mData.mfTentacleLevelAdd = cMath_IncreaseTo(mData.mfTentacleLevelAdd, afTimeStep, fTentacleLevelAddGoal);
		fMaxTentacleAmount = fMinTentacleAmount + mData.mfTentacleLevelAdd;
		
		float fLevel = cMath_Clamp(fEffectIntensity, fMinTentacleAmount, fMaxTentacleAmount);		
		float fSizeAdd = mData.mfTentacleSizeAdd * fLevel;
		float fRate = cMath_Max(fEffectIntensity, 0.5f);
		
		FearHandler_FadeLevelTo(fLevel, fSpeed, true);		
		FearHandler_FadeTentacleSizeAddTo(fSizeAdd, fSpeed);
		FearHandler_SetForcedAddFearRate(eFearForcedRateType_Struggle, fRate, 1.f, false);
		
		float fFOVShake = 0.02+0.05*fLevel;
		Effect_FOV_Shake_SetAmount(mData.mlFOVShakeId, fFOVShake);
		
		/////////////////////
		// Screen effects		
		if (mData.mfTransition >= 1.f && mData.mlBlurId != -1)
		{
			float fBlur = cMath_Max(gfStruggleBlurAmount * fEffectIntensity, 0.3f);
			Effect_Blur_FadeAmount(mData.mlBlurId, fBlur, fSpeed * 0.33f);
		}
		
		/////////////////////
		// Light
		iLight@ pLight = cLux_ID_Light(mData.m_idLight);
		if (pLight !is null)
		{
			float fTransitionMul = cMath_Clamp(mData.mfTransition * 10.f, 0.f, 1.f);
			pLight.FadeTo(cColor_White * fEffectIntensity * fTransitionMul, mData.mfLightRadius, fSpeed);
		}
		
		/////////////////////
		// Flashes
		if (mData.mbFlashesActive)
			mpActiveEvent.UpdateFlashes(afTimeStep);
		
		/////////////////////
		// Sounds		
		mpActiveEvent.UpdateSound(afTimeStep);
		
		float fParam = cMath_Max(fEffectIntensity * 10.f, 2.f);
		Sound_SetParam("Sound_StruggleLoop", 0, fParam);
		
		/////////////////////
		// Struggle barks
		if (mData.mbIsPermaFailStruggle && mData.mbIsUnderwater == false)
		{
			mData.mfStruggleBarkCount -= afTimeStep;
			if (mData.mfStruggleBarkCount <= 0.f)
			{
				mData.mfStruggleBarkCount = cMath_RandRectf(4.f, 4.5f);
				Sound_StopGui(mData.msCurrentStruggleBark, 0.3f);
				
				//////////////////////
				// Play a random bark
				if (mData.mvStruggleBarkIds.size() == 0)
				{
					for (int i = 1; i < 11; ++i)
						mData.mvStruggleBarkIds.push_back(i);
				}
				
				int lArrayId = cMath_RandRectl(0, mData.mvStruggleBarkIds.size() - 1);
				int lBarkId = mData.mvStruggleBarkIds[lArrayId];
				mData.mvStruggleBarkIds.removeAt(lArrayId);
				
				mData.msCurrentStruggleBark = gsStruggleBarkBase + lBarkId;
				Sound_PlayGui(mData.msCurrentStruggleBark, 1.f, eSoundEntryType_GuiWorld);
			}
			
			//////////////////////
			// Fade ghoulishness of bark depending on struggle progress
			float fBarkParamSpeed = fEffectIntensity < mData.mfStruggleBarkParam ? 3.f : 1.5f;
			mData.mfStruggleBarkParam = cMath_IncreaseTo(mData.mfStruggleBarkParam, afTimeStep * fBarkParamSpeed, fEffectIntensity);
			Sound_SetGuiParam(mData.msCurrentStruggleBark, "struggle", mData.mfStruggleBarkParam);
		}
				
		/////////////////////
		// Cam shake
		float fShakeMul = mpActiveEvent.UpdateEffectShakeMul() * mData.mfIntensity;		
		if (mlActiveEventType != eStruggleEvent_Animation && mlActiveEventType != eStruggleEvent_Ghoul)
		{
			cLux_GetPlayer().GetCamera().AddPitch(cMath_RandRectf(-1.f, 1.f) * fShakeMul * afTimeStep);
			mBaseObj.mpPlayer.GetCharacterBody().AddYaw(cMath_RandRectf(-1.f, 1.f) * fShakeMul * afTimeStep);
		}
		else
		{
			iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
			pBody.Cutscene_AddYaw(cMath_RandRectf(-1.f, 1.f) * fShakeMul * afTimeStep);
			pBody.Cutscene_AddPitch(cMath_RandRectf(-1.f, 1.f) * fShakeMul * afTimeStep);		
		}
		
		/////////////////
		// Rumble
		mData.mfRumbleCount -= afTimeStep;
		if (mData.mfRumbleCount <= 0.f)
		{
			mData.mfRumbleCount = 0.2f;
			float fRumble = cMath_Max(fShakeMul - 0.3f, 0.f) * 2.f;
			Effect_Rumble_Start(fRumble, 0.2f);
		}
	}
	
	//------------------------------------------------------------
	
	void End()
	{
		if (mData.mbEndEvent == false) 
			return;
		
		mData.mbEndEvent = false;
		
		///////////////////////////
		// Stop effects		
		if (mData.mlBlurId != -1)
		{
			Effect_Blur_FadeOut(mData.mlBlurId, 1.f);
			mData.mlBlurId = -1;
		}
		
		if (mData.mlHintId != -1)
		{
			Hint_Release(mData.mlHintId);
			mData.mlHintId = -1;
		}
		
		if (mData.mbForceHint)
		{
			iScrHintHandler_Interface@ pHintHandler = cast<iScrHintHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_HintHandler));
			bool bConfigEnabled = cLux_GetUserConfig().GetBool("Gameplay", "ShowHints", true);
			pHintHandler.ForceEnabled(bConfigEnabled);
		}
		
		if (mData.mlFOVShakeId != -1)
		{
			Effect_FOV_Shake_FadeOut(mData.mlFOVShakeId, 1.0f);
			mData.mlFOVShakeId = -1;
		}
		
		if (FearHandler_GetIsPermaFailing() == false)
			FearHandler_FadeTentacleSizeAddTo(0.f, 5.f);
		
		///////////////////////////
		// Add fear level
		if (mData.mbIsPermaFailStruggle == false)
		{
			float fTime = mData.mfTimePassed - mData.mfTransitionTime;
			float fAdd = cMath_Easing(eEasing_QuadIn, fTime / mData.mfEventDuration) * 0.2f;			
			float fSpeed = 0.5f;
			
			if (mlActiveEventType == eStruggleEvent_Wraith)
			{
				if (mData.mfTimePassed < mData.mfTransitionTime - 0.2f)
				{
					fAdd = 0.1;
				}
				else
				{
					float fTimeMul = cMath_Clamp((mData.mfTimePassed - mData.mfTransitionTime) / (mData.mfEventDuration) * 0.4f, 0.0f, 1.0f);
					fAdd = 0.34f + fTimeMul * 0.2f;
				}
				fSpeed = 0.02f;
			}
			else if (mlActiveEventType == eStruggleEvent_Ghoul)
			{
				fAdd = mData.mfStruggleProgress >= 1 ? cMath_Max(0.7f - mData.mfPrevFear, 0.0f) : 1;
				fSpeed = 0.02f;
			}
			else if (mData.mfStruggleProgress <= -1.f) 
			{
				fAdd = 0.3f;
				fSpeed = 5.f;
			}

			float fTar = mData.mfPrevFear + fAdd;
			
			cLux_AddDebugMessage("[Struggle] Added " + fAdd + " total:" + fTar + " " + mData.mfTimePassed + " " +  mData.mfTransitionTime);
			FearHandler_FadeLevelTo(fTar, fSpeed, true);
		}
		
		if (mpActiveEvent.ShouldResetArmMaterial())
			GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetProgression(), 2.0f);
		if (mpActiveEvent.ShouldStopStruggleLoopSound())
			FearHandler_StopStruggleSoundLoop(1.5f);
		
		///////////////////////////
		// Leave state if no outro animation is to be played
		if (mpActiveEvent.ShouldPlayOutroAnim() == false)
			cLux_GetPlayer().ChangeState(ePlayerState_Normal);
				
		///////////////////////////
		// Callback
		if (mData.mfStruggleProgress >= 1.f)
		{
			// Won, good effects!
			mData.mlStruggleFailCount = 0;
			FearHandler_SetForcedAddFearRate(eFearForcedRateType_Struggle, 0.f, 1.f, false);
			
			PlayerEmotion_PlaySound(eEmotionPlaylistType_Breathing, eEmotionSoundType_OneShotEvent, 2, "player/vocalisations/fear/fear_scare");
				
			Effect_Rumble_Start(1.f, 0.75f, 0.1f, 0.5f);
						
			if (mData.mbIsPermaFailStruggle)
			{
				cScript_RunGlobalFunc("FearHandler", "", "PermaFailStruggle_Succeed");
			}
			else
			{
				tString sMethodName = "void " + mData.msSuccessCallback + "()";
				cLuxMap@ pMap = cLux_GetCurrentMap();
				if (pMap.ScriptMethodExists(sMethodName) && pMap.ScriptPrepare(sMethodName))
					pMap.ScriptExecute();	
			}
		}
		else if (mData.mfStruggleProgress <= -1.f)
		{
			// Lost, bad effects!
			++mData.mlStruggleFailCount;
			FearHandler_SetForcedAddFearRate(eFearForcedRateType_Struggle, 1.f, 5.f, false);
			
			PlayerEmotion_PlaySound(eEmotionPlaylistType_Breathing, eEmotionSoundType_OneShotEvent, 2, "player/UI/lucid_meter/ghoul_level_1");
			
			if (mData.mbIsPermaFailStruggle)
			{
				cScript_RunGlobalFunc("FearHandler", "", "PermaFailStruggle_Fail");
			}
			else
			{
				tString sMethodName = "void " + mData.msFailCallback + "()";
				cLuxMap@ pMap = cLux_GetCurrentMap();
				if (pMap.ScriptMethodExists(sMethodName) && pMap.ScriptPrepare(sMethodName))
					pMap.ScriptExecute();
			}
		}
		else
		{
			// Forced out of state through script
			FearHandler_SetForcedAddFearRate(eFearForcedRateType_Struggle, 0.f, 1.f, false);
		}
		
		mData.mbIsPermaFailStruggle = false;
	}
	
	//------------------------------------------------------------
	
	cStruggleEvent@ GetActiveEvent()
	{
		cStruggleEvent@ pActiveEvent = null;
		
		switch (mlActiveEventType)
		{
			case eStruggleEvent_MoveToward:		@pActiveEvent = mEvent_MoveToward; break;
			case eStruggleEvent_Animation:		@pActiveEvent = mEvent_Animation; break;
			case eStruggleEvent_Wraith:			@pActiveEvent = mEvent_Wraith; break;
			case eStruggleEvent_Stationary:		@pActiveEvent = mEvent_Stationary; break;
			case eStruggleEvent_Ghoul:			@pActiveEvent = mEvent_Ghoul; break;
			case eStruggleEvent_TinHinan:		@pActiveEvent = mEvent_TinHinan; break;
		}
		
		if (pActiveEvent !is null)		
			@pActiveEvent.mpData = mData;
		
		return pActiveEvent;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnAction(int alAction, bool abPressed)
	{
		////////////////////
		// Crouch
		if (alAction == eAction_Crouch)
		{
			if (abPressed && mData.mfTransition < 1.f)
				return true;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f&in avAmount)
	{
		if (mpActiveEvent is null) 
			return false;
		
		//////////////////
		// Setup
		cCamera@ pCam = mBaseObj.mpPlayer.GetCamera();
		iCharacterBody@ pBody = mBaseObj.mpPlayer.GetCharacterBody();
		
		//////////////////
		// Look
		if (alAnalogId == eAnalogType_Look)
		{
			cVector3f vLookAmount = mpActiveEvent.UpdateRightAxis(avAmount);
			
			float fMul = mData.mfLookMul;		
			vLookAmount = cMath_Vector3ClampLength(vLookAmount, 0.f, gfStruggleMaxRightAxisAmount);
			
			// Allow stronger look during transition
			if (mData.mfTransition < 1.f)	
			{
				float fDiff = mData.mfLookMul - gfStruggleTransitionLookMul;
				fMul = gfStruggleTransitionLookMul + fDiff * mData.mfTransition;
			}
		
			//////////////////	
			// Limit how far from the tar you can look			
			cVector3f vLookPos = mpActiveEvent.GetLookTargetPos();
			cVector3f vDir = cMath_Vector3Normalize(vLookPos - pCam.GetPosition());
			
			if (cMath_Vector3Dot(pCam.GetForward(), vDir) < gfStruggleMinDot)
				fMul = 0.f;
				
			//////////////////
			// Apply camera rot
			if (mlActiveEventType == eStruggleEvent_Animation || mlActiveEventType == eStruggleEvent_Ghoul)
			{
				iScrPlayerBodyHandler_Interface@ pPlayerBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
				pPlayerBody.Cutscene_AddYaw(avAmount.x * fMul);
				pPlayerBody.Cutscene_AddPitch(avAmount.y * fMul);
			}
			else
			{
				pBody.AddYaw(vLookAmount.x * -1.f * fMul);
				pCam.AddPitch(vLookAmount.y * -1.f * fMul);
			}
		}
		
		//////////////////
		// Move
		else if (alAnalogId == eAnalogType_Move || alAnalogId == eAnalogType_GamepadMove)
		{
			cVector3f vMoveAmount = mpActiveEvent.UpdateLeftAxis(avAmount);			
			
			// Allow movement during transition
			if (mData.mfTransition < 1.f && mData.mbEventStopped == false)
				vMoveAmount = avAmount;
				
			//////////////////
			// Apply movement
			if (cMath_Abs(vMoveAmount.x) > 0.001f)
				pBody.Move(eCharDir_Right, vMoveAmount.x);
			if (cMath_Abs(vMoveAmount.y) > 0.001f)
				pBody.Move(eCharDir_Forward, vMoveAmount.y);
		}
		
		return false;
	}
	
