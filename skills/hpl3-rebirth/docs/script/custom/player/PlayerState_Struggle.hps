	//------------------------------------------------------------
	
	int mlActiveEventType = -1;	
	cStruggleEvent_Data mData;
	cStruggleEvent_MoveToward mEvent_MoveToward;
	cStruggleEvent_Animation mEvent_Animation;
	cStruggleEvent_Wraith mEvent_Wraith;
	cStruggleEvent_TinHinan mEvent_TinHinan;
