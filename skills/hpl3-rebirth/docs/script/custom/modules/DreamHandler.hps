//----------------------------------------------------------------------------------------

class cFadingDreamBlurFx
{
	tString msEntName;
	float mfFadeTime;
	float mfBrightness;
	
	cFadingDreamBlurFx(){}
	
	cFadingDreamBlurFx(const tString&in asEntName, float afFadeTime)
	{
		if (afFadeTime<=0)
			afFadeTime = 9999999;
			
		mfFadeTime = afFadeTime;
		msEntName = asEntName;
		iLuxEntity@ pEnt = Map_GetEntity(msEntName, eLuxEntityType_Prop);
		if (pEnt==null) return;
		cBillboard@ pBillboard = pEnt.GetBillboardFromName("Billboard_1");
		if (pBillboard==null) return;
		mfBrightness = pBillboard.GetBrightness();
	}
	
	void OnUpdate(float afTimeStep)
	{
		iLuxEntity@ pEnt = Map_GetEntity(msEntName, eLuxEntityType_Prop);
		if (pEnt==null || pEnt.IsActive()==false) return;
		
		cBillboard@ pBillboard = pEnt.GetBillboardFromName("Billboard_1");
		if (pBillboard==null) return;
		
		mfBrightness = cMath_IncreaseTo(mfBrightness, 1/mfFadeTime * afTimeStep, 0);
		pBillboard.SetBrightness(mfBrightness);
		
		if (mfBrightness == 0)
			pEnt.SetActive(false);
	}
}

//----------------------------------------------------------------------------------------

class cScrDreamHandler : iScrUserModule, iScrUserModule_Interface, iScrDreamHandler_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init(){}
		
	//------------------------------------------------------------
	
	void LoadUserConfig(){}
	
	//------------------------------------------------------------
	
	void SaveUserConfig(){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------	
	
	void SetActive(const bool abActive)
	{
		mfOriginalRunSpeedMul = Player_GetRunSpeedMul();
		mfOriginalLookSpeedMul = Player_GetLookSpeedMul();
		
		mbActive = abActive;
		
		Player_SetCrouchDisabled(abActive);
		Player_SetCrouchActionDisabled(abActive);
		Player_SetJumpDisabled(abActive);

		if (abActive)
		{
			if (Sketchbook_IsOpen())
				Sketchbook_Close();
				
			float fFxFadeTime = 5.f;
			Player_FadeMoveSpeedMulTo(0.75f, 1.f, ePlayerMoveSpeedMulType_Dream);
			Player_FadeLookSpeedMulTo(0.75f, 1.f);
			Player_SetRunSpeedMul(0.f);
			
			Player_SetAllowCheckBaby(false);
			Amulet_SetInDreamSequence(true);
			
			if (mlIDImageTrail<0)
				mlIDImageTrail = Effect_ImageTrail_Start(0.7f,fFxFadeTime,-1,5);
			if (mlIDRadialBlur<0)
				mlIDRadialBlur = Effect_RadialBlur_Start(0.5f, 0.3f, 0.45f, fFxFadeTime);
                
            if (mlDreamDOF==-1)
                mlDreamDOF = Effect_DoF_Start(0.1f, 15.0f, 1.0f, fFxFadeTime);
				
            Item_PutAway(eItemHandlerHand_Left);
            Item_PutAway(eItemHandlerHand_Right);
		}
		else
		{
            float fFxFadeTime=0.f;
			Player_FadeMoveSpeedMulTo(1.f, 1.f, ePlayerMoveSpeedMulType_Dream);
			Player_FadeLookSpeedMulTo(mfOriginalLookSpeedMul, 1.f);
			Player_SetRunSpeedMul(mfOriginalRunSpeedMul);
			
			Player_SetAllowCheckBaby(true);
			Amulet_SetInDreamSequence(false);
			
			if (mlIDImageTrail >= 0)
			{
				Effect_ImageTrail_FadeOut(mlIDImageTrail, fFxFadeTime);
				mlIDImageTrail=-1;
			}
			
			if (mlIDRadialBlur >= 0)
			{
				Effect_RadialBlur_FadeOut(mlIDRadialBlur, fFxFadeTime);
				mlIDRadialBlur=-1;
			}
            
            if (mlDreamDOF>=0)
            {
                Effect_DoF_FadeOut(mlDreamDOF, fFxFadeTime);
                mlDreamDOF=-1;
            }
		}
	}
	
	//------------------------------------------------------------
	
	bool GetIsActive()
	{
		return mbActive;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap){}

	//------------------------------------------------------------

	void OnMapLeave(cLuxMap @apMap)
	{
		if (mbActive)
			SetActive(false);
	}
	
	//------------------------------------------------------------
	
	void PreloadData(cLuxMap @apMap){}
	
	//------------------------------------------------------------

	void CreateWorldEntities(cLuxMap @apMap){}
	
	//------------------------------------------------------------
	
	void DestroyWorldEntities(cLuxMap @apMap){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void PregnancyContractions()
	{
		if (mbContractionInProgress) return;
		
		mbContractionInProgress = true;
		
		Sound_CreateAtEntity("Sound_ContractionStinger_", "04_01_town/contraction_pain/contraction_pain_stingers", "player");
		
		//TODO: Replace with proper voices
		Sound_CreateAtEntity("Sound_ContractionVocal", "04_01_town/contraction_pain/contraction_pain_vocal", "player");
		cLux_AddTodoMessage("Replace temp sound with proper voices");
		
		Effect_ImageTrail_Start(2.f, 0.4f, 6.f, 4.f);
		Effect_Shake_Start(.005f, 1.f, 1.f , 0.5f);
		Effect_Rumble_Start(.2f, 3, 0, 0.1f);
		
		mBaseObj.Timer_Add("Timer_ContractionsStop", 2.f, "OnTimer_ContractionsStop");
		mBaseObj.Timer_Add("Timer_Contraction", 0.3f, "OnTimer_Contraction");
	}
	
	//-------------------------------------------------------
	
	void OnTimer_ContractionsStop(uint64 alTimer)
	{
		mbContractionInProgress = false;
	}
	
	//-------------------------------------------------------
	
	void OnTimer_Contraction(uint64 alTimer)
	{
		if (mbContractionInProgress==false) 
		{
			Effect_DollyZoom_Start(- 0.1, .3f, .4f, 5);
			return;
		}
		
		float fTime = .02f;
		float fFadeIn = .2f;
		float fFadeOut = .9f;
		Effect_Rumble_Start(1, fTime + fFadeIn, 0, 0.1f);
		Effect_DollyZoom_Start(cMath_RandRectf(-.15f,-0.05f), fTime, fFadeIn, fFadeOut);
		FearHandler_SetForcedAddFearRate(1, fTime + fFadeIn + fFadeOut, false, 3, 0.1f);
		
		float fTotalTime = fTime + fFadeIn + fFadeOut;
		mBaseObj.Timer_Add("Timer_Contraction", fTotalTime, "OnTimer_Contraction");
	}
		
	//------------------------------------------------------------
	
	void OnEnterContainer(const tString&in asOldContainer){}
	
	//------------------------------------------------------------
	
	void OnLeaveContainer(const tString&in asNewContainer){}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		if (mbActive==false) return;
		
		for (int i=0; i<mvFadingDreamBlurFx.size(); i++)
		{
			cFadingDreamBlurFx@ pFx = mvFadingDreamBlurFx[i];
			if (pFx==null) continue;
			pFx.OnUpdate(afTimeStep);
		}
	}
	
	//------------------------------------------------------------
	
	void FadeDreamBlurFx(const tString&in asEntity, const float afTime)
	{
		cFadingDreamBlurFx pFx = cFadingDreamBlurFx(asEntity, afTime);
		mvFadingDreamBlurFx.push_back(pFx);
	}
	
	//------------------------------------------------------------
	
	void VariableUpdate(float afDeltaTime){}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep){}
	
	//------------------------------------------------------------
	
	void Reset(){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed){}
	
	//------------------------------------------------------------

	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount){}
	
	//------------------------------------------------------------
	
	void OnExitPressed(){}
	
	//------------------------------------------------------------
	
	void AppGotInputFocus(){}
	void AppLostInputFocus(){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GUI
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnGui(float afTimeStep)
	{
        /////////////////////////
		// Bright Vignette Effect
        
		if (mbActive==false)
        {
            mbVignetteStartedFading=false;
            return;
        }
        
        float fVignetteDepth = 0.1f;
        if (mbVignetteStartedFading==false)
        {
            ImGui_SetStateFloat("VignetteAlpha", 0.f);
            ImGui_FadeStateFloat("VignetteAlpha", fVignetteDepth, 5.f, eEasing_Linear);
            mbVignetteStartedFading=true;
        }
        
		cImGuiGfx GfxBrightVignette("vignette_white_alpha", eImGuiGfx_Texture);
		GfxBrightVignette.mColor = cColor(1,1,1,ImGui_GetStateFloat("VignetteAlpha", fVignetteDepth));

		ImGui_DoImage(GfxBrightVignette, ImGui_FullScreenPos(1.0f), ImGui_FullScreenSize());
	}
	
	//-------------------------------------------------------
	
	void OnDraw(float afFrameTime){}
	
	//------------------------------------------------------------
	
	void OnPostRender(float afFrameTime){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbActive = false;
	int mlIDRadialBlur = -1;
	int mlIDImageTrail = -1;
    bool mbVignetteStartedFading = false;
    int mlDreamDOF=-1;
	
	bool mbContractionInProgress = false;
	float mfOriginalRunSpeedMul = 1.f;
	float mfOriginalLookSpeedMul = 1.f;
	
	array<cFadingDreamBlurFx> mvFadingDreamBlurFx;
	
	//------------------------------------------------------------
}