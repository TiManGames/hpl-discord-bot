#include "PlayerBodyHandler.hps"
#include "PlayerBodyAnimationStates_Custom.hps"
#include "helper_items.hps"
#include "helper_modules.hps"

//------------------------------------------------------------

class cScrPlayerBodyHandler_Custom : cScrPlayerBodyHandler, iScrPlayerBodyHandler_Custom_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init() override
	{
		cScrPlayerBodyHandler::Init();
		
		SetCustomAnimations();
		
		mCurrentAnimationState = ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_LastEnum);
		mPrevAnimationState = ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_LastEnum);
		mNextAnimationState = ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_LastEnum);
		mPendingState = ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_LastEnum);
		
		mbUnequipItemsOnCutscene = true;
	}
	
	//------------------------------------------------------------
	
	void PopulateStateList() override
	{
		cScrPlayerBodyHandler::PopulateStateList();
		
		mvAnimationStates.resize(ePlayerBodyAnimationState_Custom_LastEnum);
		@mvAnimationStates[ePlayerBodyAnimationState_Custom_SwimIdle] = mAnimationState_SwimIdle;
		@mvAnimationStates[ePlayerBodyAnimationState_Custom_SwimForward] = mAnimationState_SwimForward;
		@mvAnimationStates[ePlayerBodyAnimationState_Custom_SwimFastToSlowTr] = mAnimationState_SwimFastToSlow;
		@mvAnimationStates[ePlayerBodyAnimationState_Custom_SwimForwardSlow] = mAnimationState_SwimForwardSlow;
	}
	
	//------------------------------------------------------------
	
	//} END OF INIT
	
	/////////////////////////////////////////
	//MAP LOADING
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Reset()
	{
		cScrPlayerBodyHandler::Reset();
		
		SetCustomAnimations();
		
		mCurrentAnimationState = ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_LastEnum);
		mPrevAnimationState = ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_LastEnum);
		mNextAnimationState = ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_LastEnum);
		mPendingState = ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_LastEnum);
	}
	
	//------------------------------------------------------------
	
	void SetCustomAnimations()
	{
		mvAnimations.resize(ePlayerBodyAnimation_Custom_LastEnum);
		
		mvAnimations[ePlayerBodyAnimation_Custom_BirthIdle] = "player_birth_idle";
		mvAnimations[ePlayerBodyAnimation_Custom_BirthPush] = "player_birth_push";
		mvAnimations[ePlayerBodyAnimation_Custom_BirthRest] = "player_birth_rest_right";
		mvAnimations[ePlayerBodyAnimation_Custom_SwimIdle] = "player_swim_idle_tread";
		mvAnimations[ePlayerBodyAnimation_Custom_SwimForward] = "player_swim";
		mvAnimations[ePlayerBodyAnimation_Custom_SwimFastToSlow] = "player_swim_fast_to_slow";
		mvAnimations[ePlayerBodyAnimation_Custom_SwimForwardSlow] = "player_swim_slow_breaststroke";
	}
	
	//------------------------------------------------------------
	
	//} END OF MAP LOADING
		
	/////////////////////////////////////////
	// PER-FRAME
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	//} END OF PER-FRAME
	
	/////////////////////////////////////////
	// INTERFACE
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnReceivePlayerBodyMessage(int alMessageId, cLuxEntityMessageData @apData)
	{
		cScrPlayerBodyHandler::OnReceivePlayerBodyMessage(alMessageId, apData);
		
		iScrFearHandler_Interface @pFearHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
		pFearHandler.OnReceivePlayerBodyMessage(alMessageId, apData);
	}
	
	//------------------------------------------------------------
	
	void SetSwimStateActive(const bool abActive, const tString&in asStartPositionEntity, const tString&in asTargetEntity, const tString&in asWaterEntity, float afAnimBlendInTime)
	{
		if (abActive==false)
		{
            if (cLux_GetPlayer().GetCurrentMoveStateId()==eMoveState_Swim)
            {
                ChangeAnimationState(ePlayerBodyAnimationState_Idle);
                cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
                cLux_GetPlayer().ChangeState(ePlayerState_Normal);
            }
			return;
		}
		
		ChangeAnimationState(ePlayerBodyAnimationState(ePlayerBodyAnimationState_Custom_SwimIdle));
		cLux_GetPlayer().ChangeMoveState(eMoveState_Swim);
		
		cScript_SetGlobalArgString(0, asStartPositionEntity);
		cScript_SetGlobalArgString(1, asTargetEntity);
		cScript_SetGlobalArgString(2, asWaterEntity);
		cScript_SetGlobalArgFloat(3, afAnimBlendInTime);
		cScript_RunGlobalFunc("MoveState_Swim", "", "_Global_SetupSwim");
	}
    
    //------------------------------------------------------------
    
    void SetSwimBodyYaw(const float afAngle)
    {
        mAnimationState_SwimIdle.mfAngle = afAngle;
        mAnimationState_SwimForward.mfAngle = afAngle;
        mAnimationState_SwimForwardSlow.mfAngle = afAngle;
    }
	
	//------------------------------------------------------------
	
	void SetBirthIdleActive(const tString &in asTargetEntity, float afFadeTime)
	{
/*		cVector3f vPos;
		float fYaw;
		GetEntityPosAndYaw(asTargetEntity, vPos, fYaw);
		
		PlayerBody_StartCustomAnimation(mvAnimations[ePlayerBodyAnimation_Custom_BirthIdle], true, afFadeTime, true, vPos, fYaw, true);*/
	}
	
	//------------------------------------------------------------
	
	void SetBirthPushActive(const tString &in asTargetEntity)
	{
/*		cVector3f vPos;
		float fYaw;
		GetEntityPosAndYaw(asTargetEntity, vPos, fYaw);
		
		PlayerBody_StartCustomAnimation(mvAnimations[ePlayerBodyAnimation_Custom_BirthPush], true, 0.3, true, vPos, fYaw, true);*/
	}
	
	//------------------------------------------------------------
	
	void SetBirthRestActive(const tString &in asTargetEntity)
	{
/*		cVector3f vPos;
		float fYaw;
		GetEntityPosAndYaw(asTargetEntity, vPos, fYaw);
		
		PlayerBody_StartCustomAnimation(mvAnimations[ePlayerBodyAnimation_Custom_BirthRest], true, 0.3, true, vPos, fYaw, true);*/
	}
	
	//------------------------------------------------------------
	
	void PlayBirthAnimation(const tString &in asTargetEntity, const tString &in asAnimation, float afFadeTime, const tString &in asCallback)
	{
		cVector3f vPos;
		float fYaw;
		GetEntityPosAndYaw(asTargetEntity, vPos, fYaw);
		StartCustomAnimation(asAnimation, asCallback == "", afFadeTime, true, vPos, fYaw, true);
		
		//Hack since playing a custom animation will sometimes reset the player state
		cLux_GetPlayer().ChangeState(ePlayerState_Custom_Birth);
	
		SetLayerAnimationCallback(ePlayerBodyAnimationLayer_FullBody, asCallback);
	}
	
	//------------------------------------------------------------
	
	void SetUnequipItemsOnCutscene(bool abX)
	{
		mbUnequipItemsOnCutscene = abX;
	}
	
	//------------------------------------------------------------
	
	//} END OF INTERFACE
		
	/////////////////////////////////////////
	//	HELPER METHODS
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void GetEntityPosAndYaw(const tString &in asTargetEntity, cVector3f &out avPos, float &out afYaw)
	{
		cLuxProp@ pProp = cLux_ID_Prop(m_idBody);
		if (pProp !is null) pProp.SetRenderLayer(0);
		
		iLuxEntity @pEntity = cLux_GetCurrentMap().GetEntityByName(asTargetEntity);
		if(pEntity is null)
		{
			Error("Could not find entity '"+asTargetEntity+"' for SetBirthPushActive");
			return;
		}
		
		cMatrixf mtxEnt = pEntity.GetMatrix();
		avPos = mtxEnt.GetTranslation();
		
		cVector3f vFwd = mtxEnt.GetTranspose().GetForward();
		afYaw = 0;
		afYaw -= cMath_ATan2(vFwd.x, -vFwd.z);
	}
	
	//------------------------------------------------------------
	
	//} END OF HELPERS
		
	/////////////////////////////////////////
	// GLOBALS
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	//} END OF GLOBALS
	
	/////////////////////////////////////////
	// ACTIONS
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void AdditionalCutsceneSetup() override
	{
		cScrPlayerBodyHandler::AdditionalCutsceneSetup();
		
		if (mbUnequipItemsOnCutscene)
		{
			Item_PutAway(eItemHandlerHand_Left);
			Item_PutAway(eItemHandlerHand_Right);
		}
		
		mbUnequipItemsOnCutscene = true;
	}
	
	//------------------------------------------------------------
	
	//} END OF ACTIONS
	
	/////////////////////////////////////////
	// PROPERTIES
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbUnequipItemsOnCutscene;
	
	cPlayerBodyAnimationState_Custom_SwimIdle mAnimationState_SwimIdle;
	cPlayerBodyAnimationState_Custom_SwimForward mAnimationState_SwimForward;
	cPlayerBodyAnimationState_Custom_SwimFastToSlow mAnimationState_SwimFastToSlow;
	cPlayerBodyAnimationState_Custom_SwimForwardSlow mAnimationState_SwimForwardSlow;
	
	//------------------------------------------------------------
	
	//} END OF PROPERTIES	
}