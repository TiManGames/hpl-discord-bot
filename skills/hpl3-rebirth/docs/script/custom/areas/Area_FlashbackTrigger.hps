#include "interfaces/Area_Interface.hps"
#include "player/Player_Types.hps"
#include "helpers/helper_audio.hps"
#include "helpers/helper_player.hps"
#include "custom/helpers/helper_items.hps"
#include "custom/helpers/helper_modules_custom.hps"

float gfFlashbackTriggerDelay = 0.75;

class cScrAreaFlashbackTrigger : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		mBaseObj.SetCheckCollision(false);
		
		mbLookAt = apVars.GetVarString("TriggerType", "Look At") == "Look At";
		mbCheckLOS = apVars.GetVarBool("CheckLineOfSight", false);
		
		msMemory = apVars.GetVarString("MemoryName", "");
		msMemoryId = apVars.GetVarString("MemoryId", "");
		
		tString sImages = apVars.GetVarString("SketchImages", "");
		cString_GetStringVec(sImages, mvImages, " ");
		tString sTimes = apVars.GetVarString("SketchTimes", "1");
		cString_GetFloatVec(sTimes, mvTimes, " ");
		
		// Copy last value to match the number of entries in the two vectors.
		while (mvTimes.length() < mvImages.length())
			mvTimes.push_back(mvTimes[mvTimes.length()-1]);
			
		msSketchSubject = apVars.GetVarString("SketchSubject", "");
		msFlashbackSubject = apVars.GetVarString("FlashbackSubject", "");
			
		mBaseObj.SetForceLookAtCheck(true);
		mBaseObj.SetLookAtMaxDistance(apVars.GetVarFloat("MaxLookAtDistance", -1.0f));
		mfTriggerDelay = gfFlashbackTriggerDelay;
		mBaseObj.SetLookAtCheckCenterOfScreen(false);
	}
	
	//------------------------------------------------------------
		
	void OnAfterWorldLoad()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	float mfMemoryDisableDelay = -1;
	
	void OnVariableUpdate(float afDeltaTime)
	{
		if (Sketchbook_IsFlashbackActive() || Sketchbook_IsOpen())
			return;

		if (mbLookAt)
		{
			bool bPlayerLookAt = mBaseObj.IsLookedAtByPlayer();
			if (mbCheckLOS)
			{
				bPlayerLookAt = bPlayerLookAt && mBaseObj.CheckIsOnScreen(true);
			}
			
			// Delay trigger slightly so it's more likely player is really looking
			if (bPlayerLookAt)  mfTriggerDelay -= afDeltaTime;
			else 				mfTriggerDelay = gfFlashbackTriggerDelay;
			bPlayerLookAt = bPlayerLookAt && mfTriggerDelay <= 0;
			
			if (mbIsLookedAt == false && bPlayerLookAt)
			{
				TriggerMemory();
			}
			else if (mbIsLookedAt && bPlayerLookAt == false)
			{
				DisableMemory(5);
			}
			mbIsLookedAt = bPlayerLookAt;
		}
		else
		{
			bool bCollision = mBaseObj.CollidesWithPlayer();
			if (mbIsCollidedWith == false && bCollision)
			{
				TriggerMemory();
			}
			else if (mbIsCollidedWith && bCollision == false)
			{
				DisableMemory(5);
			}
			mbIsCollidedWith = bCollision;
		}
			
		if (mfMemoryDisableDelay > 0)
		{
			mfMemoryDisableDelay -= afDeltaTime;
			if (mfMemoryDisableDelay <= 0)
			{
				Sketchbook_DisableMemorySketch(msMemory);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void TriggerMemory()
	{
		Sketchbook_UnlockMemory(msMemoryId);
	}
	
	//------------------------------------------------------------
	
	void DisableMemory(float afDelay)
	{
		mfMemoryDisableDelay = afDelay;
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Default;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimeStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		if (abX==false)
		{

		}
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}

	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	array<tString> mvImages;
	array<float> mvTimes;
	bool mbLookAt = true;
	bool mbCheckLOS = false;
	tString msMemory = "";
	tString msMemoryId = "";
	tString msSketchSubject;
	tString msFlashbackSubject;
	
	bool mbIsLookedAt = false;
	bool mbIsCollidedWith = false;
	float mfTriggerDelay = 1;
	
	//------------------------------------------------------------
}	