	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars)
	{
		mbStarted = false;
		cLux_AddDebugMessage("[FearArea] SetupAfterLoad");
		
		mlPriority = apVars.GetVarInt("Priority", 0);
		mbSafe = apVars.GetVarBool("Safe", false);
		mfBabyKickRateMultiplier = cMath_Max(apVars.GetVarFloat("BabyKickRateMultiplier", 1), 0.001);
		mbLocked = apVars.GetVarBool("Locked", false);
		mbAllowProgressWithToken = apVars.GetVarBool("AllowProgressWithToken", true);
		mbAllowProgressWithoutToken = apVars.GetVarBool("AllowProgressWithoutToken", false);
		mlMaxProgressCount = apVars.GetVarInt("MaxProgressCount", 1);
		mlProgressAmount = apVars.GetVarInt("ProgressAmount", 1);
		msUnsafeMusic = apVars.GetVarString("UnsafeMusic", "");
		msSafeMusic = apVars.GetVarString("SafeMusic", "");
		mfNonAgentRateCap = apVars.GetVarFloat("NonAgentRateCap", 0.8f);
		mBaseObj.SetCheckCollision(false);
		mBaseObj.SetAutoSleep(false);
		
		mParams = cFearAreaParams();
		mParams.m_idArea = mBaseObj.GetID();
		mParams.msMap = mBaseObj.GetMap().GetName();
		mParams.mlPriority = mlPriority;
		mParams.mbSafe = mbSafe;
		mParams.mbNoFear = apVars.GetVarBool("NoFear", false);
		mParams.mbDarknessFear = apVars.GetVarBool("DarknessFear", true);
		mParams.mfBabyKickRateMultiplier = mfBabyKickRateMultiplier;
		mParams.mbLocked = mbLocked;
		mParams.msUnsafeMusic = msUnsafeMusic;
		mParams.msSafeMusic = msSafeMusic;
		mParams.mfNonAgentRateCap = mfNonAgentRateCap;
		mParams.mbAllowProgressWithToken = mbAllowProgressWithToken;
		mParams.mbAllowProgressWithoutToken = mbAllowProgressWithoutToken;
		mParams.mlMaxProgressCount = mlMaxProgressCount;
		mParams.mlProgressAmount = mlProgressAmount;
	}
	
	//------------------------------------------------------------
		
	void OnAfterWorldLoad()
	{
		cLux_AddDebugMessage("[FearArea] OnAfterWorldLoad");
		mbStarted = false;
		mBaseObj.SetAutoSleep(false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
//	bool OnUpdateAutoSleep()
//	{
//		return true;
//	}
	
	//------------------------------------------------------------
	
	bool mbStarted = false;
	
	void OnUpdate(float afTimeStep)
	{
//		cLux_AddDebugMessage("UP");
		if (FearHandler_IsInitialized() && mbStarted == false)
		{
			mbStarted = true;
			
			iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
			pHandler.RegisterFearArea(mParams);
			
			mBaseObj.SetAutoSleep(true);
			
			cLux_AddDebugMessage("[FearArea] RegisterFearArea " + mBaseObj.GetName());
		}
		else
		{
			mbStarted = false;
		}
	}
	
