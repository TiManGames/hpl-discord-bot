	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// POINTS OF INTEREST
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void RebuildPointsOfInterest()
	{
		mvInterestPoints.resize(0);
		
		tString sSearch = msInterestAreaName+"*";
		array<iLuxEntity@> vEntities;
		if (cLux_GetCurrentMap().GetEntityArray(sSearch, eLuxEntityType_Area, "", vEntities))
		{
			for (uint i=0; i<vEntities.length();++i)
			{
				mvInterestPoints.push_back(vEntities[i].GetID());
			}
			cLux_AddDebugMessage("We found " + mvInterestPoints.length() + " points of interest for " + mBaseObj.GetName());
		}
		else
		{
			Error("Could not find any points of interest for AISearchArea : " + mBaseObj.GetName());
		}
	}
	
	//-----------------------------------------------------------------------
	
	void NotifyAgentsOfPlayer()
	{
		cVector3f vAreaPos = mBaseObj.GetPosition();
		
		// Figure out how far it is to the ground
		float fDistance=0.0f;
		cVector3f vNormal;
		iPhysicsBody@ pHit = cLux_GetClosestBody(vAreaPos, cVector3f_Down, 100.0f, fDistance, vNormal);
		if (pHit is null)
		{
			Error("No ground under search area: " + mBaseObj.GetName());
		}
		else
		{
			float fGround = vAreaPos.y-fDistance;
			vAreaPos.y = fGround + 0.1f;
		}			
				
		cLuxEntityComponentIterator @pIt = cLux_GetCurrentMap().GetEntityComponentIterator(eComponentType_Custom_AIPlayerNotify);
		
		while (pIt.HasNext())
		{
			// Get next component
			iLuxEntityComponent @pComp = pIt.Next();
			iLuxEntity @pEnt = pComp.GetEntity();
			
			pEnt.SetVarString("DestinationSearchArea",mBaseObj.GetName());
			pEnt.BroadcastMessage(eCustomEntityMessage_PlayerInSearchArea, null, vAreaPos,0);
		}
	}
		
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		if (abX) return;
	}
	
