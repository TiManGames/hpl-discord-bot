#include "interfaces/Area_Interface.hps"
#include "custom/modules/ModuleInterfaces_Custom.hps"
#include "helpers/helper_areas.hps"
#include "helpers/helper_player.hps"
#include "helpers/helper_map.hps"
#include "helpers/helper_audio.hps"

class cScrAreaGhoulStalkCorner : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		msFirstDir = apVars.GetVarString("FirstCornerDirection", "Forward");
		msSecondDir = apVars.GetVarString("SecondCornerDirection", "Forward");
		
		mvFirstDir = GetDir(msFirstDir);
		mvSecondDir = GetDir(msSecondDir);
		
		mfFirstMaxDist = apVars.GetVarFloat("FirstDirectionMaxDistance", 0.0f);
		mfFirstMinDist = apVars.GetVarFloat("FirstDirectionMinDistance", 0.0f);
		mfSecondMaxDist = apVars.GetVarFloat("SecondDirectionMaxDistance", 0.0f);
		mfSecondMinDist = apVars.GetVarFloat("SecondDirectionMinDistance", 0.0f);
		
		msStartStalkCallback = apVars.GetVarString("OnStalkStart", "");
		
//		mBaseObj.SetCheckCollision(false);
	}
	
	//------------------------------------------------------------
		
	void OnAfterWorldLoad()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afDeltaTime)
	{
		if (mbStalkEventActive == false && mBaseObj.CheckIsOnScreen(true) && cScript_GetGlobalVarBool("02_04_living_quarters_stalking_cooldown") == false)
		{
			cVector3f vPlayerToAreaDir = mBaseObj.GetPosition() - Player_GetPosition();
			float fDist = vPlayerToAreaDir.Length();
			vPlayerToAreaDir.Normalize();
			
			bool bPlayerAlongFirstDir = cMath_Vector3Dot(vPlayerToAreaDir, mvFirstDir) < -0.8f && fDist <= mfFirstMaxDist && fDist >= mfFirstMinDist;
			bool bPlayerAlongSecondDir = cMath_Vector3Dot(vPlayerToAreaDir, mvSecondDir) < -0.8f && fDist <= mfSecondMaxDist && fDist >= mfSecondMinDist;
			if (bPlayerAlongFirstDir || bPlayerAlongSecondDir)
			{
				StartStalkEvent(bPlayerAlongSecondDir);
			}
		}
		
		if (mbMoving)
		{
			mfMoveTimer += afDeltaTime;
			if (mfMoveTimer > 1.0f)
			{
				mfMoveTimer = 1.0f;
				mbMoving = false;
				cScript_RunGlobalFunc(mBaseObj.GetName(), "cScrAreaGhoulStalkCorner", msMoveCallback);
			}
			float fMovePercent = cMath_Easing(eEasing_QuadInOut, mfMoveTimer / 1.0f, 0.0f, 1.0f);
			iLuxEntity@ pEnt = Map_GetEntity("ghoul_corner_stalk");
			pEnt.SetPosition(mvMoveFromPos * (1.0f - fMovePercent) + mvMoveToPos * fMovePercent);
			
			if (mbMoving == false)
			{
				mfMoveTimer = 0.0f;
			}
		}
		
		if (mbTrackingPlayer)
		{
			float fMoveAmount = cMath_Abs(mfMoveOutPlayerDistance - cMath_Vector3Dist(mBaseObj.GetPosition(), Player_GetPosition()));
			if (fMoveAmount >= 2.0f)
			{
				mbTrackingPlayer = false;
				
				mBaseObj.Timer_Remove(7);
				mBaseObj.Timer_Add(7, 0.2f, "Timer_MoveBack");
			}
		}
	}
	
	
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
