	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		mbOnceOnly = apVars.GetVarBool("OnceOnly",false);
		msOnUsedCallback = apVars.GetVarString("OnUsed","");
		mbRandomYaw = apVars.GetVarBool("RandomYaw",true);
		mbDefaultWakeUp = apVars.GetVarBool("DefaultWakeUp",true);
		mbUseRandomWakeUpAnim = apVars.GetVarBool("RandomWakeUpAnim", false);
		msWakeUpAnim = apVars.GetVarString("WakeUpAnim", "");
		
		mBaseObj.SetCheckCollision(false);
		mBaseObj.SetAutoSleep(true);
	}
	
