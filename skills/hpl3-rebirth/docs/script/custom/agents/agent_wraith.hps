	void ResetSoundHeard()
	{
		mlSoundHeard_Prio = -1;
	}
	
	//------------------------------------------------------------
	
	bool ShouldHearSound(cVector3f avPos, int alPrio, const tString &in asName = "")
	{
		float fVertFeetDist = cMath_Abs((mBaseObj.GetPosition().y - mBaseObj.GetCharBody().GetSize().y / 2.0f) - avPos.y);
		if (alPrio == 0 && mBaseObj.GetDistanceToPos(avPos) <= 4.0f && fVertFeetDist < 0.2f)
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Ignored sound because it was probably caused by us");
			return false;
		}
		
		if (alPrio > mlSoundHeard_Prio || (alPrio == mlSoundHeard_Prio && mBaseObj.Timer_Exists("SamePrioCooldown") == false))
		{
			mbSoundHeard_NonPlayer = cString_GetFirstStringPos(cString_ToLowerCase(asName), "footstep") < 0;
			if (mbSoundHeard_NonPlayer && GetPointInCrystalCustomFOV(avPos, 19, 0.8f)) return false;
			
			mBaseObj.Timer_Add("SamePrioCooldown", 0.5f, "");
			mvSoundHeard_Pos = avPos;
			mlSoundHeard_Prio = alPrio;
			
			// reset sound prio after a while, so we're not too focused on a single sound
			mBaseObj.Timer_Add("Timer_ResetSoundPrio", 4.0f, "OnTimer_ResetSoundPrio");
			
			// ignore first footstep
			if (mbSoundHeard_NonPlayer == false && asName != "FootstepLand")
			{
				mBaseObj.Timer_Remove("IgnoreFootstepsCooldown");
				mBaseObj.Timer_Add("IgnoreFootstepsCooldown", 1.5f, "OnTimer_IgnoreFootstepsCooldown");
				if (mlSoundHear_IgnoreFootstep < 1)
				{
					++mlSoundHear_IgnoreFootstep;
					return false;
				}
			}
			return true;
		}
		return false;
	}
	
	void OnTimer_IgnoreFootstepsCooldown(uint64 alID)
	{
		mlSoundHear_IgnoreFootstep = 0;
	}
	
	void OnTimer_ResetSoundPrio(uint64 alID)
	{
		mlSoundHeard_Prio = 0;
	}
	
	//------------------------------------------------------------
	
	//} END SOUND HEARD
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// STEALTH MODE
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbStealthModeActive = false;
	bool mbStealthEffects = false;
	bool mbStealthFast = false;
	bool mbStealthMode_AppearUseCustomDir = false;
	cVector3f mvStealthMode_AppearCustomDir;
	tID m_idStealthModePS = tID_Invalid;
	tID m_idStealthModeAppearPS = tID_Invalid;
	int mlStealthModePassThroughWallCount = 0;
	tString msStealthMode_AppearCallback;
	tString msStealthMode_DisappearCallback;
	tString msStealthMode_MapCallback;
	
	//------------------------------------------------------------
	
	void UpdateStealthMode(float afTimeStep)
	{
	}
		
	//------------------------------------------------------------
	
	void SetStealthModeActive(bool abX, bool abEffects = true, tString asCallback = "", bool abFast = false)
	{
		if (abX && mBaseObj.Timer_Exists("Timer_StealthModeDisappear")) return;
		if (abX == false && mBaseObj.Timer_Exists("Timer_StealthModeAppear")) return;
		if (abX == mbStealthModeActive) return;
		
//		cLux_AddDebugMessage(mBaseObj.GetName() + " SET STEALTH MODE " + abX);
		
		mbStealthEffects = abEffects;
		mbStealthFast = abFast;
		
		if (abX)
		{
			msStealthMode_DisappearCallback = asCallback == "" ? "StealthDisappear" : asCallback;
			mBaseObj.Timer_Remove("Timer_StealthModeAppear");
			if (mbStealthEffects)
			{
				cParticleSystem@ pPS = ParticleSystem_CreateAtEntity(mBaseObj.GetName() + "_stealth_mode", "dwf_wraith_stealth_disappear.ps", mBaseObj.GetName(), false);
				m_idStealthModePS = pPS.GetID();
				mBaseObj.Timer_Add("Timer_StealthModeDisappear", 0.3f, "OnTimer_StealthModeDisappear");
			}
			else
			{
				OnTimer_StealthModeDisappear(H64(""));
			}
			mbStealthMode_AppearUseCustomDir = false;
		}
		else
		{
			msStealthMode_AppearCallback = asCallback == "" ? "StealthAppear" : asCallback;
			mBaseObj.Timer_Remove("Timer_StealthModeDisappear");
			if (mbStealthEffects)
			{
				tString sParticle = "dwf_wraith_stealth_appear";
				if (mbStealthFast) sParticle = "dwf_wraith_stealth_appear_fast";
				
				cParticleSystem@ pPS = ParticleSystem_CreateAtEntity(mBaseObj.GetName() + "_stealth_mode_appear", sParticle, mBaseObj.GetName(), false);
				m_idStealthModeAppearPS = pPS.GetID();
				
				float fAppearTime = 2.0f;
				if (mbStealthFast) fAppearTime = 1.0f;
				else if (mAlert >= eWraithAlertState_Provoked) fAppearTime = 1.0f;
				mBaseObj.Timer_Add("Timer_StealthModeAppear", fAppearTime, "OnTimer_StealthModeAppear");
			}
			else
			{
				OnTimer_StealthModeAppear(H64(""));
			}
		}
	}
	
	//------------------------------------------------------------
	
	void OnTimer_StealthModeDisappear(uint64 alID)
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Enter stealth mode");
		mbStealthModeActive = true;
		
		mBaseObj.GetCharBody().SetCollideFlags(mBaseObj.GetMap().GetCollideFlag("+wraith"));
		mBaseObj.GetCharBody().SetActive(false);
		mBaseObj.GetMeshEntity().SetVisible(false);
		mpMover.SetWallAvoidanceActive(false);
		
		iLight@ pDarkLight = mBaseObj.GetLightFromName("Light_Point_1");
		if (pDarkLight !is null) pDarkLight.FadeBrightnessTo(0, 0.5f);
		
//		cParticleSystem@ pPS1 = mBaseObj.GetParticleSystemFromName("PS_1");
//		if (pPS1 !is null) pPS1.KillInstantly();
		
		cParticleSystem@ pPS2 = mBaseObj.GetParticleSystemFromName("PS_2");
		if (pPS2 !is null) pPS2.KillInstantly();
		
		SetSpotLightActive(false, false);
		ResetSpotlightDir();

		mpProximitySensor.ResetState(eWraithProximity_StealthSense);
		
		cParticleSystem@ pAppearPS = cLux_ID_ParticleSystem(m_idStealthModeAppearPS);
		if (pAppearPS !is null) pAppearPS.KillInstantly();
		
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_IdleLoop);
		if (pSound !is null) pSound.FadeVolumeMul(0.0f, 1.0f);
		
		cSoundEntry@ pStealthSound = cSound_GetEntry(gsWraithSound_StealthModeLoop);
		if (pStealthSound !is null) pStealthSound.FadeVolumeMulTo(1, 1);
		
		
		if (m_idSfx_SpotlightSound != tID_Invalid)
		{
			cLux_ID_SoundEntity(m_idSfx_SpotlightSound).FadeOut(1.0f);
			m_idSfx_SpotlightSound = tID_Invalid;
		}
		
		if (m_idSfx_SpotlightTurnSound != tID_Invalid)
		{
			cLux_ID_SoundEntity(m_idSfx_SpotlightTurnSound).FadeOut(1.0f);
			m_idSfx_SpotlightTurnSound = tID_Invalid;
		}
		
		if (mbStealthEffects)
		{
			mBaseObj.PlaySound("StealthAppear", gsWraithSound_StealthDisappear, true, true);
		}
		
		FearThreatAgent_SetComponentEnabled(mBaseObj.GetName(), false);
		mbFearComponentEnabled = false;

		mpStateMachine.AddTimer(msStealthMode_DisappearCallback, 0);
		ExecuteStealthModeMapCallback();
	}
	
	//------------------------------------------------------------
	
	void OnTimer_StealthModeAppear(uint64 alID)
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Exit stealth mode");
		mbStealthModeActive = false;
		
		mBaseObj.GetCharBody().SetCollideFlags(mBaseObj.GetMap().GetCollideFlag("-wraith"));
		mBaseObj.GetCharBody().SetActive(true);
		mBaseObj.GetMeshEntity().SetVisible(true);
		mpMover.SetWallAvoidanceActive(true);
		mbCrystal_PlayerDetected = false;
		
		mbSpotlight_ActivationReset = true;
		mlSpotlight_ActivationIndex = 0;
				
		iLight@ pDarkLight = mBaseObj.GetLightFromName("Light_Point_1");
		if (pDarkLight !is null) pDarkLight.FadeBrightnessToDefault(0.5f);
				
//		cParticleSystem@ pPS1 = mBaseObj.GetParticleSystemFromName("PS_1");
//		if (pPS1 !is null) pPS1.Restart();
				
		cParticleSystem@ pPS2 = mBaseObj.GetParticleSystemFromName("PS_2");
		if (pPS2 !is null) pPS2.Restart();
				
		SetSpotLightActive(true, true);
		ResetSpotlightDir();
		
		mfPlayerLookAtTimer = 0.0f;
				
		cParticleSystem@ pPS = cLux_ID_ParticleSystem(m_idStealthModePS);
		if (pPS !is null) pPS.KillInstantly();
		
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_IdleLoop);
		if (pSound !is null) pSound.FadeVolumeMul(1.0f, 1.0f);
				
		cSoundEntry@ pStealthSound = cSound_GetEntry(gsWraithSound_StealthModeLoop);
		if (pStealthSound !is null) pStealthSound.FadeVolumeMulTo(0, 1);

		if (mbStealthEffects)
		{
			mBaseObj.PlaySound("StealthAppear", gsWraithSound_StealthAppear, true, true);
			mBaseObj.PlaySound("StealthAppear", "creatures/vocalisations/creature/wraith/wraith_teleport_appear", true, true);
		}
		
		FearThreatAgent_SetComponentEnabled(mBaseObj.GetName(), true);
		mbFearComponentEnabled = true;
		
		mpStateMachine.AddTimer(msStealthMode_AppearCallback, 0);
		ExecuteStealthModeMapCallback();
	}
	
	//------------------------------------------------------------
	
	void AddPassThroughWall(int alState)
	{
		return;
		mlStealthModePassThroughWallCount += alState;
		if (mlStealthModePassThroughWallCount > 0)
		{
			SetStealthModeActive(true);
		}
		else
		{
			SetStealthModeActive(false);
		}
	}
	
	//------------------------------------------------------------
	
	void ExecuteStealthModeMapCallback()
	{
		if (msStealthMode_MapCallback == "") return;
		
		tString sMethodName = "void " + msStealthMode_MapCallback + "(const tString &in asEntity, bool abStealthActive)";
		cLuxMap@ pMap = mBaseObj.GetMap();
		if (pMap.ScriptMethodExists(sMethodName) && pMap.ScriptPrepare(sMethodName))
		{
			tString sName = mBaseObj.GetName();
			pMap.SetArgString(0, sName);
			pMap.SetArgBool(1, mbStealthModeActive);
			pMap.ScriptExecute();
		}
	}
	
	
	//------------------------------------------------------------
	
	//} END STEALTH MODE
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// FLY MODE
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbFlyMode_Active = false;
	bool mbFlyMode_Override = false;
	tID m_idFlyMode_FlySound = tID_Invalid;
	float mfFlyMode_AdjustSoundMulTimer = 0;
	float mfFlyMode_RadiusMul = 3;
	
	//------------------------------------------------------------
	
	void UpdateFlyMode(float afTimeStep)
	{
		if (mbFlyMode_Active == false) return;
		
		mfFlyMode_AdjustSoundMulTimer -= afTimeStep;
		if (mfFlyMode_AdjustSoundMulTimer < 0)
		{
			mfFlyMode_AdjustSoundMulTimer = cMath_RandRectf(0.2, 0.4);
			
			mfSoundRadiusMul = Player_IsInLiquid() ? mfFlyMode_RadiusMul * 0.5f : mfFlyMode_RadiusMul; 
			mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul);
		}
	}
	
	//------------------------------------------------------------
	
	void SetFlyModeActive(bool abX)
	{
		if (abX == mbFlyMode_Active) return;
		mbFlyMode_Active = abX || mbFlyMode_Override;
				
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		pCharBody.SetGravityActive(!mbFlyMode_Active);
		pCharBody.SetDeaccelerateMoveSpeedInAir(mbFlyMode_Active);
		pCharBody.SetForceVelocity(cVector3f_Zero);
//		pCharBody.SetTestCollision(!mbFlyMode_Active);
		pCharBody.SetEntityPitchAmount(mbFlyMode_Active ? 0 : 1);
		mpMover.SetUse3DMovement(mbFlyMode_Active);
		if (mbFlyMode_Active) SetupFlyWallAvoidance();
		else SetupGroundWallAvoidance();
		
//		mpMover.SetBankingActive(mbFlyMode_Active);
//		mpMover.SetBankingAngleMul(0.3f);
//		mpMover.SetBankingMaxAngle(cMath_ToRad(90));
//		mpMover.SetBankingSpeedMul(3.0f);
//		mpMover.SetBankingMaxSpeed(1.0f);
		
		mpMover.SetSpeedState(eWraithState_FlyToNode);
		
		mfSoundRadiusMul = mbFlyMode_Active ? mfFlyMode_RadiusMul : mfDefaultSoundRadiusMul;
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul);
		
		if (mbFlyMode_Active == false)
		{
			mpMover.GetCharBody().SetPitch(0.0f);
		}
	}
	
	//------------------------------------------------------------
	
	bool GetFlyNode(const cVector3f &in avPos, cVector3f &out avResult)
	{
		float fMinDist = -1;
		avResult = cVector3f_Zero;
		for (int i = 0; i < mvFlyToNode_Nodes.size(); ++i)
		{
			iLuxEntity@ pNode = cLux_ID_Entity(mvFlyToNode_Nodes[i]);
			if (pNode is null) continue;
			
			float fDist = cMath_Vector3DistSqr(pNode.GetPosition(), avPos);
			if (fMinDist < 0 || fDist < fMinDist)
			{
				fMinDist = fDist;
				avResult = pNode.GetPosition();
			}
		}
		
		if (fMinDist >= 0) return true;
		return false;
	}
	
	//------------------------------------------------------------
	
	//} END FLY MODE
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LINE OF SIGHT
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbPlayerCameraLineOfSight = false;
	bool mbOnScreen = false;
	int mlLosIndex = 0;
	int mlPlayerCamerLosCount = 0;
	int mlOnScreenCount = 0;
	
	//------------------------------------------------------------
	
	void UpdateLineOfSight(float afTimeStep)
	{
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		if (pCrystal !is null)
		{
			if (mlLosIndex == 0)
			{
				cVector3f vDir = cLux_GetPlayer().GetCamera().GetPosition() - pCrystal.GetPosition();
				mBaseObj.GetClosestCharCollideBody("OnRaycast_UpdateLineOfSight", pCrystal.GetPosition(), cMath_Vector3Normalize(vDir), vDir.Length(), mlLosIndex);
			}
			else if (mlLosIndex == 1)
			{
				cVector3f vPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
				cVector3f vDir = vPos - pCrystal.GetPosition();
				mBaseObj.GetClosestCharCollideBody("OnRaycast_UpdateLineOfSight", pCrystal.GetPosition(), cMath_Vector3Normalize(vDir), vDir.Length(), mlLosIndex);
			}
			
			++mlLosIndex;
			mlLosIndex %= 2;
		}		
	}
	
	//------------------------------------------------------------
	
	void OnRaycast_UpdateLineOfSight(bool abSuccesful, float afDistance, const cVector3f&in avNormal, iPhysicsBody@ apBody, int alUservalue)
	{
		if (abSuccesful == false)
		{
			++mlPlayerCamerLosCount;
			if (mBaseObj.CheckIsOnScreen(false)) ++mlOnScreenCount;
		}
		
		if (alUservalue == 1)
		{
			mbPlayerCameraLineOfSight = mlPlayerCamerLosCount > 0;
			mbOnScreen = mlOnScreenCount > 0;
			
			mlPlayerCamerLosCount = 0;
			mlOnScreenCount = 0;
		}
	}
	
	//------------------------------------------------------------
	
	//} END LINE OF SIGHT
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// BEAM SEEN
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbBeamSeen_RemoveAfter = true;
	bool mbBeamSeen_CenterRemoveAfter = true;
	bool mbBeamSeen_Seen = false;
	bool mbBeamSeen_ApplyFear = false;
	bool mbBeamSeen_CallbackSeen = false;
	bool mbBeamSeen_CenterCallbackSeen = false;
	float mfBeamSeen_Timer = 0.0f;
	float mfBeamSeen_CallbackTimer = 0.0f;
	float mfBeamSeen_CallbackDelay = 0.5f;
	float mfBeamSeen_CenterCallbackTimer = 0.0f;
	float mfBeamSeen_CenterCallbackDelay = 0.5f;
	
	//------------------------------------------------------------
	
	void UpdateBeamSeen(float afTimeStep)
	{
		if (msCallback_BeamCenterSeen == "" && msCallback_BeamSeen == "" && mbFearFromBeam == false) return;
		
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		if (pCrystal is null) return;
		
		if (mbCrystal_Active == false) return;
		
		float fRand = cMath_RandRectf(0.0f, 1.0f);
		cVector3f vPos = mvSpotlight_RaycastPos * fRand + pCrystal.GetPosition() * (1.0f - fRand);
		cVector3f vDir = vPos - cLux_GetPlayer().GetCamera().GetPosition();
		bool bOnScreen = cLux_GetPlayer().GetCamera().GetFrustum().CollidePoint(vPos);
				
		if (bOnScreen) mBaseObj.GetClosestBody("OnRaycast_UpdateBeamSeen", cLux_GetPlayer().GetCamera().GetPosition(), cMath_Vector3Normalize(vDir), vDir.Length(), 0);
		
		// beam los
		mfBeamSeen_Timer -= 2.0f * afTimeStep;
		mfBeamSeen_Timer = cMath_Clamp(mfBeamSeen_Timer, 0.0f, 1.0f);
		mbBeamSeen_Seen = mfBeamSeen_Timer > 0;
		
		// on screen callback
		if (msCallback_BeamSeen != "")
		{
			if (mbBeamSeen_Seen) mfBeamSeen_CallbackTimer += afTimeStep;
			else mfBeamSeen_CallbackTimer = 0;
			if (mfBeamSeen_CallbackTimer >= mfBeamSeen_CallbackDelay && mbBeamSeen_CallbackSeen == false)
			{
				mbBeamSeen_CallbackSeen = true;
				ExecuteStateCallback(msCallback_BeamSeen, 1);
				if (mbBeamSeen_RemoveAfter) msCallback_BeamSeen = "";
			}
			else if (mbBeamSeen_CallbackSeen && mbBeamSeen_Seen == false)
			{
				mbBeamSeen_CallbackSeen = false;
				ExecuteStateCallback(msCallback_BeamSeen, -1);
			}
		}
		
		// center callback
		if (msCallback_BeamCenterSeen != "")
		{
			if (mbBeamSeen_Seen)
			{
				float fAngle =cMath_ToDeg(cMath_Vector3Angle(cMath_Vector3Normalize(vDir), cLux_GetPlayer().GetCamera().GetForward()));
				if (fAngle <= 65)
				{
					float fAngleMul = (1.0f - cMath_Clamp(fAngle / 65, 0.0f, 1.0f)) * 2.0f - 1.0f;
					mfBeamSeen_CenterCallbackTimer += fAngleMul * afTimeStep * 1.5f;
				}
				else
				{
					mfBeamSeen_CenterCallbackTimer = 0;
				}
			}
			else
			{
				mfBeamSeen_CenterCallbackTimer = 0;
			}
			mfBeamSeen_CenterCallbackTimer = cMath_Clamp(mfBeamSeen_CenterCallbackTimer, 0.0f, mfBeamSeen_CenterCallbackDelay);
			
			if (mfBeamSeen_CenterCallbackTimer >= mfBeamSeen_CenterCallbackDelay && mbBeamSeen_CenterCallbackSeen == false)
			{
				mbBeamSeen_CenterCallbackSeen = true;
				ExecuteStateCallback(msCallback_BeamCenterSeen, 1);
				if (mbBeamSeen_CenterRemoveAfter) msCallback_BeamCenterSeen = "";
			}
			else if (mbBeamSeen_CenterCallbackSeen && mfBeamSeen_CenterCallbackTimer <= 0)
			{
				mbBeamSeen_CenterCallbackSeen = false;
				ExecuteStateCallback(msCallback_BeamCenterSeen, -1);
			}
		}
				
		mbBeamSeen_ApplyFear = mbFearFromBeam && mfBeamSeen_Timer > 0.25f;
	}
	
	//------------------------------------------------------------
	
	void OnRaycast_UpdateBeamSeen(bool abSuccesful, float afDistance, const cVector3f&in avNormal, iPhysicsBody@ apBody, int alUservalue)
	{
		if (abSuccesful == false) mfBeamSeen_Timer += 1.0f;
	}
	
	//------------------------------------------------------------
	
	//} END LINE OF SIGHT
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CUSTOM SPOTLIGHT FOLLOW
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void UpdateCustomSpotlightFollow(float afTimeStep)
	{
		if (m_idCrystal_FollowTarget == tID_Invalid) return;
		
		iLuxEntity@ pEnt = cLux_ID_Entity(m_idCrystal_FollowTarget);
		if (pEnt is null)
		{
			m_idCrystal_FollowTarget = tID_Invalid;
			return;
		}
		
		cVector3f vOffset = mvFollowTarget_Offset;
		if (mbFollowTarget_LocalOffset)
		{
			cLuxAgent@ pAgent = cLux_ToAgent(pEnt);
			if (pAgent !is null)
				vOffset = cMath_MatrixMul(cMath_MatrixRotateY(pAgent.GetCharBody().GetYaw() + cMath_Pi), vOffset);
			else
				vOffset = cMath_MatrixMul(pEnt.GetMatrix().GetRotation(), vOffset);
		}			
		
		cVector3f vPos = pEnt.GetPosition() + vOffset;		
		TurnSpotlightToPos(vPos, true, true, 10.f);
	}
	
	//------------------------------------------------------------
	
	//} END CUSTOM SPOTLIGHT FOLLOW
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CUSTOM PLAYER LOOK AT
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvLastPlayerGazePos = 0;
	bool mbLookedAtByPlayer = false;
	float mfPlayerLookAtTimer = 0;
	float mfPlayerLookAtTriggerTime = 1.75f;
	bool mbGazeDetection = true;
	float mfPlayerGazeFov = 1.0f;
	float mfPlayerGazeMaxFov = 0.7f;
	bool mbGazeWithoutEvent = false;
	bool mbPlayerLookingAtWraith = false;
	
	//------------------------------------------------------------
	
	void UpdateCustomPlayerLookAt(float afTimeStep)
	{
		return;
		
		bool bGazeActive = mbGazeDetection && 
							mbStealthModeActive == false &&
							mbTinHinanModeActive == false &&
							mbOnScreen &&
							(GetSensesActive() || mbGazeWithoutEvent) &&
							mpStateMachine.GetCurrentState() != eWraithState_Cooldown &&
							IsInsideGazeDistance() &&
							Player_GetHiding() == false &&
							IsInsideGazeCircle();

		if (bGazeActive)
		{
			mbLookedAtByPlayer = true;
			if (mbGazeWithoutEvent == false) mfPlayerLookAtTimer += afTimeStep;
			mfPlayerGazeFov = cMath_IncreaseTo(mfPlayerGazeFov, 0.1f * afTimeStep, mfPlayerGazeMaxFov);
			Player_StartLookAt(mBaseObj.GetName(), 0.8f, 1.0f, 0.8f, true);
			mvLastPlayerGazePos = mBaseObj.GetPlayerPos();			
			mbPlayerLookingAtWraith = true;
		}
		else
		{
			mbLookedAtByPlayer = false;
			mfPlayerLookAtTimer -= afTimeStep * 0.8;
			mfPlayerGazeFov = cMath_IncreaseTo(mfPlayerGazeFov, 0.5f * afTimeStep, 1.0f);
			
			if (mbPlayerLookingAtWraith)
			{
				Player_StopLookAt(1.0f);
				mbPlayerLookingAtWraith = false;
			}
		}
		
		cLux_GetPlayer().SetCameraFOVMul(ePlayerFOVMul_Wraith, mfPlayerGazeFov);
		
		float fTriggerTime = mfPlayerLookAtTriggerTime;
		if (mbFlyMode_Active) fTriggerTime *= 2.0f;
		mfPlayerLookAtTimer = cMath_Clamp(mfPlayerLookAtTimer, 0, fTriggerTime);
		if (mfPlayerLookAtTimer >= mfPlayerLookAtTriggerTime)
		{
			mbLookedAtByPlayer = false;
			mfPlayerLookAtTimer = 0;
			
			mBaseObj.BroadcastMessage(eCustomEntityMessage_PlayerGazeDetected, null, mBaseObj.GetPosition(), 0);
		}
		
	}
	
	bool IsInsideGazeDistance()
	{
		float fGazedDist = 20.0f;
		if (mbFlyMode_Active) fGazedDist = 15.0f;
		return mBaseObj.GetDistanceToPlayer() <= fGazedDist;
	}
	
	bool IsInsideGazeCircle()
	{
		cVector3f vAgentLeft = cMath_Vector3Normalize(cMath_Vector3Cross(cVector3f_Up, cVector3f_Zero - mBaseObj.GetPlayerDir()));
		array<cVector3f> vAgentPoints;
		vAgentPoints.push_back(mBaseObj.GetEyePostion());
		vAgentPoints.push_back(mBaseObj.GetPosition());
		vAgentPoints.push_back(mBaseObj.GetPosition() + cVector3f_Down * (mBaseObj.GetCharBody().GetSize().y / 2.0f -0.2f));
		vAgentPoints.push_back(mBaseObj.GetPosition() + vAgentLeft * 0.5f);
		vAgentPoints.push_back(mBaseObj.GetPosition() - vAgentLeft * 0.5f);
		
		cVector3f vLookAtDir = cLux_GetPlayer().GetCamera().GetForward();
		for (int i = 0; i < vAgentPoints.size(); ++i)
		{
			cVector3f vAgentDir = cMath_Vector3Normalize(vAgentPoints[i] - cLux_GetPlayer().GetCamera().GetPosition());
			float fAngle = cMath_Vector3Angle(vAgentDir, vLookAtDir);
			if (fAngle <= cMath_ToRad(40.0f)) return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	//} END CUSTOM PLAYER LOOK AT
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PLAYER DATA
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfPlayerAvgMovSpeed = 0;
	bool mbPlayerCrouching = false;
	float mfPlayerCrouchingTimer = 0;
	bool mbPlayerPermafailing = false;
	float mfPlayerPermafailingTimer = 0;
	
	//------------------------------------------------------------
	
	void UpdatePlayerData(float afTimeStep)
	{
		cVector3f vPlayerVel = Player_GetVelocity();
		vPlayerVel.y = 0;
		mfPlayerAvgMovSpeed = ((60 * mfPlayerAvgMovSpeed) + vPlayerVel.Length()) / 61;
		
		mfPlayerCrouchingTimer -= afTimeStep;
		if (mfPlayerCrouchingTimer < 0)
		{
			mfPlayerCrouchingTimer = cMath_RandRectf(0.1, 0.4);
			
			mbPlayerCrouching = Player_GetCrouching();
		}
		
		mfPlayerPermafailingTimer -= afTimeStep;
		if (mfPlayerPermafailingTimer < 0)
		{
			mfPlayerPermafailingTimer = cMath_RandRectf(0.1, 0.4);
			mbPlayerPermafailing = FearHandler_GetIsPermaFailing();
		}
	}
	
	//------------------------------------------------------------
	
	//} END PLAYER DATA
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// DIRECT MOVE TO
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbDirectMoveTo = false;
	bool mbDirectMoveTo_ThroughWall = false;
	cVector3f mvDirectMoveTo_Goal;
	cVector3f mvDirectMoveTo_ThroughWallGoal;
	
	//------------------------------------------------------------
	
	void MoveDirectlyTo(const cVector3f &in avPos)
	{
		mbDirectMoveTo = true;
		mvDirectMoveTo_Goal = avPos;
	}
	
	//------------------------------------------------------------
	
	void StopDirectMove()
	{
		mbDirectMoveTo = false;
	}
	
	//------------------------------------------------------------
	
	void UpdateDirectMoveTo(float afTimeStep)
	{
		if (mbDirectMoveTo == false) return;
		cVector3f vGoal = mvDirectMoveTo_Goal;
		if (mbDirectMoveTo_ThroughWall) vGoal = mvDirectMoveTo_ThroughWallGoal;
		mpMover.MoveToPos(vGoal, false);
		
		DrawTestPoint(vGoal, 0.2f);
		
		if (mbDirectMoveTo_ThroughWall == false && mBaseObj.GetDistanceToPos2D(mvDirectMoveTo_Goal) <= 1.0f)
		{
			mbDirectMoveTo = false;
			mBaseObj.BroadcastMessage(eCustomEntityMessage_DirectMoveToGoalReached, null, mBaseObj.GetPosition(), 0);
		}
		else if (mbDirectMoveTo_ThroughWall)
		{
			if (mBaseObj.GetDistanceToPos2D(mvDirectMoveTo_Goal) <= 2.0f)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Passed goal while going through wall, changing goal");
				mvDirectMoveTo_Goal = mvDirectMoveTo_ThroughWallGoal;
			}
			
			if (mBaseObj.GetDistanceToPos2D(mvDirectMoveTo_ThroughWallGoal) <= 1.0f)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Done moving through wall");
				mbDirectMoveTo_ThroughWall = false;
			}
		}
		else if (mbStealthModeActive && mbDirectMoveTo_ThroughWall == false)
		{
			cVector3f vRayFrom = mBaseObj.GetCharBody().GetPosition();
			vRayFrom.y -= (mBaseObj.GetCharBody().GetSize().y / 2.0f) - 0.1f;
			float fDist = 0;
			cVector3f vNrm;
			iPhysicsBody@ pBody = cLux_GetClosestCharCollideBody(vRayFrom, mBaseObj.GetCharBody().GetForward(), (mBaseObj.GetCharBody().GetSize().x / 2.0f) + 0.2f, fDist, vNrm);
			if (pBody !is null && pBody.GetCollideFlags() == mBaseObj.GetMap().GetCollideFlag("-wraith"))
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Move through wall");
				mbDirectMoveTo_ThroughWall = true;
				float fMoveDist = fDist + 2.5f + mBaseObj.GetCharBody().GetSize().x / 2.0f;
				mvDirectMoveTo_ThroughWallGoal = mBaseObj.GetPosition() + mBaseObj.GetCharBody().GetForward() * fMoveDist;
			}
		}
	}
	
	//------------------------------------------------------------
	
	//} END DIRECT MOVE TO
	
	/////////////////////////////////////////
	// IDLE AUDIO LOOP
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector2f mvIdleAudioLoop_TimeBetweenBarks = cVector2f(5, 10);
	float mfIdleAudioLoop_TimeSinceLastBark = 0;
	
	//------------------------------------------------------------
	
	void UpdateIdleAudioLoop(float afTimeStep)
	{
		mfIdleAudioLoop_TimeSinceLastBark -= afTimeStep;
		if (mfIdleAudioLoop_TimeSinceLastBark < 0)
		{
			mfIdleAudioLoop_TimeSinceLastBark = cMath_RandRectf(mvIdleAudioLoop_TimeBetweenBarks.x, mvIdleAudioLoop_TimeBetweenBarks.y);
			mBaseObj.PlaySound("IdleBark", "creatures/vocalisations/creature/wraith/wraith_ croak", true, true);
		}
	}
	
	//------------------------------------------------------------
	
	//} END IDLE AUDIO LOOP
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LANTERN DETECTION
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfGoboDetectionCounter = 0;
	float mfFlashlightDetectionCounter = 0;
	
	//------------------------------------------------------------
	
	void UpdateLanternDetection(float afTimeStep)
	{
		if (mfGoboDetectionCounter > 0.0f)
		{
			mfGoboDetectionCounter -= afTimeStep;
			mfGoboDetectionCounter = cMath_Clamp(mfGoboDetectionCounter, 0.0f, 1.0f);
		}
		
		if (mfFlashlightDetectionCounter > 0.0f)
		{
			mfFlashlightDetectionCounter -= afTimeStep;
			mfFlashlightDetectionCounter = cMath_Clamp(mfFlashlightDetectionCounter, 0.0f, 1.0f);
		}
	}
	
	//------------------------------------------------------------
	
	//} END LANTERN DETECTION
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// STUCK DETECTION
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void UpdateStuckDetection(float afTimeStep)
	{
		if (mpMover.GetStuckCounter() >= 0.85)
		{
			mBaseObj.BroadcastMessage(eCustomEntityMessage_StuckCounterHigh, null, mBaseObj.GetPosition(),0);
			mpMover.ResetStuckCounter();
		}
	}
	
	//------------------------------------------------------------
	
	//} END STUCK DETECTION
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DOOR DETECTION
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfDoorDetectionTimer = 0.0f;
	float mfDoorOpenTimer = 0.0f;
	bool mbDoorDetectionCheckPath = false;
	bool mbDoorInPath = false;
	array<cVector3f> mvDoorDetectionPathPoints;
	tID m_idDoorInPath = tID_Invalid;
	int mlDoorDetectionPathIndex = 0;
	
	//------------------------------------------------------------
	
	void UpdateDoorDetection(float afTimeStep)
	{
		if (mbDoorDetectionCheckPath)
		{		
			cVector3f vFrom;
			if (mlDoorDetectionPathIndex == 0)
			{
				vFrom = mBaseObj.GetCharBody().GetPosition();
				vFrom.y -= mBaseObj.GetCharBody().GetSize().y * 0.5f;
			}
			else
			{
				vFrom = mvDoorDetectionPathPoints[mlDoorDetectionPathIndex - 1];
			}
			vFrom.y += 0.4f;
			
			cVector3f vTo;
			if (mlDoorDetectionPathIndex == mvDoorDetectionPathPoints.size() - 1)
			{
				vTo = mpPathfinder.GetGoalPos();
			}
			else
			{
				vTo = mvDoorDetectionPathPoints[mlDoorDetectionPathIndex];
			}
			vTo.y += 0.4f;
			
			cVector3f vDir = vTo - vFrom;
			float fDist = 0;
			cVector3f vNrm;
			
			iPhysicsBody@ pBody = cLux_GetClosestBody(vFrom, cMath_Vector3Normalize(vDir), vDir.Length(), fDist, vNrm);
			if (pBody !is null)
			{
				iLuxEntity@ pEnt = cLux_GetBodyEntity(pBody);
				if (pEnt !is null && pEnt.GetIsDoor() && pEnt.GetIsClosedDoor())
				{
					mbDoorInPath = true;
					mbDoorDetectionCheckPath = false;
					m_idDoorInPath = pEnt.GetID();
					return;
				}
			}
						
			++mlDoorDetectionPathIndex;
			if (mlDoorDetectionPathIndex >= mvDoorDetectionPathPoints.size())
			{
				mbDoorInPath = false;
				if (mbDoorInPath == false) m_idDoorInPath = tID_Invalid;
				mbDoorDetectionCheckPath = false;
			}
		}
		else
		{
			mfDoorDetectionTimer -= afTimeStep;
			if (mfDoorDetectionTimer <= 0.0f)
			{
				mfDoorDetectionTimer = cMath_RandRectf(0.2, 0.4f);
				if (mpPathfinder.GetPathNodeCount() > 0)
				{
					mvDoorDetectionPathPoints.resize(0);
					for (int i = mpPathfinder.GetPathNodeCount() - 1; i >= 0; --i)
					{
						mvDoorDetectionPathPoints.push_back(mpPathfinder.GetPathNode(i).GetPosition());
					}
					mlDoorDetectionPathIndex = 0;
					mbDoorDetectionCheckPath = true;
				}
				else
				{
					mbDoorInPath = false;
				}
			}
		}
		
//		cLux_AddDebugMessage("HERE " + mbDoorInPath);
		
		if (mbDoorInPath)
		{
			mfDoorOpenTimer -= afTimeStep;
			if (mfDoorOpenTimer <= 0.0f)
			{
				mfDoorOpenTimer = cMath_RandRectf(0.1, 0.2f);
				
				iLuxEntity@ pDoor = cLux_ID_Entity(m_idDoorInPath);
				
				cVector3f vDoor = pDoor.GetPosition() - mBaseObj.GetPosition();
				if (vDoor.Length() <= 5.0f)
				{
					vDoor.y = 0;
					vDoor.Normalize();
					
					cVector3f vAgent = mBaseObj.GetCharBody().GetForward();
					vAgent.y = 0;
					vAgent.Normalize();
					
					
					float fAngle = cMath_Vector3Angle(vAgent, vDoor);
					if (fAngle <= cMath_ToRad(30))
					{
						mBaseObj.BroadcastMessage(eCustomEntityMessage_ApproachingClosedDoor, null, pDoor.GetPosition(), 0);
					}
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	//} END DOOR DETECTION
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CRYSTAL
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbCrystal_Active = false;
	bool mbCrystal_HelperActive = false;
	bool mbCrystal_HelperActivation = false;
	float mfCrystal_SightRange = gfWraithDefaultCrystalSightRange;
	float mfCrystal_SightRangeMul = gfWraithDefaultCrystalSightRangeMul;
	
	tID m_idCrystal;
	tID m_idCrystal_FollowTarget;
	[nosave] tString msCrystalModel = "wraith_crystal2.ent";
	eWraithLightMovement mSpotlightMovement = eWraithLightMovement_Forward;
	cVector3f mvCrystal_CurrentDir;
	cVector3f mvCrystal_TargetDir;
	float mfCrystal_TargetHAngle = 0;
	float mfCrystal_TargetVAngle = 0;
	float mfCrystal_CurrentVAngle = 0;
	float mfCrystal_CurrentHAngle = 0;
	bool mbCrystal_PlayerDetected = false;
	bool mbCrystal_PlayerSeen = false;
	bool mbCrystal_PrevPlayerSeen = false;
	int mlCrystal_PlayerPointSeenCount = 0;
	bool mbCrystal_Sight = true;
	bool mbCrystal_InternalSight = true;
	bool mbSpotlight_WhiteEffect = false;
	
	float mfSpotlight_MovementTimer = 0.0f;
	float mfSpotlight_DetectedTimer = 0.0f;
	float mfSpotlight_DetectedMul = 1.0f;
	
	float mfSpotlight_Fov = 14.f;
	float mfSpotlight_Aspect = 0.7f;
	float mfSpotlight_ShadowCasterDistance = 43;
	float mfSpotlight_ForwardOffsetH = 0;
	float mfSpotlight_ForwardOffsetTargetH = 0;
	float mfSpotlight_ForwardOffsetV = 0;
	float mfSpotlight_ForwardOffsetTargetV = 0;
	float mfSpotlight_FollowPositionH = 0;
	float mfSpotlight_FollowPositionTargetH = 0;
	float mfSpotlight_FollowPositionV = 0;
	float mfSpotlight_FollowPositionTargetV = 0;
	float mfSpotlight_AngleDiff = 0.0f;
	float mfSpotlight_TurningDoneMul = 1.0f;
	bool mbSpotlight_Turning = false;
	float mfSpotlight_TurnHTarget = 0;
	float mfSpotlight_TurnVTarget = 0;
	float mfSpotlight_TurnSpeed = 0;
	float mfSpotlight_LerpSpeed = 0;
	float mfSpotlight_LerpSpeedMul = 1.f;
	float mfSpotlight_LerpSpeedTransitionTimer = 0;
	int mlSpotlight_ActivationIndex = 0;
	bool mbSpotlight_ActivationReset = true;
	
	cVector3f mvSpotlight_RaycastPos;
	cVector3f mvLastPlayerSpotlightPos;
	cVector3f mvSpotlight_FollowPosition;
	
	cColor mSpotlightcolor;
	float mfSpotlightBrightnessMul = 1.0f;
	tID m_idSpotLight;
	tID m_idSpotLight_LensFlare;
	
	
	cColor mSpotlightColor_Idle = cColor(0.6, 0.8, 0.9)*0.7;
//	cColor mSpotlightColor_Alert = cColor(1, 0.8, 0.6)*0.7;
	cColor mSpotlightColor_Alert = cColor(0.6, 0.8, 0.9)*0.7;
	cColor mSpotlightColor_Struggle = cColor(1, 0.25, 0.3)*0.7;
	
	cColor mSpotlightColor_Check = cColor(0.3, 0.6, 1.0)* 0.4;
	cColor mSpotlightColor_Detected = cColor(1, 0.5, 0.35)*0.6;
	
	cColor mCrystal_DefaultEffectColor;
	
//	cColor mSpotlightColor_Idle = cColor(0.6, 0.8, 0.9)*0.85;
//	cColor mSpotlightColor_Alert = cColor(1, 0.8, 0.6);
//	cColor mSpotlightColor_Detected = cColor(1, 0.5, 0.35)*1.2;
//	cColor mSpotlightColor_Struggle = cColor(1, 0.25, 0.3)*1.5;
//	cColor mSpotlightColor_Check = cColor(0.3, 0.6, 1.4) * 0.25;

	//------------------------------------------------------------
	
	void CreateCrystal()
	{
		if (m_idCrystal != tID_Invalid) return;
		if (msCrystalModel == "") return;
		
		mBaseObj.GetMap().CreateEntity(mBaseObj.GetName() + "_crystal", msCrystalModel, cMatrixf_Identity, cVector3f_One);
				
		iLuxEntity@ pEnt = mBaseObj.GetMap().GetLatestEntity();
		if (pEnt is null) return;
						
		pEnt.AttachToSocket(cLux_ID_Entity(mBaseObj.GetID()), "wraith_crystal", false, true);
		m_idCrystal = pEnt.GetID();
		mCrystal_DefaultEffectColor = pEnt.GetEffectBaseColor();
		
		iLight@ pLight = pEnt.GetLightFromName("Light_Spot_1");
		if (pLight !is null) m_idSpotLight = pLight.GetID();
						
		cLightSpot@ pSpot = cast<cLightSpot>(cLux_ID_Light(m_idSpotLight));
		mfSpotlight_Aspect = pSpot.GetAspect();
		mfSpotlight_Fov = cMath_ToDeg(pSpot.GetFOV());
		mfSpotlight_ShadowCasterDistance = pSpot.GetShadowCasterDistance();
		
		cLensFlare@ pFlare = pEnt.GetLensFlareFromName("LensFlare_1");
		if (pFlare !is null) m_idSpotLight_LensFlare = pFlare.GetID();
		
		SetSpotLightActive(false, true);
		SetSpotLightColor(mSpotlightColor_Idle);

		mBaseObj.Timer_Remove("Timer_SetCrystalColor");
//		mBaseObj.Timer_Add("Timer_SetCrystalColor", 0.2f, "OnTimer_SetCrystalColor");
				
		mvCrystal_CurrentDir = mvCrystal_TargetDir = mBaseObj.GetCharBody().GetForward();
		TurnSpotlightToDir(mvCrystal_TargetDir, true, false);
	}
	
	void OnTimer_SetCrystalColor(uint64 alID)
	{
		if (m_idCrystal != tID_Invalid) cLux_ID_Entity(m_idCrystal).GetMeshEntity().SetIlluminationColor(cColor(1.0f,1.0f,1.0f) * 1.4f);
	}

	//------------------------------------------------------------
	
	void UpdateSpotlight(float afTimeStep)
	{
		if (m_idCrystal == tID_Invalid) return;
		
		if (mlSpotlight_ActivationIndex < 3)
		{
			++mlSpotlight_ActivationIndex;
			if (mlSpotlight_ActivationIndex == 3)
			{
				if (mbCrystal_HelperActivation)
				{
					mbCrystal_HelperActivation = false;
					mbCrystal_Active = mbCrystal_HelperActive;
				}
				
				SetSpotLightActive(mbCrystal_Active);
				if (mbSpotlight_ActivationReset) ResetSpotlightDir();
			}
		}
				
		///////////////////////////
		// Update movement
		iLuxEntity@ pEnt = cLux_ID_Entity(m_idCrystal);					
		if (mSpotlightMovement == eWraithLightMovement_Turn)
		{
			mfSpotlight_LerpSpeed = 4.0f * mfSpotlight_LerpSpeedMul;
			mfCrystal_TargetHAngle = cMath_IncreaseTo(mfCrystal_TargetHAngle, mfSpotlight_TurnSpeed * afTimeStep, mfSpotlight_TurnHTarget);
			mfCrystal_TargetVAngle = cMath_IncreaseTo(mfCrystal_TargetVAngle, mfSpotlight_TurnSpeed * afTimeStep, mfSpotlight_TurnVTarget);
		}
		else if (mSpotlightMovement == eWraithLightMovement_Forward)
		{
			mfSpotlight_LerpSpeed = 1.0f;
			
			cVector3f vForward = mBaseObj.GetCharBody().GetForward();
			vForward.y -= 0.15f;
			SetSpotlightTargetDir(vForward);
		}
		else if (mSpotlightMovement == eWraithLightMovement_ForwardOffset)
		{
			cVector3f vFwd = mBaseObj.GetCharBody().GetForward();
			vFwd.y = 0;
			
			mfSpotlight_LerpSpeed = 0.8f;
			GetSpotlightAngle(vFwd, mfCrystal_TargetHAngle, mfCrystal_TargetVAngle);
			mfSpotlight_ForwardOffsetH = cMath_IncreaseTo(mfSpotlight_ForwardOffsetH, 0.8f * afTimeStep, mfSpotlight_ForwardOffsetTargetH);
			mfSpotlight_ForwardOffsetV = cMath_IncreaseTo(mfSpotlight_ForwardOffsetV, 0.8f * afTimeStep, mfSpotlight_ForwardOffsetTargetV);
			mfCrystal_TargetHAngle = ClosestAngleToAngle(mfCrystal_TargetHAngle, mfCrystal_CurrentHAngle) + mfSpotlight_ForwardOffsetH;
			mfCrystal_TargetVAngle = ClosestAngleToAngle(mfCrystal_TargetVAngle, mfCrystal_CurrentVAngle) + mfSpotlight_ForwardOffsetV;
		}
		else if (mSpotlightMovement == eWraithLightMovement_FollowPosition)
		{
			mfSpotlight_LerpSpeed = 2.0f;
			GetSpotlightAngle(GetCrystalToPosDir(mvSpotlight_FollowPosition), mfSpotlight_FollowPositionTargetH, mfSpotlight_FollowPositionTargetH);
			mfSpotlight_FollowPositionTargetH = ClosestAngleToAngle(mfSpotlight_FollowPositionTargetH, mfCrystal_CurrentHAngle);
			mfSpotlight_FollowPositionTargetV = ClosestAngleToAngle(mfSpotlight_FollowPositionTargetV, mfCrystal_CurrentVAngle);
			mfSpotlight_FollowPositionH = cMath_IncreaseTo(mfSpotlight_FollowPositionH, 1.5f * afTimeStep, mfSpotlight_FollowPositionTargetH);
			mfSpotlight_FollowPositionV = cMath_IncreaseTo(mfSpotlight_FollowPositionV, 1.5f * afTimeStep, mfSpotlight_FollowPositionTargetV);
			mfCrystal_TargetHAngle = mfSpotlight_FollowPositionH;
			mfCrystal_TargetVAngle = mfSpotlight_FollowPositionV;
//			SetSpotlightTargetDir(GetCrystalToPosDir(mvSpotlight_FollowPosition));
		}
		else if (mSpotlightMovement == eWraithLightMovement_SidewaysEight)
		{
			
			mfSpotlight_LerpSpeed = 5.0f * mfSpotlight_SidewaysEightSpeed;
			mfSpotlight_MovementTimer += mfSpotlight_SidewaysEightSpeed * afTimeStep;
			
			cVector3f vForward = cVector3f_Zero;
			if (mbSpotlight_UseCustomTarget)
			{
				iLuxEntity@ pTargetEntity = cLux_ID_Entity(m_idSpotlight_TargetEntity);
				if (pTargetEntity !is null)
				{
					vForward = GetCrystalToPosDir(pTargetEntity.GetPosition());
				}
				else
				{
					vForward = GetCrystalToPosDir(mvSpotlight_CustomTarget);
				}
			}
			else
			{
				vForward = mBaseObj.GetCharBody().GetForward();
				vForward.y -= 0.15f;
			}
			
			vForward = GetLeminscateMovement(mfSpotlight_MovementTimer, vForward, mfSpotlight_SidewaysEightHMul, mfSpotlight_SidewaysEightVMul);
			SetSpotlightTargetDir(vForward);
		}
		else if (mSpotlightMovement == eWraithLightMovement_Scan)
		{
			mfSpotlight_LerpSpeed = 1.0f;
			mfSpotlight_MovementTimer += mfSpotlight_ScanSpeed * afTimeStep;
			
			cVector3f vForward = mvSpotlight_ScanDir;
			vForward = GetScanMovement(mfSpotlight_MovementTimer, vForward, mfSpotlight_ScanHMul, mfSpotlight_ScanVMul);
			SetSpotlightTargetDir(vForward);
		}
		else if (mSpotlightMovement == eWraithLightMovement_LeftToRight)
		{
			mfSpotlight_LerpSpeed = 5.0f;
			mfSpotlight_MovementTimer += mfSpotlight_LeftRightSpeed * afTimeStep;
			
			cVector3f vForward = mBaseObj.GetCharBody().GetForward();
			
			cQuaternion q;
			q.FromAngleAxis(-cMath_ToRad(mfSpotlight_LeftRightAngle), mBaseObj.GetCharBody().GetRight());
			
			vForward = cMath_MatrixMul(cMath_MatrixQuaternion(q), vForward);
			
			vForward = GetLeftAndRightMovement(mfSpotlight_MovementTimer, vForward, mfSpotlight_LeftRightHMul);
			SetSpotlightTargetDir(vForward);
		}
		else if (mSpotlightMovement == eWraithLightMovement_FollowEntity)
		{
			mfSpotlight_LerpSpeed = 1.0f;
			iLuxEntity@ pTargetEntity = cLux_ID_Entity(m_idSpotlight_FollowEntity);
			if (pTargetEntity !is null)
			{
				cVector3f vForward = GetCrystalToPosDir(pTargetEntity.GetPosition());
				SetSpotlightTargetDir(vForward);
			}
			else
			{
				mSpotlightMovement = eWraithLightMovement_None;
			}
		}
		
		///////////////////////////
		// Update current angles
		float fLerpSpeed = mfSpotlight_LerpSpeed;
		if (mfSpotlight_LerpSpeedTransitionTimer > 0.0f)
		{
			mfSpotlight_LerpSpeedTransitionTimer -= afTimeStep;
			float fTransitionMul = 1.0f - cMath_Clamp(mfSpotlight_LerpSpeedTransitionTimer / 3.0f, 0.0f, 1.0f);
			fLerpSpeed *= ((fTransitionMul * 0.8f) + 0.2f);
		}
				
		mfCrystal_CurrentHAngle += (mfCrystal_TargetHAngle - mfCrystal_CurrentHAngle) * fLerpSpeed * afTimeStep;
		mfCrystal_CurrentVAngle += (mfCrystal_TargetVAngle - mfCrystal_CurrentVAngle) * fLerpSpeed * afTimeStep;
						
		float fAbs = cMath_Abs(mfCrystal_CurrentHAngle);
		if (fAbs > cMath_ToRad(180.0f))
		{
			float fBefore = mfCrystal_CurrentHAngle;
			mfCrystal_TargetHAngle += mfCrystal_CurrentHAngle > 0 ? -cMath_ToRad(360.0f) : cMath_ToRad(360.0f);
			mfSpotlight_TurnHTarget += mfCrystal_CurrentHAngle > 0 ? -cMath_ToRad(360.0f) : cMath_ToRad(360.0f);
			mfCrystal_CurrentHAngle += mfCrystal_CurrentHAngle > 0 ? -cMath_ToRad(360.0f) : cMath_ToRad(360.0f);
		}
		
		///////////////////////////
		// Turning done? Send message!
		if (mSpotlightMovement == eWraithLightMovement_Turn)
		{
			float fAngleDiff = cMath_Abs(mfSpotlight_TurnHTarget - mfCrystal_CurrentHAngle) + cMath_Abs(mfSpotlight_TurnVTarget - mfCrystal_CurrentVAngle);
			if (fAngleDiff <= cMath_ToRad(5.0f) * mfSpotlight_TurningDoneMul)
			{
				mSpotlightMovement = eWraithLightMovement_None;
				mBaseObj.BroadcastMessage(eCustomEntityMessage_SpotlightTurnDone, null, mBaseObj.GetPosition(), 0);
			}
		}
			
		///////////////////////////
		// Calculate new rot
		cQuaternion q1;
		q1.FromAngleAxis(-mfCrystal_CurrentHAngle + cMath_Pi, cVector3f_Up);
		
		cVector3f vForward = cMath_MatrixMul(cMath_MatrixQuaternion(q1), cVector3f_Forward);
		vForward.Normalize();
		
		cVector3f vLeft = cMath_Vector3Cross(vForward, cVector3f_Up);
		vLeft.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vLeft, vForward);
		vLeft.Normalize();
		
		cQuaternion q2;
		q2.FromAngleAxis(mfCrystal_CurrentVAngle, vLeft);
		
		cQuaternion q3 = q2 * q1;
		
		cMatrixf mtxNew = pEnt.GetMatrix();
		mtxNew.SetRotation(cMath_MatrixQuaternion(q3));
		
		pEnt.SetMatrix(mtxNew);
		
		mvCrystal_CurrentDir = pEnt.GetMatrix().GetTranspose().GetForward();
		
		// Cast ray and find where the spotlight hits an object
		/*if (msCallback_BeamSeen != "" || msCallback_BeamCenterSeen != "" || mbFearFromBeam)*/ mBaseObj.GetClosestBody("OnRaycast_FindSpotlightHit", pEnt.GetPosition(), mvCrystal_CurrentDir, mfCrystal_SightRange * mfCrystal_SightRangeMul);
		
//		DrawLosDebug();
		mlCrystal_PlayerPointSeenCount = 0;
		mbCrystal_PrevPlayerSeen = mbCrystal_PlayerSeen;
		mbCrystal_PlayerSeen = mbTerror_Seen = GetPlayerIsSeen();
		
		///////////////////////////
		// Custom code for spotting player while in State_TinHinan
		if (mbTinHinanModeActive)
		{
			mbTinHinan_PlayerSeen = mbCrystal_PlayerSeen && mbCrystal_Active;			
			mbCrystal_PlayerSeen = mbTerror_Seen = false;
		}			
											
		float fDetectionAdd = 0.0f;
		if (mbCrystal_PlayerSeen)
		{
			float fCrouchMul = mbPlayerCrouching ? 0.7 : 1.0f;
			fDetectionAdd = 1.6f * fCrouchMul;
			if (mAlert >= eWraithAlertState_Searching) fDetectionAdd = 2.5f * fCrouchMul;
			else if (Player_GetHiding()) fDetectionAdd = 0.6f;
		}
		else fDetectionAdd = -0.8f;
						
		mfSpotlight_DetectedTimer += fDetectionAdd * mfSpotlight_DetectedMul * afTimeStep;
		mfSpotlight_DetectedTimer = cMath_Clamp(mfSpotlight_DetectedTimer, 0.0f, 1.0f);
		
//		cLux_AddDebugMessage("A " + mfSpotlight_DetectedTimer + " " + mbCrystal_Sight);
		
		if (mbCrystal_Sight && mbCrystal_PlayerDetected == false && mfSpotlight_DetectedTimer >= 1.0f)
		{
			mbCrystal_PlayerDetected = true;
			if (GetSensesActive()) mBaseObj.BroadcastMessage(eLuxEntityMessage_PlayerDetected, null, mBaseObj.GetPlayerPos(), 0);
		}
		else if (mbCrystal_Sight && mbCrystal_PlayerDetected && mfSpotlight_DetectedTimer < 0.8f)
		{
			mbCrystal_PlayerDetected = false;
			if (GetSensesActive()) mBaseObj.BroadcastMessage(eLuxEntityMessage_PlayerUndetected, null, mBaseObj.GetPlayerPos(), 0);
		}
		
		// white screen effect for when you're in the beam
		if (mbCrystal_PlayerDetected && mbSpotlight_VisualsActive && mbSpotlight_WhiteEffect == false)
		{
			mbSpotlight_WhiteEffect = true;
			Blackboard_AddWraithDetectingPlayer(mBaseObj.GetID());
		}
		else if ((mbCrystal_PlayerDetected == false || mbSpotlight_VisualsActive == false) && mbSpotlight_WhiteEffect)
		{
			mbSpotlight_WhiteEffect = false;
			Blackboard_RemoveWraithDetectingPlayer(mBaseObj.GetID());
		}
		
		if (mbCrystal_PlayerDetected) mvLastPlayerSpotlightPos = mBaseObj.GetPlayerPos();
	}
	
	void OnRaycast_FindSpotlightHit(bool abSuccesful, float afDistance, const cVector3f&in avNormal, iPhysicsBody@ apBody, int alUserValue)
	{
		if (abSuccesful) mvSpotlight_RaycastPos = GetCrystalPos() + mvCrystal_CurrentDir * afDistance;
		else mvSpotlight_RaycastPos = GetCrystalPos() + mvCrystal_CurrentDir * mfCrystal_SightRange * mfCrystal_SightRangeMul;
	}
	
	//------------------------------------------------------------
	
	bool GetPlayerIsSeen()
	{
		if (mbCrystal_InternalSight == false) return false;
		if (mbPlayerCameraLineOfSight == false) return false;
		if (mbTinHinanModeActive == false && GetSensesActive() == false) return false;
		if (mbStealthModeActive) return false;
		if (GetCrystalToPos(mBaseObj.GetPlayerPos()).Length() > mfCrystal_SightRange * mfCrystal_SightRangeMul) return false;
		if (GetPointIsInFrontOfCrystal(mBaseObj.GetPlayerPos()) == false) return false;
		if (GetPointInCystalFOV(mBaseObj.GetPlayerPos()) == false) return false;
		return true;
	}
	
	void DrawLosDebug()
	{
		cVector3f vMiddle = cLux_GetPlayer().GetCharacterBody().GetPosition();
		cVector3f vToCam = cLux_GetPlayer().GetCamera().GetPosition() - vMiddle;
		cVector3f vBetterCam = vMiddle + cMath_Vector3ProjectOnPlane(vToCam, cLux_GetPlayer().GetCharacterBody().GetForward()) * 0.9f;
		cVector3f vFeet = cLux_GetPlayer().GetCharacterBody().GetFeetPosition() + cVector3f_Up * 0.1f;
		
		DrawTestPoint(vBetterCam, cEngine_GetStepSize() + 0.01f);
		DrawTestPoint(vFeet, cEngine_GetStepSize() + 0.01f);
		DrawTestPoint(vMiddle, cEngine_GetStepSize() + 0.01f);
		DrawTestRay(GetCrystalPos(), vBetterCam, cEngine_GetStepSize() + 0.01f);
		DrawTestRay(GetCrystalPos(), vFeet, cEngine_GetStepSize() + 0.01f);
		DrawTestRay(GetCrystalPos(), vMiddle, cEngine_GetStepSize() + 0.01f);
	}
	
	//------------------------------------------------------------
	
	bool GetPointIsInFrontOfCrystal(const cVector3f &in avPoint)
	{
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		if (pCrystal is null) return false;
		
		cVector3f vToPoint = GetCrystalToPos(avPoint);
		float fDot = cMath_Vector3Dot(vToPoint, pCrystal.GetMatrix().GetTranspose().GetForward());
		return fDot >= 0.0;
	}
	
	//------------------------------------------------------------
	
	bool GetPointInCystalFOV(const cVector3f &in avPoint)
	{
		return GetPointInCrystalCustomFOV(avPoint, mfSpotlight_Fov, mfSpotlight_Aspect);
	}
	
	//------------------------------------------------------------
	
	bool GetPointInCrystalCustomFOV(const cVector3f &in avPoint, float afFov, float afAspect)
	{
		iLight @ pEnt = cLux_ID_Light(m_idSpotLight);
		if (pEnt is null) return false;
		
		cVector3f vPointDir = cMath_Vector3Normalize(avPoint - pEnt.GetWorldPosition());
		cVector3f vPosDirV = cMath_Vector3ProjectOnPlane(vPointDir, pEnt.GetWorldMatrix().GetTranspose().GetRight());
		cVector3f vPosDirH = cMath_Vector3ProjectOnPlane(vPointDir, pEnt.GetWorldMatrix().GetTranspose().GetUp());
		float fVAngle = cMath_Vector3Angle(cVector3f_Zero - pEnt.GetWorldMatrix().GetTranspose().GetForward(), cMath_Vector3Normalize(vPosDirV));
		float fHAngle = cMath_Vector3Angle(cVector3f_Zero - pEnt.GetWorldMatrix().GetTranspose().GetForward(), cMath_Vector3Normalize(vPosDirH));
		return fVAngle <= cMath_ToRad(afFov + 2.f) * 0.5f && fHAngle <= cMath_ToRad((afFov + 2.f) * afAspect) * 0.5f;
	}
	
	//------------------------------------------------------------
	
	float NormalizeAngle(float afAngle)
	{
		afAngle %= cMath_PiMul2;
		if (afAngle > cMath_Pi) return afAngle - cMath_PiMul2;
		else if (afAngle < -cMath_Pi) return afAngle + cMath_PiMul2;
		else return afAngle;
	}
	
	//------------------------------------------------------------
	
	float ClosestAngleToAngle(float afAngle, float afToAngle)
	{
		float fDist1 = cMath_Abs(afToAngle - afAngle);
		float fDist2 = cMath_Abs(afToAngle - (afAngle + cMath_PiMul2));
		float fDist3 = cMath_Abs(afToAngle - (afAngle - cMath_PiMul2));
		if (fDist2 <= fDist1 && fDist2 <= fDist3) return afAngle + cMath_PiMul2;
		if (fDist3 <= fDist1 && fDist3 <= fDist2) return afAngle - cMath_PiMul2;
		return afAngle;
	}
	
	//------------------------------------------------------------
	
	void ResetCrystalDetection()
	{
		mbCrystal_PlayerDetected = false;
		mfSpotlight_DetectedTimer = 0;
		Blackboard_RemoveWraithDetectingPlayer(mBaseObj.GetID());
	}
	
	//------------------------------------------------------------
	
	array<cWraithSpotlightBillboard> mvSpotlightBillboards;
	int mlSpoltightBillboard_MaxCount = 42;
	int mlSpoltightBillboard_Quality = 2;
	float mfSpotlightBillboard_Speed = 2.5f;
	float mfSpotlightBillboard_PerFrame = 1.0f;
	float mfSpotlightBillboard_Timer = 0.0f;
	float mfSpotlightBillboard_Width = 0.8f;
	int mlSpoltightBillboard_RaycastIndex = 0;
	bool mbSpotlightBillboard_Active = false;
	bool mbSpotlightBillboard_Init = false;
	float mfSpotlightBillboard_ExtraLength = 0;
	float mfSpotlightBillboard_StartOffset = 0;
	float mfSpotlightBillboard_BrightnessMul = 1.f;
	cVector2f mvSpotlightBillboard_RangeMin = cVector2f(-1,-1);
	cVector2f mvSpotlightBillboard_RangeMax = cVector2f(-1,-1);
	tID m_idSpotlightPS = tID_Invalid;
	tID m_idSpotlightSuctionPS = tID_Invalid;
	bool mbSuctionVisible = false;
	tString msSpotlightBillboard_GroupNormal = "";
	tString msSpotlightBillboard_GroupAnim = "";
	array<tString> mvSpotlightBillboard_NormalMaterials = { "wraith_beam_shards_01.mat", "wraith_beam_shards_02.mat", "wraith_beam_shards_03.mat", "wraith_beam_shards_04.mat" };
	tString msSpotlightBillboard_AlertMaterial = "wraith_beam_shards.mat";
	
	void InitSpotlightBillboards()
	{
		if (mbSpotlightBillboard_Init) return;
		mbSpotlightBillboard_Init = true;
		
		for (int i = 0; i < mvSpotlightBillboards.size(); ++i)
		{
			cWraithSpotlightBillboard@ pBillboard = mvSpotlightBillboards[i];
			cBillboard@ pEnt = mBaseObj.GetMap().GetWorld().GetBillboardFromID(pBillboard.m_idBillboard);
			pEnt.SetActive(false);
			pEnt.SetVisible(false);
		}
		mvSpotlightBillboards.resize(0);
		
		array<tID> vBillboards;
		Blackboard_GetWraithBillboards(mBaseObj.GetID(), mlSpoltightBillboard_MaxCount, vBillboards);
		
		cBillboard@ pBillboard;
		for (int i = 0; i < vBillboards.size(); ++i)
		{
			@pBillboard = cLux_ID_Billboard(vBillboards[i]);
			cWraithSpotlightBillboard newBillboard;
			newBillboard.m_idBillboard = pBillboard.GetID();
			newBillboard.mfMaxBrightness = 0.85f;
			mvSpotlightBillboards.push_back(newBillboard);
		}
	}
	
	void UpdateSpotlightBillboards(float afTimeStep)
	{
		if (mbSpotlightBillboard_Active)
		{
			mfSpotlightBillboard_Timer += mfSpotlightBillboard_PerFrame * afTimeStep;
			if (mfSpotlightBillboard_Timer >= cEngine_GetStepSize())
			{
				mfSpotlightBillboard_Timer -= cEngine_GetStepSize();
				
				int lRaycastCount = 1;
				if (mfSpotlightBillboard_PerFrame > 1) lRaycastCount = cMath_FloorToInt(mfSpotlightBillboard_PerFrame);
				for (int i = 0; i < lRaycastCount; ++i)
				{
					iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
					if (pCrystal is null) continue;
					
					cVector3f vForward = GetCrystalDir();
					cVector2f vRot = cMath_RandRectVector2f(cVector2f(-7, -12), cVector2f(7, 12));
					
					cQuaternion q1;
					q1.FromAngleAxis(cMath_ToRad(vRot.y), pCrystal.GetMatrix().GetTranspose().GetRight());
					cQuaternion q2;
					q2.FromAngleAxis(cMath_ToRad(vRot.x), pCrystal.GetMatrix().GetTranspose().GetUp());
					
					vForward = cMath_MatrixMul(cMath_MatrixQuaternion(q1 * q2), vForward);
					
					++mlSpoltightBillboard_RaycastIndex;
					mBaseObj.GetClosestCharCollideBody("OnRaycast_ActivateSpotlightBillboard", pCrystal.GetPosition(), vForward, mfCrystal_SightRange * mfCrystal_SightRangeMul, mlSpoltightBillboard_RaycastIndex);
					
					cWraithSpotlightBillboard@ pBillboard = GetFreeSpotlightBillboard();
					if (pBillboard !is null)
					{
						pBillboard.mbAvailable = false;
						pBillboard.mlRaycastIndex = mlSpoltightBillboard_RaycastIndex;
						pBillboard.mvForward = vForward;
					}
				}
			
			}
		}
		
		int lUnusedCount = 0;
		for (int i = 0; i < mvSpotlightBillboards.size(); ++i)
		{
			cWraithSpotlightBillboard@ pBillboard = mvSpotlightBillboards[i];
			if (pBillboard.mbTurnOn || pBillboard.mbTurnOff)
			{
				cBillboard@ pEnt = mBaseObj.GetMap().GetWorld().GetBillboardFromID(pBillboard.m_idBillboard);
				float fBrightnessTarget = 0.f;
				
				if (pBillboard.mbTurnOn)
				{
					fBrightnessTarget = pBillboard.mfMaxBrightness * mfSpotlightBillboard_BrightnessMul;
					if (pBillboard.mfBrightness == fBrightnessTarget)
					{
						pBillboard.mbTurnOn = false;
						pBillboard.mbTurnOff = true;
					}
				}
				else if (pBillboard.mbTurnOff)
				{
					if (pBillboard.mfBrightness == fBrightnessTarget)
					{
						pEnt.SetVisible(false);
						pBillboard.mbTurnOff = false;
					}
				}
				
				pBillboard.mfBrightness = cMath_IncreaseTo(pBillboard.mfBrightness, mfSpotlightBillboard_Speed * afTimeStep, fBrightnessTarget);
				pEnt.SetColor(mSpotlightcolor * mfSpotlightBrightnessMul);
				pEnt.SetBrightness(pBillboard.mfBrightness);
			}
			else
			{
				++lUnusedCount;
			}
		}
		int lUsedCount = mlSpoltightBillboard_MaxCount - lUnusedCount;
		
//		cLux_AddDebugMessage("BILLBOARDS: " + lUsedCount + "/" + mlSpoltightBillboard_MaxCount);
	}
	
	void OnRaycast_ActivateSpotlightBillboard(bool abSuccesful, float afDistance, const cVector3f&in avNormal, iPhysicsBody@ apBody, int alUserValue)
	{	
		if (abSuccesful)
		{
			iLuxEntity@ pEnt = cLux_GetBodyEntity(apBody);
			if (mbPhysicsBeam_Shake) StartEntityShake(pEnt);
		}
		
		for (int i = 0; i < mvSpotlightBillboards.size(); ++i)
		{
			cWraithSpotlightBillboard@ pBillboard = mvSpotlightBillboards[i];
			if (pBillboard.mlRaycastIndex != alUserValue) continue;
			
			pBillboard.mbAvailable = true;
			
			if (mbSpotlightBillboard_Active == false) continue;
			
			iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
			if (pCrystal is null) continue;
			
			cBillboard@ pEnt = mBaseObj.GetMap().GetWorld().GetBillboardFromID(pBillboard.m_idBillboard);
			if (pEnt is null) continue;
			
			float fDist = cMath_Clamp(afDistance, 0.0f, mfCrystal_SightRange * mfCrystal_SightRangeMul);
			if (fDist < 1.0f) continue;
			
			float fStartDist = 0.0f;
			fStartDist = cMath_RandRectf(0.0f, 2.0f);
			fStartDist -= mfSpotlightBillboard_StartOffset;
			cVector3f vStart = pCrystal.GetPosition() + pBillboard.mvForward * fStartDist;
			cVector3f vTarget = pCrystal.GetPosition() + pBillboard.mvForward * (fDist + mfSpotlightBillboard_ExtraLength);
			cVector3f vMiddle = (vStart + vTarget) * 0.5f;
			cVector3f vAxis = cVector3f_Zero - pBillboard.mvForward;
						
			pEnt.SetVisible(true);
			pEnt.SetWorldPosition(vMiddle);
			pEnt.SetBrightness(0);
			pEnt.SetAxis(vAxis);
			pEnt.SetSize(cVector2f(1.2f, fDist - fStartDist));
			
			if (mvSpotlightBillboard_RangeMin.x >= 0 && mvSpotlightBillboard_RangeMin.y >= 0) pEnt.SetRangeMin(mvSpotlightBillboard_RangeMin.x, mvSpotlightBillboard_RangeMin.y);
			if (mvSpotlightBillboard_RangeMax.x >= 0 && mvSpotlightBillboard_RangeMax.y >= 0) pEnt.SetRangeMax(mvSpotlightBillboard_RangeMax.x, mvSpotlightBillboard_RangeMax.y);
			
			// change material based on alert mode, also manage billboard groups
			bool bAnimated = mAlert >= eWraithAlertState_Alerted;
			
			tString sMatName = "";
			if (bAnimated) sMatName = msSpotlightBillboard_AlertMaterial;
			else
			{
				int lIndex = cMath_RandRectl(0, mvSpotlightBillboard_NormalMaterials.size() - 1);
				sMatName = mvSpotlightBillboard_NormalMaterials[lIndex];
			}
			pEnt.SetMaterial(cResources_CreateMaterial(sMatName));
			
			pBillboard.mbTurnOn = true;
			
			// position spotlight ps
			cParticleSystem@ pHitPS = cLux_ID_ParticleSystem(m_idSpotlightPS);
			if (pHitPS !is null)
			{
				cVector3f vHitPos = pCrystal.GetPosition() + pBillboard.mvForward * fDist;
				pHitPS.SetVisible(mpStateMachine.GetCurrentState() != eWraithState_Permafail);
				pHitPS.SetWorldPosition(vHitPos);
			}
						
			// position suction ps
			cParticleSystem@ pSuctionPS = cLux_ID_ParticleSystem(m_idSpotlightSuctionPS);
			if (pSuctionPS !is null)
			{
				cVector3f vDir = pBillboard.mvForward * 0.7f + pCrystal.GetMatrix().GetTranspose().GetForward() * 0.3f;
				cVector3f vOrigin = pCrystal.GetPosition() + cMath_Vector3Normalize(vDir) * 15.0f;
				if (mbSuctionVisible) pSuctionPS.SetVisible(true);
				pSuctionPS.SetWorldPosition(pCrystal.GetPosition());
				pSuctionPS.SetCustomOrigin(vOrigin);
			}
			
			Debug_DrawSphere(pCrystal.GetPosition() + pBillboard.mvForward * fDist, 0.2f, cColor(0, 0.5, 1) * 2, 1 / mfSpotlightBillboard_Speed);
			Debug_DrawLine(pCrystal.GetPosition(), pCrystal.GetPosition() + pBillboard.mvForward * fDist, cColor(0, 0.5, 1) * 2, 1 / mfSpotlightBillboard_Speed);
			break;
		}
	}
	
	void SetSpotlightBillboardActive(bool abActive)
	{
		if (abActive == mbSpotlightBillboard_Active) return;
		mbSpotlightBillboard_Active = abActive;
		
		if (mbSpotlightBillboard_Active)
		{
			cParticleSystem@ pHitPS = mBaseObj.CreateParticleSystem("BeamHit", "wraith_beam_hit", true, false);
//			pHitPS.SetFadeAtDistance(true);
//			pHitPS.SetMinFadeDistanceStart(4);
//			pHitPS.SetMinFadeDistanceEnd(2);
//			pHitPS.SetMaxFadeDistanceStart(100);
//			pHitPS.SetMaxFadeDistanceEnd(110);
			pHitPS.SetVisible(false);
			m_idSpotlightPS = pHitPS.GetID();
			
//			cParticleSystem@ pSuctionPS = mBaseObj.CreateParticleSystem("Suction", "wraith_suction_test", true, false);
//			pSuctionPS.SetVisible(false);
//			pSuctionPS.SetUseCustomOrigin(true);
//			m_idSpotlightSuctionPS = pSuctionPS.GetID();
		}
		else
		{
			cParticleSystem@ pHitPS = cLux_ID_ParticleSystem(m_idSpotlightPS);
			if (pHitPS !is null) pHitPS.Kill();
			m_idSpotlightPS = tID_Invalid;
			
//			cLux_ID_ParticleSystem(m_idSpotlightSuctionPS).Kill();
//			m_idSpotlightSuctionPS = tID_Invalid;
		}
		
		for (int i = 0; i < mvSpotlightBillboards.size(); ++i)
		{
			cWraithSpotlightBillboard@ pBillboard = mvSpotlightBillboards[i];
			if (pBillboard.mbTurnOn) pBillboard.mbTurnOff;
		}
	}
	
	void SetSpotlightBillboardQuality(int alQuality)
	{
		if (alQuality == mlSpoltightBillboard_Quality) return;
		mlSpoltightBillboard_Quality = alQuality;
		
		if (mlSpoltightBillboard_Quality == 1)
		{
			mlSpoltightBillboard_MaxCount = 24;
			mfSpotlightBillboard_Speed = 3.5f;
			mfSpotlightBillboard_PerFrame = 0.8f;
			mfSpotlightBillboard_Width = 0.8f;
		}
		else if (mlSpoltightBillboard_Quality == 2)
		{
			mlSpoltightBillboard_MaxCount = 60;
			mfSpotlightBillboard_Speed = 3.0f;
			mfSpotlightBillboard_PerFrame = 2.5f;
			mfSpotlightBillboard_Width = 0.8f;
		}
		else if (mlSpoltightBillboard_Quality == 3)
		{
			mlSpoltightBillboard_MaxCount = 150;
			mfSpotlightBillboard_Speed = 3.0f;
			mfSpotlightBillboard_PerFrame = 6.0f;
			mfSpotlightBillboard_Width = 0.8f;
		}
		
		mbSpotlightBillboard_Init = false;
		InitSpotlightBillboards();
	}
	
	cWraithSpotlightBillboard@ GetFreeSpotlightBillboard()
	{
		for (int i = 0; i < mvSpotlightBillboards.size(); ++i)
		{
			cWraithSpotlightBillboard@ pBillboard = mvSpotlightBillboards[i];
			if (pBillboard.mbAvailable && pBillboard.mbTurnOn == false && pBillboard.mbTurnOff == false)
			{
				return pBillboard;
			}
		}
		return null;
	}
	
	//------------------------------------------------------------
	
	float mfSpotlightFear_Timer = 0;
	float mfSpotlightFear_Mul = 0;
	
	void UpdateSpotlightFear(float afTimeStep)
	{
		mfSpotlightFear_Timer -= afTimeStep;
		if (mfSpotlightFear_Timer > 0) return;
		mfSpotlightFear_Timer = cMath_RandRectf(0.2, 0.4f);
		
		if (mBaseObj.GetDistanceToPlayer() > (mfCrystal_SightRange * mfCrystal_SightRangeMul) + 4.0f) return;
		
		float fAngle = cMath_ToDeg(cMath_Vector3Angle(mBaseObj.GetPlayerDir(), mvCrystal_CurrentDir));
		mfSpotlightFear_Mul = 1.0f - cMath_Clamp((fAngle - 12.0f) / (30.0f - 12.0f), 0.0f, 1.0f);
		if (mfSpotlightFear_Mul > 0.0f) FearThreatAgent_SetComponentFearActive(mBaseObj.GetName(), true);
		FearThreatAgent_SetComponentFearRateBoost(mBaseObj.GetName(), mfSpotlightFear_Mul * 0.3f, 1.0f, false, 0.2f);
	}

	//------------------------------------------------------------
	
	float mfSpotlightFeedback_Timer = 0.05f;
	int mlSpotlightFOVShakeID = -1;
	
	void UpdateSpotlightFeedback(float afTimeStep)
	{
		mfSpotlightFeedback_Timer -= afTimeStep;
		if (mfSpotlightFeedback_Timer > 0) return;
		mfSpotlightFeedback_Timer = cMath_RandRectf(0.1, 0.15f);
		
		if (mbSpotlight_VisualsActive && mBaseObj.GetDistanceToPlayer() <= (mfCrystal_SightRange * mfCrystal_SightRangeMul) + 4.0f)
		{
			float fAngle = cMath_ToDeg(cMath_Vector3Angle(mBaseObj.GetPlayerDir(), mvCrystal_CurrentDir));
			float fShakeMul = 1.0f - cMath_Clamp((fAngle - 10.0f) / (50.0f - 10.0f), 0.0f, 1.0f);
			if (fShakeMul > 0)
			{
				fShakeMul = cMath_Easing(eEasing_QuadIn, fShakeMul);
				float fMaxShake = mbCrystal_PlayerDetected ? 0.04f : 0.025f;
				if (mlSpotlightFOVShakeID == -1)
					mlSpotlightFOVShakeID = Effect_FOV_Shake_Start(fMaxShake, -1, 0, 0, 0, true, 0.33);
				Effect_FOV_Shake_SetAmount(mlSpotlightFOVShakeID, fMaxShake*fShakeMul);
				return;
			}
		}
		
		if (mlSpotlightFOVShakeID >= 0)
		{
			Effect_FOV_Shake_FadeOut(mlSpotlightFOVShakeID, 0);
			mlSpotlightFOVShakeID = -1;
		}
	}

	//------------------------------------------------------------
	
	cVector3f GetCrystalPos()
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		return cLux_ID_Entity(m_idCrystal).GetPosition();
	}
	
	//------------------------------------------------------------
	
	cVector3f GetCrystalToPlayerDir()
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		return cMath_Vector3Normalize(mBaseObj.GetPlayerPos() - cLux_ID_Entity(m_idCrystal).GetPosition());
	}
	
	//------------------------------------------------------------
	
	cVector3f GetCrystalToPos(const cVector3f &in avPos)
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		return avPos - cLux_ID_Entity(m_idCrystal).GetPosition();
	}
	
	cVector3f GetCrystalToPosDir(const cVector3f &in avPos)
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		return cMath_Vector3Normalize(avPos - cLux_ID_Entity(m_idCrystal).GetPosition());
	}
	
	cVector3f GetCrystalDir()
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		return pCrystal.GetMatrix().GetTranspose().GetForward();
	}
	
	//------------------------------------------------------------
	
	void AddSpotlightMovementTransition()
	{
		mfSpotlight_LerpSpeedTransitionTimer = 3.0f;
	}
	
	//------------------------------------------------------------
	
	void StopSpotlightMovement()
	{
		mSpotlightMovement = eWraithLightMovement_None;
	}
	
	//------------------------------------------------------------
	
	void SetSpotlightMovement_Forward(bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eWraithLightMovement_None) return;
		mSpotlightMovement = eWraithLightMovement_Forward;
	}
	
	//------------------------------------------------------------
	
	void SetSpotlightMovement_ForwardOffset(float mfHOffset, float mfVOffset, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eWraithLightMovement_None) return;
		mSpotlightMovement = eWraithLightMovement_ForwardOffset;
		mfSpotlight_ForwardOffsetTargetH = mfHOffset;
		mfSpotlight_ForwardOffsetTargetV = mfVOffset;
	}
	
	//------------------------------------------------------------
	
	void SetSpotlightMovement_FollowPosition(const cVector3f &in avPos, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eWraithLightMovement_None) return;
		mSpotlightMovement = eWraithLightMovement_FollowPosition;
		mvSpotlight_FollowPosition = avPos;
	}
	
	//------------------------------------------------------------
	
	void SetSpotlightTargetDir(const cVector3f &in avDir, bool abClosestAngle = true)
	{
		mvCrystal_TargetDir = avDir;
		mvCrystal_TargetDir.Normalize();
		
		GetSpotlightAngle(mvCrystal_TargetDir, mfCrystal_TargetHAngle, mfCrystal_TargetVAngle);
		if (abClosestAngle)
		{
			mfCrystal_TargetHAngle = ClosestAngleToAngle(mfCrystal_TargetHAngle, mfCrystal_CurrentHAngle);
			mfCrystal_TargetVAngle = ClosestAngleToAngle(mfCrystal_TargetVAngle, mfCrystal_CurrentVAngle);
		}
	}
	
	void GetSpotlightAngle(const cVector3f &in avDir, float &out afHAngle, float &out afVAngle)
	{
		cVector3f vDirH = avDir;
		vDirH.y = 0;
		vDirH.Normalize();
		
		afHAngle = cMath_GetAngleFromPoints2D(0, cVector2f(avDir.x, avDir.z));
		afVAngle = cMath_Vector3Angle(vDirH, avDir) * cMath_Sign(avDir.y);
	}
	
	void GetClosestSpotlightAngle(const cVector3f &in avDir, float &out afHAngle, float &out afVAngle)
	{
		float fH = 0;
		float fV = 0;
		GetSpotlightAngle(avDir, fH, fV);
		afHAngle = ClosestAngleToAngle(fH, mfCrystal_CurrentHAngle);
		afVAngle = ClosestAngleToAngle(fV, mfCrystal_CurrentVAngle);
	}
	
	//------------------------------------------------------------
	
	void TurnSpotlightToAngle(float afHAngle, float afVAngle, bool abForce = false, bool abFade = true, float afTurnSpeed = 2.0f, float afTurningDoneMul = 1.0f)
	{
		if (m_idCrystal == tID_Invalid) return;
		if (abForce == false && mSpotlightMovement != eWraithLightMovement_None) return;
		
		mbSpotlight_Turning = true;
		mSpotlightMovement = eWraithLightMovement_Turn;
		
//		mfCrystal_TargetHAngle = mfCrystal_CurrentHAngle;
//		mfCrystal_TargetVAngle = mfCrystal_CurrentVAngle;
		mfSpotlight_TurnHTarget = afHAngle;
		mfSpotlight_TurnVTarget = afVAngle;
				
		if (abFade == false)
		{
			mvCrystal_CurrentDir = mvCrystal_TargetDir;
			mfCrystal_CurrentHAngle = mfCrystal_TargetHAngle = mfSpotlight_TurnHTarget;
			mfCrystal_CurrentVAngle = mfCrystal_TargetVAngle = mfSpotlight_TurnVTarget;
		}
		
		mfSpotlight_TurnSpeed = afTurnSpeed;
		mfSpotlight_TurningDoneMul = afTurningDoneMul;
	}
	
	void TurnSpotlightToDir(const cVector3f &in avDir, bool abForce = false, bool abFade = true, float afTurnSpeed = 2.0f, float afTurningDoneMul = 1.0f)
	{
		if (m_idCrystal == tID_Invalid) return;
		if (abForce == false && mSpotlightMovement != eWraithLightMovement_None) return;
									
		mbSpotlight_Turning = true;
		mSpotlightMovement = eWraithLightMovement_Turn;
		
		mvCrystal_TargetDir = avDir;
		mvCrystal_TargetDir.Normalize();
		GetSpotlightAngle(mvCrystal_TargetDir, mfSpotlight_TurnHTarget, mfSpotlight_TurnVTarget);
		
		mfSpotlight_TurnHTarget = ClosestAngleToAngle(mfSpotlight_TurnHTarget, mfCrystal_CurrentHAngle);
		mfSpotlight_TurnVTarget = ClosestAngleToAngle(mfSpotlight_TurnVTarget, mfCrystal_CurrentVAngle);
		
		if (abFade == false)
		{
			mvCrystal_CurrentDir = mvCrystal_TargetDir;
			mfCrystal_CurrentHAngle = mfCrystal_TargetHAngle = mfSpotlight_TurnHTarget;
			mfCrystal_CurrentVAngle = mfCrystal_TargetVAngle = mfSpotlight_TurnVTarget;
		}
		
		mfSpotlight_TurnSpeed = afTurnSpeed;
		mfSpotlight_TurningDoneMul = afTurningDoneMul;
	}
	
	//------------------------------------------------------------
	
	void ResetSpotlightDir()
	{
		if (m_idCrystal == tID_Invalid) return;
		
		cVector3f vDir = mBaseObj.GetCharBody().GetForward();
		
		mvCrystal_TargetDir = vDir;
		mvCrystal_TargetDir.Normalize();
		GetSpotlightAngle(mvCrystal_TargetDir, mfSpotlight_TurnHTarget, mfSpotlight_TurnVTarget);
		
		mfSpotlight_TurnHTarget = ClosestAngleToAngle(mfSpotlight_TurnHTarget, mfCrystal_CurrentHAngle);
		mfSpotlight_TurnVTarget = ClosestAngleToAngle(mfSpotlight_TurnVTarget, mfCrystal_CurrentVAngle);
		
		mvCrystal_CurrentDir = mvCrystal_TargetDir;
		mfCrystal_CurrentHAngle = mfCrystal_TargetHAngle = mfSpotlight_TurnHTarget;
		mfCrystal_CurrentVAngle = mfCrystal_TargetVAngle = mfSpotlight_TurnVTarget;
	}
	
	//------------------------------------------------------------
	
	void TurnSpotlightToPos(const cVector3f &in avPos, bool abForce = false, bool abFade = true, float afTurnSpeed = 2.0f, float afTurningDoneMul = 1.0f)
	{
		if (m_idCrystal == tID_Invalid) return;
		TurnSpotlightToDir(avPos - cLux_ID_Entity(m_idCrystal).GetPosition(), abForce, abFade, afTurnSpeed, afTurningDoneMul);
	}
	
