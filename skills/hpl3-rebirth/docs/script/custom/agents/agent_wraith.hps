	//------------------------------------------------------------
	
	bool GetSensesActive()
	{
		if (mbPlayerSubmerged) return false;
		if (mBaseObj.GetSensesActive() == false) return false;
		if (mfPermafailInvulnerabilityTimer > 0) return false;
		return true;
	}
	
	//------------------------------------------------------------
	
	bool mbRegisteredWithFearHandler = false;
	bool mbFearComponentEnabled = true;
	void RegisterWithFearHandler()
	{
		if (mbRegisteredWithFearHandler) return;
		mbRegisteredWithFearHandler = true;
		
		iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
		cFearThreatParams mFearParams;
		mFearParams.m_idEntity = mBaseObj.GetID();
		mFearParams.mfBaseFearRate = 0.2f;
		mFearParams.mfSurpriseFactor = 0.4f;
		mFearParams.mfLookAtFactor = 0.15f;
		mFearParams.mfActivationDistance = 20.0f;
		mFearParams.mfDeactivationDistance = 25.0f;
		mFearParams.mfActivationDelay = 0.2f;
		mFearParams.mfActivationLightLevel = -1.0f;
		mFearParams.mbLookAtDetectWholeArea = false;
		mFearParams.mfMaxFearDist = 6.0f;
		mFearParams.mfMinFearDist = 15.0f;
		pHandler.RegisterThreatAgent(mFearParams);
	}
	
	//------------------------------------------------------------
	
	bool CheckWraithIsInPlayerFOV()
	{
		if(mBaseObj.GetEntityIsInPlayerLineOfSight(true)) return true;
		
		return false;
	}

	//------------------------------------------------------------
	
	void ExecuteEntityCallback(const tString &in asFunc)
	{
		if (asFunc == "") return;
		
		tString sMethodName = "void " + asFunc + "(const tString &in asEntity)";
		cLuxMap@ pMap = mBaseObj.GetMap();
		if (pMap.ScriptMethodExists(sMethodName) && pMap.ScriptPrepare(sMethodName))
		{
			tString sName = mBaseObj.GetName();
			pMap.SetArgString(0, sName);
			pMap.ScriptExecute();
		}
	}
	
	void ExecuteStateCallback(const tString &in asFunc, int alState)
	{
		if (asFunc == "") return;
		
		tString sMethodName = "void " + asFunc + "(const tString &in asEntity, int alState)";
		cLuxMap@ pMap = mBaseObj.GetMap();
		if (pMap.ScriptMethodExists(sMethodName) && pMap.ScriptPrepare(sMethodName))
		{
			tString sName = mBaseObj.GetName();
			pMap.SetArgString(0, sName);
			pMap.SetArgInt(1, alState);
			pMap.ScriptExecute();
		}
	}
	
	//------------------------------------------------------------
	
	void SetAlertState(eWraithAlertState aState, bool abCanLower = false)
	{
		if (aState <= mAlert && abCanLower == false) return;
				
		if (mAlert == eWraithAlertState_None && aState > eWraithAlertState_None)
		{
			ExecuteEntityCallback(msCallback_Alerted);
		}
		
		if (mAlert > eWraithAlertState_None && aState == eWraithAlertState_None)
		{
			ExecuteEntityCallback(msCallback_CalmedDown);
			mBaseObj.PlaySound("EndSearch", gsWraithSound_End_search, true, true);
		}
		
		if (aState >= eWraithAlertState_PlayerDetected) mlSwayStage = 2;
		else if (aState >= eWraithAlertState_Alerted) mlSwayStage = 1;
		else mlSwayStage = 0;
		SetSway(mlSwayStage);
		
		mAlert = aState;
	}
	
	//------------------------------------------------------------
	
	bool IsInterruptState(eWraithState alState)
	{
		return alState == eWraithState_Search ||
				alState == eWraithState_PlayerGazeDetected ||
				alState == eWraithState_PlayerDetected ||
				alState == eWraithState_PlayerLanternDetected;
	}
	
