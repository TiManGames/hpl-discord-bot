	//------------------------------------------------------------
	
	int mlModeFlyPatrol_Stage = 0;
	float mfModeFlyPatrol_PlayerStress = 0.0f;
	tString msModeFlyPatrol_State = "";
	tString msModeFlyPatrol_PrevState = "";
	bool mbModeFlyPatrol_RandomNodes = false;
	int mlModeFLyPatrol_SameState = 0;
	float mfModeFlyPatrol_StressAddMul = 0;
	cVector2f mvModeFlyPatrol_SweepRange;
	
	void ModeFlyPatrol_Init()
	{
		mlModeFlyPatrol_Stage = 0;
	}
	
	void ModeFlyPatrol_Update(float afTimeStep)
	{
		if (mMode != eWraithMode_FlyPatrol) return;
		
		float fPlayerDist = mBaseObj.GetDistanceToPlayer();
		float fDistMul = 1.0f - cMath_Clamp((fPlayerDist - 8.0f) / (30.0f - 8.0f), 0.0f, 1.0f);
		
		mfModeFlyPatrol_StressAddMul = 0.0f;
		if (mbCrystal_PlayerSeen) mfModeFlyPatrol_StressAddMul += 1;
		if (fPlayerDist <= 25.0f) mfModeFlyPatrol_StressAddMul += mfSpotlightFear_Mul * 0.4;
		if (mbOnScreen && fPlayerDist <= 25.0f) mfModeFlyPatrol_StressAddMul += 0.25;
		if (fPlayerDist <= 12.0f) mfModeFlyPatrol_StressAddMul += 0.1;
		if (mfModeFlyPatrol_StressAddMul <= 0)
		{
			if (Player_GetVelocity().Length() > 1.5)
			{
				iLuxEntity@ pWidget = cLux_ID_Entity(m_idFlyToNode_DirWidget);
				if (pWidget !is null)
				{
					cVector3f vWidgetForward = pWidget.GetMatrix().GetTranspose().GetForward();
					if (cMath_Vector3Dot(Player_GetVelocity(), vWidgetForward) > 0)
					{
						mfModeFlyPatrol_StressAddMul = -0.6;
					}
					else
					{
						mfModeFlyPatrol_StressAddMul = -0.3;
					}
				}
				
			}
			else mfModeFlyPatrol_StressAddMul = -0.20;
		}
		mfModeFlyPatrol_StressAddMul = cMath_Clamp(mfModeFlyPatrol_StressAddMul, -1.0f, 1.0f);
				
		mfModeFlyPatrol_PlayerStress += mfModeFlyPatrol_StressAddMul * 0.2f * afTimeStep;
		mfModeFlyPatrol_PlayerStress = cMath_Clamp(mfModeFlyPatrol_PlayerStress, -1.0f, 1.0f);
		
//		cLux_AddDebugMessage("A " + mfModeFlyPatrol_PlayerStress + " " + mfModeFlyPatrol_StressAddMul);
	}
	
	void SetModeFlyPatrolState()
	{
		msModeFlyPatrol_PrevState = msModeFlyPatrol_State;
		if (mbModeFlyPatrol_RandomNodes)
		{
			msModeFlyPatrol_State = "Random";
		}
		else if (mfModeFlyPatrol_PlayerStress >= 0.7f)
		{
			msModeFlyPatrol_State = "Respite";
		}
		else if (mfModeFlyPatrol_PlayerStress <= -0.7f)
		{
			msModeFlyPatrol_State = "Attack";
		}
		else
		{
			msModeFlyPatrol_State = "Block";
		}
		
		if (msModeFlyPatrol_PrevState == msModeFlyPatrol_State)
		{
			++mlModeFLyPatrol_SameState;
			if (mlModeFLyPatrol_SameState >= 3)
			{
				msModeFlyPatrol_State = "Random";
			}
		}
		else
		{
			mlModeFLyPatrol_SameState = 0;
		}
	}
	
	void _Global_ModeFlyPatrol_ClearNodes()
	{
		mvFlyToNode_Nodes.resize(0);
	}
	
	void _Global_ModeFlyPatrol_AddNode()
	{
		array<iLuxEntity@> mvEnts;
		Map_GetEntityArray(cScript_GetGlobalArgString(0), mvEnts, eLuxEntityType_Area);
		for (int i = 0; i < mvEnts.size(); ++i)
		{
			mvFlyToNode_Nodes.push_back(mvEnts[i].GetID());
		}
	}
	
	void _Global_ModeFlyPatrol_AddNodeRange()
	{
		int lRangeStart = cScript_GetGlobalArgInt(1);
		int lRangeEnd = cScript_GetGlobalArgInt(2);
		array<iLuxEntity@> mvEnts;
		Map_GetEntityArray(cScript_GetGlobalArgString(0), mvEnts, eLuxEntityType_Area);
		for (int i = 0; i < mvEnts.size(); ++i)
		{
			iLuxEntity@ pEnt = mvEnts[i];
			if (pEnt is null) continue;
			int lSuffix = cString_GetNumericSuffixInt(pEnt.GetName(), -1);
			if (lSuffix < lRangeStart || lSuffix > lRangeEnd) continue;
			mvFlyToNode_Nodes.push_back(mvEnts[i].GetID());
		}
	}
	
