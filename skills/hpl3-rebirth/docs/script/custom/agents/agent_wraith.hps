//----------------------------------------------------------------------


class cScrAgentWraith : cScrAgentHumanoid
{
	//===========================================================

	//////////////////////////////////////////
	//=======================================
	// MAIN FUNCTIONS
	//=======================================
	//{///////////////////////////////////////
	//===========================================================
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	//{///////////////////////////////////////
		
	//------------------------------------------------------------
		
	void Init()
	{
		mBaseObj.SetUpdatePlayerDetection(true);
	}
		
	//} END INIT
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// LOADING
	//{////////////////////////////////////////
		
	//------------------------------------------------------------
		
	void SetupCharBody()
	{
		cScrAgentHumanoid::SetupCharBody();
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		pCharBody.SetMass(80);
		pCharBody.SetMaxPositiveMoveSpeed(eCharDir_Forward,1.0f);
		pCharBody.SetMoveSpeedMul(eCharDir_Forward,1);
		pCharBody.SetMoveAcc(eCharDir_Forward,4);
		pCharBody.SetMoveDeacc(eCharDir_Forward,8);
		pCharBody.SetMaxPushMass(20);
		pCharBody.SetMaxPushForce(300);
		pCharBody.SetAccurateClimbing(true);
		
		pCharBody.GetCurrentBody().SetMaterial(mBaseObj.GetMap().GetPhysicsWorld().GetMaterialFromName("cloth_leather_waterbag"));
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrAgentHumanoid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		//////////////////////
		// General Setup
		mBaseObj.SetAlignEntityWithGroundRay(true);
		mBaseObj.SetFOV(cMath_ToRad(120.0f));
//		mBaseObj.SetSightRange(25.0f);
		mBaseObj.SetSightRange(0.0f);
		mBaseObj.SetSightRangeMul(mfSightMul);
		mBaseObj.SetRelativeEyeHeight(1.15f);

		mfFrontArcFOV = cMath_ToRad(170.0f); // Used in special circumstances to determine if player is currently in front of the wraith, as it has 360 fov
		
		////////////
		// Set so animations update in variable update
		mBaseObj.GetMeshEntity().SetVariableAnimationUpdate(true);
		mBaseObj.GetMeshEntity().SetNormalizeAnimationWeights(false);
//		mBaseObj.GetMeshEntity().SetNormalizeAnimationLayers(true);

		////////////
		// Pathfinder Setup
		mpPathfinder.SetNodeContainerName("Wraith");
//		mpPathfinder.SetMaxHeight(0.8f);
		mpPathfinder.SetMaxHeight(4.0f);
		
		msSpawnAreaName = apInstanceVars.GetVarString("SpawnAreaName","");
		mbStartHidden = apInstanceVars.GetVarBool("StartHidden",true);
		msCrystalModel = apInstanceVars.GetVarString("CrystalModel", "");
		
		mbVerletEnabled = apInstanceVars.GetVarBool("VerletSimulation", false);
		
		SetupComponents(apWorld, apVars, apInstanceVars);
		
		Entity_Preload(msCrystalModel);
		Entity_Preload("wraith_lamp.ent");
		Entity_Preload("wraith_rigid.ent");
		ParticleSystem_Preload("wraith_beam_hit.ps");
		ParticleSystem_Preload("wraith_orb_trail.ps");
		ParticleSystem_Preload("wraith_teleport.ps");
		ParticleSystem_Preload("wraith_teleport_body.ps");
		ParticleSystem_Preload("wraith_teleport_crystal_end.ps");
		ParticleSystem_Preload("wraith_teleport_crystal_start.ps");
		Material_Preload("wraith_beam_shards.mat");
		Material_Preload("wraith_beam_shards_01.mat");
		Material_Preload("wraith_beam_shards_02.mat");
		Material_Preload("wraith_beam_shards_03.mat");
		Material_Preload("wraith_beam_shards_04.mat");
		Material_Preload("wraith_lamp.mat");
		//Sound_PreloadGroup("creatures/vocalisations/creature/wraith", true);
		//Sound_PreloadGroup("creatures/foley/creature/wraith", true);
	}
	
	//------------------------------------------------------------
	
	void SetupComponents(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		////////////
		// State Machine
		@mpStateMachine = cLux_CreateEntityComponent_StateMachine(mBaseObj);
		
		mpStateMachine.AddState("Idle", eWraithState_Idle);
		mpStateMachine.AddState("InvestigateSound", eWraithState_InvestigateSound);
		mpStateMachine.AddState("PlayerDetected", eWraithState_PlayerDetected);
		mpStateMachine.AddState("PlayerGazeDetected", eWraithState_PlayerGazeDetected);
		mpStateMachine.AddState("PlayerLanternDetected", eWraithState_PlayerLanternDetected);
		mpStateMachine.AddState("Struggle", eWraithState_Struggle);
		mpStateMachine.AddState("StruggleStandBy", eWraithState_StruggleStandBy);
		mpStateMachine.AddState("Permafail", eWraithState_Permafail);
		mpStateMachine.AddState("Attack", eWraithState_Attack);
		mpStateMachine.AddState("FollowAfterPlayer", eWraithState_FollowAfterPlayer);
		mpStateMachine.AddState("Search", eWraithState_Search);
		mpStateMachine.AddState("Dash", eWraithState_Dash);
		mpStateMachine.AddState("GuardPosition", eWraithState_GuardPosition);
		mpStateMachine.AddState("Cooldown", eWraithState_Cooldown);
		mpStateMachine.AddState("OpenDoor", eWraithState_OpenDoor);
		mpStateMachine.AddState("Pulse", eWraithState_Pulse);
		mpStateMachine.AddState("StealthWait", eWraithState_StealthWait);
		mpStateMachine.AddState("StealthSearch", eWraithState_StealthSearch);
		mpStateMachine.AddState("StealthApproach", eWraithState_StealthApproach);
		mpStateMachine.AddState("StealthMoveToPlayer", eWraithState_StealthMoveToPlayer);
		mpStateMachine.AddState("LookAroundForPlayer", eWraithState_LookAroundForPlayer);
		mpStateMachine.AddState("SearchAround", eWraithState_SearchAround);
		mpStateMachine.AddState("InspectPosition", eWraithState_InspectPosition);
		mpStateMachine.AddState("LookAtPosition", eWraithState_LookAtPosition);
		mpStateMachine.AddState("ControlGhoul", eWraithState_ControlGhoul);
		mpStateMachine.AddState("FlySearch", eWraithState_FlySearch);
		mpStateMachine.AddState("FlyToNode", eWraithState_FlyToNode);
		mpStateMachine.AddState("FlySpotlightSearch", eWraithState_FlySpotlightSearch);
		mpStateMachine.AddState("FlyPatrol", eWraithState_FlyPatrol);
		mpStateMachine.AddState("FlyFollowEntity", eWraithState_FlyFollowEntity);
		mpStateMachine.AddState("FlySearchPosition", eWraithState_FlySearchPosition);
		mpStateMachine.AddState("StuckRetreat", eWraithState_StuckRetreat);
		mpStateMachine.AddState("Blocked", eWraithState_Blocked);
		mpStateMachine.AddState("MoveTo", eWraithState_MoveTo);
		mpStateMachine.AddState("Investigate", eWraithState_Investigate);
		mpStateMachine.AddState("SoundHeard", eWraithState_SoundHeard);
		mpStateMachine.AddState("Patrol", eWraithState_Patrol);
		mpStateMachine.AddState("TinHinan", eWraithState_TinHinan);
		mpStateMachine.AddState("Custom", eWraithState_Custom);
		
		////////////
		// Listener
		@mpSoundListener = cLux_CreateEntityComponent_SoundListener(mBaseObj);
		mpSoundListener.LoadFromInstanceVariables(apInstanceVars);
		mpSoundListener.SetHearRadius(1.0f);
		mfSoundRadiusMul = mfDefaultSoundRadiusMul;
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul);
		
		////////////
		// Light Sensor
		@mpLightSensor = cLux_CreateEntityComponent_LightSensor(mBaseObj);
		
		///////////////////////////////
		//Proximity Sensor
		@mpProximitySensor = cLux_CreateEntityComponent_ProximitySensor(mBaseObj);
		mpProximitySensor.AddState(eWraithProximity_Touching, 1, 1.1, true, false);
		mpProximitySensor.AddState(eWraithProximity_Sense, 7, 7.5, true, false);
		mpProximitySensor.AddState(eWraithProximity_StealthSense, 7, 7.5, false, false);
		mpProximitySensor.AddState(eWraithProximity_ProximityAttack, 2.0, 2.5, true, false);
		
		////////////
		// Mover Setup
		SetupGroundWallAvoidance();
		mpMover.SetWallAvoidanceActive(true);
		mpMover.SetupDynamicObjectAvoidance(1.7f, 10, 3);
		
		mpMover.SetVerticalMoveSpeedExtraAnimMul(0.5f);
		
		mpMover.SetMaxForwardSpeed(1);
		mpMover.SetMaxBackwardSpeed(1);
		
		mpMover.SetRunToWalkSpeed(1.9);
		mpMover.SetWalkToRunSpeed(2.0);
		
		/////////////////////////////////
		// Speed States
		mpMover.AddSpeedState(eWraithSpeed_Walk);
		mpMover.SetSpeedState_Forward(1.8f);
		mpMover.SetSpeedState_TurnMaxSpeed(2.0f);
		mpMover.SetSpeedState_TurnBreakMul(0.5f);
		
		mpMover.AddSpeedState(eWraithSpeed_Slow);
		mpMover.SetSpeedState_Forward(1.0f);
		mpMover.SetSpeedState_TurnMaxSpeed(1.2f);
		mpMover.SetSpeedState_TurnBreakMul(0.5f);
		mpMover.SetSpeedState_ForwardAcc(0.5f);
		mpMover.SetSpeedState_ForwardDeacc(0.5f);
		
		mpMover.AddSpeedState(eWraithSpeed_FastWalk);
		mpMover.SetSpeedState_Forward(2.4f);
		
		mpMover.AddSpeedState(eWraithSpeed_Search);
		mpMover.SetSpeedState_Forward(1.0f);
		mpMover.SetSpeedState_TurnBreakMul(1.0f);
		mpMover.SetSpeedState_TurnMaxSpeed(3.5f);
		
		mpMover.AddSpeedState(eWraithSpeed_SearchFast);
		mpMover.SetSpeedState_Forward(2.5f);
		mpMover.SetSpeedState_TurnBreakMul(1.0f);
		mpMover.SetSpeedState_TurnMaxSpeed(3.5f);
		
		mpMover.AddSpeedState(eWraithSpeed_SearchSlow);
		mpMover.SetSpeedState_Forward(0.75f);
		mpMover.SetSpeedState_TurnMaxSpeed(3.5f);
		
		mpMover.AddSpeedState(eWraithSpeed_SearchTurn);
		mpMover.SetSpeedState_Forward(2.5f);
		mpMover.SetSpeedState_TurnMaxSpeed(1.5f);
		
		mpMover.AddSpeedState(eWraithSpeed_SearchTurnSlow);
		mpMover.SetSpeedState_Forward(1.6f);
		mpMover.SetSpeedState_TurnMaxSpeed(0.5f);
		
		mpMover.AddSpeedState(eWraithSpeed_Run);
		mpMover.SetSpeedState_Forward(4.7);
		mpMover.SetSpeedState_TurnMaxSpeed(6);
		mpMover.SetSpeedState_TurnSpeedMul(10);
		mpMover.SetSpeedState_TurnBreakMul(0.2);
		
		mpMover.AddSpeedState(eWraithSpeed_Burst);
		mpMover.SetSpeedState_Forward(9.0f);
		mpMover.SetSpeedState_ForwardAcc(150.0f);
		mpMover.SetSpeedState_ForwardDeacc(150.0f);
		mpMover.SetSpeedState_TurnMaxSpeed(20.0f);
		mpMover.SetSpeedState_TurnSpeedMul(20.0f);
		mpMover.SetSpeedState_TurnBreakMul(0.8f);
		
		mpMover.AddSpeedState(eWraithSpeed_StealthMode);
		mpMover.SetSpeedState_Forward(4.0);
		mpMover.SetSpeedState_TurnMaxSpeed(10);
		
		mpMover.AddSpeedState(eWraithSpeed_StealthMoveToPlayer);
		mpMover.SetSpeedState_Forward(4.0);
		mpMover.SetSpeedState_TurnMaxSpeed(10);
		
		mpMover.AddSpeedState(eWraithSpeed_Struggle);
		mpMover.SetSpeedState_Forward(2.0);
		
		mpMover.AddSpeedState(eWraithSpeed_ControlGhoul);
		mpMover.SetSpeedState_Forward(1.55);
		
		mpMover.AddSpeedState(eWraithSpeed_Fly);
		mpMover.SetSpeedState_Forward(4.0f);
		
//		mpMover.SetWalkToStoppedSpeed(1);
//		mpMover.SetStoppedToWalkSpeed(1);
		
		// Backbone tail
//		@mpBackboneTail = cLux_CreateEntityComponent_BackboneTail(mBaseObj);
//		mpBackboneTail.LoadFromVariables(apVars);

		// Verlet
		@mpVerletAnimation = cLux_CreateEntityComponent_VerletAnimation(mBaseObj);
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad()
	{
		cScrAgentHumanoid::OnAfterWorldLoad();
		StartSoundLoops();
		CreateDashEntities();
	}
	
	//------------------------------------------------------------
	
	void SetupWraithTree(const tString&in asRoot, const tString&in asFinal="",
						float afBaseDampingMul=1.0f, float afBaseMoveToPositionMul=3.0f,
						float afNodeStartMoveToPosMul=3.0f, float afNodeEndMoveToPosMul=1.0f,
						eEasing aNodeMoveToPosMulEasing = eEasing_Linear)
	{
		cNode3D @pRootNode = mBaseObj.GetMeshEntity().GetBoneStateFromName(asRoot);
		cNode3D @pFinalNode = asFinal=="" ? null : mBaseObj.GetMeshEntity().GetBoneStateFromName(asFinal);
		
		mpVerletAnimation.SetupVerletTree(pRootNode, pFinalNode, mBaseObj.GetMeshEntity().GetBoneStateRoot(), 
										afBaseDampingMul, afBaseMoveToPositionMul, 
										afNodeStartMoveToPosMul, afNodeEndMoveToPosMul,
										aNodeMoveToPosMulEasing);
	}
	
	//------------------------------------------------------------
	
	//} END Loading
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	//{///////////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlCurrentOnScreenCheckIdx = 0;
	float mfUpdateCounter = 0.0f;
	bool mbStarted = false;
	
	void OnUpdate(float afTimeStep)
	{		
		cScrAgentHumanoid::OnUpdate(afTimeStep);
		if(mBaseObj.IsActive()==false) return;
				
		UpdateCustomSpotlightFollow(afTimeStep);
		UpdateCustomPlayerLookAt(afTimeStep);
		UpdatePlayerData(afTimeStep);
		UpdateDoorDetection(afTimeStep);
		UpdateDirectMoveTo(afTimeStep);
		UpdateProximityAttack(afTimeStep);
		
		UpdateTestPoints(afTimeStep);
		UpdateTestRays(afTimeStep);		
	}
	
	void OnVariableUpdate(float afTimeStep)
	{
		if (mbStarted == false)
		{
			OnStart();
			mbStarted = true;
		}

		if(mbVerletModuleInitialized == false)
		{
			InitVerletModule();
		}
		
		UpdateSpotlightBillboards(afTimeStep);
		UpdateLineOfSight(afTimeStep);
		UpdateBeamSeen(afTimeStep);
		UpdateSpotlight(afTimeStep);
		UpdateSpotlightFear(afTimeStep);
		UpdateSpotlightFeedback(afTimeStep);
		UpdateOverrideFactor(afTimeStep);
		UpdateStuckDetection(afTimeStep);
		UpdateLanternDetection(afTimeStep);
		UpdateFlyMode(afTimeStep);
		UpdateTerror(afTimeStep);
		UpdateCommandDisappear(afTimeStep);
		UpdateFaceEntity(afTimeStep);
		UpdateIdleSway(afTimeStep);
		UpdateSearch(afTimeStep);
		UpdateShadowCaster(afTimeStep);
		UpdatePhysicsBeam(afTimeStep);
		
		UpdateSounds(afTimeStep);
		UpdateDashEffects(afTimeStep);
		
		cLux_ProfileStart("UpdateMeshMovement");
		UpdateMeshMovement(afTimeStep);
		cLux_ProfileEnd("UpdateMeshMovement");

		UpdateCoverage(afTimeStep);
		
		ModeFlyPatrol_Update(afTimeStep);
		
		if (mfPermafailInvulnerabilityTimer > 0 && FearHandler_GetIsPermaFailing() == false && cLux_GetPlayer().GetCurrentStateId() != ePlayerState_CutsceneAnimation)
		{
			mfPermafailInvulnerabilityTimer -= afTimeStep;
			if (mfPermafailInvulnerabilityTimer <= 0)
			{
				mBaseObj.ResetPlayerDetectionState();
				ResetCrystalDetection();
			}
		}
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
		cScrAgentHumanoid::ResetProperties();
	}
	
	//------------------------------------------------------------
	
	void OnStart()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Start");
		
		RegisterWithFearHandler();
		if (mBaseObj.IsActive()) Blackboard_AddEnemy(mBaseObj.GetID());
		
//		FearThreatAgent_SetComponentEnabled(mBaseObj.GetName(), mbFearComponentEnabled);
	}
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		cScrAgentHumanoid::OnSetActive(abX);
		if (abX == false)
		{
			Player_SetMoveSpeedMul(1, ePlayerMoveSpeedMulType_Agent);
			Blackboard_RemoveEnemy(mBaseObj.GetID());
			
			StopSoundLoops();
			
			mlSpotlight_ActivationIndex = 3;
			SetSpotLightActive(false, false);
			mlSpotlight_ActivationIndex = 0;
			
			if (Blackboard_GetWraithStruggleOwner() == mBaseObj.GetID())
				Blackboard_SetWraithStruggleOwner(tID_Invalid);
			
			if (Struggle_IsActive(true)) Struggle_Stop(true);

			if (mlSpotlightFOVShakeID >= 0)
			{
				Effect_FOV_Shake_FadeOut(mlSpotlightFOVShakeID, 0.5);
				mlSpotlightFOVShakeID = -1;
			}
			
			Terror_RemoveHuntingEnemy(mBaseObj.GetID());
			Terror_RemoveEnemy(mBaseObj.GetID());
			
			mbSpotlight_WhiteEffect = false;
			Blackboard_RemoveWraithDetectingPlayer(mBaseObj.GetID());
			
			Player_StopLookAt(1.0f);
			
			array<tID> vBillboards;
			for (int i = 0; i < mvSpotlightBillboards.size(); ++i)
			{
				cWraithSpotlightBillboard@ pBillboard = mvSpotlightBillboards[i];
				cLux_ID_Billboard(pBillboard.m_idBillboard).SetVisible(false);
				vBillboards.push_back(pBillboard.m_idBillboard);
			}
			
			Blackboard_ReleaseWraithBillboards(mBaseObj.GetID(), vBillboards);
			
			mvSpotlightBillboards.resize(0);
			mbSpotlightBillboard_Init = false;
			
			mfPermafailInvulnerabilityTimer = 0;
			
			cSoundEntity@ pDashLoop = cLux_ID_SoundEntity(m_idDash_MoveOrbLoop);
			if (pDashLoop !is null) pDashLoop.FadeOut(1);
		}
		else
		{
			Blackboard_AddEnemy(mBaseObj.GetID());
			
			StartSoundLoops();
			SetStealthModeActive(false, false);
			RegisterWithFearHandler();
			
			CreateCrystal();
		}
	}
	
	//------------------------------------------------------------
	
	void HitByProp(float afAmount, float afMass, iPhysicsBody @apBody, cLuxProp @apProp)
	{
		m_idLastHitProp = tID_Invalid;
		if (apProp is null) return;
		
		m_idLastHitProp = apProp.GetID();
	}
	
