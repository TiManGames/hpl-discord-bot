	void _Global_SetSpotlightColor2()
	{
		int lColorId = cScript_GetGlobalArgInt(0);
		if (lColorId == 1)
		{
			cLux_AddDebugMessage("[Wraith] Spotlight color: IDLE");
			SetSpotLightColor(mSpotlightColor_Idle);
		}
		else if (lColorId == 2)
		{
			cLux_AddDebugMessage("[Wraith] Spotlight color: ALERT");
			SetSpotLightColor(mSpotlightColor_Alert);
		}
		else if (lColorId == 3)
		{
			cLux_AddDebugMessage("[Wraith] Spotlight color: DETECTED");
			SetSpotLightColor(mSpotlightColor_Detected);
		}
		else if (lColorId == 4)
		{
			cLux_AddDebugMessage("[Wraith] Spotlight color: STRUGGLE");
			SetSpotLightColor(mSpotlightColor_Struggle);
		}
		
		
		SetSpotlightBillboardQuality(cScript_GetGlobalArgInt(0));
	}
	
