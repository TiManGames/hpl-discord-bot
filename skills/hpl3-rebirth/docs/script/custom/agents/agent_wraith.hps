	/////////////////////////////////////////
	// PHYSICS PULSE
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	void DoPhysicsPulse(cVector3f &in avPos, float afForce = 5,  float afRadius = 3)
	{
		cVector3f vMin = avPos - cVector3f(afRadius, afRadius, afRadius);
		cVector3f vMax = avPos + cVector3f(afRadius, afRadius, afRadius);
		
		array<iPhysicsBody@> vBodies;
		mBaseObj.GetMap().GetPhysicsWorld().GetBodiesInAABB(vMin, vMax, vBodies);
		for (int i = 0; i < vBodies.size(); ++i)
		{
			iPhysicsBody@ pBody = vBodies[i];
			if (pBody.GetMass() == 0) continue;
			
			cVector3f vToBody = pBody.GetWorldPosition() - avPos;
			float fDist = vToBody.Length();
			if (fDist > afRadius) continue;
				
			vToBody.Normalize();
			float fForce = cMath_Pow((fDist / afRadius), 0.5f) * afForce;
			pBody.AddImpulse(vToBody * fForce);
		}
	}
	
	//------------------------------------------------------------
	
	//} END PHYSICS PULSE
	
	/////////////////////////////////////////
	// COVERAGE
	//{//////////////////////////////////////

	//------------------------------------------------------------
	
	float mfCoverageAmount = 1;
	float mfCoverageTarget = 1;
	float mfCoverageFadeSpeed = 1;
	bool mbCoverageFadeCrystal = true;
	
	//------------------------------------------------------------
	
	void SetCoverage(float afCoverage, float afFadeTime = -1, bool abFadeCrystal = true)
	{
		if (afFadeTime < 0)
		{
			mfCoverageAmount = mfCoverageTarget = afCoverage;
			SetCoverageEffect(mfCoverageAmount, abFadeCrystal);
			mbCoverageFadeCrystal = true;
		}
		else
		{
			mbCoverageFadeCrystal = abFadeCrystal;
			mfCoverageTarget = afCoverage;
			float fDiff = cMath_Abs(mfCoverageTarget - mfCoverageAmount);
			mfCoverageFadeSpeed = fDiff / afFadeTime;
		}
	}
	
	//------------------------------------------------------------
	
	void SetCoverageEffect(float afCoverage, bool abSetCrystal = true)
	{
		mBaseObj.GetMeshEntity().SetCoverageAmount(afCoverage);
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		if (abSetCrystal && pCrystal !is null) pCrystal.GetMeshEntity().SetCoverageAmount(afCoverage);
	}
	
	//------------------------------------------------------------
	
	void UpdateCoverage(float afTimeStep)
	{
		if (mfCoverageAmount != mfCoverageTarget)
		{
			mfCoverageAmount = cMath_IncreaseTo(mfCoverageAmount, afTimeStep * mfCoverageFadeSpeed, mfCoverageTarget);
			SetCoverageEffect(mfCoverageAmount, mbCoverageFadeCrystal);
		}
	}
	
