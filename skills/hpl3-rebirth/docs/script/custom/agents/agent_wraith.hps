	float mfTimer = 0;
	array<cShakingProp> mvShakingObjects;
	int mlPhysicsBeam_AABBIndex = 0;
	int mlPhysicsBeam_AABBSubdivCount = 8;
	bool mbPhysicsBeam_PullObjects = false;
	bool mbPhysicsBeam_Shake = true;
	cVector3f mvPhysicsBeam_GlobalMin;
	cVector3f mvPhysicsBeam_GlobalMax;
	cVector3f mvPhysicsBeam_SubdivSize;
	
	//------------------------------------------------------------
	
	void PullObjects()
	{
		float fRaycastDist = cMath_Vector3Dist(mvSpotlight_RaycastPos, GetCrystalPos());
		float fToRaycastDist = cMath_Min(14.0f, fRaycastDist);
		cVector3f vCenter = GetCrystalPos() + GetCrystalDir() * cMath_Min(12.0f, fRaycastDist);
		mvPhysicsBeam_GlobalMax = vCenter + cVector3f(1, 0, 1) * fToRaycastDist * 0.5 + cVector3f_Up * 2;
		mvPhysicsBeam_GlobalMin = vCenter - cVector3f(1, 0, 1) * fToRaycastDist * 0.5 - cVector3f_Up * 2;
		mvPhysicsBeam_SubdivSize = cVector3f(cMath_Abs(mvPhysicsBeam_GlobalMax.x - mvPhysicsBeam_GlobalMin.x), cMath_Abs(mvPhysicsBeam_GlobalMax.y - mvPhysicsBeam_GlobalMin.y), cMath_Abs(mvPhysicsBeam_GlobalMax.z - mvPhysicsBeam_GlobalMin.z)) / 2;
		
		mlPhysicsBeam_AABBIndex = 0;
		mbPhysicsBeam_PullObjects = true;
	}
	
