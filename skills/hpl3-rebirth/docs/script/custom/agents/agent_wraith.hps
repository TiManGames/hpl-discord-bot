//				float fForce = cMath_RandRectf(0.5f, 1.5f);
//				cVector3f vForce = (cVector3f_Up - cMath_Vector3Normalize(vToBody)) * fForce;
//				
//				Debug_DrawSphere(pEnt.GetPosition(), 0.25, cColor(1, 0.0, 0.7) * 3, 0.5);
//				pBody.AddImpulse(vForce);
//				pBody.AddTorque(vToBodyLeft * 5);
