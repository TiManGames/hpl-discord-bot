//				if (pBody.GetMass() <= 0) continue;
//				if (pEnt.GetEntityType() != eLuxEntityType_Prop) continue;
//				if (GetPointInCrystalCustomFOV(pEnt.GetPosition(), 10, 0.8f) == false) continue;
//				if (cMath_RandRectf(0.0f, 1.0f) <= 0.7) continue;
//				if (pEnt.GetVarBool("Lifted")) continue;
//				
