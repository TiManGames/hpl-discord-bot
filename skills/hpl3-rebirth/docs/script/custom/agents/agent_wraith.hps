	//------------------------------------------------------------
	
	array<cVector3f> mvTestPoints;
	array<cColor> mvTestPointColors;
	array<float> mvTestPointRadiuses;
	array<cVector3f> mvTestRaysA;
	array<cVector3f> mvTestRaysB;
	array<cColor> mvTestRayColors;
	array<float> mvTestPointTimes;
	array<float> mvTestRayTimes;
	
	//------------------------------------------------------------
	
	void DrawTestPoint(const cVector3f &in avPoint, float afTime = 2, cColor aColor = cColor(5,5,20), float afRadius = 0.5f)
	{
		for (int i = 0; i < mvTestPoints.size(); ++i)
		{
			if (avPoint == mvTestPoints[i] && afRadius == mvTestPointRadiuses[i])
			{
				mvTestPointTimes[i] = afTime;
				mvTestPointColors[i] = aColor;
				return;
			}
		}
		
		mvTestPoints.push_back(avPoint);
		mvTestPointTimes.push_back(afTime);
		mvTestPointColors.push_back(aColor);
		mvTestPointRadiuses.push_back(afRadius);
	}
	
	//------------------------------------------------------------
	
	void DrawTestRay(const cVector3f &in avFrom, const cVector3f &in avTo, float afTime = 2, cColor aColor = cColor(5,5,20))
	{
		mvTestRaysA.push_back(avFrom);
		mvTestRaysB.push_back(avTo);
		mvTestRayTimes.push_back(afTime);
		mvTestRayColors.push_back(aColor);
	}
	
	//------------------------------------------------------------
	
	void UpdateTestPoints(float afTimeStep)
	{
		for (int i = 0; i < mvTestPointTimes.size(); ++i)
		{
			mvTestPointTimes[i] -= afTimeStep;
			if (mvTestPointTimes[i] <= 0)
			{
				mvTestPoints.removeAt(i);
				mvTestPointTimes.removeAt(i);
				mvTestPointColors.removeAt(i);
				mvTestPointRadiuses.removeAt(i);
				--i;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateTestRays(float afTimeStep)
	{
		for (int i = 0; i < mvTestRayTimes.size(); ++i)
		{
			mvTestRayTimes[i] -= afTimeStep;
			if (mvTestRayTimes[i] <= 0)
			{
				mvTestRaysA.removeAt(i);
				mvTestRaysB.removeAt(i);
				mvTestRayTimes.removeAt(i);
				mvTestRayColors.removeAt(i);
				--i;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		if (mbTinHinanModeActive)
		{
			//apFunctions.GetLowLevelGfx().DrawSphere(, 2.f, cColor_Red);
		}
		
		for (int i = 0; i < mvTestPoints.size(); ++i)
		{
			apFunctions.GetLowLevelGfx().DrawSphere(mvTestPoints[i], mvTestPointRadiuses[i], mvTestPointColors[i]);
		}
		
		for (int i = 0; i < mvTestRaysA.size(); ++i)
		{
			apFunctions.GetLowLevelGfx().DrawLine(mvTestRaysA[i], mvTestRaysB[i], mvTestRayColors[i]);
		}
		
		if (mbStealthSearch_DrawDebug)
		{
			apFunctions.GetLowLevelGfx().DrawSphere(mBaseObj.GetPosition(), mfStealthModeSenseRadius, cColor(10,10,0));
		}
		
		if (m_idCrystal != tID_Invalid)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idCrystal);
			
			cVector3f vForward2 = pEnt.GetMatrix().GetTranspose().GetForward();
			cVector3f vRight = cVector3f_Zero - pEnt.GetMatrix().GetTranspose().GetRight();
			cVector3f vUp = pEnt.GetMatrix().GetTranspose().GetUp();
			
			apFunctions.GetLowLevelGfx().DrawLine(pEnt.GetPosition(), pEnt.GetPosition() + vForward2 * 6.0f, cColor(1,0.0,0) * 5.0f);
//			apFunctions.GetLowLevelGfx().DrawLine(pEnt.GetPosition(), pEnt.GetPosition() + vRight * 5.0f, cColor_Red);
//			apFunctions.GetLowLevelGfx().DrawLine(pEnt.GetPosition(), pEnt.GetPosition() + vUp * 5.0f, cColor_Green);
//			apFunctions.GetLowLevelGfx().DrawLine(pEnt.GetPosition(), pEnt.GetPosition() + mvCrystal_CurrentDir * 6.0f, cColor(1,1.0,0) * 5.0f);

			cQuaternion q1;
			q1.FromAngleAxis(-mfCrystal_TargetHAngle + cMath_Pi, cVector3f_Up);
			
			cVector3f vForward = cMath_MatrixMul(cMath_MatrixQuaternion(q1), cVector3f_Forward);
			vForward.Normalize();
			
			cVector3f vLeft = cMath_Vector3Cross(vForward, cVector3f_Up);
			vLeft.Normalize();
			
			cQuaternion q2;
			q2.FromAngleAxis(mfCrystal_TargetVAngle, vLeft);
			
			cQuaternion q3 = q2 * q1;
			
			cVector3f vTargetDir = cMath_MatrixMul(cMath_MatrixQuaternion(q3), cVector3f_Forward);

			apFunctions.GetLowLevelGfx().DrawLine(pEnt.GetPosition(), pEnt.GetPosition() + vTargetDir * 5.0f, cColor(0.7,0.7,0) * 5.0f);
			
			apFunctions.GetLowLevelGfx().DrawSphere(mvSpotlight_RaycastPos, 0.2f, cColor(1.0, 0.1, 0.0) * 5.0f);
			apFunctions.GetLowLevelGfx().DrawSphere(mvSpotlight_RaycastPos, 0.8f, cColor(1.0, 0.1, 0.0) * 5.0f);
		}
		
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetPosition(), mBaseObj.GetPosition() + mBaseObj.GetCharBody().GetForward() * 4.5f, cColor(0.0,1.0,0) * 5.0f);
		
		return;
		float fHalfFOV = mBaseObj.GetFOV() / 2.0f;
		float fSight = mBaseObj.GetSightRange() * mBaseObj.GetSightRangeMul();
		cColor coneColor = cColor(5, 0.2, 0);

		cVector3f vLookDir = mBaseObj.GetCharBody().GetForward();
		cVector3f vLookPoint = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vLookDir) * fSight;
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), vLookPoint, coneColor);
		
		cVector3f vLookRight = cMath_Vector3Cross(vLookDir, cVector3f_Up);
		cVector3f vLookUp = cMath_Vector3Cross(vLookDir, vLookRight);
		
		cMatrixf mtxLookDir = cMatrixf_Identity;
		mtxLookDir.SetForward(vLookDir);
		mtxLookDir.SetRight(vLookRight);
		mtxLookDir.SetUp(vLookUp);
				
		cVector3f vVisionConeDir1 = cVector3f(1 * cMath_Tan(fHalfFOV), 1 * cMath_Tan(fHalfFOV), 1);
		vVisionConeDir1 = cMath_MatrixMul(mtxLookDir, vVisionConeDir1);
		cVector3f vVisionConeCorner1 = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir1) * fSight;
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), vVisionConeCorner1, coneColor);
		apFunctions.GetLowLevelGfx().DrawLine(vLookPoint, vVisionConeCorner1, coneColor);
		
		cVector3f vVisionConeDir2 = cVector3f(-1 * cMath_Tan(fHalfFOV), 1 * cMath_Tan(fHalfFOV), 1);
		vVisionConeDir2 = cMath_MatrixMul(mtxLookDir, vVisionConeDir2);
		cVector3f vVisionConeCorner2 = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir2) * fSight;
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), vVisionConeCorner2, coneColor);
		apFunctions.GetLowLevelGfx().DrawLine(vLookPoint, vVisionConeCorner2, coneColor);
		
		cVector3f vVisionConeDir3 = cVector3f(-1 * cMath_Tan(fHalfFOV), -1 * cMath_Tan(fHalfFOV), 1);
		vVisionConeDir3 = cMath_MatrixMul(mtxLookDir, vVisionConeDir3);
		cVector3f vVisionConeCorner3 = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir3) * fSight;
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), vVisionConeCorner3, coneColor);
		apFunctions.GetLowLevelGfx().DrawLine(vLookPoint, vVisionConeCorner3, coneColor);
		
		cVector3f vVisionConeDir4 = cVector3f(1 * cMath_Tan(fHalfFOV), -1 * cMath_Tan(fHalfFOV), 1);
		vVisionConeDir4 = cMath_MatrixMul(mtxLookDir, vVisionConeDir4);
		cVector3f vVisionConeCorner4 = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir4) * fSight;
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), vVisionConeCorner4, coneColor);
		apFunctions.GetLowLevelGfx().DrawLine(vLookPoint, vVisionConeCorner4, coneColor);
		
		int lBoxes = 10;
		for (int i = 0; i < lBoxes; ++i)
		{
			float fLineLength = ((i + 1) / float(lBoxes)) * fSight;
			
			cVector3f vPoint1 = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir1) * fLineLength;
			cVector3f vPoint2 = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir2) * fLineLength;
			cVector3f vPoint3 = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir3) * fLineLength;
			cVector3f vPoint4 = mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir4) * fLineLength;
			
			apFunctions.GetLowLevelGfx().DrawLine(vPoint1, vPoint2, coneColor);
			apFunctions.GetLowLevelGfx().DrawLine(vPoint2, vPoint3, coneColor);
			apFunctions.GetLowLevelGfx().DrawLine(vPoint3, vPoint4, coneColor);
			apFunctions.GetLowLevelGfx().DrawLine(vPoint4, vPoint1, coneColor);
		}
		
		cVector3f vVisionConeDir5 = cVector3f(1 * cMath_Tan(fHalfFOV), 0, 1);
		vVisionConeDir5 = cMath_MatrixMul(mtxLookDir, vVisionConeDir5);
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir5) * fSight, coneColor);
		
		cVector3f vVisionConeDir6 = cVector3f(-1 * cMath_Tan(fHalfFOV), 0, 1);
		vVisionConeDir6 = cMath_MatrixMul(mtxLookDir, vVisionConeDir6);
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir6) * fSight, coneColor);
		
		cVector3f vVisionConeDir7 = cVector3f(0, 1 * cMath_Tan(fHalfFOV), 1);
		vVisionConeDir7 = cMath_MatrixMul(mtxLookDir, vVisionConeDir7);
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir7) * fSight, coneColor);
		
		cVector3f vVisionConeDir8 = cVector3f(0, -1 * cMath_Tan(fHalfFOV), 1);
		vVisionConeDir8 = cMath_MatrixMul(mtxLookDir, vVisionConeDir8);
		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), mBaseObj.GetEyePostion() + cMath_Vector3Normalize(vVisionConeDir8) * fSight, coneColor);
		
//		cVector3f vLookRight = cMath_Vector3Cross(vLookDir, cVector3f_Up);
		
//		cVector3f vAxis1 = cMath_MatrixMul(cMath_MatrixRotateZ(cMath_ToRad(-45)), vLookRight);
//		cQuaternion qAxis1Rot;
//		qAxis1Rot.FromAngleAxis(cMath_ToRad(80), vAxis1);
//		cVector3f vVisionConeDir1 = cMath_MatrixMul(cMath_MatrixQuaternion(qAxis1Rot), vLookDir);
//		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), mBaseObj.GetEyePostion() + vVisionConeDir1 * mBaseObj.GetSightRange(), cColor(5, 0.2, 0));
//		
//		cVector3f vAxis2 = cMath_MatrixMul(cMath_MatrixRotateZ(cMath_ToRad(45)), vLookRight);
//		cQuaternion qAxis2Rot;
//		qAxis2Rot.FromAngleAxis(cMath_ToRad(80), vAxis2);
//		cVector3f vVisionConeDir2 = cMath_MatrixMul(cMath_MatrixQuaternion(qAxis2Rot), vLookDir);
//		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), mBaseObj.GetEyePostion() + vVisionConeDir2 * mBaseObj.GetSightRange(), cColor(5, 0.2, 0));
//		
//		cVector3f vAxis3 = cMath_MatrixMul(cMath_MatrixRotateZ(cMath_ToRad(-135)), vLookRight);
//		cQuaternion qAxis3Rot;
//		qAxis3Rot.FromAngleAxis(cMath_ToRad(80), vAxis3);
//		cVector3f vVisionConeDir3 = cMath_MatrixMul(cMath_MatrixQuaternion(qAxis3Rot), vLookDir);
//		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), mBaseObj.GetEyePostion() + vVisionConeDir3 * mBaseObj.GetSightRange(), cColor(5, 0.2, 0));
//		
//		cVector3f vAxis4 = cMath_MatrixMul(cMath_MatrixRotateZ(cMath_ToRad(135)), vLookRight);
//		cQuaternion qAxis4Rot;
//		qAxis4Rot.FromAngleAxis(cMath_ToRad(80), vAxis4);
//		cVector3f vVisionConeDir4 = cMath_MatrixMul(cMath_MatrixQuaternion(qAxis4Rot), vLookDir);
//		apFunctions.GetLowLevelGfx().DrawLine(mBaseObj.GetEyePostion(), mBaseObj.GetEyePostion() + vVisionConeDir4 * mBaseObj.GetSightRange(), cColor(5, 0.2, 0));
	}
	
