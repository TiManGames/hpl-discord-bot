	//------------------------------------------------------------
	
	//} END STATE SEARCH
	
	///////////////////////////////////
	// STATE: TIN HINAN
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbTinHinanModeActive = false;
	bool mbTinHinan_PlayerSeen = false;
	bool mbTinHinan_PrevPlayerSeen = false;
	bool mbTinHinan_WasInStruggle = false;
	bool mbTinHinan_Passive = false;
	bool mbTinHinan_IsDying = false;
	bool mbTinHinan_FirstSweep = false;
	float mfTinHinan_PlayerRunCount = 0.f;
	float mfTinHinan_PrevPlayerRunCount = 0.f;
	float mfTinHinan_SpottedCount = 0.f;
	float mfTinHinan_IgnorePlayerCount = 0.f;
	float mfTinHinan_EffectColorMul = 1.f;
	int mlTinHinan_LookAtCoverCount = 0;
	int mlTinHinan_SweepDir = 2;
	int mlTinHinan_ClosestCoverToPlayerId = -1;
	int mlTinHinan_CurrentCoverId = 0;
	int mlTinHinan_AnimationState = 1;
	cColor mTinHinan_SpotlightColorGoal = 0;
	array<tID> mvTinHinan_CoverIds;
	array<tID> mvTinHinan_CoverAreaIds;
	tID m_idTinHinan_GhostId = tID_Invalid;
	
	cColor mTinHinan_SpotlightColorIdle = cColor(0.6, 0.8, 0.9)*0.85;
	cColor mTinHinan_SpotlightColorAlert = cColor(1, 0.8, 0.6);
	cColor mTinHinan_SpotlightColorDetected = cColor(1, 0.5, 0.35)*1.2;
	cColor mTinHinan_SpotlightColorStruggle = cColor(1, 0.25, 0.3)*1.5;
	cColor mTinHinan_SpotlightColorCheck = cColor(0.3, 0.6, 1.4) * 0.25;
	
	//------------------------------------------------------------
	
	void State_TinHinan_Enter()
	{
		///////////////////////
		// Setup vars
		mbTinHinanModeActive = true;
		mbPeekDetectionActive = false;
		
		mlTinHinan_CurrentCoverId = 0;
		
		mfCrystal_SightRange = 60.f;
		mfCrystal_SightRangeMul = 1.f;
		
		mfTinHinan_PlayerRunCount = 0.f;
		mfTinHinan_SpottedCount = 0.f;
		
		mfSfx_SpotlightSoundVolumeMulGoal = 1.0f;
		mfSfx_SpotlightTurnSoundVolumeMulGoal = 1.0f;
		
		SetFlyModeActive(true);
		mpMover.SetBankingActive(false);
		
		StopSpotlightMovement();
		SetSpotlightBillboardActive(false);
		StopSoundLoops();
		
		iLuxEntity@ pCrystal = cLux_ID_Prop(m_idCrystal);
		pCrystal.SetIlluminationBaseColor(cColor(1.f));
		
		mTinHinan_SpotlightColorGoal = mTinHinan_SpotlightColorIdle;
		SetSpotLightColor(mTinHinan_SpotlightColorGoal);
		
		mpMover.SetUseMoveStateAnimations(false);
		
		///////////////////////
		// Setup behaviour
		mpStateMachine.AddTimer("SearchForPlayer", 1.f);
	}
	
	//------------------------------------------------------------

	void State_TinHinan_Leave() 
	{
		///////////////////////
		// Reset vars
		mbTinHinanModeActive = false;
		mbPeekDetectionActive = true;
		mfSpotlight_LerpSpeedMul = 1.f;
		mfCrystal_SightRange = gfWraithDefaultCrystalSightRange;
		mfCrystal_SightRangeMul = gfWraithDefaultCrystalSightRangeMul;
		mfSfx_SpotlightSoundVolumeMulGoal = 1.0f;
		mfSfx_SpotlightTurnSoundVolumeMulGoal = 0.5f;
		
		SetFlyModeActive(false);
	}
	
	//------------------------------------------------------------
	
	void State_TinHinan_Update(float afTimeStep) 
	{		
		TinHinan_UpdateCovers(afTimeStep);
		TinHinan_UpdatePlayerDetection(afTimeStep);
		TinHinan_UpdateSpotLight(afTimeStep);
		TinHinan_UpdateTurning(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void TinHinan_UpdateCovers(float afTimeStep)
	{
		cLightSpot@ pSpotLight = cast<cLightSpot>(cLux_ID_Light(m_idSpotLight));		
		iLuxEntity@ pGhost = cLux_ID_Entity(m_idTinHinan_GhostId);
		
		int lMaxCoverId = cMath_Min(mlTinHinan_CurrentCoverId + 5, mvTinHinan_CoverIds.size());
		while (mlTinHinan_CurrentCoverId < lMaxCoverId)
		{
			cLuxProp@ pCover = cLux_ID_Prop(mvTinHinan_CoverIds[mlTinHinan_CurrentCoverId]);
			if (pCover is null || pCover.IsActive() == false)
			{
				mlTinHinan_CurrentCoverId++;
				continue;
			}				
			
			//////////////////////
			// Determine state
			cVector3f vCoverPos = pCover.GetOnLoadTransform().GetTranslation() + cVector3f(0.f, 1.5f, 0.f);
			
			int lCoverState = 0;
			bool bInFov = pSpotLight.GetFrustum().CollideSphere(vCoverPos, 0.5f, 6) != eCollision_Outside;
			
			if (bInFov && mbCrystal_Active)							lCoverState = 1;
			else if (bInFov == false || mbCrystal_Active == false)	lCoverState = -1;
			
			if (pGhost !is null && pGhost.IsActive())
			{
				vCoverPos.y = pGhost.GetPosition().y;
				const float fRangeSqr = 4.f * 4.f;
				
				if ((vCoverPos - pGhost.GetPosition()).SqrLength() < fRangeSqr)
					lCoverState = 1;
			}
			
			//////////////////////
			// Open/close!
			bool bIsOpen = pCover.GetVarBool("VineOpen");				
			if (lCoverState == 1 && bIsOpen == false)
			{
				pCover.SetVarBool("VineOpen", true);
					
				cScript_SetGlobalArgFloat(0, mbTinHinan_Passive ? 2.f : 1.f);
				cScript_RunGlobalFunc(pCover.GetName(), "cScrPropVineCover", "_Global_Open");
			}
			else if (lCoverState == -1 && bIsOpen && mbTinHinan_IsDying == false)
			{
				pCover.SetVarBool("VineOpen", false);
					
				cScript_SetGlobalArgBool(0, false);
				cScript_RunGlobalFunc(pCover.GetName(), "cScrPropVineCover", "_Global_Close");
			}
			
			mlTinHinan_CurrentCoverId++;
		}
		
		mlTinHinan_CurrentCoverId %= mvTinHinan_CoverIds.size();
	}
	
	//------------------------------------------------------------
	
	void TinHinan_UpdatePlayerDetection(float afTimeStep)
	{
		//////////////////
		// Ignore player if passive
		if (mbTinHinan_Passive)
		{
			mfTinHinan_IgnorePlayerCount = 100.f;
			mbTinHinan_PlayerSeen = false;
			mbTinHinan_PrevPlayerSeen = false;
		}			
		
		//////////////////
		// Ignore player after struggle
		bool bInStruggle = Struggle_IsActive(true);
		if (bInStruggle == false && mbTinHinan_WasInStruggle)
			mfTinHinan_IgnorePlayerCount = 5.f;
		
		if (mfTinHinan_IgnorePlayerCount > 0.f)
			mfTinHinan_IgnorePlayerCount -= afTimeStep;
		
		mbTinHinan_WasInStruggle = bInStruggle;
		
		//////////////////
		// Spotted player?
		if (mbTinHinan_PlayerSeen && mfTinHinan_IgnorePlayerCount <= 0.f)
		{						
			mfTinHinan_SpottedCount -= afTimeStep;			
			if (mfTinHinan_SpottedCount <= 0.f && bInStruggle == false)
			{				
				mTinHinan_SpotlightColorGoal = mTinHinan_SpotlightColorDetected;
				
				//////////////////
				// Reset behaviour
				mfTinHinan_SpottedCount = 0.f;
				mbTinHinan_PrevPlayerSeen = true;
				
				mpStateMachine.StopTimer("SearchForPlayer");
				mpStateMachine.StopTimer("LookAtCoverEdge");
				mpStateMachine.StopTimer("HearBaby");
			
				StopSpotlightMovement();
				
				m_idCrystal_FollowTarget = mBaseObj.GetMap().GetPlayerEntity().GetID();
				mvFollowTarget_Offset = 0.f;
				mbFollowTarget_LocalOffset = false;
				
				//////////////////
				// Map callback
				ExecuteEntityCallback("OnPlayerFound_TinHinan");
			}		
		}
		//////////////////
		// Player not spotted!
		else
		{			
			mfTinHinan_SpottedCount = 0.5f;
			
			if (mbTinHinan_PrevPlayerSeen)
			{				
				//////////////////
				// Start looking again
				mbTinHinan_PrevPlayerSeen = false;
				
				m_idCrystal_FollowTarget = tID_Invalid;
				mvFollowTarget_Offset = 0.f;
				mbFollowTarget_LocalOffset = false;
				
				mpStateMachine.StopTimer("SearchForPlayer");
				mpStateMachine.StopTimer("LookAtCoverEdge");
				mpStateMachine.StopTimer("HearBaby");
				
				// Start looking again!
				if (mbTinHinan_Passive == false)
					mpStateMachine.AddTimer("HearBaby", mfTinHinan_IgnorePlayerCount);		
				
				//////////////////
				// Map callback
				ExecuteEntityCallback("OnPlayerLost_TinHinan");
			}			
		}
		
		///////////////////////
		// Player running?		
		if (mbTinHinan_Passive)
			return;
		
		if (Player_GetRunning())	mfTinHinan_PlayerRunCount += afTimeStep;
		else						mfTinHinan_PlayerRunCount = cMath_IncreaseTo(mfTinHinan_PlayerRunCount, afTimeStep * 3.f, 0.f);
		
		int lPlayerRunStage = -1;
		if (mfTinHinan_PlayerRunCount >= 1.f && mfTinHinan_PrevPlayerRunCount < 1.f)
		{
			lPlayerRunStage = 1;
		}
		else if (mfTinHinan_PlayerRunCount >= 5.f && mfTinHinan_PrevPlayerRunCount < 5.f)
		{
			lPlayerRunStage = 2;
			mfTinHinan_PlayerRunCount = 0.f;
			
			/////////////////////
			// Running a lot! Sweep in front of player!
			if (mpStateMachine.TimerExists("LookAtCoverEdge") == false)
			{
				mpStateMachine.StopTimer("SearchForPlayer");				
				TinHinan_SearchForPlayer(true);
			}
		}
		
		/////////////////////
		// Map callback!
		if (lPlayerRunStage != -1)
		{
			cLuxMap@ pMap = mBaseObj.GetMap();
			tString sFunc = "void OnPlayerRunning_TinHinan(int alStage)";
			if (pMap.ScriptMethodExists(sFunc) && pMap.ScriptPrepare(sFunc))
			{
				pMap.SetArgInt(0, lPlayerRunStage);
				pMap.ScriptExecute();
			}
		}
		
		mfTinHinan_PrevPlayerRunCount = mfTinHinan_PlayerRunCount;
	}
	
	//------------------------------------------------------------
	
	void TinHinan_UpdateSpotLight(float afTimeStep)
	{
		cLightSpot@ pSpotLight = cast<cLightSpot>(cLux_ID_Light(m_idSpotLight));
		
		float fSwayAngle = cMath_ToRad(cMath_Sin(cEngine_GetGameTime()) * 1.5f) * 1.5f;
		mfCrystal_TargetHAngle += fSwayAngle * afTimeStep;
		
		float fSpeedMulGoal = mSpotlightMovement != eWraithLightMovement_None ? 1.f : 0.25f;
		mfSpotlight_LerpSpeedMul = cMath_IncreaseTo(mfSpotlight_LerpSpeedMul, afTimeStep * 0.25f, fSpeedMulGoal);
				
		cColor newColor = pSpotLight.GetDiffuseColor() * (1.f - afTimeStep) + mTinHinan_SpotlightColorGoal * afTimeStep;
		SetSpotLightColor(newColor);
		
		mBaseObj.SetEffectBaseColor(newColor);
	}
	
	//------------------------------------------------------------
	
	void TinHinan_UpdateTurning(float afTimeStep)
	{
		/////////////////////
		// Setup vars
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		int lTurnState = 0;
		
		/////////////////////
		// Turn along with crystal		
		float fYaw = mBaseObj.GetCharBody().GetYaw();
		float fCrystalYaw = cMath_GetAngleFromPoints3D(0.f, pCrystal.GetMatrix().GetTranspose().GetForward()).y;
		float fCrystalYawGoal = cMath_GetAngleFromPoints3D(0.f, mvCrystal_TargetDir).y;
		float fDiff = cMath_GetAngleDistanceRad(fYaw, fCrystalYawGoal);		
		
		mpMover.TurnToAngle(fCrystalYaw);
			
		if (cMath_Abs(fDiff) > cMath_ToRad(5.f))
			lTurnState = cMath_Sign(fDiff);	
		
		/////////////////////
		// Update animations
		tString sAnim = "idle_" + mlTinHinan_AnimationState;
		float fFadeSpeed = 0.4f;
		
		if (lTurnState == -1)
		{
			sAnim = "turn_right_" + mlTinHinan_AnimationState;
			fFadeSpeed = 0.5f;
		}
		else if (lTurnState == 1)
		{
			sAnim = "turn_left_" + mlTinHinan_AnimationState;
			fFadeSpeed = 0.5f;
		}
			
		if (mBaseObj.GetMeshEntity().GetAnimationStateFromName(sAnim).IsActive() == false)
			mBaseObj.PlayAnimation(sAnim, fFadeSpeed, true, true);
	}
	
	//------------------------------------------------------------

	bool State_TinHinan_Message(int alMessageId) 
	{ 
		return false; 
	}
	
	//------------------------------------------------------------
	
	void State_TinHinan_TimerUp(uint64 alId) 
	{
		if (alId == H64("SearchForPlayer"))
		{
			TinHinan_SearchForPlayer();			
		}
		else if (alId == H64("HearBaby"))
		{
			TinHinan_HearBaby();
		}
		else if (alId == H64("LookAtCoverEdge"))
		{			
			TinHinan_LookAtCoverEdge();
		}
	}
	
	//------------------------------------------------------------
	
	void TinHinan_LookAtCoverEdge()
	{
		cLux_AddDebugMessage("[Tin Hinan] Look at cover edge");
		
		mTinHinan_SpotlightColorGoal = mTinHinan_SpotlightColorAlert;
		
		/////////////////////
		// Find edges of the closest cover
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		cBoundingVolume@ pBounds = cLux_ID_Area(mvTinHinan_CoverAreaIds[mlTinHinan_ClosestCoverToPlayerId]).GetAreaBody().GetBoundingVolume();
			
		bool bCheckRight = mlTinHinan_LookAtCoverCount % 2 != 0;
		cVector3f vOffset = pBounds.GetTransform().GetTranspose().GetRight() * (bCheckRight ? pBounds.GetLocalMax().x : pBounds.GetLocalMin().x);
		cVector3f vPos = pBounds.GetWorldCenter() + vOffset;
		cVector3f vDir = cMath_Vector3Normalize(vPos - pCrystal.GetPosition());
		
		/////////////////////
		// Look at the edge
		mlTinHinan_LookAtCoverCount++;			
		if (mlTinHinan_LookAtCoverCount > 2)
		{
			mpStateMachine.AddTimer("SearchForPlayer", cMath_RandRectf(2.f, 3.f));
			return;
		}
			
		TurnSpotlightToDir(vDir, true, true, 0.4f, 1.f);			
		mpStateMachine.AddTimer("LookAtCoverEdge", cMath_RandRectf(4.f, 5.f));
	}
	
	//------------------------------------------------------------
	
	void TinHinan_SearchForPlayer(bool abPlayerRunning = false)
	{				
		cLux_AddDebugMessage("[Tin Hinan] Search for player");
		
		if (mbTinHinan_PlayerSeen == false)
			mTinHinan_SpotlightColorGoal = mTinHinan_SpotlightColorIdle;
		
		if (abPlayerRunning)
			mpStateMachine.StopTimer("HearBaby");
		
		/////////////////////
		// Look in search dir!
		cVector3f vDir = TinHinan_GetSearchDir(abPlayerRunning);		
		float fSpeed = abPlayerRunning ? 1.f : 0.4f;
		float fTime = cMath_RandRectf(4.5f, 5.5f);
		TurnSpotlightToDir(vDir, true, true, fSpeed, 1.f);
		
		if (abPlayerRunning == false)
			mpStateMachine.AddTimer("SearchForPlayer", fTime);
		else
			mpStateMachine.AddTimer("HearBaby", fTime);
	}
	
	//------------------------------------------------------------
	
	cVector3f TinHinan_GetSearchDir(bool abPlayerRunning)
	{
		/////////////////////
		// Calculate dir
		cVector3f vDir = 0.f;
		cVector3f vTarPos = mBaseObj.GetPlayerFeetPos();
		cVector3f vCrystalPos = cLux_ID_Entity(m_idCrystal).GetPosition();
					
		// A little ahead of player if running
		if (abPlayerRunning)
		{
			cVector3f vPlayerVel = cLux_GetPlayer().GetCharacterBody().GetVelocity(cEngine_GetStepSize());			
			vTarPos = mBaseObj.GetPlayerFeetPos() + cMath_Vector3Normalize(vPlayerVel) * 13.f;
		}
		
		vDir = vTarPos - vCrystalPos;
		vDir.y = 0.f;
		vDir.Normalize();
		
		/////////////////////
		// Look in the same direction a couple of times
		const int lMinSameDirSweepCount = 2;
		int lPrevDir = cMath_Sign(mlTinHinan_SweepDir);
		
		if (cMath_Abs(mlTinHinan_SweepDir) >= lMinSameDirSweepCount)
		{
			int lNewDir = cMath_Sign(cMath_RandRectf(-1.f, 1.f));
			if (lNewDir != lPrevDir)
			{
				mlTinHinan_SweepDir = lNewDir;
			}
			else
			{
				mlTinHinan_SweepDir += lPrevDir;
				if (cMath_Abs(mlTinHinan_SweepDir) >= lMinSameDirSweepCount + 2)
					mlTinHinan_SweepDir = lPrevDir * -1;
			}
		}
		else
		{
			mlTinHinan_SweepDir += lPrevDir;
		}	
		
		/////////////////////
		// Apply angle
		float fAngle = abPlayerRunning ? 0.f : cMath_ToRad(cMath_RandRectf(20.f, 40.f)) * cMath_Sign(mlTinHinan_SweepDir);
		
		if (mbTinHinan_FirstSweep)
		{
			fAngle = cMath_ToRad(30.f);
			mbTinHinan_FirstSweep = false;
		}
	
		vDir = cMath_MatrixMul(cMath_MatrixRotateY(fAngle), vDir);
		vDir.y = TinHinan_GetPitch();
		
		return vDir;
	}
	
	//------------------------------------------------------------
	
	float TinHinan_GetPitch()
	{
		/////////////////////
		// Adjust pitch after player pos
		cVector3f vPos = cLux_ID_Entity(m_idCrystal).GetPosition();
		cVector3f vDir = cMath_Vector3Normalize(mBaseObj.GetPlayerFeetPos() - vPos);
		float fPitch = cMath_ATan2(vDir.y, cMath_Sqrt(vDir.x * vDir.x + vDir.z * vDir.z));
		return -cMath_Abs(fPitch);
	}
		
	//------------------------------------------------------------
	
	void TinHinan_HearBaby()
	{
		if (mbTinHinan_PlayerSeen || mbTinHinan_Passive)
			return;
			
		cLux_AddDebugMessage("[Tin Hinan] Heard baby");		
		
		mTinHinan_SpotlightColorGoal = mTinHinan_SpotlightColorAlert;		
		mpStateMachine.StopTimer("SearchForPlayer");
		
		/////////////////////
		// Find closest cover
		int lClosestId = -1;
		float fShortestDistSqr = 1000.f * 1000.f;
		cVector3f vPlayerPos = mBaseObj.GetPlayerFeetPos();
		
		for (int i = 0; i < mvTinHinan_CoverAreaIds.size(); i++)
		{
			cLuxArea@ pArea = cLux_ID_Area(mvTinHinan_CoverAreaIds[i]);
			cVector3f vAreaPos = pArea.GetPosition();
			vAreaPos.y = vPlayerPos.y;
			
			float fDistSqr = (vPlayerPos - vAreaPos).SqrLength();
			if (fDistSqr < fShortestDistSqr)
			{
				lClosestId = i;
				fShortestDistSqr = fDistSqr;
			}
		}
		
		mlTinHinan_ClosestCoverToPlayerId = lClosestId;			
		mlTinHinan_LookAtCoverCount = 0;
		
		/////////////////////
		// Look towards player
		cVector3f vDir = mBaseObj.GetPlayerDir();
		vDir.y = TinHinan_GetPitch();		
		
		TurnSpotlightToDir(vDir, true, true, 1.f, 1.f);
		
		mpStateMachine.StopTimer("LookAtCoverEdge");
		mpStateMachine.AddTimer("LookAtCoverEdge", cMath_RandRectf(2.f, 3.5f));
	}
	
	//------------------------------------------------------------
	
	void _Global_ModeTinHinan_HearBaby()
	{				
		TinHinan_HearBaby();
	}
	
	//------------------------------------------------------------
	
	void _Global_ModeTinHinan_SetPassive()
	{
		mbTinHinan_Passive = cScript_GetGlobalArgBool(0);
		
		if (mbTinHinan_Passive)
		{
			mpStateMachine.StopTimer("LookAtCoverEdge");
			mpStateMachine.StopTimer("SearchForPlayer");
			mpStateMachine.StopTimer("HearBaby");
		}
		else
		{
			mfTinHinan_IgnorePlayerCount = 0.1f;
			mpStateMachine.AddTimer("SearchForPlayer", 1.f);
			
			mbTinHinan_FirstSweep = true;
		}		
	}
	
	//------------------------------------------------------------
	
	void _Global_ModeTinHinan_SetDying()
	{
		mbTinHinan_IsDying = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_ModeTinHinan_SetAnimationState()
	{
		mlTinHinan_AnimationState = cScript_GetGlobalArgInt(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_ModeTinHinan_SetSpotlightColor()
	{
		tString sColor = cScript_GetGlobalArgString(0);
		if (sColor == "detected")		mTinHinan_SpotlightColorGoal = mTinHinan_SpotlightColorDetected;
		else if (sColor == "alert")		mTinHinan_SpotlightColorGoal = mTinHinan_SpotlightColorAlert;
		else if (sColor == "idle")		mTinHinan_SpotlightColorGoal = mTinHinan_SpotlightColorIdle;
	}
	
	//------------------------------------------------------------
	
	void _Global_ModeTinHinan_Setup()
	{
		tString sCovers = cScript_GetGlobalArgString(0);
		tString sCoverAreas = cScript_GetGlobalArgString(1);
		tString sGhost = cScript_GetGlobalArgString(2);
		
		mvTinHinan_CoverIds.resize(0);
		mvTinHinan_CoverAreaIds.resize(0);
		mBaseObj.GetMap().GetEntityArrayID(sCovers, eLuxEntityType_Prop, "", mvTinHinan_CoverIds);
		mBaseObj.GetMap().GetEntityArrayID(sCoverAreas, eLuxEntityType_Area, "", mvTinHinan_CoverAreaIds);
		
		iLuxEntity@ pEnt = mBaseObj.GetMap().GetEntityByName(sGhost);
		m_idTinHinan_GhostId = pEnt is null ? tID_Invalid : pEnt.GetID();
	}
	
