			case eWraithMode_None: return "None";
			case eWraithMode_Patrol: return "Patrol";
			case eWraithMode_WraithPatrol: return "WraithPatrol";
			case eWraithMode_ControlGhoul: return "ControlGhoul";
			case eWraithMode_FlyPatrol: return "FlyPatrol";
			case eWraithMode_TinHinan: return "TinHinan";
			case eWraithMode_FlyFollowEntity: return "FlyFollowEntity";
			case eWraithMode_GuardPosition: return "GuardPosition";
		}
		return "";
	}
	
