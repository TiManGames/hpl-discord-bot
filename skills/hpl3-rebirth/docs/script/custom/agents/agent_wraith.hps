	void _Global_CommandDisappear_Execute()
	{
		mbCommandStealthWait_Forced = cScript_GetGlobalArgBool(0);
		
		mCommand = eWraithCommand_Disappear;
		msCommandCompletedCallback = cScript_GetGlobalArgString(1);
		mbCommandStealthWait_Silent = cScript_GetGlobalArgBool(2);
		
		if (mbCommandStealthWait_Forced)
		{
			mbStealthWait_Silent = mbCommandStealthWait_Silent;
			mpStateMachine.ChangeState(eWraithState_StealthWait);
		}
	}
	
	void UpdateCommandDisappear(float afTimeStep)
	{
		if (mbCommandStealthWait_Forced) return;
		if (mCommand != eWraithCommand_Disappear) return;
		
		mfCommandStealthWait_UpdateTimer -= afTimeStep;
		if (mfCommandStealthWait_UpdateTimer > 0) return;
		
		mfCommandStealthWait_UpdateTimer = cMath_RandRectf(0.2, 0.4);
		
		if (mbOnScreen && mbPlayerCameraLineOfSight) return;
		
		mbCommandStealthWait_Forced = true;
		mbStealthWait_Silent = mbCommandStealthWait_Silent;
		mpStateMachine.ChangeState(eWraithState_StealthWait);
	}
	
	//------------------------------------------------------------
	
	cVector3f mvCommandSearch_Pos;
	void _Global_CommandSearch_Execute()
	{
		mCommand = eWraithCommand_Search;
		msCommandCompletedCallback = cScript_GetGlobalArgString(1);
		mvCommandSearch_Pos = cScript_GetGlobalArgVector3f(2);
		if (cScript_GetGlobalArgBool(0)) mpStateMachine.ChangeState(eWraithState_Idle);
	}
	
	//------------------------------------------------------------
	
	cVector3f mvCommandDash_Pos;
	bool mbCommandDash_Quick = false;
	bool mbCommandDash_DisappearAfter = false;
	void _Global_CommandDash_Execute()
	{
		if (mpStateMachine.GetCurrentState() == eWraithState_Dash) mbDash_CommandExit = true;
		
		mCommand = eWraithCommand_Dash;
		mbCommandDash_Quick = cScript_GetGlobalArgBool(0);
		mbCommandDash_DisappearAfter = cScript_GetGlobalArgBool(4);
		msCommandCompletedCallback = cScript_GetGlobalArgString(2);
		mvCommandDash_Pos = cScript_GetGlobalArgVector3f(3);
		if (cScript_GetGlobalArgBool(1) && mpStateMachine.GetCurrentState() != eWraithState_Dash) mpStateMachine.ChangeState(eWraithState_Idle);
	}
	
	//------------------------------------------------------------
	
	//} END COMMANDS
	
	//------------------------------------------------------------
	
	//} END GLOBALS
	
	//===========================================================
	
	/////////////////////////////////////////
	//=======================================
	// STATES
	//=======================================
	//{//////////////////////////////////////
	
	//===========================================================
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: DEFAULT
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Default_Enter()
	{
	}
	
	void State_Default_Leave() 
	{
	}
	
	void State_Default_Update(float afTimeStep) 
	{
		
	}
	
	bool State_Default_Message(int alMessageId) 
	{ 
		if (mbTinHinanModeActive) return true;
		if (mbStealthModeActive) return true;
		
		int lState = mpStateMachine.GetCurrentState();
		int lProximityState = mpStateMachine.GetCurrentMessageData().mlX;
		
		//////////////////////
		// Player Detected
		if(alMessageId == eLuxEntityMessage_PlayerDetected)
		{
			if (GetSensesActive() == false) return false;
			mpStateMachine.ChangeState(eWraithState_PlayerDetected);
			return false;
		}
		
		else if (alMessageId == eLuxEntityMessage_PlayerUndetected)
		{
		}
		
		/////////////////////
		// Heard sound
		else if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (GetSensesActive() == false) return false;
			if (mbHearing == false) return true;
			if (ShouldHearSound(mpStateMachine.GetCurrentMessageData().mvX, mpStateMachine.GetCurrentMessageData().mlX, mpStateMachine.GetCurrentMessageData().msX))
			{
				if (mbFlyMode_Active == false)
				{
					mvSearch_Pos = mvSoundHeard_Pos;
					mlSearch_Prio = mlSoundHeard_Prio;
					mpStateMachine.ChangeState(eWraithState_Search);
				}
				else
				{
					mvFlySearch_Pos = mvSoundHeard_Pos;
					mpStateMachine.ChangeState(eWraithState_FlySearch);
				}
			}
			return false;
		}
		
		else if (alMessageId == eCustomEntityMessage_SeeFlashlightGobo)
		{
			if (GetSensesActive() == false) return false;
			mfGoboDetectionCounter += 0.25f;
			if (mbStealthModeActive == false && mfGoboDetectionCounter >= 1.0f)
			{
				mfGoboDetectionCounter = 0;
				mvPlayerLanternDetected_LightPos = mBaseObj.GetPlayerPos();
				if (mbLanternDetectionStates) mpStateMachine.ChangeState(eWraithState_PlayerLanternDetected);
				else mpStateMachine.AddTimer("SeeFlashlightGobo", 0.0f);
			}
			return true;
		}
		
		else if (alMessageId == eCustomEntityMessage_HitByFlashlight)
		{
			if (GetSensesActive() == false) return false;
			mfFlashlightDetectionCounter += 0.3f;
			if (mbStealthModeActive == false && mfFlashlightDetectionCounter >= 1.0f)
			{
				mfFlashlightDetectionCounter = 0;
				mpStateMachine.ChangeState(eWraithState_PlayerGazeDetected);
//				mvPlayerLanternDetected_LightPos = mBaseObj.GetPlayerPos();
//				if (mbLanternDetectionStates) mpStateMachine.ChangeState(eWraithState_PlayerLanternDetected);
//				else mpStateMachine.AddTimer("HitByFlashlight", 0.0f);
			}
			return true;
		}
		
		else if (alMessageId == eCustomEntityMessage_PlayerGazeDetected)
		{
			if (GetSensesActive() == false) return false;
			mpStateMachine.ChangeState(eWraithState_PlayerGazeDetected);
		}
		
		else if(alMessageId == eCustomEntityMessage_StuckCounterHigh)
		{
			mpStateMachine.ChangeState(eWraithState_Blocked);
		}
		
		/////////////////////
		// Proximity Sensors
		else if(alMessageId == eLuxEntityMessage_LeaveProximity)
		{
		
		}
		
		else if(alMessageId == eLuxEntityMessage_EnterProximity)
		{
			if (GetSensesActive() == false) return false;
			if (lProximityState == eWraithProximity_ProximityAttack)
			{
				if (mbPlayerCameraLineOfSight == false)
				{
					mBaseObj.ResetPlayerDetectionState();
				}
			}
		}
		
		else if (alMessageId == eLuxEntityMessage_HitByProp)
		{
			if (GetSensesActive() == false) return false;
			
			cLuxProp@ pProp = cLux_ID_Prop(m_idLastHitProp);
			if (pProp is null) return false;
			
			cVector3f vPos = pProp.GetPosition();

			float fHitSpeed = mpStateMachine.GetCurrentMessageData().mvX.x;
			float fHitHeightFromFeet = vPos.y - mBaseObj.GetCharBody().GetFeetPosition().y;
			float fDistance = cMath_Vector3Dist(vPos, mBaseObj.GetCharBody().GetFeetPosition());
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Hit by object (Speed: " + fHitSpeed + " TimeSinceLastInteraction: " + cLux_GetPlayer().GetTimeSincePhysicsObjectInteraction() + " HeightFromFeet: " + fHitHeightFromFeet + ")");
			
			if (fHitSpeed < 1.4f) return false;
			if (cLux_GetPlayer().GetTimeSincePhysicsObjectInteraction() > 1.0f) return false;
			if (fHitHeightFromFeet <= 0.3f) return false;
			
			mvSearch_Pos = mBaseObj.GetPlayerPos();
			mpStateMachine.ChangeState(eWraithState_Search);
		}
		
		else if (alMessageId == eCustomEntityMessage_PlayerSubmerged)
		{
			cLux_AddDebugMessage("SUBMERGED");
			mfSpotlightBrightnessMul = 3.0;
			SetSpotLightColor(mSpotlightcolor);
			mbPlayerSubmerged = true;
		}
		else if (alMessageId == eCustomEntityMessage_PlayerEmerged)
		{
			cLux_AddDebugMessage("SUBMERGED NOT");
			mbPlayerSubmerged = false;
			mfSpotlightBrightnessMul = 1;
			SetSpotLightColor(mSpotlightcolor);
			mBaseObj.ResetPlayerDetectionState();
		}
		
		else if (alMessageId == eLuxEntityMessage_PlayerDead)
		{
			if (FearHandler_GetIsPermaFailing() == false) return true;
			
			mfPermafailInvulnerabilityTimer = 6;
		}
		
		return false; 
	}
	
	void State_Default_TimerUp(uint64 alId) 
	{
		
	}
	
	//------------------------------------------------------------
	
	//}END STATE: DEFAULT
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: IDLE
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbIdle_ResetOnce = true;
	bool mbIdle_Reset = true;
	bool mbIdle_SpotlightOn = false;
	
	//------------------------------------------------------------
	
	void State_Idle_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Idle ------");
		
		if (mBaseObj.IsActive() == false) return;
		
		CreateCrystal();
		InitSpotlightBillboards();
		SetIdleSwayActive(true);
		
		SetAlertState(eWraithAlertState_None, true);
		
		FadeIdleLoopVolume(1, 1);
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Walk);
		
		if (mbIdle_Reset && (mMode == eWraithMode_Idle || mCommand == eWraithCommand_Custom || mMode == eWraithMode_FlyPatrol))
		{
			SetSpotLightActive(mbIdle_SpotlightOn);
			StopSpotlightMovement();
			SetSpotlightMovement_SidewaysEight(1.0f, 0.06f, 0.04f);
			SetSpotLightColor(mSpotlightColor_Idle);
		}
		
		SetMoveAnimState(eWraithMoveAnimState_Default);
		
		mpStateMachine.AddTimer("DecideBehavior", 0.0f);
	}
	
	//------------------------------------------------------------
	
	void State_Idle_Leave()
	{
		SetIdleSwayActive(false);
		
		if (mbIdle_ResetOnce)
		{
			mbIdle_ResetOnce = false;
			mbIdle_Reset = true;
		}
		if (mCommand == eWraithCommand_Custom)
		{
			ExecuteEntityCallback(msCommandCompletedCallback);
			mCommand = eWraithCommand_None;
		}
	}
	
	//------------------------------------------------------------
	
	void State_Idle_Update(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	bool State_Idle_Message(int alMessageId)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_Idle_TimerUp(uint64 alId) 
	{
		if(alId == H64("DecideBehavior"))
		{
			mpStateMachine.AddTimer("DecideBehavior", 0.5f);
			if (DecideBehavior()) cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Behavior decided: " + mpStateMachine.GetNextState());
		}
	}
	
	//------------------------------------------------------------
	
	bool DecideBehavior()
	{
		if (DecideCommandBehavior()) return true;
		if (DecideModeBehavior()) return true;
		return false;
	}
	
	//------------------------------------------------------------
	
	bool DecideCommandBehavior()
	{
		if (mCommand == eWraithCommand_Custom)
		{
			mpStateMachine.ChangeState(eWraithState_Custom);
			return true;
		}
		else if (mCommand == eWraithCommand_Patrol)
		{
			if (mPatrol_CommandInstance.mvNodes.size() < 1)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ERROR: No patrol nodes, will stay in idle");
				return false;
			}
			
			mPatrol_NextInstance = mPatrol_CommandInstance;
			mpStateMachine.ChangeState(eWraithState_Patrol);
			return true;
		}
		else if (mCommand == eWraithCommand_ScanPosition)
		{
			mpStateMachine.ChangeState(eWraithState_InspectPosition);
			return true;
		}
		else if (mCommand == eWraithCommand_SearchArea)
		{
			mbSearch_MoveDirectly = true;
			mvSearch_Pos = mvCommandSearchArea_Pos;
			mpStateMachine.ChangeState(eWraithState_Search);
			return true;
		}
		else if (mCommand == eWraithCommand_Pulse)
		{
			mpStateMachine.ChangeState(eWraithState_Pulse);
			return true;
		}
		else if (mCommand == eWraithCommand_FlyToNode)
		{
			mpStateMachine.ChangeState(eWraithState_FlyToNode);
			return true;
		}
		else if (mCommand == eWraithCommand_FlySpotlightSearch)
		{
			mpStateMachine.ChangeState(eWraithState_FlySpotlightSearch);
			return true;
		}
		else if (mCommand == eWraithCommand_LookAtPosition)
		{
			mpStateMachine.ChangeState(eWraithState_LookAtPosition);
			return true;
		}
		else if (mCommand == eWraithCommand_Disappear)
		{
			return false;
			
//			mbStealthWait_Silent = mbCommandStealthWait_Silent;
//			mpStateMachine.ChangeState(eWraithState_StealthWait);
//			return true;
		}
		else if (mCommand == eWraithCommand_Search)
		{
			mvSearch_Pos = mvCommandSearch_Pos;
			mpStateMachine.ChangeState(eWraithState_Search);
			return true;
		}
		else if (mCommand == eWraithCommand_Dash)
		{
			mvDash_Pos = mvCommandDash_Pos;
			mbDash_Quick = mbCommandDash_Quick;
			mpStateMachine.ChangeState(eWraithState_Dash);
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	bool DecideModeBehavior()
	{
		if (mMode == eWraithMode_Patrol)
		{
			if (mPatrol_ModeInstance.mvNodes.size() < 1)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ERROR: No patrol nodes, will stay in idle");
				return false;
			}
			
			mPatrol_NextInstance = mPatrol_ModeInstance;
			mpStateMachine.ChangeState(eWraithState_Patrol);
			return true;
		}
		else if (mMode == eWraithMode_WraithPatrol)
		{
			if (mPatrol_ModeWraithPatrolInstance.mvNodes.size() < 1)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ERROR: No patrol nodes, will stay in idle");
				return false;
			}
			
			mPatrol_NextInstance = mPatrol_ModeWraithPatrolInstance;
			mpStateMachine.ChangeState(eWraithState_Patrol);
			return true;
		}
		else if (mMode == eWraithMode_ControlGhoul)
		{
			mfControlGhoul_MaxDist = mfModeControlGhoul_MaxDist;
			mfControlGhoul_MinDist = mfModeControlGhoul_MinDist;
			mpStateMachine.ChangeState(eWraithState_ControlGhoul);
		}
		else if (mMode == eWraithMode_FlyPatrol)
		{
			if (mlModeFlyPatrol_Stage == 0) mpStateMachine.ChangeState(eWraithState_FlyToNode);
			else mpStateMachine.ChangeState(eWraithState_FlySpotlightSearch);
			return true;
		}
		else if (mMode == eWraithMode_FlyFollowEntity)
		{
			mpStateMachine.ChangeState(eWraithState_FlyFollowEntity);
			return true;
		}
		else if (mMode == eWraithMode_TinHinan)
		{
			mpStateMachine.ChangeState(eWraithState_TinHinan);
			return true;
		}
		else if (mMode == eWraithMode_GuardPosition)
		{
			if (mBaseObj.GetDistanceToPos(mvGuardPosition_StandPosition) > 4)
			{
				mvDash_Pos = mvGuardPosition_StandPosition;
				mpStateMachine.ChangeState(eWraithState_Dash);
			}
			else mpStateMachine.ChangeState(eWraithState_GuardPosition);
			return true;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	//} END STATE: IDLE
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: INVESTIGATE SOUND
	//{////////////////////////////////

	//------------------------------------------------------------
	
	cVector3f mvInvestigateSound_Goal;
	int mlInvestigateSound_Prio;
		
	//------------------------------------------------------------
	
	void State_InvestigateSound_Enter() 
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: InvestigateSound ------");
				
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_StealthMode);
		
		SetStealthModeActive(true);
		
		mpStateMachine.AddTimer("SoundHeardReaction", 0.0f);
		mpStateMachine.AddTimer("MoveToGoal", 0.3f);
		
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul * 1.5f);
		SetAlertState(eWraithAlertState_Searching);
	}
	
	//------------------------------------------------------------

	void State_InvestigateSound_Leave() 
	{
		StopDirectMove();
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul);
	}
	
	//------------------------------------------------------------
	
	void State_InvestigateSound_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_InvestigateSound_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_PlayerDetected)
		{
			return mbStealthModeActive;
		}
		
		if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbHearing == false) return true;
			if (mbStealthModeActive == false) return true;
			if (mpStateMachine.TimerExists("StealthAppear")) return true;
			
			int lPrio = mpStateMachine.GetCurrentMessageData().mlX;
			cVector3f vPos = mpStateMachine.GetCurrentMessageData().mvX;
			
			if (ShouldHearSound(vPos, lPrio, mpStateMachine.GetCurrentMessageData().msX))
			{
				mpStateMachine.StopTimer("StartAppearing");
				mpStateMachine.AddTimer("MoveToGoal", 0.2f);
				
				mpStateMachine.AddTimer("SoundHeardReaction", 0.0f);
			}
			
			return true;
		}
		
		if (alMessageId == eLuxEntityMessage_EnterProximity && mpStateMachine.GetCurrentMessageData().mlX == eWraithProximity_StealthSense) return false;
		
		if (alMessageId == eCustomEntityMessage_DirectMoveToGoalReached)
		{
			mlInvestigateSound_Prio = -1;
			mpStateMachine.AddTimer("StartAppearing", 0.5f);
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_InvestigateSound_TimerUp(uint64 alId) 
	{
		
		if (alId == H64("SoundHeardReaction"))
		{
			mBaseObj.PlaySound("SoundHeard", gsWraithSound_Hears_a_sound, true, true);
		}
		
		if (alId == H64("StartSearchReaction"))
		{
			mBaseObj.PlaySound("StartSearch", gsWraithSound_StartSearch, true, true);
		}
		
		if (alId == H64("MoveToGoal"))
		{
			mpStateMachine.AddTimer("StartSearchReaction", 0.0f);
			MoveDirectlyTo(mvSoundHeard_Pos);
		}
		
		if (alId == H64("TurnToPlayer"))
		{
			mpMover.TurnToPos(mBaseObj.GetPlayerPos());
			mpStateMachine.AddTimer("TurnToPlayer", 0.2f);
		}
		
		if (alId == H64("StartAppearing"))
		{
			SetStealthModeActive(false);
		}
		
		if (alId == H64("StealthAppear"))
		{
			mpStateMachine.AddTimer("TurnToPlayer", 0.0f);
			mpStateMachine.AddTimer("ToLookAround", 0.5f);
		}
		
		if (alId == H64("ToLookAround"))
		{
			mpStateMachine.ChangeState(eWraithState_LookAroundForPlayer);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: INVESTIGATE SOUND
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: PLAYER DETECTED
	//{////////////////////////////////
	
	//------------------------------------------------------------
		
	bool mbPlayerDetected_Chasing = false;
	bool mbPlayerDetected_SeenOnce = false;
	bool mbPlayerDetected_FlyModeActive = false;
	float mfPlayerDetected_SeenTimer = 0;
	float mfPlayerDetected_SeenCounter = 0;
	int mlPlayerDetected_Count = 0;
	
	//------------------------------------------------------------
	
	void State_PlayerDetected_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: PlayerDetected ------");
				
		mfPlayerDetected_SeenTimer = 0;
		mfPlayerDetected_SeenCounter = 0;
		mbPlayerDetected_SeenOnce = false;
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_SearchTurn);
		SetMoveAnimState(eWraithMoveAnimState_Search);
		
		SetSpotLightActive(true);
		
		if (mbFlyMode_Active) SetSpotLightColor(mSpotlightColor_Alert);
		else if (mAlert >= eWraithAlertState_Searching)
		{
			SetSpotLightColor(mSpotlightColor_Alert);
			SetMoveAnimState(eWraithMoveAnimState_Search);
		}
		else
		{
			SetSpotLightColor(mSpotlightColor_Idle);
			SetMoveAnimState(eWraithMoveAnimState_Search, false);
			mpMover.PlayAnimation("alert");
		}
		
		TurnSpotlightToPos(mBaseObj.GetPlayerPos(), true, true);
		mpMover.TurnToPos(mBaseObj.GetPlayerPos());
				
		++mlPlayerDetected_Count;
				
		SetAlertState(eWraithAlertState_Searching);
		
		mpStateMachine.AddTimer("SoundReaction", 0.4);
	}
	
	//------------------------------------------------------------

	void State_PlayerDetected_Leave()
	{
		SetMoveAnimState(eWraithMoveAnimState_Default);
	}
	
	//------------------------------------------------------------
	
	void State_PlayerDetected_Update(float afTimeStep) 
	{		
		TurnSpotlightToPos(mBaseObj.GetPlayerPos(), true, true);
		
		if (mbCrystal_PlayerSeen && GetSensesActive())
		{
			float fSeenTimerMul = 1.0f;
			if (mbPlayerCrouching) fSeenTimerMul *= 0.4f;
			if (mfPlayerAvgMovSpeed >= 3.0) fSeenTimerMul *= 1.4f;
			if (mbOnScreen == false) fSeenTimerMul *= 0.6;
			if (Player_IsInLiquid()) fSeenTimerMul *= 0.6;
						
			mfPlayerDetected_SeenTimer += fSeenTimerMul * afTimeStep;
			mfPlayerDetected_SeenCounter += afTimeStep;
			
			if (mbCrystal_PrevPlayerSeen == false) ++mlPlayerDetected_Count;
			
			if (mfPlayerDetected_SeenTimer >= 0.5) SetSpotLightColor(mSpotlightColor_Alert);
			
			mpMover.TurnToPos(mBaseObj.GetPlayerPos());
			
			if (mbPlayerDetected_SeenOnce == false)
			{
				mbModeWraithPatrol_PulseState = true;
				mbPlayerDetected_SeenOnce = true;
				SetAlertState(eWraithAlertState_PlayerDetected);
				Blackboard_WraithNotifyPlayerSpotted(mBaseObj.GetID(), mvLastPlayerSpotlightPos);
			}
			
			mpStateMachine.StopTimer("Exit");
		}
		else
		{
			mfPlayerDetected_SeenTimer -= afTimeStep;
			
			if (mfPlayerDetected_SeenTimer < 0.5 && mbFlyMode_Active == false) SetSpotLightColor(mSpotlightColor_Idle);
						
			if (mpStateMachine.TimerExists("Exit") == false) mpStateMachine.AddTimer("Exit", 1.0f);
		}
		
		mfPlayerDetected_SeenTimer = cMath_Clamp(mfPlayerDetected_SeenTimer, 0.0f, 1.0f);
		
		if ((mfPlayerDetected_SeenTimer >= 1.0f || mlPlayerDetected_Count >= 3) && GetSensesActive())
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Detected too many times in a short amount of time, struggle");
			mpStateMachine.ChangeState(eWraithState_Struggle);
		}	
	}
	
	//------------------------------------------------------------
	
	bool State_PlayerDetected_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_PlayerSubmerged) return false;
		else if (alMessageId == eCustomEntityMessage_PlayerEmerged) return false;
		return true;
	}
	
	void State_PlayerDetected_TimerUp(uint64 alId) 
	{		
		if (alId == H64("Exit"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Exit");
			if (mlPlayerDetected_Count > 0)
			{
				mBaseObj.Timer_Remove("Timer_ResetDetectedCount");
				mBaseObj.Timer_Add("Timer_ResetDetectedCount", 4.0f, "OnTimer_ResetDetectedCount");
			}
			
			if (mbFlyMode_Active && mbPlayerDetected_SeenOnce)
			{
				mvLookAtPosition_Pos = mvLastPlayerSpotlightPos;
				if (mfPlayerDetected_SeenCounter < 0.75f) mbLookAtPosition_Scan = false;
				mpStateMachine.ChangeState(eWraithState_LookAtPosition);
				
//				mvFlySearchPosition_Pos = mvLastPlayerSpotlightPos;
//				mpStateMachine.ChangeState(eWraithState_FlySearchPosition);
			}
			else if (mbPlayerDetected_SeenOnce)
			{
				mvSearch_Pos = mBaseObj.GetPlayerPos();
				mpStateMachine.ChangeState(eWraithState_Search);
			}
			else
			{
				mpStateMachine.ChangeState(eWraithState_Idle);
			}
		}
		
		else if (alId == H64("SoundReaction"))
		{
			mBaseObj.PlaySound("PlayerSeen", gsWraithSound_Sees_the_player, true, true);
		}
	}
	
	//------------------------------------------------------------
	
	void OnTimer_ResetDetectedCount(uint64 alID)
	{
		mlPlayerDetected_Count = 0;
	}
	
	//------------------------------------------------------------
	
	//} END STATE: PLAYER DETECTED
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: PLAYER GAZE DETECTED
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbPlayerGazeDetected_Turning = false;
	bool mbPlayerGazeDetected_GazeAgain = false;
	int mlPlayerGazeDetected_Count = 0;
	
	//------------------------------------------------------------
	
	void State_PlayerGazeDetected_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: PlayerGazeDetected ------");
		
		++mlPlayerGazeDetected_Count;
		
		mbPlayerGazeDetected_Turning = false;
		mbPlayerGazeDetected_GazeAgain = false;
				
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_SearchTurn);
		
		SetSpotLightActive(true);
		
		if (mAlert >= eWraithAlertState_Alerted) SetSpotLightColor(mSpotlightColor_Alert);
		else SetSpotLightColor(mSpotlightColor_Idle);
		SetSpotlightMovement_Forward();
		
		mBaseObj.Timer_Remove("Timer_ResetGazeCount");
		
		mpStateMachine.AddTimer("PlayerDetectedReaction", 0.0f);
		mpStateMachine.AddTimer("DecideAction", 1.0f);

		SetAlertState(eWraithAlertState_Alerted);
	}
	
	//------------------------------------------------------------

	void State_PlayerGazeDetected_Leave()
	{
	}
	
	//------------------------------------------------------------
	
	void State_PlayerGazeDetected_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_PlayerGazeDetected_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_PlayerDetected)
		{
			mpStateMachine.ChangeState(eWraithState_PlayerDetected);
			return true;
		}
		
		else if (alMessageId == eLuxEntityMessage_TurningDone)
		{
			if (mbPlayerGazeDetected_Turning)
			{
				mbPlayerGazeDetected_Turning = false;
				mpStateMachine.AddTimer("Exit", 0.75);				
			}
			return true;
		}
		
		else if (alMessageId == eCustomEntityMessage_SeeFlashlightGobo) return true;
		else if (alMessageId == eCustomEntityMessage_HitByFlashlight) return true;
		else if (alMessageId == eCustomEntityMessage_PlayerGazeDetected)
		{
			mbPlayerGazeDetected_GazeAgain = true;
			
			mvSearch_Pos = mBaseObj.GetPlayerPos();
			mpStateMachine.ChangeState(eWraithState_Search);
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_PlayerGazeDetected_TimerUp(uint64 alId) 
	{	
		if (alId == H64("Exit"))
		{
			mBaseObj.Timer_Add("PlayerGazeCooldown", 6.0f);
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
		if (alId == H64("PlayerDetectedReaction"))
		{
			mBaseObj.PlaySound("PlayerDetected", gsWraithSound_DetectedPlayer, true, true);
		}
		
		if (alId == H64("TurnToPlayer"))
		{
			mbPlayerGazeDetected_Turning = true;
			
			TurnSpotlightToPos(mvLastPlayerGazePos, true, true, 3.0f);			
			mpMover.TurnToPos(mvLastPlayerGazePos);			
		}
		
		if (alId == H64("DecideAction"))
		{
			if (mbFlyMode_Active || mlPlayerGazeDetected_Count <= 1)
			{
				mpStateMachine.AddTimer("TurnToPlayer", 0.0f);
				mBaseObj.Timer_Add("Timer_ResetGazeCount", 20, "OnTimer_ResetGazeCount");
			}
			else
			{
				mlPlayerGazeDetected_Count = 0;
				mvSearch_Pos = mBaseObj.GetPlayerPos();
				mpStateMachine.ChangeState(eWraithState_Search);
			}
			
//			if (mbLookedAtByPlayer || mbPlayerGazeDetected_GazeAgain)
//			{
//				mpStateMachine.AddTimer("TurnToPlayer", 0.0f);
//			}
//			else
//			{
//				mpStateMachine.AddTimer("Exit", 1.0f);
//			}
		}
	}
	
	//------------------------------------------------------------
	
	void OnTimer_ResetGazeCount(uint64 alID)
	{
		mlPlayerGazeDetected_Count = 0;
	}
	
	//------------------------------------------------------------
	
	//} END STATE: PLAYER GAZE DETECTED
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: PLAYER LANTERN DETECTED
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvPlayerLanternDetected_LightPos;
	bool mbPlayerLanternDetected_InitialTurn = false;
	bool mbPlayerLanternDetected_CanHear = false;
	bool mbPlayerLanternDetected_DetectLantern = false;
	
	//------------------------------------------------------------
	
	void State_PlayerLanternDetected_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: PlayerLanternDetected ------");
		
		mbPlayerLanternDetected_InitialTurn = false;
		mbPlayerLanternDetected_CanHear = false;
		mbPlayerLanternDetected_DetectLantern = false;
		
		mbLanternDetectionStates = false;
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_SearchTurn);
		
		SetSpotLightColor(mSpotlightColor_Idle);
		SetSpotlightMovement_Forward();
		
		mpStateMachine.AddTimer("PlayerDetectedReaction", 0.0f);
		mpStateMachine.AddTimer("TurnToLight", 0.4f);
		
		SetAlertState(eWraithAlertState_Alerted);
	}
	
	//------------------------------------------------------------

	void State_PlayerLanternDetected_Leave()
	{
		mbLanternDetectionStates = true;
	}
	
	//------------------------------------------------------------
	
	void State_PlayerLanternDetected_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_PlayerLanternDetected_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_TurningDone)
		{
			if (mbPlayerLanternDetected_InitialTurn)
			{
				mbPlayerLanternDetected_InitialTurn = false;
				mbPlayerLanternDetected_CanHear = true;
				mbPlayerLanternDetected_DetectLantern = true;
				mfGoboDetectionCounter = 0;
				mfFlashlightDetectionCounter = 0;
				mpStateMachine.AddTimer("MoveToLight", 0.2f);
			}
			return true;
		}
		
		else if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbHearing == false) return true;
			return !mbPlayerLanternDetected_CanHear;
		}
		
		else if (alMessageId == eCustomEntityMessage_PlayerGazeDetected) return true;
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_PlayerLanternDetected_TimerUp(uint64 alId) 
	{
		if (alId == H64("PlayerDetectedReaction"))
		{
			mBaseObj.PlaySound("PlayerDetected", gsWraithSound_DetectedPlayer, true, true);
		}
		
		if (alId == H64("TurnToLight"))
		{
			mbPlayerLanternDetected_InitialTurn = true;
			mpMover.TurnToPos(mvPlayerLanternDetected_LightPos);
		}
		
		if (alId == H64("MoveToLight"))
		{
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvPlayerLanternDetected_LightPos, 0, 4, true, true, false, null);
			if (pNode !is null)
			{
				mpStateMachine.AddTimer("ToIdle", 4.0f);
				mpPathfinder.MoveTo(pNode.GetPosition(), 1.0f, false);
			}
			else
			{
				mpStateMachine.AddTimer("ToIdle", 0.5f);
			}
		}
		
		if (alId == H64("HitByFlashlight") || alId == H64("SeeFlashlightGobo"))
		{
			if (mbPlayerLanternDetected_DetectLantern == false) return;
			if (mpStateMachine.TimerExists("ToStealthSearch")) return;
			mpStateMachine.AddTimer("LanternDetectedAgain", 0.0f);
		}
		
		if (alId == H64("ToIdle"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
		if (alId == H64("LanternDetectedAgain"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Detected lantern again, to search");

			mpStateMachine.StopTimer("ToIdle");
			mpPathfinder.Stop();
			mpStateMachine.AddTimer("ToStealthSearch", 0.5f);
		}
		
		if (alId == H64("ToStealthSearch"))
		{
			mbStealthApproach_UseSuggestedAreas = true;
			mpStateMachine.ChangeState(eWraithState_StealthApproach);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: PLAYER GAZE DETECTED
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: STRUGGLE
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfStruggle_InitialDashDist = 5.0f;
	
	//------------------------------------------------------------
	
	bool mbStruggle_StruggleEndLOS = false;
	float mfStruggle_LOSTimer = 0;
	float mfStruggle_StruggleTime = 0;
	float mfStruggle_StruggleIntensityTimer = 0;
	float mfStruggle_StruggleTotalTimer = 0;
	bool mbStruggle_CheckLOS = true;
	bool mbStruggle_BreakOnLOS = true;
	bool mbStruggle_FlyModeActive = false;
	bool mbStruggle_InfiniteStruggle = false;
	bool mbStruggle_PlayStruggleOutroAnim = true;
	bool mbStruggle_Winnable = true;
	bool mbStruggle_PlayerStateEnded = false;
	bool mbStruggle_OutroOver = false;
	bool mbStruggle_EndOutroAnim = false;
	bool mbStruggle_Blocked = false;
	bool mbStruggle_Active = false;
	bool mbStruggle_Dash = true;
	bool mbStruggle_DashSetup = false;
	bool mbStruggle_Permafail = false;
	int mlStruggle_Counter = 0;
	int mlStruggle_FlyCounter = 0;
	float mfStruggle_BarkCount = 0.f;
	float mfStruggle_TimeUntilDash = 1.5f;
	array<cVector3f> mvStruggle_DashPositions;
	tID m_idStruggle_StruggleLoop = tID_Invalid;
	tID m_idStruggle_FollowEnt = tID_Invalid;
	cVector3f mvStruggle_FollowOffset = cVector3f_Zero;
	
	//------------------------------------------------------------
	
	void State_Struggle_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Struggle ------");
		
		if (Blackboard_GetWraithStruggleOwner() != mBaseObj.GetID() && Blackboard_GetWraithStruggleOwner() != tID_Invalid)
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Another wraith is already struggling");
			mpStateMachine.ChangeState(eWraithState_StruggleStandBy);
			return;
		}
		
		if (mpStateMachine.GetPrevState() != eWraithState_Dash)
		{
			mfStruggle_StruggleTime = 0;
			mbStruggle_DashSetup = false;
			mbStruggle_Permafail = false;
			mbStruggle_PlayerStateEnded = false;
		}
		else
		{
			// Resume time calc!
			cScript_SetGlobalArgBool(0, true);
			cScript_RunGlobalFunc("State_Struggle", "", "SetCalculateTimePassed");
		}
		
		mbStruggle_EndOutroAnim = false;
		mfStruggle_LOSTimer = 0;
		mbStruggle_CheckLOS = true;
		mbStruggle_StruggleEndLOS = false;
		mbStruggle_OutroOver = false;
		mbStruggle_Active = Struggle_IsActive(true);
		mfStruggle_StruggleIntensityTimer = 0;
		
		mbModeWraithPatrol_PulseState = true;
		
		mbProximityAttackActive = false;
		mbTerror_Hunting = true;
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Struggle);
		mpMover.SetUseMoveStateAnimations(false);
		mpMover.TurnToPos(mBaseObj.GetPlayerPos());
		mBaseObj.GetCharBody().SetTestCollision(false);
		
		mpProximitySensor.ResetAllStates();
		
		SetAlertState(eWraithAlertState_PlayerDetected);
		Blackboard_SetEnemyHunt(mBaseObj.GetID(), true);		
		
		////////////////
		// Setup struggle	
		if (mbFlyMode_Active) ++mlStruggle_FlyCounter;
		else 				  mlStruggle_FlyCounter = 0;
			
		++mlStruggle_Counter;			
		mbStruggle_Blocked = Struggle_IsActive(true);
		
		if (mbStruggle_Blocked == false)
		{	
			float fFearLevel = FearHandler_GetLevel();
			if (fFearLevel >= (1.0f - 0.35f)) mbStruggle_Permafail = true;
		
			bool bStopMovement = mlStruggle_Counter >= 3 || mAlert >= eWraithAlertState_Provoked || mMode == eWraithMode_FlyFollowEntity || mlStruggle_FlyCounter >= 3;
			float fLength = mbStruggle_Permafail ? 4 : cMath_Max(5.0f * (1.0f - fFearLevel * 0.5f), 2.5f);
			bool bWinnable = mbStruggle_Permafail == false && mbStruggle_Winnable;
			bool bOutroAnim = mbStruggle_Permafail == false && mbStruggle_PlayStruggleOutroAnim;
			
			mfStruggle_StruggleTotalTimer = fLength + gfWraithStruggleTransitionTime;
									
			mbStruggle_Active = true;
			
			Player_GiveDamage(0, 1, eDamageType_Silent, mBaseObj.GetName());
			Struggle_StartWraith(mBaseObj.GetName(), fLength, bWinnable, mbStruggle_InfiniteStruggle == false, gfWraithStruggleTransitionTime, bStopMovement == false, 1.f, bOutroAnim);
			Blackboard_SetWraithStruggleOwner(mBaseObj.GetID());
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Length: " + fLength + " Transition: " + gfWraithStruggleTransitionTime + " Winnable: " + bWinnable);
			
			////////////////
			// Do initial dash!
			if (mbStruggle_Dash)
			{
				if (mbStruggle_Permafail)
				{
					if (mBaseObj.GetDistanceToPlayer() > gfWraithStruggleMinDistToPlayer + 1.0f) mpStateMachine.AddTimer("FinalDash", gfWraithStruggleTransitionTime);
					else mpStateMachine.ChangeState(eWraithState_Permafail);
				}
				else if (mBaseObj.GetDistanceToPlayer() > mfStruggle_InitialDashDist + 2.0f)
				{
					mpStateMachine.AddTimer("InitialDash", gfWraithStruggleTransitionTime);
				}
			}
			else
			{
				mpStateMachine.AddTimer("MoveToEnt", 0.5);
			}
			
			mBaseObj.Timer_Add("Timer_StruggleBark", cMath_RandRectf(4.f, 6.f), "OnTimer_StruggleBark", false, false);
		}
		else
		{
			if (mbStruggle_Permafail)
			{
				mpStateMachine.AddTimer("StartPermafail", 0.5f);
			}
			else if (mbStruggle_PlayerStateEnded)
			{
				mpStateMachine.AddTimer("StruggleSuccessExit", 0.5f);
			}
			else if (mBaseObj.GetDistanceToPlayer() > gfWraithStruggleMinDistToPlayer + 1.0f)
			{
				mpStateMachine.AddTimer("FinalDash", 4.0f);
			}
		}
		
		////////////////
		// Effects		
		mfSpotlightBillboard_BrightnessMul = 0.8f;
		SetSpotLightActive(true);
		SetSpotLightColor(mSpotlightColor_Struggle);
		StopSpotlightMovement();
		
		Light_FadeBrightnessTo(mBaseObj.GetName() + "_Light_Point_Struggle", 5.f, mfStruggle_StruggleTotalTimer * 0.6f);
		DarkWorldWhispers_Play(3);
		
		if (m_idStruggle_StruggleLoop == tID_Invalid)
		{
			mBaseObj.PlaySound("StruggleStart", gsWraithSound_Struggle_start, true, true);
			cSoundEntity@ pStruggleLoop = mBaseObj.PlaySound("StrugglingLoop", gsWraithSound_Struggling_loop, true, true);
			if (pStruggleLoop !is null) m_idStruggle_StruggleLoop = pStruggleLoop.GetID();
		}
		
		////////////////
		// Callback
		ExecuteEntityCallback(msCallback_Struggle);
	}
	
	//------------------------------------------------------------

	void State_Struggle_Leave()
	{
		if (mpStateMachine.GetNextState() == eWraithState_Dash || mpStateMachine.GetNextState() == eWraithState_StruggleStandBy)
			return;
		
		mvStruggle_DashPositions.resize(0);
		mfStruggle_TimeUntilDash = 0.f;
		
		mbProximityAttackActive = true;
		mbTerror_Hunting = false;
		mbCrystal_InternalSight = true;
		m_idStruggle_FollowEnt = tID_Invalid;
					
		if (mbStruggle_OutroOver == false)
		{
			mbStruggle_OutroOver = true;
			
			Struggle_Stop(true);
			
			if (Blackboard_GetWraithStruggleOwner() == mBaseObj.GetID())
				Blackboard_SetWraithStruggleOwner(tID_Invalid);
		}
		
		Blackboard_SetEnemyHunt(mBaseObj.GetID(), false);
		
		mpMover.SetUseMoveStateAnimations(true);
		mBaseObj.GetCharBody().SetTestCollision(!mbFlyMode_Active);
			
		mBaseObj.Timer_Remove("Timer_StruggleCounterCooldown");
		mBaseObj.Timer_Add("Timer_StruggleCounterCooldown", 4.0f, "OnTimer_StruggleCounterCooldown");
			
		mBaseObj.Timer_Remove("Timer_StruggleFlyCounterCooldown");
		mBaseObj.Timer_Add("Timer_StruggleFlyCounterCooldown", 15.0f, "OnTimer_StruggleFlyCounterCooldown");		
			
		////////////////
		// Effects
		mfSpotlightBillboard_BrightnessMul = 1.f;
		SetSpotLightColor(mSpotlightColor_Idle);	
		
		DarkWorldWhispers_Stop(3.f);
		Light_FadeBrightnessTo(mBaseObj.GetName() + "_Light_Point_Struggle", 0.f, 1.f);
		
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idStruggle_StruggleLoop);
		if (pSound !is null)
		{
			pSound.FadeOut(1.0);
			m_idStruggle_StruggleLoop = tID_Invalid;
		}
	}
	
	//------------------------------------------------------------
	
	void State_Struggle_Update(float afTimeStep) 
	{
		////////////////
		// Time
		mfStruggle_StruggleTime += afTimeStep;
		float fTotalStruggleTime = mfStruggle_StruggleTotalTimer - 1.f;
		
		////////////////
		// Play anim
		if (mfStruggle_StruggleTime >= fTotalStruggleTime * 0.25f)
		{
			cAnimationState@ pState = mBaseObj.GetMeshEntity().GetAnimationStateFromName("open_up");
			if (pState.IsActive() == false)
			{
				mBaseObj.PlayAnimation("open_up", 0.25f, false);
				
				float fAnimSpeed = 1.f;
				if (mfStruggle_StruggleTotalTimer > 2.f)
					fAnimSpeed = 5.f / (fTotalStruggleTime * 0.75f);
				
				pState.SetSpeed(fAnimSpeed);
			}
		}
		
		////////////////
		// Sound
		mfStruggle_StruggleIntensityTimer += afTimeStep;
		if (m_idStruggle_StruggleLoop != tID_Invalid)
		{
			float fIntensity = cMath_Clamp(2.0f * mfStruggle_StruggleIntensityTimer / mfStruggle_StruggleTotalTimer, 0.0f, 2.0f);
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idStruggle_StruggleLoop);
			pSound.SetParam("struggle_level", fIntensity);
		}
		
		////////////////
		// Break on los
		if (mbStruggle_BreakOnLOS && mbStruggle_PlayerStateEnded == false && (mbStruggle_Winnable || mbStruggle_Permafail))
		{			
			if ((mbStruggle_CheckLOS && mbPlayerCameraLineOfSight == false) || GetSensesActive() == false)
			{
				mfStruggle_LOSTimer += afTimeStep;
				if (mfStruggle_LOSTimer >= 0.2f)
				{
					mbStruggle_CheckLOS = false;
					mbStruggle_StruggleEndLOS = true;
					if (mbStruggle_Active) 
					{
						cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Los lost, stoppping struggle");
						
						mbStruggle_Permafail = false;
						Struggle_Stop(true);
						
						if (Blackboard_GetWraithStruggleOwner() == mBaseObj.GetID())
							Blackboard_SetWraithStruggleOwner(tID_Invalid);
					}
					else 
					{
						mpStateMachine.AddTimer("StruggleSuccessExit", 0);
					}
				}
			}
		}
		
		////////////////
		// Look at player
		if (mbStruggle_OutroOver == false)
		{
			mpMover.TurnToPos(mBaseObj.GetPlayerPos());
			TurnSpotlightToPos(mBaseObj.GetPlayerPos(), true, true, 10.0f);
		}
	}
	
	//------------------------------------------------------------
	
	bool State_Struggle_Message(int alMessageId)
	{
		if (mbStruggle_Permafail == false && alMessageId == eCustomEntityMessage_PlayerSubmerged) return false;
		else if (mbStruggle_Permafail == false && alMessageId == eCustomEntityMessage_PlayerEmerged) return false;
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_Struggle_TimerUp(uint64 alId) 
	{
		if (alId == H64("MoveToPlayer"))
		{			
			if (mbStruggle_OutroOver || mvStruggle_DashPositions.size() == 0) 
				return;
				
			mvDash_Pos = mvStruggle_DashPositions[0];
			mvStruggle_DashPositions.removeAt(0);
			
			// Freeze time when dashing (since the time it takes can vary)
			cScript_SetGlobalArgBool(0, false);
			cScript_RunGlobalFunc("State_Struggle", "", "SetCalculateTimePassed");
						
			mpStateMachine.ChangeState(eWraithState_Dash);
		}
				
		else if (alId == H64("InitialDash"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Initial dash");
			
			cVector3f vWraithPos = mBaseObj.GetCharBody().GetFeetPosition();
			cVector3f vDashDir = cMath_Vector3Normalize(mBaseObj.GetPlayerFeetPos() - vWraithPos);
				
			mvDash_Pos = mBaseObj.GetPlayerFeetPos() - vDashDir * mfStruggle_InitialDashDist;
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvDash_Pos, 0, 4, true, false, false, null);
			if (pNode !is null) mvDash_Pos = pNode.GetPosition();
			else cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Couldn't find any node, dangerous");
			
			cScript_SetGlobalArgBool(0, false);
			cScript_RunGlobalFunc("State_Struggle", "", "SetCalculateTimePassed");
						
			mpStateMachine.ChangeState(eWraithState_Dash);
		}
		
		else if (alId == H64("FinalDash"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") FinalDash");
			
			cVector3f vWraithPos = mBaseObj.GetCharBody().GetFeetPosition();
			cVector3f vDashDir = cMath_Vector3Normalize(mBaseObj.GetPlayerFeetPos() - vWraithPos);
				
			mvDash_Pos = mBaseObj.GetPlayerFeetPos() - vDashDir * gfWraithStruggleMinDistToPlayer;
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvDash_Pos, 0, 4, true, false, false, null);
			if (pNode !is null) mvDash_Pos = pNode.GetPosition();
			else cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Couldn't find any node, dangerous");
			
			cScript_SetGlobalArgBool(0, false);
			cScript_RunGlobalFunc("State_Struggle", "", "SetCalculateTimePassed");
						
			mpStateMachine.ChangeState(eWraithState_Dash);
		}
		
		else if (alId == H64("CheckBlockedStruggle"))
		{
			mbStruggle_Blocked = Struggle_IsActive(true);
			if (mbStruggle_Blocked == false)
			{
				if (FearHandler_GetIsPermaFailing())
					mpStateMachine.AddTimer("HideAndStopStruggle", 0.5);
				else
					mpStateMachine.AddTimer("StruggleSuccessExit", 0);
			}
			else
			{
				if (Blackboard_GetWraithStruggleOwner() == mBaseObj.GetID())
				{
					// Setup dash after transition is done, so positioning is correct!
					if (mbStruggle_Dash && 
						mbStruggle_DashSetup == false &&
						mfStruggle_StruggleTime > gfWraithStruggleTransitionTime)
					{
						Struggle_SetupDash();
					}
					
					if (mvStruggle_DashPositions.size() == 0)
					{
						mpStateMachine.AddTimer("CheckBlockedStruggle", 0.1f);
						return;
					}
					
					mpStateMachine.AddTimer("MoveToPlayer", mfStruggle_TimeUntilDash);
				}
				else
				{
					mpStateMachine.AddTimer("CheckBlockedStruggle", 0.2);
				}
			}
		}
		
		else if (alId == H64("ToIdle"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
		else if (alId == H64("ToFollowAfterPlayer"))
		{
			mpStateMachine.ChangeState(eWraithState_FollowAfterPlayer);
		}
		
		else if (alId == H64("StruggleSuccessExit"))
		{
			if (mbStruggle_OutroOver) return;
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Struggle success");
			
			Struggle_End();
			
			if (Blackboard_GetWraithStruggleOwner() == mBaseObj.GetID())
				Blackboard_SetWraithStruggleOwner(tID_Invalid);
			
			if (mbStruggle_StruggleEndLOS)
			{
				if (mbFlyMode_Active)
				{
					mvLookAtPosition_Pos = mBaseObj.GetPlayerPos();
					mpStateMachine.ChangeState(eWraithState_LookAtPosition);
				}
				else
				{
					mvSearch_Pos = mBaseObj.GetPlayerPos();
					mbSearch_MoveDirectly = true;
					mpStateMachine.AddTimer("ToFollowAfterPlayer", mbStruggle_EndOutroAnim ? 4.0f : 0);
				}
			}
			else
			{
				if (mbFlyMode_Active)
				{
//					ResetCrystalDetection();
//					SetAlertState(eWraithAlertState_Searching, true);
//					SetSpotLightColor(mSpotlightColor_Alert);
//					mbCrystal_InternalSight = false;
//					mpStateMachine.AddTimer("ToIdle", 5.0f);
					mpStateMachine.ChangeState(eWraithState_Cooldown);
				}
				else
				{
					mpStateMachine.ChangeState(eWraithState_Cooldown);
				}
			}
		}
		
		else if (alId == H64("StruggleFailureExit"))
		{
			if (mbStruggle_OutroOver) return;
			
			Struggle_End();
			FearHandler_TriggerPermaFail(true, mBaseObj.GetName());
			
			mBaseObj.PlaySound("StruggleFail", gsWraithSound_Player_loses_struggle, true, true);
			mpStateMachine.AddTimer("HideAndStopStruggle", 0.5);
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Struggle failure");
		}
		
		else if (alId == H64("HideAndStopStruggle"))
		{
			FearHandler_SetStruggleGradingTextureActive(false);
			mpStateMachine.ChangeState(eWraithState_StealthWait);
		}
		
		else if (alId == H64("MoveToEnt"))
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idStruggle_FollowEnt);
			if (pEnt !is null)
			{			
				mpPathfinder.MoveTo(pEnt.GetPosition() + mvStruggle_FollowOffset, 1.0f, true);
				
				float fDist = cMath_Vector3Dist(pEnt.GetPosition(), mBaseObj.GetPosition());
				float fDistMul = cMath_Clamp((fDist - 0.5f) / (15.0f - 0.5f), 0.0f, 1.0f);
							
				mpMover.SetSpeedMul(2.5f * fDistMul);
			}
			
			mpStateMachine.AddTimer("MoveToEnt", cMath_RandRectf(0.1f, 0.2f));
		}
		
		else if (alId == H64("StartPermafail"))
		{
			mpStateMachine.ChangeState(eWraithState_Permafail);
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_StruggleSuccess()
	{
		if (Blackboard_GetWraithStruggleOwner() != mBaseObj.GetID()) return;
		
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Struggle callback: success");
		if (mbStruggle_Permafail) return;
		
		mpStateMachine.StopTimer("FinalDash");
		mbStruggle_PlayerStateEnded = true;
				
		mbStruggle_EndOutroAnim = cScript_GetGlobalArgBool(0);
		mpStateMachine.AddTimer("StruggleSuccessExit", 0);
	}
	
	//------------------------------------------------------------
	
	void _Global_StruggleFail()
	{
		if (Blackboard_GetWraithStruggleOwner() != mBaseObj.GetID()) return;
		
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Struggle callback: failure");
		if (mbStruggle_Permafail) return;
		
		mbStruggle_PlayerStateEnded = true;
		
		if (mBaseObj.GetDistanceToPlayer() > gfWraithStruggleMinDistToPlayer + 1.0f)
		{
			mbStruggle_Permafail = true;
			mpStateMachine.AddTimer("FinalDash", 0);
		}
		else
		{
			mpStateMachine.ChangeState(eWraithState_Permafail);
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_GetStruggleIsPermafail()
	{
		cScript_SetGlobalReturnBool(mbStruggle_Permafail);
	}
	
	//------------------------------------------------------------
	
	void OnTimer_StruggleCounterCooldown(uint64 alID)
	{
		mlStruggle_Counter = 0;
	}
	
	//------------------------------------------------------------
	
	void OnTimer_StruggleFlyCounterCooldown(uint64 alID)
	{
		mlStruggle_FlyCounter = 0;
	}
	
	//------------------------------------------------------------
	
	void Struggle_SetupDash()
	{
		mbStruggle_DashSetup = true;
		mvStruggle_DashPositions.resize(0);
							
		cVector3f vWraithPos = mBaseObj.GetCharBody().GetFeetPosition();
		cVector3f vDashDir = cMath_Vector3Normalize(mBaseObj.GetPlayerFeetPos() - vWraithPos);
							
		float fMinDistToPlayer = 4.f;
		float fDistToPlayer = cMath_Max(mBaseObj.GetDistanceToPlayer() - fMinDistToPlayer, 0.f);				
		float fDashDistance = 3.f;
							
		// Dash as many times as possible until too close!
		int lDashCount = fDistToPlayer / fDashDistance;
		for (int i = 1; i < lDashCount + 1; ++i)
			mvStruggle_DashPositions.push_back(vWraithPos + vDashDir * fDashDistance * i);						
							
		// Always do a final dash at the end!
		vDashDir = cMath_Vector3Normalize(vWraithPos - mBaseObj.GetPlayerFeetPos());
		mvStruggle_DashPositions.push_back(mBaseObj.GetPlayerFeetPos() + vDashDir * gfWraithStruggleMinDistToPlayer);
		lDashCount++;
						
		float fRemainingTime = cMath_Max((mfStruggle_StruggleTotalTimer - mfStruggle_StruggleTime) - 0.5f, 0.f);
		mfStruggle_TimeUntilDash = fRemainingTime / float(lDashCount);
	}
	
	//------------------------------------------------------------
	
	void Struggle_End()
	{
		if (mbStruggle_OutroOver) return;
		mbStruggle_OutroOver = true;
		
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idStruggle_StruggleLoop);
		if (pSound !is null)
		{
			pSound.FadeOut(1.0);
			m_idStruggle_StruggleLoop = tID_Invalid;
		}
		
		mbTerror_Hunting = false;
		mpPathfinder.Stop();
	}
	
	//------------------------------------------------------------
	
	void OnTimer_StruggleBark(uint64 alId)
	{
		if (Struggle_IsActive(true))
			mBaseObj.PlaySound("Sound_StruggleBark", gsWraithSound_Sees_the_player, true, true);
	}
	
	//------------------------------------------------------------
	
	//} END STATE: STRUGGLE
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: STRUGGLE STAND BY
	//{////////////////////////////////
		
	//------------------------------------------------------------
	
	void State_StruggleStandBy_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: StruggleStandBy ------");
		
		mbProximityAttackActive = false;
		
		mpPathfinder.Stop();
		
		SetSpotLightActive(true);
		SetSpotLightColor(mSpotlightColor_Struggle);
		
		TurnSpotlightToPos(mBaseObj.GetPlayerPos(), true);
		
		StartFacingPosition(mBaseObj.GetPlayerPos());
		
		mpStateMachine.AddTimer("MoveToEnt", 0.5);
		mpStateMachine.AddTimer("FollowWithSpotlight", 0);
		mpStateMachine.AddTimer("CheckIdle", 0);
	}
	
	//------------------------------------------------------------

	void State_StruggleStandBy_Leave()
	{
		mbProximityAttackActive = true;
		
		SetSpotLightColor(mSpotlightColor_Idle);
		SetSpotLightActive(false);
		
		StopFacingEntity();
	}
	
	//------------------------------------------------------------
	
	void State_StruggleStandBy_Update(float afTimeStep) 
	{
		mvFaceEntity_TargetPos = mBaseObj.GetPlayerPos();
	}
	
	//------------------------------------------------------------
	
	bool State_StruggleStandBy_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_PlayerDead) return false;
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_StruggleStandBy_TimerUp(uint64 alId) 
	{
		if (alId == H64("MoveToEnt"))
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idStruggle_FollowEnt);
			if (pEnt !is null)
			{			
				mpPathfinder.MoveTo(pEnt.GetPosition() + mvStruggle_FollowOffset, 1.0f, true);
				
				float fDist = cMath_Vector3Dist(pEnt.GetPosition(), mBaseObj.GetPosition());
				float fDistMul = cMath_Clamp((fDist - 0.5f) / (15.0f - 0.5f), 0.0f, 1.0f);
							
				mpMover.SetSpeedMul(2.5f * fDistMul);
				mpMover.TurnToPos(pEnt.GetPosition());
			}
			
			mpStateMachine.AddTimer("MoveToEnt", cMath_RandRectf(0.1f, 0.2f));
		}
		
		else if (alId == H64("FollowWithSpotlight"))
		{
			TurnSpotlightToPos(mBaseObj.GetPlayerPos(), true);
			mpStateMachine.AddTimer("FollowWithSpotlight", 0.2);
		}
		
		else if (alId == H64("CheckIdle"))
		{
			if (Blackboard_GetWraithStruggleOwner() == tID_Invalid)
			{
				mpStateMachine.ChangeState(eWraithState_Idle);
				return;
			}
			mpStateMachine.AddTimer("CheckIdle", 0.2);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: STRUGGLE STAND BY
	
	///////////////////////////////////
	// STATE: PERMAFAIL
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfPermafail_AlignTime = 0.2f;
	
	//------------------------------------------------------------
	
	cVector3f mvPermafail_PlayerStartPos;
	cVector3f mvPermafail_StartPos;
	cVector3f mvPermafail_TargetPos;
	float mfPermafail_AlignTimer = 0;
	float mfPermafail_PlayerStartYaw = 0;
	float mfPermafail_PlayerGoalYaw = 0;
	float mfPermafail_WraithStartYaw = 0;
	float mfPermafail_WraithGoalYaw = 0;
	bool mbPermafail_Aligned = false;
	int mlPermafail_BlurId = -1;
	tString msPermafail_AnimState = "";
	bool mbPermafail_FlyMode = false;
	
	//------------------------------------------------------------
	
	void State_Permafail_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Permafail ------");
		
		Blackboard_SetWraithStruggleOwner(mBaseObj.GetID());
		
		mfMeshMovementAmountGoal = 0;
		
		mfPermafail_AlignTimer = 0;
		mbPermafail_Aligned = false;
		mbProximityAttackActive = false;
		
		mpPathfinder.Stop();

		SetSpotLightActive(true);
		SetSpotLightColor(mSpotlightColor_Struggle);
		
		mpMover.SetBankingAngleMul(0);
		
//		mbPermafail_FlyMode = mbFlyMode_Active;
//		SetFlyModeActive(false);
		
		mBaseObj.GetCharBody().SetTestCollision(false);
//		mBaseObj.GetCharBody().SetGravityActive(false);
		
		mvPermafail_PlayerStartPos = mBaseObj.GetPlayerFeetPos();
		mvPermafail_StartPos = mBaseObj.GetCharBody().GetFeetPosition();
		
		cVector3f vPlayerDir = mvPermafail_PlayerStartPos - mvPermafail_StartPos;
		vPlayerDir.y = 0;
		vPlayerDir.Normalize();
		
		mvPermafail_TargetPos = mvPermafail_PlayerStartPos - vPlayerDir * 2.01919;
		
		mfPermafail_PlayerStartYaw = cMath_GetAngleFromPoints3D(0.0f, cLux_GetPlayer().GetCharacterBody().GetForward()).y;
		mfPermafail_PlayerGoalYaw = mfPermafail_PlayerStartYaw + cMath_GetAngleDistanceRad(mfPermafail_PlayerStartYaw, cMath_GetAngleFromPoints3D(0.0f, vPlayerDir * -1).y);
		mfPermafail_PlayerGoalYaw = cMath_GetAngleDistanceRad(mfPermafail_PlayerStartYaw, mfPermafail_PlayerGoalYaw) + mfPermafail_PlayerStartYaw;
		
		mfPermafail_WraithStartYaw = cMath_GetAngleFromPoints3D(0.0f, mBaseObj.GetCharBody().GetForward()).y;
		mfPermafail_WraithGoalYaw = mfPermafail_WraithStartYaw + cMath_GetAngleDistanceRad(mfPermafail_WraithStartYaw, cMath_GetAngleFromPoints3D(0.0f, vPlayerDir).y);
		mfPermafail_WraithGoalYaw = cMath_GetAngleDistanceRad(mfPermafail_WraithStartYaw, mfPermafail_WraithGoalYaw) + mfPermafail_WraithStartYaw;
	
		Player_SetLookSpeedMul(0);
		
		mpVerletAnimation.FadeMoveToPosMul(0, mfPermafail_AlignTime);
		
		Player_ChangeStateToNormal();
		Player_SetMoveSpeedMul(0, ePlayerMoveSpeedMulType_Agent);
				
		FearHandler_FadeLevelTo(0.75, 0.5);
		FearHandler_FadeTentacleSizeAddTo(0, 0.5);
		FearHandler_SetStruggleGradingTextureActive(true);
		FearHandler_PlayStruggleSoundLoop(0.75f, 1.0f, false);
//		Effect_FearTentacles_FadeMaterial(eFearTentacleMaterial_Focus, 0.5f);
		mlPermafail_BlurId = Effect_Blur_Start(0.5, 0.5);
		Effect_FearTentacles_FadeMinVignette(1.f, 1.f);
		
		GhoulProgression_FadeCustomArmMaterial(GhoulProgression_GetPermafailFadeProgression(), 0.5f);

		TurnSpotlightToPos(mvPermafail_PlayerStartPos + vPlayerDir * 2, true);
		
		mpStateMachine.AddTimer("PlayAnimations", mfPermafail_AlignTime);
	}
	
	//------------------------------------------------------------

	void State_Permafail_Leave()
	{
		if (Blackboard_GetWraithStruggleOwner() == mBaseObj.GetID())
			Blackboard_SetWraithStruggleOwner(tID_Invalid);
		
		SetMoveAnimState(eWraithMoveAnimState_Default, false);
		
		Player_SetMoveSpeedMul(1, ePlayerMoveSpeedMulType_Agent);
		
		mfMeshMovementAmountGoal = 1;
		mpVerletAnimation.FadeMoveToPosMul(1, 0.5);
		mbProximityAttackActive = true;
		
		mBaseObj.GetCharBody().SetTestCollision(true);
//		mBaseObj.GetCharBody().SetGravityActive(true);
		
		Player_SetLookSpeedMul(1);
		
//		FearHandler_FadeTentacleSizeAddTo(4, 0.5);
		FearHandler_SetStruggleGradingTextureActive(false);
//		Effect_FearTentacles_FadeMaterial(eFearTentacleMaterial_Default, 0.5f);
		Effect_Blur_FadeOut(mlPermafail_BlurId, 0.5);
		Effect_FearTentacles_FadeMinVignette(0.f, 0.5);
	}
	
	//------------------------------------------------------------
	
	void State_Permafail_Update(float afTimeStep) 
	{
		if (mbPermafail_Aligned == false)
		{
			mfPermafail_AlignTimer += afTimeStep;
			
			float fTRaw = mfPermafail_AlignTimer / mfPermafail_AlignTime;
			float fT =  cMath_Clamp(fTRaw, 0.0f, 1.0f);
			
			// set positions
			{
				cVector3f vPlayerPos = mvPermafail_PlayerStartPos;
				cLux_GetPlayer().GetCharacterBody().SetFeetPosition(vPlayerPos, false);
				
				cVector3f vWraihtPos = mvPermafail_StartPos * (1 - fT) + mvPermafail_TargetPos * fT;
				mBaseObj.GetCharBody().SetFeetPosition(vWraihtPos, false);
			}
			
			// set rotations
			{
				float fPlayerYaw = cMath_InterpolateLinear(mfPermafail_PlayerStartYaw, mfPermafail_PlayerGoalYaw, fT);
				cLux_GetPlayer().GetCharacterBody().SetYaw(fPlayerYaw);
				
				float fWraithYaw = cMath_InterpolateLinear(mfPermafail_WraithStartYaw, mfPermafail_WraithGoalYaw, fT);
				mBaseObj.GetCharBody().SetYaw(fWraithYaw);
			}
			
			if (fTRaw >= 1.5)
			{
				Player_SetLookSpeedMul(1);
				mbPermafail_Aligned = true;
			}
		}
		
//		cVector3f vDisplayOffset = cVector3f_Up * 5.0f;
//		Debug_DrawSphere(mBaseObj.GetCharBody().GetFeetPosition() + vDisplayOffset, 0.2, cColor_Green * 2);
//		Debug_DrawLine(mBaseObj.GetCharBody().GetFeetPosition() + vDisplayOffset, mBaseObj.GetCharBody().GetFeetPosition() + vDisplayOffset + mBaseObj.GetCharBody().GetForward() * 5, cColor_Green * 2);
//		Debug_DrawLine(mBaseObj.GetCharBody().GetFeetPosition() + vDisplayOffset, mBaseObj.GetCharBody().GetFeetPosition() + vDisplayOffset + mBaseObj.GetMeshEntity().GetWorldMatrix().GetTranspose().GetForward() * 5, cColor_Red * 2);
//		Debug_DrawSphere(cLux_GetPlayer().GetCharacterBody().GetFeetPosition() + vDisplayOffset, 0.2, cColor_Green * 2);
//		Debug_DrawLine(cLux_GetPlayer().GetCharacterBody().GetFeetPosition()+ vDisplayOffset, cLux_GetPlayer().GetCharacterBody().GetFeetPosition() + vDisplayOffset + cLux_GetPlayer().GetCharacterBody().GetForward() * 5, cColor_Green * 2);
//		
//		cVector3f vWraithDiff = mvPermafail_TargetPos - mBaseObj.GetCharBody().GetFeetPosition();
//		float fWraithAngleDiff = cMath_Abs(mfPermafail_WraithGoalYaw - mBaseObj.GetCharBody().GetYaw());
//		cLux_AddDebugMessage("WRAITH OFFSET " + vWraithDiff + " | " + fWraithAngleDiff);
//		
//		float fPlayerAngleDiff = cMath_Abs(mfPermafail_PlayerGoalYaw - cLux_GetPlayer().GetCharacterBody().GetYaw());
//		cLux_AddDebugMessage("PLAYER OFFSET " + fPlayerAngleDiff);
		
		if (msPermafail_AnimState == "struggle")
		{
			cAnimationState@ pAnim = PlayerBody_GetAnimationState("struggle_with_wraith_end");
			if (pAnim.GetRelativeTimePosition() >= 0.95)
			{
				msPermafail_AnimState = "";
				
				PlayerBody_SetCutsceneMaxPitch(10);
				PlayerBody_SetCutsceneMaxYaw(10);
				PlayerBody_PlayCutsceneAnimation("permafail_wraith", false, 0.2);
				
				mpStateMachine.AddTimer("StartPermafail", 7.9f);
				mpStateMachine.AddTimer("PlayPermafailStinger", 7.9f - 3.35f);
				mpStateMachine.AddTimer("Exit", 10.0f);
			}
		}
		
		
		
//		float fTime = 0.5f;
//		float fColorMul = 2;
//		
//		cVector3f vFromPlayer = cLux_GetPlayer().GetCharacterBody().GetFeetPosition() + cVector3f_Up * 0.2f;
//		Debug_DrawSphere(vFromPlayer, 0.25, cColor_Blue * fColorMul, fTime);
//		Debug_DrawLine(vFromPlayer, vFromPlayer + cLux_GetPlayer().GetCharacterBody().GetForward() * 1.0f, cColor_Blue * fColorMul, fTime);
//		
//		
//		cVector3f vFromWraith = mBaseObj.GetCharBody().GetFeetPosition() + cVector3f_Up * 0.2f;
//		Debug_DrawSphere(vFromWraith, 0.25, cColor_Green * fColorMul, fTime);
//		Debug_DrawLine(vFromWraith, vFromWraith + mBaseObj.GetCharBody().GetForward() * 1.0f, cColor_Green * fColorMul, fTime);		
	}
	
	//------------------------------------------------------------
	
	bool State_Permafail_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_PlayerDead) return false;
		
		if (alMessageId == eLuxEntityMessage_AnimationMessageEvent)
		{
			// scream hit
			if (mpStateMachine.GetCurrentMessageData().mlX == 1)
			{
				FearHandler_FadeLevelTo(1, 0.25);
				FearHandler_FadeTentacleSizeAddTo(3, 0.25);
				Effect_Blur_FadeAmount(mlPermafail_BlurId, 0.2, 0.25);
				
				Effect_FOV_Shake_Start(0.3, 0.5, 0.2, 0.75);
				Effect_Rumble_Start(1, 1.2f, 0, 0.5);
				
				mpStateMachine.AddTimer("LandEffects", 2.3f);
				
				mpStateMachine.AddTimer("ReduceEffects", 1.0f);
				mpStateMachine.AddTimer("FinalEffects", 2.5f);
				mpStateMachine.AddTimer("FinalEffects2", 8.5f);
			}
			
			// permafail
			else if (mpStateMachine.GetCurrentMessageData().mlX == 2)
			{
//				mBaseObj.PlaySound("FinalScream", "creatures/vocalisations/creature/wraith/permafail_scream", true, true);
			}
			
			// rumble
			if (mpStateMachine.GetCurrentMessageData().mlX == 3)
			{
				Effect_Rumble_Start(0.75, 0.5, 0, 0.2);
			}
		}
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_Permafail_TimerUp(uint64 alId) 
	{
		if (alId == H64("PlayAnimations"))
		{
			mpMover.PlayAnimation("wraith_ending_struggle_with_player", 0.3, false);
			PlayerBody_SetCutsceneMaxPitch(0);
			PlayerBody_SetCutsceneMaxYaw(0);
			PlayerBody_PlayCutsceneAnimation("struggle_with_wraith_end", false, 0.3);
			msPermafail_AnimState = "struggle";
		}
		
		else if (alId == H64("LandEffects"))
		{
			Effect_Shake_Start(0.08, 0.3, 0.1, 0.25);
			Effect_Rumble_Start(0.2, 10, 0.5, 2);
		}
		
		else if (alId == H64("ReduceEffects"))
		{
			FearHandler_FadeLevelTo(0.75, 0.5);
			FearHandler_FadeTentacleSizeAddTo(0, 0.5);
		}
		
		else if (alId == H64("FinalEffects"))
		{
			FearHandler_FadeLevelTo(1, 2);
			FearHandler_FadeTentacleSizeAddTo(4, 2);
			Effect_Blur_FadeAmount(mlPermafail_BlurId, 0.2, 0.5);
		}
		
		else if (alId == H64("FinalEffects2"))
		{
			Effect_Blur_FadeAmount(mlPermafail_BlurId, 1.0, 0.5);
		}
		
		else if (alId == H64("PlayPermafailStinger"))
		{
			FearHandler_PlayStruggleSoundLoop(1.f, 0.5f, false);
			Sound_PlayGui("player/foley/damage/player_permafail", 1);
		}
		
		else if (alId == H64("StartPermafail"))
		{
			FearHandler_TriggerPermaFail(false, mBaseObj.GetName());
		}
		
		else if (alId == H64("Exit"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: PERMAFAIL

	///////////////////////////////////
	// STATE: ATTACK
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Attack_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Attack ------");
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_SearchTurn);
		
		SetSpotLightActive(true);
		SetSpotLightColor(mSpotlightColor_Struggle);
		
		mpMover.TurnToPos(mBaseObj.GetPlayerPos());
		StopSpotlightMovement();
		TurnSpotlightToPos(mBaseObj.GetPlayerPos(), true, true, 20.0f);
		
		mbModeWraithPatrol_PulseState = true;
		
		mpStateMachine.AddTimer("Attack", 0.3f);
		mpStateMachine.AddTimer("ToStealthWait", 1.0f);
	}
	
	//------------------------------------------------------------

	void State_Attack_Leave()
	{
	}
	
	//------------------------------------------------------------
	
	void State_Attack_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_Attack_Message(int alMessageId)
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_Attack_TimerUp(uint64 alId) 
	{
		if (alId == H64("Attack"))
		{
//			Player_GiveDamage(1, 1, eDamageType_Default, mBaseObj.GetName());
			FearHandler_TriggerPermaFail(true);
			mBaseObj.PlaySound("Attack", gsWraithSound_Attack, true, true);
		}
		
		else if (alId == H64("ToStealthWait"))
		{
			mpStateMachine.ChangeState(eWraithState_StealthWait);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: ATTACK
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: FOLLOW AFTER PLAYER
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_FollowAfterPlayer_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: FollowAfterPlayer ------");
		
		mpMover.SetSpeedState(eWraithSpeed_SearchFast);
		
		StopSpotlightMovement();
		SetSpotLightActive(true);
		SetSpotLightColor(mSpotlightColor_Alert);
		SetSpotlightMovement_SidewaysEight(1.4f, 0.3f, 0.1f);
		
		mpStateMachine.AddTimer("Follow", 1.0f);
		
		SetAlertState(eWraithAlertState_PlayerDetected);
	}
	
	//------------------------------------------------------------

	void State_FollowAfterPlayer_Leave()
	{
	}
	
	//------------------------------------------------------------
	
	void State_FollowAfterPlayer_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_FollowAfterPlayer_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			mpStateMachine.AddTimer("Exit", 1.0f);
			return true;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_FollowAfterPlayer_TimerUp(uint64 alId)
	{
		if (alId == H64("Follow"))
		{
			DrawTestPoint(mvLastPlayerSpotlightPos, 2.0f);
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvLastPlayerSpotlightPos, 0.0f, 6.0f, true, true, false, null);
			if (pNode !is null)
			{
				mpPathfinder.MoveTo(pNode.GetPosition(), 1.0f, false);
				mpStateMachine.StopTimer("NoPos");
			}
			else
			{
				if (mpStateMachine.TimerExists("NoPos") == false) mpStateMachine.AddTimer("NoPos", 4.0f);
			}
			mpStateMachine.AddTimer("Follow", 0.5f);
		}
		
		if (alId == H64("NoPos"))
		{
			mpStateMachine.AddTimer("Exit", 0.0f);
		}
		
		if (alId == H64("Exit"))
		{
			mBaseObj.PlaySound("EndSearch", gsWraithSound_End_search, true, true);
			mpStateMachine.AddTimer("ToLookAround", 0.5f);
		}
		
		if (alId == H64("ToLookAround"))
		{
			mbLookAroundForPlayer_Small = true;
			mbLookAroundForPlayer_CustomPos = true;
			mvLookAroundForPlayer_LookPos = mvSearch_Pos;
			mpStateMachine.ChangeState(eWraithState_LookAroundForPlayer);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: FOLLOW AFTER PLAYER
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: SEARCH
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvSearch_Pos;
	int mlSearch_Prio;
	bool mbSearch_MoveDirectly = false;
	
	float mfSearch_CloseDist = 8.0f;
	cVector3f mvSearch_PosDir;
	bool mbSearch_CanHear = false;
	bool mbSearch_Moving = false;
	bool mbSearch_StartedSpeedAdjust = false;
	tString msSearch_TurnState;
	int mlSearch_SoundsHeard = 0;
	int mlSearch_PlayerSoundsHeard = 0;
	int mlSearch_SoundsThreshold = 1;
	float mfSearch_SoundHeardTimer = 0;
	float mfSearch_StopCheckTimer = 0;
	
	//------------------------------------------------------------
	
	void State_Search_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Search ------");
		
		mbSearch_CanHear = false;
		mbSearch_Moving = false;
		mbSearch_StartedSpeedAdjust = false;
		mlSearch_SoundsHeard = 0;
		mfSearch_StopCheckTimer = 0;
		
		if (mlSearch_PlayerSoundsHeard == 0 && mAlert >= eWraithAlertState_Searching) mlSearch_PlayerSoundsHeard = mlSearch_SoundsThreshold;
		
		ResetSoundHeard();
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Search);
		SetMoveAnimState(eWraithMoveAnimState_Search, false);
		mpMover.PlayAnimation("alert");
		mpMover.SetUseMoveStateAnimations(false);
		
		SetSpotLightActive(true);
		SetSpotLightColor(mSpotlightColor_Alert);
		SetSpotlightMovement_Forward(true);
		
		StartFacingPosition(mvSearch_Pos);
		
		FadeIdleLoopVolume(0, 1);
		FadeSearchLoopVolume(1, 1);
		
		mpStateMachine.AddTimer("DecideAction", 0.0f);
		
		mpStateMachine.AddTimer("SoundHeardReaction", 0.2f);
		mpStateMachine.AddTimer("SoundHeardReactionCooldown", 10.0f);
		
		mpStateMachine.AddTimer("EnableHearing", 0.3f);
		
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul * 1.5f);
		
		SetAlertState(eWraithAlertState_Searching);
	}
	
	//------------------------------------------------------------

	void State_Search_Leave() 
	{
		mpMover.SetSpeedMul(1);
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul);
		ResetSoundHeard();
		
		StopFacingEntity();
		
		mpMover.SetUseMoveStateAnimations(true);
		
		mbSearch_MoveDirectly = false;
		
		if (mCommand == eWraithCommand_SearchArea) mCommand = eWraithCommand_None;
		if (mCommand == eWraithCommand_Search)
		{
			mCommand = eWraithCommand_None;
			ExecuteEntityCallback(msCommandCompletedCallback);
		}
		
		SetMoveAnimState(eWraithMoveAnimState_Default);
		
		FadeIdleLoopVolume(1, 1);
		FadeSearchLoopVolume(0, 0.5);
		
		mBaseObj.Timer_Remove("StartSearchSoundCooldown");
	}
	
	//------------------------------------------------------------
	
	void State_Search_Update(float afTimeStep) 
	{
		mvFaceEntity_TargetPos = mvSearch_Pos;
		
		if (mbSearch_Moving)
		{
			mfSearch_StopCheckTimer -= afTimeStep;
			if (mfSearch_StopCheckTimer <= 0)
			{
				mfSearch_StopCheckTimer = cMath_RandRectf(0.1, 0.3);
				if (mBaseObj.GetDistanceToPos(mvSearch_Pos) < 4 && mBaseObj.GetPointIsInLineOfSight(mvSearch_Pos))
				{
					mbSearch_Moving = false;
					mpPathfinder.Stop();
					mpStateMachine.AddTimer("NothingFound", 0.0f);
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool State_Search_Message(int alMessageId)
	{	
		if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbHearing == false) return true;
			if (mbSearch_CanHear == false) return true;
			
			int lPrio = mpStateMachine.GetCurrentMessageData().mlX;
			cVector3f vPos = mpStateMachine.GetCurrentMessageData().mvX;
			tString sName = mpStateMachine.GetCurrentMessageData().msX;
						
			if (ShouldHearSound(vPos, lPrio, sName))
			{
				++mlSearch_SoundsHeard;
				
				bool bPlayer = cString_GetFirstStringPos(cString_ToLowerCase(sName), "footstep") >= 0;
				if (bPlayer) AddSearchPlayerSoundHeard(1);
				
				bool bSamePos = cMath_Vector3Dist(mvSearch_Pos, vPos) < 3.0;
				
				mvSearch_Pos = vPos;
				mlSearch_Prio = lPrio;
				mpStateMachine.StopTimer("NothingFound");
				mpStateMachine.StopTimer("ToIdle");
					
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Increasing sound counter to " + mlSearch_SoundsHeard + " P: " + mlSearch_PlayerSoundsHeard);
				
				if (bPlayer || mpStateMachine.TimerExists("SoundHeardReactionCooldown") == false || bSamePos == false)
				{
					mpStateMachine.AddTimer("SoundHeardReaction", 0.2f);
					mpStateMachine.AddTimer("SoundHeardReactionCooldown", 10.0f);
				}

				if (mlSearch_PlayerSoundsHeard >= 3)
				{
					cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Player made too much noise, speeding up and looking in their direction");
					mpStateMachine.AddTimer("StartSearch", 0);
				}
				else if (mbSearch_Moving == false || bSamePos == false)
				{
					mbSearch_Moving = false;
					mpPathfinder.Stop();
					
					float fTime = 0.5;
					if (mlSearch_PlayerSoundsHeard >= 2) fTime = 0;
					mpStateMachine.AddTimer("DecideAction", fTime);
				}
			}
			
			return true;
		}
		
		else if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			mpStateMachine.AddTimer("NothingFound", 0.0f);
		}
		
		else if (alMessageId == eCustomEntityMessage_ApproachingClosedDoor)
		{
			mpStateMachine.ChangeState(eWraithState_OpenDoor);
		}
		
		else if (alMessageId == eCustomEntityMessage_SpotlightTurnDone)
		{
			if (msSearch_TurnState == "Right") mpStateMachine.AddTimer("Turn2", 0.4f);
			else if (msSearch_TurnState == "Left") mpStateMachine.AddTimer("DecideAfterLook", 0.0f);
			else if (msSearch_TurnState == "QuickTurn") mpStateMachine.AddTimer("DecideAfterLook", 0.0f);
			else if (msSearch_TurnState == "TurnBeforeMove") mpStateMachine.AddTimer("StartSearch", 0.3f);
			msSearch_TurnState = "";
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_Search_TimerUp(uint64 alId) 
	{
		if (alId == H64("EnableHearing"))
		{
			mbSearch_CanHear = true;
		}
		
		if (alId == H64("DecideAction"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Decide action");
			// normal response
			if (mlSearch_PlayerSoundsHeard < mlSearch_SoundsThreshold && Search_ShouldLookAt())
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Normal");
				if (mBaseObj.GetDistanceToPos(mvSearch_Pos) <= mfSearch_CloseDist)
				{
					mpStateMachine.AddTimer("QuickTurn", 0);
				}
				else
				{
					mpStateMachine.AddTimer("Turn1", 1.0);
				}
			}
			// aggressive response due to many sounds
			else if (mlSearch_PlayerSoundsHeard >= mlSearch_SoundsThreshold)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Aggressive");
				mpStateMachine.AddTimer("QuickTurn", 0.0f);
			}
			// cannot see target, look and move
			else
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Cannot see target");
				mpStateMachine.AddTimer("TurnBeforeMove", 0.0f);
			}
		}
		
		else if (alId == H64("AdjustSpeed"))
		{
			if (mbSearch_Moving)
			{
				float fDist = mBaseObj.GetDistanceToPos(mvSearch_Pos);
				float fPlayerDist = mBaseObj.GetDistanceToPlayer();
				
				if (fDist > 8)
				{
					SetSpotlightMovement_SidewaysEight(0.4f, 0.5f, 0.1f, false, cVector3f_Zero, false, true);
				}
				else if (fDist <= 8)
				{
					SetSpotlightMovement_SidewaysEight(0.4f, 0.1f, 0.05f, true, mvSearch_Pos + cVector3f_Down * 2, false, true);
				}
				
				if (fPlayerDist > 20 && fDist >= 12)
				{
					mpMover.SetSpeedState(eWraithSpeed_SearchFast);
					mpMover.SetSpeedMul(2);
				}
				else if (fPlayerDist > 6)
				{
					mpMover.SetSpeedState(eWraithSpeed_SearchFast);
					mpMover.SetSpeedMul(1);
				}
				else
				{
					mpMover.SetSpeedState(eWraithSpeed_SearchSlow);
					mpMover.SetSpeedMul(1);
				}
				
				mbSearch_StartedSpeedAdjust = true;				
			}
			mpStateMachine.AddTimer("AdjustSpeed", 0.2f);
		}
		
		else if (alId == H64("Turn1"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Turn1");
			
			mpMover.TurnToPos(mvSearch_Pos);
			
			cVector3f vPosDir = cMath_Vector3Normalize(mvSearch_Pos - mBaseObj.GetPosition());
			float fH, fV = 0;
			GetClosestSpotlightAngle(vPosDir, fH, fV);
			TurnSpotlightToAngle(fH + cMath_ToRad(15), cMath_ToRad(-5), true, true, 1.25f);
			msSearch_TurnState = "Right";
		}
		
		else if (alId == H64("Turn2"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Turn2");
			
			cVector3f vPosDir = cMath_Vector3Normalize(mvSearch_Pos - mBaseObj.GetPosition());
			float fH, fV = 0;
			GetClosestSpotlightAngle(vPosDir, fH, fV);
			TurnSpotlightToAngle(fH + cMath_ToRad(-15), cMath_ToRad(-5), true, true, 1.25f);
			msSearch_TurnState = "Left";
		}
		
		else if (alId == H64("TurnBeforeMove"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") TurnBeforeMove");
						
			mpMover.TurnToPos(mvSearch_Pos);
			TurnSpotlightToPos(mvSearch_Pos + cVector3f_Down * 2, true, true, 4.0f);
			
			msSearch_TurnState = "TurnBeforeMove";
		}
		
		else if (alId == H64("QuickTurn"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") QuickTurn");
			
			cVector3f vPos = Player_GetPosition();
			
			// look ahead if player is running
			if (mlSearch_PlayerSoundsHeard >= 2 && Player_GetVelocity().Length() >= 3.0)
			{
				vPos += Player_GetForward() * 4.0f;
			}
			
			mpMover.TurnToPos(vPos);
			TurnSpotlightToPos(vPos, true, true, 60.0f);			
			
			DrawTestPoint(mvSearch_Pos, 2.0f, cColor_Green * 5.0f, 2.0f);
			
			msSearch_TurnState = "QuickTurn";
		}
		
		else if (alId == H64("SoundHeardReaction"))
		{
			mBaseObj.PlaySound("SoundHeard", gsWraithSound_Hears_a_sound, true, true);
		}
		
		else if (alId == H64("DecideAfterLook"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Decide after look");
			
			cVector3f vPosDir = cMath_Vector3Normalize(mvSearch_Pos - mBaseObj.GetPosition());
			DrawTestRay(mBaseObj.GetEyePostion(), mvSearch_Pos - vPosDir * 0.5f, 2.0f);
			if (mBaseObj.GetPointIsInLineOfSight(mvSearch_Pos - vPosDir * 0.5f))
			{
				mpStateMachine.AddTimer("NothingFound", 0.5f);
			}
			else
			{
				mpStateMachine.AddTimer("StartSearch", 0.5f);
			}
		}
		
		else if (alId == H64("StartSearch"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Start search");
			
			if (mBaseObj.Timer_Exists("StartSearchSoundCooldown") == false)
			{
				mBaseObj.Timer_Add("StartSearchSoundCooldown", 6);
				mBaseObj.PlaySound("StartSearch", gsWraithSound_Start_search, true, true);
			}
				
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvSearch_Pos, 0.0f, 5.0f, true, true, false, null);
			if (pNode is null) @pNode = mpPathfinder.GetNodeAtPos(mvSearch_Pos, 0.0f, 5.0f, true, false, false, null);
			if (pNode !is null)
			{
				mpPathfinder.BuildPathNodeArrayToPos(pNode.GetPosition()); // TODO: won't work with bigger wraith
				if (mCommand != eWraithCommand_SearchArea && mCommand != eWraithCommand_Search && (mpPathfinder.GetPathNodeArrayFullLength() > 30.0f && mlSearch_Prio <= 3))
				{
					mpStateMachine.AddTimer("NothingFound", 0.0f);
				}
				else
				{
					mbSearch_Moving = true;
					mpMover.SetUseMoveStateAnimations(true);
					
					mpStateMachine.AddTimer("AdjustSpeed", 0.5f);
					mpPathfinder.MoveToNode(pNode.GetName(), 1.0f, false);
				}
			}
			else
			{
				mpPathfinder.Stop();
				mpStateMachine.AddTimer("NothingFound", 0.0f);
			}
		}
		
		else if (alId == H64("NothingFound"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Nothing found, to look around");
			if (mBaseObj.GetDistanceToPlayer() >= 8)
			{
				mpStateMachine.AddTimer("Exit", 1.5f);
			}
			else
			{
				mpStateMachine.AddTimer("ToLookAround", 0.5f);
			}
		}
		
		else if (alId == H64("ToLookAround"))
		{
			mbLookAroundForPlayer_Small = true;
			mbLookAroundForPlayer_CustomPos = true;
			mvLookAroundForPlayer_LookPos = mvSearch_Pos;
			mpStateMachine.ChangeState(eWraithState_LookAroundForPlayer);
		}
		
		else if (alId == H64("Exit"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	bool Search_ShouldLookAt()
	{
		if (mAlert >= eWraithAlertState_PlayerDetected) return false;
		
		cVector3f vToPos = mvSearch_Pos - GetCrystalPos();
		cVector3f vToPosDir = cMath_Vector3Normalize(vToPos);	
		
//		if (mBaseObj.GetPointIsInLineOfSight(mvSearch_Pos - vPosDir * 0.5f)) return true;
		
		float fDist;
		cVector3f vNrm;
		float fRayLength = cMath_Max(0.0f, vToPos.Length() - 2.0f);
		
		DrawTestPoint(mvSearch_Pos, 2.0f);
		DrawTestRay(GetCrystalPos(), GetCrystalPos() + vToPosDir * fRayLength, 2.0f);
		
		iPhysicsBody@ pBody = cLux_GetClosestCharCollideBody(GetCrystalPos(), vToPosDir, fRayLength, fDist, vNrm);
		if (pBody is null) return true;
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void UpdateSearch(float afTimeStep)
	{
		if (mlSearch_PlayerSoundsHeard <= 0) return;

		mfSearch_SoundHeardTimer += afTimeStep;
		if (mfSearch_SoundHeardTimer >= 5)
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Reduce player sounds heard in search by one");
			AddSearchPlayerSoundHeard(-1);
		}
	}
	
	//------------------------------------------------------------
	
	void AddSearchPlayerSoundHeard(int alAmount)
	{
		mfSearch_SoundHeardTimer = 0;
		mlSearch_PlayerSoundsHeard += alAmount;
		mlSearch_PlayerSoundsHeard = cMath_Clamp(mlSearch_PlayerSoundsHeard, 0, 4);
	}
	
	//------------------------------------------------------------
	
	//} END STATE: SEARCH
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: DASH
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvDash_Pos;
	
	cVector2f mvDash_TeleportDist = cVector2f(2.5, 3.5);
	
	cVector3f mvDash_Dir;
	cVector3f mvDash_StartPos;
	cVector3f mvDash_TeleportPos;
	tID m_idDash_Ent;
	array<tID> mvDash_AfterImages;
	tID m_idDash_AfterImage;
	
	float mfDash_Dist = 0;
	int mlDash_ShortTeleportCounter = 0;
	bool mbDash_StruggleDash = false;
	bool mbDash_SoundHeardDash = false;
	bool mbDash_Moving = false;
	float mfDash_MoveTimer = 0;
	int mlDash_AfterImageStutters = 0;
	cVector3f mvDash_MoveStart;
	cVector3f mvDash_MoveEnd;
	tID m_idDash_MoveOrbTrail = tID_Invalid;
	tID m_idDash_Light = tID_Invalid;
	tID m_idDash_MoveOrbLoop = tID_Invalid;
	tString msDash_AnimState = "";
	float mfDash_AfterImageDist = 0;
	bool mbDash_Quick = false;
	bool mbDash_CommandExit = false;
	
	//------------------------------------------------------------
	
	void State_Dash_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Dash ------");
		
		mbDash_StruggleDash = mpStateMachine.GetPrevState() == eWraithState_Struggle;	
	
		if (mbDash_StruggleDash == false)
		{
			SetSpotLightActive(false);
			SetSway(2);
		}
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Burst);
		
		cVector3f vStart = mvDash_StartPos = mBaseObj.GetCharBody().GetFeetPosition();
		cVector3f vEnd = mvDash_Pos;
		mvDash_Dir = cMath_Vector3Normalize(vEnd - vStart);
		mfDash_Dist = cMath_Vector3Dist(vStart, vEnd);
		
//		DrawTestPoint(vStart, 4, cColor_Blue * 2, 0.6);
//		DrawTestPoint(vEnd, 4, cColor_Green * 2, 0.6);
		
//		mBaseObj.GetParticleSystemFromName("PS_1").Kill();
		
		float fTeleportTime = mbDash_StruggleDash || mbDash_Quick ? 0.f : 0.5f;
		mpStateMachine.AddTimer("DashStart", fTeleportTime);
	}
	
	//------------------------------------------------------------

	void State_Dash_Leave()
	{
//		mBaseObj.GetParticleSystemFromName("PS_1").Restart();
		mbDash_SoundHeardDash = false;
		mbDash_Quick = false;

		mBaseObj.GetMeshEntity().SetCoverageAmount(1.0);
		mBaseObj.GetCharBody().SetTestCollision(true);
		
		cParticleSystem@ pMoveTrail = cLux_ID_ParticleSystem(m_idDash_MoveOrbTrail);
		if (pMoveTrail !is null) pMoveTrail.Kill();
		
		if (mbDash_StruggleDash == false)
		{
			SetMoveAnimState(eWraithMoveAnimState_Default);
			SetSway(0);
		}
		
		if (mpStateMachine.GetPrevState() == eWraithState_FlyToNode && mCommand == eWraithCommand_FlyToNode)
		{
			mCommand = eWraithCommand_None;
			ExecuteEntityCallback(msCommandCompletedCallback);
		}
		
		if (mCommand == eWraithCommand_FlyToNode)
		{
			mCommand = eWraithCommand_None;
			ExecuteEntityCallback(msCommandCompletedCallback);
		}
		
		if (mbDash_CommandExit == false && mCommand == eWraithCommand_Dash)
		{
			mCommand = eWraithCommand_None;
			ExecuteEntityCallback(msCommandCompletedCallback);
		}
		mbDash_CommandExit = false;
				
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		if (pCrystal !is null) pCrystal.GetMeshEntity().SetCoverageAmount(1.0f);
		
		iLuxEntity@ pEnt = cLux_ID_Entity(m_idDash_Ent);
		if (pEnt !is null) pEnt.SetActive(false);
		
		cSoundEntity@ pDashLoop = cLux_ID_SoundEntity(m_idDash_MoveOrbLoop);
		if (pDashLoop !is null) pDashLoop.FadeOut(1);
	}
	
	//------------------------------------------------------------
	
	void State_Dash_Update(float afTimeStep) 
	{
		if (mbDash_Moving)
		{
			mfDash_MoveTimer += afTimeStep;
			if (m_idDash_MoveOrbTrail == tID_Invalid)
			{
				m_idDash_MoveOrbTrail = mBaseObj.CreateParticleSystem("DashOrbTrail", "wraith_orb_trail", false, false).GetID();
			}
			
			cVector3f vDir = mvDash_MoveEnd - mvDash_MoveStart;
			float fSpeed = 22.0f;
			float fTime = vDir.Length() / fSpeed;
			
			float fT = cMath_Clamp(mfDash_MoveTimer / fTime, 0.0f, 1.0f);
			fT = cMath_Easing(eEasing_Linear, fT);
			cVector3f vPos = mvDash_MoveStart * (1.0 - fT) + mvDash_MoveEnd * fT;
			
			cVector3f vForward = cMath_Vector3Normalize(vDir);
			cVector3f vRight = cMath_Vector3Cross(vForward, cVector3f_Down);
			cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
			cMatrixf mtxNew = cMath_MatrixUnitVectors(vRight, vUp, vForward, vPos);
			
			cParticleSystem@ pPS = cLux_ID_ParticleSystem(m_idDash_MoveOrbTrail);
			pPS.SetWorldMatrix(mtxNew);
			
			cSoundEntity@ pDashLoop = cLux_ID_SoundEntity(m_idDash_MoveOrbLoop);
			if (pDashLoop !is null)
			{
				pDashLoop.SetVolume(mfSfx_VolumeMul);
				pDashLoop.SetWorldPosition(pPS.GetWorldPosition());
			}
			
			Debug_DrawSphere(vPos, 0.2f, cColor_Red * 5, 0.5);
			
			if (fT >= 1 || mbStruggle_PlayerStateEnded)
			{
				mbDash_Moving = false;
				mpStateMachine.AddTimer("DashEnd", 0);
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool State_Dash_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_PlayerSubmerged) return false;
		else if (alMessageId == eCustomEntityMessage_PlayerEmerged) return false;
		else if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			return true;
//			if (mbFlyMode_Active == false) return true;
//			if (GetSensesActive() == false) return true;
//			if (mbHearing == false) return true;
//			if (ShouldHearSound(mpStateMachine.GetCurrentMessageData().mvX, mpStateMachine.GetCurrentMessageData().mlX, mpStateMachine.GetCurrentMessageData().msX))
//			{
//				mvFlySearch_Pos = mvSoundHeard_Pos;
//				mpStateMachine.ChangeState(eWraithState_FlySearch);
//			}
		}
		else if (alMessageId == eLuxEntityMessage_AnimationMessageEvent)
		{
			if (msDash_AnimState == "idle_tr_dash")
			{
				mpStateMachine.AddTimer("Dash1", 0);
				msDash_AnimState = "";
			}
		}
		else if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			if (msDash_AnimState == "dash_tr_idle")
			{
				mpStateMachine.AddTimer("Exit", 0);
				msDash_AnimState = "";
			}
		}
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_Dash_TimerUp(uint64 alId) 
	{
		if (alId == H64("Teleport"))
		{
			// choose teleport point
			float fTargetDist = cMath_Vector3Dist(mvDash_Pos, mBaseObj.GetCharBody().GetFeetPosition());
			float fTeleportDist = cMath_RandRectf(mvDash_TeleportDist.x, mvDash_TeleportDist.y);
			if (fTeleportDist <= fTargetDist) mvDash_TeleportPos = mBaseObj.GetCharBody().GetFeetPosition() + mvDash_Dir * fTeleportDist;
			else mvDash_TeleportPos = mvDash_Pos;
			
			DrawTestPoint(mvDash_TeleportPos, 4, cColor_White * 2, 0.4);
			
			// move and rotate wraith
			cVector3f vOldPos = mBaseObj.GetCharBody().GetFeetPosition();
			mBaseObj.GetCharBody().SetTestCollision(false);
			mBaseObj.GetCharBody().SetFeetPosition(mvDash_TeleportPos, false);
			
			cVector3f vTurnPos = mbDash_StruggleDash ? mBaseObj.GetPlayerFeetPos() : mBaseObj.GetPosition() + mvDash_Dir;
			mpMover.TurnInstantlyToPos(vTurnPos);
			
			// set coverage
			float fOpacity = cMath_RandRectf(0.4, 0.7);
			mBaseObj.GetMeshEntity().SetCoverageAmount(fOpacity);
			iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
			if (pCrystal !is null) pCrystal.GetMeshEntity().SetCoverageAmount(fOpacity);
			
			// play sound
			mBaseObj.PlaySound("Teleport", "creatures/vocalisations/creature/wraith/OLD/temp_teleport_appear", true, true);
			
			// cloud particle system
			cParticleSystem@ pPS = mBaseObj.CreateParticleSystem("WraithTeleport", "wraith_teleport", true, false);
			pPS.SetPosition(mBaseObj.GetPosition() + cVector3f_Up * -1.25 + mvDash_Dir * 1.5);
			
			// flash light
//			iLight@ pLight = mBaseObj.GetLightFromName("Light_Point_Teleport");
//			pLight.SetBrightness(cMath_RandRectf(4, 6));
//			pLight.FadeBrightnessTo(0, 0.15);
			
			// dash after image
			tID idAfterImage = CreateDashEntity();
			iLuxEntity@ pDashEnt = cLux_ID_Entity(idAfterImage);
			if (pDashEnt !is null)
			{
				mvDash_AfterImages.push_back(idAfterImage);
				pDashEnt.SetMatrix(mBaseObj.GetMeshEntity().GetWorldMatrix());
				pDashEnt.SetPosition(vOldPos + cVector3f_Up * 1.5);
				pDashEnt.GetMeshEntity().SetCoverageAmount(0.8);
				
				// Play correct anim when dashing
				cAnimationState@ pAgentOpenState = mBaseObj.GetMeshEntity().GetAnimationStateFromName("open");
				if (pAgentOpenState.IsActive())
				{
					pDashEnt.PlayAnimation("open", 0.f, false, false, "");
				
					cAnimationState@ pEntOpenState = pDashEnt.GetMeshEntity().GetAnimationStateFromName("open");
					pEntOpenState.SetRelativeTimePosition(pAgentOpenState.GetRelativeTimePosition());
					pEntOpenState.SetPaused(true);
				}
				else
				{
					pDashEnt.PlayAnimation("walk_fwd_head_raised", 0, false, false, "");
					pDashEnt.GetMeshEntity().GetAnimationStateFromName("walk_fwd_head_raised").SetPaused(true);
				}
				
				pDashEnt.SetActive(true);
			}
			
			if (mvDash_TeleportPos == mvDash_Pos)
			{
				mBaseObj.GetMeshEntity().SetCoverageAmount(1.0);
				mBaseObj.GetCharBody().SetTestCollision(true);
				
				float fExitTime = mbDash_StruggleDash || mbDash_Quick ? 0.f : 1.f;
				mpStateMachine.AddTimer("Exit", fExitTime);
			}
			else
			{
				mlDash_ShortTeleportCounter = cMath_RandRectl(2, 3);
				mpStateMachine.AddTimer("ShortTeleport", cMath_RandRectf(0.1, 0.2));
			}
		}
		
		else if (alId == H64("TurnOffLight"))
		{
//			iLight@ pLight = mBaseObj.GetLightFromName("Light_Point_Teleport");
//			pLight.FadeBrightnessTo(0, 0.2);
		}
		
		else if (alId == H64("ShortTeleport"))
		{
			cVector3f vShortPos = mvDash_TeleportPos;
			cVector3f vDirRight = cMath_Vector3Normalize(cMath_Vector3Cross(cVector3f_Up, mvDash_Dir));
			vShortPos += mvDash_Dir * 0.7 * cMath_RandRectf(-1.0, 1.0);
			vShortPos += vDirRight * 0.3 * cMath_RandRectf(-1.0, 1.0);
			
			mBaseObj.GetCharBody().SetFeetPosition(vShortPos, false);
			mBaseObj.GetMeshEntity().SetCoverageAmount(cMath_RandRectf(0.2, 0.4));
			
			--mlDash_ShortTeleportCounter;
			if (mlDash_ShortTeleportCounter <= 0)
			{
				mpStateMachine.AddTimer("Teleport", 0.02);
			}
			else
			{
				mpStateMachine.AddTimer("ShortTeleport", cMath_RandRectf(0.02, 0.04));
			}
		}
		
		else if (alId == H64("DashStart"))
		{
			SetMoveAnimState(eWraithMoveAnimState_Search);
			
			msDash_AnimState = "idle_tr_dash";
			mpMover.PlayAnimation("idle_tr_dash");
			
			mBaseObj.GetLightFromName("Light_Point_1").FadeBrightnessTo(0, 0.2, eEasing_SineOut);
			
			if (mbDash_StruggleDash)
			{
				mpMover.TurnToPos(mBaseObj.GetPlayerFeetPos());
			}
		}
		
		else if (alId == H64("Dash1"))
		{
			cSoundEntity@ pDashStartSound = mBaseObj.PlaySound("DashStart", "creatures/foley/creature/wraith/dash_start", true, false);
			if (pDashStartSound !is null) pDashStartSound.SetVolume(mfSfx_VolumeMul);
			
			Dash_DistanceBasedRumble();
			
			cParticleSystem@ pPS1 = mBaseObj.CreateParticleSystem("WraithTeleport", "wraith_teleport_body", true, false);
			pPS1.SetWorldPosition(mBaseObj.GetCharBody().GetPosition());
			
			cParticleSystem@ pPS2 = mBaseObj.CreateParticleSystem("WraithTeleport", "wraith_teleport_crystal_start", true, false);
			pPS2.SetWorldPosition(GetCrystalPos());
			
			cSoundEntity@ pDashLoop = mBaseObj.GetMap().GetWorld().CreateSoundEntity("DashOrbLoop", "creatures/foley/creature/wraith/dash_loop", true);
			if (pDashLoop !is null)
			{
				pDashLoop.SetVolume(mfSfx_VolumeMul);
				m_idDash_MoveOrbLoop = pDashLoop.GetID();
			}
			
			DoPhysicsPulse(mBaseObj.GetCharBody().GetFeetPosition() + cVector3f_Down * 0.6f);
			
			iLight@ pLight = cLux_ID_Light(m_idDash_Light);
			pLight.SetBrightness(17);
			pLight.FadeBrightnessTo(0, 0.15);
			pLight.SetDiffuseColor(cColor(0.4, 0.9, 1.0));
			pLight.SetPosition(GetCrystalPos() + GetCrystalDir() * 1.0f);
			
			iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
			cColor defaultColor = pCrystal.GetEffectBaseColor();
			pCrystal.SetEffectBaseColor(cColor(0.3, 1.0, 1.0) * 5);
			pCrystal.FadeEffectBaseColor(defaultColor, 0.15);
						
			mpStateMachine.AddTimer("Dash2", 0.2);
		}
		
		else if (alId == H64("Dash2"))
		{
			float fOpacity = 0;
			mBaseObj.GetMeshEntity().SetCoverageAmount(fOpacity);
			iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
			if (pCrystal !is null) pCrystal.GetMeshEntity().SetCoverageAmount(fOpacity);

			m_idDash_AfterImage = CreateDashEntity();
			
			iLuxEntity@ pAfterImage = cLux_ID_Entity(m_idDash_AfterImage);
			if (pAfterImage !is null)
			{
				cVector3f vAfterImagePos = mBaseObj.GetMeshEntity().GetWorldPosition() + cVector3f_Up * 1.6;
				
				cVector3f vAfterImageUp = cVector3f_Up;
				cVector3f vAfterImageFwd = cMath_Vector3Normalize(cVector3f(mvDash_Dir.x, 0, mvDash_Dir.z));
				cVector3f vAfterImageRight = cMath_Vector3Cross(vAfterImageUp, vAfterImageFwd);
				cMatrixf mtxAfterImage = cMath_MatrixUnitVectors(vAfterImageRight, vAfterImageUp, vAfterImageFwd, vAfterImagePos);
			
				pAfterImage.SetMatrix(mtxAfterImage);
				pAfterImage.SetActive(true);
				pAfterImage.GetMeshEntity().SetCoverageAmount(0.5f);
				
				pAfterImage.PlayAnimation("idle_tr_dash", 0);
				
				cAnimationState@ pAnim = pAfterImage.GetMeshEntity().GetAnimationStateFromName("idle_tr_dash");
				if (pAnim !is null)
				{
					pAnim.SetTimePosition(1.009);
					pAnim.SetPaused(true);
				}
				
				mpStateMachine.AddTimer("AfterImageStutter", 0);
			}
			
			mpMover.TurnInstantlyToPos(mvDash_Pos);
			mBaseObj.GetCharBody().SetFeetPosition(mvDash_Pos, false);
			mvDash_MoveStart = GetCrystalPos();
			
			mpStateMachine.AddTimer("Dash3", 0.1);
			
			mlDash_AfterImageStutters = 3;
			mfDash_AfterImageDist = 0;
		}
		
		else if (alId == H64("AfterImageStutter"))
		{
			iLuxEntity@ pAfterImage = cLux_ID_Entity(m_idDash_AfterImage);
			if (pAfterImage is null) return;
			
			if (mlDash_AfterImageStutters == 0)
			{
				pAfterImage.SetActive(false);
				RemoveDashEntity(m_idDash_AfterImage);
			}
			else
			{
				cVector3f vPos = mvDash_StartPos;
//				cVector3f vDirRight = cMath_Vector3Normalize(cMath_Vector3Cross(cVector3f_Up, mvDash_Dir));
//				vPos += mvDash_Dir * 0.3 * cMath_RandRectf(-1.0, 1.0);
//				vPos += vDirRight * 0.3 * cMath_RandRectf(-1.0, 1.0);
				
				float fMoveDist = cMath_RandRectf(0.5, 0.8);
				mfDash_AfterImageDist += fMoveDist;
				vPos += mvDash_Dir * mfDash_AfterImageDist;
				
				pAfterImage.SetPosition(vPos + cVector3f_Up * 1.6f);
				
				float fCoverage = cMath_Clamp(mlDash_AfterImageStutters / 7.0f, 0.0f, 1.0f);
				fCoverage = 0.1 + fCoverage * 0.5;
				pAfterImage.GetMeshEntity().SetCoverageAmount(fCoverage);
				
				--mlDash_AfterImageStutters;
				
				mpStateMachine.AddTimer("AfterImageStutter", cMath_RandRectf(0.03, 0.06));
			}
		}
		
		else if (alId == H64("Dash3"))
		{
			mvDash_MoveEnd = GetCrystalPos();
			mbDash_Moving = true;
			mfDash_MoveTimer = 0;
			
//			Debug_DrawSphere(mvDash_MoveStart, 0.3f, cColor(1, 1, 0) * 10, 2);
//			Debug_DrawSphere(mvDash_MoveEnd, 0.3f, cColor(1, 1, 0) * 10, 2);
		}
		
		else if (alId == H64("DashEnd"))
		{
			cLux_ID_ParticleSystem(m_idDash_MoveOrbTrail).Kill();
			m_idDash_MoveOrbTrail = tID_Invalid;

//			mBaseObj.GetCharBody().SetTestCollision(true);
//			mBaseObj.GetMeshEntity().SetCoverageAmount(1);
			if (mbCommandDash_DisappearAfter)
			{
				cSoundEntity@ pDashLoop = cLux_ID_SoundEntity(m_idDash_MoveOrbLoop);
				if (pDashLoop !is null) pDashLoop.FadeOut(1);
				
				mpStateMachine.AddTimer("Disappear", 0.5);
			}
			else mpStateMachine.AddTimer("Dash4", 0.2);
		}
		
		else if (alId == H64("Dash4"))
		{
			cSoundEntity@ pDashEndSound = mBaseObj.PlaySound("DashEnd", "creatures/foley/creature/wraith/dash_end", true, false);
			if (pDashEndSound !is null) pDashEndSound.SetVolume(mfSfx_VolumeMul);
			
			cParticleSystem@ pPS1 = mBaseObj.CreateParticleSystem("WraithTeleport", "wraith_teleport_body", true, false);
			pPS1.SetWorldPosition(mBaseObj.GetCharBody().GetPosition());
			
			cParticleSystem@ pPS2 = mBaseObj.CreateParticleSystem("WraithTeleport", "wraith_teleport_crystal_end", true, false);
			pPS2.SetWorldPosition(GetCrystalPos());
			
			mpStateMachine.AddTimer("Dash5", 0.2);
		}
		
		else if (alId == H64("Dash5"))
		{
			Dash_DistanceBasedRumble();
			
			if (mbDash_StruggleDash) mpMover.TurnInstantlyToPos(mBaseObj.GetPlayerFeetPos());

			float fOpacity = 1;
			mBaseObj.GetMeshEntity().SetCoverageAmount(fOpacity);
			iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
			if (pCrystal !is null) pCrystal.GetMeshEntity().SetCoverageAmount(fOpacity);
			
			SetStealthModeActive(false, false);
			
			cSoundEntity@ pDashLoop = cLux_ID_SoundEntity(m_idDash_MoveOrbLoop);
			if (pDashLoop !is null) pDashLoop.FadeOut(1);
			
			DoPhysicsPulse(mBaseObj.GetCharBody().GetFeetPosition() + cVector3f_Down * 0.6f);
			
			iLight@ pLight = cLux_ID_Light(m_idDash_Light);
			pLight.SetBrightness(17);
			pLight.FadeBrightnessTo(0, 0.3);
			pLight.SetDiffuseColor(cColor(0.4, 0.9, 1.0));
			pLight.SetPosition(GetCrystalPos() + GetCrystalDir() * 1.0f);
			
			cColor defaultColor = pCrystal.GetEffectBaseColor();
			pCrystal.SetEffectBaseColor(cColor(0.3, 1.0, 1.0) * 5.0);
			pCrystal.FadeEffectBaseColor(defaultColor, 0.15);
			
			if (mbDash_StruggleDash == false) SetMoveAnimState(eWraithMoveAnimState_Default);
			
			if (mbCommandDash_Quick)
			{
				mpStateMachine.AddTimer("Exit", 0);
			}
			else
			{
				msDash_AnimState = "dash_tr_idle";
				int lAnim = mpMover.PlayAnimation("dash_tr_idle", 0);
				cAnimationState@ pAnim = mBaseObj.GetMeshEntity().GetAnimationState(lAnim);
				pAnim.SetTimePosition(0.25);
			}
		}
		
		else if (alId == H64("Disappear"))
		{
			if (mCommand == eWraithCommand_Dash)
			{
				mCommand = eWraithCommand_None;
				ExecuteEntityCallback(msCommandCompletedCallback);
			}
			
			mpStateMachine.ChangeState(eWraithState_Idle);
			mBaseObj.SetActive(false);
		}
		
		else if (alId == H64("Exit"))
		{
			int lState = eWraithState_Idle;
			if (mbDash_StruggleDash) lState = eWraithState_Struggle;
			else if (mbDash_SoundHeardDash)
			{
				mvLookAtPosition_Pos = mvSoundHeard_Pos;
				lState = eWraithState_LookAtPosition;			
			}
			else if (mMode == eWraithMode_GuardPosition)
			{
				lState = eWraithState_GuardPosition;
			}
			mpStateMachine.ChangeState(lState);
		}
	}
	
	//------------------------------------------------------------
	
	void Dash_DistanceBasedRumble()
	{
		float fDistMul = 1.0f - cMath_Clamp((mBaseObj.GetDistanceToPlayer() - 3) / (9 - 3), 0.0f, 1.0f);
		if (fDistMul <= 0) return;		
		Effect_Rumble_Start(fDistMul, 0.5, 0, 0.4);
	}
	
	//------------------------------------------------------------
	
	void UpdateDashEffects(float afTimeStep)
	{
		for (int i = 0; i < mvDash_AfterImages.size(); ++i)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(mvDash_AfterImages[i]);
			float fCoverage = pEnt.GetMeshEntity().GetCoverageAmount();
			fCoverage -= afTimeStep * 1.2f;
			pEnt.GetMeshEntity().SetCoverageAmount(fCoverage);
			if (fCoverage <= 0.0f)
			{
				RemoveDashEntity(pEnt.GetID());
				pEnt.SetActive(false);
				mvDash_AfterImages.removeAt(i);
				--i;
			}
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: DASH

	///////////////////////////////////
	// STATE: GUARD POSITION
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	tID m_idGuardPos_CurrentLook;
	array<tID> mvGuardPosition_LookPos;
	int mlGuardPosition_PosIndex = 0;
	float mfGuardPosition_ChangePositionMinTime = -1;
	float mfGuardPosition_ChangePositionMaxTime = -1;
	cVector3f mvGuardPosition_StandPosition;
	
	//------------------------------------------------------------
	
	void State_GuardPosition_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: GuardPosition ------");
		
		if (mvGuardPosition_LookPos.size() == 0)
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") No positions to guard, return to idle");
		}
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Fly);
		
		SetSpotLightActive(false);
		SetSpotLightColor(mSpotlightColor_Idle);
				
		mpPathfinder.Stop();
		mpStateMachine.AddTimer("MoveToPosition", 0.2f);
	}
	
	//------------------------------------------------------------

	void State_GuardPosition_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_GuardPosition_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_GuardPosition_Message(int alMessageId)
	{	
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			mpStateMachine.AddTimer("FirstLook", 0.0f);
			return true;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_GuardPosition_TimerUp(uint64 alId) 
	{
		if (alId == H64("MoveToPosition"))
		{
			mpPathfinder.MoveTo(mvGuardPosition_StandPosition, 1, false);
		}
		
		if (alId == H64("FirstLook"))
		{
			m_idGuardPos_CurrentLook = mvGuardPosition_LookPos[mlGuardPosition_PosIndex];
			++mlGuardPosition_PosIndex;
			mlGuardPosition_PosIndex %= mvGuardPosition_LookPos.size();
			
			cVector3f vLook = cLux_ID_Entity(m_idGuardPos_CurrentLook).GetPosition();
			TurnSpotlightToPos(vLook, true, false);
			mpMover.TurnToPos(vLook);
			
			mpStateMachine.AddTimer("SpotlightsOn", 0.3);
		}
		
		else if (alId == H64("SpotlightsOn"))
		{
			SetSpotLightActive(true);
			mpStateMachine.AddTimer("ChangePos3", 1);
		}
		
		else if (alId == H64("ChangePos"))
		{
			m_idGuardPos_CurrentLook = mvGuardPosition_LookPos[mlGuardPosition_PosIndex];
			++mlGuardPosition_PosIndex;
			mlGuardPosition_PosIndex %= mvGuardPosition_LookPos.size();
			
			StopSpotlightMovement();
			
			mpStateMachine.AddTimer("ChangePos2", 1);
		}
		
		else if (alId == H64("ChangePos2"))
		{
			cVector3f vLook = cLux_ID_Entity(m_idGuardPos_CurrentLook).GetPosition();
			mpMover.TurnToPos(vLook);
			TurnSpotlightToPos(vLook, true, true, 0.5);
			mpStateMachine.AddTimer("ChangePos3", 2.0);
		}
		
		else if (alId == H64("ChangePos3"))
		{
			SetSpotlightMovement_SidewaysEightAtEntity(0.5, 0.2, 0.05, m_idGuardPos_CurrentLook, true, true);
			mpStateMachine.AddTimer("ChangePos", cMath_RandRectf(mfGuardPosition_ChangePositionMinTime, mfGuardPosition_ChangePositionMaxTime));
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: GUARD POSITION
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: DAZED
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfDazed_ExitTime = 6;
	
	//------------------------------------------------------------
	
	void State_Cooldown_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Dazed ------");
		
		SetSpotLightActive(false);
		SetSpotLightColor(mSpotlightColor_Idle);
		mbProximityAttackActive = false;
		
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		pCrystal.FadeEffectBaseColor(cColor(0, 0, 0, 0), 0.25f);
		
//		cVector3f vLightPos = mBaseObj.GetPosition();
//		vLightPos += mBaseObj.GetCharBody().GetForward();
//		vLightPos += cVector3f_Down;
//		TurnSpotlightToPos(vLightPos, true, true, 1.5);
		
		mpPathfinder.Stop();
		SetAlertState(eWraithAlertState_None, true);
		
		mpStateMachine.AddTimer("PlayAnim", 0.5);
	}
	
	//------------------------------------------------------------

	void State_Cooldown_Leave() 
	{
		mbProximityAttackActive = true;
		
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		pCrystal.FadeEffectBaseColor(mCrystal_DefaultEffectColor, 0.25f);
	}
	
	//------------------------------------------------------------
	
	void State_Cooldown_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_Cooldown_Message(int alMessageId)
	{	
		if (alMessageId == eCustomEntityMessage_PlayerSubmerged) return false;
		else if (alMessageId == eCustomEntityMessage_PlayerEmerged) return false;
		else if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			mpStateMachine.AddTimer("Exit", 0);
		}
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_Cooldown_TimerUp(uint64 alId) 
	{
		if (alId == H64("Exit"))
		{
			mBaseObj.ResetPlayerDetectionState();
			ResetCrystalDetection();
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
		else if (alId == H64("PlayAnim"))
		{
			mpMover.PlayAnimation("cooldown", 0.3, false);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: DAZED
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: OPEN DOOR
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	tID m_idOpenDoor_Door = tID_Invalid;
	bool mbOpenDoor_Opening = false;
	
	//------------------------------------------------------------
	
	void State_OpenDoor_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: OpenDoor ------");
		
		mbOpenDoor_Opening = false;
		
		mpPathfinder.Stop();
		
		SetSpotlightMovement_Forward(true);
		
		m_idOpenDoor_Door = m_idDoorInPath;
		
		mpStateMachine.AddTimer("LookAt", 0.5f);
	}
	
	//------------------------------------------------------------

	void State_OpenDoor_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_OpenDoor_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_OpenDoor_Message(int alMessageId)
	{	
		if (alMessageId == eLuxEntityMessage_SoundHeard) return true;
		if (alMessageId == eCustomEntityMessage_SpotlightTurnDone)
		{
			if (mbOpenDoor_Opening) return false;
			mbOpenDoor_Opening = true;
			mpStateMachine.AddTimer("OpenDoor", 0.5f);
			mpStateMachine.AddTimer("ToSearch", 1.5f);
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_OpenDoor_TimerUp(uint64 alId) 
	{
		if (alId == H64("LookAt"))
		{
			StopSpotlightMovement();
			TurnSpotlightToPos(cLux_ID_Entity(m_idOpenDoor_Door).GetPosition(), true, true, 10.0f, 2.0f);
		}
		
		if (alId == H64("OpenDoor"))
		{
			tString sDoorName = cLux_ID_Entity(m_idOpenDoor_Door).GetName();
			if (cString_GetFirstStringPos(sDoorName, "_Left") >= 0 || cString_GetFirstStringPos(sDoorName, "_Right") >= 0)
			{
				sDoorName = cString_ReplaceStringTo(sDoorName, "_Left", "");
				sDoorName = cString_ReplaceStringTo(sDoorName, "_Right", "");
				Button_SetSwitchedOn(sDoorName + "_Button_1", true, true);
			}
			else
			{
				tString sClass = cLux_ID_Entity(m_idOpenDoor_Door).GetClassName();
				if (sClass == "cScrPropSwingDoor")
					SwingDoor_PushOpen(sDoorName, 0.3f, 3);
				else
					SlideDoor_SetOpenAmount(sDoorName, 1.0f);
			}
		}
		
		if (alId == H64("ToSearch"))
		{
			if (mpStateMachine.GetPrevState() == eWraithState_Search)
			{
				SetAlertState(eWraithAlertState_None, true);
				mpStateMachine.ChangeState(eWraithState_Search);
			}
			else
			{
				mpStateMachine.ChangeState(eWraithState_Idle);
			}
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: OPEN DOOR
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: PULSE
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvPulse_PlayerPos;
	cVector3f mvPulse_PrevPlayerPos;
	int mlPulse_SameSpotCount = 0;
	float mfPulse_Range = 30.0f;
	float mfPulse_SearchPathRange = 15.0f;
	tID m_idPulse_Sphere = tID_Invalid;
	
	//------------------------------------------------------------
	
	void State_Pulse_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Pulse ------");
				
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Search);
		
		ResetSoundHeard();
		
		if (mMode != eWraithMode_None)
		{
			StopSpotlightMovement();
			SetSpotlightMovement_Forward();
			SetSpotLightActive(true);
		}
		
		mpStateMachine.AddTimer("Particles", 1.0f);
		mpStateMachine.AddTimer("Sphere", 0.5f);
		mpStateMachine.AddTimer("Sfx", 0.5f);
		mpStateMachine.AddTimer("MedalionSfx", 2.2f);
		mpStateMachine.AddTimer("EndSphere", 4.0f);
		mpStateMachine.AddTimer("CheckPlayerPos", 4.0f);
	}
	
	//------------------------------------------------------------

	void State_Pulse_Leave() 
	{
		ResetSoundHeard();
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul);
		if (mCommand == eWraithCommand_Pulse)
		{
			mCommand = eWraithCommand_None;
			ExecuteEntityCallback(msCommandCompletedCallback);
		}
	}
	
	//------------------------------------------------------------
	
	void State_Pulse_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_Pulse_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			int lPrio = mpStateMachine.GetCurrentMessageData().mlX;
			cVector3f vPos = mpStateMachine.GetCurrentMessageData().mvX;
						
			if (ShouldHearSound(vPos, lPrio, mpStateMachine.GetCurrentMessageData().msX))
			{
				SetAlertState(eWraithAlertState_PlayerDetected);
			}
			return true;
		}
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_Pulse_TimerUp(uint64 alId) 
	{
		if (alId == H64("Particles"))
		{
			mBaseObj.CreateParticleSystem("Pulse", "wraith_alexander_particles_Pulse", true, true);
		}
		
		if (alId == H64("Sphere"))
		{
			if (m_idPulse_Sphere == tID_Invalid)
			{
				mBaseObj.GetMap().CreateEntity(mBaseObj.GetName() + "_pulse", "wraith_pulse", cMatrixf_Identity, cVector3f_One);
				iLuxEntity@ pEnt = mBaseObj.GetMap().GetLatestEntity();
				cVector3f vPos = mBaseObj.GetPosition();
				vPos.y -= 0.8f;
				pEnt.SetPosition(vPos);
				pEnt.SetMeshScaleMul(cVector3f(mfPulse_Range * (2.0f / 15.0f), 0.1f, mfPulse_Range * (2.0f / 15.0f)));
				pEnt.AttachToEntity(cLux_ID_Entity(mBaseObj.GetID()), null, true, false, false);
				pEnt.SetActive(false);
				m_idPulse_Sphere = pEnt.GetID();
			}
			
			iLuxEntity@ pSphere = cLux_ID_Entity(m_idPulse_Sphere);
			Prop_SetActiveAndFade(pSphere.GetName(), true, 1.0f);
		}
		
		if (alId == H64("EndSphere"))
		{
			iLuxEntity@ pSphere = cLux_ID_Entity(m_idPulse_Sphere);
			Prop_SetActiveAndFade(pSphere.GetName(), false, 1.0f);
		}
		
		if (alId == H64("Sfx"))
		{
			mBaseObj.PlaySound("Pulse", gsWraithSound_Pulse, true, true);
		}
		
		if (alId == H64("MedalionSfx"))
		{
			ExecuteEntityCallback(msCallback_Pulse);
			if (mbCallback_PulseRemoveAfter) msCallback_Pulse = "";
			
			Sound_CreateAtEntity("AmuletDetected", "player/tools/amulet/amulet/amulet_pulse_start", "Player");
		}
		
		if (alId == H64("CheckPlayerPos"))
		{
			mvPulse_PlayerPos = mBaseObj.GetPlayerPos();
			++mlPulse_SameSpotCount;
			bool bPlayerInSameSpot = false;
			if (mlPulse_SameSpotCount >= 2)
			{
				if (cMath_Vector3Dist(mvPulse_PrevPlayerPos, mvPulse_PlayerPos) <= 4.0f)
				{
					bPlayerInSameSpot = true;
					mfModeWraithPatrol_PulseTimer += 20.0f;
					cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Player didn't move between pings and we haven't caught them, delay next ping");
				}
				else
				{
					mlPulse_SameSpotCount = 0;
				}
			}
			mvPulse_PrevPlayerPos = mvPulse_PlayerPos;
				
			if (bPlayerInSameSpot == false && mBaseObj.GetDistanceToPlayer() <= mfPulse_Range)
			{
				SetSpotLightColor(mSpotlightColor_Detected);
				mpPathfinder.BuildPathNodeArrayToPos(mvPulse_PlayerPos); // TODO: won't work with bigger wraith
				mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul * 2.0f);
				float fPath = mpPathfinder.GetPathNodeArrayFullLength();
				if (fPath <= mfPulse_SearchPathRange)
				{
					mpStateMachine.AddTimer("ToSearch", 1.0f);
				}
				else
				{
					mBaseObj.PlaySound("PlayerDetected", gsWraithSound_DetectedPlayer, true, true);
					mpStateMachine.AddTimer("ToStealthApproach", 0.5f);
				}
				
				
			}
			else
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Player not in range");
				SetSpotLightColor(mSpotlightColor_Idle);
				mpStateMachine.AddTimer("ToIdle", 1.0f);
			}
		}
		
		if (alId == H64("ToSearch"))
		{
			mvSearch_Pos = mvPulse_PlayerPos;
			mpStateMachine.ChangeState(eWraithState_Search);
		}
		
		if (alId == H64("ToStealthApproach"))
		{
			mbStealthApproach_UseCustomPos = true;
			mvStealthApproach_Pos = mvPulse_PlayerPos;
			mpStateMachine.ChangeState(eWraithState_StealthApproach);
		}
		
		if (alId == H64("ToIdle"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
	}
	
	//------------------------------------------------------------
	
	//} END STATE: PULSE
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: STEALTH WAIT
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbStealthWait_Silent = false;
	bool mbStealthWait_Fast = false;
	float mfStealthWait_Time = -1;
	int mlStealthWait_PickAttempt = 0;
	cVector3f mvStealthWait_AppearPos;
	
	//------------------------------------------------------------
	
	void State_StealthWait_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: StealthWait ------");
		
		mpPathfinder.Stop();
		if (mbBlocked) mbStealthWait_Fast = true;
		SetStealthModeActive(true, !mbStealthWait_Silent, "Disappeared", mbStealthWait_Fast);
	}
	
	//------------------------------------------------------------

	void State_StealthWait_Leave() 
	{
		mfStealthWait_Time = -1;
		mbStealthWait_Silent = false;
		mbStealthWait_Fast = false;
		mlStealthWait_PickAttempt = 0;
		SetStealthModeActive(false);
	}
	
	//------------------------------------------------------------
	
	void State_StealthWait_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_StealthWait_Message(int alMessageId)
	{
		return false;
	}
	
	void State_StealthWait_TimerUp(uint64 alId) 
	{
		if (alId == H64("Exit"))
		{
			SetStealthModeActive(false, true, "Appeared");
		}
		
		else if (alId == H64("Disappeared"))
		{
			if (mCommand == eWraithCommand_Disappear)
			{
				mBaseObj.SetActive(false);
				mCommand = eWraithCommand_None;
				ExecuteEntityCallback(msCommandCompletedCallback);
			}
			if (mbBlocked) mpStateMachine.AddTimer("PickUnblockPos", 0);
		}
		
		else if (alId == H64("Appeared"))
		{
			mbBlocked = false;
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
		else if (alId == H64("PickUnblockPos"))
		{
			cLux_AddAIDebugMessage("[Wraith] Picking pos to get unblocked #" + (mlStealthWait_PickAttempt + 1));
			
			bool bPicked = false;
			
			++mlStealthWait_PickAttempt;
			if (mlStealthWait_PickAttempt <= 2)
			{
				DrawTestPoint(mBaseObj.GetPosition() + mvBlocked_BlockDir * 5);
				cAINode@ pNode = mpPathfinder.GetNodeAtPos(mBaseObj.GetPosition() + mvBlocked_BlockDir * 3, 0, 3, true, true, false, null);
				if (pNode !is null && cMath_Vector3Dist(pNode.GetPosition(), mBaseObj.GetPlayerPos()) > 6)
				{
					mvStealthWait_AppearPos = pNode.GetPosition();
					bPicked = true;
				}
			}
			else if (mlStealthWait_PickAttempt <= 4)
			{
				cAINode@ pNode = mpPathfinder.GetNodeAtPos(mBaseObj.GetPosition() + mvBlocked_BlockDir * 5, 0, 6, false, true, false, null);
				if (pNode !is null && cMath_Vector3Dist(pNode.GetPosition(), mBaseObj.GetPlayerPos()) > 6)
				{
					mvStealthWait_AppearPos = pNode.GetPosition();
					bPicked = true;
				}
			}
			else if (mlStealthWait_PickAttempt <= 8)
			{
				cAINode@ pNode = mpPathfinder.GetNodeAtPos(mBaseObj.GetPosition(), 0, 10, false, true, false, null);
				if (pNode !is null && cMath_Vector3Dist(pNode.GetPosition(), mBaseObj.GetPlayerPos()) > 6)
				{
					mvStealthWait_AppearPos = pNode.GetPosition();
					bPicked = true;
				}
			}
			else if (mlStealthWait_PickAttempt == 9)
			{
				cAINode@ pNode = mpPathfinder.GetNodeAtPos(mBaseObj.GetPosition(), 0, 10, false, true, false, null);
				if (pNode !is null)
				{
					mvStealthWait_AppearPos = pNode.GetPosition();
					bPicked = true;
				}
			}
			else
			{
				mvStealthWait_AppearPos = mBaseObj.GetPosition();
				bPicked = true;
			}
			
			if (bPicked)
			{
				mBaseObj.GetCharBody().SetFeetPosition(mvStealthWait_AppearPos, false);
			}
			else
			{
				mpStateMachine.AddTimer("PickUnblockPos", 0.1f);
			}
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: STEALTH WAIT
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: STEALTH SEARCH
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbStealthSearch_CustomTarget = false;
	cVector3f mvStealthSearch_AreaCenter;
	cVector2f mvStealthSearch_RadiusRing = cVector2f(13, 18);
	
	cVector3f mvStealthSearch_MoveTo;
	cVector3f mvStealthSearch_PrevPos;
	bool mbStealthSearch_Senses = false;
	bool mbStealthSearch_Searching = false;
	bool mbStealthSearch_InitialMove = false;
	float mfStealthSearch_TravelDist = 0;
	bool mbStealthSearch_DrawDebug = false;
	
	//------------------------------------------------------------
	
	void State_StealthSearch_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: StealthSearch ------");
		
		mbStealthSearch_Senses = false;
		mbStealthSearch_Searching = false;
		mfStealthSearch_TravelDist = 0;
		mvStealthSearch_PrevPos = mBaseObj.GetPosition();
		mbStealthSearch_DrawDebug = true;
		mbStealthSearch_InitialMove = false;
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_StealthMode);
				
		SetStealthModeActive(true);
		
		if (mbStealthSearch_CustomTarget)
		{
			mvStealthSearch_MoveTo = mvStealthSearch_AreaCenter;
		}
		else
		{
			mvStealthSearch_MoveTo = mvStealthSearch_AreaCenter = mBaseObj.GetPosition();
		}
		DrawTestPoint(mvStealthSearch_MoveTo);
		
		if (mBaseObj.GetDistanceToPos(mvStealthSearch_MoveTo) <= 1.5f)
		{
			mpStateMachine.AddTimer("ChooseSearchPos", 0.5f);
		}
		else
		{
			mvStealthSearch_MoveTo = mvStealthSearch_AreaCenter;
			mbStealthSearch_InitialMove = true;
			MoveDirectlyTo(mvStealthSearch_MoveTo);
		}
		
		mpStateMachine.AddTimer("TryCancel", 0.5f);
		
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul * 1.5f);
		SetAlertState(eWraithAlertState_Searching);
	}
	
	//------------------------------------------------------------

	void State_StealthSearch_Leave() 
	{
		mbStealthSearch_DrawDebug = false;
		mbStealthSearch_CustomTarget = false;
		StopDirectMove();
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul);
	}
	
	//------------------------------------------------------------
	
	void State_StealthSearch_Update(float afTimeStep) 
	{
		if (mbStealthSearch_Searching)
		{
			mfStealthSearch_TravelDist += (mBaseObj.GetPosition() - mvStealthSearch_PrevPos).Length();
			if (mfStealthSearch_TravelDist > 25.0f)
			{
				mpStateMachine.AddTimer("StopStealthSearch", 0.0f);
			}
		}
		
		mvStealthSearch_PrevPos = mBaseObj.GetPosition();
	}
	
	//------------------------------------------------------------
	
	bool State_StealthSearch_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_DirectMoveToGoalReached)
		{
			if (mbStealthSearch_InitialMove || mbStealthSearch_Searching)
			{
				mbStealthSearch_InitialMove = false;
				mpStateMachine.AddTimer("ChooseSearchPos", 0.5f);
			}
			return true;
		}
		
		if (alMessageId == eCustomEntityMessage_StuckCounterHigh)
		{
			mpStateMachine.ChangeState(eWraithState_StuckRetreat);
			return true;
		}
		
		if (alMessageId == eLuxEntityMessage_EnterProximity && mpStateMachine.GetCurrentMessageData().mlX == eWraithProximity_StealthSense) return false;
		
		if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbHearing == false) return true;
			if (ShouldHearSound(mpStateMachine.GetCurrentMessageData().mvX, mpStateMachine.GetCurrentMessageData().mlX, mpStateMachine.GetCurrentMessageData().msX))
			{
				mpStateMachine.ChangeState(eWraithState_InvestigateSound);
			}
			return true;
		}
		
		return !mbStealthSearch_Senses;
	}
	
	void State_StealthSearch_TimerUp(uint64 alId) 
	{
		
		if (alId == H64("ChooseSearchPos"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ChooseSearchPos");
			
			mbStealthSearch_Searching = true;
			float fRadius = cMath_RandRectf(mvStealthSearch_RadiusRing.x, mvStealthSearch_RadiusRing.y);
			float fSqrtRadius = cMath_Sqrt(fRadius);
			float fTheta = cMath_RandRectf(0, cMath_PiMul2);
			cVector3f vOffset(fSqrtRadius * cMath_Cos(fTheta), 0, fSqrtRadius * cMath_Sin(fTheta));
			mvStealthSearch_MoveTo = mvStealthSearch_AreaCenter + vOffset;
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvStealthSearch_MoveTo, 0, 2, true, false, false, null);
			if (pNode !is null) mvStealthSearch_MoveTo.y = pNode.GetPosition().y + (mBaseObj.GetCharBody().GetSize().y / 2);
			
			MoveDirectlyTo(mvStealthSearch_MoveTo);
		}
		
		if (alId == H64("EnableSenses"))
		{
			mbCrystal_PlayerDetected = false;
			mbStealthSearch_Senses = true;
		}
		
		if (alId == H64("StealthAppear"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
		if (alId == H64("TryCancel"))
		{
			if (cMath_Vector3Dist(mBaseObj.GetPlayerPos(), mvStealthSearch_AreaCenter) > (mvStealthSearch_RadiusRing.y + mfStealthModeSenseRadius))
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Player too far away, cancel search");
				mpStateMachine.AddTimer("StopStealthSearch", 0.5f);
				return;
			}
			mpStateMachine.AddTimer("TryCancel", 0.5f);
		}
		
		if (alId == H64("StopStealthSearch"))
		{
			mbStealthSearch_Searching = false;
			StopDirectMove();
			SetStealthModeActive(false);
		}
		
		if (alId == H64("ToIdle"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: STEALTH SEARCH
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: STEALTH APPROACH
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbStealthApproach_UseCustomPos = false;
	bool mbStealthApproach_UseSuggestedAreas = false;
	cVector3f mvStealthApproach_Pos;
	float mfStealthApproach_AppearTime = -1.0f;
	
	float mfStealthApproach_AppearTimer = -1.0f;
	float mfStealthApproach_HeardCounter = 0;
	float mfStealthApproach_Progress = 0;
	float mfStealthApproach_NoiseCounter = 0;
	int mlStealthApproach_NoiseAppearCount = 0;
	int mlStealthApproach_TryAppearCount = 0;
	bool mbStealthApproach_TryAppear = false;
	bool mbStealthApproach_Appeared = false;
	bool mbStealthApproach_AppearFast = false;
	bool mbStealthApproach_CanDetectPlayer = false;
	bool mbStealthApproach_HeardNonPlayerSound = false;
	bool mbStealthApproach_Grounded = true;
	bool mbStealthApproach_Reverb = false;
	bool mbStealthApproach_NoiseCountTutorialOver = false;
	bool mbStealthApproach_TurnOffNoiseCountTutorial = false;
	tString mlStealthApproach_AppearType = "";
	
	//------------------------------------------------------------
	
	void State_StealthApproach_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: StealthApproach ------");
		
		mfStealthApproach_HeardCounter = 0;
		mlStealthApproach_TryAppearCount = 0;
		mbStealthApproach_TryAppear = false;
		mbStealthApproach_Appeared = false;
		mbStealthApproach_HeardNonPlayerSound = false;
		mbStealthApproach_AppearFast = false;
		mbStealthApproach_CanDetectPlayer = false;
		mbStealthApproach_Reverb = false;
		mfStealthApproach_Progress = 0.0f;
		mbStealthApproach_Grounded = cLux_GetPlayer().GetCharacterBody().IsOnGround();
		mfStealthApproach_NoiseCounter = 0;
		mbStealthApproach_TurnOffNoiseCountTutorial = false;
		
		if (mbStealthApproach_UseCustomPos == false) mvStealthApproach_Pos = mBaseObj.GetPlayerPos();
		
		ResetSoundHeard();
		
		StopSpotlightMovement();
		SetStealthModeActive(true);
		mpPathfinder.Stop();
		SetFlyModeActive(false);
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul * 100.0f);
				
		float fAppearTime = mfStealthApproach_AppearTime;
		if (fAppearTime < 0.0f)
		{
//			fAppearTime = cMath_RandRectf(15.0f, 40.0f);
			fAppearTime = 7.5f;
		}
				
		mfStealthApproach_AppearTimer = fAppearTime;
	}
	
	//------------------------------------------------------------

	void State_StealthApproach_Leave() 
	{
		ResetSoundHeard();
		mbStealthApproach_UseCustomPos = false;
		mbStealthApproach_UseSuggestedAreas = false;
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul);
		mfStealthApproach_AppearTime = -1.0f;
//		cLux_ID_SoundEntity(m_idSfx_StealthModeLoop).SetParam("progress", 0.0f);
//		cLux_ID_SoundEntity(m_idSfx_StealthModeLoop).SetParam("intensity", 0.0f);
		cSound_GetEntry(gsWraithSound_StealthModeLoop).SetParam(0, 0.0f);
		cSound_GetEntry(gsWraithSound_StealthModeLoop).SetParam(1, 0.0f);
		
		if (mbStealthApproach_TurnOffNoiseCountTutorial) mbStealthApproach_NoiseCountTutorialOver = true;
		Entity_SetActive("Soundscape_StealthApproach*", false);
	}
	
	//------------------------------------------------------------
	
	void State_StealthApproach_Update(float afTimeStep) 
	{	
		if (mbStealthApproach_TryAppear == false)
		{
//			float fDecreaseSpeed = 1.0f + 2.0f * mfStealthApproach_NoiseCounter;
//			mfStealthApproach_AppearTimer -= afTimeStep * fDecreaseSpeed;
			mfStealthApproach_AppearTimer -= afTimeStep * 1.0f;
			
			bool bRunning = Player_GetVelocity().Length() >= 3.0f;
			
			if (bRunning && mbStealthApproach_Reverb == false)
			{
				mbStealthApproach_Reverb = true;
				Entity_SetActive("Soundscape_StealthApproach*", true);
			}
			else if (bRunning == false && mbStealthApproach_Reverb)
			{
				mbStealthApproach_Reverb = false;
				Entity_SetActive("Soundscape_StealthApproach*", false);
			}
			
			bool bLanded = false;
			bool bGrounded = cLux_GetPlayer().GetCharacterBody().IsOnGround();
			if (bGrounded && mbStealthApproach_Grounded == false)
			{
//				mfStealthApproach_NoiseCounter += 0.2f;
				bLanded = true;
			}
			mbStealthApproach_Grounded = bGrounded;
			
//			if (bRunning == false && bLanded == false) mfStealthApproach_NoiseCounter -= 0.5f * afTimeStep;
//			else mfStealthApproach_NoiseCounter += 0.3f * afTimeStep;

			if (mfStealthApproach_NoiseCounter >= 1.0f)
			{
				mbStealthApproach_AppearFast = true;
				mfStealthApproach_AppearTimer = -1.0f;
			}
			
			mfStealthApproach_NoiseCounter -= 0.15f * afTimeStep;
			mfStealthApproach_NoiseCounter = cMath_Clamp(mfStealthApproach_NoiseCounter, 0.0f, 1.0f);
						
			mfStealthApproach_Progress = 1.0f - cMath_Clamp(mfStealthApproach_AppearTimer / 10.0f, 0.0f, 1.0f);

			float fIntensityParam = 0.0f;
			if (mfStealthApproach_NoiseCounter > 0.0f) fIntensityParam = cMath_Clamp(0.2f + (mfStealthApproach_NoiseCounter / 0.8f), 0.0f, 1.0f);
			
			// TODO: allow multiple stealth loops
			cSoundEntity@ pStealthSound = cLux_ID_SoundEntity(m_idSfx_StealthModeLoop);
			if (pStealthSound !is null)
			{
				pStealthSound.SetParam("progress", mfStealthApproach_Progress);
				pStealthSound.FadeSpeedMul(0.8f + 2.0f * cMath_Clamp((mfStealthApproach_NoiseCounter / 0.8f), 0.0f, 1.0f), 200);
//			cLux_ID_SoundEntity(m_idSfx_StealthModeLoop).SetParam("intensity", cMath_Clamp((mfStealthApproach_NoiseCounter / 0.8f), 0.0f, 1.0f));200);
			}
			else
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") No stealth sound, probably because another wraith used it");
			}
									
			if (mfStealthApproach_AppearTimer <= 0.0f || mAlert >= eWraithAlertState_Provoked)
			{
				mbStealthApproach_TryAppear = true;
				
				if (mvPlayerPath.size() > 0) mlStealthApproach_AppearType = "PlayerPathFront";
				else mlStealthApproach_AppearType = "Front";
				
//				if (mbStealthApproach_AppearFast)
//				{
//					if (mvPlayerPath.size() > 0) mlStealthApproach_AppearType = "PlayerPathFront";
//					else mlStealthApproach_AppearType = "Front";
//				}
//				else
//				{
//					mlStealthApproach_AppearType = "NonPlayer";
//				}
				
				float fAppearTime = 1.0f;
				if (mbStealthApproach_AppearFast) fAppearTime = 0.0f;
				else if (mbStealthApproach_HeardNonPlayerSound) fAppearTime = 2.0f;
				
				if (pStealthSound !is null) cLux_ID_SoundEntity(m_idSfx_StealthModeLoop).SetParam(1, 0);
				
				mpStateMachine.AddTimer("StartAppear", fAppearTime);
				mpStateMachine.AddTimer("PlayerOutOfReach", 6.0f);
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool State_StealthApproach_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbStealthApproach_TryAppear) return true;
			mlSoundHeard_Prio = mpStateMachine.GetCurrentMessageData().mlX;
			
			if (mlSoundHeard_Prio >= 3 && Player_GetVelocity().y <= -0.18f) mfStealthApproach_NoiseCounter += mbStealthApproach_NoiseCountTutorialOver ? 0.3f : 0.3f * 0.7f;
			else if (mlSoundHeard_Prio >= 3) mfStealthApproach_NoiseCounter += mbStealthApproach_NoiseCountTutorialOver ? 0.15f : 0.15f * 0.7f;
			else if (mlSoundHeard_Prio >= 2) mfStealthApproach_NoiseCounter += mbStealthApproach_NoiseCountTutorialOver ? 0.1f : 0.1f * 0.7f;
			if (mfStealthApproach_NoiseCounter >= 0.5f) mbStealthApproach_TurnOffNoiseCountTutorial = true;
			
			if (ShouldHearSound(mpStateMachine.GetCurrentMessageData().mvX, mpStateMachine.GetCurrentMessageData().mlX, mpStateMachine.GetCurrentMessageData().msX))
			{
				mvStealthApproach_Pos = mpStateMachine.GetCurrentMessageData().mvX;
				bool bFootstep = cString_GetFirstStringPos(cString_ToLowerCase(mpStateMachine.GetCurrentMessageData().msX), "footstep") >= 0;
				if (bFootstep == false)
				{
					mfStealthApproach_AppearTimer = -1.0f;
					mbStealthApproach_HeardNonPlayerSound = true;
				}
			}
		}
		else if (alMessageId == eLuxEntityMessage_PlayerDetected)
		{
			if (mbStealthApproach_CanDetectPlayer) mpStateMachine.ChangeState(eWraithState_PlayerDetected);
			return true;
		}
		else if (alMessageId == eCustomEntityMessage_PlayerSubmerged) return false;
		else if (alMessageId == eCustomEntityMessage_PlayerEmerged) return false;
		return true;
	}
	
	void State_StealthApproach_TimerUp(uint64 alId)
	{
		if (alId == H64("StartAppear"))
		{
			++mlStealthApproach_TryAppearCount;
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Searching appear pos, type " + mlStealthApproach_AppearType);
			if (mlStealthApproach_AppearType == "NonPlayer")
			{
				cAINode@ pNode = mpPathfinder.GetNodeAtPos(StealthApproach_GetPos(), 4.0f, 20.0f, false, true, false, null);
				if (pNode !is null && cMath_Vector3Dist(pNode.GetPosition(), mBaseObj.GetPlayerPos()) > 8.0f)
				{
					if (mlStealthApproach_TryAppearCount > 5 || 
						(mlStealthApproach_TryAppearCount <= 5 && cLux_CheckLineOfSight(mBaseObj.GetPlayerPos(), pNode.GetPosition(), true, false, null)))
					{
						cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") NonPlayer appear");
						mBaseObj.SetPosition(pNode.GetPosition() + cVector3f_Up * mBaseObj.GetCharBody().GetSize().y / 2.0f);
						DrawTestPoint(StealthApproach_GetPos());
						mpStateMachine.AddTimer("Appear", 0.0f);
						return;
					}
				}
			}
			else if (mlStealthApproach_AppearType == "PlayerPathFront")
			{
				int lPlayerIndex = GetPlayerPathIndex(mBaseObj.GetPlayerPos());
				if (lPlayerIndex + 1 >= mvPlayerPath.size())
				{
					mlStealthApproach_AppearType = "Front";
				}
				else
				{
					cVector3f vDir = cLux_ID_Entity(mvPlayerPath[lPlayerIndex + 1]).GetPosition() - cLux_ID_Entity(mvPlayerPath[lPlayerIndex]).GetPosition();
					DrawTestRay(mBaseObj.GetPlayerPos(), mBaseObj.GetPlayerPos() + vDir * 5.0f, 2.0f, cColor_Blue * 4.0f);
					cAINode@ pNode = mpPathfinder.GetNodeInCircularSectorAroundPos(StealthApproach_GetPos(), 5.0f, 20.0f, cVector3f_Zero - vDir, 340.0f, false, true, false, null);
					if (pNode !is null)
					{
						cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") PlayerPathFront appear");
						mBaseObj.SetPosition(pNode.GetPosition() + cVector3f_Up * mBaseObj.GetCharBody().GetSize().y / 2.0f);
						mpStateMachine.AddTimer("Appear", 0.0f);
						return;
					}
				}
			}
			else if (mlStealthApproach_AppearType == "Front")
			{
				cAINode@ pNode = mpPathfinder.GetNodeInCircularSectorAroundPos(StealthApproach_GetPos(), 6.0f, 20.0f, cVector3f_Zero - Player_GetForward(), 330.0f, false, true, false, null);
				if (pNode !is null)
				{
					cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Front appear");
					mBaseObj.SetPosition(pNode.GetPosition() + cVector3f_Up * mBaseObj.GetCharBody().GetSize().y / 2.0f);
					mpStateMachine.AddTimer("Appear", 0.0f);
					return;
				}
			}
			else if (mlStealthApproach_AppearType == "Back")
			{
				cAINode@ pNode = mpPathfinder.GetNodeInCircularSectorAroundPos(StealthApproach_GetPos(), 6.0f, 20.0f, Player_GetForward(), 80.0f, false, true, false, null);
				if (pNode !is null)
				{
					cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Back appear");
					mBaseObj.SetPosition(pNode.GetPosition() + cVector3f_Up * mBaseObj.GetCharBody().GetSize().y / 2.0f);
					mpStateMachine.AddTimer("Appear", 0.0f);
					return;
				}
			}
			mpStateMachine.AddTimer("StartAppear", cMath_RandRectf(0.1f, 0.2f));
		}
		
		if (alId == H64("PlayerOutOfReach"))
		{
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(StealthApproach_GetPos(), 6.0f, 15.0f, false, false, false, null);
			if (pNode !is null)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Backup appear");
				mBaseObj.SetPosition(pNode.GetPosition() + cVector3f_Up * mBaseObj.GetCharBody().GetSize().y / 2.0f);
			}
			else
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Couldn't find any appear pos");
			}
			mpStateMachine.StopTimer("StartAppear");
			mpStateMachine.AddTimer("Appear", 0.0f);
		}
		
		if (alId == H64("Appear"))
		{
			if (mfStealthApproach_NoiseCounter >= 1.0f) ++mlStealthApproach_NoiseAppearCount;
			if (mlStealthApproach_NoiseAppearCount >= 3) SetAlertState(eWraithAlertState_Provoked);
			mpStateMachine.StopTimer("PlayerOutOfReach");
			
			tString sAppearWarningNoise = mbStealthApproach_AppearFast ? gsWraithSound_AppearWarningFast : gsWraithSound_AppearWarning;
			mBaseObj.PlaySound("AppearSound", sAppearWarningNoise, true, true);
			
			mpMover.TurnInstantlyToPos(StealthApproach_GetPos());
			mbStealthMode_AppearUseCustomDir = true;
			mvStealthMode_AppearCustomDir = GetCrystalToPosDir(StealthApproach_GetPos());
			
			SetStealthModeActive(false, true, "AppearDone", mbStealthApproach_AppearFast);
		}
		
		if (alId == H64("AppearDone"))
		{
			mbStealthApproach_Appeared = true;
			
			mpMover.TurnInstantlyToPos(StealthApproach_GetPos());
			TurnSpotlightToPos(StealthApproach_GetPos(), true, false);
						
			if (mbStealthApproach_AppearFast)
			{
				mpStateMachine.ChangeState(eWraithState_PlayerDetected);
			}
			else
			{
				mbStealthApproach_CanDetectPlayer = true;
				mpStateMachine.AddTimer("Exit", 2.0f);
			}
		}
		
		if (alId == H64("Exit"))
		{
			mpStateMachine.ChangeState(eWraithState_LookAroundForPlayer);
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f StealthApproach_GetPos()
	{
		if (mbStealthApproach_AppearFast) return mBaseObj.GetPlayerPos();
		return mvStealthApproach_Pos;
	}
	
	//------------------------------------------------------------
	
	//} END STATE: STEALTH APPROACH
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: STEALTH MOVE TO PLAYER
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbStealthMoveToPlayer_Moving = false;
	float mfStealthMoveToPlayer_GiveUpTime = 3.0f;
	
	//------------------------------------------------------------
	
	void State_StealthMoveToPlayer_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: StealthMoveToPlayer ------");
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_StealthMoveToPlayer);
		
		mbStealthMoveToPlayer_Moving = false;
		
		if (mbStealthModeActive == false)
		{
			SetStealthModeActive(true);
		}
		else
		{
			mpStateMachine.AddTimer("StartMoving", 0.0f);
		}
		
		SetAlertState(eWraithAlertState_Searching);
	}
	
	//------------------------------------------------------------

	void State_StealthMoveToPlayer_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_StealthMoveToPlayer_Update(float afTimeStep) 
	{
		if (mbStealthMoveToPlayer_Moving && mBaseObj.GetDistanceToPlayer() <= 3 && mbPlayerCameraLineOfSight)
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Got close enough to player, start appearing");
			mbStealthMoveToPlayer_Moving = false;
			mpStateMachine.StopTimer("StartAppearing");
			mpStateMachine.AddTimer("StartAppearing", 0.0f);
		}		
	}
	
	//------------------------------------------------------------
	
	bool State_StealthMoveToPlayer_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_PlayerDetected)
		{
		}
		
		if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbHearing == false) return true;
			if (mpStateMachine.TimerExists("ToLookAround")) return true;
		}
		
		if (alMessageId == eCustomEntityMessage_StuckCounterHigh)
		{
			mpStateMachine.ChangeState(eWraithState_StuckRetreat);
			return true;
		}
		
		return mbStealthModeActive;
	}
	
	//------------------------------------------------------------
	
	void State_StealthMoveToPlayer_TimerUp(uint64 alId) 
	{
		if (alId == H64("StartMoving"))
		{
			mpStateMachine.AddTimer("StartAppearing", mfStealthMoveToPlayer_GiveUpTime);
			mbStealthMoveToPlayer_Moving = true;
			MoveDirectlyTo(mBaseObj.GetPlayerPos());
		}
		
		if (alId == H64("StealthDisappear"))
		{
			mpStateMachine.AddTimer("StartMoving", 0.5f);
		}
		
		if (alId == H64("StartAppearing"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Start appearing");
			StopDirectMove();
			SetStealthModeActive(false);
			mpStateMachine.AddTimer("TurnToPlayer", 0.0f);
		}
		
		if (alId == H64("TurnToPlayer"))
		{
			mpMover.TurnToPos(mBaseObj.GetPlayerPos());
			mpStateMachine.AddTimer("TurnToPlayer", 0.2f);
		}
		
		if (alId == H64("StealthAppear"))
		{
			cLux_AddDebugMessage("DO IT");
			mpProximitySensor.ResetAllStates();
			mpStateMachine.AddTimer("ToLookAround", 1.0f);
		}
		
		if (alId == H64("ToLookAround"))
		{
			mpStateMachine.ChangeState(eWraithState_LookAroundForPlayer);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: STEALTH MOVE TO PLAYER
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: LOOK AROUND FOR PLAYER
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbLookAroundForPlayer_Small = false;
	bool mbLookAroundForPlayer_CustomPos = false;
	cVector3f mvLookAroundForPlayer_LookPos;
	
	cVector3f mvLookAroundForPlayer_StartForward;
	tString msLookAroundForPlayer_TurnLightState;
	
	int mlLookAroundForPlayer_TurnCount = 0;
	float mfLookAroundForPlayer_TurnSpeed = 0.8f;
	
	//------------------------------------------------------------
	
	void State_LookAroundForPlayer_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: LookAroundForPlayer ------");
		
		cVector3f vCustomDir = mvLookAroundForPlayer_LookPos - mBaseObj.GetPosition();
		vCustomDir.y = 0;
		vCustomDir.Normalize();
		
		mvLookAroundForPlayer_StartForward = mbLookAroundForPlayer_CustomPos ? vCustomDir : mBaseObj.GetCharBody().GetForward();
		mlLookAroundForPlayer_TurnCount = 0;
		
		SetSpotLightActive(true);
		SetSpotLightColor(mSpotlightColor_Alert);
		StopSpotlightMovement();
		ResetCrystalDetection();
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_SearchTurn);
		mpProximitySensor.ResetAllStates();
		SetMoveAnimState(eWraithMoveAnimState_Search);

		mBaseObj.PlaySound("StartCheck", gsWraithSound_StartCheck, true, true);

		mpStateMachine.AddTimer(mbLookAroundForPlayer_Small ? "TurnRightSmall" : "TurnForward", 0.0f);
		
		SetAlertState(eWraithAlertState_Searching);
	}
	
	//------------------------------------------------------------

	void State_LookAroundForPlayer_Leave() 
	{
		SetMoveAnimState(eWraithMoveAnimState_Default);
		mbLookAroundForPlayer_CustomPos = false;
		msLookAroundForPlayer_TurnLightState = "";
	}
	
	//------------------------------------------------------------
	
	void State_LookAroundForPlayer_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_LookAroundForPlayer_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_SpotlightTurnDone)
		{
			if (msLookAroundForPlayer_TurnLightState == "TurnForward")
			{
				mpStateMachine.AddTimer("TurnRight", 0.5f);
				mpStateMachine.AddTimer("TurnMover1", 2.0f);
				mpStateMachine.AddTimer("TurnMover2", 3.0f);
			}
			else if (msLookAroundForPlayer_TurnLightState == "TurnRight") mpStateMachine.AddTimer("TurnAround", 0.5f);
			else if (msLookAroundForPlayer_TurnLightState == "TurnAround") mpStateMachine.AddTimer("TurnForward2", 0.5f);
			else if (msLookAroundForPlayer_TurnLightState == "TurnForward2") mpStateMachine.AddTimer("StartExit", 0.5f);
			else if (msLookAroundForPlayer_TurnLightState == "TurnRightSmall") mpStateMachine.AddTimer("TurnLeftSmall", 0.5f);
			else if (msLookAroundForPlayer_TurnLightState == "TurnLeftSmall") mpStateMachine.AddTimer("TurnForwardSmall", 0.5f);
			else if (msLookAroundForPlayer_TurnLightState == "TurnForwardSmall") mpStateMachine.AddTimer("StartExit", 0.5f);
			msLookAroundForPlayer_TurnLightState = "";
		}
		
		return false;
	}
	
	void State_LookAroundForPlayer_TimerUp(uint64 alId) 
	{
		if (alId == H64("StartSpotlightMovement"))
		{
			mpStateMachine.AddTimer("Turn1", 0.0f);
			
		}
		
		else if (alId == H64("TurnForward"))
		{
			msLookAroundForPlayer_TurnLightState = "TurnForward";
			TurnSpotlightToDir(mvLookAroundForPlayer_StartForward, true, true, 1.0f, 5.0f);
		}
		
		else if (alId == H64("TurnRight"))
		{
			msLookAroundForPlayer_TurnLightState = "TurnRight";
			TurnSpotlightToAngle(mfCrystal_TargetHAngle + cMath_ToRad(90), cMath_ToRad(-5), true, true, mfLookAroundForPlayer_TurnSpeed, 5.0f);
		}
		
		else if (alId == H64("TurnAround"))
		{
			msLookAroundForPlayer_TurnLightState = "TurnAround";
			TurnSpotlightToAngle(mfCrystal_TargetHAngle + cMath_ToRad(-360), cMath_ToRad(-5), true, true, mfLookAroundForPlayer_TurnSpeed, 5.0f);
		}
		
		else if (alId == H64("TurnForward2"))
		{
			msLookAroundForPlayer_TurnLightState = "TurnForward2";
			TurnSpotlightToDir(mBaseObj.GetCharBody().GetForward(), true, true, mfLookAroundForPlayer_TurnSpeed, 5.0f);
		}
		
		else if (alId == H64("TurnRightSmall"))
		{
			msLookAroundForPlayer_TurnLightState = "TurnRightSmall";
			float fH, fV = 0;
			GetClosestSpotlightAngle(mvLookAroundForPlayer_StartForward, fH, fV);
			TurnSpotlightToAngle(fH + cMath_ToRad(45), cMath_ToRad(-5), true, true, mfLookAroundForPlayer_TurnSpeed, 5.0f);
			
			cVector3f vTurnDir = mvLookAroundForPlayer_StartForward;
			mpMover.TurnToPos(mBaseObj.GetPosition() + vTurnDir);
		}
		
		else if (alId == H64("TurnLeftSmall"))
		{
			msLookAroundForPlayer_TurnLightState = "TurnLeftSmall";
			float fH, fV = 0;
			GetClosestSpotlightAngle(mvLookAroundForPlayer_StartForward, fH, fV);
			TurnSpotlightToAngle(fH - cMath_ToRad(45), cMath_ToRad(-5), true, true, mfLookAroundForPlayer_TurnSpeed, 5.0f);
		}
		
		else if (alId == H64("TurnForwardSmall"))
		{
			msLookAroundForPlayer_TurnLightState = "TurnForwardSmall";
			TurnSpotlightToDir(mBaseObj.GetCharBody().GetForward(), true, true, mfLookAroundForPlayer_TurnSpeed, 5.0f);
		}
		
		else if (alId == H64("TurnMover1"))
		{
			cVector3f vTurnDir = mvLookAroundForPlayer_StartForward;
			vTurnDir = cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(100)), vTurnDir);
			mpMover.TurnToPos(mBaseObj.GetPosition() + vTurnDir);
		}
		
		else if (alId == H64("TurnMover2"))
		{
			cVector3f vTurnDir = mvLookAroundForPlayer_StartForward;
			vTurnDir = cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(180)), vTurnDir);
			mpMover.TurnToPos(mBaseObj.GetPosition() + vTurnDir);
		}
		
		else if (alId == H64("SpotlightForward"))
		{
			SetSpotlightMovement_Forward();
		}
			
		else if (alId == H64("StartExit"))
		{
//			mBaseObj.PlaySound("StartCheck", gsWraithSound_EndCheck, true, true);

			SetSpotLightActive(false);
			
			mpStateMachine.AddTimer("ExitSound", 0.0);
			mpStateMachine.AddTimer("Exit", 0.75f);
		}
		
		else if (alId == H64("ExitSound"))
		{
			cLux_AddDebugMessage("HERE");
			mBaseObj.PlaySound("EndSearch", gsWraithSound_End_search, true, true);
		}
		
		else if (alId == H64("Exit"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: LOOK AROUND FOR PLAYER
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: SEARCH AROUND
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbSearchAround_UseAnim = true;
	
	//------------------------------------------------------------
	
	cVector3f mvSearchAround_Forward;
	bool mbSearchAround_RightFirst = false;
	tString msSearchAround_AnimState = "";
	bool mbSearchAround_CameraSpotlight = false;
	bool mbSearchAround_CameraSpotlightFade = false;
	
	//------------------------------------------------------------
	
	void State_SearchAround_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: SearchAround ------");
		
		SetSpotLightColor(mSpotlightColor_Idle);
		StopSpotlightMovement();
		ResetCrystalDetection();
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_SearchTurn);
		mpProximitySensor.ResetAllStates();
		
		msSearchAround_AnimState = "";
		mvSearchAround_Forward = mBaseObj.GetCharBody().GetForward();
		mbSearchAround_RightFirst = cMath_RandRectl(0, 1) == 0;
		mbSearchAround_CameraSpotlight = false;
		mbSearchAround_CameraSpotlightFade = false;
		
		mBaseObj.PlaySound("StartCheck", gsWraithSound_StartCheck, true, true);
		
		mpStateMachine.AddTimer("LightsOn", 1.0);
	}
	
	//------------------------------------------------------------

	void State_SearchAround_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_SearchAround_Update(float afTimeStep) 
	{
		if (mbSearchAround_UseAnim && mbSearchAround_CameraSpotlight)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idCrystal);
			if (pEnt !is null)
			{
				cVector3f vFwd = mBaseObj.GetMeshEntity().GetSocket("wraith_crystal").GetWorldMatrix().GetTranspose().GetForward();
				float fTurnSpeed = mbSearchAround_CameraSpotlightFade ? 2 : 10;
				TurnSpotlightToDir(vFwd, true, true, fTurnSpeed);
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool State_SearchAround_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			if (msSearchAround_AnimState == "look_around")
			{
//				mpStateMachine.AddTimer("StartExit", 0.5f);
				msSearchAround_AnimState = "";
			}
		}
		
		return false;
	}
	
	void State_SearchAround_TimerUp(uint64 alId) 
	{
		if (alId == H64("LightsOn"))	
		{
			SetSpotLightActive(true);
			mpStateMachine.AddTimer("Turn1", 1.0);
		}
		
		else if (alId == H64("Turn1"))
		{
			if (mbSearchAround_UseAnim)
			{
				msSearchAround_AnimState = "look_around";
				
				int lAnimIndex = cMath_RandRectl(1, 3);
				mpMover.PlayAnimation("search_look_around_" + lAnimIndex);
				
				mbSearchAround_CameraSpotlightFade = true;
				mpStateMachine.AddTimer("StartCameraSpotlight", 0.3);
				mpStateMachine.AddTimer("StopCameraSpotlightFade", 0.6);
				mpStateMachine.AddTimer("StartExit", 5.0f);
				return;
			}
			
			float fH, fV = 0;
			GetClosestSpotlightAngle(mvSearchAround_Forward, fH, fV);
			
			float fDir = mbSearchAround_RightFirst ? -1 : 1;
			float fVertical = mbFlyMode_Active ? cMath_ToRad(-35) : cMath_ToRad(-5);
			TurnSpotlightToAngle(fH - cMath_ToRad(30 * fDir), fVertical, true, true, mfLookAroundForPlayer_TurnSpeed, 4.0f);
			
			mpStateMachine.AddTimer("Turn2", 1.5);
		}
		
		else if (alId == H64("Turn2"))
		{
			float fH, fV = 0;
			GetClosestSpotlightAngle(mvSearchAround_Forward, fH, fV);
			
			float fDir = mbSearchAround_RightFirst ? 1 : -1;
			float fVertical = mbFlyMode_Active ? cMath_ToRad(-35) : cMath_ToRad(-5);
			TurnSpotlightToAngle(fH - cMath_ToRad(30 * fDir), fVertical, true, true, mfLookAroundForPlayer_TurnSpeed, 4.0f);
			
			mpStateMachine.AddTimer("StartExit", 1.5);
		}
		
		else if (alId == H64("StopCameraSpotlightFade"))
		{
			mbSearchAround_CameraSpotlightFade = false;
		}
		
		else if (alId == H64("StartCameraSpotlight"))
		{
			mbSearchAround_CameraSpotlight = true;
		}
		
		else if (alId == H64("StartExit"))
		{
			mbSearchAround_CameraSpotlight = false;
			SetSpotlightMovement_Forward(true);
			mpStateMachine.AddTimer("StartExit2", 0.5);
		}
		
		else if (alId == H64("StartExit2"))
		{
			SetSpotLightActive(false);
			mpStateMachine.AddTimer("Exit", 1.0);
		}
		
		else if (alId == H64("Exit"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: SEARCH AROUND
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: INSPECT POSITION
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvInspectPosition_Pos;
	float mfInspectPosition_Time = 0.0f;
	
	//------------------------------------------------------------
	
	void State_InspectPosition_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: InspectPosition ------");
		
		mpPathfinder.Stop();
		cVector3f vDir = GetCrystalToPos(mvInspectPosition_Pos);
		SetSpotlightMovement_Scan(vDir, 1, 1, 1, true);
				
		mpStateMachine.AddTimer("Exit", mfInspectPosition_Time);
	}
	
	//------------------------------------------------------------

	void State_InspectPosition_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_InspectPosition_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_InspectPosition_Message(int alMessageId)
	{
		return false;
	}
	
	void State_InspectPosition_TimerUp(uint64 alId) 
	{
		if (alId == H64("Exit"))
		{
			if (mCommand == eWraithCommand_ScanPosition)
			{
				mCommand = eWraithCommand_None;
				ExecuteEntityCallback(msCommandCompletedCallback);
			}
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: INSPECT POSITION
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: LOOK AT POSITION
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvLookAtPosition_Pos;
	bool mbLookAtPosition_CanHear = true;
	bool mbLookAtPosition_Scan = true;
	bool mbLookAtPosition_Alerted = false;
	bool mbLookAtPosition_HearNonPlayer = false;
	int mlLookAtPosition_SoundsHeard = 0;
	
	//------------------------------------------------------------
	
	void State_LookAtPosition_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: LookAtPosition ------");
		
		mbLookAtPosition_CanHear = false;
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Fly);
		
		ResetCrystalDetection();
		ResetSoundHeard();
		if (mAlert >= eWraithAlertState_PlayerDetected) mlLookAtPosition_SoundsHeard = 2;
		
		SetSpotLightActive(true);
		StopSpotlightMovement();
		
		if (mCommand == eWraithCommand_LookAtPosition && mbLookAtPosition_Alerted == false) SetSpotLightColor(mSpotlightColor_Idle);
		else SetSpotLightColor(mSpotlightColor_Alert);
				
		mpStateMachine.AddTimer("CanHear", 1.5f);
	
		mpStateMachine.AddTimer("SoundHeardReaction", 0.0f);
		mpStateMachine.AddTimer("LookAt", 0.5f);

		SetAlertState(eWraithAlertState_Searching);
	}
	
	//------------------------------------------------------------

	void State_LookAtPosition_Leave() 
	{
		mlLookAtPosition_SoundsHeard = 0;
		mbLookAtPosition_Scan = true;
		mbLookAtPosition_Alerted = false;
		mbLookAtPosition_HearNonPlayer = false;
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idFlyMode_FlySound);
		if (pSound !is null) pSound.FadeOut(0.5);
		m_idFlyMode_FlySound = tID_Invalid;
		
		ResetSoundHeard();
	}
	
	//------------------------------------------------------------
	
	void State_LookAtPosition_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_LookAtPosition_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_SpotlightTurnDone)
		{
			mpStateMachine.AddTimer("Scan", 1.0f);
		}
		
		else if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbLookAtPosition_CanHear == false) return true;
			if (mbHearing == false) return true;
			if (ShouldHearSound(mpStateMachine.GetCurrentMessageData().mvX, mpStateMachine.GetCurrentMessageData().mlX, mpStateMachine.GetCurrentMessageData().msX))
			{
				++mlLookAtPosition_SoundsHeard;
								
				mbLookAtPosition_HearNonPlayer = false;
				mbLookAtPosition_Scan = true;
				mbLookAtPosition_CanHear = false;
				mvLookAtPosition_Pos = mpStateMachine.GetCurrentMessageData().mvX;
				mpStateMachine.AddTimer("SoundHeardReaction", 0.0f);
				mpStateMachine.AddTimer("LookAt", mlLookAtPosition_SoundsHeard >= 2 ? 0 : 0.5f);
				mpStateMachine.AddTimer("CanHear", mlLookAtPosition_SoundsHeard >= 2 ? 0.4 : 0.8f);
				mpStateMachine.StopTimer("Exit");
				
				if (mlLookAtPosition_SoundsHeard >= 3)
				{
					SetAlertState(eWraithAlertState_PlayerDetected);
					mpStateMachine.AddTimer("Exit", 0);
				}
			}
		}
		return false;
	}
	
	void State_LookAtPosition_TimerUp(uint64 alId) 
	{
		if (alId == H64("CanHear"))
		{
			mbLookAtPosition_CanHear = true;
		}
		
		if (alId == H64("LookAt"))
		{
			float fTurnSpeed = 1.2f;
			if (mlLookAtPosition_SoundsHeard >= 2) fTurnSpeed = 3.25;
			mpMover.TurnToPos(mvLookAtPosition_Pos);
			TurnSpotlightToPos(mvLookAtPosition_Pos, true, true, fTurnSpeed);
		}
		
		if (alId == H64("Scan"))
		{
			if (mbLookAtPosition_Scan)
			{
				SetSpotlightMovement_SidewaysEight(0.6f, 0.35f, 0.06f, true, mvLookAtPosition_Pos, true);
				mpStateMachine.AddTimer("Exit", 5);
			}
			else
			{
				mpStateMachine.AddTimer("Exit", 1);
			}
		}
		
		if (alId == H64("SoundHeardReaction"))
		{
			mBaseObj.PlaySound("SoundHeard", gsWraithSound_Hears_a_sound, true, true);
		}
		
		if (alId == H64("MoveToPlayer"))
		{
			cVector3f vFlyPos;
			bool bNode = GetFlyNode(mBaseObj.GetPlayerPos(), vFlyPos);
			if (bNode)
			{
				mpPathfinder.MoveTo(vFlyPos, 1, false);
				if (m_idFlyMode_FlySound != tID_Invalid) m_idFlyMode_FlySound = mBaseObj.PlaySound("FlySound", "", false, true).GetID();
			}
			mpStateMachine.AddTimer("MoveToPlayer", 0.5);
		}
		
		if (alId == H64("Exit"))
		{
			if (mCommand == eWraithCommand_LookAtPosition)
			{
				mCommand = eWraithCommand_None;
				ExecuteEntityCallback(msCommandCompletedCallback);
			}
			
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: LOOK AT POSITION
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: CONTROL GHOUL
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	tString msControlGhoul_GhoulEnt;
	float mfControlGhoul_MaxDist = -1;
	float mfControlGhoul_MinDist = -1;
	
	//------------------------------------------------------------
	
	void State_ControlGhoul_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: ControlGhoul ------");
		
		mpMover.SetSpeedState(eWraithSpeed_ControlGhoul);
		
		SetSpotLightColor(mSpotlightColor_Struggle);
		SetSpotLightActive(true);
		StopSpotlightMovement();
		
		mpStateMachine.AddTimer("FollowTargetWithLight", 0.0);
		mpStateMachine.AddTimer("FollowTarget", 0.0);
	}
	
	//------------------------------------------------------------

	void State_ControlGhoul_Leave() 
	{
		mpMover.SetSpeedMul(1);
	}
	
	//------------------------------------------------------------
	
	void State_ControlGhoul_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_ControlGhoul_Message(int alMessageId)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_ControlGhoul_TimerUp(uint64 alId) 
	{
		if (alId == H64("FollowTarget"))
		{
			mpStateMachine.AddTimer("FollowTarget", 0.2f);
						
			cVector3f vGhoulPos = mBaseObj.GetMap().GetEntityByName(msControlGhoul_GhoulEnt).GetMainBody().GetWorldPosition();
			bool bPath = mpPathfinder.BuildPathNodeArrayFromTo(mBaseObj.GetCharBody().GetFeetPosition(), vGhoulPos);
			float fDist = bPath ? mpPathfinder.GetPathNodeArrayFullLength() : 0;
			
			float fMinDist = mfControlGhoul_MinDist;
			if (fMinDist < 0) fMinDist = 3.5;
			float fMaxDist = mfControlGhoul_MaxDist;
			if (fMaxDist < 0) fMaxDist = 13.0;
			
			float fSpeedMul = cMath_Clamp((fDist - fMinDist) / (fMaxDist - fMinDist), 0.0f, 1.0f);
			mpMover.SetSpeedMul(fSpeedMul * 2.0f);
						
			if (fSpeedMul > 0)
			{
				cAINode@ pNode = mpPathfinder.GetNodeAtPos(vGhoulPos, 0.0f, 5.0f, true, false, false, null);
				if (pNode !is null)
				{
					mpPathfinder.MoveTo(pNode.GetPosition(), 1.0f, false);
				}
			}
		}
		
		if (alId == H64("FollowTargetWithLight"))
		{
			TurnSpotlightToPos(mBaseObj.GetMap().GetEntityByName(msControlGhoul_GhoulEnt).GetPosition(), true, true);
			mpStateMachine.AddTimer("FollowTargetWithLight", 0.2f);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: CONTROL GHOUL
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: FLY SEARCH
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvFlySearch_Pos;
	
	//------------------------------------------------------------
	
	void State_FlySearch_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: FlySearch ------");
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Fly);
		
		ResetSoundHeard();
		
		mpStateMachine.AddTimer("SoundHeardReaction", 0.2f);
		mpStateMachine.AddTimer("DecideAction", 0.5f);
		
		SetAlertState(eWraithAlertState_Searching);
	}
	
	//------------------------------------------------------------

	void State_FlySearch_Leave()
	{
	}
	
	//------------------------------------------------------------
	
	void State_FlySearch_Update(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	bool State_FlySearch_Message(int alMessageId)
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_FlySearch_TimerUp(uint64 alId) 
	{
		if (alId == H64("SoundHeardReaction"))
		{
			mBaseObj.PlaySound("SoundHeard", gsWraithSound_Hears_a_sound, true, true);
//			mpMover.TurnToPos(mvFlySearch_Pos);
		}
		else if (alId == H64("DecideAction"))
		{
			cVector3f vSoundHeardDir = cMath_Vector3Normalize(mvSoundHeard_Pos - mBaseObj.GetPosition());
			cVector3f vSearchPos = mvSoundHeard_Pos - vSoundHeardDir * 6;
			
			cVector3f vNode;
			bool bFlyToNode = FlyToNode_GetClosestNode(vSearchPos, vNode);
			
			cAINode@ pNode = null;
			if (mbFlyToNode_UsePathNodes) @pNode = mpPathfinder.GetNodeAtPos(vSearchPos, 0, 5, true, false, false, null);
			
			bool bDash = pNode !is null || bFlyToNode;
			cVector3f vDashPos = pNode is null ? vNode : pNode.GetPosition();
			if (bDash && mBaseObj.GetDistanceToPos(vDashPos) > 5)
			{
				mvDash_Pos = vDashPos;
				mbDash_SoundHeardDash = true;
				mpStateMachine.ChangeState(eWraithState_Dash);
			}
			else
			{
				mvLookAtPosition_Pos = mvSoundHeard_Pos;
				mbLookAtPosition_HearNonPlayer = mbSoundHeard_NonPlayer;
				mpStateMachine.ChangeState(eWraithState_LookAtPosition);
			}
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: CONTROL GHOUL
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: FLY TO NODE
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	array<tID> mvFlyToNode_Nodes;
	cVector3f mvFlyToNode_Pos;
	tString msFlyToNode_CommandNode;
	float mfFlyToNode_SoundVolume = 1;
	bool mbFlyToNode_Spotlight = false;
	bool mbFlyToNode_UsePathNodes = true;
	
	tID m_idFlyToNode_DirWidget = tID_Invalid;
	tID m_idFlyToNode_FlySound = tID_Invalid;
	int mlFlyToNode_GazeCount = 0;
	int mlFlyToNode_PickAttempt = 0;
	
	//------------------------------------------------------------
	
	void State_FlyToNode_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: FlyToNode ------");
				
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Fly);
		SetFlyModeActive(true);
		
		SetSpotLightActive(mbFlyToNode_Spotlight);
		SetSpotLightColor(mSpotlightColor_Idle);
		SetSpotlightMovement_ForwardOffset(cMath_ToRad(0), cMath_ToRad(5), true);
		mbCrystal_InternalSight = false;
		
		mlFlyToNode_GazeCount = 0;
		mlFlyToNode_PickAttempt = 0;
		
		float fPrevStress = mfModeFlyPatrol_PlayerStress;
		
		SetModeFlyPatrolState();
		
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") State: " + msModeFlyPatrol_State + " PlayerStress: " + fPrevStress, true, false);
		
		mpStateMachine.AddTimer("PickAndMove", 0.5);
	}
	
	//------------------------------------------------------------

	void State_FlyToNode_Leave() 
	{
		mbFlyToNode_Spotlight = false;
		mbCrystal_InternalSight = true;
		mpMover.SetSpeedMul(1);
		mfFlyToNode_SoundVolume = 1;
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idFlyToNode_FlySound);
		if (pSound !is null) pSound.FadeOut(1.0f);
		if (mpStateMachine.GetNextState() != eWraithState_Idle && mpStateMachine.GetNextState() != eWraithState_Dash) mlModeFlyPatrol_Stage = 0;
	}
	
	//------------------------------------------------------------
	
	void State_FlyToNode_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_FlyToNode_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			mpStateMachine.AddTimer("StartExit", 0.0f);
		}
		
		else if (alMessageId == eCustomEntityMessage_PlayerGazeDetected)
		{
			++mlFlyToNode_GazeCount;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_FlyToNode_TimerUp(uint64 alId) 
	{
		if (alId == H64("PickAndMove"))
		{
			++mlFlyToNode_PickAttempt;
			bool bPicked = FlyToNode_PickNode();
			if (bPicked == false)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Can't find a good node to move to, attempt " + mlFlyToNode_PickAttempt);
				mpStateMachine.AddTimer("PickAndMove", 0.2f);
				if (mlFlyToNode_PickAttempt >= 5) mpStateMachine.AddTimer("StartExit", 0.0f);
				return;
			}
			
//			cSoundEntity@ pSound = mBaseObj.PlaySound("FlySound", "creatures/foley/creature/wraith/wraith_flying", false, true);
//			pSound.SetVolume(mfFlyToNode_SoundVolume);
//			pSound.FadeVolumeMul(mfSfx_VolumeMul, 100);
			
//			m_idFlyToNode_FlySound = pSound.GetID();
			
			if (msModeFlyPatrol_State == "Attack") mpMover.SetSpeedMul(2);
			cAINode@ pNode = null;
			if (mbFlyToNode_UsePathNodes) @pNode = mpPathfinder.GetNodeAtPos(mvFlyToNode_Pos, 0, 5, true, false, false, null);
			if (pNode !is null)
			{
				mvDash_Pos = pNode.GetPosition();
//				mpPathfinder.MoveToNode(pNode.GetName(), 2, true);
			}
			else
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Can't find a node, flying directly to area, dangerous!");
				
				mvDash_Pos = mvFlyToNode_Pos;
//				mpPathfinder.MoveTo(mvFlyToNode_Pos, 1.0f, true);	
			}
			
			if (mMode == eWraithMode_FlyPatrol) mlModeFlyPatrol_Stage = 1;
			mpStateMachine.ChangeState(eWraithState_Dash);
			
			
//			ParticleSystem_CreateAtEntity(mBaseObj.GetName() + "burst", "dwf_wraith_stealth_appear_fast", mBaseObj.GetName(), true);
//			mBaseObj.PlaySound("Burst", gsWraithSound_Burst, true, true);
		}
		
		if (alId == H64("StartExit"))
		{
			if (mMode == eWraithMode_FlyPatrol) mlModeFlyPatrol_Stage = 1;
//			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idFlyToNode_FlySound);
//			if (pSound !is null) pSound.FadeOut(1.0f);
			
			if (msModeFlyPatrol_State == "Attack")
			{
				mpStateMachine.AddTimer("TurnForward", 0.1f);
				mpStateMachine.AddTimer("Exit", 0.5f);
			}
			else
			{
				mpStateMachine.AddTimer("TurnForward", 0.5f);
				mpStateMachine.AddTimer("Exit", 1.0f);
			}
		}
		
		else if (alId == H64("TurnForward"))
		{
			cVector3f vFwd = mBaseObj.GetCharBody().GetForward();
			vFwd.y = 0;
			mpMover.TurnToPos(mBaseObj.GetCharBody().GetPosition() + cMath_Vector3Normalize(vFwd));
		}
			
		else if (alId == H64("Exit"))
		{
			if (mCommand == eWraithCommand_FlyToNode)
			{
				mCommand = eWraithCommand_None;
				ExecuteEntityCallback(msCommandCompletedCallback);
			}
			
			if (mlFlyToNode_GazeCount >= 2)
			{
				mpStateMachine.ChangeState(eWraithState_PlayerGazeDetected);
			}
			else 
			{
				mpStateMachine.ChangeState(eWraithState_Idle);
			}
		}
	}
	//------------------------------------------------------------
	
	bool FlyToNode_PickNode()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Pick node");
		
		// Pick chosen node when commanded
		if (mCommand == eWraithCommand_FlyToNode && msFlyToNode_CommandNode != "")
		{
			iLuxEntity@ pEnt = mBaseObj.GetMap().GetEntityByName(msFlyToNode_CommandNode);
			if (pEnt is null)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Chosen node doesn't exist");
				return false;
			}
			else
			{
				mvFlyToNode_Pos = pEnt.GetPosition();
				DrawTestPoint(mvFlyToNode_Pos, 5.0f, cColor_Green * 2.0f, 0.2f);
				return true;
			}
		}
		
		if (mvFlyToNode_Nodes.size() == 0) return false;
		
		float fPlayerGoalDot = FlyToNode_GetPositionDot(mBaseObj.GetPlayerPos());
		
		iLuxEntity@ pWidget = cLux_ID_Entity(m_idFlyToNode_DirWidget);
		if (pWidget !is null)
		{
			cVector3f vWidgetFwd = pWidget.GetMatrix().GetTranspose().GetForward();
			vWidgetFwd.y = 0;
			vWidgetFwd.Normalize();
			DrawTestPoint(pWidget.GetPosition(), 5.0f, cColor_Green * 2.0f, 0.2f);
			DrawTestRay(pWidget.GetPosition(), pWidget.GetPosition() + vWidgetFwd * 10.0f, 5.0f, cColor_Green * 2.0f);
		}
				
		array<cVector3f> vEligiblePos;
		cVector3f vClosestPos;
		float fClosestDist = -1;
		for (int i = 0; i < mvFlyToNode_Nodes.size(); ++i)
		{
			iLuxEntity@ pNode = cLux_ID_Entity(mvFlyToNode_Nodes[i]);
			if (pNode is null) continue;
			DrawTestPoint(pNode.GetPosition(), 5.0f, cColor_Red * 2.0f, 0.2f);
			if (mBaseObj.GetDistanceToPos(pNode.GetPosition()) <= 5.0f) continue;
			
			float fPlayerDist = (mBaseObj.GetPlayerPos() - pNode.GetPosition()).Length();
			float fGoalDot = FlyToNode_GetPositionDot(pNode.GetPosition());
			
			if (msModeFlyPatrol_State == "Random")
			{
				vEligiblePos.push_back(pNode.GetPosition());
				DrawTestPoint(pNode.GetPosition(), 5.0f, cColor_Blue * 2.0f, 0.2f);
			}
			else if (msModeFlyPatrol_State == "Block")
			{
				if (mlFlyToNode_PickAttempt == 1)
				{
					if (fGoalDot < fPlayerGoalDot + 20.0f) continue;
					if (fGoalDot > fPlayerGoalDot + 40.0f) continue;
					if (fPlayerDist < 25.0f) continue;
				}
				else if (mlFlyToNode_PickAttempt == 2)
				{
					if (fPlayerDist < 25.0f) continue;
					if (fPlayerDist < 40.0f) continue;
				}
				else if (mlFlyToNode_PickAttempt >= 3)
				{
					if (fPlayerDist < 25.0f) continue;
				}
				
				vEligiblePos.push_back(pNode.GetPosition());
				DrawTestPoint(pNode.GetPosition(), 5.0f, cColor_Blue * 2.0f, 0.2f);
			}
			else if (msModeFlyPatrol_State == "Respite")
			{
				if (mlFlyToNode_PickAttempt == 1)
				{
					if (FlySpotlightSearch_LineIntersectPlayer(pNode.GetPosition(), mBaseObj.GetPosition(), 10.0f)) continue;
					if (fPlayerDist < 35.0f) continue;
					if (fGoalDot > fPlayerGoalDot) continue;
				}
				else if (mlFlyToNode_PickAttempt == 2)
				{
					if (fPlayerDist < 35.0f) continue;
				}
				else if (mlFlyToNode_PickAttempt >= 3)
				{
					if (fPlayerDist < 20.0f) continue;
				}

				vEligiblePos.push_back(pNode.GetPosition());
				DrawTestPoint(pNode.GetPosition(), 5.0f, cColor_Blue * 2.0f, 0.2f);
			}
			else if (msModeFlyPatrol_State == "Attack")
			{
				if (mlFlyToNode_PickAttempt == 1)
				{
					if (fGoalDot < fPlayerGoalDot + 8.0f) continue;
					if (fPlayerDist > 17.0f) continue;
					if (fPlayerDist < 7.0f) continue;
				}
				else if (mlFlyToNode_PickAttempt == 2)
				{
					if (fPlayerDist > 15.0f) continue;
					if (fPlayerDist < 5.0f) continue;
				}
				else if (mlFlyToNode_PickAttempt == 3)
				{
					if (fPlayerDist > 25.0f) continue;
				}
				else if (mlFlyToNode_PickAttempt >= 4)
				{
					float fDist = cMath_Vector3Dist(pNode.GetPosition(), mBaseObj.GetPlayerPos());
					if (fClosestDist < 0 || fDist < fClosestDist)
					{
						fClosestDist = fDist;
						vClosestPos = pNode.GetPosition();
					}
					if (fClosestDist >= 0 && i == (mvFlyToNode_Nodes.size() - 1))
					{
						vEligiblePos.push_back(vClosestPos);
						DrawTestPoint(pNode.GetPosition(), 5.0f, cColor_Blue * 2.0f, 0.2f);
					}
					continue;
				}
				
				vEligiblePos.push_back(pNode.GetPosition());
				DrawTestPoint(pNode.GetPosition(), 5.0f, cColor_Blue * 2.0f, 0.2f);
			}
		}
		
		if (vEligiblePos.size() > 0)
		{
			mvFlyToNode_Pos = vEligiblePos[cMath_RandRectl(0, vEligiblePos.size() - 1)];
			DrawTestPoint(mvFlyToNode_Pos, 5.0f, cColor_Green * 2.0f, 0.2f);
			return true;
		}
		
		return false;
	}
	
	float FlyToNode_GetPositionDot(const cVector3f &in avPos)
	{
		iLuxEntity@ pWidget = cLux_ID_Entity(m_idFlyToNode_DirWidget);
		if (pWidget is null) return 0;
		cVector3f vWidgetFwd = pWidget.GetMatrix().GetTranspose().GetForward();
		vWidgetFwd.y = 0;
		vWidgetFwd.Normalize();
		cVector3f vWidgetToPos = avPos - pWidget.GetPosition();
		vWidgetToPos.y = 0;
		return cMath_Vector3Dot(vWidgetToPos, vWidgetFwd);
	}
	
	//------------------------------------------------------------
	
	bool FlyToNode_GetClosestNode(const cVector3f &in avPos, cVector3f &out avNode)
	{
		float fMinDist = -1;
		iLuxEntity@ pMinNode;
		for (int i = 0; i < mvFlyToNode_Nodes.size(); ++i)
		{
			iLuxEntity@ pNode = cLux_ID_Entity(mvFlyToNode_Nodes[i]);
			if (pNode is null) continue;
			
			float fDist = cMath_Vector3Dist(avPos, pNode.GetPosition());
			if (fDist < fMinDist || fMinDist < 0)
			{
				fMinDist = fDist;
				@pMinNode = pNode;
			}
		}
		
		if (pMinNode !is null)
		{
			avNode = pMinNode.GetPosition();
			return true;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	//} END STATE: FLY TO NODE
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: FLY SPOTLIGHT SEARCH
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbFlySpotlightSearch_SnapTurn = false;
	bool mbFlySpotlightSearch_TurnLeft = false;
	int mlFlySpotlightSearch_TurnCount = 0;
	int mlFlySpotlightSearch_SweepCount = 0;
	cVector2f mvFlySpotlightSearch_SweepCountRange = cVector2f(2,3);
	array<cVector3f> mvFlySpotlightSearch_LookAtNodes;
	array<cVector3f> mvFlySpotlightSearch_LookAtPositions;
	
	int mlFlySpotlightSearch_Turns = 2;
	int mlFlySpotlightSearch_SweepsTarget = 2;
	float mfFlySpotlightSearch_LookAtFieldNodeDistance = 4.0f;
	cVector3f mvFlySpotlightSearch_LookAtPos;
	cVector3f mvFlySpotlightSearch_CommandLookAtPos;
	float mfFlySpotlightSearch_SweepHalfDist = 10.0f;
	
	//------------------------------------------------------------
	
	void State_FlySpotlightSearch_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: FlySpotlightSearch ------");
		
		mbFlySpotlightSearch_SnapTurn = true;
		mbFlySpotlightSearch_TurnLeft = true;
		mlFlySpotlightSearch_TurnCount = 0;
		mlFlySpotlightSearch_SweepCount = 0;
		mlFlySpotlightSearch_SweepsTarget = cMath_RandRectl(mvFlySpotlightSearch_SweepCountRange.x, mvFlySpotlightSearch_SweepCountRange.y);
		
		mpPathfinder.Stop();
		SetSpotLightActive(false);
		SetSpotLightColor(mSpotlightColor_Idle);
		StopSpotlightMovement();
				
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") State: " + msModeFlyPatrol_State, true, false);
		
		mpStateMachine.AddTimer("PickNodeAndLook", 0.0f);
		mpStateMachine.AddTimer("LightsOn", 0.75);
	}
	
	//------------------------------------------------------------

	void State_FlySpotlightSearch_Leave() 
	{
		mbCrystal_InternalSight = true;
		
		if (mpStateMachine.GetNextState() != eWraithState_Idle) mlModeFlyPatrol_Stage = 0;
		if (msModeFlyPatrol_State == "Attack" && mfModeFlyPatrol_PlayerStress > 0.7f) mfModeFlyPatrol_PlayerStress -= 0.5f;
	}
	
	//------------------------------------------------------------
	
	void State_FlySpotlightSearch_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_FlySpotlightSearch_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_SpotlightTurnDone)
		{
			mbFlySpotlightSearch_SnapTurn = false;
			float fWraithDot = FlyToNode_GetPositionDot(mBaseObj.GetPosition());
			float fPlayerDot = FlyToNode_GetPositionDot(mBaseObj.GetPlayerPos());
			
			if (mlFlySpotlightSearch_TurnCount >= mlFlySpotlightSearch_Turns)
			{
				mlFlySpotlightSearch_TurnCount = 0;
				++mlFlySpotlightSearch_SweepCount;
				
				if (mlFlySpotlightSearch_SweepCount >= mlFlySpotlightSearch_SweepsTarget || fPlayerDot >= fWraithDot + 5.0f || (mbModeFlyPatrol_RandomNodes == false && mfModeFlyPatrol_PlayerStress < -0.7f))
				{
					cLux_AddDebugMessage("FAIL " + fPlayerDot + " "+  fWraithDot + " " + mfModeFlyPatrol_PlayerStress);
					mpStateMachine.AddTimer("StartExit", 0.0f);
				}
				else
				{
					mpStateMachine.AddTimer("PickNodeAndLook", 1.0f);
				}
			}
			else
			{
				mbFlySpotlightSearch_TurnLeft = !mbFlySpotlightSearch_TurnLeft;
				if (fPlayerDot >= fWraithDot + 15.0f)
				{
					mpStateMachine.AddTimer("StartExit", 0.0f);
				}
				else
				{
					mpStateMachine.AddTimer("TurnLightToExtreme", 1.0f);
				}
			}
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_FlySpotlightSearch_TimerUp(uint64 alId) 
	{
		if (alId == H64("PickNodeAndLook"))
		{
			bool bPicked = FlySpotlightSearch_PickNode();
			
			if (msModeFlyPatrol_State == "Attack") mvFlySpotlightSearch_LookAtPos = mBaseObj.GetPlayerPos();
			
			DrawTestPoint(mvFlySpotlightSearch_LookAtPos, 10.0f, cColor(1.0f, 0.8f, 0.0f) * 3.0f, 5);
			
			mvFlySpotlightSearch_LookAtPositions.resize(0);
			
			float fSweepHalfDist = mfFlySpotlightSearch_SweepHalfDist;
			if (msModeFlyPatrol_State == "Attack") fSweepHalfDist *= 0.75f;
			
			cVector3f vLookLeftPos = mvFlySpotlightSearch_LookAtPos + FlySpotlightSearch_GetSweepDir(mvFlySpotlightSearch_LookAtPos) * fSweepHalfDist;
			mvFlySpotlightSearch_LookAtPositions.push_back(vLookLeftPos);
			cVector3f vLeftDir = vLookLeftPos - mBaseObj.GetPosition();
			vLeftDir.y = 0;
			vLeftDir.Normalize();
			
			cVector3f vLookRightPos = mvFlySpotlightSearch_LookAtPos + FlySpotlightSearch_GetSweepDir(mvFlySpotlightSearch_LookAtPos) * -fSweepHalfDist;
			mvFlySpotlightSearch_LookAtPositions.push_back(vLookRightPos);
			cVector3f vRightDir = vLookRightPos - mBaseObj.GetPosition();
			vRightDir.y = 0;
			vRightDir.Normalize();
			
			cVector3f vSpotlightDir = mvCrystal_CurrentDir;
			vSpotlightDir.y = 0;
			vSpotlightDir.Normalize();
			
			if (cMath_Vector3Angle(vSpotlightDir, vLeftDir) <= cMath_Vector3Angle(vSpotlightDir, vRightDir)) mbFlySpotlightSearch_TurnLeft = true;
			else mbFlySpotlightSearch_TurnLeft = false;
			
			mbFlySpotlightSearch_SnapTurn = true;
			mpStateMachine.AddTimer("TurnToPos", 0.0f);
			mpStateMachine.AddTimer("TurnLightToExtreme", 0.0f);
		}
			
		else if (alId == H64("LightsOn"))
		{
			SetSpotLightActive(true);
		}
		
		else if (alId == H64("TurnToPos"))
		{
			mpMover.TurnToPos(mvFlySpotlightSearch_LookAtPos);
		}
		
		else if (alId == H64("TurnLightToExtreme"))
		{
			float fDirMul = mbFlySpotlightSearch_TurnLeft ? 1.0f : -1.0f;
			cVector3f vLookPos = mbFlySpotlightSearch_TurnLeft ? mvFlySpotlightSearch_LookAtPositions[0] : mvFlySpotlightSearch_LookAtPositions[1];
			DrawTestPoint(vLookPos, 4.0f, cColor(1.0f, 0.2f, 0.0f) * 3.0f);
			
			if (mbFlySpotlightSearch_SnapTurn)
			{
				TurnSpotlightToPos(vLookPos, true, true, 1.0f);
//				SetSpotLightActive(true, false);
			}
			else
			{
				++mlFlySpotlightSearch_TurnCount;
				float fSpeed = 0.5f;
				if (msModeFlyPatrol_State == "Attack") fSpeed = 0.8f;
				TurnSpotlightToPos(vLookPos, true, true, fSpeed);
			}
		}
		
		else if (alId == H64("StartExit"))
		{
			if (mMode == eWraithMode_FlyPatrol) mlModeFlyPatrol_Stage = 0;
			SetSpotLightActive(false);
			mbCrystal_InternalSight = false;
			SetSpotlightMovement_ForwardOffset(cMath_ToRad(0), cMath_ToRad(5));
			mpStateMachine.AddTimer("Exit", 1.0f);
		}
		
		else if (alId == H64("TurnOffLights"))
		{
			SetSpotLightActive(false);
		}
		
		else if (alId == H64("Exit"))
		{
			if (mCommand == eWraithCommand_FlySpotlightSearch)
			{
				mCommand = eWraithCommand_None;
				ExecuteEntityCallback(msCommandCompletedCallback);
			}
			
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f FlySpotlightSearch_GetSweepDir(const cVector3f &in avPoint)
	{
		cVector3f vDir = avPoint - mBaseObj.GetPosition();
		cVector3f vLeft = cMath_Vector3Cross(cVector3f_Up, vDir);
		return cMath_Vector3Normalize(vLeft);
	}
	
	//------------------------------------------------------------
	
	void FlySpotlightSearch_AddLookAtField(const tString &in asField)
	{
		iLuxEntity@ pEnt = Map_GetEntity(asField);
		if (pEnt is null) return;
		
		cLuxArea@ pArea = cLux_ToArea(pEnt);
		if (pArea is null) return;
		
		int lDimX = cMath_Floor(pArea.GetSize().x / mfFlySpotlightSearch_LookAtFieldNodeDistance);
		int lDimZ = cMath_Floor(pArea.GetSize().z / mfFlySpotlightSearch_LookAtFieldNodeDistance);
		
		float fEdgeX = (pArea.GetSize().x % mfFlySpotlightSearch_LookAtFieldNodeDistance) / 2.0f;
		float fStartX = pArea.GetPosition().x - (pArea.GetSize().x / 2.0f) + fEdgeX;
		float fEdgeZ = (pArea.GetSize().z % mfFlySpotlightSearch_LookAtFieldNodeDistance) / 2.0f;
		float fStartZ = pArea.GetPosition().z - (pArea.GetSize().z / 2.0f) + fEdgeZ;
		
		float fX = 0.0f;
		float fZ = 0.0f;
		
		for (int i = 0; i < lDimX; ++i)
		{
			for (int j = 0; j < lDimZ; ++j)
			{
				cVector3f vPos = cVector3f(fStartX + fX, pArea.GetPosition().y, fStartZ + fZ);
				mvFlySpotlightSearch_LookAtNodes.push_back(vPos);
				DrawTestPoint(vPos, 2.0f, cColor(1.0f, 1.0f, 0.0f) * 3.0f);
				
				fZ += mfFlySpotlightSearch_LookAtFieldNodeDistance;
			}
			fX += mfFlySpotlightSearch_LookAtFieldNodeDistance;
			fZ = 0;
		}
	}
	
	//------------------------------------------------------------
	
	bool FlySpotlightSearch_PickNode()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") PickNode " + msModeFlyPatrol_State);
		
		// Pick chosen pos when commanded
		if (mCommand == eWraithCommand_FlySpotlightSearch)
		{
			mvFlySpotlightSearch_LookAtPos = mvFlySpotlightSearch_CommandLookAtPos;
			DrawTestPoint(mvFlySpotlightSearch_LookAtPos, 5.0f, cColor_Green * 2.0f, 0.2f);
			return true;
		}
		
		if (mvFlySpotlightSearch_LookAtNodes.size() == 0) return false;
		
		if (msModeFlyPatrol_State == "Attack")
		{
			mvFlySpotlightSearch_LookAtPos = mBaseObj.GetPlayerPos();
		}
		
		float fPlayerGoalDot = FlyToNode_GetPositionDot(mBaseObj.GetPlayerPos());
		
		array<cVector3f> vEligiblePos;
		for (int i = 0; i < mvFlySpotlightSearch_LookAtNodes.size(); ++i)
		{
			cVector3f vNode = mvFlySpotlightSearch_LookAtNodes[i];
			DrawTestPoint(vNode, 5.0f, cColor_Red * 2.0f, 0.2f);
			
			if (msModeFlyPatrol_State == "Attack") continue;
			
			float fNodeDist = mBaseObj.GetDistanceToPos2D(vNode);
			if (fNodeDist <= 8.0f) continue;
			
			if (mlFlySpotlightSearch_SweepCount > 0)
			{
				cVector3f vNodeToLast = mvFlySpotlightSearch_LookAtPos - vNode;
				vNodeToLast.y = 0;
				if (vNodeToLast.Length() <= 6.0f) continue;
			}
			
			cVector3f vNodeToPlayer = mBaseObj.GetPlayerPos() - vNode;
			vNodeToPlayer.y = 0;
			float fNodeToPlayerDist = vNodeToPlayer.Length();
			
			if (msModeFlyPatrol_State == "Random")
			{
				DrawTestPoint(vNode, 5.0f, cColor_Blue * 2.0f, 0.2f);
				vEligiblePos.push_back(vNode);
			}
			else if (msModeFlyPatrol_State == "Block")
			{
				if (fNodeToPlayerDist <= 10.0f) continue;
				if (fNodeDist >= 17.0f) continue;
				if (cMath_RandRectf(0, 1) <= 0.8)
				{
					float fGoalDot = FlyToNode_GetPositionDot(vNode);
					if (fGoalDot < fPlayerGoalDot + 5) continue;
				}
//				if (FlySpotlightSearch_LineIntersectPlayer(vNode, mBaseObj.GetPosition(), 10.0f)) continue;
								
				DrawTestPoint(vNode, 5.0f, cColor_Blue * 2.0f, 0.2f);
				vEligiblePos.push_back(vNode);
			}
			else if (msModeFlyPatrol_State == "Respite")
			{
				if (fNodeToPlayerDist <= 20.0f) continue;
				if (fNodeDist >= 15.0f) continue;
				if (FlySpotlightSearch_LineIntersectPlayer(vNode, mBaseObj.GetPosition(), 10.0f)) continue;
								
				DrawTestPoint(vNode, 5.0f, cColor_Blue * 2.0f, 0.2f);
				vEligiblePos.push_back(vNode);
			}
			else if (msModeFlyPatrol_State == "Attack")
			{
				if (fNodeToPlayerDist > 10.0f) continue;
				if (fNodeDist > 25.0f) continue;
				
				cVector3f vExtreme1 = vNode + FlySpotlightSearch_GetSweepDir(vNode) * 0.75f * mfFlySpotlightSearch_SweepHalfDist;
				cVector3f vExtreme1ToPlayer = mBaseObj.GetPlayerPos() - vExtreme1;
				vExtreme1ToPlayer.y = 0;
				
				cVector3f vExtreme2 = vNode - FlySpotlightSearch_GetSweepDir(vNode) * 0.75f * mfFlySpotlightSearch_SweepHalfDist;
				cVector3f vExtreme2ToPlayer = mBaseObj.GetPlayerPos() - vExtreme2;
				vExtreme2ToPlayer.y = 0;
				
				float fExtremeRadius = 7.0f;
				if (fNodeToPlayerDist >= fExtremeRadius && vExtreme1ToPlayer.Length() >= fExtremeRadius && vExtreme2ToPlayer.Length() >= fExtremeRadius) continue;
				
				DrawTestPoint(vNode, 5.0f, cColor_Blue * 2.0f, 0.2f);
				vEligiblePos.push_back(vNode);
			}
			
		}
		
		if (vEligiblePos.size() > 0)
		{
			mvFlySpotlightSearch_LookAtPos = vEligiblePos[cMath_RandRectl(0, vEligiblePos.size() - 1)];
			cVector3f vNode = mvFlySpotlightSearch_LookAtPos;
			
			cVector3f vExtreme1 = vNode + FlySpotlightSearch_GetSweepDir(vNode) * mfFlySpotlightSearch_SweepHalfDist;
			DrawTestPoint(vExtreme1, 5.0f, cColor(1,0,1) * 2.0f, 0.2f);
			cVector3f vExtreme1ToPlayer = mBaseObj.GetPlayerPos() - vExtreme1;
			vExtreme1ToPlayer.y = 0;
			
			cVector3f vExtreme2 = vNode - FlySpotlightSearch_GetSweepDir(vNode) * mfFlySpotlightSearch_SweepHalfDist;
			DrawTestPoint(vExtreme2, 5.0f, cColor(1,0,1) * 2.0f, 0.2f);
			cVector3f vExtreme2ToPlayer = mBaseObj.GetPlayerPos() - vExtreme2;
			vExtreme2ToPlayer.y = 0;
			
			cVector3f vNodeToPlayer = mBaseObj.GetPlayerPos() - vNode;
			vNodeToPlayer.y = 0;
			float fNodeToPlayerDist = vNodeToPlayer.Length();
						
			DrawTestPoint(mvFlySpotlightSearch_LookAtPos, 5.0f, cColor_Green * 2.0f, 0.2f);
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	bool FlySpotlightSearch_LineIntersectPlayer(const cVector3f &in avA, const cVector3f &in avB, float afPlayerRadius)
	{
		cVector3f vStart = cVector3f(avA.x, 0, avA.z);
		cVector3f vEnd = cVector3f(avB.x, 0, avB.z);
		
		float fT1 = 0.0f;
		cVector3f vI1;
		float fT2 = 0.0f;
		cVector3f vI2;
		return cMath_CheckSphereLineIntersection(mBaseObj.GetPlayerPos(), afPlayerRadius, vStart, vEnd, fT1, vI1, fT2, vI2);
	}
	
	//------------------------------------------------------------
	
	//} END STATE: FLY TO NODE
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: FLY PATROL
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cWraithFlyPatrol mFlyPatrol_ModeInstance = cWraithFlyPatrol();
	cWraithFlyPatrol mFlyPatrol_CurrentInstance = cWraithFlyPatrol();
	cWraithFlyPatrol mFlyPatrol_NextInstance = cWraithFlyPatrol();
	int mlFlyPatrol_InstanceCounter = 0;
	int mlFlyPatrol_PatrolIndex = 0;
	float mfFlyPatrol_Speed = 1.0f;
	float mfFlyPatrol_HAngle = 90.0f;
	float mfFlyPatrol_VAngle = 35.0f;
	
	//------------------------------------------------------------
	
	void State_FlyPatrol_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: FlyPatrol ------");
		mlFlyPatrol_PatrolIndex = 0;		
		mFlyPatrol_CurrentInstance = mFlyPatrol_NextInstance;
		mfFlyPatrol_HAngle = mFlyPatrol_CurrentInstance.mfHAngle;
		mfFlyPatrol_VAngle = mFlyPatrol_CurrentInstance.mfVAngle;
		mfFlyPatrol_Speed = mFlyPatrol_CurrentInstance.mfRotSpeed;
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Fly);
		
		SetSpotLightActive(true);
		SetSpotlightMovement_Forward(true);
		SetSpotLightColor(mSpotlightColor_Idle);
				
		if (mbFlyMode_Active == false)
		{
			SetStealthModeActive(true, true, "StealthDisappear");
		}
		else if (mbStealthModeActive)
		{
			SetStealthModeActive(false, true, "StealthAppear");
		}
		else
		{
			mpStateMachine.AddTimer("Start", 0.0f);
		}
		
		SetFlyModeActive(true);
	}
	
	//------------------------------------------------------------

	void State_FlyPatrol_Leave() 
	{
		mpSoundListener.SetSoundRadiusMul(mfSoundRadiusMul * 1.0f);
	}
	
	//------------------------------------------------------------
	
	void State_FlyPatrol_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_FlyPatrol_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			mpStateMachine.AddTimer("MoveToPos", 0.0f);
		}
		
		return false;
	}
	
	void State_FlyPatrol_TimerUp(uint64 alId) 
	{
		if (alId == H64("Start"))
		{
			mpStateMachine.AddTimer("MoveToPos", 0.0f);
//			SetSpotlightMovement_Forward();
			SetSpotlightMovement_LeftToRight(mfFlyPatrol_VAngle, mfFlyPatrol_Speed, mfFlyPatrol_HAngle / 90.0f);
		}
		
		if (alId == H64("StealthDisappear"))
		{
			tString sNode = mFlyPatrol_CurrentInstance.mvNodes[mlFlyPatrol_PatrolIndex];
			mBaseObj.SetPosition(mBaseObj.GetMap().GetEntityByName(sNode).GetPosition());
			SetStealthModeActive(false, true, "StealthAppear");
		}
		
		if (alId == H64("StealthAppear"))
		{
			mpStateMachine.AddTimer("Start", 0.0f);
		}
		
		if (alId == H64("MoveToPos"))
		{
			cVector3f mvMoveToPos = cVector3f_Zero;
			if (mFlyPatrol_CurrentInstance.mbRandom)
			{
				tString sNode = mFlyPatrol_CurrentInstance.mvNodes[cMath_RandRectl(0, mFlyPatrol_CurrentInstance.mvNodes.size() - 1)];
				mvMoveToPos = mBaseObj.GetMap().GetEntityByName(sNode).GetPosition();
			}
			else
			{
				tString sNode = mFlyPatrol_CurrentInstance.mvNodes[mlFlyPatrol_PatrolIndex];
				mvMoveToPos = mBaseObj.GetMap().GetEntityByName(sNode).GetPosition();
				++mlFlyPatrol_PatrolIndex;
				mlFlyPatrol_PatrolIndex %= mFlyPatrol_CurrentInstance.mvNodes.size();
			}
			
			mpPathfinder.MoveTo(mvMoveToPos, 1.0f, false);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: FLY PATROL
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: FLY FOLLOW ENTITY
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	tString msFlyFollowEntity_Ent;
	tID m_idFlyFollow_Ent;
	eWraithLightMovement mFlyFollowEntity_PrevLightMovement = eWraithLightMovement_None;
	bool mbFlyFollowEntity_LookAtPlayer = false;
	float mfFlyFollowEntity_LookAtCounter = 0;
	float mfFlyFollowEntity_SpeedMul = 1.0f;
	
	//------------------------------------------------------------
	
	void State_FlyFollowEntity_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: FlyFollowEntity ------");
		
		mFlyFollowEntity_PrevLightMovement = eWraithLightMovement_None;
		mbFlyFollowEntity_LookAtPlayer = false;
		mfFlyFollowEntity_LookAtCounter = 0;
		
		iLuxEntity@ pEnt = mBaseObj.GetMap().GetEntityByName(msFlyFollowEntity_Ent);
		if (pEnt is null)
		{
			mpStateMachine.AddTimer("Exit", 0);
			return;
		}
		
		SetSpotLightActive(true);
		
		m_idFlyFollow_Ent = pEnt.GetID();
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Fly);
		
		mfSpotlight_DetectedMul = 0.8f;
				
		mpStateMachine.AddTimer("MoveToEnt", 0);
	}
	
	//------------------------------------------------------------

	void State_FlyFollowEntity_Leave() 
	{
		mfFlyFollowEntity_SpeedMul = 1.0f;
		mfSpotlight_DetectedMul = 1.0f;
		mpMover.SetSpeedMul(1.0f);
	}
	
	//------------------------------------------------------------
	
	void State_FlyFollowEntity_Update(float afTimeStep) 
	{
		if (mbFlyFollowEntity_LookAtPlayer)
		{
			TurnSpotlightToPos(mvLastPlayerSpotlightPos, true, true, 10.0f);
						
			if (mbCrystal_PlayerSeen)
			{
				if (mpStateMachine.TimerExists("StopLookAt")) mpStateMachine.StopTimer("StopLookAt");
				mfFlyFollowEntity_LookAtCounter += afTimeStep;
				if (mfFlyFollowEntity_LookAtCounter >= 2.5f)
				{
					mpStateMachine.ChangeState(eWraithState_Struggle);
				}
			}
			else
			{
				mfFlyFollowEntity_LookAtCounter -= afTimeStep;
				if (mfFlyFollowEntity_LookAtCounter <= 0.0f)
				{
					mfFlyFollowEntity_LookAtCounter = 0.0f;
					if (mpStateMachine.TimerExists("StopLookAt") == false) mpStateMachine.AddTimer("StopLookAt", 1.0f);
				}
			}
		}
		
//		if (Player_GetCrouching())
//		{
//			mfSpotlight_DetectedMul = 1.8f;
//		}
//		else
//		{
//			mfSpotlight_DetectedMul = 1.2f;
//		}
	}
	
	//------------------------------------------------------------
	
	bool State_FlyFollowEntity_Message(int alMessageId)
	{
		if(alMessageId == eLuxEntityMessage_PlayerDetected)
		{
			mFlyFollowEntity_PrevLightMovement = mSpotlightMovement;
			mbFlyFollowEntity_LookAtPlayer = true;
			SetSpotLightColor(mSpotlightColor_Alert);
			SetAlertState(eWraithAlertState_PlayerDetected);
			return true;
		}
		
		return false;
	}
	
	void State_FlyFollowEntity_TimerUp(uint64 alId) 
	{
		if (alId == H64("Exit"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
		if (alId == H64("StopLookAt"))
		{
			mbFlyFollowEntity_LookAtPlayer = false;
			SetSpotLightColor(mSpotlightColor_Alert);
			SetAlertState(eWraithAlertState_None, true);
			mSpotlightMovement = mFlyFollowEntity_PrevLightMovement;
		}
		
		if (alId == H64("MoveToEnt"))
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idFlyFollow_Ent);
			mpPathfinder.MoveTo(pEnt.GetPosition(), 1.0f, true);
			
			float fDist = cMath_Vector3Dist(pEnt.GetPosition(), mBaseObj.GetPosition());
			float fDistMul = cMath_Clamp((fDist - 0.5f) / (15.0f - 0.5f), 0.0f, 1.0f);
						
			mpMover.SetSpeedMul(2.5f * mfFlyFollowEntity_SpeedMul * fDistMul);
			
			mpStateMachine.AddTimer("MoveToEnt", cMath_RandRectf(0.1f, 0.2f));
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: FLY FOLLOW ENTITY
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: FLY SEARCH POSITION
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvFlySearchPosition_Pos;
	cVector3f mvFlySearchPosition_FlyPos;
	tID m_idFlySearchPosition_FlySound;
	int mlFlySearchPosition_PickAttempt = 0;
	bool mbFlySearchPosition_Move = false;
	bool mbFlySearchPosition_CanHear = false;
	cVector3f mvFlySearchPosition_PlayerPos;
	
	//------------------------------------------------------------
	
	void State_FlySearchPosition_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: FlySearchPosition ------");
		
		mlFlySearchPosition_PickAttempt = 0;
		mbFlySearchPosition_Move = false;
		mbFlySearchPosition_CanHear = false;
		
		mvFlySearchPosition_PlayerPos = mBaseObj.GetPlayerPos();
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Fly);
		
		SetFlyModeActive(true);
		SetSpotLightActive(true);
		StopSpotlightMovement();
		
		SetSpotLightColor(mSpotlightColor_Alert);
		SetAlertState(eWraithAlertState_Searching);
		
		mpStateMachine.AddTimer("PickNodeAndMove", 0.0f);
		mpStateMachine.AddTimer("CheckPlayerDist", 2.0f);
	}
	
	//------------------------------------------------------------

	void State_FlySearchPosition_Leave() 
	{
		mpMover.SetSpeedMul(1);
		
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idFlySearchPosition_FlySound);
		if (pSound !is null) pSound.FadeOut(0.5f);
	}
	
	//------------------------------------------------------------
	
	void State_FlySearchPosition_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_FlySearchPosition_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			mbFlySearchPosition_Move = false;
			mpStateMachine.AddTimer("TurnToTarget", 0.5f);
			mpStateMachine.AddTimer("StartExit", 3.5f);
		}
		else if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			return !mbFlySearchPosition_CanHear;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_FlySearchPosition_TimerUp(uint64 alId) 
	{
		if (alId == H64("PickNodeAndMove"))
		{
			bool bPicked = FlySearchPosition_PickNode();
			++ mlFlySearchPosition_PickAttempt;
			if (bPicked)
			{
				mbFlySearchPosition_Move = true;
				
//				m_idFlySearchPosition_FlySound = mBaseObj.PlaySound("FlySound", "", false, true).GetID();
				
				SetSpotlightMovement_SidewaysEight(0.7f, 0.35f, 0.06f, true, mvFlySearchPosition_Pos, true);
				
				mpPathfinder.MoveTo(mvFlySearchPosition_FlyPos, 1, false);
				mpStateMachine.AddTimer("AdjustSpeed", 0.0f);
			}
			else
			{
				if (mlFlySearchPosition_PickAttempt >= 5)
				{
					mpStateMachine.AddTimer("StartExit", 0.0f);
				}
				else
				{
					mpStateMachine.AddTimer("PickNodeAndMove", 0.2f);	
				}
			}
		}
		
		else if (alId == H64("AdjustSpeed"))
		{
			if (mbFlySearchPosition_Move)
			{
				float fTargetDist = mBaseObj.GetDistanceToPlayer2D();
				float fSpeedMul = 1;
				if (mAlert >= eWraithAlertState_PlayerDetected)
				{
					if (fTargetDist <= 12.5) fSpeedMul = 0.8f;
					else fSpeedMul = 1.3f;
				}
				else if (fTargetDist <= 12.5) mpMover.SetSpeedMul(0.3);
				mpMover.SetSpeedMul(fSpeedMul);
				
			}
			mpStateMachine.AddTimer("AdjustSpeed", cMath_RandRectf(0.2, 0.4f));
		}
		
		else if (alId == H64("CheckPlayerDist"))
		{
			float fPlayerOrigDist = cMath_Vector3Dist(mvFlySearchPosition_PlayerPos, mBaseObj.GetPlayerPos());
			if (fPlayerOrigDist > 4)
			{
				mbFlySearchPosition_CanHear = true;
			}
			mpStateMachine.AddTimer("CheckPlayerDist", cMath_RandRectf(0.2, 0.4f));
		}
		
		else if (alId == H64("TurnToTarget"))
		{
			mpMover.TurnToPos(mvFlySearchPosition_Pos);
			TurnSpotlightToPos(mvFlySearchPosition_Pos, true, true, 1.2);
		}
		
		else if (alId == H64("StartExit"))
		{
			mbFlySearchPosition_Move = false;
			
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idFlySearchPosition_FlySound);
			if (pSound !is null) pSound.FadeOut(1.0f);
			
			SetSpotlightMovement_ForwardOffset(cMath_ToRad(0), cMath_ToRad(5), true);
			mpMover.TurnToPos(mBaseObj.GetPosition() + mBaseObj.GetCharBody().GetForward());
			
			mpStateMachine.AddTimer("Exit", 1.0f);
		}
		
		else if (alId == H64("Exit"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	bool FlySearchPosition_PickNode()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Pick node");
		
		if (mvFlyToNode_Nodes.size() == 0) return false;
		
		cVector3f vPosDir = mvFlySearchPosition_Pos - mBaseObj.GetPosition();
		cVector3f vTargetPos = mvFlySearchPosition_Pos + cMath_Vector3Normalize(vPosDir) * 5.0f;
		
		DrawTestPoint(vTargetPos, 5.0f, cColor_Green * 2.0f, 0.2f);
		
		float fMinDist = -1;
		cVector3f vMinPos;
		for (int i = 0; i < mvFlyToNode_Nodes.size(); ++i)
		{
			iLuxEntity@ pNode = cLux_ID_Entity(mvFlyToNode_Nodes[i]);
			if (pNode is null) continue;
			
			DrawTestPoint(pNode.GetPosition(), 5.0f, cColor_Red * 2.0f, 0.2f);
			
			float fDist = cMath_Vector3Dist(pNode.GetPosition(), vTargetPos);
			if (pNode.GetPosition().y < vTargetPos.y + 5) continue;
			if (fDist >= 20.0f) continue;
			if (fMinDist < 0 || fDist < fMinDist)
			{
				fMinDist = fDist;
				vMinPos = pNode.GetPosition();
			}
		}
		
		if (fMinDist > 0)
		{
			mvFlySearchPosition_FlyPos = vMinPos;
			return true;
		}
		return false;
	}
	
	//------------------------------------------------------------
	
	//} END STATE: FLY SEARCH POSITION
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: STUCK RETREAT
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_StuckRetreat_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: StuckRetreat ------");
		
		if (mbStealthModeActive)
		{
			mpStateMachine.AddTimer("StealthDisappear", 0.0f);
		}
		else
		{
			SetStealthModeActive(true);
		}
	}
	
	//------------------------------------------------------------

	void State_StuckRetreat_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_StuckRetreat_Update(float afTimeStep) 
	{		
	}
	
	//------------------------------------------------------------
	
	bool State_StuckRetreat_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_DirectMoveToGoalReached)
		{
			SetStealthModeActive(false);
		}
		return true;
	}
	
	void State_StuckRetreat_TimerUp(uint64 alId) 
	{
		if (alId == H64("StealthDisappear"))
		{
			cVector3f vRetreatPos = mBaseObj.GetPosition() - mBaseObj.GetPlayerDir() * 10.0f;
			cAINode@ pNode = mpPathfinder.GetNodeOutOfSight(vRetreatPos, 0.0f, 10.0f, mBaseObj.GetPlayerPos(), 0, 0, true, true, false, null);
			if (pNode !is null)
			{
				MoveDirectlyTo(pNode.GetPosition());
			}
			else
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Couldn't find good retreat pos, retreating away from the player");
				MoveDirectlyTo(vRetreatPos);
			}
		}
		
		if (alId == H64("StealthAppear"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: STUCK RETREAT
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: BLOCKED
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	tID m_idBlocked_Prop = tID_Invalid;
	cVector3f mvBlocked_BlockDir;
	
	//------------------------------------------------------------
	
	void State_Blocked_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Blocked ------");
		
		mpPathfinder.Stop();
		mbBlocked = true;
		
		// are we blocked by a prop?
		float fCharRadius = mBaseObj.GetCharBody().GetSize().x * 0.5f;
		float fDist = 2.0f;
		cVector3f vFwd = mBaseObj.GetCharBody().GetForward();
		cVector3f vRayStart = mBaseObj.GetPosition();
		vRayStart += vFwd * fCharRadius;
		cLuxClosestEntityData data;
		if (cLux_GetClosestEntity(vRayStart, vFwd, fDist, 0, false, data) == false)
		{
			vRayStart.y -= mBaseObj.GetCharBody().GetSize().y * 0.5f - 0.2f;
			cLux_GetClosestEntity(vRayStart, vFwd, fDist, 0, false, data);
		}
		if (data.mpEntity !is null && data.mpEntity.GetEntityType() == eLuxEntityType_Prop)
		{
			m_idBlocked_Prop = data.mpEntity.GetID();
		}
		
		mvBlocked_BlockDir = vFwd;
		mvBlocked_BlockDir.Normalize();
		
		mpStateMachine.AddTimer("DecideAction", 0.5);
	}
	
	//------------------------------------------------------------

	void State_Blocked_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_Blocked_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_Blocked_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_PlayerSubmerged) return false;
		else if (alMessageId == eCustomEntityMessage_PlayerEmerged) return false;
		return true;
	}
	
	void State_Blocked_TimerUp(uint64 alId) 
	{
		if (alId == H64("DecideAction"))
		{
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mBaseObj.GetCharBody().GetFeetPosition() + mBaseObj.GetCharBody().GetForward() * 3, 0, 2, true, false, false, null);
			if (pNode is null) @pNode = mpPathfinder.GetNodeAtPos(mBaseObj.GetCharBody().GetFeetPosition() + mBaseObj.GetCharBody().GetForward() * 5, 0, 4, true, false, false, null);
			if (pNode is null) @pNode = mpPathfinder.GetNodeAtPos(mBaseObj.GetCharBody().GetFeetPosition() + mBaseObj.GetCharBody().GetForward() * 7, 0, 6, true, false, false, null);
			if (pNode is null)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Couldn't find node beyond blockage, back to idle");
				mpStateMachine.AddTimer("ToIdle", 1);
			}
			else
			{
				mvDash_Pos = pNode.GetPosition();
				mpStateMachine.ChangeState(eWraithState_Dash);
			}
		}
		
		else if (alId == H64("ToIdle"))
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	//} END STATE: BLOCKED
	
	///////////////////////////////////
	// STATE: MOVE TO
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvMoveTo_Pos;
	bool mbMoveTo_WraithPatrolMoved = false;
	
	//------------------------------------------------------------
	
	void State_MoveTo_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: MoveTo ------");
		
		mbMoveTo_WraithPatrolMoved = false;
		
		mpPathfinder.Stop();
		mpMover.SetSpeedState(eWraithSpeed_Walk);
		SetSpotlightMovement_SidewaysEight(1.0f, 0.5f, 0.3f);
		
		cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvMoveTo_Pos, 0.0f, 5.0f, true, true, false, null);
		if (pNode !is null)
		{
			mpPathfinder.MoveTo(pNode.GetPosition(), 1.0f, false);
		}
		else
		{
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
	}
	
	//------------------------------------------------------------

	void State_MoveTo_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_MoveTo_Update(float afTimeStep) 
	{		
	}
	
	//------------------------------------------------------------
	
	bool State_MoveTo_Message(int alMessageId)
	{
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			if (mbMoveTo_WraithPatrolMoved == false && mMode == eWraithMode_WraithPatrol)
			{
				cVector3f vClosest;
				if (Patrol_GetClosestNode(mBaseObj.GetPosition(), vClosest))
				{
					mbMoveTo_WraithPatrolMoved = true;
					mpPathfinder.MoveTo(vClosest, 1.0f, false);
					cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Move to closest patrol node");
					return true;
				}
			}
			
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		return false;
	}
	
	void State_MoveTo_TimerUp(uint64 alId) 
	{
	}
	
	//------------------------------------------------------------
	
	//} END STATE: MOVE TO
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: PATROL
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cWraithPatrol mPatrol_NextInstance = cWraithPatrol();
	cWraithPatrol mPatrol_CurrentInstance = cWraithPatrol();
	cWraithPatrol mPatrol_ModeInstance = cWraithPatrol();
	cWraithPatrol mPatrol_CommandInstance = cWraithPatrol();
	cWraithPatrol mPatrol_ModeWraithPatrolInstance = cWraithPatrol();
	bool mbPatrol_NewInstance = false;
	bool mbPatrol_LookAroundCheck = false;
	bool mbPatrol_FollowPosLeft = false;
	bool mbPatrol_SpotlightDirChangeDelay = false;
	int mlPatrol_InstanceCounter = 0;
	int mlPatrol_LookAroundRaycastIndex = 0;
	int mlPatrol_LookAroundSuccessfulRaycasts = 0;
	int mlPatrol_CurrentLoop = 0;
	float mfPatrol_PathAngle = 0;
	
	bool mbPatrol_Bursting = false;
	bool mbPatrol_BurstActive = false;
	cVector2f mvPatrol_BurstTimeRange(5, 10);
	float mfPatrol_BurstTimer = 0;
	
	bool mbPatrol_IdleBarksActive = true;
	float mfPatrol_IdleBarkTimer = 0;
	cVector2f mvPatrol_IdleBarkTimeRange(5, 10);
	int mlPatrol_LookStage = -1;
	float mfPatrol_LookTimer = 0;
	
	//------------------------------------------------------------
	
	void State_Patrol_Enter() 
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Patrol ------");
		
		if (mCommand == eWraithCommand_Patrol) SetSpotLightActive(mbCommandPatrol_SpotligtOn);
		else SetSpotLightActive(false);
		
		SetSpotlightMovement_Forward(true);
		SetSpotLightColor(mSpotlightColor_Idle);
//		Patrol_SetSpotlightOffset();

		SetIdleSwayActive(true);
		
		mbCrystal_PlayerDetected = false;
		mbPatrol_LookAroundCheck = false;
		mbPatrol_FollowPosLeft = false;
		mbPatrol_SpotlightDirChangeDelay = false;
		mbPatrol_Bursting = false;
		mfPatrol_PathAngle = 0;
		mlPatrol_LookStage = 0;
		
		mfPatrol_IdleBarkTimer = cMath_RandRectf(mvPatrol_IdleBarkTimeRange.x, mvPatrol_IdleBarkTimeRange.y);
				
		mbPatrol_NewInstance = mPatrol_NextInstance.mlId != mPatrol_CurrentInstance.mlId;
		if (mbPatrol_NewInstance)
		{
			Patrol_SetupTrack(mPatrol_NextInstance);
			mPatrol_CurrentInstance = mPatrol_NextInstance;
		}
		
		mpMover.SetSpeedState(mPatrol_CurrentInstance.mSpeed);
		
		if (mPatrol_CurrentInstance.mbDone) mpStateMachine.AddTimer("StopPatrol", 0);
		else mpStateMachine.AddTimer("StartPatrol", 0);
		
		if (mMode == eWraithMode_WraithPatrol)
		{
			mpStateMachine.AddTimer("UpdateWraithPatrol", 0.5f);
//			mpStateMachine.AddTimer("UpdatePatrolLook", 4);
		}		
	}
	
	//------------------------------------------------------------

	void State_Patrol_Leave() 
	{
		mpPathfinder.SetTrackPaused(true);
		
		SetIdleSwayActive(false);
//		StopPatrolLook();
	}
	
	//------------------------------------------------------------

	void State_Patrol_Update(float afTimeStep) 
	{
		if (mlPatrol_LookStage != 0)
		{
			mfPatrol_LookTimer += afTimeStep;
			float fVariation = cMath_Easing(eEasing_SineInOut, cMath_Sin(mfPatrol_LookTimer * 0.7), -1, 1);
			float fAngle = 0;
			if (mlPatrol_LookStage == -1) fAngle = -40 + -25 * fVariation;
			else if (mlPatrol_LookStage == 1) fAngle = +40 + 25 * fVariation;
			
			mvFaceEntity_PatrolTargetPos = mBaseObj.GetPosition() + cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(fAngle)), mBaseObj.GetCharBody().GetForward());
		}
	}
	
	//------------------------------------------------------------

	bool State_Patrol_Message(int alMessageId) 
	{ 
		if (alMessageId == eLuxEntityMessage_EndOfTrack)
		{
			if (mpPathfinder.GetTrackLoop() == false)
			{
				if (mlPatrol_CurrentLoop < mPatrol_CurrentInstance.mlLoopCount)
				{
					++mlPatrol_CurrentLoop;
					mpStateMachine.AddTimer("StartPatrol", 0.0f);
				}
				else
				{
					mPatrol_CurrentInstance.mbDone = true;
					mpStateMachine.AddTimer("StopPatrol", 1.0f);
				}
			}
//			if (mpPathfinder.GetTrackNodeNum() == 1) mpPathfinder.StopTrack();
		}		
	
		else if (mbPatrol_Bursting) return true;
		
		else if (alMessageId == eCustomEntityMessage_ApproachingClosedDoor)
		{
			mpStateMachine.ChangeState(eWraithState_OpenDoor);
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------

	void State_Patrol_TimerUp(uint64 alId) 
	{		
		if (alId == H64("StartPatrol"))
		{
			if (mpPathfinder.GetTrackNodeNum() > 0)
			{
				mpPathfinder.SetTrackPaused(false);
				if (mbPatrol_NewInstance)	
				{
					mpPathfinder.StartTrack(mPatrol_CurrentInstance.mlLoopCount < 0, 0.3, "", mPatrol_CurrentInstance.mbRandom);	
				}
				return;
			}
			mpStateMachine.AddTimer("StartPatrol", 0.5);
		}
		
		if (alId == H64("StopPatrol"))
		{
			if (mCommand == eWraithCommand_Patrol)
			{
				mCommand = eWraithCommand_None;
				ExecuteEntityCallback(mPatrol_CurrentInstance.msEndOfPatrolCallback);
				mPatrol_NextInstance = cWraithPatrol();
			}
			mpStateMachine.ChangeState(eWraithState_Idle);
		}
		
		if (alId == H64("UpdateWraithPatrol"))
		{
			mfPatrol_PathAngle = GetPathAngle();
			Patrol_UpdateIdleBarks();
			Patrol_UpdateBurst();
			Patrol_UpdateSpotlightMovement();
			Patrol_UpdateLookAround();
			Patrol_UpdateGoTowardsPlayer();
			Patrol_UpdatePulse();
			mpStateMachine.AddTimer("UpdateWraithPatrol", 0.5f);
		}
		
		if (alId == H64("StartBurst"))
		{
			mBaseObj.PlaySound("Burst", gsWraithSound_Burst, true, true);
			mpPathfinder.SetTrackPaused(false);
			mpMover.SetSpeedState(eWraithSpeed_Burst);
			ParticleSystem_CreateAtEntity(mBaseObj.GetName() + "burst", "dwf_wraith_stealth_appear_fast", mBaseObj.GetName(), true);
		}
		
		if (alId == H64("StopBurst"))
		{
			mpPathfinder.SetTrackPaused(true);
			mpPathfinder.Stop();
		}
		
		if (alId == H64("ExitBurst"))
		{
			mbPatrol_Bursting = false;
			mpPathfinder.SetTrackPaused(false);
			mpMover.SetSpeedState(eWraithSpeed_Slow);
//			SetSpotLightActive(true, false);
		}
		
		if (alId == H64("SelectLeftPos2"))
		{
			StopSpotlightMovement();
			SetSpotlightMovement_ForwardOffset(cMath_ToRad(0), cMath_ToRad(-18));
		}
		
		if (alId == H64("SelectLeftPos1"))
		{
			float fLeftRightMul = mbPatrol_FollowPosLeft ? 1 : -1;
			StopSpotlightMovement();
			SetSpotlightMovement_ForwardOffset(fLeftRightMul * cMath_ToRad(45), cMath_ToRad(-18));
			mbPatrol_FollowPosLeft = !mbPatrol_FollowPosLeft;
		}
		
		if (alId == H64("SelectLeftPos"))
		{
			float fLeftRightMul = mbPatrol_FollowPosLeft ? 1 : -1;
			cVector3f vDir = RotateDirHV(mBaseObj.GetCharBody().GetForward(), fLeftRightMul * cMath_ToRad(30), cMath_ToRad(15));
			vDir.Normalize();
			
			DrawTestRay(GetCrystalPos(), GetCrystalPos() + vDir * mfCrystal_SightRange * mfCrystal_SightRangeMul);
			
			float fDist = 0;
			cVector3f vNrm;
			iPhysicsBody@ pBody = cLux_GetClosestCharCollideBody(GetCrystalPos(), vDir, mfCrystal_SightRange * mfCrystal_SightRangeMul, fDist, vNrm);
			
			cVector3f vFollowPos;
			if (pBody !is null) vFollowPos = GetCrystalPos() + vDir * fDist;
			else vFollowPos = GetCrystalPos() + vDir * mfCrystal_SightRange * mfCrystal_SightRangeMul;
				
			StopSpotlightMovement();
			SetSpotlightMovement_FollowPosition(vFollowPos);
			
			mbPatrol_FollowPosLeft = !mbPatrol_FollowPosLeft;
		}
		
		if (alId == H64("UpdatePatrolLook"))
		{
			cLux_AddDebugMessage("UPDATE PATROL LOOK " + mlPatrol_LookStage);
			
			if (mlPatrol_LookStage == 0) mlPatrol_LookStage = cMath_RandRectf(0.0f, 1.0f) <= 0.5 ? -1 : 1;
			else mlPatrol_LookStage = 0;
			
			mfPatrol_LookTimer = 0;
			
			if (mlPatrol_LookStage == 0)
			{
				mpStateMachine.AddTimer("UpdatePatrolLook", cMath_RandRectf(10, 15));
				StopPatrolLook();
			}
			
			// look left
			else if (mlPatrol_LookStage == -1)
			{
				mpStateMachine.AddTimer("UpdatePatrolLook", cMath_RandRectf(4, 8));
				StartPatrolLook(0.6, 1, 2);
			}
			
			// look right
			else if (mlPatrol_LookStage == 1)
			{
				mpStateMachine.AddTimer("UpdatePatrolLook", cMath_RandRectf(4, 8));
				StartPatrolLook(0.6, 1, 2);
			}
			
			cLux_AddDebugMessage("UPDATE PATROL LOOK AFTER " + mlPatrol_LookStage);
		}
	}
	
	//------------------------------------------------------------
	
	void Patrol_UpdateWraithPatrol(float afTimeStep)
	{
		
	}
	
	//------------------------------------------------------------
	
	void Patrol_UpdateIdleBarks()
	{
		mfPatrol_IdleBarkTimer -= 0.5f;
		if (mfPatrol_IdleBarkTimer > 0) return;
		mfPatrol_IdleBarkTimer = cMath_RandRectf(mvPatrol_IdleBarkTimeRange.x, mvPatrol_IdleBarkTimeRange.y);
		
		mBaseObj.PlaySound("IdleScream", gsWraithSound_Idle_scream, true, true);
	}
	
	//------------------------------------------------------------
	
	void Patrol_UpdateBurst()
	{
		if (mbPatrol_BurstActive == false) return;
		
		mfPatrol_BurstTimer -= 0.5f;
		if (mfPatrol_BurstTimer > 0.0f) return;
		
		if (mBaseObj.GetDistanceToPos(mpPathfinder.GetGoalPos()) <= 6.0f) return;
		if (mfPatrol_PathAngle > 1.0f) return;
		
		mfPatrol_BurstTimer = cMath_RandRectf(mvPatrol_BurstTimeRange.x, mvPatrol_BurstTimeRange.y);
		
		mvDash_Pos = mpPathfinder.GetGoalPos();
		mpStateMachine.ChangeState(eWraithState_Dash);
		
		return;
		if (mbPatrol_Bursting)
		{
			// stop if too close to the player
			if (mpPathfinder.IsMoving() && mBaseObj.GetDistanceToPlayer() < 5)
			{
				mpStateMachine.AddTimer("StopBurst", 0);
				mpStateMachine.AddTimer("ExitBurst", 3);
			}
			return;
		}
		
		mfPatrol_BurstTimer -= 0.5f;
		if (mfPatrol_BurstTimer > 0.0f) return;
		
		if (mBaseObj.GetDistanceToPos(mpPathfinder.GetGoalPos()) <= 8.0f) return;
		if (mfPatrol_PathAngle > 1.0f) return;
		
		mpPathfinder.Stop();
		
		mbPatrol_Bursting = true;
//		SetSpotLightActive(false, false);
		mpPathfinder.SetTrackPaused(true);
		mpPathfinder.Stop();
		
		mpStateMachine.AddTimer("StartBurst", 1.5f);
		mpStateMachine.AddTimer("StopBurst", 3.0f);
		mpStateMachine.AddTimer("ExitBurst", 6.0f);
		
		mfPatrol_BurstTimer = cMath_RandRectf(mvPatrol_BurstTimeRange.x, mvPatrol_BurstTimeRange.y);
	}
	
	//------------------------------------------------------------
	
	void Patrol_UpdateSpotlightMovement()
	{
		return;
		
		if (mpStateMachine.TimerExists("SpotlightDirCooldown")) return;
		if (mpStateMachine.TimerExists("SpotlightDirChangeDelay")) return;
		if (mBaseObj.GetDistanceToPos(mpPathfinder.GetGoalPos()) <= 4.0f) return;
		if (mfPatrol_PathAngle > 1.0f) return;
		
		if (mbPatrol_SpotlightDirChangeDelay == false)
		{
			mbPatrol_SpotlightDirChangeDelay = true;
			mpStateMachine.AddTimer("SpotlightDirChangeDelay", 1.0f);
			return;
		}
		
		Patrol_SetSpotlightOffset();
		mpStateMachine.AddTimer("SpotlightDirCooldown", 10.0f);
		mbPatrol_SpotlightDirChangeDelay = false;
	}
	
	void Patrol_SetSpotlightOffset()
	{
		float fSideMul = mbPatrol_FollowPosLeft ? 1 : -1;
		SetSpotlightMovement_ForwardOffset(fSideMul * cMath_ToRad(45), cMath_ToRad(-18), true);
		mbPatrol_FollowPosLeft = !mbPatrol_FollowPosLeft;
	}
	
	//------------------------------------------------------------
	
	void Patrol_UpdateLookAround()
	{
		if (mbPatrol_Bursting) return;
		if (mbModeWraithPatrol_LookAround == false) return;
		mfModeWraithPatrol_LookAroundTimer -= 0.5f;
		if (mbPatrol_LookAroundCheck == false && mfModeWraithPatrol_LookAroundTimer <= 0.0f)
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Check if we're in a closed in environment");
			
			mbPatrol_LookAroundCheck = true;
			mlPatrol_LookAroundRaycastIndex = 0;
			mlPatrol_LookAroundSuccessfulRaycasts = 0;
			
			array<cVector3f> vRayDirs;
			vRayDirs.push_back(mBaseObj.GetCharBody().GetForward());
			vRayDirs.push_back(cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(90)), mBaseObj.GetCharBody().GetForward()));
			vRayDirs.push_back(cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(-90)), mBaseObj.GetCharBody().GetForward()));
			vRayDirs.push_back(cMath_MatrixMul(cMath_MatrixRotateY(cMath_ToRad(180)), mBaseObj.GetCharBody().GetForward()));
			
			for (int i = 0; i < vRayDirs.size(); ++i)
			{
				mBaseObj.GetClosestCharCollideBody("Patrol_LookAroundRaycast", mBaseObj.GetCharBody().GetPosition(), vRayDirs[i], 8.0f);
				DrawTestRay(mBaseObj.GetCharBody().GetPosition(), mBaseObj.GetCharBody().GetPosition() + vRayDirs[i] * 8.0f, 1.0f);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void Patrol_LookAroundRaycast(bool abSuccesful, float afDistance, const cVector3f&in avNormal, iPhysicsBody@ apBody, int alUserValue)
	{
		if (mpStateMachine.GetCurrentState() != eWraithState_Patrol) return;
		if (mbPatrol_Bursting) return;
		
		++mlPatrol_LookAroundRaycastIndex;
		if (abSuccesful) ++mlPatrol_LookAroundSuccessfulRaycasts;
		if (mlPatrol_LookAroundRaycastIndex == 4)
		{
			mbPatrol_LookAroundCheck = false;
			mfModeWraithPatrol_LookAroundTimer = 1.0f;
						
			if (mlPatrol_LookAroundSuccessfulRaycasts < 4)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Not in a closed in environment, look around");
				Patrol_LookAroundForPlayer();
			}
			else
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") In a closed in environment, won't look around");
			}
		}
	}
	
	//------------------------------------------------------------
	
	void Patrol_LookAroundForPlayer()
	{
		if (mpStateMachine.GetCurrentState() != eWraithState_Patrol) return;
		if (mbPatrol_Bursting) return;
		
		mfModeWraithPatrol_LookAroundTimer = cMath_RandRectf(mvModeWraithPatrol_LookAroundTimeRange.x, mvModeWraithPatrol_LookAroundTimeRange.y);
		mpStateMachine.ChangeState(eWraithState_SearchAround);
	}
	
	//------------------------------------------------------------
	
	void Patrol_UpdateGoTowardsPlayer()
	{
		if (mbModeWraithPatrol_GoTowardsPlayer == false) return;
		if (mbPatrol_Bursting) return;
		
		float fGoTowardsTimeReduction = 0.5f;
		if (mbOnScreen) fGoTowardsTimeReduction = 0.25f;
		mfModeWraithPatrol_GoTowardsPlayerTimer -= fGoTowardsTimeReduction;
						
		if (mfModeWraithPatrol_GoTowardsPlayerTimer <= 0.0f && mBaseObj.GetDistanceToPlayer() > 8.0f)
		{
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mBaseObj.GetPlayerPos(), 0.0f, 5.0f, false, true, false, null);
			if (pNode !is null)
			{
				mfModeWraithPatrol_GoTowardsPlayerTimer = cMath_RandRectf(mvModeWraithPatrol_GoTowardsPlayerTimer.x, mvModeWraithPatrol_GoTowardsPlayerTimer.y);
				
				mvMoveTo_Pos = pNode.GetPosition();
				mpStateMachine.ChangeState(eWraithState_MoveTo);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void Patrol_UpdatePulse()
	{
		if (mbModeWraithPatrol_PulseState == false) return;
		if (mbModeWraithPatrol_Pulse == false) return;
		if (mbPatrol_Bursting) return;
		
		mfModeWraithPatrol_PulseTimer -= 0.5f;
		if (mfModeWraithPatrol_PulseTimer <= 0.0f)
		{
			mfModeWraithPatrol_PulseTimer = cMath_RandRectf(mvModeWraithPatrol_PulseTimer.x, mvModeWraithPatrol_PulseTimer.y);
			mpStateMachine.ChangeState(eWraithState_Pulse);
		}
	}
	
	//------------------------------------------------------------
	
	void Patrol_SetupTrack(cWraithPatrol@ apPatrol)
	{
		mpPathfinder.ClearTrackNodes();
		for (int i = 0; i < apPatrol.mvNodes.size(); ++i)
		{
			cWraithPatrolNode pNode = apPatrol.mvNodes[i];
			mpPathfinder.AddTrackNode(pNode.msName, pNode.mfMinWaitTime, pNode.mfMaxWaitTime, pNode.msAnimName, pNode.mbLoopAnim);
		}
	}
	
	//------------------------------------------------------------
	
	bool Patrol_GetClosestNode(const cVector3f &in avPos, cVector3f &out avNodePos)
	{
		float fMinDist = -1;
		cVector3f vPos;
		for (int i = 0; i < mPatrol_CurrentInstance.mvNodes.size(); ++i)
		{
			cAINode@ pNode = mpPathfinder.GetNodeContainer().GetNodeFromName(mPatrol_CurrentInstance.mvNodes[i].msName);
			if (mBaseObj.GetDistanceToPos(pNode.GetPosition()) < 5.0f) continue;
			float fDist = cMath_Vector3DistSqr(mBaseObj.GetPlayerPos(), pNode.GetPosition());
			if (fMinDist < 0.0f || fDist < fMinDist)
			{
				fMinDist = fDist;
				vPos = pNode.GetPosition();
			}
		}
		
		if (fMinDist > 0)
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Go to closest node to player");
			avNodePos = vPos;
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	//} END STATE: PATROL
	
