	//------------------------------------------------------------
	
	cVector3f GetLeminscateMovement(float afT, const cVector3f &in avDir, float afHMoveMul, float afVMoveMul)
	{
		float fHMove = afHMoveMul * cMath_Cos((2.0f * afT) + cMath_PiDiv2);
		float fVMove = afVMoveMul * cMath_Sin(4.0f * afT) / 4.0f;

		cVector3f vForward = avDir;
		vForward.Normalize();
		
		cVector3f vRight = cMath_Vector3Cross(cVector3f_Up, vForward);
		vRight.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
		vUp.Normalize();
		
		cVector3f vFinalDir = vForward;
		
		cQuaternion qHRot;
		qHRot.FromAngleAxis(fHMove * cMath_ToRad(90), vUp);
		
		cQuaternion qVRot;
		qVRot.FromAngleAxis(fVMove * cMath_ToRad(90), vRight);
		
		vFinalDir = cMath_MatrixMul(cMath_MatrixQuaternion(qHRot * qVRot), vFinalDir);
		
		return vFinalDir;
	}
	
	//------------------------------------------------------------
	
	cVector3f RotateDirHV(const cVector3f &in avDir, float afH, float afV)
	{
		cVector3f vForward = avDir;
		vForward.Normalize();
		
		cVector3f vRight = cMath_Vector3Cross(cVector3f_Up, vForward);
		vRight.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
		vUp.Normalize();
		
		cVector3f vFinalDir = vForward;
		
		cQuaternion qHRot;
		qHRot.FromAngleAxis(afH, vUp);
		
		cQuaternion qVRot;
		qVRot.FromAngleAxis(afV, vRight);
		
		vFinalDir = cMath_MatrixMul(cMath_MatrixQuaternion(qHRot * qVRot), vFinalDir);
		
		return vFinalDir;
	}
	
	//------------------------------------------------------------
	
	cVector3f mvSpotlight_ScanDir;
	float mfSpotlight_ScanSpeed = 1.0f;
	float mfSpotlight_ScanHMul = 0.0f;
	float mfSpotlight_ScanVMul = 0.0f;
	
	void SetSpotlightMovement_Scan(const cVector3f &in avDir, float afSpeed = 1.0f, float afHMul = 1.0f, float afVMul = 1.0f, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eWraithLightMovement_None) return;
		mvSpotlight_ScanDir = avDir;
		mfSpotlight_ScanSpeed = afSpeed;
		mfSpotlight_ScanHMul = afHMul;
		mfSpotlight_ScanVMul = afVMul;
		if (mSpotlightMovement != eWraithLightMovement_Scan) mfSpotlight_MovementTimer = 0.0f;
		mSpotlightMovement = eWraithLightMovement_Scan;
	}
	
	//------------------------------------------------------------
	
	cVector3f GetScanMovement(float afT, const cVector3f &in avDir, float afHMoveMul, float afVMoveMul)
	{
		float fDistMul = 1.0f / (avDir.Length() * 0.2f);
		if (fDistMul < 1.0f) fDistMul = 1.0f;
		float fHMove = fDistMul * 0.6f * cMath_Cos(2.0f * afT);
		float fVMove = fDistMul * 0.15f * cMath_Sin(0.7f * afT);

		cVector3f vForward = avDir;
		vForward.Normalize();
		
		cVector3f vRight = cMath_Vector3Cross(cVector3f_Up, vForward);
		vRight.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
		vUp.Normalize();
		
		cVector3f vFinalDir = vForward;
		
		cQuaternion qHRot;
		qHRot.FromAngleAxis(fHMove * cMath_ToRad(90), vUp);
		
		cQuaternion qVRot;
		qVRot.FromAngleAxis(fVMove * cMath_ToRad(90), vRight);
		
		vFinalDir = cMath_MatrixMul(cMath_MatrixQuaternion(qHRot * qVRot), vFinalDir);
		
		return vFinalDir;
	}
	
	//------------------------------------------------------------
	
	float mfSpotlight_LeftRightAngle = 45.0f;
	float mfSpotlight_LeftRightSpeed = 1.0f;
	float mfSpotlight_LeftRightHMul = 0.0f;
	
	void SetSpotlightMovement_LeftToRight(float afAngle = 45.0f, float afSpeed = 1.0f, float afHMul = 1.0f, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eWraithLightMovement_None) return;
		mfSpotlight_LeftRightAngle = afAngle;
		mfSpotlight_LeftRightSpeed = afSpeed;
		mfSpotlight_LeftRightHMul = afHMul;
		if (mSpotlightMovement != eWraithLightMovement_LeftToRight) mfSpotlight_MovementTimer = 0.0f;
		mSpotlightMovement = eWraithLightMovement_LeftToRight;
	}
	
	//------------------------------------------------------------
	
	cVector3f GetLeftAndRightMovement(float afT, const cVector3f &in avDir, float afHMoveMul)
	{
		float fHMove = afHMoveMul * cMath_Cos(afT);

		cVector3f vForward = avDir;
		vForward.Normalize();
		
		cVector3f vRight = cMath_Vector3Cross(cVector3f_Up, vForward);
		vRight.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
		vUp.Normalize();
		
		cVector3f vFinalDir = vForward;
		
		cQuaternion qHRot;
		qHRot.FromAngleAxis(fHMove * cMath_ToRad(90), vUp);
		
		vFinalDir = cMath_MatrixMul(cMath_MatrixQuaternion(qHRot), vFinalDir);
		
		return vFinalDir;
	}
	
