	bool State_Custom_Message(int alMessageId)
	{	
		if (alMessageId == eCustomEntityMessage_PlayerSubmerged) return false;
		else if (alMessageId == eCustomEntityMessage_PlayerEmerged) return false;
		else if (alMessageId == eLuxEntityMessage_PlayerDetected) return !mbCrystal_Sight;
		else if (alMessageId == eLuxEntityMessage_PlayerUndetected) return !mbCrystal_Sight;
		return true;
	}
	
