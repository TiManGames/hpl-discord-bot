	void SetupGroundWallAvoidance()
	{
		mpMover.SetupWallAvoidance(2.0f, 2.0f, 4);
	}
	
	void SetupFlyWallAvoidance()
	{
		mpMover.SetupWallAvoidance(4.0f, 10.0f, 4);
	}
	
	//------------------------------------------------------------
	
	float GetPathAngle()
	{
		cVector3f vPrevPos;
		float fPathAngle = 0;
		float fDist = 0;
		for (int i = mpPathfinder.GetPathNodeCount() - 1; i >= -1; --i)
		{
			cVector3f vPos;
			if (i > -1) vPos = mpPathfinder.GetPathNode(i).GetPosition();
			else vPos = mpPathfinder.GetGoalPos();
			if (i == mpPathfinder.GetPathNodeCount() - 1) vPrevPos = mBaseObj.GetCharBody().GetFeetPosition();
			
			cVector3f vDir = cMath_Vector3Normalize(vPos - vPrevPos);
			fPathAngle += cMath_Vector3Angle(vDir, mBaseObj.GetCharBody().GetForward());
			fDist += cMath_Vector3Dist(vPos, vPrevPos);
			if (fDist >= 8.0f) break;
			
			vPrevPos = vPos;
		}
		return fPathAngle;
	}
	
	//------------------------------------------------------------
	
	void SetMoveAnimState(eWraithMoveAnimState aState, bool abPlayAnim = true)
	{
		if (aState == mMoveAnimState) return;
		mMoveAnimState = aState;
		
		tString sIdleAnim = "";
		tString sWalkAnim = "";
		if (mMoveAnimState == eWraithMoveAnimState_Default)
		{
			sIdleAnim = "idle";
			sWalkAnim = "walk";
		}
		else if (mMoveAnimState == eWraithMoveAnimState_Search)
		{
			sIdleAnim = "search_idle";
			sWalkAnim = "search_walk";
		}
		
		mpMover.SetIdleAnimName(sIdleAnim);
		mpMover.SetWalkAnimName(sWalkAnim);
				
		if (abPlayAnim)
		{
			if (mpPathfinder.IsMoving()) mpMover.PlayAnimation(sWalkAnim, 0.5);
			else mpMover.PlayAnimation(sIdleAnim, 0.5);
		}
	}
	
