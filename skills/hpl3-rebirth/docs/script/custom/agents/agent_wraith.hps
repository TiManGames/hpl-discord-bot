	/////////////////////////////////////////
	// OVERRIDE FACTOR
	//{//////////////////////////////////////
	
	float mfOverrideFactorTimer = 0.0f;
	void UpdateOverrideFactor(float afTimeStep)
	{
		mfOverrideFactorTimer -= afTimeStep;
		if (mfOverrideFactorTimer > 0) return;
		mfOverrideFactorTimer = cMath_RandRectf(0.1f, 0.2f);
			
		float fFactor = 0;
		fFactor += mbTerror_Apply ? 1.0f : 0.0f;
		fFactor += mbBeamSeen_ApplyFear ? 0.3f : 0.0f;
		FearThreatAgent_SetOverrideFactor(mBaseObj.GetName(), fFactor);
		if (fFactor > 0) FearThreatAgent_SetComponentFearActive(mBaseObj.GetName(), true);
	}
	
