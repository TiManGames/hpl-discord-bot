	bool mbTerror_Added = false;
	bool mbTerror_Seen = false;
	bool mbTerror_Hunting = false;
	bool mbTerror_Apply = false;
	
	void UpdateTerror(float afTimeStep)
	{
		mbTerror_Apply = mbTerror_Seen || mbTerror_Hunting;
		
		if (mbTerror_Apply && mbTerror_Added == false)
		{
			mbTerror_Added = true;
//			Terror_AddEnemy(mBaseObj.GetID());
		}
		else if (mbTerror_Apply == false && mbTerror_Added)
		{
			mbTerror_Added = false;
//			Terror_RemoveEnemy(mBaseObj.GetID());
		}
	}
	
	void StopTerror()
	{
		Terror_RemoveEnemy(mBaseObj.GetID());
	}
	
