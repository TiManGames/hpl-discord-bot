	/////////////////////////////////////////
	// MESH MOVEMENT
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfMeshTime = 0;
	float fMax = 0;
	float mfMeshMovementAmount = 0;
	float mfMeshMovementAmountGoal = 1;
	
	//------------------------------------------------------------
	
	void UpdateMeshMovement(float afTimeStep)
	{
		if (mbVerletEnabled == false) return;
		if (mbVerletModuleInitialized == false) return;
		
		bool bUpdate = mfMeshMovementAmount > 0;
		mfMeshMovementAmount = cMath_IncreaseTo(mfMeshMovementAmount, 1.0f * afTimeStep, mfMeshMovementAmountGoal);

		/////////////
		// Mesh offset
		mBaseObj.SetAlignEntityWithGroundRay(false);
		if(bUpdate || mfMeshMovementAmount > 0)
		{
			cLux_ProfileStart("MeshOffset");
		
			cMatrixf mtxOffset = mBaseObj.GetBaseEntityOffset();
			
			float fSpeed = 1.0f;
			float fMaxMoveX = 1.3f;
			float fMaxMoveY = 0.8f;
			float fMaxMoveZ = 1.3f;
			float fPosMul = 2;
			float fTimeX = cEngine_GetGameTime() * fSpeed * 1.3365143f;
			float fTimeY = cEngine_GetGameTime() * fSpeed * 1.61688f;
			float fTimeZ = cEngine_GetGameTime() * fSpeed * 1.9564f;
						
			cVector3f vPosOffset = mtxOffset.GetTranslation();
			
			cVector3f vPosAdd = cVector3f_Zero;
			vPosAdd += cVector3f_Right * fMaxMoveX * cGenerate_FractalNoise1D(fTimeX, mMeshMovementParams);
			vPosAdd += cVector3f_Up * fMaxMoveY * cGenerate_FractalNoise1D(fTimeY, mMeshMovementParams);
			vPosAdd += cVector3f_Forward * fMaxMoveZ * cGenerate_FractalNoise1D(fTimeZ, mMeshMovementParams);
			
			mtxOffset.SetTranslation(vPosOffset + vPosAdd * mfMeshMovementAmount);
			
			mBaseObj.GetCharBody().SetEntityOffset(mtxOffset);
			cLux_ProfileEnd("MeshOffset");
		}

		mpVerletAnimation.SetMovementOffsetMul(0.05f * mfMeshMovementAmount, 1.0f * mfMeshMovementAmount);
	}
	
	//------------------------------------------------------------
	
	void InitVerletModule()
	{
		if (mbVerletEnabled == false) return;
		if (mbVerletModuleInitialized) return;
		
		float fBaseMoveToMul = 1.75f;
		SetupWraithTree("j_L_BackSide_1", "", 0.6f, fBaseMoveToMul);
		SetupWraithTree("j_L_Back_1", "", 0.6f, fBaseMoveToMul);
		SetupWraithTree("j_L_FrontSide_2", "", 0.6f, 5.0f, 3.0f, 1.0f);
		SetupWraithTree("j_L_Front_2", "", 0.6f, 5.0f, 3.0f, 1.0f);
		SetupWraithTree("j_L_Side_1", "", 0.6f, fBaseMoveToMul);
		SetupWraithTree("j_R_BackSide_1", "", 0.6f, fBaseMoveToMul);
		SetupWraithTree("j_R_FrontSide_2", "", 0.6f, 5.0f, 3.0f, 1.0f);
		SetupWraithTree("j_R_Front_2", "", 0.6f, 5.0f, 3.0f, 1.0f);
		SetupWraithTree("j_R_Side_1", "", 0.6f, fBaseMoveToMul);
		
		SetupWraithTree("j_L_Arm_1", "j_L_Arm_6", 0.2f, 8.0f, 1.5f, 4.5f);
		SetupWraithTree("j_Neck", "j_Head", 0.2f, 2.0f, 1.0f, 3.0f);

		mMeshMovementParams.mlNumOfOctaves = 1;
		mMeshMovementParams.mfStartFrequency = 0.12;
		mMeshMovementParams.mfStartAmplitude = 1.0;
		mMeshMovementParams.mfOctaveMul = 1.75;
		
		mbVerletModuleInitialized = true;
	}
	
