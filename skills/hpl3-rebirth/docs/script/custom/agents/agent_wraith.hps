	/////////////////////////////////////////
	// PLAYER PATH
	//{//////////////////////////////////////

	//------------------------------------------------------------
	
	int GetPlayerPathIndex(const cVector3f &in avPos)
	{
		int lMinIndex = -1;
		float fMinDist = -1;
		for (int i = 0; i < mvPlayerPath.size(); ++i)
		{
			float fDist = cMath_Vector3Dist(avPos, cLux_ID_Entity(mvPlayerPath[i]).GetPosition());
			if (fMinDist < 0 || fDist <= fMinDist)
			{
				lMinIndex = i;
				fMinDist = fDist;
			}
		}
		
		return lMinIndex;
	}
	
