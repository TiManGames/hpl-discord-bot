	/////////////////////////////////////////
	// PROXIMITY ATTACK
	//{//////////////////////////////////////

	//------------------------------------------------------------
	
	float mfProximityAttackTimer = 0.0f;
	bool mbProximityAttackActive = true;
	
	//------------------------------------------------------------
	
	void UpdateProximityAttack(float afTimeStep)
	{
		if (GetSensesActive() == false) return;
		
		mfProximityAttackTimer -= afTimeStep;
		if (mfProximityAttackTimer > 0.0f) return;
		mfProximityAttackTimer = cMath_RandRectf(0.1f, 0.2f);
		
		if (mbProximityAttackActive == false) return;
		if (mbStealthModeActive) return;
		if (mpProximitySensor.GetPlayerInsideState(eWraithProximity_ProximityAttack) == false) return;
		if (mbOnScreen == false) return;
		
		mpStateMachine.ChangeState(eWraithState_Struggle);
		
//		mvSearch_Pos = mBaseObj.GetPlayerPos();
//		mpStateMachine.ChangeState(eWraithState_Search);
	}
	
	//------------------------------------------------------------
	
	//} END PROXIMITY ATTACK
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// FACE ENTITY
	//{//////////////////////////////////////

	//------------------------------------------------------------
	
	bool mbFaceEntity_FadeIn = true;
	bool mbFaceEntity_FadeOut = false;
	float mfFaceEntity_FadeInSpeed = 6;
	float mfFaceEntity_FadeOutSpeed = 6;
	float mfFaceEntity_TargetAngle = 0;
	float mfFaceEntity_CurrentAngle = 0;
	float mfFaceEntity_Speed = 0;
	float mfFaceEntity_AfterFadeSpeed = 0;
	
	float mfFaceEntity_FadeInTime = 0;
	float mfFaceEntity_FadeOutTime = 0;
	float mfFaceEntity_FadeTimer = 0;
	
	cMatrixf mtxFaceEntity_Target = cMatrixf_Identity;
	cMatrixf mtxFaceEntity_Current = cMatrixf_Identity;
	tID m_idFaceEntity_Entity = tID_Invalid;
	cVector3f mvFaceEntity_TargetPos = 0;
	bool mbFaceEntity_Active = false;
	bool mbFaceEntity_PatrolLook = false;
	cVector3f mvFaceEntity_PatrolTargetPos = 0;
	
	//------------------------------------------------------------
	
	void UpdateFaceEntity(float afTimeStep)
	{
		if (mbFaceEntity_Active == false && mbFaceEntity_PatrolLook == false) return;
		
		cVector3f vLookAtPos = 0;
		iLuxEntity@ pEntity = cLux_ID_Entity(m_idFaceEntity_Entity);
		if (mbFaceEntity_Active)
		{
			if (pEntity is null) vLookAtPos = mvFaceEntity_TargetPos;
			else vLookAtPos = pEntity.GetPosition();
		}
		else if (mbFaceEntity_PatrolLook)
		{
			vLookAtPos = mvFaceEntity_PatrolTargetPos;
		}
		
		cVector3f vLookAtFwd = cMath_Vector3Normalize(vLookAtPos - mBaseObj.GetCharBody().GetPosition());
		cVector3f vLookAtUp = cVector3f_Up;
		cVector3f vLookAtRight = cMath_Vector3Normalize(cMath_Vector3Cross(vLookAtUp, vLookAtFwd));
		cMatrixf mtxLookAt = cMath_MatrixUnitVectors(vLookAtRight, vLookAtUp, vLookAtFwd, cVector3f_Zero);
		
		cMatrixf mtxInvCharRotation = cMath_MatrixRotateY(-mBaseObj.GetCharBody().GetYaw() + cMath_Pi);
				
		cMatrixf mtxOffset = cMatrixf_Identity;
		if (mbFaceEntity_FadeOut == false) mtxOffset.SetRotation(cMath_MatrixMul(mtxLookAt, mtxInvCharRotation));
		mtxFaceEntity_Target = mtxOffset;
		
		mtxFaceEntity_Current = cMath_MatrixSlerp(mfFaceEntity_Speed * afTimeStep, mtxFaceEntity_Current, mtxFaceEntity_Target, true);
		mBaseObj.GetCharBody().SetEntityPostOffset(mtxFaceEntity_Current);
		if (mbFaceEntity_FadeOut && cMath_MatrixEulerAngleDistance(mtxFaceEntity_Current, cMatrixf_Identity).Length() <= 0.015)
		{
			mbFaceEntity_FadeOut = false;
			
			m_idFaceEntity_Entity = tID_Invalid;
			mBaseObj.GetCharBody().SetEntityPostOffset(cMatrixf_Identity);
			mtxFaceEntity_Current = mtxFaceEntity_Target = cMatrixf_Identity;
			
			mbFaceEntity_Active = false;
			mbFaceEntity_PatrolLook = false;
		}
		
		//		cVector3f vLookAtDir = vLookAtPos - mBaseObj.GetCharBody().GetPosition();
		//		vLookAtDir.y = 0;
		//		vLookAtDir.Normalize();
		//		
		//		cVector3f vCharFwd = mBaseObj.GetCharBody().GetForward();
		//		vCharFwd.y = 0;
		//		vCharFwd.Normalize();
		//		
		//		float fLookAtAngle = cMath_GetAngleFromPoints3D(0, vLookAtDir).y;
		//		float fCharAngle = cMath_GetAngleFromPoints3D(0, vCharFwd).y;
		//		float fDist = fLookAtAngle - fCharAngle;
		//				
		//		mfFaceEntity_TargetAngle = fDist;
		//		mfFaceEntity_CurrentAngle = cMath_InterpolateLinear(mfFaceEntity_CurrentAngle, ClosestAngleToAngle(mfFaceEntity_TargetAngle, mfFaceEntity_CurrentAngle), afTimeStep);
		//		
		//		cMatrixf mtxOffset = cMatrixf_Identity;
		//		mtxOffset = cMath_MatrixRotateY(mfFaceEntity_CurrentAngle);
		//		mBaseObj.GetCharBody().SetEntityPostOffset(mtxOffset);
	}
	
	//------------------------------------------------------------
	
	void StartPatrolLook(float afFadeInSpeed = 0.6, float afFadeInTime = 1, float afFacingSpeed = 2)
	{
		if (mbFaceEntity_Active || mbFaceEntity_PatrolLook) return;
			
		mbFaceEntity_PatrolLook = true;
		
		mbFaceEntity_FadeIn = true;
		mbFaceEntity_FadeOut = false;
		mfFaceEntity_Speed = afFadeInSpeed;
		mfFaceEntity_AfterFadeSpeed = afFacingSpeed;
		
		// stop fade in
		mBaseObj.Timer_Remove("Timer_StopFaceEntityFading");
		mBaseObj.Timer_Add("Timer_StopFaceEntityFading", afFadeInTime, "OnTimer_StopFaceEntityFading");
	}
	
	void StopPatrolLook(float afFadeOutSpeed = 0.6)
	{
		if (mbFaceEntity_Active) return;
		
		mbFaceEntity_FadeOut = true;
		mbFaceEntity_FadeIn = false;
		mfFaceEntity_Speed = afFadeOutSpeed;
		
		mBaseObj.Timer_Remove("Timer_StopFaceEntityFading");
	}
	
	void StartFacingEntity(tID a_idEntity, float afFadeInSpeed = 0.6, float afFadeInTime = 1, float afFacingSpeed = 2)
	{
		mbFaceEntity_Active = true;
		
		m_idFaceEntity_Entity = a_idEntity;
		mbFaceEntity_FadeIn = true;
		mbFaceEntity_FadeOut = false;
		mfFaceEntity_Speed = afFadeInSpeed;
		mfFaceEntity_AfterFadeSpeed = afFacingSpeed;
		
		// stop fade in
		mBaseObj.Timer_Remove("Timer_StopFaceEntityFading");
		mBaseObj.Timer_Add("Timer_StopFaceEntityFading", afFadeInTime, "OnTimer_StopFaceEntityFading");
	}
	
	//------------------------------------------------------------
	
	void StopFacingEntity(float afFadeOutSpeed = 0.6)
	{
		mbFaceEntity_FadeOut = true;
		mbFaceEntity_FadeIn = false;
		mfFaceEntity_Speed = afFadeOutSpeed;
		
		mBaseObj.Timer_Remove("Timer_StopFaceEntityFading");
	}
	
	//------------------------------------------------------------
	
	void StartFacingPosition(const cVector3f &in avPos, float afFadeInSpeed = 0.6, float afFadeInTime = 1, float afFacingSpeed = 2)
	{
		mbFaceEntity_Active = true;
		
		mvFaceEntity_TargetPos = avPos;
		m_idFaceEntity_Entity = tID_Invalid;
		mbFaceEntity_FadeIn = true;
		mbFaceEntity_FadeOut = false;
		mfFaceEntity_Speed = afFadeInSpeed;
		mfFaceEntity_AfterFadeSpeed = afFacingSpeed;
		
		// stop fade in
		mBaseObj.Timer_Remove("Timer_StopFaceEntityFading");
		mBaseObj.Timer_Add("Timer_StopFaceEntityFading", afFadeInTime, "OnTimer_StopFaceEntityFading");
	}
	
	//------------------------------------------------------------
	
	void OnTimer_StopFaceEntityFading(uint64 alID)
	{
		mbFaceEntity_FadeIn = false;
		mfFaceEntity_Speed = mfFaceEntity_AfterFadeSpeed;
	}
	
	//------------------------------------------------------------
	
	//} END FACE ENTITY
	
	/////////////////////////////////////////
	// SWAY
	//{//////////////////////////////////////

	//------------------------------------------------------------
	
	float mfIdleSwayTimer = 0;
	bool mbIdleSwayOn = false;
	bool mbIdleSwayActive = false;
	int mlSwayStage = 0;
	
	//------------------------------------------------------------
	
	void SetIdleSwayActive(bool abX)
	{
		if (abX == mbIdleSwayActive) return;
		
		mbIdleSwayActive = abX;
		mfIdleSwayTimer = 0;
		mbIdleSwayOn = false;
		
		if (mbIdleSwayActive) SetSway(1);
		else SetSway(0);
	}
	
	//------------------------------------------------------------
	
	void UpdateIdleSway(float afTimeStep)
	{
		if (mbIdleSwayActive == false) return;
		
		mfIdleSwayTimer -= afTimeStep;
		if (mfIdleSwayTimer > 0) return;
		
		mbIdleSwayOn = !mbIdleSwayOn;
		if (mbIdleSwayOn)
		{
			SetSway(mlSwayStage + 1);
			mfIdleSwayTimer = cMath_RandRectf(2, 4);
		}
		else
		{
			SetSway(mlSwayStage);
			mfIdleSwayTimer = cMath_RandRectf(8, 12);
		}
	}
	
	//------------------------------------------------------------
	
	void SetSway(int alStage)
	{
		return;
		tString sBodyMat = "";
		tString sLeavesMat = "";
		if (alStage == 0)
		{
			sBodyMat = "wraith_body";
			sLeavesMat = "wraith_leaves";
		}
		else if (alStage == 1)
		{
			sBodyMat = "wraith_body_sway_1";
			sLeavesMat = "wraith_leaves_sway_1";
		}
		else if (alStage == 2)
		{
			sBodyMat = "wraith_body_sway_2";
			sLeavesMat = "wraith_leaves_sway_2";
		}
		else if (alStage == 3)
		{
			sBodyMat = "wraith_body_sway_3";
			sLeavesMat = "wraith_leaves_sway_3";
		}
		else
		{
			return;
		}
		
		cMaterial@ pMat = null;
		cSubMeshEntity@ pSubMesh = null;
		
		@pMat = cResources_CreateMaterial(sBodyMat);
		@pSubMesh = mBaseObj.GetMeshEntity().GetSubMeshEntityName("wraith_body");
		if (pMat !is null && pSubMesh !is null) pSubMesh.SetCustomMaterial(pMat, false);
		
		@pMat = cResources_CreateMaterial(sLeavesMat);
		@pSubMesh = mBaseObj.GetMeshEntity().GetSubMeshEntityName("wraith_leaves");
		if (pMat !is null && pSubMesh !is null) pSubMesh.SetCustomMaterial(pMat, false);
		
		@pMat = cResources_CreateMaterial(sLeavesMat);
		@pSubMesh = mBaseObj.GetMeshEntity().GetSubMeshEntityName("wraith_leaves_b");
		if (pMat !is null && pSubMesh !is null) pSubMesh.SetCustomMaterial(pMat, false);
	}
	
	//------------------------------------------------------------
	
	//} END SWAY
	
	/////////////////////////////////////////
	// DASH ENTITIES
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] array<tID> mvDashEntities;
	[nosave] array<bool> mvDashEntityUsed;
	[nosave] array<tID> mvDashEntityStack;
	
	//------------------------------------------------------------
	
	void CreateDashEntities()
	{
		for (int i = 0; i < 3; ++i)
		{
			mBaseObj.GetMap().CreateEntity(mBaseObj.GetName() + "_Dash_" + (i + 1), "wraith_rigid.ent", cMatrixf_Identity, cVector3f_One);
			
			iLuxEntity@ pEnt = mBaseObj.GetMap().GetLatestEntity();
			pEnt.PlayAnimation("walk_fwd_head_raised", 0, false, false, "");
			pEnt.GetMeshEntity().GetAnimationStateFromName("walk_fwd_head_raised").SetPaused(true);
			pEnt.SetActive(false);
			pEnt.SetScriptableIsSaved(false);
			
			mvDashEntities.push_back(pEnt.GetID());
			mvDashEntityUsed.push_back(false);
		}
		
		cLightPoint@ pDashLight = mBaseObj.GetMap().GetWorld().CreateLightPoint(mBaseObj.GetName()+"_TeleportLight", "", false);
		m_idDash_Light = pDashLight.GetID();
		pDashLight.SetBrightness(0);
		pDashLight.SetRadius(4.5);
		pDashLight.SetFalloffPow(1.5);
	}
	
	//------------------------------------------------------------
	
	tID CreateDashEntity()
	{
		int lIndex = -1;
		for (int i = 0; i < mvDashEntities.size(); ++i)
		{
			if (mvDashEntityUsed[i]) continue;
			lIndex = i;
		}
		
		if (lIndex < 0) return tID_Invalid;
		mvDashEntityUsed[lIndex] = true;
		return mvDashEntities[lIndex];
		
		
//		tID a_idReturnEnt = tID_Invalid;
//		for (int i = 0; i < mvDashEntities.size(); ++i)
//		{
//			tID a_idEnt = mvDashEntities[i];
//			if (mvDashEntityStack.find(a_idEnt) >= 0) continue;
//			a_idReturnEnt = a_idEnt;
//			break;
//		}
//		
//		if (a_idReturnEnt == tID_Invalid) return tID_Invalid;		
//		mvDashEntityStack.push_back(a_idReturnEnt);
//		return a_idReturnEnt;
	}
	
	//------------------------------------------------------------
	
	void RemoveDashEntity(tID a_idEnt)
	{
		for (int i = 0; i < mvDashEntities.size(); ++i)
		{
			if (a_idEnt == mvDashEntities[i])
			{
				mvDashEntityUsed[i] = false;
				return;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void FreeDashEntity(tID a_idEnt)
	{
		for (int i = 0; i < mvDashEntities.size(); ++i)
		{
			if (a_idEnt != mvDashEntities[i]) continue;
			mvDashEntityUsed[i] = false;
		}
	}
	
	//------------------------------------------------------------
	
	//} DASH ENTITIES
	
	/////////////////////////////////////////
	// SHADOW CASTER DISTANCE
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfShadowCasterTimer = 0;
	
	//------------------------------------------------------------
	
	void UpdateShadowCaster(float afTimeStep)
	{
		mfShadowCasterTimer -= afTimeStep;
		if (mfShadowCasterTimer > 0) return;
		
		mfShadowCasterTimer = cMath_RandRectf(0.2, 0.5);
		
		cLightSpot@ pSpot = cast<cLightSpot>(cLux_ID_Light(m_idSpotLight));
		if (pSpot is null) return;
		
		float fPlayerDist = cMath_Min(mBaseObj.GetDistanceToPlayer(), mfCrystal_SightRange * mfCrystal_SightRangeMul);
		cVector3f vClosestBeamPos = GetCrystalPos() + GetCrystalDir() * fPlayerDist;
		float fBeamDist = cMath_Vector3Dist(vClosestBeamPos, mBaseObj.GetPlayerPos());
				
		if (fBeamDist <= 27.5)
		{
			pSpot.SetShadowCastersAffected(eObjectVariabilityFlag_All);
			pSpot.SetShadowCasterDistance(mfSpotlight_ShadowCasterDistance);
		}
		else if (fBeamDist <= 42.5)
		{
			pSpot.SetShadowCastersAffected(eObjectVariabilityFlag_Static);
			pSpot.SetShadowCasterDistance(mfSpotlight_ShadowCasterDistance * 0.6);
		}
		else
		{
			pSpot.SetShadowCastersAffected(eObjectVariabilityFlag_Static);
			pSpot.SetShadowCasterDistance(mfSpotlight_ShadowCasterDistance * 0.3);
		}
		
	}
	
	//------------------------------------------------------------
	
	//} END SHADOW CASTER DISTANCE
	
