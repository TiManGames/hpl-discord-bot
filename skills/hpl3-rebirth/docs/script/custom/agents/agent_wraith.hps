	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		afStartY += 10;
		float fDist = cMath_Vector3Dist(mBaseObj.GetPlayerFeetPos(),mBaseObj.GetPosition());
		afStartY = cLux_DrawDebugText("dist : "+fDist, afStartY);
		afStartY = cLux_DrawDebugText("stuck : " + mpMover.GetStuckCounter(), afStartY);
		afStartY = cLux_DrawDebugText("player gaze : "+mfPlayerLookAtTimer, afStartY);
		afStartY = cLux_DrawDebugText("spotlight : "+mfSpotlight_DetectedTimer, afStartY);
		afStartY = cLux_DrawDebugText("speed : "+SpeedStateToString(mpMover.GetSpeedState()), afStartY);
		afStartY = cLux_DrawDebugText("mode : "+ModeToString(mMode), afStartY);
		afStartY = cLux_DrawDebugText("command : "+CommandToString(mCommand), afStartY);
		afStartY = cLux_DrawDebugText("alert : "+AlertToString(mAlert), afStartY);
		afStartY = cLux_DrawDebugText("stress : "+msModeFlyPatrol_State+ " " + mfModeFlyPatrol_PlayerStress + " " + mfModeFlyPatrol_StressAddMul, afStartY);
		
		return afStartY;
	}
	
