//			mBaseObj.GetAttachEntity().AddChild(pSound);
//			m_idSfx_StealthModeLoop = pSound.GetID();
//			pSound.SetVolume(mfSfx_StealthModeLoopVolume);
//			pSound.FadeVolumeMul(0, 200);
//		}
		
//		if (a == false)
//		{
//			a = true;
//			
//			cLuxSoundExtraData extraData;
//			cLux_PlayGuiSoundDataEx(gsWraithSound_StealthModeLoop, eSoundEntryType_World, 1.0f, true, extraData);
//			extraData.mpSoundEntry.SetVolume(mfSfx_StealthModeLoopVolume);
//			extraData.mpSoundEntry.SetVolumeMul(0.0f);
//		}
	}
	
	//------------------------------------------------------------
	
	void StopSoundLoops()
	{
		if (m_idSfx_IdleLoop != tID_Invalid)
		{
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_IdleLoop);
			if (pSound !is null) pSound.FadeOut(1.0f);
			m_idSfx_IdleLoop = tID_Invalid;
		}
		
		if (m_idSfx_SearchLoop != tID_Invalid)
		{
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_SearchLoop);
			if (pSound !is null) pSound.FadeOut(1.0f);
			m_idSfx_SearchLoop = tID_Invalid;
		}
		
		if (m_idSfx_StealthModeLoop != tID_Invalid)
		{
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_StealthModeLoop);
			if (pSound !is null) pSound.FadeOut(1.0f);
			m_idSfx_StealthModeLoop = tID_Invalid;
		}
		
		if (m_idSfx_SpotlightSound != tID_Invalid)
		{
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_SpotlightSound);
			if (pSound !is null) pSound.FadeOut(1.0f);
			m_idSfx_SpotlightSound = tID_Invalid;
		}
		
		if (m_idSfx_SpotlightTurnSound != tID_Invalid)
		{
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_SpotlightTurnSound);
			if (pSound !is null) pSound.FadeOut(1.0f);
			m_idSfx_SpotlightTurnSound = tID_Invalid;
		}
		
		Sound_Stop(mBaseObj.GetName() + "_PlayerInSight", 0.0f);
		
//		cSoundEntry@ pStealhModeSound = cSound_GetEntry(gsWraithSound_StealthModeLoop);
//		if (pStealhModeSound !is null) pStealhModeSound.FadeOut(1.0f);
	}
	
	//------------------------------------------------------------
	
	void FadeIdleLoopVolume(float afTarget, float afSpeed)
	{
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_IdleLoop);
		if (pSound is null) return;
		
		mfSfx_IdleLoopVolume = afTarget;
		pSound.FadeVolumeMul(mfSfx_IdleLoopVolume * mfSfx_VolumeMulGoal, afSpeed);		
	}
	
	//------------------------------------------------------------
	
	void FadeSearchLoopVolume(float afTarget, float afSpeed)
	{
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_SearchLoop);
		if (pSound is null) return;
		
		pSound.FadeVolumeMul(afTarget, afSpeed);
	}
	
	//------------------------------------------------------------
	
	void UpdateSounds(float afTimeStep)
	{
		/////////////////////////
		// Update volume muls
		mfSfx_VolumeMul = cMath_IncreaseTo(mfSfx_VolumeMul, afTimeStep, mfSfx_VolumeMulGoal);
		
		float fSpotlightSoundActiveMulTar = mbSfx_SpotlightSoundActive ? 1 : 0;
		mfSfx_SpotlightSoundActiveMul = cMath_IncreaseTo(mfSfx_SpotlightSoundActiveMul, afTimeStep, fSpotlightSoundActiveMulTar);
		
		mfSfx_SpotlightSoundVolumeMul = cMath_IncreaseTo(mfSfx_SpotlightSoundVolumeMul, afTimeStep, mfSfx_SpotlightSoundVolumeMulGoal);
		mfSfx_SpotlightSoundVolumeMul *= mfSfx_VolumeMul;
				
		mfSfx_SpotlightTurnSoundVolumeMul = cMath_IncreaseTo(mfSfx_SpotlightTurnSoundVolumeMul, afTimeStep, mfSfx_SpotlightTurnSoundVolumeMulGoal);
		mfSfx_SpotlightTurnSoundVolumeMul *= mfSfx_VolumeMul;
								
		/////////////////////////
		// Update sounds
		if (mbStealthModeActive) return;
		if (m_idSfx_SpotlightSound == tID_Invalid)
		{
			cSoundEntity@ pSound = mBaseObj.GetMap().GetWorld().CreateSoundEntity(mBaseObj.GetName() + "_SpotlightSound", gsWraithSound_Spotlight_sound, true);			
			m_idSfx_SpotlightSound = pSound.GetID();
			
			pSound.SetCustomMaxDistance(500.f);
			pSound.SetCustomMinDistance(20.f);
			pSound.SetUseCustomProperties(true);
			
			pSound.SetVolume(mfSfx_SpotlightSoundVolume);
			pSound.FadeVolumeMul(0, 0);
		}
		else
		{
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_SpotlightSound);
			if (pSound is null)
			{
				if (mBaseObj.Timer_Exists("SpotlightErrorCooldown") == false)
				{
					cLux_AddAIDebugMessage("[Wraith] Can't play spotlight sound.");
					mBaseObj.Timer_Add("SpotlightErrorCooldown", 5, "");
				}
			}
			else
			{
				float fSoundPosDist = cMath_Min(mBaseObj.GetDistanceToPlayer() - 3.f, mfCrystal_SightRange * mfCrystal_SightRangeMul);
				cVector3f vPos = GetCrystalPos() + GetCrystalDir() * fSoundPosDist;
				pSound.SetPosition(vPos);
				
				DrawTestPoint(vPos, cEngine_GetStepSize() + 0.01f, cColor(1, 1, 0) * 2.0f, 0.5f);
				
				float fDistToPlayer = (vPos - mBaseObj.GetPlayerPos()).Length();
				float fVolume = cMath_Clamp(1.f - cMath_Clamp((fDistToPlayer / 10), 0.0f, 1.0f), 0.0f, 1.f);
				fVolume = cMath_Easing(eEasing_QuadOut, fVolume);
									
				pSound.FadeVolumeMul(fVolume * mfSfx_SpotlightSoundVolumeMul * mfSfx_SpotlightSoundActiveMul, 0);
			}
		}
		
		/*if (m_idSfx_SpotlightTurnSound == tID_Invalid)
		{
			cSoundEntity@ pTurnSound = mBaseObj.GetMap().GetWorld().CreateSoundEntity(mBaseObj.GetName() + "_SpotlightTurnSound", gsWraithSound_SpotlightMoveLoop, true);
			m_idSfx_SpotlightTurnSound = pTurnSound.GetID();
			
			pTurnSound.SetCustomMaxDistance(100.f);
			pTurnSound.SetCustomMinDistance(30.f);
			pTurnSound.SetUseCustomProperties(true);
			
			pTurnSound.SetVolume(mfSfx_SpotlightTurnSoundVolume);
			pTurnSound.FadeVolumeMul(0, 200);
		}
		else
		{
			cSoundEntity@ pTurnSound = cLux_ID_SoundEntity(m_idSfx_SpotlightTurnSound);
			if (pTurnSound !is null)
			{
				float fSoundPosDist = cMath_Min(mBaseObj.GetDistanceToPlayer() - 3.f, mfCrystal_SightRange * mfCrystal_SightRangeMul);
				cVector3f vPos = GetCrystalPos() + GetCrystalDir() * fSoundPosDist;
				
				pTurnSound.SetPosition(vPos);
				float fTurnVolume = mSpotlightMovement == eWraithLightMovement_Turn ? 1.0f : 0.0f;
				
				if (mbCrystal_Active)
					pTurnSound.FadeVolumeMul(fTurnVolume * mfSfx_SpotlightTurnSoundVolumeMul, 0.f);
			}
		}*/
		
//		if (mbCrystal_PlayerDetected && mbSfx_InLightSound == false)
//		{
//			mbSfx_InLightSound = true;
//			Sound_CreateAtEntity(mBaseObj.GetName() + "_PlayerInSight", gsWraithSound_Player_is_in_spotlight, "player", 0.0f);
//		}
//		else if (mbCrystal_PlayerDetected == false && mbSfx_InLightSound)
//		{
//			mbSfx_InLightSound = false;
//			Sound_Stop(mBaseObj.GetName() + "_PlayerInSight", 0.0f);
//		}		
		
		cSoundEntity@ pIdleLoop = cLux_ID_SoundEntity(m_idSfx_IdleLoop);
		if (pIdleLoop !is null)
		{
//			pIdleLoop.SetParam(2, mpMover.GetMoveSpeed() > 0.2f ? 1 : 0);
			pIdleLoop.SetParam("move", mpMover.GetMoveSpeed() > 0.2f ? 1 : 0);
		}
	}
	
