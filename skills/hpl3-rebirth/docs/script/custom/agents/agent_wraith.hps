		for (int i = 0; i < mvShakingObjects.size(); ++i)
		{
			cShakingProp@ pObj = mvShakingObjects[i];
			iLuxEntity@ pEnt = cLux_ID_Entity(pObj.m_idProp);
			pObj.mfShakdeDirTimer -= afTimeStep;
			if (pObj.mfShakdeDirTimer < 0)
			{
				pObj.mvOffsetGoal = cMath_RandRectVector3f(cVector3f_One, cVector3f_One * -1) * 0.06;
				pObj.mvOffsetGoal.y *= 0.3f;
				pObj.mfShakdeDirTimer = cMath_RandRectf(0.005, 0.02);
			}
			
			float fT = afTimeStep * 10;
			pObj.mvOffset = pObj.mvOffset * (1.0f - fT) + pObj.mvOffsetGoal * fT;
			
			pObj.mfTimer -= afTimeStep;
			if (pObj.mfTimer < 0)
			{
				pEnt.SetVarBool("Shaking", false);
				pObj.mvOffset = 0;
				mvShakingObjects.removeAt(i);
				--i;
			}
			
			for (int j = 0; j < pEnt.GetMeshEntity().GetSubMeshEntityNum(); ++j)
			{
				pEnt.GetMeshEntity().GetSubMeshEntity(j).SetPosition(pObj.mvSubmeshOffset[j] + pObj.mvOffset);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void StartEntityShake(iLuxEntity@ apEnt)
	{
		if (apEnt is null) return;
		iPhysicsBody@ pBody = apEnt.GetMainBody();
		if (pBody is null) return;
		if (pBody.GetMass() <= 0) return;
		if (apEnt.GetEntityType() != eLuxEntityType_Prop) return;
		if (GetPointInCrystalCustomFOV(apEnt.GetPosition(), 10, 0.8f) == false) return;
		if (apEnt.GetVarBool("Shaking")) return;
		
		apEnt.SetVarBool("Shaking", true);
		
		Debug_DrawSphere(apEnt.GetPosition(), 0.25, cColor(1, 0.0, 0.7) * 3, 0.5);
		
		cShakingProp newLifted;
		newLifted.m_idProp = apEnt.GetID();
		newLifted.mfTimer = cMath_RandRectf(0.4, 0.7);
		for (int j = 0; j < apEnt.GetMeshEntity().GetSubMeshEntityNum(); ++j)
		{
			newLifted.mvSubmeshOffset.push_back(apEnt.GetMeshEntity().GetSubMeshEntity(j).GetLocalPosition());
		}
		mvShakingObjects.push_back(newLifted);
	}
	
