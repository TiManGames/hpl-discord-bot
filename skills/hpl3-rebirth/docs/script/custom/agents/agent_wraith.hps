	void StartSoundLoops()
	{
		if (mBaseObj.IsActive() == false) return;
		
		if (m_idSfx_IdleLoop == tID_Invalid)
		{
			cSoundEntity@ pSound = mBaseObj.PlaySound("IdleLoop", gsWraithSound_Idle_loop, true, true);
			m_idSfx_IdleLoop = pSound.GetID();
		}
		
		if (m_idSfx_SearchLoop == tID_Invalid)
		{
			cSoundEntity@ pSound = mBaseObj.PlaySound("SearchLoop", gsWraithSound_Search_loop, true, true);
			pSound.FadeVolumeMul(0, 0);
			m_idSfx_SearchLoop = pSound.GetID();
		}
		
//		if (m_idSfx_StealthModeLoop == tID_Invalid)
//		{
