	eWraithState_Cooldown,
	eWraithState_OpenDoor,
	eWraithState_Pulse,
	eWraithState_StealthWait,
	eWraithState_StealthSearch,
	eWraithState_StealthApproach,
	eWraithState_StealthMoveToPlayer,
	eWraithState_LookAroundForPlayer,
	eWraithState_SearchAround,
	eWraithState_InspectPosition,
	eWraithState_LookAtPosition,
	eWraithState_ControlGhoul,
	eWraithState_FlySearch,
