//----------------------------------------------------------------------

class cWraithPatrol
{
	cWraithPatrol(){}
	cWraithPatrol(int alId)
	{
		mlId = alId;
	}
	
	int mlId = -1;
	int mlLoopCount = -1;
	bool mbRandom = false;
	bool mbDone = false;
	eWraithSpeed mSpeed = eWraithSpeed_Walk;
	tString msEndOfPatrolCallback = "";
	array<cWraithPatrolNode> mvNodes;
}

class cWraithPatrolNode
{
	tString msName;
	float mfMinWaitTime;
	float mfMaxWaitTime;
	tString msAnimName;
	bool mbLoopAnim;
}

class cWraithFlyPatrol
{
	cWraithFlyPatrol(){}
	cWraithFlyPatrol(int alId)
	{
		mlId = alId;
	}
	
	int mlId = -1;
	int mlLoopCount = -1;
	bool mbRandom = false;
	float mfHAngle = 45.0f;
	float mfVAngle = 20.0f;
	float mfRotSpeed = 1.0f;
	array<tString> mvNodes;
}

