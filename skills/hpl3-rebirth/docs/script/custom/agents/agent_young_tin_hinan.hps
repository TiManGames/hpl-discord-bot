#include "agents/Agent_Humanoid.hps"
#include "custom/agents/agent_types_custom.hps"

//------------------------------------------------------------

enum eYoungTinHinanState
{
	eYoungTinHinanState_Idle = 0,
	eYoungTinHinanState_Stage1 = 1,
	eYoungTinHinanState_Stage2 = 2,
	eYoungTinHinanState_Stage3 = 3,
	eYoungTinHinanState_Stage4 = 4,
	eYoungTinHinanState_Stage5 = 5
}

//------------------------------------------------------------

class cScrAgentYoungTinHinan : cScrAgentHumanoid
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void Init()
	{		
		mbSetupDefaultEffects = false;
		mbMeshVisible = false;
		
		mlStage = 1;		
		mbFlying = false;
		mbOverrideDefaultFlying = false;
		
		mfParticleBrightnessDefault[0] = 1.f;
		mfParticleBrightnessDefault[1] = 1.f;
		mfParticleBrightnessDefault[2] = 1.f;
		mfBillboardBrightnessDefault = 1.f;
		mfLightBrightnessDefault[0] = 1.f;
		mfLightBrightnessDefault[1] = 1.f;
		
		mfParticleBrightnessGoal[0] = 1.f;
		mfParticleBrightnessGoal[1] = 1.f;
		mfParticleBrightnessGoal[2] = 1.f;
		mfBillboardBrightnessGoal = 1.f;
		mfLightBrightnessGoal[0] = 1.f;
		mfLightBrightnessGoal[1] = 1.f;
		mfCoverageGoal = 1.f;
		mfCustomCoverageGoal = -1.f;
		
		mfParticleBrightnessFadeSpeed[0] = 1.f;
		mfParticleBrightnessFadeSpeed[1] = 1.f;
		mfParticleBrightnessFadeSpeed[2] = 1.f;
		mfBillboardBrightnessFadeSpeed = 1.f;
		mfLightBrightnessFadeSpeed[0] = 1.f;
		mfLightBrightnessFadeSpeed[1] = 1.f;
		mfCoverageFadeSpeed = 1.f;
		
		mfEffectBrightnessMul = 1.f;
		mfEffectBrightnessMulGoal = 1.f;
		mfEffectBrightnessMulFadeSpeed = 1.f;
		
		mfDeactivationCount = 0.f;
		mfDeactivationTime = -1.f;
		
		mbTurnTowardPlayer = true;
		mbAboutToMove = false;
		mbTurnInstantlyToNextNode = false;
		mbExactStopAtEnd = false;
		mvMovePos = 0.f;
		msMoveCallback = "";
		
		mvBillboardOffset = 0.f;
		
		m_idLightId[0] = tID_Invalid;
		m_idLightId[1] = tID_Invalid;
		msParticles[0] = "PS_1";
		msParticles[1] = "PS_2";
		msParticles[2] = "PS_3";
		m_idBillboardId = tID_Invalid;
		m_idParentId = tID_Invalid;
		m_idSoundId = tID_Invalid;
		
		msHeadTracker_TargetEntity = "";
			
		mBaseObj.SetUpdatePlayerDetection(false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupCharBody()
	{
		cScrAgentHumanoid::SetupCharBody();
	}
	
	//------------------------------------------------------------
		
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrAgentHumanoid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		//////////////////////
		// Char body
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();		
		pCharBody.SetMaxPositiveMoveSpeed(eCharDir_Forward, 1.f);
		pCharBody.SetMaxNegativeMoveSpeed(eCharDir_Forward, -1.f);
		pCharBody.SetMaxPositiveMoveSpeed(eCharDir_Right, 1.f);
		pCharBody.SetMaxNegativeMoveSpeed(eCharDir_Right, -1.f);
		pCharBody.SetMoveAcc(eCharDir_Forward, 2.f);
		pCharBody.SetMoveAcc(eCharDir_Right, 2.f);
		pCharBody.SetMoveDeacc(eCharDir_Forward, 2.f);
		pCharBody.SetMoveDeacc(eCharDir_Right, 2.f);
		pCharBody.SetMoveSpeedMul(eCharDir_Forward, 1.f);
		pCharBody.SetMaxPushMass(17.f);
		pCharBody.SetGravityActive(true);
		pCharBody.SetTestCollision(true);
		
		//////////////////////
		// Sight
		mBaseObj.SetAlignEntityWithGroundRay(true);
		mBaseObj.SetFOV(cMath_ToRad(130.f));
		mBaseObj.SetSightRange(20.f);
		mBaseObj.SetSightRangeMul(1.f);
		mBaseObj.SetRelativeEyeHeight(0.8f);
		
		//////////////////////
		// Char mover
		mpMover.SetWallAvoidanceActive(false);
		mpMover.SetDynamicObjectAvoidanceActive(false);
		mpMover.SetDynamicObjectPlayerAvoidanceActive(false);
		mpMover.SetUseMoveStateAnimations(true);
		
		mpMover.SetMoveSpeedAnimMul(1.f);
		mpMover.SetMaxForwardSpeed(1.f);
		mpMover.SetMaxBackwardSpeed(1.f);

		mpMover.SetStoppedToWalkSpeed(0.2f);
		mpMover.SetWalkToRunSpeed(3.f);
		mpMover.SetWalkToStoppedSpeed(0.15f);
		mpMover.SetRunToWalkSpeed(0.8f);		
		mpMover.SetTurnMinBreakAngle(cMath_ToRad(40.f));		
		
		mpMover.SetTurnBreakMul(0.5f);
		mpMover.SetTurnMaxSpeed(30.f);
		mpMover.SetTurnSpeedMul(15.f);
		
		mpMover.AddSpeedState(eYoungTinHinanSpeed_WalkingSlow);
		mpMover.SetSpeedState_Forward(1.5f);
		mpMover.SetSpeedState_ForwardAcc(2.f);
		mpMover.SetSpeedState_ForwardDeacc(2.f);
		
		mpMover.AddSpeedState(eYoungTinHinanSpeed_WalkingFast);
		mpMover.SetSpeedState_Forward(5.f);
		mpMover.SetSpeedState_ForwardAcc(4.f);
		mpMover.SetSpeedState_ForwardDeacc(4.f);
		
		mpMover.AddSpeedState(eYoungTinHinanSpeed_FlyingSlow);
		mpMover.SetSpeedState_Forward(1.75f);
		mpMover.SetSpeedState_ForwardAcc(2.f);
		mpMover.SetSpeedState_ForwardDeacc(2.f);
		
		mpMover.AddSpeedState(eYoungTinHinanSpeed_FlyingFast);
		mpMover.SetSpeedState_Forward(6.f);
		mpMover.SetSpeedState_ForwardAcc(4.f);
		mpMover.SetSpeedState_ForwardDeacc(4.f);		
		
		//////////////////////
		// Pathfinder
		mpPathfinder.SetNodeContainerName("YoungTinHinan");
		mpPathfinder.SetMaxHeight(0.8f);
		mpPathfinder.SetClimbWalls(false);
		
		//////////////////////
		// State machine
		@mpStateMachine = cLux_CreateEntityComponent_StateMachine(mBaseObj);
		mpStateMachine.AddState("Idle", eYoungTinHinanState_Idle);
		mpStateMachine.AddState("Stage1", eYoungTinHinanState_Stage1);
		mpStateMachine.AddState("Stage2", eYoungTinHinanState_Stage2);
		mpStateMachine.AddState("Stage3", eYoungTinHinanState_Stage3);
		mpStateMachine.AddState("Stage4", eYoungTinHinanState_Stage4);
		mpStateMachine.AddState("Stage5", eYoungTinHinanState_Stage5);
		
		/////////////////////
		// Head tracker
		@mpHeadTracker = cLux_CreateEntityComponent_HeadTracker(mBaseObj);
		mpHeadTracker.LoadFromVariables(apVars);
		
		msHeadTracker_TargetEntity = apInstanceVars.GetVarString("HeadTracker_TargetEntity", "");
		if (msHeadTracker_TargetEntity == "")
			msHeadTracker_TargetEntity = "Player";
		
		mpHeadTracker.SetActive(apInstanceVars.GetVarBool("HeadTracker_Active", true));
		
		/////////////////////
		// Foot placement
		@mpFootPlacement = cLux_CreateEntityComponent_FootPlacement(mBaseObj);
		mpFootPlacement.LoadFromVariables(apVars);
		mpFootPlacement.SetActive(true);
		
		/////////////////////
		// Specific
		cMeshEntity@ pMehEnt = mBaseObj.GetMeshEntity();
		pMehEnt.SetVisible(false);
		pMehEnt.SetUpdateBonesWhenCulled(true);
		
		mlStage = apVars.GetVarInt("Stage", 1);
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad()
	{
		cScrAgentHumanoid::OnAfterWorldLoad();
		//SetupDefaultEffects();
		
		if (msHeadTracker_TargetEntity != "")
		{
			iLuxEntity@ pEntity = mBaseObj.GetMap().GetEntityByName(msHeadTracker_TargetEntity);
			if (pEntity !is null)
				mpHeadTracker.SetTrackEntity(pEntity);
			else
				Error("Could not find headtracker target entity '"+msHeadTracker_TargetEntity+"' for entity '"+mBaseObj.GetName()+"'");
		}
	}
	
	//------------------------------------------------------------
	
	void SetupDefaultEffects()
	{		
		if (mbSetupDefaultEffects)
			return;
		
		mbSetupDefaultEffects = true;
		
		iLight@ pLight_1 = mBaseObj.GetLightFromName("Light_Point_1");
		iLight@ pLight_2 = mBaseObj.GetLightFromName("Light_Spot_1");
		cParticleSystem@ pPS_1 = mBaseObj.GetParticleSystemFromName("PS_1");
		cParticleSystem@ pPS_2 = mBaseObj.GetParticleSystemFromName("PS_2");
		cParticleSystem@ pPS_3 = mBaseObj.GetParticleSystemFromName("PS_3");
		cBillboard@ pBillboard = mBaseObj.GetBillboardFromName("Billboard_1");
		
		if (pLight_1 !is null)
		{
			mfLightBrightnessDefault[0] = pLight_1.GetBrightness();	
			pLight_1.SetBrightness(0.f);
			m_idLightId[0] = pLight_1.GetID();
		}
		
		if (pLight_2 !is null)
		{
			mfLightBrightnessDefault[1] = pLight_2.GetBrightness();
			pLight_2.SetBrightness(0.f);	
			m_idLightId[1] = pLight_2.GetID();
		}
		
		if (pPS_1 !is null)
		{
			mfParticleBrightnessDefault[0] = pPS_1.GetBrightness();
			pPS_1.SetBrightness(0.f);
			mfParticleBrightness[0] = pPS_1.GetBrightness();
		}
		
		if (pPS_2 !is null)
		{
			mfParticleBrightnessDefault[1] = pPS_2.GetBrightness();
			pPS_2.SetBrightness(0.f);
			mfParticleBrightness[1] = pPS_2.GetBrightness();
		}
		
		if (pPS_3 !is null)
		{
			mfParticleBrightnessDefault[2] = pPS_3.GetBrightness();
			pPS_3.SetBrightness(0.f);
			mfParticleBrightness[2] = pPS_3.GetBrightness();
		}
		
		if (pBillboard !is null)
		{
			mfBillboardBrightnessDefault = pBillboard.GetBrightness();
			pBillboard.SetBrightness(0.f);
			m_idBillboardId = pBillboard.GetID();
			
			cBoneState@ pBone = mBaseObj.GetMeshEntity().GetBoneStateFromName("j_Hip");
			if (pBone !is null)
				mvBillboardOffset = pBillboard.GetWorldPosition() - pBone.GetWorldPosition();
		}
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		if (abX)
		{
			///////////////////
			// Setup effects
			SetupDefaultEffects();
			
			///////////////////
			// Setup mesh
			mBaseObj.GetMeshEntity().SetVisible(mbMeshVisible);
			Entity_SetCastShadows(mBaseObj.GetName(), false);
		}
		else
		{
			///////////////////
			// Reset effects
			iLight@ pLight_1 = cLux_ID_Light(m_idLightId[0]);
			iLight@ pLight_2 = cLux_ID_Light(m_idLightId[1]);
			cBillboard@ pBillboard = cLux_ID_Billboard(m_idBillboardId);
			
			if (pLight_1 !is null)		pLight_1.SetBrightness(0.f);
			if (pLight_2 !is null)		pLight_2.SetBrightness(0.f);
			if (pBillboard !is null)	pBillboard.SetBrightness(0.f);
			
			for (int i = 0; i < msParticles.length(); ++i)
			{
				mfParticleBrightness[i] = 0;
				cParticleSystem@ pPS = mBaseObj.GetParticleSystemFromName(msParticles[i]);
				if (pPS !is null)	pPS.SetBrightness(mfParticleBrightness[i]);
			}
				
			mBaseObj.GetMeshEntity().SetCoverageAmount(0.f);
			mfEffectBrightnessMul = 0.f;
			
			if (m_idSoundId != tID_Invalid)
			{
				cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSoundId);
				if (pSound !is null)
					pSound.FadeOut(0.3f);
					
				m_idSoundId = tID_Invalid;
			}
		}		
	}
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{	
		////////////////////////
		// Setup vars
		cBillboard@ pBillboard = cLux_ID_Billboard(m_idBillboardId);
		cMeshEntity@ pMeshEnt = mBaseObj.GetMeshEntity();
		
		////////////////////////
		// State
		int lState = eYoungTinHinanState(mlStage);
		if (mpStateMachine.GetCurrentState() != lState)
			mpStateMachine.ChangeState(lState);
		
		///////////////////////
		// Orientation
		if (mbTurnTowardPlayer)
		{
			cVector3f vCamPos = cLux_GetPlayer().GetCamera().GetPosition();
			if (IsMoving() == false && mBaseObj.GetAngleToPos2D(vCamPos) > cMath_ToRad(75.f))
			{
				if (pMeshEnt.GetCoverageAmount() <= 0.f)	mpMover.TurnInstantlyToPos(vCamPos);
				else										mpMover.TurnToPos(vCamPos);
			}
		}

		// Makes transition from stopped to moving faster
		if (mbTurnInstantlyToNextNode)
		{
			if (mpPathfinder.BuildPathNodeArrayToPos(mvMovePos) && mpPathfinder.GetPathNodeArraySize() > 0)
			{
				cAINode@ pNode = mpPathfinder.GetPathNodeArrayNode(0);
				if (pNode !is null)
					mpMover.TurnInstantlyToPos(pNode.GetPosition());
			}
			
			mbTurnInstantlyToNextNode = false;
		}
		
		//////////////////////
		// Effects
		mfEffectBrightnessMul = cMath_IncreaseTo(mfEffectBrightnessMul, mfEffectBrightnessMulFadeSpeed * afTimeStep, mfEffectBrightnessMulGoal);		
		
		///////////////////////
		// Particles
		for (int i = 0; i < msParticles.length(); ++i)
		{
			cParticleSystem@ pPS = mBaseObj.GetParticleSystemFromName(msParticles[i]);
			
			if (pPS !is null)
			{			
				mfParticleBrightness[i] = cMath_IncreaseTo(mfParticleBrightness[i], afTimeStep * mfParticleBrightnessFadeSpeed[i], mfParticleBrightnessGoal[i]);
				pPS.SetBrightness(mfParticleBrightness[i] * mfEffectBrightnessMul);
				
				/////////////////////
				// Remove attachment so we can smooth movement in PostUpdate()
				iEntity3D@ pParent = pPS.GetEntityParent();
				if (pParent !is null)
				{
					m_idParentId = pParent.GetID();
					pParent.RemoveChild(pPS);
				}
			}
		}
		
		///////////////////////
		// Light
		for (int i = 0; i < 2; ++i)
		{
			iLight@ pLight = cLux_ID_Light(m_idLightId[i]);
			if (pLight !is null)
			{	
				float fBrightness = pLight.GetBrightness();			
				fBrightness = cMath_IncreaseTo(fBrightness, afTimeStep * mfLightBrightnessFadeSpeed[i], mfLightBrightnessGoal[i]);
				pLight.SetBrightness(fBrightness * mfEffectBrightnessMul);
			}
		}
		
		///////////////////////
		// Billboard
		if (pBillboard !is null)
		{		
			float fGoal = mfBillboardBrightnessGoal;
			if (IsMoving()) fGoal = 0.f;
			
			float fBrightness = pBillboard.GetBrightness();				
			fBrightness = cMath_IncreaseTo(fBrightness, afTimeStep * mfBillboardBrightnessFadeSpeed, mfBillboardBrightnessGoal);
			pBillboard.SetBrightness(fBrightness * mfEffectBrightnessMul);
		}
		else
		{
			@pBillboard = mBaseObj.GetBillboardFromName("Billboard_1");
			if (pBillboard !is null)
				m_idBillboardId = pBillboard.GetID();
		}
		
		///////////////////////
		// Coverage
		{			
			float fGoal = mfCoverageGoal;
			if (IsMoving()) fGoal = 0;
			else if (mfCustomCoverageGoal >= 0) fGoal = mfCustomCoverageGoal;
			
			float fCoverage = pMeshEnt.GetCoverageAmount();
			fCoverage = cMath_IncreaseTo(fCoverage, afTimeStep * mfCoverageFadeSpeed, fGoal);
			pMeshEnt.SetCoverageAmount(fCoverage * mfEffectBrightnessMul);
		}
		
		//////////////////////
		// Movement
		if (mbAboutToMove)
		{
			// Don't move until mesh is invisible!
			float fCoverage = pMeshEnt.GetCoverageAmount();
			float fBrightness = pBillboard is null ? 0.f : pBillboard.GetBrightness();
			
			if (fCoverage <= 0.f && fBrightness <= 0.f)
			{						
				mpPathfinder.MoveTo(mvMovePos, 1.f, mbExactStopAtEnd, "", false);
				mpPathfinder.SetEndOfPathCallbackFunc(msMoveCallback);
				
				mbAboutToMove = false;
				mbTurnInstantlyToNextNode = true;
				mbExactStopAtEnd = false;
			}			
		}
		
		///////////////////////
		// Sound
		if (m_idSoundId == tID_Invalid && (mpPathfinder.IsMoving() || mbAboutToMove))
		{			
			cSoundEntity@ pSound = mBaseObj.PlaySound("Sound_TinHinanMove", "creatures/foley/creature/tin_hinan/phase/loop", true, true);
			if (pSound !is null)
			{
				pSound.FadeIn(0.5f, 1.f);
				m_idSoundId = pSound.GetID();
			}
		}
		else if (m_idSoundId != tID_Invalid && mpPathfinder.IsMoving() == false && mbAboutToMove == false)
		{
			if (mbMeshVisible && mlStage == 5)
				mBaseObj.PlaySound("Sound_TinHinanStop", "creatures/foley/creature/tin_hinan/phase/end", true, true);
			
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSoundId);
			
			if (pSound is null)
				@pSound = mBaseObj.GetMap().GetWorld().GetSoundEntity(mBaseObj.GetName() + "Sound_TinHinanMove");
			if (pSound !is null)
				pSound.FadeOut(0.3f);
				
			m_idSoundId = tID_Invalid;
		}
		
		//////////////////////
		// Deactivation
		if (mfDeactivationTime > 0.f)
		{
			mfDeactivationCount += afTimeStep;
			if (mfDeactivationCount >= mfDeactivationTime)
			{
				mfDeactivationTime = -1.f;
				mfDeactivationCount = 0.f;
				
				mBaseObj.SetActive(false);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
		///////////////////
		// Custom billboard attachment
		// (Place at hip bone but with no rotation, so it works properly during cutscenes)
		cBillboard@ pBillboard = cLux_ID_Billboard(m_idBillboardId);
		cBoneState@ pBone = mBaseObj.GetMeshEntity().GetBoneStateFromName("j_Hip");
		
		if (pBillboard !is null && pBone !is null)
		{
			cMatrixf mtxNew = cMath_MatrixMul(cMath_MatrixTranslate(mvBillboardOffset), pBone.GetWorldMatrix());
			mtxNew.SetRotation(cMatrixf_Identity);
			pBillboard.SetWorldMatrix(mtxNew);
		}

		//////////////////////
		// Smooth particle movement
		for (int i = 0; i < msParticles.length(); ++i)
		{
			cParticleSystem@ pPS = mBaseObj.GetParticleSystemFromName(msParticles[i]);
			if (pPS is null)
				continue;
			
			cVector3f vPos = pPS.GetWorldPosition();
			
			tString sSocket = i != 0 ? "HeadParticleSocket" : "BodyParticleSocket";
			cNode3D@ pSocket = mBaseObj.GetMeshEntity().GetSocket(sSocket);
			
			if (pSocket !is null)
				vPos = (pPS.GetWorldPosition() * (1.f - (afTimeStep * 3.f)) + pSocket.GetWorldPosition() * (afTimeStep * 3.f));
			
			/////////////////
			// Reattach to parent so the particles get saved correctly
			iEntity3D@ pParent = cLux_ID_Entity3D(m_idParentId);
			if (pParent !is null)
			{
				pParent.AddChild(pPS);
				pPS.SetWorldPosition(vPos);
			}
		}
	}
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: DEFAULT
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Default_Enter() {}	
	void State_Default_Leave() {}
	void State_Default_Update(float afTimeStep) {}
	bool State_Default_Message(int alMessageId) { return false; }		
	void State_Default_TimerUp(uint64 alId) {}
	
	//------------------------------------------------------------
	
	//} END DEFAULT
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: IDLE
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Idle_Enter() {}	
	void State_Idle_Leave() {}
	void State_Idle_Update(float afTimeStep) {}
	bool State_Idle_Message(int alMessageId) { return false; }	
	void State_Idle_TimerUp(uint64 alId) {}
	
	//------------------------------------------------------------
	
	//} END IDLE
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: STAGE 1
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Stage1_Enter() 
	{		
		mpMover.SetSpeedState(eYoungTinHinanSpeed_WalkingSlow);
		
		mbMeshVisible = false;
		mBaseObj.GetMeshEntity().SetVisible(false);
	}
	
	//------------------------------------------------------------
	
	void State_Stage1_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_Stage1_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_Stage1_Message(int alMessageId) 
	{ 
		return false; 
	}

	//------------------------------------------------------------	
	
	void State_Stage1_TimerUp(uint64 alId) 
	{
	}
	
	//------------------------------------------------------------
	
	//} END STAGE 1
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: STAGE 2
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Stage2_Enter() 
	{
		mpMover.SetSpeedState(eYoungTinHinanSpeed_WalkingFast);
		
		if (mbOverrideDefaultFlying == false)
			SetFlying(true);
		
		mbMeshVisible = false;
		mBaseObj.GetMeshEntity().SetVisible(false);
	}
	
	//------------------------------------------------------------
	
	void State_Stage2_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_Stage2_Update(float afTimeStep) 
	{		
		bool bIsMoving = IsMoving();
		
		///////////////////////
		// Particles
		mfParticleBrightnessFadeSpeed[0] = (mfParticleBrightnessDefault[0] / 2.f);
		mfParticleBrightnessGoal[0] = bIsMoving ? 0.f : mfParticleBrightnessDefault[0];
		
		mfParticleBrightnessFadeSpeed[1] = mfParticleBrightnessDefault[1];
		mfParticleBrightnessGoal[1] = bIsMoving ? mfParticleBrightnessDefault[1] : 0.f;
		
		mfParticleBrightnessFadeSpeed[2] = mfParticleBrightnessDefault[2];
		mfParticleBrightnessGoal[2] = bIsMoving ? mfParticleBrightnessDefault[2] : 0.f;
				
		///////////////////////
		// Billboard
		mfBillboardBrightnessFadeSpeed = (mfBillboardBrightnessDefault / 1.5f);
		mfBillboardBrightnessGoal = bIsMoving ? 0.f : mfBillboardBrightnessDefault;
				
		///////////////////////
		// Light
		mfLightBrightnessFadeSpeed[0] = (mfLightBrightnessDefault[0] / 1.5f);
		mfLightBrightnessGoal[0] = bIsMoving ? mfLightBrightnessDefault[0] * 0.5f : mfLightBrightnessDefault[0];
		
		mfLightBrightnessFadeSpeed[1] = (mfLightBrightnessDefault[1] / 1.f);
		mfLightBrightnessGoal[1] = bIsMoving ? 0.f : mfLightBrightnessDefault[1];
		
		///////////////////////
		// Coverage
		mfCoverageFadeSpeed = 1.f / 1.f;
		mfCoverageGoal = 0.f;
	}
	
	//------------------------------------------------------------
	
	bool State_Stage2_Message(int alMessageId)
	{ 
		return false; 
	}

	//------------------------------------------------------------	
	
	void State_Stage2_TimerUp(uint64 alId) 
	{
	}
	
	//------------------------------------------------------------
	
	//} END STAGE 2
	
	///////////////////////////////////
	// STATE: STAGE 3
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Stage3_Enter() 
	{
		mpMover.SetSpeedState(eYoungTinHinanSpeed_WalkingFast);
		
		if (mbOverrideDefaultFlying == false)
			SetFlying(false);
		
		mbMeshVisible = true;
		mBaseObj.GetMeshEntity().SetVisible(true);
	}
	
	//------------------------------------------------------------
	
	void State_Stage3_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_Stage3_Update(float afTimeStep) 
	{		
		bool bIsMoving = IsMoving();
		
		///////////////////////
		// Particles
		mfParticleBrightnessFadeSpeed[0] = (mfParticleBrightnessDefault[0] / 2.f);
		mfParticleBrightnessGoal[0] = bIsMoving ? 0.f : mfParticleBrightnessDefault[0];
		
		mfParticleBrightnessFadeSpeed[1] = mfParticleBrightnessDefault[1];
		mfParticleBrightnessGoal[1] = bIsMoving ? mfParticleBrightnessDefault[1] : 0.f;
		
		mfParticleBrightnessFadeSpeed[2] = mfParticleBrightnessDefault[2];
		mfParticleBrightnessGoal[2] = bIsMoving ? mfParticleBrightnessDefault[2] : 0.f;
		
		///////////////////////
		// Billboard
		mfBillboardBrightnessFadeSpeed = (mfBillboardBrightnessDefault / 1.5f);
		mfBillboardBrightnessGoal = bIsMoving ? 0.f : mfBillboardBrightnessDefault;
		
		///////////////////////
		// Light
		mfLightBrightnessFadeSpeed[0] = (mfLightBrightnessDefault[0] / 1.5f);
		mfLightBrightnessGoal[0] = bIsMoving ? mfLightBrightnessDefault[0] * 0.5f : mfLightBrightnessDefault[0];
		
		mfLightBrightnessFadeSpeed[1] = (mfLightBrightnessDefault[1] / 1.f);
		mfLightBrightnessGoal[1] = bIsMoving ? 0.f : mfLightBrightnessDefault[1];
		
		///////////////////////
		// Coverage
		mfCoverageFadeSpeed = 1.f / 1.5f;
		mfCoverageGoal = bIsMoving ? 0.f : cMath_Max(0.f, mfEffectBrightnessMul - 0.5f);
	}
	
	//------------------------------------------------------------
	
	bool State_Stage3_Message(int alMessageId)
	{ 
		return false; 
	}

	//------------------------------------------------------------	
	
	void State_Stage3_TimerUp(uint64 alId) 
	{
	}
	
	//------------------------------------------------------------
	
	//} END STAGE 3
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: STAGE 4
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Stage4_Enter() 
	{
		mpMover.SetSpeedState(eYoungTinHinanSpeed_WalkingFast);
		
		if (mbOverrideDefaultFlying == false)
			SetFlying(false);
		
		mbMeshVisible = true;
		mBaseObj.GetMeshEntity().SetVisible(true);
	}
	
	//------------------------------------------------------------
	
	void State_Stage4_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_Stage4_Update(float afTimeStep) 
	{			
		bool bIsMoving = IsMoving();
		
		///////////////////////
		// Particles
		mfParticleBrightnessFadeSpeed[0] = (mfParticleBrightnessDefault[0] / 2.f);
		mfParticleBrightnessGoal[0] = bIsMoving ? mfParticleBrightnessDefault[0] : mfParticleBrightnessDefault[0] * 0.1f;	
		
		mfParticleBrightnessFadeSpeed[1] = mfParticleBrightnessDefault[1];
		mfParticleBrightnessGoal[1] = bIsMoving ? mfParticleBrightnessDefault[1] : 0.f;
		
		mfParticleBrightnessFadeSpeed[2] = mfParticleBrightnessDefault[2];
		mfParticleBrightnessGoal[2] = bIsMoving ? 0.f : mfParticleBrightnessDefault[2];
		
		///////////////////////
		// Billboard
		mfBillboardBrightnessFadeSpeed = (mfBillboardBrightnessDefault / 1.5f);
		mfBillboardBrightnessGoal = bIsMoving ? 0.f : mfBillboardBrightnessDefault;
		
		///////////////////////
		// Light
		mfLightBrightnessFadeSpeed[0] = (mfLightBrightnessDefault[0] / 1.5f);
		mfLightBrightnessGoal[0] = bIsMoving ? mfLightBrightnessDefault[0] * 0.5f : mfLightBrightnessDefault[0];
		
		mfLightBrightnessFadeSpeed[1] = (mfLightBrightnessDefault[1] / 1.f);
		mfLightBrightnessGoal[1] = bIsMoving ? 0.f : mfLightBrightnessDefault[1];
		
		///////////////////////
		// Coverage
		mfCoverageFadeSpeed = 1.f / 1.5f;
		mfCoverageGoal = bIsMoving ? 0.f : cMath_Max(0.f, mfEffectBrightnessMul - 0.2f);
	}
	
	//------------------------------------------------------------
	
	bool State_Stage4_Message(int alMessageId)
	{ 
		return false; 
	}

	//------------------------------------------------------------	
	
	void State_Stage4_TimerUp(uint64 alId) 
	{
	}
	
	//------------------------------------------------------------
	
	//} END STAGE 4
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: STAGE 4
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void State_Stage5_Enter() 
	{
		mpMover.SetSpeedState(eYoungTinHinanSpeed_WalkingFast);
		
		if (mbOverrideDefaultFlying == false)
			SetFlying(false);
		
		mbMeshVisible = true;
		mBaseObj.GetMeshEntity().SetVisible(true);
	}
	
	//------------------------------------------------------------
	
	void State_Stage5_Leave() 
	{
	}
	
	//------------------------------------------------------------
	
	void State_Stage5_Update(float afTimeStep) 
	{				
		bool bIsMoving = IsMoving();
	
		///////////////////////
		// Particles		
		mfParticleBrightnessFadeSpeed[0] = (mfParticleBrightnessDefault[0] / 2.f);
		mfParticleBrightnessGoal[0] = bIsMoving ? mfParticleBrightnessDefault[0] : mfParticleBrightnessDefault[0] * 0.1f;

		if (bIsMoving && mbFlying)
			mfParticleBrightnessGoal[0] = 0.f;
		
		mfParticleBrightnessFadeSpeed[1] = mfParticleBrightnessDefault[1];
		mfParticleBrightnessGoal[1] = bIsMoving ? mfParticleBrightnessDefault[1] : 0.f;
		
		mfParticleBrightnessFadeSpeed[2] = mfParticleBrightnessDefault[2];
		mfParticleBrightnessGoal[2] = bIsMoving && mbFlying ? mfParticleBrightnessDefault[2] : 0.f;
		
		///////////////////////
		// Billboard
		mfBillboardBrightnessFadeSpeed = (mfBillboardBrightnessDefault / 1.5f);
		mfBillboardBrightnessGoal = bIsMoving ? 0.f : mfBillboardBrightnessDefault;
		
		///////////////////////
		// Light
		mfLightBrightnessFadeSpeed[0] = (mfLightBrightnessDefault[0] / 1.5f);
		mfLightBrightnessGoal[0] = bIsMoving ? mfLightBrightnessDefault[0] * 1.1f : mfLightBrightnessDefault[0];
		
		mfLightBrightnessFadeSpeed[1] = (mfLightBrightnessDefault[1] / 1.f);
		mfLightBrightnessGoal[1] = bIsMoving ? 0.f : mfLightBrightnessDefault[1];
		
		///////////////////////
		// Coverage
		mfCoverageFadeSpeed = 1.f / 1.f;
		mfCoverageGoal = bIsMoving ? 0.f : mfEffectBrightnessMul;
	}
	
	//------------------------------------------------------------
	
	bool State_Stage5_Message(int alMessageId)
	{
		return false; 
	}

	//------------------------------------------------------------	
	
	void State_Stage5_TimerUp(uint64 alId) 
	{
	}
	
	//------------------------------------------------------------
	
	//} END STAGE 5
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CUSTOM
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetFlying(bool abX)
	{
		mbFlying = abX;
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		pCharBody.SetGravityActive(abX == false);
		pCharBody.SetTestCollision(abX == false);
		pCharBody.SetEntityPitchAmount(abX ? 0.f : 0.3f);
		pCharBody.SetForceVelocity(cVector3f_Zero);
		pCharBody.SetDeaccelerateMoveSpeedInAir(abX);
		
		mpMover.SetUse3DMovement(abX);
		mpMover.SetBankingActive(abX);
		mpMover.SetBankingAngleMul(0.3f);
		mpMover.SetBankingMaxAngle(cMath_ToRad(45.f));
		mpMover.SetBankingSpeedMul(3.f);
		mpMover.SetBankingMaxSpeed(1.f);
		mpMover.SetTurnBreakMul(abX ? 0.f : 0.5f);
		mpMover.SetTurnMaxSpeed(abX ? 4.f : 30.f);
		mpMover.SetTurnSpeedMul(abX ? 3.f : 15.f);
		
		mpMover.SetSpeedState(abX ? eYoungTinHinanSpeed_FlyingFast : GetDefaultWakingSpeedState());
	}
	
	//------------------------------------------------------------
	
	eYoungTinHinanSpeed GetDefaultWakingSpeedState()
	{
		eYoungTinHinanSpeed eStage = eYoungTinHinanSpeed_WalkingSlow;
		
		switch (mlStage)
		{
			case 1: eStage = eYoungTinHinanSpeed_WalkingSlow;
			default: eStage = eYoungTinHinanSpeed_WalkingFast;
		}
		
		return eStage;
	}
	
	//------------------------------------------------------------
	
	bool IsMoving()
	{
		return mBaseObj.GetCharBody().GetVelocity(cEngine_GetStepSize()).SqrLength() > 0.f || mbAboutToMove;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_Activate()
	{
		mBaseObj.SetActive(true);
		
		float fTime = cMath_Max(cScript_GetGlobalArgFloat(0), 0.0001f);
		
		mfEffectBrightnessMulGoal = 1.f;
		mfEffectBrightnessMulFadeSpeed = cMath_Abs(mfEffectBrightnessMulGoal - mfEffectBrightnessMul) / fTime;
		
		bool bPlaySound = cScript_GetGlobalArgBool(1);
		if (bPlaySound)
			mBaseObj.PlaySound("Sound_Appear", "creatures/foley/creature/tin_hinan/appear", true, true);
	}
	
	//------------------------------------------------------------
	
	void _Global_Deactivate()
	{
		mfDeactivationTime = cMath_Max(cScript_GetGlobalArgFloat(0), 0.0001f);
		mfDeactivationCount = 0.f;	
	
		mfEffectBrightnessMulGoal = 0.f;
		mfEffectBrightnessMulFadeSpeed = cMath_Abs(mfEffectBrightnessMulGoal - mfEffectBrightnessMul) / mfDeactivationTime;
		
		bool bPlaySound = cScript_GetGlobalArgBool(1);
		if (bPlaySound)
			mBaseObj.PlaySound("Sound_Disappear", "creatures/foley/creature/tin_hinan/disappear", true, true);
	}
	
	//------------------------------------------------------------
	
	void _Global_MoveTo()
	{
		tString sTarget = cScript_GetGlobalArgString(0);
		msMoveCallback = cScript_GetGlobalArgString(1);
		mbExactStopAtEnd = cScript_GetGlobalArgBool(2);
		
		cAINode@ pNode = mpPathfinder.GetNodeFromName(sTarget);
		if (pNode !is null)
		{
			mvMovePos = pNode.GetPosition();
		}
		else
		{
			iLuxEntity@ pEnt = mBaseObj.GetMap().GetEntityByName(sTarget);
			if (pEnt !is null)
				mvMovePos = pEnt.GetPosition();
		}		
		
		bool bPrevAboutToMove = mbAboutToMove;
		mbAboutToMove = true;
		
		if (bPrevAboutToMove == false && mlStage == 5)
			mBaseObj.PlaySound("Sound_TinHinanStart", "creatures/foley/creature/tin_hinan/phase/start", true, true);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetFlying()
	{
		mbOverrideDefaultFlying = true;
		SetFlying(cScript_GetGlobalArgBool(0));
	}
	
	//------------------------------------------------------------
	
	void _Global_SetCustomCoverage()
	{
		mfCustomCoverageGoal = cScript_GetGlobalArgFloat(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetAutoTurnTowardPlayer()
	{
		mbTurnTowardPlayer = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
