	bool mbOverrideDefaultFlying;
	
	float[] mfParticleBrightnessDefault = {0.f, 0.f, 0.f};
	float mfBillboardBrightnessDefault;
	float[] mfLightBrightnessDefault = {0.f, 0.f};
	
	float[] mfParticleBrightnessGoal = {0.f, 0.f, 0.f};
	float[] mfParticleBrightness = { 1.0f, 1.0f, 1.0f };
	float mfBillboardBrightnessGoal;
	float[] mfLightBrightnessGoal = {0.f, 0.f};
	float mfCoverageGoal;
	float mfCustomCoverageGoal;
	
	float[] mfParticleBrightnessFadeSpeed = {0.f, 0.f, 0.f};
	float mfBillboardBrightnessFadeSpeed;
	float[] mfLightBrightnessFadeSpeed = {0.f, 0.f};
	float mfCoverageFadeSpeed;
	
	float mfEffectBrightnessMul;
	float mfEffectBrightnessMulGoal;
	float mfEffectBrightnessMulFadeSpeed;
	
	float mfDeactivationCount;
	float mfDeactivationTime;
	
	bool mbTurnTowardPlayer;
	bool mbAboutToMove;
	bool mbTurnInstantlyToNextNode;
	bool mbExactStopAtEnd;
	cVector3f mvMovePos;
	tString msMoveCallback;
	
	cVector3f mvBillboardOffset;
	
	tID[] m_idLightId = { tID_Invalid, tID_Invalid };
	tString[] msParticles = { "PS_1", "PS_2", "PS_3" };
	tID m_idBillboardId;
	tID m_idParentId;
	tID m_idSoundId;
	
	tString msHeadTracker_TargetEntity;
	
	cLuxStateMachine@ mpStateMachine;
