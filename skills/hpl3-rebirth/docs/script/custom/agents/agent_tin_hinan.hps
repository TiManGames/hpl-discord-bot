////////////////////////////////
// TIN HINAN                  //
////////////////////////////////

//----------------------------------------------------------------------

#include "agents/Agent_Humanoid.hps"
#include "helpers/helper_player.hps"
#include "helpers/helper_effects.hps"
#include "custom/player/PlayerTypes_Custom.hps"
#include "base/Base_Types.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "custom/helpers/helper_player_custom.hps"
#include "custom/agents/agent_types_custom.hps"
#include "custom/helpers/helper_modules_custom.hps"

//----------------------------------------------------------------------

tString gsTinHinanSound_TurnOnLight = "creatures/foley/creature/wraith/Turns_on_light";
tString gsTinHinanSound_TurnOffLight = "creatures/foley/creature/wraith/Turns_off_light";
tString gsTinHinanSound_SpotlightLoop = "creatures/foley/creature/wraith/spotlight_sound";
tString gsTinHinanSound_SpotlightMoveLoop = "creatures/foley/creature/tin_hinan/tin_hinan_beam_sweep";

float gfTinHinanDefaultCrystalSightRange = 33.5f;
float gfTinHinanDefaultCrystalSightRangeMul = 1.f;

//----------------------------------------------------------------------

class cTinHinanSpotlightBillboard
{
	tID m_idBillboard = tID_Invalid;
	int mlRaycastIndex = 0;
	bool mbAvailable = true;
	cVector3f mvForward;
	float mfMaxBrightness = 2;
	float mfBrightness = 0;
	bool mbTurnOn = false;
	bool mbTurnOff = false;
}

//----------------------------------------------------------------------

enum eTinHinanState
{
	eTinHinanState_TinHinan,
}

//----------------------------------------------------------------------

enum eTinHinanLightMovement
{
	eTinHinanLightMovement_None,
	eTinHinanLightMovement_Turn,
	eTinHinanLightMovement_Forward,
	eTinHinanLightMovement_ForwardOffset,
	eTinHinanLightMovement_FollowPosition,
	eTinHinanLightMovement_SidewaysEight,
	eTinHinanLightMovement_Scan,
	eTinHinanLightMovement_LeftToRight,
	eTinHinanLightMovement_FollowEntity,
}

//----------------------------------------------------------------------

class cScrAgentTinHinan : cScrAgentHumanoid
{
	//===========================================================

	//////////////////////////////////////////
	//=======================================
	// MAIN FUNCTIONS
	//=======================================
	//{///////////////////////////////////////
	//===========================================================
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	//{///////////////////////////////////////
		
	//------------------------------------------------------------
		
	void Init()
	{
		msHeadTracker_TargetEntity = "";
		mBaseObj.SetUpdatePlayerDetection(false);
	}
		
	//} END INIT
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// LOADING
	//{////////////////////////////////////////
		
	//------------------------------------------------------------
		
	void SetupCharBody()
	{
		cScrAgentHumanoid::SetupCharBody();
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		pCharBody.SetMass(80);
		pCharBody.SetMaxPositiveMoveSpeed(eCharDir_Forward,1.0f);
		pCharBody.SetMoveSpeedMul(eCharDir_Forward,1);
		pCharBody.SetMoveAcc(eCharDir_Forward,4);
		pCharBody.SetMoveDeacc(eCharDir_Forward,8);
		pCharBody.SetMaxPushMass(20);
		pCharBody.SetMaxPushForce(300);
		pCharBody.SetAccurateClimbing(true);
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrAgentHumanoid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		//////////////////////
		// General Setup
		mBaseObj.SetAlignEntityWithGroundRay(true);
		mBaseObj.SetFOV(cMath_ToRad(120.0f));
		mBaseObj.SetSightRange(80.0f);
		mBaseObj.SetSightRangeMul(1.0f);
		mBaseObj.SetRelativeEyeHeight(0.55f);
		
		////////////
		// Pathfinder Setup
		mpPathfinder.SetNodeContainerName("TinHinan");
		mpPathfinder.SetMaxHeight(4.0f);
				
		SetupComponents(apWorld, apVars, apInstanceVars);
		
		Entity_Preload(msCrystalModel);
		
		mpStateMachine.ChangeState(eTinHinanState_TinHinan);
	}
	
	//------------------------------------------------------------
	
	void SetupComponents(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		////////////
		// State Machine
		@mpStateMachine = cLux_CreateEntityComponent_StateMachine(mBaseObj);
		mpStateMachine.AddState("TinHinan", eTinHinanState_TinHinan);
				
		////////////
		// Mover Setup
		mpMover.SetWallAvoidanceActive(true);
		mpMover.SetupWallAvoidance(4.0f, 10.0f, 4);
		mpMover.SetupDynamicObjectAvoidance(1.7f, 10, 3);
		mpMover.SetVerticalMoveSpeedExtraAnimMul(0.5f);
		mpMover.SetMaxForwardSpeed(1);
		mpMover.SetMaxBackwardSpeed(1);
		mpMover.SetRunToWalkSpeed(1.9);
		mpMover.SetWalkToRunSpeed(2.0);
		mpMover.SetTurnSpeedMul(2.f);
						
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		pCharBody.SetGravityActive(false);
		pCharBody.SetDeaccelerateMoveSpeedInAir(true);
		pCharBody.SetForceVelocity(cVector3f_Zero);
		pCharBody.SetEntityPitchAmount(0);
		mpMover.SetUse3DMovement(true);
		mpMover.SetBankingActive(false);
		
		mbFlyMode_Active = true;		
		mfSoundRadiusMul = 3.f;
		
		/////////////////////
		// Head tracker
		@mpHeadTracker = cLux_CreateEntityComponent_HeadTracker(mBaseObj);
		mpHeadTracker.LoadFromVariables(apVars);
		
		msHeadTracker_TargetEntity = apInstanceVars.GetVarString("HeadTracker_TargetEntity", "");
		if (msHeadTracker_TargetEntity == "")
			msHeadTracker_TargetEntity = "Player";
		
		mpHeadTracker.SetActive(apInstanceVars.GetVarBool("HeadTracker_Active", true));
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad()
	{
		cScrAgentHumanoid::OnAfterWorldLoad();
		
		if (msHeadTracker_TargetEntity != "")
		{
			iLuxEntity@ pEntity = mBaseObj.GetMap().GetEntityByName(msHeadTracker_TargetEntity);
			if (pEntity !is null)
				mpHeadTracker.SetTrackEntity(pEntity);
			else
				Error("Could not find headtracker target entity '"+msHeadTracker_TargetEntity+"' for entity '"+mBaseObj.GetName()+"'");
		}
	}
	
	//------------------------------------------------------------
	
	//} END Loading
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	//{///////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		cScrAgentHumanoid::OnUpdate(afTimeStep);
		if(mBaseObj.IsActive()==false) return;

		UpdateCustomSpotlightFollow(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afDeltaTime)
	{
		if (mbStarted == false)
		{
			OnStart();
			mbStarted = true;
		}
		
		UpdateSpotlightBillboards(afDeltaTime);
		UpdateLineOfSight(afDeltaTime);
		UpdateSpotlight(afDeltaTime);	
		UpdateSounds(afDeltaTime);
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
		cScrAgentHumanoid::ResetProperties();
	}
	
	//------------------------------------------------------------
	
	void OnStart()
	{
		RegisterWithFearHandler();
	}
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		cScrAgentHumanoid::OnSetActive(abX);
		if (abX == false)
		{			
			mlSpotlight_ActivationIndex = 3;
			SetSpotLightActive(false, false);
			mlSpotlight_ActivationIndex = 0;

			if (mlSpotlightFOVShakeID >= 0)
			{
				Effect_FOV_Shake_FadeOut(mlSpotlightFOVShakeID, 0.5);
				mlSpotlightFOVShakeID = -1;
			}		

			array<tID> vBillboards;
			for (int i = 0; i < mvSpotlightBillboards.size(); ++i)
			{
				cTinHinanSpotlightBillboard@ pBillboard = mvSpotlightBillboards[i];
				cLux_ID_Billboard(pBillboard.m_idBillboard).SetVisible(false);
				vBillboards.push_back(pBillboard.m_idBillboard);
			}
			
			Blackboard_ReleaseWraithBillboards(mBaseObj.GetID(), vBillboards);
			
			mvSpotlightBillboards.resize(0);
			mbSpotlightBillboard_Init = false;
		}
		else
		{
			RegisterWithFearHandler();
		}
	}
	
	//------------------------------------------------------------
	
	//} END GENERAL
	
	//------------------------------------------------------------
		
	//}END MAIN FUNCTIONS

	//===========================================================
	
	/////////////////////////////////////////
	//=======================================
	// HELPERS
	//=======================================
	//{//////////////////////////////////////
	
	//===========================================================
		
	//------------------------------------------------------------
	
	void RegisterWithFearHandler()
	{
		if (mbRegisteredWithFearHandler) return;
		mbRegisteredWithFearHandler = true;
		
		iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
		cFearThreatParams mFearParams;
		mFearParams.m_idEntity = mBaseObj.GetID();
		mFearParams.mfBaseFearRate = 0.2f;
		mFearParams.mfSurpriseFactor = 0.4f;
		mFearParams.mfLookAtFactor = 0.15f;
		mFearParams.mfActivationDistance = 20.0f;
		mFearParams.mfDeactivationDistance = 25.0f;
		mFearParams.mfActivationDelay = 0.2f;
		mFearParams.mfActivationLightLevel = -1.0f;
		mFearParams.mbLookAtDetectWholeArea = false;
		mFearParams.mfMaxFearDist = 6.0f;
		mFearParams.mfMinFearDist = 15.0f;
		pHandler.RegisterThreatAgent(mFearParams);
	}

	//------------------------------------------------------------
	
	void ExecuteEntityCallback(const tString &in asFunc)
	{
		if (asFunc == "") return;
		
		tString sMethodName = "void " + asFunc + "(const tString &in asEntity)";
		cLuxMap@ pMap = mBaseObj.GetMap();
		if (pMap.ScriptMethodExists(sMethodName) && pMap.ScriptPrepare(sMethodName))
		{
			tString sName = mBaseObj.GetName();
			pMap.SetArgString(0, sName);
			pMap.ScriptExecute();
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// SOUNDS
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
		
	tID m_idSfx_SpotlightSound = tID_Invalid;
	bool mbSfx_SpotlightSoundActive = false;
	float mfSfx_SpotlightSoundActiveMul = 0;
	float mfSfx_SpotlightSoundVolume = 1.0f;
	float mfSfx_SpotlightSoundVolumeMul = 0.0f;
	float mfSfx_SpotlightSoundVolumeMulGoal = 1.0f;
	
	tID m_idSfx_SpotlightTurnSound = tID_Invalid;
	float mfSfx_SpotlightTurnSoundVolume = 1.0f;
	float mfSfx_SpotlightTurnSoundVolumeMul = 0.0f;
	float mfSfx_SpotlightTurnSoundVolumeMulGoal = 0.5f;
	
	float mfSfx_VolumeMul = 1.0f;
	float mfSfx_VolumeMulGoal = 1.0f;

	//------------------------------------------------------------
	
	void UpdateSounds(float afTimeStep)
	{
		/////////////////////////
		// Update volume muls
		mfSfx_VolumeMul = cMath_IncreaseTo(mfSfx_VolumeMul, afTimeStep, mfSfx_VolumeMulGoal);
		
		float fSpotlightSoundActiveMulTar = mbSfx_SpotlightSoundActive ? 1 : 0;
		mfSfx_SpotlightSoundActiveMul = cMath_IncreaseTo(mfSfx_SpotlightSoundActiveMul, afTimeStep, fSpotlightSoundActiveMulTar);
		
		mfSfx_SpotlightSoundVolumeMul = cMath_IncreaseTo(mfSfx_SpotlightSoundVolumeMul, (1.f / 3.f) * afTimeStep, mfSfx_SpotlightSoundVolumeMulGoal);
		mfSfx_SpotlightSoundVolumeMul *= mfSfx_VolumeMul;
		mfSfx_SpotlightSoundVolumeMul *= mfSfx_SpotlightSoundActiveMul;
		
		mfSfx_SpotlightTurnSoundVolumeMul = cMath_IncreaseTo(mfSfx_SpotlightTurnSoundVolumeMul, (1.f / 3.f) * afTimeStep, mfSfx_SpotlightTurnSoundVolumeMulGoal);
		mfSfx_SpotlightTurnSoundVolumeMul *= mfSfx_VolumeMul;
								
		/////////////////////////
		// Update sounds
		if (m_idSfx_SpotlightSound == tID_Invalid)
		{
			cSoundEntity@ pSound = mBaseObj.GetMap().GetWorld().CreateSoundEntity(mBaseObj.GetName() + "_SpotlightSound", gsTinHinanSound_SpotlightLoop, true);			
			m_idSfx_SpotlightSound = pSound.GetID();
			
			pSound.SetCustomMaxDistance(75.f);
			pSound.SetCustomMinDistance(20.f);
			pSound.SetUseCustomProperties(true);
			
			pSound.SetVolume(mfSfx_SpotlightSoundVolume);
			pSound.FadeVolumeMul(0, 0);
		}
		else
		{
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_SpotlightSound);
			if (pSound !is null)
			{
				float fSoundPosDist = cMath_Min(mBaseObj.GetDistanceToPlayer() - 3.f, mfCrystal_SightRange * mfCrystal_SightRangeMul);
				cVector3f vPos = GetCrystalPos() + GetCrystalDir() * fSoundPosDist;
				pSound.SetPosition(vPos);
				
				float fDistToPlayer = (vPos - mBaseObj.GetPlayerPos()).Length();
				float fVolume = cMath_Clamp(1.f - cMath_Clamp((fDistToPlayer / 20.f), 0.0f, 1.0f), 0.0f, 1.f);
				
				fVolume = cMath_Easing(eEasing_QuadOut, fVolume);
				float fSpeed = 0.f;				
				
				if (mbCrystal_Active == false)
				{
					fVolume = 0.f;
					fSpeed = 1.f;
				}
				
				pSound.FadeVolumeMul(fVolume * mfSfx_SpotlightSoundVolumeMul, fSpeed);
			}
		}
		
		if (m_idSfx_SpotlightTurnSound == tID_Invalid)
		{
			cSoundEntity@ pSound = mBaseObj.GetMap().GetWorld().CreateSoundEntity(mBaseObj.GetName() + "_SpotlightTurnSound", gsTinHinanSound_SpotlightMoveLoop, true);
			m_idSfx_SpotlightTurnSound = pSound.GetID();
			
			pSound.SetCustomMaxDistance(75.f);
			pSound.SetCustomMinDistance(20.f);
			pSound.SetUseCustomProperties(true);
			
			pSound.SetVolume(mfSfx_SpotlightTurnSoundVolume);
			pSound.FadeVolumeMul(0, 0);
		}
		else
		{
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idSfx_SpotlightTurnSound);
			if (pSound !is null)
			{
				float fSoundPosDist = cMath_Min(mBaseObj.GetDistanceToPlayer() - 3.f, mfCrystal_SightRange * mfCrystal_SightRangeMul);
				cVector3f vPos = GetCrystalPos() + GetCrystalDir() * fSoundPosDist;				
				pSound.SetPosition(vPos);
				
				float fVolume = mSpotlightMovement == eTinHinanLightMovement_Turn ? 1.0f : 0.0f;
				float fSpeed = 0.f;
				
				if (mbCrystal_Active == false)
				{
					fVolume = 0.f;
					fSpeed = 1.f;
				}
					
				pSound.FadeVolumeMul(fVolume * mfSfx_SpotlightTurnSoundVolumeMul, fSpeed);
			}
		}
	}
	
	//------------------------------------------------------------
	
	//} END SOUNDS
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CUSTOM SPOTLIGHT FOLLOW
	//{//////////////////////////////////////
	
	cVector3f mvFollowTarget_Offset = 0.f;
	bool mbFollowTarget_LocalOffset = false;
	
	//------------------------------------------------------------
	
	void UpdateCustomSpotlightFollow(float afTimeStep)
	{
		if (m_idCrystal_FollowTarget == tID_Invalid) return;
		
		iLuxEntity@ pEnt = cLux_ID_Entity(m_idCrystal_FollowTarget);
		if (pEnt is null)
		{
			m_idCrystal_FollowTarget = tID_Invalid;
			return;
		}
		
		cVector3f vOffset = mvFollowTarget_Offset;
		if (mbFollowTarget_LocalOffset)
		{
			cLuxAgent@ pAgent = cLux_ToAgent(pEnt);
			if (pAgent !is null)
				vOffset = cMath_MatrixMul(cMath_MatrixRotateY(pAgent.GetCharBody().GetYaw() + cMath_Pi), vOffset);
			else
				vOffset = cMath_MatrixMul(pEnt.GetMatrix().GetRotation(), vOffset);
		}			
		
		cVector3f vPos = pEnt.GetPosition() + vOffset;		
		TurnSpotlightToPos(vPos, true, true, 10.f);
	}
	
	//------------------------------------------------------------
	
	//} END CUSTOM SPOTLIGHT FOLLOW
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LINE OF SIGHT
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbPlayerCameraLineOfSight = false;
	int mlLosIndex = 0;
	int mlPlayerCamerLosCount = 0;
	cVector3f mvCrytalLosCheckPos = 0.f;
	
	//------------------------------------------------------------
	
	void UpdateLineOfSight(float afTimeStep)
	{
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		if (pCrystal !is null)
		{
			// Check los from position crystal had when the struggle started
			cVector3f vCrystalPos = pCrystal.GetPosition();
			if (mbTinHinan_InStruggle == false)		mvCrytalLosCheckPos = vCrystalPos;
			else 									vCrystalPos = mvCrytalLosCheckPos;
			
			if (mlLosIndex == 0)
			{
				cVector3f vDir = cLux_GetPlayer().GetCamera().GetPosition() - vCrystalPos;
				mBaseObj.GetClosestBody("OnRaycast_UpdateLineOfSight", vCrystalPos, cMath_Vector3Normalize(vDir), vDir.Length(), mlLosIndex);
			}
			else if (mlLosIndex == 1)
			{
				cVector3f vPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
				cVector3f vDir = vPos - vCrystalPos;
				mBaseObj.GetClosestBody("OnRaycast_UpdateLineOfSight", vCrystalPos, cMath_Vector3Normalize(vDir), vDir.Length(), mlLosIndex);
			}
			
			++mlLosIndex;
			mlLosIndex %= 2;
		}		
	}
	
	//------------------------------------------------------------
	
	void OnRaycast_UpdateLineOfSight(bool abSuccesful, float afDistance, const cVector3f&in avNormal, iPhysicsBody@ apBody, int alUservalue)
	{
		if (abSuccesful == false)
		{
			++mlPlayerCamerLosCount;
		}
		
		if (alUservalue == 1)
		{
			mbPlayerCameraLineOfSight = mlPlayerCamerLosCount > 0;
			mlPlayerCamerLosCount = 0;
		}
	}
	
	//------------------------------------------------------------
	
	//} END LINE OF SIGHT
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CRYSTAL
	//{//////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbCrystal_Active = false;
	bool mbCrystal_HelperActive = false;
	bool mbCrystal_HelperActivation = false;
	float mfCrystal_SightRange = gfTinHinanDefaultCrystalSightRange;
	float mfCrystal_SightRangeMul = gfTinHinanDefaultCrystalSightRangeMul;
	
	tID m_idCrystal;
	tID m_idCrystal_FollowTarget;
	[nosave] tString msCrystalModel = "tin_hinan_crystal.ent";
	eTinHinanLightMovement mSpotlightMovement = eTinHinanLightMovement_Forward;
	cVector3f mvCrystal_CurrentDir;
	cVector3f mvCrystal_TargetDir;
	float mfCrystal_TargetHAngle = 0;
	float mfCrystal_TargetVAngle = 0;
	float mfCrystal_CurrentVAngle = 0;
	float mfCrystal_CurrentHAngle = 0;
	bool mbCrystal_PlayerDetected = false;
	bool mbCrystal_PlayerSeen = false;
	bool mbSpotlight_WhiteEffect = false;
	
	float mfSpotlight_MovementTimer = 0.0f;
	float mfSpotlight_DetectedTimer = 0.0f;
	float mfSpotlight_DetectedMul = 1.0f;
	
	float mfSpotlight_Fov = 14.f;
	float mfSpotlight_Aspect = 0.7f;
	float mfSpotlight_ForwardOffsetH = 0;
	float mfSpotlight_ForwardOffsetTargetH = 0;
	float mfSpotlight_ForwardOffsetV = 0;
	float mfSpotlight_ForwardOffsetTargetV = 0;
	float mfSpotlight_FollowPositionH = 0;
	float mfSpotlight_FollowPositionTargetH = 0;
	float mfSpotlight_FollowPositionV = 0;
	float mfSpotlight_FollowPositionTargetV = 0;
	float mfSpotlight_TurningDoneMul = 1.0f;
	float mfSpotlight_TurnHTarget = 0;
	float mfSpotlight_TurnVTarget = 0;
	float mfSpotlight_TurnSpeed = 0;
	float mfSpotlight_LerpSpeed = 0;
	float mfSpotlight_LerpSpeedMul = 1.f;
	float mfSpotlight_LerpSpeedTransitionTimer = 0;
	int mlSpotlight_ActivationIndex = 0;
	bool mbSpotlight_ActivationReset = true;
	
	cVector3f mvSpotlight_RaycastPos;
	cVector3f mvSpotlight_FollowPosition;
	
	cColor mSpotlightcolor;
	float mfSpotlightBrightnessMul = 1.0f;
	tID m_idSpotLight;
	tID m_idSpotLight_LensFlare;
	
	//------------------------------------------------------------
	
	void CreateCrystal()
	{
		if (m_idCrystal != tID_Invalid) return;
		if (msCrystalModel == "") return;

		mBaseObj.GetMap().CreateEntity(mBaseObj.GetName() + "_crystal", msCrystalModel, cMatrixf_Identity, cVector3f_One);
		
		iLuxEntity@ pEnt = mBaseObj.GetMap().GetLatestEntity();
		if (pEnt is null) return;
						
		pEnt.AttachToSocket(cLux_ID_Entity(mBaseObj.GetID()), "wraith_crystal", false, true);
		m_idCrystal = pEnt.GetID();
		
		iLight@ pLight = pEnt.GetLightFromName("Light_Spot_1");
		if (pLight !is null) m_idSpotLight = pLight.GetID();
						
		cLightSpot@ pSpot = cast<cLightSpot>(cLux_ID_Light(m_idSpotLight));
		mfSpotlight_Aspect = pSpot.GetAspect();
		mfSpotlight_Fov = cMath_ToDeg(pSpot.GetFOV());
		
		cLensFlare@ pFlare = pEnt.GetLensFlareFromName("LensFlare_1");
		if (pFlare !is null) m_idSpotLight_LensFlare = pFlare.GetID();
		
		SetSpotLightActive(false, true);
		SetSpotLightColor(mTinHinan_SpotlightColorIdle);

		mBaseObj.Timer_Remove("Timer_SetCrystalColor");
//		mBaseObj.Timer_Add("Timer_SetCrystalColor", 0.2f, "OnTimer_SetCrystalColor");
				
		mvCrystal_CurrentDir = mvCrystal_TargetDir = mBaseObj.GetCharBody().GetForward();
		TurnSpotlightToDir(mvCrystal_TargetDir, true, false);
	}
	
	void OnTimer_SetCrystalColor(uint64 alID)
	{
		if (m_idCrystal != tID_Invalid) cLux_ID_Entity(m_idCrystal).GetMeshEntity().SetIlluminationColor(cColor(1.0f,1.0f,1.0f) * 1.4f);
	}

	//------------------------------------------------------------
	
	void UpdateSpotlight(float afTimeStep)
	{
		if (m_idCrystal == tID_Invalid) return;
		
		if (mlSpotlight_ActivationIndex < 3)
		{
			++mlSpotlight_ActivationIndex;
			if (mlSpotlight_ActivationIndex == 3)
			{
				if (mbCrystal_HelperActivation)
				{
					mbCrystal_HelperActivation = false;
					mbCrystal_Active = mbCrystal_HelperActive;
				}
				
				SetSpotLightActive(mbCrystal_Active);
				if (mbSpotlight_ActivationReset) ResetSpotlightDir();
			}
		}
				
		///////////////////////////
		// Update movement
		iLuxEntity@ pEnt = cLux_ID_Entity(m_idCrystal);					
		if (mSpotlightMovement == eTinHinanLightMovement_Turn)
		{
			mfSpotlight_LerpSpeed = 4.0f * mfSpotlight_LerpSpeedMul;
			mfCrystal_TargetHAngle = cMath_IncreaseTo(mfCrystal_TargetHAngle, mfSpotlight_TurnSpeed * afTimeStep, mfSpotlight_TurnHTarget);
			mfCrystal_TargetVAngle = cMath_IncreaseTo(mfCrystal_TargetVAngle, mfSpotlight_TurnSpeed * afTimeStep, mfSpotlight_TurnVTarget);
		}
		else if (mSpotlightMovement == eTinHinanLightMovement_Forward)
		{
			mfSpotlight_LerpSpeed = 1.0f;
			
			cVector3f vForward = mBaseObj.GetCharBody().GetForward();
			vForward.y -= 0.15f;
			SetSpotlightTargetDir(vForward);
		}
		else if (mSpotlightMovement == eTinHinanLightMovement_ForwardOffset)
		{
			cVector3f vFwd = mBaseObj.GetCharBody().GetForward();
			vFwd.y = 0;
			
			mfSpotlight_LerpSpeed = 0.8f;
			GetSpotlightAngle(vFwd, mfCrystal_TargetHAngle, mfCrystal_TargetVAngle);
			mfSpotlight_ForwardOffsetH = cMath_IncreaseTo(mfSpotlight_ForwardOffsetH, 0.8f * afTimeStep, mfSpotlight_ForwardOffsetTargetH);
			mfSpotlight_ForwardOffsetV = cMath_IncreaseTo(mfSpotlight_ForwardOffsetV, 0.8f * afTimeStep, mfSpotlight_ForwardOffsetTargetV);
			mfCrystal_TargetHAngle = ClosestAngleToAngle(mfCrystal_TargetHAngle, mfCrystal_CurrentHAngle) + mfSpotlight_ForwardOffsetH;
			mfCrystal_TargetVAngle = ClosestAngleToAngle(mfCrystal_TargetVAngle, mfCrystal_CurrentVAngle) + mfSpotlight_ForwardOffsetV;
		}
		else if (mSpotlightMovement == eTinHinanLightMovement_FollowPosition)
		{
			mfSpotlight_LerpSpeed = 2.0f;
			GetSpotlightAngle(GetCrystalToPosDir(mvSpotlight_FollowPosition), mfSpotlight_FollowPositionTargetH, mfSpotlight_FollowPositionTargetH);
			mfSpotlight_FollowPositionTargetH = ClosestAngleToAngle(mfSpotlight_FollowPositionTargetH, mfCrystal_CurrentHAngle);
			mfSpotlight_FollowPositionTargetV = ClosestAngleToAngle(mfSpotlight_FollowPositionTargetV, mfCrystal_CurrentVAngle);
			mfSpotlight_FollowPositionH = cMath_IncreaseTo(mfSpotlight_FollowPositionH, 1.5f * afTimeStep, mfSpotlight_FollowPositionTargetH);
			mfSpotlight_FollowPositionV = cMath_IncreaseTo(mfSpotlight_FollowPositionV, 1.5f * afTimeStep, mfSpotlight_FollowPositionTargetV);
			mfCrystal_TargetHAngle = mfSpotlight_FollowPositionH;
			mfCrystal_TargetVAngle = mfSpotlight_FollowPositionV;
//			SetSpotlightTargetDir(GetCrystalToPosDir(mvSpotlight_FollowPosition));
		}
		else if (mSpotlightMovement == eTinHinanLightMovement_SidewaysEight)
		{
			
			mfSpotlight_LerpSpeed = 5.0f * mfSpotlight_SidewaysEightSpeed;
			mfSpotlight_MovementTimer += mfSpotlight_SidewaysEightSpeed * afTimeStep;
			
			cVector3f vForward = cVector3f_Zero;
			if (mbSpotlight_UseCustomTarget)
			{
				iLuxEntity@ pTargetEntity = cLux_ID_Entity(m_idSpotlight_TargetEntity);
				if (pTargetEntity !is null)
				{
					vForward = GetCrystalToPosDir(pTargetEntity.GetPosition());
				}
				else
				{
					vForward = GetCrystalToPosDir(mvSpotlight_CustomTarget);
				}
			}
			else
			{
				vForward = mBaseObj.GetCharBody().GetForward();
				vForward.y -= 0.15f;
			}
			
			vForward = GetLeminscateMovement(mfSpotlight_MovementTimer, vForward, mfSpotlight_SidewaysEightHMul, mfSpotlight_SidewaysEightVMul);
			SetSpotlightTargetDir(vForward);
		}
		else if (mSpotlightMovement == eTinHinanLightMovement_Scan)
		{
			mfSpotlight_LerpSpeed = 1.0f;
			mfSpotlight_MovementTimer += mfSpotlight_ScanSpeed * afTimeStep;
			
			cVector3f vForward = mvSpotlight_ScanDir;
			vForward = GetScanMovement(mfSpotlight_MovementTimer, vForward, mfSpotlight_ScanHMul, mfSpotlight_ScanVMul);
			SetSpotlightTargetDir(vForward);
		}
		else if (mSpotlightMovement == eTinHinanLightMovement_LeftToRight)
		{
			mfSpotlight_LerpSpeed = 5.0f;
			mfSpotlight_MovementTimer += mfSpotlight_LeftRightSpeed * afTimeStep;
			
			cVector3f vForward = mBaseObj.GetCharBody().GetForward();
			
			cQuaternion q;
			q.FromAngleAxis(-cMath_ToRad(mfSpotlight_LeftRightAngle), mBaseObj.GetCharBody().GetRight());
			
			vForward = cMath_MatrixMul(cMath_MatrixQuaternion(q), vForward);
			
			vForward = GetLeftAndRightMovement(mfSpotlight_MovementTimer, vForward, mfSpotlight_LeftRightHMul);
			SetSpotlightTargetDir(vForward);
		}
		else if (mSpotlightMovement == eTinHinanLightMovement_FollowEntity)
		{
			mfSpotlight_LerpSpeed = 1.0f;
			iLuxEntity@ pTargetEntity = cLux_ID_Entity(m_idSpotlight_FollowEntity);
			if (pTargetEntity !is null)
			{
				cVector3f vForward = GetCrystalToPosDir(pTargetEntity.GetPosition());
				SetSpotlightTargetDir(vForward);
			}
			else
			{
				mSpotlightMovement = eTinHinanLightMovement_None;
			}
		}
		
		///////////////////////////
		// Update current angles
		float fLerpSpeed = mfSpotlight_LerpSpeed;
		if (mfSpotlight_LerpSpeedTransitionTimer > 0.0f)
		{
			mfSpotlight_LerpSpeedTransitionTimer -= afTimeStep;
			float fTransitionMul = 1.0f - cMath_Clamp(mfSpotlight_LerpSpeedTransitionTimer / 3.0f, 0.0f, 1.0f);
			fLerpSpeed *= ((fTransitionMul * 0.8f) + 0.2f);
		}
				
		mfCrystal_CurrentHAngle += (mfCrystal_TargetHAngle - mfCrystal_CurrentHAngle) * fLerpSpeed * afTimeStep;
		mfCrystal_CurrentVAngle += (mfCrystal_TargetVAngle - mfCrystal_CurrentVAngle) * fLerpSpeed * afTimeStep;
						
		float fAbs = cMath_Abs(mfCrystal_CurrentHAngle);
		if (fAbs > cMath_ToRad(180.0f))
		{
			float fBefore = mfCrystal_CurrentHAngle;
			mfCrystal_TargetHAngle += mfCrystal_CurrentHAngle > 0 ? -cMath_ToRad(360.0f) : cMath_ToRad(360.0f);
			mfSpotlight_TurnHTarget += mfCrystal_CurrentHAngle > 0 ? -cMath_ToRad(360.0f) : cMath_ToRad(360.0f);
			mfCrystal_CurrentHAngle += mfCrystal_CurrentHAngle > 0 ? -cMath_ToRad(360.0f) : cMath_ToRad(360.0f);
		}
		
		///////////////////////////
		// Turning done? Send message!
		if (mSpotlightMovement == eTinHinanLightMovement_Turn)
		{
			float fAngleDiff = cMath_Abs(mfSpotlight_TurnHTarget - mfCrystal_CurrentHAngle) + cMath_Abs(mfSpotlight_TurnVTarget - mfCrystal_CurrentVAngle);
			if (fAngleDiff <= cMath_ToRad(5.0f) * mfSpotlight_TurningDoneMul)
			{
				mSpotlightMovement = eTinHinanLightMovement_None;
				mBaseObj.BroadcastMessage(eCustomEntityMessage_SpotlightTurnDone, null, mBaseObj.GetPosition(), 0);
			}
		}
			
		///////////////////////////
		// Calculate new rot
		cQuaternion q1;
		q1.FromAngleAxis(-mfCrystal_CurrentHAngle + cMath_Pi, cVector3f_Up);
		
		cVector3f vForward = cMath_MatrixMul(cMath_MatrixQuaternion(q1), cVector3f_Forward);
		vForward.Normalize();
		
		cVector3f vLeft = cMath_Vector3Cross(vForward, cVector3f_Up);
		vLeft.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vLeft, vForward);
		vLeft.Normalize();
		
		cQuaternion q2;
		q2.FromAngleAxis(mfCrystal_CurrentVAngle, vLeft);
		
		cQuaternion q3 = q2 * q1;
		
		cMatrixf mtxNew = pEnt.GetMatrix();
		mtxNew.SetRotation(cMath_MatrixQuaternion(q3));
		
		pEnt.SetMatrix(mtxNew);
		
		mvCrystal_CurrentDir = pEnt.GetMatrix().GetTranspose().GetForward();
		
		// Cast ray and find where the spotlight hits an object
		mBaseObj.GetClosestBody("OnRaycast_FindSpotlightHit", pEnt.GetPosition(), mvCrystal_CurrentDir, mfCrystal_SightRange * mfCrystal_SightRangeMul);
		
		mbTinHinan_PlayerSeen = mbCrystal_Active && GetPlayerIsSeen();

		mbCrystal_PlayerSeen = false;		
											
		float fDetectionAdd = 0.0f;
		if (mbCrystal_PlayerSeen)
		{
			float fCrouchMul = 1.0f;
			fDetectionAdd = 1.6f * fCrouchMul;
			if (Player_GetHiding()) fDetectionAdd = 0.6f;
		}
		else fDetectionAdd = -0.8f;
						
		mfSpotlight_DetectedTimer += fDetectionAdd * mfSpotlight_DetectedMul * afTimeStep;
		mfSpotlight_DetectedTimer = cMath_Clamp(mfSpotlight_DetectedTimer, 0.0f, 1.0f);
		
		if (mbCrystal_PlayerDetected == false && mfSpotlight_DetectedTimer >= 1.0f)
		{
			mbCrystal_PlayerDetected = true;
			mBaseObj.BroadcastMessage(eLuxEntityMessage_PlayerDetected, null, mBaseObj.GetPlayerPos(), 0);
		}
		else if (mbCrystal_PlayerDetected && mfSpotlight_DetectedTimer < 0.8f)
		{
			mbCrystal_PlayerDetected = false;
			mBaseObj.BroadcastMessage(eLuxEntityMessage_PlayerUndetected, null, mBaseObj.GetPlayerPos(), 0);
		}
		
		// white screen effect for when you're in the beam
		if (mbCrystal_PlayerDetected && mbSpotlight_VisualsActive && mbSpotlight_WhiteEffect == false)
		{
			mbSpotlight_WhiteEffect = true;
		}
		else if ((mbCrystal_PlayerDetected == false || mbSpotlight_VisualsActive == false) && mbSpotlight_WhiteEffect)
		{
			mbSpotlight_WhiteEffect = false;
		}
	}
	
	void OnRaycast_FindSpotlightHit(bool abSuccesful, float afDistance, const cVector3f&in avNormal, iPhysicsBody@ apBody, int alUserValue)
	{
		if (abSuccesful) mvSpotlight_RaycastPos = GetCrystalPos() + mvCrystal_CurrentDir * afDistance;
		else mvSpotlight_RaycastPos = GetCrystalPos() + mvCrystal_CurrentDir * mfCrystal_SightRange * mfCrystal_SightRangeMul;
	}
	
	//------------------------------------------------------------
	
	bool GetPlayerIsSeen()
	{
		if (mbPlayerCameraLineOfSight == false) return false;
		if (GetCrystalToPos(mBaseObj.GetPlayerPos()).Length() > mfCrystal_SightRange * mfCrystal_SightRangeMul) return false;
		if (GetPointIsInFrontOfCrystal(mBaseObj.GetPlayerPos()) == false) return false;
		if (GetPointInCystalFOV(mBaseObj.GetPlayerPos()) == false) return false;
		return true;
	}
	
	//------------------------------------------------------------
	
	bool GetPointIsInFrontOfCrystal(const cVector3f &in avPoint)
	{
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		if (pCrystal is null) return false;
		
		cVector3f vToPoint = GetCrystalToPos(avPoint);
		float fDot = cMath_Vector3Dot(vToPoint, pCrystal.GetMatrix().GetTranspose().GetForward());
		return fDot >= 0.0;
	}
	
	//------------------------------------------------------------
	
	bool GetPointInCystalFOV(const cVector3f &in avPoint)
	{
		iLight @ pEnt = cLux_ID_Light(m_idSpotLight);
		if (pEnt is null) return false;
		
		cVector3f vPointDir = cMath_Vector3Normalize(avPoint - pEnt.GetWorldPosition());
		cVector3f vPosDirV = cMath_Vector3ProjectOnPlane(vPointDir, pEnt.GetWorldMatrix().GetTranspose().GetRight());
		cVector3f vPosDirH = cMath_Vector3ProjectOnPlane(vPointDir, pEnt.GetWorldMatrix().GetTranspose().GetUp());
		float fVAngle = cMath_Vector3Angle(cVector3f_Zero - pEnt.GetWorldMatrix().GetTranspose().GetForward(), cMath_Vector3Normalize(vPosDirV));
		float fHAngle = cMath_Vector3Angle(cVector3f_Zero - pEnt.GetWorldMatrix().GetTranspose().GetForward(), cMath_Vector3Normalize(vPosDirH));
		return fVAngle <= cMath_ToRad(mfSpotlight_Fov + 2.f) * 0.5f && fHAngle <= cMath_ToRad((mfSpotlight_Fov + 2.f) * mfSpotlight_Aspect) * 0.5f;
	}
	
	//------------------------------------------------------------
	
	float NormalizeAngle(float afAngle)
	{
		afAngle %= cMath_PiMul2;
		if (afAngle > cMath_Pi) return afAngle - cMath_PiMul2;
		else if (afAngle < -cMath_Pi) return afAngle + cMath_PiMul2;
		else return afAngle;
	}
	
	//------------------------------------------------------------
	
	float ClosestAngleToAngle(float afAngle, float afToAngle)
	{
		float fDist1 = cMath_Abs(afToAngle - afAngle);
		float fDist2 = cMath_Abs(afToAngle - (afAngle + cMath_PiMul2));
		float fDist3 = cMath_Abs(afToAngle - (afAngle - cMath_PiMul2));
		if (fDist2 <= fDist1 && fDist2 <= fDist3) return afAngle + cMath_PiMul2;
		if (fDist3 <= fDist1 && fDist3 <= fDist2) return afAngle - cMath_PiMul2;
		return afAngle;
	}
	
	//------------------------------------------------------------
	
	void ResetCrystalDetection()
	{
		mbCrystal_PlayerDetected = false;
		mfSpotlight_DetectedTimer = 0;
	}

	//------------------------------------------------------------
	
	cVector3f GetCrystalPos()
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		return cLux_ID_Entity(m_idCrystal).GetPosition();
	}
	
	//------------------------------------------------------------
	
	cVector3f GetCrystalToPlayerDir()
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		return cMath_Vector3Normalize(mBaseObj.GetPlayerPos() - cLux_ID_Entity(m_idCrystal).GetPosition());
	}
	
	//------------------------------------------------------------
	
	cVector3f GetCrystalToPos(const cVector3f &in avPos)
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		return avPos - cLux_ID_Entity(m_idCrystal).GetPosition();
	}
	
	cVector3f GetCrystalToPosDir(const cVector3f &in avPos)
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		return cMath_Vector3Normalize(avPos - cLux_ID_Entity(m_idCrystal).GetPosition());
	}
	
	cVector3f GetCrystalDir()
	{
		if (m_idCrystal == tID_Invalid) return cVector3f_Zero;
		iLuxEntity@ pCrystal = cLux_ID_Entity(m_idCrystal);
		return pCrystal.GetMatrix().GetTranspose().GetForward();
	}
	
	//------------------------------------------------------------
	
	void AddSpotlightMovementTransition()
	{
		mfSpotlight_LerpSpeedTransitionTimer = 3.0f;
	}
	
	//------------------------------------------------------------
	
	void StopSpotlightMovement()
	{
		mSpotlightMovement = eTinHinanLightMovement_None;
	}
	
	//------------------------------------------------------------
	
	void SetSpotlightMovement_Forward(bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
		mSpotlightMovement = eTinHinanLightMovement_Forward;
	}
	
	//------------------------------------------------------------
	
	void SetSpotlightMovement_ForwardOffset(float mfHOffset, float mfVOffset, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
		mSpotlightMovement = eTinHinanLightMovement_ForwardOffset;
		mfSpotlight_ForwardOffsetTargetH = mfHOffset;
		mfSpotlight_ForwardOffsetTargetV = mfVOffset;
	}
	
	//------------------------------------------------------------
	
	void SetSpotlightMovement_FollowPosition(const cVector3f &in avPos, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
		mSpotlightMovement = eTinHinanLightMovement_FollowPosition;
		mvSpotlight_FollowPosition = avPos;
	}
	
	//------------------------------------------------------------
	
	void SetSpotlightTargetDir(const cVector3f &in avDir, bool abClosestAngle = true)
	{
		mvCrystal_TargetDir = avDir;
		mvCrystal_TargetDir.Normalize();
		
		GetSpotlightAngle(mvCrystal_TargetDir, mfCrystal_TargetHAngle, mfCrystal_TargetVAngle);
		if (abClosestAngle)
		{
			mfCrystal_TargetHAngle = ClosestAngleToAngle(mfCrystal_TargetHAngle, mfCrystal_CurrentHAngle);
			mfCrystal_TargetVAngle = ClosestAngleToAngle(mfCrystal_TargetVAngle, mfCrystal_CurrentVAngle);
		}
	}
	
	void GetSpotlightAngle(const cVector3f &in avDir, float &out afHAngle, float &out afVAngle)
	{
		cVector3f vDirH = avDir;
		vDirH.y = 0;
		vDirH.Normalize();
		
		afHAngle = cMath_GetAngleFromPoints2D(0, cVector2f(avDir.x, avDir.z));
		afVAngle = cMath_Vector3Angle(vDirH, avDir) * cMath_Sign(avDir.y);
	}
	
	void GetClosestSpotlightAngle(const cVector3f &in avDir, float &out afHAngle, float &out afVAngle)
	{
		float fH = 0;
		float fV = 0;
		GetSpotlightAngle(avDir, fH, fV);
		afHAngle = ClosestAngleToAngle(fH, mfCrystal_CurrentHAngle);
		afVAngle = ClosestAngleToAngle(fV, mfCrystal_CurrentVAngle);
	}
	
	//------------------------------------------------------------
	
	void TurnSpotlightToAngle(float afHAngle, float afVAngle, bool abForce = false, bool abFade = true, float afTurnSpeed = 2.0f, float afTurningDoneMul = 1.0f)
	{
		if (m_idCrystal == tID_Invalid) return;
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
		
		mSpotlightMovement = eTinHinanLightMovement_Turn;
		;
		mfSpotlight_TurnHTarget = afHAngle;
		mfSpotlight_TurnVTarget = afVAngle;
				
		if (abFade == false)
		{
			mvCrystal_CurrentDir = mvCrystal_TargetDir;
			mfCrystal_CurrentHAngle = mfCrystal_TargetHAngle = mfSpotlight_TurnHTarget;
			mfCrystal_CurrentVAngle = mfCrystal_TargetVAngle = mfSpotlight_TurnVTarget;
		}
		
		mfSpotlight_TurnSpeed = afTurnSpeed;
		mfSpotlight_TurningDoneMul = afTurningDoneMul;
	}
	
	void TurnSpotlightToDir(const cVector3f &in avDir, bool abForce = false, bool abFade = true, float afTurnSpeed = 2.0f, float afTurningDoneMul = 1.0f)
	{
		if (m_idCrystal == tID_Invalid) return;
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
									
		mSpotlightMovement = eTinHinanLightMovement_Turn;
		
		mvCrystal_TargetDir = avDir;
		mvCrystal_TargetDir.Normalize();
		GetSpotlightAngle(mvCrystal_TargetDir, mfSpotlight_TurnHTarget, mfSpotlight_TurnVTarget);
		
		mfSpotlight_TurnHTarget = ClosestAngleToAngle(mfSpotlight_TurnHTarget, mfCrystal_CurrentHAngle);
		mfSpotlight_TurnVTarget = ClosestAngleToAngle(mfSpotlight_TurnVTarget, mfCrystal_CurrentVAngle);
		
		if (abFade == false)
		{
			mvCrystal_CurrentDir = mvCrystal_TargetDir;
			mfCrystal_CurrentHAngle = mfCrystal_TargetHAngle = mfSpotlight_TurnHTarget;
			mfCrystal_CurrentVAngle = mfCrystal_TargetVAngle = mfSpotlight_TurnVTarget;
		}
		
		mfSpotlight_TurnSpeed = afTurnSpeed;
		mfSpotlight_TurningDoneMul = afTurningDoneMul;
	}
	
	//------------------------------------------------------------
	
	void ResetSpotlightDir()
	{
		if (m_idCrystal == tID_Invalid) return;
		
		cVector3f vDir = mBaseObj.GetCharBody().GetForward();
		
		mvCrystal_TargetDir = vDir;
		mvCrystal_TargetDir.Normalize();
		GetSpotlightAngle(mvCrystal_TargetDir, mfSpotlight_TurnHTarget, mfSpotlight_TurnVTarget);
		
		mfSpotlight_TurnHTarget = ClosestAngleToAngle(mfSpotlight_TurnHTarget, mfCrystal_CurrentHAngle);
		mfSpotlight_TurnVTarget = ClosestAngleToAngle(mfSpotlight_TurnVTarget, mfCrystal_CurrentVAngle);
		
		mvCrystal_CurrentDir = mvCrystal_TargetDir;
		mfCrystal_CurrentHAngle = mfCrystal_TargetHAngle = mfSpotlight_TurnHTarget;
		mfCrystal_CurrentVAngle = mfCrystal_TargetVAngle = mfSpotlight_TurnVTarget;
	}
	
	//------------------------------------------------------------
	
	void TurnSpotlightToPos(const cVector3f &in avPos, bool abForce = false, bool abFade = true, float afTurnSpeed = 2.0f, float afTurningDoneMul = 1.0f)
	{
		if (m_idCrystal == tID_Invalid) return;
		TurnSpotlightToDir(avPos - cLux_ID_Entity(m_idCrystal).GetPosition(), abForce, abFade, afTurnSpeed, afTurningDoneMul);
	}
	
	//------------------------------------------------------------
	
	float mfSpotlight_SidewaysEightSpeed = 1.0f;
	float mfSpotlight_SidewaysEightHMul = 0.0f;
	float mfSpotlight_SidewaysEightVMul = 0.0f;
	bool mbSpotlight_UseCustomTarget = false;
	tID m_idSpotlight_TargetEntity;
	cVector3f mvSpotlight_CustomTarget;
	
	void SetSpotlightMovement_SidewaysEight(float afSpeed = 1.0f, float afHMul = 1.0f, float afVMul = 1.0f, bool abUseCustomTarget = false, const cVector3f &in avCustomTarget = cVector3f_Zero, bool abResetTimer = false, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
		mfSpotlight_SidewaysEightSpeed = afSpeed;
		mfSpotlight_SidewaysEightHMul = afHMul;
		mfSpotlight_SidewaysEightVMul = afVMul;
		mbSpotlight_UseCustomTarget = abUseCustomTarget;
		mvSpotlight_CustomTarget = avCustomTarget;
		m_idSpotlight_TargetEntity = tID_Invalid;
		if (mSpotlightMovement != eTinHinanLightMovement_SidewaysEight || abResetTimer) mfSpotlight_MovementTimer = 0.0f;
		if (mSpotlightMovement != eTinHinanLightMovement_SidewaysEight) AddSpotlightMovementTransition();
		mSpotlightMovement = eTinHinanLightMovement_SidewaysEight;
	}
	
	void SetSpotlightMovement_SidewaysEightAtEntity(float afSpeed = 1.0f, float afHMul = 1.0f, float afVMul = 1.0f, tID a_idEntity = tID_Invalid, bool abResetTimer = false, bool abForce = false)
	{
		SetSpotlightMovement_SidewaysEight(afSpeed, afHMul, afVMul, true, cVector3f_Zero, abResetTimer, abForce);
		m_idSpotlight_TargetEntity = a_idEntity;
	}
	
	void SetSpotlightMovement_SidewaysEightCustomTarget(const cVector3f &in avCustomTarget)
	{
		mvSpotlight_CustomTarget = avCustomTarget;
	}
	
	//------------------------------------------------------------
	
	cVector3f GetLeminscateMovement(float afT, const cVector3f &in avDir, float afHMoveMul, float afVMoveMul)
	{
		float fHMove = afHMoveMul * cMath_Cos((2.0f * afT) + cMath_PiDiv2);
		float fVMove = afVMoveMul * cMath_Sin(4.0f * afT) / 4.0f;

		cVector3f vForward = avDir;
		vForward.Normalize();
		
		cVector3f vRight = cMath_Vector3Cross(cVector3f_Up, vForward);
		vRight.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
		vUp.Normalize();
		
		cVector3f vFinalDir = vForward;
		
		cQuaternion qHRot;
		qHRot.FromAngleAxis(fHMove * cMath_ToRad(90), vUp);
		
		cQuaternion qVRot;
		qVRot.FromAngleAxis(fVMove * cMath_ToRad(90), vRight);
		
		vFinalDir = cMath_MatrixMul(cMath_MatrixQuaternion(qHRot * qVRot), vFinalDir);
		
		return vFinalDir;
	}
	
	//------------------------------------------------------------
	
	cVector3f RotateDirHV(const cVector3f &in avDir, float afH, float afV)
	{
		cVector3f vForward = avDir;
		vForward.Normalize();
		
		cVector3f vRight = cMath_Vector3Cross(cVector3f_Up, vForward);
		vRight.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
		vUp.Normalize();
		
		cVector3f vFinalDir = vForward;
		
		cQuaternion qHRot;
		qHRot.FromAngleAxis(afH, vUp);
		
		cQuaternion qVRot;
		qVRot.FromAngleAxis(afV, vRight);
		
		vFinalDir = cMath_MatrixMul(cMath_MatrixQuaternion(qHRot * qVRot), vFinalDir);
		
		return vFinalDir;
	}
	
	//------------------------------------------------------------
	
	cVector3f mvSpotlight_ScanDir;
	float mfSpotlight_ScanSpeed = 1.0f;
	float mfSpotlight_ScanHMul = 0.0f;
	float mfSpotlight_ScanVMul = 0.0f;
	
	void SetSpotlightMovement_Scan(const cVector3f &in avDir, float afSpeed = 1.0f, float afHMul = 1.0f, float afVMul = 1.0f, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
		mvSpotlight_ScanDir = avDir;
		mfSpotlight_ScanSpeed = afSpeed;
		mfSpotlight_ScanHMul = afHMul;
		mfSpotlight_ScanVMul = afVMul;
		if (mSpotlightMovement != eTinHinanLightMovement_Scan) mfSpotlight_MovementTimer = 0.0f;
		mSpotlightMovement = eTinHinanLightMovement_Scan;
	}
	
	//------------------------------------------------------------
	
	cVector3f GetScanMovement(float afT, const cVector3f &in avDir, float afHMoveMul, float afVMoveMul)
	{
		float fDistMul = 1.0f / (avDir.Length() * 0.2f);
		if (fDistMul < 1.0f) fDistMul = 1.0f;
		float fHMove = fDistMul * 0.6f * cMath_Cos(2.0f * afT);
		float fVMove = fDistMul * 0.15f * cMath_Sin(0.7f * afT);

		cVector3f vForward = avDir;
		vForward.Normalize();
		
		cVector3f vRight = cMath_Vector3Cross(cVector3f_Up, vForward);
		vRight.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
		vUp.Normalize();
		
		cVector3f vFinalDir = vForward;
		
		cQuaternion qHRot;
		qHRot.FromAngleAxis(fHMove * cMath_ToRad(90), vUp);
		
		cQuaternion qVRot;
		qVRot.FromAngleAxis(fVMove * cMath_ToRad(90), vRight);
		
		vFinalDir = cMath_MatrixMul(cMath_MatrixQuaternion(qHRot * qVRot), vFinalDir);
		
		return vFinalDir;
	}
	
	//------------------------------------------------------------
	
	float mfSpotlight_LeftRightAngle = 45.0f;
	float mfSpotlight_LeftRightSpeed = 1.0f;
	float mfSpotlight_LeftRightHMul = 0.0f;
	
	void SetSpotlightMovement_LeftToRight(float afAngle = 45.0f, float afSpeed = 1.0f, float afHMul = 1.0f, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
		mfSpotlight_LeftRightAngle = afAngle;
		mfSpotlight_LeftRightSpeed = afSpeed;
		mfSpotlight_LeftRightHMul = afHMul;
		if (mSpotlightMovement != eTinHinanLightMovement_LeftToRight) mfSpotlight_MovementTimer = 0.0f;
		mSpotlightMovement = eTinHinanLightMovement_LeftToRight;
	}
	
	//------------------------------------------------------------
	
	cVector3f GetLeftAndRightMovement(float afT, const cVector3f &in avDir, float afHMoveMul)
	{
		float fHMove = afHMoveMul * cMath_Cos(afT);

		cVector3f vForward = avDir;
		vForward.Normalize();
		
		cVector3f vRight = cMath_Vector3Cross(cVector3f_Up, vForward);
		vRight.Normalize();
		
		cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
		vUp.Normalize();
		
		cVector3f vFinalDir = vForward;
		
		cQuaternion qHRot;
		qHRot.FromAngleAxis(fHMove * cMath_ToRad(90), vUp);
		
		vFinalDir = cMath_MatrixMul(cMath_MatrixQuaternion(qHRot), vFinalDir);
		
		return vFinalDir;
	}
	
	//------------------------------------------------------------
	
	tID m_idSpotlight_FollowEntity;
	
	void SetSpotlightMovement_FollowEntity(tID a_idEntity, bool abForce = false)
	{
		if (abForce == false && mSpotlightMovement != eTinHinanLightMovement_None) return;
		if (a_idEntity == tID_Invalid) return;
		mSpotlightMovement = eTinHinanLightMovement_FollowEntity;
		m_idSpotlight_FollowEntity = a_idEntity;
	}
	
	
	//------------------------------------------------------------
	
	bool mbSpotlightActivation_Active = false;
	bool mbSpotlightActivation_SpotlightOnly = false;
	float mfSpotlightActivation_FadeTime = 0;
	bool mbSpotlight_VisualsActive = false;
	
	void SetSpotLightActive(bool abX, bool abMeshVisible = true, bool abSpotlightOnly = false, float afEffectFadeTime = 0.f)
	{
		bool bChange = mbCrystal_Active != abX;
		mbCrystal_Active = abX;
		
		cLuxProp@ pCrystal = cLux_ID_Prop(m_idCrystal);
		if (pCrystal !is null)
		{
			pCrystal.SetActive(abMeshVisible);
		}
		else return;
		
		if (mbCrystal_Active && mlSpotlight_ActivationIndex < 3) return;
		
		if (bChange)
		{
			if (mbCrystal_Active)
			{
				cSoundEntity@ pSound = mBaseObj.PlaySound("LightOn", gsTinHinanSound_TurnOnLight, true, true);
				pSound.SetVolume(mfSfx_VolumeMul);
			}
			else
			{
				cSoundEntity@ pSound = mBaseObj.PlaySound("LightOff", gsTinHinanSound_TurnOffLight, true, true);
				pSound.SetVolume(mfSfx_VolumeMul);
			}
		}
		
		mbSpotlightActivation_Active = mbCrystal_Active;
		mbSpotlightActivation_SpotlightOnly = abSpotlightOnly;
		mfSpotlightActivation_FadeTime = afEffectFadeTime;
		
		// activate visuals
		float fVisualsDelay = 0;
		if (mbCrystal_Active) fVisualsDelay = 0.3;
		mBaseObj.Timer_Remove("Timer_ActivateSpotlightVisuals");
		mBaseObj.Timer_Add("Timer_ActivateSpotlightVisuals", fVisualsDelay, "OnTimer_ActivateSpotlightVisuals");
		
		// activate sounds
		mBaseObj.Timer_Remove("Timer_ActivateSpotlightSounds");
		if (abX)
		{
			mBaseObj.Timer_Add("Timer_ActivateSpotlightSounds", 0.2, "OnTimer_ActivateSpotlightSounds");
		}
		else
		{
			mbSfx_SpotlightSoundActive = false;
		}
	}
	
	//------------------------------------------------------------
	
	void OnTimer_ActivateSpotlightVisuals(uint64 alID)
	{
		cLuxProp@ pCrystal = cLux_ID_Prop(m_idCrystal);
		if (pCrystal is null) return;
		
		mbSpotlight_VisualsActive = mbSpotlightActivation_Active;
		SetSpotlightBillboardActive(mbSpotlightActivation_Active);
		
		for (int i = 0; i < pCrystal.GetLightNum(); ++i)
		{
			iLight@ pLight = pCrystal.GetLight(i);
			float fLightBrightness = pLight.GetDefaultBrightness();
			if (mbSpotlightActivation_Active == false) fLightBrightness = 0.0f;
			pLight.FadeBrightnessTo(fLightBrightness, mfSpotlightActivation_FadeTime);
		}
		
		if (mbSpotlightActivation_SpotlightOnly == false)
		{
			cLensFlare@ pFlare = cLux_ID_LensFlare(m_idSpotLight_LensFlare);
			if (pFlare !is null)
			{
				if (mbSpotlightActivation_Active) pFlare.FadeIn(mfSpotlightActivation_FadeTime);
				else pFlare.FadeOut(mfSpotlightActivation_FadeTime);
			} 
			
			for (int i = 0; i < pCrystal.GetBillboardNum(); ++i) 
				pCrystal.GetBillboard(i).SetVisible(mbSpotlightActivation_Active);
		}
		
		SetSpotLightColor(mSpotlightcolor);
	}
	
	//------------------------------------------------------------
	
	void OnTimer_ActivateSpotlightSounds(uint64 alID)
	{
		mbSfx_SpotlightSoundActive = true;
	}
	
	//------------------------------------------------------------
	
	void SetSpotLightColor(const cColor&in aColor)
	{
		mSpotlightcolor = aColor;
		
		cLuxProp@ pCrystal = cLux_ID_Prop(m_idCrystal);
		if (pCrystal is null) return;
			
		pCrystal.SetEffectBaseColor(aColor * mfSpotlightBrightnessMul);
		
		float fActiveMul = mbCrystal_Active ? 2.5f : 2.0f;
		if (mbFlyMode_Active) fActiveMul *= 2.0f;
		pCrystal.GetMeshEntity().SetIlluminationColor(aColor * mfSpotlightBrightnessMul * fActiveMul);
		
//		for (int i = 0; i < pCrystal.GetLightNum(); ++i)
//			pCrystal.GetLight(i).SetDiffuseColor(aColor);
		
		cLensFlare@ pFlare = cLux_ID_LensFlare(m_idSpotLight_LensFlare);
		if (pFlare !is null)
		{
			pFlare.SetFlareColor(eLensFlareType_AnamorphicFlare, aColor * mfSpotlightBrightnessMul);
			pFlare.SetFlareColor(eLensFlareType_Halo, aColor * mfSpotlightBrightnessMul);
			pFlare.SetFlareColor(eLensFlareType_MultiIris, aColor * mfSpotlightBrightnessMul);
		}
		
		for (int i = 0; i < pCrystal.GetBillboardNum(); ++i) 
			pCrystal.GetBillboard(i).SetColor(aColor * mfSpotlightBrightnessMul);
	}
	
