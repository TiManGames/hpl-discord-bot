#include "custom/effects/Effects_Custom.hps"

//-------------------------------------------------

/////////////////////////////////////////
// BABY KICK
/////////////////////////////////////////

//-------------------------------------------------

void Effect_BabyKick_Start(float afIntensity = 1.f, bool abPlayGasp = true, bool abShake = true)
{
	iScrEffect_BabyKick@ pEffect = cast<iScrEffect_BabyKick>(cLux_GetEffectHandler().GetEffect(eEffect_Custom_BabyKick));
	pEffect.Start(afIntensity, abPlayGasp, abShake);	
}

//-------------------------------------------------

void Effect_BabyKick_Stop()
{
	iScrEffect_BabyKick@ pEffect = cast<iScrEffect_BabyKick>(cLux_GetEffectHandler().GetEffect(eEffect_Custom_BabyKick));
	pEffect.Stop();	
}

//-------------------------------------------------

bool Effect_BabyKick_IsActive()
{
	iScrEffect_BabyKick@ pEffect = cast<iScrEffect_BabyKick>(cLux_GetEffectHandler().GetEffect(eEffect_Custom_BabyKick));
	return pEffect.IsActive();
}

