//-------------------------------------------------


/////////////////////////////////////////
// DOLLY ZOOM
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets the direct amount of lens distortion directly
 *
 * @param afX, The amount of the effect, positive values give vertigo effect, negative give opposite effect
 * @param afTime, The amount of time the effect should last
 * @param afFadeInTime, The amount of time it takes for the effect to reach the desired amount
 * @param afFadeOutTime, The amount of time it takes for the effect to go back to the original state. -1 disables the return to the original state. 
 **/
void Effect_DollyZoom_Start(float afAmount, float afTime, float afFadeInTime, float afFadeOutTime = -1)
{
	iScrEffect_DollyZoom@ pEffect = cast<iScrEffect_DollyZoom>(cLux_GetEffectHandler().GetEffect(eEffect_Custom_DollyZoom));
	pEffect.Start(afAmount, afTime, afFadeInTime, afFadeOutTime);
}

//-------------------------------------------------

void Effect_DollyZoom_Stop()
{
	iScrEffect_DollyZoom@ pEffect = cast<iScrEffect_DollyZoom>(cLux_GetEffectHandler().GetEffect(eEffect_Custom_DollyZoom));
	pEffect.Stop();
}

