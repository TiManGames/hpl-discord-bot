#include "custom/modules/ModuleInterfaces_Custom.hps"

//-------------------------------------------------------

/////////////////////////////////////////
// MENU HANDLER
/////////////////////////////////////////

//-------------------------------------------------------

/**
 * Sets if the pause menu is allowed to be used
 * @param abActive, If true, the pause menu can be opened
  **/
void PauseMenu_Enabled(bool abActive)
{
	iScrMenuHandler_Interface @pPDHandler = cast<iScrMenuHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_MenuHandler) );
	pPDHandler.EnablePauseMenu(abActive);
}

//-------------------------------------------------------

/**
 * Show the pause manu
 * @param abActive, If true, the pause menu can be opened
  **/
void PauseMenu_Show(bool abActive)
{
	iScrMenuHandler_Interface @pPDHandler = cast<iScrMenuHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_MenuHandler) );
	pPDHandler.SetMenuActive(abActive);
}

//-------------------------------------------------------

/**
 * If main menu should be shown
 * @param abActive, If true, the main menu is visible
  **/
void MainMenu_Show(bool abX)
{
	iScrMenuHandler_Interface @pPDHandler = cast<iScrMenuHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_MenuHandler) );
	pPDHandler.ShowMainMenu(abX);
}

//-------------------------------------------------------

/**
 * Return whether the Main Menu is active or not
  **/
bool MainMenu_IsShowing()
{
	iScrMenuHandler_Interface @pPDHandler = cast<iScrMenuHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_MenuHandler) );
	bool bActive = pPDHandler.GetMenuActive();
	return bActive;
}

//-------------------------------------------------------

/** Returning to the main menu when the game's complete */
void MainMenu_GameOver()
{
	iScrMenuHandler_Interface @pPDHandler = cast<iScrMenuHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_MenuHandler) );
	pPDHandler.GameOver();
}

//------------------------------------------------------- 

void MainMenu_Sketchbook_SetSketch(const tString& in asSketch)
{
	iScrMenuHandler_Interface @pPDHandler = cast<iScrMenuHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_MenuHandler) );
	pPDHandler.SetMainMenuSketchbookSketch(asSketch);
}

//------------------------------------------------------- 

void MainMenu_SetPhase_Ghoul(int alPhase)
{
	iScrMenuHandler_Interface @pPDHandler = cast<iScrMenuHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_MenuHandler) );
	pPDHandler.SetMainMenuGhoulPhase(alPhase);
}

//------------------------------------------------------- 

void MainMenu_SetPhase_Items(eMainMenuPhase_Items aPhase)
{
	iScrMenuHandler_Interface @pPDHandler = cast<iScrMenuHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_MenuHandler) );
	pPDHandler.SetMainMenuItemsPhase(aPhase);
}

//-------------------------------------------------------

void LastTimeOnGame_SetText(const tString &in asText)
{
	cScript_SetGlobalVarString("LastTimeOnGameText", asText);
	
	cLux_AddDebugMessage("Setting LastTimeOnGameText to " + asText);
}

