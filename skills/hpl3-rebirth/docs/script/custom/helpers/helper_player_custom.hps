/** Sets an entity which will play the specified animations in sync with the player ones.
 * @param asEntity, the entity to play the animations on.
 * @param asAnim, the animation to play.
 * @param asAnimIntro, the animation to be played at the start.
 * @param asAnimOutro, the animation to be played at the end.
 * @param abLoop, if the animation (asAnim) should loop or not
 */
void Struggle_SetAnimationEntity(const tString &in asEntity, const tString &in asAnim, const tString &in asAnimIntro, 
								 const tString &in asAnimOutro, const tString &in asAnimStruggle, bool abLoop)
{
	cScript_SetGlobalArgString(0, asEntity);
	cScript_SetGlobalArgString(1, asAnim);
	cScript_SetGlobalArgString(2, asAnimIntro);
	cScript_SetGlobalArgString(3, asAnimOutro);
	cScript_SetGlobalArgString(4, asAnimStruggle);
	cScript_SetGlobalArgBool(5, abLoop);
	cScript_RunGlobalFunc("State_Struggle", "", "SetupAnimationEntity");
}

