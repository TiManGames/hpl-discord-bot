/**
 * Gives damage to the player which applies a damage effect
 * 
 * @param afAmount, how much damage to do to the player
 * @param afMaxFear, max fear level the damage can cause
 * @param alType, the type of damage, which damage effect should be applied to the screen
 * @param asSource, the name of the entity doing the damage
 **/
void Player_GiveDamage(float afAmount, float afMaxFear, int alType, const tString &in asSource)
{
	cScript_SetGlobalArgFloat(0, afAmount);
	cScript_SetGlobalArgFloat(1, afMaxFear);
	cScript_SetGlobalArgInt(2, alType);
	cScript_SetGlobalArgString(3, asSource);
	cScript_RunGlobalFunc("LuxPlayer", "", "_Global_GiveDamage");
}

//-------------------------------------------------

/** Just does the damage effects without doing any real damage */
void Player_DoDamageEffects(float afAmount, float afShake = 0.05f)
{
	cScript_SetGlobalArgFloat(0, afAmount);
	cScript_SetGlobalArgFloat(1, afShake);
	cScript_RunGlobalFunc("LuxPlayer", "", "_Global_DoDamageEffects");
}

