//-------------------------------------------------

/** Starts/switches to the birth state
 * @param asPositionEntity, name of entity the animation should be played at
 * @param asFocusEntity, name of entity the player should be looking at
 * @param asFocusBone, name of bone in the entity the player should be looking at. If empty, the position of the entity will be used instead.
 * @param asSuccessCallback, map function to call on success.
 * @param asFailCallback, map function to call on fail.
 * @param asFadeStruggleCallBack, map function to call on fade out struggle end.
 */
void BirthState_Start(const tString&in asPositionEntity, const tString&in asFocusEntity, const tString&in asFocusBone, const tString&in asSuccessCallback="", const tString&in asFailCallback="", const tString&in asFadeStruggleCallBack="")
{
	cScript_SetGlobalArgString(0, asPositionEntity);
	cScript_SetGlobalArgString(1, asFocusEntity);
	cScript_SetGlobalArgString(2, asFocusBone);
	
	cScript_SetGlobalArgString(3, asSuccessCallback);
	cScript_SetGlobalArgString(4, asFailCallback);
	cScript_SetGlobalArgString(5, asFadeStruggleCallBack);
	
	cScript_RunGlobalFunc("State_Birth", "", "_Global_SetupBirthState");
	
	cLux_GetPlayer().ChangeState(ePlayerState_Custom_Birth);
}

//-------------------------------------------------

/** Switches birth's state push state on/off.
 * @param afDuration, the overall duration of the push state.
 */
void BirthState_StartPush(const float afDuration=4.f)
{
	if (cLux_GetPlayer().GetCurrentStateId()!=ePlayerState_Custom_Birth) return;
	
	cScript_SetGlobalArgFloat(0, afDuration);
	cScript_RunGlobalFunc("State_Birth", "", "_Global_ActivatePushState");
}

//-------------------------------------------------

/** Switches birth's state fade out state on/off.
 * @param afStruggleDuration, how long the player should stay focused to win the struggle.
 */
void BirthState_StartFadeOut(const float afStruggleDuration=8.f)
{
	if (cLux_GetPlayer().GetCurrentStateId()!=ePlayerState_Custom_Birth) return;
	
	cScript_SetGlobalArgFloat(0, afStruggleDuration);
	cScript_RunGlobalFunc("State_Birth", "", "_Global_ActivateFadeOutState");
}

//-------------------------------------------------

/** Switches birth's state ghoul mode on/off.
 * @param abActive, enables or disables the ghoul mode.
 */
void BirthState_SetGhoulMode(const bool abActive)
{
	if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Custom_Birth) return;
		
	cScript_SetGlobalArgBool(0, abActive);
	cScript_RunGlobalFunc("State_Birth", "", "_Global_SetGhoulMode");
}

//-------------------------------------------------

/** Plays a specific birth animation
 * @param asAnimation, animation to play
 */
void BirthState_PlayAnimation(const tString&in asAnimation, float afFadeTime=0.3f, const tString &in asCallback = "")
{
	if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Custom_Birth) return;
		
	cScript_SetGlobalArgString(0, asAnimation);
	cScript_SetGlobalArgFloat(1, afFadeTime);
	cScript_SetGlobalArgString(2, asCallback);
	cScript_RunGlobalFunc("State_Birth", "", "_Global_PlayAnimation");
}

