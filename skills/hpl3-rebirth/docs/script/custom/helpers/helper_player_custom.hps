/** Starts a struggle of the type Wraith.
 * @param asWraith, name of the wraith entity.
 * @param afDuration, max duration of the event.
 * @param abWinnable, if the event is winnable.
 * @param afTransitionTime, duration of the transition into the struggle.
 * @param abAllowTransitionMovement, if movement while in transition should be allowed.
 * @param afIntensity, the intensity of the event, 1.f is default.
 * @param abPlayOutroAnim, if the outro animation should play when the player breaks free from the struggle.
 * @param abShowHint, if the struggle hint should be shown when entering the struggle.
 */
void Struggle_StartWraith(const tString &in asWraith, float afDuration, bool abWinnable, bool abCanStop, float afTransitionTime, 
						  bool abAllowTransitionMovement, float afIntensity = 1.f, bool abPlayOutroAnim = true, bool abShowHint = true)
{
	cScript_SetGlobalArgInt(0, eStruggleEvent_Wraith);
	cScript_SetGlobalArgString(1, asWraith);
	cScript_SetGlobalArgFloat(2, afDuration);
	cScript_SetGlobalArgBool(3, abWinnable);
	cScript_SetGlobalArgFloat(4, afTransitionTime);
	cScript_SetGlobalArgBool(5, abAllowTransitionMovement);
	cScript_SetGlobalArgFloat(6, afIntensity);
	cScript_SetGlobalArgBool(7, abPlayOutroAnim);
	cScript_SetGlobalArgBool(8, abShowHint);
	cScript_SetGlobalArgBool(9, abCanStop);
	cScript_RunGlobalFunc("State_Struggle", "", "SetupStruggle");
	cLux_GetPlayer().ChangeState(ePlayerState_Custom_Struggle);
}

