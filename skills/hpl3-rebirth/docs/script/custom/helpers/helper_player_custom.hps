//-------------------------------------------------

/** Starts a struggle event of the type MoveTowards.
 * @param asTar, the main target. Will look toward it, move toward it, use it to calculate the speed etc.
 * @param asLookTar, target at which the player will look at if specified. Overrides asTar.
 * @param asLight, light which will be used for effects.
 * @param asSuccessCallback, callback if the event is won. Syntax: void Func()
 * @param asFailCallback, callback if the event is lost. Syntax: void Func()
 * @param afDuration, max duration of the event.
 * @param abWinnable, if the event is winnable.
 * @param afTransitionTime, duration of the transition into the struggle
 * @oaram afMoveSpeed, speed at which the player will move toward the target. If -1, speed is distance / duration.
 * @param afIntensity, the intensity of the event, 1.f is default.
 * @param abShowHint, if the struggle hint should be shown when entering the struggle.
 */
void Struggle_StartMoveTowards(const tString &in asTar, const tString &in asLookTar = "", const tString &in asLight = "", 
							   const tString &in asSuccessCallback = "", const tString &in asFailCallback = "",
							   float afDuration = 8.f, bool abWinnable = true, float afTransitionTime = 3.f, 
							   float afMoveSpeed = -1.f, float afIntensity = 1.f, bool abShowHint = true, float afSoundFadeTime = 0.75f)
{
	cScript_SetGlobalArgInt(0, eStruggleEvent_MoveToward);
	cScript_SetGlobalArgString(1, asTar);
	cScript_SetGlobalArgString(2, asLookTar);
	cScript_SetGlobalArgString(3, asLight);
	cScript_SetGlobalArgString(4, asSuccessCallback);
	cScript_SetGlobalArgString(5, asFailCallback);
	cScript_SetGlobalArgFloat(6, afDuration);
	cScript_SetGlobalArgBool(7, abWinnable);
	cScript_SetGlobalArgFloat(8, afTransitionTime);
	cScript_SetGlobalArgFloat(9, afMoveSpeed);
	cScript_SetGlobalArgFloat(10, afIntensity);
	cScript_SetGlobalArgBool(11, abShowHint);
	cScript_SetGlobalArgFloat(12, afSoundFadeTime);
	cScript_RunGlobalFunc("State_Struggle", "", "SetupStruggle");
	cLux_GetPlayer().ChangeState(ePlayerState_Custom_Struggle);
}

//-------------------------------------------------

/** Starts a struggle event of the type Animation.
 * @param asStandTar, where the player will be positioned during the even (will use both yaw and position of the target)
 * @param asAnim, the animation to be looped.
 * @param asAnimStruggle, additative animation to be played when actively struggling.
 * @param asAnimIntro, the animation to be played at the start.
 * @param asAnimOutro, the animation to be played at the end.
 * @param abLoop, if the animation (asAnim) should loop
 * @param asLight, light which will be used for effects.
 * @param asSuccessCallback, callback if the event is won. Syntax: void Func()
 * @param asFailCallback, callback if the event is lost. Syntax: void Func()
 * @param asAnimOutroCallback, callback at the end of the outro anim
 * @param afDuration, max duration of the event.
 * @param abWinnable, if the event is winnable.
 * @param afTransitionTime, duration of the transition into the struggle
 * @param afIntensity, the intensity of the event, 1.f is default.
 * @param abShowHint, if the struggle hint should be shown when entering the struggle.
 * @param afFadeTime, animation fade in time.
 */
void Struggle_StartAnimation(const tString &in asStandTar, const tString &in asAnim,
							 const tString &in asAnimStruggle = "", const tString &in asAnimIntro = "", 
							 const tString &in asAnimOutro = "", bool abLoop = true, const tString &in asLight = "", 
							 const tString &in asSuccessCallback = "", const tString &in asFailCallback = "", const tString &in asAnimOutroCallback = "",
							 float afDuration = 8.f, bool abWinnable = true, float afTransitionTime = 2.f, float afIntensity = 1.f, bool abShowHint = true, float afFadeTime = 0.3f, bool abPlayStruggleLoop = true, bool abForceHint = false)
{
	cScript_SetGlobalArgInt(0, eStruggleEvent_Animation);
	cScript_SetGlobalArgString(1, asStandTar);
	cScript_SetGlobalArgString(2, asAnim);
	cScript_SetGlobalArgString(3, asAnimStruggle);
	cScript_SetGlobalArgString(4, asAnimIntro);
	cScript_SetGlobalArgString(5, asAnimOutro);
	cScript_SetGlobalArgBool(6, abLoop);
	cScript_SetGlobalArgString(7, asLight);
	cScript_SetGlobalArgString(8, asSuccessCallback);
	cScript_SetGlobalArgString(9, asFailCallback);
	cScript_SetGlobalArgString(10, asAnimOutroCallback);
	cScript_SetGlobalArgFloat(11, afDuration);
	cScript_SetGlobalArgBool(12, abWinnable);
	cScript_SetGlobalArgFloat(13, afTransitionTime);
	cScript_SetGlobalArgFloat(14, afIntensity);
	cScript_SetGlobalArgBool(15, abShowHint);
	cScript_SetGlobalArgFloat(16, afFadeTime);
	cScript_SetGlobalArgBool(17, abPlayStruggleLoop);
	cScript_SetGlobalArgBool(18, abForceHint);
	cScript_RunGlobalFunc("State_Struggle", "", "SetupStruggle");
	cLux_GetPlayer().ChangeState(ePlayerState_Custom_Struggle);
}

//-------------------------------------------------

/** Starts a struggle event of the type Ghoul.
 * @param asStandTar, where the player will be positioned during the even (will use both yaw and position of the target)
 * @param asAnim, the animation to be looped.
 * @param asAnimStruggle, additative animation to be played when actively struggling.
 * @param asAnimIntro, the animation to be played at the start.
 * @param asAnimOutro, the animation to be played at the end.
 * @param abLoop, if the animation (asAnim) should loop
 * @param asLight, light which will be used for effects.
 * @param asSuccessCallback, callback if the event is won. Syntax: void Func()
 * @param asFailCallback, callback if the event is lost. Syntax: void Func()
 * @param asAnimOutroCallback, callback at the end of the outro anim
 * @param afDuration, max duration of the event.
 * @param abWinnable, if the event is winnable.
 * @param afTransitionTime, duration of the transition into the struggle
 * @param afIntensity, the intensity of the event, 1.f is default.
 * @param abShowHint, if the struggle hint should be shown when entering the struggle.
 * @param afFadeTime, animation fade in time.
 */
void Struggle_StartGhoul(const tString &in asGhoul, const tString &in asStandTar, const tString &in asAnim,
							 const tString &in asAnimStruggle = "", const tString &in asAnimIntro = "", 
							 const tString &in asAnimSuccessOutro = "", const tString &in asAnimFailureOutro = "", bool abLoop = true, const tString &in asLight = "", 
							 const tString &in asSuccessCallback = "", const tString &in asFailCallback = "", const tString &in asAnimOutroCallback = "",
							 float afDuration = 8.f, bool abWinnable = true, float afTransitionTime = 2.f, float afIntensity = 1.f, bool abShowHint = true, float afFadeTime = 0.3f)
{
	cScript_SetGlobalArgInt(0, eStruggleEvent_Ghoul);
	cScript_SetGlobalArgString(1, asStandTar);
	cScript_SetGlobalArgString(2, asAnim);
	cScript_SetGlobalArgString(3, asAnimStruggle);
	cScript_SetGlobalArgString(4, asAnimIntro);
	cScript_SetGlobalArgString(5, asAnimSuccessOutro);
	cScript_SetGlobalArgBool(6, abLoop);
	cScript_SetGlobalArgString(7, asLight);
	cScript_SetGlobalArgString(8, asSuccessCallback);
	cScript_SetGlobalArgString(9, asFailCallback);
	cScript_SetGlobalArgString(10, asAnimOutroCallback);
	cScript_SetGlobalArgFloat(11, afDuration);
	cScript_SetGlobalArgBool(12, abWinnable);
	cScript_SetGlobalArgFloat(13, afTransitionTime);
	cScript_SetGlobalArgFloat(14, afIntensity);
	cScript_SetGlobalArgBool(15, abShowHint);
	cScript_SetGlobalArgFloat(16, afFadeTime);
	cScript_SetGlobalArgString(17, asGhoul);
	cScript_SetGlobalArgString(18, asAnimFailureOutro);
	cScript_RunGlobalFunc("State_Struggle", "", "SetupStruggle");
	cLux_GetPlayer().ChangeState(ePlayerState_Custom_Struggle);
}

