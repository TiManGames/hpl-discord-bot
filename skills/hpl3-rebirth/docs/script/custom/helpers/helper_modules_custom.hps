{
	iScrPlayerEmotionHandler_Interface@ pHandler = cast<iScrPlayerEmotionHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_PlayerEmotionHandler));
	pHandler.SetActive(abActive);
