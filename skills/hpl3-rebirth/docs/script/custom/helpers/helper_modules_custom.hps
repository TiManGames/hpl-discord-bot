/////////////////////////////////////////
// DARK WORLD POWER HANDLER
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Activates or deactivates the DarkWorldPower handler. Will automatically be disabled if you don't have any DWPower entities in your map.
 * @param abX, if the handler should be active or not
 */
void DarkWorldPower_SetActive(bool abX)
{
	iScrDarkWorldPowerHandler_Interface @pHandler = cast<iScrDarkWorldPowerHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_DarkWorldPowerHandler) );
	pHandler.SetActive(abX);
}

//-------------------------------------------------

/**
 * Sets a special rule that uses a custom distance between two DarkWorldPower entities.
 * @param asFirst, the name of the first DWPower entity
 * @param asSecond, the name of the second DWPower entity
 * @param afRadius, the custom radius that should be used between the entities for activation/deactivation
 */
void DarkWorldPower_SetEntityPairRadius(const tString &in asFirst, const tString &in asSecond, float afRadius)
{
	iScrDarkWorldPowerHandler_Interface @pHandler = cast<iScrDarkWorldPowerHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_DarkWorldPowerHandler) );
	pHandler.SetEntityPairRadius(asFirst, asSecond, afRadius);
}

//-------------------------------------------------

/**
 * Adds a mask area for a specific power node that makes it impossible for its power to extend into it. Can still use extenders to get power to it however. Can be useful for 
 * avoiding weird solutions to the power puzzles where power is transmitted through walls in ways that you don't want it to be.
 * @param asEntity, the name of the DWPower entity
 * @param asMaskArea, the name of the area that will be used as the mask
 */
void DarkWorldPower_AddMask(const tString &in asEntity, const tString &in asMaskArea)
{
	iScrDarkWorldPowerHandler_Interface @pHandler = cast<iScrDarkWorldPowerHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_DarkWorldPowerHandler) );
	pHandler.AddMask(asEntity, asMaskArea);
}

