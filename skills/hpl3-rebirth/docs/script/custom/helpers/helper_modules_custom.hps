//------------------------------------------------------------

/**
 * Trigger a microflash.
 * 
 * @param asSubject, name of the voice subject.
 * @param asCallback, callback after the subject has played. Syntax: void Func(const tString &in asScene, const tString &in asSubject).
 * @param alLineId, specific line of the microflash to play.
 * 
 **/
void Sketchbook_Microflash(const tString&in asSubject, const tString &in asCallback = "", int alLineId = -1, float afDuckAudioTo=0.5f)
{
    iScrSketchbookUIHandler_Interface @pHandler = cast<iScrSketchbookUIHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_SketchbookUIHandler) );
	pHandler.Microflash(asSubject, asCallback, alLineId, afDuckAudioTo);
}

//------------------------------------------------------------

/**
 * Unlock a specific memory.
 * @param asMemoryID: Memory "ID" as defined in PlayerMemories.cfg.
 * @param abDoFlashback: Flashback effects will occur.
 * @param asCallback, callback after the memory has played. Syntax: void Func(const tString &in asScene, const tString &in asSubject)
 **/
void Sketchbook_UnlockMemory(const tString&in asMemoryID, const bool abDoFlashback=true, const tString &in asCallback="", bool abAllowSkip=true)
{
	iScrSketchbookUIHandler_Interface @pHandler = cast<iScrSketchbookUIHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_SketchbookUIHandler) );
	pHandler.SetLockByMemoryID(asMemoryID, false, abDoFlashback, asCallback, abAllowSkip);
}

