	pHandler.SetLevelTo(afLevel);
}

//-------------------------------------------------

/**
 * Fades the current FEAR LEVEL to a desired value
 * @param afLevel, the value FEAR LEVEL will fade to
 * @param afFadeTime, how long the fade should take
 * @param abIgnoreRegenCap, if regen caps should be ignored (if true the closest regen cap to afLevel will be calculated after the fade is completed)
 */
void FearHandler_FadeLevelTo(float afLevel, float afFadeTime, bool abIgnoreRegenCap = true)
{
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.FadeLevelTo(afLevel, afFadeTime, abIgnoreRegenCap);
}

//-------------------------------------------------

/**
 * Fades the multiplier for the FEAR RATE
 * @param afMul, the value the fear rate multiplier will fade to
 * @param afFadeTime, how long the fade should take
 */
void FearHandler_FadeRateMulTo(float afMul, float afFadeTime)
{
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.FadeRateMulTo(eFearRateMulType_Script, afMul, afFadeTime);
}

//-------------------------------------------------

/**
 * Fades the multiplier for the FEAR RATE
 * @param aType, eFearRateMulType specifying which type of Fear Rate Mul should be faded. Allows the fear rate to be multiplied in different parts of the code without them interfering with each other.
 * @param afMul, the value the fear rate multiplier will fade to
 * @param afFadeTime, how long the fade should take
 */
void FearHandler_FadeRateMulTo(eFearRateMulType aType, float afMul, float afFadeTime)
{
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.FadeRateMulTo(aType, afMul, afFadeTime);
}

