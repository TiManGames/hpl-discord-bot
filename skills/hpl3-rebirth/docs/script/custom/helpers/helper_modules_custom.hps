//-------------------------------------------------

/**
 * Adds a scene (an animation at the specified entity) that will be played when permafailing. The scenes will be played in the order added.
 * @param asPlayerAnim, name of the animation
 * @param asEntity, the entity to play the player animation at
 * @param asAnimEntity, name of an entity to play an animation on
 * @param asEntityAnim, name of the animation to play on the entity
 * @param afDuration, the duration of the scene. If -1, will use the length of the player animation.
 * @param abRandomLookDir,if true a random camera rotation sequence is played.
*/
void FearHandler_AddPermaFailScene(const tString &in asPlayerAnim, const tString &in asEntity, 
								   const tString &in asAnimEntity = "", const tString &in asEntityAnim = "",
								   float afDuration = 2.f, bool abRandomLookDir = false)
{
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.AddPermaFailScene(asPlayerAnim, asEntity, asAnimEntity, asEntityAnim, afDuration, abRandomLookDir);
}

//-------------------------------------------------

/**
 * Adds a scene (where the player moves from the start entity to the end entity) that will be played when permafailing. The scenes will be played in the order added.
 * @param asMoveStartEnt, the entity at which the player will start moving from.
 * @param asMoveEndEnt, the entity the player will move towards.
 * @param afMoveSpeed, the speed at which the player will move toward the end entity (in m/s).
 * @param afDuration, the duration of the scene. If -1, will use the length of the player animation.
 * @param abRandomLookDir,if true a random camera rotation sequence is played.
 * @param abCrouch, if the player should crouch during the scene.
*/
void FearHandler_AddPermaFailScene(const tString &in asMoveStartEnt, const tString &in asMoveEndEnt, float afMoveSpeed, float afDuration = 2.f, 
								   bool abRandomLookDir = true, bool abCrouch = false)
{	
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.AddPermaFailScene(asMoveStartEnt, asMoveEndEnt, afMoveSpeed, afDuration, abRandomLookDir, abCrouch);
}

//-------------------------------------------------

/**
 * Adds a scene (where the player moves from the start entity to the end entity) that will be played when permafailing. The scenes will be played in the order added.
 * @param asCameraAnim, the camera anim name.
 * @param afDuration, the duration of the scene. 
*/
void FearHandler_AddPermaFailScene(const tString &in asCameraAnim, float afDuration = 2.f)
{	
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.AddPermaFailScene(asCameraAnim, afDuration);
}

