//-------------------------------------------------

/**
 * Sets which death area should be used when player is killed by the specified source. Wildcards for areas accepted.
 * 
 * @param asDeathSource, name of the source
 * @param asDeathArea, name of the death area to use. Wildcards accepted.
 * 
 **/
void Death_SetActiveDeathAreaForSource(const tString &in asDeathSource, const tString &in asDeathArea)
{
    array<iLuxEntity@> vEntities;
    cLux_GetCurrentMap().GetEntityArray(asDeathArea, eLuxEntityType_Area, "cScrAreaDeath", vEntities);
    if (vEntities.size() <= 0)
    {
        Error("No death area with name '" + asDeathArea + "' could be found for Death_SetActiveDeathAreaForSource()!");
		return;
    }
	
	iScrDeathHandler_Interface @pHandler = cast<iScrDeathHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DeathHandler));
	pHandler.SetDeathAreaForSource(asDeathSource, asDeathArea);
}

//-------------------------------------------------

/**
 * Sets which death area should be used by default when the player dies. Set back to "" to use normal death area picking.
 * 
 * @param asDeathArea, name of the death area to use. Wildcards accepted.
 * 
 **/
void Death_SetDefaultDeathArea(const tString &in asDeathArea)
{
	iScrDeathHandler_Interface @pHandler = cast<iScrDeathHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DeathHandler));
	pHandler.SetDefaultDeathArea(asDeathArea);
}

//-------------------------------------------------

/**
 * Pick an area for the player to respawn at.
 * 
 * @param asFunc, name of the function that will be executed when the player respawns.
 * 
 **/
void Death_SetRespawnCallback(const tString &in asFunc)
{
	iScrDeathHandler_Interface @pHandler = cast<iScrDeathHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DeathHandler));
	pHandler.SetRespawnCallback(asFunc);
}

//-------------------------------------------------

/**
 * Pick an area for the player to respawn at.
 * 
 * @param asDeathArea, name of the death areas to pick from. Wildcards supported.
 * 
 **/
void Death_PickRespawnArea(const tString &in asSpecifiedAreas)
{
	iScrDeathHandler_Interface @pHandler = cast<iScrDeathHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DeathHandler));
	pHandler.PickRespawnArea(asSpecifiedAreas);
}

//-------------------------------------------------

/**
 * Pick an area for the player to respawn at.
 * 
 * @param asDeathArea, name of the death areas to pick from. Wildcards supported.
 * 
 **/
tString Death_GetSource()
{
	iScrDeathHandler_Interface @pHandler = cast<iScrDeathHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DeathHandler));
