//-------------------------------------------------

void Pregnancy_DoBabyKick(bool abForce)
{
	iScrPregHandler_Interface @pHandler = cast<iScrPregHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_PregHandler) );
	if (pHandler.GetBabyKicksEnabled() == false) 
	{
		Error("Can't perform baby kick because they are disabled. Use Pregnancy_SetBabyKicksEnabled to enable them.");
		return;
	}
	pHandler.DoBabyKick(abForce);
}

