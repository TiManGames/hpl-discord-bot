//-------------------------------------------------

/**
* @param abActive, active - true or false
* @param afMaxHeatExposureToAdd, additional exposure above base when it gets very hot
* @param abShouldPerformEvents, whether the player should play sounds or anims as a result of getting tired from the heat
* @param abShouldAffectMoveSpeed, whether the player's speed should be affected
* @param abShouldProtectEyes, whether the player should play the eye protection animation
*/
void Heat_SetActive(const bool abActive, const float afMaxHeatExposureToAdd=1.5f,  const bool abShouldPerformEvents=true, const bool abShouldAffectMoveSpeed=true, const bool abShouldProtectEyes=true)
{
	iScrHeatHandler_Interface @pHandler = cast<iScrHeatHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_HeatHandler));
	pHandler.SetHeatActive(abActive, afMaxHeatExposureToAdd, abShouldPerformEvents, abShouldAffectMoveSpeed, abShouldProtectEyes);
}

