/////////////////////////////////////////
// SHADOW FLESH HANDLER
/////////////////////////////////////////

/**
 * Fades in the specified flesh and decals.
 * @param asFlesh, name of the flesh entities (wildcards supported)
 * @param asDecals, name of the decals (wildcards supported)
 * @param afMinTime, minimum time for the flesh and decals to fade in
 * @param afMaxTime, maximum time for the flesh and decals to fade in
 * @param abDefaultEffects, if default effects for spawning the flesh should be used
 * @param afShake, shake intensity
 */
void ShadowFlesh_Spawn(const tString &in asFlesh, const tString &in asDecals, float afMinTime = 1.5f, float afMaxTime = 3.f, bool abDefaultEffects = false, float afShake = 0.01f, float afImageTrail = 1.f)
{
	iScrShadowFleshHandler_Interface @pHandler = cast<iScrShadowFleshHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ShadowFleshHandler) );
	pHandler.SpawnFlesh(asFlesh, asDecals, afMinTime, afMaxTime, abDefaultEffects, afShake, afImageTrail);
}

//-------------------------------------------------

/**
 * Sets the specified decal's alpha to 0.
 * @param asDecals, name of the decals (wildcards supported)
 */
void ShadowFlesh_SetupDecals(const tString &in asDecals)
{
	iScrShadowFleshHandler_Interface @pHandler = cast<iScrShadowFleshHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ShadowFleshHandler) );
	pHandler.SetupDecals(asDecals);
}

//-------------------------------------------------

/**
 * Stores the IDs of the specified flesh and decals in memory until map leave, can increase performance when spawning.
 * @param asFlesh, name of the flesh entities (wildcards supported)
 * @param asDecals, name of the decals (wildcards supported)
 */
void ShadowFlesh_AddGroup(const tString &in asFlesh, const tString &in asDecals)
{
	iScrShadowFleshHandler_Interface @pHandler = cast<iScrShadowFleshHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ShadowFleshHandler) );
	pHandler.AddGroup(asFlesh, asDecals);
}

//-------------------------------------------------

/**
 * Does flesh spawn effects at the specified position.
 * @param avPos, position to do the effects at
 * @param afLightRadius, radius of the light flash
 * @param afShake, the shake amount
 */
void ShadowFlesh_DoFleshEffectsAtPos(const cVector3f &in avPos, float afLightRadius, float afShake = 0.01f, float afImageTrail = 1.f)
{
	iScrShadowFleshHandler_Interface @pHandler = cast<iScrShadowFleshHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ShadowFleshHandler) );
	pHandler.DoFleshEffectsAtPos(avPos, afLightRadius, afShake, afImageTrail);
}

//-------------------------------------------------

/**
 * If the array of spawned decals should be reset on map leave
 */
void ShadowFlesh_ResetSpawnedDecalsOnMapLeave(bool abX)
{
	iScrShadowFleshHandler_Interface @pHandler = cast<iScrShadowFleshHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ShadowFleshHandler) );
	pHandler.ResetSpawnedDecalsOnMapLeave(abX);
}

/**
 * Volume mul of sound that plays when flesh is spawned
 */
void ShadowFlesh_SetFleshSpawnVolumeMul(float afX)
{
	iScrShadowFleshHandler_Interface @pHandler = cast<iScrShadowFleshHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ShadowFleshHandler) );
	pHandler.SetFleshSpawnSoundVolumeMul(afX);
}


