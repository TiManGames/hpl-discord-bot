}

//-------------------------------------------------

/**
 * Enables/disables average brightness calculation, which takes the brightness of the screen the player is looking at into consideration
 * when calculating whether the player is in darkness or not
 * @param abActive, if average brightness calculation should be active
 */
void FearHandler_SetAverageBrightness(bool abActive)
{
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.SetAverageBrightness(abActive);
}

//-------------------------------------------------

/**
 * Set a forced fear factor which will be added to the current FEAR RATE
 * @param afFearRate, the amount FEAR RATE that will be added to the FEAR RATE
 * @param afDuration, how long the factor should be active, negative value will cancel any forced additions
 * @param abGasp, if tasi should gasp (only afFearFactor > 0.4f will gasp if true)
 * @param afIncreaseSpeed, how fast the FEAR RATE should increase, unit: FEAR RATE per second, negative value means default value
 * @param afDecreaseSpeed, how fast the FEAR RATE should decrease, unit: FEAR RATE per second, negative value means default value
 * @param afDelay, how much time should pass before the FEAR RATE should start to increase
 */
void FearHandler_SetForcedAddFearRate(float afFearRate, float afDuration = -1.0f, bool abGasp = true, float afIncreaseSpeed = -1.0f, float afDecreaseSpeed = -1.0f, float afDelay = 0.0f)
{
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.SetForcedAddFearRate(eFearForcedRateType_Script, afFearRate, afDuration, abGasp, afIncreaseSpeed, afDecreaseSpeed, afDelay);
}

//-------------------------------------------------

/**
 * Set a forced fear factor which will be added to the current FEAR RATE
 * @param aType, the type of the forced rate.
 * @param afFearRate, the amount FEAR RATE that will be added to the FEAR RATE
 * @param afDuration, how long the factor should be active, negative value will cancel any forced additions
 * @param abGasp, if tasi should gasp (only afFearFactor > 0.4f will gasp if true)
 * @param afIncreaseSpeed, how fast the FEAR RATE should increase, unit: FEAR RATE per second, negative value means default value
 * @param afDecreaseSpeed, how fast the FEAR RATE should decrease, unit: FEAR RATE per second, negative value means default value
 * @param afDelay, how much time should pass before the FEAR RATE should start to increase
 */
void FearHandler_SetForcedAddFearRate(eFearForcedRateType aType, float afFearRate, float afDuration = -1.0f, bool abGasp = true, float afIncreaseSpeed = -1.0f, float afDecreaseSpeed = -1.0f, float afDelay = 0.0f)
{
	iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
	pHandler.SetForcedAddFearRate(aType, afFearRate, afDuration, abGasp, afIncreaseSpeed, afDecreaseSpeed, afDelay);
}

