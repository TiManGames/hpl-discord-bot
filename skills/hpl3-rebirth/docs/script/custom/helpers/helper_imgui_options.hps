bool OptionMenu_GetMouseOnLeftSide(cVector2f avPos)
{
	cVector3f vPos = OptionMenu_GetTopLeftOffset(avPos  + kOptionMenu_MultiOffset + cVector2f(115, 0), 1.5);
	cVector2f vMousePos = ImGui_GetMousePosition();
		
	return (vMousePos.x - vPos.x) < 0;
}

//-------------------------------------------------------

bool OptionMenu_GetMouseOnLeftSideNrm(cVector3f avPos)
{
	cVector2f vMousePos = ImGui_GetMousePosition();
		
	return (vMousePos.x - avPos.x) < 0;
}

//------------------------------------------------------- 

int OptionMenu_GetMouseInsideToggle(cVector3f avLeft, cVector3f avRight, cVector2f avSize)
{
	if (ImGui_GetModUseInput() == false)
		return 0;

	///////////////////////////////////////////
	// -1 = left, 1 = right, 0 = not hovering
	int lSelected = 0;
	float fMargin = 5;
	cVector2f vMousePos = ImGui_GetMousePosition();
	
	if (vMousePos.y < avLeft.y || vMousePos.y > avLeft.y+avSize.y*2) return 0;
	
	if (vMousePos.x >= avLeft.x && vMousePos.x <= avLeft.x+avSize.x) lSelected = -1;
	else if (vMousePos.x >= avRight.x && vMousePos.x <= avRight.x+avSize.x) lSelected = 1;
	
	//cLux_AddDebugMessage("SELECTED: "+lSelected);
	
	mlCurrentDir = lSelected;
	
	if (mlCurrentDir != mlLastDir)
	{
		cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
		mlLastDir = mlCurrentDir;
	}
	
	return lSelected;
}

//-------------------------------------------------------

bool OptionMenu_GetMouseInsideSliderArrow(cVector2f avMin, cVector2f avMax)
{
	if (ImGui_GetModUseInput() == false)
		return false;

	cVector3f vMin = OptionMenu_GetTopLeftOffset(avMin, 1.5);
	cVector3f vMax = OptionMenu_GetTopLeftOffset(avMax, 1.5);
	cVector2f vMousePos = ImGui_GetMousePosition();
	
	//cLux_AddDebugMessage("MIN: "+vMin+" - MAX: "+vMax+" - MOUSE: "+vMousePos);
		
	vMousePos.x = (vMousePos.x - vMin.x) / (vMax.x - vMin.x);

	if(vMousePos.x >= 0 && vMousePos.x <= 1)
	{
		return true;
	}

	return false;
}

//-------------------------------------------------------

int mlLastDir = 0;

int OptionMenu_GetMouseInsideMultiSelectArrows(cVector3f avPos, cVector2f avSize)
{
	if (ImGui_GetModUseInput() == false)
		return 0;

	int lArrow = 0;
	
	cVector2f vMousePos = ImGui_GetMousePosition();
	
	if (vMousePos.x >= avPos.x && vMousePos.x <= avPos.x+avSize.x/2) lArrow = -1;
	else if (vMousePos.x > avPos.x+avSize.x/2 && vMousePos.x <= avPos.x+avSize.x) lArrow = 1;
		
	mlCurrentDir = lArrow;
	
	if (mlCurrentDir != mlLastDir)
	{
		cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
		mlLastDir = mlCurrentDir;
	}
		
	return lArrow;
}

int OptionMenu_GetMouseInsideSliderArrowsNew(cVector3f avLeft, cVector3f avRight, cVector2f avSize)
{
	///////////////////////////////////////////
	// -1 = left, 1 = right, 0 = not hovering
	if(ImGui_GetModUseInput() == false)
		return 0;

	int lArrow = 0;
	float fMargin = 5;
	cVector2f vMousePos = ImGui_GetMousePosition();

	if (vMousePos.y < avLeft.y || vMousePos.y > avLeft.y+avSize.y) return 0;
	
	if (vMousePos.x >= avLeft.x-fMargin && vMousePos.x <= avLeft.x+avSize.x+fMargin) lArrow = -1;
	else if (vMousePos.x >= avRight.x-fMargin && vMousePos.x <= avRight.x+avSize.x+fMargin) lArrow = 1;
	
	//cLux_AddDebugMessage("ARROW: "+lArrow);
	
	mlCurrentDir = lArrow;
	
	if (mlCurrentDir != mlLastDir && mlCurrentDir != 0)
	{
		cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
		mlLastDir = mlCurrentDir;
	}
	
	return lArrow;
}

cVector2f OptionMenu_GetMouseInsideSlider(cVector2f avMin, cVector2f avMax)
{
	if (ImGui_GetModUseInput() == false)
		return -1.0;

	cVector2f vMousePos = ImGui_GetMousePosition();
		
	vMousePos.x = (vMousePos.x - avMin.x) / (avMax.x - avMin.x);
	vMousePos.y = (vMousePos.y - avMin.y) / (avMax.y - avMin.y);

	if(vMousePos.y >= 0 && vMousePos.y <= 1 &&
		vMousePos.x >= 0 && vMousePos.x <= 1)
	{
		return vMousePos;
	}

	return -1.0;
}

//------------------------------------------------------- 

int OptionMenu_GetMouseInsideSliderArrows(cVector2f avPos)
{
	if (ImGui_GetModUseInput() == false)
		return 0;

	///////////////////////////////////////////
	// -1 = left, 1 = right, 0 = not hovering
	
	int lArrow = 0;
	
	if (OptionMenu_GetMouseInsideSliderArrow(avPos+cVector2f(kOptionMenu_SliderArrowOffsetL.x-40,0), avPos+cVector2f(kOptionMenu_SliderArrowOffsetL.x+20,1))) lArrow = -1;
	else if (OptionMenu_GetMouseInsideSliderArrow(avPos+cVector2f(kOptionMenu_SliderArrowOffsetR.x-40,0), avPos+cVector2f(kOptionMenu_SliderArrowOffsetR.x+60,1))) lArrow = 1;
	
	return lArrow;
}

//------------------------------------------------------- 

cVector2f OptionMenu_GetMouseInside(cVector2f avMin, cVector2f avMax)
{
	if (ImGui_GetModUseInput() == false)
		return -1.0;

	cVector3f vMin = OptionMenu_GetTopLeftOffset(avMin, 1.5);
	cVector3f vMax = OptionMenu_GetTopLeftOffset(avMax, 1.5);
	cVector2f vMousePos = ImGui_GetMousePosition();
		
	vMousePos.x = (vMousePos.x - vMin.x) / (vMax.x - vMin.x);
	vMousePos.y = (vMousePos.y - vMin.y) / (vMax.y - vMin.y);

	if(vMousePos.y >= 0 && vMousePos.y <= 1 &&
		vMousePos.x >= 0 && vMousePos.x <= 1)
	{
		return vMousePos;
	}

	return -1.0;
}

//------------------------------------------------------- 

tString OptionMenu_UpdateFocus(tString asID, tString asSelector)
{	
	if (ImGui_PrevBecameInFocus())
	{
		//cLux_AddTodoMessage("Sound: Menu focus changed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
		return asID;
	}
	//cLux_AddDebugMessage("SELECTOR:"+asSelector);
	return asSelector;
}

//-------------------------------------------------------

void OptionMenu_OptionsCheckbox(cVector2f avPos, bool abIsSelected, bool abIsChecked, tString asOffText = "Off", tString asOnText="On", const tString &in asName="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1)
{
	////////////////
	// Draw background
	cImGuiGfx gfxOn("startmenu_frame_yesno");
	cImGuiGfx gfxOff("startmenu_frame_yesno");
	cImGuiGfx gfxHover("startmenu_underscore_yesno");

	cVector3f vPosNrm = OptionMenu_GetTopLeftOffset(avPos,3);
	cVector3f vRightAnchorNrm = OptionMenu_GetTopLeftOffset(avRightAnchor);
	//vRightAnchorNrm = cVector3f(avRightAnchor.x,avRightAnchor.y,30);
	
	cVector2f vButtonSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_MultiSize+cVector2f(gfOptionsMenu_ExtraWidth_Toggle, 0));
	cVector3f vButtonLeftPosNrm = cVector3f(vRightAnchorNrm.x-vButtonSizeNrm.x,vPosNrm.y+5, vPosNrm.z);
	cVector3f vButtonRightPosNrm = cVector3f(vRightAnchorNrm.x-vButtonSizeNrm.x/2,vPosNrm.y+5, vPosNrm.z);
	
	cImGuiGfx gfxButton = cImGuiGfx(OptionMenu_GetButtonBackground(cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y)), eImGuiGfx_Texture);
	
	cVector2f vUnderlineSizeNrm = OptionMenu_GetScaledSize(cVector2f(70,5));
	//cVector2f vCircleSize = OptionMenu_GetScaledSize(kOptionMenu_CheckboxCircleSize);
	
	cVector3f vButtonLeftMiddleNrm = cVector3f(vButtonLeftPosNrm.x+vButtonSizeNrm.x/4,vButtonLeftPosNrm.y+vButtonSizeNrm.y/2,vPosNrm.z+1);
	cVector3f vButtonRightMiddleNrm = cVector3f(vButtonRightPosNrm.x+vButtonSizeNrm.x/4,vButtonRightPosNrm.y+vButtonSizeNrm.y/2,vPosNrm.z+1);
	
	float fButtonSeparation = 5;
	//cVector2f vCheckboxSize = OptionMenu_GetScaledSize(kOptionMenu_CheckboxSize+cVector2f(gfOptionsMenu_ExtraWidth_Toggle*0.5, 0));
	
	// LEFT
	ImGui_DrawGfx(gfxButton, vButtonLeftPosNrm, cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y), kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
	// RIGHT
	ImGui_DrawGfx(gfxButton, vButtonRightPosNrm, cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y), kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
	
	if (abIsChecked)
	{
		ImGui_DrawGfx(gfxOn, vButtonRightPosNrm+cVector3f(-6,0,1), cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y), cColor_White*cColor(1,afAlpha));
		//ImGui_DrawGfx(gfxOn, vButtonLeftMiddleNrm-cVector3f(vCircleSize.x/2,vCircleSize.y/2,0), OptionMenu_GetScaledSize(kOptionMenu_CheckboxCircleSize), cColor(1,1));
		if (abIsSelected && OptionMenu_GetMouseInsideToggle(vButtonLeftPosNrm, vButtonRightPosNrm, vButtonSizeNrm/2) == -1)
			ImGui_DrawGfx(gfxHover, vButtonLeftMiddleNrm+cVector3f(-vUnderlineSizeNrm.x/2,vButtonSizeNrm.y-27,1), vUnderlineSizeNrm, cColor_White*cColor(1,afAlpha));
	}
	else
	{
		ImGui_DrawGfx(gfxOff, vButtonLeftPosNrm+cVector3f(-6,0,1), cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y), cColor_White*cColor(1,afAlpha));

		//ImGui_DrawGfx(gfxOn, vButtonRightMiddleNrm-cVector3f(vCircleSize.x/2,vCircleSize.y/2,0), OptionMenu_GetScaledSize(kOptionMenu_CheckboxCircleSize), cColor(1,1));
		if (abIsSelected && OptionMenu_GetMouseInsideToggle(vButtonLeftPosNrm, vButtonRightPosNrm, vButtonSizeNrm/2) == 1)
			ImGui_DrawGfx(gfxHover, vButtonRightMiddleNrm+cVector3f(-vUnderlineSizeNrm.x/2,vButtonSizeNrm.y-27,1), vUnderlineSizeNrm, cColor_White*cColor(1,afAlpha));
	}
	
	if (abIsSelected)
	{		
		cVector3f vInfoBoxPos = OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_TextedSliderTextOffset + cVector2f(kOptionMenu_TextedSliderSize.x,0), 0) + OptionMenu_GetTopLeftOffset(kOptionMenu_InfoBoxBgOffset);
		OptionMenu_InfoBox("", cVector3f(avInfoBoxPos.x,vInfoBoxPos.y,avInfoBoxPos.z), kOptionMenu_InfoBoxBgSize, asName+"_Info",afAlpha);
	}

	///////////////
	// Draw labels
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	labelData.mFont.mvSize = cVector2f(36, 36);
	labelData.mFont.mColor = cColor(1, afAlpha);
	
	labelData.mFontAlign = eFontAlign_Center;
	//vCheckboxSize.x -= 20;
	//vCheckboxSize.y = -1;
	
	cImGuiLabelData labelLeftData = labelData;
	cImGuiLabelData labelRightData = labelData;
	
	if (abIsChecked)
		labelLeftData.mFont.mColor = cColor(0.7f,afAlpha);
	else
		labelRightData.mFont.mColor = cColor(0.7f,afAlpha);
	
	//float fPos = OptionMenu_GetTopLeftOffset(avPos+ kOptionMenu_CheckboxOffset, 2.0).x;
	
	// OFF
	ImGui_DoLabelExt(asOffText,labelLeftData, vButtonLeftPosNrm+cVector3f(0,8,0), vButtonSizeNrm/2);
	// ON
	ImGui_DoLabelExt(asOnText,labelRightData, vButtonRightPosNrm+cVector3f(0,8,0), vButtonSizeNrm/2);
}

//-------------------------------------------------------

tString sSliderActive = "";
	
float OptionMenu_OptionsSlider(cVector2f avMainPos, cVector2f avPos, float afValue, int alID, float afStepSize, int alUIActionHorizontal, cImGuiButtonData aButtonData, tString asTextValue, bool abSelected, tString asTextValueTransCat="", const tString &in asName="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1)
{
	bool bTexted = asTextValue.length() > 0;
	float fLabelWidth = (bTexted) ? 60 : 0;
	
	////////////////
	// Draw background
	cImGuiGfx gfx("startmenu_button_wide", eImGuiGfx_Texture);
	cImGuiGfx gfxArrow("startmenu_options_arrow");
	cImGuiGfx gfxArrowHover("startmenu_selection_ring_arrow");
	cImGuiGfx gfxArrowUnderlineHover("startmenu_underscore_triangle");
	cImGuiGfx gfxBar;
	// Absolute left of the entire row left
	cVector3f vPosNrm = OptionMenu_GetTopLeftOffset(avPos,1);
	cVector3f vLeftAnchorNrm = OptionMenu_GetTopLeftOffset(avMainPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0);
	cVector3f vRightAnchorNrm = OptionMenu_GetTopLeftOffset(avRightAnchor);
	cVector2f vButtonAreaSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_SliderSize+cVector2f(gfOptionsMenu_ExtraWidth_MultiSelect, 0));
	cVector3f vButtonAreaPosNrm = cVector3f(vRightAnchorNrm.x-vButtonAreaSizeNrm.x,vPosNrm.y+5, vPosNrm.z);
	cVector3f vArrowLeftPosNrm = cVector3f(vButtonAreaPosNrm.x+8,vButtonAreaPosNrm.y-5,vPosNrm.z+2);
	cVector3f vArrowRightPosNrm = cVector3f(vButtonAreaPosNrm.x+vButtonAreaSizeNrm.x-OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize).x+10-fLabelWidth,vButtonAreaPosNrm.y-4,vPosNrm.z+2);
	cVector2f vArrowSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize);
	cVector2f vArrowHoverSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverUnderlineSize);

	// Interaction Area
	cVector2f vSliderMin = cVector2f(vArrowLeftPosNrm.x+vArrowSizeNrm.x);
	cVector2f vSliderMax = cVector2f(vArrowRightPosNrm.x);
	
	//ImGui_DrawGfx(cImGuiGfx(), vLeftAnchorNrm, OptionMenu_GetScaledSize(kOptionMenu_ButtonSize), kOptionMenu_ButtonBgColor*gOptionMenu_ModColor);
	
	cVector2f vVal = OptionMenu_GetMouseInsideSlider(vSliderMin - cVector2f(0, 1024), vSliderMax + cVector2f(0, 1024));
	float fVal = vVal.x;
	int lHoveredArrow = OptionMenu_GetMouseInsideSliderArrowsNew(vArrowLeftPosNrm,vArrowRightPosNrm,vArrowSizeNrm);
	
	//if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0),  OptionMenu_GetScaledSize(cVector2f(avRightAnchor.x-avPos.x, kOptionMenu_ButtonSize.y))))
	{
		if(fVal != -1)
		{
			//////////////
			// Reapet button if it is being clicked
			if(ImGui_DoRepeatButtonExt(asName,asName, aButtonData, vLeftAnchorNrm+cVector3f(0,0,100), cVector2f(vRightAnchorNrm.x-vLeftAnchorNrm.x,kOptionMenu_ButtonSize.y)))
			{				
				//ImGui_DoButton("Dummy","",cVector3f(0,0,vArrowLeftPosNrm.z+3),cVector2f_One*1000);
				sSliderActive = asName;
				cLux_GetCurrentImGui().LockMouseFocus();
				
				if(cMath_Abs(fVal-afValue)>0.001f)
				{
					afValue = fVal;
					
					//float fSoundVal = cMath_Floor(fVal*100);
					//cLux_AddDebugMessage("SVAL: "+fSoundVal);
					if (Map_TimeHasPassed("SliderDelay",0.08f)) Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
					
					
					cLux_AddDebugMessage("VALUE: "+fVal);
					//cLux_AddTodoMessage("Sound: Menu slider value changed ");
					
				}
			}
		}
		else
		{	
			//////////////////////
			// Snap to min-max when out of boundaries
			if (sSliderActive == asName)
			{
				if (ImGui_ActionIsDown(eImGuiAction_MouseLeft) == false)
				{
					cLux_AddDebugMessage("RELEASE");
					sSliderActive = "";
				}
				else
				{
					cLux_GetCurrentImGui().LockMouseFocus();
					//afValue = (ImGui_GetMousePosition().x < vPosNrm.x+30) ? 0 : 1;
					afValue = (afValue <= 0.5) ? 0 : 1;
					//cLux_AddDebugMessage("afValue: " + afValue);
				}
			}
			
			//////////////
			// Normal button
			// if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0),  OptionMenu_GetScaledSize(cVector2f(avRightAnchor.x-avPos.x, kOptionMenu_ButtonSize.y))))
			// if(ImGui_DoButtonExt(asName,asName, aButtonData, vLeftAnchorNrm, OptionMenu_GetScaledSize(kOptionMenu_ButtonSize)))
			if(ImGui_DoButtonExt(asName,asName, aButtonData, vLeftAnchorNrm, cVector2f(vRightAnchorNrm.x-vLeftAnchorNrm.x,kOptionMenu_ButtonSize.y)))
			{
				
				// Select based on which side the mouse was
				if(ImGui_GetMouseVisible()) 
				{
					fVal = cMath_Clamp(afValue + afStepSize*mlCurrentDir, 0.0f, 1.0f);
				}

				if(afValue != fVal && fVal != -1)
				{
					afValue = fVal;
					cLux_AddTodoMessage("Sound: Menu slider value changed ");
					if (Map_TimeHasPassed("SliderDelay",0.08f)) Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
				}
			}
		}

		///////////
		// Gamepad input
		if(abSelected)
		{
			afValue += alUIActionHorizontal * afStepSize;

			if(alUIActionHorizontal != 0)
			{
				cLux_AddTodoMessage("Sound: Menu slider value changed");
				if (Map_TimeHasPassed("SliderDelay",0.08f)) Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
			}
		}

		/////////////
		// Clamp
		afValue = cMath_Clamp(afValue, 0.0, 1.0);
	}
	
	cColor arrowRHover = (lHoveredArrow == 1) ? cColor(1,afAlpha) : cColor(1,0);
	cColor arrowLHover = (lHoveredArrow == -1) ? cColor(1,afAlpha) : cColor(1,0);
	//cLux_AddDebugMessage(asName+" "+lHoveredArrow+ " - Selected: "+abSelected);
	
	if(ImGui_GetMouseVisible() == false || abSelected == false || lHoveredArrow == 0)
	{
		arrowRHover = cColor(0,0);
		arrowLHover = cColor(0,0);
	}
		
	if (abSelected)
	{
		////////////////
		// InfoBox
		cVector3f vInfoBoxPos = OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_TextedSliderTextOffset + cVector2f(kOptionMenu_TextedSliderSize.x,0), 0) + OptionMenu_GetTopLeftOffset(kOptionMenu_InfoBoxBgOffset);
		OptionMenu_InfoBox("", cVector3f(avInfoBoxPos.x,vInfoBoxPos.y,avInfoBoxPos.z), kOptionMenu_InfoBoxBgSize, asName+"_Info");
	}
	
	//ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_SliderOffset, 1.5), OptionMenu_GetScaledSize(kOptionMenu_SliderSize), kOptionMenu_ButtonBgColor*gOptionMenu_ModColor);
	
	//////////////////////
	// Slider with text
	if (bTexted)
	{
		////////////
		// Draw background
		ImGui_DrawGfx(gfx, vButtonAreaPosNrm, vButtonAreaSizeNrm, kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
		
		//////////////
		// Draw text at the end
		cImGuiLabelData labelData;
		labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
		labelData.mFont.mvSize = cVector2f(36, 36);
		labelData.mFont.mColor = cColor(1, afAlpha)*gOptionMenu_ModColor;
		labelData.mFontAlign = eFontAlign_Right;
		
		ImGui_SetTransCategory(asTextValueTransCat);
		ImGui_DoLabelExt(asTextValue,labelData, vButtonAreaPosNrm+cVector3f(vButtonAreaSizeNrm.x-fLabelWidth,-4,0));
		ImGui_SetTransCategory("Menu");
			
		/////////////
		// Draw arrows
		ImGui_SetModRotateAngle(180);
		ImGui_DrawGfx(gfxArrow, vArrowLeftPosNrm, vArrowSizeNrm, cColor(1,afAlpha));
		//ImGui_DrawGfx(gfxArrowUnderlineHover, vArrowLeftPosNrm+cVector3f(3,kOptionMenu_SliderArrowSize.y-8,1), vArrowHoverSizeNrm, arrowLHover);
		ImGui_DrawGfx(gfxArrowHover, vArrowLeftPosNrm+cVector3f(-6,6,1), OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize), arrowLHover);
		ImGui_SetModRotateAngle(0.0);
		ImGui_DrawGfx(gfxArrow, vArrowRightPosNrm, vArrowSizeNrm, cColor(1,afAlpha));
		//ImGui_DrawGfx(gfxArrowUnderlineHover, vArrowRightPosNrm+cVector3f(-3,kOptionMenu_SliderArrowSize.y-8,1), vArrowHoverSizeNrm, arrowRHover);
		ImGui_DrawGfx(gfxArrowHover, vArrowRightPosNrm+cVector3f(-8,4,1), OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize), arrowRHover);
		

		//////////////
		// Draw bar
		
		ImGui_DrawGfx(gfxBar, cVector3f(vSliderMin.x,vPosNrm.y+vButtonAreaSizeNrm.y/2,vArrowLeftPosNrm.z), cVector2f(vSliderMax.x-vSliderMin.x,5), cColor(1,afAlpha));
		ImGui_DrawGfx(gfxBar, cVector3f(vSliderMin.x+afValue*(vSliderMax.x-vSliderMin.x),vPosNrm.y+13,vArrowLeftPosNrm.z), OptionMenu_GetScaledSize(cVector2f(6, 16)), cColor(1,afAlpha));
		
		//ImGui_DrawGfx(gfxBar, OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_TextedSliderBarOffset + kOptionMenu_TextedSliderBarSize * cVector2f(afValue, 0.5) + cVector2f(-3, -8), 2.0), OptionMenu_GetScaledSize(cVector2f(6, 16)), cColor(1,1));

	}
	else
	{
		
		////////////
		// Draw background
		ImGui_DrawGfx(gfx, vButtonAreaPosNrm+cVector3f(0,0,0.1), vButtonAreaSizeNrm, kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
			
		/////////////
		// Draw arrows
		
		ImGui_SetModRotateAngle(180);
		ImGui_DrawGfx(gfxArrow, vArrowLeftPosNrm, vArrowSizeNrm, cColor(1,afAlpha));
		//ImGui_DrawGfx(gfxArrowUnderlineHover, vArrowLeftPosNrm+cVector3f(3,kOptionMenu_SliderArrowSize.y-8,1), vArrowHoverSizeNrm, arrowLHover);
		ImGui_DrawGfx(gfxArrowHover, vArrowLeftPosNrm+cVector3f(-6,6,1), OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize), arrowLHover);
		ImGui_SetModRotateAngle(0.0);
		ImGui_DrawGfx(gfxArrow, vArrowRightPosNrm, vArrowSizeNrm, cColor(1,afAlpha));
		//ImGui_DrawGfx(gfxArrowUnderlineHover, vArrowRightPosNrm+cVector3f(-3,kOptionMenu_SliderArrowSize.y-8,1), vArrowHoverSizeNrm, arrowRHover);
		ImGui_DrawGfx(gfxArrowHover, vArrowRightPosNrm+cVector3f(-8,4,1), OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize), arrowRHover);
		

		//////////////
		// Draw bar
		ImGui_DrawGfx(gfxBar, cVector3f(vSliderMin.x,vPosNrm.y+vButtonAreaSizeNrm.y/2,vArrowLeftPosNrm.z), cVector2f(vSliderMax.x-vSliderMin.x,5), cColor(1,afAlpha));
		ImGui_DrawGfx(gfxBar, cVector3f(vSliderMin.x+afValue*(vSliderMax.x-vSliderMin.x),vPosNrm.y+13,vArrowLeftPosNrm.z), OptionMenu_GetScaledSize(cVector2f(6, 16)), cColor(1,afAlpha));
	}
	
	return afValue;
}

//-------------------------------------------------------

tString OptionMenu_GetInfoBox(cVector2f avSize)
{
	
	int w = avSize.x*2;
	int h = avSize.y*2;
	
	float fRatio = float(w)/float(h);
	//cLux_AddDebugMessage("RATIO: "+fRatio);
	
	if (fRatio <= 0.7f)
	{
		w = 650;
		h = 1000;
	}
	else if (fRatio <= 1.25f)
	{
		w = 1200;
		h = 800;
	}
	else if (fRatio <= 1.5f)
	{
		w = 650;
		h = 450;
	}
	else if (fRatio <= 2.f)
	{
		w = 900;
		h = 450;
	}
	else
	{
		w = 1500;
		h = 450;
	}
	
	return "mainmenu_submenu_backdrop_"+w+"x"+h;
}

//------------------------------------------------------- 

void OptionMenu_InfoBox(tString asGfx, cVector3f avPos, cVector2f avSize, const tString &in asText, float afAlpha=1)
{
	if (cLux_HasTranslation("Menu",asText) == false) return;
	
	//cLux_AddDebugMessage("Rendering info");
	
	float fClampedSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize().x-cLux_GetCurrentImGui().GetSet().GetVirtualSizeOffset().x-15-avPos.x;
	cVector3f vPos = avPos;
	cVector2f vSize = cVector2f(cMath_Min(avSize.x,fClampedSize),avSize.y);
		
	cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
	textData.mbUseBackgroundGfx = false;
	textData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu_InfoBox,56));
	textData.mFont.mvSize = cVector2f(gfFontSize_InfoBox);
	textData.mFont.mColor = cColor(1, afAlpha)*gTextCol_Dark;
	textData.mFontAlign = eFontAlign_Left;
	
	array<tWString> vLines;
	GetFontWordWrapRows(textData.mFont,1,asText,vSize.x,vLines);
	
	float fTextVertSpacing = 12;
	float fTextHeight = (textData.mFont.mvSize.y+fTextVertSpacing)*vLines.length();
	float fBkgHeight = fTextHeight+fTextVertSpacing+20;
	
	cGuiSet@ pSet = cLux_GetCurrentImGui().GetSet();
	//cLux_AddDebugMessage("SIZE Y: "+pSet.GetVirtualSize().y+" - "+ImGui_GetMousePosition().y);
	if (vPos.y+fBkgHeight > pSet.GetVirtualSize().y) vPos.y-=(vPos.y+fBkgHeight-pSet.GetVirtualSize().y);
	cVector3f vBkgPos = cVector3f(vPos.x,vPos.y-12,22);
	cVector3f vTextPos = cVector3f(vBkgPos.x+30,vPos.y+10,23);
	
	
	
	tString sBkg = OptionMenu_GetInfoBox(cVector2f(vSize.x+50,fBkgHeight));
	cImGuiGfx gfxBkg(sBkg, eImGuiGfx_Texture);
	ImGui_DrawGfx(gfxBkg, vBkgPos, cVector2f(vSize.x+50,fBkgHeight), cColor(1,afAlpha));
	ImGui_DoTextFrameExt(asText, cVector2f_Zero, fTextVertSpacing, 0, textData, vTextPos, cVector2f(vSize.x,fTextHeight));
}

//-------------------------------------------------------

int mlCurrentDir = 0;
	
void OptionMenu_OptionsMultiSelect(cVector2f avPos, array<tString> aArray, int aValue, bool abSelected, tString asCategory="Menu", tString asName="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1)
{
	////////////////
	// Draw background
	cVector3f vPosNrm = OptionMenu_GetTopLeftOffset(avPos,2);
	cVector3f vRightAnchorNrm = OptionMenu_GetTopLeftOffset(avRightAnchor);
	
	cVector2f vButtonSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_MultiSize+cVector2f(gfOptionsMenu_ExtraWidth_MultiSelect, 0));
	cVector3f vButtonPosNrm = cVector3f(vRightAnchorNrm.x-vButtonSizeNrm.x,vPosNrm.y+5, vPosNrm.z);
	cVector3f vLabelPosNrm = cVector3f(vButtonPosNrm.x+vButtonSizeNrm.x/2, vButtonPosNrm.y, vPosNrm.z+1);
	cVector3f vArrowLeftPosNrm = cVector3f(vButtonPosNrm.x+8,vButtonPosNrm.y-1,vPosNrm.z+2);
	cVector3f vArrowRightPosNrm = cVector3f(vButtonPosNrm.x+vButtonSizeNrm.x-OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize).x,vButtonPosNrm.y-1,vPosNrm.z+2);
	cVector2f vArrowSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize);
	cVector2f vArrowHoverSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverUnderlineSize);
	cImGuiGfx gfx = cImGuiGfx(OptionMenu_GetButtonBackground(vButtonSizeNrm), eImGuiGfx_Texture);
	cImGuiGfx gfxArrow("startmenu_options_arrow");
	cImGuiGfx gfxArrowHover("startmenu_selection_ring_arrow");
	//cImGuiGfx gfxArrowUnderlineHover("startmenu_underscore_triangle");
	
	//cVector3f vLabelPosNrm = OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_MultiOffset + cVector2f((kOptionMenu_MultiSize.x+gfOptionsMenu_ExtraWidth_MultiSelect)/2, 0), 2.0);
	
	
	ImGui_DrawGfx(gfx, vButtonPosNrm, vButtonSizeNrm, kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
	//ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_MultiOffset, 1.5), OptionMenu_GetScaledSize(kOptionMenu_MultiSize+cVector2f(gfOptionsMenu_ExtraWidth_MultiSelect, 0)), kOptionMenu_ButtonBgColor*gOptionMenu_ModColor);
	
	
	//int lArrowHovered = OptionMenu_GetMouseInsideSliderArrowsNew(vArrowLeftPosNrm,vArrowRightPosNrm,vArrowSizeNrm);
	
	
	//cLux_AddDebugMessage("ARROW: "+lArrowHovered);
	
	if(abSelected)
	{
		bool bMouseOnLeft = OptionMenu_GetMouseOnLeftSide(avPos);
		int lArrowHovered = OptionMenu_GetMouseInsideMultiSelectArrows(vButtonPosNrm, vButtonSizeNrm);
		bool bMouseOnArrows = lArrowHovered != 0;
		//cLux_AddDebugMessage("SIDE: "+bMouseOnLeft);
		/////////////
		// Draw selected arrows
		cColor right = bMouseOnLeft ? cColor(1, afAlpha) : cColor(1, afAlpha);
		cColor left = bMouseOnLeft ? cColor(1, afAlpha) : cColor(1, afAlpha);
		cColor arrowLHover;
		cColor arrowRHover;
		
		if (bMouseOnArrows)
		{
			if (lArrowHovered == 1)
			{
				arrowLHover = cColor(1,0);
				arrowRHover = cColor(1,afAlpha);
			}
			else
			{
				arrowLHover = cColor(1,afAlpha);
				arrowRHover = cColor(1,0);
			}
		}
		
		////////////////
		// InfoBox
		
		cVector3f vInfoBoxPos = vLabelPosNrm+cVector3f(kOptionMenu_MultiSize.x/2+60,0,0);
		OptionMenu_InfoBox("", cVector3f(avInfoBoxPos.x,vInfoBoxPos.y,avInfoBoxPos.z), kOptionMenu_InfoBoxBgSize, asName+"_Info", afAlpha);
		
		if(ImGui_GetMouseVisible() == false)
		{
			left = right = cColor(1,afAlpha);
			arrowLHover = cColor(1,0);
			arrowRHover = cColor(1,0);
		}
		
		ImGui_DrawGfx(gfxArrow, vArrowRightPosNrm, OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize), left*gOptionMenu_ModColor);
		//if (bMouseOnArrows) ImGui_DrawGfx(gfxArrowUnderlineHover, vArrowRightPosNrm+cVector3f(0,kOptionMenu_SliderArrowSize.y-10,1), vArrowHoverSizeNrm, arrowRHover);
		if (bMouseOnArrows) ImGui_DrawGfx(gfxArrowHover, vArrowRightPosNrm+cVector3f(-6,4,1), OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize), arrowRHover);
		ImGui_SetModRotateAngle(180);
		
		ImGui_DrawGfx(gfxArrow, vArrowLeftPosNrm, OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize), left*gOptionMenu_ModColor);
		//if (bMouseOnArrows) ImGui_DrawGfx(gfxArrowUnderlineHover, vArrowLeftPosNrm+cVector3f(3,kOptionMenu_SliderArrowSize.y-8,1), vArrowHoverSizeNrm, arrowLHover);
		if (bMouseOnArrows) ImGui_DrawGfx(gfxArrowHover, vArrowLeftPosNrm+cVector3f(-6,4,1), OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize), arrowLHover);
		ImGui_SetModRotateAngle(0.0);
		
	}
	else
	{
		cColor arrowLHover = cColor(1,0);
		cColor arrowRHover = cColor(1,0);

		/////////////
		// Draw arrows
		ImGui_DrawGfx(gfxArrow, vArrowRightPosNrm, OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize), cColor(1,afAlpha)*gOptionMenu_ModColor);
		ImGui_SetModRotateAngle(180);
		ImGui_DrawGfx(gfxArrow, vArrowLeftPosNrm, OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize), cColor(1,afAlpha)*gOptionMenu_ModColor);		
		ImGui_SetModRotateAngle(0.0);
	}
		
	///////////////
	// Draw multi-select items
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	labelData.mFont.mvSize = cVector2f(36, 36);
	labelData.mFont.mColor = cColor(1, afAlpha)*gOptionMenu_ModColor;
	labelData.mFontAlign = eFontAlign_Center;

	if(aValue < aArray.size())
	{
		ImGui_SetTransCategory(asCategory);
		ImGui_DoLabelExt(aArray[aValue],labelData, vLabelPosNrm, 0);
		ImGui_SetTransCategory("Menu");
	}
}

//-------------------------------------------------------

int OptionMenu_MessageBox(const tString &in asMessage, const tString &in asButton, tString &out asFocusIn, tString &out asFocusOut, const bool abPlaySound=true)
{
	return OptionMenu_MessageBox(asMessage, asButton, "", asFocusIn, asFocusOut, tWString(""), abPlaySound);
}

//------------------------------------------------------- 

int mlPrevSelectedButton = 0;
int mlSelectedButton = 0;

int OptionMenu_MessageBox(const tString &in asMessage, const tString &in asLeft, const tString &in asRight, tString &out asFocusIn, tString &out asFocusOut, const tWString &in asSecondRow=tWString(""), const bool abPlaySound=true)
{	
	////////////////////////////////////
	// ImGui Data
	
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	labelData.mFont.mvSize = cVector2f(36, 36);
	labelData.mFont.mColor = cColor(0,1);
	labelData.mFontAlign = eFontAlign_Center;
	
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = true;
	buttonData.mGfxBackground = cImGuiGfx("startmenu_button_short.tga");
	buttonData.mGfxBackground.mColor = kOptionMenu_ButtonBgColor;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = cVector2f(36, 36);
	buttonData.mFontAlign = eFontAlign_Center;
	buttonData.mFont.mColor = cColor(1, 1);
	
	cImGuiButtonData buttonLeftData = buttonData;
	buttonLeftData.mGfxInFocus = cImGuiGfx("startmenu_selection_ring_on.tga");
	buttonLeftData.mGfxInFocus.mColor = cColor(1, 1);
		
	cImGuiButtonData buttonRightData = buttonData;
	buttonRightData.mGfxInFocus = cImGuiGfx("startmenu_selection_ring_off.tga");
	buttonRightData.mGfxInFocus.mColor = cColor(1, 1);
	
	
	// Second row used for timer countdown
	tWString sMessage = ImGui_Translate(asMessage);
	tWString sSecondRow = asSecondRow;
	tWString sThirdRow = "";
		
	cVector2f vButtonSize = cVector2f(116,43);
	float fButtonAspectRatio = vButtonSize.x/vButtonSize.y;
	vButtonSize.y = buttonData.mFont.mvSize.y;
	vButtonSize.x = vButtonSize.y*fButtonAspectRatio;
	
	cVector2f vMessageSize(cLux_GetCurrentImGui().GetFontLength(labelData.mFont,  1.0f,  sMessage), labelData.mFont.mvSize.y);
	vMessageSize = OptionMenu_GetScaledSize(vMessageSize);
	
	// Padding between Buttons (x) and between Message and Buttons (y)
	//cVector2f vPadding = OptionMenu_GetScaledSize(cVector2f(15.0f, 15.0f));
	cVector2f vPadding = OptionMenu_GetScaledSize(cVector2f(2.0f, 2.0f));
	
	/////////////////////
	// Calculate Message wrapping
	
	float fMinWidth = vButtonSize.x*2+80;
	float fMaxWidth = cLux_GetCurrentImGui().GetSet().GetVirtualSize().x-200;
	
	if (vMessageSize.x + 2*vPadding.x > fMaxWidth)
	{
		int lHalfLength = sMessage.length()/2;
		tWString sWhitespaceCheck = cString_SubW(sMessage, lHalfLength);
		int lWhitespace = cString_GetFirstStringPosW(sWhitespaceCheck, cString_To16Char(" "));
		if (lWhitespace < 0)
		{
			sWhitespaceCheck = cString_SubW(sMessage, 0, lHalfLength);
			lWhitespace = cString_GetLastStringPosW(sWhitespaceCheck, cString_To16Char(" "));
		}
		else
		{
			lWhitespace += lHalfLength;
		}
		
		if (lWhitespace > 0)
		{
			sThirdRow = sSecondRow;
			sSecondRow = cString_SubW(sMessage, lWhitespace+1);
			sMessage.resize(lWhitespace);
			if (lWhitespace >= lHalfLength)
				vMessageSize = cVector2f(cLux_GetCurrentImGui().GetFontLength(labelData.mFont,  1.0f,  sMessage), labelData.mFont.mvSize.y);
			else
				vMessageSize = cVector2f(cLux_GetCurrentImGui().GetFontLength(labelData.mFont,  1.0f,  sSecondRow), labelData.mFont.mvSize.y);
			vMessageSize = OptionMenu_GetScaledSize(vMessageSize);
		}
	}
	
	///////////////////////
	// Positioning
	
	cVector2f vFrameSize = cVector2f(cMath_Max(vPadding.x + vMessageSize.x + vPadding.x, fMinWidth), (vPadding.y + vMessageSize.y + vPadding.y + vButtonSize.y + vPadding.y));
	cVector3f vFramePos = ImGui_NrmPos(0.5f,0.5f,30.0f) - cVector3f(vFrameSize.x, vFrameSize.y, 0)/2.0f;
	
	cVector3f vMessagePos = vFramePos + cVector3f(0, vPadding.y, 1.0f);
	//cVector3f vButtonPos = vFramePos + cVector3f(vFrameSize.x/2.0f, vPadding.y + vMessageSize.y + vPadding.y - 6, 1.0f); // Middle
	cVector3f vButtonPos = vFramePos + cVector3f(vFrameSize.x/2.0f, vPadding.y + vMessageSize.y + vPadding.y + 2, 1.0f); // Middle
	
	////////////////////////////////////
	// Draw black overlay
	
	cVector3f vScreenCoverPos = ImGui_FullScreenPos(25);
	cVector2f vScreenOverlay = ImGui_FullScreenSize();
	ImGui_DrawGfx(cImGuiGfx(), vScreenCoverPos, vScreenOverlay, cColor(0.0, 0.75));
	
	//////////////////////////
	// Draw background slip
	
	float fHeight = (sSecondRow.length() != 0) ? 180 : 116;
	float fVOffset = (sSecondRow.length() != 0) ? 30 : 0;
	cVector2f vSize = cVector2f(cMath_Max(vMessageSize.x,475.f),fHeight);
	
	cVector2f kScreenCenter = cVector2f(512, 384); // Virtual size: 1024x768
	cImGuiGfx gfxBkg = cImGuiGfx("startmenu_submenu_backdrop_dialog.tga", eImGuiGfx_Texture);
	ImGui_DrawAlignedGfx(gfxBkg, cVector3f(kScreenCenter.x,kScreenCenter.y+fVOffset,30), eImGuiAlign_CenterCenter,vSize);
	
	//////////////////////
	// Draw message
	
	ImGui_SetTextOverride(sMessage);
	ImGui_DoLabelExt("",labelData, vMessagePos, cVector2f(vFrameSize.x, -1));
	ImGui_ClearTextOverride();
	
	if(sSecondRow.length()!=0)
	{
		ImGui_SetTextOverride(sSecondRow);
		//ImGui_DoLabelExt("",labelData, vMessagePos + cVector3f(0,vMessageSize.y + vPadding.y, 0.0f), cVector2f(vFrameSize.x, -1));
		ImGui_DoLabelExt("",labelData, vMessagePos + cVector3f(0, vMessageSize.y * 0.9, 0.0f), cVector2f(vFrameSize.x, -1));
		ImGui_ClearTextOverride();
		
		vButtonPos.y += vMessageSize.y + vPadding.y;
		vFrameSize.y += vMessageSize.y + vPadding.y;
	}	
	if(sThirdRow.length()!=0)
	{
		ImGui_SetTextOverride(sThirdRow);
		//ImGui_DoLabelExt("",labelData, vMessagePos + cVector3f(0,(vMessageSize.y + vPadding.y)*2, 0.0f), cVector2f(vFrameSize.x, -1));
		ImGui_DoLabelExt("",labelData, vMessagePos + cVector3f(0, vMessageSize.y * 2 * 0.9, 0.0f), cVector2f(vFrameSize.x, -1));
		ImGui_ClearTextOverride();
		
		vButtonPos.y += vMessageSize.y + vPadding.y;
		vFrameSize.y += vMessageSize.y + vPadding.y;
	}
	
	/////////////////////
	// Draw two buttons
	
	int lVal = 0; // Output value
	int lSelectedButton = 0; // Currently selected
	float fButtonSep = vPadding.x/2;
	cVector2f vUnderlineSizeNrm = OptionMenu_GetScaledSize(cVector2f(70,5));
	cImGuiGfx gfxHover = cImGuiGfx("startmenu_underscore_yesno", eImGuiGfx_Texture);
	

	//int lButton = OptionMenu_GetMouseInsideToggle(vButtonPos+cVector3f(-vButtonSize.x-fButtonSep/2, 0.0f, 0.0f),  vButtonPos, vButtonSize);
	
	if(asLeft!="" && asRight!="")
	{
		ImGui_LayoutBegin(eImGuiLayout_X, vButtonPos-cVector3f(vButtonSize.x+fButtonSep/2, 0.0f, 0.0f), cVector2f_MinusOne, cVector2f(fButtonSep,0));
		
			ImGui_SetUIMoveWrapMode(eImGuiWrap_None);
			
			if (mlSelectedButton == 1)
			{
				buttonLeftData.mFont.mColor = cColor(0.7f, 1.f);
				buttonRightData.mFont.mColor = cColor(1.f, 1.f);
			}
			else if (mlSelectedButton == -1)
			{
				buttonLeftData.mFont.mColor = cColor(1.f, 1.f);
				buttonRightData.mFont.mColor = cColor(0.7f,1.f);
			}
				
			if(ImGui_DoButtonExt(asLeft,asLeft, buttonLeftData, 0, vButtonSize+cVector2f(0,6)))
			{
				lVal = -1;
				if (abPlaySound) Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
			}
			asFocusOut = OptionMenu_UpdateFocus(asLeft, asFocusIn);
				
			if(ImGui_DoButtonExt(asRight,asRight, buttonRightData, 0, vButtonSize+cVector2f(0,6)) ||
			   ImGui_ActionTriggered(eImGuiAction_Cancel, true))
			{
				lVal = 1;
				if (abPlaySound) Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
			}
			asFocusOut = OptionMenu_UpdateFocus(asRight, asFocusOut);
		
			lSelectedButton = (ImGui_PrevInFocus()) ? 1 : -1;
			mlSelectedButton = lSelectedButton;
	
		ImGui_LayoutEnd();

		//if(ImGui_GetMouseVisible())
		{
			// Not sure why this works, but hey
			if (ImGui_PrevInFocus() == false)
				ImGui_DrawGfx(gfxHover, vButtonPos+cVector3f(-vButtonSize.x/2-fButtonSep/2-vUnderlineSizeNrm.x/2, vButtonSize.y-3, 1.0f), vUnderlineSizeNrm, cColor_White);
			else
				ImGui_DrawGfx(gfxHover, vButtonPos+cVector3f(vButtonSize.x/2-fButtonSep/2-vUnderlineSizeNrm.x/2, vButtonSize.y-3, 1.0f), vUnderlineSizeNrm, cColor_White);
		}
	}
	else if(asLeft!="" || asRight!="") // Only one option
	{
		tString sButton = (asLeft!="") ? asLeft : asRight;
		
		ImGui_LayoutBegin(eImGuiLayout_X, vButtonPos+cVector3f(-vButtonSize.x/2, 0.0f, 1.0f), cVector2f_MinusOne, cVector2f(0,0));
		
			if(ImGui_DoButtonExt(asLeft,asLeft, buttonLeftData, 0, vButtonSize+cVector2f(0,6)))
			{
				lVal = 1;
				if (abPlaySound) Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
			}
			asFocusOut = OptionMenu_UpdateFocus(asLeft, asFocusIn);
			
			lSelectedButton = 1;
		
		ImGui_LayoutEnd();
			
		//if(ImGui_GetMouseVisible())
			ImGui_DrawGfx(gfxHover, vButtonPos+cVector3f(-vButtonSize.x/2, vButtonSize.y-3, 1.0f), vUnderlineSizeNrm, cColor_White);
	}
	
	
	return lVal;
	
}

//-------------------------------------------------------

void OptionMenu_MainMenuButtonBackground(const tString &in asName, int alID, cVector2f avPos, float afAlpha=1)
{
	// USED FOR MAIN MENU
	
	cImGuiFont font;
	font.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	font.mvSize = cVector2f(36, 36);
	
	float fWidth = cMath_Max(kMainMenu_ButtonBgSize.x, GetFontLengthW(font, 1, ImGui_Translate(asName))+50);
	
	///////////
	// Draw background
	int lButtonIndex = (alID%5)+1;
	cImGuiGfx gfx("startmenu_top_button_long" + lButtonIndex, eImGuiGfx_Texture);
	ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos - kMainMenu_ButtonBgOffset, 0.5), OptionMenu_GetScaledSize(cVector2f(fWidth, kMainMenu_ButtonBgSize.y)), cColor(1,afAlpha));// kOptionMenu_ButtonBgColor*gOptionMenu_ModColor);
	/*if(ImGui_TimerExists("ButtonClicked"))
	{
		cImGuiGfx gfXUnderline("startmenu_button_long_triggered", eImGuiGfx_Texture);
		ImGui_DrawGfx(gfXUnderline, OptionMenu_GetTopLeftOffset(avPos - kMainMenu_ButtonBgOffset+cVector2f(-10,36), 0.5), OptionMenu_GetScaledSize(kMainMenu_ButtonBgUnderlineSize), cColor_White*kOptionMenu_ButtonBgColor);
	}*/
}
	
