void OptionMenu_ButtonBackgroundOptions(cVector2f avPos, bool abSubMenu=true, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1)
{
	///////////
	// Draw background
	{

		cVector3f vPos = OptionMenu_GetTopLeftOffset(avPos - cVector2f(16, -4), 0.5);
		//cVector2f vSize = (abSubMenu) ? kOptionMenu_ButtonBgLargeSize : kOptionMenu_ButtonBgSize;
		cVector2f vSize =  kOptionMenu_ButtonBgSize;
		cImGuiGfx gfx("startmenu_button_wide", eImGuiGfx_Texture);
		
		ImGui_DrawGfx(gfx, vPos, OptionMenu_GetScaledSize(vSize+cVector2f(OptionMenu_GetExtraWidth(), 0)), kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
	}
}

//------------------------------------------------------- 

void OptionMenu_ButtonBackgroundSaveFile(cVector2f avPos, cVector2f avSize = kOptionMenu_ButtonBgSize, float afAlpha=1)
{
	///////////
	// Draw background
	{
		cImGuiGfx gfx("startmenu_selection_submenu", eImGuiGfx_Texture);
		ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos + cVector2f(-6, 6), 0.29), OptionMenu_GetScaledSize(avSize+cVector2f(368,0)), kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1, afAlpha));
	}
}

//-------------------------------------------------------

bool OptionMenu_MainMenuButton(tString asName, const cVector2f &in avBasePos, int alEntryPos, int alID, tString asSelectedID, int alClickedID, float afAlpha=1.f)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = cVector2f(36, 36);
	buttonData.mFontAlign = eFontAlign_Left;
	//////////////
	// Draw button
	bool bSelected = (asSelectedID == asName && alClickedID == -1) || alClickedID == alID;
	
	float fAlpha = afAlpha;
	buttonData.mFont.mColor = cColor(1,afAlpha);
	
	//////////////
	// Swap color transition
	if(ImGui_TimerExists("ButtonClicked") && bSelected)
		buttonData.mFont.mColor = cColor(1,afAlpha);
	else
		buttonData.mFont.mColor = (bSelected ? gTextCol_Dark*cColor(1,afAlpha) : cColor(1,afAlpha));
		
	bool bClicked = false;
	
	cVector2f vButtonPos2D = avBasePos + cVector2f(0, kOptionMenu_ButtonSpacing * alEntryPos);
	cVector3f vButtonPos = OptionMenu_GetTopLeftOffset(vButtonPos2D, 1.0);
	
	if(ImGui_DoButtonExt(asName, asName, buttonData, vButtonPos, OptionMenu_GetScaledSize(kOptionMenu_ButtonSize)) && alClickedID == -1)
	{
		if (asName != "ReturnToGame" && /*asName != "NewGame" &&*/ asName != "Exit" && asName != "SaveAndExit" && ImGui_TimerExists("TransitionOut") == false)
			ImGui_AddTimer("TransitionOut",10.f);
			
		ImGui_AddTimer("ButtonClicked", 0.15f);
		buttonData.mFont.mColor = cColor(1,1);
		//cLux_AddTodoMessage("Sound: Menu main button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		
		bClicked = true;
	}
	if(bSelected) OptionMenu_MainMenuButtonBackground(asName, alID, vButtonPos2D, afAlpha);

	return bClicked;
}

//-------------------------------------------------------

void OptionMenu_MainMenuDisabledButton(tString asName, const cVector2f &in avBasePos, int alEntryPos, cImGuiLabelData aLabelData)
{
	ImGui_DoLabelExt(asName, aLabelData, OptionMenu_GetTopLeftOffset(avBasePos + cVector2f(0, kOptionMenu_ButtonSpacing * alEntryPos), 0.0f));
}

//-------------------------------------------------------

int mlItemLimit = 99;

int OptionMenu_GetLimit()
{
	return mlItemLimit;
}

void OptionMenu_SetOutOfLimit(int alLimit)
{
	mlItemLimit = alLimit;
}

//-------------------------------------------------------

bool OptionMenu_CheckOutOfLimits(int alID)
{
	bool bOutOfLimits = (alID < 0 || alID >= mlItemLimit); 
	//if (bOutOfLimits == false) cLux_AddDebugMessage("BUTTON: "+alID);
	//if (bOutOfLimits) cLux_AddDebugMessage("OUT OF LIMITS: "+alID); 
	return bOutOfLimits;
}

//------------------------------------------------------- 

bool OptionMenu_ButtonOptions(tString asName, cVector2f avPos, int alID, tString asSelected, bool abSubMenu=true, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBox=cVector3f_Zero, float afAlpha=1)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = cVector2f(36, 36);
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = (asSelected == asName ? cColor(1, afAlpha) : gTextCol_Dark*cColor(1,afAlpha)); 

	//////////////
	// Draw button
	bool bClicked = false;

	if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0), OptionMenu_GetScaledSize(kOptionMenu_ButtonSize)))
	{
		bClicked = true;
		cLux_AddTodoMessage("Sound: Menu option button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		if (ImGui_TimerExists("TransitionOut") == false)
			ImGui_AddTimer("TransitionOut",10.f);
	}
	
	
	//if(asSelectedID == asName) OptionMenu_ButtonBackgroundOptions(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), abSubMenu, avRightAnchor, avInfoBox);
	if(asSelected == asName) OptionMenu_ButtonSelectedBackground(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), avRightAnchor, afAlpha);
	

	return bClicked;
}

//-------------------------------------------------------

bool OptionMenu_ButtonModOptions(tString asName, cVector2f avPos, tString asSelected, bool bFadeOnClick=false, float afAlpha=1)
{
	//////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = cVector2f(36, 36);
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = (asSelected == asName ? cColor(1, afAlpha) : gTextCol_Dark * cColor(1,afAlpha)); 

	//////////////
	// Draw button
	if(asSelected == asName) OptionMenu_ButtonSelectedBackground(avPos, cVector2f(avPos.x+560, 0), afAlpha);
	
	if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(cVector2f(kOptionMenu_ButtonSize.x * 0.45, kOptionMenu_ButtonSize.y))))
	{
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		if (bFadeOnClick && ImGui_TimerExists("TransitionOut") == false)
			ImGui_AddTimer("TransitionOut", 10.f);
			
		return true;
	}
	
	return false;
}

//-------------------------------------------------------

bool OptionMenu_ButtonSaveFile(tString asName, tWString asTitle, tString asDate, tWString asSuffix, cVector2f avPos, cVector2f avDatePos, bool abSelected, float afAlpha=1)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;	// overridden below
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	buttonData.mFont.mvSize = cVector2f(28, 28);
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = abSelected ? cColor(1, afAlpha) : gTextCol_Dark*cColor(1, afAlpha); 
	
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	labelData.mFont.mvSize = cVector2f(28, 28);
	labelData.mFont.mColor = abSelected ? cColor(1, afAlpha) : gTextCol_Dark*cColor(1, afAlpha);
	labelData.mFontAlign = eFontAlign_Right;
	
	int lSep = cString_GetFirstCharPos(asDate,'-');
	tString sDate = cString_Sub(asDate,0,lSep) + "/" + cString_Sub(asDate,lSep+3);

	//////////////
	// Draw button
	bool bClicked = false;
	
	////////////////////
	// Translate if it's not a quicksave
	ImGui_SetTransCategory("Levels");

	if (asTitle == cString_To16Char("Xx-xx-dummy-level")) ImGui_SetTransCategory("");
	else if (cString_GetFirstStringPosW(asTitle, tWString("QuickSave")) < 0) asTitle = _ImGui_GetTextString(cString_To8Char(asTitle));
	
	if(cLux_GetCurrentImGui().DoButton(asName, asTitle, buttonData, OptionMenu_GetTopLeftOffset(avPos, 0.3f), OptionMenu_GetScaledSize(cVector2f(420, 40))))
	{
		bClicked = true;
		cLux_AddTodoMessage("Sound: Menu save file pressed");
	}

	ImGui_SetTransCategory("");
	ImGui_DoLabelExt(sDate,labelData, OptionMenu_GetTopLeftOffset(avDatePos, 1.0), 0);
		
	ImGui_SetTransCategory("Menu");

	if(abSelected)
	{
		OptionMenu_ButtonBackgroundSaveFile(avPos, kOptionMenu_ButtonBgSize, afAlpha);
		cVector3f vInfoBoxPos = OptionMenu_GetTopLeftOffset(avDatePos + kOptionMenu_LoadInfoBoxBgOffset, 0);
		
		tString sInfo = "ClassicMode";
		if(asSuffix == tWString("ADV")) sInfo = "AdventureMode";

		OptionMenu_InfoBox("", vInfoBoxPos, cMath_Min(GetFontLengthW(labelData.mFont, 1, ImGui_Translate(sInfo)) + 32.0f, kOptionMenu_InfoBoxBgSize.x), sInfo);
	}

	return bClicked;
}

//-------------------------------------------------------

bool OptionMenu_ButtonMod(tString&in asName, tString&in asTitle, cVector2f avPos, bool abInFocus, tString&in asProvider, float afAlpha=1, bool abDownload=false, float afDownloadProgress=0)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;	// overridden below
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	buttonData.mFont.mvSize = cVector2f(28, 28);
	buttonData.mFontAlign = eFontAlign_Left;
	const float fAlpha = abDownload ? afAlpha * 0.7 : afAlpha;
	buttonData.mFont.mColor = abInFocus ? cColor(1, fAlpha) : gTextCol_Dark * cColor(1, fAlpha);
	
	/////////////////////////////////////
	// Draw Btn
	
	// In focus gfx
	if (abInFocus)
	{
		cImGuiGfx gfx("startmenu_selection_submenu", eImGuiGfx_Texture);
		gfx.mColor = kOptionMenu_ButtonBgColor * gOptionMenu_ModColor * cColor(1, afAlpha);
		ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos + cVector2f(-8,0), 0.29), OptionMenu_GetScaledSize(kOptionMenu_ButtonBgSize + cVector2f(310,0)));
	}
	
	// Download bar gfx
	/*if (abDownload && afDownloadProgress > 0)
	{
		cImGuiGfx gfx("startmenu_selection_submenu", eImGuiGfx_Texture);
		const float fA = abInFocus ? afAlpha : afAlpha * 0.35;
		gfx.mColor = cColor(1, fA); 
		const float fGaugeSizeMul = cMath_Clamp(afDownloadProgress, 0.f, 1.f);
		cVector2f vGaugeSize = OptionMenu_GetScaledSize(kOptionMenu_ButtonBgSize + cVector2f(310,0));
		vGaugeSize.x *= fGaugeSizeMul;
		ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos + cVector2f(-8,0), 0.3), vGaugeSize);
	}*/
	
	ImGui_LayoutBegin(eImGuiLayout_X, cVector3f_Zero, cVector2f_MinusOne, cVector2f(2));
	{
		// Provider img
		if (abDownload==false)
		{
			const cVector2f vProvImgSize = cVector2f(25);
			const cVector2f vProvImgPos = avPos + cVector2f(0,8);
			cImGuiGfx gfxProviderImg = cImGuiGfx(asProvider, eImGuiGfx_Texture);
			gfxProviderImg.mColor = abInFocus ? cColor(1, afAlpha) : cColor(0, afAlpha);
			ImGui_DoImage(gfxProviderImg, OptionMenu_GetTopLeftOffset(vProvImgPos, 1.0), OptionMenu_GetScaledSize(vProvImgSize));
		}
		// download %
		else
		{
			cImGuiLabelData labelData;
			labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
			labelData.mFont.mvSize = cVector2f(28, 28);
			labelData.mFontAlign = eFontAlign_Left;
			const float fLabelAlpha = afAlpha * 0.75;
			labelData.mColorBase = abInFocus ? cColor(1, fLabelAlpha) : gTextCol_Dark * cColor(1, fLabelAlpha);
			const cVector2f vProvImgPos = avPos + cVector2f(0,8);
			tString sLabel = ""+ cMath_RoundToInt(100 * afDownloadProgress) +" % ";
			ImGui_DoLabelExt(sLabel, labelData, OptionMenu_GetTopLeftOffset(vProvImgPos, 1.0), cVector2f_MinusOne, 0.8);
		}
		
		// Button
		const cVector2f vBtnSize = cVector2f(360, 38);
		if (ImGui_DoButtonExt(asName, asTitle, buttonData, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(vBtnSize)))
		{
			if (abDownload==false)
			{
				Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
				return true;
			}
		}
	}
	ImGui_LayoutEnd();
	
	return false;
}

//-------------------------------------------------------

int OptionMenu_ButtonKeybind(tString asName, tString asTitle, tString asBindPrimary, tString asBindSecondary, cVector2f avPos, bool abSelected, int alTypeFocus, int&out alFocusChange, bool abDuplicate, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBox=cVector3f_Zero, float afAlpha=1)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = cVector2f(30, 30);
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = abSelected ? cColor(1, afAlpha) : gTextCol_Dark*cColor(1,afAlpha); 
	buttonData.mfClipAreaPaddingLeft = 12;
	buttonData.mfClipAreaPaddingRight = 16;
	buttonData.mfScrollSpeed = 32;
	buttonData.mfScrollResetDelay = 1;
	
	cImGuiGfx gfxInFocus = cImGuiGfx("startmenu_frame_yesno", eImGuiGfx_Texture);
	//gfxInFocus.mColor = cColor(1);
	buttonData.mGfxInFocus = gfxInFocus;
	
	cVector3f vPosNrm = OptionMenu_GetTopLeftOffset(avPos,3);
	cVector3f vRightAnchorNrm = OptionMenu_GetTopLeftOffset(avRightAnchor);
	
	cVector2f vButtonSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_MultiSize+cVector2f(gfOptionsMenu_ExtraWidth_Keybind, -5));
	cVector3f vButtonLeftPosNrm = cVector3f(vRightAnchorNrm.x-vButtonSizeNrm.x-30,vPosNrm.y+5, vPosNrm.z);
	cVector3f vButtonRightPosNrm = cVector3f(vRightAnchorNrm.x-vButtonSizeNrm.x/2-30,vPosNrm.y+5, vPosNrm.z);
	//cLux_AddDebugMessage("SIZE: "+vButtonSizeNrm+" - RIGHT ANCH: "+vRightAnchorNrm+" - RIGHT POS: "+vButtonRightPosNrm);
	cImGuiGfx gfxButton = cImGuiGfx(OptionMenu_GetButtonBackground(cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y)), eImGuiGfx_Texture);
	
	cColor mPrimaryColor = (abDuplicate) ? cColor(1, 0.8f, 1, afAlpha) : cColor(1, afAlpha);
	cColor mSecondaryColor = cColor(1, afAlpha);

	/////////////
	// Background
	cImGuiGfx gfx("startmenu_button_short", eImGuiGfx_Texture);
	
	//////////////
	// Draw button
	int lClicked = 0;
	alFocusChange = 0;

	/////////////
	// Label
	ImGui_SetTransCategory("Actions"); 

	{
		if(ImGui_DoButtonExt(asName,asTitle, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, 3), 2.0), OptionMenu_GetScaledSize(kOptionMenu_KeybindBaseButtonSize)))
		{
			lClicked = 1;
			cLux_AddTodoMessage("Sound: Keybind file pressed");
		}
		if(ImGui_PrevBecameInFocus()) alFocusChange = 1; //Update focus
	}
	//if(abSelected) OptionMenu_ButtonBackgroundSaveFile(avPos);
	
	buttonData.mFontAlign = eFontAlign_Center;
	buttonData.mbClipText = true;
	
	// LEFT
	
	// RIGHT
	
	buttonData.mbUseInFocusGfx = true;

	/////////////////
	// Primary button
	{
		buttonData.mFont.mColor = mPrimaryColor;
		ImGui_SetTransCategory("ButtonNames"); 
		if(ImGui_DoButtonExt(asName+"Primary",asBindPrimary, buttonData, vButtonLeftPosNrm, cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y)))
		{
			lClicked = 1;
			cLux_AddTodoMessage("Sound: Keybind file pressed");
		}
		if(ImGui_PrevBecameInFocus()) alFocusChange = 2; //Update focus
		ImGui_DrawGfx(gfxButton, vButtonLeftPosNrm, cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y), (abSelected && alTypeFocus == 1) ? cColor(1,afAlpha) : kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
		//ImGui_DrawGfx(gfxButton, OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_KeybindButtonPrimaryPos + kOptionMenu_KeybindButtonBgOffset + cVector2f(OptionMenu_GetExtraWidth(), 0), 0.75), OptionMenu_GetScaledSize(kOptionMenu_KeybindButtonBgSize), (abSelected && alTypeFocus == 1) ? cColor(1,afAlpha) : kOptionMenu_ButtonBgColor*cColor(1,afAlpha));
	}
			
	///////////////
	// Secondary button
	{
		buttonData.mFont.mColor = mSecondaryColor;

		if(ImGui_DoButtonExt(asName+"Secondary",asBindSecondary, buttonData, vButtonRightPosNrm, cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y)))
		{
			lClicked = 2;
			cLux_AddTodoMessage("Sound: Keybind file pressed");
		}
		if(ImGui_PrevBecameInFocus()) alFocusChange = 3; //Update focus
		ImGui_DrawGfx(gfxButton, vButtonRightPosNrm, cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y), (abSelected && alTypeFocus == 2) ? cColor(1,afAlpha) : kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
		//ImGui_DrawGfx(gfxButton, OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_KeybindButtonSecondaryPos + kOptionMenu_KeybindButtonBgOffset + cVector2f(OptionMenu_GetExtraWidth(), 0),  0.75), OptionMenu_GetScaledSize(kOptionMenu_KeybindButtonBgSize), (abSelected && alTypeFocus == 2) ? cColor(1,afAlpha) : kOptionMenu_ButtonBgColor*cColor(1,afAlpha));
	}
	
	ImGui_SetTransCategory("Menu");
	

	return lClicked;
}

//-------------------------------------------------------
	
int OptionMenu_SaveSlot(tString asName, cVector2f avPos, tString asDescription, tString asSelected, tString&out asSelectedOut)
{
	asSelectedOut = asSelected;

	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = cVector2f(36, 36);
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = asSelected == asName ? cColor(0, 1) : cColor(1, 1); 
	
	////////////////
	// Description
	if(asDescription != "")
	{
		/////////////
		// Image and description
		cImGuiGfx gfx(asDescription + ".tga", eImGuiGfx_Texture);
		ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(kOptionMenu_SaveSlotSize));

		cImGuiLabelData labelData;
		labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
		labelData.mFont.mvSize = cVector2f(36, 36);
		labelData.mFont.mColor = cColor(1,1);
		labelData.mFontAlign = eFontAlign_Center;

		ImGui_DoLabelExt(asDescription,labelData, OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_SaveSlotLabelOffset, 1.0), OptionMenu_GetScaledSize(kOptionMenu_SaveSlotTextSize));
	}
	else
	{
		////////////
		// Grey background
		cImGuiGfx gfx;
		ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(kOptionMenu_SaveSlotSize), cColor(0.5, 0.5, 0.5, 0.5));
	}

	//////////////
	// Start
	if(ImGui_DoButtonExt(asName + "Start", "Start", buttonData, OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_SaveSlotStartOffset, 1.0), OptionMenu_GetScaledSize(kOptionMenu_SaveSlotTextSize)))
	{
		cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
	}
	
	if(asSelected == (asName + "Start"))
	{
		OptionMenu_ButtonBackgroundOptions(avPos + kOptionMenu_SaveSlotStartOffset);
	}

	asSelectedOut = OptionMenu_UpdateFocus(asName + "Start", asSelectedOut);
	
	if(asDescription != "")
	{
		//////////////
		// Delete
		if(ImGui_DoButtonExt(asName + "Delete", "Delete", buttonData, OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_SaveSlotDeleteOffset, 1.0), OptionMenu_GetScaledSize(kOptionMenu_SaveSlotTextSize)))
		{
			cLux_AddTodoMessage("Sound: Menu toggle button pressed");
			Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
		}

		if(asSelected == (asName + "Delete")) OptionMenu_ButtonBackgroundOptions(avPos + kOptionMenu_SaveSlotDeleteOffset);
	
		asSelectedOut = OptionMenu_UpdateFocus(asName + "Delete", asSelectedOut);
	}

	return 0;
}

//-------------------------------------------------------
	
bool OptionMenu_ButtonOptionsToggle(tString asName, cVector2f avPos, int alID, tString asSelected, bool abValue, int alUIActionHorizontal, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1)
{	
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
	buttonData.mFont.mvSize = cVector2f(36, 36);
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = asSelected == asName ? cColor(1, afAlpha) : gTextCol_Dark*cColor(1,afAlpha); 

	//////////////
	// Check if button was clicked
	if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0),  OptionMenu_GetScaledSize(cVector2f(avRightAnchor.x-avPos.x, kOptionMenu_ButtonSize.y))))
	{
		cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		abValue = !abValue;
		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
	}

	/////////////
	// Check for gamepad input
	if(asSelected == asName && ((alUIActionHorizontal == 1 && abValue == false) || (alUIActionHorizontal ==-1 && abValue == true)))
	{
		cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		//cLux_AddDebugMessage("ACTION: "+alUIActionHorizontal+" VALUE: "+abValue);
		abValue = !abValue;
		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
	}
			
	//////////////
	// Draw checkbox and background
	OptionMenu_OptionsCheckbox(avPos+ cVector2f(OptionMenu_GetExtraWidth()-gfOptionsMenu_ExtraWidth_Toggle, kOptionMenu_ButtonSpacing * alID), asSelected == asName, abValue, "Off", "On", asName, avRightAnchor, avInfoBoxPos, afAlpha);
		
	if(asSelected == asName) OptionMenu_ButtonSelectedBackground(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), avRightAnchor, afAlpha);

	return abValue;
}

//-------------------------------------------------------

void OptionMenu_ButtonSelectedBackground(cVector2f avPos, cVector2f avRightAnchor=cVector2f_Zero, float afAlpha=1)
{
	///////////
	// Draw background
	{
		cVector3f vPos = OptionMenu_GetTopLeftOffset(avPos - cVector2f(16, -4), 0.5);
		
		cVector2f vButtonAreaSize = OptionMenu_GetScaledSize(kOptionMenu_MultiSize+cVector2f(gfOptionsMenu_ExtraWidth_MultiSelect, 0));
		cVector3f vMaxRight = OptionMenu_GetTopLeftOffset(avRightAnchor.x-vButtonAreaSize.x,0);
		cVector2f vSize = OptionMenu_GetScaledSize(cVector2f(vMaxRight.x-vPos.x,kOptionMenu_ButtonBgLargeSize.y));// OptionMenu_GetScaledSize(kOptionMenu_ButtonBgLargeSize+cVector2f(gfOptionsMenu_ExtraWidth-46, 0)); // TO DO: Add extra width
		
		cImGuiGfx gfx = cImGuiGfx(OptionMenu_GetButtonBackground(vSize), eImGuiGfx_Texture);
		//cLux_AddDebugMessage("BTNSIZE: "+vButtonAreaSize.x+" - MAX RIGHT: "+vMaxRight+" - SIZE: "+vSize.x);

		ImGui_DrawGfx(gfx, vPos, vSize, kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1,afAlpha));
	}
}

//-------------------------------------------------------

tString OptionMenu_GetBackground(cVector2f avSize)
{
	
	int w = avSize.x*2;
	int h = avSize.y*2;
	
	//cLux_AddDebugMessage("W: "+w+" H: "+h);
	
	// w 650, 900, 1200, 1500
	// h 450, 650, 800, 1000
	
	if (w <= 750)			w = 650;
	else if (w <= 1100)		w = 900;
	else if (w <= 1650)		w = 1200;
	else					w = 1500;
	
	if (h <= 550)			h = 450;
	else if (h <= 720)		h = 650;
	else if (h <= 950)		h = 800;
	else					h = 1000;
		
	return "mainmenu_submenu_backdrop_"+w+"x"+h;
}

//-------------------------------------------------------

tString OptionMenu_GetFrame(cVector2f avSize)
{
	
	int w = avSize.x*2;
	int h = avSize.y*2;
	
	// w 650, 900, 1200, 1500
	// h 450, 650, 800, 1000
	
	if (w < 750)			w = 650;
	else if (w < 1100)		w = 900;
	else if (w < 1350)		w = 1200;
	else					w = 1500;
	
	if (h < 550)			h = 450;
	else if (h < 720)		h = 650;
	else if (h < 900)		h = 800;
	else					h = 1000;
	
	return "mainmenu_submenu_frame_"+w+"x"+h;
} 

//------------------------------------------------------- 

tString OptionMenu_GetButtonBackground(cVector2f avSize)
{
	if (avSize.x < 150)
		return "startmenu_button_short";
	else if (avSize.x < 280)
		return "startmenu_button_wide";
	else if (avSize.x < 430)
		return "startmenu_button_wide_500";
	else
		return "startmenu_button_wide_700";
} 

//-------------------------------------------------------
	
int OptionMenu_ButtonOptionsMultiSelect(tString asName, cVector2f avPos, int alID, tString asSelected, array<tString> avValues, int alValue, bool abInvert, int alUIActionHorizontal, tString asCategory="Menu", int afExtraSpacingFromLabel=0, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = cVector2f(36, 36);
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = (asSelected == asName ? cColor(1, afAlpha) : gTextCol_Dark*cColor(1,afAlpha)); 

	//////////////
	// Check if button was clicked
	int lDirection = 0;
	
	if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0),  OptionMenu_GetScaledSize(cVector2f(avRightAnchor.x-avPos.x, kOptionMenu_ButtonSize.y))))
	{
		// TO DO: Size seems really off!
		//cLux_AddDebugMessage("SIZE: "+OptionMenu_GetScaledSize(kOptionMenu_ButtonSize));
		
		// Select based on which side the mouse was
		if(ImGui_GetMouseVisible()) 
		{			
			if (mlCurrentDir == 0) 
				lDirection++;
			else 
			{
				lDirection += mlCurrentDir;
				mlCurrentDir = 0;
			}
		}
		else
		{
			lDirection++;
		}
		cLux_AddTodoMessage("Sound: Menu Multi-select button pressed");

		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
	}	

	////////////
	// Check gamepad input
	if(asSelected == asName && alUIActionHorizontal != 0)
	{
		lDirection += alUIActionHorizontal;
		cLux_AddTodoMessage("Sound: Menu Multi-select button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
		//Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
	}

	/////////////
	// Wrap data
	if(lDirection != 0)
	{
		if(abInvert) alValue -= lDirection;
		else		 alValue += lDirection;

		alValue = (alValue + avValues.size()) % avValues.size();
	}

	OptionMenu_OptionsMultiSelect(avPos+ cVector2f(OptionMenu_GetExtraWidth()-gfOptionsMenu_ExtraWidth_MultiSelect, kOptionMenu_ButtonSpacing * alID)+cVector2f(afExtraSpacingFromLabel,0), avValues, alValue, asSelected == asName, asCategory, asName, avRightAnchor, avInfoBoxPos, afAlpha);

	if(asSelected == asName) OptionMenu_ButtonSelectedBackground(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), avRightAnchor, afAlpha);
	
	return alValue;
}

//-------------------------------------------------------

float OptionMenu_ButtonOptionsSlider(tString asName, cVector2f avPos, int alID, tString asSelected, float afValue, float afStepSize, int alUIActionHorizontal, tString asTextValue="", tString asTextValueTransCat="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = cVector2f(36, 36);
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = (asSelected == asName ? cColor(1, afAlpha) : gTextCol_Dark*cColor(1, afAlpha)); 
	
	cVector2f vRealPos = avPos;
	vRealPos.x += OptionMenu_GetExtraWidth();
	
	///////////////
	// Repeat or normal button?
	cVector2f vSliderMin = kOptionMenu_SliderMin;
	cVector2f vSliderMax = kOptionMenu_SliderMax;
	
	//if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0),  OptionMenu_GetScaledSize(cVector2f(avRightAnchor.x-avPos.x, kOptionMenu_ButtonSize.y))))

	float fValue = OptionMenu_OptionsSlider(avPos, vRealPos+ cVector2f(0, kOptionMenu_ButtonSpacing * alID), afValue, alID, afStepSize, alUIActionHorizontal, buttonData, asTextValue, asSelected == asName, asTextValueTransCat, asName, avRightAnchor, avInfoBoxPos, afAlpha);
	//cLux_AddDebugMessage(asName+" VALUE: "+fValue);
	if(asSelected == asName) OptionMenu_ButtonSelectedBackground(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), avRightAnchor, afAlpha);

	return fValue;
}

//-------------------------------------------------------

void OptionMenu_ShowGamepadButtons(bool abShowArrows, bool abShowCancel = true, cVector2f avOffset = cVector2f(0))
{
	if(cLux_GetInputHandler().IsGamepadConnected() == false) return;

	////////////
	// Buttons
	tString sButtonA = Platform_IsPlayStation() ? "startmenu_button_x" : "startmenu_button_xbox_A";
	tString sButtonB = Platform_IsPlayStation() ? "startmenu_button_circle" : "startmenu_button_xbox_B";
	
	cColor colButtonA = Platform_IsPlayStation() ? cColor(0.42,0.54,0.78,1) : cColor(0,0.8,0.4,1);
	cColor colButtonB = Platform_IsPlayStation() ? cColor(1,0.4,0.4,1) : cColor(1,0.4,0.4,1);

	cImGuiGfx gfxConfirm(sButtonA);
	cImGuiGfx gfxCancel(sButtonB);
	cImGuiGfx gfxArrows("startmenu_button_direction2");

	/////////////
	// Text
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_GamepadPrompt, 56));
	labelData.mFont.mvSize = gfFontSize_GamepadPrompts;
	labelData.mFont.mColor = cColor(1,1);
	
	float fX = 100;
	float fXOffset = 0;

	ImGui_DoLabelExt("Accept",labelData, OptionMenu_GetBotLeftOffset(cVector2f(fX+fXOffset, 65) + avOffset, 10.0));
	fXOffset += GetFontLengthW(labelData.mFont, 1, ImGui_Translate("Accept"));
	ImGui_DrawGfx(gfxConfirm, OptionMenu_GetBotLeftOffset(cVector2f(fX-8+fXOffset, 70) + avOffset, 10.5), OptionMenu_GetScaledSize(36), colButtonA);
	fXOffset += 37;

	if(abShowCancel)
	{
		ImGui_DoLabelExt("Cancel",labelData, OptionMenu_GetBotLeftOffset(cVector2f(fX+fXOffset, 65) + avOffset, 10.0));
		fXOffset += GetFontLengthW(labelData.mFont, 1, ImGui_Translate("Cancel"));
		ImGui_DrawGfx(gfxCancel, OptionMenu_GetBotLeftOffset(cVector2f(fX-8+fXOffset, 70) + avOffset, 10.5), OptionMenu_GetScaledSize(36), colButtonB);
		fXOffset += 37;
	}

	if(abShowArrows)
	{
		ImGui_DoLabelExt("Select",labelData, OptionMenu_GetBotLeftOffset(cVector2f(fX+fXOffset, 65) + avOffset, 10.0));
		fXOffset += GetFontLengthW(labelData.mFont, 1, ImGui_Translate("Select"));
		ImGui_DrawGfx(gfxArrows, OptionMenu_GetBotLeftOffset(cVector2f(fX-18+fXOffset, 85) + avOffset, 10.5), OptionMenu_GetScaledSize(72), cColor(1,1));
	}
}

//------------------------------------------------------- 

void OptionMenu_SectionTitle(tString asTitle, cVector2f avPos)
{
	/////////////
	// Text
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,92));
	labelData.mFont.mvSize = cVector2f(84, 84);
	labelData.mFont.mColor = cColor(1,1);
	labelData.mFontAlign = eFontAlign_Right;

	ImGui_DoLabelExt(asTitle,labelData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, -8), 1.0), OptionMenu_GetScaledSize(cVector2f(190, 72)));

	////////////
	// Borders
	cImGuiGfx border;

	float fSize = GetFontLengthW(labelData.mFont, 1.0f, _ImGui_GetTextString(asTitle)) + 18;
	
	ImGui_DrawGfx(border, OptionMenu_GetTopLeftOffset(avPos + cVector2f(193, -13), 10.5), cVector2f(10, 90), cColor(1,1));
	ImGui_DrawGfx(border, OptionMenu_GetTopLeftOffset(avPos + cVector2f(193, -13), 10.5) - cVector3f(fSize, 0, 0), cVector2f(fSize, 10), cColor(1,1));
	ImGui_DrawGfx(border, OptionMenu_GetTopLeftOffset(avPos + cVector2f(193, -13), 10.5) - cVector3f(fSize,-80, 0), cVector2f(fSize, 10), cColor(1,1));
	ImGui_DrawGfx(border, OptionMenu_GetTopLeftOffset(avPos + cVector2f(193, -13), 10.5) - cVector3f(fSize,0, 0), cVector2f(10, 90), cColor(1,1));
}

//------------------------------------------------------- 

void OptionMenu_SectionTitle(tString asTitle, cVector2f avPos, cVector2f avSize)
{
	/////////////
	// Text
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	labelData.mFont.mvSize = cVector2f(84, 84)*0.55;
	labelData.mFont.mColor = cColor(1,1);
	labelData.mFontAlign = eFontAlign_Right;
	
	cVector2f vSize = OptionMenu_GetScaledSize(avSize);
	cVector3f vPos = OptionMenu_GetTopLeftOffset(avPos, 1);
	vPos.y += vSize.y+5;
		
	ImGui_DoLabelExt(asTitle,labelData, vPos, cVector2f(vSize.x-54, -1));
}

//------------------------------------------------------- 

void OptionMenu_SectionTitleIcon(const tString &in asIcon, const cVector2f &in avPos)
{
	cVector3f vTitlePos(avPos.x, avPos.y, 21);
	
	cImGuiGfx gfxTitleIcon(asIcon, eImGuiGfx_Texture);
	ImGui_DrawAlignedGfx(gfxTitleIcon, vTitlePos, eImGuiAlign_TopRight, OptionMenu_GetScaledSize(GetUsedGfxSize(gfxTitleIcon,-1))*0.6f, cColor(1.0, 1.0));
}