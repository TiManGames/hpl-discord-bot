/////////////////////////////////////////
// PUSHABLE FOG
/////////////////////////////////////////

//-------------------------------------------------

void PushableFogArea_SetCustomStartAndEnd(const tString &in asArea, float afStart, float afEnd)
{
	cScript_SetGlobalArgFloat(0, afStart);
	cScript_SetGlobalArgFloat(1, afEnd);
	cScript_RunGlobalFunc(asArea, "cScrPushableFog", "_Global_SetCustomStartAndEnd");
}

//-------------------------------------------------

void PushableFogArea_ResetCustomStartAndEnd(const tString &in asArea)
{
	cScript_RunGlobalFunc(asArea, "cScrPushableFog", "_Global_ResetCustomStartAndEnd");
}

//-------------------------------------------------
