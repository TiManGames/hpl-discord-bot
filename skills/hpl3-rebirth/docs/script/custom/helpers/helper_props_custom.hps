//-------------------------------------------------------

/**
 * Starts a radio call.
 * 
 * @param asSubject, the voice subject to be played
 * @param asSubjectCallback, callback when the subject is done. Syntax: void Func(const tString &in asScene, const tString &in asSubject)
 * @param afTakeOutDelay, time until the radio is automatically taken out 
 * @param asCharacter, the character speaking on the radio. If many, separate names with ;
 * 
 **/
void Radio_StartCall(const tString &in asSubject, const tString &in asSubjectCallback = "", float afTakeOutDelay = 4.f, 
					 const tString &in asCharacter = "Doctor")
{
	cLux_GetCurrentMap().AddTimer("_Timer_HelperStartRadioCall", afTakeOutDelay, "$_OnTimer_HelperStartRadioCall");
	
	tString sItem = ItemType_GetFirstInInventory("Radio");
	cScript_SetGlobalArgString(0, asSubject);
	cScript_SetGlobalArgString(1, asSubjectCallback);
	cScript_SetGlobalArgString(2, asCharacter);
	cScript_RunGlobalFunc(Item_GetItemEntity(sItem), "cScrPropRadio", "_Global_StartCall");
}

//-------------------------------------------------------

void _OnTimer_HelperStartRadioCall(const tString &in asTimer)
{
	if (Item_GetHeldType(eItemHandlerHand_Right) != "Radio")
		Item_TakeOut(ItemType_GetFirstInInventory("Radio"));
}

//-------------------------------------------------------

/**
 * Stops and puts away the radio if a call is active
 * 
 **/
void Radio_StopCall()
{
	tString sItem = ItemType_GetFirstInInventory("Radio");	
	cScript_RunGlobalFunc(Item_GetItemEntity(sItem), "cScrPropRadio", "_Global_StopCall");
}

//-------------------------------------------------------

/**
 * Returns true if a call is active
 * 
 **/
bool Radio_GetCallActive()
{
	tString sItem = ItemType_GetFirstInInventory("Radio");	
	cScript_RunGlobalFunc(Item_GetItemEntity(sItem), "cScrPropRadio", "_Global_GetCallActive");
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------------

void DWNote_RenderGUI(const tString&in asEntityName, float afTimeStep)
{
	iScrSketchbookUIHandler_Interface @pHandler = cast<iScrSketchbookUIHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_SketchbookUIHandler) );
	pHandler.RenderDWNoteGUI(asEntityName, afTimeStep);
}

//-------------------------------------------------------

void Pickup_SetCanBeHighlighted(const tString &in asEntity, bool abX)
{
	cScript_SetGlobalArgBool(0, abX);
	if (cScript_RunGlobalFunc(asEntity, "cScrPropPickup", "_Global_SetCanBeHighlighted") == false)
	{
		Error("Could not find door with name '"+asEntity+"' for _Global_SetCanBeHighlighted");
	}
}

//-------------------------------------------------------

void VineCover_Open(const tString &in asEntity)
{
	array<iLuxEntity@> vEnts;
	cLux_GetCurrentMap().GetEntityArray(asEntity, eLuxEntityType_Prop, "cScrPropVineCover", vEnts);
	if (vEnts.size() == 0)
	{
		Error("Couldn't find prop '" + asEntity + "' for VineCover_Open");
		return;
	}
	
	for (uint i = 0; i < vEnts.size(); ++i)
	{
		if (cScript_RunGlobalFunc(vEnts[i].GetName(), "cScrPropVineCover", "_Global_Open") == false)
		{
			Error("Failed find prop '"+asEntity+"' for _Global_Open");
		}
	}
}

//-------------------------------------------------------

void VineCover_Close(const tString &in asEntity)
{
	array<iLuxEntity@> vEnts;
	cLux_GetCurrentMap().GetEntityArray(asEntity, eLuxEntityType_Prop, "cScrPropVineCover", vEnts);
	if (vEnts.size() == 0)
	{
		Error("Couldn't find prop '" + asEntity + "' for VineCover_Close");
		return;
	}
	
	for (uint i = 0; i < vEnts.size(); ++i)
	{
		if (cScript_RunGlobalFunc(vEnts[i].GetName(), "cScrPropVineCover", "_Global_Close") == false)
		{
			Error("Failed find prop '"+asEntity+"' for _Global_Close");
		}
	}
}

//-------------------------------------------------------

void VineCover_SetIndependant(const tString &in asEntity, bool abX)
{
	array<iLuxEntity@> vEnts;
	cLux_GetCurrentMap().GetEntityArray(asEntity, eLuxEntityType_Prop, "cScrPropVineCover", vEnts);
	if (vEnts.size() == 0)
	{
		Error("Couldn't find prop '" + asEntity + "' for VineCover_SetIndependant");
		return;
	}
	
	for (uint i = 0; i < vEnts.size(); ++i)
	{
		cScript_SetGlobalArgBool(0, abX);
		if (cScript_RunGlobalFunc(vEnts[i].GetName(), "cScrPropVineCover", "_Global_SetIndependant") == false)
		{
			Error("Failed find prop '"+asEntity+"' for _Global_SetIndependant");
		}
	}
}

