tString TorturePod_GetState(const tString &in asEntity)
{
	if (cScript_RunGlobalFunc(asEntity, "cScrPropTorturePod", "_Global_GetPodState") == false)
	{
		Error("Failed to find prop '"+asEntity+"' for _Global_GetPodState");
		return "";
	}
	return cScript_GetGlobalReturnString();
}

//-------------------------------------------------------

void TorturePod_SetActive(const tString &in asEntity, bool abActive)
{
	cScript_SetGlobalArgBool(0, abActive);
	if (cScript_RunGlobalFunc(asEntity, "cScrPropTorturePod", "_Global_SetActive") == false)
	{
		Error("Failed to find prop '"+asEntity+"' for _Global_SetActive");
	}
}

//-------------------------------------------------------

void TorturePod_Kill(const tString &in asEntity)
{
	if (cScript_RunGlobalFunc(asEntity, "cScrPropTorturePod", "_Global_SetDead") == false)
	{
		Error("Failed to find prop '"+asEntity+"' for _Global_SetActive");
	}
}

//-------------------------------------------------------

void TorturePod_SetVolume(const tString &in asEntity, float afVolume, float afFadeSpeed = 0)
{
	cScript_SetGlobalArgFloat(0, afVolume);
	cScript_SetGlobalArgFloat(1, afFadeSpeed);
	if (cScript_RunGlobalFunc(asEntity, "cScrPropTorturePod", "_Global_SetVolume") == false)
	{
		Error("Failed to find prop '"+asEntity+"' for _Global_SetVolume");
	}
}

