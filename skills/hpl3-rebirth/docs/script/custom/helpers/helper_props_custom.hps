//-------------------------------------------------------

float Rift_GetOpenAmount(const tString &in asEntity)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity, eLuxEntityType_Prop, "cScrPropRift");
	if (pEnt is null)
	{
		Error("No rift with name " + asEntity + " found for Rift_GetOpenAmount()!");
		return -1.f;
	}
	
	return UserComponent_Rift_Get(pEnt).GetOpenAmount();
}

