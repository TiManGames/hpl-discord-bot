#include "interfaces/AchievementHandler_Interface.hps"
#include "base/AchievementHandler_Types.hps"
#include "custom/modules/ModuleInterfaces_Custom.hps"

class cScrAchievementHandler : iScrAchievementHandlerBase, iScrAchievementHandler_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CREATE ACHIEVEMENTS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CreateAchievements()
	{
		/////////////
		// Create the achievements
		CreateAchievement(eAchievement_Amnesiac, "Amnesiac");
		CreateAchievement(eAchievement_Follower, "Follower");
		CreateAchievement(eAchievement_Dreamer, "Dreamer");
		CreateAchievement(eAchievement_Widow, "Widow");
		CreateAchievement(eAchievement_Pilgrim, "Pilgrim");
		CreateAchievement(eAchievement_Communicator, "Communicator");
		CreateAchievement(eAchievement_Gunner, "Gunner");
		CreateAchievement(eAchievement_Pathfinder, "Pathfinder");
		CreateAchievement(eAchievement_Nomad, "Nomad");
		CreateAchievement(eAchievement_Somnambulist, "Somnambulist");
		CreateAchievement(eAchievement_Fugitive, "Fugitive");
		CreateAchievement(eAchievement_Tinkerer, "Tinkerer");
		CreateAchievement(eAchievement_Murderer, "Murderer");
		CreateAchievement(eAchievement_Traveller, "Traveller");
		CreateAchievement(eAchievement_Diagnostician, "Diagnostician");
		CreateAchievement(eAchievement_Torturer, "Torturer");
		CreateAchievement(eAchievement_Altruist, "Altruist");
		CreateAchievement(eAchievement_Castaway, "Castaway");
		CreateAchievement(eAchievement_Refugee, "Refugee");
		CreateAchievement(eAchievement_Mother, "Mother");
		CreateAchievement(eAchievement_Tasi, "Tasi");
		CreateAchievement(eAchievement_Harvester, "Harvester");
		CreateAchievement(eAchievement_Provider, "Provider");
		CreateAchievement(eAchievement_Iconoclast, "Iconoclast");
		CreateAchievement(eAchievement_Stoic, "Stoic");
		CreateAchievement(eAchievement_Caregiver, "Caregiver");
		CreateAchievement(eAchievement_Archivist, "Archivist");
		CreateAchievement(eAchievement_Overlooked, "Overlooked");
		CreateAchievement(eAchievement_Trawler, "Trawler");
		CreateAchievement(eAchievement_Speedster, "Speedster");
		CreateAchievement(eAchievement_Vandal, "Vandal");
		CreateAchievement(eAchievement_EscapeArtist, "EscapeArtist");
		CreateAchievement(eAchievement_NopeMerci, "NopeMerci");
		CreateAchievement(eAchievement_Translocator, "Translocator");
		CreateAchievement(eAchievement_Historian, "Historian");
		CreateAchievement(eAchievement_Narcissist, "Narcissist");
		CreateAchievement(eAchievement_Curator, "Curator");
		CreateAchievement(eAchievement_Crewmember, "Crewmember");
		CreateAchievement(eAchievement_Canopener, "Canopener");
		CreateAchievement(eAchievement_Lightbringer, "Lightbringer");
		CreateAchievement(eAchievement_Reborn, "Reborn");

		/////////////
		// Register all achievements on Steam/PS4
		RegisterAchievements();	
		
		ePlatform platform = cSystem_GetPlatform();
		if (platform == ePlatform_Win32 || 
			platform == ePlatform_Linux ||
			platform == ePlatform_Mac)
		{
			/////////////
			// Auto unlock Reborn if all are unlocked and it failed to log you in last time
			if (mBaseObj.GetAllAchievementsUnlocked() && mBaseObj.GetAchievementUnlocked(eAchievement_Reborn) == false)
			{
				mBaseObj.UnlockAchievement(eAchievement_Reborn);
			}
		}
	}
	
	//-------------------------------------------------------
	
	void IncreaseCount(eAchievementCount aCount)
	{
		switch(aCount)
		{
			case eAchievementCount_Notes:
				mlNotes++;
				break;
			case eAchievementCount_CrewNotes:
				mlCrewNotes++;
				break;
			case eAchievementCount_Cylinders:
				mlCylinders++;
				break;
			case eAchievementCount_UsedMatches:
				mlUsedMatches++;
				break;
			case eAchievementCount_BrokenProps:
				mlBrokenProps++;
				break;
		}
	}
	
	//------------------------------------------------------------
	
	int mlNotes = 0;
	int mlCrewNotes = 0;
	int mlCylinders = 0;
	int mlUsedMatches = 0;
	int mlBrokenProps = 0;
	
}	