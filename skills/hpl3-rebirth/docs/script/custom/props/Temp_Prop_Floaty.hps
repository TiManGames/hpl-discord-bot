#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"
#include "helpers/helper_props.hps"
#include "helpers/helper_modules.hps"
#include "helpers/helper_map.hps"

class cScrTempPropFloaty : iScrProp, iScrProp_Interface
{
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		///////////////////////////////
		// Get vars
		mOnColor = apVars.GetVarColor("ColorOn", cColor(1, 0, 1, 1));
		mOffColor = apVars.GetVarColor("ColorOff", cColor(1, 0, 1, 1));
		mfModifiedGravity = apVars.GetVarFloat("GravityWhenOn", -1);
		
		mbCanInteract = apInstanceVars.GetVarBool("CanInteract", false);
		mbChangeColor = apInstanceVars.GetVarBool("ChangeColor", false);
		mbChangeGravity = apInstanceVars.GetVarBool("ChangeGravity", false);
		mfFloatTime = apInstanceVars.GetVarFloat("FloatTime", 3);
		
		if (mbChangeColor)
		{
			mBaseObj.SetEffectBaseColor(mOffColor);
		}
		
		mBaseObj.SetFullGameSave(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		// After letting go the prop, turn it off after a while
		if(mbIsInteracting && !mBaseObj.IsInteractedWith())
		{
			mbIsInteracting = false;
			mBaseObj.Timer_Add("TimerTurnOff", mfFloatTime, "TimerTurnOff");
		}
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
		 
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(float afAmount, int alStrength, const tString&in asType, tID a_idSource)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if(!mbCanInteract) return false;
		if(mBaseObj.HasPlayerInteractCallback()) return true;
		if(mBaseObj.GetParentType() == eParentType_StickyStuck) return false;
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		// Turn the prop on
		ChangeState(true);
		mbIsInteracting = true;
		
		// Remove turn off timer if already scheduled
		mBaseObj.Timer_Remove("TimerTurnOff");
		
		///////////////////////////////
		//Set up grabstate
		if (mBaseObj.GetStaticPhysics())
		{
			mBaseObj.SetStaticPhysics(false);
		}
		mBaseObj.SetSaveDataIsUpdated(true);
		
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab postion
		
		cScript_SetGlobalArgFloat(7, 1.2);	//Custom depth
		cScript_SetGlobalArgFloat(8, 0.1);	//Grab mass mul
		cScript_SetGlobalArgFloat(9, 0.8);	//Min depth
		cScript_SetGlobalArgFloat(10, 2);	//Max Depth
		cScript_SetGlobalArgFloat(11, 1);
		cScript_SetGlobalArgFloat(12, 1);
		cScript_SetGlobalArgFloat(13, 5);
		cScript_RunGlobalFunc("State_Interact_Grab", "", "SetupGrab");
		
		cLux_GetPlayer().ChangeState(ePlayerState_Grab);
	
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_CarryOneHanded;
	}
	
	//------------------------------------------------------------
	
	void ChangeState(bool abOn)
	{
		if (mbChangeColor)
		{
			mBaseObj.SetEffectBaseColor(abOn ? mOnColor : mOffColor);
		}
		
		if (mbChangeGravity)
		{
			mBaseObj.GetBody(0).SetGravity(!abOn);
		}
	}
	
	//------------------------------------------------------------
	
	void TimerTurnOff(uint64 alID)
	{
		ChangeState(false);
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cColor mOnColor;
	cColor mOffColor;
	float mfModifiedGravity = -1;
	bool mbCanInteract = false;
	bool mbChangeColor = false;
	bool mbChangeGravity = false;
	float mfFloatTime = 0;
	
	bool mbOn = false;
	bool mbInteractDisablesStaticPhysics = false;
	bool mbIsInteracting = false;

	//------------------------------------------------------------
}