#include "props/Prop_Grab.hps"

class cScrTestRope : cScrPropGrab
{
	
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if(mbGrab_InteractOnlyWithMainBody && apBody !is mBaseObj.GetMainBody()) return false;
		if(mBaseObj.HasPlayerInteractCallback()) return true;
		if(mBaseObj.GetStaticPhysics() && !mbInteractDisablesStaticPhysics) return false;
	
		return true;
	}
	
}