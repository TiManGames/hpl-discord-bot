#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"

#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"

class cScrTempPropBullet : iScrProp, iScrProp_Interface
{	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mBaseObj.SetScriptCollisionCallbackActive(true);	
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{

	}
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
		 
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-------------------------------------------------------------
	
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in aContactData)
	{		

		if (!mbExplode)
		{
			mBaseObj.Timer_Add("ExplodeTimer", 0, "Explode");
			mbExplode = true;
		}
			
	}
	
		
	//------------------------------------------------------------
	
	void Explode(uint64 alId)
	{
		//////////
		// EXPLODE
		
		// Create explosion PS
		cParticleSystem@ pPuffPS = cLux_GetCurrentMap().GetWorld().CreateParticleSystem("puff","ball_puff",cVector3f_One,true,false);
		pPuffPS.SetPosition(mBaseObj.GetPosition());
		
		/////////////
		// CREATE PUSH

		// Deal damage
		
		float fDamage = 0.5f;
		float fDamageRadius = 1.0f;
		cVector3f vOrigin = mBaseObj.GetPosition();	
		cMatrixf mtxId = cMath_MatrixTranslate(vOrigin);
		iCollideShape@ mpCollideShape = cLux_GetCurrentMap().GetPhysicsWorld().CreateSphereShape(fDamageRadius,mtxId);
		cLux_ShapeDamage(mpCollideShape,cMatrixf_Identity,vOrigin,fDamage,0,0,0,0.0f,0,true,true,true,false,mBaseObj.GetID(),cLux_GetCurrentMap().GetNewAttackInstanceID());
		
		// Destroy ball
		mBaseObj.Break();
		
	}
	
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	
	//-------------------------------------------------------------
	

	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool mbExplode = false;
	
	//------------------------------------------------------------
}