#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "props/Prop_Rigid.hps"

class cScrTempPropBallProjectile : cScrPropRigid
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		cScrPropRigid::Init();
		mBaseObj.SetScriptCollisionCallbackActive(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////

	//------------------------------------------------------------
	
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData &in aContactData)
	{
		cScrPropRigid::OnPhysicsCollision(apBody, apCollideBody, aContactData);
		
		/////////////////////////
		// Add explosion timer on only the first bounce
		mBaseObj.Timer_Add("explode_timer", 0.2, "TimerExplode");
		mBaseObj.SetScriptCollisionCallbackActive(false);
	}
	
	//------------------------------------------------------------
	
	void TimerExplode(uint64 aTimerID)
	{
		/////////////////////////
		// Get nearby bodies
		cVector3f vMin = mBaseObj.GetPosition() - cVector3f(1, 1, 1) * mfForceRadius;
		cVector3f vMax = mBaseObj.GetPosition() + cVector3f(1, 1, 1) * mfForceRadius;
		array<iPhysicsBody@> vBodies;
		mBaseObj.GetMap().GetPhysicsWorld().GetBodiesInAABB(vMin, vMax, vBodies);
		
		/////////////////////////
		// Add an impulse to each body
		for (int i = 0; i < vBodies.size(); ++i)
		{
			iPhysicsBody@ pBody = vBodies[i];
			cVector3f vDirToBody = pBody.GetWorldPosition() - mBaseObj.GetPosition();
			float fDistance = vDirToBody.Length();
			vDirToBody.Normalize();
			
			/////////////////////////
			// Scale power according to distance squared
			float fRadiusSquared = mfForceRadius * mfForceRadius;
			float fDistanceSquared = fDistance * fDistance;
			float fPowerMul = 1.0f  - cMath_Clamp(fDistanceSquared / fRadiusSquared, 0.0f, 1.0f);
			
			/////////////////////////
			// Scale power according to mass
			float fMassMul = 1.0f - cMath_Clamp(cMath_Max(0.1f, pBody.GetMass()) / 10.0f, 0.0f, 1.0f);
			
			pBody.AddImpulse(vDirToBody * fPowerMul * fMassMul * 25.0f);
		}
		
		/////////////////////////
		// Break the prop
		mBaseObj.Break();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfForceRadius = 5;
	
	//------------------------------------------------------------
}