	[nosave] tString msSoundHandleUp;
	[nosave] tString msSoundHandleDown;
	[nosave] tString msSoundHandleMove;
	[nosave] tString msSoundHandleGrab;
	[nosave] tString msSoundHandleGrabStuck;
