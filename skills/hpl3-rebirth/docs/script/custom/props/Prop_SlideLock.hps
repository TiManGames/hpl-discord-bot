	[nosave] float mfSoundHandleDownMinSpeed;

	[nosave] tString msSoundTeethOut;
	[nosave] tString msSoundTeethIn;
	[nosave] tString msSoundTeethMove;
	[nosave] float mfSoundTeethInMinSpeed;
	[nosave] float mfSoundTeethOutMinSpeed;

	[nosave] float mfHandlePadMultiplier;
	[nosave] eCrossHairState mCustomInteractIcon;
	[nosave] bool mbLockConnectedEntity;
	[nosave] bool mbInteractOnlyWithMainBody;
	
	[nosave] bool mbMoveTeeth = false;
	[nosave] bool mbTeethOut = true;
	[nosave] bool mbStartLocked = false;
	[nosave] bool mbIsReady = false;

	cVector3f mvHandleInitialPosition;
	cVector3f mvTeethInitialPosition;
	cVector3f mvTeethFinalPosition;

	//------------------------------------------------------------
	
	int mlAutoMoving;
	float mfAutoMoveTarget;
	bool mbStuck;
	int mlCurrentState = 0;
	
	bool mbFirstInteract=true;
	
	float mfInteractSoundCount;
	
	cUtility_JointFix mJointFix;
		
	//------------------------------------------------------------
		
}	