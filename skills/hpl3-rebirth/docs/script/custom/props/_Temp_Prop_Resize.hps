#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"

class cScrTempPropResize : iScrProp, iScrProp_Interface
{	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		
		/////////////////
		// Get vars
		
		msOwner = apVars.GetVarString("Owner", "Alex");
		mfSizeMultiplier = apInstanceVars.GetVarFloat("SizeMultiplier", 1.1);
		mbInteractOnce = apInstanceVars.GetVarBool("InteractOnce",true);
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
		 
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	
		
	//------------------------------------------------------------

	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return mbCanInteract;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		cVector3f vMyScale = mBaseObj.GetMeshScaleMul();
		cVector3f vNewScale(mfSizeMultiplier,mfSizeMultiplier,mfSizeMultiplier);
		mBaseObj.SetMeshScaleMul(vMyScale*vNewScale);
		
		tString sMyScale = vNewScale.x*vMyScale.x;

		Debug_Log(msOwner+"'s prop is now "+sMyScale+" times bigger!");

		mbCanInteract = mbInteractOnce ? false : true;
		
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_CarryOneHanded;
	}
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tString msOwner;
	float mfSizeMultiplier;
	bool mbInteractOnce;
	bool mbCanInteract = true;
	
	//------------------------------------------------------------
}