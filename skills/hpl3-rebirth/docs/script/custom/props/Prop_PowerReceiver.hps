#include "props/Prop_Rigid.hps"
#include "custom/modules/ModuleInterfaces_Custom.hps"

#include "helpers/helper_audio.hps"

class cScrPropPowerReceiver : cScrPropRigid
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropRigid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		mbEnabled = apInstanceVars.GetVarBool("Active", false);
		mbPlaySounds = apInstanceVars.GetVarBool("PlaySounds", false);
		tString sCallback = apInstanceVars.GetVarString("Callback", "");
		
		if (mbEnabled)
		{
			iScrDarkWorldPowerHandler_Interface @pHandler = cast<iScrDarkWorldPowerHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DarkWorldPowerHandler));
			pHandler.AddReceiver(mBaseObj.GetMap(), mBaseObj.GetID(), sCallback);
		}
		
		SetVisualState(0, true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_PowerActivate()
	{
		if (mbPlaySounds)
		{
			Sound_CreateAtEntity("ReceiverOn_" + mBaseObj.GetName(), "03_07_DW_theatre/energy_receiver/receiver_on", mBaseObj.GetName());
			Sound_CreateAtEntity("ReceiverOnLoop_" + mBaseObj.GetName(), "03_07_DW_theatre/energy_receiver/receiver_loop", mBaseObj.GetName());
			Sound_Stop("ReceiverOffIdleLoop_" + mBaseObj.GetName(), 0.5f);
		}
		SetVisualState(1);
	}
	
	//------------------------------------------------------------
	
	void _Global_PowerDeactivate()
	{
		if (mbPlaySounds)
		{
			Sound_CreateAtEntity("ReceiverOff_" + mBaseObj.GetName(), "03_07_DW_theatre/energy_receiver/receiver_off", mBaseObj.GetName());
			Sound_CreateAtEntity("ReceiverOffIdleLoop_" + mBaseObj.GetName(), "03_07_DW_theatre/energy_receiver/receiver_idle", mBaseObj.GetName());
			Sound_Stop("ReceiverOnLoop_" + mBaseObj.GetName(), 0.5f);
		}
		SetVisualState(0);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// POWER RECEIVER
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetVisualState(int alState, bool abInstant = false)
	{
		cColor baseColor = cColor(1, 1, 0.4);
		if (alState == 0)
		{
			baseColor = cColor(1, 0.1, 0.1)*1.25f;
		}
		else if (alState == 1)
		{
			baseColor = cColor(1, 1, 0.4)*1.75f;
		}
		
		mBaseObj.SetEffectsActive(true, !abInstant);
		if (abInstant) mBaseObj.SetEffectBaseColor(baseColor);
		else mBaseObj.FadeEffectBaseColor(baseColor, 0.25f);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbEnabled = false;
	bool mbPlaySounds = true;
	
	//------------------------------------------------------------
}