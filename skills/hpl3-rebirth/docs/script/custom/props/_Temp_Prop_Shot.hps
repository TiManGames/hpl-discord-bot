#include "props/Prop_Rigid.hps"
#include "helpers/helper_modules.hps"
#include "helpers/helper_effects.hps"
#include "custom/helpers/helper_agent.hps"
#include "custom/player/PlayerTypes_Custom.hps"

class cScrTempPropShot : cScrPropRigid
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mBaseObj.SetScriptCollisionCallbackActive(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
			
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	//------------------------------------------------------------

	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in aContactData)
	{		
		//////////////////////////////////////////////////////////////
		// Start prepare explosion timer
		mBaseObj.Timer_Add("CreateExplosionDamageTimer", 0.1f, "Timer_CreateExplosionDamage");	
		
		//////////////////////////////////////////////////////////////
		// Disable this callback to prevent future calls
		mBaseObj.SetScriptCollisionCallbackActive(false);	
	}
	
	//------------------------------------------------------------
	
	void Timer_CreateExplosionDamage(uint64 alId)
	{
		//////////////////////////////////////////////////////////////
		// Create damage shape!
		cLuxMap@ pMap = cLux_GetCurrentMap();
		
		iCollideShape@ pExplosionColl = pMap.GetPhysicsWorld().CreateSphereShape(4.f, mBaseObj.GetBody(0).GetWorldMatrix());
		cLux_ShapeDamage(pExplosionColl, cMatrixf_Identity, cVector3f_Zero, 35.f, 0.f, 0.f, 0, 0.f, 
						 eDamageType_Default, true, false, false, false, tID_Invalid, pMap.GetNewAttackInstanceID());
		
		//////////////////////////////////////////////////////////////
		// Explode in 0.01!
		mBaseObj.Timer_Add("ExplodeTimer", 0.05f, "Timer_Explode");
	}
	
	//------------------------------------------------------------
	
	void Timer_Explode(uint64 alId)
	{
		//////////////////////////////////////////////////////////////
		// Get bodies in explosion range	
		cVector3f vMin = mBaseObj.GetPosition() - cVector3f_One * 4.f;
		cVector3f vMax = mBaseObj.GetPosition() + cVector3f_One * 4.f;
				
		array<iPhysicsBody@> vBodies;
		cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(vMin, vMax, vBodies);
		
		cVector3f vForceDir;
		float fForceMul;
		
		for (int i = 0; i < vBodies.length(); i++)
		{
			iPhysicsBody@ pBody = vBodies[i];
			
			if (pBody.IsActive() == false ||
				pBody.GetID() == mBaseObj.GetBody(0).GetID() ||
				pBody.GetName() == "Terrain")
				continue;
				
			//////////////////////////////////////////////////
			// Calculate impulse dir and intensity
			vForceDir = pBody.GetWorldPosition() - mBaseObj.GetPosition();			
			
			fForceMul = 1.0f - (vForceDir.Length() / 5.f);			
			fForceMul = cMath_Clamp(fForceMul, 0.f, 1.f);
			fForceMul = cMath_Easing(eEasing_CubicIn, fForceMul);
			
			vForceDir.Normalize();
			cVector3f vForce = vForceDir * (10000.f * fForceMul);		

			//////////////////////////////////////////////////
			// Apply force
			pBody.AddForce(vForce);
		}
		
		cLuxMap@ pMap = cLux_GetCurrentMap();
		
		//////////////////////////////
		// Create effects		
		pMap.CreateEntity(mBaseObj.GetName() + "Effects", "shot_effects.ent", mBaseObj.GetMatrix(), cVector3f_One);
		LightFlash_Add(0.f, 0.1f, 0.5f, pMap.GetLatestEntity().GetName(), cColor_White, 5.f, 7.f);	
				
		int lShakeId = Effect_Shake_Start(1.f, 0.05f, 0.2f, 0.3f);
		Effect_Shake_SetSourceEntity(lShakeId, pMap.GetLatestEntity().GetName(), 0.f, 20.f, eEasing_Linear);
		
		//////////////////////////////
		// Destroy shot entity		
		mBaseObj.Break();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
			
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
}	