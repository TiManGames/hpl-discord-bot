#include "props/Prop_Push.hps"
#include "helpers/helper_audio.hps"

class cScrPushAnimated : cScrPropPush
{
	void Init()
	{
		cScrPropPush::Init();
	}
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropPush::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		msAnimName = apVars.GetVarString("AnimName", "");
		mvForwardDir = apVars.GetVarVector3f("ForwardDir", cVector3f(0, 0, 1));
		mfAnimSpeedMul = apVars.GetVarFloat("AnimSpeedMul", 1.0f);
		msSoundName = apVars.GetVarString("SoundName", "");
		
		mBaseObj.StopAllAnimations(0);
		
		cAnimationState@ pAnim = mBaseObj.GetMeshEntity().GetAnimationStateFromName(msAnimName);
		if (pAnim !is null)
		{
			pAnim.SetRelativeTimePosition(0.0f);
			pAnim.SetSpeed(0.0f);
		}
	}
	
	void OnUpdate(float afTimeStep)
	{
		float fSpeed = 0;
		if (mbPlayLoopAnim)
		{
			cVector3f vVel = mBaseObj.GetMainBody().GetLinearVelocity();
			fSpeed = vVel.Length();
			if (fSpeed > 0 || mfAnimSpeed > 0)
			{
				bool bFalling = vVel.y < 0.0f && cVector3f(vVel.x, 0.0f, vVel.z).Length() < 0.05f;
				mfAnimSpeed = bFalling ? 0.0f : mfAnimSpeedMul * fSpeed;
				if (pAnimState is null) @pAnimState = mBaseObj.GetMeshEntity().GetAnimationStateFromName(msAnimName);
				if (pAnimState !is null)
				{
					if (pAnimState.IsActive() == false) mBaseObj.PlayAnimation(msAnimName, 0, true);
					cVector3f vForwardDirWorld = cMath_MatrixMul(mBaseObj.GetMatrix().GetRotation(), mvForwardDir);
					float fDir = cMath_Vector3Dot(mBaseObj.GetMainBody().GetLinearVelocity(), vForwardDirWorld) >= 0.0f ? 1.0f : -1.0f;
					pAnimState.SetSpeed(fDir * mfAnimSpeed);
				}
			}
			else
			{
				mBaseObj.Sleep();
				StopSoundLoop();
			}
		}
		
		if (msSoundName != "")
		{
			if (fSpeed > 0.2f)
			{
				if (m_idMoveSound == tID_Invalid)
				{
					cSoundEntity@ pSound = mBaseObj.PlaySound("CannonMove", msSoundName, false, true);
					m_idMoveSound = pSound.GetID();
				}
				else
				{
					cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idMoveSound);
					float fVolume = cMath_Clamp((fSpeed - 0.2f) / (1.5f - 0.2f), 0.0f, 1.0f);
					if (pSound !is null) pSound.FadeVolumeMul(fVolume, 0.0f);
				}
			}
			else
			{
				StopSoundLoop();
			}
		}
	}
	
	void StopSoundLoop()
	{
		if (m_idMoveSound == tID_Invalid) return;
			
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idMoveSound);
		if (pSound !is null) pSound.FadeOut(1);
		
		m_idMoveSound = tID_Invalid;
	}
	
	void OnSetActive(bool abX)
	{
		if (abX)
		{
			
		}
		else
		{
			if (m_idMoveSound != tID_Invalid)
			{
				cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idMoveSound);
				if (pSound !is null) pSound.FadeOut(1);
				
				m_idMoveSound = tID_Invalid;
			}
		}
	}
	
	void _Global_SetPlayLoopAnim()
	{
		mbPlayLoopAnim = cScript_GetGlobalArgBool(0);
	}
	
	[volatile] cAnimationState@ pAnimState;
	tString msAnimName;
	tString msSoundName;
	float mfAnimSpeedMul;
	float mfAnimSpeed;
	cVector3f mvForwardDir;
	tID m_idMoveSound = tID_Invalid;
	bool mbPlayLoopAnim = true;
}