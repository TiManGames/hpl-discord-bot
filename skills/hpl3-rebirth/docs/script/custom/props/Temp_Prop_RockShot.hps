#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "props/Prop_Rigid.hps"
#include "custom/player/PlayerTypes_Custom.hps"

class cScrTempPropRockShot : cScrPropRigid
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		cScrPropRigid::Init();
		mBaseObj.SetScriptCollisionCallbackActive(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////

	//------------------------------------------------------------
	
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData &in aContactData)
	{
		cScrPropRigid::OnPhysicsCollision(apBody, apCollideBody, aContactData);
		
		if (mbDealtDamage) return;
		mbDealtDamage = true;

		iCollideShape@ pCollideShape = cLux_GetCurrentMap().GetPhysicsWorld().CreateSphereShape(cVector3f_One * 6.0f, cMatrixf_Identity);
		cLux_ShapeDamage(pCollideShape, mBaseObj.GetMatrix(), mBaseObj.GetPosition(), 0.4f, mfForce, 2000, 0, 0, eDamageType_Default, true, false, true, false, mBaseObj.GetID(), cLux_GetCurrentMap().GetNewAttackInstanceID());
		
		cSoundEntity@ pSoundEnt = cLux_GetCurrentMap().GetWorld().CreateSoundEntity("sound_explosion", "_temp/gregor/sfx/bigboom.snt", true);
		pSoundEnt.SetVolume(0.5f);
		pSoundEnt.SetPosition(apBody.GetWorldPosition());

		mBaseObj.Break();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	//{//////////////////////////////////////
	
	//-----------------------------------------------------------
	
	bool mbDealtDamage = false;
	float mfForce = 800.0f;
	
	//-----------------------------------------------------------
}