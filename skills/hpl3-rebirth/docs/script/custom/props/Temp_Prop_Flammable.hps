#include "props/Prop_Grab.hps"
#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "helpers/helper_player.hps"

class cScrPropFlammable : cScrPropGrab
{	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropGrab::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		/////////////////
		// Get vars
		mbTurnOnWhenInteracting = apInstanceVars.GetVarBool("TurnOnWhenInteracting", false);
		mbStartOn = apInstanceVars.GetVarBool("StartOn", false);
		
		/////////////////
		// Temp Fire Component
		@mpTempFireComponent = UserComponent_TempFire_Create(mBaseObj);
		mpTempFireComponent.SetActive(mbTurnOnWhenInteracting == false && mbStartOn == true);
		mpTempFireComponent.SetupAfterLoad(apWorld, apVars, apInstanceVars);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		if (mbInteracted && !mBaseObj.IsInteractedWith())
		{
			mbInteracted = false;
			
			// Stop dealing burn damage when not interacting
			mBaseObj.Timer_Remove("TimerBurnDamage");
			
			if (mbTurnOnWhenInteracting == true)
			{
				mBaseObj.Timer_Add("TimerStopFlames", 2, "TimerStopFlames", true, false);
			}
		}
	}
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		cScrPropGrab::OnInteract(alType, apBody, avFocusPos, asData);
		
		mbInteracted = true;
		
		// Queue burn damage
		mBaseObj.Timer_Add("TimerBurnDamage", 1, "TimerBurnDamage", true, true);
		
		if (mbTurnOnWhenInteracting == true)
		{
			mpTempFireComponent.SetActive(true);
			mBaseObj.Timer_Remove("TimerStopFlames");
		}
		return true;
	}

	//------------------------------------------------------------
	
	void TimerBurnDamage(uint64 alID)
	{
		cLux_GetPlayer().GiveDamage(0.1, 0, 0, 0, tID_Invalid, -1);
	}
	
	//------------------------------------------------------------

	void TimerStopFlames(uint64 alID)
	{
		mpTempFireComponent.SetActive(false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbInteracted = false;
	
	// If true, flames will be off by default, and turned on when interacting with the entity
	bool mbTurnOnWhenInteracting = false;
	bool mbStartOn = false;
	
	[volatile] iScrTempFireComponent_Interface@ mpTempFireComponent = null;
	
	//------------------------------------------------------------
}