#include "custom/props/Prop_Pickup.hps"

//------------------------------------------------------------

const float gfFlareBurnTime = 60.f;

//------------------------------------------------------------

class cScrPropFlare : cScrPropPickup
{				
	
	//------------------------------------------------------------
	
	void _Global_CopyFromItemEntity() override
	{
		cScrPropPickup::_Global_CopyFromItemEntity();
				
		tString sDest = cScript_GetGlobalArgString(0);
		cScript_SetGlobalArgFloat(0, mfBurnTime);
		cScript_SetGlobalArgInt(1, mlPutAwayTimeStamp);
		cScript_RunGlobalFunc(sDest, "cScrPropFlare", "_Global_CopyValues");
	}
	
	//------------------------------------------------------------
	
	// Called to transfer values from another of these entities
	// e.g. when spawning something from the inventory
	
	void _Global_CopyValues()
	{
		mfBurnTime = cScript_GetGlobalArgFloat(0);
		mlPutAwayTimeStamp = cScript_GetGlobalArgInt(1);
	}
	
	//------------------------------------------------------------
	
	void _Global_Ignite()
	{
		mfBurnTime = 0.f;
	}
	
	//-----------------------------------------------------------
	
	void _Global_OnItemPutAway()
	{
		mlPutAwayTimeStamp = cLux_GetCurrentMap().GetTimeStamp();
	}
	
	//-----------------------------------------------------------
	
	void _Global_OnItemTakenOut()
	{
		float fPutAwayCount = cLux_GetCurrentMap().GetElapsedTime(mlPutAwayTimeStamp);
		if (mfBurnTime > 0.f)
		{
			mfBurnTime += fPutAwayCount;
		}		
		if (mfBurnTime >= gfFlareBurnTime)
		{
			mBaseObj.SetEffectsActive(false, false);
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_OnItemThrown()
	{		
		if (mfBurnTime > 0)
		{			
			mBaseObj.SetAutoSleep(false);
		}		
		if (mfBurnTime >= gfFlareBurnTime)
		{
			mBaseObj.SetEffectsActive(false, false);
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_CanBeHighlighted()
	{
		cScript_SetGlobalReturnBool(true);
		cScript_SetGlobalArgID(0, mBaseObj.GetID());
	}
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		cScrPropPickup::OnUpdate(afTimeStep);
		
		if (mfBurnTime >= 0.f)
		{
			mfBurnTime += afTimeStep;

			if (mfBurnTime > gfFlareBurnTime)
			{
				mBaseObj.SetEffectsActive(false, true);
			}
			else
			{
				mBaseObj.SetEffectsActive(true,true);
			}

			//////////////////////////////////////////////////////////////////
			// Update running - it's not put away, stamp needs to be current
			mlPutAwayTimeStamp = cLux_GetCurrentMap().GetTimeStamp();		
		}
		else
		{
			mBaseObj.SetEffectsActive(false, false);
		}
	}
	
	//------------------------------------------------------------
	// Properties
	//------------------------------------------------------------
	
	float mfBurnTime = -1.f;
	int mlPutAwayTimeStamp = 0;
}