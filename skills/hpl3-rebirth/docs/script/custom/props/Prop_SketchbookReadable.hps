#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"

class cScrPropSketchbookReadable : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{		
		msSubmesh = apVars.GetVarString("Submesh", "");
		msOnGuiFunction = apInstanceVars.GetVarString("OnGuiFunction", "");
		cVector2f vScreenSize = apVars.GetVarVector2f("ScreenSize", cVector2f(512.0f));

		mBaseObj.DisableSubMeshMerge(msSubmesh);
		mBaseObj.CreateAndSetupGui(msSubmesh, cColor(1,1,1,1), cColor(1,1,1,1), cColor(1,1,1,1), vScreenSize);
		mBaseObj.SetOnGuiFunction(msOnGuiFunction);
		mBaseObj.SetGuiVariableFPS(30);
		mBaseObj.SetGuiActive(true);
		mBaseObj.SetGuiUpdateWhenOutOfView(false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
