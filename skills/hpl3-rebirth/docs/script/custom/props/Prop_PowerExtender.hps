#include "props/Prop_Grab.hps"

#include "helpers/helper_audio.hps"
#include "helpers/helper_player.hps"
#include "helpers/helper_player_custom.hps"

class cScrPropPowerExtender : cScrPropGrab
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropGrab::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		mbEnabled = apInstanceVars.GetVarBool("Active", false);
		mbBroken = apInstanceVars.GetVarBool("Broken", false);
		mbFlickering = apInstanceVars.GetVarBool("Flickering", false);
		tString sCallback = apInstanceVars.GetVarString("Callback", "");
		msPulseCallback = apInstanceVars.GetVarString("PulseCallback", "");
		float fRadius = apInstanceVars.GetVarFloat("Radius", 10);
		
		if (mbEnabled)
		{
			iScrDarkWorldPowerHandler_Interface @pHandler = cast<iScrDarkWorldPowerHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DarkWorldPowerHandler));
			pHandler.AddExtender(mBaseObj.GetMap(), mBaseObj.GetID(), fRadius, sCallback);
			SetVisualState(0);
		}
		
		if (mbFlickering)
		{
			StartFlickering();
		}
		
		//Sound_PreloadGroup("03_07_DW_theatre/energy_extender", true);
		//Sound_PreloadGroup("03_07_DW_theatre/energy_extender_broken", true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_PowerActivate()
	{
		if (mbFlickering==false) Sound_CreateAtEntity("ExtenderOn_" + mBaseObj.GetName(), "03_07_DW_theatre/energy_extender/extender_on", mBaseObj.GetName());
		if (mbFlickering==false) Sound_CreateAtEntity("ExtenderLoop_" + mBaseObj.GetName(), "03_07_DW_theatre/energy_extender/energy_loop", mBaseObj.GetName());
		Sound_Stop("ExtenderIdle_" + mBaseObj.GetName(), 0.5f);
		if (mbBroken)
		{
			StartPulsing();
		}
		else
		{
			SetVisualState(1);
		}
		mbActive = true;
	}
	
	//------------------------------------------------------------
	
	void _Global_PowerDeactivate()
	{
		if (mbFlickering==false) Sound_CreateAtEntity("ExtenderOff_" + mBaseObj.GetName(), "03_07_DW_theatre/energy_extender/extender_off", mBaseObj.GetName());
		if (mbFlickering==false) Sound_CreateAtEntity("ExtenderIdle_" + mBaseObj.GetName(), "03_07_DW_theatre/energy_extender/extender_idle", mBaseObj.GetName());
		Sound_Stop("ExtenderLoop_" + mBaseObj.GetName(), 0.5f);
		if (mbPulsing == false)
		{
			SetVisualState(0);
		}
		else if (mbPulseBuildup)
		{
			StopBuildup();
		}
		mbActive = false;
	}
	
	//------------------------------------------------------------
	
	void _Global_SetBroken()
	{
		mbBroken = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		if (mbPulsing && mbPulseBuildup == false)
		{
			DoShock();
			return false;
		}
		else
		{
			return cScrPropGrab::OnInteract(alType, apBody, avFocusPos, asData);
		}
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		if (mbShocked) return eCrossHairState_PickUpForbidden;
		else return cScrPropGrab::GetInteractIconId(alType, apBody);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// POWER EXTENDER
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void StartPulsing()
	{
		if (mbPulsing) return;
		mbPulsing = true;
		mbPulseBuildup = true;
		
//		mBaseObj.SetAutoSleep(false);
		mlPulseCount = 0;
		
		SetVisualState(2);
				
//		cSoundEntity@ pSound = mBaseObj.PlaySound("Sound_ExtenderBuildup", "03_07_DW_theatre/energy_extender_broken/explode_warning", true, true);
//		m_idBuildupSound = pSound.GetID();
		
//		pSound.SetUseCustomProperties(true);
//		pSound.SetCustomMaxDistance(30);
//		pSound.SetCustomMinDistance(8);
//		pSound.SetVolume(1.0);
		
		cSoundEntity@ pSoundBrokenLoop = mBaseObj.PlaySound("Sound_ExtenderBrokenLoop", "03_07_DW_theatre/energy_extender_broken/energy_loop", true, true);
		m_idBrokenLoopSound = pSoundBrokenLoop.GetID();
		
//		mBaseObj.Timer_Add("Timer_BuildupSpeed", 0.1, "OnTimer_BuildupSpeed");
//		mBaseObj.Timer_Add("Timer_BuildupStop", 1.5, "OnTimer_BuildupStop");
		mBaseObj.Timer_Add("Timer_Pulsing", 1.5, "OnTimer_Pulsing");
	}
	
	//------------------------------------------------------------
	
	void StopBuildup()
	{
		mbPulseBuildup = false;
		mbPulsing = false;
		SetVisualState(0);
		
//		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idBuildupSound);
//		pSound.FadeOut(2);
		

		mBaseObj.Timer_Remove("Timer_BuildupSpeed");
		mBaseObj.Timer_Remove("Timer_BuildupStop");
		mBaseObj.Timer_Remove("Timer_Pulsing");
	}
	
	//------------------------------------------------------------
	
	void OnTimer_BuildupSpeed(uint64 alId)
	{
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idBuildupSound);
		pSound.FadeSpeedMul(4, 0.4);
	}
	
	void OnTimer_BuildupStop(uint64 alId)
	{
		cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idBuildupSound);
		pSound.FadeOut(2);
	}
	
	//------------------------------------------------------------
	
	void OnTimer_Pulsing(uint64 alId)
	{
		mbPulseBuildup = false;
		
		++mlPulseCount;
		if (mlPulseCount == 1)
		{
			mOrigColor = mBaseObj.GetEffectBaseColor();
		}
		if (mlPulseCount <= 6)
		{
			DoPulse();
			mBaseObj.Timer_Add("Timer_Pulsing", 2.5, "OnTimer_Pulsing");
		}
		else
		{
			mbPulsing = false;
			
			cLux_ID_SoundEntity(m_idBrokenLoopSound).FadeOut(1);
			m_idBrokenLoopSound = tID_Invalid;
			
			if (mbActive) SetVisualState(1);
			else SetVisualState(0);
		}
	}
	
	//------------------------------------------------------------
	
	void DoPulse()
	{
		float fVolume = mlPulseCount == 1 ? 1.0 : 0.8;
		cSoundEntity@ pSound = mBaseObj.PlaySound("ExtenderPulse", "03_07_DW_theatre/energy_extender_broken/broken_pulse", true, true);
//		pSound.SetVolume(fVolume);

		if (mlPulseCount == 1) mBaseObj.GetMap().BroadcastSoundHeardEvent("ExtenderSound", mBaseObj.GetPosition(), 999, 4, false);
		
		mBaseObj.CreateParticleSystem("ExtenderSparks", "extender_fail_spark", true, true);
		
		mBaseObj.FadeEffectBaseColor(mOrigColor * 1.5, 0.25);
		mBaseObj.Timer_Add("Timer_TurnOffPulse", 0.3, "OnTimer_TurnOffPulse");
		
		if (mBaseObj.IsInteractedWith())
		{
			mBaseObj.GetMainBody().AddImpulse(Player_GetForward() * 3);
			DoShock();
		}
		
		if (msPulseCallback != "")
		{
			tString sMethodName = "void " + msPulseCallback + "()";
			if (mBaseObj.GetMap().ScriptMethodExists(sMethodName) && mBaseObj.GetMap().ScriptPrepare(sMethodName))
			{
				mBaseObj.GetMap().ScriptExecute();
			}
		}
	}
	
	//------------------------------------------------------------
	
	void DoShock()
	{
		mbShocked = true;
		Player_ChangeStateToNormal();
		Player_GiveDamage(0.05f, 0.9, eDamageType_Default, "");
		
		cSoundEntity@ pSound = mBaseObj.PlaySound("ExtenderPulseDamage", "03_07_DW_theatre/energy_extender_broken/broken_shock", true, true);		
		mBaseObj.Timer_Add("Timer_RemoveShocked", 0.3, "OnTimer_RemoveShocked");
	}
	
	//------------------------------------------------------------
	
	void OnTimer_RemoveShocked(uint64 alId)
	{
		mbShocked = false;
	}
	
	//------------------------------------------------------------
	
	void OnTimer_TurnOffPulse(uint64 alId)
	{
		mBaseObj.FadeEffectBaseColor(mOrigColor, 0.25);
	}
	
	//------------------------------------------------------------
	
	void SetVisualState(int alState, bool abInstant = false)
	{
		cColor baseColor = cColor(0.7, 1.0, 1.0);
		if (alState == 2) baseColor = cColor(1.1, 0.7, 0.7);
		
		float fBrightness = 0;
		if (alState == 0) fBrightness = 0.4;
		else if (alState == 1) fBrightness = 1;
		else if (alState == 2) fBrightness = 1.2;
		
		mBaseObj.SetEffectsActive(true, !abInstant);
		if (abInstant) mBaseObj.SetEffectBaseColor(baseColor * fBrightness);
		else mBaseObj.FadeEffectBaseColor(baseColor * fBrightness, 0.25f);
	}
	
	//------------------------------------------------------------
	
	void StartFlickering()
	{
		mBaseObj.Timer_Add("Timer_FlickerOff", cMath_RandRectf(0.05, 0.2), "OnTimer_FlickerOff");
	}
	
	//------------------------------------------------------------
	
	void OnTimer_FlickerOff(uint64 alId)
	{
		iScrDarkWorldPowerHandler_Interface @pHandler = cast<iScrDarkWorldPowerHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DarkWorldPowerHandler));
		pHandler.SetEntityEnabled(mBaseObj.GetID(), false);
		
		//SetVisualState(0);
		mBaseObj.Timer_Add("Timer_MicroFlickerOn", cMath_RandRectf(0.05, 0.3), "OnTimer_MicroFlickerOn");
		mBaseObj.Timer_Add("Timer_FlickerOn", cMath_RandRectf(0.2, 3.0), "OnTimer_FlickerOn");
	}
	
	//------------------------------------------------------------
	
	void OnTimer_FlickerOn(uint64 alId)
	{
		iScrDarkWorldPowerHandler_Interface @pHandler = cast<iScrDarkWorldPowerHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_Custom_DarkWorldPowerHandler));
		pHandler.SetEntityEnabled(mBaseObj.GetID(), true);
		
		mBaseObj.SetEffectsActive(true, true);
		mBaseObj.Timer_Remove("Timer_MicroFlickerOff");
		mBaseObj.Timer_Remove("Timer_MicroFlickerOn");
		mBaseObj.Timer_Add("Timer_FlickerOff", cMath_RandRectf(0.08, 0.25), "OnTimer_FlickerOff");
	}
	
	//------------------------------------------------------------
	
	void OnTimer_MicroFlickerOn(uint64 alId)
	{
		mBaseObj.SetEffectsActive(true, true);
		mBaseObj.Timer_Add("Timer_MicroFlickerOff", cMath_RandRectf(0.05, 0.3), "OnTimer_MicroFlickerOff");
	}
	
	//------------------------------------------------------------
	
	void OnTimer_MicroFlickerOff(uint64 alId)
	{
		mBaseObj.SetEffectsActive(false, true);
		mBaseObj.Timer_Add("Timer_MicroFlickerOn", cMath_RandRectf(0.05, 0.3), "OnTimer_MicroFlickerOn");
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbEnabled = false;
	bool mbBroken = false;
	bool mbFlickering = false;
	
	bool mbActive = false;
	bool mbPulsing = false;
	bool mbPulseBuildup = false;
	bool mbShocked = false;
	int mlPulseCount = 0;
	cColor mOrigColor;
	tID m_idBuildupSound = tID_Invalid;
	tID m_idBrokenLoopSound = tID_Invalid;
	tString msPulseCallback = "";
	
	//------------------------------------------------------------
}