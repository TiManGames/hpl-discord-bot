#include "custom/props/Prop_Rigid.hps"

class cScrRigidGhoul : cScrPropRigid
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		cScrPropRigid::OnSetActive(abX);
	}
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		if (mbStarted == false)
		{
			mbStarted = true;
		}
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfEyeCollorMul = 5.0f;
	cColor gGhoul_EyeColorDefault = cColor(1.65f, 1.65f, 1.65f);
	cColor gGhoul_EyeColorAlerted = cColor(1.95f, 1.68f, 0.5f);
	cColor gGhoul_EyeColorAttacking = cColor(2.5f, 0.7f, 0.7f);
	
	bool mbEyesCreated = false;
	bool mbStarted = false;
	tID m_idEyeLeft;
	tID m_idEyeRight;
	
	//------------------------------------------------------------
	
}