#include "effect/Effects.hps"
#include "custom/effects/Effects_Custom.hps"
#include "helpers/helper_effects.hps"

/////////////////////////////////////////
// NAUSEA
/////////////////////////////////////////

//------------------------------------------------------------

class cScrEffect_Nausea : iScrEffect, iScrEffect_Interface, iScrEffect_Nausea
{

	//----------------------------------
	
	void Init()
	{
	}

	//----------------------------------
	
	void OnDestroy()
	{
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PUBLIC METHODS
	/////////////////////////////////////////
	
	//----------------------------------
	
	void Start()
	{	
		if (mBaseObj.IsActive()) return;
		
		mfDuration = 0.f;
		mfPulseSpeedMul = 0.4f;
		mfSpikeCount = 0.f;
	
		float fAspect =  cLux_GetPlayer().GetCamera().GetAspect();
		float fBaseSize = 0.945f - (0.383f * (fAspect - 1.333f));
		cVector2f vSize = cVector2f(fBaseSize * fAspect, fBaseSize);
		
		mlScreenId = Effect_Screen_Start("temp_nausea_screen_less.mat", cVector2f(0.5f, 0.5f), cVector2f(fBaseSize * fAspect, fBaseSize));
		mlDofId = Effect_DoF_Start(0.f, 0.1f, 0.005f, 3.f);
		
		mBaseObj.SetActive(true);
	}
	
	//----------------------------------
	
	void Stop()
	{		
		if (mlScreenId != -1)
			Effect_Screen_FadeOut(mlScreenId, 1.f);
		mlScreenId = -1;
		
		if (mlDofId != -1)
			Effect_DoF_FadeOut(mlDofId, 1.f);
		mlDofId = -1;
		
		mBaseObj.SetActive(false);
	}
	
	//----------------------------------
	
	void Spike(float afTime)
	{
		mfSpikeCount = afTime;
	}

	//----------------------------------
	
	/////////////////////////////////////////
	// GENERAL CALLBACKS
	/////////////////////////////////////////
	
	//----------------------------------
	
	void OnStart()
	{
	}

	//----------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
		Reset();
	}
	
	//----------------------------------
	
	void OnMapLeave(cLuxMap @apMap)
	{
		Reset();
	}

	//----------------------------------
	
	void Reset()
	{
	}

	//----------------------------------
	
	
	void Update(float afTimeStep)
	{
		if (mfSpikeCount > 0.f)
		{
			mfSpikeCount -= afTimeStep;
			mfDuration = cMath_IncreaseTo(mfDuration, afTimeStep * 2.f, cMath_PiDiv2);
		}
		else
		{
			mfDuration += afTimeStep * mfPulseSpeedMul;
			if (mfDuration > cMath_Pi)
				mfDuration -= cMath_Pi;
		}
			
		float fPulse = cMath_Abs(cMath_Sin(mfDuration));		
		if (fPulse >= 0.99f)
			mfPulseSpeedMul = cMath_RandRectf(0.2f, 0.4f);
		
		float fAlpha = fPulse * 0.6f;
		Effect_Screen_SetAlpha(mlScreenId, fAlpha);
			
		float fDofEnd = cMath_Clamp((1.f - fPulse) * 10.f, 0.75f, 10.f);
		Effect_DoF_FadeFocus(mlDofId, 0.f, fDofEnd, afTimeStep);
	}
	
	//----------------------------------
	
	void OnDraw(float afFrameTime)
	{
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//----------------------------------
	
	int mlScreenId = -1;
	int mlDofId = -1;
	float mfDuration = 0.f;
	float mfPulseSpeedMul = 0.4f;
	float mfSpikeCount = 0.f;
	
	//----------------------------------
}