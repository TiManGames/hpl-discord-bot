#include "modules/ModuleInterfaces.hps"

//---------------------------------------------------

shared enum eEffect_Custom
{
	// Must be bigger than eEffect_LastEnum
	eEffect_Custom_BabyKick=51,
	eEffect_Custom_Nausea=52,
	eEffect_Custom_DollyZoom=53,
	eEffect_Custom_FearTentacles=54,
	eEffect_Custom_LastEnum
}

//---------------------------------------------------

/////////////////////////////////////////
// Custom effect interfaces below
/////////////////////////////////////////
	
//---------------------------------------------------

shared interface iScrEffect_BabyKick
{
	void Start(float afIntensity, bool abPlayGasp, bool abShake);
	void Stop();
	bool IsActive();
}

//---------------------------------------------------

shared interface iScrEffect_Nausea
{
	void Start();
	void Stop();
	void Spike(float afTime);
}

//-----------------------------------------

shared interface iScrEffect_DollyZoom
{
	void Start(float afAmount, float afTime, float afFadeInTime, float afFadeOutTime);
	void Stop();
}

//-----------------------------------------

shared enum eFearTentacleMaterial
{
	eFearTentacleMaterial_Default = 0,
	eFearTentacleMaterial_Focus = 1,
}

//---------------------------------------------------

shared interface iScrEffect_FearTentacles
{
	void Start();
	void Stop();
	
	void SetAlpha(float afX);
	void FadeAlpha(float afX, float afFadeTime);

	void SetCoverage(float afX);
	void FadeCoverage(float afX, float afFadeTime, bool abClampValue);
	
	void SetMinVignette(float afX);
	void FadeMinVignette(float afX, float afFadeTime);
	void SetVignetteEnabled(bool abX);
	void SetVignetteMul(float afX);
	
	void SetIntensity(float afX);
	void SetCritical(float afX);
	void SetScaleAdd(float afX);
	void FadeScaleAdd(float afX, float afFadeTime);
	
	
	void SetMul(float afX);
	float GetMul();
	void FadeMul(float afX, float afFadeTime);
	
	void SetSpeedMul(float afX);
	float GetSpeedMul();
	
	void SetMaterial(eFearTentacleMaterial aMaterial);
	void FadeMaterial(eFearTentacleMaterial aMaterial, float afTime);
	void PreloadData(cLuxMap@ apMap);
	
	void SetRingModeActive(bool abX);
}

//-----------------------------------------