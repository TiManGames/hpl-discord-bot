
//---------------------------------------------------

shared enum eComponentType_Custom
{
	eComponentType_Custom_Test = eLuxEntityComponentType_LastEnum,
	eComponentType_Custom_LiquidSource,
	eComponentType_Custom_MeatComponent,
	eComponentType_Custom_FireComponent,
	eComponentType_Custom_LampComponent,
	eComponentType_Custom_AIMeatSensor,
	eComponentType_Custom_AIFireSensor,
	eComponentType_Custom_AIPlayerNotify,
	/*eComponentType_Custom_CurseRadiator,
	eComponentType_Custom_Temp_BurnComponent,
	eComponentType_Custom_TempFire,
	eComponentType_Custom_Temp_AIBurnSensor,
	eComponentType_Custom_Temp_AIFireSensor,
	eComponentType_Custom_LucidityDrainer,
	eComponentType_Custom_TempFlammableComponent,
	eComponentType_Custom_TempFlammableSensor,*/
	eComponentType_Custom_FearScaryObjectComponent,
	eComponentType_Custom_FearThreatComponent,
	eComponentType_Custom_RiftComponent,
}

/////////////////////////////////////////
// Meat Component
/////////////////////////////////////////
	
//---------------------------------------------------

shared interface iScrMeatComponent_Interface
{
	void TestFunc();
	void SetAttractDistance(float afDistance);
	void SetMaxAttractDistance(float afDistance);
	void SetAttractEnabled(bool abX);
	void ClearCurrentAttraction();
	void SetUnreachable();
}

iScrMeatComponent_Interface@ UserComponent_MeatComponent_Create(iLuxEntity@ apEntity)
{
	return cast<iScrMeatComponent_Interface>(cLux_CreateUserComponent(apEntity, 
									"Meat", 
									"script/custom/components/MeatComponent.hps", 
									"cScrMeatComponent", 
									eComponentType_Custom_MeatComponent));
}

iScrMeatComponent_Interface@ UserComponent_MeatComponent_Get(iLuxEntity@ apEntity)
{
	return cast<iScrMeatComponent_Interface>(cLux_GetUserComponent(apEntity,eComponentType_Custom_MeatComponent));
}

