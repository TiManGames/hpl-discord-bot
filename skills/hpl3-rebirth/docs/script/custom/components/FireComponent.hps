#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "base/Base_Types.hps"

//---------------------------------------------------

class cScrFireComponent : iScrUserComponent, iScrUserComponent_Interface, iScrFireComponent_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfRepelDistance;
	
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	/////////////////////////////////////////
	// SETUP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void OnSetupAfterLoad(cWorld@ apWorld)
	{
		
	}
	
	void OnAfterWorldLoad()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void TestFunc()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlCount=0;
	float mfCountUpdate=0;
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		if( (mfCountUpdate+=afTimeStep) < 1) return;
		mfCountUpdate=0;
	
		UpdateRepel(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void UpdateRepel(float afTimeStep)
	{
		if (mBaseObj.GetEntity().IsActive() == false) return;
		if (mBaseObj.GetEntity().IsInteractedWith()) return;

		// If object is moving quite fast (i.e thrown)
		float fVel = mBaseObj.GetEntity().GetMainBody().GetLinearVelocity().Length();
		if (fVel > 0.5f) return;
		
		cVector3f vFirePos = mBaseObj.GetEntity().GetPosition();
		cVector3f vAgentPos;
		float fDist = -1;
		
		cLuxEntityComponentIterator @pIt = cLux_GetCurrentMap().GetEntityComponentIterator(eComponentType_Custom_AIMeatSensor);
		while (pIt.HasNext())
		{
			// Get next component
			iLuxEntityComponent @pComp = pIt.Next();
			iLuxEntity @pEnt = pComp.GetEntity();
			
			// Found an agent
			if(pEnt.GetEntityType() == eLuxEntityType_Agent)
			{
				cLuxAgent @pAgent = cLux_ToAgent(pEnt);
				
				vAgentPos = pAgent.GetCharBody().GetFeetPosition();
				fDist = cMath_Vector3Dist(vFirePos,vAgentPos);
				
				if (fDist > mfRepelDistance+1.0f) continue;
			
				// Is the enemy already attracted by a piece of meat?
				if (pAgent.GetVarString(sMeatAttract) != "") continue;
				
				pEnt.BroadcastMessage(eCustomEntityMessage_WithinFireArea, null, vFirePos,0);
			}
		}
	}

}



//---------------------------------------------------