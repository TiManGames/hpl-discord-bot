#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "helpers/helper_modules_custom.hps"
#include "helpers/helper_player.hps"

//---------------------------------------------------

class cScrFearThreatComponent : iScrUserComponent, iScrUserComponent_Interface, iScrFearThreatComponent_Interface
{

	////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	/////////////////////////////////////////
	// SETUP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//void AfterWorldLoad(){}
	//void SetupAfterLoadingSave() {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		float fBaseFearRate = apVars.GetVarFloat("Threat_BaseFearRate", 0.1f);
		float fBaseFearRateMul = 1.0f;
		if (apInstanceVars !is null) fBaseFearRateMul = apInstanceVars.GetVarFloat("Threat_BaseFearRateMultiplier", 1.0f);
		
		mFearParams.m_idEntity = mBaseObj.GetEntity().GetID();
		mFearParams.mfBaseFearRate = fBaseFearRate * fBaseFearRateMul;
		mFearParams.mfSurpriseFactor = apVars.GetVarFloat("Threat_SurpriseFactor", -1.0f);
		mFearParams.mfLookAtFactor = apVars.GetVarFloat("Threat_LookAtFactor", -1.0f);
		mFearParams.mfActivationDistance = apVars.GetVarFloat("Threat_MinFearDistance", 12.0f);
		mFearParams.mfDeactivationDistance = apVars.GetVarFloat("Threat_MinFearDistance", 12.0f);
		mFearParams.mfActivationDelay = apVars.GetVarFloat("Threat_ActivationDelay", 0.2f);
		mFearParams.mfActivationLightLevel = apVars.GetVarFloat("Threat_ActivationLightLevel", 0.1f);
		mFearParams.msActivationCallback = apInstanceVars !is null ? apInstanceVars.GetVarString("Threat_ActivationCallback", "") : apVars.GetVarString("Threat_ActivationCallback", "");
		mFearParams.msDeactivationCallback = apInstanceVars !is null ? apInstanceVars.GetVarString("Threat_DeactivationCallback", "") : apVars.GetVarString("Threat_DeactivationCallback", "");
		mFearParams.mbLookAtDetectWholeArea = apVars.GetVarBool("LookAtDetectWholeArea", false);
		mFearParams.msActivationTriggers = apVars.GetVarString("AdditionalActivationTriggers", "");		
		mFearParams.mfMaxFearDist = apVars.GetVarFloat("Threat_MaxFearDistance", 2.0f);
		
		mBaseObj.GetEntity().SetAutoSleep(false);
	}
	
	//------------------------------------------------------------
	
	void AfterWorldLoad()
	{
		mbStarted = false;
	}
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//NOTE: DON'T ADD COMMENTED-OUT FUNCTIONS UNLESS NEEDED. MUCH FASTER THAT WAY!
	
	//------------------------------------------------------------

	//void Reset(){}
	
	//------------------------------------------------------------
	
	bool mbStarted = true;
	
	void Update(float afTimeStep)
	{
		if (mbStarted == false)
		{
			mbStarted = true;
			
//			cLux_AddDebugMessage("REGISTER FEAR THREAT COMPONENT " + mBaseObj.GetEntity().GetName());
			iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
			pHandler.RegisterThreat(mFearParams);
			
			mBaseObj.GetEntity().SetAutoSleep(true);
		}
	}
	
	//void PostUpdate(float afTimeStep){}
	//void VariableUpdate(float afDeltaTime){}

	//------------------------------------------------------------
	
	//void OnSetActive(bool abX) {}
	//bool OnUpdateAutoSleep(){ return false;}
	
	//------------------------------------------------------------
	
	//void OnRecieveMessage(int alMessageId, cLuxEntityMessageData@ apData){}
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	//------------------------------------------------------------

	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//void OnRenderSolid(cRendererCallbackFunctions* apFunctions){}
	//float DrawDebug(cGuiSet *apSet,iFontData *apFont,float afStartY){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cFearThreatParams mFearParams;
	
	//------------------------------------------------------------
}