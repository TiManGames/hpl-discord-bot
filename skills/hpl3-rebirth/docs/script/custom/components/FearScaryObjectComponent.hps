#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "helpers/helper_modules_custom.hps"
#include "helpers/helper_player.hps"

//---------------------------------------------------

class cScrFearScaryObjectComponent : iScrUserComponent, iScrUserComponent_Interface, iScrFearScaryObjectComponent_Interface
{

	////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//void Init() {}
	
	/////////////////////////////////////////
	// SETUP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//void AfterWorldLoad(){}
	//void SetupAfterLoadingSave() {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		float fBaseFearRate = apVars.GetVarFloat("ScaryObject_BaseFearRate", 0.1f);
		float fBaseFearRateMul = 1.0f;
		if (apInstanceVars !is null) fBaseFearRateMul = apInstanceVars.GetVarFloat("ScaryObject_BaseFearRateMultiplier", 1.0f);
		
		mFearParams = cFearScaryObjectParams();
		mFearParams.m_idEntity = mBaseObj.GetEntity().GetID();
		mFearParams.mfBaseFearRate = fBaseFearRate * fBaseFearRateMul;
		mFearParams.mfSurpriseFactor = apVars.GetVarFloat("ScaryObject_SurpriseFactor", -1.0f);
		mFearParams.mfLookAtFactor = apVars.GetVarFloat("ScaryObject_LookAtFactor", -1.0f);
		mFearParams.mfActivationDistance = apVars.GetVarFloat("ScaryObject_ActivationDistance", 12.0f);
		mFearParams.mfDeactivationDistance = apVars.GetVarFloat("ScaryObject_DeactivationDistance", 8.0f);
		mFearParams.mfActivationDelay = apVars.GetVarFloat("ScaryObject_ActivationDelay", 0.2f);
		mFearParams.mfActivationLightLevel = apVars.GetVarFloat("ScaryObject_ActivationLightLevel", 0.1f);
		mFearParams.msActivationCallback = apInstanceVars !is null ? apInstanceVars.GetVarString("ScaryObject_ActivationCallback", "") : apVars.GetVarString("ScaryObject_ActivationCallback", "");
		mFearParams.msDeactivationCallback = apInstanceVars !is null ? apInstanceVars.GetVarString("ScaryObject_DeactivationCallback", "") : apVars.GetVarString("ScaryObject_DeactivationCallback", "");
		mFearParams.mbLookAtDetectWholeArea = apVars.GetVarBool("LookAtDetectWholeArea", false);
		mFearParams.msActivationTriggers = apVars.GetVarString("AdditionalActivationTriggers", "");
		
		mFearParams.mfInteractFactor = apVars.GetVarFloat("ScaryObject_InteractFactor", -1.0f);
		
		mBaseObj.GetEntity().SetAutoSleep(false);
	}
	
	//------------------------------------------------------------
	
	void AfterWorldLoad()
	{
		mbStarted = false;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//NOTE: DON'T ADD COMMENTED-OUT FUNCTIONS UNLESS NEEDED. MUCH FASTER THAT WAY!
	
	//------------------------------------------------------------

	//void Reset(){}
	
	//------------------------------------------------------------
	
	bool mbStarted = true;
	
	void Update(float afTimeStep)
	{
		if (mbStarted == false)
		{
			mbStarted = true;
			
//			cLux_AddDebugMessage("REGISTER FEAR SCARY OBJECT COMPONENT " + mBaseObj.GetEntity().GetName());
			iScrFearHandler_Interface @pHandler = cast<iScrFearHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_FearHandler) );
			pHandler.RegisterScaryObject(mFearParams);
			
			mBaseObj.GetEntity().SetAutoSleep(true);
		}
	}
	
	//void PostUpdate(float afTimeStep){}
	//void VariableUpdate(float afDeltaTime){}

	//------------------------------------------------------------
	
	//void OnSetActive(bool abX) {}
	//bool OnUpdateAutoSleep(){ return false;}
	
	//------------------------------------------------------------
	
	//void OnRecieveMessage(int alMessageId, cLuxEntityMessageData@ apData){}
		
	//------------------------------------------------------------

	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//void OnRenderSolid(cRendererCallbackFunctions* apFunctions){}
	//float DrawDebug(cGuiSet *apSet,iFontData *apFont,float afStartY){}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cFearScaryObjectParams mFearParams;
	
	//------------------------------------------------------------
}