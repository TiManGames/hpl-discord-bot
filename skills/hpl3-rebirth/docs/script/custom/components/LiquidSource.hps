#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "custom/player/PlayerTypes_Custom.hps"

//---------------------------------------------------

class cScrLiquidSourceComponent : iScrUserComponent, iScrUserComponent_Interface, iScrLiquidSourceComponent_Interface
{
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	/////////////////////////////////////////
	// SETUP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void OnSetupAfterLoad(cWorld@ apWorld)
	{
		
	}
	
	void OnAfterWorldLoad()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetContents(const tString& in asSubType, int alAmount=-1)
	{
		mlAmount = alAmount;
		msSubType = asSubType;
	}

	//------------------------------------------------------------

	tString GetContentSubType()
	{
		return msSubType;
	}

	//------------------------------------------------------------

	int DispenseLiquid(int alRequestedAmount)
	{
		if (mlAmount<0)
		{
			cLux_AddDebugMessage("[LiquidSource] Taking "+alRequestedAmount+" "+msSubType+" from endless source "+mBaseObj.GetEntity().GetName());
			return alRequestedAmount;
		}

		int lInitial = mlAmount;
		int lReturned = alRequestedAmount;

		mlAmount-=alRequestedAmount;

		if (mlAmount<0)
		{ 
			lReturned = alRequestedAmount+mlAmount;
			mlAmount=0;
		}

		cLux_AddDebugMessage("[LiquidSource] Taking "+lReturned+" "+msSubType+" from "+mBaseObj.GetEntity().GetName()+" and leaving "+mlAmount);
		if ((mlAmount==0)&&(lInitial>0))
		{
			mbTriggerOnDrained = true;
		}

		return lReturned;
	}

	//------------------------------------------------------------

	bool IsEmpty()
	{
		return (mlAmount==0);
	}

	//------------------------------------------------------------

	void SetDrainedCallback(const tString& in asFunction)
	{
		msOnDrained = asFunction;
	}

	//------------------------------------------------------------
	void SetCanDrink(bool abValue)
	{
		mbCanDrink = abValue;
	}

	//------------------------------------------------------------

	bool CanDrink()
	{
		return mbCanDrink&&(mlAmount!=0);
	}

	//------------------------------------------------------------

	void StartDrinking()
	{
		cLux_AddDebugMessage("Start drinking");
		cScript_SetGlobalArgString(0,mBaseObj.GetEntity().GetName());
		cScript_RunGlobalFunc("State_Drinking","","_Global_SetupStateFromSource");

		cLux_GetPlayer().ChangeState(ePlayerState_Custom_Drinking);
		cLux_GetPlayer().GetCharacterBody().StopMovement();
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		if (mbTriggerOnDrained)
		{
			mbTriggerOnDrained = false;

			if (msOnDrained=="")
				return;

			cLuxMap@ pMap = cLux_GetCurrentMap();
			if(pMap.ScriptPrepare("void "+msOnDrained+"(const tString&in)"))
			{
				pMap.SetArgString(0, mBaseObj.GetEntity().GetName());
				pMap.ScriptExecute();
			}
		}
	}
	
	//------------------------------------------------------------

	tString msSubType;
	int mlAmount=-1;
	tString msOnDrained="";
	bool mbTriggerOnDrained=false;
	bool mbCanDrink=true;

	//------------------------------------------------------------
}



//---------------------------------------------------