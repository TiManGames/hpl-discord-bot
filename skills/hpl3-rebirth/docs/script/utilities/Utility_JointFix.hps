//------------------------------------------------------------

// Hack class to try to make sure that physics bodies stay roughly where they should be
// after we had disappearing bodies.

class cUtility_JointFix
{
	cMatrixf m_matLastKnownGoodPos;
	float mfUpdateCount=0;
	float mfMaxAllowedDist=70;
	
	void Init(iPhysicsBody@ apBody)
	{
		m_matLastKnownGoodPos = apBody.GetWorldMatrix();
	}
	
	void Update(cLuxProp@ apProp, iPhysicsBody@ apBody)
	{
		float fNewMaxDist = apProp.GetVarFloat("JointFixMaxDist");
		if (fNewMaxDist>0.0f)
		{
			mfMaxAllowedDist = fNewMaxDist;
		}
			
		cMatrixf matCurrent = apBody.GetWorldMatrix();
		cVector3f vDist = matCurrent.GetTranslation()-m_matLastKnownGoodPos.GetTranslation();
		if (vDist.SqrLength()>mfMaxAllowedDist*mfMaxAllowedDist)
		{
			Error("--- IMPORTANT START ----\n");
			Error("Body "+apBody.GetName()+" jumped more than "+mfMaxAllowedDist+" units ("+vDist.Length()+")- restoring!\n");
			Error("--- IMPORTANT END ----\n");
			apBody.SetWorldMatrix(m_matLastKnownGoodPos);
			apBody.SetAngularVelocity(cVector3f_Zero);
			apBody.SetLinearVelocity(cVector3f_Zero);
			apBody.SetActive(true);
			apBody.Enable();
			return;	
		}
		m_matLastKnownGoodPos = matCurrent;
	}
}

//------------------------------------------------------------