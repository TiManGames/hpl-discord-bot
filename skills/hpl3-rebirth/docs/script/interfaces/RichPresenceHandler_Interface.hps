

//---------------------------------------------------------

class iScrRichPresenceHandlerBase
{
	/////////////////////////////////
	//Basic Init
	iLuxRichPresenceHandler@ mBaseObj;
	void SetupBaseInterface(iLuxRichPresenceHandler @aObj){@mBaseObj = aObj;}
	iLuxRichPresenceHandler@ GetBase(){ return mBaseObj;}
	
	/////////////////////////////////
	//Functions
	void CreateRichPresence(int alID, const tString&in asName)
	{
		mBaseObj.CreateRichPresence(alID, asName);
	}

	void RegisterRichPresences()
	{
		mBaseObj.RegisterRichPresences();
	}

	void SetCurrentRichPresence(int alID)
	{
		mBaseObj.SetCurrentRichPresence(alID);
	}
	
	int GetCurrentRichPresence()
	{
		return mBaseObj.GetCurrentRichPresence();
	}
	
	tString GetRichPresenceName(int alID)
	{
		return mBaseObj.GetRichPresenceName(alID);
	}
	
	tString GetRichPresenceDescription(int alID)
	{
		return mBaseObj.GetRichPresenceDescription(alID);
	}
}

