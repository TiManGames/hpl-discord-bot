#include "interfaces/Area_Interface.hps"
#include "helpers/helper_player.hps"

enum eAmbientLightType
{
	eAmbientLightType_None,
	eAmbientLightType_Indoors,
	eAmbientLightType_Outdoors,
}

class cScrAreaAmbientLight: iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mbPlayerIsInside = false;
		mBaseObj.SetAutoSleep(false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	eAmbientLightType GetType(const tString&in asType)
	{
		if(asType == "None") 		return eAmbientLightType_None;
		if(asType == "Indoors")		return eAmbientLightType_Indoors;
		if(asType == "Outdoors")	return eAmbientLightType_Outdoors;
		
		Error("Ambient Light Type '"+asType+"' in area '"+mBaseObj.GetName()+"' is invalid!");
		return eAmbientLightType_None;
	}
	
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{			
		mType = GetType(apVars.GetVarString("Type","Indoors"));
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		
		
		bool bCollide = cMath_CheckPointInBVIntersection(pCam.GetPosition(), mBaseObj.GetAreaBody().GetBoundingVolume());
		
		if(bCollide && mbPlayerIsInside==false)
		{
			switch(mType)
			{
			case eAmbientLightType_None:
				Player_SetAmbientLight_None(true);
				break;
			case eAmbientLightType_Outdoors:
				Player_SetAmbientLight_Outdoors(true);
				break;
			case eAmbientLightType_Indoors:
				Player_SetAmbientLight_Indoors(true);
				break;
			}
		}
		
		mbPlayerIsInside = bCollide;
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
		
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbPlayerIsInside;
	eAmbientLightType mType;
		
	//------------------------------------------------------------
		
}	