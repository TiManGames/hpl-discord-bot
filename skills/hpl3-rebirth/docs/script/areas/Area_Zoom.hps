#include "interfaces/Area_Interface.hps"
#include "helpers/helper_modules.hps"
#include "player/Player_Types.hps"
//#include "helpers/helper_player.hps"

//------------------------------------------------------------

class cScrAreaZoom: iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		mBaseObj.SetPlayerLookAtCallback(	apVars.GetVarString("PlayerLookAtCallback",""),
											apVars.GetVarBool("PlayerLookAtCallbackAutoRemove",false),
											apVars.GetVarBool("PlayerLookAtCheckCenterOfScreen",true),
											apVars.GetVarBool("PlayerLookAtCheckRayIntersection",true),
											apVars.GetVarFloat("PlayerLookAtMaxDistance",-1),
											apVars.GetVarFloat("PlayerLookAtCallbackDelay",0));

		mBaseObj.SetPlayerInteractCallback(	apVars.GetVarString("PlayerInteractCallback",""),
											apVars.GetVarBool("PlayerInteractCallbackAutoRemove",false) );
											
		msTextCategory = apVars.GetVarString("TextCategory","");
		msTextEntry = apVars.GetVarString("TextEntry","");
		mfZoomDistance = apVars.GetVarFloat("ZoomDistance", 0.0f);
		msGuiFunction = apVars.GetVarString("OnGuiFunction", "");
		msZoomedCallback = apVars.GetVarString("ZoomedInCallback", "");
		mfFOV = cMath_ToRad(apVars.GetVarFloat("VerticalFOV", 70));
		
		if ((msGuiFunction!="") && (msTextEntry!=""))
		{
			cLux_AddDebugMessage("WARNING: Shouldn't have both a text entry and GUI function set on the same zoom area (area:"+mBaseObj.GetName()+")");
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{

	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, 
					const tString&in asData)
	{
		/////////////////////
		// Fade fov		
		cLux_GetPlayer().FadeCameraFOVTo(mfFOV, 1.0f);

		cScript_SetGlobalArgID(0, mBaseObj.GetID());
		cScript_SetGlobalArgString(1, msTextCategory);
		cScript_SetGlobalArgString(2, msTextEntry);
		cScript_SetGlobalArgFloat(3, mfZoomDistance);
		cScript_SetGlobalArgString(4, msGuiFunction);
		cScript_SetGlobalArgString(5, msZoomedCallback);
		
		cScript_RunGlobalFunc("State_Interact_ZoomArea", "", "SetupZoomArea");
	
		cLux_GetPlayer().ChangeState(ePlayerState_ZoomArea);	
		
		return false;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Examine;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimteStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	[nosave] float mfFOV;
	
	tString msTextCategory;
	tString msTextEntry;
	tString msGuiFunction;
	tString msZoomedCallback;
	float mfZoomDistance;
	
	//------------------------------------------------------------
		
}	