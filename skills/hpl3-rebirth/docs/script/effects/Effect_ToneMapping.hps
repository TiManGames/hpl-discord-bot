#include "effect/Effects.hps"

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

class FadeVariable
{
	FadeVariable()
	{
		mfFadeSpeed = 0;
	}

	void StartFade(float afCurrent, float afGoal, float afTime)
	{
		mfGoal = afGoal;
		mfFadeSpeed = cMath_Abs(afCurrent - mfGoal) / cMath_Max(0.000001f, afTime);
	}

	float FadeValue(float afCurrent, float afTimeStep)
	{
		if(IsComplete()) return 0;

		float fDist = mfGoal - afCurrent;

		if(fDist == 0)
		{
			//////////
			// Goal reached, stop updating
			mfFadeSpeed = 0;
			return 0;
		}
		else
		{
			/////////////
			// Fade closer to goal
			float fAdd = cMath_Min(mfFadeSpeed * afTimeStep, cMath_Abs(fDist));
			return cMath_Sign(fDist) * fAdd;
		}
	}

	bool IsComplete()
	{
		return mfFadeSpeed == 0;
	}

	void Stop()
	{
		mfFadeSpeed = 0;
	}

	float mfFadeSpeed;
	float mfGoal;
}

//------------------------------------------------------------

class cScrEffect_ToneMapping : iScrEffect, iScrEffect_Interface, iScrEffect_ToneMapping
{

	//----------------------------------
	
	void Init()
	{
		Reset();
	}

	//----------------------------------
	
	void OnDestroy()
	{
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PULBIC METHODS
	/////////////////////////////////////////
	
	//----------------------------------

	void SetFilmGrainActive(bool abX)
	{
		cLux_GetViewport().GetToneMappingEffect().SetFilmGrainActive(abX);
	}
	
	//----------------------------------
	
	void SetBloomActive(bool abX)
	{
		cLux_GetViewport().GetToneMappingEffect().SetBloomActive(abX);
	}

	//----------------------------------

	void SetSRGB(bool abX)
	{
		cLux_GetViewport().GetToneMappingEffect().SetSRGBGamma(abX);
	}
	
	//----------------------------------

	void SetKey(float afKey)
	{
		cLux_GetCurrentMap().GetWorld().SetToneMappingKey(afKey);
	}

	//----------------------------------

	void FadeWorldGrading(tString asTextureName, float afTime)
	{
		cLux_GetCurrentMap().GetWorld().FadeGradingTexture(asTextureName, afTime);
	}

	//----------------------------------
			
	void SetGradingTexture(int alPrio, tString asTextureName, float afAlpha)
	{
		cLux_GetViewport().GetToneMappingEffect().SetGradingTexture(alPrio, asTextureName, afAlpha);
	}

	void RemoveGradingTexture(tString asTextureName)
	{
		cLux_GetViewport().GetToneMappingEffect().RemoveGradingTexture(asTextureName);
	}

	//----------------------------------

	void FadeExposure(float afExposure, float afTime)
	{
		cLux_GetCurrentMap().GetWorld().FadeToneMappingExposure(afExposure, afTime);
	}

	//----------------------------------

	void FadeWhiteCut(float afWhiteCut, float afTime)
	{
		cLux_GetCurrentMap().GetWorld().FadeToneMappingWhiteCut(afWhiteCut, afTime);
	}

	//----------------------------------

	void FadeBrightPass(float afBrightPass, float afTime)
	{
		float fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, fBloomFalloff;
		cColor vBloomTint;
		cLux_GetViewport().GetToneMappingEffect().GetParams(fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, vBloomTint, fBloomFalloff);

		mFadeBrightPass.StartFade(fBrightPass, afBrightPass, afTime);

		mBaseObj.SetActive(true);
	}

	//----------------------------------

	void FadeBloomWidth(float afBloomWidth, float afTime)
	{
		float fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, fBloomFalloff;
		cColor vBloomTint;
		cLux_GetViewport().GetToneMappingEffect().GetParams(fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, vBloomTint, fBloomFalloff);

		mFadeBloomWidth.StartFade(fBloomWidth, afBloomWidth, afTime);

		mBaseObj.SetActive(true);
	}

	//----------------------------------

	void FadeBloomTint(float afR, float afG, float afB, float afTime)
	{
		float fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, fBloomFalloff;
		cColor vBloomTint;
		cLux_GetViewport().GetToneMappingEffect().GetParams(fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, vBloomTint, fBloomFalloff);

		mFadeBloomTintR.StartFade(vBloomTint.r, afR, afTime);
		mFadeBloomTintG.StartFade(vBloomTint.g, afG, afTime);
		mFadeBloomTintB.StartFade(vBloomTint.b, afB, afTime);

		mBaseObj.SetActive(true);
	}

	//----------------------------------

	void FadeFilmGrainIntensity(float afIntensity, float afTime)
	{	
		float fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, fBloomFalloff;
		cColor vBloomTint;
		cLux_GetViewport().GetToneMappingEffect().GetParams(fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, vBloomTint, fBloomFalloff);

		mFadeIntensity.StartFade(fIntensity, afIntensity, afTime);

		mBaseObj.SetActive(true);
	}

	//----------------------------------

	void FadeBloomFalloff(float afFalloff, float afTime)
	{
		float fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, fBloomFalloff;
		cColor vBloomTint;
		cLux_GetViewport().GetToneMappingEffect().GetParams(fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, vBloomTint, fBloomFalloff);

		mFadeBloomFalloff.StartFade(fBloomFalloff, afFalloff, afTime);

		mBaseObj.SetActive(true);
	}

	//----------------------------------

	float GetExposure()
	{
		return cLux_GetViewport().GetToneMappingEffect().GetExposure();
	}

	//----------------------------------
	
	/////////////////////////////////////////
	// GENERAL CALLBACKS
	/////////////////////////////////////////
	
	
	//----------------------------------
	
	void OnStart()
	{
	}

	//----------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
		mBaseObj.SetActive(true);
	}
	
	//----------------------------------
	
	void OnMapLeave(cLuxMap @apMap)
	{
		Reset();
		cLux_GetViewport().GetToneMappingEffect().SetSRGBGamma(false);
	}

	//----------------------------------
	
	void Reset()
	{
		mFadeBrightPass.Stop();
		mFadeBloomWidth.Stop();
		mFadeIntensity.Stop();

		mFadeBloomTintR.Stop();
		mFadeBloomTintG.Stop();
		mFadeBloomTintB.Stop();

		mFadeBloomFalloff.Stop();
	}

	//----------------------------------
	
	
	void Update(float afTimeStep)
	{
		//////////////
		// Get all the parameters
		float fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, fBloomFalloff;
		cColor vBloomTint;
		cLux_GetViewport().GetToneMappingEffect().GetParams(fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, vBloomTint, fBloomFalloff);

		//cLux_AddDebugMessage("bright pass: " + fBrightPass);
		////////////
		// Update the values
		fBrightPass += mFadeBrightPass.FadeValue(fBrightPass, afTimeStep);
		fBloomWidth += mFadeBloomWidth.FadeValue(fBloomWidth, afTimeStep);
		fIntensity += mFadeIntensity.FadeValue(fIntensity, afTimeStep);
		fBloomFalloff += mFadeBloomFalloff.FadeValue(fBloomFalloff, afTimeStep);

		vBloomTint.r += mFadeBloomTintR.FadeValue(vBloomTint.r, afTimeStep);
		vBloomTint.g += mFadeBloomTintG.FadeValue(vBloomTint.g, afTimeStep);
		vBloomTint.b += mFadeBloomTintB.FadeValue(vBloomTint.b, afTimeStep);

		//////////////
		// Set the update values
		cLux_GetViewport().GetToneMappingEffect().SetParams(fKey, fGammaCorrection, fIntensity, fBrightPass, fBloomWidth, vBloomTint, fBloomFalloff);

		////////////
		// Check if any fade is still active
		bool bAllComplete = mFadeBrightPass.IsComplete() &&
							mFadeBloomWidth.IsComplete() &&
							mFadeIntensity.IsComplete() &&
							mFadeBloomFalloff.IsComplete() &&
							mFadeBloomTintR.IsComplete() &&
							mFadeBloomTintG.IsComplete() &&
							mFadeBloomTintB.IsComplete();

		mBaseObj.SetActive(bAllComplete == false);
	}
	
	//----------------------------------
	
	void OnDraw(float afFrameTime)
	{
		
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//----------------------------------

	FadeVariable mFadeBrightPass;
	FadeVariable mFadeBloomWidth;
	FadeVariable mFadeIntensity;
	FadeVariable mFadeBloomFalloff;

	FadeVariable mFadeBloomTintR;
	FadeVariable mFadeBloomTintG;
	FadeVariable mFadeBloomTintB;

	//----------------------------------
}