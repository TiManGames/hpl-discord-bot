#include "effect/Effects.hps"

/////////////////////////////////////////
// SETTINGS - Lucidity Meter
/////////////////////////////////////////

//------------------------------------------------------------

class cLuxEffect_LucidityMeterInstance
{
	float mfAmount;
	float mfMaxAmount;
	float mfTime;
	float mfFadeInTime;
	float mfMaxFadeInTime;
	float mfFadeOutTime;
	float mfMaxFadeOutTime;
	bool mbNeverFadeOut;
	eLucidityMeterEffectType mType;
	int mlID;
}

//------------------------------------------------------------

class cScrEffect_LucidityMeter : iScrEffect, iScrEffect_Interface, iScrEffect_LucidityMeter
{

	//----------------------------------
	
	void Init()
	{
		mfDirectAmount = 0;
	}
	
	//----------------------------------
	
	void OnDestroy()
	{
		/*
		if(mpEffect is null) return;
		
		cLux_GetViewport().GetPostEffectComposite().RemovePostEffect(mpEffect);
		cGraphics_DestroyPostEffect(mpEffect);
		@mpEffect = null;
		*/
	}
	
	//---------------------------------

	void CreatePostEffect()
	{
		if(mbEffectLoaded == false)
		{
			//////////////////
			// Create the post effect if null
			/*
			@mpEffect = cast<cPostEffect_DarkMeter@>(cLux_GetViewport().GetPostEffectComposite().GetPostEffectFromType("DarkMeter"));

			if(mpEffect is null)
			{
				@mpEffect = cGraphics_CreatePostEffect_DarkMeter();
				cLux_GetViewport().GetPostEffectComposite().AddPostEffect(mpEffect, 100);
			}
			*/
			mbEffectLoaded = true;
		}
	}

	//----------------------------------
	
	void LoadUserConfig()
	{
	}

	//----------------------------------
	
	/////////////////////////////////////////
	// PUBLIC METHODS
	/////////////////////////////////////////
	
	//---------------------------------
	
	void SetDirectAmount(float afAmount, eLucidityMeterEffectType aType)
	{
		mfDirectAmount = afAmount;
		mDirectType = aType;
		mBaseObj.SetActive(true);
	}
	
	//----------------------------------
	
	int Start(float afAmount, float afTime, float afFadeInTime, float afFadeOutTime, eLucidityMeterEffectType aType, float afVolume)
	{			
		cLuxEffect_LucidityMeterInstance instance;
		instance.mfAmount = 0;
		instance.mfMaxAmount = afAmount;
		instance.mfTime = afTime<0 ? 1.0f: afTime;
		instance.mbNeverFadeOut = afTime<0;
		instance.mfFadeInTime = afFadeInTime;
		instance.mfFadeOutTime = cMath_Max(afFadeOutTime, 0.001f);
		instance.mfMaxFadeInTime = instance.mfFadeInTime;
		instance.mfMaxFadeOutTime = instance.mfFadeOutTime;
		instance.mType = aType;
		
		instance.mlID = mlIdCounter++;

		mvInstances.push_back(instance);
		
		mfAudio_Volume=afVolume;
		
		mBaseObj.SetActive(true);
		
		return instance.mlID;
	}
	
	//----------------------------------

	void FadeOut(int alID, float afFadeOutTime)
	{
		for(uint i = 0; i < mvInstances.size(); ++i)
		{
			if(alID==-1 || mvInstances[i].mlID  == alID)
			{
				mvInstances[i].mfTime = 0;
				mvInstances[i].mfFadeInTime = 0;
				mvInstances[i].mfFadeOutTime = afFadeOutTime;
				mvInstances[i].mfMaxFadeOutTime = afFadeOutTime;
				mvInstances[i].mbNeverFadeOut = false;
			}
		}
	}
	
	//----------------------------------
	
	void SetMaxAmount(int alID, float afMaxAmount)
	{
		for(uint i = 0; i < mvInstances.size(); ++i)
		{
			if(mvInstances[i].mlID  == alID)
			{
				mvInstances[i].mfMaxAmount = afMaxAmount;
				
				break; 
			}
		}
	}
	
	//----------------------------------
	
	float GetAmount()
	{
		return mfEffect_Amount;
	}
		
	//----------------------------------
	
	/////////////////////////////////////////
	// GENERAL CALLBACKS
	/////////////////////////////////////////
	
	
	//----------------------------------
	
	void OnStart()
	{
	}

	//----------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}
	
	//----------------------------------
	
	void OnMapLeave(cLuxMap @apMap)
	{
		Reset();
	}

	//----------------------------------
	
	void Reset()
	{
		mfDirectAmount =0;
		mDirectType = eLucidityMeterEffectType_RealWorldDark;
		
		mfEffect_Amount=0;
		mfEffect_Time = 0.0f;
		mEffect_Type = eLucidityMeterEffectType_RealWorldDark;
		
		mvInstances.resize(0);
		/*
		if(mbEffectLoaded)
		{
			mpEffect.SetParams(0.0f,0,0);
		}	
		*/
		mfPulseTime = -1.0f;
		mfPulseLength = 1.0f;
	}
	
	//----------------------------------
	
	void Update(float afTimeStep)
	{
		//////////////////////////////
		// Make sure effect is created
		CreatePostEffect();
		
		//////////////////////////////
		// Pulse
		if (mfPulseLength>0.0f)
		{
			mfPulseTime-=afTimeStep;
			if (mfPulseTime<0.0f)
			{
				//end pulse
				mfPulseLength=-cMath_RandRectf(0.5f,1.0f);
				mfPulseTime = -mfPulseLength;
			}
			mfPulseLevel=cMath_Clamp(1.0f-mfPulseTime/mfPulseLength,0.0f,1.0f);
		}
		else if (mfPulseLength<0.0f)
		{
			mfPulseTime-=afTimeStep;
			if (mfPulseTime<0.0f)
			{
				// end pause
				mfPulseLength=cMath_RandRectf(0.25f,1.0f);
				mfPulseTime = mfPulseLength;
			}
			mfPulseLevel=0.0f;
		}
		
		//mfPulseLevel+=afDeltaTime*gfEffectChange;
		//mfPulseLevel=cMath_Clamp(mfPulseLevel,0.0f,1.0f);
		
		//////////////////////////////
		// Update Instances
		{
			for(uint i=0;i<mvInstances.size(); ++i)
			{
				cLuxEffect_LucidityMeterInstance @instance = @mvInstances[i];
				
				///////////////////////////////////////
				// Fade in
				if(instance.mfFadeInTime >0)
				{
					instance.mfFadeInTime -= afTimeStep; 
					if(instance.mfFadeInTime<0) instance.mfFadeInTime=0;
					
					float fT = instance.mfFadeInTime / instance.mfMaxFadeInTime;
					instance.mfAmount = (1-fT) * instance.mfMaxAmount;
				}
				///////////////////////////////////////
				// Mid point
				else if(instance.mfTime >0 || instance.mbNeverFadeOut)
				{
					if(instance.mbNeverFadeOut==false)
					{
						instance.mfTime -= afTimeStep; 
						if(instance.mfTime<0)instance.mfTime=0;
					}
					instance.mfAmount = instance.mfMaxAmount;
				}
				///////////////////////////////////////
				// Fade out
				else if(instance.mbNeverFadeOut==false)
				{
					instance.mfFadeOutTime -= afTimeStep; 
					if(instance.mfFadeOutTime<0) instance.mfFadeOutTime=0;
					float fT = instance.mfFadeOutTime / instance.mfMaxFadeOutTime;
					instance.mfAmount =  fT * instance.mfMaxAmount;
				}
				
				///////////////////////////////////////
				// Check if over.
				if(instance.mfTime <= 0 && instance.mfFadeOutTime <= 0 && instance.mfFadeInTime <= 0)
				{
					mvInstances.removeAt(i);
					--i;
				}
			}
		}
				
		//////////////////////////////
		// Set up data
		{
			float fAmount = 0;
			eLucidityMeterEffectType type = eLucidityMeterEffectType_RealWorldDark;
			
			/////////////////////////
			// Get the largest instances
			for(int i=0; i<mvInstances.size(); ++i)
			{
				if (mvInstances[i].mfAmount>fAmount)
				{
					fAmount = mvInstances[i].mfAmount;
					type = mvInstances[i].mType;
				}
			}
			
			/////////////////////////
			// Add direct Amount
			mfEffect_Amount = fAmount;
			mEffect_Type = type;
			if (mfDirectAmount>mfEffect_Amount)
			{
				mfEffect_Amount = mfDirectAmount;
				mEffect_Type = mDirectType;
			}
			float fPulse = cMath_Sin(cMath_ToRad(180.0f)*mfPulseLevel);
			mfEffect_Amount = cMath_Clamp(mfEffect_Amount*0.75f+fPulse*0.25f,0.1f,1.0f);
			
			/////////////////////////
			// Set up params
			mfEffect_Time+=afTimeStep;
			mfEffect_Time=cMath_Wrap(mfEffect_Time,0.0f,1000.0f);
			//mpEffect.SetParams(	mfEffect_Amount, mfEffect_Time, mEffect_Type );
			
			/////////////////////////
			// Set if active
			mBaseObj.SetActive( mfDirectAmount>0 || mvInstances.size()>0 );
		}
	}

	void OnDraw(float afTimeStep)
	{
	}

	//----------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//----------------------------------

	//[nosave] cPostEffect_DarkMeter@ mpEffect;

	float mfDirectAmount=0;
	[nosave] bool mbEffectLoaded=false;
	float mfAudio_Volume=1.0f;
	eLucidityMeterEffectType mDirectType=eLucidityMeterEffectType_RealWorldDark;
	
	//----------------------------------
	
	array<cLuxEffect_LucidityMeterInstance> mvInstances;
	int mlIdCounter=0;
	
	//----------------------------------
	
	float mfEffect_Amount=0;
	float mfEffect_Time=0;
	eLucidityMeterEffectType mEffect_Type=eLucidityMeterEffectType_RealWorldDark;
	
	float mfPulseLevel = 0.0f;
	float mfPulseTime = -1.0f;
	float mfPulseLength = 1.0f;
		
	//----------------------------------
}