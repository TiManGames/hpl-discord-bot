#include "effect/Effects.hps"

//------------------------------------------------------------

class cFadeInstance
{
	cFadeInstance()
	{
	}

	cFadeInstance(float afFadeInTime, float afWhiteTime, float afFadeOutTime, float afMaxAlpha=1.0f)
	{
		mlStep = 0;

		mfAlpha =0;
		mfMaxAlpha = afMaxAlpha;

		if(afFadeInTime==0) afFadeInTime = 0.000001f;
		if(afWhiteTime==0) afWhiteTime = 0.000001f;
		if(afFadeOutTime==0) afFadeOutTime = 0.000001f;

		mfFadeInSpeed = 1 / afFadeInTime;
		mfWhiteSpeed = 1 / afWhiteTime;
		mfFadeOutSpeed = 1 / afFadeOutTime;
	}

	bool Update(float afTimeStep)
	{		
		if(mlStep ==0)
		{
			mfAlpha += mfFadeInSpeed * afTimeStep;
			if(mfAlpha >= 1.0f)
			{
				mfAlpha = 1.0f;
				mlStep=1;
				mfCount = 1;
			}
		}
		else if(mlStep ==1)
		{
			mfCount -= mfWhiteSpeed * afTimeStep;
			if(mfCount <= 0)
			{
				mlStep = 2;
			}
		}
		else if(mlStep ==2)
		{
			mfAlpha -= mfFadeOutSpeed * afTimeStep;
			if (mfAlpha <= 0)
			{
				return false;
			}
		}

		return true;
	}

	float mfAlpha;
	float mfMaxAlpha;

	int mlStep;
	float mfCount;

	float mfFadeInSpeed;
	float mfWhiteSpeed;
	float mfFadeOutSpeed;
}

class cScrEffect_Flash : iScrEffect, iScrEffect_Interface, iScrEffect_Flash
{
	
	//----------------------------------
	
	void Init()
	{
		@mpWhiteGfx = cGui_CreateGfxFilledRect(cColor(1,1), eGuiMaterial_Additive);
	}
	//----------------------------------
	
	void OnDestroy()
	{
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PULBIC METHODS
	/////////////////////////////////////////
	
	//----------------------------------
	
	void Start(float afFadeInTime, float afWhiteTime, float afFadeOutTime, float afMaxAlpha=1.0f)
	{
		mBaseObj.SetActive(true);

		mvFadeInstances.push_back(cFadeInstance(afFadeInTime, afWhiteTime, afFadeOutTime, afMaxAlpha));
	}

	
	//----------------------------------
	
	/////////////////////////////////////////
	// GENERAL CALLBACKS
	/////////////////////////////////////////
	
	//----------------------------------
	
	void OnStart()
	{
	}

	//----------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}
	
	//----------------------------------
	
	void OnMapLeave(cLuxMap @apMap)
	{
	
	}

	//----------------------------------
	
	void Reset()
	{
		mvFadeInstances.resize(0);
	}

	//----------------------------------
	
	
	void Update(float afTimeStep)
	{
		for(int i = 0; i < mvFadeInstances.size(); ++i)
		{
			if(mvFadeInstances[i].Update(afTimeStep) == false)
			{
				mvFadeInstances[i--] = mvFadeInstances[mvFadeInstances.size()-1];
				mvFadeInstances.pop_back();
			}
		}
		
		mBaseObj.SetActive(mvFadeInstances.empty() == false);
	}
	
	//----------------------------------
	
	void OnDraw(float afFrameTime)
	{
		float fAlpha = 0;

		for(int i = 0; i < mvFadeInstances.size(); ++i)
		{
			fAlpha = cMath_Max(fAlpha, mvFadeInstances[i].mfAlpha*mvFadeInstances[i].mfMaxAlpha);
		}

		cVector2f vHudSize = cLux_GetHudVirtualSize();
		cLux_GetGameHudSet().DrawGfx(mpWhiteGfx,cLux_GetHudVirtualStartPos()+cVector3f(vHudSize.x * -0.125f, vHudSize.y * -0.125f,0.7), vHudSize * 1.25f,cColor(fAlpha, 1));
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//----------------------------------
	
	[nosave] cGuiGfxElement@ mpWhiteGfx;

	array<cFadeInstance> mvFadeInstances;
	
	//----------------------------------
}