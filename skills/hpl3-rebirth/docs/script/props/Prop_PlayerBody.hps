	//------------------------------------------------------------
	
	cFootstep_Foot@ GetFoot(tString asSocket)
	{
		uint sid = cString_GetHash(asSocket);
		
		//////////////// 
		// Find foot
		for(int i = 0; i < mvFootstepFeet.size(); ++i)
		{
			if(sid == mvFootstepFeet[i].mlFootstepSocket)
				return mvFootstepFeet[i];
		}
	
		////////////////
		// Create foot
		cFootstep_Foot foot;
		foot.mlId = asSocket[0] == 'L' ? -1 : 1;
		foot.mlFootstepSocket = sid;
		foot.mlLastFootstepTimeStamp = -100;
		mvFootstepFeet.push_back(foot);
		
		return mvFootstepFeet[mvFootstepFeet.size() - 1];
	}
	
	//------------------------------------------------------------	
	
	void OnRecieveMessage(int alMessageId, cLuxEntityMessageData @apData)
	{
		iScrPlayerBodyHandler_Interface @pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		if (pBody !is null)
		{
			pBody.OnReceivePlayerBodyMessage(alMessageId, apData);
		}
		
		if (alMessageId==eLuxEntityMessage_AnimationFootStep)
		{
			tString sSocket = apData.msX;
			cFootstep_Foot@ pFoot = GetFoot(sSocket);
			cNode3D@ pSocket = mBaseObj.GetMeshEntity().GetSocket(sSocket);
			
			// Prevent blended animations from triggering the same sound twice
			int lNewTimeStamp = mBaseObj.GetMap().GetTimeStamp();
			int lDiff = lNewTimeStamp - pFoot.mlLastFootstepTimeStamp;
			
			if (lDiff < 30)
				return;
				
			pFoot.mlLastFootstepTimeStamp = lNewTimeStamp;
			
			// Let MoveState_Normal deal with which sound and decals
			cScript_SetGlobalArgInt(0, eFootSound_Step);
			cScript_SetGlobalArgFloat(1, 0);
			cScript_RunGlobalFunc("MoveState_Normal","","_Global_FootSound");
			
			cScript_SetGlobalArgInt(0, pFoot.mlId);
			cScript_SetGlobalArgMatrix(1, pSocket.GetWorldMatrix());
			cScript_RunGlobalFunc("MoveState_Normal","","_Global_FootDecal");
		}
	}
	
	//------------------------------------------------------------
	
	void OnAfterAnimationUpdate(cMeshEntity@ apFunctions, float afTimeStep)
	{
		for (uint i = 0; i < mvSocketAttachments.length(); i++)
		{
			tID idProp = mvSocketAttachments[i].m_idEntity;
			iLuxEntity@ pAttachProp = cLux_ID_Entity(idProp);
			
			if (idProp == tID_Invalid)
				continue;			
			if (pAttachProp is null)
				continue;
			
			pAttachProp.UpdateEntityAttachment();
		
			if (mvSocketAttachments[i].mbUseParentBoneRotation)
			{
				cNode3D@ pSocket = mBaseObj.GetMeshEntity().GetSocket(mvSocketAttachments[i].msSocket);
				cNode3D@ pParent = pSocket.GetParent();
						
				cMatrixf mtxParentRot = pParent.GetWorldMatrix().GetRotation();
				// Parent bone has a default scale of 0.01f, need to normalize it
				mtxParentRot = cMath_MatrixMul(cMath_MatrixScale(100.f), mtxParentRot);
						
				cMatrixf mtxNew = pAttachProp.GetMatrix();
				mtxNew.SetRotation(mtxParentRot);
						
				pAttachProp.SetMatrix(mtxNew);
			}
		}
	}
		
