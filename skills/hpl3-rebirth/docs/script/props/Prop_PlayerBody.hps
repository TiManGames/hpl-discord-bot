	//------------------------------------------------------------
	
	void _Global_SetAttachmentPropsActive()
	{
		SetAttachmentPropsActive(cScript_GetGlobalArgBool(0));
	}
	
	//------------------------------------------------------------
	
	void SetAttachmentPropsActive(bool abX)
	{
		for (int i = mvSocketAttachments.length()-1; i >= 0; i--)
		{
			tID idProp = mvSocketAttachments[i].m_idEntity;
			if(idProp!=tID_Invalid)
			{
				iLuxEntity@ pAttachProp = cLux_ID_Entity(idProp);
				if (pAttachProp !is null)
				{
					pAttachProp.SetActive(abX);
					
					// Last minute fix to make sure ring is only visible when it should be
					if (abX && pAttachProp.GetName() == "SalimsRing_Accessory")
						pAttachProp.GetMeshEntity().SetVisible(cScript_GetGlobalVarBool("SalimsRingVisible"));
				}
			}
			//mvSocketAttachments.removeAt(i);
		}
	}
	
