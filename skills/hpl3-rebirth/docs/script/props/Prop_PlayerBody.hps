	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
/*		@mpEdgeGlow = cLux_CreateEntityComponent_EdgeGlow(mBaseObj);
		mpEdgeGlow.SetColor(cColor(0.5,0.5,1));
		mpEdgeGlow.SetLightLimit(0.1f);
		mpEdgeGlow.SetAlpha(0.1f);
		mpEdgeGlow.SetEdgeThickness(0.25f);*/
		mvAnimations.resize(ePlayerBodyAnimation_LastEnum);
		
		mvAnimations[ePlayerBodyAnimation_Idle] = apVars.GetVarString("PlayerBodyAnim_Idle", "");
		LoadDirectionalAnims(apVars.GetVarString("PlayerBodyAnim_Walk_Base", ""), ePlayerBodyAnimation_WalkFwd);
		LoadDirectionalAnims(apVars.GetVarString("PlayerBodyAnim_CrouchWalk_Base", ""), ePlayerBodyAnimation_CrouchWalkFwd);
		LoadDirectionalAnims(apVars.GetVarString("PlayerBodyAnim_Run_Base", ""), ePlayerBodyAnimation_RunFwd);
		mvAnimations[ePlayerBodyAnimation_TurnRight] = apVars.GetVarString("PlayerBodyAnim_TurnRight", "");
		mvAnimations[ePlayerBodyAnimation_TurnLeft] = apVars.GetVarString("PlayerBodyAnim_TurnLeft", "");
		mvAnimations[ePlayerBodyAnimation_CrouchIdle] = apVars.GetVarString("PlayerBodyAnim_CrouchIdle", "");
		mvAnimations[ePlayerBodyAnimation_CrouchTurnRight] = apVars.GetVarString("PlayerBodyAnim_CrouchTurnRight", "");
		mvAnimations[ePlayerBodyAnimation_CrouchTurnLeft] = apVars.GetVarString("PlayerBodyAnim_CrouchTurnLeft", "");
		mvAnimations[ePlayerBodyAnimation_Crouch] = apVars.GetVarString("PlayerBodyAnim_StandToCrouch", "");
		mvAnimations[ePlayerBodyAnimation_Stand] = apVars.GetVarString("PlayerBodyAnim_CrouchToStand", "");
		mvAnimations[ePlayerBodyAnimation_JumpLaunch] = apVars.GetVarString("PlayerBodyAnim_JumpLaunch", "");
		mvAnimations[ePlayerBodyAnimation_JumpFall] = apVars.GetVarString("PlayerBodyAnim_JumpFall", "");
		mvAnimations[ePlayerBodyAnimation_JumpLand] = apVars.GetVarString("PlayerBodyAnim_JumpLand", "");
		
		cString_GetStringVec(apVars.GetVarString("PlayerBodyAnim_PermafailWakeUpAnims", ""), mvPFWakeUpAnimations, " ");
		cString_GetStringVec(apVars.GetVarString("PlayerBodyAnim_PermafailCrouchWakeUpAnims", ""), mvPFWakeUpCrouchAnimations, " ");
		
		cString_GetStringVec(apVars.GetVarString("PlayerBody_YawBones", ""), mvYawBones, " ");
		cString_GetStringVec(apVars.GetVarString("PlayerBody_PitchBones", ""), mvPitchBones, " ");
		cString_GetStringVec(apVars.GetVarString("PlayerBody_ShakeBones", ""), mvShakeBones, " ");
		
		array<tString> vYawBoneWeights;
		cString_GetStringVec(apVars.GetVarString("PlayerBody_YawBoneWeights", ""), vYawBoneWeights, " ");
		for (int i = 0; i < vYawBoneWeights.length(); i++)
		{
			mvYawBoneWeights.push_back(cString_ToFloat(vYawBoneWeights[i], 0));
		}
		
		GetBoneAxes(apVars.GetVarString("PlayerBody_YawBoneAxes", "0 1 0"), mvYawBones.length(), mvYawBoneAxes);
		
		array<tString> vPitchBoneWeights;
		cString_GetStringVec(apVars.GetVarString("PlayerBody_PitchBoneWeights", ""), vPitchBoneWeights, " ");
		for (int i = 0; i < vPitchBoneWeights.length(); i++)
		{
			mvPitchBoneWeights.push_back(cString_ToFloat(vPitchBoneWeights[i], 0));
		}
		
		GetBoneAxes(apVars.GetVarString("PlayerBody_PitchBoneAxes", "-1 0 0"), mvPitchBones.length(), mvPitchBoneAxes);
		
		array<tString> vShakeBoneWeights;
		cString_GetStringVec(apVars.GetVarString("PlayerBody_ShakeBoneWeights", ""), vShakeBoneWeights, " ");
		for (int i = 0; i < vShakeBoneWeights.length(); i++)
		{
			mvShakeBoneWeights.push_back(cString_ToFloat(vShakeBoneWeights[i], 0));
		}
		
		GetBoneAxes(apVars.GetVarString("PlayerBody_ShakeBoneAxes", "-1 0 0"), mvShakeBones.length(), mvShakeBoneAxes);
		
		msLeftArmPitchBone = apVars.GetVarString("PlayerBody_LeftArmControlBone", "j_L_Clavicle");
		mvLeftArmPitchAxis = apVars.GetVarVector3f("PlayerBody_LeftArmPitchAxis", cVector3f_Left);
		mvLeftArmYawAxis = apVars.GetVarVector3f("PlayerBody_LeftArmYawAxis", cVector3f_Up);
		msRightArmPitchBone = apVars.GetVarString("PlayerBody_RightArmControlBone", "j_R_Clavicle");
		mvRightArmPitchAxis = apVars.GetVarVector3f("PlayerBody_RightArmPitchAxis", cVector3f_Right);
		mvRightArmYawAxis = apVars.GetVarVector3f("PlayerBody_RightArmYawAxis", cVector3f_Up);
		
		mfYawSoftLimit = apVars.GetVarFloat("PlayerBody_YawSoftLimit", 70.0f);
		mfYawHardLimit = apVars.GetVarFloat("PlayerBody_YawHardLimit", 95.0f);
		mfCrouchYawSoftLimit = apVars.GetVarFloat("PlayerBody_YawSoftLimit_Crouch", 25.0f);
		mfCrouchYawHardLimit = apVars.GetVarFloat("PlayerBody_YawHardLimit_Crouch", 45.0f);
		
		mfMinRunSpeed = apVars.GetVarFloat("PlayerBody_MinRunSpeed", 3.0f);

		SetupComponents(apWorld, apVars, apInstanceVars);
		
		mBaseObj.GetMeshEntity().SetUpdateBonesWhenCulled(true);
	}
	
	void LoadDirectionalAnims(const tString &in asBase, ePlayerBodyAnimation aStart)
	{
		ePlayerBodyAnimation iterator = aStart;
		mvAnimations[iterator++] = asBase+"_fwd";
		mvAnimations[iterator++] = asBase+"_fwd_right";
		mvAnimations[iterator++] = asBase+"_right";
		mvAnimations[iterator++] = asBase+"_back_right";
		mvAnimations[iterator++] = asBase+"_back";
		mvAnimations[iterator++] = asBase+"_back_left";
		mvAnimations[iterator++] = asBase+"_left";
		mvAnimations[iterator++] = asBase+"_fwd_left";
	}

	void SetupComponents(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		///////////////
		// Foot placement
		@mpFootPlacement = cLux_CreateEntityComponent_FootPlacement(mBaseObj);
		mpFootPlacement.LoadFromVariables(apVars);

		// Activate IK here
		mpFootPlacement.SetActive(true);
		
		///////////////
		// Hand placement
		@mpHandPlacement = cLux_CreateEntityComponent_HandPlacement(mBaseObj);
		mpHandPlacement.LoadFromVariables(apVars);
		mpHandPlacement.SetActive(false);
	}
	
	void GetBoneAxes(const tString &in asVarString, int alBoneCount, array<cVector3f> &out avArray)
	{
		array<float> vBoneAxes;
		cString_GetFloatVec(asVarString, vBoneAxes, " ");
		cVector3f vAxis;
		for (int i = 2; i < vBoneAxes.length(); i+=3)
		{
			vAxis.x = vBoneAxes[i-2];
			vAxis.y = vBoneAxes[i-1];
			vAxis.z = vBoneAxes[i];
			avArray.push_back(vAxis);
		}
		
		// Fill out array with the last entry, allowing one to just enter a single value if multiple bones share the same axis
		while (avArray.length() < alBoneCount)
			avArray.push_back(vAxis);
	}
	
