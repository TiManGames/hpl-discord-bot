	//------------------------------------------------------------
	
	void _Global_SetupPlayerBody()
	{
		iScrPlayerBodyHandler_Interface @pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		for (int i = 0; i < mvAnimations.length(); i++)
		{
			ePlayerBodyAnimation animationType = ePlayerBodyAnimation(i);
			pBody.SetAnimation(animationType, mvAnimations[animationType]);
		}
		pBody.SetPermafailWakeUpAnims(mvPFWakeUpAnimations, mvPFWakeUpCrouchAnimations);
		
		pBody.SetYawBones(mvYawBones, mvYawBoneWeights, mvYawBoneAxes);
		pBody.SetPitchBones(mvPitchBones, mvPitchBoneWeights, mvPitchBoneAxes);
		pBody.SetShakeBones(mvShakeBones, mvShakeBoneWeights, mvShakeBoneAxes);
		pBody.SetArmControlBones(msLeftArmPitchBone, mvLeftArmPitchAxis, mvLeftArmYawAxis, msRightArmPitchBone, mvRightArmPitchAxis, mvRightArmYawAxis);
		pBody.SetYawLimit(mfYawSoftLimit, mfYawHardLimit, mfCrouchYawSoftLimit, mfCrouchYawHardLimit);
		pBody.SetMinRunSpeed(mfMinRunSpeed);
	}
	
	//------------------------------------------------------------
	
	void _Global_AttachProp()
	{
		tString sProp = cScript_GetGlobalArgString(0);
		tString sSocket = cScript_GetGlobalArgString(1);
		bool bUseParentBoneRotation = cScript_GetGlobalArgBool(2);
		bool bReplacePrevProp = cScript_GetGlobalArgBool(3);
		
		if(sProp == "") return;
		
		iLuxEntity @pProp = cLux_GetCurrentMap().GetEntityByName(sProp);
		if(pProp is null)
		{
			Error("Could not find entity '"+sProp+"' to be attached to player hands");
			return;
		}
		
		iLuxEntity @pPrevProp = null;
		
		if (bReplacePrevProp)
		{
			for (uint i = 0; i < mvSocketAttachments.length(); i++)
			{
				if (mvSocketAttachments[i].msSocket == sSocket) 
				{
					@pPrevProp = cLux_ID_Entity(mvSocketAttachments[i].m_idEntity);
					if(pPrevProp !is pProp) mvSocketAttachments.removeAt(i);
					break;
				}
			}
		}
		
		if(pPrevProp !is pProp)
		{
			if(pPrevProp !is null)
			{
				pPrevProp.RemoveEntityAttachment();
				pPrevProp.SetActive(false);
			} 
			
			if(pProp.GetMainBody() !is null)
			{
				pProp.GetMainBody().SetCollideCharacter(false);
				pProp.GetMainBody().SetCollide(false);
			}
			
			pProp.AttachToSocket(mBaseObj, sSocket, true, true, true);
			pProp.SetActive(true);
			
			cPlayerBodySocketAttachment attachment;
			attachment.m_idEntity  = pProp.GetID();
			attachment.msSocket = sSocket;
			attachment.mbUseParentBoneRotation = bUseParentBoneRotation;
			mvSocketAttachments.push_back(attachment);
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_DetachProp()
	{
		tString sProp = cScript_GetGlobalArgString(0);
		
		iLuxEntity @pTargetProp = null;
		for (uint i = 0; i < mvSocketAttachments.length(); i++)
		{
			if (mvSocketAttachments[i].m_idEntity == tID_Invalid) 
				continue;
				
			iLuxEntity @pAttachProp = cLux_ID_Entity(mvSocketAttachments[i].m_idEntity);
			if (pAttachProp !is null && pAttachProp.GetName()==sProp) 
			{
				@pTargetProp = pAttachProp;
				mvSocketAttachments.removeAt(i);
				break;
			}
		}
			
		if(pTargetProp !is null)
		{
			pTargetProp.SetActive(false);
			pTargetProp.RemoveEntityAttachment();
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_FreeSocket()
	{
		tString sSocket = cScript_GetGlobalArgString(0);
		
		tID idCurrentProp = tID_Invalid;
		for (uint i = 0; i < mvSocketAttachments.length(); i++)
		{
			if (mvSocketAttachments[i].msSocket == sSocket) 
			{
				idCurrentProp = mvSocketAttachments[i].m_idEntity;
				mvSocketAttachments.removeAt(i);
				break;
			}
		}
			
		if(idCurrentProp!=tID_Invalid)
		{
			iLuxEntity @pAttachProp = cLux_ID_Entity(idCurrentProp);
			if(pAttachProp !is null)
			{
				pAttachProp.SetActive(false);
				pAttachProp.RemoveEntityAttachment();	
			}
		}
	}
	
