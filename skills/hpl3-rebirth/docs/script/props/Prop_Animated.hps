#include "interfaces/Prop_Interface.hps"
#include "player/Player_Types.hps"

class cScrPropAnimated : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mfPrevState = 0.f;
		
		mlStuckState = -1;
		mbStuck = false;
		
		mbInteractConnectionMovementActive = false;
		mlInteractConnectionAnimDir = 0;
		msInteractConnectionAnim = "";
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////

	//------------------------------------------------------------
	
	int ToAnimationDirection(const tString &in asDir)
	{
		int lDir = 0;
		
		if (asDir == "Forward")		lDir = 1;
		if (asDir == "Backward") 	lDir = -1;
		if (asDir == "Both")		lDir = 0;
		
		return lDir;
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		msInteractConnectionAnim = apVars.GetVarString("Animation", "");
		mlInteractConnectionAnimDir = ToAnimationDirection(apVars.GetVarString("AnimationDirection", "Both"));
		mlStuckState = apVars.GetVarInt("AnimationStuckState", 0);
		
		mBaseObj.StopAllAnimations(0.f);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		UpdateInteractConnection();
	}
	
	//------------------------------------------------------------
	
	void UpdateInteractConnection()
	{
		mbInteractConnectionMovementActive = false;
		
		//////////////////////
		// Broadcast state		
		cAnimationState@ pState = mBaseObj.GetMeshEntity().GetAnimationStateFromName(msInteractConnectionAnim);
		float fState = pState is null ? 0.f : pState.GetRelativeTimePosition();
			
		mBaseObj.ChangeInteractConnectionState(fState);
	}
	
	//------------------------------------------------------------
	
	void ResetProperties() {}
	void BeforeEntityDestruction() {}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity, int alState)
	{
	}
	
	//------------------------------------------------------------
	
	void OnInteractConnectionStateChange(cLuxProp@ apProp, float afT)
	{
		if (mbStuck)
			return;
		
		mbInteractConnectionMovementActive = true;
		
		/////////////////////
		// Update animation
		cAnimationState@ pState = mBaseObj.GetMeshEntity().GetAnimationStateFromName(msInteractConnectionAnim);
		if (pState is null)
			return;
		
		/////////////////////
		// Play anim
		if (pState.IsActive() == false)
		{
			mBaseObj.GetMeshEntity().PlayName(msInteractConnectionAnim, false, true);
			pState.SetSpeed(0.f);
		}
		
		/////////////////////
		// Determine state
		float fNewState = pState.GetRelativeTimePosition();
		
		if (mlInteractConnectionAnimDir == 1)
		{
			if (afT > mfPrevState)
				fNewState = afT;
		}
		else if (mlInteractConnectionAnimDir == -1)
		{
			if (afT < mfPrevState)
				fNewState = afT;
		}
		else if (mlInteractConnectionAnimDir == 0)
		{
			fNewState = afT;
		}
		
		// At stuck state? Set stuck!
		if (cMath_Abs(float(mlStuckState) - fNewState) < 0.01f)
			mbStuck = true;
		
		mfPrevState = fNewState;
		
		/////////////////////
		// Set state
		pState.SetRelativeTimePosition(fNewState);
	}
	
	//------------------------------------------------------------
	
	/*bool OnUpdateAutoSleep()
	{
		return true; 
	}*/
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_None;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_SetStuck()
	{
		mbStuck = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetStuckState()
	{
		mlStuckState = cScript_GetGlobalArgInt(0);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfPrevState;
	
	int mlStuckState;
	bool mbStuck;
	
	bool mbInteractConnectionMovementActive;
	int mlInteractConnectionAnimDir;
	
	[nosave] tString msInteractConnectionAnim;
		
	//------------------------------------------------------------		
}	