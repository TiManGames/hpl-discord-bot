	//------------------------------------------------------------
	
	void SetCurrentDamageLevel(int alX)
	{
		if(mlCurrentMeshEntity == alX) return;
		
		mBaseObj.SetSaveDataIsUpdated(true);

		mlCurrentMeshEntity = alX;
		
		bool bAnyActive = false;
		for(int i=0; i<3; ++i)
		{
			if(mpDamageMeshEntity[i] !is null)
			{
				bool bActive = mlCurrentMeshEntity==i;
				if (bActive) bAnyActive = true;

				mpDamageMeshEntity[i].SetVisible(bActive);
				mpDamageMeshEntity[i].SetActive(bActive);
				SetDamageTint(mpDamageMeshEntity[i]);
			}
		}
		
		if (bAnyActive == false && mpDamageMeshEntity.size() > 0)
		{
			mpDamageMeshEntity[0].SetVisible(true);
			mpDamageMeshEntity[0].SetActive(true);
			SetDamageTint(mpDamageMeshEntity[0]);
		}
	}
	
	void SetDamageTint(cMeshEntity@ apMesh)
	{
		if (mbDamageTint == false) return;
		cColor colorMul = mDefaultColorMul;
		if (mlCurrentMeshEntity == 1) colorMul = cColor(3.0, 0.8, 0.0);
		if (mlCurrentMeshEntity == 2) colorMul = cColor(3.0, 0.0, 0.0);
		apMesh.SetDiffuseColorMul(colorMul);
	}
	
	//------------------------------------------------------------
	
	void AddDoorBodyImpulse(float afAmount)
	{
		mBaseObj.SetSaveDataIsUpdated(true);
		
		cVector3f vHingeToBody = mpDoorBody.GetLocalPosition() - mpHingeJoint.GetPivotPoint();		
		cVector3f vDir = cMath_Vector3Cross(vHingeToBody, mpHingeJoint.GetPinDir());		
		mpDoorBody.AddImpulse(vDir * afAmount);
	}
	
	void _Global_AddDoorBodyImpulse()
	{
		AddDoorBodyImpulse(cScript_GetGlobalArgFloat(0));
	}

	//------------------------------------------------------------
	
	void _Global_GetDoorOpenDir()
	{
		cVector3f vHingeToBody = mpDoorBody.GetLocalPosition() - mpHingeJoint.GetPivotPoint();
		cVector3f vDir = cMath_Vector3Cross(vHingeToBody, mpHingeJoint.GetPinDir());
		vDir.Normalize();
		
		cScript_SetGlobalReturnVector3f(vDir);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetHingeToDoorDir()
	{
		cVector3f vHingeToBody = mpDoorBody.GetLocalPosition() - mpHingeJoint.GetPivotPoint();
		cScript_SetGlobalReturnVector3f(vHingeToBody);
	}
	
