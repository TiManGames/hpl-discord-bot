	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		int lIcon = mbIsHatch ? eCrossHairState_PullDoorHatch : eCrossHairState_PullDoor;
		
		if (apBody is mpLockBody)
			lIcon = eCrossHairState_PullDoorHatch;		
		
		return lIcon;
	}
	
