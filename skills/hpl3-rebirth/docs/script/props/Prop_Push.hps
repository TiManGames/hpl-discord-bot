#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"

class cScrPropPush : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mBaseObj.SetIgnoreDynamicAvoidance(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		mbPushAtPoint = apVars.GetVarBool("PushAtPoint", false);
		mfForceMul = apVars.GetVarFloat("ForceMul", 1);
		mfThrowImpulse = apVars.GetVarFloat("ThrowImpulse", 2);
		mbLookPushActive = apVars.GetVarBool("LookPushActive", true);
		mfMaxPlayerSpeedMul = apVars.GetVarFloat("MaxPlayerSpeedMul", 1.0f);
		mbInteractDisablesStaticPhysics = apInstanceVars.GetVarBool("InteractDisablesStaticPhysics", false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	/*void OnUpdate(float afTimeStep)
	{
		 //mClimbHelper.Update(afTimeStep, mBaseObj.GetMainBody());
	}*/
	
	//------------------------------------------------------------
	
	/*void OnPostUpdate(float afTimeStep)
	{
		//mClimbHelper.PostUpdate(afTimeStep);
	}*/
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
	
	//------------------------------------------------------------
	
	void _Global_SetThrowImpulse()
	{
		mfThrowImpulse = cScript_GetGlobalArgFloat(0);
	}
	
	//------------------------------------------------------------
	
	/*bool OnUpdateAutoSleep()
	{
		return true;
	}*/
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBodyHit, const cVector3f&in avOrigin, const cVector3f&in avHitPos, cLuxDamageProperties@ apDamageProps)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in aContactData)
	{
		//Debug:
		//cLux_AddDebugMessage("Body "+apBody.GetName()+" vs "+apCollideBody.GetName() + "Nrm: " +aContactData.mfMaxContactNormalSpeed + " Tan: "+aContactData.mfMaxContactTangentSpeed, false);
	}
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if(mBaseObj.GetStaticPhysics() && !mbInteractDisablesStaticPhysics) return false;
		if(mBaseObj.GetParentType() == eParentType_StickyStuck) return false;
	
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		
		if (mBaseObj.GetStaticPhysics())
		{
			if (!mbInteractDisablesStaticPhysics) 
				return false;
				
			mBaseObj.SetStaticPhysics(false);
		}
		
		///////////////////////////////
		//Set up the grabstate
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab postion
		cScript_SetGlobalArgBool(3,mbPushAtPoint);
		cScript_SetGlobalArgFloat(4,mfForceMul);
		cScript_SetGlobalArgFloat(5,mfThrowImpulse);
		cScript_SetGlobalArgBool(6, mbLookPushActive);
		cScript_SetGlobalArgFloat(7, mfMaxPlayerSpeedMul);
				
		cScript_RunGlobalFunc("State_Interact_Push", "", "SetupPush");
		
		///////////////////////////////
		//Set up the grabstate
		cLux_GetPlayer().ChangeState(ePlayerState_Push);	
	
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Push;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] bool mbPushAtPoint;
	[nosave] float mfForceMul;
	[nosave] float mfThrowImpulse;
	[nosave] bool mbLookPushActive;
	[nosave] float mfMaxPlayerSpeedMul;
	
	bool mbInteractDisablesStaticPhysics = false;
	
	//------------------------------------------------------------
}	