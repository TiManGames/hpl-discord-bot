	{
		ResetAutoMove();
	}
	
	//------------------------------------------------------------
	
	void ResetAutoMove()
	{
		mbAutoMoving = false;
		mRotatePid.Reset();
	}
	
	//------------------------------------------------------------
	
	void SetMaxJointAngle(float afMaxAngle)
	{
		float fDistToMax = afMaxAngle - mfAngle;

		if(fDistToMax > cMath_Pi){//TOo far away, no need to set limit.
			mpHingeJoint.SetMaxAngle(cMath_PiMul2);
			return; 
		}

		float fJointMax = mfJointAngle + fDistToMax; //Get the value of the joint maximum.
		
		/////////////////////////////
		//The max value is in the 0 - Pi half
		if( (mfJointAngle >=0 && fJointMax <= cMath_Pi) || (mfJointAngle <0 && fJointMax<0) )
		{
			//Make sure limit is not too close to 180 (might make it bug out)
			float fLimit = cMath_ToRad(177);
			if(fJointMax > fLimit) fJointMax = fLimit;
			
			mpHingeJoint.SetMaxAngle(fJointMax);
		}
		else
		{
			mpHingeJoint.SetMaxAngle(cMath_PiMul2);
		}
	}

	//-----------------------------------------------------------------------

	void SetMinJointAngle(float afMinAngle)
	{
		float fDistToMin = mfAngle - afMinAngle;

		if(fDistToMin > cMath_Pi){//TOo far away, no need to set limit.
			mpHingeJoint.SetMinAngle(-cMath_PiMul2);
			return; 
		}

		float fJointMax = mfJointAngle - fDistToMin; //Get the value of the joint minimum
		
		//The max value is in the 0 - Pi half
		if( (mfJointAngle >=0 && fJointMax >= 0) || (mfJointAngle <0 && fJointMax > -cMath_Pi))
		{
			//Make sure limit is not too close to 180 (might make it bug out)
			float fLimit = cMath_ToRad(-177);
			if(fJointMax < fLimit) fJointMax = fLimit;
		
			mpHingeJoint.SetMinAngle(fJointMax);
		}
		else
		{
			mpHingeJoint.SetMinAngle(-cMath_PiMul2);
		}
	}
	
	//-----------------------------------------------------------------------

	float GetMinJointAngle()
	{
		return mpHingeJoint.GetMinAngle();
	}

	//-----------------------------------------------------------------------

	void ChangeState(int alState, bool abEffects, bool abChangeConnectionState = true)
	{
		if(mlCurrentState == alState) return;
		if(mbSkipMiddleState && alState==0) return;

		mlCurrentState = alState;
		
		tString sSound = "";
		
		/////////////////
		//Max
		if(mlCurrentState == 1)
		{
			sSound = msMaxLimitSound;
		}
		/////////////////
		//Min
		else if(mlCurrentState == -1)
		{
			sSound = msMinLimitSound;
		}

		///////////////////////
		//Play sound
		if(abEffects  && sSound != "")
		{
			cSoundEntity @pSound = mBaseObj.GetMap().GetWorld().CreateSoundEntity("WheelSound", sSound, true);
			if(pSound !is null) pSound.SetPosition(mpHingeJoint.GetPivotPoint());
		}

		/////////////////
		//Connection
		if (abChangeConnectionState)
			mBaseObj.ChangeConnectionState(mlCurrentState);
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// WHEEL SPECIFIC UPDATES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void UpdateAngle(float afTimeStep)
	{
		/////////////////////////////////////////
		//Update the Angle value
		float fLast = mfAngle;
		mfJointAngle = mpHingeJoint.GetAngle();
		float fAngleAdd = cMath_GetAngleDistanceRad(mfPrevJointAngle, mfJointAngle);
		
		mfPrevAngle = mfAngle;
		mfAngle += fAngleAdd;

		mfPrevJointAngle = mfJointAngle;
		
		/////////////////////////////////////
		//Check for movement and play stuck sound
		if(mlStuckState!=0 && mBaseObj.IsInteractedWith())
		{
			if(mfStuckSoundTimer <= 0 && cMath_Abs(fAngleAdd) >0.01f * afTimeStep)
			{
				mBaseObj.PlaySound("WheelStuck", msStuckSound, true, true);
				mfStuckSoundTimer = 1.5f;
			}
		}

		/////////////////////////////////////
		//Get value to used to set limit for spinning in one direction.
		float fSpinVal =0;
		bool bSetOneDirBlockAngle = false;
		if(mlSpinDir==1 && mfAngle > mfLastToMax)
		{
			mfLastToMax = mfAngle;
			fSpinVal = mpHingeJoint.GetAngle();
			bSetOneDirBlockAngle = true;
		}
		if(mlSpinDir==-1 && mfAngle < mfLastToMin){
			mfLastToMin = mfAngle;
			fSpinVal = mpHingeJoint.GetAngle();
			bSetOneDirBlockAngle = true;
		}

		//If no limits, skip the rest.
		if(mfMaxLimit ==0 && mfMinLimit==0) return;

		/////////////////////////////////////
		//Set Max and min limit
		if(mlStuckState==0)
		{
			if(mlSpinDir==1)
			{
				SetMaxJointAngle(mfMaxLimit);
				if(bSetOneDirBlockAngle) mpHingeJoint.SetMinAngle(fSpinVal - cMath_ToRad(5.0f));
			}
			else if(mlSpinDir==-1)
			{
				SetMinJointAngle(mfMinLimit);	
				if(bSetOneDirBlockAngle)  mpHingeJoint.SetMaxAngle(fSpinVal + cMath_ToRad(5.0f));
			}
			else
			{
				SetMaxJointAngle(mfMaxLimit);	
				SetMinJointAngle(mfMinLimit);
			}
		}
		
		 if (mbJammed)
		 {
			 SetMinJointAngle(mfJammedMinLimit);
			 SetMaxJointAngle(mfJammedMaxLimit);
		 }
	}

	//-----------------------------------------------------------------------

	void UpdateCheckLimit(float afTimeStep)
	{
		if(mlStuckState !=0) return;
		
		if(mfMaxLimit ==0 && mfMinLimit==0) return;
		
		///////////////////////
		//Max
		if(mfAngle > (mfMaxLimit - mfMaxLimitRange) && mlCurrentState != 1)
		{
			ChangeState(1, true);
			if(mbMaxLimitStuck) SetStuckState(1, false);
		}
		///////////////////////
		//Min
		else if(mfAngle < (mfMinLimit + mfMinLimitRange) && mlCurrentState != -1)
		{
			ChangeState(-1, true);
			if(mbMinLimitStuck) SetStuckState(-1, false);
		}
		///////////////////////
		//Middle
		else if(mfAngle < (mfMaxLimit - mfMaxLimitRange) && mfAngle > (mfMinLimit + mfMinLimitRange) &&
			    mlCurrentState != 0 && mbSkipMiddleState==false)
		{
			ChangeState(0, true);
		}
	}

	//-----------------------------------------------------------------------

	void UpdateAutoRotation(float afTimeStep)
	{
		/////////////////////////////
		//Auto move to angle
		if(mbAutoMoving)
		{			
			if (cMath_Abs(mfAngle-mfAutoMoveGoal) < cMath_ToRad(0.1f))
			{
				ResetAutoMove();
			}
			else
			{				
				float fWantedSpeed = (mfAngle - mfAutoMoveGoal) * mfAutoRotateMul + (mfPrevAngle - mfAngle)*afTimeStep*1.0f;
				
				if (mbLinearAutoMove)
				{
					float fDiff = mfAngle - mfAutoMoveGoal;
					if (cMath_Abs(fDiff) > cMath_ToRad(2.f)) 
						fDiff = cMath_Sign(fDiff);
						
					fWantedSpeed = fDiff * mfAutoRotateMul + (mfPrevAngle - mfAngle) * afTimeStep;
				}
				
				if (mbInteractConnectionMovementActive)
					fWantedSpeed = (mfAngle - mfAutoMoveGoal) / afTimeStep;					
					
				//Log("Angle: %f Wanted: %f Diff: %f Speed: %f\n", cMath_ToDeg(mfAngle), cMath_ToDeg(mfAutoMoveGoal),cMath_Abs(mfAngle-mfAutoMoveGoal), fWantedSpeed);
				
				cVector3f vRotateDir = mpHingeJoint.GetPinDir();
				cVector3f vBodyVel = mpWheelBody.GetAngularVelocity();
				cVector3f vHingeVel = vRotateDir * cMath_Vector3Dot(vRotateDir, vBodyVel);
				cVector3f vWantedVel = vRotateDir * fWantedSpeed;

				cVector3f vTorque = mRotatePid.Output(vWantedVel - vHingeVel, afTimeStep);
				vTorque = cMath_MatrixMul(mpWheelBody.GetInertiaMatrix(), vTorque);
				
				mpWheelBody.AddTorque(vTorque);
			}
		}
		
		//If there is an interaction, do not do any slow down
		if(mBaseObj.IsInteractedWith())
		{
			return;
		}

		/////////////////////////////
		//Slowdown rotation to 0
		if(mlStuckState==0 && mbAutoMoving==false && mbSlowDownRotation)
		{
			cVector3f vBodyVel = mpWheelBody.GetAngularVelocity();
			cVector3f vWantedVel = cVector3f(0);

			cVector3f vTorque = mRotatePid.Output(vWantedVel - vBodyVel, afTimeStep);
			vTorque = cMath_MatrixMul(mpWheelBody.GetInertiaMatrix(), vTorque);

			mpWheelBody.AddTorque(vTorque);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateInteractConnection()
	{			
		/////////////////////////////
		// Update leader
		if (mbInteractConnectionMovementActive == false)
			mBaseObj.UpdateInteractConnectionLeader();
		
		mbInteractConnectionMovementActive = false;
			
		//////////////////////
		// Limit angle based on connected prop (if not one way connection)
		float fRange = cMath_Max(mfMaxLimit - mfMinLimit, 0.0001f);		
		float fLastState = mBaseObj.GetLastInteractConnectionState();
		
		if (mBaseObj.IsInteractedWith() &&
			mbInteractConnectionOneWay == false &&
			fLastState > 0.1f && fLastState < 0.9f)
		{		
			float fAngle = mfMinLimit + fLastState * fRange;			
			SetMinJointAngle(fAngle - cMath_ToRad(5.f));
			SetMaxJointAngle(fAngle + cMath_ToRad(5.f));
		}
		
		//////////////////////
		// Broadcast state
		if (mfAngle != mfPrevAngle)
		{
			float fT = cMath_Clamp((mfAngle - mfMinLimit) / fRange, 0.f, 1.f);
			mBaseObj.ChangeInteractConnectionState(fT);
		}			
	}
	
