	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// TERMINAL SPECIFIC ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if (mBaseObj.HasActiveGui()==false || mBaseObj.IsGuiActive()==false || mbAllowInteraction==false)
			return false;
			
		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
		if(pCharBody.IsOnGround() == false) return false;
					
		///////////////////////////////////
		// Get screen position and normal
		cMatrixf mtxToWorld = GetBase().GetMatrix();		
		cVector3f vPosition = cMath_MatrixMul(mtxToWorld, mvScreenPos);
		cVector3f vNormal = cMath_MatrixMul(mtxToWorld.GetRotation(), cMath_Vector3Normalize(mvScreenNormal));
				
		////////////////
		// The player must face and see the screen to activate it
		cVector3f vScreenToCam = cMath_Vector3Normalize(cLux_GetPlayer().GetCamera().GetPosition() - vPosition);
		float fDot = cMath_Vector3Dot(vNormal, vScreenToCam);
		if(fDot < 0) return false;
		
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{				
		///////////////////////////////////
		// Get screen position and normal
		cMatrixf mtxToWorld = mBaseObj.GetMatrix();		
		cVector3f vPosition = cMath_MatrixMul(mtxToWorld, mvScreenPos);
		cVector3f vNormal = cMath_MatrixMul(mtxToWorld.GetRotation(), cMath_Vector3Normalize(mvScreenNormal));
				
		////////////////
		// The player must face and see the screen to activate it
		cVector3f vScreenToCam = cMath_Vector3Normalize(cLux_GetPlayer().GetCamera().GetPosition() - vPosition);
		float fDot = cMath_Vector3Dot(vNormal, vScreenToCam);
		if(fDot < 0) return false;
		
		///////////////////////////////
		//Set up the interact state
		if(mBaseObj.SetGuiIsFocused(true, mbShowMouse))
		{
			////////////////////////////////////
			// Callback
			if(msEnterCallback != "")
			{
				cLuxMap @pMap = mBaseObj.GetMap();
				if(pMap.ScriptPrepare("void " + msEnterCallback + "(const tString &in asEntityName)" ) )
				{
					tString sName = mBaseObj.GetName();
					pMap.SetArgString(0, sName);
					pMap.ScriptExecute();
				}
			}

			/////////////////////
			// Fade fov		
			cLux_GetPlayer().FadeCameraFOVTo(mfFOV, 4.0f);

			////////////////////////////////////
			// Allow interction again
			mbAllowInteraction = true;
			mBaseObj.SetGuiSetUseInput(mbAllowInteraction);
					
			////////////////////////////////////
			// Enter terminal state
			
			cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
			cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
			cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab position
			cScript_SetGlobalArgVector3f(3, vNormal);//Screen normal
			cScript_SetGlobalArgVector3f(4, vPosition);//Screen world position
			cScript_SetGlobalArgFloat(5, mfCameraDistance);//Target camera distance from screen
			cScript_SetGlobalArgString(6, msLeaveCallback);//Called when the interaction is over.
			cScript_SetGlobalArgString(7, msPlayerPosEntity);//Entity the player should be placed at
			
			cScript_RunGlobalFunc("State_Interact_Terminal", "", "SetupTerminal");
		
			cLux_GetPlayer().ChangeState(ePlayerState_Terminal);	
			
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Terminal;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
