	void _Global_SetAllowInteraction()
	{
		mbAllowInteraction = cScript_GetGlobalArgBool(0);
		mBaseObj.SetGuiSetUseInput(mbAllowInteraction);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetOnGuiFunction()
	{
		tString sCallback = cScript_GetGlobalArgString(0);
		mBaseObj.SetOnGuiFunction(sCallback);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetEnterCallback()
	{
		msEnterCallback = cScript_GetGlobalArgString(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetLeaveCallback()
	{
		msLeaveCallback = cScript_GetGlobalArgString(0);
	}
	
