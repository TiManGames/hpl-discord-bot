#include "interfaces/Prop_Interface.hps"
#include "player/Player_Types.hps"
#include "helper_audio.hps"
#include "helper_effects.hps"
#include "helpers/helper_modules.hps"
#include "helpers/helper_menu.hps"

class cScrPropLevelDoor : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mfLockedCount = 0;
		mbHasBeenInteractedWith = false;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		///////////////////////////
		// Type vars
		msEnterSound = apVars.GetVarString("EnterSound", "");
		msExitSound = apVars.GetVarString("ExitSound", "");
        msOpenAnim = apVars.GetVarString("OpenAnim","");
		
		///////////////////////////
		// Instance vars
		msMapFile = apInstanceVars.GetVarString("MapFile","");
		msStartPos = apInstanceVars.GetVarString("StartPos","");

		mbLocked = apInstanceVars.GetVarBool("Locked",false);
		msLockedSound = apInstanceVars.GetVarString("LockedSound","");
		msLockedTextCat = apInstanceVars.GetVarString("LockedTextCat","");
		msLockedTextEntry = apInstanceVars.GetVarString("LockedTextEntry","");
		mbCheckPlayGo = apInstanceVars.GetVarBool("CheckPlayGo",false); 
        
        tString sOpenAnimOverride = apInstanceVars.GetVarString("OpenAnim","");
        if (sOpenAnimOverride!="")
            msOpenAnim = sOpenAnimOverride;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		if(mfLockedCount >0)
		{
			mfLockedCount -= afTimeStep;
		}
		else
		{
			mBaseObj.SetAutoSleep(true);
		}
	}
	
	//------------------------------------------------------------
	
	/*void OnPostUpdate(float afTimeStep)
	{
	
	}*/
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBodyHit, const cVector3f&in avOrigin, const cVector3f&in avHitPos, cLuxDamageProperties@ apDamageProps)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
	
	//------------------------------------------------------------
	
	/*bool OnUpdateAutoSleep()
	{
		return true;
	}*/
	
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in apContactData)
	{
	
	}	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{	
		mbHasBeenInteractedWith = true;
		
		if(mbLocked)
		{
			//Wait until last locked message until showing a new.
			if(mfLockedCount <=0)
			{
				Sound_PlayGui(msLockedSound, 1.0f);
				mfLockedCount = 1.f;

				mBaseObj.SetAutoSleep(false);
			}
		}
		else
		{
            cLux_GetPlayer().SetActive(false);
            Sound_PlayGui(msEnterSound, 1.f);
            
            ////////////////////
            // Animation support
            float fAnimDuration = 1.5f;
            if (msOpenAnim=="")
            {
                FadeStart();
            }
            else
            {
                mBaseObj.PlayAnimation(msOpenAnim, 0.3f, false, true, "", false, false);
                PlayerBody_PlayCutsceneAtEntity(msOpenAnim, mBaseObj.GetName(), false, 0.6f, "", 1, 0, 0, 0, true, false);
                fAnimDuration = PlayerBody_GetAnimationState(msOpenAnim).GetLength();
                mBaseObj.Timer_Add("Timer_StartFade", fAnimDuration - 1.f, "OnTimer_StartFade");
            }
		}

		return true;
	}
    
    //------------------------------------------------------------
    
    void OnTimer_StartFade(uint64 alId)
	{
        FadeStart();
	}
    
	//------------------------------------------------------------
    
    void FadeStart()
    {
		cLux_GetEffectHandler().FadeOut(1.f);
        //Map_FadeOut(1.f);
        mBaseObj.Timer_Add("Timer_FadeOver", 1.f, "OnTimer_FadeOver");
    }
    
	//------------------------------------------------------------
	
	void OnTimer_FadeOver(uint64 alId)
	{
        PlayerBody_StopAnimationLayer(ePlayerBodyAnimationLayer_FullBody, 0.01f);
        //Adding an extra delay or the cutscene anim state fails to end properly.
		mBaseObj.Timer_Add("Timer_ChangeMap", 0.1f, "OnTimer_ChangeMap");
	}
	
	//------------------------------------------------------------
    
    void OnTimer_ChangeMap(uint64 alId)
    {
		if(mbCheckPlayGo)
		{
			int64 lETA = 0;

			if(cLux_IsPlayGoReady(lETA) == false) //Is all the data needed downloaded?
			{
				// Remaining data has not finished download, try again in 3 seconds
				cScript_SetGlobalVarBool("PlayGo", true);
				PauseMenu_Show(true);
				mBaseObj.Timer_Add("Timer_ChangeMap", 3.0f, "OnTimer_ChangeMap");
				return;
			}
		}

        cLux_GetPlayer().SetActive(true);
        cLux_ChangeMap(msMapFile, msStartPos, "", "", msExitSound, true, 1.5f);
    }
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return mbLocked && mbHasBeenInteractedWith ? eCrossHairState_ExitLevelLocked : eCrossHairState_ExitLevel;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// SPECIFIC ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	void _Global_SetLocked()
	{
		mbLocked = cScript_GetGlobalArgBool(0);
	}
	
	void _Global_GetLocked()
	{
		cScript_SetGlobalReturnBool(mbLocked);
	}
	
	void _Global_SetOpenAnim()
	{
		msOpenAnim = cScript_GetGlobalArgString(0);
	}

	//------------------------------------------------------------

	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] tString msEnterSound;
	[nosave] tString msExitSound;
	
	//------------------------------------------------------------
	
	tString msMapFile;
	tString msStartPos;

	bool mbLocked;
	bool mbCheckPlayGo;
	tString msLockedSound;
	tString msLockedTextCat;
	tString msLockedTextEntry;
	
	float mfLockedCount;
	bool mbHasBeenInteractedWith;
    
    tString msOpenAnim="";
}	