//-------------------------------------------------

void SwingDoor_SetAutoClose(const tString &in asName, bool abX)
{
	array<iLuxEntity@> vEnts;
	cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_Prop, "cScrPropSwingDoor", vEnts);
	
	if (vEnts.size() == 0)
	{
		Error("Could not find door with name '"+asName+"' for _Global_SetAutoClose");
		return;
	}	
	
	for (uint i = 0; i < vEnts.size(); i++)
	{
		iLuxEntity@ pEnt = vEnts[i];		
		cScript_SetGlobalArgBool(0, abX);
		cScript_RunGlobalFunc(pEnt.GetName(), "cScrPropSwingDoor", "_Global_SetAutoClose");
	}
}

