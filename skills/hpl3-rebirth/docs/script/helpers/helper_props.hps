//-------------------------------------------------

/**
 * Sets the uv animation speed on the material of the specified submesh entity within the prop.
 * 
 * @param asProp, name of the prop.
 * @param asSubMeshEntity, submesh within the prop that has a material with a uv animation.
 * @param afSpeed, speed value.
 * @param alAnimId, id of the anim.
 **/
void Prop_SetUvAnimationSpeed(const tString &in asProp, const tString &in asSubMeshEntity, float afSpeed, int alAnimId = 0)
{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asProp,  eLuxEntityType_Prop);	
	if (pEntity is null)
		return;
		
	cSubMeshEntity@ pSubMesh = pEntity.GetMeshEntity().GetSubMeshEntityName(asSubMeshEntity);
	if (pSubMesh is null)
		return;
		
	cMaterial@ pMateral = pSubMesh.GetMaterial();
	if (pMateral is null)
		return;
		
	pMateral.SetUvAnimationSpeed(alAnimId, afSpeed);
}

//-------------------------------------------------

/**
 * Sets the uv animation time position on the material of the specified submesh entity within the prop.
 * 
 * @param asProp, name of the prop.
 * @param asSubMeshEntity, submesh within the prop that has a material with a uv animation.
 * @param afTime, time value.
 * @param alAnimId, id of the anim.
 **/
void Prop_SetUvAnimationTime(const tString &in asProp, const tString &in asSubMeshEntity, float afTime, int alAnimId = 0)
{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asProp,  eLuxEntityType_Prop);	
	if (pEntity is null)
		return;
		
	cSubMeshEntity@ pSubMesh = pEntity.GetMeshEntity().GetSubMeshEntityName(asSubMeshEntity);
	if (pSubMesh is null)
		return;
		
	cMaterial@ pMateral = pSubMesh.GetMaterial();
	if (pMateral is null)
		return;
		
	pMateral.SetUvAnimationTime(alAnimId, afTime);
}

