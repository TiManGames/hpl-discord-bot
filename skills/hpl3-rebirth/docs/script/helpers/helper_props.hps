//-------------------------------------------------

/**
 * Syncs an entity animation with its rotation amount.
 * 
 * @param asWheel, name of the wheel object prop.
 * @param asEntity, name of the entity that plays the animation.
 * @param asAnim, name of the animation to play.
 * @param afSlowdownFactor, animation slowdown factor.
 **/

void Wheel_SyncEntityAnimation(const tString &in asWheel, const tString &in asEntity, const tString &in asAnim, float afSlowdownFactor = 1.f)
{
	float fWheelRotation;
	if(cScript_RunGlobalFunc(asWheel, "cScrPropWheel", "_Global_GetRotationAmount")==false)
	{
		Error("Could not find entity with name '"+asWheel+"' for _Global_GetRotationAmount");
		return;
	}
	else fWheelRotation = cScript_GetGlobalReturnFloat();
	
	float fAnimPosition = 1.f;
	fAnimPosition = ((fAnimPosition * (afSlowdownFactor - 1)) + fWheelRotation) / afSlowdownFactor; 
	
	cAnimationState@ pAnim = cLux_GetCurrentMap().GetEntityByName(asEntity).GetMeshEntity().GetAnimationStateFromName(asAnim);
	pAnim.SetSpeed(0.f);
	pAnim.SetActive(true);
	pAnim.SetPaused(true);
	pAnim.SetWeight(1.f);
	pAnim.SetRelativeTimePosition(fAnimPosition);
}

