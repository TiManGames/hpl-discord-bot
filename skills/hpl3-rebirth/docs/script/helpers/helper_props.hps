/**
 * Returns the currently grabbed prop, or null if there isn't one.
 * 
 * @return a pointer to the currently grabbed prop
 **/
cLuxProp@ Grab_GetGrabbedProp()
{
	if(cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Grab)
		return null;
		
	cScript_RunGlobalFunc("State_Interact_Grab", "", "_Global_GetPropID");
	tID idProp = cScript_GetGlobalReturnID();
	if (idProp == tID_Invalid)
		return null;
	return cLux_ID_Prop(idProp);
}

//-------------------------------------------------

void Grab_SetSpecificHint(const tString &in asHintEntry)
{
	cScript_SetGlobalArgString(0, asHintEntry);
	cScript_RunGlobalFunc("State_Interact_Grab", "", "_Global_SetSpecificHint");
}

