/**
 * Sets the interaction icon for an entity. Currently only works for MoveBody, 
 * MoveableButton, Lever, Rigid and Triggers.
 * 
 * @param asName, name of the entity.
 * @param aIcon, The interaction icon.
 **/
void Entity_SetCustomInteractIcon(const tString &in asName, eCrossHairState aIcon)
{
	cScript_SetGlobalArgInt(0, aIcon);
	if(cScript_RunGlobalFunc(asName, "", "_Global_SetCustomInteractIcon")==false)
	{
		Error("Could not find entity with name '"+asName+"' for Prop_SetCustomInteractIcon");
	}
}

/**
 * Teleports an entity to an agent's feet.
 * 
 * @param asEntity, name of the entity to teleport.
 * @param asAgent, name of the target agent.
 * @param abAlignRotation, if the entity should align to the rotation of the agent
 **/
void Entity_TeleportToAgent(const tString &in asEntity, const tString &in asAgent, bool abAlignRotation = true)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity);
	if (pEnt is null) return;
	
	cLuxAgent@ pAgent = cLux_ToAgent(cLux_GetCurrentMap().GetEntityByName(asAgent, eLuxEntityType_Agent));
	if (pAgent is null) return;
	
	cVector3f vAgentPos = pAgent.GetCharBody().GetFeetPosition();
	float fAgentYaw = pAgent.GetCharBody().GetYaw();
	
	pEnt.SetPosition(vAgentPos);
	
	if (abAlignRotation)
		Entity_LookAtDirection(asEntity, pAgent.GetCharBody().GetForward());
}

//-------------------------------------------------

/**
 * Rotates the entity so it faces the other entity with its forward vector (positive Z).
 * 
 * @param asName, name of the entity.
 * @param asLookAtEntity, name of the entity to look at.
 **/
void Entity_LookAtEntity(const tString &in asName, const tString &in asLookAtEntity)
{
	iLuxEntity@ pEnt1 = cLux_GetCurrentMap().GetEntityByName(asName);
	if (pEnt1 is null) return;
	
	iLuxEntity@ pEnt2 = cLux_GetCurrentMap().GetEntityByName(asLookAtEntity);
	if (pEnt2 is null) return;
	
	cVector3f vDir = pEnt2.GetPosition() - pEnt1.GetPosition();
	Entity_LookAtDirection(asName, vDir);
}

//-------------------------------------------------

/**
 * Rotates the entity so it faces a direction with its forward vector (positive Z).
 * 
 * @param asName, name of the entity.
 * @param avLookAtDir, direction to look at.
 **/
void Entity_LookAtDirection(const tString &in asName, const cVector3f &in avLookAtDir)
{
	cVector3f vForward = avLookAtDir;
	vForward.Normalize();
	
	cVector3f vRight = cMath_Vector3Cross(vForward, cVector3f_Down);
	vRight.Normalize();
	
	cVector3f vUp = cMath_Vector3Cross(vForward, vRight);
	vUp.Normalize();
	
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asName);
	if (pEnt is null) return;
	
	cMatrixf mtxNew = cMath_MatrixUnitVectors(vRight, vUp, vForward, pEnt.GetMatrix().GetTranslation());
	pEnt.SetMatrix(mtxNew);
}

//-------------------------------------------------

/**
 * TO DO: Move to c++.
 * 
 * @param asSources, name of the source.
 * @param asEntities, name of the other entities (supports wildcards).
 **/
iLuxEntity@ Entity_GetClosestTo(const tString&in asSource,const tString&in asEntities)
{
	tID idClosestEntity = tID_Invalid;
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asEntities, eLuxEntityType_LastEnum, "", vEntities);

	float fDist = -1;
	for (uint i = 0; i < vEntities.length(); i++)
	{	
		iLuxEntity@ pCurrentEnt = vEntities[i];
		float fCurrentDist = Entity_GetDeltaToEntity(asSource,pCurrentEnt.GetName()).Length();
		cLux_AddDebugMessage("("+asSource+") Current entity: "+pCurrentEnt.GetName()+" | Distance: "+fCurrentDist);

		if (fCurrentDist < fDist || fDist < 0)
		{
			fDist = fCurrentDist;
			idClosestEntity = pCurrentEnt.GetID();
		}			
		
	}
	
	iLuxEntity@ pClosestEntity = cLux_GetCurrentMap().GetEntityByID(idClosestEntity);
	cLux_AddDebugMessage("("+asSource+") Found closest entity: "+pClosestEntity.GetName());
	
	return pClosestEntity;
}

