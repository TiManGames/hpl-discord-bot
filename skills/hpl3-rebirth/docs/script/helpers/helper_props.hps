/**
 * Sets whether bones should be animated when culled.
 * 
 * @param asEntity, name of the entity.
 * @param abX, enabled or not.
 **/
void Entity_SetUpdateBonesWhenCulled(const tString &in asEntity, bool abX)
{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntity);
	if (pEntity is null)
		return;
	cMeshEntity@ pMeshEntity = pEntity.GetMeshEntity();
	if (pMeshEntity is null)
		return;
		
	pMeshEntity.SetUpdateBonesWhenCulled(abX);
}

//-------------------------------------------------

/**
 * Sets the speed of the current animatmion.
 * 
 * @param asEntity, name of the entity.
 * @param afX, speed value.
 **/
void Entity_SetCurrentAnimationSpeed(const tString &in asEntity, float afX)
{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntity);
	if (pEntity is null)
		return;
	cAnimationState@ pState = pEntity.GetCurrentAnimationState();
	if (pState is null)
		return;
		
	pState.SetSpeed(afX);
}

//-------------------------------------------------

/**
 * Sets the speed of the specified animatmion.
 * 
 * @param asEntity, name of the entity.
 * @param afX, speed value.
 **/
void Entity_SetAnimationSpeed(const tString &in asEntity, const tString &in asAnim, float afX)
{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntity);
	if (pEntity is null)
		return;
	cMeshEntity@ pMeshEnt = pEntity.GetMeshEntity();
	if (pMeshEnt is null)
		return;
	cAnimationState@ pState = pMeshEnt.GetAnimationStateFromName(asAnim);
	if (pState is null)
		return;
	
	pState.SetSpeed(afX);
}

//-------------------------------------------------

/**
 * Aligns the first entity's base matrix with the sercond entity's base matrix.
 * 
 * @param asEntity, name of the entity that will be aligned
 * @param asEntityTarget, name of the entity to align to
 **/
void Entity_AlignBaseMatrix(const tString &in asEntity, const tString &in asEntityTarget)
{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntity);
	if (pEntity is null) return;
	
	iLuxEntity@ pEntityTarget = cLux_GetCurrentMap().GetEntityByName(asEntityTarget);
	if (pEntityTarget is null) return;
	
	cMatrixf mtxNew = cMath_MatrixMul(pEntityTarget.GetBaseMatrix(), cMath_MatrixInverse(pEntity.GetOnLoadOffsetTransform()));
	pEntity.SetMatrix(mtxNew);
}

