/**
 * Tears the prop.
 * 
 * @param asEntity, name of the tear prop.
 **/
void Tear_ForceTear(const tString &in asEntity)
{
	if (cLux_GetPlayer().GetCurrentStateId() == ePlayerState_Tear && Entity_IsInteractedWith(asEntity))
		cLux_GetPlayer().ChangeState(ePlayerState_Normal);
	
	if (cScript_RunGlobalFunc(asEntity, "cScrPropTear", "_Global_ForceTear") == false)
	{
		Error("Could not find tear prop with name '"+asEntity+"' for _Global_ForceTear");
	}
}

