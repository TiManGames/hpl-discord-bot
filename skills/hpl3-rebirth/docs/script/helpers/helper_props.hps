{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asPropName,  eLuxEntityType_Prop);	
	if (pEntity is null)
		return;
		
	cLuxProp@ pProp = cast<cLuxProp>(pEntity);
	pProp.SetRenderLayer(alLayer);
}

