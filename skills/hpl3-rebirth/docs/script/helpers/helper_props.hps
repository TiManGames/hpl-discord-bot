#include "helpers/helper_items.hps"

/////////////////////////////////////////
// SWING DOOR
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Pushes a door open using one or many impulses
 * 
 * @param asName, name of the door.
 * @param alState, if the door should be pushed open (1) or closed (-1).
 * @param afImpulseStrength, strength of the push impulse applied to the door
 * @param alImpulses, amount of impulses to apply to the door
 * @param afTimeBetweenImpulses, time between the impulses
 **/
void SwingDoor_Push(const tString&in asName, int alState, float afImpulseStrength=1, int alImpulses=1, float afTimeBetweenImpulses=0.1)
{
	SwingDoor_PushOpen(asName,afImpulseStrength*alState,alImpulses,afTimeBetweenImpulses);
}


/**
 * Pushes a door open using one or many impulses
 * 
 * @param asName, name of the door.
 **/
void SwingDoor_PushOpen(const tString& in asName, float afImpulseAmount, int alNumOfTimes=1, 
						float afTimeBetweenPushes=0.1)
{
	SwingDoor_SetDisableSnapClose(asName, true);
	SwingDoor_SetClosed(asName, false, true);
	
	if(alNumOfTimes>2)
	{
		cLux_GetCurrentMap().AddTimer(asName+"_HelperPushOpenImpulse", afTimeBetweenPushes, "$_Timer_HelperPushOpen_Impulse");
		cLux_GetCurrentMap().SetTimerUserVarString(asName+"_HelperPushOpenImpulse", asName);
		cLux_GetCurrentMap().SetTimerUserVarInt(asName+"_HelperPushOpenImpulse", alNumOfTimes-1);
		cLux_GetCurrentMap().SetTimerUserVarFloat(asName+"_HelperPushOpenImpulse", afImpulseAmount);
	}
	else
	{
		cLux_GetCurrentMap().AddTimer(asName+"_HelperPushOpenSnapClose", 1.0f, "$_Timer_HelperPushOpen_SnapClose");
		cLux_GetCurrentMap().SetTimerUserVarString(asName+"_HelperPushOpenSnapClose", asName);
	}
	
	SwingDoor_AddDoorBodyImpulse(asName, afImpulseAmount);
}

void _Timer_HelperPushOpen_Impulse(const tString&in asTimer)
{
	tString sName = cLux_GetCurrentMap().GetTimerUserVarString(asTimer);
	float fAmount = cLux_GetCurrentMap().GetTimerUserVarFloat(asTimer);
	int lCount  = cLux_GetCurrentMap().IncTimerUserVarInt(asTimer, -1);
	
	SwingDoor_AddDoorBodyImpulse(sName, fAmount);
	
	if(lCount>0)
		cLux_GetCurrentMap().RestartCurrentTimer();
	else
	{
		cLux_GetCurrentMap().AddTimer(sName+"_HelperPushOpenSnapClose", 1.0f, "$_Timer_HelperPushOpen_SnapClose");
		cLux_GetCurrentMap().SetTimerUserVarString(sName+"_HelperPushOpenSnapClose", sName);
	}
}

void _Timer_HelperPushOpen_SnapClose(const tString&in asTimer)
{
	tString sName = cLux_GetCurrentMap().GetTimerUserVarString(asTimer);
	
	SwingDoor_SetDisableSnapClose(sName, false);
}

//-------------------------------------------------

/**
 * Stops the pushing open of the specified door started by SwingDoor_PushOpen.
 * 
 * @param asName, name of the door.
 **/
void SwingDoor_StopPushOpen(const tString &in asName)
{
	cLux_GetCurrentMap().RemoveTimer(asName + "_HelperPushOpenImpulse");
	cLux_GetCurrentMap().RemoveTimer(asName + "_HelperPushOpenSnapClose");
	
	SwingDoor_SetDisableSnapClose(asName, false);
}

//-------------------------------------------------

/**
 * Returns the direction the door opens in
 * 
 * @param asName, name of the door.
 **/
cVector3f SwingDoor_GetDoorOpenDir(const tString&in asName)
{
	if (cScript_RunGlobalFunc(asName, "cScrPropSwingDoor", "_Global_GetDoorOpenDir") == false)
	{
		Error("Could not find door with name '"+asName+"' for SwingDoor_GetDoorOpenDir");
		return cVector3f_Zero;
	}
	return cScript_GetGlobalReturnVector3f();
}

