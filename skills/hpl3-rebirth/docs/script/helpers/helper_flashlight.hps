#include "modules/ModuleInterfaces.hps"

//-------------------------------------------------

/////////////////////////////////////////
// FLASHLIGHT
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Turns the flashlight on or off.
 * 
 * @param bool abX, true = flashlight on. - false = flashlight off.
 * @param bool abSuppressSound, if true don't make a noise
 **/
void Flashlight_SetOn(bool abX, bool abSuppressSound = false)
{
	iScrFlashlightHandler_Interface @pLightHandler = cast<iScrFlashlightHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_FlashlightHandler) );
	pLightHandler.SetOn(abX,abSuppressSound);
}

//-------------------------------------------------

/**
 * Returns if the flashlight is turned on or off
 * 
 * @return abX, true = flashlight on. - false = flashlight off.
 **/
bool Flashlight_IsOn()
{
	iScrFlashlightHandler_Interface @pLightHandler = cast<iScrFlashlightHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_FlashlightHandler,true) );
	if (pLightHandler is null)
		return false;
	return pLightHandler.IsOn();
}

//-------------------------------------------------

/**
 * Returns the range of the flashlight
 * 
 * @return afX, Radius of flashlight.
 **/
float Flashlight_GetRange()
{
	iScrFlashlightHandler_Interface @pLightHandler = cast<iScrFlashlightHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_FlashlightHandler) );
	return pLightHandler.GetRange();
}

//-------------------------------------------------

/**
 * Set the flashlight fade out and ease
 * 
 * @param afSpeed, fade speed
 * @param aEasing, easing method to use
 **/
void Flashlight_SetFadeOut(float afSpeed, eEasing aEasing = eEasing_Linear)
{
	iScrFlashlightHandler_Interface @pLightHandler = cast<iScrFlashlightHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_FlashlightHandler) );
	pLightHandler.SetFadeOut(afSpeed,aEasing);
}

//-------------------------------------------------

/**
 * Set the flashlight fade in and ease
 * 
 * @param afSpeed, fade speed
 * @param aEasing, easing method to use
 **/
void Flashlight_SetFadeIn(float afSpeed, eEasing aEasing = eEasing_Linear)
{
	iScrFlashlightHandler_Interface @pLightHandler = cast<iScrFlashlightHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_FlashlightHandler) );
	pLightHandler.SetFadeIn(afSpeed,aEasing);
}

//-------------------------------------------------

/**
 * Enables or disables toggling flashlight on/off
 * 
 * @param bool abX, false = flashlight can't be turned on or off. - true = flashlight can be turned on or off.
 **/
void Flashlight_SetEnabled(bool abX)
{
	iScrFlashlightHandler_Interface @pLightHandler = cast<iScrFlashlightHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_FlashlightHandler) );
	pLightHandler.SetEnabled(abX);
}

//-------------------------------------------------
	
/**
 * Set a callback for when the flashlight is toggled on or off.
 * 
 * @param tString asCallback, name of function callback.
 * 
 * @callback syntax for callback function, FunctionName(bool abLit).
 **/
void Flashlight_SetOnOffCallback(const tString &in asCallback)
{
	iScrFlashlightHandler_Interface @pLightHandler = cast<iScrFlashlightHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_FlashlightHandler) );
	pLightHandler.SetOnOffCallback(asCallback);
}

//-------------------------------------------------
	
/**
 * Set how much the player flashlight should affect env particles
 * 
 * @param float afMul, how bright the flashlight should make the env particles
 **/
void Flashlight_SetEnvParticleMul(float afMul)
{
	iScrFlashlightHandler_Interface @pLightHandler = cast<iScrFlashlightHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_FlashlightHandler) );
	pLightHandler.SetEnvParticleMul(afMul);
}

//-------------------------------------------------