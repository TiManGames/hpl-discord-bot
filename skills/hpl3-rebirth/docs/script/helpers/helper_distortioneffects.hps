#include "modules/ModuleInterfaces.hps"

//-------------------------------------------------

/////////////////////////////////////////
// DISTORTION EFFECT
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Adds the entity has an instance that will help create a distortion effect if the player is near enough.
 * 
 * @param a_idEntity, The entity who this will be connected to.
 * @param afMaxDistance, The distance at which the effect will start.
 * @param afMinDistance, The distance when the effect will be at max
 * @param afMaxAmount, The max amount the effect will have from this entity.
 * @param aEasing, The easing function used to fade between max and min
 **/
void DistortionEffect_AddInstance(tID a_idEntity, float afMaxDistance, float afMinDistance, float afMaxAmount, eEasing aEasing = eEasing_Linear)
{
	iScrDistortionEffectsHandler_Interface @pDistHandler = cast<iScrDistortionEffectsHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DistortionEffectsHandler) );
	
	pDistHandler.AddInstance(a_idEntity, afMaxDistance, afMinDistance, afMaxAmount, aEasing);
}

//-------------------------------------------------

/**
 * Removes an instance that will create the distortion effect.
 * 
 * @param a_idEntity, The entity to break the connection with
 **/
void DistortionEffect_RemoveInstance(tID a_idEntity)
{
	iScrDistortionEffectsHandler_Interface @pDistHandler = cast<iScrDistortionEffectsHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_DistortionEffectsHandler) );
	
	pDistHandler.RemoveInstance(a_idEntity);
}

//-------------------------------------------------