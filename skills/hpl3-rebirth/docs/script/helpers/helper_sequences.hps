
//-------------------------------------------------------

/////////////////////////////////////////
// MAIN FUNCTIONS
/////////////////////////////////////////
	
//-------------------------------------------------

class cSequenceStatesData
{
	cSequenceStatesData()
	{ 
		mlStateCounter = 0;
	}

	tString msSequenceFuncName;
	
	float mfTimestamp; //Current timestamp
	int mlStateCounter; //This is the state we are currently at.
	
	int mlCurrentSequenceState; //This is the state count when going through the states
	bool mbStateCalled;
}

//-------------------------------------------------

cSequenceStatesData @gpCurrentSequenceStateData;

//-------------------------------------------------

/**
 * Begins to define a sequence of events. 
 * Note that the entire specified function will be run once for every sequence step.
 * 
 * @param asFunction, the name of the function that Sequence_Begin is called from. Syntax: void Func(const tString &in asSequence).
 * @param aData, object containing the state of the sequence.
 **/
void Sequence_Begin(const tString &in asFunction, cSequenceStatesData & aData)
{
	////////////////////////////
	// Init 
	if(aData.mlStateCounter ==0)
	{
		aData.msSequenceFuncName = asFunction;
	}
	
	////////////////////////////
	// Set up for sequence checking
	aData.mbStateCalled = false;
	aData.mlCurrentSequenceState =0;
	aData.mfTimestamp = 0;
	
	@gpCurrentSequenceStateData = aData;
}

//-------------------------------------------------

/**
 * Ends the definition of a sequence. 
 **/
void Sequence_End()
{
	//////////////////////////////////
	//All states are called, reset
	if(gpCurrentSequenceStateData.mbStateCalled == false)
	{
		gpCurrentSequenceStateData.mlStateCounter = 0;
	}
}

//-------------------------------------------------

/**
 * Stops the current sequence immediately.
 **/
void Sequence_Stop()
{
	gpCurrentSequenceStateData.mlStateCounter = 0;
	cLux_GetCurrentMap().RemoveTimer(gpCurrentSequenceStateData.msSequenceFuncName+"_Timer");
}

//-------------------------------------------------

/**
 * Use as an if statement condition to define a single step in a sequence. 
 * A step will only be run once per sequence, and delays execution of the next step by a specified time.
 * 
 * @param afTime, the time before the next step is called.
 **/
bool Sequence_DoStepAndWait(float afTime)
{
	if(gpCurrentSequenceStateData.mbStateCalled==true) return false;
	
	/////////////////////////////
	// This is the current state!
	gpCurrentSequenceStateData.mfTimestamp += afTime;
	if(gpCurrentSequenceStateData.mlCurrentSequenceState == gpCurrentSequenceStateData.mlStateCounter)
	{
		gpCurrentSequenceStateData.mbStateCalled = true;
		gpCurrentSequenceStateData.mlStateCounter++;
		cLux_GetCurrentMap().AddTimer(gpCurrentSequenceStateData.msSequenceFuncName+"_Timer", afTime, gpCurrentSequenceStateData.msSequenceFuncName);
		return true;
	}
	/////////////////////////////
	// This is NOT the state
	else
	{
		gpCurrentSequenceStateData.mlCurrentSequenceState++;
		return false;
	}
}

void Sequence_AddWaitTime(float afTime)
{
	tString sTimer = gpCurrentSequenceStateData.msSequenceFuncName+"_Timer";
	float fTime = cLux_GetCurrentMap().GetTimerTime(sTimer);
	if (fTime <= 0) return;
	cLux_GetCurrentMap().RemoveTimer(sTimer);
	cLux_GetCurrentMap().AddTimer(sTimer, fTime + afTime, gpCurrentSequenceStateData.msSequenceFuncName);
}

/**
 * Use as an if statement condition to define a single step in a sequence. 
 * A step will only be run once per sequence, and delays execution until the timestep
 * 
 * @param floatafTimestamp, the time when the next step is executed
 **/
bool Sequence_DoStepAndWaitUntil(float afTimestamp)
{
	if(gpCurrentSequenceStateData.mbStateCalled==true) return false;
	
	return Sequence_DoStepAndWait(cMath_Max(0.0f, afTimestamp - gpCurrentSequenceStateData.mfTimestamp));
}

//-------------------------------------------------

/**
 * Use as an if statement condition to define a single step in a sequence. 
 * A step will only be run once per sequence. This one waits and allows you to repeat different times before moving on.
 * 
 * @param alNumOfRepetitions, amount of times this sequence step should repeat.
 * @param afWaitTime, the time before the next step is called.
 **/
bool Sequence_DoStepWaitAndRepeat(int alNumOfRepetitions, float afWaitTime)
{
	bool bRet = false;
	for(int i=0; i<alNumOfRepetitions; ++i)
	{
		if(Sequence_DoStepAndWait(afWaitTime)) bRet =true;
	}
	return bRet;
}


//-------------------------------------------------

/**
 * Use as an if statement condition to define a single step in a sequence. 
 * A step will only be run once per sequence. This one does not wait and just jumps to the next step.
 **/
bool Sequence_DoStepAndContinue()
{
	if(gpCurrentSequenceStateData.mbStateCalled==true) return false;
	
	/////////////////////////////
	// This is the current state!
	if(gpCurrentSequenceStateData.mlCurrentSequenceState == gpCurrentSequenceStateData.mlStateCounter)
	{
		gpCurrentSequenceStateData.mlStateCounter++;
		gpCurrentSequenceStateData.mlCurrentSequenceState++;
		return true;
	}
	/////////////////////////////
	// This is NOT the state
	else
	{
		gpCurrentSequenceStateData.mlCurrentSequenceState++;
		return false;
	}
}

//-------------------------------------------------

/**
 * Use as an if statement condition to define a single step in a sequence. 
 * Works similar to Sequence_DoStepAndWait, but pauses the sequence after the step has been executed.
 * To resume, use SequenceStates_Resume("FunctionName")
 * 
 * @param afTime, the time before the next step is called after the sequence has been resumed, 0 by default.
 **/
bool Sequence_DoStepAndPause(float afTime = 0)
{
	bool bStepDone = Sequence_DoStepAndWait(afTime);
	
	if (bStepDone) cLux_GetCurrentMap().SetTimerPaused(gpCurrentSequenceStateData.msSequenceFuncName+"_Timer", true);
	
	return bStepDone;
}

//-------------------------------------------------

/**
 * This is just like an if statement with DoStepAndWait only it does nothing, ie if(Sequence_DoStepAndWait(x)){}. 
 * It therefore should not be inside a Sequence_DoStepXXX function.
 * Add it to just get a wait before the next step is run .
 * 
 * @param afTime, the time before the next step is called after the sequence has been resumed, 0 by default.
 **/
void Sequence_Wait(float afTime)
{
	if(Sequence_DoStepAndWait(afTime)){}
}

//-------------------------------------------------

/**
 * This is just like an if statement with Sequence_DoStepAndPause only it does nothing, ie if(Sequence_DoStepAndPause(x)){}.
 * It therefore should not be inside a Sequence_DoStepXXX function.
 * Add it to just get a pause.
 **/
void Sequence_Pause()
{
	if(Sequence_DoStepAndPause()){}
}

//-------------------------------------------------

/**
 * Skips a number of steps of the sequence.
 * 
 * @param alStepsToSkip, the number of steps to skip.
 **/
void Sequence_SkipNextSteps(int alStepsToSkip)
{
	gpCurrentSequenceStateData.mlStateCounter += alStepsToSkip;
}

//-------------------------------------------------

/**
 * Skips the next step of the sequence.
 **/
void Sequence_SkipNextStep()
{
	Sequence_SkipNextSteps(1);
}

//-------------------------------------------------

/////////////////////////////////////////
// HELPER FUNCTIONS
/////////////////////////////////////////
	
//-------------------------------------------------

/**
 * Pauses a sequence. 
 * Contrary to Sequence_Pause(), this should go inside a Sequence_DoStepXXX function.
 * 
 * @param asName, the name of the sequence to pause.
 **/
void SequenceStates_Pause(tString &in asName)
{
	cLux_GetCurrentMap().SetTimerPaused(asName+"_Timer", true);
}

//-------------------------------------------------

/**
 * Resumes a sequence. 
 * Contrary to Sequence_Resume(), this should go inside a Sequence_DoStepXXX function.
 * 
 * @param asName, the name of the sequence to resume.
 **/
void SequenceStates_Resume(tString &in asName)
{
	cLux_GetCurrentMap().SetTimerPaused(asName+"_Timer", false);	
}

//-------------------------------------------------

/**
 * Stops a sequence. 
 * Contrary to Sequence_Stop(), this should go inside a Sequence_DoStepXXX function.
 * 
 * @param asName, the name of the sequence to stop.
 **/
void SequenceStates_Stop(tString &in asName)
{
	cLux_GetCurrentMap().RemoveTimer(asName+"_Timer");	
}

//-------------------------------------------------

/**
 * Checks if a sequence is currently active.
 * 
 * @param asName, the name of the sequence to check.
 **/
bool SequenceStates_IsActive(tString &in asName)
{
	return cLux_GetCurrentMap().GetTimerTime(asName+"_Timer") > 0;	
}

//-------------------------------------------------

