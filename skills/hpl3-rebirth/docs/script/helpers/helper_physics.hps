//-------------------------------------------------

/////////////////////////////////////////
// VERLET ROPE
/////////////////////////////////////////

/**
 * Create a physics rope. After a small delay since the rope is created, use Rope_CreateGfx to render it.
 * 
 * @param asName, name of the rope to create.
 * @param avStart, position of the first segment.
 * @param avEnd, position of the last segment.
 * @param afSegmentLength, length of the single segments.
 * @param afDamping, angular damping amount.
 * @param afStrength, rope strength.
 * @param afStiffness, rope stiffness.
 * @param abCollide, if the rope should collide with other entities.
 * @param abCollideAttachments, if the rope should collide with attached entities.
 **/
void Rope_Create(const tString &in asName, cVector3f avStart, cVector3f avEnd, float afSegmentLength = .2f, float afDamping = .05f, float afStrength = 100.f, float afStiffness = .1f, bool abCollide = false, bool abCollideAttachments = false)
{	
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().CreateRope(asName, avStart, avEnd);
	pRope.SetSegmentLength(afSegmentLength);
	pRope.SetDamping(afDamping);
	pRope.SetStrength(afStrength);
	pRope.SetStiffness(afStiffness);
	pRope.SetCollide(abCollide);
	pRope.SetCollideAttachments(abCollideAttachments);
	pRope.SetCollideFlags(uint(-1));		
	pRope.SetActive(true);
	pRope.SetPhysicsActive(true);
	//pRope.SetSleepParamters(0.05, 0.1, 1);
} 

//-------------------------------------------------

void Rope_SetActive(const tString &in asName, bool abActive, bool abPhysicsActive)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	pRope.SetActive(abActive);
	pRope.SetPhysicsActive(abPhysicsActive);
	Rope_SetVisible(asName,abActive);
}

//------------------------------------------------------- 

/**
 * Creates the graphics for an existing physics rope.
 * 
 * @param asName, name of the existing physics rope to create gfx for.
 * @param abVisible, whether the rope entity should be visible.
 **/
void Rope_SetVisible(const tString &in asName, bool abVisible)
{
	iRopeEntity@ pRopeGfx = cLux_GetCurrentMap().GetWorld().GetRopeEntity(asName+"Gfx");
	pRopeGfx.SetVisible(abVisible);
}

//-------------------------------------------------


/**
 * Checks if a physics rope exists.
 * 
 * @param asName, name of the physics rope.
 **/
bool Rope_Exists(const tString &in asName)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	return (pRope == null) ? false : true;
}

//-------------------------------------------------

/**
 * Sets collision of rope
 * 
 * @param asName, name of the existing physics rope.
 * @param abCollide, if the rope should collide with the world entities.
 * @param abCollideAttachments, if the rope should collide with the attached bodies.
 * @param abCollideCharacter, if the rope should collide with char bodies such as player or agnets
 * @param abCollideRagdoll, if the rope should collide with ragdoll bodies.
 * @param asCollideGroup, which collide group this rope belongs to
 **/
void Rope_SetCollide(const tString &in asName, bool abCollide, bool abCollideAttachments, bool abCollideCharacter=true, bool abCollideRagdoll=true)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	
	if (pRope == null)
	{
		Error("Cannot find rope "+asName+". Cannot set collide parameters.");
		return;
	}
	
	pRope.SetCollide(abCollide);
	pRope.SetCollideAttachments(abCollideAttachments);	
	pRope.SetCollideCharacter(abCollideCharacter);	
	pRope.SetCollideRagDoll(abCollideRagdoll);	
}

//-------------------------------------------------

/**
 * Sets collision group of rope
 * 
 * @param asCollideGroup, which collide group this rope belongs to
 **/
void Rope_SetCollideGroup(const tString &in asName, const tString&in asCollideGroup="")
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	
	if (pRope == null)
	{
		Error("Cannot find rope "+asName+". Cannot set collide group.");
		return;
	}
	
	if(asCollideGroup == "")
	{
		pRope.SetCollideFlags(uint(-1));	
	}
	else
	{
		pRope.SetCollideFlags(cLux_GetCurrentMap().GetCollideFlag(asCollideGroup));	
	}
}

//-------------------------------------------------

/**
 * Sets the length of an existing physics rope.
 * 
 * @param asName, name of the existing physics rope.
 * @param afLength, length of the rope.
 **/
void Rope_SetTotalLength(const tString &in asName, float afLength)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	if (pRope == null)
	{
		Error("Cannot find rope "+asName+". Cannot set total length.");
		return;
	}
	
	pRope.SetTotalLength(afLength);
}

//-------------------------------------------------

/**
 * Sets the length of an existing physics rope.
 * 
 * @param asName, name of the existing physics rope.
 * @param afLength, max length of the rope.
 **/
void Rope_SetMaxTotalLength(const tString &in asName, float afLength)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	if (pRope == null)
	{
		Error("Cannot find rope "+asName+". Cannot set max length.");
		return;
	}
	
	pRope.SetMaxTotalLength(afLength);
}

//-------------------------------------------------

/**
 * Stretch length of an existing physics rope.
 * 
 * @param asName, name of the existing physics rope.
 * @param afLength, length of the rope.
 **/
void Rope_StretchToLength(const tString &in asName, float afLength, float afSpeed)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	
	if (pRope == null)
	{
		Error("Cannot find rope "+asName+". Rope cannot be stretched.");
		return;
	}
	
	pRope.SetMotorWantedLength(afLength);
	pRope.SetMotorSpeedMul(afSpeed);
	//pRope.SetMotorMaxSpeed(afSpeed);
	pRope.SetMotorActive(true);
}

//-------------------------------------------------

/**
 * Sets the starting particle mass of an existing physics rope.
 * 
 * @param asName, name of the existing physics rope.
 * @param afMass, mass of the first particle.
 **/
void Rope_SetStartParticleMass(const tString &in asName, float afMass)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	if (pRope == null)
	{
		Error("Cannot find rope "+asName+". Cannot set starting particle mass.");
		return;
	}
	
	pRope.GetStartParticle().SetInvMass(afMass);
}

//-------------------------------------------------

/**
 * Sets the ending particle mass of an existing physics rope.
 * 
 * @param asName, name of the existing physics rope.
 * @param afMass, mass of the last particle.
 **/
void Rope_SetEndParticleMass(const tString &in asName, float afMass)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	if (pRope == null)
	{
		Error("Cannot find rope "+asName+". Cannot set ending particle mass.");
		return;
	}
	
	pRope.GetEndParticle().SetInvMass(afMass);
}

//-------------------------------------------------

/**
 * Attaches the beginning of a physics rope to an entity.
 * 
 * @param asName, name of the existing physics rope.
 * @param asEntity, entity the beginning of the rope should be attached to.
 **/
void Rope_AttachStart(const tString &in asName, const tString &in asEntity, const tString &in asBodyName = "")
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	
	if (pRope == null)
	{
		Error("Cannot find physics rope "+asName+". Impossible to get entity rope.");
		return;
	}
	
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntity);
	iPhysicsBody@ pBody = pEntity.GetMainBody();	
	
	if (asBodyName != "")
		@pBody = pEntity.GetBodyFromName(asBodyName);
		
	if (pBody == null)
	{
		Error("Cannot find body "+asBodyName+". Rope cannot be attached.");
		return;
	}

	
	pRope.SetAttachedStartBody(pBody);
}

//-------------------------------------------------

/**
 * Attaches the end of a physics rope to an entity.
 * 
 * @param asName, name of the existing physics rope.
 * @param asEntity, entity the end of the rope should be attached to.
 **/
void Rope_AttachEnd(const tString &in asName, const tString &in asEntity, const tString &in asBodyName = "")
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	
	if (pRope == null)
	{
		Error("Cannot find physics rope "+asName+". Impossible to get entity rope.");
		return;
	}
	
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntity);
	iPhysicsBody@ pBody = pEntity.GetMainBody();
	
	if (asBodyName != "")
		@pBody = pEntity.GetBodyFromName(asBodyName);
		
	if (pBody == null)
	{
		Error("Cannot find body "+asBodyName+". Rope cannot be attached.");
		return;
	}
		
	pRope.SetAttachedEndBody(pBody);
}

//-------------------------------------------------

/**
 * Detaches a specific entity from a physics rope.
 * 
 * @param asName, name of the existing physics rope.
 * @param asEntity, entity to detach.
 **/
void Rope_Detach(const tString &in asName, const tString &in asEntity)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	
	if (pRope == null)
	{
		Error("Cannot find physics rope "+asName+". Cannot detach.");
		return;
	}
	
	pRope.RemoveAttachedBody(cLux_GetCurrentMap().GetEntityByName(asEntity).GetMainBody(), true);
}

//-------------------------------------------------

/**
 * Sets the parameters according to which a physics rope goes to sleep.
 * 
 * @param asName, name of the existing physics rope.
 * @param afInterval, how often (sec) to check if the rope should sleep .
 * @param afDistance, how short the rope has to move for it to be considered asleep.
 * @param afCountMax, how many times to check that the distance is the same before sending to sleep.
 **/
void Rope_SetSleepParameters(const tString &in asName, float afInterval =.3f, float afDistance = .0015f, float afCountMax = 3.f)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	
	if (pRope == null)
	{
		Error("Cannot find physics rope "+asName+". Cannot set sleep parameters.");
		return;
	}
	
	pRope.SetSleepParamters(afInterval, afDistance, afCountMax);
}

//-------------------------------------------------

/**
 * Creates the graphics for an existing physics rope.
 * 
 * @param asName, name of the existing physics rope to create gfx for.
 * @param asMaterial, material file to apply to the rope.
 * @param afRadius, radius of the rope.
 **/
void Rope_CreateGfx(const tString &in asName, const tString &in asMaterial, float afRadius)
{
	iPhysicsRope@ pRope = cLux_GetCurrentMap().GetPhysicsWorld().GetRope(asName);
	
	if (pRope == null)
	{
		Error("Cannot find physics rope "+asName+". Cannot set graphics parameters.");
		return;
	}
	
	iRopeEntity@ pRopeGfx = cLux_GetCurrentMap().GetWorld().CreateRopeEntity(asName+"Gfx", eRopeType_3D, pRope, 32, 6);
	cMaterial@ pMat = cResources_CreateMaterial(asMaterial);
	pRopeGfx.SetMaterial(pMat);  
	pRopeGfx.SetRadius(afRadius);
	pRopeGfx.SetActive(true);
	pRopeGfx.SetVisible(true);
	pRopeGfx.SetScriptableIsSaved(true);
	pRopeGfx.SetRenderFlagBit(eRenderableFlag_ShadowCaster, true);
}