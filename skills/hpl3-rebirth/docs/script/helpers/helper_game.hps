//-------------------------------------------------

/////////////////////////////////////////
// PLATFORM
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Gets the name of the platform that is running the game.
 **/
tString Platform_GetName()
{
	return cSystem_GetPlatformName();
}

/**
 * Checks if the game is running on a console
 **/
bool Platform_IsConsole()
{
	ePlatform platform = cSystem_GetPlatform();
	return platform >= ePlatform_PS4 && platform <= ePlatform_PS5 || Platform_IsStreaming();
}

/**
 * Checks if the game is running on a PlayStation.
 **/
bool Platform_IsPlayStation()
{
	ePlatform platform = cSystem_GetPlatform();
	return platform >= ePlatform_PS4 && platform <= ePlatform_PS5;
}

/**
 * Checks if the game is running on a PS4.
 **/
bool Platform_IsPS4()
{
	ePlatform platform = cSystem_GetPlatform();
	return platform == ePlatform_PS4 || platform == ePlatform_PS4Pro;
}

/**
 * Checks if the game is running on streaming platform, ie no options
 **/
bool Platform_IsStreaming()
{
	return cSystem_GetPlatform() == ePlatform_Streaming;
}

/////////////////////////////////////////
// SAVING
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Saves the current postion of the game.
 **/
void Game_AutoSave(bool abSaveCheckpoint = true, bool abDelayed = true)
{
	cLux_GetSaveHandler().AutoSave(abSaveCheckpoint, abDelayed);
	
	//if(cLux_ScriptDebugOn())
	//	cSystem_Sleep(2000);
}

//-------------------------------------------------

/////////////////////////////////////////
// CHECKPOINT
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets a checkpoint for the player. If the player dies the game will be reloaded to the state it was when this was called.
 * 
 * @param asCallback, Function called after player has died and just before he starts again. Syntax: void F(int alNumDeathsAtCheckPoint, const tString&in asDeathSource)
 **/
void CheckPoint_Setup(	const tString&in asCallback="")
{
	cScript_SetGlobalArgString(0, asCallback);
	cScript_RunGlobalFunc("GameOverHandler","","_Global_SetupCheckPoint");
	
	//if(cLux_ScriptDebugOn())
	//	cSystem_Sleep(2000);
}

//-------------------------------------------------


/////////////////////////////////////////
// ACHEIVEMENTS
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Unlocks a specific game achievement.
 * 
 * @param alID, The achievement ID
 **/
void Achievement_Unlock(int alID)
{
	cLux_AddDebugMessage("[UNLOCKED ACHIEVEMENT] "+Achievement_GetName(alID));
	cLux_GetAchievementHandler().UnlockAchievement(alID);
	if (Achievement_GetAllUnlocked())
	{
		cLux_AddDebugMessage("[ !!! PLATINUM UNLOCKED !!!!]");
		cLux_GetAchievementHandler().UnlockAchievement(eAchievement_Reborn);
	}
}

/**
 * Increase one of the counters needed to unlock cumulative achievements.
 * 
 * @param aCount, The counter to increase
 **/
void Achievement_IncreaseCount(eAchievementCount aCount)
{
	iScrAchievementHandler_Custom_Interface @pAchievementHandler = cast<iScrAchievementHandler_Custom_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_AchievementHandler) );
	pAchievementHandler.IncreaseCount(aCount);
}

/**
 * Returns the name of an achievement.
 * 
 * @param alID, The achievement ID
 **/
tString Achievement_GetName(int alID)
{
	return cLux_GetAchievementHandler().GetAchievementName(alID);
}

/**
 * Checks if an achievement has already be unlocked or not.
 * 
 * @param alID, The achievement ID
 **/
bool Achievement_GetUnlocked(int alID)
{
	return cLux_GetAchievementHandler().GetAchievementUnlocked(alID);
}

/**
 * Checks if all of the achievements have been unlocked.
 * 
 **/
bool Achievement_GetAllUnlocked()
{
	return cLux_GetAchievementHandler().GetAllAchievementsUnlocked();
}

/**
 * Returns the displayed name of an achievement (might differ from the name itself).
 * 
 * @param alID, The achievement ID
 **/
tString Achievement_GetDisplayName(int alID)
{
	return cLux_GetAchievementHandler().GetAchievementDisplayName(alID);
}

/**
 * Returns the description of an achievement.
 * 
 * @param alID, The achievement ID
 **/
tString Achievement_GetDescription(int alID)
{
	return cLux_GetAchievementHandler().GetAchievementDescription(alID);
}

/**
 * Returns the icon assigned to an achievement.
 * 
 * @param alID, The achievement ID
 **/
int Achievement_GetIcon(int alID)
{
	return cLux_GetAchievementHandler().GetAchievementIcon(alID);
}

//-------------------------------------------------

void Debug_Log(float afValue, bool afDuplicates=true)
{
	Debug_Log(""+afValue,afDuplicates);
}

void Debug_Log(bool abValue, bool afDuplicates=true)
{
	Debug_Log(""+abValue,afDuplicates);
}

//-------------------------------------------------------

tString Game_GetPlaytime(bool abAddCurrent=false)
{
	iScrSketchbookUIHandler_Interface @pHandler = cast<iScrSketchbookUIHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_SketchbookUIHandler) );
	
	float fTime = pHandler.GetPlaytime(abAddCurrent) / 60.0f;
	return String_SecondsToClockDisplay(fTime,true,true,true,false);
}

void Game_LogStats(bool abLogCurrentTime=true)
{
	cLux_AddDebugMessage("---------------  STATS  --------------");
	cLux_AddDebugMessage("");
	cLux_AddDebugMessage("PLAYTIME: "+Game_GetPlaytime(abLogCurrentTime));
	cLux_AddDebugMessage("GHOUL LEVEL: "+GhoulProgression_GetProgression()+"/"+GhoulProgression_GetMaxProgression()+" (LIMIT: "+GhoulProgression_GetLimit()+")");
	cLux_AddDebugMessage("TIMES PERMAFAILED: "+FearHandler_GetTotalTimesPermafailed());
	cLux_AddDebugMessage("MATCHES USED: "+Sketchbook_GetUsedMatchesCounter());
	cLux_AddDebugMessage("PROPS BROKEN: "+Player_GetBrokenItems());
	Sketchbook_GetCollectedNotesAmount();
	cLux_AddDebugMessage("BABY CHECKS: "+Player_GetAmountBabyChecked());
	cLux_AddDebugMessage("");
	cLux_AddDebugMessage("--------------------------------------");
	
}