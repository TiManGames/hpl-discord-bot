#include "player/PlayerState_Interact_RotateBase.hps"

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------

//const float gfMaxForce = 10000;

//------------------------------------------------------------

class cScrPlayerState_Interact_Wheel : iScrPlayerState_Interact_RotateBase, iScrPlayerState_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool UseNewWay() { return false; }
	
	//------------------------------------------------------------
	
	void InitRotateBase()
	{
		mRotatePid.p = 5.0f;
		mRotatePid.i = 0.0f;
		mRotatePid.d = 0.1f;
		
		mfMoveToMouseAddFactor = 0.1;
		mfMaxAngularImpulse = 100;
		mbResetSpeedWhenNoMouseMovement = false;
		
		mvMoveDirs.resize(10);
		
		msHint = "HintWheel";
		
		msWheelName = "";
		mfWheelStartAngle = 0.f;
		mbWheelHintGiven = false;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// USER SETTINGS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void LoadUserConfig() override
	{
		iScrPlayerState_Interact::LoadUserConfig();
	}
	
	void SaveUserConfig() override
	{
		iScrPlayerState_Interact::SaveUserConfig();
	}	
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	
	}
	void OnMapLeave(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap @apMap)
	{
	
	}
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupWheel()
	{
		////////////////////////////////
		// Get basic params & setup
		SetupInteractVars();
		
		////////////////////////////////
		// Get the parameters
		mfMoveMaxSpeed = cScript_GetGlobalArgFloat(3);
		mfMoveSpeedFactor = cScript_GetGlobalArgFloat(4);
		mfMoveSlowDownFactor = cScript_GetGlobalArgFloat(5);
		mbWiggle = cScript_GetGlobalArgBool(6);
		msLookAtEntity = cScript_GetGlobalArgString(7);
		mfLookAtAcc = cScript_GetGlobalArgFloat(8);
		mfLookAtSpeedMul = cScript_GetGlobalArgFloat(9);
		mfLookAtMaxSpeed = cScript_GetGlobalArgFloat(10);
		mfLookAtDec = cScript_GetGlobalArgFloat(11);
		mfAdditionalInertia = cScript_GetGlobalArgFloat(12);
		msStandTar = cScript_GetGlobalArgString(13);
		mbDefaultLookAt = cScript_GetGlobalArgBool(14);
		msWheelName = cScript_GetGlobalArgString(15);
		
		if(mbUseNewWay)
		{
			Setup_Base_Rotate();
		}
	}
	
	//------------------------------------------------------------
	
	void EnableWiggle()
	{
		mbWiggle = true;
		mfWiggleCount = 0;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void EnterRotateBase(int alPrevStateId)
	{
		//Reset the array
		for(uint i=0; i< mvMoveDirs.size(); ++i) mvMoveDirs[i] = cVector2f(0,0);
		
		//Reset the array variables
		mlMoveAddInsertPos = 0;
		mlMoveAddNum =0;
		
		//The wiggle count needs reset too!
		mfWiggleCount = 0;
		
		if (mbWheelHintGiven == false)
			mfWheelStartAngle = Wheel_GetCurrentAngle(msWheelName);
	}
	
	//------------------------------------------------------------
	
	void LeaveRotateBase(int alNextStateId)
	{
		float fAngle = Wheel_GetCurrentAngle(msWheelName);
		
		// Allow hint again if angle hasn't changed much
		if (cMath_Abs(mfWheelStartAngle - fAngle) < 90.f && mbWheelHintGiven == false)
			Hint_RemoveFromGiven("Hints", msHint);
		else
			mbWheelHintGiven = true;
	}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
		if(CheckShouldUpdate()==false) return;
	
		if(mbWiggle) mfWiggleCount += afTimeStep;
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// IMPLEMENTED
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float GetSpeedAdd(cCamera @apCam)
	{	
		mvMoveDirs[mlMoveAddInsertPos] = mvMoveAdd;
		mlMoveAddInsertPos++;

		if(mlMoveAddNum < mvMoveDirs.size()) mlMoveAddNum++;
		if(mlMoveAddInsertPos >= mvMoveDirs.size()) mlMoveAddInsertPos = 0;

		///////////////////////////////
		//Calculate the tangents
		cVector2f vPrevPos = cVector2f(0);
		bool bFirst = true;
		float fProperPosCount =0;

		array<cVector2f> vTanCenterVec; 
		vTanCenterVec.resize(2);
		vTanCenterVec[0] = cVector2f(0); vTanCenterVec[1] = cVector2f(0);
		
		array<cVector2f> vTangent;
		vTangent.resize(2);
		vTangent[0] = cVector2f(0); vTangent[1] = cVector2f(0);
		
		//////////////////////////////////////////
		//Iterate the latest 10 moveadds, get tanget (both dirs) and for each tangent dir calculate
		//prev_pos + tan and add to that tan center vec accu,
		int lCurrent = mlMoveAddInsertPos; //this should be the oldest inser pos once a full circuit is done!
		for(int i=0; i<mlMoveAddNum; ++i)
		{
			cVector2f vNormalPos = mvMoveDirs[lCurrent];
			lCurrent++;
			if(lCurrent >= mvMoveDirs.size()) lCurrent =0;
				
			vNormalPos.Normalize();
			
			if(bFirst)
			{
				bFirst = false;
				vPrevPos = vNormalPos;
				continue;
			}

			cVector2f vDiff = vNormalPos - vPrevPos;
			if(vDiff.Length() < 0.00001f) continue;

			vTangent[0] = cVector2f(vDiff.y, -vDiff.x);
			vTangent[1] = cVector2f(-vDiff.y, vDiff.x);
			
			for(int j=0; j<2; ++j)
			{
				cVector2f vTan = vTangent[j];
				vTan.Normalize();
			
				vTanCenterVec[j] += vPrevPos + vTan;
			}
			
			fProperPosCount += 1;
		}
		
		//The the median tan center vec
		float[] fTanCenterDist = {0,0};
		for(int i=0; i<2; ++i)
		{
			fTanCenterDist[i] = (vTanCenterVec[i] / fProperPosCount).Length();	
		}

		//Get the direction of the rotation and also make sure there is some rotation going on.
		float fDirMul = 1;
		float fMinDist = fTanCenterDist[1];
		if(fTanCenterDist[0] < fTanCenterDist[1])
		{
			fDirMul = -1;
			fMinDist = fTanCenterDist[0];
		}
		//If too far from center, there is no real rotation made, so skip the movement.
		if(fMinDist > 1.25f) return 0;
		
		///////////////////////////////
		//Get the rotate direction based on the pin.
		cCamera @pCam = mBaseObj.mpPlayer.GetCamera();
		
		iPhysicsJoint@ pJoint = cLux_ID_Joint(mJointID);
		cVector3f vFwd = pCam.GetForward();
		cVector3f vPinDir = pJoint.GetPinDir();
		
		if(cMath_Vector3Dot(vPinDir, vFwd) < 0) fDirMul = -fDirMul;

		///////////////////////////////
		//Calculate the speed
		float fLength = mvMoveAdd.Length();
		
		return fDirMul *fLength* 2.5f;
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnExitPressed()
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// CHARACTER CALLBACK
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CharBody_GravityCollide(iCharacterBody@ apCharBody, iPhysicsBody@ apBody, cCollideData @apCollideData)
	{
		
	}
	
	//------------------------------------------------------------
	
	void CharBody_HitGround(iCharacterBody@ apCharBody,const cVector3f &in avVel)
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		iPhysicsBody@ pBody = cLux_ID_Body(mBodyID);
		apSet.DrawFont(tWString("RotSpeed:"+mfRotSpeed), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) );
		afStartY += 14;
		apSet.DrawFont(tWString("Mass:"+pBody.GetMass()), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) );
		afStartY += 14;	
		apSet.DrawFont(tWString("BodyVel:"+pBody.GetAngularVelocity()), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) );
		afStartY += 14;	
		
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	array<cVector2f> mvMoveDirs;
	int mlMoveAddInsertPos;
	int mlMoveAddNum;
	
	bool mbWiggle;
	float mfWiggleCount;
	
	float mfWheelStartAngle;
	bool mbWheelHintGiven;
	tString msWheelName;
	
	//------------------------------------------------------------
		
}