	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// IMPLEMENTED
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float GetSpeedAdd(cCamera @apCam)
	{	
		float fSpeedAdd = 0;
		iPhysicsBody@ pBody = cLux_ID_Body(mBodyID);
		iPhysicsJoint@ pJoint = cLux_ID_Joint(mJointID);

		cVector3f vBodyCenter = cMath_MatrixMul(pBody.GetLocalMatrix(), pBody.GetMassCenter());
		cVector3f vJointToBody =  cMath_Vector3Normalize(vBodyCenter - pJoint.GetPivotPoint());
		cVector3f vJointTurnFwd = cMath_Vector3Cross(pJoint.GetPinDir(), vJointToBody);
					
		cVector3f vUp, vRight;
		if(mlMoveDir==0)
		{
			//X
			fSpeedAdd += cMath_Vector3Dot(vJointTurnFwd, apCam.GetRight()) * mvMoveAdd.x;
			
			//Y
			fSpeedAdd += cMath_Vector3Dot( cMath_Vector3Cross(apCam.GetUp(), vJointToBody), pJoint.GetPinDir()) * mvMoveAdd.y;
		}
		else
		{
			//X
			fSpeedAdd += cMath_Vector3Dot(cVector3f(0,1,0), pJoint.GetPinDir()) * mvMoveAdd.x;
			
			//Y
			fSpeedAdd += cMath_Vector3Dot(vJointTurnFwd, apCam.GetForward()) * -mvMoveAdd.y;
		}
		
		return fSpeedAdd;
	}
	
