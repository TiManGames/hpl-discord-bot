	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnAction(int alAction, bool abPressed)
	{
		if(abPressed==false) return true;
		
		////////////////////////////
		// Physical Interaction
		if(alAction == eAction_Interact)
		{
			if (mvInteractionBlockers.length() > 0)
				return false;
				
			if(mPickBasics.GetFocusedEntity() is null) return false;
			
			//Call entity
			if(mPickBasics.GetFocusedEntity().OnInteract(0, mPickBasics.GetFocusedBody(), mPickBasics.mvFocusPosition, ""))
			{
				//Force saving of entity
				mPickBasics.GetFocusedEntity().SetFullGameSave(true);

				//Event db trigger
				if(EventDB_UseStandardTriggers())
				{
					EventDB_SetGlobalFactString("InteractEntity", mPickBasics.GetFocusedEntity().GetName());
					EventDB_SetGlobalFactString("InteractEntityTag", mPickBasics.GetFocusedEntity().GetEventTag());
					EventDB_SetGlobalFactString("InteractEntityInstanceTag", mPickBasics.GetFocusedEntity().GetEventInstanceTag());
					EventDB_QueryToAll(0, "PlayerInteract");
				}
			}
				
			return false;
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		//////////////
		// Look
		if (alAnalogId == eAnalogType_Look)
		{
			//////////////
			// Clamp yaw to cam limits
			cCamera@ pCam = mBaseObj.mpPlayer.GetCamera();
			iCharacterBody@ pCharBody = mBaseObj.mpPlayer.GetCharacterBody();
			
			float fMinYaw = pCam.GetYawMinLimit();
			float fMaxYaw = pCam.GetYawMaxLimit();
			
			if (fMinYaw != 0.f && fMaxYaw != 0.f)
			{
				float fYaw = cMath_Clamp(pCharBody.GetYaw(), fMinYaw, fMaxYaw);
				pCharBody.SetYaw(fYaw);
			}
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnExitPressed()
	{
		return true;
	}
	
	/////////////////////////////////////////
	// BODY CALLBACKS
