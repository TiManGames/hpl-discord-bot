	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAttachBodyToStickyArea()
	{
		//Do nothing!
	}
	
	void _Global_GetFocusEntityName()
	{
		cScript_SetGlobalReturnString(mPickBasics.msFocusedEntityName);		
	}
	
	void _Global_GetFocusEntityID()
	{
		if (mPickBasics.GetFocusedEntity() !is null)
			cScript_SetGlobalReturnID(mPickBasics.GetFocusedEntity().GetID());	
		else
			cScript_SetGlobalReturnID(tID_Invalid);	
	}
	
	//------------------------------------------------------------
	
	void _Global_SetInteractionAllowed()
	{
		tString sID = cScript_GetGlobalArgString(0);
		bool mbAllowed = cScript_GetGlobalArgBool(1);
		
		int lIx = mvInteractionBlockers.find(sID);
		if (mbAllowed && lIx >= 0)
		{
			mvInteractionBlockers.removeAt(lIx);
		}
		else if (!mbAllowed && lIx < 0)
		{
			mvInteractionBlockers.push_back(sID);
		}
		
		mbUpdateCrosshair = mvInteractionBlockers.length() == 0;
	}
	
	//------------------------------------------------------------
	
	void _Global_GetInteractionAllowed()
	{
		cScript_SetGlobalReturnBool(mvInteractionBlockers.length() == 0);
	}
	
