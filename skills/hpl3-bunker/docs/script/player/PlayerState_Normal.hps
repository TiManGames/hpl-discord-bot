	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		////////////////
		// Early out?
		if (mvInteractionBlockers.length() > 0 && 
			mbUpdateCrosshair == false) 
		{
			return;
		}
		
		bool bShowPickupItemHint = false;
		
		////////////////
		// Update crosshair
		cCamera@ pCam = mBaseObj.mpPlayer.GetCamera();		
		if (pCam !is null && mPickBasics.UpdatePickCheck(pCam, true))
		{
			int lState = mPickBasics.GetFocusedEntity().GetInteractIconId(0, mPickBasics.GetFocusedBody());
			if (lState >= 0)
			{
				Player_SetCrossHairState(eCrossHairState(lState));
				
				if (lState == eCrossHairState_PickUp && mbPickupItemHintShown == false)
					bShowPickupItemHint = true;
			}
			else
			{
				Player_SetCrossHairState(eCrossHairState_Default);
				
			}
		}
		
		////////////////
		// Pickup item hint
		if (bShowPickupItemHint)
		{
			mfShowPickupItemHintCount -= afTimeStep;
			if (mfShowPickupItemHintCount <= 0.f)
			{
				mbPickupItemHintShown = true;
						
				Hint_StopHint();
				Hint_ShowHint_Hold("Hints", "HintPickUpItem", true, 1.5f, true, 15.f);
			}
		}
		else
		{
			mfShowPickupItemHintCount = gfPlayer_PickupItemHintDelay;
		}


		// debug stuff
		/*
		{
			cVector3f vRayStart = pCam.GetPosition();
			cVector3f vRayDir = pCam.GetForward();

			float fDist = 0;
			cVector3f vNorm = 0;
			iPhysicsBody@ pBody = cLux_GetClosestBody(vRayStart, vRayDir, 100, fDist, vNorm);
			if(pBody !is null)
			{
				cVector3f vHitPos = vRayStart + vRayDir * fDist;
				vHitPos += cVector3f_Up * 0.1f;
				cVector3f vPushBack = 0;
				bool bFits = mBaseObj.mpPlayer.GetCharacterBody().CheckCharacterFits(vHitPos, true, 0, vPushBack);
				cColor color = cColor_Red;
				if(bFits)
					color = cColor_Green;
				cLux_AddDebugMessage(pBody.GetName() + " - Dist: " + fDist);
				Debug_DrawSphere(vHitPos, 0.5f, color *2);
				Debug_DrawSphere(vHitPos + vPushBack, 0.4f, color *2);
			}
		}
		*/
	}
	
