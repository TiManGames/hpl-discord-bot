	//------------------------------------------------------------
	
	void _Global_GetIsZoomedIn()
	{
		cScript_SetGlobalReturnBool(mbZoomed);
	}
	
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnAction(int alAction, bool abPressed)
	{
		bool bShowText = alAction == eAction_ShowText;
		
		// If gbReadablesHoldInteract is set, allow releasing the interact
		// button to cancel. So the player needs to hold.
		if (gbReadablesHoldInteract && !abPressed && bShowText)
		{
			LeaveState();
			return false;
		}
		
		if (alAction == eAction_Crouch || alAction == eAction_Jump)
			return false;
		
		if (abPressed && alAction == eAction_Interact && mbAllowExtraZoom)
		{
			mbZoomed = !mbZoomed;

			if (mbZoomed)
			{
				mvTargetCameraPosition = mvZoomedCameraPosition;
			}
			else
			{
				mvTargetCameraPosition = mvCenterCameraPosition;
			}
		}
		
		if (abPressed && !mReadable.IsFading())
		{
			///////////////////////////////
			// SPACE / A
			if (bShowText)
			{
				if (!mReadable.IsShowingText())
				{
					mReadable.ShowText();
					Effect_Shake_EnableAll(false);
				}
				else
				{
					// Increase page num
					if(mReadable.GetPage() < mReadable.GetPageNum())
					{
						mReadable.NextPage();
					}
					else
					{
						mReadable.HideText();
						Effect_Shake_EnableAll(true);
					}
				}
				
				return false;
			}
			
			///////////////////////////////
			// Right click
			if (alAction == eAction_InteractCancel || alAction == eAction_OpenMenu)
			{
				LeaveState();
				return false;
			}
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		//////////////////////
		// Move Camera
		if (alAnalogId == eAnalogType_Move || alAnalogId == eAnalogType_GamepadMove)
		{	
			if (!mbZoomed) return false;
			
			mvCameraMoveDir += avAmount;
			mvCameraMoveDir = cMath_Vector3ClampLength(mvCameraMoveDir, 0, 1.0f);
			return false;
		}
		
		//////////////////////
		// Disable look
		if (alAnalogId == eAnalogType_Look)
		{			
			return false;
		}
		
		//////////////////////
		// Disable lean
		if (alAnalogId == eAnalogType_Lean)
		{			
			return false;
		}
		
		//////////////////////
		// Text scrolling
		if (alAnalogId == eAnalogType_Scroll)
		{
			if (mReadable.IsShowingText())
			{
				return false;
			}
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnExitPressed()
	{
		LeaveState();
		return false;
	}
	
	//------------------------------------------------------------
	
	void LeaveState()
	{
		mbReturnCamera = true;
		
		////////////////////////////////////////
		// Reset camera
		float fSpeedMul = 4.0f;
		cLux_GetPlayer().MoveCameraPosAdd(eCameraAddType_Terminal, cVector3f(0), fSpeedMul * gfHeadMoveAcc, fSpeedMul * gfHeadMoveSpeed, gfHeadMoveSlowdownDist);
		cLux_GetPlayer().StopCameraRotate(0);
		
		//////////////////////////////
		// Fade out text
		mReadable.HideText();
		mReadable.StopReading();
		
//		mBaseObj.mpPlayer.ChangeState(mlPreviousState);
	}
	
	//------------------------------------------------------------
	
	void ExecuteZoomedCallback(int alState)
	{
		if (msZoomedCallback == "") return;
		tString sMethodName = "void " + msZoomedCallback + "(int alState)";
		if (cLux_GetCurrentMap().ScriptMethodExists(sMethodName) && cLux_GetCurrentMap().ScriptPrepare(sMethodName))
		{
			cLux_GetCurrentMap().SetArgInt(0, alState);
			cLux_GetCurrentMap().ScriptExecute();
		}
	}
	
