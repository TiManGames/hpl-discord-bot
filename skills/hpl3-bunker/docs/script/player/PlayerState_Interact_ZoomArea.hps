	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvTargetCameraPosition;
	cVector3f mvCenterCameraPosition;
	cVector3f mvZoomedCameraPosition;
	bool mbReturnCamera = false;
	float mfZoomDistance;
	float mfCurrentCameraSpeed;
	bool mbExit;
	int mlPreviousState;
	bool mbAllowExtraZoom;
	
	bool mbZoomed = false;
	cVector3f mvCameraMoveDir;
	cVector3f mvZoomOffset;
	cVector3f mvZoomMin;
	cVector3f mvZoomMax;
	float mfZoomOffsetFadeInT = 0;
	
	tID mAreaID;
	
	[nosave] cUtility_Readable mReadable;
	tString msGuiFunction;
	tString msZoomedCallback;
	bool mbEnteringState = false;
	
	//------------------------------------------------------------
		
