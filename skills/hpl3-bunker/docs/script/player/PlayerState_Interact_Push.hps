	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		//apSet.DrawFont(tWString("Something:"+mBaseObj.mpPlayer.GetCamera().GetPitch()), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) );
		//afStartY += 14;
						
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbPushAtPoint;
	bool mbCanLeaveState = true;
	float mfForceMul;
	float mfThrowImpulse;
	bool mbLookPushActive = true;
	float mfMaxPlayerSpeedMul = 1.0f;
	float mfMaxPlayerSpeed = 0.f;
	float mfMoveDirChangeCount = 0.f;
	
	float[] mfMaxSpeedInDir={0,0};
	float[] mfTotalMoveMul={0,0};
	float[] mfPrevTotalMoveMul={0,0};
	bool[] mbMoving={false, false};
	
	cVector3f mvLocalAttachPos;
	cVector3f mvPushDir;
	cVector3f mvPrevPushDir;
	cVector3f mvLookAdd;
	cVector3f mvLastForceApplied;
	cVector2f mvYawLimits = 0.f;
