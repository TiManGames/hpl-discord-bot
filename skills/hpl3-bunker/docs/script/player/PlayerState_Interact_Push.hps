	{
		mfForceMul = cScript_GetGlobalArgFloat(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetLastForceApplied()
	{
		cScript_SetGlobalReturnVector3f(mvLastForceApplied);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetCanLeaveState()
	{
		mbCanLeaveState = cScript_GetGlobalArgBool(0);
