	int mlPreviousState;
	
	bool mbAnimationOver;
	
	float mfElapsedTime;
	float mfFadeTime;
	
	float mfSpeed;
	float mfWantedSpeed;
	float mfPrevWantedSpeed;
	float mfSpeedAddRate;
	
	float mfInteractiveMinT;
	float mfInteractiveMaxT;
	bool mbInteractiveRangeSetup;
	tString msInteractiveRangeCallback;
	
	bool mbAutoReverse;
	bool mbExitAtStart;
	bool mbExitAtEnd;
	
	bool mbSideAnimsOnly;
	tString msPlayerLeftAnim;
	tString msPlayerRightAnim;
	
	bool mbLoop;
	bool mbAnyInputDir;
	
	tString msPlayerAnim;
	
	tString msPlayerStartIdleAnim;
	bool mbPlayerStartIdleAnimSetup;
	
	bool mbAnimationEntitySetup;
	tString msEntityAnim;	
	tID m_idAnimEntity;
	
	int mlCurrCheckpoint;
	int mlTarCheckpoint;
	bool mbCheckpointsSetup;
	float mfInteractCount;	
	array<float> mvCheckpoints;
	
	float mfHintCount;
	bool mbAllowHint = true;
	
	bool mbWithinInteractiveRange;
	
	tString msInteractCallback;
	cUtility_PickBasics mPickBasics;
	
	//------------------------------------------------------------
}