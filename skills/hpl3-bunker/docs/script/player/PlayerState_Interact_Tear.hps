	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		apSet.DrawFont(tWString("mfHealth: "+mfHealth), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) );
		afStartY += 14;
		apSet.DrawFont(tWString("mfTearSpeed: "+mfTearSpeed), apFont, cVector3f(5,afStartY,0), cVector2f(14), cColor(1,1) );
		afStartY += 14;
		
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
		
	//------------------------------------------------------------
	
	float mfMoveSpeedFactor;
	float mfMoveSlowDownSpeed;
	float mfPlayerMoveSpeedMul;
	float mfHealthLossFactor;
	
	int mlJointIndex;
	bool mbHasGravity;

	float mfMaxDistance;
	float mfHealth;
	
	bool mbHealthTearOnly;
	bool mbCanBeTorn;

	cVector3f mvJointRight;
	cVector3f mvJointForward;
	
	cVector2f mvMoveAdd;
	
	float mfTearSpeed;
	float mfPrevAngle;
	
	eTearType mTearType;
    
    tString msTearPropName;
			
	//------------------------------------------------------------
	
}