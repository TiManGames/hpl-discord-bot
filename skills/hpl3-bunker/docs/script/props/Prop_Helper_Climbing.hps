
class cProp_Helper_Climbing
{
	//---------------------------------------------------
	
	void Init()
	{
		mfCanBeClimbedCount = 0;
		mbPlayerClimbCollides = false;
	}
	
	//---------------------------------------------------
		
	void LoadVariables(cResourceVarsObject @apVars)
	{
		mbClimb_Active = apVars.GetVarBool("Climb_Active", false);
		mbClimb_MustBeUp = apVars.GetVarBool("Climb_MustBeUp", false);

		mBaseObj.SetAutoSleep(mbClimb_Active == false);
	}
	
	//---------------------------------------------------
	
	void Update(float afTimeStep, iPhysicsBody@ apBody)
	{
		if(mbClimb_Active==false) return;
		
		///////////////////////////////////////
		// Climb check
		mfCanBeClimbedCount += afTimeStep;
		if(mfCanBeClimbedCount<0.1 && mbPlayerClimbCollides==false) return;
		
		mfCanBeClimbedCount =0;
		mbPlayerClimbCollides = false;
		
		if(cScript_GetGlobalVarBool("Climb_Allowed")==false) return; //Check if allowed at all.
			
		iCharacterBody @pCharBody = cLux_GetPlayer().GetCharacterBody();
		cBoundingVolume@ pBV = apBody.GetBoundingVolume();
		
		///////////////////////////////
		// Feet pos not to hight up!
		// TODO: Need to be some dummy entity saying where the max is!
		float fTopY = pBV.GetWorldCenter().y +  pBV.GetSize().y/2;
		float fMaxY = fTopY - 0.1f;
		float fMinY = pBV.GetWorldCenter().y - pBV.GetSize().y/2 - 0.2;
		
		float fFeetY = pCharBody.GetFeetPosition().y;
		
		if(fMaxY < fFeetY || fMinY > fFeetY)
		{
			return;
		}
			
		///////////////////////////////
		// Check frustum
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		if(pCam.GetFrustum().CollideBoundingVolume(apBody.GetBoundingVolume())==eCollision_Outside)
		{
			return;
		}
			
		///////////////////////////////
		// Check collision
		cBoundingVolume@ pCharBV = pCharBody.GetCurrentBody().GetBoundingVolume();
				
		cVector3f vBigMin = pBV.GetMin(); vBigMin.x -= 0.15f; vBigMin.z -= 0.15f;
		cVector3f vBigMax = pBV.GetMax(); vBigMax.x += 0.15f; vBigMax.z += 0.15f;
				
		if(cMath_CheckAABBIntersection(pCharBV.GetMin(), pCharBV.GetMax(), vBigMin, vBigMax)==false)
		{
			return;
		}
		
		///////////////////////////////
		// Check if up (in case needed)
		if(mbClimb_MustBeUp)
		{
			cMatrixf mtxInv = cMath_MatrixInverse(apBody.GetLocalMatrix());
			
			if(cMath_Vector3Angle(mtxInv.GetUp(), cVector3f(0,1,0)) > cMath_ToRad(10))
			{
				return;
			}
		}
	
		
		///////////////////////////////
		// Check angle
		cVector3f vDirection = pBV.GetWorldCenter() - pCam.GetPosition();
		vDirection.y =0; vDirection.Normalize();
		
		cVector3f vFwd2D = pCam.GetForward(); vFwd2D.y=0; vFwd2D.Normalize();
		
		float fAngle = cMath_Vector3Angle(vFwd2D, vDirection);
		if(fAngle > cMath_PiDiv4) return;
		
		
		/////////////////////////////////////////
		// Set up variables
		mbPlayerClimbCollides = true;
		
		cScript_SetGlobalVarBool("Climb_ForceCrouch",false);
		cScript_SetGlobalVarVector3f("Climb_Direction", vDirection);
		
		//Feet position should be pretty close to the player
		cVector3f vFeetPos = pBV.GetWorldCenter()*0.5f + pCharBody.GetPosition()*0.5f;
							
		vFeetPos.y = fTopY; //This puts the feet position at top.
		cScript_SetGlobalVarVector3f("Climb_FeetPos",vFeetPos);
	}
	
	//---------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
		if(mbPlayerClimbCollides)
		{
			cScript_SetGlobalVarInt("PlayerPhysicalAction", ePhysicalAction_Climb);
		}
	}

	//---------------------------------------------------
	
	[nosave] bool mbClimb_Active;
	[nosave] bool mbClimb_MustBeUp;
	
	//---------------------------------------------------
	
	float mfCanBeClimbedCount;
	bool mbPlayerClimbCollides;
	
	//---------------------------------------------------
	
}
