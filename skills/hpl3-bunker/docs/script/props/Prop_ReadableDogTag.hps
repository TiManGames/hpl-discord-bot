	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		//if(ToolHandler_GetPlayerCarriesHeavyTool()) return false;
		
		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();

		bool bCanInteract = (cLux_GetPlayer().GetCurrentStateName() == "State_InteractiveCutsceneAnimation") ? true : pCharBody.IsOnGround();
		
		return bCanInteract;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{	
		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
		if(pCharBody.IsOnGround() == false) return false;
	
		//////////////////////////////////
		// Set up the created entity
		if (mpOpenEntity is null)
		{
			cLux_GetCurrentMap().CreateEntity(GetBase().GetName() + "_open", msOpenEntityFile, cMatrixf_Identity, cVector3f(1));
			@mpOpenEntity = cLux_GetCurrentMap().GetLatestEntity();
			for (int i = 0; i < mpOpenEntity.GetBodyNum(); i++)
			{
				iPhysicsBody@ pBody = mpOpenEntity.GetBody(i);
				pBody.SetCollideCharacter(false);
				pBody.SetCollide(false);
				pBody.SetCollideRagDoll(false);
				pBody.SetMass(0);
			}

			mpOpenEntity.SetActive(false);
			cLux_ToProp(mpOpenEntity).SetAllowMapTransfer(false);
			
			SetupReadableCode();
		}

		/////////////////////
		// Fade fov		
		cLux_GetPlayer().FadeCameraFOVTo(mfFOV, 1.0f);
		
		//////////////////////////////////
		// Set up the created entity
		cScript_RunGlobalFunc(mpOpenEntity.GetName(), "", "_Global_SetIsHudVersion");
		mpOpenEntity.SetVarBool("IsHUDVersion", true);
		
		//////////////////////////////////
		// Set up and call the interact state
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); //Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); //Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);//The grab postion
		cScript_SetGlobalArgID(3, mpOpenEntity.GetID()); //Open entity object ID
		
		//Sketchbook_GetNoteData(msNameID, msTextCategory, msVoiceSubject, msFrontTextEntry, msBackTextEntry);
		//Sketchbook_AddNoteByID(msNameID);

		cScript_SetGlobalArgString(4, msTextCategory); //Contents categories
		cScript_SetGlobalArgString(5, msFrontTextEntry); //Contents entries
		cScript_SetGlobalArgString(6, msBackTextEntry); //Contents entries
		cScript_SetGlobalArgString(7, ""); //Title (not used)

		cScript_SetGlobalArgFloat(9, mfDistanceFromCamera); //Target prop distance from camera
		cScript_SetGlobalArgFloat(10, mfYStartOffset); //Start offset along the camera's Y axis.
		cScript_SetGlobalArgString(11, msOpenSound); //Sound played when interaction starts
		cScript_SetGlobalArgString(12, msCloseSound); //Sound played when interaction ends
		cScript_SetGlobalArgString(13, msCloseCallback); //Callback called when interaction ends.
		cScript_SetGlobalArgString(14, msVoiceSubject); //Voice subject to play on interaction
		cScript_SetGlobalArgString(15, msHighResMaterial); //High res material of the readable
		cScript_SetGlobalArgFloat(16, mfNoteScale); // Allow tweaking of pop-up version
		cScript_SetGlobalArgFloat(17, mfNoteYOffs); // Allow tweaking of pop-up version
		
		cScript_RunGlobalFunc("State_Interact_ReadDogTag", "", "SetupReading");
		cLux_GetPlayer().ChangeState(ePlayerState_Custom_ReadDogTag);
		
		return false;
	}
	
	void SetupReadableCode()
	{
		if (msCombination == "") return;
		
		cMeshEntity@ pMeshEnt = mpOpenEntity.GetMeshEntity();
		if (pMeshEnt is null) return;
		
		cMesh@ pMesh = pMeshEnt.GetMesh();
		for (int i = 0; i < 4; i++)
		{
			tString sDigit = cString_Sub(msCombination, i, 1);
			Prop_SetCustomMaterial(mpOpenEntity.GetName(), "dogtag_number_0"+sDigit+".mat", "dogtag_number_p"+(i+1));
		}
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Read;
	}
	
	
