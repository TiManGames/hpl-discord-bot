	//------------------------------------------------------------
	
	// Callback from Readable state
	void _Global_OnItemRead()
	{
		if(!mbIsRead)
		{
			if (msNameID != "" && msCombination != "") 
			{
				Sketchbook_AddCode(msNameID, msCombination);
				//Hint_StopHint(0.1);
				//Hint_ShowHint("Hints", "HintCodes");
				Hint_StopHint();
				Hint_ShowHint_Hold("Hints", "HintCodes", false, 1.5f, true, 10.f);
			}
				
			////////////////////////////////
			// Runs AddCode callback if it exists.
			cLuxMap@ pMap = cLux_GetCurrentMap();
			if(msAddCodeCallback != "" && pMap.ScriptPrepare("void " + msAddCodeCallback + "(const tString &in asEntity, const tString&in asNameID, const tString&in asCombination)"))
			{
				tString entityName = mBaseObj.GetName();
				pMap.SetArgString(0, entityName);
				pMap.SetArgString(1, msNameID);
				pMap.SetArgString(2, msCombination);
				pMap.ScriptExecute();
			}
		}
		
		mbIsRead = true;
		GetBase().SetActive(false);
	}
	
	//------------------------------------------------------------

	void _Global_GetItemRead()
	{
		cScript_SetGlobalReturnBool(mbIsRead);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetHasCode()
	{
		cScript_SetGlobalReturnBool((msNameID != "" && msCombination != ""));
	}

	//------------------------------------------------------------
	
	void _Global_SetCloseCallback()
	{
		msCloseCallback = cScript_GetGlobalArgString(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetOpenEntityFile()
	{
		tString sNewEntityFile = cScript_GetGlobalArgString(0);
		if (msOpenEntityFile == sNewEntityFile)
			return;
		
		if (mpOpenEntity != null)
		{
			cLux_GetCurrentMap().DestroyEntity(mpOpenEntity);
			@mpOpenEntity = null;
		}
		
		msOpenEntityFile = sNewEntityFile;
	}
	
	//------------------------------------------------------------
	
	void _Global_GetCanBeHighlighted()
	{
		cScript_SetGlobalReturnBool(mbIsRead == false && mBaseObj.IsInteractedWith()==false && mbIsHudVersion==false);
	}
	
	//------------------------------------------------------------
	
	
	void _Global_SetIsHudVersion()
	{
		mbIsHudVersion = true;
	}
	
	//------------------------------------------------------------
	
	void _Global_SetEntries()
	{
		msTextCategory = cScript_GetGlobalArgString(0);
		msFrontTextEntry = cScript_GetGlobalArgString(1);
		msBackTextEntry = cScript_GetGlobalArgString(2);
		msTitleEntry = cScript_GetGlobalArgString(3);
	}
		
	//------------------------------------------------------------
	
	void _Global_GetIsRandomizeable()
	{
		cScript_SetGlobalReturnBool(mbRandomizeable);
	}
		
	//------------------------------------------------------------
	
	void _Global_SetCombination()
	{
		msCombination = cString_ToString(cScript_GetGlobalArgInt(0), 4);
	}
		
