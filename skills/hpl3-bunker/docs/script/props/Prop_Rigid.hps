#include "interfaces/Prop_Interface.hps"
#include "base/Player_Types.hps"
#include "helpers/helper_components_custom.hps"


class cScrPropRigid : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	
	void Init()
	{
		mbCanInteractWithoutCallback = false;
		mbCanInteractOnlyWithMainBody = false;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		mbCanInteractOnlyWithMainBody = apVars.GetVarBool("InteractOnlyWithMainBody", false);
		mCustomInteractIcon = PlayerTypes_StringToCrossHairState(apInstanceVars.GetVarString("CustomInteractIcon", "None"));
		mbCanInteractWithoutCallback = apInstanceVars.GetVarBool("CanInteractWithoutCallback",false);
		msOnBreakDeactivateEnts = apInstanceVars.GetVarString("OnBreakDeactivateEnts", "");
		
		/////////////
		// Wooden Breakable
		@mpWoodenBreakableComponent = UserComponent_WoodenBreakableComponent_Create(mBaseObj);
		mpWoodenBreakableComponent.SetMainBody(mBaseObj.GetMainBody());
		mpWoodenBreakableComponent.SetupAfterLoad(apWorld, apVars, apInstanceVars);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	/*void OnUpdate(float afTimeStep)
	{
		//mClimbHelper.Update(afTimeStep, mBaseObj.GetMainBody());
	}*/
	
	//------------------------------------------------------------
	
	/*void OnPostUpdate(float afTimeStep)
	{
		//mClimbHelper.PostUpdate(afTimeStep);
	}*/
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
		mpWoodenBreakableComponent.ResetProperties();
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
		mpWoodenBreakableComponent.BeforeEntityDestruction();
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
	
	//------------------------------------------------------------
	
	/*bool OnUpdateAutoSleep()
	{
		return true;
	}*/
		
	//------------------------------------------------------------
	
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBodyHit, const cVector3f&in avOrigin, const cVector3f&in avHitPos, cLuxDamageProperties@ apDamageProps)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
		mpWoodenBreakableComponent.OnHealthChange();
		
		///////////////////////
		// Deactiavte entities
		if (mBaseObj.GetHealth() <= 0.f && 
			msOnBreakDeactivateEnts != "")
		{
			array<tString> vEntNames;
			cString_GetStringVec(msOnBreakDeactivateEnts, vEntNames, ", ");
			
			for (int i=0; i<vEntNames.size(); i++)
			{
				Entity_SetActive(vEntNames[i], false);
			}
		}
	}
	
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in apContactData)
	{
		mpWoodenBreakableComponent.OnPhysicsCollision(apBody, apCollideBody, apContactData);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if (mbCanInteractOnlyWithMainBody && apBody !is mBaseObj.GetMainBody())							return false;
		if (mBaseObj.HasPlayerInteractCallback() == false && mbCanInteractWithoutCallback == false)		return false;
		
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return mBaseObj.HasPlayerInteractCallback() || mbCanInteractWithoutCallback;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		if(mBaseObj.HasPlayerInteractCallback() || mbCanInteractWithoutCallback)
			return mCustomInteractIcon;
		return eCrossHairState_Default;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// SPECIFIC ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_SetCustomInteractIcon()
	{
		mCustomInteractIcon = eCrossHairState(cScript_GetGlobalArgInt(0));
	}
			
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	[nosave] tString msOnBreakDeactivateEnts;
	[nosave] bool mbCanInteractOnlyWithMainBody;
	eCrossHairState mCustomInteractIcon;	
	bool mbCanInteractWithoutCallback;
	
	[volatile] iScrWoodenBreakableComponent_Interface@ mpWoodenBreakableComponent = null;
	
	//------------------------------------------------------------
}	