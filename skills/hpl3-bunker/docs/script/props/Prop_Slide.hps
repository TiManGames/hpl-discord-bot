    [nosave] float mfMaxDistance;
	
	float mfSlideMaxSpeed;
	[nosave] float mfSlideSlowDownFactor;
	[nosave] float mfSlideSpeedFactor;
	[nosave] float mfAutoOpenAmount;
	[nosave] bool mbAutoOpen;
	[nosave] tString msLockOnSound;
	[nosave] tString msLockOffSound;
	[nosave] tString msInteractLockedSound;
	[nosave] tString msInteractJammedSound;
	[nosave] tString msOpenSound;
	[nosave] float mfOpenSoundMinSpeed;
	[nosave] tString msCloseSound;
	[nosave] float mfCloseSoundMinSpeed;
	[nosave] tString msGrabStartSound;
	[nosave] tString msGrabEndSound;
	[nosave] float mfSlidePadMultiplier;
	[nosave] eCrossHairState mCustomInteractIcon;

	cVector3f mvInitialPosition;

	//------------------------------------------------------------
	
	int mlAutoMoving;
	float mfAutoMoveTarget;
	bool mbLocked;
	bool mbJammed;
	int mlCurrentState = 0;
	
	bool mbFirstInteract=true;
	
	float mfMaxOpenAmount;
	float mfInteractSoundCount;
	
	bool mbInteractConnectionMovementActive;
	
	[volatile] iScrWoodenBreakableComponent_Interface@ mpWoodenBreakableComponent = null;
	[nosave] tString msOnBreakDeactivateEnts;
		
