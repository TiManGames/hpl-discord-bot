	//-----------------------------------------------------------

	void _Global_SetForceMul()
	{
		mfGrab_ForceMul = cScript_GetGlobalArgFloat(0);
		
		mBaseObj.SetSaveDataIsUpdated(true);
		
		// Are we currently grabbing a prop?
		cLuxProp@ pProp = Grab_GetGrabbedProp();
		if (pProp==null)
			return;
			
		// Is it this prop?
		if (pProp.GetID() == mBaseObj.GetID())
		{
			// Update the forcemul used by the current grab
			cScript_SetGlobalArgFloat(0, mfGrab_ForceMul);
			cScript_RunGlobalFunc("State_Interact_Grab", "", "_Global_SetForceMul");
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBodyHit, const cVector3f&in avOrigin, const cVector3f&in avHitPos, cLuxDamageProperties@ apDamageProps)
	{
	}
	
	//------------------------------------------------------------
	
