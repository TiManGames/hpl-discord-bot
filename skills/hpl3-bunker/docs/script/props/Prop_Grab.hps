	[nosave] cVector3f mvGrab_CostumRotationOffset;
	[nosave] bool mbGrab_UseCustomDepth;
	[nosave] float mfGrab_CustomDepth;
	[nosave] float mfGrab_MassMul;
	[nosave] float mfGrab_MinDepth;
	[nosave] float mfGrab_MaxDepth;
	[nosave] float mfGrab_ForceMul;
	[nosave] float mfGrab_TorqueMul;
	[nosave] float mfGrab_ThrowImpulse;
	[nosave] bool mbGrab_IsHeavy;
	[nosave] bool mbGrab_CollisionWithPlayer;
	[nosave] bool mbGrab_InteractOnlyWithMainBody;
	[nosave] bool mbGrab_CanInteractWithNoMass;
	[nosave] bool mbGrab_LowerMass;
	
	//////////////////////
	// Readable
	[nosave] tString msTextCategory;
	[nosave] tString msFrontTextEntry;
	[nosave] tString msBackTextEntry;
	[nosave] float mfTextRotateOffset;
	
	//------------------------------------------------------------
	
	bool mbInteractDisablesStaticPhysics = false;
