	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		mBaseObj.EnableBodyCollisionCallback(); //This so that we generate collide events.
		
		mbGrab_UseCustomOffset = apVars.GetVarBool("Grab_UseCustomOffset", false);
		mvGrab_CostumPositionOffset = apVars.GetVarVector3f("Grab_CustomPositionOffset", cVector3f(0,0,0));
		mvGrab_CostumRotationOffset = apVars.GetVarVector3f("Grab_CustomRotationOffset", cVector3f(0,0,0));
		mbGrab_UseCustomDepth = apVars.GetVarBool("Grab_UseCustomDepth", false);
		mfGrab_CustomDepth = apVars.GetVarFloat("Grab_CustomDepth", 0);
		mfGrab_MassMul = apVars.GetVarFloat("Grab_MassMul", 0);
		mfGrab_MinDepth = apVars.GetVarFloat("Grab_MinDepth", 0);
		mfGrab_MaxDepth = apVars.GetVarFloat("Grab_MaxDepth", 0);
		mfGrab_ForceMul = apVars.GetVarFloat("Grab_ForceMul", 0);
		mfGrab_TorqueMul = apVars.GetVarFloat("Grab_TorqueMul", 0);
		mfGrab_ThrowImpulse = apVars.GetVarFloat("Grab_ThrowImpulse", 5.0f);
		mbGrab_IsHeavy = apVars.GetVarBool("Grab_IsHeavy", false);
		mbGrab_CollisionWithPlayer = apVars.GetVarBool("Grab_CollisionWithPlayer", false);
		mbGrab_InteractOnlyWithMainBody = apVars.GetVarBool("Grab_InteractOnlyWithMainBody", false);
		mbGrab_CanInteractWithNoMass = apVars.GetVarBool("Grab_CanInteractWithNoMass", false); 
		mbGrab_LowerMass = apVars.GetVarBool("Grab_LowerMass", true); 
		
		//////////////////////
		// Readable
		msTextCategory = apVars.GetVarString("TextCategory", "");
		msFrontTextEntry = apVars.GetVarString("FrontTextEntry", "");
		msBackTextEntry = apVars.GetVarString("BackTextEntry", "");
		mfTextRotateOffset = apVars.GetVarFloat("TextRotateOffset", 0.0f);
		if(apInstanceVars.GetVarString("TextCategory", "") != "")
			msTextCategory = apInstanceVars.GetVarString("TextCategory", "");
		if(apInstanceVars.GetVarString("FrontTextEntry", "") != "")
			msFrontTextEntry = apInstanceVars.GetVarString("FrontTextEntry", "");
		if(apInstanceVars.GetVarString("BackTextEntry", "") != "")
			msBackTextEntry = apInstanceVars.GetVarString("BackTextEntry", "");
			
		//mClimbHelper.LoadVariables(apVars);
		
		mbInteractDisablesStaticPhysics = apInstanceVars.GetVarBool("InteractDisablesStaticPhysics", false);
		
		//mBaseObj.SetSaveDataIsUpdated(false);
		
		//mBaseObj.SetFullGameSave(true);
		
		mBaseObj.SetAllowMapTransfer(true);
		
		/////////////
		// Wooden Breakable
		@mpWoodenBreakableComponent = UserComponent_WoodenBreakableComponent_Create(mBaseObj);
		mpWoodenBreakableComponent.SetMainBody(mBaseObj.GetMainBody());
		mpWoodenBreakableComponent.SetupAfterLoad(apWorld, apVars, apInstanceVars);
	}
	
