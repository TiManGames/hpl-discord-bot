#include "interfaces/Area_Interface.hps"
#include "player/Player_Types.hps"

class cScrAreaClimb : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mBaseObj.SetAutoSleep(true);
		mBaseObj.SetMaxInteractDistance(1);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		mbCrouch = apVars.GetVarBool("Crouch", false);
		msFeetPosition = apVars.GetVarString("FeetPosition", "");
		mbCanBeClimbed = apVars.GetVarBool("CanBeClimbed",true);
		
		mBaseObj.SetCheckCollision(false);
	}
	
	
	void OnAfterWorldLoad()
	{
		if(msFeetPosition != "")
		{
			iLuxEntity@ pArea = mBaseObj.GetMap().GetEntityByName(msFeetPosition, eLuxEntityType_Area);
			if(pArea !is null)
				m_idFeetPositionArea = pArea.GetID();
			else
				Error("Cannot find feet area area'"+msFeetPosition+"' for climb area '"+mBaseObj.GetName()+"'");
		}
	}		
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if(mbCanBeClimbed==false) return false;
		
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		cVector3f vFwd2D = pCam.GetForward(); vFwd2D.y=0; vFwd2D.Normalize();
		
		cMatrixf mtxInv = cMath_MatrixInverse(mBaseObj.GetAreaBody().GetLocalMatrix());
		cVector3f vDirection = mtxInv.GetForward();
		
		float fDir = cMath_Vector3Dot(vDirection, vFwd2D);
		
		return fDir<-0.5f;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		///////////////////////////////
		//Set up arguments
		cScript_SetGlobalArgVector3f(0, cLux_ID_Entity(m_idFeetPositionArea).GetPosition());
		cScript_SetGlobalArgBool(1, mbCrouch);
		
		cMatrixf mtxInv = cMath_MatrixInverse(mBaseObj.GetAreaBody().GetLocalMatrix());
		cScript_SetGlobalArgVector3f(2, mtxInv.GetForward());
		
		cScript_SetGlobalArgVector3f(3, mBaseObj.GetPosition());
		
		///////////////////////////////
		//Call the function
		cScript_RunGlobalFunc("State_ClimbLedge", "", "SetupClimbLedge");
		
		cLux_GetPlayer().ChangeState(ePlayerState_ClimbLedge);	
		
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_ClimbLedge;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimteStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
		
		mbCanBeClimbed = alState==1;
	}
	
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbCrouch;
	tString msFeetPosition;
	tID m_idFeetPositionArea = tID_Invalid;
	
	bool mbCanBeClimbed;
	
	//------------------------------------------------------------
		
}	