#include "interfaces/Area_Interface.hps"
#include "player/player_types.hps"

class cScrAreaInteractAux : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		msInteractParent = apVars.GetVarString("InteractParent", "");
		mbOverrideParentMainBody = apVars.GetVarBool("OverrideParentMainBody",false);
		mbPassMainBody = apVars.GetVarBool("UseParentMainBody",true);
		mbDeactivateOnInteract = apVars.GetVarBool("DeactivateOnInteract",false);
		
		float fMaxInteractDist = apVars.GetVarFloat("MaxFocusDistance", -1);
		if(fMaxInteractDist>=0) mBaseObj.SetMaxInteractDistance(fMaxInteractDist);
		
		mbUseCustomInteractIcon = apVars.GetVarBool("UseCustomInteractIcon", false);
		
		if (mbUseCustomInteractIcon)
		{
			tString sCustomInteractIcon = apVars.GetVarString("CustomInteractIcon", "Default");
			mCustomInteractIcon = PlayerTypes_StringToCrossHairState(sCustomInteractIcon);
		}
		else
		{
			mCustomInteractIcon = eCrossHairState_Default;
		}
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad()
	{
		if(msInteractParent != "")
		{
			iLuxEntity @pEntity = mBaseObj.GetMap().GetEntityByName(msInteractParent);
			if(pEntity is null)
			{
				Error("Entity '"+msInteractParent+"' used by InteractAux '"+mBaseObj.GetName()+"' does not exist!");
				return;
			}
			
			m_idInteractParent = pEntity.GetID();
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		iLuxEntity@ pInteractEntity = cLux_ID_Entity(m_idInteractParent);
		if (pInteractEntity is null)
			return false;
		
		if (pInteractEntity.GetInteractionDisabled() && mbOverrideParentMainBody == false)
			return false;

		if (mbPassMainBody)
			@apBody = pInteractEntity.GetMainBody();
			
		// Hacky fix for GDC to make levers work!
		cScript_SetGlobalVarBool("UsingInteractAuxArea",true);
		bool bCanInteract = pInteractEntity.CanInteract(alType, apBody);
		cScript_SetGlobalVarBool("UsingInteractAuxArea",false);
		return bCanInteract;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		iLuxEntity@ pInteractEntity = cLux_ID_Entity(m_idInteractParent);
		if (pInteractEntity.GetInteractionDisabled() && mbOverrideParentMainBody == false)
			return false;
			
			
		if (mbPassMainBody)
			@apBody = pInteractEntity.GetMainBody();
		if (mbDeactivateOnInteract)
			mBaseObj.SetActive(false);
		return pInteractEntity.OnInteract(alType, apBody, avFocusPos, asData);
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{		
		if (mbUseCustomInteractIcon)
		{
			return mCustomInteractIcon;
		}
		else
		{
			iLuxEntity@ pInteractEntity = cLux_ID_Entity(m_idInteractParent);
			if (mbPassMainBody)
				@apBody = pInteractEntity.GetMainBody();
				
			return pInteractEntity.GetInteractIconId(alType, apBody);
		}
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void _Global_GetInteractParent()
	{
		cScript_SetGlobalReturnString(msInteractParent);
	}
	
	//-----------------------------------------------------------------------
	
	void _Global_SetInteractParent()
	{
		msInteractParent = cScript_GetGlobalArgString(0);
		
		if(msInteractParent != "")
		{
			iLuxEntity @pEntity = mBaseObj.GetMap().GetEntityByName(msInteractParent);
			if(pEntity is null)
			{
				Error("Entity '"+msInteractParent+"' used by InteractAux '"+mBaseObj.GetName()+"' does not exist!");
				return;
			}
			
			m_idInteractParent = pEntity.GetID();
		}
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimteStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tString msInteractParent;
	tID m_idInteractParent;
	bool mbOverrideParentMainBody;
	bool mbPassMainBody;
	bool mbDeactivateOnInteract;
	bool mbUseCustomInteractIcon;
	eCrossHairState mCustomInteractIcon;
	
	//------------------------------------------------------------
		
}	