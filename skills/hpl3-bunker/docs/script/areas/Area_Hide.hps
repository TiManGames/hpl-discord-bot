#include "interfaces/Area_Interface.hps"
#include "helpers/helper_player.hps"

//------------------------------------------------------------

class cScrAreaHide: iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	

	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mbPlayerIsInside = false;

		mBaseObj.SetAutoSleep(false);
		mBaseObj.SetVariableUpdateRate(cMath_RandRectf(0.25f, 0.35f)); //call variable update no faster than once per 0.3 sec
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{			
		mlPrio = apVars.GetVarInt("Prio", 0);
		mbRequiresCrouch = apVars.GetVarBool("RequiresCrouch", true);
		
		tString sConnectedProp = apVars.GetVarString("ConnectedProp", "");
		cLuxProp@ pProp = cLux_ToProp(mBaseObj.GetMap().GetEntityByName(sConnectedProp, eLuxEntityType_Prop));
		m_idConnectedProp = pProp !is null ? pProp.GetID() : tID_Invalid;
		
		mlKillAnimDir = StringToAxis(apVars.GetVarString("KillAnimDir", "Z"));
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep)
	{	
		/////////////////
		// Deactivate if prop is inactive/doesn't exist
		cLuxProp@ pProp = cLux_ID_Prop(m_idConnectedProp);
		bool bDeactivate = (pProp !is null && pProp.IsActive() == false) ||
						   (pProp is null && m_idConnectedProp != tID_Invalid);
		
		/////////////////
		// Check player collision
		bool bCollide = false;
		if (bDeactivate == false)
			bCollide = mBaseObj.CheckCharacterCollision(cLux_GetPlayer().GetCharacterBody(), mBaseObj.GetMap());
				
		/////////////////
		// Player enters
		if (bCollide && mbPlayerIsInside == false && bDeactivate == false)
		{
			cScript_SetGlobalArgID(0, mBaseObj.GetID());
			cScript_SetGlobalArgInt(1, mlPrio);
			cScript_SetGlobalArgBool(2, mbRequiresCrouch);
			cScript_SetGlobalArgID(3, m_idConnectedProp);
			cScript_SetGlobalArgInt(4, mlKillAnimDir);
			cScript_RunGlobalFunc("LuxPlayer", "", "_Global_AddHideArea");
		}
		
		/////////////////
		// Player leaves
		else if ((bCollide == false && mbPlayerIsInside) || bDeactivate)
		{
			cScript_SetGlobalArgID(0, mBaseObj.GetID());
			cScript_RunGlobalFunc("LuxPlayer", "", "_Global_RemoveHideArea");
		}		
		
		/////////////////
		// Update state
		mbPlayerIsInside = bCollide;
		
		if (bDeactivate)
			mBaseObj.SetActive(false);
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
	
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if (alState == 0) return;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	eAxis3D StringToAxis(const tString &in asAxis)
	{
		tString sLowAxis = cString_ToLowerCase(asAxis);

		if(sLowAxis == "x") return eAxis3D_X;
		if(sLowAxis == "y") return eAxis3D_Y;
		if(sLowAxis == "z") return eAxis3D_Z;

		Error("Axis " + asAxis + " does not exist!");

		return eAxis3D_LastEnum;
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_GetConectedPropID()
	{
		cScript_SetGlobalReturnID(m_idConnectedProp);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont, float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlPrio;
	bool mbRequiresCrouch;
	bool mbPlayerIsInside;
	int mlKillAnimDir;
	tID m_idConnectedProp;
	
	//------------------------------------------------------------
}	