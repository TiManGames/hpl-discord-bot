#include "interfaces/Area_Interface.hps"
#include "helpers/helper_player.hps"

class cScrAreaCrawl: iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mbPlayerIsInside = false;
		mBaseObj.SetAutoSleep(false);
		mBaseObj.SetVariableUpdateRate(cMath_RandRectf(0.3f, 0.45f)); //call variable update no faster than once per 0.3 sec
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
        mbCrouch = apVars.GetVarBool("Crouch", false);
		mbAllowJump = apVars.GetVarBool("AllowJump", false);
		mbRestoreJumpAfterExit = apVars.GetVarBool("AllowJumpAfterExit", true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep)
	{		
		bool bCollide = mBaseObj.CheckCharacterCollision(cLux_GetPlayer().GetCharacterBody(), cLux_GetCurrentMap());
		
		int lState = cLux_GetPlayer().GetCurrentStateId();
		if(	cLux_GetPlayer().IsActive() == false ||
			lState == ePlayerState_ClimbLedge ||
			lState == ePlayerState_Ladder)
		{
			bCollide =false;
		}
		
		//////////////////////////////
		// Player Enters
		if(bCollide && mbPlayerIsInside==false)
		{
			cScript_RunGlobalFunc("MoveState_Normal", "", "_Global_IncCrawlAreaCount");	
			
            if (mbCrouch)
            {
                Player_SetStandDisabled(true);
            }
            else
            {
                Player_IncCrawlCount();
            }
			
			// Toggle jump based on checkbox in editor
			Player_SetJumpDisabled(!mbAllowJump);
			
		}
		//////////////////////////////
		// Player Exits
		else if(bCollide==false && mbPlayerIsInside)
		{
			cScript_RunGlobalFunc("MoveState_Normal", "", "_Global_DecCrawlAreaCount");				
			cScript_RunGlobalFunc("MoveState_Normal", "", "_Global_GetCrawlAreaCount");
			int lCount = cScript_GetGlobalReturnInt();
			
			//////////////////////////
			// Only reset state if player isn't in any area!
			if (lCount == 0)
			{
				if (mbCrouch)
				{
					Player_SetStandDisabled(false);
					Player_SetCrouching(false, false, false);
					Player_SetCrouchDisabledTime(0.5f);
				}
				else
				{
					Player_DecCrawlCount();
				}
				
				// Enable jump upon leaving.
				if (mbRestoreJumpAfterExit)
					Player_SetJumpDisabled(false);
			}
		}
				
		mbPlayerIsInside = bCollide;
	}
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{
		
	}
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return false;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
		
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	//------------------------------------------------------------
	
	bool mbPlayerIsInside;
    bool mbCrouch = false;
	bool mbAllowJump = false;
	bool mbRestoreJumpAfterExit = true;
		
	//------------------------------------------------------------
		
}	