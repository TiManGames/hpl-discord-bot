#include "effect/Effects.hps"
#include "player/Player_Types.hps"
#include "helpers/helper_effects.hps"
#include "ModuleInterfaces.hps"

/////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////

//------------------------------------------------------------


//------------------------------------------------------------

class cLuxEffect_FOVShakeInstance
{
	float mfMaxSize;
	float mfSize;
	float mfTime;
	float mfFadeInTime;
	float mfMaxFadeInTime;
	float mfFadeOutTime;
	float mfMaxFadeOutTime;
	float mfShakeMaxTime;
	float mfShakeCount;
	bool mbNeverFadeOut;
	tID m_idSourceEntity = tID_Invalid;
	float mfMinDist;
	float mfMaxDist;
	eEasing mEasingType = eEasing_CubicOut;
	bool mbUseNoise;
	float mfNoiseMinFraction;
	float mfNoiseSpeed;
	bool mbUseRumble;
	
	float mfCurrentOffset = 0;
	float mfNextOffset = 0;
	
	int mlID;
}

//------------------------------------------------------------

class cScrEffect_FOV_Shake : iScrEffect, iScrEffect_Interface, iScrEffect_FOV_Shake
{
	
	//----------------------------------
	
	void Init()
	{
		mlIdCounter = 0;
	}
	//----------------------------------
	
	void OnDestroy()
	{
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PULBIC METHODS
	/////////////////////////////////////////
	
	//----------------------------------
	
	int Start(float afAmount, float afTime, float afFadeInTime,float afFadeOutTime, float afFrequency, bool abUseNoise, float afNoiseMinRelAmount, float afNoiseSpeed, bool abUseRumble)
	{		
		cLuxEffect_FOVShakeInstance shake;
		shake.mfSize = afAmount;
		shake.mfMaxSize = afAmount;
		shake.mfTime = afTime<0 ? 1.0f: afTime;
		shake.mbNeverFadeOut = afTime<0;
		shake.mfFadeInTime = afFadeInTime;
		shake.mfMaxFadeInTime = afFadeInTime;
		shake.mfFadeOutTime = cMath_Max(afFadeOutTime, 0.001f);
		shake.mfMaxFadeOutTime = cMath_Max(afFadeOutTime, 0.001f);
		shake.mbUseNoise = abUseNoise;
		shake.mfNoiseMinFraction = afNoiseMinRelAmount;
		shake.mfNoiseSpeed = afNoiseSpeed;
		shake.mbUseRumble = abUseRumble;
		
		shake.mfShakeMaxTime = afFrequency<=0 ? 0 : 1.0f/afFrequency;
		shake.mfShakeCount = 0; //First shake should come directly
		
		shake.mlID = mlIdCounter++;

		mvShakes.push_back(shake);

		mBaseObj.SetActive(true);
		
		return shake.mlID;
	}
	
	//----------------------------------

	void FadeOut(int alID, float afFadeOutTime)
	{
		for(uint i = 0; i < mvShakes.size(); ++i)
		{
			if(alID==-1 || mvShakes[i].mlID  == alID)
			{				
				mvShakes[i].mfTime = 0;
				mvShakes[i].mfFadeOutTime = afFadeOutTime * mvShakes[i].mfFadeOutTime / mvShakes[i].mfMaxFadeOutTime;
				mvShakes[i].mfMaxFadeOutTime = cMath_Max(afFadeOutTime, 0.001f);
				mvShakes[i].mbNeverFadeOut = false;
			}
		}
	}
	
	//----------------------------------

	void SetSourceEntity(int alID, tID a_idSource, float afMinDist, float afMaxDist, eEasing aEasingType)
	{
		for(uint i = 0; i < mvShakes.size(); ++i)
		{
			if(mvShakes[i].mlID  == alID)
			{				
				mvShakes[i].m_idSourceEntity = a_idSource;
				mvShakes[i].mfMinDist = afMinDist;
				mvShakes[i].mfMaxDist = afMaxDist;
				mvShakes[i].mEasingType = aEasingType;
				break;
			}
		}
	}
	
	void SetAmount(int alID, float afAmount)
	{
		for(uint i = 0; i < mvShakes.size(); ++i)
		{
			if(mvShakes[i].mlID  == alID)
			{				
				mvShakes[i].mfSize = afAmount;
				mvShakes[i].mfMaxSize = afAmount;
				mvShakes[i].mfFadeInTime = -1;
				break;
			}
		}
	}
	
	//----------------------------------
	
	float GetCurrentShakeAmount()
	{
		return mfCurrentShakeAmount;
	} 
	
	//----------------------------------
	
	float GetCurrentRumble()
	{
		return mfCurrentRumble;
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// GENERAL CALLBACKS
	/////////////////////////////////////////
	
	//----------------------------------
	
	void OnStart()
	{
		mfCurrentShakeAmount = 0.0f;
		mfCurrentRumble = 0.0f;
	}

	//----------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
		mfCurrentShakeAmount = 0.0f;
		mfCurrentRumble = 0.0f;
	}
	
	//----------------------------------
	
	void OnMapLeave(cLuxMap @apMap)
	{
		for(uint i=0;i<mvShakes.size(); ++i)
		{
			cLuxEffect_FOVShakeInstance @shake = @mvShakes[i];	
			shake.mbNeverFadeOut = false;
			shake.mfFadeInTime=0;
			shake.mfTime=0;
			
			shake.mfFadeOutTime = 0.5;
			shake.mfMaxFadeOutTime = 0.5;
		}
	}

	//----------------------------------
	
	void Reset()
	{
		mvShakes.resize(0);
		mfCurrentShakeAmount = 0.0f;
		mfCurrentRumble = 0.0f;
	}

	//----------------------------------
	
	void Update(float afTimeStep)
	{
		float fLargest = 0;
		float fLargestLength =0;
		float fRumble = 0.0f;

		///////////////////////////////
		// Iterate the shakes 
		for(uint i=0;i<mvShakes.size(); ++i)
		{
			cLuxEffect_FOVShakeInstance @shake = @mvShakes[i];
			
			///////////////////////////////////////
			// Fade in
			if(shake.mfFadeInTime >0)
			{
				shake.mfFadeInTime -= afTimeStep; if(shake.mfFadeInTime<0) shake.mfFadeInTime=0;
				float fT = shake.mfFadeInTime / shake.mfMaxFadeInTime;
				shake.mfSize = (1-fT) * shake.mfMaxSize;
			}
			///////////////////////////////////////
			// Mid point
			else if(shake.mfTime >0 && shake.mbNeverFadeOut==false)
			{
				shake.mfTime -= afTimeStep; if(shake.mfTime<0)shake.mfTime=0;
				shake.mfSize = shake.mfMaxSize;
			}
			///////////////////////////////////////
			// Fade out
			else if(shake.mbNeverFadeOut==false)
			{
				shake.mfFadeOutTime -= afTimeStep; if(shake.mfFadeOutTime<0) shake.mfFadeOutTime=0;
				float fT = shake.mfFadeOutTime / shake.mfMaxFadeOutTime;
				shake.mfSize =  fT * shake.mfMaxSize;
			}
			
			///////////////////////////////////////
			// Generate new offset.
			shake.mfShakeCount -= afTimeStep;
			if(shake.mfShakeCount <=0)
			{
				shake.mfCurrentOffset = shake.mfNextOffset;
				shake.mfNextOffset = cMath_RandRectf(-1, 1);
				shake.mfShakeCount = shake.mfShakeMaxTime;
			}
			
			///////////////////////////////////////
			// Get current shake offset
			float fT;
			
			if (shake.mfShakeMaxTime<=0) fT = 1;
			else	 					 fT = (1.0f - shake.mfShakeCount/shake.mfShakeMaxTime);
			
			float fShake;
			if(fT <1)
			{
				fT = (1.0f - shake.mfShakeCount/shake.mfShakeMaxTime);
				
				fShake = cMath_InterpolateSigmoid(shake.mfCurrentOffset, shake.mfNextOffset, fT);
			}
			else
			{
				fShake = shake.mfNextOffset;
			}
			
			fShake *= shake.mfSize;
			
			/////////////////////////////
			// Apply noise
			if (shake.mbUseNoise)
			{
				float fNoise = cGenerate_GetNoisePerlin1D(cEngine_GetGameTime()*shake.mfNoiseSpeed);
				fNoise = (fNoise+1.0f)/2.0f;
				
				fShake = fShake*shake.mfNoiseMinFraction + fShake*fNoise*(1.0f-shake.mfNoiseMinFraction);
			}
			
			///////////////////////////////////////////
			// reduce if far away from source entity
			if (shake.m_idSourceEntity != tID_Invalid)
			{
				iLuxEntity@ pSource = cLux_ID_Entity(shake.m_idSourceEntity);
				if (pSource is null)
				{
					if(shake.m_idSourceEntity != tID_Invalid) Error("ShakeInstance with id " + shake.mlID + " has an invalid source entity id!");
					shake.m_idSourceEntity = tID_Invalid;
					continue;
				}
				
				float fDist = cMath_Vector3Dist(cLux_GetPlayer().GetCharacterBody().GetPosition(), pSource.GetPosition());
				float fDistFract = (fDist-shake.mfMinDist)/(shake.mfMaxDist-shake.mfMinDist);
				float fDistMul = cMath_Easing(shake.mEasingType, 1.0f-fDistFract);
				fShake *= cMath_Clamp(fDistMul, 0.0, 1.0);
			}
			
			float fLength = cMath_Abs(fShake);
												
			///////////////////////////////////////
			// Check if the this is the largest shake
			if(fLargestLength < fLength)
			{
				fLargestLength = fLength;
				fLargest = fShake;
			}
			
			if (shake.mbUseRumble)
			{
				if (fRumble<fShake)
					fRumble = fShake;
			}

			///////////////////////////////////////
			// Check if over.
			if(shake.mfTime <= 0 && shake.mfFadeOutTime <= 0 && shake.mfFadeInTime <= 0)
			{
				mvShakes.removeAt(i);
				--i;

				//////////////////////////////////////////
				//If all shaking is over, set pos add to 0 and return.
				if(mvShakes.size()==0)
				{
					mfCurrentRumble=0;
					mBaseObj.SetActive(false);
					ApplyShakeEffect(0);
					return;
				}
			}
		}

		////////////////////////////////
		// Disable shakes when the player is reading etc.
		if (!cScript_GetGlobalVarBool("ShakesEnabled"))
		{
			fLargest = 0;
		}
		
		mfCurrentRumble = fRumble;
		if(cMath_Abs(mfCurrentRumble)>0.0001f)
		{
			Effect_Rumble_WakeUp();
		}
			
		///////////////////////////////
		// Set the camera offset.
		ApplyShakeEffect(fLargest);
	}
	
	//----------------------------------
	
	void OnDraw(float afFrameTime)
	{
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//----------------------------------
	
	void ApplyShakeEffect(float afAmount)
	{
		mfCurrentShakeAmount = afAmount;
		
		iScrPlayerBodyHandler_Interface@ pBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
		
		cLux_GetPlayer().SetCameraFOVMul(ePlayerFOVMul_FOV_Shake, 1.0f+cMath_Max(afAmount, -0.99f));
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//----------------------------------
	
	array<cLuxEffect_FOVShakeInstance> mvShakes;
	int mlIdCounter;
	float mfCurrentShakeAmount = 0.0f;
	float mfCurrentRumble = 0.0f;
	
	//----------------------------------
}