	//------------------------------------------------------------
	
	void SetupVerletTree(const tString &in asEntity, const tString &in asRootBone)
	{
		iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntity);
		if (pEntity is null) return;
		
		cBoneState@ pBoneState = pEntity.GetMeshEntity().GetBoneStateFromName(asRootBone);
		if (pBoneState is null) return;
		
		int alRootBoneId = pEntity.GetMeshEntity().GetBoneStateIndex(asRootBone);
		
		SetupVerletTree_AddNode(pEntity, -1, alRootBoneId);
	}
	
	//------------------------------------------------------------
	
	void SetupVerletTree_AddNode(iLuxEntity@ apEntity, int alParentNodeId, int alBoneId)
	{		
		if (apEntity is null) return;
		
		cBoneState@ pBone = apEntity.GetMeshEntity().GetBoneState(alBoneId);
		if (pBone is null) return;
				
		//////////////////////////////////////
		// Add node
		cVerletNode node;
		mvVerletNodes.push_back(node);
		int lNodeId = mvVerletNodes.size()-1;
		cVerletNode@ pNode = mvVerletNodes[lNodeId];
		
		//////////////////////////////////////
		// Setup node
		pNode.mlId = lNodeId;
		pNode.mlBoneId = alBoneId;
		pNode.m_idEntity = apEntity.GetID();
		pNode.m_mtxStartLocal = pBone.GetLocalMatrix();
		pNode.mvPosition = pBone.GetWorldPosition();
		pNode.mvPrevPosition = pBone.GetWorldPosition();
//		pNode.m_idCylinder = GetFreeCylinder();
//		cLux_ID_Entity(pNode.m_idCylinder).SetActive(true);
		
		if(alParentNodeId < 0) 
		{
			pNode.mfInvMass = 0;
			
			pNode.mvBaseRight = TransformDirection(pBone.GetLocalMatrix(), cVector3f(1,0,0));
			pNode.mvBaseUp = TransformDirection(pBone.GetLocalMatrix(), cVector3f(0,1,0));
			pNode.mvBaseForward = TransformDirection(pBone.GetLocalMatrix(), cVector3f(0,0,-1));
			
			pNode.mvBaseOffset = 0;
			
			// add node as tree
			mvVerletTrees.push_back(lNodeId);
		}
		else
		{
			cVerletNode@ pParentNode = mvVerletNodes[alParentNodeId];
			cBoneState@ pParentBone = apEntity.GetMeshEntity().GetBoneState(pParentNode.mlBoneId);
			cVector3f vParentPos = pParentBone.GetWorldPosition();
			cVector3f vPos = pNode.mvPosition;
			
			pNode.mfDistToParent = cMath_Vector3Dist(vParentPos, vPos); 
			
			CalculateNormals(vParentPos - vPos, 
								pParentNode.mvBaseRight,pParentNode.mvBaseForward,
								pNode.mvBaseRight, pNode.mvBaseUp, pNode.mvBaseForward);
							
			pNode.mvBaseOffset = pNode.mvPosition - pParentNode.mvPosition;
		}
		
		pNode.mvCurrentRight = pNode.mvBaseRight;
		pNode.mvCurrentUp = pNode.mvBaseUp;
		pNode.mvCurrentForward = pNode.mvBaseForward;
				
		//////////////////////////////////////
		// Add to parent
		if(alParentNodeId >= 0)
			mvVerletNodes[alParentNodeId].mvChildren.push_back(lNodeId);
		
		//////////////////////////////////////
		// Iterate and add children
		cNode3DIterator@ pChildren = pBone.GetChildIterator();
		while (pChildren.HasNext())
		{
			cBoneState@ pChildBone = cast<cBoneState>(pChildren.Next());
			if (pChildBone is null) continue;
			
			SetupVerletTree_AddNode(apEntity, lNodeId, apEntity.GetMeshEntity().GetBoneStateIndex(pChildBone.GetName()));
		}
		
	}
	
	//------------------------------------------------------------
	
	void CalculateNormals(const cVector3f&in avChildToParent, 
							const cVector3f&in avBaseRight, const cVector3f&in avBaseForward,
							cVector3f&out avOutRight, cVector3f&out avOutUp, cVector3f&out avOutForward)
	{
		avOutUp = cMath_Vector3Normalize(avChildToParent);
		
		avOutRight = avBaseRight - avOutUp*cMath_Vector3Dot(avOutUp, avBaseRight);
		avOutRight.Normalize();
		
		avOutForward = cMath_Vector3Cross(avOutUp, avOutRight);
		avOutForward.Normalize();
	}
	
