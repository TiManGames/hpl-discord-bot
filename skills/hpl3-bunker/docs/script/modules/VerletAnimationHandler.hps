//----------------------------------------------------------------------------------------

class cVerletNode
{
	int mlId;
	int mlBoneId;
	array<int> mvChildren;
	tID m_idEntity;
	tID m_idCylinder;
	
	cMatrixf m_mtxStartLocal;
	
	cVector3f mvPosition=0;
	cVector3f mvPrevPosition=0;
	cVector3f mvForce =0;
	float mfInvMass = 1;
	
	float mfDistToParent;
	
	cVector3f mvBaseOffset;
	
	cVector3f mvBaseUp;
	cVector3f mvBaseRight;
	cVector3f mvBaseForward;
	
	cVector3f mvCurrentUp;
	cVector3f mvCurrentRight;
	cVector3f mvCurrentForward;
	
	cMatrixf m_mtxCurrentRotation;
	cMatrixf m_mtxCurrentWorldRotation;
}

//----------------------------------------------------------------------------------------

cVector3f gvVerletGravity = cVector3f(0, 0, 0);
float gfVerletDampingMul = 1;
float gfVerletStiffness = 1;

float gfVerletMaxSpeed = 2.1f;
float gfVerletMoveToPositionMul = 3.0f;

//----------------------------------------------------------------------------------------

