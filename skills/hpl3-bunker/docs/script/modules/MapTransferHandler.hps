#include "interfaces/UserModule_Interface.hps"
#include "modules/ModuleInterfaces.hps"

//---------------------------------------------------

class cSaveState_Gun
{
	int mlCurrentChamberId;
	float mfCylinderAngle;
	array<int> mvChamberStates;
}

//---------------------------------------------------

class cSaveState_Shotgun
{
	int mlMagazineCount;
	bool mbChamberedShell;
}

//---------------------------------------------------

class cSaveState_DynLantern
{
	float mfCharge;
	float mfPrevCharge;
	float mfEffectT;
	int mlPutAwayTimeStamp;
}

//---------------------------------------------------

class cSaveState_Stalker
{
	cVector3f mvPosition;
	float mfYaw;
	int mlState;
}

//---------------------------------------------------

class cSaveState_Torch
{
	float mfHealth;
}

//---------------------------------------------------

class cScrMapTransferHandler : iScrUserModule, iScrUserModule_Interface, iScrMapTransferHandler_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	
	}
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	//MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}

	void OnMapLeave(cLuxMap @apMap)
	{
	}
	
	//------------------------------------------------------------
	
	void PreloadData(cLuxMap @apMap)
	{
	}
	
	void CreateWorldEntities(cLuxMap @apMap)
	{
		// Clear here, it's the first thing that happens when changing map
	}

	void DestroyWorldEntities(cLuxMap @apMap)
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterContainer(const tString&in asOldContainer)
	{
	
	}
	void OnLeaveContainer(const tString&in asNewContainer)
	{
	
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		mlTimeStamp++;
	}
	
	
	//------------------------------------------------------------
		
	void PostUpdate(float afTimeStep)
	{
	}
	
	void VariableUpdate(float afDeltaTime)
	{
	}

	//------------------------------------------------------------
	
	void Reset()
	{
		mlTimeStamp=0;
	}
	
	//------------------------------------------------------------
	
	
	void OnDraw(float afFrameTime)
	{
	
	}

	void OnPostRender(float afFrameTime)
	{
	
	}
	
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		afStartY = cLux_DrawDebugText("TimeStamp: " + mlTimeStamp, afStartY);
		return afStartY;
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// MAP TRANSFER
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	void Clear()
	{
	}

	//------------------------------------------------------------
	// Gun

	cSaveState_Gun mGunState;

	void SaveState_Gun(int alCurrentChamberId, float afCylinderAngle, const array<int>&in avChamberStates)
	{
		mGunState.mlCurrentChamberId = alCurrentChamberId;
		mGunState.mfCylinderAngle = afCylinderAngle;
		mGunState.mvChamberStates = avChamberStates;
	}

	void LoadState_Gun(int&out alCurrentChamberIdOut, float&out afCylinderAngleOut, array<int>&out avChamberStatesOut)
	{
		alCurrentChamberIdOut = mGunState.mlCurrentChamberId;
		afCylinderAngleOut = mGunState.mfCylinderAngle;
		avChamberStatesOut = mGunState.mvChamberStates;
	}

	//------------------------------------------------------------
	// Shotgun

	cSaveState_Shotgun mShotgunState;

	void SaveState_Shotgun(int alMagazineCount, bool abChamberedShell)
	{
		mShotgunState.mlMagazineCount = alMagazineCount;
		mShotgunState.mbChamberedShell = abChamberedShell;
	}

	void LoadState_Shotgun(int&out alMagazineCountOut, bool&out abChamberedShellOut)
	{
		alMagazineCountOut = mShotgunState.mlMagazineCount;
		abChamberedShellOut = mShotgunState.mbChamberedShell;
	}

	//------------------------------------------------------------
	// Dyn lantern

	cSaveState_DynLantern mDynLanternState;

	void SaveState_DynamoLantern(float afCharge, float afPrevCharge, float afEffectT, int alPutAwayTimeStamp)
	{
		mDynLanternState.mfCharge = afCharge;
		mDynLanternState.mfPrevCharge = afPrevCharge;
		mDynLanternState.mfEffectT = afEffectT;
		mDynLanternState.mlPutAwayTimeStamp = alPutAwayTimeStamp;
	}

	void LoadState_DynamoLantern(float&out afCharge, float&out afPrevCharge, float&out afEffectT, int&out alPutAwayTimeStamp)
	{
		afCharge = mDynLanternState.mfCharge;
		afPrevCharge = mDynLanternState.mfPrevCharge;
		afEffectT = mDynLanternState.mfEffectT;
		alPutAwayTimeStamp = mDynLanternState.mlPutAwayTimeStamp;
	}

	//------------------------------------------------------------
	// Stalker
	cSaveState_Stalker mStalkerState;

	void SaveState_Stalker(const cVector3f&in avPosition, float afYaw, int alState)
	{
		mStalkerState.mvPosition = avPosition;
		mStalkerState.mfYaw = afYaw;
		mStalkerState.mlState = alState;
	}

	void LoadState_Stalker(cVector3f&out avPosition, float&out afYaw, int&out alState)
	{
		avPosition = mStalkerState.mvPosition;
		afYaw = mStalkerState.mfYaw;
		alState = mStalkerState.mlState;
	}

	//------------------------------------------------------------
	// Timestamp
	
	int GetTimeStamp()
	{
		return mlTimeStamp;
	}

	float GetTimeElapsed(int alTimeStamp)
	{
		return float(mlTimeStamp - alTimeStamp) / float(cEngine_GetUpdatesPerSec());
	}
	
	//------------------------------------------------------------
	// Torch
	
	cSaveState_Torch mTorchState;

	void SaveState_Torch(const float&in afHealth)
	{
		mTorchState.mfHealth = afHealth;
	}

	void LoadState_Torch(float&out afHealth)
	{
		afHealth = mTorchState.mfHealth;
	}

	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnAction(int alAction, bool abPressed)
	{
	
	}
	void OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
	
	}
	
	//------------------------------------------------------------
	
	void OnExitPressed()
	{
	
	}
	
	//------------------------------------------------------------
	
	void AppGotInputFocus()
	{
	
	}
	void AppLostInputFocus()
	{
	
	}
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlTimeStamp = 0;
	

	//------------------------------------------------------------
		
}
