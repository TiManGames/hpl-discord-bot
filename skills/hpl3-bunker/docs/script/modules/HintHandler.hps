	//------------------------------------------------------------
	
	[nosave] bool mbHintsEnabled;
	[nosave] bool mbPausingHintsEnabled;

	bool mbHintsForced = false;
	bool mbCanShowHints = true;
	
	//------------------------------------------------------------
	
	cLuxScreenTextFormatParameters mFormatParamsHeader;
	cLuxScreenTextFormatParameters mFormatParamsHint;
	cLuxScreenTextFormatParameters mFormatParamsFooter;
	
	//------------------------------------------------------------
	
	cHint mCurrentHint;
	array<cHint> mvNextHintCandidates;
	array<cHintRemoveData> mvHintsToRemove;
	cScriptStringSet m_setHintsGiven;
	cScriptStringSet m_setHintsBlocked;
	cScriptStringSet m_setHintsPausedOnce;
	
	//------------------------------------------------------------
	
	tWString msHeader;
	tWString msFooter;
	array<tWString> mvCurrentHintLines;
	[volatile] array<cLuxScreenTextIcon@>	mvCurrentHintIcons;
	[nosave] array<array<int>>			mvCurrentHintIconsPerLine;
	int mlNumParsedHintIcons;
	
	[nosave] bool mbFirstUpdateAfterLoading = true;
	
	float mfLineHeight = gfHintFontSize * 1.2;
		
