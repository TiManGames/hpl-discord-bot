	void _Global_SetPausingHintsEnabled()
	{
		mbHintsEnabled = cScript_GetGlobalArgBool(0);
		if (mbHintsEnabled)
			mbHintsEnabled = cLux_GetUserConfig().GetBool("Gameplay", "GamePausingHints", true);
	}
	
