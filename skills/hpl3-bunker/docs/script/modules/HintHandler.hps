//---------------------------------------------------

const float gfMaxTextWidth = 750;
const tString gsFont_Hint = "work_56.fnt";
const float gfHintFontSize = 22;
const cColor gHintHeaderColor(1,0,0,1);
const cColor gHintHeaderColorPulse(0.85,0,0,1);

const cColor gHintFooterColor(1,0,0,1);
const cColor gHintFooterColorPulse(0.85,0,0,1);

const cVector3f gvHintShadowOffset(1.f, 1.f, -1.f);
const float gfHintShadowAlphaMul = 0.5f;
const float gfHintDrawPosZ = 6.f;

//---------------------------------------------------

class cHint
{
	cHint()
	{
		Clear();
	}
	
	cHint(const tString &in asHeaderCat, const tString &in asHeaderEntry, 
			const tString &in asTextCat, const tString &in asTextEntry, 
			bool abIsInputHint,
			const cColor &in aColor, float afTimeMul=1.5f, bool abAddAsGiven=true, bool abPausing = false)
	{
		msHeaderCat = asHeaderCat;
		msHeaderEntry = asHeaderEntry;
		msTextCat = asTextCat;
		msTextEntry = asTextEntry;
		mbInputHint = abIsInputHint;
		mColor = aColor;
		mfTimeToDisplay = afTimeMul;
		mbAddAsGiven = abAddAsGiven;
		
		mlID = 0;
		
		tString sTextCatInName = msTextCat;
				
		if(mbInputHint)
		{
			bool bIsConsole = Platform_IsConsole(); // Only PS4 for now
			mbTriggeredByGamepad = bIsConsole || cLux_GetInputHandler().GetGamepadWasLastDeviceUsed();
			
			tString sGamepadCat = msTextCat+"Gamepad";
			if(mbTriggeredByGamepad)
			{
				sTextCatInName = sGamepadCat;
				
				if(cLux_HasTranslation(sGamepadCat, msTextEntry) || cLux_HasTranslation(sGamepadCat, msTextEntry+"_1"))
					msTextCat = sGamepadCat;
			}
		}
		else
			mbTriggeredByGamepad = false;
			
		msName = BuildHintName(msTextCat, msTextEntry);
		mbPausing = abPausing;
	}
	
	void Clear()
	{
		msName = "";
		mlID = -1;
		msHeaderCat = "";
		msHeaderEntry = "";
		msTextCat = "";
		msTextEntry = "";
		mbInputHint = false;
		mbTriggeredByGamepad = false;
		mColor = cColor(1,1);
		mfTimeToDisplay = 1.0f;
		mbAddAsGiven = true;
		mbPausing = false;
	}
	
	bool IsEmpty()
	{
		return mlID==-1;
	}
		
	tString msName;
	int mlID;
		
	tString msHeaderCat;
	tString msHeaderEntry;
	tString msTextCat;
	tString msTextEntry;
	
	bool mbInputHint;
	bool mbTriggeredByGamepad;
	
	cColor mColor;
	float mfTimeToDisplay;
	bool mbAddAsGiven;
	bool mbPausing;
};

//---------------------------------------------------

class cHintRemoveData
{
	cHintRemoveData()
	{
		msName = "";
		mfTime = 0.f;
		mbRemoveFromGiven = false;
		mbRemoveFromPauseOnce = false;
		mlReleaseId = -1;
	}
	
	cHintRemoveData(const tString &in asName, float afTime, bool abRemoveFromGiven, int alReleaseId, bool abRemoveFromPauseOnce=false)
	{
		msName = asName;
		mfTime = afTime;
		mbRemoveFromGiven = abRemoveFromGiven;
		mlReleaseId = alReleaseId;
		mbRemoveFromPauseOnce = abRemoveFromPauseOnce;
	}
	
	tString msName;
	float mfTime;
	bool mbRemoveFromGiven;
	bool mbRemoveFromPauseOnce;
	int mlReleaseId;
};

//---------------------------------------------------

///////////////////////////////////////
// Helper hint global funcs
tString BuildHintName(const tString &in asTextCat, const tString &in asTextEntry)
{
	return asTextCat + "." + asTextEntry;
}

//---------------------------------------------------

class cScrHintHandler : iScrUserModule, iScrUserModule_Interface, iScrHintHandler_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mbHintsEnabled = cLux_GetUserConfig().GetBool("Gameplay", "ShowHints", true);
		mbPausingHintsEnabled = cLux_GetUserConfig().GetBool("Gameplay", "GamePausingHints", true);
		
		mbFirstUpdateAfterLoading = true;
		
		///////////////////////////////
		// Load Graphics
		/*mFormatParamsHeader.mLabelText.mFont = cImGuiFont(FontHandler_GetFont(eFontType_Hints, 56), cVector2f(gfHintFontSize));
		mFormatParamsHeader.mLabelText.mFontAlign = eFontAlign_Center;

		mFormatParamsFooter.mLabelText.mFont = cImGuiFont(FontHandler_GetFont(eFontType_Hints, 56), cVector2f(gfHintFontSize));
		mFormatParamsFooter.mLabelText.mFontAlign = eFontAlign_Center;

		mFormatParamsHint.mLabelText.mFont = cImGuiFont(FontHandler_GetFont(eFontType_Hints, 56), cVector2f(gfHintFontSize));
//		mFormatParamsHint.mfOutputLineWidth = gfMaxTextWidth;
		mFormatParamsHint.mfOutputLineWidth = cLux_GetHudVirtualSize().x;
		mFormatParamsHint.mfIconGamepadHeight = gfHintFontSize*1.5f;
		mFormatParamsHint.mfIconMouseHeight = gfHintFontSize*1.25f;
		mFormatParamsHint.mfIconKeyHeight = gfHintFontSize*1.5f;
		mFormatParamsHint.mLabelText.mFontAlign = eFontAlign_Center;*/

		
		mlNumParsedHintIcons = 0;
		
		mfTextAlpha = 0.0f;
		mfDisplayTime = 0.0f;
		mfPrevDisplayTime = 0.f;
		mfFadeCurrentTime = 0.0f;
		mfFadeTotalTime = 0.0f;
		mfFooterAlpha = 0.f;
		mfFooterAlphaGoal = 0.f;
		mbPaused = false;
		
		mvHintsToRemove.resize(0);
	}
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
		bool bPrevHintsEnabled = mbHintsEnabled;
		mbHintsEnabled = cLux_GetUserConfig().GetBool("Gameplay", "ShowHints", true);
		mbPausingHintsEnabled = cLux_GetUserConfig().GetBool("Gameplay", "GamePausingHints", true);
		
		// When disabling hints, clear all hint related stuff
		if((mbHintsEnabled==false&&mbHintsForced==false) && mbHintsEnabled!=bPrevHintsEnabled)
		{
			if(mCurrentHint.IsEmpty()==false)
			{
				mCurrentHint.Clear();
				mvNextHintCandidates.resize(0);
				mvHintsToRemove.resize(0);
				
				mvCurrentHintLines.resize(0);
				mvCurrentHintIcons.resize(0);
				
				Reset();
				ResetTimers();
			}
		}
	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig() {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
		Reset();
		ResetTimers();
		mbHintsForced = false;
	}
	
	//------------------------------------------------------------
	
	void OnMapLeave(cLuxMap @apMap)
	{
		Reset();
		ResetTimers();
		mbHintsForced = false;
	}
	
	//------------------------------------------------------------
	
	void ResetTimers()
	{
		mfDisplayTime = 0.0f;
		mfPrevDisplayTime = 0.f;
		mfFadeCurrentTime = 0.0f;
		mfFadeTotalTime = 0.0f;
	}
	
	//------------------------------------------------------------
	
	void PreloadData(cLuxMap @apMap) {}
	void CreateWorldEntities(cLuxMap @apMap) {}
	void DestroyWorldEntities(cLuxMap @apMap) {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterContainer(const tString&in asOldContainer) {}
	void OnLeaveContainer(const tString&in asNewContainer) {}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		if((mbHintsForced == false && mbHintsEnabled==false) || mbCanShowHints==false || cLux_GetFootageModeActive()) return;

		if(mbPauseGameNextTime)
		{
			mbPauseGameNextTime = false;
			cLux_SetGamePaused(true, false, true, false, eSoundEntryType_World);
		}

		////////////////
		// Update line width
		mFormatParamsHint.mfOutputLineWidth = cLux_GetHudVirtualSize().x;
		
		////////////////////
		// Any hints to remove/release?
		for (int i = 0; i < mvHintsToRemove.size(); ++i)
		{
			mvHintsToRemove[i].mfTime -= afTimeStep;
			if (mvHintsToRemove[i].mfTime <= 0.f)
			{
				if (mvHintsToRemove[i].mbRemoveFromGiven)
					m_setHintsGiven.Erase(mvHintsToRemove[i].msName);				
				
				int lReleaseId = mvHintsToRemove[i].mlReleaseId;
				if (lReleaseId != -1 && lReleaseId < mvNextHintCandidates.size())
					mvNextHintCandidates.removeAt(lReleaseId);
				
				mvHintsToRemove.removeAt(i);
				--i;
			}
		}
						
		////////////////////
		// Update fade
		bool bTextWasDisplayed = mbTextDisplayed;
		mbTextDisplayed = (mfDisplayTime > 0.f || mfPrevDisplayTime > 0.f) ? true : false;

		if(mfFooterAlpha == 1.f && mfFooterAlphaGoal == 1.f && mbWaitingForInput)
		{
			if(cLux_GetGamePaused() && cLux_GetInputHandler().CheckIfButtonPressed())
			{
				mfFooterAlphaGoal = 0.f;
				mbWaitingForInput = false;

				if(mCurrentHint.mbPausing)
				{
					cLux_SetGamePaused(false, false, false, false);
					Effect_Blur_FadeOut(mlPausableHintBlurFxID, 0.1f);
					mlPausableHintBlurFxID = -1;
					PauseMenu_Enabled(true);
					Sketchbook_SetCanOpen(true);
				}
			}
			mbTextDisplayed = true;
		}

		// Fade in
		if(!bTextWasDisplayed && mbTextDisplayed)
		{
			StartTextFade(1.0f, 1.0f);
			
			if(mCurrentHint.mbPausing)
			{
				mfFooterAlphaGoal = 1.f;
			}
		}
		// Fade out
		else if(bTextWasDisplayed && !mbTextDisplayed && !mbWaitingForInput)
		{
			StartTextFade(0.0f, 1.0f/3);
			
			if(mCurrentHint.mbPausing)
				mfFooterAlphaGoal = 0.f;
		}

		if(mbTextDisplayed && mbPaused == false && mbWaitingForInput == false)
		{
			mfPrevDisplayTime = mfDisplayTime;
			mfDisplayTime = cMath_IncreaseTo(mfDisplayTime, afTimeStep, 0.f);
		}

		// Update fading
		if(mbTextFadingStarted)
		{
			if(DoneFading()==false)
			{
				UpdateFade(afTimeStep);
			}
			else
			{
				mbTextFadingStarted = false;
				
				// If faded out, resume with next hint (if any)
				if(mfFadeGoal==0.0f)
				{

					mvCurrentHintLines.resize(0);
					if(mCurrentHint.IsEmpty()==false)
					{
						mCurrentHint.Clear();
						
						if(HasNextHint())
						{
							cHint hint = GetNextHint();
							StartMessage(hint);
						}
					}
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	void PreUpdate(float afTimeStep){}
	void PostUpdate(float afTimeStep){}
	void VariableUpdate(float afDeltaTime ){}
	
	//------------------------------------------------------------
	
	void Reset()
	{
		mfTextAlpha = 0.0f;
		mfFadeStart = 0.0f;
		mfFadeGoal = 0.0f;
		mfFadeCurrentTime = 0.0f;
		mbTextFadingStarted = false;
		mbPaused = false;
		mbCanShowHints = true;
		mbTextDisplayed = false;
		mbWaitingForInput = false;
		mfFooterAlpha = 0.f;
		mfFooterAlphaGoal = 0.f;
		mCurrentHint.Clear();
		mvNextHintCandidates.resize(0);
		mvHintsToRemove.resize(0);
		
		mvCurrentHintLines.resize(0);
		mvCurrentHintIcons.resize(0);

		mbPauseGameNextTime = false;
		mfFooterAlphaGoal = 0.f;
		mfFooterAlpha = 0;
		mbWaitingForInput = false;

		if(mCurrentHint.mbPausing)
		{
			cLux_SetGamePaused(false, false, false, false);
			Effect_Blur_FadeOut(mlPausableHintBlurFxID, 0.1f);
			mlPausableHintBlurFxID = -1;
			PauseMenu_Enabled(true);
			Sketchbook_SetCanOpen(true);
		}
	}
	
	//------------------------------------------------------------
	
	void OnGui(float afFrameTime)
	{
		mfFrameTime += afFrameTime;
		
		if((mbHintsForced == false && mbHintsEnabled==false) || mbCanShowHints==false || cLux_GetFootageModeActive()) return;
		
		if(mCurrentHint.mbPausing && cLux_GetGamePaused())
			Update(afFrameTime);
		
		mFormatParamsHeader.mLabelText.mFont = cImGuiFont(FontHandler_GetFont(eFontType_Hints, 56), cVector2f(gfHintFontSize));
		mFormatParamsHeader.mLabelText.mFontAlign = eFontAlign_Center;

		mFormatParamsFooter.mLabelText.mFont = cImGuiFont(FontHandler_GetFont(eFontType_Hints, 56), cVector2f(gfHintFontSize));
		mFormatParamsFooter.mLabelText.mFontAlign = eFontAlign_Center;
		
		mFormatParamsHint.mLabelText.mFont = cImGuiFont(FontHandler_GetFont(eFontType_Hints, 56), cVector2f(gfHintFontSize));
		mFormatParamsHint.mfOutputLineWidth = cLux_GetHudVirtualSize().x;
		mFormatParamsHint.mfIconGamepadHeight = gfHintFontSize*1.5f;
		mFormatParamsHint.mfIconMouseHeight = gfHintFontSize*1.25f;
		mFormatParamsHint.mfIconKeyHeight = gfHintFontSize*1.5f;
		mFormatParamsHint.mLabelText.mFontAlign = eFontAlign_Center;
		
		// Check if a string reparse is needed (e.g. after loading a saved game)
		if(mCurrentHint.IsEmpty()==false)
		{
			if(mbFirstUpdateAfterLoading || mlNumParsedHintIcons!=mvCurrentHintIcons.length())
			{
				ParseAndFormatHint(mCurrentHint);
				// Also Reset hint time
				mfPrevDisplayTime = mfDisplayTime = mCurrentHint.mfTimeToDisplay;
				mbFirstUpdateAfterLoading = false;
			}
		}
		else
		{
			return;
		}
		
		bool bCanSkipHintText = mfTextAlpha==0 || mvCurrentHintLines.length()==0;
		if(bCanSkipHintText) return;
		
		////////////////////
		// Draw hint header
		cColor headerColor = ImGui_FadeOscillateColor("HintHeader", gHintHeaderColor, gHintHeaderColorPulse, 1.f, eEasing_SineInOut);
		headerColor.a = mfTextAlpha;
		ImGui_SetModColorMul(headerColor);

		cVector3f vHeaderPos = ImGui_NrmPos(0.0f, 0.175f, gfHintDrawPosZ);
		cVector2f vHeaderLineSize(ImGui_NrmSize(1.0f, 0.0f).x, mFormatParamsHeader.mLabelText.mFont.mvSize.y);
			
		cLux_GetCurrentImGui().DoLabel(msHeader, mFormatParamsHeader.mLabelText, vHeaderPos, vHeaderLineSize, 1.0f);
		
		////////////////////
		// Header shadow
		vHeaderPos += gvHintShadowOffset;
		float fShadowAlpha = mfTextAlpha * gfHintShadowAlphaMul;
		
		ImGui_SetModColorMul(cColor(0.f, 0.f, 0.f, fShadowAlpha)); 
		cLux_GetCurrentImGui().DoLabel(msHeader, mFormatParamsHeader.mLabelText, vHeaderPos, vHeaderLineSize, 1.0f);
			
		// If only showing header, skip hint text
		if (bCanSkipHintText) return;
		
		////////////////////
		// Draw hint
		float fHeaderHeight = GetHeaderHeight();	
				
		cVector3f vHintPos = ImGui_NrmPos(0.5f, 0.0f, gfHintDrawPosZ);
		vHintPos.x -= mFormatParamsHint.mfOutputLineWidth*0.5f;
		vHintPos.y = vHeaderPos.y + fHeaderHeight;
		
		cVector2f vHintLineSize(mFormatParamsHint.mfOutputLineWidth, mFormatParamsHint.mLabelText.mFont.mvSize.y);		
		ImGui_SetModColorMul(cColor(mTextColor.r,mTextColor.g, mTextColor.b, mfTextAlpha));
		DrawHint(cLux_GetGameHudImGui(), afFrameTime, mFormatParamsHint.mLabelText, vHintPos, vHintLineSize.x, mfLineHeight,
											mvCurrentHintLines, mvCurrentHintIcons, mvCurrentHintIconsPerLine);
		
		////////////////////
		// Draw hint shadow
		vHintPos += gvHintShadowOffset;
		
		ImGui_SetModColorMul(cColor(0, 0, 0, fShadowAlpha));
		DrawHint(cLux_GetGameHudImGui(), afFrameTime, mFormatParamsHint.mLabelText, vHintPos, vHintLineSize.x, mfLineHeight,
											mvCurrentHintLines, mvCurrentHintIcons, mvCurrentHintIconsPerLine);
	

		mfFooterAlpha = cMath_IncreaseTo(mfFooterAlpha, afFrameTime, mfFooterAlphaGoal);

		if(mfFooterAlpha > 0.f)
		{
			////////////////////
			// Draw hint footer
			cColor footerColor = ImGui_FadeOscillateColor("HintFooter", gHintFooterColor, gHintFooterColorPulse, 1.f, eEasing_SineInOut);
			footerColor.a = mfFooterAlpha * mfTextAlpha;
			ImGui_SetModColorMul(footerColor);

			cVector3f vFooterPos = ImGui_NrmPos(0.f, 0.f, gfHintDrawPosZ);
			vFooterPos.y = vHintPos.y;
			vFooterPos.y += (vHintLineSize.y * float(mvCurrentHintLines.size() + 1));

			cVector2f vFooterLineSize(ImGui_NrmSize(1.0f, 0.0f).x, mFormatParamsFooter.mLabelText.mFont.mvSize.y);


			//cImGuiButtonData mButtonData;
			//mButtonData.mFont = cImGuiFont(gsFont_Hint, cVector2f(gfHintFontSize));
			//mButtonData.mFontAlign = eFontAlign_Center;
			//vFooterLineSize.x = cLux_GetCurrentImGui().GetFontLength(mFormatParamsFooter.mLabelText.mFont,  1.f,  msFooter);
			//if(cLux_GetCurrentImGui().DoButton("HintHandler_FooterButton", msFooter, mButtonData,  vFooterPos,  vFooterLineSize))
			//{
			//}

			cLux_GetCurrentImGui().DoLabel(msFooter, mFormatParamsFooter.mLabelText, vFooterPos, vFooterLineSize, 1.0f);
			
			////////////////////
			// footer shadow
			vFooterPos += gvHintShadowOffset;
			
			ImGui_SetModColorMul(cColor(0.f, 0.f, 0.f, fShadowAlpha)); 
			cLux_GetCurrentImGui().DoLabel(msFooter, mFormatParamsFooter.mLabelText, vFooterPos, vFooterLineSize, 1.0f);
		}
		
		ImGui_ResetModifiers();
	}
	
	//------------------------------------------------------------
	
	void DrawHint(cImGui@ apImGui, float afTimeStep, const cImGuiLabelData&in aLabel, const cVector3f&in avPosition, float afLineWidth, float afLineSpacing, array<tWString>&in apInTextLines,  array<cLuxScreenTextIcon@>&in apIconArray,  array<array<int>>&in apIconsPerLineArray)
	{
		cVector3f vStartPos(avPosition);
		cVector2f vLineSize(afLineWidth, aLabel.mFont.mvSize.y);

		cImGuiLabelData labelData = aLabel;
		labelData.mFontAlign = eFontAlign_Center;

		array<float> vLineWidths;
		{
			tWString sLine = apInTextLines[0];
			float fLineWidth = apImGui.GetFontLength(labelData.mFont, 1.0f, sLine);

			vLineWidths.push_back(fLineWidth);

			apImGui.DoLabel(sLine, labelData, vStartPos, vLineSize, 1.0f);

			vStartPos.y += afLineSpacing;
		}
			
		//vStartPos.x += afLineWidth/2.0f;
		//vStartPos.x -= vLineWidths[0]/2.0f;
		//labelData.mFontAlign = eFontAlign_Left;
		for(int i=1; i<apInTextLines.size(); ++i)
		{
			tWString sLine = apInTextLines[i];

			float fLineWidth = apImGui.GetFontLength(labelData.mFont, 1.0f, sLine);
			vLineWidths.push_back(fLineWidth);

			apImGui.DoLabel(sLine, labelData, vStartPos, vLineSize, 1.0f);

			vStartPos.y += afLineSpacing;
		}

		vStartPos.x = avPosition.x;
		vStartPos.y = avPosition.y + aLabel.mFont.mvSize.y/2;

		//if(aLabel.mFontAlign==eFontAlign_Center)
			vStartPos.x += afLineWidth/2;
		//else if(aLabel.mFontAlign==eFontAlign_Right)
		//	vStartPos.x += afLineWidth;
		
		{
			cVector3f vLineRefPos(vStartPos);
			float fCurrentLineActualWidth = vLineWidths[0];

			vLineRefPos.x -= fCurrentLineActualWidth/2;
			
			array<int>@ pIconsPerLine = apIconsPerLineArray[0];

			if (pIconsPerLine !is null)
			{
				for (int j = 0; j < pIconsPerLine.size(); ++j)
				{
					int lIconIndex = pIconsPerLine[j];
					cLuxScreenTextIcon@ pIcon = apIconArray[lIconIndex];

					if (pIcon !is null)
					{
						pIcon.Draw(apImGui, afTimeStep, vLineRefPos);
					}
				}
			}

			vStartPos.y += afLineSpacing;
		}

		vStartPos.x = avPosition.x;
		
		for(int i=1; i<vLineWidths.size(); ++i)
		{
			vStartPos.x = avPosition.x;
			vStartPos.x += afLineWidth/2.0f;
			vStartPos.x -= vLineWidths[i]/2.0f;

			cVector3f vLineRefPos(vStartPos);
			float fCurrentLineActualWidth = vLineWidths[i];
			array<int>@ pIconsPerLine = apIconsPerLineArray[i];

			if (pIconsPerLine !is null)
			{
				for (int j = 0; j < pIconsPerLine.size(); ++j)
				{
					int lIconIndex = pIconsPerLine[j];
					cLuxScreenTextIcon@ pIcon = apIconArray[lIconIndex];

					if (pIcon !is null)
					{
						pIcon.Draw(apImGui, afTimeStep, vLineRefPos);
					}
				}
			}

			vStartPos.y += afLineSpacing;
		}
	}


	//------------------------------------------------------------
	
	void OnDraw(float afFrameTime) {}	
	void OnPostRender(float afFrameTime) {}
	
