#include "helpers/helper_effects.hps"

//---------------------------------------------------

class cEffectHandlerPreset
{
	cEffectHandlerPreset()
	{
		mbFog = false;
		mbSecondFog = false;
		mbDOF = false;
		mbBloom = false;
	}

	cEffectHandlerPreset(tString asName)
	{
		mbFogActive = false;
		mfFogStart =0;
		mfFogEnd = 10;
		mfFogFalloffExp = 1;
		mfFogBrightness = 1.0f;
		mFogColor = cColor(1,1);

		mbSecondFogActive = false;
		mfSecondFogStart =0;
		mfSecondFogEnd = 10;
		mfSecondFogFalloffExp = 1;
		mfSecondFogBrightness = 1.0f;
		mSecondFogColor = cColor(1,1,1,1);

		mbFogUnderwater = false;
		mbFogSkybox = false;
		mbFogExponential = false;

		mfDOFFocusStart = 1.0f;
		mfDOFFocusEnd = 40.0f;
		mfDOFFalloff = 1.0f;
		mbDOFActive = false;
		
		mfBloomWidth = 128.0f;
		mfBloomBrightPass = 0.75f;
		mfBloomFalloff = 0.5f;
		mBloomTint = cColor(1,1);

		mfToneMappingKey = 0.5f;
		mfToneMappingExposure = 0.0f;
		mfToneMappingWhiteCut = 3.2f;

		mbFog = false;
		mbSecondFog = false;
		mbDOF = false;
		mbBloom = false;
		mbColorGrading = false;
		mbToneMapping = false;

		mbSkyboxColor = false;
		mSkyboxColor = cColor(0,1);
		mfSkyboxBrightness = 1;

		msName = asName;
	}

	tString msName;

	bool mbFogActive;
	bool mbFogUnderwater;
	bool mbFogSkybox;
	bool mbFogExponential;
	float mfFogStart;
	float mfFogEnd;
	float mfFogFalloffExp;
	cColor mFogColor;
	float mfFogBrightness;
	bool mbFog;

	bool mbSecondFogActive;
	float mfSecondFogStart;
	float mfSecondFogEnd;
	float mfSecondFogFalloffExp;
	cColor mSecondFogColor;
	float mfSecondFogBrightness;
	bool mbSecondFog;

	float mfDOFFocusStart;
	float mfDOFFocusEnd;
	float mfDOFFalloff;
	bool mbDOFActive;
	bool mbDOF;

	bool mbBloom;
	float mfBloomWidth;
	float mfBloomBrightPass;
	float mfBloomFalloff;
	cColor mBloomTint;

	bool mbDirLight;
	bool mbDirLightActive;
	float mfDirLightBrightness;
	cVector3f mvDirLightDir;
	cColor mDirLightGroundColor;
	cColor mDirLightSkyColor;
	cColor mDirLightDiffuseColor;

	bool mbToneMapping;
	float mfToneMappingKey;
	float mfToneMappingExposure;
	float mfToneMappingWhiteCut;

	bool mbColorGrading;
	tString msColorGrading;
	
	bool mbSkyboxColor;
	cColor mSkyboxColor;
	float mfSkyboxBrightness;
}

//---------------------------------------------------

class cScrMapEffectsHandler : iScrUserModule, iScrUserModule_Interface, iScrMapEffectsHandler_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mfFogFadeStartTarget = -1;
		mfFogFadeStartSpeed = -1;
		
		mfFogFadeEndTarget = -1;
		mfFogFadeEndSpeed = -1;
		
		mFogFadeColorTarget = cColor(0, 0);
		mFogFadeColorAdd = cColor(0, 0);
		mfFogFadeColorTime = -1;
			
		mvEnvParticleWindVelTarget = cVector3f_Zero;
		mvEnvParticleWindVelAdd = cVector3f_Zero;
		mfEnvParticleWindVelTime = -1;

		mEnvParticleColorTarget = cColor(1,1);
		mEnvParticleStartColor = cColor(1,1);
		mfEnvParticleColorMax = -1;
		mfEnvParticleColorTime = 0;

		mfEnvParticleBrightnessTarget = 1;
		mfEnvParticleBrightnessMax = -1;
		mfEnvParticleBrightnessTime = 0;
		
		mfEnvParticleFadeInStartTarget = 0.f;
		mfEnvParticleFadeInStart = 0.f;
		mfEnvParticleFadeInEndTarget = 0.f;
		mfEnvParticleFadeInEnd = 0.f;
		mfEnvParticleFadeInTime = 0.f;
		mfEnvParticleFadeInMax = -1.f;
		msEnvParticleFadeInName = "";
		
		mfFogFadeFalloffExpTarget = -1;
		mfFogFadeFalloffExpSpeed = -1;

		mfPresetFadeSpeed = 0;

		mSourcePreset = cEffectHandlerPreset("Source");

		mlPresetDoFId = -1;
	}
	
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	//MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}

	void OnMapLeave(cLuxMap @apMap)
	{
		Reset();
	}
	
	//------------------------------------------------------------
	
	void PreloadData(cLuxMap @apMap)
	{
	}
	
	void CreateWorldEntities(cLuxMap @apMap)
	{
		
	}
	void DestroyWorldEntities(cLuxMap @apMap)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterContainer(const tString&in asOldContainer)
	{
	
	}
	void OnLeaveContainer(const tString&in asNewContainer)
	{
	
	}
	//------------------------------------------------------------
	
	void Reset()
	{
		mfPresetFadeSpeed = 0;
		mfFogFadeColorTime = 0;
		mfFogFadeFalloffExpSpeed = 0;
		mfEnvParticleWindVelTime = 0;
		mfFogFadeEndSpeed = 0;
		mfFogFadeStartSpeed = 0;
		mfEnvParticleColorTime = 0;
		mfEnvParticleColorMax = -1;
		mfEnvParticleBrightnessTime = 0;
		mfEnvParticleBrightnessMax = -1;
		mfEnvParticleFadeInTime = 0;
		mfEnvParticleFadeInMax = -1;
		mlPresetDoFId = -1;
		mvPreset.resize(0);
		mSourcePreset.mbFog = false;
		mSourcePreset.mbSecondFog = false;
		mSourcePreset.mbDOF = false;
		mSourcePreset.mbBloom = false;
		mSourcePreset.mbToneMapping = false;
		mSourcePreset.mbDirLight = false;
		mSourcePreset.mbColorGrading = false;
		mSourcePreset.mbSkyboxColor = false;
	}

	//------------------------------------------------------------

	void Clear()
	{
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep) {}

	void VariableUpdate(float afTimeStep)
	{
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if(pMap is null || pMap.IsActive() == false) return;

		cWorld@ pWorld = pMap.GetWorld();
		if (pWorld is null) return;
		
		if (mfFogFadeStartSpeed > 0)
		{
			float fNewStart = cMath_IncreaseTo(pWorld.GetFogStart(), mfFogFadeStartSpeed*afTimeStep, mfFogFadeStartTarget);
			pWorld.SetFogStart(fNewStart);
			
			if (fNewStart == mfFogFadeStartTarget)
			{
				mfFogFadeStartSpeed = -1;
			}
		}
		
		if (mfFogFadeEndSpeed > 0)
		{
			float fNewEnd = cMath_IncreaseTo(pWorld.GetFogEnd(), mfFogFadeEndSpeed*afTimeStep, mfFogFadeEndTarget);
			pWorld.SetFogEnd(fNewEnd);
			
			if (fNewEnd == mfFogFadeEndTarget)
			{
				mfFogFadeEndSpeed = -1;
			}
		}
		
		if (mfFogFadeColorTime > 0)
		{
			mfFogFadeColorTime -= afTimeStep;
			cColor newColor = mfFogFadeColorTime < 0 ? mFogFadeColorTarget : 
												   pWorld.GetFogColor() + mFogFadeColorAdd*afTimeStep;
			
			pWorld.SetFogColor(newColor);
		}
		
		if (mfFogFadeFalloffExpSpeed > 0)
		{
			float fNewFalloffExp = cMath_IncreaseTo(pWorld.GetFogFalloffExp(), mfFogFadeFalloffExpSpeed*afTimeStep, mfFogFadeFalloffExpTarget);
			pWorld.SetFogFalloffExp(fNewFalloffExp);
			
			if (fNewFalloffExp == mfFogFadeFalloffExpTarget)
			{
				mfFogFadeFalloffExpSpeed = -1;
			}
		}
		
		if (mfEnvParticleWindVelTime > 0)
		{
			array<cEnvironmentParticles@> vParticles;
			Map_GetEnvironmentParticles(msEnvParticleWindName, vParticles);

			for(int i = 0; i < vParticles.length(); ++i)
			{
				cEnvironmentParticles@ pParticles = vParticles[i];
				mfEnvParticleWindVelTime -= afTimeStep;
				cVector3f newVelocity = mfEnvParticleWindVelTime < 0 ? mvEnvParticleWindVelTarget : 
													   pParticles.GetWindVelocity() + mvEnvParticleWindVelAdd*afTimeStep;
			
				pParticles.SetWindVelocity(newVelocity);
			}
		}

		if (mfEnvParticleColorTime < mfEnvParticleColorMax)
		{
			array<cEnvironmentParticles@> vParticles;
			Map_GetEnvironmentParticles(msEnvParticleColorName, vParticles);

			for(int i = 0; i < vParticles.length(); ++i)
			{
				cEnvironmentParticles@ pParticles = vParticles[i];
				mfEnvParticleColorTime = cMath_Min(mfEnvParticleColorTime + afTimeStep, mfEnvParticleColorMax);
				float fT = mfEnvParticleColorTime / mfEnvParticleColorMax;
				cColor newCol = mEnvParticleColorTarget * fT + mEnvParticleStartColor * (1.0 - fT);
			
				pParticles.SetColor(newCol);
			}
		}

		if (mfEnvParticleBrightnessTime < mfEnvParticleBrightnessMax)
		{
			array<cEnvironmentParticles@> vParticles;
			Map_GetEnvironmentParticles(msEnvParticleBrightnessName, vParticles);

			for(int i = 0; i < vParticles.length(); ++i)
			{
				cEnvironmentParticles@ pParticles = vParticles[i];
				mfEnvParticleBrightnessTime = cMath_Min(mfEnvParticleBrightnessTime + afTimeStep, mfEnvParticleBrightnessMax);
				float fT = mfEnvParticleBrightnessTime / mfEnvParticleBrightnessMax;
				float fNewBrightness = mfEnvParticleBrightnessTarget * fT + pParticles.GetBrightness() * (1.0 - fT);
				
				pParticles.SetBrightness(fNewBrightness);
			}
		}
		
		if (mfEnvParticleFadeInTime < mfEnvParticleFadeInMax)
		{
			array<cEnvironmentParticles@> vParticles;
			Map_GetEnvironmentParticles(msEnvParticleFadeInName, vParticles);
			
			for(int i = 0; i < vParticles.length(); ++i)
			{
				cEnvironmentParticles@ pParticles = vParticles[i];
				mfEnvParticleFadeInTime = cMath_Min(mfEnvParticleFadeInTime + afTimeStep, mfEnvParticleFadeInMax);
				float fT = mfEnvParticleFadeInTime / mfEnvParticleFadeInMax;
				
				float fFadeInStart = mfEnvParticleFadeInStartTarget * fT + mfEnvParticleFadeInStart * (1.0 - fT);
				float fFadeInEnd = mfEnvParticleFadeInEndTarget * fT + mfEnvParticleFadeInEnd * (1.0 - fT);
				
				pParticles.SetFadeInStart(fFadeInStart);
				pParticles.SetFadeInEnd(fFadeInEnd);
			}			
		}

		if(mfPresetFadeSpeed > 0)
		{
			mfPresetFade += mfPresetFadeSpeed * afTimeStep;
			
			if(mfPresetFade > 1.0)
			{
				mfPresetFadeSpeed = 0;
				mfPresetFade = 1.0;
			}

			float fT = (mfPresetFade * mfPresetFade * (3.0f - 2.0f * mfPresetFade));
			
			///////////////////
			// Fade fog
			if(mSourcePreset.mbFog)
			{
				pWorld.SetFogStart(cMath_InterpolateLinear(mSourcePreset.mfFogStart, mvPreset[mlPresetID].mfFogStart, fT));
				pWorld.SetFogEnd(cMath_InterpolateLinear(mSourcePreset.mfFogEnd, mvPreset[mlPresetID].mfFogEnd, fT));
				pWorld.SetFogFalloffExp(cMath_InterpolateLinear(mSourcePreset.mfFogFalloffExp, mvPreset[mlPresetID].mfFogFalloffExp, fT));
				pWorld.SetFogBrightness(cMath_InterpolateLinear(mSourcePreset.mfFogBrightness, mvPreset[mlPresetID].mfFogBrightness, fT));
				pWorld.SetFogColor(mSourcePreset.mFogColor * (1.0 - fT) + mvPreset[mlPresetID].mFogColor * fT);
			}
			
			if(mSourcePreset.mbSecondFog)
			{
				pWorld.SetSecondaryFogStart(cMath_InterpolateLinear(mSourcePreset.mfSecondFogStart, mvPreset[mlPresetID].mfSecondFogStart, fT));
				pWorld.SetSecondaryFogEnd(cMath_InterpolateLinear(mSourcePreset.mfSecondFogEnd, mvPreset[mlPresetID].mfSecondFogEnd, fT));
				pWorld.SetSecondaryFogFalloffExp(cMath_InterpolateLinear(mSourcePreset.mfSecondFogFalloffExp, mvPreset[mlPresetID].mfSecondFogFalloffExp, fT));
				pWorld.SetSecondaryFogBrightness(cMath_InterpolateLinear(mSourcePreset.mfSecondFogBrightness, mvPreset[mlPresetID].mfSecondFogBrightness, fT));
				pWorld.SetSecondaryFogColor(mSourcePreset.mSecondFogColor * (1.0 - fT) + mvPreset[mlPresetID].mSecondFogColor * fT);
			}
			
			if(mSourcePreset.mbToneMapping)
			{
				pWorld.SetToneMappingKey(cMath_InterpolateLinear(mSourcePreset.mfToneMappingKey, mvPreset[mlPresetID].mfToneMappingKey, fT));
			}
			
			if(mSourcePreset.mbSkyboxColor)
			{
				pWorld.SetSkyBoxColor(mSourcePreset.mSkyboxColor * (1.0 - fT) + mvPreset[mlPresetID].mSkyboxColor * fT);
				pWorld.SetSkyBoxBrightness(cMath_InterpolateLinear(mSourcePreset.mfSkyboxBrightness, mvPreset[mlPresetID].mfSkyboxBrightness, fT));
			}
			
			if(mSourcePreset.mbDirLight)
			{
				cLightDirectional@ pDirLight = pWorld.GetDirectionalLight();

				if(mvPreset[mlPresetID].mbDirLightActive == false)
				{
					pDirLight.SetBrightness(cMath_InterpolateLinear(mSourcePreset.mfDirLightBrightness, 0, fT));
				}
				else
				{
					pDirLight.SetBrightness(cMath_InterpolateLinear(mSourcePreset.mfDirLightBrightness, mvPreset[mlPresetID].mfDirLightBrightness, fT));
					pDirLight.SetDirection(cMath_Vector3Normalize(mSourcePreset.mvDirLightDir * (1.0 - fT) + mvPreset[mlPresetID].mvDirLightDir * fT));
					pDirLight.SetAmbientColorGround(mSourcePreset.mDirLightGroundColor * (1.0 - fT) + mvPreset[mlPresetID].mDirLightGroundColor * fT);
					pDirLight.SetAmbientColorSky(mSourcePreset.mDirLightSkyColor * (1.0 - fT) + mvPreset[mlPresetID].mDirLightSkyColor * fT);
					pDirLight.SetDiffuseColor(mSourcePreset.mDirLightDiffuseColor * (1.0 - fT) + mvPreset[mlPresetID].mDirLightDiffuseColor * fT);
				}
			}

			if(mfPresetFade == 1.0)
			{
				if(mSourcePreset.mbFog) pWorld.SetFogActive(mvPreset[mlPresetID].mbFogActive);
				if(mSourcePreset.mbSecondFog) pWorld.SetSecondaryFogActive(mvPreset[mlPresetID].mbSecondFogActive);
				if(mSourcePreset.mbDirLight) pWorld.SetDirectionalLightActive(mvPreset[mlPresetID].mbDirLightActive);

				mSourcePreset.mbFog = false;
				mSourcePreset.mbSecondFog = false;
				mSourcePreset.mbDirLight = false;
				mSourcePreset.mbToneMapping = false;
				mSourcePreset.mbColorGrading = false;
				mSourcePreset.mbSkyboxColor = false;
			}
		}
	}

	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep){}
		
	//------------------------------------------------------------
	
	
	void OnDraw(float afFrameTime)
	{
	}
	
	//------------------------------------------------------------
		
	void OnPostRender(float afFrameTime)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// MODULE SPECIFIC
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void FadeFogStart(float afX, float afTime)
	{
		if (afTime <= 0) afTime = 0.001;
		
		cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
		
		mfFogFadeStartSpeed = cMath_Abs(pWorld.GetFogStart()-afX)/afTime;
		mfFogFadeStartTarget = afX;
	}
	
	void FadeFogEnd(float afX, float afTime)
	{
		if (afTime <= 0) afTime = 0.001;
		
		cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
		
		mfFogFadeEndSpeed = cMath_Abs(pWorld.GetFogEnd()-afX)/afTime;
		mfFogFadeEndTarget = afX;
	}
	
	void FadeFogColor(const cColor &in aCol, float afTime)
	{
		if (afTime <= 0) afTime = 0.001;
		
		cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
		
		mfFogFadeColorTime = afTime;
		mFogFadeColorTarget = aCol;
		
		mFogFadeColorAdd = (aCol-pWorld.GetFogColor())/afTime;
	}
	
	void FadeFogFalloffExp(float afX, float afTime)
	{
		if (afTime <= 0) afTime = 0.001;
		
		cWorld@ pWorld = cLux_GetCurrentMap().GetWorld();
		
		mfFogFadeFalloffExpSpeed = cMath_Abs(pWorld.GetFogFalloffExp()-afX)/afTime;
		mfFogFadeFalloffExpTarget = afX;
	}
	
	void FadeEnvParticlesWindVel(const cVector3f avWindVel, float afTime, tString asName)
	{
		if (afTime <= 0) afTime = 0.001;
		
		msEnvParticleWindName = asName;
		array<cEnvironmentParticles@> vParticles;
		Map_GetEnvironmentParticles(msEnvParticleWindName, vParticles);

		if(vParticles.empty())
		{
			mfEnvParticleWindVelTime = 0;
		}
		else
		{
			mvEnvParticleWindVelAdd = 0;
		
			mfEnvParticleWindVelTime = afTime;
			mvEnvParticleWindVelTarget = avWindVel;
			int lNum = 0;
			for(uint i = 0; i < vParticles.length(); ++i)
			{
				cEnvironmentParticles@ pParticles = vParticles[i];
		
				mvEnvParticleWindVelAdd += (avWindVel-pParticles.GetWindVelocity())/afTime;
				lNum++;
			}

			mvEnvParticleWindVelAdd /= lNum;
		}
	}

	void FadeEnvParticlesColor(const cColor&in aColor, float afTime, tString asName)
	{		
		if (afTime <= 0) afTime = 0.001;
		
		msEnvParticleColorName = asName;
		array<cEnvironmentParticles@> vParticles;
		Map_GetEnvironmentParticles(msEnvParticleColorName, vParticles);

		if(vParticles.empty())
		{
			mfEnvParticleColorMax = -1;
		}
		else
		{
			mfEnvParticleColorTime = 0;
			mfEnvParticleColorMax = afTime;
			mEnvParticleColorTarget = aColor;
			
			for (int i = 0; i < vParticles.size(); ++i)
			{
				cEnvironmentParticles@ pParticle = vParticles[i];
				mEnvParticleStartColor = pParticle.GetColor();
			}			
		}
	}

	void FadeEnvParticlesBrightness(float afX, float afTime, tString asName)
	{		
		if (afTime <= 0) afTime = 0.001;
		
		msEnvParticleBrightnessName = asName;
		array<cEnvironmentParticles@> vParticles;
		Map_GetEnvironmentParticles(msEnvParticleBrightnessName, vParticles);

		if(vParticles.empty())
		{
			mfEnvParticleBrightnessMax = -1;
		}
		else
		{
			mfEnvParticleBrightnessTime = 0;
			mfEnvParticleBrightnessMax = afTime;
			mfEnvParticleBrightnessTarget = afX;
		}
	}
	
	void FadeEnvParticlesFadeInDist(float afStartDist, float afEndDist, float afTime, const tString &in asName)
	{
		if (afTime <= 0) afTime = 0.001f;
		
		msEnvParticleFadeInName = asName;
		array<cEnvironmentParticles@> vParticles;
		Map_GetEnvironmentParticles(msEnvParticleFadeInName, vParticles);
		
		if (vParticles.empty())
		{
			mfEnvParticleFadeInMax = 0.f;
		}
		else
		{
			mfEnvParticleFadeInTime = 0.f;
			mfEnvParticleFadeInMax = afTime;
			mfEnvParticleFadeInStartTarget = afStartDist;
			mfEnvParticleFadeInEndTarget = afEndDist;
			
			for (int i = 0; i < vParticles.size(); ++i)
			{
				cEnvironmentParticles@ pParticle = vParticles[i];
				mfEnvParticleFadeInStart = pParticle.GetFadeInStart();
				mfEnvParticleFadeInEnd = pParticle.GetFadeInEnd();
			}
		}
	}

	//------------------------------------------------------------

	int GetPreset(tString asName, bool abCreate)
	{
		for(uint i = 0; i < mvPreset.length(); ++i)
		{
			if(mvPreset[i].msName == asName) return i;
		}
		
		if(abCreate)
		{
			mvPreset.push_back(cEffectHandlerPreset(asName));

			return mvPreset.length() - 1;
		}
		else
		{
			return -1;
		}
	}
	
	//------------------------------------------------------------

	void PresetSetFog(tString asName, bool abActive, float afStart, float afEnd, float afFalloffExp, cColor aColor, float afBrightness, bool abUnderwater, bool abSkybox, bool abExponential)
	{
		int i = GetPreset(asName, true);
		
		mvPreset[i].mbFogActive = abActive;
		mvPreset[i].mfFogStart = afStart;
		mvPreset[i].mfFogEnd = afEnd;
		mvPreset[i].mfFogFalloffExp = afFalloffExp;
		mvPreset[i].mfFogBrightness = afBrightness;
		mvPreset[i].mFogColor = aColor;
		mvPreset[i].mbFogUnderwater = abUnderwater;
		mvPreset[i].mbFogSkybox = abSkybox;
		mvPreset[i].mbFogExponential = abExponential;
		mvPreset[i].mbFog = true;
	}

	void PresetSetSecondaryFog(tString asName, bool abActive, float afStart, float afEnd, float afFalloffExp, cColor aColor, float afBrightness)
	{
		int i = GetPreset(asName, true);
		
		mvPreset[i].mbSecondFogActive = abActive;
		mvPreset[i].mfSecondFogStart = afStart;
		mvPreset[i].mfSecondFogEnd = afEnd;
		mvPreset[i].mfSecondFogFalloffExp = afFalloffExp;
		mvPreset[i].mfSecondFogBrightness = afBrightness;
		mvPreset[i].mSecondFogColor = aColor;
		mvPreset[i].mbSecondFog = true;
	}

	void PresetSetDepthOfField(tString asName, bool abActive, float afStart, float afEnd, float afFalloff)
	{
		int i = GetPreset(asName, true);

		mvPreset[i].mbDOFActive = abActive;
		mvPreset[i].mfDOFFocusStart = afStart;
		mvPreset[i].mfDOFFocusEnd = afEnd;
		mvPreset[i].mfDOFFalloff = afFalloff;
		mvPreset[i].mbDOF = true;
	}
	
	void PresetSetBloom(tString asName, float afWidth, float afBrightPass, float afFalloff, cColor aTint)
	{
		int i = GetPreset(asName, true);

		mvPreset[i].mfBloomWidth = afWidth;
		mvPreset[i].mfBloomBrightPass = afBrightPass;
		mvPreset[i].mfBloomFalloff = afFalloff;
		mvPreset[i].mBloomTint = aTint;
		mvPreset[i].mbBloom = true;
	}
	
	void PresetSetToneMapping(tString asName, float afToneMappingKey, float afToneMappingExposure, float afToneMappingWhiteCut)
	{
		int i = GetPreset(asName, true);

		mvPreset[i].mfToneMappingKey = afToneMappingKey;
		mvPreset[i].mfToneMappingExposure = afToneMappingExposure;
		mvPreset[i].mfToneMappingWhiteCut = afToneMappingWhiteCut;
		mvPreset[i].mbToneMapping = true;
	}
	
	void PresetSetColorGrading(tString asName, tString asColorGrading)
	{
		int i = GetPreset(asName, true);

		mvPreset[i].msColorGrading = asColorGrading;
		mvPreset[i].mbColorGrading = true;
	}
	
	void PresetSetSkybox(tString asName, const cColor &in aColor, float afBrightness)
	{
		int i = GetPreset(asName, true);

		mvPreset[i].mSkyboxColor = aColor;
		mvPreset[i].mfSkyboxBrightness = afBrightness;
		mvPreset[i].mbSkyboxColor = true;
	}

	void PresetSetDirLight(tString asName, bool abDirLightActive, float afDirLightBrightness, cVector3f avDirLightDir, cColor aDirLightGroundColor, cColor aDirLightSkyColor, cColor aDirLightDiffuseColor)
	{
		int i = GetPreset(asName, true);

		mvPreset[i].mbDirLightActive = abDirLightActive;
		mvPreset[i].mfDirLightBrightness = abDirLightActive ? afDirLightBrightness : 0;
		mvPreset[i].mvDirLightDir = avDirLightDir;
		mvPreset[i].mDirLightGroundColor = aDirLightGroundColor;
		mvPreset[i].mDirLightSkyColor = aDirLightSkyColor;
		mvPreset[i].mDirLightDiffuseColor = aDirLightDiffuseColor;
		mvPreset[i].mbDirLight = true;
	}

	void FadeToWorldSettings(cWorld@ apWorld, float afTime)
	{
		/////////////
		// Setup a preset from this world
		PresetSetFog(apWorld.GetName(), apWorld.GetFogActive(), apWorld.GetFogStart(), apWorld.GetFogEnd(), apWorld.GetFogFalloffExp(), apWorld.GetFogColor(), apWorld.GetFogBrightness(), apWorld.GetFogUnderwater(), apWorld.GetFogUseSkybox(), apWorld.GetFogExponential());
		PresetSetSecondaryFog(apWorld.GetName(), apWorld.GetSecondaryFogActive(), apWorld.GetSecondaryFogStart(), apWorld.GetSecondaryFogEnd(), apWorld.GetSecondaryFogFalloffExp(), apWorld.GetSecondaryFogColor(), apWorld.GetSecondaryFogBrightness());
		PresetSetToneMapping(apWorld.GetName(), apWorld.GetToneMappingKey(), apWorld.GetToneMappingExposure(), apWorld.GetToneMappingWhiteCut());

		cLightDirectional@ pDirLight = apWorld.GetDirectionalLight();
		PresetSetDirLight(apWorld.GetName(), apWorld.GetDirectionalLightActive(), pDirLight.GetBrightness(), pDirLight.GetDirection(), pDirLight.GetAmbientColorGround(), pDirLight.GetAmbientColorSky(), pDirLight.GetDiffuseColor());

		////////////
		// Fade to the preset
		FadePreset(apWorld.GetName(), afTime);
	}

	//------------------------------------------------------------
	
	void FadePreset(tString asName, float afFadeTime)
	{
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if(pMap is null) return;

		cWorld@ pWorld = pMap.GetWorld();
		if (pWorld is null) return;
		
		int i = GetPreset(asName, false);

		if(i == -1)
		{
			Error("Can not fade in preset '"+asName+"'. It does not exist in cScrMapEffectsHandler");
			return;
		}
		else
		{
			//////////////
			// Init fade
			mlPresetID = i;
			if(afFadeTime <= 0.0) afFadeTime = 0.0001f; 

			int i = 0; 

			////////////
			// Fog
			if(mvPreset[mlPresetID].mbFog)
			{
				//////////////
				// Setup fog if needed
				mSourcePreset.mfFogStart = pWorld.GetFogStart();
				mSourcePreset.mfFogEnd = pWorld.GetFogEnd();
				mSourcePreset.mfFogFalloffExp = pWorld.GetFogFalloffExp();
				mSourcePreset.mfFogBrightness = pWorld.GetFogBrightness();
				mSourcePreset.mFogColor = pWorld.GetFogColor();
				mSourcePreset.mbFog = true;

				if(pWorld.GetFogActive() == false)
				{
					mSourcePreset.mfFogStart = mvPreset[mlPresetID].mfFogStart;
					mSourcePreset.mfFogEnd = mvPreset[mlPresetID].mfFogEnd;
					mSourcePreset.mfFogFalloffExp = mvPreset[mlPresetID].mfFogFalloffExp;
					mSourcePreset.mfFogBrightness = mvPreset[mlPresetID].mfFogBrightness;
					mSourcePreset.mFogColor = mvPreset[mlPresetID].mFogColor;
					mSourcePreset.mFogColor.a = 0.0;
				}

				if(mvPreset[mlPresetID].mbFogActive)
				{
					pWorld.SetFogActive(true);
				}
				else
				{
					mvPreset[mlPresetID].mFogColor.a = 0.0f;
				}

				pWorld.SetFogUnderwater(mvPreset[mlPresetID].mbFogUnderwater);
				pWorld.SetFogUseSkybox(mvPreset[mlPresetID].mbFogSkybox);
				pWorld.SetFogExponential(mvPreset[mlPresetID].mbFogExponential);
			}

			////////////
			// Second fog
			if(mvPreset[mlPresetID].mbSecondFog)
			{
				mSourcePreset.mfSecondFogStart = pWorld.GetSecondaryFogStart();
				mSourcePreset.mfSecondFogEnd = pWorld.GetSecondaryFogEnd();
				mSourcePreset.mfSecondFogFalloffExp = pWorld.GetSecondaryFogFalloffExp();
				mSourcePreset.mfSecondFogBrightness = pWorld.GetSecondaryFogBrightness();
				mSourcePreset.mSecondFogColor = pWorld.GetSecondaryFogColor();
				mSourcePreset.mbSecondFog = true;

				if(pWorld.GetSecondaryFogActive() == false)
				{
					mSourcePreset.mfSecondFogStart = mvPreset[mlPresetID].mfSecondFogStart;
					mSourcePreset.mfSecondFogEnd = mvPreset[mlPresetID].mfSecondFogEnd;
					mSourcePreset.mfSecondFogFalloffExp = mvPreset[mlPresetID].mfSecondFogFalloffExp;
					mSourcePreset.mfSecondFogBrightness = mvPreset[mlPresetID].mfSecondFogBrightness;
					mSourcePreset.mSecondFogColor = mvPreset[mlPresetID].mSecondFogColor;
					mSourcePreset.mSecondFogColor.a = 0.0;
				}

				if(mvPreset[mlPresetID].mbSecondFogActive)
				{
					pWorld.SetSecondaryFogActive(true);
				}
				else
				{
					mvPreset[mlPresetID].mSecondFogColor.a = 0.0f;
					mvPreset[mlPresetID].mfSecondFogEnd = 1000.0;
				}
			}

			////////////
			// Dof
			if(mvPreset[mlPresetID].mbDOF)
			{
				if(mvPreset[mlPresetID].mbDOFActive)
				{
					if(mlPresetDoFId == -1)
					{
						// Start new
						mlPresetDoFId = Effect_DoF_Start(mvPreset[mlPresetID].mfDOFFocusStart, 
														 mvPreset[mlPresetID].mfDOFFocusEnd,
														 mvPreset[mlPresetID].mfDOFFalloff,
														 afFadeTime);
					}
					else
					{
						// Fade current
						Effect_DoF_FadeFocus(mlPresetDoFId, mvPreset[mlPresetID].mfDOFFocusStart,
															mvPreset[mlPresetID].mfDOFFocusEnd,
															afFadeTime);
						Effect_DoF_FadeFalloff(mlPresetDoFId, mvPreset[mlPresetID].mfDOFFalloff,  afFadeTime);
					}
				}
				else if(mlPresetDoFId != -1)
				{
					// Fade out
					Effect_DoF_FadeOut(mlPresetDoFId, afFadeTime);
					mlPresetDoFId = -1;
				}
			}

			//////////////
			// Bloom
			if(mvPreset[mlPresetID].mbBloom)
			{
				Effect_Bloom_FadeBrightPass(mvPreset[mlPresetID].mfBloomBrightPass, afFadeTime);
				Effect_Bloom_FadeBloomWidth(mvPreset[mlPresetID].mfBloomWidth, afFadeTime);
				Effect_Bloom_FadeBloomFalloff(mvPreset[mlPresetID].mfBloomFalloff, afFadeTime);
				Effect_Bloom_FadeBloomTint(mvPreset[mlPresetID].mBloomTint.r, 
										   mvPreset[mlPresetID].mBloomTint.g, 
										   mvPreset[mlPresetID].mBloomTint.b, 
										   afFadeTime);
			}
			
			//////////////
			// DirLight
			if(mvPreset[mlPresetID].mbDirLight)
			{
				cLightDirectional@ pDirLight = pWorld.GetDirectionalLight();
				
				mSourcePreset.mbDirLight = true;
				mSourcePreset.mbDirLightActive = pWorld.GetDirectionalLightActive();

				if(mvPreset[mlPresetID].mbDirLightActive == true)
				{
					if(pWorld.GetDirectionalLightActive() == false)
					{
						pWorld.SetDirectionalLightActive(true);
						pDirLight.SetBrightness(0.0f);
					}
				}

				if(mSourcePreset.mbDirLightActive == false)
				{
					mSourcePreset.mfDirLightBrightness = 0.0f;
					mSourcePreset.mvDirLightDir = mvPreset[mlPresetID].mvDirLightDir;
					mSourcePreset.mDirLightGroundColor = mvPreset[mlPresetID].mDirLightGroundColor;
					mSourcePreset.mDirLightSkyColor = mvPreset[mlPresetID].mDirLightSkyColor;
					mSourcePreset.mDirLightDiffuseColor = mvPreset[mlPresetID].mDirLightDiffuseColor;
				}
				else
				{
					mSourcePreset.mfDirLightBrightness = pDirLight.GetBrightness();
					mSourcePreset.mvDirLightDir = pDirLight.GetDirection();
					mSourcePreset.mDirLightGroundColor = pDirLight.GetAmbientColorGround();
					mSourcePreset.mDirLightSkyColor = pDirLight.GetAmbientColorSky();
					mSourcePreset.mDirLightDiffuseColor = pDirLight.GetDiffuseColor();
				}
			}

			//////////////
			// Tonemapping
			if(mvPreset[mlPresetID].mbToneMapping)
			{
				mSourcePreset.mbToneMapping = true;
				mSourcePreset.mfToneMappingKey = pWorld.GetToneMappingKey();

				pWorld.FadeToneMappingWhiteCut(mvPreset[mlPresetID].mfToneMappingWhiteCut, afFadeTime);
				pWorld.FadeToneMappingExposure(mvPreset[mlPresetID].mfToneMappingExposure, afFadeTime);
			}

			//////////////
			// Color grading
			if(mvPreset[mlPresetID].mbColorGrading)
			{
				pWorld.FadeGradingTexture(mvPreset[mlPresetID].msColorGrading, afFadeTime);
			}
			
			if(mvPreset[mlPresetID].mbSkyboxColor)
			{
				mSourcePreset.mSkyboxColor = pWorld.GetSkyBoxColor();
				mSourcePreset.mfSkyboxBrightness = pWorld.GetSkyBoxBrightness();
				mSourcePreset.mbSkyboxColor = true;
			}

			//////////////
			// Setup fade speed
			mfPresetFade = 0;
			mfPresetFadeSpeed = (1.0 / afFadeTime);
		}
	}

