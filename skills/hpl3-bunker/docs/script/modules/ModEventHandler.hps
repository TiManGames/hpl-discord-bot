	//------------------------------------------------------------
	
	void OnExitPressed(){}
	void AppGotInputFocus(){}
	void AppLostInputFocus(){}
	
	
	//------------------------------------------------------------
	
	void TriggerEvent(eModEvent eventID)
	{
		for (int i=0;i<mListeners.size();i++)
		{
			int modID = mListeners[i];
			iModEventListener@ pHandler = cast<iModEventListener>(cLux_GetUserModuleFromID(modID));
			pHandler.OnModEvent(eventID);
		}
	}
	
	//------------------------------------------------------------
	
	void AddListener(int iModuleID)
	{
		for (int i=0;i<mListeners.size();i++)
			if (mListeners[i]==iModuleID)
				return;
		mListeners.push_back(iModuleID);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	array<int> mListeners;
		
	//------------------------------------------------------------
}
