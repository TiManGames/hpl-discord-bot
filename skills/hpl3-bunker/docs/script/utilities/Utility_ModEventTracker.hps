//------------------------------------------------------------

// Class to make it easier to fire mod events

class cUtility_ModEventTracker
{
	eModEvent m_evID;
	bool m_signalled = false;
	float m_fHowLongToTrigger;
	float m_fTime;
	
	/** 
	@param fHowLongToTrigger - how much time the thing is consistently signalled before the mod event is sent. 
	 */
	cUtility_ModEventTracker(eModEvent evID, float fHowLongToTrigger)
	{
		m_evID = evID;
		m_fHowLongToTrigger = fHowLongToTrigger;
		Reset();
	}

	void Reset()
	{
		m_signalled = false;
		m_fTime=0.0f;
	}
	
	/**
	 * @param afTimeStep Standard delta time step
	 * @param bSignalCondition Should the signal be sent, or not? This must be consistently true for fHowLongToTrigger seconds before the signal is actually sent.
	 */
	void Update(float afTimeStep, bool bSignalCondition)
	{
		if (m_signalled)
			return;
		if (bSignalCondition)
		{
			m_fTime+=afTimeStep;
			if (m_fTime>m_fHowLongToTrigger)
			{
				ModEvent_Trigger(m_evID);
				m_signalled = true;
			}
		}
		else
		{
			m_fTime=0.0f;
		}
	}
};

//------------------------------------------------------------

// Class to make it easier to fire mod events

class cUtility_ModEventAverageTracker
{
	eModEvent m_evID;
	bool m_signalled = false;
	float m_fHowLongToTrigger;
	float m_fTime;
	float[] m_afValues;
	float m_fThreshold;
	float m_fSettleTime;
	int m_lValueIndex;
	
	/** 
	@param fHowLongToTrigger - how much time the thing is consistently signalled before the mod event is sent. 
	 */
	cUtility_ModEventAverageTracker(eModEvent evID, float fHowLongToTrigger, float afThreshold, float afSettleTime=0.0f)
	{
		m_evID = evID;
		m_fHowLongToTrigger = fHowLongToTrigger;
		m_fThreshold = afThreshold;
		m_fSettleTime = afSettleTime;
		Reset();
	}

	void Reset()
	{
		m_signalled = false;
		m_fTime=-m_fSettleTime;
		m_afValues.resize(0);
		m_lValueIndex=0;
	}
	
	/**
	 * @param afTimeStep Standard delta time step
	 */
	void Update(float afTimeStep,  float afValue)
	{
		if (m_signalled)
			return;
			
		if (m_fTime<0.0f)
		{
			m_fTime+=afTimeStep;
			if (m_fTime>=0.0f)
			{
				m_fTime=0.0f;
			}
			return;
		}
		
		m_lValueIndex = (m_lValueIndex+1)%10;
		if (m_afValues.size()<10)
		{
			m_afValues.push_back(afValue);
			return;
		}
		
		m_afValues[m_lValueIndex] = afValue;
		float afAverage = 0.0f;
		for (int i=0;i<10;i++)
		{
			afAverage+=m_afValues[i];
		}
		afAverage/=10.0f;
		
		//cLux_AddDebugMessage("Effort:"+afAverage);
			
		if (afAverage>m_fThreshold)
		{
			m_fTime+=afTimeStep;
			if (m_fTime>m_fHowLongToTrigger)
			{
				ModEvent_Trigger(m_evID);
				m_signalled = true;
			}
		}
		else
		{
			m_fTime=0.0f;
		}
	}
}

