#include "effect/Effects.hps"
#include "custom/effects/Effects_Custom.hps"
#include "helpers/helper_effects.hps"
#include "player/Player.hps"
#include "custom/player/PlayerTypes_Custom.hps"

/////////////////////////////////////////
// DOLLY ZOOM
/////////////////////////////////////////

//------------------------------------------------------------

class cScrEffect_DollyZoom : iScrEffect, iScrEffect_Interface, iScrEffect_DollyZoom
{

	//----------------------------------
	
	void Init()
	{
	}
	
	//----------------------------------
	
	void OnDestroy()
	{
	}
	
	//----------------------------------
	
	/////////////////////////////////////////
	// PUBLIC METHODS
	/////////////////////////////////////////
	
	//---------------------------------
	
	void Start(float afAmount, float afTime, float afFadeInTime, float afFadeOutTime)
	{		
		mlState = 0; //0 = fadein, 1 = stay, 2 = fadeout
		mfAmount = 0;
		mfAmountTarget = afAmount;
		mfStayTime = (afTime < 0) ? 1.0f : afTime;
		mfFadeInTime = (afFadeInTime < 0) ? 1.0f : afFadeInTime;
		mfFadeOutTime = (afFadeOutTime < 0) ? 1.0f : afFadeOutTime;
		
		mfFadeSpeed = cMath_Abs(mfAmountTarget - mfAmount)/mfFadeInTime;
		
		mfCurrentTimer = mfFadeInTime;

		mBaseObj.SetActive(true);
	}
	
	//----------------------------------

	void Stop()
	{
		cLuxPlayer@ pPlayer = cLux_GetPlayer();
		pPlayer.SetCameraFOVMul(ePlayerFOVMul_DollyZoom, 1.f);
		pPlayer.SetCameraPosAdd(eCameraAddType_DollyZoom, 0.f);
		
		mBaseObj.SetActive(false);
	}
		
	//----------------------------------
	
	/////////////////////////////////////////
	// GENERAL CALLBACKS
	/////////////////////////////////////////
	
	
	//----------------------------------
	
	void OnStart()
	{
	}

	//----------------------------------
	
	void OnMapEnter(cLuxMap @apMap)
	{
	}
	
	//----------------------------------
	
	void OnMapLeave(cLuxMap @apMap)
	{
		Reset();
	}

	//----------------------------------
	
	void Reset()
	{		
	}
	
	//----------------------------------
	
	void Update(float afTimeStep)
	{		
		cLuxPlayer@ pPlayer = cLux_GetPlayer();
		cCamera@ pCam = cLux_GetPlayer().GetCamera();
		
		mfCurrentTimer -= afTimeStep;
		
		if (mlState == 0) // fade in
		{
			if (mfCurrentTimer > 0)
			{
				mfFadeSpeed = cMath_Abs(mfAmountTarget - mfAmount)/mfFadeInTime;
				mfAmount = cMath_IncreaseTo(mfAmount, afTimeStep * mfFadeSpeed, mfAmountTarget);
							
				float fT = cMath_Easing(eEasing_SineInOut, mfAmount / mfAmountTarget);			
				float fFOVMul = 1.f + fT * mfAmount;
			
				pPlayer.SetCameraFOVMul(ePlayerFOVMul_DollyZoom, fFOVMul);
			
				cVector3f vPosAdd = (cVector3f_Forward * mfAmount) * fT;
				pPlayer.SetCameraPosAdd(eCameraAddType_DollyZoom, vPosAdd);
			}
			else
			{
				mlState = 1;
				mfCurrentTimer = mfStayTime;
				return;
			}
		}
		else if (mlState == 1) // stay
		{
			if (mfCurrentTimer <= 0)
			{
				mlState = 2;
				mfCurrentTimer = mfFadeOutTime;
				return;
			}
		}
		else // fade out
		{
			if (mfCurrentTimer > 0)
			{
				mfFadeSpeed = cMath_Abs(mfAmountTarget - mfAmount)/mfFadeOutTime;

				mfAmount = cMath_IncreaseTo(mfAmount, afTimeStep * mfFadeSpeed, 0);
					
				float fT = cMath_Easing(eEasing_SineInOut, mfAmount / mfAmountTarget);					
				float fFOVMul = 1.f + fT * mfAmount;
					
				pPlayer.SetCameraFOVMul(ePlayerFOVMul_DollyZoom, fFOVMul);
					
				cVector3f vPosAdd = (cVector3f_Forward * mfAmount) * fT;
				pPlayer.SetCameraPosAdd(eCameraAddType_DollyZoom, vPosAdd);
			}
			else
			{
				Stop();
			}
		}
	}

	void OnDraw(float afTimeStep)
	{
	}

	//----------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//----------------------------------
	
	float mlState;
	float mfAmount;
	float mfAmountTarget;
	float mfCurrentTimer;
	float mfStayTime;
	float mfFadeInTime;
	float mfFadeOutTime;
	float mfFadeSpeed;
			
	//----------------------------------
}