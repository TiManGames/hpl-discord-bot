#include "custom/props/Prop_Rigid.hps"
#include "base/Base_Types.hps"
#include "helpers/helper_game.hps"
#include "helpers/helper_modules.hps"
#include "helpers/helper_player.hps"
#include "custom/helpers/helper_modules_custom.hps"

#include "custom/helpers/helper_particle_settings.hps"

//------------------------------------------------------------

const float gfFuelSpill_TimeUntilSpread = 0.05f;
const float gfFuelSpill_SpreadDist = 1.f;

const int glFuelSpill_SpreadDirNum = 6;

const cVector3f gvFuelSpill_AreaSize = cVector3f(1.25f, 2.f, 1.25f);

const tString gsFuelSpill_BurnLoopSound = "weapons/throwables/molotov/burn_loop";
const tString gsFuelSpill_IgniteSound = "weapons/throwables/molotov/ignite";

const tString gsFuelSpill_FireEffectsEnt = "molotov_cocktail_fire_effects.ent";
const tString[] gsFuelSpill_FireParticles = { "molotov_fire.ps", "molotov_fire_02.ps" };

const int glFuelSpill_MaxSpillsPerMap = 9;

//------------------------------------------------------------

enum eFuelSpillState
{
	eFuelSpillState_Unlit,
	eFuelSpillState_PreBurn,
	eFuelSpillState_Burn,
	eFuelSpillState_Spent	
}

//------------------------------------------------------------

class cScrPropFuelSpill : cScrPropRigid
{
	//------------------------------------------------------------
	
	///////////////////////////////
	// INIT
	///////////////////////////////
	
	//------------------------------------------------------------

	void Init()
	{
		cScrPropRigid::Init();
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld@ apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropRigid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		mBaseObj.SetEffectsActive(false, false);	
		
		uint lTimeStamp = cSystem_GetApplicationTime();
		mBaseObj.SetVarInt("CreationTimeStamp", lTimeStamp);
		
		cLuxMap@ pMap = mBaseObj.GetMap();
		if (pMap is null) return;

		//////////
		// Preload
		for(int i = 0; i < gsFuelSpill_FireParticles.length(); ++i)
			ParticleSetting_PreloadParticles(gsFuelSpill_FireParticles[i]);
		
		Entity_Preload(gsFuelSpill_FireEffectsEnt);

		//////////////////////////////
		// Prevent too many oil spills from being generated by disabling the oldest ones
		array<iLuxEntity@> vSpills;
		pMap.GetEntityArray("*", eLuxEntityType_Prop, "cScrPropFuelSpill", vSpills);
		
		// Remove oldest spill
		if (vSpills.length() > glFuelSpill_MaxSpillsPerMap-1)
		{
			int lGeneratedSpillCount = 0;
			uint lOldestTimeStamp = lTimeStamp;
			int lOldestIndex = 0;
			for (uint i = 0; i < vSpills.length(); i++)
			{
				iLuxEntity @pEnt = vSpills[i];
				
				if (pEnt.GetVarBool("SpillGenerated")==false) continue;
				
				lGeneratedSpillCount++;
				
				uint lCreationTimeStamp = uint(pEnt.GetVarInt("CreationTimeStamp"));
				
				if (lCreationTimeStamp > lOldestTimeStamp) continue;
				
				lOldestIndex = i;
				lOldestTimeStamp = lCreationTimeStamp;
			}
			
			if (lGeneratedSpillCount > glFuelSpill_MaxSpillsPerMap-1)
				pMap.DestroyEntity(vSpills[lOldestIndex]);
		}

		EnvironmentalDamage_AddEntityToCheck(mBaseObj.GetID());
	}
	
	//------------------------------------------------------------

	void OnMapEnter()
	{
		///////////////
		// Setup damage
		EnvironmentalDamage_AddEntityToCheck(mBaseObj.GetID());

		if (mState == eFuelSpillState_Burn || mState == eFuelSpillState_PreBurn)
		{
			mfSpentCount += MapTransfer_GetTimeElapsed(mlTimeStamp);
			
			const float fTimeUntilSpent = GameDifficulty_GetSettingValueByID_Float(eGameDifficultySetting_FireDuration);
			if (mfSpentCount >= fTimeUntilSpent)
			{
				for(int i = 0; i < mvParticles.size(); ++i)
				{
					cParticleSystem@ pPS = cLux_ID_ParticleSystem(mvParticles[i]);
					if (pPS !is null)
					{
						pPS.KillInstantly();
						EnvironmentalDamage_RemoveArea(pPS.GetID());
					
					}
				}

				mvParticles.resize(0);
				
				mState = eFuelSpillState_Spent;
				StopEffects();

				cLuxMap@ pMap = mBaseObj.GetMap();
				if (pMap !is null)
					pMap.DestroyEntity(mBaseObj);
			}
		}

		
		if(mState == eFuelSpillState_Burn)
		{
			for(int i = 0; i < mvParticles.size(); ++i)
			{
				cParticleSystem@ pPS = cLux_ID_ParticleSystem(mvParticles[i]);
				AddDamageArea(mvParticles[i], pPS.GetWorldPosition() + cVector3f(0.f, 0.5f, 0.f));
			}
		}
	}

	void OnMapLeave()
	{
		mlTimeStamp = MapTransfer_GetTimeStamp();
		EnvironmentalDamage_RemoveEntityToCheck(mBaseObj.GetID());
		m_idSoundLoop = tID_Invalid;
	}

	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
		iLuxEntity@ pEffectsEnt = cLux_ID_Entity(m_idEffectsEntId);
		if (pEffectsEnt !is null)
		{
			mBaseObj.GetMap().DestroyEntity(pEffectsEnt);
			m_idEffectsEntId = tID_Invalid;
		}

		EnvironmentalDamage_RemoveEntityToCheck(mBaseObj.GetID());
	}
	
	//------------------------------------------------------------
	
	///////////////////////////////
	// GENERAL
	///////////////////////////////
		
	//------------------------------------------------------------
		
	void OnVariableUpdate(float afDeltaTime)
	{
		///////////////
		// Pre Burn
		if (mState == eFuelSpillState_PreBurn)
		{
			mfPreBurnDelay -= afDeltaTime;
			if (mfPreBurnDelay <= 0)
			{
				Ignite(mbDelayedBurnIntentional);
			}
		}
		///////////////
		// Burn
		else if (mState == eFuelSpillState_Burn)
		{
			//////////////
			// Update light
			iLight@ pLight = mBaseObj.GetLight(0);
			if (pLight !is null)
				pLight.SetWorldPosition(mvOrigin + cVector3f_Up);
			
			//////////////
			// Update sound
			cSoundEntity@ pSoundLoop = cLux_ID_SoundEntity(m_idSoundLoop);
			if (pSoundLoop is null)
			{
				@pSoundLoop = mBaseObj.PlaySound("Sound_BurnLoop", gsFuelSpill_BurnLoopSound, true, false);
				if (pSoundLoop !is null)
					m_idSoundLoop = pSoundLoop.GetID();
			}
			
			//////////////
			// Spent?
			mfSpentCount += afDeltaTime;
			const float fTimeUntilSpent = GameDifficulty_GetSettingValueByID_Float(eGameDifficultySetting_FireDuration);
			if (mfSpentCount >= fTimeUntilSpent)
			{
				//////////////
				// Reset time
				mfSpentCount = fTimeUntilSpent - cMath_RandRectf(0.5f, 1.5f);
				
				//////////////
				// Kill one PS at a time!
				int lId = cMath_RandRectl(0, mvParticles.size() - 1);
				
				cParticleSystem@ pPS = cLux_ID_ParticleSystem(mvParticles[lId]);
				if (pPS !is null)
				{
					pPS.Kill();
					EnvironmentalDamage_RemoveArea(pPS.GetID());
				}
				mvParticles.removeAt(lId);
				
				//////////////
				// None left? Set to spent!
				if (mvParticles.size() == 0)
				{
					//////////////
					// Setup state
					mState = eFuelSpillState_Spent;
					
					//////////////
					// Stop effects
					StopEffects();
				}
				
				return;
			}
			
			//////////////
			// Spread fire?
			mfSpreadCount += afDeltaTime;		
			if (mfSpreadCount >= gfFuelSpill_TimeUntilSpread &&
				mlSpreadDirId < glFuelSpill_SpreadDirNum)
			{
				///////////////
				// Get dir
				cMatrixf mtxRot = cMath_MatrixRotateY((cMath_PiMul2 / glFuelSpill_SpreadDirNum) * mlSpreadDirId);
				cVector3f vSpreadDir = cMath_MatrixMul(mtxRot, cVector3f_Forward);
					
				///////////////
				// Do raycast
				float fDist;
				cVector3f vNrm;
				cVector3f vStart = mvOrigin + cVector3f_Up * 0.75f;				
					
				iPhysicsBody@ pBody = cLux_GetClosestBody(vStart, vSpreadDir, gfFuelSpill_SpreadDist, fDist, vNrm);
				
				Debug_DrawLine(vStart , vStart + vSpreadDir * gfFuelSpill_SpreadDist, cColor_White, 5);
					
				///////////////
				// Can spread in dir?
				if (pBody is null)
				{
					///////////////
					// Get ground pos
					cVector3f vGroundPos = GetGroundPosAtPoint(vStart + vSpreadDir * gfFuelSpill_SpreadDist);			
					
					///////////////
					// Fround ground pos? Create particles!
					if (vGroundPos.SqrLength() > 0.f)
					{
						cParticleSystem@ pPS = CreateFireParticles();
						if (pPS !is null)
						{
							///////////////
							// Position it
							pPS.SetWorldPosition(vGroundPos);
								
							///////////////
							// Store particles
							tID idPS = pPS.GetID();
							mvParticles.push_back(idPS);
							
							///////////////
							// Setup damage
							AddDamageArea(idPS, vGroundPos + cVector3f(0.f, 0.5f, 0.f));
						}
					}
				}
					
				///////////////
				// Prepare next spread
				++mlSpreadDirId;
				mfSpreadCount = gfFuelSpill_TimeUntilSpread - cMath_RandRectf(0.5f, 1.5f);
			}
		}
		
		///////////////
		// Spent
		else if (mState == eFuelSpillState_Spent)
		{
			mfSpendDisableDelay -= afDeltaTime;
			if (mfSpendDisableDelay <= 0)
			{
				cLuxMap@ pMap = mBaseObj.GetMap();
				if (pMap !is null)
					pMap.DestroyEntity(mBaseObj);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBodyHit, const cVector3f&in avOrigin, const cVector3f&in avHitPos, cLuxDamageProperties@ apDamageProps)
	{
		///////////////////
		// Already leaking?
		if (mState != eFuelSpillState_Unlit)
			return;
		
		iLuxEntity@ pSource = cLux_ID_Entity(apDamageProps.m_idSource);
		bool bFromTrap = pSource !is null && pSource.GetVarBool("IsTrap");
		
		///////////////////////////
		// Take damage and burn
		if (apDamageProps.mDamageType == eDamageType_Gun || apDamageProps.mDamageType == eDamageType_Grenade)
		{
			Ignite(apDamageProps.mDamageType == eDamageType_Gun || !bFromTrap);
		}
		else if ((apDamageProps.mDamageType == eDamageType_Fire) && mfPreBurnDelay <= 0)
		{
			mState = eFuelSpillState_PreBurn;
			mfPreBurnDelay = cMath_RandRectf(0.2, 0.4);
			mBaseObj.WakeUp();
			
			mbDelayedBurnIntentional = !bFromTrap;
		}
		else if (apDamageProps.mDamageType == eDamageType_Spark)
		{			
			mfSparkIgniteHealth -= 0.3f;
			if (mfSparkIgniteHealth <= 0)
			{
				if (bFromTrap)
				{
					mBaseObj.SetVarBool("IsTrap", true);
					mBaseObj.SetVarString("TriggerCause", pSource.GetVarString("TriggerCause"));
				}
				
				Ignite(!bFromTrap);
			}
		}
	}
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		tString sStateName = Player_GetCurrentStateName();
		return sStateName == "State_UsingLighter" || sStateName == "State_UsingTorch";
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Default;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Ignite(bool abIntentional)
	{
		cLuxMap@ pMap = mBaseObj.GetMap();
		
		if (pMap is null) return;
		if (mState != eFuelSpillState_Unlit && mState != eFuelSpillState_PreBurn) return;
		
		///////////////
		// Setup state
		mfSpreadCount = 0.f;
		mState = eFuelSpillState_Burn;
		mlSpawnParticleId = cMath_RandRectl(0, gsFuelSpill_FireParticles.length() - 1);
		
		mBaseObj.SetVarBool("FuelSpillIgnited", true);
		
		///////////////
		// Setup origin
		mvOrigin = GetGroundPosAtPoint(mBaseObj.GetPosition());
		if (mvOrigin.SqrLength() <= 0.f)
			mvOrigin = mBaseObj.GetPosition();
			
		mBaseObj.SetEffectsActive(true, true);
		mBaseObj.WakeUp();
		
		///////////////
		// Sound		
		mBaseObj.PlaySound("Sound_Ignite", gsFuelSpill_IgniteSound, true, false);
		
		cSoundEntity@ pSoundLoop = mBaseObj.PlaySound("Sound_BurnLoop", gsFuelSpill_BurnLoopSound, true, false);
		if (pSoundLoop !is null)
			m_idSoundLoop = pSoundLoop.GetID();
	
		///////////////
		// Particles
		cParticleSystem@ pPS = CreateFireParticles();
		if (pPS !is null)
		{
			pPS.SetWorldPosition(mvOrigin);
			
			///////////////
			// Store particles
			tID idPS = pPS.GetID();
			mvParticles.push_back(idPS);
			
			///////////////
			// Setup damage area
			AddDamageArea(idPS, mvOrigin + cVector3f(0.f, 0.5f, 0.f));
		}
		
		//////////////////
		// Create effects entity
		cMatrixf mtxEffectsEnt = cMath_MatrixTranslate(mBaseObj.GetPosition());
		pMap.CreateEntity(mBaseObj.GetName() + "_Effects", gsFuelSpill_FireEffectsEnt, mtxEffectsEnt, cVector3f(1.f));
		
		iLuxEntity@ pEffectsEnt = pMap.GetLatestEntity();
		m_idEffectsEntId = pEffectsEnt !is null ? pEffectsEnt.GetID() : tID_Invalid;
		
		if (abIntentional)
		{
			GameStats_IncreaseEntryAmount(eHeroStats_FiresStarted);
			Achievement_Unlock(eAchievement_Arsonist);
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_GetCanIgnite()
	{
		cScript_SetGlobalReturnBool(mState == eFuelSpillState_Unlit);
	}
	
	//------------------------------------------------------------
	
	void _Global_Ignite()
	{
		Ignite(cScript_GetGlobalArgBool(0));
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX) 
	{
		if (abX == false)
		{
			StopEffects();
		}
	}
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return mState == eFuelSpillState_Unlit;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void AddDamageArea(tID a_idPS, const cVector3f &in avBoundsPos)
	{
		cVector3f vMin = avBoundsPos - gvFuelSpill_AreaSize / 2.f;
		cVector3f vMax = avBoundsPos + gvFuelSpill_AreaSize / 2.f;
		
		bool bTrap = mBaseObj.GetVarBool("IsTrap");
		tID a_idArea = EnvironmentalDamage_AddMolotovArea(a_idPS, vMin, vMax, bTrap);
		
		if (bTrap)
		{
			iLuxEntity@ pFire = cLux_ID_Entity(a_idArea);
			if (pFire !is null)
			{
				cLux_AddDebugMessage("Adding area "+pFire.GetName());
				pFire.SetVarString("TriggerCause", mBaseObj.GetVarString("TriggerCause"));
			}
		}
	}
	
	//------------------------------------------------------------
	
	void StopEffects()
	{
		cSoundEntity@ pLoop = cLux_ID_SoundEntity(m_idSoundLoop);
		 if (pLoop !is null)
			 pLoop.Stop(true);

		for (int i = 0; i < mvParticles.size(); ++i)
		{
			cParticleSystem@ pPS = cLux_ID_ParticleSystem(mvParticles[i]);
			if (pPS is null) continue;
			
			pPS.Kill();
			EnvironmentalDamage_RemoveArea(pPS.GetID());
		}
		
		mvParticles.resize(0);
		
		iLuxEntity@ pEffectsEnt = cLux_ID_Entity(m_idEffectsEntId);
		if (pEffectsEnt !is null)
			pEffectsEnt.SetEffectsActive(false, true);
		
		mBaseObj.SetEffectsActive(false, true);
	}
	
	//------------------------------------------------------------
	
	cVector3f GetGroundPosAtPoint(const cVector3f &in avPos)
	{
		////////////////////
		// Setup vars
		float fLength = 3.f;
		cVector3f vGroundPos = cVector3f(0.f);
		
		////////////////////
		// Get ground pos
		float fDist;
		cVector3f vNrm;
		iPhysicsBody@ pBody = cLux_GetClosestBody(avPos, cVector3f_Down, fLength, fDist, vNrm);
		
		if (pBody !is null)
		{
			vGroundPos = avPos + cVector3f_Down * fDist;
			
			cLuxAgent@ pAgent = cLux_ToAgent(cLux_GetBodyEntity(pBody));
			if (pAgent !is null)
				vGroundPos.y = pAgent.GetCharBody().GetFeetPosition().y;
		}

		return vGroundPos;
	}
	
	//------------------------------------------------------------
	
	void SetCollisionEnabled(bool abX)
	{
		for (int i = 0; i < mBaseObj.GetBodyNum(); ++i)
		{
			iPhysicsBody@ pBody = mBaseObj.GetBody(i);
			if (pBody !is null)
				pBody.SetCollide(abX);
		}
	}
	
	//------------------------------------------------------------
	
	void OnTimer_DeactivateHitbox(uint64 alId)
	{
		mBaseObj.GetMainBody().SetCollide(false);
	}
	
	//------------------------------------------------------------
	
	cParticleSystem@ CreateFireParticles()
	{
		tString sPS = gsFuelSpill_FireParticles[mlSpawnParticleId];
		mlSpawnParticleId = ++mlSpawnParticleId % gsFuelSpill_FireParticles.length();
		return ParticleSetting_CreateParticleSystemFromSetting(cast<iLuxEntity@>(mBaseObj), "PS_FuelSpillFire", sPS, true, false);
		//return mBaseObj.CreateParticleSystem("PS_FuelSpillFire", sPS, true, false);
	}
	
	//------------------------------------------------------------
	
	///////////////////////////////
	// PROPERTIES
	///////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbSetup = false;
	int mlSpreadDirId = 0;	
	float mfSpreadCount = 0.f;	
	float mfSpentCount = 0.f;
	
	int mlSpawnParticleId = 0;
	
	cVector3f mvOrigin = cVector3f(0.f);
	tID m_idSoundLoop = tID_Invalid;
	array<tID> mvParticles;	
	eFuelSpillState mState = eFuelSpillState_Unlit;
	
	float mfSpendDisableDelay = 0.5f;
	
	float mfPreBurnDelay = -1;
	bool mbDelayedBurnIntentional = false;
	float mfSparkIgniteHealth = 1.0f;
	
	tID m_idEffectsEntId = tID_Invalid;
	int mlTimeStamp = 0;

	//------------------------------------------------------------
}