#include "interfaces/Prop_Interface.hps"
#include "helpers/helper_game.hps"
#include "helpers/helper_props.hps"
#include "helpers/helper_effects.hps"
#include "custom/helpers/helper_agent.hps"
#include "custom/helpers/helper_modules_custom.hps"

const int glMaxGratingBolts = 2;
const float gfInteractionDuration = 1.5f;

class cScrPropGrating : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		msBoltEntityLeft = apInstanceVars.GetVarString("BoltEntityLeft", "");
		msBoltEntityRight = apInstanceVars.GetVarString("BoltEntityRight", "");
		msGrabEntity = apInstanceVars.GetVarString("GrabEntity", "");
		msWallEntity = apInstanceVars.GetVarString("WallEntity", "");
		msRemoveBoltAnimationPositionEntityLeft = apInstanceVars.GetVarString("RemoveBoltAnimationPositionEntityLeft", "");
		msRemoveBoltAnimationPositionEntityRight = apInstanceVars.GetVarString("RemoveBoltAnimationPositionEntityRight", "");
		msOpeningSound = apVars.GetVarString("OpeningSound", "");
		
		mfTimeSinceLastInteraction = 0;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep)
	{
		//////////////
		// Setup
		if (mbSetup == false)
		{
			mbSetup = true;
			UpdateBlocksPath();
		}
		
		if (mbOpen) return;
		
		//////////////
		// Interaction
		if (mfTimeSinceLastInteraction > 0.f)
			mfTimeSinceLastInteraction -= afTimeStep;
	}
	
	//------------------------------------------------------------
	
	void UpdateBlocksPath()
	{
		array<iLuxEntity@> vStalkers;
		mBaseObj.GetMap().GetEntityArray("*", eLuxEntityType_Agent, "cScrAgentStalker", vStalkers);
		
		tID idBlocker = mBaseObj.GetMainBody().GetID();
		
		for (int i = 0; i < vStalkers.size(); ++i)
		{
			tString sName = vStalkers[i].GetName();
			
			if (mbOpen == false)
				Stalker_AddPathBlockerBody(sName, idBlocker, true);
			else
				Stalker_RemovePathBlockerBody(sName, idBlocker);
		}
		
		if (mbOpen == false) 	RatHandler_AddPathBlocker(idBlocker, false);
		else					RatHandler_RemovePathBlocker(idBlocker);
	}
	
	//------------------------------------------------------------
	
	void ResetProperties() {}
	void BeforeEntityDestruction() {}
	void OnStartMove() {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBodyHit, const cVector3f&in avOrigin, const cVector3f&in avHitPos, cLuxDamageProperties@ apDamageProps)
	{		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{		
	}
	
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return mbOpen;
	}
	
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in apContactData)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		if (mbOpen)
			return true;
			
		if (mfTimeSinceLastInteraction > 0)
			return true;
			
		Effect_Rumble_Start(0.3, 0.3);
		
		int lRand = cMath_RandRectl(0, 1);
		float fWiggleTimeLeft = lRand == 1 ? 0.4f : 0.5f;
		float fWiggleTimeRight = lRand == 1 ? 0.5f : 0.4f;
		
		Entity_PlayProcAnimation(msBoltEntityLeft, "Wiggle", fWiggleTimeLeft, false, 0.f);
		Entity_PlayProcAnimation(msBoltEntityRight, "Wiggle", fWiggleTimeRight, false, 0.f);
		Entity_PlayProcAnimation(mBaseObj.GetName(), "Wiggle", 0.3f, false, 0.f);
		
		mBaseObj.Timer_Add("Timer_StopBoltAnims", 0.25f, "OnTimer_StopBoltAnims");
		
		mBaseObj.PlaySound("Sound_GratingRattle","level_entity_shared/doors/metal_locker/locked",true, true);
		
		mfTimeSinceLastInteraction = gfInteractionDuration;
		return false;
	}
	
	//------------------------------------------------------------
	
	void OnTimer_StopBoltAnims(uint64 alId)
	{
		Entity_StopProcAnimation(msBoltEntityLeft, "Wiggle");
		Entity_StopProcAnimation(msBoltEntityRight, "Wiggle");
		Entity_StopProcAnimation(mBaseObj.GetName(), "Wiggle");
	}
    
    //------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return mfTimeSinceLastInteraction > 0 ? eCrossHairState_Default : eCrossHairState_CarryOneHanded;
	}
	
	//------------------------------------------------------------
	
	void OnStopMove()
	{
		if (mbOpen==false)
			return;
			
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap is null) return;
		
		/////////////////////
		// Enable grab entity
		iLuxEntity@ pGrabEnt = pMap.GetEntityByName(msGrabEntity, eLuxEntityType_Prop);
		if (pGrabEnt is null)
		{
			Error("[Grating prop] " + mBaseObj.GetName() + " doesn't have a grab entity assigned!");
			Error("[Grating prop] GrabEntity: " + msGrabEntity);
			return;
		}
		
		pGrabEnt.SetActive(true);
		mBaseObj.SetActive(false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
		
	//------------------------------------------------------------
	
	void _Global_Open()
	{
		Open();
	}
	
	//------------------------------------------------------------
	
	void _Global_GetIsOpen()
	{
		cScript_SetGlobalReturnBool(mbOpen);
	}
	
	//------------------------------------------------------------
	
	void _Global_RemoveBolt()
	{
		mlBoltsRemoved++;
		cLux_AddDebugMessage("[Prop_Grating] Removed bolt from grating " + mBaseObj.GetName() + ". Bolts left: " + (glMaxGratingBolts - mlBoltsRemoved));
		
		if (mlBoltsRemoved < glMaxGratingBolts)
			return;
		
		Achievement_IncreaseCleithrophobistCount();
		
		Open();
	}
	
	//------------------------------------------------------------
	
	void _Global_GetBolt()
	{
		bool bRight = cScript_GetGlobalArgBool(0);
		tString sBolt = bRight ? msBoltEntityRight : msBoltEntityLeft;
		cScript_SetGlobalReturnString(sBolt);
	}
	
	//------------------------------------------------------------
	
	void _Global_RemoveBoltAnimationPositionEntityLeft()
	{
		bool bRight = cScript_GetGlobalArgBool(0);
		tString sEntity = bRight ? msRemoveBoltAnimationPositionEntityRight : msRemoveBoltAnimationPositionEntityLeft;
		cScript_SetGlobalReturnString(sEntity);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOCAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Open()
	{
		if (mbOpen)
			return;
		
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap is null) return;
		
		iLuxEntity@ pGrabEnt = pMap.GetEntityByName(msGrabEntity, eLuxEntityType_Prop);
		if (pGrabEnt is null)
		{
			Error("[Grating prop] " + mBaseObj.GetName() + " doesn't have a grab entity assigned!");
			Error("[Grating prop] GrabEntity: " + msGrabEntity);
			return;
		}
		
		cMatrixf mtx = pGrabEnt.GetMatrix();
		mBaseObj.MoveAngularTo(mtx, 2, 2, 0.2, false, false, cVector3f_Zero, cVector3f_Zero);
		mBaseObj.MoveLinearTo(pGrabEnt.GetPosition(), 2, 2, 0.2, false);
		
		mbOpen = true;
		
		UpdateBlocksPath();
		
		if (msWallEntity != "")
			cScript_RunGlobalFunc(msWallEntity, "cScrPropGratingWall", "_Global_Open");
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbOpen = false;
	bool mbSetup = false;
	tString msGrabEntity = "";
	tString msWallEntity = "";
	tString msOpeningSound = "";
	int mlBoltsRemoved = 0;
	tString msBoltEntityLeft = "";
	tString msBoltEntityRight = "";
	tString msRemoveBoltAnimationPositionEntityLeft = "";
	tString msRemoveBoltAnimationPositionEntityRight = "";
	
	float mfTimeSinceLastInteraction = 0.f;
	
	//------------------------------------------------------------
}