	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	eTrapType mType = eTrapType_LastEnum;
	
	bool mbIsDoorTrap = false;
	bool mbCanBeTriggeredByRats = false;
	
	tID m_idPreTriggerPayload;
	tID m_idPostTriggerPayload;
	
	tString msDoorName;
	tString msDoorAttachPointName;
	tID m_idDoorAttachPoint;
	float mfDoorAttachPointDist;
	
	int mlTriggerBodyIndex = 0;
	int mlPayloadBodyIndex = -1;
	int mlBlockerBodyIndex = 0;
	cMatrixf m_mtxSetupTriggerOrientation;
	cVector3f mvLastAttachPointPos = 0;
	
	array<tID> mvIgnoredCollisionEntities;
	[nosave] bool mbSetup = false;
	bool mbTriggered = false;
	bool mbDisarmed = false;
	
	bool mbExcludeFromRandomization = false;
	array<bool> mvAllowedTypes;
	
	//------------------------------------------------------------
}