#include "custom/props/Prop_Rigid.hps"

class cScrPropAnimationHitbox : cScrPropRigid
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBodyHit, const cVector3f&in avOrigin, const cVector3f&in avHitPos, cLuxDamageProperties@ apDamageProps)
	{
		///////////////////
		// Give damage to linked ent
		if (m_idLinkedDamageEnt != tID_Invalid)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idLinkedDamageEnt);
			if (pEnt is null) return;
			
			pEnt.GiveDamage(apBodyHit, avOrigin, avHitPos, apDamageProps);
		}		
	}
		
	//------------------------------------------------------------
	
	void OnPhysicsCollision(iPhysicsBody@ apBody, iPhysicsBody@ apCollideBody, cPhysicsContactData &in apContactData)
	{		
		///////////////////
		// Hit by molotov? Give damage to linked ent
		if (m_idLinkedDamageEnt != tID_Invalid)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idLinkedDamageEnt);
			cLuxProp@ pProp = cLux_ToProp(cLux_GetBodyEntity(apCollideBody));
			
			if (pEnt is null) return;
			if (pProp is null) return;
			if (pProp.GetVarBool("IsMolotovCocktail") == false) return;
			
			cVector3f vPos = apCollideBody.GetWorldPosition();
			int lDamageId = mBaseObj.GetMap().GetNewAttackInstanceID();
				
			pEnt.GiveDamage(apBody, vPos, vPos, eDamageType_Fire, 0.3f, 1, 0.f, 0.f, apCollideBody.GetID(), lDamageId);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_Setup()
	{
		tString sEnt = cScript_GetGlobalArgString(0);
		iLuxEntity@ pEnt = mBaseObj.GetMap().GetEntityByName(sEnt);
		
		if (pEnt !is null)
		{
			m_idLinkedDamageEnt = pEnt.GetID();
			mBaseObj.SetScriptCollisionCallbackActive(true);
		}
	}
			
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tID m_idLinkedDamageEnt = tID_Invalid;
	
	//------------------------------------------------------------
}	