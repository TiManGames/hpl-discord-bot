#include "interfaces/Prop_Interface.hps"
#include "helpers/helper_props.hps"
#include "helpers/helper_effects.hps"

//------------------------------------------------------------

const float gfRattleInteractDuration = 1.f;

//------------------------------------------------------------

class cScrPropChainLock : iScrProp, iScrProp_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		msDoorEntity = apInstanceVars.GetVarString("DoorEntity", "");
		msPathBlockerEntity = apInstanceVars.GetVarString("PathBlockerEntity", "");
		mfPostCutYPos = apInstanceVars.GetVarFloat("PostCutAnimYPos", -1.f);
		
		mBaseObj.StopAllAnimations(0.001f);
		mBaseObj.PlayAnimation("chain_idle", 0.1f, true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	/*void OnUpdate(float afTimeStep)
	{
		
	}*/
	
	//------------------------------------------------------------
	
	/*void OnPostUpdate(float afTimeStep)
	{
	
	}*/
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afTimeStep)
	{
		if (mbBroken)
			return;
		
		///////////////////////
		// Play idle anim after rattle is over
		if (mfRattleInteractDuration > 0)
		{
			mfRattleInteractDuration -= afTimeStep;
			
			/////////////////
			// Retern to idle
			if (mfRattleInteractDuration <= 0.f)
				mBaseObj.PlayAnimation("chain_idle", 0.1f, true);
		}
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
		//TODO: Update so that the door type is taken into account (swing/slide etc).
		UnlockDoor();		
	}
		
	//------------------------------------------------------------
	
	void OnStartMove()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBodyHit, const cVector3f&in avOrigin, const cVector3f&in avHitPos, cLuxDamageProperties@ apDamageProps)
	{
		
	}
	
	//------------------------------------------------------------
	
	void OnHealthChange()
	{
		
	}
	//------------------------------------------------------------
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
	}
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	//NOTE: This is only useable if SetScriptCollisionCallbackActive is true
	void OnPhysicsCollision(iPhysicsBody @apBody, iPhysicsBody @apCollideBody, cPhysicsContactData&in apContactData)
	{
	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		if (mfRattleInteractDuration > 0.f)
			return true;
		
		Effect_Rumble_Start(0.3, 0.5);
		mfRattleInteractDuration = gfRattleInteractDuration;
		
		mBaseObj.PlayAnimation("chain_rattle", 0.1f, false);		
		mBaseObj.PlaySound("Sound_Rattle", "level_entity_shared/doors/locked/chain", true, false);	

		cAnimationState@ pAnim = mBaseObj.GetMeshEntity().GetAnimationStateFromName("chain_rattle");
		mfRattleInteractDuration = pAnim !is null ? pAnim.GetLength() : gfRattleInteractDuration;
		return true;
	}
    
    //------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return mfRattleInteractDuration > 0.f ? eCrossHairState_Default : eCrossHairState_CarryOneHanded;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
		
	//------------------------------------------------------------
	
	void _Global_Break()
	{
		if (mbBroken) return;
		
		for (int i = 0; i < mBaseObj.GetBodyNum(); ++i)
		{
			iPhysicsBody@ pBody = mBaseObj.GetBody(i);
			pBody.SetActive(false);
			pBody.SetCollide(false);
		}
		
		mBaseObj.PlayAnimation("chain_cut", 0.1f, false, true, "");
		
		UnlockDoor();
		mbBroken = true;
		
		if (mfPostCutYPos != -1.f)
		{
			cAnimationState@ pAnim = mBaseObj.GetMeshEntity().GetAnimationStateFromName("chain_cut");
			float fTime = pAnim !is null ? pAnim.GetLength() - 1.f : 0.f;
			mBaseObj.Timer_Add("Timer_PlaceAtPostCutYPos", fTime, "OnTimer_PlaceAtPostCutYPos");
		}
	}
	
	//------------------------------------------------------------
	
	void OnTimer_PlaceAtPostCutYPos(uint64 alId)
	{
		float fOnLoadYPos = mBaseObj.GetOnLoadTransform().GetTranslation().y;
		float fDiff = mfPostCutYPos - fOnLoadYPos;
		
		cVector3f vPos = mBaseObj.GetPosition();
		vPos.y += fDiff;
		mBaseObj.SetPosition(vPos);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetIsBroken()
	{
		cScript_SetGlobalReturnBool(mbBroken);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// Local
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void UnlockDoor()
	{
		array<iLuxEntity@> vDoors;
		if (Map_GetEntityArray(msDoorEntity, vDoors, eLuxEntityType_Prop)==false)
		{
			Error("No door entity called " + msDoorEntity + " found!");
			return;
		}
		
		for (int i=0; i<vDoors.size(); i++)
		{
			iLuxEntity@ pDoorEnt = vDoors[i];
			if (pDoorEnt is null) continue;
			
			tString sDoorClass = pDoorEnt.GetClassName();
			
			////////////////////
			// A slide prop?
			if (sDoorClass == "cScrPropSlide")
			{
				Slide_SetLocked(msDoorEntity, false, true);
				
				//TODO: Fix this. Temp hack to animate the hinge for note cabinet locks.
				mBaseObj.Timer_Add("Timer_OpenDrawerHinge", 1.f, "OnTimer_OpenDrawerHinge");
			}
			
			///////////
			// A swing door?
			else if (sDoorClass == "cScrPropSwingDoor")
			{
				SwingDoor_SetBlocked(msDoorEntity, false, true);
				SwingDoor_SetLocked(msDoorEntity, false, true);
			}
		}
		
		///////////////////////////
		// If accompaniment by a pathblocker disable it
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap !is null)
		{
			iLuxEntity@ pPathBlocker = pMap.GetEntityByName(msPathBlockerEntity, eLuxEntityType_Prop);
			if (pPathBlocker !is null)
			{
				pPathBlocker.SetActive(false);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void OnTimer_OpenDrawerHinge(uint64 alId)
	{
		Prop_SetStaticPhysics(msDoorEntity + "_Hinge", false);
		Body_AddImpulse(msDoorEntity + "_Hinge_Body_2", cVector3f_Forward * 0.2f, true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tString msDoorEntity;
	tString msPathBlockerEntity;
	bool mbBroken = false;
	float mfRattleAnimLength = 0.f;
	float mfRattleInteractDuration = 0.f;
	float mfPostCutYPos = -1.f;
	
	//------------------------------------------------------------
}