#include "props/Prop_Pickup.hps"
#include "base/Base_Types.hps"

//------------------------------------------------------------

class cScrPropRabbitDoll : cScrPropPickup
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld@ apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropPickup::SetupAfterLoad(apWorld, apVars, apInstanceVars);	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afDeltaTime)
	{
		/////////////////////////
		// Setup vars
		iPhysicsBody@ pBody = mBaseObj.GetMainBody();
		if (pBody is null) return;
		
		/////////////////////////
		// Thrown by player?
		if (mbAttractStalker == false && pBody.GetThrownByPlayer()) 
		{
			mbAttractStalker = true;
			mBaseObj.SetAutoSleep(false);			
			mBaseObj.GetMap().GetEntityArrayID("*", eLuxEntityType_Agent, "cScrAgentStalker", mvStalkerIds);
		}		
		
		/////////////////////////
		// Attract stalker
		if (mbAttractStalker == false) return;
		if (pBody.GetEnabled()) return;
		
		mfBroadcastCount -= afDeltaTime;
		if (mfBroadcastCount <= 0.f)
		{
			mfBroadcastCount = 0.3f;
			
			for (int i = 0; i < mvStalkerIds.size(); ++i)
			{
				cLuxAgent@ pAgent = cLux_ID_Agent(mvStalkerIds[i]);
				if (pAgent is null) continue;
				
				pAgent.BroadcastMessage(eCustomEntityMessage_RabbitDollAttract, null, mBaseObj.GetPosition(), 0);
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool mbAttractStalker = false;
	float mfBroadcastCount = 0.3f;
	array<tID> mvStalkerIds;
	
	//------------------------------------------------------------
}