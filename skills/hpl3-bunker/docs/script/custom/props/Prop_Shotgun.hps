		apFunctions.GetLowLevelGfx().DrawLine(cLux_GetPlayer().GetCamera().GetPosition(),  vControlPoint,  cColor(0,10,0,1));
	}*/
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlMagazineCount = 0;
	bool mbChamberedShell = false;
}