			afStartY = cLux_DrawDebugText("!!    '" + sName + "'", afStartY, fSize, col);
		}
		
		return afStartY;
	}*/
	
	//------------------------------------------------------------
	
/*	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		iPhysicsBody@ pBody = mBaseObj.GetBodyFromName("Body_BulletStart");
		
