#include "custom/props/Prop_FuelSpillGenerator.hps"
#include "base/Base_Types.hps"
#include "custom/helpers/helper_props_custom.hps"

//------------------------------------------------------------

class cScrPropMolotovCocktail : cScrPropFuelSpillGenerator
{
	//------------------------------------------------------------
	
	///////////////////////////////
	// GENERAL
	///////////////////////////////
		
	//------------------------------------------------------------
		
	void OnVariableUpdate(float afDeltaTime)
	{
		cScrPropFuelSpillGenerator::OnVariableUpdate(afDeltaTime);
		
		///////////////
		// Pre burn
		if (!mbInitialized)
		{
			mbInitialized = true;
			
			//////////////
			// Broadcast message
			cLuxMap@ pMap = mBaseObj.GetMap();
			if (pMap is null) return;
			
			array<iLuxEntity@> vAgents;
			pMap.GetEntityArray("*", eLuxEntityType_Agent, "", vAgents);
			
			for (int i = 0; i < vAgents.size(); ++i)
			{
				vAgents[i].BroadcastMessage(eCustomEntityMessage_MolotovImpact, null, mBaseObj.GetPosition(), -1);				
			}
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return cScrPropFuelSpillGenerator::OnUpdateAutoSleep() && mbInitialized;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CreateSpill()
	{
		cScrPropFuelSpillGenerator::CreateSpill();
		FuelSpill_Ignite(mBaseObj.GetName() + "_spill", false);
	}
	
	//------------------------------------------------------------
	
	bool mbInitialized = false;
	
	//------------------------------------------------------------
}