#include "props/Prop_Rigid.hps"
#include "helpers/helper_effects.hps"
#include "helpers/helper_audio.hps"
#include "helpers/helper_player.hps"
#include "helpers/helper_modules_custom.hps"
#include "custom/player/PlayerTypes_Custom.hps"

//------------------------------------------------------------

class cScrPropMemoryCylinder : iScrProp, iScrProp_Interface
{
    //------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		msVoiceSubject = "";
		msBackground="";
		mBaseObj.SetAutoSleep(true);
		mbRead = false;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{			
		msVoiceSubject = apInstanceVars.GetVarString("VoiceSubject", "");
		msBackground = apInstanceVars.GetVarString("CylinderBackground", "");
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ResetProperties() {}
	void BeforeEntityDestruction() {}
    
    //------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX) {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		tString sName = mBaseObj.GetName();
		cScript_SetGlobalArgString(0, sName);
		cScript_SetGlobalArgString(1, msVoiceSubject);
		cScript_SetGlobalArgString(2, msBackground);
		cScript_RunGlobalFunc("State_ReadMemoryCylinder", "", "_Global_ReadMemoryCylinder");
		mbRead = true;
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		return eCrossHairState_Touch;
	}
    
    //------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
    
	void _Global_GetCanBeHighlighted()
	{
		cScript_SetGlobalReturnBool(mbRead == false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------

    tString msVoiceSubject;
	tString msBackground;
	bool mbRead;
	
	//------------------------------------------------------------
}	