#include "custom/props/Prop_Rigid.hps"
#include "custom/helpers/helper_player_custom.hps"

//------------------------------------------------------------

const tString gsFuelSpillGenerator_Entity = "fuel_spill.ent";

//------------------------------------------------------------

class cScrPropFuelSpillGenerator : cScrPropRigid
{
	//------------------------------------------------------------
	
	///////////////////////////////
	// INIT
	///////////////////////////////
	
	//------------------------------------------------------------

	void Init()
	{
		cScrPropRigid::Init();
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld@ apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropRigid::SetupAfterLoad(apWorld, apVars, apInstanceVars);

		////////////
		// Preload
		Entity_Preload(gsFuelSpillGenerator_Entity);
	}	
	
	//------------------------------------------------------------
	
	///////////////////////////////
	// GENERAL
	///////////////////////////////
		
	//------------------------------------------------------------
		
	void OnVariableUpdate(float afDeltaTime)
	{
		if (mbGenerated) return;
		
		mbGenerated = true;
		CreateSpill();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return mbGenerated;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CreateSpill()
	{
		////////////////////
		// Temporarily disable collision to make sure the raycast doesn't hit the generator body
		array<bool> vCollisions;
		vCollisions.resize(mBaseObj.GetBodyNum());
		for (int i = 0; i < mBaseObj.GetBodyNum(); i++)
		{
			vCollisions[i] = mBaseObj.GetBody(i).GetCollide();
			mBaseObj.GetBody(i).SetCollide(false);
		}
		
		//////////////////
		// Figure out position
		
		cVector3f vOriginPos = mBaseObj.GetPosition()+cVector3f_Up*0.1f;
			
		float fRayLength = 100;
		float fHitDist;
		cVector3f vHitNrm;
		cVector3f vHitPos = vOriginPos;
		
		iPhysicsBody@ pTargetBody = cLux_GetClosestBody(vOriginPos, cVector3f_Down, fRayLength, fHitDist, vHitNrm);
		
		vHitPos = vHitPos + cVector3f_Down * (fHitDist-0.01);
		if (pTargetBody is null) vHitPos = vOriginPos;
		
		cVector3f vRight = cMath_Vector3Cross(vHitNrm, cVector3f_Forward);
		cVector3f vFwd = cMath_Vector3Cross(vRight, vHitNrm);
		cMatrixf mtxTransform = cMath_MatrixUnitVectors(vRight, vHitNrm, vFwd, vHitPos);
				
		//////////////////
		// Create spill
		cLuxMap@ pMap = mBaseObj.GetMap();
		if (pMap !is null)
		{
			pMap.CreateEntity(mBaseObj.GetName() + "_spill", gsFuelSpillGenerator_Entity, mtxTransform, cVector3f(1.f));
			iLuxEntity@ pEnt = pMap.GetLatestEntity();
			if (pEnt !is null && pEnt.GetName() == (mBaseObj.GetName() + "_spill"))
			{
				pEnt.SetVarBool("SpillGenerated", true);				
				Player_AddAimAssistTarget(pEnt.GetID());
			}
		}
		
		////////////////////////
		// Restore collision
		for (int i = 0; i < mBaseObj.GetBodyNum(); i++)
		{
			mBaseObj.GetBody(i).SetCollide(vCollisions[i]);
		}
	}
	
	//------------------------------------------------------------
	
	///////////////////////////////
	// PROPERTIES
	///////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbGenerated = false;
	
	//------------------------------------------------------------
}