	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------

	void SetupRollers()
	{
		array<tString> vRollerNames;
		array<tID> vRollerIds;
		cString_GetStringVec(msRollers, vRollerNames, " ");

		cLuxProp@ pProp = mBaseObj;
		cMeshEntity@ pMeshEntity = pProp.GetMeshEntity();
		
		for(int i =0; i < vRollerNames.size(); ++i)
		{
			cSubMeshEntity@ pSubMesh = pMeshEntity.GetSubMeshEntityName(vRollerNames[i]);
			if(pSubMesh !is null)
			{
				vRollerIds.push_back(pSubMesh.GetID());
			}
		}

		array<int> vStartFaces;
		if(!mbRandomStartFaces)
			cString_GetIntVec(msStartFaces, vStartFaces, " ,;:");
		else
		{
			for(int i = 0; i < vRollerIds.size(); ++i)
			{
				vStartFaces.push_back(cMath_RandRectl(0, mlRollerNumberCount));
			}
		}

		float fTotalSteps = float(mlRollerNumberCount);
		float fHalfTotalSteps = fTotalSteps * 0.5;
		float fStep = cMath_PiMul2 / fTotalSteps;

		for(int i = 0; i < vRollerIds.size(); ++i)
		{
			// Update rollers:
			cSubMeshEntity@ pSubMesh = cLux_ID_SubMeshEntity(vRollerIds[i]);

			if(pSubMesh !is null)
			{
				float fFace = cMath_Wrap(vStartFaces[i], -fHalfTotalSteps, fHalfTotalSteps);
				pSubMesh.SetMatrix(cMath_MatrixMul(pSubMesh.GetLocalMatrix(), cMath_MatrixRotateX(fStep * fFace)));
			}
		}
	}

	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		//cString_GetStringVec(apVars.GetVarString("RollerSubmeshes", ""), mvRollers, " ");
		msRollers = apVars.GetVarString("RollerSubmeshes", "");
		mlRollerNumberCount = apVars.GetVarInt("RollerNumberCount", 0);
		
		///////////////////////////
		// Instance variables
		msCombination = apInstanceVars.GetVarString("Combination", "");
		msStartFaces = apInstanceVars.GetVarString("RollerStartFaces", "");
		mbRandomStartFaces = apInstanceVars.GetVarBool("RandomStartFaces", false);

		msDoorEntity = apInstanceVars.GetVarString("DoorEntity", "");

		mvLocalPos = apInstanceVars.GetVarVector3f("Position", cVector3f(0, 0, 0))*mBaseObj.GetOnLoadScale();
		mvLocalNormal = apInstanceVars.GetVarVector3f("Normal", cVector3f(0, 0, 1));
		mfCameraDistance = apInstanceVars.GetVarFloat("TargetCameraDistance", 1)*mBaseObj.GetOnLoadScale().y;

		mbAllowInteraction = apInstanceVars.GetVarBool("AllowInteraction", true);
		
		msUnlockCallback = apInstanceVars.GetVarString("UnlockCallback", "");
		
		msPlayerPosEntity = apInstanceVars.GetVarString("PlayerPosEntity", "");
		mfFOV = cMath_ToRad(apInstanceVars.GetVarFloat("VerticalFOV", 70));

		mBaseObj.SetGuiSetUseInput(mbAllowInteraction);
		SetupRollers();
	}
	
