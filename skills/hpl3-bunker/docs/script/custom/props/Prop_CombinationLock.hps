	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// COMBINATIONLOCK SPECIFIC ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetCombination(int alX)
	{
		tString sCombination = cString_ToString(alX, 4);
		msCombination = "";
		for (uint i = 0; i < sCombination.length(); i++) 
		{
			msCombination += cString_Sub(sCombination, i, 1);
			//msCombination += sCombination[i];
			if (i == sCombination.length() - 1) break;
			
			msCombination += " ";
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		if (mbAllowInteraction==false)
			return false;

		//TODO: Fix so that the door type is taken into account.
		if(!SwingDoor_GetLocked(msDoorEntity) && !SwingDoor_GetBlocked(msDoorEntity))
			return false;
			
		iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
		if(pCharBody.IsOnGround() == false) return false;
					
		///////////////////////////////////
		// Get screen position and normal
		cMatrixf mtxToWorld = GetBase().GetMatrix();		
		cVector3f vPosition = cMath_MatrixMul(mtxToWorld, mvLocalPos);
		cVector3f vNormal = cMath_MatrixMul(mtxToWorld.GetRotation(), cMath_Vector3Normalize(mvLocalNormal));
				
		////////////////
		// The player must face and see the screen to activate it
		cVector3f vScreenToCam = cMath_Vector3Normalize(cLux_GetPlayer().GetCamera().GetPosition() - vPosition);
		float fDot = cMath_Vector3Dot(vNormal, vScreenToCam);
		if(fDot < 0) return false;
		
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		///////////////////////////////////
		// Get screen position and normal
		cMatrixf mtxToWorld = mBaseObj.GetMatrix();
		cVector3f vPosition = cMath_MatrixMul(mtxToWorld, mvLocalPos);
		cVector3f vNormal = cMath_MatrixMul(mtxToWorld.GetRotation(), cMath_Vector3Normalize(mvLocalNormal));
		
		////////////////
		// The player must face and see the screen to activate it
		cVector3f vScreenToCam = cMath_Vector3Normalize(cLux_GetPlayer().GetCamera().GetPosition() - vPosition);
		float fDot = cMath_Vector3Dot(vNormal, vScreenToCam);
		
		if(fDot < 0)
			return false;
		
		///////////////////////////////
		//Set up the interact state
		
		/////////////////////
		// Fade fov
		cLux_GetPlayer().FadeCameraFOVTo(mfFOV, 4.0f);

		////////////////////////////////////
		// Allow interction again
		mbAllowInteraction = true;
		

		////////////////////////////////////
		// Enter combinationlock state
		
		cScript_SetGlobalArgID(0, mBaseObj.GetID()); 					// Object ID
		cScript_SetGlobalArgInt(1, apBody.GetUniqueID()); 				// Body Id
		cScript_SetGlobalArgVector3f(2, avFocusPos);					// The grab position
		cScript_SetGlobalArgVector3f(3, vNormal);						// Screen normal
		cScript_SetGlobalArgVector3f(4, vPosition);						// Screen world position
		cScript_SetGlobalArgFloat(5, mfCameraDistance);					// Target camera distance from screen
		cScript_SetGlobalArgString(6, msUnlockCallback);				// Called when the lock is unlocked
		cScript_SetGlobalArgString(7, msPlayerPosEntity);				// Entity the player should be placed at
		cScript_SetGlobalArgString(8, msRollers); 						// Roller Sub meshes string
		cScript_SetGlobalArgString(9, msCombination); 					// Combination
		cScript_SetGlobalArgString(10, msDoorEntity); 					// The door this is connected to
		cScript_SetGlobalArgBool(11, mbOpenDoorEntityOnUnlock); 		// If the door should open when unlocked
		

		cScript_RunGlobalFunc("State_Interact_CombinationLock", "", "SetupCombinationLock");
	
		cLux_GetPlayer().ChangeState(ePlayerState_Custom_CombinationLock);
		
		cScript_SetGlobalVarBool("CombinationLockAtScreenCenter", cMath_Abs(mvLocalPos.x) <= 0.03f);
		
		return true;
	}
	
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
