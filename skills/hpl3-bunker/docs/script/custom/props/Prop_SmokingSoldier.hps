#include "custom/props/Prop_Headtracker.hps"

const float gfSmokingSoldier_MaxHeadTilt = -0.75f;

class cScrSmokingSoldier : cScrHeadTracker
{
	void OnUpdate(float afTimeStep)
	{
		cScrHeadTracker::OnUpdate(afTimeStep);
		
		float fTargetRot = 0;
		if (mbArmTracking)
		{
			fTargetRot = GetTargetArmRotation();
		}
		
		float fDiffMul = cMath_Abs(mfCurrentArmAngle-fTargetRot)*1.0f;
		mfCurrentArmAngle = cMath_IncreaseTo(mfCurrentArmAngle, afTimeStep*1.0f*fDiffMul, fTargetRot);
		
		////////////////////////////
		// Arms
		tString[] vArmBones = {"j_R_Arm_00_Clavicle", "j_R_Arm_02"};
		float[] vArmWeights = {0.5, 0.5};
		cVector3f[] vArmAxes = {cVector3f_Right, cMath_Vector3Normalize(cVector3f(1, 0, -1))};
		
		cMeshEntity@ pMesh = mBaseObj.GetMeshEntity();
		for (int i = 0; i < vArmBones.length(); i++)
		{
			cBoneState@ pBone = pMesh.GetBoneStateFromName(vArmBones[i]);
			if (pBone is null) continue;
			
			float fWeight = vArmWeights[i];
			cVector3f vAxis = vArmAxes[i];
			
			pBone.SetUsePreTransform(true);
			pBone.SetPreTransform(cMath_MatrixRotateXYZ(vAxis*mfCurrentArmAngle*fWeight));
		}
		
		mfHeadTiltT = cMath_IncreaseTo(mfHeadTiltT, afTimeStep, mbTiltHead ? 1.0f : 0.0f);
		float fHeadTilt = cMath_Easing(eEasing_SineInOut, mfHeadTiltT, 0, gfSmokingSoldier_MaxHeadTilt);
	
		cBoneState@ pBone = pMesh.GetBoneStateFromName("j_Head_Neck_01");
		pBone.SetUsePreTransform(true);
		pBone.SetPreTransform(cMath_MatrixRotateX(fHeadTilt));
	}
	
	void _Global_SetHeadTiltActive()
	{
		mbTiltHead = cScript_GetGlobalArgBool(0);
	}
	
	void _Global_SetArmTrackingActive()
	{
		mbArmTracking = cScript_GetGlobalArgBool(0);
	}
	
	float GetTargetArmRotation()
	{
		cVector3f vDir = cLux_GetPlayer().GetCharacterBody().GetFeetPosition() - mBaseObj.GetBasePosition();
		vDir.y = 0;
		vDir.Normalize();

		cVector3f vFwd = mBaseObj.GetMatrix().GetTranspose().GetRight()*-1;
		float fAngle = cMath_ACos(cMath_Vector3Dot(vFwd, vDir));
		
		if (cMath_Vector3Cross(vFwd, vDir).y > 0) 
			fAngle = -fAngle;
		
		float fMinAngle = -0.6f;
		float fMaxAngle = 0.6f;
		fAngle = cMath_Clamp(fAngle, fMinAngle, fMaxAngle);
			
		float fValue = 0;
		if (fAngle < 0)
			fValue = cMath_Easing(eEasing_Linear, fAngle/fMinAngle, 0, -1.0f);
		else
			fValue = cMath_Easing(eEasing_Linear, fAngle/fMaxAngle, 0, 0.5f);
			
		return fValue;
	}
	
	bool mbTiltHead = false;
	float mfHeadTiltT = 0;
	
	bool mbArmTracking = false;
	float mfCurrentArmAngle = 0;
	float mfCurrentArmVel = 0;
}