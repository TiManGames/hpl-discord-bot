#include "custom/props/Prop_Rigid.hps"
#include "custom/helpers/helper_props_custom.hps"

//------------------------------------------------------------

const float gfPadlock_FadeTime = 1.0f;

//------------------------------------------------------------

class cScrPropPadlockCut : cScrPropRigid
{
	//------------------------------------------------------------
	
	///////////////////////////////
	// INIT
	///////////////////////////////
	
	//------------------------------------------------------------

	void Init()
	{
		cScrPropRigid::Init();
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld@ apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropRigid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		m_mtxStart = mBaseObj.GetMatrix();
		
		cVector3f vRight = m_mtxStart.GetTranspose().GetRight();
		cVector3f vFwd = cMath_Vector3Cross(vRight, cVector3f_Up);
		
		m_mtxGoal = cMath_MatrixUnitVectors(vRight, cVector3f_Up, vFwd, mBaseObj.GetPosition());
		
		//mBaseObj.StopAllAnimations(0);
		
		mBaseObj.PlayAnimation("padlock_cut", gfPadlock_FadeTime);
	}	
	
	//------------------------------------------------------------
	
	///////////////////////////////
	// GENERAL
	///////////////////////////////
		
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afDeltaTime)
	{
		if (mfT < 1.0f)
		{
			mfT += afDeltaTime/gfPadlock_FadeTime;
			
			cMatrixf mtx = cMath_MatrixSlerp(mfT, m_mtxStart, m_mtxGoal, true);
			mBaseObj.SetMatrix(mtx);
		}
		
		if (!mbUnlockedDoor)
		{
			cAnimationState@ pState = mBaseObj.GetMeshEntity().GetAnimationStateFromName("padlock_cut");
			if (pState.GetRelativeTimePosition() > 0.75f)
			{
				mbUnlockedDoor = true;
				Padlock_UnlockDoor(mBaseObj.GetVarString("Padlock"));
			}
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool OnUpdateAutoSleep()
	{
		return mbUnlockedDoor;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	///////////////////////////////
	// PROPERTIES
	///////////////////////////////
	
	//------------------------------------------------------------
	
	cMatrixf m_mtxStart;
	cMatrixf m_mtxGoal;
	
	float mfT = 0;
	bool mbUnlockedDoor = false;
	
	//------------------------------------------------------------
}