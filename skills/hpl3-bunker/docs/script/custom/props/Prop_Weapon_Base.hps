#include "custom/props/Prop_Pickup.hps"
#include "script/helpers/helper_modules.hps"
#include "script/helpers/helper_player.hps"
#include "custom/helpers/helper_gun.hps"

//------------------------------------------------------------

const tString gsGun_RemoveBulletsAnim = "gun_reload_remove_bullets";
const tString gsGun_StartAnim = "gun_bullet_check_close";
const tString gsGun_ReloadAnim = "gun_bullet_check_close";

//------------------------------------------------------------

class cScrPropWeapon_Base : cScrPropPickup
{
	//------------------------------------------------------------
	
	///////////////////////////////
	// INIT
	///////////////////////////////
	
	//------------------------------------------------------------

	void Init()
	{
		cScrPropPickup::Init();
		
		msPrevAnimState = "";
	}
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld@ apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrPropPickup::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		//////////////////////
		// Make sure an animation is active (so the cylinder rotation works)
		mBaseObj.PlayAnimation(gsGun_StartAnim, 0.f, false);
		
		cAnimationState@ pState = mBaseObj.GetMeshEntity().GetAnimationStateFromName(gsGun_StartAnim);
		if (pState !is null)
			pState.SetRelativeTimePosition(0.95f);
	}
		
	//------------------------------------------------------------
	
	///////////////////////////////
	// SAVE/LOAD
	///////////////////////////////
	
	//------------------------------------------------------------

	void Save()
	{
	}
	
	//------------------------------------------------------------
	
	void Load()
	{
	}


	//------------------------------------------------------------

	///////////////////////////////
	// GLOBAL
	///////////////////////////////
	
	//------------------------------------------------------------

	void _Global_OnMapLeave()
	{
		Save();
	}
	
	//------------------------------------------------------------
	
	void _Global_OnMapEnter()
	{
		Load();
	}
	
	//------------------------------------------------------------
	
	void _Global_CopyValues()
	{
		UpdateBulletVisibility();
	}
	
	//------------------------------------------------------------
	
	void _Global_OnItemStartPutAway() 
	{
		Save();
	}		
	void _Global_OnItemPutAway(){}

	void _Global_OnHeldItemDrop()
	{
		Save();
	}
	
	//------------------------------------------------------------
	
	void _Global_OnItemTakenOut()
	{	
		// hack to load state
		Load();
		
		UpdateBulletVisibility();
		mBaseObj.SetAnimationCallbackActive(true);
		
		//////////////////
		// Don't float magically in the air!
		cMeshEntity@ pMeshEnt = mBaseObj.GetMeshEntity();
		if (pMeshEnt !is null)
		{
			pMeshEnt.SetRenderFlagBit(eRenderableFlag_VisibleInReflection, false);
			pMeshEnt.SetRenderFlagBit(eRenderableFlag_VisibleInNonReflection, true);
			pMeshEnt.SetRenderFlagBit(eRenderableFlag_ShadowCaster, true);
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_GetCanFire()
	{
		cScript_SetGlobalReturnBool(true);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetHasSpentBullets()
	{
		cScript_SetGlobalReturnBool(false);
	}
	
	//------------------------------------------------------------
	
	void _Global_GetFullyLoaded()
	{
		cScript_SetGlobalReturnBool(GetFullyLoaded());
	}
	
	//------------------------------------------------------------
	
	void _Global_TriggerEvent()
	{
		HandleEvent(eGunEvent(cScript_GetGlobalArgInt(0)));
	}
	
	//------------------------------------------------------------
	
	void _Global_GetReloadAnimationDone()
	{
		cAnimationState@ pState = mBaseObj.GetMeshEntity().GetAnimationStateFromName(gsGun_ReloadAnim);
		bool bRet = pState !is null && pState.IsActive() ? pState.GetTimePosition() >= 1.f : true;
		
		cScript_SetGlobalReturnBool(bRet);
	}
	
	//------------------------------------------------------------
	
	///////////////////////////////
	// GENERAL
	///////////////////////////////
	
	//------------------------------------------------------------
	
	void OnPostUpdate(float afTimeStep)
	{		
	}
	
	//------------------------------------------------------------
	
	void OnAfterAnimationUpdate(cMeshEntity@ apFunctions, float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
		if (abX)
		{
			UpdateBulletVisibility();
		}
	}
	
	//------------------------------------------------------------
	
	void OnRecieveMessage(int alMessageId, cLuxEntityMessageData @apData)
	{
		/////////////////
		// Message event
		if (alMessageId == eLuxEntityMessage_AnimationMessageEvent)
		{
			HandleEvent(eGunEvent(apData.mlX));
		}
	}
	
	//------------------------------------------------------------
	
	void HandleEvent(eGunEvent aEvent)
	{
		//////////////////
		// Bullets were emptied!
		if (aEvent == eGunEvent_EmptyBullets)
		{
			UpdateBulletVisibility();
		}
		
		//////////////////
		// Hide reload bullet and enable real one
		else if (aEvent == eGunEvent_HideReloadBullet)
		{
			UpdateBulletVisibility();		
		}
	}	
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void UpdateBulletVisibility()
	{
	}
	
	//------------------------------------------------------------
	
	bool GetFullyLoaded()
	{
		Error("GetFullyLoaded() Not implemented for "+mBaseObj.GetName());
		return true;
	}
	
	//------------------------------------------------------------
	
	///////////////////////////////
	// PROPERTIES
	///////////////////////////////
	
	//------------------------------------------------------------
	
	tString msPrevAnimState;
	
	//------------------------------------------------------------
}