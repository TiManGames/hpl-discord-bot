#include "interfaces/AchievementHandler_Interface.hps"
#include "base/AchievementHandler_Types.hps"
#include "custom/modules/ModuleInterfaces_Custom.hps"

class cScrAchievementHandler : iScrAchievementHandlerBase, iScrAchievementHandler_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// CREATE ACHIEVEMENTS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void CreateAchievements()
	{
		/////////////
		// Create the achievements
		CreateAchievement(eAchievement_CroixDeGuerre, "CroixDeGuerre");
		CreateAchievement(eAchievement_Enlisted, "Enlisted");
		CreateAchievement(eAchievement_GaveTheAllClear, "GaveTheAllClear");
		CreateAchievement(eAchievement_Signalman, "Signalman");
		CreateAchievement(eAchievement_Toolist, "Toolist");
		CreateAchievement(eAchievement_Memorialist, "Memorialist");
		CreateAchievement(eAchievement_MunitionsExpert, "MunitionsExpert");
		CreateAchievement(eAchievement_ExplosivesTechnician, "ExplosivesTechnician");
		CreateAchievement(eAchievement_Napoo, "Napoo");
		CreateAchievement(eAchievement_Librarian, "Librarian");
		CreateAchievement(eAchievement_Codebreaker, "Codebreaker");
		CreateAchievement(eAchievement_TootSweet, "TootSweet");
		CreateAchievement(eAchievement_Nope, "Nope");
		CreateAchievement(eAchievement_Cartographer, "Cartographer");
		CreateAchievement(eAchievement_EasyBreather, "EasyBreather");
		CreateAchievement(eAchievement_FlintSteel, "FlintSteel");
		CreateAchievement(eAchievement_PackRat, "PackRat");
		CreateAchievement(eAchievement_LifePreserver, "LifePreserver");
		CreateAchievement(eAchievement_Chaplain, "Chaplain");
		CreateAchievement(eAchievement_Canonnier, "Canonnier");
		CreateAchievement(eAchievement_ToyCollector, "ToyCollector");
		CreateAchievement(eAchievement_BeastMaster, "BeastMaster");
		CreateAchievement(eAchievement_PitMaster, "PitMaster");
		CreateAchievement(eAchievement_Trickster, "Trickster");
		CreateAchievement(eAchievement_Saboteur, "Saboteur");
		CreateAchievement(eAchievement_CulinarySpecialist, "CulinarySpecialist");
		CreateAchievement(eAchievement_Arsonist, "Arsonist");
		CreateAchievement(eAchievement_ChemicalWeaponExpert, "ChemicalWeaponExpert");
		CreateAchievement(eAchievement_GotItInOne, "GotItInOne");
		CreateAchievement(eAchievement_EfficiencyExpert, "EfficiencyExpert");
		CreateAchievement(eAchievement_Tinkerer, "Tinkerer");
		CreateAchievement(eAchievement_Sentimentalist, "Sentimentalist");
		CreateAchievement(eAchievement_ToyFanatic, "ToyFanatic");
		CreateAchievement(eAchievement_Scarper, "Scarper");
		CreateAchievement(eAchievement_Roastmaster, "Roastmaster");
		CreateAchievement(eAchievement_Cleithrophobist, "Cleithrophobist");
		CreateAchievement(eAchievement_Improviser, "Improviser");
		CreateAchievement(eAchievement_Ratter, "Ratter");
		CreateAchievement(eAchievement_CutItOff, "CutItOff");
		CreateAchievement(eAchievement_ExtremeRatter, "ExtremeRatter");
		CreateAchievement(eAchievement_GotIntroduced, "GotIntroduced");
		CreateAchievement(eAchievement_ShellShocked, "ShellShocked");
		CreateAchievement(eAchievement_Revisionist, "Revisionist");
		CreateAchievement(eAchievement_InRecovery, "InRecovery");

		/////////////
		// Register all achievements on Steam/PS4
		RegisterAchievements();	
		
		ePlatform platform = cSystem_GetPlatform();
		if (platform == ePlatform_Win32 || 
			platform == ePlatform_Linux ||
			platform == ePlatform_Mac)
		{
			/////////////
			// Auto unlock Reborn if all are unlocked and it failed to log you in last time
			if (mBaseObj.GetAllAchievementsUnlocked() && mBaseObj.GetAchievementUnlocked(eAchievement_CroixDeGuerre) == false)
			{
				mBaseObj.UnlockAchievement(eAchievement_CroixDeGuerre);
			}
		}
	}
	
	//-------------------------------------------------------
	
	void IncreaseCount(eAchievementCount aCount)
	{
		switch(aCount)
		{
			case eAchievementCount_Notes:
				mlNotes++;
				break;
			case eAchievementCount_CrewNotes:
				mlCrewNotes++;
				break;
			case eAchievementCount_Cylinders:
				mlCylinders++;
				break;
			case eAchievementCount_UsedMatches:
				mlUsedMatches++;
				break;
			case eAchievementCount_BrokenProps:
				mlBrokenProps++;
				break;
		}
	}
	
	//------------------------------------------------------------
	
	int mlNotes = 0;
	int mlCrewNotes = 0;
	int mlCylinders = 0;
	int mlUsedMatches = 0;
	int mlBrokenProps = 0;
	
}	