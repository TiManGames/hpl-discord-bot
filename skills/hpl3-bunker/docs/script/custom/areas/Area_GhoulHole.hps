#include "interfaces/Area_Interface.hps"
#include "custom/helpers/helper_modules_custom.hps"
#include "custom/helpers/helper_props_custom.hps"

//------------------------------------------------------------

class cScrAreaGhoulHole : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{	
		mBaseObj.SetCheckCollision(false);
		mBaseObj.SetAutoSleep(true);
	}
	
	//------------------------------------------------------------
	
	void OnAfterWorldLoad() 
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ResetProperties() {}
	void BeforeEntityDestruction() {}

	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX) {}	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState) {}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
		
	//-----------------------------------------------------------------------
	
	void _Global_GetBlockingBody()
	{
		cScript_SetGlobalReturnID(GetBlockingBody());
	}
		
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	tID GetBlockingBody()
	{
		int lTimeStamp = mBaseObj.GetMap().GetTimeStamp();
		if (lTimeStamp == mlBlockingBodyUpdateTimestamp)
			return m_idBlockingBody;
		
		mlBlockingBodyUpdateTimestamp = lTimeStamp;
		UpdateBlockingBody();
		return m_idBlockingBody;
	}
	
	//------------------------------------------------------------
	
	void UpdateBlockingBody()
	{
		cVector3f vBoxSize(0.1f, 0.1f, 0.1f);
		cVector3f vAreaFwd = mBaseObj.GetMatrix().GetTranspose().GetForward();
		cVector3f vBoxPos = mBaseObj.GetPosition() + (vAreaFwd * 0.25f) - cVector3f(0.f, 0.25f, 0.f);
		cVector3f vMin = vBoxPos - vBoxSize / 2.f;
		cVector3f vMax = vBoxPos + vBoxSize / 2.f;
		
		array<iPhysicsBody@> vBodies;
		mBaseObj.GetMap().GetPhysicsWorld().GetBodiesInAABB(vMin, vMax, false, false, vBodies);
		
		for (int i = 0; i < vBodies.size(); ++i)
		{
			iPhysicsBody@ pBody = vBodies[i];
			
			if (Blackboard_GetCanBodyBlockPath(pBody))
			{
				m_idBlockingBody = pBody.GetID();
				return;
			}
		}
		
		m_idBlockingBody = tID_Invalid;
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}

	//------------------------------------------------------------	
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		//apFunctions.GetLowLevelGfx().DrawSphere(pBlockingEnt.GetBasePosition(), 0.25, cColor_Green*3);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbLit = false;
	tID m_idBlockingBody;
	int mlBlockingBodyUpdateTimestamp = -1;
	
	//------------------------------------------------------------
}	