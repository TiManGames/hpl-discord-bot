#include "interfaces/Area_Interface.hps"
#include "base/Player_Types.hps"

#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "helpers/helper_player.hps"
#include "helpers/helper_modules.hps"
#include "custom/helpers/helper_player_custom.hps"

class cScrAreaFuelHatch : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		float fMaxInteractDist = apVars.GetVarFloat("MaxFocusDistance", -1);
		if(fMaxInteractDist>=0) mBaseObj.SetMaxInteractDistance(fMaxInteractDist);
		
		mBaseObj.SetPlayerLookAtCallback(	apVars.GetVarString("PlayerLookAtCallback",""),
											apVars.GetVarBool("PlayerLookAtCallbackAutoRemove",false),
											apVars.GetVarBool("PlayerLookAtCheckCenterOfScreen",true),
											apVars.GetVarBool("PlayerLookAtCheckRayIntersection",true),
											apVars.GetVarFloat("PlayerLookAtMaxDistance",-1),
											apVars.GetVarFloat("PlayerLookAtCallbackDelay",0));

		mBaseObj.SetPlayerInteractCallback(	apVars.GetVarString("PlayerInteractCallback",""),
											apVars.GetVarBool("PlayerInteractCallbackAutoRemove",false) );
		
		mBaseObj.SetCheckCollision(false);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ResetProperties()
	{
	}
	
	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERACTION
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	bool CanInteract(int alType, iPhysicsBody@ apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
		
	bool OnInteract(int alType, iPhysicsBody@ apBody, const cVector3f &in avFocusPos, const tString&in asData)
	{
		return mBaseObj.HasPlayerInteractCallback();
	}
	//------------------------------------------------------------
	
	int GetInteractIconId(int alType, iPhysicsBody@ apBody)
	{
		bool bHasFuelCanister = ItemType_GetCountInInventory("Fuel") > 0;
		bool bHasFuelBottle = ItemType_GetCountInInventory("FuelBottle") > 0;
		
		if (bHasFuelCanister==false && bHasFuelBottle)
			return eCrossHairState_UseFuelBottle;
			
		return eCrossHairState_UseFuel;
	}
		
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// COLLISIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------

	bool OnStartCheckCollision(float afTimeStep, float afTimeSinceCheck)
	{
		return false;
	}
	
	//-----------------------------------------------------------------------

	bool OnCheckCollision(iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		return true;
	}
	
	//-----------------------------------------------------------------------

	void OnEndCheckCollision(float afTimteStep)
	{
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	void OnSetActive(bool abX)
	{
	
	}
	
	//-----------------------------------------------------------------------
	
	
	void OnConnectionStateChange(iLuxEntity@ apEntity,int alState)
	{
		if(alState==0) return;
	}
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//-----------------------------------------------------------------------
	
	//-----------------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
}	