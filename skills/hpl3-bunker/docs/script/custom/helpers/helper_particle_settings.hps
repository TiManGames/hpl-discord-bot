
const tString[] gvParticleQualitySuffix =
{
	"_low",
	"_med",
	"_high"
};

/*
relevant particles/entities:

gas_grenade_smoke.ps
gas_grenade_smoke_spread.ps

molotov_fire.ps
molotov_fire_02.ps

grenade_explosion.ps
flare_thrown.ent


*/

cParticleSystem@ ParticleSetting_CreateParticleSystemFromSetting(iLuxEntity@ pEntity, const tString&in asName, const tString&in asFile, bool abRemoveWhenDone, bool abAttach)
{
	int lParticleQuality = cLux_GetUserConfig().GetInt("Graphics", "ParticleQuality", 1);
	lParticleQuality = cMath_Clamp(lParticleQuality, 0, 2);
	
	tString sExt = "." + cString_GetFileExt(asFile);
	tString sBaseName = cString_SetFileExt(asFile, "");

	cParticleSystem@ pPS = null;

	for(int i = lParticleQuality; i < 3; ++i)
	{
		tString sParticleSystem = sBaseName + gvParticleQualitySuffix[i] + sExt;
		@pPS = pEntity.CreateParticleSystem(asName, sParticleSystem, abRemoveWhenDone, abAttach);

		if(pPS !is null)
		{
			cLux_AddDebugMessage("Spawned:" + sParticleSystem);
			return pPS;
		}
	}
	
	// Try with the default
	@pPS = pEntity.CreateParticleSystem(asName, asFile, abRemoveWhenDone, abAttach);
	cLux_AddDebugMessage("Spawned:" + asFile);

	return pPS;
}

void ParticleSetting_PreloadParticles(const tString&in asFile)
{
	tString sExt = "." + cString_GetFileExt(asFile);
	tString sBaseName = cString_SetFileExt(asFile, "");

	cParticleSystem@ pPS = null;

	for(int i = 0; i < 3; ++i)
	{
		tString sParticleSystem = sBaseName + gvParticleQualitySuffix[i] + sExt;
		ParticleSystem_Preload(sParticleSystem);
	}
	
	// Try with the default
	ParticleSystem_Preload(asFile);
}


iLuxEntity@ ParticleSetting_CreateEntityFromSetting(cLuxMap@ apMap, const tString&in asName, const tString&in asFile, const cMatrixf&in a_mtxTransform, const cVector3f&in avScale)
{
	int lParticleQuality = cLux_GetUserConfig().GetInt("Graphics", "ParticleQuality", 0);
	lParticleQuality = cMath_Clamp(lParticleQuality, 0, 2);
	
	tString sExt = "." + cString_GetFileExt(asFile);
	tString sBaseName = cString_SetFileExt(asFile, "");

	iLuxEntity@ pEnt = null;

	for(int i = lParticleQuality; i < 3; ++i)
	{
		tString sFileName = sBaseName + gvParticleQualitySuffix[i] + sExt;

		apMap.CreateEntity(asName, sFileName, a_mtxTransform, avScale);
		@pEnt = apMap.GetLatestEntity();

		if(pEnt !is null)
		{
			cLux_AddDebugMessage("Spawned:" + sFileName);
			return pEnt;
		}
	}
	
	// Try with the default
	apMap.CreateEntity(asName, asFile, a_mtxTransform, avScale);
	@pEnt = apMap.GetLatestEntity();
	cLux_AddDebugMessage("Spawned:" + asFile);
	return pEnt;
}

void ParticleSetting_PreloadEntity(const tString&in asFile)
{
	tString sExt = "." + cString_GetFileExt(asFile);
	tString sBaseName = cString_SetFileExt(asFile, "");

	for(int i = 0; i < 3; ++i)
	{
		Entity_Preload(sBaseName + gvParticleQualitySuffix[i] + sExt);
	}
	
	// Try with the default
	Entity_Preload(asFile);
}

