int Revolver_GetUnspentBulletCount()
{
	tString sEnt = Item_GetItemEntity(ItemType_GetFirstInInventory("Gun"));
	cScript_RunGlobalFunc(sEnt, "cScrPropGun", "_Global_GetUnspentBulletCount");
	return cScript_GetGlobalReturnInt();
}

//-------------------------------------------------

bool Revolver_GetCurrentChamberEmpty()
{
	tString sEnt = Item_GetItemEntity(ItemType_GetFirstInInventory("Gun"));
	cScript_RunGlobalFunc(sEnt, "cScrPropGun", "_Global_GetCurrentChamberEmpty");
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------

void Revolver_LoadChamber(int alChamber = -1)
{
	tString sEnt = Item_GetItemEntity(ItemType_GetFirstInInventory("Gun"));
	cScript_SetGlobalArgInt(0, alChamber);
	cScript_RunGlobalFunc(sEnt, "cScrPropGun", "_Global_LoadChamber");
}

