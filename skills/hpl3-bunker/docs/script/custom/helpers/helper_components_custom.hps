#include "custom/components/ComponentInterfaces_Custom.hps"

/////////////////////////////////////////
// RAT FOOD
/////////////////////////////////////////

//-------------------------------------------------

tString RatFood_GetAltFoodEntity(const tString &in asEntity)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity, eLuxEntityType_Prop);
	if (pEnt is null) return "";
	if (pEnt.IsActive()==false) return "";
	
	//////////////////////////////
	// Get alt entity from the component
	iScrRatFoodComponent_Interface@ pFood = UserComponent_RatFoodComponent_Get(pEnt);
	if (pFood is null)
	{
		Error("Entity '"+asEntity+"' doesn't have a rat food component!");
		return "";
	}

	////////////////////////////
	// If no alt entity specified return self
	tString sFoodEnt = pFood.GetFoodEntity();
	return sFoodEnt!="" ? asEntity : sFoodEnt;
}

//-------------------------------------------------

int RatFood_GetFeedingSlotsCount(const tString &in asEntity)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity, eLuxEntityType_Prop);
	if (pEnt is null) return 0;
	if (pEnt.IsActive()==false) return 0;
	
	iScrRatFoodComponent_Interface@ pFood = UserComponent_RatFoodComponent_Get(pEnt);
	if (pFood is null)
	{
		Error("Entity '"+asEntity+"' doesn't have a rat food component!");
		return 0;
	}
	
	return pFood.GetFeedingSlotsCount();
}

//-------------------------------------------------

void WoodenBreakable_SetIsBreakable(const tString &in asEntity, bool abX)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity, eLuxEntityType_Prop);
	iScrWoodenBreakableComponent_Interface@ pComp = pEnt !is null ? UserComponent_WoodenBreakableComponent_Get(pEnt) : null;
	
	if (pEnt is null) return;
	if (pComp is null) return;
	
	pComp.SetIsBreakable(abX);
}

//-------------------------------------------------

bool WoodenBreakable_GetIsPathBlocker(const tString &in asEntity)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity, eLuxEntityType_Prop);
	iScrWoodenBreakableComponent_Interface@ pComp = pEnt !is null ? UserComponent_WoodenBreakableComponent_Get(pEnt) : null;
	
	if (pEnt is null || pComp is null) return false;
	
	return pComp.GetIsPathBlocker();
}

//-------------------------------------------------

bool WoodenBreakable_GetIsBroken(const tString &in asEntity)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity, eLuxEntityType_Prop);
	iScrWoodenBreakableComponent_Interface@ pComp = pEnt !is null ? UserComponent_WoodenBreakableComponent_Get(pEnt) : null;
	
	if (pEnt is null || pComp is null) return false;
	
	return pComp.GetIsBroken();
}

