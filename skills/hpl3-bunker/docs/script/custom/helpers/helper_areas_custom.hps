//-------------------------------------------------

//////////////////////////////////
// RAT FEED AREA
//////////////////////////////////

//-------------------------------------------------

int RatFeed_GetMaxRatAmount(const tString &in asArea)
{
	if (cScript_RunGlobalFunc(asArea, "cScrAreaRatFeed", "_Global_GetMaxRatAmount") == false)
	{
		Error("Could not run '"+asArea+"' / _Global_GetMaxRatAmount()");
		return 0;
	}
	
	return cScript_GetGlobalReturnInt();
}

//-------------------------------------------------

tString RatFeed_GetFoodEntity(const tString &in asArea)
{
	if (cScript_RunGlobalFunc(asArea, "cScrAreaRatFeed", "_Global_GetFoodEntity") == false)
	{
		Error("Could not run '"+asArea+"' / _Global_GetFoodEntity()");
		return "";
	}
	
	return cScript_GetGlobalReturnString();
}

