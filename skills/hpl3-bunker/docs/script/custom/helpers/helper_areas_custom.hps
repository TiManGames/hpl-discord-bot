//////////////////////////////////////
// GHOUL HOLES
//////////////////////////////////////

//-------------------------------------------------

tID GhoulHole_GetBlockingBody(const tString&in asEntity)
{
	cScript_RunGlobalFunc(asEntity, "cScrAreaGhoulHole", "_Global_GetBlockingBody");
	return cScript_GetGlobalReturnID();
}

