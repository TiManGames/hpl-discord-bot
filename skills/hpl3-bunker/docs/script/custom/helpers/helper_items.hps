//-------------------------------------------------------

/**
* @param aInstance, inventory instance,
* @param abIgnoreHidden, if it should include hidden items (i.e. bullets)
*/

bool Item_GetInventoryIsFull(eInventoryInstance aInstance=eInventoryInstance_Player, bool abIgnoreHidden=false)
{
	iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
	int lCount = pHandler.GetItemCount(aInstance, abIgnoreHidden);
	return lCount >= pHandler.GetCurrentSlotsCount(aInstance);
}

//-------------------------------------------------------

bool Item_GetPlayerInventoryIsFull()
{
	iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
	int lCount = pHandler.GetItemCount(eInventoryInstance_Player, true);
	return lCount >= pHandler.GetCurrentSlotsCount(eInventoryInstance_Player);
}

