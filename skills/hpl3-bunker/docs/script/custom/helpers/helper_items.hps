tString Item_GetAnimationName(const tString& in asEntity)
{
	cScript_RunGlobalFunc(asEntity, "cScrPropPickup", "_Global_GetAnimationName");
	return cScript_GetGlobalReturnString();
}

//-------------------------------------------------------

tString Item_GetAnimationNameSpecific(const tString& in asEntity, const tString& in asType)
{
	cScript_SetGlobalArgString(0, asEntity);
	cScript_SetGlobalArgString(1, asType);
	cScript_RunGlobalFunc(asEntity, "cScrPropPickup", "_Global_GetAnimationNameSpecific");
	return cScript_GetGlobalReturnString();
}

//-------------------------------------------------------

void Item_ReduceContentCount(const tString &in asContentType, int alAmount, eInventoryInstance aInstance=eInventoryInstance_Player)
{
	iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
	for (uint i=0; i<pHandler.GetItemCount(aInstance); ++i)
	{
		iScrItem@ pItem = pHandler.GetItem(aInstance, i);
		
		if (pItem.GetType().GetContainerContentType()!=asContentType) continue;
		
		int lAmount = pItem.GetAmount();
		if (lAmount<=0) continue;
		if (lAmount >= alAmount)
		{
			pItem.SetAmount(lAmount - alAmount);
			return;
		}
		else
		{
			pItem.SetAmount(0);
			alAmount -= lAmount;
		}
	}
}

//-------------------------------------------------------

/////////////////////////////////////////
// POCKET WATCH
/////////////////////////////////////////

//-------------------------------------------------------

void PocketWatch_WindUp(bool abInstant)
{
	if (Item_GetHeldType(eItemHandlerHand_Right) != "PocketWatch")
		return;
	
	/////////////////
	// Play animation
	if (abInstant == false)
	{
		if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Normal)
			cLux_GetPlayer().ChangeState(ePlayerState_Normal);
		
		cScript_RunGlobalFunc("State_UsingPocketWatch", "", "_Global_SetupWindUp");
		cLux_GetPlayer().ChangeState(ePlayerState_Custom_UsingPocketWatch);
		return;
	}
	
	/////////////////
	// Skip animatons
	tString sEnt = Item_GetHeldEntity(eItemHandlerHand_Right);
	PocketWatch_WindUpInstant(sEnt);
}

//-------------------------------------------------------

void PocketWatch_WindUpInstant(const tString &in asEntity)
{
	cScript_SetGlobalArgBool(0, true);
	
	cScript_RunGlobalFunc(asEntity, "cScrPropPocketWatch", "_Global_WindUpPocketWatch");
	cScript_RunGlobalFunc("State_UsingPocketWatch", "", "_Global_SetWindupTimestamp");
}

//-------------------------------------------------------

void PocketWatch_WindUpIfNeeded(bool abInstant)
{
	cScript_RunGlobalFunc("State_UsingPocketWatch", "", "_Global_GetWindupNeeded");
	bool bWindupNeeded = cScript_GetGlobalReturnBool();
	
	if (bWindupNeeded) PocketWatch_WindUp(abInstant);
}

//-------------------------------------------------------

bool PocketWatch_GetWindUpNeeded()
{
	cScript_RunGlobalFunc("State_UsingPocketWatch", "", "_Global_GetWindupNeeded");
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------------

void PocketWatch_ForceWindUp()
{
	cScript_RunGlobalFunc("State_UsingPocketWatch", "", "_Global_ForceWindup");
}

//-------------------------------------------------

void PocketWatch_Stop()
{
	if (Item_GetHeldType(eItemHandlerHand_Right) != "PocketWatch")
		return;
	
	tString sEnt = Item_GetHeldEntity(eItemHandlerHand_Right);
	
	cScript_RunGlobalFunc(sEnt, "cScrPropPocketWatch", "_Global_StopPocketWatch");
}

//-------------------------------------------------

void PocketWatch_Reset()
{
	if (Item_GetHeldType(eItemHandlerHand_Right) != "PocketWatch")
		return;
	
	tString sEnt = Item_GetHeldEntity(eItemHandlerHand_Right);
	cScript_RunGlobalFunc(sEnt, "cScrPropPocketWatch", "_Global_ResetPocketWatch");
}

//-------------------------------------------------

bool PocketWatch_GetIsRunning()
{
	if (Item_GetHeldType(eItemHandlerHand_Right) != "PocketWatch")
		return false;
		
	tString sEnt = Item_GetItemEntity(ItemType_GetFirstInInventory("PocketWatch"));
	cScript_RunGlobalFunc(sEnt, "cScrPropPocketWatch", "_Global_GetIsRunning");
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------------

void PocketWatch_Run()
{
	if (Item_GetHeldType(eItemHandlerHand_Right) != "PocketWatch")
		return;
	
	cScript_RunGlobalFunc("State_UsingPocketWatch", "", "_Global_SetupClick");
	cLux_GetPlayer().ChangeState(ePlayerState_Custom_UsingPocketWatch);
}

