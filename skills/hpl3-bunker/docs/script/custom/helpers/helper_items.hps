//-------------------------------------------------------

/** If this item type is droppable,
 * spawns an entity in the level to represent the item at
 * the given location.
 * The entity file comes from ItemTypes.cfg 
 * @param asType Item type
 * @param aTransform Position to spawn it at
 * @return name of the new entity, or "" if it failed.
 */
tString ItemType_SpawnAsEntity(const tString& in asType, const cMatrixf& in aTransform, const tString& in asName="", float afScale=1.0f, eItemSpawn aSpawn=eItemSpawn_World, eItemSpawnType aSpawnType=eItemSpawnType_Default)
{
	iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
	return pHandler.SpawnTypeAsEntity(asType, aTransform, asName, afScale, aSpawn, aSpawnType);
}

//-------------------------------------------------------
 
 /**
  * @brief 
  * @param aInstance, the inventory instance.
  * @param in asType, Item type.
  * @return True if there's enough space in the inventory.
  */
bool ItemType_WillFit(const tString& in asType, bool abIgnoreHidden=false, eInventoryInstance aInstance=eInventoryInstance_Player)
{
	iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
	return pHandler.WillItemTypeFit(aInstance, asType, abIgnoreHidden);
}

