/////////////////////////////////////////
// ARENA
/////////////////////////////////////////

//-------------------------------------------------------

class cPlatformNode
{
	cPlatformNode() {}	
	cPlatformNode(const tString &in asName, const array<tString> &in avNeighbours)
	{
		msName = asName;
		mvNeighbours = avNeighbours;	
	}
	
	tString msName;
	array<tString> mvNeighbours;
}

//--------------------------------------------------

class cPlatformNodeHistory
{
	cPlatformNodeHistory() {}
	cPlatformNodeHistory(const tString &in asCurrent, const tString &in asPrev, float afCost)
	{
		msName = asCurrent;
		msPrev = asPrev;
		mfCost = afCost;
	}
	
	tString msName;
	tString msPrev;
	float mfCost;
}

//--------------------------------------------------

class cPlatformNodePriority
{
	cPlatformNodePriority() {}
	cPlatformNodePriority(const tString &in asName, float afPriority)
	{
		msName = asName;
		mfPriority = afPriority;
	}
	
	tString msName;
	float mfPriority;
	
	int opCmp(const cPlatformNodePriority &in other)
	{
		if (mfPriority > other.mfPriority) return 1;
		if (mfPriority < other.mfPriority) return -1;
		return 0;
	}
}

//--------------------------------------------------

class cPlatformNodeEdge
{
	cPlatformNodeEdge() {}
	cPlatformNodeEdge(const tString &in asNodeA, const tString &in asNodeB, float afCost)
	{
		msNodeA = asNodeA;
		msNodeB = asNodeB;
		msName = msNodeA + msNodeB;
		mfCost = afCost;
	}
	
	tString msNodeA;
	tString msNodeB;
	tString msName;
	float mfCost;
}

//--------------------------------------------------

class cPlatformPathfinder
{	
	//-------------------------------------------------------
	
	void GeneratePlatformNodeEdgeCosts(bool abRandomize)
	{
		mvPlatformNodeEdges.resize(0);
		
		///////////////////
		// Iterate nodes
		for (int i = 0; i < mvPlatformNodeGraph.size(); ++i)
		{
			cPlatformNode@ pNodeA = mvPlatformNodeGraph[i];
			
			for (int j = 0; j < pNodeA.mvNeighbours.size(); ++j)
			{
				cPlatformNode@ pNodeB = GetPlatformNode(pNodeA.mvNeighbours[j]);
				
				///////////////////
				// Calculate cost
				float fCost = 1.f;		
				
				if (abRandomize)
				{
					if (mvHighCostPlaformNodes.find(pNodeA.msName) != -1 ||
						mvHighCostPlaformNodes.find(pNodeB.msName) != -1)
					{
						if (cMath_RandRectl(0, 1) == 1)
							fCost = 10.f;
					}
					else
					{
						if (cMath_RandRectl(0, 2) == 2)
							fCost = 5.f;
					}
				}
				
				///////////////////
				// Create edge
				mvPlatformNodeEdges.push_back(cPlatformNodeEdge(pNodeA.msName, pNodeB.msName, fCost));
			}
		}
	}
	
	//-------------------------------------------------------
	
	array<cPlatformNode@>@ GetPlatformNodePath(const tString &in asStart, const tString &in asGoal, bool abRandomizeEdgeCosts = false)
	{
		/////////////////
		// Generate costs
		if (mvPlatformNodeEdges.size() == 0 || abRandomizeEdgeCosts)
		{
			GeneratePlatformNodeEdgeCosts(abRandomizeEdgeCosts);
		}
			
		/////////////////	
		// Setup vars
		mvPlatformNodeFrontier.resize(0);
		mvPlatformNodeHistory.resize(0);
		
		mvPlatformNodeFrontier.push_back(cPlatformNodePriority(asStart, 0.f));
		mvPlatformNodeHistory.push_back(cPlatformNodeHistory(asStart, "", 0.f));
			
		cPlatformNode@ pGoal = GetPlatformNode(asGoal);
		
		if (pGoal is null) return null;
			
		/////////////////
		// Find path
		while (mvPlatformNodeFrontier.size() > 0)
		{
			cPlatformNode@ pCurrent = GetPlatformNode(mvPlatformNodeFrontier[0].msName);
			cPlatformNodeHistory@ pCurrentHistory = GetPlatformNodeHistory(pCurrent.msName);
			
			/////////////////
			// At goal?
			if (pCurrent is pGoal)
			{
				break;
			}
			
			/////////////////
			// Iterate neighbours
			for (int i = 0; i < pCurrent.mvNeighbours.size(); ++i)
			{
				cPlatformNode@ pNext = GetPlatformNode(pCurrent.mvNeighbours[i]);				
				
				/////////////////
				// Update history
				cPlatformNodeEdge@ pEdge = GetPlatformNodeEdge(pCurrent.msName, pNext.msName);
				cPlatformNodeHistory@ pNextHistory = GetPlatformNodeHistory(pNext.msName);
				
				float fEdgeCost = pEdge !is null ? pEdge.mfCost : 0.f;
				float fNewCost = pCurrentHistory.mfCost + fEdgeCost;
				
				if (pNextHistory is null || fNewCost < pNextHistory.mfCost)
				{
					if (pNextHistory is null)
					{
						mvPlatformNodeHistory.push_back(cPlatformNodeHistory(pNext.msName, pCurrent.msName, fNewCost));
					}
					else
					{
						pNextHistory.mfCost = fNewCost;
						pNextHistory.msPrev = pCurrent.msName;
					}
					
					/////////////////
					// Update priority
					cPlatformNodePriority@ pNodePriority = GetPlatformNodePriority(pNext.msName);
					float fPriority = fNewCost;
					
					if (pNodePriority !is null)
					{
						pNodePriority.mfPriority = fPriority;
					}
					else
					{
						mvPlatformNodeFrontier.push_back(cPlatformNodePriority(pNext.msName, fPriority));
					}
				}					
			}
			
			/////////////////
			// Prioritize high prio nodes
			mvPlatformNodeFrontier.removeAt(0);
			mvPlatformNodeFrontier.sortAsc();
		}
			
		/////////////////
		// Retrace path
		array<cPlatformNode@> vPath;		
		cPlatformNodeHistory@ pNodeHistory = GetPlatformNodeHistory(asGoal);
		
		while (pNodeHistory !is null)
		{
			vPath.push_back(GetPlatformNode(pNodeHistory.msName));
			@pNodeHistory = GetPlatformNodeHistory(pNodeHistory.msPrev);
		}
			
		vPath.reverse();
		
		return vPath;
	}
	
	//-------------------------------------------------------
	
	cPlatformNode@ GetPlatformNode(const tString &in asName)
	{
		for (int i = 0; i < mvPlatformNodeGraph.size(); ++i)
		{
			cPlatformNode@ pNode = mvPlatformNodeGraph[i];
			if (pNode.msName == asName)
				return pNode;
		}
		
		return null;
	}
	
	//-------------------------------------------------------
	
	cPlatformNodeHistory@ GetPlatformNodeHistory(const tString &in asName)
	{
		for (int i = 0; i < mvPlatformNodeHistory.size(); ++i)
		{
			cPlatformNodeHistory@ pHistory = mvPlatformNodeHistory[i];
			if (pHistory.msName == asName)
				return pHistory;
		}
		
		return null;
	}
	
	//-------------------------------------------------------
	
	cPlatformNodePriority@ GetPlatformNodePriority(const tString &in asName)
	{
		for (int i = 0; i < mvPlatformNodeFrontier.size(); ++i)
		{
			cPlatformNodePriority@ pPriority = mvPlatformNodeFrontier[i];
			if (pPriority.msName == asName)
				return pPriority;
		}
		
		return null;
	}	
	
	//-------------------------------------------------------
	
	cPlatformNodeEdge@ GetPlatformNodeEdge(const tString &in asNodeA, const tString &in asNodeB)
	{		
		for (int i = 0; i < mvPlatformNodeEdges.size(); ++i)
		{
			cPlatformNodeEdge@ pEdge = mvPlatformNodeEdges[i];
						
			if (pEdge.msNodeA != asNodeA) continue;
			if (pEdge.msNodeB != asNodeB) continue;
			
			return pEdge;
		}
		
		return null;
	}
	
	//-------------------------------------------------------
	
	cPlatformNodeEdge@ GetPlatformNodeEdge(const tString &in asName)
	{
		for (int i = 0; i < mvPlatformNodeEdges.size(); ++i)
		{
			cPlatformNodeEdge@ pEdge = mvPlatformNodeEdges[i];
			if (pEdge.msName == asName)
				return pEdge;
		}
		
		return null;
	}
	
	//-------------------------------------------------------
	
	void RemovePlatformNodeEdge(const tString &in asNodeA, const tString &in asNodeB)
	{						
		for (int i = 0; i < mvPlatformNodeGraph.length(); ++i)
		{
			cPlatformNode@ pNode = mvPlatformNodeGraph[i];				
			if (pNode.msName != asNodeA) continue;
					
			for (int j = 0; j < pNode.mvNeighbours.size(); ++j)
			{
				tString sNeighbour = pNode.mvNeighbours[j];				
				if (sNeighbour != asNodeB) continue;
				
				pNode.mvNeighbours.removeAt(j);
				--j;
			}
		}
		
		for (int i = 0; i < mvPlatformNodeEdges.size(); ++i)
		{
			cPlatformNodeEdge@ pEdge = mvPlatformNodeEdges[i];
			
			if (pEdge.msNodeA != asNodeA) continue;
			if (pEdge.msNodeB != asNodeB) continue;
			
			mvPlatformNodeEdges.removeAt(i);
			--i;
		}
	}
	
	//-------------------------------------------------------
	
	void AddPlatformNodeEdge(const tString &in asNodeA, const tString &in asNodeB)
	{
		cPlatformNodeEdge@ pEdge = GetPlatformNodeEdge(asNodeA, asNodeB);
		if (pEdge !is null) return;
		
		for (int i = 0; i < mvPlatformNodeGraph.length(); ++i)
		{
			cPlatformNode@ pNode = mvPlatformNodeGraph[i];			
			if (pNode.msName != asNodeA) continue;
			
			pNode.mvNeighbours.push_back(asNodeB);
		}
		
		mvPlatformNodeEdges.push_back(cPlatformNodeEdge(asNodeA, asNodeB, 1.f));
	}
	
	//-------------------------------------------------------
	
	cPlatformNode[] mvPlatformNodeGraph = { cPlatformNode("A", array<tString> = { "B", "C", "D" }),
											cPlatformNode("B", array<tString> = { "A", "C", "E" }),
											cPlatformNode("C", array<tString> = { "A", "B", "F", "G" }),
											cPlatformNode("D", array<tString> = { "A", "G" }),
											cPlatformNode("E", array<tString> = { "B", "F", "Z" }),
											cPlatformNode("F", array<tString> = { "C", "E", "G", "Z" }),
											cPlatformNode("G", array<tString> = { "C", "D", "F", "H" }),
											cPlatformNode("H", array<tString> = { "G", "Z" }),
											cPlatformNode("Z", array<tString> = { "E", "F", "H" }) };
	
	tString[] mvHighCostPlaformNodes = { "B", "C", "E", "F" };	
	
	array<cPlatformNodeEdge> mvPlatformNodeEdges;
	array<cPlatformNodeHistory> mvPlatformNodeHistory;	
	array<cPlatformNodePriority> mvPlatformNodeFrontier;
	
	tString msCurrentNode = "";
}

//--------------------------------------------------

class cBridgeData
{
	tString msName = "";
	tString msId = "";
	tString msPlatform = "";
	cVector3f mvStartPos = cVector3f(0.f);
	cVector3f mvEndPos = cVector3f(0.f);
}

//-------------------------------------------------------

class cBridgePathBlockerData
{
	float mfEdgeCost = -1.f;
	tString msNodeA = "";
	tString msNodeB = "";
	tID m_idBlockerEnt = tID_Invalid;
}

