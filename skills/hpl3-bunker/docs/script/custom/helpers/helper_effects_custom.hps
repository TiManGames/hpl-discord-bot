#include "custom/effects/Effects_Custom.hps"

//-------------------------------------------------

/////////////////////////////////////////
// DOLLY ZOOM
/////////////////////////////////////////

//-------------------------------------------------

void Effect_DollyZoom_Start(float afAmount, float afTime, float afFadeInTime, float afFadeOutTime)
{
	iScrEffect_DollyZoom@ pEffect = cast<iScrEffect_DollyZoom>(cLux_GetEffectHandler().GetEffect(eEffect_Custom_DollyZoom));
	pEffect.Start(afAmount, afTime, afFadeInTime, afFadeOutTime);
}

//-------------------------------------------------

void Effect_DollyZoom_Stop()
{
	iScrEffect_DollyZoom@ pEffect = cast<iScrEffect_DollyZoom>(cLux_GetEffectHandler().GetEffect(eEffect_Custom_DollyZoom));
	pEffect.Stop();
}

//-------------------------------------------------