	//------------------------------------------------------------
	
	void _Global_Debug()
	{
		mpStateMachine.ChangeState(eShotgunnerState_Debug);
		
		Hurt_SpawnBlood();
	}
	
	//------------------------------------------------------------
	
	void _Global_AddPatrolNode()
	{
		tString sNode = cScript_GetGlobalArgString(0);
		
		int lId = mvPatrol_Nodes.find(sNode);
		if (lId == -1)
			mvPatrol_Nodes.push_back(sNode);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetWaitInIdle()
	{
		mbIdle_Wait = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_StartPatrol()
	{
		if (mpStateMachine.GetCurrentState() == eShotgunnerState_Idle)
			mpStateMachine.ChangeState(eShotgunnerState_Patrol);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetShootMapLight()
	{
		m_idShoot_MapLightFlash = cScript_GetGlobalArgID(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_Shoot()
	{
		tString sEnt = cScript_GetGlobalArgString(0);
		bool bReload = cScript_GetGlobalArgBool(1);
		bool bWaitInIdleAfterShoot = cScript_GetGlobalArgBool(2);
		iLuxEntity@ pEnt = mBaseObj.GetMap().GetEntityByName(sEnt);
		
		if (pEnt !is null)
		{
			mbShoot_Reload = bReload;
			mbIdle_Wait = bWaitInIdleAfterShoot;
			mbShoot_WaitInIdleAfterShoot = bWaitInIdleAfterShoot;
			
			if (mpStateMachine.GetCurrentState() == eShotgunnerState_Shoot)
			{
				mbIdle_QueueShoot = true;
				m_idIdle_QueueShootTarget = pEnt.GetID();
				mbShoot_WaitInIdleAfterShoot = true;
				mbShoot_ResetWaitInIdleAfterShoot = false;
			}
			else
			{
				m_idShoot_Target = pEnt.GetID();
				mpStateMachine.ChangeState(eShotgunnerState_Shoot);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_ResetWaitInIdleAfterShoot()
	{
		mbShoot_WaitInIdleAfterShoot = false;
		mbShoot_ResetWaitInIdleAfterShoot = false;
	}
	
	//------------------------------------------------------------
	
	void _Global_AddShootIgnoreEnt()
	{
		tString sEnt = cScript_GetGlobalArgString(0);
		iLuxEntity@ pEnt = mBaseObj.GetMap().GetEntityByName(sEnt);
		
		tID id = pEnt !is null ? pEnt.GetID() : tID_Invalid;
		
		int lId = mvShoot_IgnoreEntIds.find(id);
		if (lId == -1)
			mvShoot_IgnoreEntIds.push_back(id);
	}
	
	//------------------------------------------------------------
	
	void _Global_RemoveShootIgnoreEnt()
	{
		tString sEnt = cScript_GetGlobalArgString(0);
		iLuxEntity@ pEnt = mBaseObj.GetMap().GetEntityByName(sEnt);
		
		tID id = pEnt !is null ? pEnt.GetID() : tID_Invalid;
		
		int lId = mvShoot_IgnoreEntIds.find(id);
		if (lId != -1)
			mvShoot_IgnoreEntIds.removeAt(lId);
	}
	
	//------------------------------------------------------------
	
	void _Global_AddRouteBlockerSet()
	{
		tID idBlockerA = cScript_GetGlobalArgID(0);
		tID idBlockerB = cScript_GetGlobalArgID(1);
		
		//////////////////////
		// Set exists?
		bool bExists = false;		
		for (int i = 0; i < mvRouteBlockerSets.size(); ++i)
		{
			cShotgunner_RouteBlockerSet@ pSet = mvRouteBlockerSets[i];
			
			if (pSet.m_idBlockerA == idBlockerA ||
				pSet.m_idBlockerA == idBlockerB ||
				pSet.m_idBlockerB == idBlockerA ||
				pSet.m_idBlockerB == idBlockerB)
			{
				bExists = true;
				break;
			}			
		}
		
		//////////////////////
		// Add set!
		if (bExists == false)
		{
			cShotgunner_RouteBlockerSet set;
			set.m_idBlockerA = idBlockerA;
			set.m_idBlockerB = idBlockerB;
			
			mvRouteBlockerSets.push_back(set);
			
			//////////////////////
			// Shuffle blockers
			ShuffleRouteBlockers();
		}
	}
	
	//------------------------------------------------------------
	
	void _Global_SetRouteBlockerActive()
	{
		tID idBlocker = cScript_GetGlobalArgID(0);
		bool bActive = cScript_GetGlobalArgBool(1);
		SetRouteBlockerActive(idBlocker, bActive);
	}	
	
	//------------------------------------------------------------
	
	void _Global_Retreat()
	{
		if (mpStateMachine.GetCurrentState() == eShotgunnerState_Dead)
			return;
		
		if (mpStateMachine.GetCurrentState() != eShotgunnerState_Retreat)
			mpStateMachine.ChangeState(eShotgunnerState_Retreat);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetEncounterBarksActive()
	{
		bool bEncounterBarks = cScript_GetGlobalArgBool(0);
		mlPoemBarkState = bEncounterBarks ? eShotgunnerBark_PoemEncounter : eShotgunnerBark_PoemIntro;
		
		int lState = mpBarkMachine.GetCurrentState();
		if (lState == eShotgunnerBark_PoemIntro && bEncounterBarks)
			mpBarkMachine.ChangeState(eShotgunnerBark_PoemEncounter);
		else if (lState == eShotgunnerBark_PoemEncounter && bEncounterBarks == false)
			mpBarkMachine.ChangeState(eShotgunnerBark_PoemIntro);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetChantPoem()
	{
		mbChantPoem = cScript_GetGlobalArgBool(0);
	}
	
	//------------------------------------------------------------
	
	void _Global_ResetPoemCount()
	{
		mfPoemPlayCount = mfPoemWaitTime;
		mfPoemWaitTime = -1.f;
	}
	
	//------------------------------------------------------------
	
	void _Global_AddDoor()
	{
		tID idDoor = cScript_GetGlobalArgID(0);
		if (idDoor == tID_Invalid) return;
		
		int lId = mvDoorIds.find(idDoor);
		if (lId == -1)
			mvDoorIds.push_back(idDoor);
	}
	
	//------------------------------------------------------------
	
	void _Global_SetReducedPerceptionActive()
	{
		bool bActive = cScript_GetGlobalArgBool(0);
		SetReducedPerceptionActive(bActive);
	}
	
