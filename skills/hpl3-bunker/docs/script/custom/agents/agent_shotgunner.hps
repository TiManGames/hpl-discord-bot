	///////////////////////////////////
	// SHOTGUNNER HELPERS
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetRagdollActive(bool abX, float afFadeTime = 0.f)
	{
		mpMover.SetUseMoveStateAnimations(abX == false);
		mBaseObj.SetRagdollActive(abX, afFadeTime);
	}
	
	//------------------------------------------------------------
	
	void SetAttachShotgun(bool abX)
	{
		cLuxProp@ pShotgun = cLux_ID_Prop(m_idShotgunEnt);
		if (pShotgun is null) return;
		
		////////////////////
		// Setup bodies
		pShotgun.SetStaticPhysics(abX);
		pShotgun.SetInteractionDisabled(abX);
		
		for (int i = 0; i < pShotgun.GetBodyNum(); ++i)
		{
			iPhysicsBody@ pBody = pShotgun.GetBody(i);
			
			pBody.SetCollide(abX == false);
			pBody.SetCollideCharacter(abX == false);
		}
		
		////////////////////
		// Attach/detach
		if (abX)
		{
			Entity_AlignSocketWithParentRotation(mBaseObj.GetName(), "R_Hand");
			pShotgun.AttachToSocket(mBaseObj, "R_Hand", true, true, true);	
		}
		else
		{
			pShotgun.RemoveEntityAttachment();
		}
	}
	
	//------------------------------------------------------------
	
	bool GetShouldShootAtPoint(const cVector3f& in avPos)
	{
		//////////////////
		// Check LoS
		array<cVector3f> vPointsToCheck;
		vPointsToCheck.push_back(avPos);
		
		cVector3f vToPoint = cMath_Vector3Normalize(avPos - mBaseObj.GetPosition());
		cVector3f vRight = cMath_Vector3Cross(vToPoint, cVector3f_Down);
		
		cVector3f vPointA = avPos + vRight * 0.75f;
		cVector3f vPointB = avPos + vRight * -0.75f;
		
		if (cLux_CheckLineOfSight(avPos, vPointA, false, false))
			vPointsToCheck.push_back(vPointA);
		if (cLux_CheckLineOfSight(avPos, vPointB, false, false))
			vPointsToCheck.push_back(vPointB);
			
		for (int i = 0; i < vPointsToCheck.size(); ++i)
		{			
			if (mBaseObj.GetPointIsInLineOfSight(vPointsToCheck[i]))
			{
				return true;
			}
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	float GetPathDistanceToPos(const cVector3f &in avFrom, const cVector3f &in avTo, bool abGetGroundPos = false)
	{
		cVector3f[] vPositions = {avFrom, avTo};
		
		if (abGetGroundPos)
		{
			float fDist;
			cVector3f vNrm;
			for (int i = 0; i < 2; ++i)
			{
				if (cLux_GetClosestBody(vPositions[i], cVector3f_Down, 2.f, fDist, vNrm) !is null)
					vPositions[i] = vPositions[i] + cVector3f_Down * (fDist - 0.1f);
			}
		}
		
		if (mpPathfinder.BuildPathNodeArrayFromTo(vPositions[0], vPositions[1]))
			return mpPathfinder.GetPathNodeArrayFullLength();
		
		return -1.f;
	}
	
	//------------------------------------------------------------
	
	bool GetShouldIgnoreSound()
	{	
		/////////////////
		// About to be stunned?
		if (mpStateMachine.GetNextState() == eShotgunnerState_Stunned)
			return true;
		
		/////////////////
		// Setup vars		
		bool bCausedBySelf = false;
		
		cVector3f vSoundPos = mpStateMachine.GetCurrentMessageData().mvX;
		tID idSoundSourceBody = mpStateMachine.GetCurrentMessageData().mID;	
		bool bCausedByPlayer = mpStateMachine.GetCurrentMessageData().msY == "Player";
		bool bIsPhysicsSound = mpStateMachine.GetCurrentMessageData().mlY == 1;
		
		iPhysicsBody@ pSourceBody = cLux_ID_Body(idSoundSourceBody);
		cLuxProp@ pSourceProp = cLux_ToProp(cLux_GetBodyEntity(pSourceBody));
		
		/////////////////
		// Ignore physics sounds?		
		if (bCausedByPlayer == false && 
			bIsPhysicsSound && 
			mBaseObj.Timer_Exists("Timer_IgnorePhysicsSounds"))
		{
			return true;
		}
		
		/////////////////
		// Physics sound close to agent, not caused by the player?
		float fDistSqr = (mBaseObj.GetPosition() - vSoundPos).SqrLength();
			
		if (bIsPhysicsSound && 
			fDistSqr < 4.f * 4.f && 
			pSourceBody !is null &&
			bCausedByPlayer == false)
		{
			bCausedBySelf = true;
		}
		
		/////////////////
		// Check if caused by any of the tracked collide props
		else
		{
			for (int i = 0; i < mvCollideProps.size(); ++i)
			{
				/////////////////
				// Does prop contain sound source body?
				cLuxProp@ pProp = cLux_ID_Prop(mvCollideProps[i].m_idProp);
				if (pProp !is null && pProp is pSourceProp) 
				{
					bCausedBySelf = true;
					break;
				}
					
				/////////////////
				// Caused by the prop being broken?
				if (pSourceProp !is null)
				{
					if (pSourceProp.GetName() == mvCollideProps[i].msPropName + "_broken")
					{
						bCausedBySelf = true;
						break;
					}
				}
					
				/////////////////
				// Sound close to prop?
				float fDistToPropSqr = (mvCollideProps[i].mvLastPropPos - vSoundPos).SqrLength();
				if (fDistToPropSqr < 2.f * 2.f)
				{
					bCausedBySelf = true;
					break;
				}
			}
		}
		
		/////////////////
		// Caused by self, ignore!
		if (bCausedBySelf)
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Ignore sound made by knocking over stuff", false, true);
			return true;
		}
		
		/////////////////
		// Don't ignore!
		return false;
	}

	//------------------------------------------------------------
	
	bool GetSensesActive(bool abCheckIfPlayerSubmerged = true)
	{
		if (abCheckIfPlayerSubmerged && mbPlayerSubmerged) return false;
		return mBaseObj.GetSensesActive();
	}
	
	//------------------------------------------------------------
	
	void SetPreBlockedState(int alState)
	{
		if (alState != eShotgunnerState_Blocked &&
			alState != eShotgunnerState_EvaluateObstacle)
		{
			mlBlocked_PrevState = alState;
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f GetPredictedPlayerPosInTime(float afTime)
	{
		return cLux_GetPlayer().GetCharacterBody().GetPosition() + GetAveragePlayerVelocity() * afTime;
	}
	
	//------------------------------------------------------------
	
	cVector3f GetAveragePlayerVelocity()
	{
		cVector3f vAvgVelocity = cVector3f(0.f);		
		
		for (int i = 0; i < mvPlayerPrediction_VelocityBuffer.size(); ++i)
			vAvgVelocity += mvPlayerPrediction_VelocityBuffer[i];
			
		vAvgVelocity /= mvPlayerPrediction_VelocityBuffer.size();		
		return vAvgVelocity;
	}
	
	//------------------------------------------------------------
	
	void DoLightFlash(const cVector3f &in avPos, const cVector3f &in avDir, float afDelay)
	{		
		tString sTimer = "Timer_DoLightFlash";
		if (mBaseObj.Timer_Exists(sTimer)) return;
		
		mvLightFlash_Pos = avPos;
		mvLightFlash_Dir = avDir;
		mBaseObj.Timer_Add(sTimer, afDelay, "OnTimer_DoLightFlash", false, false);
	}
	
	//------------------------------------------------------------
	
	void OnTimer_DoLightFlash(uint64 alId)
	{
		iLight@ pLight = cLux_ID_Light(m_idLightFlash);
		iLight@ pMapLight = cLux_ID_Light(m_idShoot_MapLightFlash);
		iPhysicsBody@ pMuzzleBody = cLux_ID_Body(m_idShotgunMuzzleBody);
		
		if (pLight is null) return;
		if (pMuzzleBody is null) return;
		
		///////////////////
		// Spot
		cVector3f vFwd = cMath_Vector3Normalize(mvLightFlash_Dir * -1.f);
		cVector3f vRight = cMath_Vector3Normalize(cMath_Vector3Cross(vFwd, cVector3f_Down));
		cVector3f vUp = cVector3f_Up;
		cVector3f vPos = pMuzzleBody.GetWorldPosition() - mvLightFlash_Dir * 2.f;		
		cMatrixf mtxNew = cMath_MatrixUnitVectors(vRight, vUp, vFwd, vPos);			
		pLight.SetWorldMatrix(mtxNew);
		
		pLight.FadeBrightnessToDefault(gfShotgunner_LightFlashFadeInTime);
		
		if (pMapLight !is null)
			pMapLight.FadeBrightnessTo(pLight.GetDefaultBrightness(), gfShotgunner_LightFlashFadeInTime);
		
		float fTotalTime = gfShotgunner_LightFlashFadeInTime + gfShotgunner_LightFlashStayTime;
		mBaseObj.Timer_Add("Timer_FadeOutLightFlash", fTotalTime, "OnTimer_FadeOutLightFlash");
		
		///////////////////
		// Point
		LightFlash_Add(gfShotgunner_LightFlashStayTime, gfShotgunner_LightFlashFadeInTime, gfShotgunner_LightFlashFadeOutTime, 
					   mBaseObj.GetPosition(), pLight.GetDiffuseColor(), 2.f, pLight.GetDefaultBrightness());
	}
	
	//------------------------------------------------------------
	
	void OnTimer_FadeOutLightFlash(uint64 alId)
	{
		iLight@ pLight = cLux_ID_Light(m_idLightFlash);
		iLight@ pMapLight = cLux_ID_Light(m_idShoot_MapLightFlash);
		
		if (pLight !is null)
			pLight.FadeBrightnessTo(0.f, gfShotgunner_LightFlashFadeOutTime);
		if (pMapLight !is null)
			pMapLight.FadeBrightnessTo(0.f, gfShotgunner_LightFlashFadeOutTime);
			
		m_idShoot_MapLightFlash = tID_Invalid;
	}
	
	//------------------------------------------------------------
	
	void SetSpeedState(int alState)
	{
		mlCurrentSpeedState = alState;
		mpMover.SetSpeedState(eShotgunnerSpeed(mlCurrentSpeedState));
	}
	
	//------------------------------------------------------------
	
	void DetectPlayer()
	{
		mBaseObj.ResetPlayerDetectionState();
		mBaseObj.RevealPlayerPos();
	}
	
	//------------------------------------------------------------
	
	bool ReloadShotgun(bool abForcePump)
	{
		bool bRet = false;
		float fTimeLeft = mBaseObj.Timer_GetTimeLeft("Timer_PlayedReloadSound");
		
		cLuxProp@ pShotgun = cLux_ID_Prop(m_idShotgunEnt);
		
		if (fTimeLeft <= 0.f || (abForcePump && fTimeLeft <= 10.f))
		{		
			bRet = true;
			msAnimState = "Reload";
			
			int lAnimId = cMath_RandRectl(0, gsShotgunnerAnim_PumpShotgun.length() - 1);
			tString sAnim = gsShotgunnerAnim_PumpShotgun[lAnimId];
			tString sShotgunAnim = gsShotgunnerAnim_ShotgunAnimPump[lAnimId];
			
			mpMover.PlayAnimation(sAnim, 0.3f, false);
			if (pShotgun !is null)
				pShotgun.PlayAnimation(sShotgunAnim, 0.3f, false);
		}
		else if (fTimeLeft <= 5.f)
		{
			bRet = true;
			msAnimState = "AddBullet";
			
			int lAnimId = cMath_RandRectl(0, gsShotgunnerAnim_ReloadShotgun.length() - 1);
			tString sAnim = gsShotgunnerAnim_ReloadShotgun[lAnimId];
			tString sShotgunAnim = gsShotgunnerAnim_ShotgunAnimReload[lAnimId];
			
			mpMover.PlayAnimation(sAnim, 0.3f, false);
			
			if (pShotgun !is null)
			{
				pShotgun.PlayAnimation(sShotgunAnim, 0.3f, false);
				
				SetShotgunBulletsVisible(false);
				mBaseObj.Timer_Add("Timer_SetShotgunBulletsVisible", 0.6f, "OnTimer_SetShotgunBulletsVisible");
			}
		}
		
		mBaseObj.Timer_Remove("Timer_PlayedReloadSound");
		mBaseObj.Timer_Add("Timer_PlayedReloadSound", 15.f);
		
		return bRet;
	}
	
	//------------------------------------------------------------
	
	void OnTimer_SetShotgunBulletsVisible(uint64 alId)
	{
		SetShotgunBulletsVisible(true);
	}
	
	//------------------------------------------------------------
	
	void ShuffleRouteBlockers()
	{
		//////////////////
		// Randomly activate route blockers, to make the path unpredictable
		for (int i = 0; i < mvRouteBlockerSets.size(); ++i)
		{
			cShotgunner_RouteBlockerSet@ pSet = mvRouteBlockerSets[i];
			tID idActiveBlocker = cMath_RandRectl(0, 1) == 1 ? pSet.m_idBlockerA : pSet.m_idBlockerB;
			SetRouteBlockerActive(idActiveBlocker, true);
		}
	}
	
	//------------------------------------------------------------
	
	void SetRouteBlockerActive(tID a_idBlocker, bool abActive)
	{
		//////////////////
		// Activate/deactivate route blockers
		// (One blocker of each set is always active)
		for (int i = 0; i < mvRouteBlockerSets.size(); ++i)
		{
			cShotgunner_RouteBlockerSet@ pSet = mvRouteBlockerSets[i];
			tID[] vIds = { pSet.m_idBlockerA, pSet.m_idBlockerB };
			int lBlockerId = -1;
			
			for (int j = 0; j < 2; ++j)
			{			
				if (vIds[j] == a_idBlocker)
				{
					lBlockerId = j;
					break;
				}
			}
			
			if (lBlockerId != -1)
			{				
				iLuxEntity@ pEntA = cLux_ID_Entity(vIds[lBlockerId]);
				iLuxEntity@ pEntB = cLux_ID_Entity(vIds[(lBlockerId + 1) % 2]);
				tID idBodyA = pEntA !is null ? pEntA.GetMainBody().GetID() : tID_Invalid;
				tID idBodyB = pEntB !is null ? pEntB.GetMainBody().GetID() : tID_Invalid;
				
				pEntA.SetActive(abActive);
				pEntB.SetActive(abActive == false);
				pEntA.GetMeshEntity().SetVisible(false);
				pEntB.GetMeshEntity().SetVisible(false);
								
				EvaluateObstacle_AddPathBlocker(abActive ? idBodyA : idBodyB);
				EvaluateObstacle_RemovePathBlocker(abActive ? idBodyB : idBodyA);
				break;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void DeactivateAllRouteBlockers()
	{
		for (int i = 0; i < mvRouteBlockerSets.size(); ++i)
		{
			cShotgunner_RouteBlockerSet@ pSet = mvRouteBlockerSets[i];
			tID[] vIds = { pSet.m_idBlockerA, pSet.m_idBlockerB };
			
			for (int j = 0; j < 2; ++j)
			{			
				iLuxEntity@ pEnt = cLux_ID_Entity(vIds[j]);
				iPhysicsBody@ pBody = pEnt !is null ? pEnt.GetMainBody() : null;
				
				if (pEnt is null) continue;
				if (pBody is null) continue;
				
				pEnt.SetActive(false);
				EvaluateObstacle_RemovePathBlocker(pBody.GetID());
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool GetIsTemporarilyLeavingState()
	{
		int lNextState = mpStateMachine.GetNextState();
		return lNextState == eShotgunnerState_Blocked || 
			   lNextState == eShotgunnerState_EvaluateObstacle ||
			   (lNextState == eShotgunnerState_Shoot && mbShoot_RandomShot);
	}
	
