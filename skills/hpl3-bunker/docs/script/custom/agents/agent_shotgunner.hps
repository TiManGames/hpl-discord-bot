	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: DEFAULT
	//{////////////////////////////////
	
	//------------------------------------------------------------

	void State_Default_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Default ------");
	}
	
	//------------------------------------------------------------
	
	void State_Default_Leave()
	{
		msAnimState = "";
	}
	
	//------------------------------------------------------------
	
	void State_Default_Update(float afTimeStep) {}

	//------------------------------------------------------------

	bool State_Default_Message(int alMessageId)
	{
		int lState = mpStateMachine.GetCurrentState();
		int lProximityState = mpStateMachine.GetCurrentMessageData().mlX;
		
		//////////////////////
		// Player detected
		if (alMessageId == eLuxEntityMessage_PlayerDetected)
		{
			if (mbRetreat_Active) return true;
			if (GetSensesActive() == false) return true;
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Player detected");			
			
			Terror_AddEnemy(mBaseObj.GetID(), gfShotgunner_DetectPlayerTime * 0.5f);
			
			mbShoot_ShootPlayer = true;
			mpStateMachine.ChangeState(eShotgunnerState_Shoot);
			return false;
		}

		/////////////////////
		// Stuck counter high
		else if (alMessageId == eCustomEntityMessage_StuckCounterHigh)
		{
			mpStateMachine.ChangeState(eShotgunnerState_Blocked);
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Stuck counter high!");
			return true;
		}

		/////////////////////
		// Heard sound
		else if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbRetreat_Active) return true;
			if (GetSensesActive() == false) return true;
			if (GetShouldIgnoreSound()) return true;
			
			/////////////////////
			// Ignore sounds if player detected
			if (mBaseObj.PlayerIsDetected())
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Ignoring sound because player is detected");
				return false;
			}
			
			cVector3f vGoal = mpStateMachine.GetCurrentMessageData().mvX;
			int lPrio = mpStateMachine.GetCurrentMessageData().mlX;
			tString sSoundName = mpStateMachine.GetCurrentMessageData().msX;
			bool bCausedByPlayer = mpStateMachine.GetCurrentMessageData().msY == "Player";
			tID idSourceBody = mpStateMachine.GetCurrentMessageData().mID;
			
			InvestigateSound_RegisterSound(lPrio, vGoal, sSoundName, bCausedByPlayer, idSourceBody, true, false);
			return false;
		}

		/////////////////////
		// Leave proximity
		else if (alMessageId == eLuxEntityMessage_LeaveProximity)
		{
			if (GetSensesActive() == false) return true;
			
			int lProxState = mpStateMachine.GetCurrentMessageData().mlX;			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Leave proximity " + ProximityStateToString(lProxState));
		}
		
		/////////////////////
		// Enter proximity
		else if (alMessageId == eLuxEntityMessage_EnterProximity)
		{
			if (mbRetreat_Active) return true;
			if (GetSensesActive(false) == false) return true;
			
			int lCurrentState = mpStateMachine.GetCurrentState();
			int lProxState = mpStateMachine.GetCurrentMessageData().mlX;			
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Enter proximity " + ProximityStateToString(lProxState));
			
			//////////////////////
			// Touching
			if (lProxState == eShotgunnerProximity_Touching)
			{
				DetectPlayer();
			}
			
			//////////////////////
			// Close / medium
			else if (lProxState == eShotgunnerProximity_Close ||
					 lProxState == eShotgunnerProximity_Medium)
			{
				if (mBaseObj.GetPointIsInFront(mBaseObj.GetPlayerPos()))
				{
					mvDetectPlayer_PlayerPos = mBaseObj.GetPlayerPos();
					mpStateMachine.ChangeState(eShotgunnerState_DetectPlayer);
				}
				else
				{
					mpProximitySensor.ResetState(lProxState);
				}
			}
			
			//////////////////////
			// Far
			else if (lProxState == eShotgunnerProximity_Far)
			{
				
			}
		}
		
		/////////////////////
		// Hit by prop
		else if (alMessageId == eLuxEntityMessage_HitByProp)
		{
			if (mbRetreat_Active) return true;
			if (GetSensesActive() == false) return true;		
			if (mbLastHitByPropThrownByPlayer == false) return false;
			
			if (mbLastHitByPropWasMolotov) 
			{
				mbLastHitByPropWasMolotov = false;
				return false;
			}
			
			float fHitSpeed = mpStateMachine.GetCurrentMessageData().mvX.x;
			if (fHitSpeed < 0.75f) return false;	

			mpStateMachine.ChangeState(eShotgunnerState_Stunned);
			
			mbLastHitByPropThrownByPlayer = false;
		}
		
		/////////////////////
		// Water hiding
		else if (alMessageId == eCustomEntityMessage_PlayerSubmerged)
		{
			mbPlayerSubmerged = true;
		}
		else if (alMessageId == eCustomEntityMessage_PlayerEmerged)
		{
			mbPlayerSubmerged = false;
			mBaseObj.ResetPlayerDetectionState();
		}
		
		///////////////////
		// Player fired gun
		else if (alMessageId == eCustomEntityMessage_PlayerShotGun)
		{
			if (GetSensesActive() == false) return true;
			
			/////////////////////
			// Investigate sound!
			mBaseObj.GetMap().BroadcastSoundHeardEvent("Gunshot", mBaseObj.GetPlayerHeadPos(), 500.f, 6, false, true);
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Heard gunshot");
		}
		
		/////////////////////
		// Grenade/molotov impact
		else if (alMessageId == eCustomEntityMessage_Explosion ||
				 alMessageId == eCustomEntityMessage_GrenadeImpact ||
				 alMessageId == eCustomEntityMessage_MolotovImpact)
		{			
			if (mbRetreat_Active) return true;
			
			/////////////////////
			// Distance check
			cVector3f vImpactPos = mpStateMachine.GetCurrentMessageData().mvX;
			float fDist = mBaseObj.GetDistanceToPos(vImpactPos);			
			
			float fMinDist = gfShotgunner_GrenadeRetreatMinDist;
			if (alMessageId == eCustomEntityMessage_MolotovImpact)
				fMinDist = gfShotgunner_MolotovRetreatMinDist;				
			
			if (fDist >= fMinDist) return true;
			
			int lReactivity = GameDifficulty_GetSettingValueByID_Int(eGameDifficultySetting_ShotgunnerReactivity);
			if (lReactivity < eDifficultySettingValue_ShotgunnerReactivity_Default &&
				alMessageId == eCustomEntityMessage_GrenadeImpact)
			{
				return true;
			}
			
			/////////////////////
			// Retreat			
			if (cScript_GetGlobalVarBool("Tunnels_ShotgunnerEncounterStarted") == false)
			{
				mBaseObj.SetSensesActive(true);
				mBaseObj.Timer_Add("Timer_ReduceGrenadeDamage", 5.f);
			}
			
			mpStateMachine.ChangeState(eShotgunnerState_Retreat);			
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Grenade/molotov impact nearby, retreat!");
		}
		
		return false;
	}
	
	//------------------------------------------------------------

	//} END DEFAULT

	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: IDLE
	//{////////////////////////////////
	
	//-----------------------------------------------------------
	
	bool mbIdle_Wait = false;
	bool mbIdle_QueueShoot = false;
	cVector3f mvIdle_QueueShootPos = cVector3f(0.f);
	tID m_idIdle_QueueShootTarget = tID_Invalid;
	
	//-----------------------------------------------------------
	
	void State_Idle_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Idle ------");
		
		mpPathfinder.Stop();		
		mpBarkMachine.ChangeState(mlPoemBarkState);		
		mAlertState = eShotgunnerAlertState_None;
		
		if (mbIdle_Wait == false)
		{
			mpStateMachine.AddTimer("Patrol", cMath_RandRectf(2.f, 4.f));
		}
		
		if (mbIdle_QueueShoot)
		{
			mpStateMachine.AddTimer("Shoot", 0.f);
		}
		
		if (mbShoot_ResetWaitInIdleAfterShoot)
			mbIdle_Wait = false;
	}

	//------------------------------------------------------------

	void State_Idle_Leave()
	{
		mbIdle_QueueShoot = false;
		mvIdle_QueueShootPos = cVector3f(0.f);
		m_idIdle_QueueShootTarget = tID_Invalid;
	}
	
	//------------------------------------------------------------
	
	void State_Idle_Update(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------
	
	bool State_Idle_Message(int alMessageId)
	{
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_Idle_TimerUp(uint64 alId)
	{
		///////////////////
		// Patrol
		if (alId == H64("Patrol"))
		{
			if (mbIdle_Wait == false)
			{
				mpStateMachine.ChangeState(eShotgunnerState_Patrol);
			}
		}
		
		///////////////////
		// Shoot
		else if (alId == H64("Shoot"))
		{
			m_idShoot_Target = m_idIdle_QueueShootTarget;
			mbShoot_ResetWaitInIdleAfterShoot = true;
			mpStateMachine.ChangeState(eShotgunnerState_Shoot);
		}
	}
    
	//------------------------------------------------------------

	//} END STATE: IDLE
	
	///////////////////////////////////
	// STATE: PATROL
	//{////////////////////////////////
	
	//-----------------------------------------------------------
	
	array<tString> mvPatrol_Nodes;
	int mlPatrol_BlockedTrackNodeCount = 0;
	bool mbPatrol_Resume = false;
	
	//-----------------------------------------------------------
	
	void State_Patrol_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Patrol ------");
		
		//////////////////////
		// Setup state
		SetSpeedState(eShotgunnerSpeed_Walk);
		mpBarkMachine.ChangeState(mlPoemBarkState);
		mAlertState = eShotgunnerAlertState_None;
		
		//////////////////////
		// Setup track
		if (mpPathfinder.GetTrackNodeNum() == 0)
		{
			for (int i = 0; i < mvPatrol_Nodes.size(); ++i)
			{
				tString sWaitAnim = "";
					
				float fMinWaitTime = 2.f;
				float fMaxWaitTime = 4.f;
					
				if (cMath_RandRectl(0, 2) == 0)
				{
					fMinWaitTime = 0;
					fMaxWaitTime = 0;
				}
					
				mpPathfinder.AddTrackNode(mvPatrol_Nodes[i], fMinWaitTime, fMaxWaitTime, sWaitAnim, true);
			}
		}
		
		//////////////////////
		// Start track?
		if (mpPathfinder.GetTrackActive() == false)
		{
			mpPathfinder.StartTrack(true, 1.f, "", true);
		}
		
		//////////////////////
		// Resume track?
		else if (mpPathfinder.GetTrackPaused())
		{
			mpPathfinder.SetTrackPaused(false);
			
			if (mbPatrol_Resume == false)
			{
				ShuffleRouteBlockers();
				mpPathfinder.GoToNextTrackNode();
			}
		}
		
		mbPatrol_Resume = false;
	}

	//------------------------------------------------------------

	void State_Patrol_Leave()
	{
		mpPathfinder.SetTrackPaused(true);
		
		///////////////////
		// Probably returning to this state?
		if (GetIsTemporarilyLeavingState())
		{
			mbPatrol_Resume = true;
		}
	}
	
	//------------------------------------------------------------
	
	void State_Patrol_Update(float afTimeStep)
	{
		UpdateRandomShot(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	bool State_Patrol_Message(int alMessageId)
	{
		//////////////////////
		// End of path
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			ShuffleRouteBlockers();
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_Patrol_TimerUp(uint64 alId)
	{
	}
    
	//------------------------------------------------------------

	//} END STATE: PATROL
	
	//------------------------------------------------------------

	///////////////////////////////////
	// STATE: INVESTIGATE SOUND
	//{////////////////////////////////

	//------------------------------------------------------------
	
	bool mbInvestigateSound_Resume = false;
	bool mbInvestigateSound_CausedByPlayer = false;
	bool mbInvestigateSound_ReachedEnd = false;
	bool mbInvestigateSound_OnEnterForceReload = false;
	bool mbInvestigateSound_PlayedSoundHeardBark = false;
	int mlInvestigateSound_Prio = -1;
	int mlInvestigateSound_TimeStamp = 0;
	cVector3f mvInvestigateSound_Goal = 0.f;
	tString msInvestigateSound_SoundName = "";
	tID m_idInvestigateSound_SoundSourceBodyId = tID_Invalid;
	array<tID> mvInvestigateSound_SoundSourceBodyIdsToIgnore;

	//------------------------------------------------------------

	void State_InvestigateSound_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: InvestigateSound ------",false,true);
		
		//////////////////////
		// Setup state		
		SetSpeedState(eShotgunnerSpeed_Walk);		
		
		//////////////////////
		// Setup behaviour
		if (mbInvestigateSound_Resume)
		{
			mpBarkMachine.ChangeState(mlPoemBarkState);
			mpStateMachine.AddTimer("GoToSource", 0.f);
		}
		else
		{
			// Shuffle route blockers to make path unpredictable
			ShuffleRouteBlockers();
			
			mbInvestigateSound_OnEnterForceReload = mlInvestigateSound_Prio >= 4 || mbInvestigateSound_CausedByPlayer;
						
			mpPathfinder.Stop();
			
			bool bStopVoice = Voice_SubjectIsPlaying(gsShotgunner_PoemDefaultVoiceSubject);
			mpBarkMachine.ChangeState(eShotgunnerBark_Silent, bStopVoice);
			
			//////////////////////
			// Anim + sound if not super close
			float fDist = (mvInvestigateSound_Goal - mBaseObj.GetPosition()).Length();
			if (fDist >= gfShotgunner_PlayListenAnimMinDistToSound)
			{
				msAnimState = "ListenShort";
				mpMover.PlayAnimation(gsShotgunnerAnim_ListenShort, 0.3f, false);
				
				//////////////////////
				// Play voice
				bool bPlayHeardPlayerBark = mbInvestigateSound_CausedByPlayer || 
											msInvestigateSound_SoundName == "ScriptedEvent";
											
				if (bPlayHeardPlayerBark &&
					mbInvestigateSound_PlayedSoundHeardBark == false)
				{
					mbInvestigateSound_PlayedSoundHeardBark = true;
					
					float fTime = mBaseObj.GetDistanceToPlayer() < 12.f ? 1.f : 0.f;
					mpStateMachine.AddTimer("Bark", fTime);
				}
			}
			
			//////////////////////
			// Take action
			else
			{
				mpStateMachine.AddTimer("TakeAction", 0.f);
			}
		}		
	}
	
	//------------------------------------------------------------

	void State_InvestigateSound_Leave()
	{		
		///////////////////
		// Probably returning to this state?
		if (GetIsTemporarilyLeavingState())
		{
			mbInvestigateSound_Resume = true;
		}
		
		///////////////////
		// Reset if leaving state and not coming back!
		else
		{
			mbInvestigateSound_Resume = false;
			mbInvestigateSound_CausedByPlayer = false;
			mbInvestigateSound_ReachedEnd = false;
			mbInvestigateSound_OnEnterForceReload = false;;
			mlInvestigateSound_Prio = -1;
			msInvestigateSound_SoundName = "";
			m_idInvestigateSound_SoundSourceBodyId = tID_Invalid;
		}			
	}
	
	//------------------------------------------------------------

	void State_InvestigateSound_Update(float afTimeStep)
	{					
		if (mbInvestigateSound_ReachedEnd == false)
		{
			UpdateRandomShot(afTimeStep);
		}
	}
	
	//------------------------------------------------------------

	bool State_InvestigateSound_Message(int alMessageId)
	{				
		//////////////////////
		// Animation over
		if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			/////////////////
			// Listen short
			if (msAnimState == "ListenShort")
			{
				mpStateMachine.AddTimer("TakeAction", 0.f);
			}
			
			/////////////////
			// Reload
			else if (msAnimState == "Reload")
			{
				InvestigateSound_GoToSource(false);
			}
			
			/////////////////
			// Add bullet
			else if (msAnimState == "AddBullet")
			{
				InvestigateSound_GoToSource(false);
			}
			
			/////////////////
			// Look around end
			else if (msAnimState == "LookAroundEnd")
			{
				mpStateMachine.AddTimer("Exit", 0.2f);
			}
			
			msAnimState = "";
			return true;
		}
		
		//////////////////////
		// End of path
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Reached end, look around");
			
			mbInvestigateSound_ReachedEnd = true;
			
			mpPathfinder.Stop();
			mpStateMachine.StopTimer("GoToSource");
			mpStateMachine.AddTimer("LookAroundEnd", 0.f);
			
			////////////////////
			// Ignore flare if found!
			if (msInvestigateSound_SoundName == "Flare" && m_idInvestigateSound_SoundSourceBodyId != tID_Invalid)
			{
				if (mvInvestigateSound_SoundSourceBodyIdsToIgnore.find(m_idInvestigateSound_SoundSourceBodyId) == -1)
					mvInvestigateSound_SoundSourceBodyIdsToIgnore.push_back(m_idInvestigateSound_SoundSourceBodyId);
			}
			
			return true;
		}

		//////////////////////
		// Sound heard
		if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (GetSensesActive() == false) return true;
			if (GetShouldIgnoreSound()) return true;
			if (mpStateMachine.TimerExists("Shoot")) return true;
			
			int lPrevPrio = mlInvestigateSound_Prio;
			int lPrio = mpStateMachine.GetCurrentMessageData().mlX;
			cVector3f vPos = mpStateMachine.GetCurrentMessageData().mvX;
			tString sSoundName = mpStateMachine.GetCurrentMessageData().msX;
			tID idSourceBody = mpStateMachine.GetCurrentMessageData().mID;
			bool bCausedByPlayer = mpStateMachine.GetCurrentMessageData().msY == "Player";
			float fTimeSinceLastSound = mBaseObj.GetMap().GetElapsedTime(mlInvestigateSound_TimeStamp);
			
			//////////////////////
			// Is new sound more important?
			if (InvestigateSound_RegisterSound(lPrio, vPos, sSoundName, bCausedByPlayer, idSourceBody, false, true)) 
			{
				if (mpStateMachine.TimerExists("TakeAction")) return true;
				if (msAnimState == "ListenShort") return true;
				
				msAnimState = "";
				
				mpStateMachine.StopTimer("GoToSource");
				mpStateMachine.StopTimer("TakeAction");
				mpStateMachine.StopTimer("TurnToGoal");
				mpStateMachine.StopTimer("LookAroundEnd");
				mpStateMachine.StopTimer("Exit");
				
				bool bStop = fTimeSinceLastSound >= 5.f || lPrio > lPrevPrio;
				if (bStop)
				{
					mpPathfinder.Stop();					
					mpStateMachine.AddTimer("TakeAction", cMath_RandRectf(1.f, 1.5f));
				}		
				else
				{
					mpStateMachine.AddTimer("TakeAction", cMath_RandRectf(0.2f, 0.3f));
				}
				
				bool bStopVoice = Voice_SubjectIsPlaying(gsShotgunner_PoemDefaultVoiceSubject);
				mpBarkMachine.ChangeState(eShotgunnerBark_Silent, bStopVoice);
			}

			return true;
		}

		return false;
	}
	
	//------------------------------------------------------------

	void State_InvestigateSound_TimerUp(uint64 alId)
	{
		///////////////////////
		// Take action
		if (alId == H64("TakeAction"))
		{			
			if (Voice_SubjectIsPlaying(gsShotgunner_SoundHeardVoiceSubject) && 
				mBaseObj.PlayerIsDetected() == false &&
				GetShouldShootAtPoint(mvInvestigateSound_Goal) == false)
			{
				mpStateMachine.AddTimer("TakeAction", 0.1f);
				return;
			}
			
			InvestigateSound_TakeAction();
		}
		
		///////////////////////
		// Go to source
		else if (alId == H64("GoToSource"))
		{					
			//////////////////
			// Get pos near sound
			bool bFoundPos = false;
			
			cVector3f vSoundDir = cMath_Vector3Normalize(mvInvestigateSound_Goal - mBaseObj.GetPosition());
			cVector3f vPos = mvInvestigateSound_Goal - vSoundDir * 2.f;
			cAINode@ pNode = mpPathfinder.GetNodeInPosLOS(vPos, mvInvestigateSound_Goal, 0.f, 4.f);
			
			if (pNode !is null)
			{
				bFoundPos = true;
				mpPathfinder.MoveTo(pNode.GetPosition(), 1.f, false);
			}
			else if (mlInvestigateSound_Prio >= 6)
			{
				@pNode = mpPathfinder.GetNodeAtPos(mvInvestigateSound_Goal, 0.f, 5.f, true, false, false, null);
				
				if (pNode !is null)
				{
					bFoundPos = true;
					mpPathfinder.MoveTo(pNode.GetPosition(), 1.f, false);
				}					
			}
			
			//////////////////
			// No pos found
			if (bFoundPos == false)
			{
				mpStateMachine.ChangeState(eShotgunnerState_Idle);
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Did not find path to source");
			}
		}
		
		///////////////////////
		// Turn to goal
		else if (alId == H64("TurnToGoal"))
		{
			mpMover.TurnToPos(mvInvestigateSound_Goal);
		}
				
		///////////////////////
		// Look around end
		else if (alId == H64("LookAroundEnd"))
		{
			cAnimationState@ pAnim = mBaseObj.GetCurrentAnimationState();
			if (pAnim !is null && pAnim.GetName() == gsShotgunnerAnim_ListenLong)
				return;
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Look around");
			
			mpPathfinder.Stop();
			msAnimState = "LookAroundEnd";
			
			mpMover.PlayAnimation(gsShotgunnerAnim_ListenLong, 0.3f, false);
		}		
		
		///////////////////////
		// Shoot
		else if (alId == H64("Shoot"))
		{
			/////////////////
			// Shoot player?
			bool bShootPlayer = false;			
			if (cString_Sub(msInvestigateSound_SoundName, 0, 8) == "Footstep")
				bShootPlayer = true;
			if (cString_Sub(msInvestigateSound_SoundName, 0, 7) == "Gunshot")
				bShootPlayer = true;
			
			/////////////////
			// Enter shoot!
			mbShoot_InvestigateShootPos = mlInvestigateSound_Prio >= 2 || mbInvestigateSound_CausedByPlayer;
			mbShoot_ShootPlayer = bShootPlayer;
			mvShoot_Pos = mvInvestigateSound_Goal;
			mbShoot_Reload = mbShoot_ShootPlayer ? mBaseObj.GetDistanceToPlayer() > 6.f : true;
			mpStateMachine.ChangeState(eShotgunnerState_Shoot);
		}
		
		///////////////////////
		// Bark
		else if (alId == H64("Bark"))
		{
			mpBarkMachine.PlayVoice(gsShotgunner_SoundHeardVoiceSubject, 0, -1.f, -1.f, -1.f, 5);
		}
		
		///////////////////////
		// Exit
		else if (alId == H64("Exit"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Exit");
			mpStateMachine.ChangeState(eShotgunnerState_Idle);
		}
	}
	
	//------------------------------------------------------------
	
	bool InvestigateSound_RegisterSound(int alPrio, const cVector3f &in avPos, const tString &in asSoundName, 
										bool abCausedByPlayer, tID a_idSourceBody, bool abChangeState, bool abCheckOverride)
	{
		///////////////
		// Occluded?
		if (InvestigateSound_GetIsSoundOccluded(alPrio, mBaseObj.GetCharBody().GetPosition(), avPos))
			return false;
		
		///////////////
		// Is in ignore list?
		if (a_idSourceBody != tID_Invalid && mvInvestigateSound_SoundSourceBodyIdsToIgnore.find(a_idSourceBody) != -1)
			return false;
			
		///////////////
		// Is a grenade/gas grenade?
		iLuxEntity@ pEnt = cLux_GetBodyEntity(cLux_ID_Body(a_idSourceBody));
		if (pEnt !is null)
		{
			tString sClass = pEnt.GetClassName();
			if (sClass == "cScrPropGrenade") return false;
			if (sClass == "cScrPropGasGrenade") return false;
		}
		
		///////////////
		// Only care about door sounds if made by player!
		bool bIsDoorSound = cString_GetFirstStringPos(asSoundName, "door") >= 0;
		if (bIsDoorSound && cLux_GetPlayer().GetCurrentStateId() != ePlayerState_SwingDoor)
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Ignored sound from door since the player isn't interacting with it!");
			return false;
		}
		
		///////////////
		// Only register if new sound is interesting enough
		bool bRegister = abCheckOverride == false;
		
		if (abCheckOverride)
		{
			if (alPrio > mlInvestigateSound_Prio)
			{
				bRegister = true;
			}
			
			if (alPrio >= glShotgunner_AlwaysInvestigateSoundPrio)
			{
				bRegister = true;
			}
			
			if (alPrio == mlInvestigateSound_Prio && 
				abCausedByPlayer && 
				mbInvestigateSound_CausedByPlayer == false)
			{
				bRegister = true;
			}
				
			if (abCausedByPlayer)
			{
				bRegister = true;
			}
		}
		
		///////////////
		// Register
		if (bRegister)
		{
			mlInvestigateSound_TimeStamp = mBaseObj.GetMap().GetTimeStamp();
			mbInvestigateSound_CausedByPlayer = abCausedByPlayer;
			mlInvestigateSound_Prio = alPrio;
			mvInvestigateSound_Goal = avPos;
			msInvestigateSound_SoundName = asSoundName;
			m_idInvestigateSound_SoundSourceBodyId = a_idSourceBody;
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Sound heard: (Prio: " + alPrio + ", Name: " +  mpStateMachine.GetCurrentMessageData().msX + ")");					
		}		
		
		///////////////
		// Investigate sound
		if (abChangeState)
		{
			mpStateMachine.ChangeState(eShotgunnerState_InvestigateSound);
		}
		
		///////////////
		// Return
		return bRegister;		
	}
	
	//------------------------------------------------------------
	
	void InvestigateSound_TakeAction()
	{
		/////////////////////
		// Can shoot?
		bool bShoot = GetShouldShootAtPoint(mvInvestigateSound_Goal);
		if (bShoot)
		{					
			bool bInPlayerLoS = mBaseObj.GetEntityIsInPlayerLineOfSight(true);
			float fTime = bInPlayerLoS ? cMath_RandRectf(0.f, 0.2f) : cMath_RandRectf(0.75f, 1.25f);
			mpStateMachine.AddTimer("Shoot", fTime);
			return;
		}
		
		/////////////////////
		// Reload shotgun		
		bool bPump = bShoot || 
					 mlInvestigateSound_Prio >= 4 || 
					 mbInvestigateSound_OnEnterForceReload;
		
		mbInvestigateSound_OnEnterForceReload = false;
		
		bool bReloading = ReloadShotgun(bPump);
				
		/////////////////////
		// Move to source?
		if (bShoot == false && bReloading == false)
		{				
			InvestigateSound_GoToSource(true);
		}
	}
	
	//------------------------------------------------------------
	
	void InvestigateSound_GoToSource(bool abDelay)
	{
		mAlertState = eShotgunnerAlertState_Investigating;
		
		mpBarkMachine.ChangeState(mlPoemBarkState);
		float fTime = abDelay ? cMath_RandRectf(0.5f, 0.9f) : 0.f;
		mpStateMachine.AddTimer("GoToSource", fTime);
	}
	
	//------------------------------------------------------------
	
	bool InvestigateSound_GetIsSoundOccluded(int alPrio, const cVector3f &in avListenerPos, const cVector3f &in avSoundPos)
	{
		if (alPrio <= glShotgunner_IgnoreOccludedSoundMaxPrio &&
			SoundOcclusion_GetIsPointOccluded(avListenerPos, avSoundPos))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Ignored sound with prio: " + alPrio + " since it's occluded!");
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------

	//} END INVESTIGATE SOUND
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: DETECT PLAYER
	//{////////////////////////////////
	
	//-----------------------------------------------------------
	
	cVector3f mvDetectPlayer_PlayerPos = cVector3f(0.f);
	
	//-----------------------------------------------------------
	
	void State_DetectPlayer_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: DetectPlayer ------");
		
		mpPathfinder.Stop();
		mpMover.StopTurning();
		mAlertState = eShotgunnerAlertState_Detected;
		
		bool bStopVoice = Voice_SubjectIsPlaying(gsShotgunner_PoemDefaultVoiceSubject);
		mpBarkMachine.ChangeState(eShotgunnerBark_Silent, bStopVoice);
		
		mpStateMachine.AddTimer("Reload", 0.f);
		
		Terror_AddEnemy(mBaseObj.GetID(), gfShotgunner_DetectPlayerTime);
	}

	//------------------------------------------------------------

	void State_DetectPlayer_Leave()
	{
		Terror_RemoveEnemy(mBaseObj.GetID());
	}
	
	//------------------------------------------------------------
	
	void State_DetectPlayer_Update(float afTimeStep)
	{
		if (Terror_GetAmount() >= 1.f)
		{
			DetectPlayer();
		}
	}
	
	//------------------------------------------------------------
	
	bool State_DetectPlayer_Message(int alMessageId)
	{
		//////////////////////
		// Animation over
		if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			if (msAnimState == "Reload" || msAnimState == "AddBullet")
			{
				mpStateMachine.AddTimer("Turn", cMath_RandRectf(0.1f, 0.3f));
				mpStateMachine.AddTimer("Exit", cMath_RandRectf(2.f, 3.f));
			}
			
			msAnimState = "";
		}
		
		//////////////////////
		// Sound heard
		else if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (GetSensesActive() == false) return true;
			if (GetShouldIgnoreSound()) return true;
			
			DetectPlayer();
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_DetectPlayer_TimerUp(uint64 alId)
	{
		//////////////////
		// Reload
		if (H64("Reload") == alId)
		{
			if (ReloadShotgun(true) == false)
			{
				mpStateMachine.AddTimer("Turn", cMath_RandRectf(0.1f, 0.3f));
				mpStateMachine.AddTimer("Exit", cMath_RandRectf(2.f, 3.f));
			}
		}
		
		//////////////////
		// Turn
		if (H64("Turn") == alId)
		{
			mpMover.TurnToPos(mvDetectPlayer_PlayerPos);
		}
		
		//////////////////
		// Exit
		if (H64("Exit") == alId)
		{
			mpStateMachine.ChangeState(eShotgunnerState_Patrol);
		}
	}
    
	//------------------------------------------------------------

	//} END STATE: DETECT PLAYER	
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: SHOOT
	//{////////////////////////////////
	
	//-----------------------------------------------------------
	
	bool mbShoot_Reload = false;
	bool mbShoot_Aiming = false;
	bool mbShoot_AdjustSpine = false;
	bool mbShoot_ShootPlayer = false;
	bool mbShoot_WaitInIdleAfterShoot = false;
	bool mbShoot_ResetWaitInIdleAfterShoot = true;
	bool mbShoot_ReturnToPreBlockedStateAfterShoot = false;
	bool mbShoot_BulletHitPlayer = false;
	bool mbShoot_RandomShot = false;
	bool mbShoot_InvestigateShootPos = false;
	bool mbShoot_InvestigateSound = false;
	bool mbShoot_ShootAnimPlayed = false;
	bool mbShoot_WasQuickTurning = false;
	bool mbShoot_ShouldTurn = false;
	float mfShoot_AimAngleLength = 1.f;
	int mlShoot_ShootCount = 0;
	int mlShoot_MaxShootCount = 1;
	cVector3f mvShoot_Pos = cVector3f(0.f);
	cVector3f mvShoot_PlayerPosOffset = cVector3f(0.f);
	tID m_idShoot_Target = tID_Invalid;
	tID m_idShoot_MapLightFlash = tID_Invalid;
	cQuaternion m_qShoot_AimRotAdd = cQuaternion_Identity;
	array<tID> mvShoot_IgnoreEntIds;
	
	//-----------------------------------------------------------
	
	void State_Shoot_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Shoot ------");
		
		///////////////////
		// No target?
		if (mbShoot_ShootPlayer == false && 
			mvShoot_Pos.SqrLength() <= 0.f &&
			m_idShoot_Target == tID_Invalid)
		{
			ResetResumeStates();
			mpStateMachine.ChangeState(eShotgunnerState_Idle);
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Nothing to shoot at!");
			return;
		}
		
		//////////////////
		// Setup state
		mbShoot_Aiming = false;		
		mbShoot_BulletHitPlayer = false;
		mbShoot_InvestigateSound = false;
		mbShoot_ShootAnimPlayed = false;
		mbShoot_WasQuickTurning = false;
		mbShoot_ShouldTurn = false;
		mlShoot_ShootCount = 0;
		mlShoot_MaxShootCount = cMath_RandRectl(2, 3);
		mfShoot_AimAngleLength = 1.f;
		mvShoot_PlayerPosOffset = cVector3f(0.f);
		m_qShoot_AimRotAdd = cQuaternion_Identity;
		
		mpPathfinder.Stop();
		mpMover.StopTurning();		
		
		SetSpeedState(eShotgunnerSpeed_Stopped);
		
		bool bStopVoice = Voice_SubjectIsPlaying(gsShotgunner_PoemDefaultVoiceSubject) && mbShoot_RandomShot == false;
		mpBarkMachine.ChangeState(eShotgunnerBark_Silent, bStopVoice);
		
		//////////////////
		// Aim	
		if (mbShoot_Reload)
		{
			mbShoot_Reload = false;
			mpStateMachine.AddTimer("Reload", 0.f);
		}
		else
		{
			mpStateMachine.AddTimer("Aim", 0.f);
		}
		
		if (mbShoot_ShootPlayer)
		{
			mAlertState = eShotgunnerAlertState_Detected;
			Terror_AddEnemy(mBaseObj.GetID(), 1.f);
		}
	}
	
	//------------------------------------------------------------

	void State_Shoot_Leave()
	{
		if (mbShoot_ResetWaitInIdleAfterShoot)
		{
			mbShoot_WaitInIdleAfterShoot = false;
		}
		
		mbShoot_RandomShot = false;
		mbShoot_ShootPlayer = false;
		mbShoot_AdjustSpine = false;
		mbShoot_ReturnToPreBlockedStateAfterShoot = false;
		mbShoot_InvestigateShootPos = false;
		mvShoot_Pos = cVector3f(0.f);
		m_idShoot_Target = tID_Invalid;
		
		mpMover.SetUseMoveStateAnimations(true);
		mpMover.StopTurning();
		
		Terror_RemoveEnemy(mBaseObj.GetID());
	}
	
	//------------------------------------------------------------
	
	void State_Shoot_Update(float afTimeStep)
	{
		////////////////////
		// Setup vars
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		iLuxEntity@ pTarget = cLux_ID_Entity(m_idShoot_Target);

		if (pCharBody is null) return;
		
		////////////////////
		// TOOD: This is a hotfix for getting stuck in this state. Figure out a proper fix!
		if (mbShoot_Aiming == false && 
			mbShoot_Reload == false &&
			mbPlayQuickTurnAnim == false &&
			msAnimState == "" &&
			mpStateMachine.TimerExists("Aim") == false &&
			mpStateMachine.TimerExists("Reload") == false &&
			mpStateMachine.TimerExists("Exit") == false)
		{
			mpStateMachine.AddTimer("Exit", 0.f);
		}
		
		////////////////////
		// Was quick turning? Go back to aiming!
		if (mbPlayQuickTurnAnim == false && mbShoot_WasQuickTurning)
		{
			mbShoot_WasQuickTurning = false;
			mpMover.SetUseMoveStateAnimations(false);
			mpStateMachine.AddTimer("Aim", 0.f);
		}
		
		if (mbPlayQuickTurnAnim)
			mbShoot_WasQuickTurning = true; 
		
		////////////////////
		// Aiming
		if (mbShoot_Aiming)
		{			
			////////////////////
			// Track player
			if (mbShoot_ShootPlayer)
			{
				float fDistToPlayer = mBaseObj.GetDistanceToPlayer2D();
				float fOffset = (1.f - cMath_Clamp(fDistToPlayer / 3.f, 0.f, 1.f)) * 0.6f;
				cVector3f vOffsetGoal = fDistToPlayer < 3.f ? cVector3f(0.f, -fOffset, 0.f) : cVector3f(0.f);			
				
				mvShoot_PlayerPosOffset = cMath_Vector3IncreaseTo(mvShoot_PlayerPosOffset, cVector3f(1.f) * afTimeStep, vOffsetGoal);
				mvShoot_Pos = cLux_GetPlayer().GetCamera().GetPosition() + mvShoot_PlayerPosOffset;
			}
			
			////////////////////
			// Track target
			else if (pTarget !is null)
			{
				cLuxAgent@ pAgent = cLux_ToAgent(pTarget);
				if (pAgent !is null)
				{
					mvShoot_Pos = pTarget.GetPosition() + cVector3f(0.f, 0.05f, 0.f);
				}
				else
				{
					mvShoot_Pos = pTarget.GetPosition();
				}
			}
			
			////////////////////
			// Update quick turn yaw
			if (mbPlayQuickTurnAnim)
			{			
				cVector3f vToTarget = cMath_Vector3Normalize(mvShoot_Pos - pCharBody.GetPosition());
				mfQuickTurnGoalYaw = cMath_GetAngleFromPoints3D(0.f, vToTarget).y;
			}
			
			////////////////////
			// Shoot!	
			if (Shoot_GetAimingDone() && 
				mbPlayQuickTurnAnim == false && 
				mbShoot_WasQuickTurning == false)
			{		
				////////////////
				// Anim
				if (mbShoot_ShootAnimPlayed == false)
				{
					mpMover.StopTurning();
					
					msAnimState = "Shoot";
					mbShoot_ShootAnimPlayed = true;
					
					cLuxProp@ pShotgun = cLux_ID_Prop(m_idShotgunEnt);
					
					int lAnimId = cMath_RandRectl(0, gsShotgunnerAnim_Shoot.length() - 1);
					tString sShootAnim = gsShotgunnerAnim_Shoot[lAnimId];
					tString sShotgunShootAnim = gsShotgunnerAnim_ShotgunAnimShoot[lAnimId];
					
					mpMover.PlayAnimation(sShootAnim, 0.3f, false);
					
					if (pShotgun !is null)
						pShotgun.PlayAnimation(sShotgunShootAnim, 0.3f, false);
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool State_Shoot_Message(int alMessageId)
	{	
		if (alMessageId == eCustomEntityMessage_PlayerShotGun) return false;
		if (alMessageId == eLuxEntityMessage_HitByProp) return false;
		
		////////////////////////
		// Animation over
		if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			///////////////////
			// Reload/add bullet
			if (msAnimState == "Reload" ||
				msAnimState == "AddBullet")
			{
				mpStateMachine.AddTimer("Aim", 0.f);
			}
			
			/////////////////
			// Shoot
			else if (msAnimState == "Shoot")
			{
				mbShoot_ShootAnimPlayed = false;
				
				/////////////////
				// Keep firing at player?
				if (mbShoot_ShootPlayer && 
					mlShoot_ShootCount < mlShoot_MaxShootCount &&
					GetShouldShootAtPoint(mBaseObj.GetPlayerHeadPos()))
				{
					mpStateMachine.AddTimer("Aim", 0.f);
				}
					
				/////////////////
				// Exit
				else
				{		
					msAnimState = "AimEnd";
					mpMover.PlayAnimation(gsShotgunnerAnim_AimEnd, 0.3f, false);
					
					// Note: 	For some reason this animation plays really slowly IF the shotgunner has been stunned before
					//			entering this state. No idea why, this is a hacky fix.
					cAnimationState@ pAnim = mBaseObj.GetMeshEntity().GetAnimationStateFromName(gsShotgunnerAnim_AimEnd);
					if (pAnim !is null)
						pAnim.SetSpeed(1.f);
					
					return true;
				}
			}
			
			/////////////////
			// Aim end
			else if (msAnimState == "AimEnd")
			{
				mpStateMachine.AddTimer("Exit", 0.f);
			}			
			
			msAnimState = "";
		}
		
		////////////////////////
		// Animation message
		if (alMessageId == eLuxEntityMessage_AnimationMessageEvent)
		{
			int lX = mpStateMachine.GetCurrentMessageData().mlX;
			if (msAnimState == "Shoot" && lX == 1)
			{			
				mbShoot_Aiming = false;				
				Shoot_ShootAtPos();		
			}
		}
		
		////////////////////////
		// Player detected
		if (alMessageId == eLuxEntityMessage_PlayerDetected)
		{
			if (mbRetreat_Active) return true;
			
			Shoot_StopTimers();
			
			Terror_AddEnemy(mBaseObj.GetID(), 2.f);
			mAlertState = eShotgunnerAlertState_Detected;
			
			mbShoot_ShootPlayer = true;
			mpStateMachine.AddTimer("Aim", cMath_RandRectf(0.3f, 0.6f));
		}
		
		////////////////////////
		// Sound heard
		if (alMessageId == eLuxEntityMessage_SoundHeard)
		{
			if (mbRetreat_Active) return true;
			if (GetSensesActive() == false) return true;
			if (GetShouldIgnoreSound()) return true;
			
			/////////////////////
			// Ignore sounds if player detected
			if (mBaseObj.PlayerIsDetected() || mbShoot_ShootPlayer)
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Ignoring sound because player is detected");
				return true;
			}
			
			cVector3f vGoal = mpStateMachine.GetCurrentMessageData().mvX;
			int lPrio = mpStateMachine.GetCurrentMessageData().mlX;
			tString sSoundName = mpStateMachine.GetCurrentMessageData().msX;
			bool bCausedByPlayer = mpStateMachine.GetCurrentMessageData().msY == "Player";
			tID idSourceBody = mpStateMachine.GetCurrentMessageData().mID;
			
			if (InvestigateSound_RegisterSound(lPrio, vGoal, sSoundName, bCausedByPlayer, idSourceBody, false, true))
			{
				mbShoot_InvestigateSound = true;
			}
		}
		
		////////////////////////
		// Grenade/molotov impact
		if (alMessageId == eCustomEntityMessage_Explosion ||
			alMessageId == eCustomEntityMessage_GrenadeImpact ||
			alMessageId == eCustomEntityMessage_MolotovImpact)
		{
			if (mbRetreat_Active) return true;
			return mbShoot_ShootPlayer;
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_Shoot_TimerUp(uint64 alId)
	{
		///////////////////
		// Reload
		if (alId == H64("Reload"))
		{
			bool bReload = ReloadShotgun(true);
			if (bReload == false)
			{
				mpStateMachine.AddTimer("Aim", 0.f);
			}
		}
		
		///////////////////
		// Aim
		else if (alId == H64("Aim"))
		{			
			msAnimState = "AimLoop";
			mpMover.PlayAnimation(gsShotgunnerAnim_AimLoop, 0.3f, true);
			
			mbShoot_Aiming = true;
			mbShoot_AdjustSpine = true;		
			mpMover.StopTurning();
		}
				
		///////////////////
		// Exit
		else if (alId == H64("Exit"))
		{
			int lNewState = eShotgunnerState_Patrol;
			
			///////////////////
			// Wait in idle?
			if (mbShoot_WaitInIdleAfterShoot)
			{
				lNewState = eShotgunnerState_Idle;
			}
			
			///////////////////
			// Return to prev?
			else if (mbShoot_ReturnToPreBlockedStateAfterShoot)
			{
				lNewState = mlBlocked_PrevState;
			}
			
			/////////////////
			// Hit player?
			else if (mbShoot_BulletHitPlayer)
			{
				if (Player_GetGasMaskEquipped())
				{
					lNewState = eShotgunnerState_Retreat;
					mbRetreat_HurtPlayer = true;
				}
				else
				{
					lNewState = eShotgunnerState_TeleportRetreat;
				}
			}			
			
			///////////////////
			// Player pinned?
			else if (mbShoot_ShootPlayer)
			{
				mbInvestigatePos_IsPlayer = true;
				mvInvestigatePos_InterestPos = mvShoot_Pos;
				lNewState = eShotgunnerState_InvestigatePos;
			}
			
			//////////////////
			// Investigate sound?
			else if (mbShoot_InvestigateSound)
			{
				ResetResumeStates();				
				lNewState = eShotgunnerState_InvestigateSound;
			}
			
			///////////////////
			// Investigate pos?
			else if (mbShoot_InvestigateShootPos)
			{
				mbInvestigatePos_IsPlayer = false;
				mvInvestigatePos_InterestPos = mvShoot_Pos;
				lNewState = eShotgunnerState_InvestigatePos;
			}
			
			mpStateMachine.ChangeState(lNewState);
			
			///////////////////
			// Reset resume states if not going back to prev
			if (lNewState != mlBlocked_PrevState)
			{
				ResetResumeStates();
			}
		}
	}
	
	//------------------------------------------------------------

	void Shoot_UpdateAiming(float afTimeStep)
	{
		//////////////////
		// Setup vars
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		cMeshEntity@ pMeshEnt = mBaseObj.GetMeshEntity();
		cBoneState@ pSpine = pMeshEnt !is null ? pMeshEnt.GetBoneStateFromName("j_Spine_01") : null;
		
		if (pCharBody is null) return;
		if (pMeshEnt is null) return;
		if (pSpine is null) return;
		
		//////////////////////
		// Calculate angles
		bool bAdjustSpine = mbShoot_AdjustSpine && 
							mbPlayQuickTurnAnim == false && 
							mbShoot_WasQuickTurning == false;
		bool bPointInFront = mBaseObj.GetPointIsInFront(mvShoot_Pos);
		float fAngleX = 0.f;
		float fAngleY = 0.f;
		cVector3f vRight = cVector3f(0.f);
		
		if (bAdjustSpine)
		{
			cVector3f vPos = pCharBody.GetPosition();
			cVector3f vFwd = pCharBody.GetForward();
			cVector3f vToTarget = cMath_Vector3Normalize(mvShoot_Pos - vPos);
						
			float fAngleStartY = cMath_GetAngleFromPoints3D(0.f, vFwd).y;
			float fAngleGoalY = cMath_GetAngleFromPoints3D(0.f, vToTarget).y;
			fAngleY = cMath_GetAngleDistanceRad(fAngleStartY, fAngleGoalY);
			fAngleY += gfShotgunner_AimYawOffset;
			fAngleY = cMath_Clamp(fAngleY, gfShotgunner_AimMinYaw, gfShotgunner_AimMaxYaw);
							
			cMatrixf mtxRotY = cMath_MatrixRotateY(fAngleY);
			vFwd = cMath_MatrixMul(mtxRotY, vFwd);
			vRight = cMath_MatrixMul(mtxRotY, pCharBody.GetRight());			
			
			cVector3f vPlaneX = cMath_Vector3ProjectOnPlane(vToTarget, vRight);
			fAngleX = cMath_Vector3Angle(vFwd, vPlaneX) * cMath_Sign(vPlaneX.y) * 1.f;
			fAngleX += gfShotgunner_AimPitchOffset;
			fAngleX = cMath_Clamp(fAngleX, gfShotgunner_AimMinPitch, gfShotgunner_AimMaxPitch);
		}
			
		//////////////////////
		// Calculate rotation
		cMatrixf mtxSpine = pSpine.GetWorldMatrix();
		
		cQuaternion qYaw;
		cQuaternion qPitch;		
		qYaw.FromAngleAxis(fAngleY, cVector3f_Up);		
		qPitch.FromAngleAxis(fAngleX, vRight);
						
		cQuaternion qRotAddGoal = qPitch * qYaw;
		
		float fAimSpeed = gfShotgunner_AimSpeed;		
		if (mbShoot_Aiming && 
			mbShoot_ShootPlayer && 
			mBaseObj.GetDistanceToPlayer() < 2.5f)
		{
			fAimSpeed *= 1.5f;
		}
		
		float fRotSpeed = bAdjustSpine ? fAimSpeed : fAimSpeed * 0.3f;
		if (bPointInFront == false)
		{
			fRotSpeed *= 0.1f;
		}
			
		m_qShoot_AimRotAdd = cMath_QuaternionNlerp(fRotSpeed * afTimeStep, m_qShoot_AimRotAdd, qRotAddGoal);
		
		cMatrixf mtxNewRot = mtxSpine;
		mtxNewRot.SetRotation(cMath_MatrixMul(cMath_MatrixQuaternion(m_qShoot_AimRotAdd), mtxSpine));
		pSpine.SetWorldMatrix(mtxNewRot);
		
		//////////////////////
		// Calculate rotation diff
		cMatrixf mtxCurrentRot = cMath_MatrixQuaternion(m_qShoot_AimRotAdd);
		cMatrixf mtxRotGoal = cMath_MatrixQuaternion(qRotAddGoal);
		mfShoot_AimAngleLength = cMath_MatrixEulerAngleDistance(mtxCurrentRot, mtxRotGoal).Length();
		
		//////////////////////
		// Goal outside of yaw range, turn?
		if (bAdjustSpine &&
			(fAngleY >= gfShotgunner_AimMaxYaw || 
			 fAngleY <= gfShotgunner_AimMinYaw ||
			 bPointInFront == false))
		{
			mbShoot_ShouldTurn = true;
			mfShoot_AimAngleLength = 1.f;		
			mpMover.TurnToPos(mvShoot_Pos);
		}
		else
		{
			mbShoot_ShouldTurn = false;
		}
	}
	
	//------------------------------------------------------------

	void Shoot_ShootAtPos()
	{
		////////////////
		// Setup vars
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();			
		cVector3f vStartOffset = cVector3f_Up * 0.6f + pCharBody.GetForward() * pCharBody.GetSize().x * 0.3f;
		cVector3f vStart = mBaseObj.GetPosition() + vStartOffset;
		cVector3f vDir = cMath_Vector3Normalize(mvShoot_Pos - vStart);
		
		////////////////
		// Apply accuracy offset		
		if (mbShoot_ShootPlayer)
		{
			float fAccuracyOffset = cMath_RandRectf(gfShotgunner_AccuracyOffsetMin, gfShotgunner_AccuracyOffsetMax);
			
			float fAccuracyMul = Shoot_GetAccuracyMul();
			fAccuracyOffset *= (1.f - fAccuracyMul);
			
			cMatrixf mtxAccuracyOffset = cMath_MatrixRotateY(fAccuracyOffset);
			vDir = cMath_Vector3Normalize(cMath_MatrixMul(mtxAccuracyOffset, vDir));
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Shooting with accuracy: " + fAccuracyMul);
		}
		
		////////////////
		// Add bullet	
		int lBulletCount = 16;
		cVector3f vBulletRandPoint;
		cVector3f vBulletDir;
		array<int> vBulletIds;
		
		for (int i = 0; i < lBulletCount; i++)
		{
			vBulletRandPoint = cMath_RandomSphereSurfacePoint(cMath_RandRectf(0, 0.1f));
			vBulletRandPoint += vDir;
			vBulletDir = cMath_Vector3Normalize(vBulletRandPoint);
			
			int lId = BulletHandler_AddBullet(vStart, vBulletDir, eBulletType_Shotgun, mBaseObj.GetID(), "Shoot_OnBulletHit");
			vBulletIds.push_back(lId);
		}
		
		for (int i = 0; i < vBulletIds.size(); ++i)
		{
			int lId = vBulletIds[i];
			BulletHandler_AddIgnoredEntity(lId, mBaseObj.GetID());
			
			for (int j = 0; j < mvShoot_IgnoreEntIds.size(); ++j)
			{
				BulletHandler_AddIgnoredEntity(lId, mvShoot_IgnoreEntIds[j]);
			}
		}		
		
		////////////////
		// Ignore physics sounds for a while
		mBaseObj.Timer_Add("Timer_IgnorePhysicsSounds", 5.f);
					
		////////////////
		// Sound
		tString sSound = "creatures/shotgunner/large_fire";
		eSoundEntryType soundType = eSoundEntryType_GuiWorld;

		if (Gun_GetMuffledEffectActive())
		{
			sSound = "weapons/revolver/gunshot_muffled";
			soundType = eSoundEntryType_Safe;
		}
			
		Sound_PlayGui(sSound, 1.f, soundType);
		
		// TODO: Make a proper gun effect instead of using the hide mode one!
		if (mBaseObj.GetDistanceToPlayer2D() < 10.f)
			Gun_ActivateMuffledEffect(7.f);
		
		////////////////
		// Visual effects
		cWorld@ pWorld = mBaseObj.GetMap().GetWorld();
		iPhysicsBody@ pMuzzleBody = cLux_ID_Body(m_idShotgunMuzzleBody);
		
		if (pWorld !is null && pMuzzleBody !is null)
		{
			cParticleSystem@ pPS = pWorld.CreateParticleSystem("PS_ShotgunMuzzleFlame", gsShotgunnerPS_MuzzleFlame, cVector3f(1.f), true, false);
			pPS.SetWorldMatrix(pMuzzleBody.GetWorldMatrix());
		}
		
		DoLightFlash(vStart, vDir, 0.f);	
		
		////////////////
		// Player scared
		mfPlayerScaredCount = 0.f;
		Player_SetScared(5.f);
		
		////////////////
		// Inc shoot count
		++mlShoot_ShootCount;
	}
	
	//------------------------------------------------------------
	
	bool Shoot_GetAimingDone()
	{
		cMeshEntity@ pMeshEnt = mBaseObj.GetMeshEntity();
		if (pMeshEnt is null) return false;
		
		cAnimationState@ pAnimA = pMeshEnt.GetAnimationStateFromName(gsShotgunnerAnim_AimLoop);
		cAnimationState@ pAnimB = pMeshEnt.GetAnimationStateFromName(gsShotgunnerAnim_AimStart);
		bool bAnimPlaying = (pAnimA !is null && pAnimA.IsActive()) ||
						    (pAnimB !is null && pAnimB.IsActive() && pAnimB.GetRelativeTimePosition() > 0.5f);
		
		float fAimAngleLengthThreshold = mBaseObj.GetDistanceToPlayer() < 2.f ? 0.5f : 0.08f;
		
		return bAnimPlaying && 
			   mfShoot_AimAngleLength < fAimAngleLengthThreshold;
	}
	
	//------------------------------------------------------------
	
	float Shoot_GetAccuracyMul()
	{
		return 1.f - cMath_Clamp(GetAveragePlayerVelocity().Length() / 5.f, 0.1f, 1.f);
	}
	
	//------------------------------------------------------------
	
	bool Shoot_GetShouldTurn()
	{
		return mpStateMachine.GetCurrentState() == eShotgunnerState_Shoot && mbShoot_Aiming && mbShoot_ShouldTurn;
	}
	
	//------------------------------------------------------------
	
	void Shoot_OnBulletHit()
	{		
		///////////////////
		// Get data
		tID idEntity = cScript_GetGlobalArgID(0);
		tID idBody = cScript_GetGlobalArgID(1);
		iLuxEntity@ pEnt = cLux_ID_Entity(idEntity);
		iPhysicsBody@ pBody = cLux_ID_Body(idBody);
		
		///////////////////
		// Shot player? Exit state!
		if (pEnt is mBaseObj.GetMap().GetPlayerEntity())
		{
			Shoot_StopTimers();
			
			mbShoot_Aiming = false;
			mbShoot_BulletHitPlayer = true;
			
			mpStateMachine.AddTimer("Exit", 0.f);
		}
	}
	
	//------------------------------------------------------------
	
	void Shoot_StopTimers()
	{
		mpStateMachine.StopTimer("Aim");
		mpStateMachine.StopTimer("Exit");
	}
	
	//------------------------------------------------------------

	//} END STATE: SHOOT
	
	//-----------------------------------------------------------
	
	///////////////////////////////////
	// STATE: RETREAT
	//{////////////////////////////////
	
	//-----------------------------------------------------------
	
	bool mbRetreat_Active = false;
	bool mbRetreat_Hurt = false;
	bool mbRetreat_HurtIgnoreTimerSetup = false;
	bool mbRetreat_HurtPlayer = false;
	bool mbRetreat_PlayerBlocksPath = false;
	cVector3f mvRetreat_Pos = cVector3f(0.f);
	
	//-----------------------------------------------------------
	
	void State_Retreat_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Retreat ------");
		
		/////////////////
		// Setup state
		SetSpeedState(eShotgunnerSpeed_Run);
		
		mpProximitySensor.ResetAllStates();
		
		bool bStopVoice = Voice_SubjectIsPlaying(gsShotgunner_PoemDefaultVoiceSubject);
		mpBarkMachine.ChangeState(eShotgunnerBark_Silent, bStopVoice);
		
		bool bRetreatWasActive = mbRetreat_Active;
		mbRetreat_Active = true;
		
		if (mAlertState != eShotgunnerAlertState_Detected)
			mAlertState = eShotgunnerAlertState_None;
		
		/////////////////
		// Ignore player timer
		bool bForceIgnoreTime = false;
		float fIgnorePlayerTime = bRetreatWasActive ? 0.f : 6.f;		
		
		if (mbRetreat_HurtPlayer)
		{
			fIgnorePlayerTime = 5.f;
			mbRetreat_HurtPlayer = false;
		}
		else if (mbRetreat_Hurt == false &&
				 mbRetreat_HurtPlayer == false &&
				 mBaseObj.GetDistanceToPlayer() > 10.f)
		{
			fIgnorePlayerTime = 1.f;	
		}
		
		if (mbRetreat_Hurt &&
			mbRetreat_HurtIgnoreTimerSetup == false)
		{
			bForceIgnoreTime = true;
			mbRetreat_HurtIgnoreTimerSetup = true;
			fIgnorePlayerTime = 6.f;
		}
		
		tString sIgnorePlayerTimer = "Timer_RetreatIgnorePlayer";
		if (bForceIgnoreTime || 
			mBaseObj.Timer_Exists(sIgnorePlayerTimer) == false)
		{
			mBaseObj.Timer_Add(sIgnorePlayerTimer, fIgnorePlayerTime);
		}
		
		/////////////////
		// Avoid player
		DeactivateAllRouteBlockers();
		
		if (mbRetreat_PlayerBlocksPath == false)
		{
			mbRetreat_PlayerBlocksPath = true;
			Blackboard_SetPlayerBlocksPath(mBaseObj, true);
		}
		
		/////////////////
		// Get retreat pos		
		if (mvRetreat_Pos.SqrLength() <= 0.f)
		{
			mBaseObj.Timer_Add("Timer_RetreatStarted", cMath_RandRectf(5.f, 6.f));
			mvRetreat_Pos = Retreat_GetRetreatPos(true);
			
			if (mvRetreat_Pos.SqrLength() <= 0.f)
			{
				Retreat_Reset();
				mpStateMachine.ChangeState(eShotgunnerState_Patrol);
				return;
			}
		}
				
		/////////////////
		// Move!
		mpPathfinder.MoveTo(mvRetreat_Pos, 1.f, false);		
		mpStateMachine.AddTimer("Exit", 1.f);
	}

	//------------------------------------------------------------

	void State_Retreat_Leave()
	{
	}
	
	//------------------------------------------------------------
	
	void State_Retreat_Update(float afTimeStep)
	{	
	}
	
	//------------------------------------------------------------
	
	bool State_Retreat_Message(int alMessageId)
	{
		//////////////////////
		// End of path
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			Retreat_End();			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") End of path!");
		}
		
		/////////////////////
		// Enter proximity
		else if (alMessageId == eLuxEntityMessage_EnterProximity)
		{			
			if (mBaseObj.Timer_Exists("Timer_RetreatIgnorePlayer"))
			{
				mpProximitySensor.ResetAllStates();
				return true;
			}
			
			int lProxState = mpStateMachine.GetCurrentMessageData().mlX;			
			bool bPlayerDetected = false;
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Enter proximity " + ProximityStateToString(lProxState));
			
			//////////////////////
			// Touching
			if (lProxState == eShotgunnerProximity_Touching)
			{
				DetectPlayer();
				bPlayerDetected = true;
			}
			
			//////////////////////
			// Close / medium
			else if (lProxState == eShotgunnerProximity_Close ||
					 lProxState == eShotgunnerProximity_Medium)
			{
				bool bPlayerSneaking = Player_GetCrouching() || Player_GetSpeed() <= 1.f;
				
				if (bPlayerSneaking == false || 
					mBaseObj.GetPointIsInFront(mBaseObj.GetPlayerPos()))
				{
					mvDetectPlayer_PlayerPos = mBaseObj.GetPlayerPos();
					mpStateMachine.ChangeState(eShotgunnerState_DetectPlayer);
					
					bPlayerDetected = true;
				}
				else
				{
					mpProximitySensor.ResetState(lProxState);
				}
			}
			
			//////////////////////
			// Retreat done if player detected!
			if (bPlayerDetected)
			{
				Retreat_Reset();
			}
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	void State_Retreat_TimerUp(uint64 alId)
	{
		//////////////////////
		// Exit
		if (H64("Exit") == alId)
		{
			if (mBaseObj.Timer_Exists("Timer_RetreatStarted"))
			{
				mpStateMachine.AddTimer("Exit", 1.f);
				return;
			}
			
			//////////////////////
			// Far enough away from player?
			tID idPlayerPathBlocker = Blackboard_GetPlayerPathBlockerBodyId();
			if (mbRetreat_PlayerBlocksPath && 
				idPlayerPathBlocker != tID_Invalid)
			{
				mpPathfinder.RemovePathBlockerBody(idPlayerPathBlocker);
			}
		
			float fDist = GetPathDistanceToPos(mBaseObj.GetCharBody().GetFeetPosition(), mBaseObj.GetPlayerFeetPos(), false);
			
			if (mbRetreat_PlayerBlocksPath && 
				idPlayerPathBlocker != tID_Invalid)
			{
				mpPathfinder.AddPathBlockerBody(idPlayerPathBlocker);
			}
				
			if (fDist >= 25.f)
			{
				Retreat_End();
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Far enough away, end retreat!");
				return;
			}
			
			mpStateMachine.AddTimer("Exit", 1.f);
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f Retreat_GetRetreatPos(bool abDoPathCheck)
	{
		///////////////////
		// Setup vars
		cVector3f vRetreatPos = cVector3f(0.f);		
		array<tID> vRetreatAreaIds = mvRetreatAreaIds;		
		array<tID> vDoorBodies;
		
		for (int i = 0; i < mvDoorIds.size(); ++i)
		{
			cLuxProp@ pDoor = cLux_ID_Prop(mvDoorIds[i]);
			if (pDoor is null)
			{
				mvDoorIds[i] = mvDoorIds[mvDoorIds.size() - 1];
				mvDoorIds.pop_back();
				--i;
				continue;
			}
			
			tID idBody = SwingDoor_GetDoorBodyID(pDoor.GetName());
			if (idBody != tID_Invalid)
			{
				vDoorBodies.push_back(idBody);
				mpPathfinder.AddPathBlockerBody(idBody);
			}
		}
		
		///////////////////
		// Get retreat pos
		int lIterations = vDoorBodies.size() > 0 ? 2 : 1;
		
		for (int i = 0; i < lIterations; ++i)
		{
			if (i == 1)
			{
				for (int j = 0; j < vDoorBodies.size(); ++j)
				{
					mpPathfinder.RemovePathBlockerBody(vDoorBodies[j]);
				}
			}
			
			while (vRetreatPos.SqrLength() <= 0.f && vRetreatAreaIds.size() > 0)
			{
				//////////////////
				// Get area			
				int lId = cMath_RandRectl(0, vRetreatAreaIds.size() - 1);
				tID idArea = vRetreatAreaIds[lId];
				vRetreatAreaIds.removeAt(lId);
							
				cLuxArea@ pArea = cLux_ID_Area(idArea);
				
				//////////////////
				// Doesn't exist?
				if (pArea is null)
				{
					continue;
				}
				
				//////////////////
				// Too close?
				float fDistSqr = (pArea.GetPosition() - mBaseObj.GetPosition()).SqrLength();
				if (fDistSqr < gfShotgunner_MinRetreatDistance * gfShotgunner_MinRetreatDistance)
				{
					continue;
				}
				
				//////////////////
				// Too close to player?
				float fDistToPlayerSqr = (pArea.GetPosition() - mBaseObj.GetPlayerPos()).SqrLength();
				if (fDistToPlayerSqr < gfShotgunner_MinRetreatDistanceToPlayer * gfShotgunner_MinRetreatDistanceToPlayer)
				{
					continue;
				}
								
				//////////////////
				// In player LOS?
				if (cLux_CheckLineOfSight(mBaseObj.GetPlayerHeadPos(), pArea.GetPosition(), false, false, mBaseObj.GetMap().GetPlayerEntity()))
				{
					continue;
				}
				
				//////////////////
				// Goal inside path blocker?
				tID idBlockerBody;
				if (EvaluateObstacle_GetPointIsInsidePathBlocker(pArea.GetPosition(), idBlockerBody))
				{
					continue;
				}
				
				//////////////////
				// Path available?
				if (abDoPathCheck)
				{
					if (mpPathfinder.BuildPathNodeArrayToPos(pArea.GetPosition(), 1) == false)
					{
						continue;
					}
				}
				
				//////////////////
				// Found our position!
				vRetreatPos = pArea.GetPosition();
			}
			
			if (vRetreatPos.SqrLength() > 0.f)
				break;
		}
		
		/////////////////
		// Fail safe!
		if (vRetreatPos.SqrLength() <= 0.f)
		{
			cAINode@ pNode = mpPathfinder.GetNodeInCircularSectorAroundPos(mBaseObj.GetPlayerPos(), 15.f, 30.f, cVector3f(0.f), 0.f, false, false, false, null);
			if (pNode !is null)
			{
				vRetreatPos = pNode.GetPosition();
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") No retreat area found, getting node!");
			}
			else
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") No retreat pos found!");
			}
		}
		
		return vRetreatPos;
	}
    
	//------------------------------------------------------------
	
	void Retreat_Reset()
	{
		mvRetreat_Pos = cVector3f(0.f);
		mbRetreat_Active = false;
		mbRetreat_Hurt = false;
		mbRetreat_HurtIgnoreTimerSetup = false;
		mbRetreat_HurtPlayer = false;
		mbRetreat_PlayerBlocksPath = false;
		
		Blackboard_SetPlayerBlocksPath(mBaseObj, false);
	}
	
	//------------------------------------------------------------
	
	void Retreat_End()
	{
		mpStateMachine.ChangeState(eShotgunnerState_Idle);
			
		if (mbRetreat_Hurt &&
			mHurt_DamageType != eDamageType_Gas &&
			mHurt_DamageType != eDamageType_Fire)
		{
			ResetVoiceSubjectIfPlayed(gsShotgunner_HurtSubject);			
			mpBarkMachine.PlayVoice(gsShotgunner_HurtSubject, 1);
		}
		
		Retreat_Reset();
	}
	
	//------------------------------------------------------------

	//} END STATE: RETREAT

	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: INVESTIGATE POS
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbInvestigatePos_IsPlayer = false;
	cVector3f mvInvestigatePos_InterestPos = cVector3f(0.f);
	
	//------------------------------------------------------------

	void State_InvestigatePos_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: InvestigatePos ------",false,true);
		
		////////////////////
		// Setup state
		SetSpeedState(eShotgunnerSpeed_Walk);
		mAlertState = eShotgunnerAlertState_Investigating;
		
		bool bStopVoice = Voice_SubjectIsPlaying(gsShotgunner_PoemDefaultVoiceSubject);
		mpBarkMachine.ChangeState(eShotgunnerBark_Search, bStopVoice);
		
		mpProximitySensor.ResetAllStates();
		
		mpStateMachine.AddTimer("Move", cMath_RandRectf(0.3f, 0.6f));
		
		////////////////////
		// Bark
		ResetVoiceSubjectIfPlayed(gsShotgunner_SearchVoiceSubject);
		mpBarkMachine.PlayVoice(gsShotgunner_SearchVoiceSubject, 1);
	}

	//------------------------------------------------------------

	void State_InvestigatePos_Leave()
	{		
		mbInvestigatePos_IsPlayer = false;
		mvInvestigatePos_InterestPos = cVector3f(0.f);
	}

	//------------------------------------------------------------

	void State_InvestigatePos_Update(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------

	bool State_InvestigatePos_Message(int alMessageId)
	{		
		/////////////////////
		// Enter proximity
		if (alMessageId == eLuxEntityMessage_EnterProximity && mbInvestigatePos_IsPlayer)
		{
			if (GetSensesActive(false) == false) return true;
			
			int lProxState = mpStateMachine.GetCurrentMessageData().mlX;
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Enter proximity " + ProximityStateToString(lProxState));
			
			//////////////////////
			// Touching
			if (lProxState == eShotgunnerProximity_Touching)
			{
				DetectPlayer();
			}
			
			//////////////////////
			// Close / medium
			else if (lProxState == eShotgunnerProximity_Close ||
					 lProxState == eShotgunnerProximity_Medium)
			{
				cVector3f vPlayerPos = mBaseObj.GetPlayerHeadPos();
				bool bPlayerSpotted = mBaseObj.GetPointIsInFront(vPlayerPos) &&
									  mBaseObj.GetPointIsInLineOfSight(vPlayerPos);
				
				if (bPlayerSpotted)
				{
					DetectPlayer();
				}
				else
				{
					mpProximitySensor.ResetState(lProxState);
				}
			}
			
			return true;
		}
		
		//////////////////////
		// Animation over
		if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			if (msAnimState == "LookAroundEnd")
			{
				mpStateMachine.AddTimer("Exit", 0.2f);
			}
			
			msAnimState = "";
			return true;
		}
		
		/////////////////////
		// End of path
		if (alMessageId == eLuxEntityMessage_EndOfPath)
		{
			mpStateMachine.AddTimer("LookAroundEnd", 0.5f);			
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------

	void State_InvestigatePos_TimerUp(uint64 alId)
	{		
		/////////////////////
		// Move
		if (H64("Move") == alId)
		{
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvInvestigatePos_InterestPos, 0.f, 3.f, true, false, false, null);
			if (pNode !is null)
			{
				mpPathfinder.MoveTo(pNode.GetPosition(), 1.f, false);
			}
			else
			{
				mpStateMachine.AddTimer("Exit", cMath_RandRectf(1.f, 1.5f));
			}		
		}
		
		/////////////////////
		// Look around
		if (alId == H64("LookAroundEnd"))
		{
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Look around");
			
			mpPathfinder.Stop();
			msAnimState = "LookAroundEnd";
			
			mpMover.PlayAnimation(gsShotgunnerAnim_ListenLong, 0.3f, false);
		}		
		
		/////////////////////
		// Exit
		if (H64("Exit") == alId)
		{
			mpStateMachine.ChangeState(eShotgunnerState_Patrol);
		}
	}

	//------------------------------------------------------------

	//} END INVESTIGATE POS
	
	///////////////////////////////////
	// STATE: TELEPORT RETREAT
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbTeleportRetreat_Hurt = false;
	float mfTeleportRetreat_Coverage = 1.f;
	
	//------------------------------------------------------------

	void State_TeleportRetreat_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: TeleportRetreat ------");
		
		////////////////////
		// Setup state				
		mpPathfinder.Stop();
		SetSpeedState(eShotgunnerSpeed_Stopped);
		mAlertState = eShotgunnerAlertState_None;
		
		int lBarkState = mbTeleportRetreat_Hurt ? eShotgunnerBark_Hurt : eShotgunnerBark_Silent;
		mpBarkMachine.ChangeState(lBarkState, true);
		
		mBaseObj.GetCharBody().SetActive(false);
		
		mfTeleportRetreat_Coverage = 1.f;
		
		BulletHandler_AddGlobalIgnoredAgent(mBaseObj.GetID());

		////////////////////
		// Setup reaction		
		if (mbTeleportRetreat_Hurt)
		{
			mpStateMachine.AddTimer("PlayHurtSound", 0.1f);			
			mpStateMachine.AddTimer("PlayHurtAnim", 0.f);		
			mpStateMachine.AddTimer("SpawnBlood", 0.f);		
			mpStateMachine.AddTimer("SwarmSilhouettes", 0.125f);
		}
		
		////////////////////
		// Exit
		float fExitTime = mbTeleportRetreat_Hurt ? cMath_RandRectf(9.f, 12.f) : cMath_RandRectf(7.f, 9.f);
		mpStateMachine.AddTimer("Exit", fExitTime);
	}	
	
	//------------------------------------------------------------
	
	void State_TeleportRetreat_Leave() 
	{
		mbTeleportRetreat_Hurt = false;
		
		TeleportRetreat_SetCoverage(1.f);
		
		mpMover.SetUseMoveStateAnimations(true);
		mBaseObj.GetCharBody().SetActive(true);
		
		BulletHandler_RemoveGlobalIgnoredAgent(mBaseObj.GetID());
	}	
	
	//------------------------------------------------------------
	
	void State_TeleportRetreat_Update(float afTimeStep) 
	{
		mfTeleportRetreat_Coverage = cMath_IncreaseTo(mfTeleportRetreat_Coverage, afTimeStep, 0.f);
		TeleportRetreat_SetCoverage(mfTeleportRetreat_Coverage);
	}
	
	//------------------------------------------------------------
	
	bool State_TeleportRetreat_Message(int alMessageId) 
	{
		return true; 
	}
	
	//------------------------------------------------------------
	
	void State_TeleportRetreat_TimerUp(uint64 alId)
	{
		//////////////////////
		// Anim
		if (H64("PlayHurtAnim") == alId)
		{						
			msAnimState = "Hurt";
			mpMover.PlayAnimation(msHurt_HurtAnim, 0.3f, false);
		}
		
		//////////////////////
		// Sound
		if (H64("PlayHurtSound") == alId)
		{
			Hurt_PlaySound();
		}
		
		////////////////////
		// Swarm with silhouettes
		if (H64("SwarmSilhouettes") == alId)
		{
			Hurt_SwarmSilhouettes();
		}		
		
		////////////////////
		// Spawn blood
		if (H64("SpawnBlood") == alId)
		{
			Hurt_SpawnBlood();
		}
		
		////////////////////
		// Exit
		if (H64("Exit") == alId)
		{
			mvRetreat_Pos = Retreat_GetRetreatPos(false);
			
			cAINode@ pNode = mpPathfinder.GetNodeAtPos(mvRetreat_Pos, 0.f, 5.f, true, false, false, null);
			cVector3f vNewPos = pNode !is null ? pNode.GetPosition() : mvRetreat_Pos;
			
			mBaseObj.GetCharBody().SetFeetPosition(vNewPos, false);
			
			mbRetreat_Hurt = mbTeleportRetreat_Hurt;
			mpStateMachine.ChangeState(eShotgunnerState_Retreat);
		}
	}
	
	//------------------------------------------------------------
	
	void TeleportRetreat_SetCoverage(float afCoverage)
	{
		cMeshEntity@ pMeshEnt = mBaseObj.GetMeshEntity();
		cLuxProp@ pShotgun = cLux_ID_Prop(m_idShotgunEnt);
		cMeshEntity@ pShotgunMeshEnt = pShotgun !is null ? pShotgun.GetMeshEntity() : null;
		
		if (pMeshEnt is null) return;
		if (pShotgunMeshEnt is null) return;
		
		pMeshEnt.SetCoverageAmount(afCoverage);
		pShotgunMeshEnt.SetCoverageAmount(afCoverage);
	}
	
	//------------------------------------------------------------

	//} END TELEPORT RETREAT
	
	///////////////////////////////////
	// STATE: STUNNED
	//{////////////////////////////////

	//------------------------------------------------------------

	void State_Stunned_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Stunned ------",false,true);
		
		////////////////////
		// Setup state		
		mpPathfinder.Stop();		
		mpMover.StopTurning();		
		SetSpeedState(eShotgunnerSpeed_Stopped);
		mAlertState = eShotgunnerAlertState_Detected;
		
		mpBarkMachine.ChangeState(eShotgunnerBark_Silent, true);
		
		DetectPlayer();
		
		////////////////////
		// Reaction
		msAnimState = "Stunned";
		mpMover.PlayAnimation(gsShotgunnerAnim_Stunned, 0.3f, false, true);
		
		mpStateMachine.AddTimer("PlaySound", 0.1f);	
	}

	//------------------------------------------------------------

	void State_Stunned_Leave()
	{		
	}

	//------------------------------------------------------------

	void State_Stunned_Update(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------

	bool State_Stunned_Message(int alMessageId)
	{
		////////////////////
		// Stunned anim over?
		if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			if (msAnimState == "Stunned")
			{				
				mbShoot_ShootPlayer = true;
				mpStateMachine.ChangeState(eShotgunnerState_Shoot);
				
				msAnimState = "";
			}
		}
		
		return true;
	}
	
	//------------------------------------------------------------

	void State_Stunned_TimerUp(uint64 alId)
	{		
		////////////////////
		// Play sound
		if (H64("PlaySound") == alId)
		{
			mBaseObj.PlaySound("HitByProp", gsShotgunnerSound_BeHit, true, true);
		}
	}

	//------------------------------------------------------------

	//} END STUNNED    
   
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: HURT
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlHurt_BloodCount = 0;
	eDamageType mHurt_DamageType = eDamageType_Gun;
	tString msHurt_HurtAnim = "";
	
	//------------------------------------------------------------

	void State_Hurt_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Hurt ------", false, true);
						
		////////////////////
		// Setup state				
		mpPathfinder.Stop();
		SetSpeedState(eShotgunnerSpeed_Stopped);
		mAlertState = eShotgunnerAlertState_None;
		
		mpBarkMachine.ChangeState(eShotgunnerBark_Hurt, true);
		
		////////////////////
		// Teleport retreat?
		if (Player_GetGasMaskEquipped() == false &&
			mHurt_DamageType == eDamageType_Gun &&
			mBaseObj.GetDistanceToPlayer() >= gfShotgunner_IgnoreBulletDistance)
		{
			mbTeleportRetreat_Hurt = true;
			mpStateMachine.ChangeState(eShotgunnerState_TeleportRetreat);
			return;
		}
		
		////////////////////
		// Setup reaction		
		if (mHurt_DamageType == eDamageType_Gas ||
			mHurt_DamageType == eDamageType_Fire)
		{
			mpStateMachine.AddTimer("PlayHurtBark", 0.1f);
		}
		else
		{
			mpStateMachine.AddTimer("PlayHurtSound", 0.2f);
		}
		
		mpStateMachine.AddTimer("PlayHurtAnim", 0.1f);
		mpStateMachine.AddTimer("SpawnBlood", 0.1f);
		
		if (mHurt_DamageType == eDamageType_Gun)
		{
			mpStateMachine.AddTimer("SwarmSilhouettes", 0.25f);
		}
	}

	//------------------------------------------------------------

	void State_Hurt_Leave()
	{
		mpMover.SetUseMoveStateAnimations(true);
	}

	//------------------------------------------------------------

	void State_Hurt_Update(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------

	bool State_Hurt_Message(int alMessageId)
	{		
		//////////////////////
		// Anim over
		if (alMessageId == eLuxEntityMessage_AnimationOver)
		{
			if (msAnimState == "Hurt")
			{
				mbRetreat_Hurt = true;
				mpStateMachine.ChangeState(eShotgunnerState_Retreat);
			}
		}
		
		return true;
	}
	
	//------------------------------------------------------------

	void State_Hurt_TimerUp(uint64 alId)
	{
		//////////////////////
		// Anim
		if (H64("PlayHurtAnim") == alId)
		{						
			msAnimState = "Hurt";
			mpMover.PlayAnimation(msHurt_HurtAnim, 0.3f, false);
		}
		
		//////////////////////
		// Sound
		if (H64("PlayHurtSound") == alId)
		{
			Hurt_PlaySound();
		}
		
		//////////////////////
		// Bark
		if (H64("PlayHurtBark") == alId)
		{
			tString sSubject;
			if (mHurt_DamageType == eDamageType_Gas)
				sSubject = gsShotgunner_HurtGasSubject;
			else if (mHurt_DamageType == eDamageType_Fire)
				sSubject = gsShotgunner_HurtFireSubject;
			else
				sSubject = gsShotgunner_HurtSubject;
			
			ResetVoiceSubjectIfPlayed(sSubject);			
			mpBarkMachine.PlayVoice(sSubject, 1);
		}
		
		////////////////////
		// Swarm with silhouettes
		if (H64("SwarmSilhouettes") == alId)
		{
			Hurt_SwarmSilhouettes();
		}
		
		///////////////////
		// Spawn blood
		if (H64("SpawnBlood") == alId)
		{
			Hurt_SpawnBlood();
		}
	}
	
	//------------------------------------------------------------
	
	void Hurt_PlaySound()
	{
		tString sTimer = "Timer_HurtSoundCooldown";
		if (mBaseObj.Timer_Exists(sTimer)) return;
		
		if (mHurt_DamageType != eDamageType_Gas && 
			Voice_CharacterIsSpeaking(gsShotgunner_CharacterName) == false)
		{
			mpBarkMachine.PlayVoice(gsShotgunner_HurtEmoteSubject, 1);
			mBaseObj.Timer_Add(sTimer, 2.f);
		}
	}
	
	//------------------------------------------------------------
	
	void Hurt_SwarmSilhouettes()
	{
		int lSilhouetteCount = 4;
		array<tString> vSilhouettes;
		array<iLuxEntity@> vEnts;
		mBaseObj.GetMap().GetEntityArray("*", eLuxEntityType_Agent, "cScrAgentFogSilhouette", vEnts);
				
		if (vEnts.size() >= lSilhouetteCount)
		{
			int lCount = 0;
			int lSilhouettesFound = 0;
				
			while (lSilhouettesFound < lSilhouetteCount || lCount > 15)
			{
				++lCount;
					
				int lId = cMath_RandRectl(0, vEnts.size() - 1);
				iLuxEntity@ pSilhouette = vEnts[lId];
				tString sFileName = pSilhouette !is null ? pSilhouette.GetFileName() : "";
					
				if (pSilhouette is null) continue;
				if (cString_GetFirstStringPos(sFileName, "ghoul") != -1) continue;
				if (cString_GetFirstStringPos(sFileName, "wraith") != -1) continue;
				if (cString_GetFirstStringPos(sFileName, "rat") != -1) continue;
						
				vSilhouettes.push_back(pSilhouette.GetName());
				vEnts.removeAt(lId);
					
				++lSilhouettesFound;
			}
		}
				
		for (int i = 0; i < vSilhouettes.size(); ++i)
		{
			FogSilhouette_SpawnAtShotgunner(vSilhouettes[i]);
		}	
	}
	
	//------------------------------------------------------------
	
	void Hurt_SpawnBlood()
	{
		cLuxMap@ pMap = mBaseObj.GetMap();
		if (pMap is null) return;
		
		//////////////////
		// Setup transform
		cVector3f vStart = mBaseObj.GetCharBody().GetFeetPosition() + cVector3f(0.f, 0.1f, 0.f);
		cVector3f vDir = cVector3f_Down;
		cVector3f vNrm = cVector3f(0.f);

		float fDist;
		float fLength = 10.f;
			
		if (cLux_GetClosestBody(vStart, vDir, fLength, fDist, vNrm) is null)
			return;
		
		cVector3f vPos = vStart + vDir * (fDist - 0.01f);
		vPos.y += cMath_RandRectf(-0.0001f, 0.0001f);
		
		cQuaternion qRot;
		qRot.FromAngleAxis(cMath_RandRectf(-cMath_Pi, cMath_Pi), vNrm);
		
		cMatrixf mtxTransform = cMath_MatrixTranslate(vPos);
		mtxTransform.SetRotation(cMath_MatrixQuaternion(qRot));
		
		float fScale = cMath_RandRectf(0.65f, 0.85f);
			
		//////////////////
		// Create entity
		++mlHurt_BloodCount;	
		
		pMap.CreateEntity("BloodStain_" + mlHurt_BloodCount, gsShotgunner_BloodStainEntity, mtxTransform, cVector3f(fScale));
		iLuxEntity@ pEnt = pMap.GetLatestEntity();		
		if (pEnt is null) return;		
			
		//////////////////
		// Setup texture
		cMeshEntity@ pMeshEnt = pEnt.GetMeshEntity();
		if (pMeshEnt !is null)
			pMeshEnt.GetSubMeshEntity(0).SetCurrentSubDiv(0);
	}
	
	//------------------------------------------------------------

	//} END HURT
		
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: DEAD
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbDead_Ragdoll = false;
	int mlDead_HitboxBodyId = -1;
	float mfDead_HitForce = 0.f;
	float mfDead_HitMaxImpulse = 0.f;
	cVector3f mvDead_HitPosition = cVector3f(0.f);
	cVector3f mvDead_HitOrigin = cVector3f(0.f);
	
	//------------------------------------------------------------

	void State_Dead_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Dead ------",false,true);

		//////////////////
		// Setup state
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		mpMover.StopTurning();
		mpPathfinder.Stop();
		
		mpBarkMachine.ChangeState(eShotgunnerBark_Dead, true);
		mAlertState = eShotgunnerAlertState_None;
		
		mpMover.SetUseMoveStateAnimations(false);
		
		tID id = mBaseObj.GetID();
		Terror_RemoveHuntingEnemy(id);
		Terror_RemoveEnemy(id);
		
		mbChantPoem = false;		
		mBaseObj.GetMeshEntity().GetActorAnimController().Stop(false);
		
		if (mbRetreat_PlayerBlocksPath)
		{
			mbRetreat_PlayerBlocksPath = false;
			Blackboard_SetPlayerBlocksPath(mBaseObj, false);
		}
		
		mBaseObj.SetVarBool("IsDead", true);
		
		//////////////////
		// Delayed ragdoll?
		bool bDelayedRagdoll = false;
		{
			iPhysicsWorld@ pPhysicsWorld = mBaseObj.GetMap().GetPhysicsWorld();
			if (pPhysicsWorld is null) return;
			
			///////////////////
			// Space in front free? If not, use ragdoll
			float fRadius = 0.6f;
			iCollideShape@ pShape = pPhysicsWorld.CreateSphereShape(fRadius, cMatrixf_Identity);
			
			float fDist;
			cVector3f vNrm;
			cVector3f vPush;
			cVector3f vPos = pCharBody.GetFeetPosition() + cVector3f_Up * (fRadius * 1.05f) + pCharBody.GetForward() * 0.8f;
			cMatrixf mtxTransform = cMath_MatrixUnitVectors(pCharBody.GetRight(), pCharBody.GetForward(), pCharBody.GetUp(), vPos);
			
			if (cMath_ToDeg(cMath_Vector3Angle(cVector3f_Up, pCharBody.GetLastGroundNormal())) >= 5.f)
			{
				bDelayedRagdoll = true;
			}
			else if (pPhysicsWorld.CheckShapeWorldCollision(vPush, pShape, mtxTransform, null, false, false, true, false))
			{
				bDelayedRagdoll = true;
			}
			else if (cLux_GetClosestBody(vPos, cVector3f_Down, (fRadius * 1.1f), fDist, vNrm) is null)
			{
				bDelayedRagdoll = true;
			}

			if (pShape !is null)
				pPhysicsWorld.DestroyShape(pShape);
		}
		
		//////////////////
		// Setup ragdoll
		if (mbDead_Ragdoll)
			SetRagdollActive(true);
		
		SetAttachShotgun(false);
							
		mBaseObj.SetEffectsActive(false, true);
		
		tString sDeathAnim = "";
		if (mHurt_DamageType == eDamageType_Gas) 		sDeathAnim = gsShotgunnerAnim_DieGas;
		else if (mHurt_DamageType == eDamageType_Fire)	sDeathAnim = gsShotgunnerAnim_DieFire;
		else 											sDeathAnim = gsShotgunnerAnim_Die[cMath_RandRectl(0, gsShotgunnerAnim_Die.length() - 1)];
		
		//////////////////
		// Spawn pickup version of shotgun
		cLuxMap@ pMap = mBaseObj.GetMap();		
		if (pMap !is null)
		{
			pMap.CreateEntity("Shotgun_Pickup", gsShotgunner_ShotgunPickupEntity, cMatrixf_Identity, mBaseObj.GetOnLoadScale());
			
			cLuxProp@ pShotgun = cLux_ID_Prop(m_idShotgunEnt);
			cLuxProp@ pShotgunPickup = cLux_ToProp(pMap.GetLatestEntity());
			
			if (pShotgun !is null && pShotgunPickup !is null)
			{
				pShotgunPickup.SetMatrix(pShotgun.GetMatrix());
				pShotgunPickup.GetMainBody().SetCollideFlags(mBaseObj.GetMap().GetCollideFlag("+shotgun"));
				pShotgunPickup.GetMainBody().SetCollideCharacter(false);
				
				pShotgun.SetActive(false);
				
				if (mbDead_Ragdoll == false)
				{					
					cVector3f vImpulse;					
					if (sDeathAnim == "die_left")
						vImpulse = pCharBody.GetForward() * 1.f + pCharBody.GetRight() * 1.f;
					else if (sDeathAnim == "die_right")
						vImpulse = pCharBody.GetForward() * 1.f + pCharBody.GetRight() * -1.f;
					else
						vImpulse = pCharBody.GetForward() * 1.f + pCharBody.GetRight() * 1.f;
						
					pShotgunPickup.GetMainBody().AddImpulse(vImpulse);
				}				
			}
		}
		
		//////////////////
		// Ragdoll impulse
		if (mbDead_Ragdoll)
		{			
			cVector3f vDir = cMath_Vector3Normalize(mvDead_HitPosition - mvDead_HitOrigin);
			
			//////////////////
			// Add impulse to all ragdoll bodies		
			if (mlDead_HitboxBodyId == -1)
			{
				for (int i = 0; i < mBaseObj.GetHitboxBodyNum(); ++i)
					Dead_AddImpulseToRagdollBody(i, vDir);
			}
				
			//////////////////
			// Add impulse to specific ragdoll body
			else
			{
				Dead_AddImpulseToRagdollBody(mlDead_HitboxBodyId, vDir);
			}
		}
		
		//////////////////
		// Play death anim
		else
		{
			PlayCutsceneAnimation(sDeathAnim, false, 0.3f, "", 1.f, 0.f, false, cVector3f(0.f), 0.f, false, false, true);
			mbCutsceneAnimation_FadeEntityOffset = false;
			
			for (int i = 0; i < mBaseObj.GetHitboxBodyNum(); ++i)
			{
				iPhysicsBody@ pBody = mBaseObj.GetHitboxBody(i);			
				pBody.SetCollide(true);
				pBody.SetCollideCharacter(true);
				
				if (cString_GetFirstStringPos(pBody.GetName(), "Hand") != -1)
					pBody.SetCollideFlags(mBaseObj.GetMap().GetCollideFlag("-shotgun"));
			}
			
			if (bDelayedRagdoll)
			{
				float fTime = 0.5f;				
				if (mHurt_DamageType == eDamageType_Fire) 		fTime = 5.5f;
				else if (mHurt_DamageType == eDamageType_Gas) 	fTime = 3.7f;
				
				mpStateMachine.AddTimer("ActivateRagdoll", fTime);
				mpStateMachine.AddTimer("Sleep", cMath_Max(3.f, fTime + 1.f));
			}
		}
		
		//////////////////
		// Sleep
		if (bDelayedRagdoll == false)
		{
			float fTime;
			if (mbDead_Ragdoll)
			{
				fTime = 5.f;
			}
			else
			{
				cAnimationState@ pAnim = mBaseObj.GetMeshEntity().GetAnimationStateFromName(sDeathAnim);
				fTime = pAnim !is null ? pAnim.GetLength() : 5.f;
			}
			
			mpStateMachine.AddTimer("Sleep", fTime);
		}
		
		//////////////////
		// Play sound
		iPhysicsBody@ pHitBody = mBaseObj.GetHitboxBody(mlDead_HitboxBodyId);
		bool bSkipBark = pHitBody !is null && 
						 mHurt_DamageType == eDamageType_Gun && 
						 cString_GetFirstStringPos(pHitBody.GetName(), "Head") != -1;
						 
		if (bSkipBark == false)
		{
			mpStateMachine.AddTimer("PlayDeathBark", 0.1f);
		}
		
		mpStateMachine.AddTimer("PlayDeathStinger", 0.1f);
		
		//////////////////
		// Callback
		tString sCallback = "void OnShotgunnerDeath()";
		if (pMap !is null && 
			pMap.ScriptMethodExists(sCallback) && 
			pMap.ScriptPrepare(sCallback))
		{
			pMap.ScriptExecute();
		}
	}

	//------------------------------------------------------------

	void State_Dead_Leave()
	{
		mlDead_HitboxBodyId = -1;
		mfDead_HitForce = 0.f;
		mfDead_HitMaxImpulse = 0.f;
		mvDead_HitPosition = cVector3f(0.f);
		mvDead_HitOrigin = cVector3f(0.f);
	}

	//------------------------------------------------------------

	void State_Dead_Update(float afTimeStep)
	{
		if (mbDead_Ragdoll == false)
		{
			mBaseObj.UpdateHitboxBodyTransforms();
		}
	}
	
	//------------------------------------------------------------

	bool State_Dead_Message(int alMessageId)
	{						
		return true;
	}
	
	//------------------------------------------------------------

	void State_Dead_TimerUp(uint64 alId)
	{
		///////////////////
		// Play death sound
		if (H64("PlayDeathBark") == alId)
		{			
			tString sSubject;
			
			if (mHurt_DamageType == eDamageType_Gas) 		sSubject = gsShotgunner_DieGasSubject;
			else if (mHurt_DamageType == eDamageType_Fire) 	sSubject = gsShotgunner_DieFireSubject;
			else											sSubject = gsShotgunner_DieGeneralSubject;
			
			mpBarkMachine.PlayVoice(sSubject, 1);
		}
		
		///////////////////
		// Activate ragdoll
		else if (H64("ActivateRagdoll") == alId)
		{
			mbDead_Ragdoll = true;
			SetRagdollActive(true, 0.f);
		}
		
		///////////////////
		// Sleep
		else if (H64("Sleep") == alId)
		{
			mBaseObj.Sleep();
		}
		
		///////////////////
		// Stinger
		else if (H64("PlayDeathStinger") == alId)
		{
			Sound_PlayGui(gsShotgunnerSound_DeathStinger, 1.f, eSoundEntryType_Gui);
		}
	}
	
	//------------------------------------------------------------
	
	void Dead_AddImpulseToRagdollBody(int alBodyId, const cVector3f &in avDir)
	{
		iPhysicsBody@ pHitboxBody = mBaseObj.GetHitboxBody(alBodyId);
		iPhysicsBody@ pRagdollBody = pHitboxBody !is null ? mBaseObj.GetRagdollBodyFromHitboxName(pHitboxBody.GetName()) : null;
		
		if (pRagdollBody !is null)
		{
			cVector3f vImpulse = avDir * cMath_Min(mfDead_HitForce / pRagdollBody.GetMass(), mfDead_HitMaxImpulse);			
			pRagdollBody.AddImpulseAtPosition(vImpulse, mvDead_HitPosition);
		}
	}
	
	//------------------------------------------------------------

	//} END DEAD
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: EVALUATE OBSTACLE
	//{////////////////////////////////		
	
	//------------------------------------------------------------
	
	bool mbEvaluateObstacle_IgnoreNextDamageArea = false;
	tID m_idEvaluateObstacle_BlockerBodyCandidate = tID_Invalid;
	array<tID> mvEvaluateObstacle_IgnoredProps;	
	array<cShotgunner_PathBlockerBodyData> mvEvaluateObstacle_BlockerBodyData;
	
	//------------------------------------------------------------
	
	void State_EvaluateObstacle_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: EvaluateObstacle ------",false,true);
		
		///////////////////
		// Setup vars
		iPhysicsBody@ pBody = cLux_ID_Body(m_idEvaluateObstacle_BlockerBodyCandidate);
		cLuxProp@ pProp = pBody !is null ? cLux_ToProp(cLux_GetBodyEntity(pBody)) : null;
		
		if (pBody is null || pProp is null)
		{
			mpStateMachine.ChangeState(mpStateMachine.GetPrevState());
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Obstacle doesn't exist, returning to prev state!", false, true);
			return;
		}
		
		cVector3f vPathGoal = mpPathfinder.GetGoalPos();
		if (vPathGoal.SqrLength() <= 0)
			vPathGoal = mBaseObj.GetCharBody().GetFeetPosition();
			
		bool bIsDamageArea = Blackboard_GetIsBodyDamageArea(pBody);
		
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Evaluating prop: " + pProp.GetName(), false, true);
		
		///////////////////
		// Setup state	
		SetPreBlockedState(mpStateMachine.GetPrevState());
		
		///////////////////
		// Take alt path?
		bool bAltPathExists = false;
		bool bPlayerHidingByBlocker = false;
		array<tID> vAddedPathBlockerBodyIds;
		
		if (pProp.GetIsDoor() == false)
		{
			EvaluateObstacle_GetPathAroundBlockerBody(m_idEvaluateObstacle_BlockerBodyCandidate, vPathGoal, 
												      bAltPathExists, bPlayerHidingByBlocker, vAddedPathBlockerBodyIds);
		}
		
		if (bAltPathExists)
		{
			mpPathfinder.MoveTo(vPathGoal, 1.f, false);
			mpStateMachine.ChangeState(mlBlocked_PrevState);
				
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Taking path around blockage!", false, true);
			return;
		}
		
		///////////////////
		// Physical blockage?
		if (bIsDamageArea == false)
		{
			///////////////////
			// Enter idle!
			if (bPlayerHidingByBlocker)
			{
				mpStateMachine.ChangeState(eShotgunnerState_Idle);
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Player hiding by blocker!", false, true);
			}
			
			///////////////////
			// Break blockage!	
			else if (pProp.GetBreakActive())
			{
				mbShoot_ReturnToPreBlockedStateAfterShoot = true;
				m_idShoot_Target = pProp.GetID();
				mpStateMachine.ChangeState(eShotgunnerState_Shoot);
						
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Break blockage!", false, true);
				return;
			}
			
			///////////////////
			// Can't break, ignore it!
			else
			{
				EvaluateObstacle_AddIgnoredProp(pProp.GetID());
				mpStateMachine.ChangeState(mlBlocked_PrevState);
				
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Can't break blockage, ignoring!", false, true);
				return;
			}
		}
		
		///////////////////
		// Damage area?
		else
		{	
			float fExitTime = cMath_RandRectf(0.75f, 1.5f);
			
			///////////////////
			// Ignore it?
			if (mbEvaluateObstacle_IgnoreNextDamageArea)
			{
				mbEvaluateObstacle_IgnoreNextDamageArea = false;
				
				for (int i = 0; i < vAddedPathBlockerBodyIds.size(); ++i)
				{
					tID idBlockerBody = vAddedPathBlockerBodyIds[i];
					iPhysicsBody@ pBlockerBody = cLux_ID_Body(idBlockerBody);
					cLuxProp@ pBlockerProp = cLux_ToProp(cLux_GetBodyEntity(pBlockerBody));
					
					if (pBlockerProp !is null)
					{
						EvaluateObstacle_AddIgnoredProp(pBlockerProp.GetID());
						mBaseObj.Timer_Add(H64(pBlockerProp.GetName()), 15.f, "OnTimer_RemoveIgnoredProp");
					}
					
					EvaluateObstacle_RemovePathBlocker(idBlockerBody);
				}
				
				fExitTime = 0.f;
				
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") No path around damage area, ignore it!", false, true);
			}
			
			///////////////////
			// Patrol!
			mpStateMachine.AddTimer("Exit", fExitTime);
			return;
		}
	}

	//------------------------------------------------------------

	void State_EvaluateObstacle_Leave()
	{		
		m_idEvaluateObstacle_BlockerBodyCandidate = tID_Invalid;
		
		if (mbRetreat_Active &&
			mpStateMachine.GetNextState() != eShotgunnerState_Retreat &&
			mbShoot_ReturnToPreBlockedStateAfterShoot == false)
		{
			Retreat_Reset();
		}
	}

	//------------------------------------------------------------

	void State_EvaluateObstacle_Update(float afTimeStep)
	{
	}
	
	//------------------------------------------------------------

	bool State_EvaluateObstacle_Message(int alMessageId)
	{		
		if (alMessageId == eCustomEntityMessage_StuckCounterHigh) return true;
		return false;
	}
	
	//------------------------------------------------------------
	
	void State_EvaluateObstacle_TimerUp(uint64 alId)
	{
		///////////////////
		// Exit
		if (alId == H64("Exit"))
		{
			int lState = mbRetreat_Active ? eShotgunnerState_Retreat : eShotgunnerState_Patrol;
			mpStateMachine.ChangeState(lState);
		}
	}
	
	//------------------------------------------------------------
	
	void EvaluateObstacle_GetPathAroundBlockerBody(tID a_idBody, const cVector3f &in avGoal, bool &out abAltPathExists, 
												   bool &out abPlayerHidingByBlocker, array<tID> &out avAddedPathBlockerBodyIds)
	{
		///////////////
		// Setup vars
		iPhysicsBody@ pBody = cLux_ID_Body(a_idBody);
		cLuxProp@ pProp = pBody !is null ? cLux_ToProp(cLux_GetBodyEntity(pBody)) : null;
		
		if (pBody is null) return;
		if (pProp is null) return;
		
		abAltPathExists = false;
		abPlayerHidingByBlocker = false;
		
		bool bIsDamageArea = Blackboard_GetIsBodyDamageArea(pBody);		
		cVector3f vPathGoal = avGoal;
		
		///////////////
		// Get original path dist
		float fOriginalPathDist = -1.f;
		if (mpPathfinder.BuildPathNodeArrayToPos(vPathGoal))
		{
			fOriginalPathDist = mpPathfinder.GetPathNodeArrayFullLength();
		}
		
		///////////////
		// Group together blockers close to each other
		avAddedPathBlockerBodyIds = Blackboard_GetPathBlockerBodyCluster(a_idBody);
		if (avAddedPathBlockerBodyIds.find(a_idBody) == -1)
		{
			// Specified ID is not in array? It's most likely a door, add it manually!
			avAddedPathBlockerBodyIds.push_back(a_idBody);
		}
		
		for (int i = 0; i < avAddedPathBlockerBodyIds.size(); ++i)
			EvaluateObstacle_AddPathBlocker(avAddedPathBlockerBodyIds[i]);
		
		///////////////////
		// Goal inside blocker? Don't look for alt path
		tID idBlockingBody = tID_Invalid;
		if (EvaluateObstacle_GetPointIsInsidePathBlocker(vPathGoal, idBlockingBody))
		{ 
			abAltPathExists = false;
		}
		
		///////////////////
		// Look for alt path
		else
		{
			///////////////
			// Is there an alt path?
			abAltPathExists = mpPathfinder.BuildPathNodeArrayToPos(vPathGoal);
			
			///////////////
			// Still blocked by a damage area?
			if (abAltPathExists == false && bIsDamageArea)
			{
				///////////////
				// Can we find one if we remove physical blockers?
				array<tID> vRemovedBlockers = EvaluateObstacle_RemoveAllPathBlockers(true, false);						
				if (mpPathfinder.BuildPathNodeArrayToPos(vPathGoal))
				{
					abAltPathExists = true;
					cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Found path previously blocked by physical obstacle!", false, true);
				}
				
				///////////////////
				// Nope, restore blockers we removed!
				else
				{
					for (int i = 0; i < vRemovedBlockers.size(); ++i)
						EvaluateObstacle_AddPathBlocker(vRemovedBlockers[i]);
				}	
			}
			
			////////////////////////////
			// Skip path if much longer than just breaking the obstacle (unless blocker is a door)
			if (abAltPathExists && bIsDamageArea == false && pProp.GetIsDoor() == false)
			{
				float fAltPathDist = mpPathfinder.GetPathNodeArrayFullLength();				
				if (fAltPathDist > fOriginalPathDist * 1.5f)
				{
					abAltPathExists = false;
				}
			}
		}
		
		///////////////////
		// No alt path found, blocker is physical and NOT a door
		if (abAltPathExists == false && bIsDamageArea == false && pProp.GetIsDoor() == false)
		{
			//////////////////
			// Player hiding by blocker?
			cBoundingVolume@ pBlockerBounds = pBody.GetBoundingVolume();
			cBoundingVolume@ pPlayerBounds = cLux_GetPlayer().GetCharacterBody().GetCurrentBody().GetBoundingVolume();
			
			cVector3f vBlockerCenter = pBlockerBounds.GetWorldCenter();
			cVector3f vBlockerMin = vBlockerCenter + pBlockerBounds.GetLocalMin() * 2.f;
			cVector3f vBlockerMax = vBlockerCenter + pBlockerBounds.GetLocalMax() * 2.f;
						
			if (cMath_CheckAABBIntersection(vBlockerMin, vBlockerMax, pPlayerBounds.GetMin(), pPlayerBounds.GetMax()))
			{
				abPlayerHidingByBlocker = true;
			}
			
			/////////////////
			// Remove blocker!
			else
			{				
				for (int i = 0; i < avAddedPathBlockerBodyIds.size(); ++i)
					EvaluateObstacle_RemovePathBlocker(avAddedPathBlockerBodyIds[i]);
					
				avAddedPathBlockerBodyIds.resize(0);
			}
		}
	}
		
	//------------------------------------------------------------
	
	void EvaluateObstacle_AddPathBlocker(tID a_idBody, bool abIsOpenDoor = false)
	{
		if (EvaluateObstacle_GetPathBlockerExists(a_idBody))
			return;
		if (a_idBody == m_idShotgunEnt)
			return;
		
		cShotgunner_PathBlockerBodyData data;
		data.m_idBody = a_idBody;
		data.mfTimeUntilRemoval = gfShotgunner_AutoRemovePathBlockerTime;
		data.mbIsOpenDoor = abIsOpenDoor;		
		mvEvaluateObstacle_BlockerBodyData.push_back(data);
		
		mpPathfinder.AddPathBlockerBody(a_idBody);
	}
	
	//------------------------------------------------------------
	
	void EvaluateObstacle_RemovePathBlocker(tID a_idBody)
	{
		for (int i = 0 ; i < mvEvaluateObstacle_BlockerBodyData.size(); ++i)
		{
			cShotgunner_PathBlockerBodyData@ pData = mvEvaluateObstacle_BlockerBodyData[i];
			if (pData.m_idBody == a_idBody)
			{
				mvEvaluateObstacle_BlockerBodyData.removeAt(i);
				break;
			}
		}
						
		mpPathfinder.RemovePathBlockerBody(a_idBody);
	}
	
	//------------------------------------------------------------
	
	bool EvaluateObstacle_GetPathBlockerExists(tID a_idBody)
	{
		for (int i = 0 ; i < mvEvaluateObstacle_BlockerBodyData.size(); ++i)
		{
			cShotgunner_PathBlockerBodyData@ pData = mvEvaluateObstacle_BlockerBodyData[i];
			if (pData.m_idBody == a_idBody)
				return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	array<tID>@ EvaluateObstacle_RemoveAllPathBlockers(bool abPhysicalBlockers, bool abDamageAreas)
	{
		array<tID> vOut;
		
		for (int i = 0; i < mvEvaluateObstacle_BlockerBodyData.size(); ++i)
		{
			cShotgunner_PathBlockerBodyData@ pData = mvEvaluateObstacle_BlockerBodyData[i];
			iPhysicsBody@ pBody = cLux_ID_Body(pData.m_idBody);
			if (pBody is null) continue;
			
			bool bIsDamageArea = Blackboard_GetIsBodyDamageArea(pBody);
			
			if (bIsDamageArea && abDamageAreas == false) continue;
			if (bIsDamageArea == false && abPhysicalBlockers == false) continue;
			
			mpPathfinder.RemovePathBlockerBody(pData.m_idBody);
			vOut.push_back(pData.m_idBody);
				
			mvEvaluateObstacle_BlockerBodyData.removeAt(i);
			--i;
		}
		
		if (abPhysicalBlockers && abDamageAreas)
		{
			mpPathfinder.ClearPathBlockerBodies();
		}
		
		return vOut;
	}
	
	//------------------------------------------------------------
	
	bool EvaluateObstacle_GetPointIsInsidePathBlocker(const cVector3f &in avPos, tID &out a_idBlockingBody)
	{
		for (int i = 0; i < mvEvaluateObstacle_BlockerBodyData.size(); ++i)
		{
			cShotgunner_PathBlockerBodyData@ pData = mvEvaluateObstacle_BlockerBodyData[i];
			iPhysicsBody@ pBody = cLux_ID_Body(pData.m_idBody);
			cBoundingVolume@ pBounds = pBody !is null ? pBody.GetBoundingVolume() : null;
			if (pBounds is null) continue;
			
			cVector3f vOffset = cVector3f(0.2f);
			cVector3f vMin = pBounds.GetMin() - vOffset;
			cVector3f vMax = pBounds.GetMax() + vOffset;
			
			if (cMath_CheckPointInAABBIntersection(avPos, vMin, vMax))
			{
				a_idBlockingBody = pData.m_idBody;
				return true;
			}
		}
		
		a_idBlockingBody = tID_Invalid;
		return false;
	}
	
	//------------------------------------------------------------
	
	cVector3f EvaluateObstacle_GetAvailablePosNearPoint(const cVector3f &in avPos)
	{
		////////////////////////
		// Setup vars
		int lCount = 0;
		float fMinRadius = 1.f;
		float fMaxRadius = 5.f;
		cAINode@ pNode = null;		
		tID idBlockingBody = tID_Invalid;
		cVector3f vGoalPos = cVector3f(0.f);
		
		while ((pNode is null || pNode.GetName() == "") && lCount < 5)
		{
			++lCount;
			@pNode = mpPathfinder.GetNodeInCircularSectorAroundPos(avPos, fMinRadius, fMaxRadius, 0.f, 0.f, false, false, false, null);
				
			////////////////////////
			// Increase radius until we find a node
			if (pNode is null) 
			{
				fMaxRadius += 1.f;
				continue;
			}
				
			////////////////////////
			// Don't move to point inside blocker
			if (EvaluateObstacle_GetPointIsInsidePathBlocker(pNode.GetPosition(), idBlockingBody))
			{
				continue;
			}
			
			////////////////////////
			// We found our pos!
			vGoalPos = pNode.GetPosition();
			break;
		}
		
		return vGoalPos;
	}
	
	//------------------------------------------------------------
	
	bool EvaluateObstacle_EvaluateBody(iPhysicsBody@ apBody, bool abCheckLoS)
	{
		////////////////
		// Setup vars
		cLuxProp@ pProp = cLux_ToProp(cLux_GetBodyEntity(apBody));
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		if (apBody is null) return false;
		if (pProp is null) return false;
		if (pCharBody is null) return false;	
		
		////////////////
		// Player path blocker? Handled differently!
		if (Blackboard_GetIsBodyPlayerPathBlocker(apBody))
		{
			return false;
		}
		
		////////////////
		// Should be ignored?
		if (mvEvaluateObstacle_IgnoredProps.find(pProp.GetID()) != -1)
		{
			return false;
		}
		
		////////////////
		// Already evaluated?
		if (EvaluateObstacle_GetPathBlockerExists(apBody.GetID()))
		{
			return false;
		}
		
		/////////////////
		// Can the body block the path?
		bool bBlocksPath = Blackboard_GetCanBodyBlockPath(apBody) ||	
						   (pProp.GetIsDoor() && SwingDoor_GetOpenAmount(pProp.GetName()) < gfShotgunner_SwingDoorObstacleOpenAmount) ||
						   (pProp.GetIsBreakable() && (apBody.GetMass() <= 0.f || pProp.GetStaticPhysics()));
			
		if (bBlocksPath == false)
		{
			return false;
		}
		
		/////////////////
		// Body in LoS?
		// (Only do this for physical blockers!)
		if (Blackboard_GetIsBodyDamageArea(apBody) == false && abCheckLoS)
		{			
			float fDist;
			cVector3f vNrm;
			cVector3f vStart = pCharBody.GetPosition() + pCharBody.GetForward() * (pCharBody.GetSize().x / 2.f);
			cVector3f vDir = (apBody.GetWorldPosition() - vStart);		
			
			if (cLux_GetClosestBody(vStart, cMath_Vector3Normalize(vDir), vDir.Length(), fDist, vNrm) !is apBody)
				return false;
		}	
		
		/////////////////
		// Evaluate it!
		m_idEvaluateObstacle_BlockerBodyCandidate = apBody.GetID();
		mpStateMachine.ChangeState(eShotgunnerState_EvaluateObstacle);
		return true;
	}
	
	//------------------------------------------------------------
	
	void EvaluateObstacle_AddIgnoredProp(tID a_idProp)
	{
		if (mvEvaluateObstacle_IgnoredProps.find(a_idProp) == -1)
		{
			mvEvaluateObstacle_IgnoredProps.push_back(a_idProp);
		}
	}
	
	//------------------------------------------------------------
	
	void OnTimer_RemoveIgnoredProp(uint64 alId)
	{
		for (int i = 0; i < mvEvaluateObstacle_IgnoredProps.size(); ++i)
		{
			cLuxProp@ pProp = cLux_ID_Prop(mvEvaluateObstacle_IgnoredProps[i]);
			
			if (pProp is null || alId == H64(pProp.GetName()))
			{
				mvEvaluateObstacle_IgnoredProps.removeAt(i);
				--i;
			}
		}
	}
	
	//------------------------------------------------------------

	//} END EVALUATE OBSTACLE
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: BLOCKED
	//{////////////////////////////////

	//------------------------------------------------------------

	int mlBlocked_PrevState = eShotgunnerState_Idle;
	
	//------------------------------------------------------------

	void State_Blocked_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Blocked ------",false,true);
		
		mpPathfinder.Stop();
		mBaseObj.ResetPlayerDetectionState();
		
		//////////////////
		// Update no collision bodies
		mfNoCollisionBodiesUpdateCount = 0.f;
		UpdateNoCollisionBodies(0.f);
		
		///////////////////
		// Set state before being blocked
		SetPreBlockedState(mpStateMachine.GetPrevState());		
		
		///////////////////
		// Check if we are blocked by a prop	
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		cVector3f vBoxCenter = pCharBody.GetFeetPosition() + pCharBody.GetForward() * 0.5f;
		cVector3f vBoxMin = vBoxCenter - cVector3f(1.f);
		cVector3f vBoxMax = vBoxCenter + cVector3f(1.f);
		
		array<iPhysicsBody@> vBodies;
		mBaseObj.GetMap().GetPhysicsWorld().GetBodiesInAABB(vBoxMin, vBoxMax, false, false, vBodies);
		
		int lBlockingProps = 0;
		array<cLuxProp@> vBreakableProps;
		array<cLuxProp@> vPushableProps;
		
		for (int i = 0; i < vBodies.size(); ++i)
		{
			iPhysicsBody@ pBody = vBodies[i];
			cLuxProp@ pProp = cLux_ToProp(cLux_GetBodyEntity(pBody));
			
			if (pBody is null) continue;
			if (pProp is null) continue;
			if (pProp.IsActive() == false) continue;
			if (pBody.GetMass() == 0.f && pProp.GetBreakActive() == false) continue;
			if (pBody.IsCharacter()) continue;
			
			++lBlockingProps;
			
			///////////////////
			// If we can break it/interact with it, save it!
			if ((pProp.GetIsDoor() || pProp.GetBreakActive()) && pProp.GetHealth() > 0.f)
			{
				vBreakableProps.push_back(pProp);
			}
			
			///////////////////
			// Otherwise, we can still push it!
			else
			{
				vPushableProps.push_back(pProp);
			}
		}
		
		///////////////////
		// If many, prioritize the ones colliding with the agent!
		cLuxProp@ pPropToBreak = null;
		cLuxProp@ pPropToPush = null;
		
		for (int i = 0; i < vBreakableProps.size(); ++i)
		{
			@pPropToBreak = vBreakableProps[i];
			if (pPropToBreak is null) continue;
			if (mBaseObj.CheckEntityCollision(pPropToBreak))
				break;
		}
		
		for (int i = 0; i < vPushableProps.size(); ++i)
		{
			@pPropToPush = vPushableProps[i];
			if (pPropToPush is null) continue;
			if (mBaseObj.CheckEntityCollision(pPropToPush))
				break;
		}
		
		///////////////////
		// Shoot the prop!
		if (pPropToBreak !is null)
		{
			m_idShoot_Target = pPropToBreak.GetID();
			mpStateMachine.ChangeState(eShotgunnerState_Shoot);
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Stuck on breakable prop, shoot it!");
			return;
		}
		
		if (lBlockingProps > 0)
		{
			m_idShoot_Target = pPropToPush.GetID();
			mpStateMachine.ChangeState(eShotgunnerState_Shoot);
			
			uint lFlag = mBaseObj.GetMap().GetCollideFlag("-agent");
			for (int i = 0; i < pPropToPush.GetBodyNum(); ++i)
			{
				iPhysicsBody@ pBody = pPropToPush.GetBody(i);
				if (pBody is null) continue;
				
				pBody.SetCollideFlags(lFlag);				
			}
			
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Stuck on unbreakable prop, shoot it and disable collision with agent!");			
			return;
		}
		
		///////////////////
		// Final fail safe -- enter idle!
		ResetResumeStates();		
		mpStateMachine.ChangeState(eShotgunnerState_Idle);
		
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Blocked and can't do anything about it, entering idle!");
	}

	//------------------------------------------------------------

	void State_Blocked_Leave()
	{
	}

	//------------------------------------------------------------

	void State_Blocked_Update(float afTimeStep)
	{
	}

	//------------------------------------------------------------

	bool State_Blocked_Message(int alMessageId)
	{
		if (alMessageId == eCustomEntityMessage_StuckCounterHigh) return true;		
		return false;
	}

	//------------------------------------------------------------

	void State_Blocked_TimerUp(uint64 alId)
	{
	}
	
	//------------------------------------------------------------

	//} END BLOCKED

	//------------------------------------------------------------
	
	///////////////////////////////////
	// STATE: DEBUG
	//{////////////////////////////////
	
	//------------------------------------------------------------
	
	cVector3f mvDebug_GoalPos = cVector3f(0.f);
	
	//------------------------------------------------------------

	void State_Debug_Enter()
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ ENTER STATE: Debug ------");
		
		SetSpeedState(eShotgunnerSpeed_Walk);
		
		if (mvDebug_GoalPos.SqrLength() != 0.f)
			mpPathfinder.MoveTo(mvDebug_GoalPos, 1.f, false);
		
		mvDebug_GoalPos = cVector3f(0.f);
		
		mpStateMachine.AddTimer("FollowPlayer", 1.f);
	}	
	
	//------------------------------------------------------------
	
	void State_Debug_Leave() 
	{
		cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") ------ LEAVE STATE: Debug ------");
		
		mvDebug_GoalPos = mpPathfinder.GetGoalPos();
	}	
	
	//------------------------------------------------------------
	
	void State_Debug_Update(float afTimeStep) 
	{
	}
	
	//------------------------------------------------------------
	
	bool State_Debug_Message(int alMessageId) 
	{
		return true; 
	}
	
	//------------------------------------------------------------
	
	void State_Debug_TimerUp(uint64 alId)
	{
		if (alId == H64("FollowPlayer"))
		{
			mpPathfinder.MoveTo(mBaseObj.GetPlayerFeetPos(), 1.f, true);
			mpStateMachine.AddTimer("FollowPlayer", 1.f);
		}
	}
	
	//------------------------------------------------------------

	//} END DEBUG
	
