	/////////////////////////////////////////
	//=======================================
	// SHOTGUNNER SPECIFIC CODE
	//=======================================
	//{//////////////////////////////////////

	//===========================================================
	
	//------------------------------------------------------------
	
	void HitByProp(float afAmount, float afMass, iPhysicsBody@ apBody, cLuxProp@ apProp)
	{				
		//////////////////
		// Caused by player?
		mbLastHitByPropThrownByPlayer = apBody.GetThrownByPlayer();
		
		//////////////////
		// Is it a molotov?		
		if (apProp.GetVarBool("IsMolotovCocktail"))
		{
			mbLastHitByPropWasMolotov = true;
			
			cVector3f vPos = apBody.GetWorldPosition();
			iPhysicsBody@ pCurrentBody = mBaseObj.GetCharBody().GetCurrentBody();
			int lDamageId = mBaseObj.GetMap().GetNewAttackInstanceID();
			
			mBaseObj.Timer_Remove("Timer_EnvironmentalDamageCooldown");
			mBaseObj.Timer_Add("Timer_HitByMolotov", 0.1f);
			mBaseObj.GiveDamage(pCurrentBody, vPos, vPos, eDamageType_Fire, 1.f, 1, 0.f, 0.f, apBody.GetID(), lDamageId);			
		}
		else
		{
			mbLastHitByPropWasMolotov = false;
		}
		
		//////////////////
		// Keep track of props collided with not caused by player
		if (mbLastHitByPropThrownByPlayer == false)
		{
			//////////////////
			// Reset track time if already exists
			for (int i = 0; i < mvCollideProps.size(); ++i)
			{
				if (mvCollideProps[i].m_idProp == apProp.GetID())
				{
					mvCollideProps[i].mfTimeSinceCollision = 0.f;
					return;
				}
			}
			
			//////////////////
			// Track prop!
			cShotgunner_CollidePropData data;
			data.msPropName = apProp.GetName();
			data.m_idProp = apProp.GetID();
			data.mfTimeSinceCollision = 0.f;
			
			mvCollideProps.push_back(data);
		}
	}
	
	//------------------------------------------------------------
	
	void GiveDamage(iPhysicsBody@ apBody, const cVector3f &in avOrigin, const cVector3f &in avHitPos, cLuxDamageProperties@ apDamageProps)
	{
		int lCurrentState = mpStateMachine.GetCurrentState();
		if (lCurrentState == eShotgunnerState_Dead) return;
		if (lCurrentState == eShotgunnerState_TeleportRetreat) return;
		
		/////////////////
		// Setup vars			
		int lHitboxBodyId = -1;	
		float fHitForceMul = 1.f;
		float fPrevHealth = mfHealth;
		bool bEnterHurt = true;
		bool bRagdollOnDeath = false;
		tString sAnim = "";
		mHurt_DamageType = eDamageType(apDamageProps.mDamageType);
		
		if (apBody !is null)
		{
			for (int i = 0; i < mBaseObj.GetHitboxBodyNum(); ++i)
			{
				if (apBody is mBaseObj.GetHitboxBody(i))
				{
					lHitboxBodyId = i;
					break;
				}
			}
		}
		
		/////////////////
		// Gun
		if (apDamageProps.mDamageType == eDamageType_Gun)
		{			
			iPhysicsBody@ pBody = mBaseObj.GetHitboxBody(lHitboxBodyId);
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Shot by gun in body: '" + (pBody !is null ? pBody.GetName() : "") + "'");
			
			if (cString_GetFirstStringPos(pBody.GetName(), "Head") != -1)
			{
				mfHealth = 0.f;
				bRagdollOnDeath = true;
			}
			else
			{
				float fDamage = gfShotgunner_GunDamage;
				if (BulletHandler_GetLastDamageBulletType() == eBulletType_Shotgun)
					fDamage = apDamageProps.mfDamage;
					
				mfHealth -= fDamage;
			}			
			
			fHitForceMul *= 1.5f;			
			sAnim = gsShotgunnerAnim_HurtByGun;
		}
		
		/////////////////////
		// Grenade
		else if (apDamageProps.mDamageType == eDamageType_Grenade)
		{					
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Hurt by grenade!");
			
			if (mBaseObj.Timer_Exists("Timer_HurtByGrenade") == false)
			{
				float fDamage = gfShotgunner_GrenadeDamage;
				if (m_idShoot_Target == apDamageProps.m_idSource)
				{
					fDamage = 0.01f;
				}
				
				if (mBaseObj.Timer_Exists("Timer_ReduceGrenadeDamage"))
				{
					fDamage = 0.1f;
				}

				mfHealth -= fDamage;
				fHitForceMul *= 3.f;
				sAnim = gsShotgunnerAnim_Hurt;
				bRagdollOnDeath = true;
				
				mBaseObj.Timer_Add("Timer_HurtByGrenade", 1.f);
			}
			else
			{
				bEnterHurt = false;
			}
		}
			
		/////////////////////
		// Gas
		else if (apDamageProps.mDamageType == eDamageType_Gas)
		{			
			if (GetCanBeHurtByEnvironmentalDamage())
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Hurt by gas!");
				
				mfHealth -= gfShotgunner_GasDamage;
				mfRunCount = 2.f;
				sAnim = gsShotgunnerAnim_Hurt;
				
				StartEnvironmentalDamageCooldown();
			}
			else
			{
				bEnterHurt = false;
			}
		}
			
		/////////////////////
		// Fire
		else if (apDamageProps.mDamageType == eDamageType_Fire)
		{	
			if (GetCanBeHurtByEnvironmentalDamage())
			{
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Hurt by fire!");
				
				mfHealth -= gfShotgunner_FireDamage;
				mfRunCount = 2.f;
				sAnim = gsShotgunnerAnim_Hurt;
				
				if (mBaseObj.Timer_Exists("Timer_HitByMolotov"))
					mfHealth = 0.f;
				
				StartEnvironmentalDamageCooldown();
			}
			else
			{
				bEnterHurt = false;
			}
		}
		
		/////////////////////
		// Clamp health
		bool bHurt = fPrevHealth > mfHealth;
		mfHealth = cMath_Clamp(mfHealth, 0.f, 1.f);
		
		/////////////////////
		// Dead?		
		if (bHurt && mfHealth <= 0.f)
		{
			mlDead_HitboxBodyId = lHitboxBodyId;
			mfDead_HitForce = apDamageProps.mfForce * fHitForceMul;
			mfDead_HitMaxImpulse = apDamageProps.mfMaxImpulse;
			mvDead_HitPosition = avHitPos;
			mvDead_HitOrigin = avOrigin;
			mbDead_Ragdoll = bRagdollOnDeath;
			
			mpStateMachine.ChangeState(eShotgunnerState_Dead);
		}
		
		/////////////////////
		// Hurt?
		else if (bHurt && bEnterHurt)
		{
			msHurt_HurtAnim = sAnim;
			mpStateMachine.ChangeState(eShotgunnerState_Hurt);
		}	
	}
	
	//------------------------------------------------------------
	
	void OnPathFindingResult(bool abSuccessful)
	{		
		int lState = mpStateMachine.GetCurrentState();
		
		/////////////////////////
		// No path found!
		if (abSuccessful == false)
		{
			/////////////////
			// Go to next node if in patrol
			if (lState == eShotgunnerState_Patrol)
			{				
				++mlPatrol_BlockedTrackNodeCount;
				if (mlPatrol_BlockedTrackNodeCount < mpPathfinder.GetTrackNodeNum())
				{
					mpPathfinder.GoToNextTrackNode();
					return;
				}
				
				/////////////////
				// Can't reach next node, ignore next damage area blocker!
				else
				{
					mbEvaluateObstacle_IgnoreNextDamageArea = true;
					mlPatrol_BlockedTrackNodeCount = 0;
				}
			}
			
			/////////////////////////
			// Remove all path blockers and try again!
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") No path found, removing all existing path blockers as failsafe!", false, true);
			
			mfIgnorePathBlockerCount = 1.f;
			
			DeactivateAllRouteBlockers();
			EvaluateObstacle_RemoveAllPathBlockers(true, true);
			
			if (mpPathfinder.IsMoving())
				mpPathfinder.MoveTo(mpPathfinder.GetGoalPos(), 1.f, false);
		}	
	
		/////////////////////////
		// Found a path!
		else
		{			
			/////////////////
			// Goal pos inside blocker?
			bool bInsideBlocker = false;
			bool bBlockerIsDamageArea = false;
			tID idBlockingBody;
			iPhysicsBody@ pBody = null;
			
			if (EvaluateObstacle_GetPointIsInsidePathBlocker(mpPathfinder.GetGoalPos(), idBlockingBody))
			{
				@pBody = cLux_ID_Body(idBlockingBody);
				
				bInsideBlocker = true;
				bBlockerIsDamageArea = Blackboard_GetIsBodyDamageArea(pBody);
			}
			
			/////////////////
			// Patrol
			if (lState == eShotgunnerState_Patrol)
			{
				mlPatrol_BlockedTrackNodeCount = 0;
				
				/////////////////
				// Go to next if inside blocker!
				if (bInsideBlocker && bBlockerIsDamageArea)
				{
					mpPathfinder.GoToNextTrackNode();
				}
			}
			
			/////////////////
			// Ignore physical blocker if specifically told to head to a position inside one			
			if (bInsideBlocker && bBlockerIsDamageArea == false)
			{
				EvaluateObstacle_RemovePathBlocker(idBlockingBody);
				cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Goal pos is inside physical blocker, removing blocker!", false, true);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void OnRecieveMessage(int alMessageId, cLuxEntityMessageData@ apData)
	{		
		////////////////////////
		// Handle footsteps
		if (alMessageId == eLuxEntityMessage_AnimationFootStep)
		{						
			tString sSoundPath = "creatures/shotgunner/walk";
			tString sSoundCategory = "";
			tString sSoundName = "";
			
			///////////////////////
			// In water?
			if (mbIsInLiquid)
			{
				sSoundName = "water";
			}
			
			////////////////////////////
			// Play sound!
			tString sSound = sSoundPath + sSoundCategory + sSoundName;
			cSoundEntity@ pSound = mBaseObj.GetMap().GetWorld().CreateSoundEntity("Sound_Footstep_" + mBaseObj.GetName(), sSound, true);
			
			if (pSound !is null)
			{
				///////////////////
				// Play at socket?
				tString sSocket = apData.msX;			
				cNode3D@ pSocket = mBaseObj.GetMeshEntity().GetSocket(apData.msX);
				
				if (pSocket !is null)
				{
					pSocket.AddEntity(pSound);
				}
				else
				{
					pSound.SetWorldPosition(mBaseObj.GetCharBody().GetFeetPosition());
				}
				
				pSound.SetScriptableIsSaved(false);
			}
		}
		
		////////////////////////
		// Generic animation events
		else if (alMessageId == eLuxEntityMessage_AnimationMessageEvent && mbCutsceneAnimation_Active == false)
		{
		}
	}
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// SHOTGUB MAN UPDATES
	//{////////////////////////////////
	
	//------------------------------------------------------------

	void UpdateObstacles(float afTimeStep)
	{
		/////////////////////
		// Stuck counter
		float fStuck = mpMover.GetStuckCounter();
		if (fStuck > 0.85f)
		{
			mBaseObj.BroadcastMessage(eCustomEntityMessage_StuckCounterHigh, null, mBaseObj.GetPosition(), 0);
			mpMover.ResetStuckCounter();
		}
		
		/////////////////////
		// Open door avoidance
		if (mpPathfinder.IsMoving())
		{
			cVector3f vStart = mBaseObj.GetCharBody().GetPosition();
			cVector3f vDir = cMath_Vector3Normalize(mpPathfinder.GetNextGoalPos() - vStart);
			
			mBaseObj.GetClosestEntity("AvoidOpenDoor_RaycastResult", vStart, vDir, 1.5f, -1.f, false);
		}
		
		/////////////////////
		// Path blockers
		UpdateObstacles_RemovePathBlockers(afTimeStep);
		UpdateObstacles_CheckForPathBlockers(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void UpdateObstacles_RemovePathBlockers(float afTimeStep)
	{
		/////////////////////
		// Iterate obstacles
		for (int i = 0; i < mvEvaluateObstacle_BlockerBodyData.size(); ++i)
		{
			/////////////////////
			// Setup vars
			cShotgunner_PathBlockerBodyData@ pData = mvEvaluateObstacle_BlockerBodyData[i];
			iPhysicsBody@ pBody = cLux_ID_Body(pData.m_idBody);
		
			bool bRemove = false;
				
			/////////////////////
			// Blocker gone, or inactive?
			if (pBody is null || pBody.IsActive() == false)
			{
				bRemove = true;
			}
			else
			{
				/////////////////////
				// Enough time has passed?
				float fPrevTimeUntilRemoval = pData.mfTimeUntilRemoval;
				pData.mfTimeUntilRemoval -= afTimeStep;
					
				if (pData.mfTimeUntilRemoval <= 0.f)
				{
					bRemove = true;
				}
				
				/////////////////////
				// Open door and now it's closed?
				if (pData.mbIsOpenDoor && 
					pData.mfTimeUntilRemoval % 2.f > 1.f && 
					fPrevTimeUntilRemoval % 2 < 1.f)
				{
					cLuxProp@ pProp = cLux_ToProp(cLux_GetBodyEntity(pBody));
					if (pProp !is null)
					{
						if (SwingDoor_GetOpenAmount(pProp.GetName()) < gfShotgunner_SwingDoorObstacleOpenAmount)
							bRemove = true;
					}						
				}
			}				
				
			/////////////////////
			// Remove?
			if (bRemove)
			{						
				EvaluateObstacle_RemovePathBlocker(pData.m_idBody);
				--i;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateObstacles_CheckForPathBlockers(float afTimeStep)
	{
		///////////////////
		// Count check
		if (mfIgnorePathBlockerCount > 0.f)
		{
			mfIgnorePathBlockerCount -= afTimeStep;
			return;
		}
		
		///////////////////
		// State check
		int lCurrentState = mpStateMachine.GetCurrentState();
		if (lCurrentState == eShotgunnerState_EvaluateObstacle ||
			lCurrentState == eShotgunnerState_Shoot ||
			lCurrentState == eShotgunnerState_Stunned ||
			lCurrentState == eShotgunnerState_Hurt ||
			lCurrentState == eShotgunnerState_Dead ||
			lCurrentState == eShotgunnerState_Blocked ||
			lCurrentState == eShotgunnerState_TeleportRetreat)
		{
			return;
		}
			
		///////////////////
		// Get bodies ahead!
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		cBoundingVolume@ pBounds = pCharBody.GetCurrentBody().GetBoundingVolume();
		
		float fBoxWidth = 2.f;
		float fBoxHeight = 1.5f;
		
		cVector3f vFwdOffset = pCharBody.GetForward() * (pCharBody.GetSize().x / 2.f) + pCharBody.GetForward() * (fBoxWidth / 2.f);
		cVector3f vBoxCenter = pCharBody.GetFeetPosition() + vFwdOffset + cVector3f(0.f, fBoxHeight / 2.f, 0.f);
		cVector3f vBoxMin = vBoxCenter - cVector3f(fBoxWidth / 2.f, fBoxHeight / 2.f, fBoxWidth / 2.f);
		cVector3f vBoxMax = vBoxCenter + cVector3f(fBoxWidth / 2.f, fBoxHeight / 2.f, fBoxWidth / 2.f);
			
		array<iPhysicsBody@> vBodies;
		mBaseObj.GetMap().GetPhysicsWorld().GetBodiesInAABB(vBoxMin, vBoxMax, false, false, vBodies);
		
		///////////////////
		// Iterate potential blockers!
		for (int i = 0; i < vBodies.size(); ++i)
		{
			iPhysicsBody@ pBody = vBodies[i];
			if (pBody is null) continue;		
			
			/////////////////
			// Ignore intersecting damage areas if retreating
			if (mbRetreat_Active &&
				Blackboard_GetIsBodyDamageArea(pBody) &&
				mBaseObj.CheckBodyCollision(pBody, mBaseObj.GetMap()))
			{
				continue;
			}
			
			/////////////////
			// Evaluate
			EvaluateObstacle_EvaluateBody(pBody, true);
		}
	}
	
	//------------------------------------------------------------
	
	void AvoidOpenDoor_RaycastResult(bool abSuccesful, float afDistance, iPhysicsBody@ apBody, iLuxEntity@ apEntity)
	{
		/////////////////////
		// Is prop door?
		cLuxProp@ pProp = cLux_ToProp(apEntity);
		tString sPropName = pProp !is null ? pProp.GetName() : "";
			
		if (apBody is null) return;
		if (pProp is null) return;
		if (pProp.GetIsDoor() == false) return;
		
		/////////////////////
		// Can we add the door as a path blocker?
		tID idDoor = SwingDoor_GetDoorBodyID(sPropName);
		
		if (EvaluateObstacle_GetPathBlockerExists(idDoor)) return;		
		if (SwingDoor_GetOpenAmount(sPropName) < gfShotgunner_SwingDoorObstacleOpenAmount) return;
		
		/////////////////////
		// Add it
		EvaluateObstacle_AddPathBlocker(idDoor, true);
		
		/////////////////////
		// Update path!
		if (mpPathfinder.IsMoving())
			mpPathfinder.MoveTo(mpPathfinder.GetGoalPos(), 1.f, false);
	}
	
	//------------------------------------------------------------

	void UpdatePlayerPrediction(float afTimeStep)
	{
		///////////////////
		// Check interval
		mfPlayerPrediction_UpdateCount -= afTimeStep;
		if (mfPlayerPrediction_UpdateCount <= 0.f)
		{
			mfPlayerPrediction_UpdateCount = gfShotgunner_PlayerPredictionIntervalTime;
			
			///////////////////
			// Keep track of specified num of positions
			if (mvPlayerPrediction_VelocityBuffer.size() == glShotgunner_PlayerPredictionVelocityBufferSize)
			{
				mvPlayerPrediction_VelocityBuffer.pop_front();
			}
			
			mvPlayerPrediction_VelocityBuffer.push_back(cLux_GetPlayer().GetCharacterBody().GetVelocity(afTimeStep));
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateNoCollisionBodies(float afTimeStep)
	{
		///////////////////
		// Check interval
		mfNoCollisionBodiesUpdateCount -= afTimeStep;
		if (mfNoCollisionBodiesUpdateCount > 0.f)
			return;
			
		mfNoCollisionBodiesUpdateCount = 0.1f;
		
		///////////////////
		// Setup box
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		float fBoxSize = pCharBody.GetSize().x * 1.25f;
		float fBoxHeight = pCharBody.GetSize().y;
		
		cVector3f vBoxCenter = pCharBody.GetFeetPosition() + cVector3f(0.f, fBoxHeight / 2.f, 0.f);
		cVector3f vBoxMin = vBoxCenter - cVector3f(fBoxSize / 2.f, fBoxHeight / 2.f, fBoxSize / 2.f);
		cVector3f vBoxMax = vBoxCenter + cVector3f(fBoxSize / 2.f, fBoxHeight / 2.f, fBoxSize / 2.f);
		
		///////////////////
		// Get bodies in box
		array<iPhysicsBody@> vBodies;
		mBaseObj.GetMap().GetPhysicsWorld().GetBodiesInAABB(vBoxMin, vBoxMax, true, false, vBodies);
				
		for (int i = 0; i < vBodies.size(); ++i)
		{
			iPhysicsBody@ pBody = vBodies[i];
			cLuxProp@ pProp = cLux_ToProp(cLux_GetBodyEntity(pBody));
			
			///////////////////
			// Filter out certain bodies
			if (pProp is null) continue;
			if (pBody is null) continue;
			if (pProp.IsActive() == false) continue;
			if (pProp.GetStaticPhysics()) continue;
			if (pProp.GetIsDoor()) continue;
			if (pProp.IsInteractedWith()) continue;
			if (pBody.GetThrownByPlayer()) continue;
			if (pBody.IsCharacter()) continue;
			if (pBody.GetMass() == 0.f) continue;
			if (pBody.GetJointNum() > 0) continue;
			
			///////////////////
			// Already set to not collide with it?
			if (mvNoCollBodies.find(pBody.GetID()) != -1)
				continue;
			
			///////////////////
			// Set to not collide if body is small enough
			cVector3f vBodySize = pBody.GetBoundingVolume().GetSize();
			float fBodySize = cMath_Max(vBodySize.x, cMath_Max(vBodySize.y, vBodySize.z));
			float fBodyMass = pBody.GetMass();
			
			if (fBodySize < 1.f || 
				(fBodySize < 2.f && fBodyMass < 5.5f))
			{
				mvNoCollBodies.push_back(pBody.GetID());
				mvNoCollBodiesCollGroups.push_back(pBody.GetCollideFlags());
				
				pBody.SetCollideFlags(mBaseObj.GetMap().GetCollideFlag("-agent"));
				
				// Add a little impulse to the body so the agent is less likely to just clip through
				cVector3f vImpulse = pCharBody.GetForward() * 1.5f;
				pBody.AddImpulse(vImpulse);
			}
		}
		
		///////////////////
		// Enable agent collision again?
		for (int i = 0; i < mvNoCollBodies.size(); ++i)
		{
			iPhysicsBody@ pBody = cLux_ID_Body(mvNoCollBodies[i]);
			cLuxProp@ pProp = cLux_ToProp(cLux_GetBodyEntity(pBody));
			
			if (pBody is null) continue;
			if (pProp is null) continue;
			
			bool bEnableColl = false;
			float fDistSqr = (pBody.GetWorldPosition() - pCharBody.GetFeetPosition()).SqrLength();

			if (fDistSqr > 3.f * 3.f ||
				pProp.IsInteractedWith() ||
				pBody.GetThrownByPlayer())
			{
				bEnableColl = true;
			}			
			
			if (bEnableColl)
			{
				pBody.SetCollideFlags(mvNoCollBodiesCollGroups[i]);
				
				mvNoCollBodies.removeAt(i);
				mvNoCollBodiesCollGroups.removeAt(i);
				--i;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateHitByProp(float afTimeStep)
	{
		////////////////
		// Iterate collide props
		for (int i = 0; i < mvCollideProps.size(); ++i)
		{
			////////////////
			// Setup vars
			cShotgunner_CollidePropData@ pData = mvCollideProps[i];
			cLuxProp@ pProp = cLux_ID_Prop(mvCollideProps[i].m_idProp);
			
			////////////////
			// Update prop pos
			if (pProp !is null)
				mvCollideProps[i].mvLastPropPos = pProp.GetPosition();
			
			////////////////
			// Remove if tracked for long enough
			pData.mfTimeSinceCollision += afTimeStep;
			if (pData.mfTimeSinceCollision >= gfShotgunner_CollidePropTrackTime)
			{
				mvCollideProps.removeAt(i);
				--i;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateQuickTurn(float afTimeStep)
	{		
		////////////////////
		// Setup
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		cMeshEntity@ pMeshEnt = mBaseObj.GetMeshEntity();
		cLuxMap@ pMap = mBaseObj.GetMap();
		iPhysicsWorld@ pPhysicsWorld = pMap.GetPhysicsWorld();
		
		if (pCharBody is null) return;
		if (pMeshEnt is null) return;
		if (pPhysicsWorld is null) return;
		if (pPhysicsWorld is null) return;
		if (pCharBody.IsOnGround() == false) return;
		if (mpStateMachine.GetCurrentState() == eShotgunnerState_Dead) return;

		////////////////////
		// Play turn around anim?
		if (mbPlayQuickTurnAnim == false && 
			(mpPathfinder.IsMoving() || Shoot_GetShouldTurn()))
		{
			////////////////////
			// Long enough since last?
			if (mlQuickTurnTimeStamp > 0 && 
				pMap.GetElapsedTime(mlQuickTurnTimeStamp) < gfShotgunner_MinTimeBetweenQuickTurns)
			{
				mfQuickTurnCount = 0.f;
				return;
			}
			
			////////////////////
			// Valid goal?
			mfQuickTurnGoalYaw = mpMover.GetTurnGoalAngles().y;
			if (cMath_Abs(mfQuickTurnGoalYaw) == 0.f)
			{
				mfQuickTurnCount = 0.f;
				return;
			}
			
			////////////////////
			// Valid angle?
			bool bValidAngle = false;
			bool bIsRunning = mpMover.GetSpeedState() == eStalkerSpeed_Run;
			float fAngleDist = cMath_GetAngleDistanceRad(pCharBody.GetYaw(), mfQuickTurnGoalYaw);
			float fAbsAngleDist = cMath_Abs(fAngleDist);			
			
			if (bIsRunning == false &&
				fAbsAngleDist > gfShotgunner_PlayTurnSideAnimMinAngle && 
				fAbsAngleDist < gfShotgunner_PlayTurnSideAnimMaxAngle)
			{
				bValidAngle = true;
				mQuickTurnAnimType = fAngleDist > 0.f ? eShotgunnerQuickTurnType_Left : eShotgunnerQuickTurnType_Right;
			}
			else if (fAbsAngleDist >= gfShotgunner_PlayTurnAroundAnimMinAngle)
			{
				bValidAngle = true;
				mQuickTurnAnimType = eShotgunnerQuickTurnType_TurnAround;
			}
						
			if (bValidAngle == false)
			{
				mfQuickTurnCount = 0.f;
				return;
			}
			
			////////////////////
			// Moving too fast?
			float fMoveSpeed = pCharBody.GetMoveSpeed(eCharDir_Forward);
			if (fMoveSpeed > gfShotgunner_QuickTurnMaxFwdSpeed)
			{
				mfQuickTurnCount = 0.f;
				return;
			}
			
			////////////////////
			// Too small angle when walking?
			if (bIsRunning == false &&
				fMoveSpeed > 0.f &&
				 (mQuickTurnAnimType == eShotgunnerQuickTurnType_Left ||
				  mQuickTurnAnimType == eShotgunnerQuickTurnType_Right))
			{
				if (fAbsAngleDist < gfShotgunner_PlayTurnSideAnimWalkMinAngle)
				{
					mfQuickTurnCount = 0.f;
					return;
				}
			}
			
			////////////////////
			// Tried to turn around for long enough?
			mfQuickTurnCount += afTimeStep;
			if (mfQuickTurnCount < 0.05f)
			{
				return;
			}
			
			////////////////////
			// Quick turn not allowed?
			if (mBaseObj.Timer_Exists("Timer_QuickTurnDisallowed"))
			{
				return;
			}
			
			////////////////////
			// Play anim			
			PlayQuickTurnAnim();
		}
		
		////////////////////
		// Turn around anim playing?
		if (mbPlayQuickTurnAnim)
		{
			////////////////////
			// Safety check!
			cAnimationState@ pCurrentAnim = mBaseObj.GetCurrentAnimationState();
			if (pCurrentAnim !is null && pCurrentAnim.GetName() != msQuickTurnAnim)
			{
				ResetQuickTurn();
				return;
			}
			
			////////////////////
			// Stop movement
			pCharBody.StopMovement();
			mpMover.StopTurning();
			
			////////////////////
			// Get anim
			cAnimationState@ pAnim = pMeshEnt.GetAnimationStateFromName(msQuickTurnAnim);
			if (pAnim is null)
			{
				ResetQuickTurn();
				return;
			}
			
			////////////////////
			// Anim playing?
			else if (pAnim.IsActive() && pAnim.IsOver() == false)
			{
				/////////////////
				// Align yaw
				float fT = cMath_Min(pAnim.GetRelativeTimePosition() + 0.1f, 1.f);
				
				float fYawOffset = 0.f;				
				switch (mQuickTurnAnimType)
				{
					case eShotgunnerQuickTurnType_TurnAround: 		fYawOffset = cMath_Pi; 			break;
					case eShotgunnerQuickTurnType_Left: 			fYawOffset = cMath_PiDiv2; 		break;
					case eShotgunnerQuickTurnType_Right: 			fYawOffset = -cMath_PiDiv2;		break;
				}				
				
				float fYawCorrection = cMath_GetAngleDistanceRad(mfQuickTurnStartYaw + fYawOffset, mfQuickTurnGoalYaw);
				float fNewYaw = mfQuickTurnStartYaw + fYawCorrection * fT;
				
				pCharBody.SetYaw(fNewYaw);
				pCharBody.UpdateEntity();	
			}
			
			////////////////////
			// Anim over?
			else if (pAnim.IsOver())
			{				
				ResetQuickTurn();
				
				////////////////////
				// Orient char body!
				pCharBody.SetYaw(mfQuickTurnGoalYaw);
				pCharBody.UpdateEntity();
				
				////////////////////
				// Play idle anim
				mpMover.PlayAnimation("idle", 0.f, false, false, "");
				mpMover.SetUseMoveStateAnimations(true);
				mpMover.StopTurning();
										
				////////////////////
				// Update path
				if (mpPathfinder.IsMoving())
				{
					mpPathfinder.MoveTo(mpPathfinder.GetGoalPos(), 1.f, false);
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	void PlayQuickTurnAnim()
	{
		cLuxMap@ pMap = mBaseObj.GetMap();
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		if (pMap is null) return;
		if (pCharBody is null) return;
		
		////////////////////
		// Setup anim
		mbPlayQuickTurnAnim = true;
		mfQuickTurnCount = 0.f;
		mlQuickTurnTimeStamp = pMap.GetTimeStamp();
		mfQuickTurnStartYaw = pCharBody.GetYaw();
		msQuickTurnAnim = GetQuickTurnAnim(mQuickTurnAnimType);
						
		mpMover.PlayAnimation(msQuickTurnAnim, 0.3f, false, false, "");
		mpMover.SetUseMoveStateAnimations(false);
			
		////////////////////
		// Disable player detection
		mBaseObj.SetUpdatePlayerDetection(false);
	}
	
	//------------------------------------------------------------
	
	tString GetQuickTurnAnim(eShotgunnerQuickTurnType aType)
	{
		int lId = int(aType);
		
		tString[] vNormalAnims = { gsShotgunnerAnim_Turn180, gsShotgunnerAnim_Turn90Left, gsShotgunnerAnim_Turn90Right };
		tString[] vFastAnims = { gsShotgunnerAnim_Turn180Quick, gsShotgunnerAnim_Turn90LeftQuick, gsShotgunnerAnim_Turn90RightQuick };
		
		bool bFastTurn = mbRetreat_Active ||
						 mBaseObj.PlayerIsDetected() ||
						 mbShoot_ShootPlayer;
		
		return bFastTurn ? vFastAnims[lId] : vNormalAnims[lId];
	}
	
	//------------------------------------------------------------
	
	void ResetQuickTurn()
	{
		mbPlayQuickTurnAnim = false;
		mBaseObj.SetUpdatePlayerDetection(true);
	}
	
	//------------------------------------------------------------
	
	void UpdatePerceptionMuls(float afTimeStep)
	{
		mfUpdatePerceptionMulsCount -= afTimeStep;
		if (mfUpdatePerceptionMulsCount > 0.f) return;
		
		mfUpdatePerceptionMulsCount = cMath_RandRectf(0.2f, 0.3f);
		
		float fMul = 1.f;
		if (mbReducedPerception)
		{
			fMul = Player_GetCrouching() ? 0.3f : 0.6f;
		}
		
		mfHearingMul = gfShotgunner_SoundRadiusMul * fMul;
		mfProximityDistMul = fMul;
		
		mpSoundListener.SetSoundRadiusMul(mfHearingMul);
		
		for (int i = eShotgunnerProximity_Touching; i < eShotgunnerProximity_LastEnum; ++i)
		{
			float fDistMul = mfProximityDistMul;
			if (i == eShotgunnerProximity_Touching)
				fDistMul = 1.f;
			
			mpProximitySensor.SetStateDistanceMul(i, fDistMul);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateMusic(float afDeltaTime)
	{
		eTerrorMusicStage stage;
		int lCurrentState = mpStateMachine.GetCurrentState();
		
		if (GetSensesActive() == false)									stage = eTerrorMusicStage_None;
		else if (lCurrentState == eShotgunnerState_Dead)				stage = eTerrorMusicStage_None;
		else if (mAlertState == eShotgunnerAlertState_Detected)			stage = eTerrorMusicStage_Hunting;
		else if (mAlertState == eShotgunnerAlertState_Investigating)	stage = eTerrorMusicStage_Searching;
		else															stage = eTerrorMusicStage_Default;
		
		Terror_SetEnemyMusicStage(eTerrorMusicAgentType_Shotgunner, stage);
	}
	
	//------------------------------------------------------------
	
	void UpdatePoem(float afDeltaTime)
	{
		if (mbChantPoem == false) return;
		
		/////////////////
		// Setup vars
		cLuxVoiceHandler@ pVoice = cLux_GetVoiceHandler();
		if (pVoice is null) return;
		
		int lPrio;
		float fMinDist;
		float fMaxDist;
		float fMinTime;
		float fMaxTime;
		int lBarkState = mpBarkMachine.GetCurrentState();
		
		if (lBarkState == eShotgunnerBark_PoemIntro)
		{
			lPrio = 0;
			fMinDist = 1.f;
			fMaxDist = 50.f;
			
			if (mfPoemWaitTime <= 0.f)
				mfPoemWaitTime = cMath_RandRectf(gfShotgunner_PoemMinBetweenTime, gfShotgunner_PoemMaxBetweenTime);
		}
		else if (lBarkState == eShotgunnerBark_PoemEncounter)
		{
			lPrio = 0;
			fMinDist = 1.f;
			fMaxDist = 50.f;
			
			if (mfPoemWaitTime <= 0.f)
				mfPoemWaitTime = cMath_RandRectf(gfShotgunner_PoemMinBetweenTime * 1.75f, gfShotgunner_PoemMaxBetweenTime * 1.75f);
		}
		else
		{
			mfPoemPlayCount = 0.f;
			mfPoemWaitTime = -1.f;
			return;
		}
		
		/////////////////
		// Play voice?
		if (pVoice.CharacterIsSpeaking(gsShotgunner_CharacterName) == false)
		{
			mfPoemPlayCount += afDeltaTime;
			if (mfPoemPlayCount >= mfPoemWaitTime)
			{
				mfPoemPlayCount = 0.f;
				mfPoemWaitTime = -1.f;
				
				/////////////////
				// Get subject depending on health
				int lUnhurtSubjectId = cMath_RandRectl(0, gsShotgunner_PoemSubjectsUnhurt.length() - 1);
				int lHurtSubjectId = cMath_RandRectl(0, gsShotgunner_PoemSubjectsHurt.length() - 1);
				tString sUnhurtSubject = gsShotgunner_PoemSubjectsUnhurt[lUnhurtSubjectId];
				tString sHurtSubject = gsShotgunner_PoemSubjectsHurt[lHurtSubjectId];				
				tString sSubject = mfHealth < 1.f ? sHurtSubject : sUnhurtSubject;
				
				/////////////////
				// Play!
				mpBarkMachine.PlayVoice(sSubject, lPrio, fMinDist, fMaxDist, fMaxDist, mlPoemSubjectLineId);
				
				/////////////////
				// Increase line id
				// (And clear subjects if at end)
				++mlPoemSubjectLineId;
				if (mlPoemSubjectLineId >= pVoice.GetSubjectLineNumber(sSubject))
				{
					mlPoemSubjectLineId = 0;
					
					for (int i = 0; i < gsShotgunner_PoemSubjectsUnhurt.length(); ++i)
						pVoice.ClearSubjectPlayedLines(gsShotgunner_PoemSubjectsUnhurt[i]);
					for (int i = 0; i < gsShotgunner_PoemSubjectsHurt.length(); ++i)
						pVoice.ClearSubjectPlayedLines(gsShotgunner_PoemSubjectsHurt[i]);
				}	
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateColorMul(float afDeltaTime)
	{
		/////////////////////////
		// Darker when far away, to make harder to distinguish from silhouettes
		float fDist = mBaseObj.GetDistanceToPlayer();
		float fDistT = (fDist - gfShotgunner_ColorMulMinDist) / (gfShotgunner_ColorMulMaxDist - gfShotgunner_ColorMulMinDist);
				
		bool bDefaultColor = mpStateMachine.GetCurrentState() == eShotgunnerState_Dead ||
							 Player_GetGasMaskEquipped();
		float fColorMulGoal = bDefaultColor ? 1.f : 1.f - cMath_Clamp(fDistT, 0.f, 1.f);
		
		mfColorMul = cMath_IncreaseTo(mfColorMul, afDeltaTime, fColorMulGoal);
		
		cColor color = cColor(mfColorMul, mfColorMul, mfColorMul, 1.f);
		mBaseObj.GetMeshEntity().SetDiffuseColorMul(color);
	}	
	
	//------------------------------------------------------------
	
	void UpdateRandomShot(float afDeltaTime)
	{		
		//////////////////
		// Setup vars
		cCamera@ pCam = cLux_GetPlayer().GetCamera();
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
		
		if (pCam is null) return;
		if (pCharBody is null) return;
		
		//////////////////
		// Fired recently?
		if (BulletHandler_GetTimeSinceLastBullet() < 15.f)
		{
			return;
		}
		
		//////////////////
		// Count
		mfRandomShotCount -= afDeltaTime;
		if (mfRandomShotCount > 0.f)
		{
			return;
		}
		
		mfRandomShotCount = cMath_RandRectf(0.5f, 1.f);
		
		//////////////////
		// Valid point to shoot at?
		float fDist;
		cVector3f vNrm;
		cVector3f vHitPos = cVector3f(0.f);
		cVector3f vStart = mBaseObj.GetEyePostion();
		cVector3f vDir = cMath_Vector3Normalize(pCharBody.GetForward() + cMath_RandomSphereSurfacePoint(0.2f));
		
		if (cLux_GetClosestBody(vStart, vDir, 30.f, fDist, vNrm) !is null)
		{
			vHitPos = vStart + vDir * fDist;
		}
		
		if (vHitPos.SqrLength() <= 0.f)
			return;
		
		//////////////////
		// Shoot if point is in view
		bool bShoot = pCam.GetFrustum().CollidePoint(vHitPos) &&
					  cLux_CheckLineOfSight(pCam.GetPosition(), vHitPos, false, false);
		
		if (bShoot)
		{
			mfRandomShotCount = cMath_RandRectf(20.f, 30.f);
			
			SetPreBlockedState(mpStateMachine.GetCurrentState());
			
			mbShoot_ReturnToPreBlockedStateAfterShoot = true;
			mbShoot_RandomShot = true;
			mvShoot_Pos = vHitPos;
			mpStateMachine.ChangeState(eShotgunnerState_Shoot);
				
			cLux_AddAIDebugMessage("(" + mBaseObj.GetName() + ") Shoot at pos randomly!", false, true);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdatePlayerScared(float afDeltaTime)
	{
		mfPlayerScaredCount += afDeltaTime;
		if (mfPlayerScaredCount > 1.f)
		{
			mfPlayerScaredCount = 0.f;
			
			float fDist = mBaseObj.GetDistanceToPlayer2D();
			bool bOnScreen = false;
			
			int lCurrentState = mpStateMachine.GetCurrentState();
			if (lCurrentState == eShotgunnerState_Dead ||
				lCurrentState == eShotgunnerState_TeleportRetreat)
			{
				fDist = 1000.f;
			}
			else
			{
				bOnScreen = mBaseObj.CheckIsOnScreen(true);
			}
			
			Player_AddScaredSource(fDist, bOnScreen);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateRunCounter(float afDeltaTime)
	{
		mfRunCount -= afDeltaTime;
		
		eShotgunnerSpeed state = mfRunCount > 0.f ? eShotgunnerSpeed_Run : eShotgunnerSpeed(mlCurrentSpeedState);
		if (mpMover.GetSpeedState() != state)
		{
			mpMover.SetSpeedState(state);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateIgnorePlayerPathBlocker(float afDeltaTime)
	{
		if (!mbRetreat_PlayerBlocksPath) return;
		
		tID idBlocker = Blackboard_GetPlayerPathBlockerBodyId();
		iPhysicsBody@ pBody = cLux_ID_Body(idBlocker);
		cBoundingVolume@ pBodyBV = pBody !is null ? pBody.GetBoundingVolume() : null;
		cBoundingVolume@ pAgentBV = mBaseObj.GetCharBody().GetCurrentBody().GetBoundingVolume();
		
		if (pBodyBV is null) return;
		if (pAgentBV is null) return;
		
		if (cMath_CheckAABBIntersection(pAgentBV.GetMin(), pAgentBV.GetMax(), pBodyBV.GetMin(), pBodyBV.GetMax()))
		{
			mpPathfinder.RemovePathBlockerBody(idBlocker);
		}
		else
		{
			mpPathfinder.AddPathBlockerBody(idBlocker);
		}
	}
	
