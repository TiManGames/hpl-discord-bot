	/////////////////////////////////////////
	// GENERAL
	//{///////////////////////////////////////

	//------------------------------------------------------------
	
	void OnUpdate(float afTimeStep)
	{
		cScrAgentHumanoid::OnUpdate(afTimeStep);
		if (mBaseObj.IsActive() == false) return;
		
		/////////////////////
		// Setup shotgun
		if (mbSetupShotgun == false)
		{
			mbSetupShotgun = true;
			SetupShotgun();
		}
		
		UpdateObstacles(afTimeStep);
		UpdatePlayerPrediction(afTimeStep);
		UpdateHitByProp(afTimeStep);
		UpdateNoCollisionBodies(afTimeStep);
		UpdateQuickTurn(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void OnVariableUpdate(float afDeltaTime)
	{
		UpdatePerceptionMuls(afDeltaTime);
		UpdateMusic(afDeltaTime);
		UpdatePoem(afDeltaTime);
		UpdateColorMul(afDeltaTime);
		UpdateRunCounter(afDeltaTime);
		UpdatePlayerScared(afDeltaTime);
		UpdateIgnorePlayerPathBlocker(afDeltaTime);
	}
	
	//------------------------------------------------------------
	
	void OnAfterAnimationUpdate(cMeshEntity@ apFunctions, float afTimeStep)
	{
		Shoot_UpdateAiming(afTimeStep);
	}
	
	//------------------------------------------------------------

	void ResetProperties()
	{
		cScrAgentHumanoid::ResetProperties();
		
		msAnimState = "";
		
		mbIsInLiquid = false;		
		mbPlayerSubmerged = false;
		
		mfPlayerScaredCount = 0.f;		
		mbLastHitByPropThrownByPlayer = false;		
		mfNoCollisionBodiesUpdateCount = 0.2f;
		
		mfIgnorePathBlockerCount = 0.f;
		mfUpdatePerceptionMulsCount = 0.f;
		
		mHurt_DamageType = eDamageType_Gun;
		msHurt_HurtAnim = "";
	}

	//------------------------------------------------------------

	void OnSetActive(bool abX)
	{
		cScrAgentHumanoid::OnSetActive(abX);
		
		tID id = mBaseObj.GetID();
		
		if (abX)
		{
			Blackboard_AddEnemy(id);
			SetReducedPerceptionActive(Blackboard_GetReducedEnemyPerceptionActive());
		}
		else
		{
			Blackboard_RemoveEnemy(id);
			Terror_RemoveHuntingEnemy(id);
			Terror_RemoveEnemy(id);
			Terror_SetEnemyMusicStage(eTerrorMusicAgentType_Shotgunner, eTerrorMusicStage_None);
			Player_AddScaredSource(0.f, false);
			
			mbRetreat_Active = false;
		}
		
		iLuxEntity@ pShotgun = cLux_ID_Entity(m_idShotgunEnt);
		if (pShotgun !is null)
		{
			pShotgun.SetActive(abX);
		}
	}
	
