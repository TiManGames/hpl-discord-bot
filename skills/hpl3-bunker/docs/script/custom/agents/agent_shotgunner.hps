	/////////////////////////////////////////
	// DEBUG
	//{//////////////////////////////////////

	//------------------------------------------------------------

	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont, float afStartY)
	{
		if (Blackboard_GetAgentCount() > 4) 
			return afStartY;
		
		afStartY += 10.f;

		afStartY = cLux_DrawDebugText("Player distance: " + mBaseObj.GetDistanceToPlayer(), afStartY);
		afStartY = cLux_DrawDebugText("Stuck: " + mpMover.GetStuckCounter(), afStartY);
		afStartY = cLux_DrawDebugText("Senses active: " + GetSensesActive(), afStartY);
		afStartY = cLux_DrawDebugText("Reduced perception: " + mbReducedPerception, afStartY);
		afStartY = cLux_DrawDebugText("Speed state: " + SpeedStateToString(mpMover.GetSpeedState()), afStartY);
		afStartY = cLux_DrawDebugText("Speed: " + mBaseObj.GetCharBody().GetMoveSpeed(eCharDir_Forward), afStartY);
		afStartY = cLux_DrawDebugText("Animations: ", afStartY);
		
		cMeshEntity@ pMeshEnt = mBaseObj.GetMeshEntity();		
		for (int i = 0; i < pMeshEnt.GetAnimationStateNum(); ++i)
		{
			cAnimationState@ pState = pMeshEnt.GetAnimationState(i);
			if (pState.IsActive())
			{
				afStartY = cLux_DrawDebugText("   " + pState.GetName() + ", time: " + pState.GetRelativeTimePosition() + ", speed: " + pState.GetSpeed() + ", weight: " + pState.GetWeight(), afStartY);
			}
		}

		return afStartY;
	}

	//------------------------------------------------------------	
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		int lState = mpStateMachine.GetCurrentState();
		
		apFunctions.GetLowLevelGfx().DrawSphere(mBaseObj.GetPosition(), 1.f, cColor_Green);
		
		if (lState == eShotgunnerState_Shoot)
		{
			iCharacterBody@ pCharBody = mBaseObj.GetCharBody();
			
			float fDist = (mvShoot_Pos - mBaseObj.GetPosition()).Length();
			float fAccuracy = 1.f - Shoot_GetAccuracyMul();
			
			cVector3f vDir = cMath_Vector3Normalize(mvShoot_Pos - mBaseObj.GetPosition());
			cVector3f vDirA = cMath_Vector3Normalize(cMath_MatrixMul(cMath_MatrixRotateY(gfShotgunner_AccuracyOffsetMin * fAccuracy), vDir));
			cVector3f vDirB = cMath_Vector3Normalize(cMath_MatrixMul(cMath_MatrixRotateY(gfShotgunner_AccuracyOffsetMax * fAccuracy), vDir));			
			
			cVector3f vStart = mBaseObj.GetPosition();
			cVector3f vEndA = vStart + vDirA * fDist;
			cVector3f vEndB = vStart + vDirB * fDist;
			
			apFunctions.GetLowLevelGfx().DrawLine(vStart, vEndA, cColor_Red);
			apFunctions.GetLowLevelGfx().DrawLine(vStart, vEndB, cColor_Red);
			
			if (mvShoot_Pos.SqrLength() > 0.f)
			{
				apFunctions.GetLowLevelGfx().DrawLine(vStart, mvShoot_Pos, cColor_White);
				apFunctions.GetLowLevelGfx().DrawSphere(mvShoot_Pos, 0.25f, cColor_White);
			}
		}
	}
	
	//------------------------------------------------------------

	//} END DEBUG
}