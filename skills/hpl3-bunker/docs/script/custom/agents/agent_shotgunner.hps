	tString SpeedStateToString(int alState)
	{
		switch (alState)
		{
			case eShotgunnerSpeed_Walk: return "Walk";
			case eShotgunnerSpeed_Run: return "Run";
			case eShotgunnerSpeed_Stopped: return "Stopped";
		}
		
		return "";
	}
	
	//------------------------------------------------------------
	
	tString StateToString(int alState)
	{
		switch (alState)
		{
			case eShotgunnerState_Idle: return "Idle";
			case eShotgunnerState_Patrol: return "Patrol";
			case eShotgunnerState_InvestigateSound: return "InvestigateSound";
			case eShotgunnerState_DetectPlayer: return "DetectPlayer";
			case eShotgunnerState_Shoot: return "Shoot";
			case eShotgunnerState_Retreat: return "Retreat";
			case eShotgunnerState_InvestigatePos: return "InvestigatePos";
			case eShotgunnerState_Hurt: return "Hurt";
			case eShotgunnerState_Dead: return "Dead";
			case eShotgunnerState_Stunned: return "Stunned";
			case eShotgunnerState_Blocked: return "Blocked";
			case eShotgunnerState_EvaluateObstacle: return "EvaluateObstacle";
			case eShotgunnerState_Debug: return "Debug";
			case eShotgunnerState_TeleportRetreat: return "TeleportRetreat";
		}
		
		return "";
	}
	
	//------------------------------------------------------------
	
	tString ProximityStateToString(int alState)
	{
		switch (alState)
		{
			case eShotgunnerProximity_Touching: return "Touching";
			case eShotgunnerProximity_Close: return "Close";
			case eShotgunnerProximity_Medium: return "Mid";
			case eShotgunnerProximity_Far: return "Far";
		}
		
		return "";
	}

