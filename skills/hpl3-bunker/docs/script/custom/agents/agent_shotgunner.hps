//----------------------------------------------------------------------

class cScrAgentShotgunner : cScrAgentHumanoid
{
	//===========================================================

	/////////////////////////////////////////
	//=======================================
	// MAIN FUNCTIONS
	//=======================================
	//{//////////////////////////////////////
	
	//===========================================================

	//------------------------------------------------------------

	/////////////////////////////////////////
	// INIT
	//{//////////////////////////////////////

	//------------------------------------------------------------

	void Init()
	{
		mBaseObj.SetUpdatePlayerDetection(true);
		mBaseObj.SetCheckForDoors(false);
		mBaseObj.SetAnimationCallbackActive(true);
		
		mvRouteBlockerSets.resize(0);
		mvDoorIds.resize(0);
	}
	
	//------------------------------------------------------------

	//} END INIT

	//------------------------------------------------------------

	/////////////////////////////////////////
	// LOADING
	//{//////////////////////////////////////

	//------------------------------------------------------------

	void SetupCharBody()
	{
		cScrAgentHumanoid::SetupCharBody();
		iCharacterBody@ pCharBody = mBaseObj.GetCharBody();

		pCharBody.SetMass(80.f);
		pCharBody.SetMaxPositiveMoveSpeed(eCharDir_Forward, 1.f);
		pCharBody.SetMoveSpeedMul(eCharDir_Forward,1.f);
		pCharBody.SetMoveAcc(eCharDir_Forward, 4.f);
		pCharBody.SetMoveDeacc(eCharDir_Forward, 8.f);
		pCharBody.SetMaxPushMass(20.f);
		pCharBody.SetMaxPushForce(300.f);
		pCharBody.SetAccurateClimbing(true);
		pCharBody.SetCollideCharacter(false);		
		pCharBody.SetupSafePositions(0.25f, 5.f);
	}

	//------------------------------------------------------------

	void SetupAfterLoad(cWorld@ apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		cScrAgentHumanoid::SetupAfterLoad(apWorld, apVars, apInstanceVars);
		
		//////////////////////
		// General		
		mBaseObj.SetAlignEntityWithGroundRay(true);
		mBaseObj.SetFOV(cMath_ToRad(0.f));
		mBaseObj.SetSightRange(0.f);
		mBaseObj.SetSightRangeMul(0.f);
		mBaseObj.SetRelativeEyeHeight(0.8f);
		
		//////////////////////
		// Pathfinder
		mpPathfinder.SetNodeContainerName("Shotgunner");
		mpPathfinder.SetMaxHeight(0.8f);
		mpPathfinder.SetDirectPathMaxDistanceMul(0.5f);
		mpPathfinder.SetMaxEdgeDistance(3.f);		
		mpPathfinder.SetMaxGoalsPerIsland(4);
		mpPathfinder.Debug_SetRenderPathBlockerBodies(true);
		
		//////////////////////
		// Vars
		msRetreatAreas = apInstanceVars.GetVarString("RetreatAreas", "");
		
		//////////////////////
		// Components
		SetupComponents(apWorld, apVars, apInstanceVars);
		
		//////////////////////
		// Take environmental damage
		EnvironmentalDamage_AddEntityToCheck(mBaseObj.GetID());
		
		////////////
		// Preload
		ParticleSystem_Preload("rifle_fire.ps");
		cLux_PreloadEntity(gsShotgunner_ShotgunEntity);
		cLux_PreloadEntity(gsShotgunner_ShotgunPickupEntity);
		cLux_PreloadEntity(gsShotgunner_BloodStainEntity);
	}

	//------------------------------------------------------------

	void SetupComponents(cWorld@ apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars)
	{
		//////////////////////
		// State machine
		@mpStateMachine = cLux_CreateEntityComponent_StateMachine(mBaseObj);
		
		mpStateMachine.AddState("Idle", eShotgunnerState_Idle);
		mpStateMachine.AddState("Patrol", eShotgunnerState_Patrol);
		mpStateMachine.AddState("InvestigateSound", eShotgunnerState_InvestigateSound);
		mpStateMachine.AddState("DetectPlayer", eShotgunnerState_DetectPlayer);
		mpStateMachine.AddState("Shoot", eShotgunnerState_Shoot);
		mpStateMachine.AddState("Retreat", eShotgunnerState_Retreat);
		mpStateMachine.AddState("InvestigatePos", eShotgunnerState_InvestigatePos);
		mpStateMachine.AddState("Stunned", eShotgunnerState_Stunned);
		mpStateMachine.AddState("Hurt", eShotgunnerState_Hurt);
		mpStateMachine.AddState("Dead", eShotgunnerState_Dead);
		mpStateMachine.AddState("EvaluateObstacle", eShotgunnerState_EvaluateObstacle);
		mpStateMachine.AddState("Blocked", eShotgunnerState_Blocked);
		mpStateMachine.AddState("Debug", eShotgunnerState_Debug);
		mpStateMachine.AddState("TeleportRetreat", eShotgunnerState_TeleportRetreat);
		
		//////////////////////
		// Listener
		@mpSoundListener = cLux_CreateEntityComponent_SoundListener(mBaseObj);
		mpSoundListener.LoadFromInstanceVariables(apInstanceVars);
		mpSoundListener.SetSoundRadiusMul(mfHearingMul);
		
		//////////////////////
		// Head tracker
		@mpHeadTracker = cLux_CreateEntityComponent_HeadTracker(mBaseObj);
		mpHeadTracker.LoadFromVariables(apVars);
		
		//////////////////////
		// Foot placement
		@mpFootPlacement = cLux_CreateEntityComponent_FootPlacement(mBaseObj);
		mpFootPlacement.LoadFromVariables(apVars);

		//////////////////////
		// Proximity sensor
		float fProximityTouchingEnterDist;
		float fProximityTouchingLeaveDist;
		float fProximityCloseEnterDist;
		float fProximityCloseLeaveDist;
		float fProximityMediumEnterDist;
		float fProximityMediumLeaveDist;
		float fProximityFarEnterDist;
		float fProximityFarLeaveDist;
		
		switch (GameDifficulty_GetSettingValueByID_Int(eGameDifficultySetting_ShotgunnerReactivity))
		{
			case eDifficultySettingValue_ShotgunnerReactivity_Low:
			{
				fProximityTouchingEnterDist = 1.5f;
				fProximityTouchingLeaveDist = 1.9f;
				fProximityCloseEnterDist = 2.f;
				fProximityCloseLeaveDist = 2.5f;
				fProximityMediumEnterDist = 2.6f;
				fProximityMediumLeaveDist = 3.5f;
				fProximityFarEnterDist = 12.f;
				fProximityFarLeaveDist = 12.9f;
				break;
			}
			case eDifficultySettingValue_ShotgunnerReactivity_Default:
			{
				fProximityTouchingEnterDist = 2.f;
				fProximityTouchingLeaveDist = 2.9f;
				fProximityCloseEnterDist = 3.f;
				fProximityCloseLeaveDist = 3.9f;
				fProximityMediumEnterDist = 4.5f;
				fProximityMediumLeaveDist = 5.4f;
				fProximityFarEnterDist = 12.f;
				fProximityFarLeaveDist = 12.9f;
				break;
			}
			case eDifficultySettingValue_ShotgunnerReactivity_High:
			{
				fProximityTouchingEnterDist = 2.25f;
				fProximityTouchingLeaveDist = 3.0f;
				fProximityCloseEnterDist = 3.1f;
				fProximityCloseLeaveDist = 4.25f;
				fProximityMediumEnterDist = 5.0f;
				fProximityMediumLeaveDist = 6.0f;
				fProximityFarEnterDist = 12.f;
				fProximityFarLeaveDist = 12.9f;
				break;
			}
		}
		
		@mpProximitySensor = cLux_CreateEntityComponent_ProximitySensor(mBaseObj);		
		mpProximitySensor.AddState(eShotgunnerProximity_Touching, fProximityTouchingEnterDist, fProximityTouchingLeaveDist, true, false);		
		mpProximitySensor.AddState(eShotgunnerProximity_Close, fProximityCloseEnterDist, fProximityCloseLeaveDist, true, false);
		mpProximitySensor.AddState(eShotgunnerProximity_Medium, fProximityMediumEnterDist, fProximityMediumLeaveDist, true, false);		
		mpProximitySensor.AddState(eShotgunnerProximity_Far, fProximityFarEnterDist, fProximityFarLeaveDist, true, false);
		
		for (int i = eShotgunnerProximity_Touching; i < eShotgunnerProximity_LastEnum; ++i)
		{
			mpProximitySensor.SetStateDistanceMul(i, mfProximityDistMul);
		}
		
		//////////////////////
		// Bark Machine
		@mpBarkMachine = cLux_CreateEntityComponent_BarkMachine(mBaseObj);
		mpBarkMachine.SetupVoice(gsShotgunner_CharacterName, true, 1.f, 45.f, 45.f); 
		
		mpBarkMachine.AddState(eShotgunnerBark_Silent);		
		mpBarkMachine.AddState(eShotgunnerBark_PoemIntro);	
		mpBarkMachine.AddState(eShotgunnerBark_PoemEncounter);		
		mpBarkMachine.AddState(eShotgunnerBark_Search);
		mpBarkMachine.AddState(eShotgunnerBark_Hurt);
		mpBarkMachine.AddState(eShotgunnerBark_Dead);
		
		//////////////////////
		// Char mover
		mpMover.SetupWallAvoidance(0.9f, 5.f, 4);
		mpMover.SetWallAvoidanceActive(true);
		mpMover.SetupDynamicObjectAvoidance(2.5f, 20.f, 5);
		mpMover.SetDynamicObjectAvoidanceActive(false);		
		mpMover.SetDynamicObjectPlayerAvoidanceActive(false);
		mpMover.SetupDynamicObjectPlayerAvoidance(4.f, 3);
		mpMover.SetRunToWalkSpeed(1.6f);
		mpMover.SetWalkToRunSpeed(3.f);
		mpMover.SetStoppedToWalkSpeed(0.05f);
		mpMover.SetWalkToStoppedSpeed(0.1f);
		mpMover.SetStoppedToWalkTurnAnimSpeed(1.f);
		mpMover.SetTurnMinBreakAngle(cMath_ToRad(40.f));
		mpMover.SetTurnMinPlayAnimAngle(cMath_ToRad(40.f));
		
		mpMover.AddSpeedState(eShotgunnerSpeed_Walk);
			mpMover.SetSpeedState_Forward(1.f);
			mpMover.SetSpeedState_Backward(1.f);
			mpMover.SetSpeedState_ForwardAcc(10.f);
			mpMover.SetSpeedState_ForwardDeacc(10.f);
			mpMover.SetSpeedState_TurnMaxSpeed(20.f);
			mpMover.SetSpeedState_TurnSpeedMul(4.f);
			mpMover.SetSpeedState_TurnSpeedAcc(10.f);
			mpMover.SetSpeedState_TurnSpeedDeacc(12.f);
			mpMover.SetSpeedState_TurnBreakMul(0.25f);
		
		mpMover.AddSpeedState(eShotgunnerSpeed_Run);
			mpMover.SetSpeedState_Forward(4.4f);
			mpMover.SetSpeedState_ForwardAcc(10.f);
			mpMover.SetSpeedState_ForwardDeacc(10.f);
			mpMover.SetSpeedState_TurnMaxSpeed(20.f);
			mpMover.SetSpeedState_TurnSpeedMul(4.f);
			mpMover.SetSpeedState_TurnSpeedAcc(10.f);
			mpMover.SetSpeedState_TurnSpeedDeacc(12.f);
			mpMover.SetSpeedState_TurnBreakMul(0.25f);

		mpMover.AddSpeedState(eShotgunnerSpeed_Stopped);
			mpMover.SetSpeedState_Forward(0.f);
			mpMover.SetSpeedState_Backward(0.f);
			mpMover.SetSpeedState_TurnMaxSpeed(40.f);
			mpMover.SetSpeedState_TurnSpeedMul(8.f);
			mpMover.SetSpeedState_TurnSpeedAcc(20.f);
			mpMover.SetSpeedState_TurnSpeedDeacc(20.f);
			
		mpMover.SetStopMovementDuringNonLocomotionAnim(true);
		
		// TODO: Add visemes, emotions and gestures as locomotion anims when setting up the CharMover instead
		cMeshEntity@ pMeshEnt = mBaseObj.GetMeshEntity();
		if (pMeshEnt !is null)
		{
			for (int i = 0; i < pMeshEnt.GetAnimationStateNum(); ++i)
			{
				cAnimationState@ pAnim = pMeshEnt.GetAnimationState(i);
				tString sName = pAnim !is null ? pAnim.GetName() : "";
				
				if (pAnim is null) continue;
				if (cString_GetFirstStringPos(sName, "Viseme") == -1) continue;
				
				mpMover.AddLocomotionAnim(sName);
			}
		}
	}

	//------------------------------------------------------------

	void OnAfterWorldLoad()
	{
		cScrAgentHumanoid::OnAfterWorldLoad();
		
		/////////////////////
		// Add to blackboard
		if (mBaseObj.IsActive())
		{
			Blackboard_AddEnemy(mBaseObj.GetID());			
		}
		
		/////////////////////
		// Retreat areas
		if (msRetreatAreas != "")
		{
			mBaseObj.GetMap().GetEntityArrayID(msRetreatAreas, eLuxEntityType_Area, "", mvRetreatAreaIds);
		}
		
		/////////////////////
		// Light flash
		iLight@ pLight = mBaseObj.GetLightFromName("Light_Spot_1");
		if (pLight !is null)
		{
			m_idLightFlash = pLight.GetID();
			pLight.SetBrightness(0.f);
		}
	}
	
	//------------------------------------------------------------
	
	void SetupShotgun()
	{
		/////////////////////
		// Create prop
		cLuxMap@ pMap = mBaseObj.GetMap();
		if (pMap is null) return;
		
		pMap.ResetLatestEntity();
		pMap.CreateEntity("Shotgun", gsShotgunner_ShotgunEntity, cMatrixf_Identity, mBaseObj.GetOnLoadScale());
		
		cLuxProp@ pShotgun = cLux_ToProp(pMap.GetLatestEntity());
		if (pShotgun !is null)
		{
			m_idShotgunEnt = pShotgun.GetID();
			
			pShotgun.SetFullGameSave(false);
			pShotgun.SetScriptableIsSaved(false);
			pShotgun.StopAllAnimations(0.f);
			
			iPhysicsBody@ pMuzzleBody = pShotgun.GetBodyFromName("Body_2");
			m_idShotgunMuzzleBody = pMuzzleBody !is null ? pMuzzleBody.GetID() : tID_Invalid;
			
			/////////////////////
			// Disable collision with hands
			uint lFlagShotgun = mBaseObj.GetMap().GetCollideFlag("+shotgun");
			uint lFlagHands = mBaseObj.GetMap().GetCollideFlag("-shotgun");
			
			for (int i = 0; i < pShotgun.GetBodyNum(); ++i)
			{
				pShotgun.GetBody(i).SetCollideFlags(lFlagShotgun);
			}
			
			mBaseObj.GetRagdollBodyFromName("Body_Hand_Left").SetCollideFlags(lFlagHands);
			mBaseObj.GetRagdollBodyFromName("Body_Hand_Right").SetCollideFlags(lFlagHands);
			
			/////////////////////
			// Attach it!
			SetAttachShotgun(true);
			
			/////////////////////
			// Ignore it as obstacle!
			EvaluateObstacle_AddIgnoredProp(m_idShotgunEnt);
		}
		
		/////////////////////
		// Deactivate?
		if (mBaseObj.IsActive() == false)
		{
			pShotgun.SetActive(false);
		}
	}
	
	//------------------------------------------------------------
	
	void OnMapEnter()
	{
		EnvironmentalDamage_AddEntityToCheck(mBaseObj.GetID());
		
		///////////
		// Reduced perception
		SetReducedPerceptionActive(Blackboard_GetReducedEnemyPerceptionActive());
	}
	
	//------------------------------------------------------------

	void OnMapLeave()
	{
		EnvironmentalDamage_RemoveEntityToCheck(mBaseObj.GetID());
	}

	//------------------------------------------------------------
	
	void BeforeEntityDestruction()
	{
		EnvironmentalDamage_RemoveEntityToCheck(mBaseObj.GetID());
	}
	
	//------------------------------------------------------------

	//} END LOADING

