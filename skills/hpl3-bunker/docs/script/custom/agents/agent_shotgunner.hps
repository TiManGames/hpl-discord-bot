	void SetShotgunBulletsVisible(bool abX)
	{
		cLuxProp@ pShotgun = cLux_ID_Prop(m_idShotgunEnt);
		cMeshEntity@ pMeshEnt = pShotgun !is null ? pShotgun.GetMeshEntity() : null;
		if (pShotgun is null) return;
		
		for (int i = 0; i < gsShotgunner_ShotgunBulletSubmeshes.length(); ++i)
		{
			cSubMeshEntity@ pSubMesh = pMeshEnt.GetSubMeshEntityName(gsShotgunner_ShotgunBulletSubmeshes[i]);
			if (pSubMesh is null) continue;
			
			pSubMesh.SetVisible(abX);
		}		
	}
	
