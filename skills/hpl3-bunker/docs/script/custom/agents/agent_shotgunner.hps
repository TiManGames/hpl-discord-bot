//----------------------------------------------------------------------

enum eShotgunnerState
{
	eShotgunnerState_Idle,
	eShotgunnerState_Patrol,
	eShotgunnerState_InvestigateSound,
	eShotgunnerState_DetectPlayer,
	eShotgunnerState_Shoot,
	eShotgunnerState_Retreat,
	eShotgunnerState_InvestigatePos,
	eShotgunnerState_Stunned,
	eShotgunnerState_Hurt,
	eShotgunnerState_Dead,
	eShotgunnerState_EvaluateObstacle,
	eShotgunnerState_Blocked,
	eShotgunnerState_Debug,
	eShotgunnerState_TeleportRetreat
}

//----------------------------------------------------------------------

enum eShotgunnerProximity
{
	eShotgunnerProximity_Touching,
	eShotgunnerProximity_Close,
	eShotgunnerProximity_Medium,
	eShotgunnerProximity_Far,
	eShotgunnerProximity_LastEnum
}

//----------------------------------------------------------------------

enum eShotgunnerQuickTurnType
{
	eShotgunnerQuickTurnType_TurnAround = 0,
	eShotgunnerQuickTurnType_Left = 1,
	eShotgunnerQuickTurnType_Right = 2,
}

//----------------------------------------------------------------------

enum eShotgunnerAlertState
{
	eShotgunnerAlertState_None,
	eShotgunnerAlertState_Investigating,
	eShotgunnerAlertState_Detected
}

