#include "PlayerState_UsingThrowable.hps"

//------------------------------------------------------------

class cScrPlayerState_UsingMolotovCocktail : cScrPlayerState_UsingThrowable
{
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init() override
	{
		cScrPlayerState_UsingThrowable::Init();

		mfThrowableMinPitch = cMath_ToRad(-70.f);
		mfThrowableMaxPitch = cMath_ToRad(30.f);
		mfThrowablePitchFadeTime = 0.25f;
		mfMaxThrowDelay = 1.0f;

		msFocusIntroAnim_L = "tool_molotov_focus_start_larm";
		msFocusIntroAnim_R = "tool_molotov_focus_start_rarm";
		msFocusLoopAnim_L = "tool_molotov_focus_idle_larm";
		msFocusLoopAnim_R = "tool_molotov_focus_idle_rarm";
		msFocusOutroAnim_L = "tool_molotov_focus_end_larm";
		msFocusOutroAnim_R = "tool_molotov_focus_end_rarm";
		msThrowAnim_L = "tool_molotov_throw_larm";
		msThrowAnim_R = "tool_molotov_throw_rarm";
		msThrowAnim_Lighter = "lighter_molotov_throw";
		msThrowAnim_Head = "tool_molotov_throw_head";

		msFocusIntroAnim_Item = "idle";
		msFocusLoopAnim_Item = "idle";
		msFocusOutroAnim_Item = "idle";
		msThrowAnim_Item = "throw";

		msThrowEnt = "molotov_cocktail_thrown.ent";
		
		mbUsesOtherHandAnims = true;
		mbUsesLighter = true;
		
		mfEquipLastItemOnLeaveDelay = 0.7f;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep) override
	{
		cScrPlayerState_UsingThrowable::Update(afTimeStep);
		
		////////////////////////
		// Handle fire effects
		if (mlAnimState == eUsingItemAnimState_Use)
		{
			if (mbLit == false && mfThrowDelay > 0.5f)
			{
				mbLit = true;
				iLuxEntity@ pMolotovEnt = cLux_ID_Entity(m_idItemEntity);
				if (pMolotovEnt is null) return;
				
				iLight@ pFireLight = pMolotovEnt.GetLightFromName("Light_Fire");
				if (pFireLight !is null)
				{
					pFireLight.SetBrightness(3.f);
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ThrowProp(const tString &in asThrowEnt)
	{
		cScrPlayerState_UsingThrowable::ThrowProp(asThrowEnt);
		GameStats_IncreaseEntryAmount(eHeroStats_PetrolBombsThrown);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbLit = false;
		
	//------------------------------------------------------------
}