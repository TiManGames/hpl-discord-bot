	array<tID> mvRollerIds;

	array<float> mvRollerGlowAmounts;

	array<int> mvCombination;
	tString msDoorEntity;
	tString msCombination;
	
	int mlRollerIndex;
	bool mbExit;
	bool mbOpenDoorEntityOnUnlock;

	float fRollerSwitchCooldown = 0;

	float mfRotationSpeed;

	bool mbForceFace = false;
	int mlForceFace = 0;
	
	float mfScrollUpdateTimer = 0;
	//------------------------------------------------------------
		
}