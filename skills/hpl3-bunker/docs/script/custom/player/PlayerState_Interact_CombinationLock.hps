	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY)
	{
		afStartY = cLux_DrawDebugText("Current: " + mlRollerIndex, afStartY);
		afStartY = cLux_DrawDebugText("Force face: " + mbForceFace, afStartY);
		afStartY = cLux_DrawDebugText("Force face: " + mlForceFace, afStartY);

		for(int i = 0; i < mvRollerIds.size(); ++i)
		{
			afStartY = cLux_DrawDebugText("Roller " + i + " face: " + GetRollerFace(i), afStartY);
		}
		return afStartY;
	}
	
