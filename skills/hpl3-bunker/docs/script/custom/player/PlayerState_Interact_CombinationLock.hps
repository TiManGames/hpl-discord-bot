	/////////////////////////////////////////
	// HELPER METHODS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ChangeRollerIndex(int alInc)
	{
		mbForceFace = false;
		mlRollerIndex += alInc;
		if(mlRollerIndex < 0)
			mlRollerIndex = mvRollerIds.size() - 1;
		if(mlRollerIndex > mvRollerIds.size() - 1)
			mlRollerIndex = 0;
	}
	
	void CombinationScroll(bool abDown)
	{
		if(mbForceFace)
			mlForceFace = abDown ? mlForceFace+1 : mlForceFace-1;
		else
			mlForceFace = abDown ? GetRollerFace(mlRollerIndex) + 1 : GetRollerFace(mlRollerIndex) - 1;
			
		mbForceFace = true;
		cLuxProp@ pProp = cLux_ID_Prop(mPropID);
		Sound_CreateAtEntity("Sound_CombinationLock_Turn", "level_entity_shared/doors/combination_lock/turn", pProp.GetName(), 1.f, false);
	}
	
