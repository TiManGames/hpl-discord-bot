#include "PlayerState_UsingThrowable.hps"

//------------------------------------------------------------

class cScrPlayerState_UsingEmptyBottle : cScrPlayerState_UsingThrowable
{
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init() override
	{
		cScrPlayerState_UsingThrowable::Init();
		
		mfThrowableMinPitch = cMath_ToRad(-70.f);
		mfThrowableMaxPitch = cMath_ToRad(30.f);
		mfThrowablePitchFadeTime = 1.0f;
		mfMaxThrowDelay = 1.0f;

		msFocusIntroAnim_R = "tool_bottle_focus_start";
		msFocusLoopAnim_R = "tool_bottle_focus_idle";
		msFocusOutroAnim_R = "tool_bottle_focus_end";
		msThrowAnim_R = "tool_bottle_throw";
		msThrowAnim_Head = "tool_bottle_throw_head";
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap) 
	{
		/////////////
		// Preload
		Entity_Preload("full_bottle_thrown.ent");
		Entity_Preload("empty_bottle_thrown.ent");
	}

	void OnMapLeave(cLuxMap @apMap) {}
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap @apMap) {}	
	void DestroyWorldEntities(cLuxMap @apMap) {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{	
		////////////////
		// Enter base
		cScrPlayerState_UsingThrowable::OnEnterState(alPrevStateId);			
		msThrowEnt = msItemType == "FuelBottle" ? "full_bottle_thrown.ent" : "empty_bottle_thrown.ent";
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnUse() 
	{
		iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
		
		///////////////////////////////////////////////
		// If the item can be used on things in the map
		cCamera @pCam = mBaseObj.mpPlayer.GetCamera();
		if(mPickBasics.UpdatePickCheck(pCam, false))
		{
			if (pHandler.CanUseHeldItemOnWorld(eItemHandlerHand_Right, mPickBasics.GetFocusedEntity().GetName()))
			{
				Item_UseHeldOnWorld(eItemHandlerHand_Right, mPickBasics.GetFocusedEntity().GetName());
				return;
			}
		}
		
		cScrPlayerState_UsingThrowable::OnUse();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	//------------------------------------------------------------
}