#include "custom/player/PlayerState_UsingWeapon_Aim_Base.hps"
#include "helpers/helper_effects.hps"

//------------------------------------------------------------

const tString gsUsingShotgun_RightHandBone = "j_R_Arm_Zero";
const tString gsUsingShotgun_LeftHandBone = "j_L_Arm_Zero";

const int glShotgun_PelletCount = 9;

//------------------------------------------------------------

const tString gsUsingShotgun_Aim_GunIdleAnim = "shotgun_aim_idle";
const tString gsUsingShotgun_Aim_GunShootEmptyAnim = "shotgun_fire_empty";
const tString[] gvUsingShotgun_Aim_GunShootAnim = { "shotgun_fire_shell_01", "shotgun_fire_shell_02", "shotgun_fire_shell_03" };

const tString gsUsingShotgun_Aim_PlayerShootEmptyRAnim = "player_shotgun_fire_empty_rarm";
const tString gsUsingShotgun_Aim_PlayerShootEmptyLAnim = "player_shotgun_fire_empty_larm";
const tString gsUsingShotgun_Aim_PlayerShootEmptyHeadAnim = "";

const tString[] gvUsingShotgun_Aim_PlayerShootRAnim = { "player_shotgun_fire_shell_01_rarm", "player_shotgun_fire_shell_02_rarm", "player_shotgun_fire_shell_03_rarm" };
const tString[] gvUsingShotgun_Aim_PlayerShootLAnim = { "player_shotgun_fire_shell_01_larm", "player_shotgun_fire_shell_02_larm", "player_shotgun_fire_shell_03_larm" };
const tString[] gvUsingShotgun_Aim_PlayerHeadShootAnim = { "player_head_shotgun_fire_shell_01", "player_head_shotgun_fire_shell_02", "player_head_shotgun_fire_shell_03" };

const tString gsUsingShotgun_Aim_ShootLargeRoomSound = "weapons/shotgun/fire_large_room";
const tString gsUsingShotgun_Aim_ShootMediumRoomSound = "weapons/shotgun/fire_med_room";
const tString gsUsingShotgun_Aim_ShootSmallRoomSound = "weapons/shotgun/fire_small_room";
const tString gsUsingShotgun_Aim_ShootExteriorSound = "weapons/shotgun/fire_exterior";
const tString gsUsingShotgun_Aim_ShootEarRingFireSound = "weapons/shotgun/gunshot_muffled";
const tString gsUsingShotgun_Aim_ShootDryFireSound = "weapons/shotgun/dry_fire";

//------------------------------------------------------------

class cScrPlayerState_UsingShotgun_Aim : iScrPlayerState_UsingWeapon_Aim_Base
{
	//------------------------------------------------------------
			
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init() override
	{
		mlBulletType = eBulletType_Shotgun;
		msWeaponType = "Shotgun";
		msItemPrompt = "FireWeapon";
		mbAllowUsingLantern = false;
		mbUsesOtherHandAnims = true;
		mlDefaultCrossHairState = -1;
		mfShootCooldown = 0.85;
		
		msAimIntroAnim = "";
		msAimLoopAnim = "";
		msAimOutroAnim = "";	
		msAimDualIntroLAnim = "player_shotgun_idle_one_handed_tr_aim_idle_larm";
		msAimDualIntroRAnim = "player_shotgun_idle_one_handed_tr_aim_idle_rarm";
		msAimDualLoopLAnim = "player_shotgun_aim_idle_larm";
		msAimDualLoopRAnim = "player_shotgun_aim_idle_rarm";
		msAimDualOutroLAnim = "player_shotgun_aim_idle_tr_idle_one_handed_larm";
		msAimDualOutroRAnim = "player_shotgun_aim_idle_tr_idle_one_handed_rarm";
		
		msHandBone_R = gsUsingShotgun_RightHandBone;
		msHandBone_L = gsUsingShotgun_LeftHandBone;

		msShootSound_SmallRoom = gsUsingShotgun_Aim_ShootSmallRoomSound;
		msShootSound_MediumRoom = gsUsingShotgun_Aim_ShootMediumRoomSound;
		msShootSound_LargeRoom = gsUsingShotgun_Aim_ShootLargeRoomSound;
		msShootSound_Exterior = gsUsingShotgun_Aim_ShootExteriorSound;
		msShootSound_Muffled = gsUsingShotgun_Aim_ShootEarRingFireSound;
		msShootSound_Dry = gsUsingShotgun_Aim_ShootDryFireSound;
		
		cVector3f vBasePos = cVector3f(0.007, -0.0015f, -0.455f);
		mfWristBonePitchOffset_Default = cMath_ToRad(0.0f);
		mfWristBoneYawOffset_Default = cMath_ToRad(0.f);
		mvBonePosRelativeToCamR_Default = vBasePos + cVector3f(0.17507, -0.20738, 0.16113);
		mvBonePosRelativeToCamL_Default = vBasePos + cVector3f(-0.18424, -0.20453, 0.30791);
		
		vBasePos = cVector3f(0.006, 0.03125f, -0.485f);
		mfWristBonePitchOffset_Crouch = cMath_ToRad(9.5);
		mfWristBoneYawOffset_Crouch = cMath_ToRad(0.f);
		mvBonePosRelativeToCamR_Crouch = vBasePos + cVector3f(0.17507, -0.20738, 0.16213);
		mvBonePosRelativeToCamL_Crouch = vBasePos + cVector3f(-0.18424, -0.17153, 0.30891);
		
		vBasePos = cVector3f(0.007, -0.0015f, -0.455f);
		mfWristBonePitchOffset_LeanRight = cMath_ToRad(0.0f);
		mfWristBoneYawOffset_LeanRight = cMath_ToRad(3.f);
		mvBonePosRelativeToCamR_LeanRight = vBasePos + cVector3f(0.15607, -0.21138, 0.14213);
		mvBonePosRelativeToCamL_LeanRight = vBasePos + cVector3f(-0.2150, -0.20053, 0.32891);
		
		vBasePos = cVector3f(0.007, -0.0015f, -0.455f);
		mfWristBonePitchOffset_LeanLeft = cMath_ToRad(0.0f);
		mfWristBoneYawOffset_LeanLeft = cMath_ToRad(-4.f);
		mvBonePosRelativeToCamR_LeanLeft = vBasePos + cVector3f(0.19407, -0.21338, 0.16213);
		mvBonePosRelativeToCamL_LeanLeft = vBasePos + cVector3f(-0.15224, -0.20253, 0.30891);
		
		vBasePos = cVector3f(0.007, -0.0015f, -0.455f);
		mfWristBonePitchOffset_LeanCrouchRight =  cMath_ToRad(5.f);
		mfWristBoneYawOffset_LeanCrouchRight = cMath_ToRad(0.f);
		mvBonePosRelativeToCamR_LeanCrouchRight = vBasePos + cVector3f(0.17707, -0.19838, 0.14213);
		mvBonePosRelativeToCamL_LeanCrouchRight = vBasePos + cVector3f(-0.18424, -0.17753, 0.28891);
		
		vBasePos = cVector3f(0.007, -0.0015f, -0.455f);
		mfWristBonePitchOffset_LeanCrouchLeft = cMath_ToRad(14.f);
		mfWristBoneYawOffset_LeanCrouchLeft = cMath_ToRad(-2.f);
		mvBonePosRelativeToCamR_LeanCrouchLeft = vBasePos + cVector3f(0.18107, -0.1530, 0.12213);
		mvBonePosRelativeToCamL_LeanCrouchLeft = vBasePos + cVector3f(-0.1710, -0.1040, 0.26891);
		
		mfEquipLastItemOnLeaveDelay = 0.75f;
		
		iScrPlayerState_UsingWeapon_Aim_Base::Init();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{	
		mbUsesOtherHandAnims = true;
		
		////////////////
		// Enter base
		iScrPlayerState_UsingWeapon_Aim_Base::OnEnterState(alPrevStateId);
		
		PlayerBody_SetArmAnimationPitchFadeActive(false, true, true);
		// Doing this adds a bunch of z-fighting! Find a better value. / Edvin
		//Player_SetCameraNearPlane(0.001f);
	}
	
	//------------------------------------------------------------
	
	void OnLeaveState(int alNextStateId) override
	{	
		iScrPlayerState_UsingWeapon_Aim_Base::OnLeaveState(alNextStateId);
		Player_RestoreClipPlane();
	}
	
	//------------------------------------------------------------
	
/*	void Update(float afTimeStep)
	{
		iScrPlayerState_UsingWeapon_Aim_Base::Update(afTimeStep);
	}*/
	
	//------------------------------------------------------------
	
	void UpdateAnimationStates(float afTimeStep) override
	{		
		if (mlAnimState == eUsingItemAnimState_Outro)
			iScrPlayerState_UsingItem_Base::UpdateAnimationStates(afTimeStep);
		else
			iScrPlayerState_UsingWeapon_Aim_Base::UpdateAnimationStates(afTimeStep);
	}
	
	//------------------------------------------------------------
	
	float GetIntroFadeTime() override
	{
		return mfIntroRelTime > 0 ? 0.0f : 0.1f;
	}
	
	//------------------------------------------------------------
	
	void SpawnProjectiles(const cMatrixf a_mtxOrientation) override
	{
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap is null) return;
		
		////////////////
		// Add bullet!	
		cVector3f vStart = a_mtxOrientation.GetTranslation();
		cVector3f vFwd = a_mtxOrientation.GetTranspose().GetForward();
		
		cVector3f vRandPoint;
		cVector3f vDir;
		for (int i = 0; i < glShotgun_PelletCount; i++)
		{
			vRandPoint = cMath_RandomSphereSurfacePoint(cMath_RandRectf(0, 0.1f));
			vRandPoint += vFwd;
			vDir = cMath_Vector3Normalize(vRandPoint);
			BulletHandler_AddBullet(vStart, vDir, eBulletType(mlBulletType), pMap.GetPlayerEntity().GetID(), "OnPlayerBulletHit");
		}
		
		////////////////
		// Extra shake
		if (mbReduceCameraMotion == false)
			Effect_FOV_Shake_Start(0.08f, 0.2, 0.0, 0.4, 32);
	}
	
	//------------------------------------------------------------
	
	void OnAnimStateEnter(int alState, int alPrevState) override 
	{
		if (alState == eUsingItemAnimState_Loop)
		{
			Entity_PlayAnimation(msItemEntity, gsUsingShotgun_Aim_GunIdleAnim, 0.0f, false);
		}
	}
	
	//------------------------------------------------------------
	
	void OnUse()
	{
		// Check first thing because this will return false right after every shot fired
		bool bCanFire = Gun_GetCanFire(msWeaponType) || cLux_GetGodModeActivated();
		
		iScrPlayerState_UsingWeapon_Aim_Base::OnUse();
		
		if (bCanFire)
		{
			GameStats_IncreaseEntryAmount(eHeroStats_ShotgunShellsFired);
			Effect_Rumble_Start(0.75, 0.5);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int GetRandomShootAnimId() override
	{
		if (mvShootAnimIds.size() == 0)
		{
			for (int i = 0; i < gvUsingShotgun_Aim_PlayerShootRAnim.length(); ++i)
			{
				mvShootAnimIds.push_back(i);
			}
		}
		
		int lId = cMath_RandRectl(0, mvShootAnimIds.size() - 1);
		int lAnimId = mvShootAnimIds[lId];
		mvShootAnimIds.removeAt(lId);
		
		return lAnimId;
	}
	
	//------------------------------------------------------------
	
	tString GetGunFireAnimation(int alIx) override
	{
		return alIx < 0 ? gsUsingShotgun_Aim_GunShootEmptyAnim : gvUsingShotgun_Aim_GunShootAnim[alIx];
	}
	
	//------------------------------------------------------------
	
	tString GetPlayerFireAnimation(int alIx, eGunAnimationLayer aLayer) override
	{
		if (aLayer == eGunAnimationLayer_Head)
			return alIx < 0 ? gsUsingShotgun_Aim_PlayerShootEmptyHeadAnim : gvUsingShotgun_Aim_PlayerHeadShootAnim[alIx];
		if (aLayer == eGunAnimationLayer_RightArm)
			return alIx < 0 ? gsUsingShotgun_Aim_PlayerShootEmptyRAnim : gvUsingShotgun_Aim_PlayerShootRAnim[alIx];
		if (aLayer == eGunAnimationLayer_LeftArm)
			return alIx < 0 ? gsUsingShotgun_Aim_PlayerShootEmptyLAnim : gvUsingShotgun_Aim_PlayerShootLAnim[alIx];
			
		return "";
	}
	
	//------------------------------------------------------------
	
	bool ForceDeactivateHandPlacement()
	{
		if (msActivePlayerShootAnim == gsUsingShotgun_Aim_PlayerShootEmptyRAnim)
			return false;
			
		// TEMP - prevent the left hand from getting out of sync with the right one.
		// TODO: Fix by using IK instead!
		cAnimationState@ pShootAnim = PlayerBody_GetAnimationState(msActivePlayerShootAnim);
		if (pShootAnim !is null && pShootAnim.IsActive())
			return pShootAnim.GetRelativeTimePosition() <= 0.0f;

		//cAnimationState@ pIntroAnim = PlayerBody_GetAnimationState(msAimDualIntroRAnim);
		//if (pIntroAnim !is null && pIntroAnim.IsActive() && pIntroAnim.GetRelativeTimePosition() < 0.6f)
		//	return true;
		
		return false;
	}
	
	//------------------------------------------------------------
}