#include "custom/player/PlayerState_UsingWeapon_Aim_Base.hps"
#include "helpers/helper_effects.hps"

//------------------------------------------------------------

const tString gsUsingGun_Aim_GunShootEmptyAnim = "gun_shot_empty";
const tString[] gvUsingGun_Aim_GunShootAnim = { "gun_shot_1", "gun_shot_2", "gun_shot_3" };

const tString gsUsingGun_Aim_PlayerShootEmptyRAnim = "player_gun_shot_empty";
const tString gsUsingGun_Aim_PlayerShootEmptyLAnim = "player_gun_shot_empty_larm";

const tString[] gvUsingGun_Aim_PlayerShootRAnim = { "player_gun_shot_1", "player_gun_shot_2", "player_gun_shot_3" };
const tString[] gvUsingGun_Aim_PlayerShootLAnim = { "player_gun_shot_1_larm", "player_gun_shot_2_larm", "player_gun_shot_3_larm" };
const tString[] gvUsingGun_Aim_PlayerHeadShootAnim = { "player_head_gun_shot_1", "player_head_gun_shot_2", "player_head_gun_shot_3" };

const tString gsUsingGun_Aim_ShootLargeRoomSound = "weapons/revolver/fire_large_room";
const tString gsUsingGun_Aim_ShootMediumRoomSound = "weapons/revolver/fire_med_room";
const tString gsUsingGun_Aim_ShootSmallRoomSound = "weapons/revolver/fire_small_room";
const tString gsUsingGun_Aim_ShootExteriorSound = "weapons/revolver/fire_exterior";
const tString gsUsingGun_Aim_ShootEarRingFireSound = "weapons/revolver/gunshot_muffled";
const tString gsUsingGun_Aim_ShootDryFireSound = "weapons/revolver/dry_fire";

//------------------------------------------------------------

class cScrPlayerState_UsingGun_Aim : iScrPlayerState_UsingWeapon_Aim_Base
{
	void Init() override
	{
		mlBulletType = eBulletType_Revolver;
		msWeaponType = "Gun";
		msItemPrompt = "FireWeapon";
		mbAllowUsingLantern = true;
		mlDefaultCrossHairState = -1;
		mfShootCooldown = 0.4;
		
		msAimIntroAnim = "tool_gun_relaxed_tr_aim";
		msAimLoopAnim = "tool_gun_aim_idle";
		msAimOutroAnim = "tool_gun_aim_tr_relaxed";
		msAimDualIntroLAnim = "tool_gun_dual_relaxed_tr_aim_larm";
		msAimDualIntroRAnim = "tool_gun_relaxed_tr_aim";
		msAimDualLoopLAnim = "tool_gun_dual_aim_idle_larm";
		msAimDualLoopRAnim = "tool_gun_dual_aim_idle_rarm";
		msAimDualOutroLAnim = "tool_gun_dual_aim_tr_relaxed_larm";
		msAimDualOutroRAnim = "tool_gun_aim_tr_relaxed";
		
		msShootSound_SmallRoom = gsUsingGun_Aim_ShootSmallRoomSound;
		msShootSound_MediumRoom = gsUsingGun_Aim_ShootMediumRoomSound;
		msShootSound_LargeRoom = gsUsingGun_Aim_ShootLargeRoomSound;
		msShootSound_Exterior = gsUsingGun_Aim_ShootExteriorSound;
		msShootSound_Muffled = gsUsingGun_Aim_ShootEarRingFireSound;
		msShootSound_Dry = gsUsingGun_Aim_ShootDryFireSound;

		mfWristBonePitchOffset_Default = cMath_ToRad(2.f);
		mfWristBoneYawOffset_Default = cMath_ToRad(0.f);
		mvBonePosRelativeToCamR_Default = cVector3f(0.138f, -0.280f, 0.015f);
		mvBonePosRelativeToCamL_Default = cVector3f(-0.156f, -0.280f, 0.015f);

		mfWristBonePitchOffset_Crouch = cMath_ToRad(12.f);
		mfWristBoneYawOffset_Crouch = cMath_ToRad(0.f);
		mvBonePosRelativeToCamR_Crouch = cVector3f(0.136f, -0.255f, 0.015f);
		mvBonePosRelativeToCamL_Crouch = cVector3f(-0.158f, -0.255f, 0.015f);
		
		mfWristBonePitchOffset_LeanRight = cMath_ToRad(1.5f);
		mfWristBoneYawOffset_LeanRight = cMath_ToRad(4.5f);
		mvBonePosRelativeToCamR_LeanRight = cVector3f(0.129f, -0.282f, 0.015f);		
		mvBonePosRelativeToCamL_LeanRight = cVector3f(-0.165f, -0.282f, 0.015f);
		
		mfWristBonePitchOffset_LeanLeft = cMath_ToRad(1.5f);
		mfWristBoneYawOffset_LeanLeft = cMath_ToRad(-4.f);
		mvBonePosRelativeToCamR_LeanLeft = cVector3f(0.146f, -0.283f, 0.015f);
		mvBonePosRelativeToCamL_LeanLeft = cVector3f(-0.147f, -0.283f, 0.015f);
		
		mfWristBonePitchOffset_LeanCrouchRight = cMath_ToRad(6.5f);
		mfWristBoneYawOffset_LeanCrouchRight = cMath_ToRad(0.5f);
		mvBonePosRelativeToCamR_LeanCrouchRight = cVector3f(0.138f, -0.268f, 0.015f);
		mvBonePosRelativeToCamL_LeanCrouchRight = cVector3f(-0.156f, -0.268f, 0.015f);
		
		mfWristBonePitchOffset_LeanCrouchLeft = cMath_ToRad(17.f);
		mfWristBoneYawOffset_LeanCrouchLeft = cMath_ToRad(-1.5f);
		mvBonePosRelativeToCamR_LeanCrouchLeft = cVector3f(0.140f, -0.244f, 0.015f);
		mvBonePosRelativeToCamL_LeanCrouchLeft = cVector3f(-0.154f, -0.244f, 0.015f);
		
		iScrPlayerState_UsingWeapon_Aim_Base::Init();
	}
	
	void OnEnterState(int alPrevStateId) override
	{
		int lHeldState = Item_GetHandHeldState(eItemHandlerHand_Left);
		bool bHeld = lHeldState == 1 || lHeldState == 3;
		mbUsesOtherHandAnims = false;
		
		iScrPlayerState_UsingWeapon_Aim_Base::OnEnterState(alPrevStateId);		
		
		mAimMode = bHeld == false ? eGunAimMode_TwoHands : eGunAimMode_OneHand;
		mPrevAimMode = mAimMode;
		mLanternEquipState = lHeldState == 2 ? eGunLanternEquipState_Unequip : eGunLanternEquipState_None;
		
		PlayerBody_SetArmAnimationPitchFadeActive(false, mAimMode == eGunAimMode_TwoHands || mbWeaponSwayActive == false, mAimMode == eGunAimMode_TwoHands);
	}
	
	void OnLeaveState(int alNextStateId) override
	{
		iScrPlayerState_UsingWeapon_Aim_Base::OnLeaveState(alNextStateId);		
	}
	
	void SpawnProjectiles(const cMatrixf a_mtxOrientation) override
	{
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap is null) return;
		
		////////////////
		// Add bullet!	
		cVector3f vStart = a_mtxOrientation.GetTranslation();
		cVector3f vDir = a_mtxOrientation.GetTranspose().GetForward();
		
		BulletHandler_AddBullet(vStart, vDir, eBulletType(mlBulletType), pMap.GetPlayerEntity().GetID(), "OnPlayerBulletHit");
	}
	
	void OnUse()
	{
		// Check first thing because this will return false after the last loaded shot
		bool bCanFire = Gun_GetCanFire(msWeaponType) || cLux_GetGodModeActivated();

		iScrPlayerState_UsingWeapon_Aim_Base::OnUse();
		
		if (bCanFire)
		{
			GameStats_IncreaseEntryAmount(eHeroStats_BulletsFired);
			Effect_Rumble_Start(0.5, 0.5);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int GetRandomShootAnimId() override
	{
		if (mvShootAnimIds.size() == 0)
		{
			for (int i = 0; i < gvUsingGun_Aim_PlayerShootRAnim.length(); ++i)
			{
				mvShootAnimIds.push_back(i);
			}
		}
		
		int lId = cMath_RandRectl(0, mvShootAnimIds.size() - 1);
		int lAnimId = mvShootAnimIds[lId];
		mvShootAnimIds.removeAt(lId);
		
		return lAnimId;
	}
	
	//------------------------------------------------------------
	
	tString GetGunFireAnimation(int alIx) override
	{
		return alIx < 0 ? gsUsingGun_Aim_GunShootEmptyAnim : gvUsingGun_Aim_GunShootAnim[alIx];
	}
	
	//------------------------------------------------------------
	
	tString GetPlayerFireAnimation(int alIx, eGunAnimationLayer aLayer) override
	{
		if (aLayer == eGunAnimationLayer_Head)
			return alIx < 0 ? "" : gvUsingGun_Aim_PlayerHeadShootAnim[alIx];
		if (aLayer == eGunAnimationLayer_RightArm)
			return alIx < 0 ? gsUsingGun_Aim_PlayerShootEmptyRAnim : gvUsingGun_Aim_PlayerShootRAnim[alIx];
		if (aLayer == eGunAnimationLayer_LeftArm)
			return alIx < 0 ? gsUsingGun_Aim_PlayerShootEmptyLAnim : gvUsingGun_Aim_PlayerShootLAnim[alIx];
			
		return "";
	}
	
	//------------------------------------------------------------
	
	bool ForceDeactivateHandPlacement()
	{
		// TEMP - prevent the left hand from getting out of sync with the right one.
		// TODO: Fix by using IK instead!
		cAnimationState@ pShootAnim = PlayerBody_GetAnimationState(msActivePlayerShootAnim);
		return cString_GetFirstStringPos(msActivePlayerShootAnim, "empty") == -1 &&
			pShootAnim !is null &&
			pShootAnim.IsActive() &&
			pShootAnim.GetRelativeTimePosition() <= 0.5f;
	}
	
	//------------------------------------------------------------
}