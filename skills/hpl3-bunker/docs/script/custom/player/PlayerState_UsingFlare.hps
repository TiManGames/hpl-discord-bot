#include "PlayerState_UsingThrowable.hps"

//------------------------------------------------------------

class cScrPlayerState_UsingFlare : cScrPlayerState_UsingThrowable
{
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init() override
	{
		cScrPlayerState_UsingThrowable::Init();
		
		mfThrowableMinPitch = cMath_ToRad(-50.f);
		mfThrowableMaxPitch = cMath_ToRad(30.f);
		mfThrowablePitchFadeTime = 1.f;
		mfMaxThrowDelay = 1.2f;

		msFocusIntroAnim_L = "tool_flare_focus_start_larm";
		msFocusIntroAnim_R = "tool_flare_focus_start_rarm";
		msFocusLoopAnim_L = "tool_flare_focus_idle_larm";
		msFocusLoopAnim_R = "tool_flare_focus_idle_rarm";
		msFocusOutroAnim_L = "tool_flare_focus_end_larm";
		msFocusOutroAnim_R = "tool_flare_focus_end_rarm";
		msThrowAnim_L = "tool_flare_throw_larm";
		msThrowAnim_R = "tool_flare_throw_rarm";
		msThrowAnim_Head = "tool_flare_throw_head";
		
		msThrowAnim_Item = "throw";
		
		msThrowEnt = "flare_thrown.ent";
		mbUseQualitySetting = true;
		
		mbUsesOtherHandAnims = true;
		
		mfEquipLastItemOnLeaveDelay = 0.55f;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ENTER MAP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap @apMap) 
	{
		/////////////
		// Preload
		ParticleSetting_PreloadEntity(msThrowEnt);
	}

	void OnMapLeave(cLuxMap @apMap) {}
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap @apMap) {}	
	void DestroyWorldEntities(cLuxMap @apMap) {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ThrowProp(const tString &in asThrowEnt)
	{
		cScrPlayerState_UsingThrowable::ThrowProp(asThrowEnt);
		GameStats_IncreaseEntryAmount(eHeroStats_FlaresThrown);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	//------------------------------------------------------------
}