#include "PlayerState_UsingThrowable.hps"

//------------------------------------------------------------

class cScrPlayerState_UsingGrenade : cScrPlayerState_UsingThrowable
{
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init() override
	{
		cScrPlayerState_UsingThrowable::Init();
		
		mfThrowableMinPitch = cMath_ToRad(-55.f);
		mfThrowableMaxPitch = cMath_ToRad(30.f);
		mfThrowablePitchFadeTime = 0.25f;
		mfMaxThrowDelay = 1.f;

		msFocusIntroAnim_L = "tool_grenade_focus_start_larm";
		msFocusIntroAnim_R = "tool_grenade_focus_start_rarm";
		msFocusLoopAnim_L = "tool_grenade_focus_idle_larm";
		msFocusLoopAnim_R = "tool_grenade_focus_idle_rarm";
		msFocusOutroAnim_L = "tool_grenade_focus_end_larm";
		msFocusOutroAnim_R = "tool_grenade_focus_end_rarm";
		msThrowAnim_L = "tool_grenade_throw_larm";
		msThrowAnim_R = "tool_grenade_throw_rarm";
		msThrowAnim_Head = "tool_grenade_throw_head";
		
		msFocusIntroAnim_Item = "focus_start";
		msFocusLoopAnim_Item = "focus_idle";
		msFocusOutroAnim_Item = "focus_end";
		msThrowAnim_Item = "throw";
		
		msThrowEnt = "grenade_thrown.ent";
		
		mbUsesOtherHandAnims = true;
		
		mfEquipLastItemOnLeaveDelay = 0.55f;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void ThrowProp(const tString &in asThrowEnt)
	{
		cScrPlayerState_UsingThrowable::ThrowProp(asThrowEnt);
		GameStats_IncreaseEntryAmount(eHeroStats_GrenadesThrown);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	//------------------------------------------------------------
}