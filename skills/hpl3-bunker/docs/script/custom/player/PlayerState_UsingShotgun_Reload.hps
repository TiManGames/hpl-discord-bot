#include "custom/player/PlayerState_UsingWeapon_Reload_Base.hps"

//------------------------------------------------------------

const tString gsUsingShotgun_RightHandBone = "j_R_Arm_Zero";
const tString gsUsingShotgun_LeftHandBone = "j_L_Arm_Zero";

enum eShotgunReloadEnd
{
	eShotgunReloadEnd_Simple,
	eShotgunReloadEnd_Pump
}

const tString[] gvUsingShotgun_ReloadEndAnims_R = 		{"player_shotgun_reload_end_rarm",	"player_shotgun_reload_end_pump_tr_check_ammo_rarm"};
const tString[] gvUsingShotgun_ReloadEndAnims_L = 		{"player_shotgun_reload_end_larm",	"player_shotgun_reload_end_pump_tr_check_ammo_larm"};
const tString[] gvUsingShotgun_ReloadEndAnims_Head = 	{"player_head_shotgun_reload_end",	"player_head_shotgun_reload_end_pump_tr_check_ammo"};
const tString[] gvUsingShotgun_ReloadEndAnims_Gun = 	{"shotgun_reload_end",				"shotgun_reload_end_pump_tr_check_ammo"};

//------------------------------------------------------------

class cScrPlayerState_UsingShotgun_Reload : iScrPlayerState_UsingWeapon_Reload_Base
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init() override
	{
		msWeaponType = "Shotgun";
		msAmmunitionType = "ShotgunAmmunition";
		msItemPrompt = "ReloadShotgun";
		
		msPlayerIntroAnim_R = "player_shotgun_idle_one_handed_tr_check_ammo_rarm";
		msPlayerIntroAnim_L = "player_shotgun_idle_one_handed_tr_check_ammo_larm";
		msPlayerIntroAnim_Head = "player_head_shotgun_idle_one_handed_tr_check_ammo";
		msGunIntroAnim = "shotgun_idle_one_handed_tr_check_ammo";
		
		msPlayerLoopAnim_R = "player_shotgun_check_ammo_idle_rarm";
		msPlayerLoopAnim_L = "player_shotgun_check_ammo_idle_larm";
		msPlayerLoopAnim_Head = ""; //"player_head_shotgun_check_ammo_idle"; - Skip head anim on idle since it messes up the player body yaw!
		msGunLoopAnim = "shotgun_check_ammo_idle";
		
		msPlayerOutroAnim_R = "player_shotgun_check_ammo_tr_idle_one_handed_rarm";
		msPlayerOutroAnim_L = "player_shotgun_check_ammo_tr_idle_one_handed_larm";
		msPlayerOutroAnim_Head = "player_head_shotgun_check_ammo_tr_idle_one_handed";
		msGunOutroAnim = "shotgun_check_ammo_tr_idle_one_handed";
	
		msPlayerReloadStartAnim_R = "player_shotgun_reload_start_rarm";
		msPlayerReloadStartAnim_L = "player_shotgun_reload_start_larm";
		//msPlayerReloadStartAnim_Head = "player_head_shotgun_reload_start";
		msGunReloadStartAnim = "shotgun_reload_start";
	
		msPlayerReloadAddBulletAnim_R = "player_shotgun_reload_rarm";
		msPlayerReloadAddBulletAnim_L = "player_shotgun_reload_larm";
		//msPlayerReloadAddBulletAnim_Head = "player_head_shotgun_reload";
		msGunReloadAddBulletAnim = "shotgun_reload";
		
		iScrPlayerState_UsingWeapon_Reload_Base::Init();
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId) override
	{	
		iScrPlayerState_UsingWeapon_Reload_Base::OnEnterState(alPrevStateId);
		
		mbCustomBonePosActiveL = false;
		mbCustomBonePosActiveR = false;
		mfCustomBoneWeightL = 0.f;
		mfCustomBoneWeightR = 0.f;
		
		mfIntroDelayTime = 0.73f;
		
		cVector3f vBasePos = cVector3f(0, -0.0f, -0.45f);
		mfWristBonePitchOffset_Default = 0;
		mfWristBoneYawOffset_Default = 0.f;
		mvBonePosRelativeToCamR_Default = vBasePos + cVector3f(0.17507, -0.20738, 0.16213);
		mvBonePosRelativeToCamL_Default = vBasePos + cVector3f(-0.18424, -0.20453, 0.30891);
		
		vBasePos = cVector3f(0, 0.025f, -0.45f);
		mfWristBonePitchOffset_Crouch = cMath_ToRad(5);
		mfWristBoneYawOffset_Crouch = 0.f;
		mvBonePosRelativeToCamR_Crouch = vBasePos + cVector3f(0.17507, -0.20738, 0.16213);
		mvBonePosRelativeToCamL_Crouch = vBasePos + cVector3f(-0.18, -0.20453, 0.30891);
		
		msHandBone_R = gsUsingShotgun_RightHandBone;
		msHandBone_L = gsUsingShotgun_LeftHandBone;
		
		mbShotgunAlignment_Active = false;
		mfShotgunAlignment_Time = 0.f;
		mfShotgunAlignment_Delay = 0.f;
		msShotgunAlignment_Socket = "";
		msShotgunAlignment_PrevSocket = "";
		
		///////////////
		// Attach to left socket
		AlignShotgunWithSocket("L_Hand", 0.5f);
	}
	
	//------------------------------------------------------------
	
	void OnLeaveState(int alNextStateId) override
	{	
		iScrPlayerState_UsingWeapon_Reload_Base::OnLeaveState(alNextStateId);
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		//////////////////
		// Hand placement
		UpdateHandPlacement(afTimeStep);	
		
		//////////////////
		// Base update
		iScrPlayerState_UsingWeapon_Reload_Base::Update(afTimeStep);
		
		//////////////////
		// Align with left socket after a delay
		if (mfShotgunAlignment_Delay > 0.f)
		{
			if (mbWaitForUnequip == false)
				mfShotgunAlignment_Delay -= afTimeStep;
			
			if (mfShotgunAlignment_Delay <= 0.f)
			{
				mfShotgunAlignment_Delay = 0.f;
				AlignShotgunWithSocket(msShotgunAlignment_Socket, 0.f);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateAnimationStates(float afTimeStep) override
	{
		////////////////
		// Outro
		if (mlAnimState == eUsingItemAnimState_Outro)
		{
			int lState = UpdateStateAnims(msFocusOutroAnim_R, 
								 msFocusOutroAnim_L, 
								 msPlayerOutroAnim_Head,
								 msFocusOutroAnim_Item, 
								 false, mfOutroFadeTime, false, true, mfOutroRelTime);
			if (lState == -1)
			{
				mBaseObj.mpPlayer.ChangeState(ePlayerState_Normal);
			}
			
			UpdateArmStates();
		}
		
		////////////////
		// End reload
		else if (mlAnimState == eUsingGun_ReloadState_EndReload)
		{
			int lState = UpdateStateAnims(	gvUsingShotgun_ReloadEndAnims_R[mReloadEndType], 
											gvUsingShotgun_ReloadEndAnims_L[mReloadEndType], 
											"",
											gvUsingShotgun_ReloadEndAnims_Gun[mReloadEndType], 
											false, 0.f, false, msPlayerLoopAnim_L=="");
			if (lState == -1)
			{
				ChangeAnimState(mbLeaveState ? eUsingItemAnimState_Outro : eUsingItemAnimState_Loop);
			}
			
			UpdateArmStates();
		}
		
		////////////////
		// Base
		else
		{
			iScrPlayerState_UsingWeapon_Reload_Base::UpdateAnimationStates(afTimeStep);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateArmStates() override
	{		
		if (mlAnimState == eUsingItemAnimState_Intro)
		{			
			mbCustomBonePosActiveR = true;
			mbCustomBonePosActiveL = true;
			
			//PlayerBody_SetCrouchArmRotationOffsetActive(false, false, true);
			//PlayerBody_SetCrouchArmRotationOffsetActive(true, false, false);
		}	
		
		////////////////
		// Empty bullets
		else if (mlAnimState == eUsingGun_ReloadState_EmptyBullets)
		{			
/*			mbCustomBonePosActiveR = true;
			mbCustomBonePosActiveL = true;*/
		}
		
		////////////////
		// Loop
		else if (mlAnimState == eUsingItemAnimState_Loop)
		{	
			mbCustomBonePosActiveR = true;
			mbCustomBonePosActiveL = true;
			
			PlayerBody_SetArmAnimationPitch(true, true, true);
		}
		
		////////////////
		// Start reload
		else if (mlAnimState == eUsingGun_ReloadState_StartReload)
		{
			mbCustomBonePosActiveR = true;
			mbCustomBonePosActiveL = true;
			
			PlayerBody_SetArmAnimationPitch(true, true, true);
		}

		////////////////
		// Insert bullet
		else if (mlAnimState == eUsingGun_ReloadState_InsertBullet)
		{
			mbCustomBonePosActiveR = true;
			mbCustomBonePosActiveL = true;
			
			PlayerBody_SetArmAnimationPitch(true, true, true);
		}	
		
		////////////////
		// End reload
		else if (mlAnimState == eUsingGun_ReloadState_EndReload)
		{
			mbCustomBonePosActiveR = true;
			mbCustomBonePosActiveL = true;
			
			PlayerBody_SetArmAnimationPitch(true, true, true);
		}	
	
		////////////////
		// Outro
		else if (mlAnimState == eUsingItemAnimState_Outro)
		{
			cAnimationState@ pAnim = PlayerBody_GetAnimationState(msPlayerOutroAnim_R);
			bool bCustomBonePosActive = pAnim !is null && pAnim.IsActive() && pAnim.GetRelativeTimePosition() < 0.3f;
			
			mbCustomBonePosActiveR = bCustomBonePosActive;
			mbCustomBonePosActiveL = bCustomBonePosActive;
			
			PlayerBody_SetArmAnimationPitch(true, true, true);
		}
	}
	
	//------------------------------------------------------------
	
	float GetAnimStateRelTime(eUsingItemAnimState aState, eUsingItemAnimState aBlendState) override
	{
		float fBlendTime = _GetAnimStateRelTime_GetBlendTime(aBlendState);
		if (fBlendTime >= 1.0f) return 0.0f;
		
		/////////////////////////////////
		// Split the animations up into separate steps and blend between those
		if (aState == eUsingItemAnimState_Outro && aBlendState == eUsingItemAnimState_Intro)
		{
			return 0;
		}
		
/*		if (aState == eUsingItemAnimState_Intro && aBlendState == eUsingItemAnimState_Outro)
		{
			return gfUsingGun_Reload_IntroAnim_FlickStart;
		}*/
		
		// clamp and ease for the best possible look when blending the animations, this is all a bit magic numbery
		float fRel = cMath_Max(fBlendTime, 0.2f);
		return cMath_Easing(eEasing_ExpoIn, 1.0f - fRel);
	}
	
	//------------------------------------------------------------
	
	void _Global_OnAfterAnimationUpdate() override
	{		
		///////////////////
		// After anim update
		iScrPlayerState_UsingWeapon_Reload_Base::_Global_OnAfterAnimationUpdate();
		
		///////////////////
		// Place shotgun at socket
		if (mbShotgunAlignment_Active)
		{
			iLuxEntity@ pShotgun = cLux_ID_Entity(m_idItemEntity);
			iLuxEntity@ pPlayerBody = cLux_ID_Entity(PlayerBody_GetEntityID());
			
			if (pShotgun is null) return;
			if (pPlayerBody is null) return;
			 
			cNode3D@ pSocket = pPlayerBody.GetMeshEntity().GetSocket(msShotgunAlignment_Socket);
			cNode3D@ pPrevSocket = pPlayerBody.GetMeshEntity().GetSocket(msShotgunAlignment_PrevSocket);
			cNode3D@ pSocketParent = pSocket !is null ? pSocket.GetParent() : null;
			
			if (pSocket is null) return;
			if (pPrevSocket is null) return;
			if (pSocketParent is null) return;		
			
			cMatrixf mtxStart = GetShotgunMatrixFromSocket(pPrevSocket);
			cMatrixf mtxGoal = GetShotgunMatrixFromSocket(pSocket);
			
			mfShotgunAlignment_Time += cEngine_GetFrameTime() * (1.f / 0.1f);
			
			cMatrixf mtxNew = cMath_MatrixSlerp(mfShotgunAlignment_Time, mtxStart, mtxGoal, true);		
			pShotgun.SetMatrix(mtxNew);
			
			if (mfShotgunAlignment_Time >= 1.f)
			{
				mfShotgunAlignment_Time = 0.f;
				mbShotgunAlignment_Active = false;
				PlayerBody_AttachProp(msItemEntity, msShotgunAlignment_Socket, true);
			}
		}
	}
	
	//------------------------------------------------------------
	
	cMatrixf GetShotgunMatrixFromSocket(cNode3D@ apSocket)
	{
		if (apSocket is null) return cMatrixf_Identity;
		
		cMatrixf mtxGoal = apSocket.GetWorldMatrix();
		cMatrixf mtxRot = cMath_MatrixMul(cMath_MatrixScale(100.f), apSocket.GetParent().GetWorldMatrix().GetRotation());
		mtxGoal.SetRotation(mtxRot);
		
		return mtxGoal;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void UpdateHandPlacement(float afTimeStep)
	{
		//////////////////
		// Get goals
		float fWristBonePitchOffsetGoal = mfWristBonePitchOffset_Default;
		float fWristBoneYawOffsetGoal = mfWristBoneYawOffset_Default;
		cVector3f vHandBonePosOffsetGoalL = mvBonePosRelativeToCamL_Default;
		cVector3f vHandBonePosOffsetGoalR = mvBonePosRelativeToCamR_Default;
		
		if (Player_GetCrouching())
		{
			fWristBonePitchOffsetGoal = mfWristBonePitchOffset_Crouch;
			fWristBoneYawOffsetGoal = mfWristBoneYawOffset_Crouch;
			vHandBonePosOffsetGoalL = mvBonePosRelativeToCamL_Crouch;
			vHandBonePosOffsetGoalR =  mvBonePosRelativeToCamR_Crouch;
		}
		
		//////////////////
		// Set instantly?
		if (mfWristBoneYawOffset == 0.f)
		{
			mfWristBonePitchOffset = fWristBonePitchOffsetGoal;
			mfWristBoneYawOffset = fWristBoneYawOffsetGoal;
			mvHandBonePosRelativeToCamL = vHandBonePosOffsetGoalL;
			mvHandBonePosRelativeToCamR = vHandBonePosOffsetGoalR;
		}
		
		//////////////////
		// Increase to goal
		float fOffsetChangeSpeed = afTimeStep * 0.25f;
		mfWristBonePitchOffset = cMath_IncreaseTo(mfWristBonePitchOffset, fOffsetChangeSpeed, fWristBonePitchOffsetGoal);
		mfWristBoneYawOffset = cMath_IncreaseTo(mfWristBoneYawOffset, fOffsetChangeSpeed, fWristBoneYawOffsetGoal);
		mvHandBonePosRelativeToCamL = cMath_Vector3IncreaseTo(mvHandBonePosRelativeToCamL, fOffsetChangeSpeed, vHandBonePosOffsetGoalL);
		mvHandBonePosRelativeToCamR = cMath_Vector3IncreaseTo(mvHandBonePosRelativeToCamR, fOffsetChangeSpeed, vHandBonePosOffsetGoalR);
	}
	
	//------------------------------------------------------------
	
	void ChangeAnimState(int alNewState) override
	{
		if (alNewState != mlAnimState && alNewState == eUsingGun_ReloadState_EndReload)
		{
			mReloadEndType = Shotgun_GetShellIsChambered() ? eShotgunReloadEnd_Simple : eShotgunReloadEnd_Pump;
		}
		
		iScrPlayerState_UsingWeapon_Reload_Base::ChangeAnimState(alNewState);
	}
	
	//------------------------------------------------------------
	
	void OnAnimStateEnter(int alState, int alPrevState) override 
	{
		if (alState == eUsingItemAnimState_Outro)
		{
			AlignShotgunWithSocket("R_Hand", 0.1f);
		}
		
		if (alState == eUsingItemAnimState_Outro)
		{
			mfOutroFadeTime = 0.1f;
			mfOutroRelTime = 0;
			if (alPrevState == eUsingItemAnimState_Intro)
			{
				// clamp and ease for the best possible look when blending the animations, this is all a bit magic numbery
				mfOutroRelTime = GetAnimStateRelTime(eUsingItemAnimState_Outro, eUsingItemAnimState_Intro);
				if (mfOutroRelTime > 0) mfOutroFadeTime = 0.3f;
			}
		}
	}
	
	//------------------------------------------------------------
	
	void AlignShotgunWithSocket(const tString &in asSocket, float afDelay)
	{		
		mfShotgunAlignment_Delay = 0.f;
		msShotgunAlignment_Socket = asSocket;		
		msShotgunAlignment_PrevSocket = asSocket == "L_Hand" ? "R_Hand" : "L_Hand";		
		
		if (afDelay > 0.f)
		{
			mfShotgunAlignment_Delay = afDelay;
			return;
		}
		
		mbShotgunAlignment_Active = true;
		mfShotgunAlignment_Time = 0.f;
	
		PlayerBody_FreeSocket(msShotgunAlignment_PrevSocket);
		
		iLuxEntity@ pShotgun = cLux_ID_Entity(m_idItemEntity);
		if (pShotgun !is null)
			pShotgun.SetActive(true);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GLOBAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void _Global_CanCheckAmmo() override
	{
		cAnimationState@ pAnim = PlayerBody_GetAnimationState(msPlayerOutroAnim_R);
		
		const float gfUsingGun_Reload_IntroAnim_FlickStart = 0.328f;
		const float gfUsingGun_Reload_IntroAnim_MoveStart = 0.485f;
		const float gfUsingGun_Reload_IntroAnim_MoveEnd = 0.9f;

		const float gfUsingGun_Reload_OutroAnim_FlickStart = 0.25f;
		const float gfUsingGun_Reload_OutroAnim_MoveStart = 0.5f;
		
		bool bCanCheckAmmo = pAnim !is null && (pAnim.IsActive()==false || pAnim.GetRelativeTimePosition() > gfUsingGun_Reload_OutroAnim_MoveStart);
		cScript_SetGlobalReturnBool(bCanCheckAmmo);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float mfWristBonePitchOffset_Default;
	float mfWristBoneYawOffset_Default;
	cVector3f mvBonePosRelativeToCamL_Default;
	cVector3f mvBonePosRelativeToCamR_Default;
	
	float mfWristBonePitchOffset_Crouch;
	float mfWristBoneYawOffset_Crouch;
	cVector3f mvBonePosRelativeToCamL_Crouch;
	cVector3f mvBonePosRelativeToCamR_Crouch;
	
	eShotgunReloadEnd mReloadEndType;
	
	float mfOutroRelTime;
	float mfOutroFadeTime;
	
	bool mbShotgunAlignment_Active = false;
	float mfShotgunAlignment_Time = 0.f;
	float mfShotgunAlignment_Delay = 0.f;
	tString msShotgunAlignment_Socket = "";
	tString msShotgunAlignment_PrevSocket = "";
	
	//------------------------------------------------------------
}