#include "interfaces/PlayerState_Interface.hps"
#include "custom/player/PlayerState_UsingItem_Base.hps"
#include "base/InputHandler_Types.hps"
#include "player/Player_Types.hps"
#include "custom/helpers/helper_modules_custom.hps"
#include "custom/helpers/helper_items.hps"
#include "custom/helpers/helper_props_custom.hps"

//------------------------------------------------------------

const float gfUsingTorch_MinPitch = cMath_ToRad(-70.f);
const float gfUsingTorch_MaxPitch = cMath_ToRad(30.f);
const float gfUsingTorch_PitchFadeTime = 1.f;

const tString gsTorchFocusWaveAnim_BaseName_Player = "tool_torch_wave_";
const tString gsTorchFocusWaveAnim_End_Player = "tool_torch_wave_end_rarm";
const tString gsTorchFocusWaveAnim_FastEnd_Player = "tool_torch_wave_end_fast_rarm";

//------------------------------------------------------------

enum eUsingTorchAnimState
{
	eUsingTorchAnimState_WaveEnd = eUsingItemAnimState_LastEnum,
	eUsingTorchAnimState_WaveEndFast
}

//------------------------------------------------------------

class cScrPlayerState_UsingTorch : iScrPlayerState_UsingItem_Base, iScrPlayerState_Interface
{
	//------------------------------------------------------------
		
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		iScrPlayerState_UsingItem_Base::Init();
		
		msFocusIntroAnim_R = "tool_torch_aim_start_rarm";
		msFocusLoopAnim_R = "tool_torch_aim_rarm";
		msFocusOutroAnim_R = "tool_torch_aim_end_rarm";
		
		msItemPrompt = "WaveTorch";
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{
		////////////////
		// Enter base
		iScrPlayerState_UsingItem_Base::OnEnterState(alPrevStateId);
		AddInteractableEntityClass("cScrPropFuelSpill");
		mlUseCrossHairState = eCrossHairState_UseTorch;
		
		////////////////
		// Setup vars
		
		////////////////
		// Setup pitch
		//PlayerBody_SetArmAnimationPitch(true, true, true);
		SetupPitchFade(gfUsingTorch_MinPitch, gfUsingTorch_MaxPitch, gfUsingTorch_PitchFadeTime, false);
		
		/////////////
		// Scare rats
		RatHandler_SetPlayerThreatensRats(true);
		Torch_SetAimAttributes(true);
	}
	
	//------------------------------------------------------------
	
	void OnLeaveState(int alNextStateId)
	{
		////////////////
		// Leave base
		iScrPlayerState_UsingItem_Base::OnLeaveState(alNextStateId);
		
		/////////////
		// Stop scaring rats
		RatHandler_SetPlayerThreatensRats(false);
		Torch_SetAimAttributes(false);
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
/*		if (mlAnimState == eUsingItemAnimState_Use)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(m_idItemEntity);
			
			iPhysicsBody@ pTorchBody = pEnt.GetBodyFromName("Body_2");
			cBoundingVolume boundingVolume = pTorchBody.GetBoundingVolume();
			array<iPhysicsBody@> vBodies;
			cLux_GetCurrentMap().GetPhysicsWorld().GetBodiesInAABB(boundingVolume.GetMin(), boundingVolume.GetMax(), true, false, vBodies);
			for (uint i = 0; i < vBodies.length(); i++)
			{
				iPhysicsBody@ pBody = vBodies[i];
				
				//////////////////////////
				// Check if body should trigger the trap
				if (pBody.IsActive()==false) continue;
				if (pBody.IsCharacter() || pBody.GetMass()==0) continue;
				
				//////////////////////////
				// Do a full collision check since the AABB can contain bodies that don't collide with the wire
				cCollideData data;
				data.SetMaxSize(1);
				if (cLux_GetCurrentMap().GetPhysicsWorld().CheckShapeCollision(pBody.GetShape(), pBody.GetWorldMatrix(), pTorchBody.GetShape(), pTorchBody.GetWorldMatrix(), data, 1, false))
				{
					pBody.AddImpulse(cMath_Vector3Normalize(pBody.GetWorldPosition()-pTorchBody.GetWorldPosition())*0.1);
					break;
				}
			}
		}*/
		
		//////////////
		// Update base
		iScrPlayerState_UsingItem_Base::Update(afTimeStep);
		
		////////////////
		// Sway again?
		if (cInput_IsTriggered(eAction_Interact) && mbLeaveState==false && mlAnimState != eUsingItemAnimState_Use && mfIntroTimer > 0.1f)
		{
			Sway();
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateAnimationStates(float afTimeStep) override
	{
		if (mlAnimState == eUsingItemAnimState_Use)
		{
			///////////////
			// Update state
			int lState = UpdateStateAnims(msTorchWaveAnimToPlay, "", false, false, 0.1f);
			
			////////////////
			// Entered state
			if (lState == 1)
			{
			}
			
			////////////////
			// State over?
			if (lState == -1)
			{
				ChangeAnimState(mbLeaveState ? eUsingTorchAnimState_WaveEndFast : eUsingTorchAnimState_WaveEnd);
			}
		}
		
		////////////////
		// Wave End
		else if (mlAnimState == eUsingTorchAnimState_WaveEnd || mlAnimState == eUsingTorchAnimState_WaveEndFast)
		{
			///////////////
			// Update state
			int lState = UpdateStateAnims(mlAnimState == eUsingTorchAnimState_WaveEnd ? 
											gsTorchFocusWaveAnim_End_Player : 
											gsTorchFocusWaveAnim_FastEnd_Player, "", false, false, 0.1f);
			
			////////////////
			// Entered state
			if (lState == 1)
			{
				mlWaveAnimIt = 0;
			}
			
			////////////////
			// State over?
			if (lState == -1)
			{
				ChangeAnimState(mbLeaveState ? eUsingItemAnimState_Outro : eUsingItemAnimState_Loop);
			}
		}
		
		else
		{
			iScrPlayerState_UsingItem_Base::UpdateAnimationStates(afTimeStep);
		}
	}
	
	//------------------------------------------------------------
	
	void OnUse() 
	{
		if (GetCanInteractWithFocusedEntity())
		{
			iLuxEntity@ pEnt = mPickBasics.GetFocusedEntity();
			FuelSpill_Ignite(pEnt.GetName(), true);
		}
		
		mlWaveAnimIt = 0;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		return iScrPlayerState_UsingItem_Base::OnAnalogInput(alAnalogId, avAmount);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool GetCanInteractWithFocusedEntity() override
	{
		if (!iScrPlayerState_UsingItem_Base::GetCanInteractWithFocusedEntity())
			return false;
			
		iLuxEntity@ pPickedEnt = mPickBasics.GetFocusedEntity();
		return FuelSpill_GetCanIgnite(pPickedEnt.GetName());
	}
	
	//------------------------------------------------------------
	
	void Sway()
	{
		///////////////////
		// Animation picker
		mlWaveAnimIt = mlWaveAnimIt < 3 ? mlWaveAnimIt + 1 : 2; // loop between 2 and 3 variations but start with 1. 
		msTorchWaveAnimToPlay = gsTorchFocusWaveAnim_BaseName_Player + mlWaveAnimIt;
		ChangeAnimState(eUsingItemAnimState_Use);
		
		//////////////////
		// Scare rats away
		array<iLuxEntity@> vAgents;
		cLux_GetCurrentMap().GetEntityArray("*", eLuxEntityType_Agent, "cScrAgentRat", vAgents);
		
		for (int i = 0; i<vAgents.size(); ++i)
		{
			iLuxEntity@ pCurrAgent = vAgents[i];
			if (pCurrAgent is null) continue;
			pCurrAgent.BroadcastMessage(eCustomEntityMessage_ThreatenedAttack, null, cVector3f(0), 0);
		}
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont, float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlWaveAnimIt = 0;
	tString msTorchWaveAnimToPlay = "";
	
	//------------------------------------------------------------
}