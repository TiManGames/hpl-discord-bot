	void AppLostInputFocus() {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	cGameStat@ GetEntry(int alId)
	{
		for (int i=0; i<mvGameStats.size(); i++)
		{
			cGameStat@ pStat = mvGameStats[i];
			if (pStat is null) continue;
			
			if (pStat.mlId == alId)
				return pStat;
		}
		
		return null;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetGameTimerActive(bool abX)
	{
		mbPlayTimerActive = abX;
	}
	
	//------------------------------------------------------------
	
	void UpdateTimeBetweenSaves()
	{
		float fTimeSinceLastSave = mfTimePlayed - mfLastSaveGameTime;
		mfLastSaveGameTime = mfTimePlayed;
		
		if (fTimeSinceLastSave > mfLongestTimeBetweenSaves)
			mfLongestTimeBetweenSaves = fTimeSinceLastSave;
	}
	
	//------------------------------------------------------------
	
	void SetGuiActive(bool abX)
	{
		if (MainMenu_IsShowing()) return;
		
		mbGuiActive = abX;
		PauseMenu_Enabled(!abX);
		cLux_SetGamePaused(abX, false, true, true);
		cLux_GetGuiHandler().SetGameHudInputFocus(abX);
	}
	
	//------------------------------------------------------------
	
	bool GetGuiActive()
	{
		return mbGuiActive;
	}
	
	//------------------------------------------------------------
	
	void ResetAllEntries(bool abSave=false)
	{
		mfTimePlayed = 0.f;
		mfLongestTimeBetweenSaves = 0.f;
		
		mvGameStats.resize(0);
		
		AddEntry(eHeroStats_TimesSaved, "TimesSaved");
		AddEntry(eHeroStats_NumberOfDeaths, "NumberOfDeaths");
		AddEntry(eHeroStats_RatsKilled, "RatsKilled");
		AddEntry(eHeroStats_BulletsFired, "BulletsFired");
		AddEntry(eHeroStats_ShotgunShellsFired, "ShotgunShellsFired");
		AddEntry(eHeroStats_GrenadesThrown, "GrenadesThrown");
		AddEntry(eHeroStats_GasGrenadesThrown, "GasGrenadesThrown");
		AddEntry(eHeroStats_PetrolBombsThrown, "PetrolBombsThrown");
		AddEntry(eHeroStats_FlaresThrown, "FlaresThrown");
		AddEntry(eHeroStats_HealthItemsUsed, "HealthItemsUsed");
		AddEntry(eHeroStats_GeneratorRefills, "GeneratorRefills");
		AddEntry(eHeroStats_Blackouts, "Blackouts");
		AddEntry(eHeroStats_TrapsTriggered, "TrapsTriggered");
		AddEntry(eHeroStats_CorpsesBurnt, "CorpsesBurnt");
		AddEntry(eHeroStats_FiresStarted, "FiresStarted");
		AddEntry(eHeroStats_DoorsDestroyed, "DoorsDestroyed");
		AddEntry(eHeroStats_TimesSpottedByStalker, "TimesSpottedByStalker");
		AddEntry(eHeroStats_ItemsCrafted, "ItemsCrafted");
		AddEntry(eHeroStats_StalkerHitCount, "StalkerHitCount");
		AddEntry(eHeroStats_RatsScaredByTorch, "RatsScaredByTorch");
		
		if (abSave)
			SaveStats();
	}
	
	//------------------------------------------------------------
	
	void AddEntry(int alId, const tString&in asName)
	{
		cGameStat@ pStat = GetEntry(alId);
		if (pStat !is null)
		{
			Error("[GameStatsModule] [AddEntry] Failed to add game stat entry with ID" + alId + " because the ID already exists.");
			return;
		}
		
		cGameStat newEntry;
		newEntry.mlId = alId;
		newEntry.msName = asName;
		newEntry.mlAmount = 0;
		mvGameStats.push_back(newEntry);
		
		//cLux_AddDebugMessage("[GameStatsModule] [AddEntry] Game stat entry " + asName + " succesfully added!");
	}
	
	//------------------------------------------------------------
	
	void RemoveEntry(int alId)
	{
		for (int i=0; i<mvGameStats.size(); i++)
		{
			cGameStat@ pStat = mvGameStats[i];
			if (pStat is null) continue;
			if (pStat.mlId != alId) continue;
			mvGameStats.removeAt(i);
			break;
		}
	}
	
	//------------------------------------------------------------
	
	void SetEntryAmount(int alId, int alAmount)
	{
		/////////////////////////////
		// If the entry already exists update the amount
		cGameStat@ pStat = GetEntry(alId);
		if (pStat !is null)
		{
			pStat.mlAmount = alAmount;
			
			//////////////////////////
			// Link hero stats
			cLux_GetHeroStatsHandler().SetHeroStatAmount(alId, alAmount);
			return;
		}
		
		////////////////////////
		// Inform the user that the entry doesn't exist
		cLux_AddDebugMessage("[GameStatsModule] [SetEntryAmount] Game stat entry " + alId + " doesn't exist!");
	}
	
	//------------------------------------------------------------
	
	void IncreaseEntryAmount(int alId, int alAmount)
	{
		int lNewAmount = GetEntryAmount(alId);
		lNewAmount += alAmount;
		SetEntryAmount(alId, lNewAmount);
		
		//////////////////////////
		// Link hero stats
		cLux_GetHeroStatsHandler().IncreaseHeroStatAmount(alId, alAmount);
	}
	
	//------------------------------------------------------------
	
	int GetEntryAmount(int alId)
	{
		cGameStat@ pStat = GetEntry(alId);
		if (pStat !is null)
			return pStat.mlAmount;
		
		return 0;
	}
	
	//------------------------------------------------------------
	
	bool GetEntryExists(int alId)
	{
		return GetEntry(alId) != null;
	}
	
	//------------------------------------------------------------
	
	void SaveStats()
	{
		cConfigFile@ pConfig = cLux_GetStatsConfig();
		if (pConfig is null) return;
		
		tString sCategory = cString_To8Char(cLux_GetSaveHandler().GetSaveSuffix());
		if(sCategory.length() == 0) sCategory = "base";

		Log("[GameStatsModule] Saving Game Stats for slot: " + sCategory + "\n");

		pConfig.SetFloat(sCategory, "TimePlayed", mfTimePlayed);
		pConfig.SetFloat(sCategory, "LongestTimeBetweenSaves", mfLongestTimeBetweenSaves);
		
		for (int i=0; i<mvGameStats.size(); i++)
		{
			cGameStat@ pStat = mvGameStats[i];
			if (pStat is null) continue;

			pConfig.SetInt(sCategory, pStat.msName, pStat.mlAmount);
		}
		
		pConfig.Save();
	}
	
	//------------------------------------------------------------
	
	void LoadStats()
	{
		cConfigFile@ pConfig = cLux_GetStatsConfig();
		if (pConfig is null) return;
		
		ResetAllEntries(false);
		
		tString sCategory = cString_To8Char(cLux_GetSaveHandler().GetSaveSuffix());
		if(sCategory.length() == 0) sCategory = "base";
		
		mfTimePlayed = pConfig.GetFloat(sCategory, "TimePlayed", 0.f);
		mfLongestTimeBetweenSaves = pConfig.GetFloat(sCategory, "LongestTimeBetweenSaves", 0.f);
		
		for (int i=0; i<mvGameStats.size(); i++)
		{
			cGameStat@ pStat = mvGameStats[i];
			if (pStat is null) continue;
			
			pStat.mlAmount = pConfig.GetInt(sCategory, pStat.msName, 0);
			Log("[GameStatsModule] Loading Game Stat " + pStat.msName + " for slot: " + sCategory + " with value " + pStat.mlAmount + "\n");
		}
	}
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// GUI
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	void OnGui(float afTimeStep)
	{
		if (mbGuiActive==false) return;
		if (MainMenu_IsShowing()) return;
			
		/////////////////////////////////////
		//Renders a in game mouse pointer.
		ImGui_SetShowMouseAutomatically(true);
		
		bool bShowDifficultySettings = Game_GetDifficultyMode()==eGameMode_Custom;
		
		/////////////////
		// Bg
		ImGui_SetAlignment(eImGuiAlign_TopCenter);
		cImGuiGfx gfxBg = cImGuiGfx("background_stats.dds", eImGuiGfx_TextureTemporary);
		ImGui_DoImage(gfxBg, ImGui_NrmPos(0.5,0,10), ImGui_NrmSize(1));
		
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
		
		/////////////////////////
		// Draw stuff
		cImGuiGfx gfxBlackBg;
		gfxBlackBg.mColor = cColor(0, 1);
		cVector3f vShadowOffset(1.5f, 1.f, 0.f);
		
		ImGui_GroupBegin(ImGui_FullScreenPos(10.f), ImGui_FullScreenSize());
		{
			ImGui_DoImage(gfxBlackBg, ImGui_NrmPosGroup(cVector3f(0,0,0)), ImGui_NrmSizeGroup(1));
			
			/////////////////////////
			// Do Lists
			{
				if (mbShowDifficultySettingsList==false)
					DoStatsGUI(afTimeStep);
				else
					DoDifficultySettingsGui(afTimeStep);
			}
			
			cImGuiButtonData buttonData;
			buttonData.mbUseInFocusColor = false;
			buttonData.mbUseBackgroundGfx = false;
			buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
			buttonData.mFont.mvSize = 22;
			buttonData.mFont.mColor = msSelectedButton=="Continue" ? cColor(1, 0.75, 0.25, 1) : cColor(1,1);
			
			cImGuiLabelData buttonLabelDataShadow = ImGui_GetDefaultLabel();
			buttonLabelDataShadow.mColorBase = cColor_White;
			buttonLabelDataShadow.mFontAlign = eFontAlign_Center;
			buttonLabelDataShadow.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
			buttonLabelDataShadow.mFont.mvSize = 22;
			buttonLabelDataShadow.mColorBase = cColor(0.f);
			
			ImGui_SetTransCategory("Menu");
			ImGui_SetAlignment(eImGuiAlign_TopCenter);
			
			cVector3f vButtonPos = ImGui_NrmPosGroup(0.5f, 0.81, 0);
			cVector2f vButtonSize = ImGui_NrmSizeGroup(0.1, 0.1);
			
			ImGui_DoLabelExt("Continue", buttonLabelDataShadow, vButtonPos + vShadowOffset, vButtonSize);
			
			if (ImGui_DoButtonExt("Continue", "Continue", buttonData, vButtonPos, vButtonSize))
			{
				if (mbShowDifficultySettingsList==false && bShowDifficultySettings)
				{
					mbShowDifficultySettingsList = true;
					return;
				}
				
				SetGuiActive(false);
				cLux_StartMap(cLux_GetMainMenuFile());
				cLux_GetEffectHandler().FadeOut(0.0);
				cLux_LoadScreenSetOneShotSolidColorBackground();
				Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
				return;
			}
			
			if (ImGui_PrevBecameInFocus())
			{
				Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
				msSelectedButton = "Continue";
			}
			
			ImGui_SetTransCategory("");
		}
		ImGui_GroupEnd();
		
		ImGui_SetAlignment(eImGuiAlign_TopLeft);
		ImGui_ResetModifiers();
		
		//////////////////////////
		// Just a dummy full screen button used for highlighting the Continue button above.
		if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed()==false)
		{
			cImGuiButtonData dummyButton;
			dummyButton.mbUseBackgroundGfx = false;
			ImGui_DoButtonExt("DummyButton", "", dummyButton, ImGui_NrmPos(0,0,0), ImGui_NrmSize(1));
			if (ImGui_PrevBecameInFocus())
				msSelectedButton = "";
		}		
	}
	
	//------------------------------------------------------------
	
	void DoStatsGUI(float afTimeStep)
	{
		cVector3f vShadowOffset(1.5f, 1.f, 0.f);
		
		///////////////////////////
		// Title
		cImGuiLabelData titleLabelData = ImGui_GetDefaultLabel();
		titleLabelData.mColorBase = cColor_White;
		titleLabelData.mFontAlign = eFontAlign_Center;
		titleLabelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
		titleLabelData.mFont.mvSize = 24;
		cVector3f vTitlePos = cVector3f(0.5, 0.113, 0);
		cVector2f vTitleSize = cVector2f(0.35, 0.035);
		
		cImGuiLabelData titleLabelDataShadow = titleLabelData;
		titleLabelDataShadow.mColorBase = cColor(0.f);			
		
		ImGui_SetAlignment(eImGuiAlign_TopCenter);
		ImGui_SetTransCategory("GameStats");
		ImGui_DoLabelExt("GameStatsTitle", titleLabelDataShadow, ImGui_NrmPosGroup(vTitlePos) + vShadowOffset, ImGui_NrmSizeGroup(vTitleSize));
		ImGui_DoLabelExt("GameStatsTitle", titleLabelData, ImGui_NrmPosGroup(vTitlePos), ImGui_NrmSizeGroup(vTitleSize));
		
		//////////////////////
		// Set up label widgets
		cImGuiLabelData labelData = ImGui_GetDefaultLabel();
		labelData.mColorBase = cColor_White;
		labelData.mFontAlign = eFontAlign_Left;
		labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
		labelData.mFont.mvSize = 17;
		
		cImGuiLabelData amountLabelData = labelData;
		amountLabelData.mFontAlign = eFontAlign_Left;			
		cImGuiLabelData labelDataShadow = labelData;
		labelDataShadow.mColorBase = cColor(0.f);			
		cImGuiLabelData amountLabelDataShadow = amountLabelData;
		amountLabelDataShadow.mColorBase = cColor(0.f);
		
		//////////////////
		// Get max label width
		ImGui_SetTransCategory("GameStats");
		
		float fFontWidthTimePlayed = GetFontLengthW(labelData.mFont, 1.f, "TimePlayed");
		float fFontWidthTimeBetweenSaves = GetFontLengthW(labelData.mFont, 1.f, "TimeBetweenSaves");
		float fMaxFontWidth = cMath_Max(fFontWidthTimePlayed, fFontWidthTimeBetweenSaves);
		
		for (int i = 0; i < mvGameStats.size(); ++i)
		{
			cGameStat@ pStat = mvGameStats[i];
			if (pStat is null) continue;				
							
			float fFontWidth = GetFontLengthW(labelData.mFont, 1.f, pStat.msName);
			if (fFontWidth > fMaxFontWidth)
			{
				fMaxFontWidth = fFontWidth;
			}
		}
		
		ImGui_SetTransCategory("");
		
		float fGroupSizeX = cLux_GetCurrentImGui().GetCurrentGroupSize().x;
		float fNrmMaxFontWidth = (fMaxFontWidth + 100.f) / fGroupSizeX;		
		float fMaxLineWidth = fNrmMaxFontWidth + (GetFontLengthW(labelData.mFont, 1.f, String_SecondsToClockDisplay(mfTimePlayed, true, true, true, false)) / fGroupSizeX);
		
		//////////////////
		// Position and scale labels	
		cVector3f vNamePos = cVector3f(0.5 - (fMaxLineWidth / 2.f), 0.185, 0);
		cVector2f vLabelSize = cVector2f(fNrmMaxFontWidth, 0.035);
		float fLineSpacing = vLabelSize.y * 0.8f;
		cVector3f vAmountPos = cVector3f(vNamePos.x + vLabelSize.x, vNamePos.y, 0);
					
		///////////////////////
		// Mode
		tString sCurrentLang = cLux_GetCurrentLanguage();
		bool bLowerCaseGameModeEntry = cString_GetFirstStringPos(sCurrentLang, "russian") == -1 &&
									   cString_GetFirstStringPos(sCurrentLang, "chinese") == -1;
		
		ImGui_SetAlignment(eImGuiAlign_CenterLeft);
		
		ImGui_SetTransCategory("Menu");
		tString sMode = "DifficultyMode";

		if (bLowerCaseGameModeEntry)
		{
			sMode = cString_To8Char(ImGui_Translate("DifficultyMode"));
			sMode = cString_Sub(sMode, 0, 1) + cString_ToLowerCase(cString_Sub(sMode, 1, sMode.length()));
			ImGui_SetTransCategory("");
		}
		
		ImGui_DoLabelExt(sMode, labelDataShadow, ImGui_NrmPosGroup(vNamePos) + vShadowOffset);
		ImGui_DoLabelExt(sMode, labelData, ImGui_NrmPosGroup(vNamePos));
		
		tString sDifficultyMode;
		switch (Game_GetDifficultyMode())
		{
			case eGameMode_VeryEasy: 	sDifficultyMode = "VeryEasy";	break;
			case eGameMode_Easy: 		sDifficultyMode = "Easy";		break;
			case eGameMode_Normal: 		sDifficultyMode = "Normal";		break;
			case eGameMode_Hard: 		sDifficultyMode = "Hard";		break;
			case eGameMode_UltraHard: 	sDifficultyMode = "ShellShock";	break;
			case eGameMode_Custom: 		sDifficultyMode = "Custom";		break;
			default:			 		sDifficultyMode = "Normal";		break;
		}
		
		ImGui_SetTransCategory("Menu");
		
		if (bLowerCaseGameModeEntry)
		{
			sDifficultyMode = cString_To8Char(ImGui_Translate(sDifficultyMode));
			
			if (cString_GetFirstStringPos(sCurrentLang, "english") == -1)
			{
				sDifficultyMode = cString_Sub(sDifficultyMode, 0, 1) + cString_ToLowerCase(cString_Sub(sDifficultyMode, 1, sDifficultyMode.length()));
			}
			else
			{
				tString sTempDifficultyMode = "";
				array<tString> vOut;
				cString_GetStringVec(sDifficultyMode, vOut, " ");
				
				for (int i = 0; i < vOut.size(); ++i)
				{
					tString sSubString = vOut[i];
					sTempDifficultyMode += cString_Sub(sSubString, 0, 1) + cString_ToLowerCase(cString_Sub(sSubString, 1, sSubString.length()));
					
					if (i < vOut.size() - 1)
						sTempDifficultyMode += " ";
				}
				
				sDifficultyMode = sTempDifficultyMode;
			}
			
			ImGui_SetTransCategory("");
		}
		
		ImGui_DoLabelExt(sDifficultyMode, labelDataShadow, ImGui_NrmPosGroup(vAmountPos) + vShadowOffset);
		ImGui_DoLabelExt(sDifficultyMode, labelData, ImGui_NrmPosGroup(vAmountPos));
		
		vNamePos.y += fLineSpacing;
		vAmountPos.y += fLineSpacing;
		
		///////////////////////
		// Draw playtime
		ImGui_SetTransCategory("GameStats");
		
		ImGui_DoLabelExt("TimePlayed", labelDataShadow, ImGui_NrmPosGroup(vNamePos) + vShadowOffset);
		ImGui_DoLabelExt("TimePlayed", labelData, ImGui_NrmPosGroup(vNamePos));
		
		vNamePos.y += fLineSpacing;
		
		ImGui_SetTransCategory("");
		tString sTimePlayedString = String_SecondsToClockDisplay(mfTimePlayed, true, true, true, false);
		ImGui_DoLabelExt(sTimePlayedString, amountLabelDataShadow, ImGui_NrmPosGroup(vAmountPos) + vShadowOffset);
		ImGui_DoLabelExt(sTimePlayedString, amountLabelData, ImGui_NrmPosGroup(vAmountPos));
		vAmountPos.y += fLineSpacing;
		
		/////////////////////////
		// Draw time between saves
		ImGui_SetTransCategory("GameStats");
		ImGui_DoLabelExt("TimeBetweenSaves", labelDataShadow, ImGui_NrmPosGroup(vNamePos) + vShadowOffset);
		ImGui_DoLabelExt("TimeBetweenSaves", labelData, ImGui_NrmPosGroup(vNamePos));
		vNamePos.y += fLineSpacing;
		
		ImGui_SetTransCategory("");
		tString sTimeBetweenSavesString = String_SecondsToClockDisplay(mfLongestTimeBetweenSaves, true, true, true, false);
		ImGui_DoLabelExt(sTimeBetweenSavesString, amountLabelDataShadow, ImGui_NrmPosGroup(vAmountPos) + vShadowOffset);
		ImGui_DoLabelExt(sTimeBetweenSavesString, amountLabelData, ImGui_NrmPosGroup(vAmountPos));
		vAmountPos.y += fLineSpacing;
		
		/////////////////////////
		// Draw all integer stats here
		for(int i=0; i<mvGameStats.size(); i++)
		{
			cGameStat@ pStat = mvGameStats[i];
			if (pStat is null) continue;
			
			/////////////////
			// Draw stat name
			ImGui_SetTransCategory("GameStats");
			ImGui_DoLabelExt(pStat.msName, labelDataShadow, ImGui_NrmPosGroup(vNamePos) + vShadowOffset);
			ImGui_DoLabelExt(pStat.msName, labelData, ImGui_NrmPosGroup(vNamePos));
			vNamePos.y += fLineSpacing;
			
			//////////////////
			// Draw stat Amount
			ImGui_SetTransCategory("");
			tString sStatAmount = cString_ToString(pStat.mlAmount, 0, true);
			ImGui_DoLabelExt(sStatAmount, amountLabelDataShadow, ImGui_NrmPosGroup(vAmountPos) + vShadowOffset);
			ImGui_DoLabelExt(sStatAmount, amountLabelData, ImGui_NrmPosGroup(vAmountPos));
			vAmountPos.y += fLineSpacing;
		}
		
		ImGui_SetTransCategory("");
	}
	
	//------------------------------------------------------------
	
	void DoDifficultySettingsGui(float afTimeStep)
	{
		cVector3f vShadowOffset(1.5f, 1.f, 0.f);
		
		///////////////////////////
		// Title
		cImGuiLabelData titleLabelData = ImGui_GetDefaultLabel();
		titleLabelData.mColorBase = cColor_White;
		titleLabelData.mFontAlign = eFontAlign_Center;
		titleLabelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
		titleLabelData.mFont.mvSize = 24;
		cVector3f vTitlePos = cVector3f(0.5, 0.113, 0);
		cVector2f vTitleSize = cVector2f(0.35, 0.035);
		
		cImGuiLabelData titleLabelDataShadow = titleLabelData;
		titleLabelDataShadow.mColorBase = cColor(0.f);			
		
		ImGui_SetAlignment(eImGuiAlign_TopCenter);
		ImGui_SetTransCategory("Menu");
		ImGui_DoLabelExt("DifficultySettingsTitle", titleLabelDataShadow, ImGui_NrmPosGroup(vTitlePos) + vShadowOffset, ImGui_NrmSizeGroup(vTitleSize));
		ImGui_DoLabelExt("DifficultySettingsTitle", titleLabelData, ImGui_NrmPosGroup(vTitlePos), ImGui_NrmSizeGroup(vTitleSize));
		
		//////////////////////
		// Set up label widgets
		cImGuiLabelData labelData = ImGui_GetDefaultLabel();
		labelData.mColorBase = cColor_White;
		labelData.mFontAlign = eFontAlign_Left;
		labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
		labelData.mFont.mvSize = 15;
		labelData.mbScrolling = true;
		labelData.mbUseBackgroundGfx = false;
		labelData.mfScrollSpeed = 15;
		labelData.mfScrollResetDelay = 2;
		labelData.mfScrollStartDelay = 2;
		
		cImGuiLabelData amountLabelData = labelData;
		amountLabelData.mFontAlign = eFontAlign_Left;			
		cImGuiLabelData labelDataShadow = labelData;
		labelDataShadow.mColorBase = cColor(0.f);			
		cImGuiLabelData amountLabelDataShadow = amountLabelData;
		amountLabelDataShadow.mColorBase = cColor(0.f);
		
		//////////////////
		// Get max label width
		const float fMaxFontWidthLimit = 0.5;
		float fMaxFontWidth = 0.f;
		const array<tString> vCustomSettings_Names = GameDifficulty_GetSettingsNames();
		const array<int> vCustomSettings_Ids = GameDifficulty_GetSettingsIDs();
		for (int i = 0; i < vCustomSettings_Names.size(); ++i)
		{
			tString sName = vCustomSettings_Names[i];			
			const tString sValue = GameDifficulty_GetSettingValueNameByID(i);
			float fFontWidth = GetFontLengthW(labelData.mFont, 1.f, sName);
			//const float fFontWidth_Value = GetFontLengthW(labelData.mFont, 1.f, sValue);
			//fFontWidth+=fFontWidth_Value;
			if (fFontWidth > fMaxFontWidth)
				fMaxFontWidth = fFontWidth;
		}
		
		ImGui_SetTransCategory("");
		
		float fGroupSizeX = cLux_GetCurrentImGui().GetCurrentGroupSize().x;
		float fNrmMaxFontWidth = (fMaxFontWidth + 100.f) / fGroupSizeX;				
		
		//////////////////
		// Position and scale labels	
		cVector3f vNamePos = cVector3f(0.21, 0.185, 0);
		const float fInitNamePosY = vNamePos.y;
		
		const float fLabelSizeX = cMath_Min(fNrmMaxFontWidth, 0.21) * 1.f;
		cVector2f vLabelSize = cVector2f(fLabelSizeX, 0.035);
		float fLineSpacing = vLabelSize.y * 0.8f;
		
		tString sCurrentLang = cLux_GetCurrentLanguage();
		bool bLowerCaseGameModeEntry = cString_GetFirstStringPos(sCurrentLang, "russian") == -1 && cString_GetFirstStringPos(sCurrentLang, "chinese") == -1;
		ImGui_SetTransCategory("Menu");
		cVector2f vLabelSizeClamped = ImGui_NrmSizeGroup(fLabelSizeX, -1);
		
		/////////////////////////
		// Draw settings
		const int lSettingsCount = vCustomSettings_Names.size();
		const int fColumnLength = cMath_RoundToInt(lSettingsCount/2);
		
		for(int i=0; i<lSettingsCount; i++)
		{
			cVector3f vCurrentPos = vNamePos;
			bool bSecondColumn = i > fColumnLength;
			float fSecondColumnPosOffset = 0.42f;
			if (bSecondColumn)
				vCurrentPos.x += fSecondColumnPosOffset;
				
			//////////////////////
			// Bring height to init pos to start a new Column
			if (i == fColumnLength)
			{
				vNamePos.y = fInitNamePosY-fLineSpacing;
			}
			
			tString sName = vCustomSettings_Names[i];
			
			/////////////////
			// Draw setting name
			ImGui_SetAlignment(eImGuiAlign_TopCenter);
			ImGui_DoLabelExt(sName, labelDataShadow, ImGui_NrmPosGroup(vCurrentPos) + vShadowOffset, vLabelSizeClamped);
			ImGui_DoLabelExt(sName, labelData, ImGui_NrmPosGroup(vCurrentPos) + cVector3f(0,0, 0.1), vLabelSizeClamped);
			vNamePos.y += fLineSpacing;
			
			//////////////////
			// Draw setting Amount
			ImGui_SetAlignment(eImGuiAlign_TopRight);
			const cVector3f vAmountPos = cVector3f(vCurrentPos.x + vLabelSize.x * 1.35, vCurrentPos.y, 0);
			const int lID = vCustomSettings_Ids[i];
			const tString sValue = GameDifficulty_GetSettingValueNameByID(lID);
			ImGui_DoLabelExt(sValue, amountLabelDataShadow, ImGui_NrmPosGroup(vAmountPos) + vShadowOffset);
			ImGui_DoLabelExt(sValue, amountLabelData, ImGui_NrmPosGroup(vAmountPos) + cVector3f(0,0, 0.1));
		}
		
		ImGui_SetTransCategory("");
	}
	
	//------------------------------------------------------------
	
	void OnDraw(float afFrameTime) {}
	void OnPostRender(float afFrameTime) {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont,float afY)
	{
		if (mbShowModuleOutput==false) return afY;
		
		afY = cLux_DrawDebugText("------------ Game Stats Handler ------------", afY);
		afY = cLux_DrawDebugText("TimePlayed: " + String_SecondsToClockDisplay(mfTimePlayed, true, true, true, false), afY);
		afY = cLux_DrawDebugText("LongestTimeBetweenSaves: " + String_SecondsToClockDisplay(mfLongestTimeBetweenSaves, true, true, true, false), afY);
		
		for(int i=0; i<mvGameStats.size(); i++)
		{
			cGameStat@ pStat = mvGameStats[i];
			if (pStat is null) continue;
			
			afY = cLux_DrawDebugText(pStat.msName+  " : " + pStat.mlAmount, afY);
		}
		
		return afY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// VARIABLES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbGuiActive = false;
	tString msSelectedButton;
	bool mbPlayTimerActive = true;
    [nosave] float mfTimePlayed = 0.f;
	[nosave] float mfLongestTimeBetweenSaves = 0.f;
	float mfLastSaveGameTime = 0;
    [nosave] array<cGameStat> mvGameStats;
	bool mbShowModuleOutput = false;
	bool mbShowDifficultySettingsList = false;
	
	//------------------------------------------------------------
}