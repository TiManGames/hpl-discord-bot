	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////	
	
	//------------------------------------------------------------
	
	void VariableUpdate(float afDeltaTime)
	{
		/////////////////////
		// Load values
		if (mvGameStats.size()==0)
		{
			ResetAllEntries();
			LoadStats();
		}
		
		////////////////////////////////////
		// Play time counter, disable for main menu
		cLuxMap@ pMap = cLux_GetCurrentMap();
		if (pMap !is null)
		{
			bool bRunTimer = pMap.GetName() != "main_menu";
			if (mbPlayTimerActive && bRunTimer)
				mfTimePlayed += afDeltaTime;
		}
	}
	
	void Update(float afTimeStep) {}
	void PostUpdate(float afTimeStep) {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// ACTIONS
	/////////////////////////////////////////
	
