//------------------------------------------------------------

class cGameStat
{
	[nosave] int mlId;
	[nosave] tString msName;
    [nosave] int mlAmount;
}

//------------------------------------------------------------

class cScrGameStatsHandler : iScrUserModule, iScrUserModule_Interface, iScrGameStatsHandler_Interface
{
