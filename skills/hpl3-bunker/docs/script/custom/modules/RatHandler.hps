	//------------------------------------------------------------
	
	float GetBloodTrailIntensity(tID a_idTrail)
	{
		for (uint i = 0; i < mvBloodTrails.size(); ++i)
		{
			cRat_BloodTrail@ pTrail = mvBloodTrails[i];
			if (pTrail.m_idEntity == a_idTrail) return pTrail.mfIntensity;
		}
		
		return 0;
	}
	
	//------------------------------------------------------------
	
	cRat_BloodTrail@ GetMostRecentBloodTrailAtPos(const cVector3f &in avPos, float afMaxDist)
	{
		////////////////
		// Get trails within distance
		int lMostRecentId = -1;
		int lMostRecentTimeStamp = -1000;
		int lCount = 0;
		for (uint i = 0; i < mvBloodTrails.size(); ++i)
		{						
			float fDistSqr = (mvBloodTrails[i].mvPosition - avPos).SqrLength();
			if (fDistSqr < afMaxDist * afMaxDist && mvBloodTrails[i].mlTimeStamp > lMostRecentTimeStamp)
			{
				lMostRecentId = i;
				lMostRecentTimeStamp = mvBloodTrails[i].mlTimeStamp;
				lCount++;
			}
		}
		
		if (lMostRecentId == -1) return null;
		
		return mvBloodTrails[lMostRecentId];
	}
	
	//------------------------------------------------------------
	
	bool GetPointIsInsidePathBlocker(const cVector3f &in avPos, tID &out a_idBody)
	{
		for (uint i = 0; i < mvPathBlockerBodyIds.size(); ++i)
		{
			tID idBody = mvPathBlockerBodyIds[i];
			iPhysicsBody@ pBody = cLux_ID_Body(idBody);
			cBoundingVolume@ pBounds = pBody !is null ? pBody.GetBoundingVolume() : null;
			
			if (pBounds is null) continue;
			
			cVector3f vOffset = cVector3f(0.2f);
			cVector3f vMin = pBounds.GetMin() - vOffset;
			cVector3f vMax = pBounds.GetMax() + vOffset;
			
			if (cMath_CheckPointInAABBIntersection(avPos, vMin, vMax))
			{
				a_idBody = idBody;
				return true;
			}
		}
		
		a_idBody = tID_Invalid;
		return false;
	}
	
