	//------------------------------------------------------------
	
	cRat_FoodEntity@ _AddFoodEntity(iLuxEntity@ apEntity)
	{
		if (apEntity is null) return null;
		
		iScrRatFoodComponent_Interface@ pFood = UserComponent_RatFoodComponent_Get(apEntity);
		if (apEntity.IsActive()==false) return null;
		if (pFood is null || pFood.GetIsDestroyed())  return null;
		
		cLuxMap@ pMap = apEntity.GetMap();
		if (pMap is null) return null;
		//if (pFood.GetAttractEnabled()==false) continue;
		
		for (uint i = 0; i < mvFoodEntities.length(); i++)
		{
			if (mvFoodEntities[i].mID == apEntity.GetID())
				return mvFoodEntities[i];
		}
		
		////////////////////////////////////
		// Get food entity name. If no alt entity use self.
		tString sAltFoodEnt = pFood.GetFoodEntity();
		tString sFoodEnt = (sAltFoodEnt=="") ? apEntity.GetName() : sAltFoodEnt;
		cLux_AddDebugMessage("[RatHandler]: Food Entity: " + sFoodEnt);
		
		////////////////////////////
		// Setup internal food ent class
		cRat_FoodEntity foodEntity;
		foodEntity.mID = apEntity.GetID();
		foodEntity.mlPriority = pFood.GetPriority();
		foodEntity.msFoodEntity = sFoodEnt;
		foodEntity.mlFeedingSlotsCount = pFood.GetFeedingSlotsCount();
		foodEntity.mfLifeTime = pFood.GetLifeTime();
		foodEntity.mfAttractDistance = pFood.GetAttractDistance();
		foodEntity.mbIsArea = pFood.GetIsArea();
		foodEntity.mbIsThrownMeat = pFood.GetIsThrownMeat();
		
		/////////////////////////
		// Get actual food entity
		iLuxEntity@ pActualFoodEnt = foodEntity.mbIsArea ? apEntity : pMap.GetEntityByName(sFoodEnt);			
		if (pActualFoodEnt !is null)
		{
			foodEntity.mvBoundsCenter = pActualFoodEnt.GetPosition();
			if (foodEntity.mbIsArea==false)
			{
				cMeshEntity@ pMeshEntity = pActualFoodEnt.GetMeshEntity();
				if (pMeshEntity !is null)
					foodEntity.mvBoundsCenter = pMeshEntity.GetBoundingVolume().GetPosition();
			}
			
			GetFeedPositionsAtFoodEntity(foodEntity.mvFeedPositions, pActualFoodEnt, foodEntity.mlFeedingSlotsCount, foodEntity.mbIsArea);
		}
		
		foodEntity.mvAgentIds.resize(foodEntity.mlFeedingSlotsCount);
		foodEntity.mvFeedSlotFreeDelays.resize(foodEntity.mlFeedingSlotsCount);
		for (int i = 0; i < foodEntity.mlFeedingSlotsCount; ++i)
		{
			foodEntity.mvAgentIds[i] = tID_Invalid;
			foodEntity.mvFeedSlotFreeDelays[i] = -1;
		}
		
		mvFoodEntities.push_back(foodEntity);
		
		/////////////////////////////////////////
		// Disable agent collision on food entity
		array<iLuxEntity@> vFoodEnts;
		pMap.GetEntityArray(foodEntity.msFoodEntity, eLuxEntityType_Prop, "*", vFoodEnts);

		for (uint i = 0; i < vFoodEnts.size(); ++i)
		{
			iLuxEntity@ pFoodEnt = vFoodEnts[i];
			if (pFoodEnt is null) continue;
			
			for (int k = 0; k < pFoodEnt.GetBodyNum(); ++k)
			{
				iPhysicsBody@ pBody = pFoodEnt.GetBody(k);
				pBody.SetCollideCharacter(false);
				pBody.SetCollideRagDoll(false);
			}
		}
		
		return foodEntity;
	}
	
	//------------------------------------------------------------
	
	void DistributeRats()
	{
		//////////////////////////////
		// Distribute rats by entities
		uint lRatId = 0;
		
		for (uint i = 0; i < mvFoodEntities.size(); ++i)
		{
			/////////////////////
			// Setup vars
			cRat_FoodEntity@ pFoodEntity = mvFoodEntities[i];
			if (pFoodEntity is null) continue;
			
			uint lMaxRatCountAtEntity = cMath_Min(lRatId + pFoodEntity.mlFeedingSlotsCount, mvRatIds.size());
			
			/////////////////////
			// Iterate rats
			for (; lRatId < lMaxRatCountAtEntity; ++lRatId)
			{
				cLuxAgent@ pAgent = cLux_ID_Agent(mvRatIds[lRatId]);
				iCharacterBody@ pCharBody = pAgent !is null ? pAgent.GetCharBody() : null;
				tString sRat = pAgent !is null ? pAgent.GetName() : "";
				
				//cLux_AddDebugMessage(pAgent.GetName()+" Health: "+pAgent.GetHealth());
				if (pAgent.GetHealth() <= 0) continue;
				if (pCharBody is null) continue;
				if (Rat_GetSpawnAtPos(sRat)) continue;
				
				/////////////////////
				// Place at feed pos
				cVector3f vFeedPos = AddRatToFoodEntity(pFoodEntity, pAgent.GetID());
				float fYaw = cMath_GetAngleFromPoints3D(vFeedPos, pFoodEntity.mvBoundsCenter).y;
				
				pCharBody.SetFeetPosition(vFeedPos, false);
				pCharBody.SetYaw(fYaw);
				pAgent.SetActive(mbActive);
				
				Rat_Eat(sRat, pFoodEntity.mID);
			}
		}
		
		//////////////////////
		// Any rats left? Hide them!
		for (; lRatId < mvRatIds.size(); ++lRatId)
		{
			cLuxAgent@ pAgent = cLux_ID_Agent(mvRatIds[lRatId]);
			if (pAgent is null) continue;
			if (pAgent.GetHealth() <= 0) continue;
			
			pAgent.SetActive(false);
			
			if (Rat_GetSpawnAtPos(pAgent.GetName())) continue;
			
			AddHidingRat(mvRatIds[lRatId]);
		}
	}
	
	//------------------------------------------------------------
	
	void SetupHoles(cLuxMap@ apMap)
	{
		///////////////////////////////////
		// Fetch the holes
		int lGhoulNetwork = Blackboard_RegisterGhoulHoleNetwork(apMap, "GhoulHole_*");
		array<tID> vHoleIds = Blackboard_GetGhoulHoleNetwork(lGhoulNetwork);
		int lRatNetwork = Blackboard_RegisterGhoulHoleNetwork(apMap, "RatHole_*");
		array<tID> vRatHoleIds = Blackboard_GetGhoulHoleNetwork(lRatNetwork);
		for (uint i = 0; i < vRatHoleIds.length(); i++)
			vHoleIds.push_back(vRatHoleIds[i]);
		
		cLuxPathfinder@ pPathfinder = GetPathfinder();
		if (pPathfinder is null) return;
		
		mvHoles.resize(vHoleIds.length());
		for (uint i = 0; i < mvHoles.length(); i++)
		{
			cRat_Hole@ pHole = mvHoles[i];
			pHole.m_idEntity = vHoleIds[i];
			iLuxEntity@ pHoleEntity = cLux_ID_Entity(pHole.m_idEntity);
			
			for (uint j = i+1; j < vHoleIds.length(); j++)
			{
				tID idTargetHole = vHoleIds[j];
				iLuxEntity@ pTargetHoleEntity = cLux_ID_Entity(idTargetHole);
				
				if (pPathfinder.BuildPathNodeArrayFromTo(pHoleEntity.GetPosition(), pTargetHoleEntity.GetPosition()))
				{
					cRat_Hole@ pTargetHole = mvHoles[j];
					pTargetHole.mvConnections.push_back(pHole.m_idEntity);
					pHole.mvConnections.push_back(idTargetHole);
				}
			}
			
/*			cLux_AddDebugMessage("Connections for "+pHoleEntity.GetName());
			for (int k = 0; k < pHole.mvConnections.length(); k++)
			{
				cLux_AddDebugMessage(cLux_ID_Entity(pHole.mvConnections[k]).GetName());
			}*/
			
			pHole.mfBaseWeight = pHole.mvConnections.length() > 0 ? 1 : 0;
		}
	}
	
	//------------------------------------------------------------
	
	cRat_Hole@ GetBestHoleFromPos(const cVector3f &in avPos, bool abIgnoreEmergeTimer = false, float afDistanceThreshold = 5.f, bool abOnlyGhoulHoles = false)
	{		
		if (mvRatIds.length() == 0)
			return null;
		
		//////////////////
		// No holes available, escape!
		if (mvHoles.size() == 0)
			return null;
		
		//////////////////
		// Get hole with shortest path to pos
		// TODO: Getting path distance to all holes is very expensive! Find out better way of doing this.
		float fMinDist = 1000.f;
		cRat_Hole@ pClosest = null;
		
		cLuxPathfinder@ pPathfinder = GetPathfinder();
		if (pPathfinder is null) return null;

		cSystem_ProfileStart("RatHandler_GetBestHoleFromPos");
		
		for (uint i = 0; i < mvHoles.size(); ++i)
		{
			cRat_Hole@ pHole = mvHoles[i];
			if (pHole is null) continue;
			if (!abIgnoreEmergeTimer && pHole.mfEmergeTimer > 0) continue;
			if (GetIsHoleBlocked(pHole.m_idEntity)) continue;
			
			cLuxArea@ pArea = cLux_ID_Area(pHole.m_idEntity);
			if (pArea is null) continue;
			if (pArea.IsActive() == false) continue;
			if (abOnlyGhoulHoles && cString_GetFirstStringPos(pArea.GetName(), "RatHole") >= 0) continue;
			
			cVector3f vAreaPos = pArea.GetPosition();
			vAreaPos.y = pArea.GetAreaBody().GetBoundingVolume().GetMin().y + 0.2f;
			
			// And skip holes that are further away than closest hole
			if(cMath_Vector3DistSqr(avPos, vAreaPos) > fMinDist * fMinDist)
				continue;
			
			float fDist = GetPathDistanceToPos(avPos, vAreaPos, pPathfinder);
			if (fDist < fMinDist && fDist > 0.f)
			{
				fMinDist = fDist;
				@pClosest = pHole;
				
				// If dist is short enough, just get this one!
				if (fDist <= afDistanceThreshold)
				{
					cSystem_ProfileEnd("RatHandler_GetBestHoleFromPos");
					return pClosest;
				}
			}
		}
		
		cSystem_ProfileEnd("RatHandler_GetBestHoleFromPos");
		return pClosest;
	}	
	
	//------------------------------------------------------------
	
	float GetPathDistanceToPos(const cVector3f &in avFrom, const cVector3f &in avTo, cLuxPathfinder@ aPathfinder)
	{
		if (aPathfinder.BuildPathNodeArrayFromTo(avFrom, avTo))
			return aPathfinder.GetPathNodeArrayFullLength();
		
		return -1.f;
	}
	
	//------------------------------------------------------------
	
	void GetFeedPositionsAtFoodEntity(array<cVector3f> &out avFeedPositions, iLuxEntity@ apEntity, int alAvailableFeedSlots, bool abIsArea)
	{
		if (apEntity is null) return;
		if (alAvailableFeedSlots == 0) return;
		
		avFeedPositions.resize(alAvailableFeedSlots);
		
		/////////////
		// Setup vars
		cBoundingVolume@ pBounds = null;
		cVector3f vOffset = 0;
		if (abIsArea)
		{
			cLuxArea@ pArea = cLux_ToArea(apEntity);
			if (pArea is null)
			{
				Error("[RatHandler] RatFoodComponent is defined as area but is not!");
				return;
			}
			
			@pBounds = pArea.GetAreaBody().GetBoundingVolume();
		}
		else
		{
			cMeshEntity@ pMeshEntity = apEntity.GetMeshEntity();
			if (pMeshEntity is null)
			{
				Error("[RatHandler] RatFood mesh entity is null!");
				return;
			}

			@pBounds = pMeshEntity.GetBoundingVolume();
			//vOffset = pBounds.GetWorldCenter();
		}
		cVector3f vLocalMin = pBounds.GetLocalMin()-vOffset;
		cVector3f vLocalMax = pBounds.GetLocalMax()-vOffset;
		
		//////////////////
		// Expand bounds if too small to fit all rats
		float fMinCircumference = alAvailableFeedSlots * 0.35f;
		float fCircumference = ((vLocalMax.x-vLocalMin.x)+(vLocalMax.z-vLocalMin.z))*2;
		if (fCircumference < fMinCircumference)
		{
			float fExpansion = (fMinCircumference - vLocalMax.x*2 + vLocalMin.x*2 - vLocalMax.z*2 + vLocalMin.z*2)/8.0f;
			vLocalMin -= cVector3f(fExpansion, 0, fExpansion);
			vLocalMax += cVector3f(fExpansion, 0, fExpansion);
		}
		
		cVector3f[] vPoints = { cVector3f(vLocalMax.x, vLocalMax.y, vLocalMax.z), 
									cVector3f(vLocalMax.x, vLocalMax.y, vLocalMin.z),
									cVector3f(vLocalMin.x, vLocalMax.y, vLocalMin.z),
									cVector3f(vLocalMin.x, vLocalMax.y, vLocalMax.z) };
										 
		cVector3f[] vEdges = { vPoints[1] - vPoints[0], 
								   vPoints[2] - vPoints[1],
								   vPoints[3] - vPoints[2],
								   vPoints[0] - vPoints[3] };
								   
		///////////////////////////////////////
		// Calculate distance along the area's top edges
		float fTotalDist = 0.f;		
		for (uint i=0; i < vEdges.length(); ++i)
		{
			fTotalDist += vEdges[i].Length();
		}
		
		float fAvailableDist = fTotalDist;
		
		/////////////////////////////////////////
		// Calculate min step dist required for the number of positions
		float fMinStepDist = fTotalDist / float(alAvailableFeedSlots);
		if (fMinStepDist > gfRatHandler_DefaultFeedPosStepMinDist)
			fMinStepDist = gfRatHandler_DefaultFeedPosStepMinDist;
			
		//////////////////////////
		// Calculate the positions
		for (int i=0; i < alAvailableFeedSlots; ++i)
		{
			////////////////////
			// Get max step dist
			// (Make sure to leave enough room for all positions)
			float fMinNeededDist = fMinStepDist * (alAvailableFeedSlots - i);
			float fMaxStepDist = cMath_RandRectf(fMinStepDist, fAvailableDist / 2.f);
			
			if (fAvailableDist - fMaxStepDist < fMinNeededDist)
			{
				float fRemainder = fAvailableDist % fMinNeededDist;
				fMaxStepDist = fMinStepDist + cMath_RandRectf(0.f, fRemainder);
			}
		
			/////////////////
			// Get step dist
			float fStepDist = cMath_RandRectf(fMinStepDist, fMaxStepDist);
			fAvailableDist -= fStepDist;
			
			float fTotalStepDist = fTotalDist - fAvailableDist;
			
			///////////////////////
			// Get position on edge
			cVector3f vPos = cVector3f(0.f);
			for (uint j = 0; j < vEdges.length(); ++j)
			{
				cVector3f vEdge = vEdges[j];
				float fEdgeDist = vEdge.Length();
				
				/////////////////////////
				// Is point on this edge?
				if (fTotalStepDist <= fEdgeDist || j == vEdges.length()-1)
				{
					float fT = fTotalStepDist / fEdgeDist;
					vPos = vPoints[j] + cMath_Vector3Normalize(vEdge) * fEdgeDist * fT;
					break;
				}
				
				///////////////
				// Keep looking
				else
				{
					fTotalStepDist -= fEdgeDist;
				}
			}

			vPos.y = vLocalMin.y;
			avFeedPositions[i] = vPos;
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f AddRatToFoodEntity(cRat_FoodEntity@ apFoodEntity, tID a_idAgent)
	{
		//////////////////
		// Setup vars
		cLuxAgent@ pAgent = cLux_ID_Agent(a_idAgent);
		
		if (apFoodEntity is null) 
			return cVector3f(0.f);	
		if (pAgent is null) 
			return cVector3f(0.f);
		if (GetRatIsInFoodEntity(apFoodEntity, a_idAgent))
			return cVector3f(0.f);
			
		iLuxEntity@ pEnt = cLux_ID_Entity(apFoodEntity.mID);
		if (pEnt is null) return cVector3f(0.f);
		
		int lFreeSlotId = -1;
		float fMinDistSqr = 1000.f * 1000.f;
		cVector3f vFeedPos = cVector3f(0.f);
		
		/////////////////////////
		// Iterate feed positions
		for (uint i = 0; i < apFoodEntity.mvFeedPositions.size(); ++i)
		{
			/////////////////////////
			// Reserved by this agent? Just pick this one.
			if (apFoodEntity.mvAgentIds[i] == a_idAgent)
			{
				lFreeSlotId = i;
				vFeedPos = cMath_MatrixMul(pEnt.GetMatrix(), apFoodEntity.mvFeedPositions[i]);
				vFeedPos.y = apFoodEntity.mvFeedPositions[i].y+pEnt.GetPosition().y;
				break;
			}
			
			/////////////////////////
			// Used by another agent?
			if (apFoodEntity.mvAgentIds[i] != tID_Invalid)
				continue;
			
			///////////////////////
			// Get closest feed pos
			cVector3f vWorldPos = cMath_MatrixMul(pEnt.GetMatrix(), apFoodEntity.mvFeedPositions[i]);
			vWorldPos.y = apFoodEntity.mvFeedPositions[i].y+pEnt.GetPosition().y;
			float fDistSqr = (vWorldPos - pAgent.GetPosition()).SqrLength();
			if (fDistSqr < fMinDistSqr)
			{
				lFreeSlotId = i;
				fMinDistSqr = fDistSqr;
				vFeedPos = vWorldPos;
			}
		}
		
		/////////////////////////////////////////
		// Assign agent to slot and get feed pos!
		if (lFreeSlotId != -1)
		{
			apFoodEntity.mvAgentIds[lFreeSlotId] = a_idAgent;
			apFoodEntity.mvFeedSlotFreeDelays[lFreeSlotId] = -1;
		}
		return vFeedPos;
	}
	
	//------------------------------------------------------------
	
	cVector3f GetFeedWorldPos(cRat_FoodEntity@ apFoodEntity, tID a_idAgent)
	{
		iLuxEntity@ pEnt = cLux_ID_Entity(apFoodEntity.mID);
		if (pEnt is null) return cVector3f_Zero;
		
		cVector3f vFeedPos = cVector3f_Zero;
		
		/////////////////////////
		// Find the right slot
		for (uint i = 0; i < apFoodEntity.mvFeedPositions.size(); ++i)
		{
			/////////////////////////
			// Reserved by this agent? Just pick this one.
			if (apFoodEntity.mvAgentIds[i] != a_idAgent)
				continue;
			
			vFeedPos = cMath_MatrixMul(pEnt.GetMatrix(), apFoodEntity.mvFeedPositions[i]);
			vFeedPos.y = apFoodEntity.mvFeedPositions[i].y+pEnt.GetPosition().y;
			return vFeedPos;
		}
		
		return pEnt.GetPosition();
	}
	
	//------------------------------------------------------------
	
	void RemoveRatFromFoodEntity(cRat_FoodEntity@ apFoodEntity, tID a_idAgent, float afDelay)
	{
		if (apFoodEntity is null) return;
		
		int lId = apFoodEntity.mvAgentIds.find(a_idAgent);
		if (lId == -1) return;
		
		if (afDelay > 0)
			apFoodEntity.mvFeedSlotFreeDelays[lId] = afDelay;
		else
			apFoodEntity.mvAgentIds[lId] = tID_Invalid;
	}
	
	//------------------------------------------------------------
	
	bool GetRatIsInFoodEntity(cRat_FoodEntity@ apFoodEntity, tID a_idAgent)
	{
		if (apFoodEntity is null) return false;
		
		int lIx = apFoodEntity.mvAgentIds.find(a_idAgent);
		return lIx != -1 && apFoodEntity.mvFeedSlotFreeDelays[lIx] <= 0;
	}
	
	//------------------------------------------------------------
	
	bool GetFoodEntityIsFree(cRat_FoodEntity@ apFoodEntity)
	{
		return apFoodEntity !is null && apFoodEntity.mvAgentIds.find(tID_Invalid) != -1;
	}
	
	//------------------------------------------------------------
	
	cRat_FoodEntity@ GetFreeFoodEntity(tID a_idAgent, bool abCheckAttractionDistance, bool abCheckThrownMeat)
	{
		///////////////////////////
		// Get ent ids and separate thrown meat from other entities
		array<int> vRandomIds;
		array<int> vThrownMeatIds;
		for (uint i = 0; i < mvFoodEntities.size(); ++i)
		{
			cRat_FoodEntity@ pFoodEntity = mvFoodEntities[i];
			
			if (pFoodEntity is null) continue;
			
			if (pFoodEntity.mbIsThrownMeat)
				vThrownMeatIds.push_back(i);
			else
				vRandomIds.push_back(i);
		}
		
		//////////////////////////
		// Prioritize thrown meat if available and checked for
		while (abCheckThrownMeat && vThrownMeatIds.length() > 0)
		{
			cRat_FoodEntity@ pFoodEntity = mvFoodEntities[vThrownMeatIds[0]];
			vThrownMeatIds.removeAt(0);
			
			if (CheckValidFoodEntity(pFoodEntity, a_idAgent, abCheckAttractionDistance))
				return pFoodEntity;
		}
		
		//////////////////////////
		// Randomly select an entity and check if it's free
		while (vRandomIds.size() > 0)
		{
			int lId = cMath_RandRectl(0, vRandomIds.size() - 1);
			cRat_FoodEntity@ pFoodEntity = mvFoodEntities[vRandomIds[lId]];
			
			vRandomIds.removeAt(lId);
			
			if (CheckValidFoodEntity(pFoodEntity, a_idAgent, abCheckAttractionDistance))
				return pFoodEntity;
		}
		
		return null;
	}
	
	//------------------------------------------------------------
	
	bool CheckValidFoodEntity(cRat_FoodEntity@ apFoodEntity, tID a_idAgent, bool abCheckAttractionDistance)
	{
		if (apFoodEntity is null)
			return false;
		if (apFoodEntity.mfThreatTime > 0)
			return false;
		if (GetFoodEntityIsFree(apFoodEntity) == false)
			return false;
		if (GetRatIsInFoodEntity(apFoodEntity, a_idAgent))
			return false;
			
		/////////////////////////////////////////////////////
		// Check so agent is within attraction distance
		if (abCheckAttractionDistance || apFoodEntity.mbIsThrownMeat)
		{
			cVector3f vFoodPos = cLux_ID_Entity(apFoodEntity.mID).GetPosition();
			cVector3f vAgentPos = cLux_ID_Entity(a_idAgent).GetPosition();
			
			if ((vAgentPos-vFoodPos).Length() > apFoodEntity.mfAttractDistance)
				return false;
			
			cLuxPathfinder@ pPathfinder = GetPathfinder();
			if (pPathfinder !is null && pPathfinder.BuildPathNodeArrayFromTo(vAgentPos, vFoodPos)==false)
			{
				return false;
				
			}
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	cRat_FoodEntity@ GetClosestFoodEntity(tID a_idAgent)
	{
		cVector3f vPos = cLux_ID_Entity(a_idAgent).GetPosition();
		float fClosest = 999999.0f;
		int lClosestIx = -1;
		for (uint i = 0; i < mvFoodEntities.size(); ++i)
		{
			cRat_FoodEntity@ pFoodEntity = mvFoodEntities[i];
			float fDist = (pFoodEntity.mvBoundsCenter - vPos).SqrLength();
			if (fDist > fClosest)
				continue;
			fClosest = fDist;
			lClosestIx = i;
		}
		return (lClosestIx >= 0) ? mvFoodEntities[lClosestIx] : null;
	}
	
	//------------------------------------------------------------
	
	cRat_FoodEntity@ GetFoodEntityFromId(tID a_idEntity)
	{
		for (uint i = 0; i < mvFoodEntities.size(); ++i)
		{
			cRat_FoodEntity@ pFoodEnt = mvFoodEntities[i];
			if (pFoodEnt is null) continue;
			
			if (pFoodEnt.mID == a_idEntity)
				return pFoodEnt;
		}
		
		return null;
	}
		
	//------------------------------------------------------------
	
	cLuxPathfinder@ GetPathfinder()
	{
		if (mvRatIds.length() == 0) return null;
		
		tID idRat = mvRatIds[0];
		cLuxAgent@ pAgent = cLux_ID_Agent(idRat);
		if (pAgent is null) return null;
		
		return cast<cLuxPathfinder@>(pAgent.GetComponentByType(eLuxEntityComponentType_Pathfinder));
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetActive(bool abX)
	{
		if (mbActive == abX) return;
		
		mbActive = abX;
		
		if (mbActive)
		{
			for (uint i = 0; i < mvRatIds.size(); ++i)
			{
				cLuxAgent@ pAgent = cLux_ID_Agent(mvRatIds[i]);
				pAgent.SetActive(true);
			}
			
			for (uint i = 0; i < mvHidingRats.size(); ++i)
			{
				cRat_Hiding@ pRat = mvHidingRats[i];
				if (pRat is null) continue;
				
				cLuxAgent@ pAgent = cLux_ID_Agent(pRat.m_idAgent);
				if (pAgent !is null) pAgent.SetActive(false);
			}
		}
		else
		{
			for (uint i = 0; i < mvRatIds.size(); ++i)
			{
				cLuxAgent@ pAgent = cLux_ID_Agent(mvRatIds[i]);
				if (pAgent !is null) pAgent.SetActive(false);
			}
		}
	}
	
