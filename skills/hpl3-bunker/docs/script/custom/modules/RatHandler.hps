	//------------------------------------------------------------
	
	bool GetAttackAllowed()
	{
		float fRatAggressiveness = GameDifficulty_GetSettingValueByID_Float(eGameDifficultySetting_RatsAggressiveness);;
		float fAttackDelayMul = 1.0f;
		
		if (fRatAggressiveness > 1.0)
			fAttackDelayMul = 1.0f - fRatAggressiveness*0.125;
		else if (fRatAggressiveness < 1.0)
			fAttackDelayMul = 1.0f + (1.0f/fRatAggressiveness)*0.25f;
		
		int lMinDelayIx = cMath_Clamp(mvAttackingRatIds.size()-1, 0, gvRatHandler_MinRatAttackDelays.size()-1);
		float fDelay = gvRatHandler_MinRatAttackDelays[lMinDelayIx]*fAttackDelayMul;
		return cLux_GetCurrentMap().GetElapsedTime(mlLastAttackTimeStamp) > fDelay;
	}
	
	//------------------------------------------------------------
	
	void DoRatAttack()
	{
		mlLastAttackTimeStamp = cLux_GetCurrentMap().GetTimeStamp();
	}
	
	//------------------------------------------------------------
	
	bool GetWarningAttackWasIssued()
	{
		float fTimeSinceWarning = cLux_GetCurrentMap().GetElapsedTime(mlWarningAttackTimeStamp);
		return fTimeSinceWarning > 0.75f && fTimeSinceWarning < 10.0f;
	}
	
	//------------------------------------------------------------
	
	bool GetWarningAttackIsPending()
	{
		float fTimeSinceWarning = cLux_GetCurrentMap().GetElapsedTime(mlWarningAttackTimeStamp);
		return fTimeSinceWarning < 10.0f;
	}
	
	//------------------------------------------------------------
	
	void IssueWarningAttack(tID a_idFoodEntity)
	{
		cRat_FoodEntity@ pFood = GetFoodEntityFromId(a_idFoodEntity);
		if (pFood is null)
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(a_idFoodEntity);
			Error("[Rat Handler] Attempting to issue warning attack for invalid food entity '"+(pEnt is null ? "NULL" : pEnt.GetName())+"'");
			return;
		}
		
		tString sClosestAgent = "";
		float fClosestDist = 10000.0f;
		for (uint i = 0; i < pFood.mvAgentIds.length(); i++)
		{
			cLuxAgent@ pRat = cLux_ID_Agent(pFood.mvAgentIds[i]);
			if (pRat is null) continue;
			
			if (StateMachine_GetCurrentStateName(pRat.GetName()) == "Eat")
			{
				float fDist = pRat.GetDistanceToPlayer2D();
				if (fDist < fClosestDist)
				{
					fClosestDist = fDist;
					sClosestAgent = pRat.GetName();
				}
			}
		}
		
		if (sClosestAgent == "")
		{
			iLuxEntity@ pEnt = cLux_ID_Entity(a_idFoodEntity);
			Error("[Rat Handler] Could not find valid rat for issuing warning attack on food entity '"+(pEnt is null ? "NULL" : pEnt.GetName())+"'");
			return;
		}
		
		Rat_Attack(sClosestAgent, true, true);
		mlWarningAttackTimeStamp = cLux_GetCurrentMap().GetTimeStamp();
	}
	
