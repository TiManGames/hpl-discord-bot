	cVector3f AddEatingRat(tID a_idAgent, tID a_idEntity)
	{
		cRat_FoodEntity@ pFoodEntity = GetFoodEntityFromId(a_idEntity);
		if (pFoodEntity is null) return cVector3f(0.f);
		
		return AddRatToFoodEntity(pFoodEntity, a_idAgent);
	}
	
	//------------------------------------------------------------
	
	void RemoveEatingRat(tID a_idAgent, float afDelay = 0, tID a_idSpecificFood = tID_Invalid)
	{
		for (uint i = 0; i < mvFoodEntities.size(); ++i)
		{
			cRat_FoodEntity@ pFoodEntity = mvFoodEntities[i];
			if (a_idSpecificFood != tID_Invalid && pFoodEntity.mID != a_idSpecificFood)
				continue;
				
			RemoveRatFromFoodEntity(pFoodEntity, a_idAgent, afDelay);
		}
	}
	
	//------------------------------------------------------------
	
	void SetFoodThreatTime(tID a_idFood, float afTime)
	{
		cRat_FoodEntity@ pFoodEntity = null;
		for (uint i = 0; i < mvFoodEntities.size(); ++i)
		{
			if (mvFoodEntities[i].mID != a_idFood)
				continue;
			
			@pFoodEntity = mvFoodEntities[i];
			break;
		}
		
		if (pFoodEntity is null) return;
		
		pFoodEntity.mfThreatTime = afTime;
		
		if (afTime < 0) return;
		
		for (int i = 0; i < pFoodEntity.mvAgentIds.length(); i++)
		{
			cLuxAgent@ pRat = cLux_ID_Agent(pFoodEntity.mvAgentIds[i]);
			if (pRat is null) continue;
			
			if (StateMachine_GetCurrentStateName(pRat.GetName()) != "Eat")
				continue;
			
			Rat_Retreat(pRat.GetName(), true, true, false, "", true);
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f GetFeedWorldPos(tID a_idAgent, tID a_idEntity)
	{
		cRat_FoodEntity@ pFoodEntity = GetFoodEntityFromId(a_idEntity);
		if (pFoodEntity is null) return cVector3f(0.f);
		
		return GetFeedWorldPos(pFoodEntity, a_idAgent);
	}
	
	//------------------------------------------------------------
	
	bool AddHidingRat(tID a_idAgent, tID a_idUsedHole = tID_Invalid)
	{
		///////////////
		// Already hiding?
		bool bExists = false;
		for (uint i = 0; i < mvHidingRats.size(); ++i)
		{
			cRat_Hiding@ pHidingRat = mvHidingRats[i];
			if (pHidingRat is null) continue;
			
			if (pHidingRat.m_idAgent == a_idAgent)
			{
				bExists = true;
				break;
			}
		}
		
		///////////////
		// Add to hiding array!
		if (bExists == false)
		{
			cRat_Hiding hidingRat;
			hidingRat.m_idAgent = a_idAgent;
			hidingRat.mfHideCount = cMath_RandRectf(gfRatHandler_RatHideTimeMin, gfRatHandler_RatHideTimeMax);
			mvHidingRats.push_back(hidingRat);
			
			if (a_idUsedHole != tID_Invalid)
			{
				for (uint i = 0; i < mvHoles.length(); i++)
				{
					if (mvHoles[i].m_idEntity == a_idUsedHole)
					{
						mvHoles[i].mfEmergeTimer = gfRatHandler_RatEmergeDelay;
					}
				}
			}
			
			return true;
		}
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void RemoveHidingRat(tID a_idAgent)
	{
		for (uint i = 0; i < mvHidingRats.size(); ++i)
		{
			cRat_Hiding@ pHidingRat = mvHidingRats[i];
			if (pHidingRat is null) continue;
			
			if (pHidingRat.m_idAgent == a_idAgent)
			{
				mvHidingRats.removeAt(i);
				break;
			}
		}
	}
	
