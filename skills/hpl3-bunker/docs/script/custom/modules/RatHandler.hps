		_AddFoodEntity(apEntity);
	}
	
	//------------------------------------------------------------
	
	void RemoveFoodEntity(tID a_idEntity)
	{
		cRat_FoodEntity@ pFoodEnt = null;
		int lIx = -1;
		for (uint i = 0; i < mvFoodEntities.length(); i++)
		{
			if (mvFoodEntities[i].mID != a_idEntity) continue;
			
			@pFoodEnt = mvFoodEntities[i];
			lIx = i;
		}
		
		if (pFoodEnt is null) return;
			
		float fRetreatDelay = 0;
		for (uint i = 0; i < pFoodEnt.mvAgentIds.length(); i++)
		{
			if (pFoodEnt.mvAgentIds[i] == tID_Invalid || pFoodEnt.mvFeedSlotFreeDelays[i] > 0) 
				continue;
			
			cLuxAgent@ pRat = cLux_ID_Agent(pFoodEnt.mvAgentIds[i]);
			
			tString sState = StateMachine_GetCurrentStateName(pRat.GetName());
			
			if (sState == "Eat" || sState == "FindFood")
			{
				Rat_DelayedFoodRetreat(pRat.GetName(), fRetreatDelay);
				fRetreatDelay += cMath_RandRectf(0.4, 0.8);
			}
		}
		mvFoodEntities.removeAt(lIx);
	}
	
	//------------------------------------------------------------
	
	float GetPlayerDistanceToClosestRat()
	{
		float fMinDistSqr = 1000.f * 1000.f;
		cVector3f vPlayerPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
		
		for (int i = 0; i < mvRatIds.size(); ++i)
		{
			cLuxAgent@ pAgent = cLux_ID_Agent(mvRatIds[i]);
			
			if (pAgent is null) continue;
			if (pAgent.IsActive() == false) continue;
			
			float fDistSqr = (vPlayerPos - pAgent.GetPosition()).SqrLength();
			if (fDistSqr < fMinDistSqr)
			{
				fMinDistSqr = fDistSqr;
			}
		}
		
		return cMath_Sqrt(fMinDistSqr);
	}
	
	//------------------------------------------------------------
	
	void AddPathBlocker(tID a_idBlockerBody, bool abIsDamageArea)
	{		
		////////////////
		// Add to array
		if (mvPathBlockerBodyIds.find(a_idBlockerBody) != -1)
			return;
		
		mvPathBlockerBodyIds.push_back(a_idBlockerBody);
		
		////////////////
		// Add to rats
		for (uint i = 0; i < mvRatIds.size(); ++i)
		{
			tID idRat = mvRatIds[i];
			cLuxAgent@ pAgent = cLux_ID_Agent(idRat);
			if (pAgent is null) continue;

			cLuxPathfinder@ pPathfinder = cast<cLuxPathfinder@>(pAgent.GetComponentByType(eLuxEntityComponentType_Pathfinder));
			if (pPathfinder is null) continue;
			
			
			if (abIsDamageArea && 
				mvIgnoreDamageAreasRatIds.find(idRat) != -1)
			{
				continue;
			}
			
			pPathfinder.AddPathBlockerBody(a_idBlockerBody);
		}
	}
	
	//------------------------------------------------------------
	
	void RemovePathBlocker(tID a_idBlockerBody)
	{
		////////////////
		// Remove from array
		int lId = mvPathBlockerBodyIds.find(a_idBlockerBody);
		if (lId == -1) return;
		
		mvPathBlockerBodyIds.removeAt(lId);
		
		////////////////
		// Remove from rats
		for (uint i = 0; i < mvRatIds.size(); ++i)
		{
			cLuxAgent@ pAgent = cLux_ID_Agent(mvRatIds[i]);
			cLuxPathfinder@ pPathfinder = pAgent !is null ? cast<cLuxPathfinder@>(pAgent.GetComponentByType(eLuxEntityComponentType_Pathfinder)) : null;
			
			if (pAgent is null) continue;
			if (pPathfinder is null) continue;
			
			pPathfinder.RemovePathBlockerBody(a_idBlockerBody);
		}
	}
	
