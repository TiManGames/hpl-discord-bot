	float mfUpdateDamageAreaCount = 0.1f;
	bool mbPlayerThreatensRats = false;
	int mlLastAttackTimeStamp = -10000;
	int mlWarningAttackTimeStamp = -10000;

	int mlHidingRatIndex;
	
	[nosave] bool mbNonAggressiveRats = false;
	
	array<tID> mvRatIds;
	array<tID> mvAttackingRatIds;
	array<tID> mvAlertedRatIds;
	array<tID> mvStalkingRatIds;
	array<tID> mvPathBlockerBodyIds;
	array<tID> mvIgnoreDamageAreasRatIds;
	array<cRat_Hiding> mvHidingRats;
	array<cRat_FoodEntity> mvFoodEntities;
	array<cRat_BloodTrail> mvBloodTrails;
	array<cRat_Hole> mvHoles;

	tID m_idStalker = tID_Invalid;
	
