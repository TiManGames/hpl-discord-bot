//----------------------------------------------------------------------------------------

const float gfRatHandler_DefaultFeedPosStepMinDist = 0.5f;
const float gfRatHandler_RatCollisionCheckMinDistSqr = 0.3f * 0.3f;
const float gfRatHandler_RatCollisionCheckMaxPushForce = 3000.0f;
const float gfRatHandler_StalkerRetreatMinDistSqr = 5.f * 5.f;
const float gfRatHandler_RatHideTimeMin = 7;
const float gfRatHandler_RatHideTimeMax = 14;
const float gfRatHandler_RatEmergeDelay = 3.0f;
const float gfRatHandler_TrackBloodTrailMinDist = 6.0f;
const float gfRatHandler_TrackBloodTrailMinIntensity = 0.0f;
const float gfRatHandler_TrackBloodTrailMaxChance = 0.25f;
const float gfRatHandler_BloodTrailConnectionMinDistSqr = 1.f * 1.f;
const float gfRatHandler_BloodTrailHoleWeightContribution = 5.0f;

const float[] gvRatHandler_MinRatAttackDelays = {1.0f, 0.9f, 0.8f, 0.75f, 0.7f};

//----------------------------------------------------------------------------------------

class cRat_FoodEntity
{
	tID mID;
	int mlPriority;
	int mlFeedingSlotsCount;
	int mlCurrentRatCount;
	float mfLifeTime;
	float mfAttractDistance;
	cVector3f mvBoundsCenter;
	tString msFoodEntity;
	array<tID> mvAgentIds;
	array<cVector3f> mvFeedPositions;
	array<float> mvFeedSlotFreeDelays;
	bool mbIsArea;
	bool mbIsThrownMeat;
	float mfThreatTime = -1;
	int mlUnreachableCount = 0;
}

//----------------------------------------------------------------------------------------

class cRat_Hiding
{
	tID m_idAgent;
	float mfHideCount;
}

//----------------------------------------------------------------------------------------

class cRat_BloodTrail
{
	cVector3f mvPosition;
	tID m_idEntity;
	float mfIntensity;
	int mlTimeStamp;
}

//----------------------------------------------------------------------------------------

class cRat_Hole
{
	tID m_idEntity;
	float mfBaseWeight = 0;
	float mfWeight = 0;
	float mfEmergeTimer = 0;
	tID m_idBloodTrail;
	array<tID> mvConnections;
	
	int opCmp(const cRat_Hole &in pOther)
	{
		if (mfWeight > pOther.mfWeight) return 1;
		if (mfWeight < pOther.mfWeight) return -1;
		return 0;
	}
}

//----------------------------------------------------------------------------------------

class cScrRatHandler : iScrUserModule, iScrUserModule_Interface, iScrRatHandler_Interface
{
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		LoadUserConfig();
	}
		
	//------------------------------------------------------------
	
	void LoadUserConfig() 
	{
		mbNonAggressiveRats = cLux_GetUserConfig().GetBool("Accessibility", "NonAggressiveRats", false);
	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig() {}
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// MAP LOADING
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnMapEnter(cLuxMap@ apMap)
	{
		///////////////
		// Setup vars
		Reset();
		
		///////////////
		// Get stalker
		array<iLuxEntity@> vStalkers;
		apMap.GetEntityArray("*", eLuxEntityType_Agent, "cScrAgentStalker", vStalkers);
		
		if (vStalkers.size() > 0)
		{
			m_idStalker = vStalkers[0].GetID();
		}
		
		///////////////
		// Get rats
		apMap.GetEntityArrayID("*", eLuxEntityType_Agent, "cScrAgentRat", mvRatIds);
		
		///////////////
		// Add path blockers
		array<tID> vPathBlockers;
		array<iLuxEntity@> vDoors;
		array<iLuxEntity@> vGratings;
		apMap.GetEntityArray("*", eLuxEntityType_Prop, "cScrPropSwingDoor", vDoors);
		apMap.GetEntityArray("*", eLuxEntityType_Prop, "cScrPropGrating", vGratings);
		
		for (uint i = 0; i < vDoors.size(); ++i)
			vPathBlockers.push_back(SwingDoor_GetDoorBodyID(vDoors[i].GetName()));
			
		for (uint i = 0; i < vGratings.size(); ++i)
		{
			iLuxEntity@ pGrating = vGratings[i];
			
			if (pGrating.IsActive() == false) continue;
			if (Grating_GetIsOpen(pGrating.GetName())) continue;
			
			vPathBlockers.push_back(pGrating.GetMainBody().GetID());
		}
			
		cLuxEntityComponentIterator@ pBreakableIt = cLux_GetCurrentMap().GetEntityComponentIterator(eComponentType_Custom_WoodenBreakableComponent);
		while (pBreakableIt.HasNext())
		{
			iLuxEntityComponent@ pComp = pBreakableIt.Next();
			if (pComp is null) continue;
			iLuxEntity @pEnt = pComp.GetEntity();
			if (pEnt is null) continue;
			
			iScrWoodenBreakableComponent_Interface@ pBreakableComp = UserComponent_WoodenBreakableComponent_Get(pEnt);
			if (pBreakableComp.GetIsPathBlocker()==false) continue;
			
			vPathBlockers.push_back(pEnt.GetMainBody().GetID());
		}
		
		for (uint i = 0; i < vPathBlockers.size(); ++i)
		{
			tID idBlockerBody = vPathBlockers[i];
			if (idBlockerBody == tID_Invalid) continue;
			
			AddPathBlocker(idBlockerBody, false);
		}
		
		SetupHoles(apMap);
		
		if (GameDifficulty_GetNewGamePlusActive() == false)
		{
			SetupFeedAreas();
		}
	}
	
	//------------------------------------------------------------

	void OnMapLeave(cLuxMap@ apMap) 
	{
	}
	
	//------------------------------------------------------------
	
	void CreateWorldEntities(cLuxMap@ apMap) {}	
	void DestroyWorldEntities(cLuxMap@ apMap) {}
	void PreloadData(cLuxMap@ apMap) {}	
	void OnEnterContainer(const tString&in asOldContainer) {}
	void OnLeaveContainer(const tString&in asNewContainer) {}
	
	//------------------------------------------------------------
	
	void Reset()
	{
		mlFrameRatUpdateId = -1;		
		mlPathBlockerCheckId = -1;
		mfUpdateDamageAreaCount = 0.1f;
		mvRatIds.resize(0);
		mvAttackingRatIds.resize(0);
		mvAlertedRatIds.resize(0);
		mvPathBlockerBodyIds.resize(0);
		mvIgnoreDamageAreasRatIds.resize(0);
		mvHidingRats.resize(0);
		mvFoodEntities.resize(0);
		mvBloodTrails.resize(0);
		mvHoles.resize(0);
		m_idStalker = tID_Invalid;
		mlLastAttackTimeStamp = -10000;
		mlWarningAttackTimeStamp = -10000;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////	
	
	//------------------------------------------------------------
	
	void VariableUpdate(float afDeltaTime)
	{		
		if (!mbActive) return;
		
		////////////////
		// Get frame update rat
		cLuxAgent@ pRat = null;
		if (mvRatIds.size() > 0)
		{
			mlFrameRatUpdateId = ++mlFrameRatUpdateId % mvRatIds.size();
			@pRat = cLux_ID_Agent(mvRatIds[mlFrameRatUpdateId]);
		}
		
		////////////////
		// Updates
		
		cSystem_ProfileStart("UpdateFoodEntities");
			UpdateFoodEntities(afDeltaTime); 
		cSystem_ProfileEnd("UpdateFoodEntities");
		cSystem_ProfileStart("UpdateTrackBloodTrail");
			UpdateTrackBloodTrail(afDeltaTime, pRat); 
		cSystem_ProfileEnd("UpdateTrackBloodTrail");
		cSystem_ProfileStart("UpdateHidingRats");
			UpdateHidingRats(afDeltaTime, pRat); 
		cSystem_ProfileEnd("UpdateHidingRats");
		cSystem_ProfileStart("UpdateRatOnRatCollision");
			UpdateRatOnRatCollision(afDeltaTime, pRat); 
		cSystem_ProfileEnd("UpdateRatOnRatCollision");
		cSystem_ProfileStart("UpdatePathBlockers");
			UpdatePathBlockers(afDeltaTime); 
		cSystem_ProfileEnd("UpdatePathBlockers");
		cSystem_ProfileStart("UpdateFleeStalker");
			UpdateFleeStalker(afDeltaTime, pRat); 
		cSystem_ProfileEnd("UpdateFleeStalker");
		cSystem_ProfileStart("UpdateRagdolls");
			UpdateRagdolls(afDeltaTime, pRat); 
		cSystem_ProfileEnd("UpdateRagdolls");
		cSystem_ProfileStart("UpdateThreatenedRats");
			UpdateThreatenedRats(afDeltaTime, pRat); 
		cSystem_ProfileEnd("UpdateThreatenedRats");
	}
	
	void UpdateFoodEntities(float afDeltaTime)
	{
		for (uint i = 0; i < mvFoodEntities.length(); i++)
		{
			cRat_FoodEntity@ pFood = mvFoodEntities[i];
			
			if (pFood.mfThreatTime > 0)
				pFood.mfThreatTime -= afDeltaTime;
			
			/////////////////////////////
			// Free up slots
			bool bBeingEaten = false;
			for (uint j = 0; j < pFood.mvAgentIds.length(); j++)
			{
				if (pFood.mvFeedSlotFreeDelays[j] > 0)
				{
					pFood.mvFeedSlotFreeDelays[j] -= afDeltaTime;
					if (pFood.mvFeedSlotFreeDelays[j] <= 0)
					{
						pFood.mvAgentIds[j] = tID_Invalid;
					}
				}
				
				if (!bBeingEaten && pFood.mfLifeTime > 0 && pFood.mvAgentIds[j] != tID_Invalid)
				{
					cLuxAgent@ pRat = cLux_ID_Agent(pFood.mvAgentIds[j]);
					if (pRat is null) continue;
					
					if (StateMachine_GetCurrentStateName(pRat.GetName()) == "Eat")
					{
						bBeingEaten = true;
						pFood.mfLifeTime -= afDeltaTime;
					}
				}
			}
			
			//////////////////////////////
			// Remove invalid entities
			iLuxEntity@ pFoodEnt = cLux_ID_Entity(pFood.mID);
			iScrRatFoodComponent_Interface@ pFoodComponent = pFoodEnt !is null ? UserComponent_RatFoodComponent_Get(pFoodEnt) : null;
			
			if (pFoodComponent !is null && bBeingEaten && pFood.mfLifeTime < 0)
				pFoodComponent.SetIsDestroyed(true);
			
			if (pFoodEnt is null || pFoodComponent is null || pFoodComponent.GetIsDestroyed())
			{
				RemoveFoodEntity(pFood.mID);
				i--;
				continue;
			}
			
			//////////////////////////////
			// Update position
			if (pFood.mbIsArea==false)
			{
				cMeshEntity@ pMeshEntity = pFoodEnt.GetMeshEntity();
				if (pMeshEntity !is null)
				{
					pFood.mvBoundsCenter = pMeshEntity.GetBoundingVolume().GetPosition();
				}
			}
			else
			{
				pFood.mvBoundsCenter = pFoodEnt.GetPosition();
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateTrackBloodTrail(float afDeltaTime, cLuxAgent@ apRat)
	{
		if (apRat is null) return;
		if (apRat.IsActive() == false) return;
		if (mbNonAggressiveRats) return;
		
		////////////////
		// Trail exists?
		if (mvBloodTrails.size() == 0)
		{
			Rat_SetPrevClosestBloodTrail(apRat.GetName(), tID_Invalid);
			return;
		}
		
		////////////////
		// Get most recent blood trail near rat!
		cRat_BloodTrail@ pTrail = GetMostRecentBloodTrailAtPos(apRat.GetPosition(), gfRatHandler_TrackBloodTrailMinDist);
		if (pTrail !is null)
		{
			tID idPrevTrail = Rat_GetPrevClosestBloodTrail(apRat.GetName());
			if (idPrevTrail == pTrail.m_idEntity) return;
			
			//cLux_AddDebugMessage("FOUND A TRAIL "+pTrail.mfIntensity);
			Rat_SetPrevClosestBloodTrail(apRat.GetName(), pTrail.m_idEntity);
			
			float fDifficultyMultiplier = GameDifficulty_GetSettingValueByID_Float(eGameDifficultySetting_RatsAggressiveness);

			////////////////////////////////////////
			// Check if trail should be tracked
			if (Player_GetIsBleeding() == false || 
				pTrail.mfIntensity < gfRatHandler_TrackBloodTrailMinIntensity ||
				cMath_RandRectf(0.0f, 1.0f) > gfRatHandler_TrackBloodTrailMaxChance*fDifficultyMultiplier*pTrail.mfIntensity)
				return;
			
			//cLux_AddDebugMessage("TRACK THE TRAIL");
			Rat_TrackBloodTrail(apRat.GetName(), pTrail.m_idEntity);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateHidingRats(float afDeltaTime, cLuxAgent@ apRat)
	{
		for (uint i = 0; i < mvHoles.length(); i++)
		{
			cRat_Hole@ pHole = mvHoles[i];
			if (pHole.mfEmergeTimer > 0)
				pHole.mfEmergeTimer -= afDeltaTime;
		}
		
		////////////////////
		// Iterate hiding rats
		for (uint lRatIx = 0; lRatIx < mvHidingRats.size(); ++lRatIx)
		{
			cRat_Hiding@ pHidingRat = mvHidingRats[lRatIx];
			if (pHidingRat is null) continue;
			pHidingRat.mfHideCount -= afDeltaTime;
			
			////////////////////////////////
			// Only evaluate the current rat
			if (pHidingRat.m_idAgent != apRat.GetID()) continue;
			
			////////////////////
			// Hidden long enough?
			if (pHidingRat.mfHideCount <= 0.f)
			{
				tID idFood = GetFreeFoodEntityId(pHidingRat.m_idAgent, false, false);
				tID idEmergeHole = tID_Invalid;
				tID idTargetHole = tID_Invalid;
				tID idTargetBloodTrail = tID_Invalid;
				
				//////////////////////////////
				// temp fix for bugged mesh bounds
				if (idFood != tID_Invalid)
				{
					cVector3f vAreaPos = cVector3f_Zero;
					if (GetRatFoodIsArea(idFood)==false)
					{
						iLuxEntity@ pEntity = cLux_ID_Entity(idFood);
						
						if (pEntity !is null)
						{
							vAreaPos = pEntity.GetPosition();
							vAreaPos.y = pEntity.GetMeshEntity().GetBoundingVolume().GetMin().y + 0.2f;
						}
					}
					else
					{
						cLuxArea@ pArea = cLux_ID_Area(idFood);
						if (pArea !is null)
						{
							vAreaPos = pArea.GetPosition();
							vAreaPos.y = pArea.GetAreaBody().GetBoundingVolume().GetMin().y + 0.2f;
						}
					}
					
					cRat_Hole@ pBestHole = GetBestHoleFromPos(vAreaPos, true);
					if (pBestHole !is null && pBestHole.mfEmergeTimer <= 0)
					{
						idEmergeHole = pBestHole.m_idEntity;
						pBestHole.mfEmergeTimer = gfRatHandler_RatEmergeDelay;
					}
				}
				
				if (idEmergeHole == tID_Invalid)
				{
					idFood = tID_Invalid;
					
					float fBloodTrailMultiplier = GameDifficulty_GetSettingValueByID_Float(eGameDifficultySetting_RatsAggressiveness);
					
					///////////////////////////////////////////////
					// Calculate hole weights
					cRat_Hole@ pHole = null;
					iLuxEntity@ pHoleEnt = null;
					float fTotalWeight = 0;
					for (uint i = 0; i < mvHoles.length(); i++)
					{
						@pHole = mvHoles[i];
						pHole.mfWeight = pHole.mfBaseWeight;
						pHole.m_idBloodTrail = tID_Invalid;
						
						@pHoleEnt = cLux_ID_Entity(pHole.m_idEntity);
		
						cRat_BloodTrail@ pTrail = GetMostRecentBloodTrailAtPos(pHoleEnt.GetPosition(), gfRatHandler_TrackBloodTrailMinDist);
						bool bBloodTrailFound = mbNonAggressiveRats == false &&
												pTrail !is null && 
												pTrail.mfIntensity > gfRatHandler_TrackBloodTrailMinIntensity && 
												Player_GetIsBleeding();
						if (bBloodTrailFound)
						{
							float fTrailTime = cLux_GetCurrentMap().GetElapsedTime(pTrail.mlTimeStamp);
							float fTimeMul = 1.0f + cMath_Clamp(1.0f-(fTrailTime/30.0f), 0.0f, 1.0f);
							
							if (fTrailTime > 5.0f) // Prevent rats from immediately starting to come out after taking damage
							{
								pHole.mfWeight += gfRatHandler_BloodTrailHoleWeightContribution * fBloodTrailMultiplier * pTrail.mfIntensity * fTimeMul;
								pHole.m_idBloodTrail = pTrail.m_idEntity;
							}
						}
							
						if (!bBloodTrailFound || 
							GetIsHoleBlocked(pHole.m_idEntity) ||
							pHoleEnt.IsActive() == false)
						{
							pHole.mfWeight = 0;
						}
						
						pHole.mfWeight = cMath_Max(pHole.mfWeight, 0.0f);
						
						fTotalWeight += pHole.mfWeight;
					}
					
					//////////////////////////////////////////////
					// Create list of candidate indexes
					array<int> vHoleCandidates;
					vHoleCandidates.resize(mvHoles.length()); 
					for (uint i = 0; i < mvHoles.length(); i++)
						vHoleCandidates[i] = i;
					
					////////////////////////////////////////////
					// Select random hole based on weight
					while (vHoleCandidates.length() > 0)
					{
						if (fTotalWeight <= 0) break;
						
						/////////////////////////////
						// Select random weight
						float fRandWeight = cMath_RandRectf(0, fTotalWeight);
						//cLux_AddDebugMessage("Selecting weight "+fRandWeight);
						
						/////////////////////////////
						// Pick the first hole with a culumative weight higher than random value
						cRat_Hole@ randomHole;
						int lRandIx = 0;
						float fCumulativeWeight = 0;
						for (uint i = 0; i < vHoleCandidates.length(); i++)
						{
							lRandIx = i;
							@randomHole = mvHoles[vHoleCandidates[i]];
							fCumulativeWeight += randomHole.mfWeight;
							if (fCumulativeWeight >= fRandWeight)
								break;
						}
						//cLux_AddDebugMessage("Selected index "+vHoleCandidates[lRandIx]);
					
						vHoleCandidates.removeAt(lRandIx);
						
						if (randomHole is null) continue;
						
						idEmergeHole = randomHole.m_idEntity;
						
						bool bEmergeTimerOver = randomHole.mfEmergeTimer <= 0;
						
						if (bEmergeTimerOver && randomHole.m_idBloodTrail != tID_Invalid)
						{
							idTargetBloodTrail = randomHole.m_idBloodTrail;
							randomHole.mfEmergeTimer = gfRatHandler_RatEmergeDelay;
						}
						break;
					}
				}
				
				if (idEmergeHole == tID_Invalid)
					continue;
				
				cLuxAgent@ pRat = cLux_ID_Agent(pHidingRat.m_idAgent);
				if (pRat is null) continue;
				
				////////////////////
				// Can emerge?
				if ((idFood != tID_Invalid && Rat_EmergeToFood(pRat.GetName(), idEmergeHole, idFood)) ||
					(idTargetHole != tID_Invalid && Rat_EmergeToWander(pRat.GetName(), idEmergeHole, idTargetHole)) ||
					(idTargetBloodTrail != tID_Invalid && Rat_EmergeToBloodTrail(pRat.GetName(), idEmergeHole, idTargetBloodTrail)))
				{
					mvHidingRats.removeAt(lRatIx);
					--lRatIx;
				}
				
				////////////////////
				// Otherwise, restart hiding!
				else
				{
					pHidingRat.mfHideCount = cMath_RandRectf(gfRatHandler_RatHideTimeMin, gfRatHandler_RatHideTimeMax);
				}
			}
		}
	}
	
	//------------------------------------------------------------
	
	// TODO: Find a better way of doing this
	void UpdateRatOnRatCollision(float afDeltaTime, cLuxAgent@ apRat)
	{
		if (apRat is null) return;
		if (apRat.IsActive() == false) return;
		
		////////////////////
		// Setup vars
		iCharacterBody@ pCharBody = apRat.GetCharBody();
		
		bool bCollideChar = true;
		bool bIsAttacking = mvAttackingRatIds.find(apRat.GetID()) != -1;		
		
		////////////////////
		// Push away from other rats
		cVector3f vPushForce = cVector3f_Zero;
		for (uint i = 0; i < mvRatIds.size(); ++i)
		{			
			cLuxAgent@ pOtherRat = cLux_ID_Agent(mvRatIds[i]);
			
			if (pOtherRat is null) continue;
			if (pOtherRat.IsActive() == false) continue;
			if (apRat is pOtherRat) continue;
			if (StateMachine_GetCurrentStateName(pOtherRat.GetName())=="Dead") continue;
			
			////////////////////
			// Don't collide if close enough and at least one is not moving
			cVector3f vDelta = pOtherRat.GetPosition() - apRat.GetPosition();
			float fDistSqr = vDelta.SqrLength();
			
			if (fDistSqr < gfRatHandler_RatCollisionCheckMinDistSqr)
			{
				float fT = (1.0f-(fDistSqr/gfRatHandler_RatCollisionCheckMinDistSqr));
				float fForce = cMath_Easing(eEasing_QuadIn, fT, 0, gfRatHandler_RatCollisionCheckMaxPushForce);
				vPushForce += cMath_Vector3Normalize(vDelta) * -fForce;
			}
		}
		apRat.SetVarVector3f("CollisionPushForce", cMath_Vector3ClampLength(vPushForce, 0, gfRatHandler_RatCollisionCheckMaxPushForce));
	}
	
	//------------------------------------------------------------
	
	void UpdatePathBlockers(float afDeltaTime)
	{		
		if (mvPathBlockerBodyIds.size() == 0)
			return;
		
		////////////////
		// Check one body per frame
		mlPathBlockerCheckId = ++mlPathBlockerCheckId % mvPathBlockerBodyIds.size();
		tID idBody = mvPathBlockerBodyIds[mlPathBlockerCheckId];
		iPhysicsBody@ pBody = cLux_ID_Body(idBody);		
		
		////////////////
		// Body is gone, remove!
		if (pBody is null)
		{
			RemovePathBlocker(idBody);
		}
		
		////////////////
		// Update damage areas if they have changed
		if(mlPathBlockerCounter != Blackboard_GetPathBlockerCounter())
		{
			mlPathBlockerCounter = Blackboard_GetPathBlockerCounter();
			array<tID> vDamageAreaIds = Blackboard_GetPathBlockerBodyIds(false, true);
			for (uint i = 0; i < vDamageAreaIds.size(); ++i)
				AddPathBlocker(vDamageAreaIds[i], true);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateFleeStalker(float afDeltaTime, cLuxAgent@ apRat)
	{
		if (apRat is null) return;
		if (apRat.IsActive() == false) return;
		if (StateMachine_GetCurrentStateName(apRat.GetName())=="Dead") return;
		
		//////////////////
		// Get stalker
		cLuxAgent@ pStalker = cLux_ID_Agent(m_idStalker);

		if (pStalker is null) return;
		if (pStalker.IsActive() == false) return;
		if (pStalker.GetMeshEntity().IsVisible() == false) return;
		
		//////////////////
		// Retreat if stalker is near!
		float fDistSqr = (pStalker.GetPosition() - apRat.GetPosition()).SqrLength();
		if (fDistSqr < gfRatHandler_StalkerRetreatMinDistSqr)
		{
			Rat_Retreat(apRat.GetName(), true, true, false);
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateRagdolls(float afDeltaTime, cLuxAgent@ apRat)
	{
		if (apRat is null) return;
		if (apRat.IsActive() == false) return;
		
		//////////////////////
		// Update ragdoll
		if (apRat.IsSleeping() && apRat.GetRagdollActive())
		{
			apRat.UpdateRagdoll();
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateThreatenedRats(float afDeltaTime, cLuxAgent@ apRat)
	{
		if (mbPlayerThreatensRats==false)
		{
			return;
		}
			
		if (apRat is null) return;
		if (apRat.IsActive() == false) return;
		
		tString sEntName = apRat.GetName();
		
		if (Rat_GetInThreatReactionRange(sEntName) && Entity_IsInPlayerFOV(sEntName))
		{
			Rat_Threatened(sEntName);
		}
	}

	//------------------------------------------------------------
	
	void Update(float afTimeStep) {}
	void PostUpdate(float afTimeStep) {}
	
