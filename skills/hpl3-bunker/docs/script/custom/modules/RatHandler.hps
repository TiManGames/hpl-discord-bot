	//------------------------------------------------------------
	
	void SetRatIgnoresDamageAreas(tID a_idAgent, bool abX)
	{
		///////////////
		// Get id
		int lIgnoringRatId = mvIgnoreDamageAreasRatIds.find(a_idAgent);		
		
		///////////////
		// Set to ignore!
		if (abX)
		{
			if (lIgnoringRatId != -1)
				return;
			
			///////////////
			// Get rat
			int lRatId = mvRatIds.find(a_idAgent);
			cLuxAgent@ pAgent = lRatId != -1 ? cLux_ID_Agent(mvRatIds[lRatId]) : null;
			cLuxPathfinder@ pPathfinder = pAgent !is null ? cast<cLuxPathfinder@>(pAgent.GetComponentByType(eLuxEntityComponentType_Pathfinder)) : null;
			
			if (pPathfinder is null) 
				return;
			
			///////////////
			// Remove damage areas from rat's pathfinding
			array<tID> vDamageAreaIds = Blackboard_GetPathBlockerBodyIds(false, true);
			for (uint i = 0; i < vDamageAreaIds.size(); ++i)
				pPathfinder.RemovePathBlockerBody(vDamageAreaIds[i]);		
				
			///////////////
			// Add rat to damage area ignore array
			mvIgnoreDamageAreasRatIds.push_back(a_idAgent);
		}
		
		///////////////
		// Stop ignoring
		else
		{
			if (lIgnoringRatId != -1)
				mvIgnoreDamageAreasRatIds.removeAt(lIgnoringRatId);
		}
	}
	
	//------------------------------------------------------------
	
	void AddBloodTrail(tID a_idEntity, float afIntensity)
	{
		////////////////
		// Get trail
		cLuxProp@ pTrail = cLux_ID_Prop(a_idEntity);
		if (pTrail is null) return;
		
		////////////////
		// Invalid?
		if (a_idEntity == tID_Invalid)
			return;
			
		////////////////
		// Already exists?
		for (uint i = 0; i < mvBloodTrails.size(); ++i)
		{
			if (mvBloodTrails[i].m_idEntity == a_idEntity)
				return;
		}
		
		////////////////
		// Close to another trail? If so, bump that one up to the front to make it most recent!
		for (uint i = 0; i < mvBloodTrails.size(); ++i)
		{
			float fDistSqr = (mvBloodTrails[i].mvPosition - pTrail.GetPosition()).SqrLength();
			if (fDistSqr < gfRatHandler_BloodTrailConnectionMinDistSqr)
			{
				mvBloodTrails.push_back(mvBloodTrails[i]);
				mvBloodTrails.removeAt(i);
				return;
			}
		}
		
		float fRatAggressiveness = GameDifficulty_GetSettingValueByID_Float(eGameDifficultySetting_RatsAggressiveness);
			
		////////////////
		// Add it!
		cRat_BloodTrail bloodTrail;
		bloodTrail.m_idEntity = a_idEntity;
		bloodTrail.mvPosition = pTrail.GetPosition();	
		bloodTrail.mfIntensity = afIntensity * fRatAggressiveness;
		bloodTrail.mlTimeStamp = cLux_GetCurrentMap().GetTimeStamp();
		mvBloodTrails.push_back(bloodTrail);
	}
	
	//------------------------------------------------------------
	
	void RemoveBloodTrail(tID a_idEntity)
	{
		for (uint i = 0; i < mvBloodTrails.size(); ++i)
		{
			if (mvBloodTrails[i].m_idEntity == a_idEntity)
			{
				mvBloodTrails.removeAt(i);
				break;
			}
		}
	}
	
