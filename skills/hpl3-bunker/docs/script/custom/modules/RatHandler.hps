		if (pHole is null) return tID_Invalid;
		
		return pHole.m_idEntity;
	}
	
	//------------------------------------------------------------
	
	tID GetRandomHoleId(tID a_idIgnoredHole, bool abCheckPath, const cVector3f &in avStartPos)
	{
		if (mvHoles.length() == 0) return tID_Invalid;
		if (mvHoles.length() == 1) return mvHoles[0].m_idEntity;
		
		cLuxPathfinder@ pPathfinder = GetPathfinder();
		if (pPathfinder is null) return tID_Invalid;
		
		array<tID> vHoleCandidates;
		vHoleCandidates.resize(mvHoles.length());
		for (uint i = 0; i < vHoleCandidates.length(); i++)
			vHoleCandidates[i] = mvHoles[i].m_idEntity;
		
		while (vHoleCandidates.length() > 0)
		{
			int lIx = cMath_RandRectl(0, vHoleCandidates.length()-1);
			tID idReturn = vHoleCandidates[lIx];			
			cLuxArea@ pArea = cLux_ID_Area(idReturn);
			
			vHoleCandidates.removeAt(lIx);
			if (idReturn == a_idIgnoredHole || 
				GetIsHoleBlocked(idReturn) ||
				(pArea !is null && pArea.IsActive() == false))
			{
				continue;
			}				
				
			bool bPath = abCheckPath ? pPathfinder.BuildPathNodeArrayFromTo(avStartPos, cLux_ID_Entity(idReturn).GetPosition()) : true;
			if (!abCheckPath || bPath)
				return idReturn;
		}
		return tID_Invalid;
	}
	
