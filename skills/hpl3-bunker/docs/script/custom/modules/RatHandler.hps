	void ReportUnreachableFood(tID a_idFood)
	{
		cRat_FoodEntity@ pFoodEnt = GetFoodEntityFromId(a_idFood);
		pFoodEnt.mlUnreachableCount++;
		
		if (pFoodEnt.mlUnreachableCount > 3)
		{
			RemoveFoodEntity(a_idFood);
		}
	}
	
	//------------------------------------------------------------
	
	void ReportReachableFood(tID a_idFood)
	{
		cRat_FoodEntity@ pFoodEnt = GetFoodEntityFromId(a_idFood);
		pFoodEnt.mlUnreachableCount = cMath_Max(pFoodEnt.mlUnreachableCount-1, 0);
	}
	
	//------------------------------------------------------------
	
	void SetupFeedAreas()
	{
		if (mvFoodEntities.length()!=0)
			return;
		
		////////////////////
		// Get food entities
		int lTotalMaxRatAmount = 0;
		
		array<tID> vRatFoodEntities;
		cLuxEntityComponentIterator @pFoodIt = cLux_GetCurrentMap().GetEntityComponentIterator(eComponentType_Custom_RatFoodComponent);
		while (pFoodIt.HasNext())
		{
			iLuxEntityComponent @pComp = pFoodIt.Next();
			if (pComp is null) continue;
			iLuxEntity @pEnt = pComp.GetEntity();
			if (pEnt is null) continue;
			
			cRat_FoodEntity@ pFood = _AddFoodEntity(pEnt);
			if (pFood is null) continue;
			
			//////////////////////////////////
			// Calculate total max rat amount
			lTotalMaxRatAmount += pFood.mlFeedingSlotsCount;
		}
		
		cLux_AddDebugMessage("[RatHandler] TotalMaxRatAmount: "+lTotalMaxRatAmount);
		
		DistributeRats();
	}
	
	//------------------------------------------------------------
	
	bool GetRatsAreAggressive()
	{
		return mbNonAggressiveRats == false;
	}
	
	//------------------------------------------------------------

	/////////////////////////////////////////
	// GUI
	/////////////////////////////////////////
	
	//------------------------------------------------------------

	void OnGui(float afTimeStep) {}	
	void OnDraw(float afFrameTime) {}
	void OnPostRender(float afFrameTime) {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont, float afStartY)
	{		
		afStartY = cLux_DrawDebugText("--------- Rat Handler ---------", afStartY);	
		afStartY = cLux_DrawDebugText("Blood trail num: " + mvBloodTrails.size(), afStartY);			
		
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		if (cLux_DebugModeOn() == false) return;
		if (cLux_ShowEntityInfoOn() == false) return;
		
		for (uint i = 1; i < mvBloodTrails.size(); ++i)
		{
			apFunctions.GetLowLevelGfx().DrawLine(mvBloodTrails[i - 1].mvPosition, mvBloodTrails[i].mvPosition, cColor_White * 2.f);
		}
		
		for (uint i = 0; i < mvFoodEntities.length(); i++)
		{
			cRat_FoodEntity@ pFood = mvFoodEntities[i];
			iLuxEntity@ pFoodEnt = cLux_ID_Entity(pFood.mID);
			if (pFoodEnt is null) continue;
			
			for (uint j = 0; j < pFood.mvFeedPositions.length(); j++)
			{
				cVector3f vFeedPos = cMath_MatrixMul(pFoodEnt.GetMatrix(), pFood.mvFeedPositions[j]);
				vFeedPos.y = pFood.mvFeedPositions[j].y+pFoodEnt.GetPosition().y;
				
				cColor col = cColor_Green*2;
				if (pFood.mvAgentIds[j] != tID_Invalid)
				{
					col = pFood.mvFeedSlotFreeDelays[j] > 0 ? cColor(0, 2, 2) : (cColor_Green*2);
				}
				if (pFood.mfThreatTime >= 0)
					col = cColor_Red*2;
				apFunctions.GetLowLevelGfx().DrawSphere(vFeedPos, 0.2, col);
			}
		}
	}
	
