//------------------------------------------------------------

class cDifficultySettingValue
{
	cDifficultySettingValue(){}
	cDifficultySettingValue(int aId, const tString&in asName, bool abValue)
	{
		mType = eDifficultySettingType_Bool;
		mControlType = eDifficultySettingControlType_Checkbox;
		mId = aId;
		msName = asName;
		mbValue = abValue;
	}
	cDifficultySettingValue(int aId, const tString&in asName, int alValue, int aControlType)
	{
		mType = eDifficultySettingType_Int;
		mControlType = aControlType;
		mId = aId;
		msName = asName;
		mlValue = alValue;
	}
	cDifficultySettingValue(int aId, const tString&in asName, float afValue, int aControlType)
	{
		mType = eDifficultySettingType_Float;
		mControlType = aControlType;
		mId = aId;
		msName = asName;
		mfValue = afValue;
	}
	
	int mId;
	tString msName;
	int mType;
	int mControlType;
	bool mbValue;
	int mlValue;
	float mfValue;
}

//------------------------------------------------------------

class cDifficultySettingEntry
{
	/////////////////////////////////////////
	// Common
	cDifficultySettingEntry(){}
	int mId;
	tString msName;
	int mType;
	int mControlType;
	int mlReliesOn_SettingID;
	array<int> mvReliesOn_DisablingValueIDs;
	bool mbActive;
	
	array<cDifficultySettingValue> mvValueLevels;
	int mlSelectedValueID;
	int mlVeryEasyValueID;
	int mlEasyValueID;
	int mlNormalValueID;
	int mlHardValueID;
	int mlVeryHardValueID;
	
	void SetSelectedSettingValueByID(int aId)
	{
		mlSelectedValueID = aId;
		//cLux_AddDebugMessage("New Value = " + aId);
	}
	
	cDifficultySettingValue@ GetSelectedSettingValue()
	{
		return GetSettingValueByID(mlSelectedValueID);
	}
	
	cDifficultySettingValue@ GetSettingValueByID(int aId)
	{
		for (int i=0; i<mvValueLevels.size(); i++)
		{
			cDifficultySettingValue@ pSettingValue = mvValueLevels[i];
			if (pSettingValue.mId != aId) continue;
			return pSettingValue;
		}
		
		Warning("[DifficultyHandler] cDifficultySettingEntry.GetSettingValueByID: ID " + aId + " doesn't exist in the " + msName + "setting list of potential values!");
		return null;
	}
}

