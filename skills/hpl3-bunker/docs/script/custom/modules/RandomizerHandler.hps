{
	eLockerRandomizerName_Travers,
	eLockerRandomizerName_Auclair,
	eLockerRandomizerName_Laval,
	eLockerRandomizerName_Giraud,
	eLockerRandomizerName_Boucher,
	eLockerRandomizerName_Fortin,
	eLockerRandomizerName_Bardin
}

class cLockerData
{
	cLockerData() {}
	
	cLockerData(const tString asName, const tString asHubLockerName, const tString asHubLockName, const tString asHubNametagBaseName, const tString asHubNametagTextName)
	{
		msName = asName;
		
		msHubLockerName = asHubLockerName;
		msHubLockName = asHubLockName;
		msHubNametagBaseName = asHubNametagBaseName;
		msHubNametagTextName = asHubNametagTextName;
	}
	
	tString msName;
	tString msLevel;
	int mlPositionIndex;
	
	tString msHubLockerName;
	tString msHubLockName;
	tString msHubNametagBaseName;
	tString msHubNametagTextName;
}

