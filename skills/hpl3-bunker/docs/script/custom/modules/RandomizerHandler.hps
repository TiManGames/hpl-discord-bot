	// GENERAL
	/////////////////////////////////////////	
	
	//------------------------------------------------------------
	void VariableUpdate(float afDeltaTime) {}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep) {}
	
	//------------------------------------------------------------
	
	void PostUpdate(float afTimeStep)
	{
		if (mbApplyRandomizePropsFix) 
		{
			SetupRandomization_Props();		
		}
		
		if (mbApplyDogtagsFix && cLux_GetCurrentMap() != null)
		{
			mbApplyDogtagsFix = false;
			OnMapEnter_DogtagsAndCorpses(cLux_GetCurrentMap());
		}
		
		if (mbApplyNewItemTypeFix)
		{
			ApplyNewItemTypeFix();
		}
		
		if (mbApplyAddedItemLocationsFix)
		{
			ApplyAddedItemLocationsFix();
		}
	}
	
