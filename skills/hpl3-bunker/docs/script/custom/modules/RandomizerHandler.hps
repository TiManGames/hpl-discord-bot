	void AppGotInputFocus() {}
	void AppLostInputFocus() {}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// HELPERS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int GetNeededFuses()
	{
		if (GameDifficulty_GetSettingValueByID_Bool(eGameDifficultySetting_FusesAndFuseBoxes) == false)
			return 0;			
		
		int lTotalFuseBoxCount = 4;
		int lInitialPoweredFuseBoxes = GameDifficulty_GetSettingValueByID_Int(eGameDifficultySetting_InitialPoweredFuseBoxes);
		int lNeededFuses = (lTotalFuseBoxCount - lInitialPoweredFuseBoxes);
		return lNeededFuses;
	}
	
	//------------------------------------------------------------
	
	void SetupRandomization()
	{
		SetupRandomization_Items();
		SetupRandomization_Traps();
		SetupRandomization_Codes();
		SetupRandomization_DogtagsAndCorpses();
		SetupRandomization_Props();
		SetupRandomization_Lockers();
	}
	
	//------------------------------------------------------------
	
	void ApplyNewItemTypeFix()
	{
		////////////////////
		// New item type added, need to make sure saves from previous patch work
		cLuxMap@ pMap = cLux_GetCurrentMap();
		
		if (pMap is null) return;
		if (mvVisitedMaps.size() == 0) return;
		if (mvMapsWithNewItemTypeFix.find(pMap.GetName()) != -1) return;
		
		mbApplyNewItemTypeFix = false;
		mvMapsWithNewItemTypeFix.push_back(pMap.GetName());
			
		//////////////////////////
		// Ensure correct item array size
		int lOldItemTypeNum = -1;
		int lItemTypeNum = eItemRandomizerType_LastEnum;			
		
		for (int i = 0; i < mvMapItemData.size(); ++i)
		{
			cMapItemData@ pMapItemData = mvMapItemData[i];
			if (pMapItemData is null) continue;
			
			if (lOldItemTypeNum == -1)
				lOldItemTypeNum = pMapItemData.mvItemCount.size();
			
			if (pMapItemData.mvItemCount.size() < lItemTypeNum)				pMapItemData.mvItemCount.resize(lItemTypeNum);
			if (pMapItemData.mvMaxItemCount.size() < lItemTypeNum) 			pMapItemData.mvMaxItemCount.resize(lItemTypeNum);
			if (pMapItemData.mvMinItemCount.size() < lItemTypeNum) 			pMapItemData.mvMinItemCount.resize(lItemTypeNum);
			if (pMapItemData.mvTotalItemSlotCount.size() < lItemTypeNum)	pMapItemData.mvTotalItemSlotCount.resize(lItemTypeNum);
			if (pMapItemData.mvMaxLimitedItemCount.size() < lItemTypeNum)	pMapItemData.mvMaxLimitedItemCount.resize(lItemTypeNum);
			if (pMapItemData.mvLimitedItemExists.size() < lItemTypeNum)		pMapItemData.mvLimitedItemExists.resize(lItemTypeNum);
		}
		
		if (lOldItemTypeNum <= eItemRandomizerType_Meat)
		{
			mbMeatAddedInNewItemTypeFix = true;
		}
			
		//////////////////////////
		// Disable fuse items?
		if (GameDifficulty_GetSettingValueByID_Bool(eGameDifficultySetting_FusesAndFuseBoxes) == false)
		{
			array<iLuxEntity@> vItems;
			cLux_GetCurrentMap().GetEntityArray("*", eLuxEntityType_Prop, "cScrPropPickup", vItems);
				
			for (uint i = 0; i < vItems.length(); i++)
			{
				iLuxEntity@ pItem = vItems[i];
				if (pItem is null) continue;
					
				tString sTypeString = Item_GetEntityItemType(pItem.GetName());					
				if (StringToItemType(sTypeString) == eItemRandomizerType_Fuse)
				{
					cLux_GetCurrentMap().DestroyEntity(pItem);
				}
			}
		}			
	}
	
	//------------------------------------------------------------
	
	void ApplyAddedItemLocationsFix()
	{
		cLuxMap@ pMap = cLux_GetCurrentMap();
		
		if (pMap is null) return;
		if (mvVisitedMaps.size() == 0) return;
		if (mvMapsWithAddedItemLocationsFix.find(pMap.GetName()) != -1) return;
		
		mvMapsWithAddedItemLocationsFix.push_back(pMap.GetName());
		mbApplyAddedItemLocationsFix = false;
		
		array<iLuxEntity@> vItems;
		cLux_GetCurrentMap().GetEntityArray("*", eLuxEntityType_Prop, "cScrPropPickup", vItems);
		
		DisableFallPatchItems(vItems, true);
	}
	
	//------------------------------------------------------------
	
	void DisableFallPatchItems(const array<iLuxEntity@> &in avItems, bool abDoMeatMeshFix)
	{		
		for (uint i = 0; i < avItems.length(); i++)
		{
			iLuxEntity@ pItem = avItems[i];
			if (pItem is null) continue;
			
			if (pItem.GetVarString("") == "FallPatch")
			{
				cLux_GetCurrentMap().DestroyEntity(pItem);
			}
			
			//////////////////////
			// Make sure old meat item meshes are aligned with the body
			else if (abDoMeatMeshFix &&
					 mbMeatAddedInNewItemTypeFix &&
					 StringToItemType(Item_GetEntityItemType(pItem.GetName())) == eItemRandomizerType_Meat)
			{				
				cMeshEntity@ pMeshEnt = pItem.GetMeshEntity();
				cBoneState@ pBone = pMeshEnt !is null ? pMeshEnt.GetBoneStateFromName("j_meat_root") : null;
				
				if (pMeshEnt is null) continue;
				if (pBone is null) continue;
				if (pMeshEnt.GetSkeletonPhysicsActive() == false) continue;
				
				pMeshEnt.SetSkeletonPhysicsActive(false);
				pBone.SetMatrix(pItem.GetOnLoadOffsetTransform());
			}
		}	
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
