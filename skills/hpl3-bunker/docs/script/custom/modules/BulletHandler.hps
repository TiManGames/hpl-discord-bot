	/////////////////////////////////////////
	// DEBUG
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont,float afY)
	{
		afY = cLux_DrawDebugText("------------ Bullet Handler ------------", afY);
		afY = cLux_DrawDebugText("Bullets: " + mvBullets.size(), afY);
		afY = cLux_DrawDebugText("Custom impact data: " + mvCustomImpactEffects.size(), afY);
		return afY;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// VARIABLES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	int mlBulletCount = 0;
	int mlBulletIndex = 0;
	float mfTimeSinceLastBullet = 0.f;
	tString msImpactParticleSuffix = "";
	eBulletType mLastDamageBulletType = eBulletType_Revolver;
	array<cBullet> mvBullets;
	array<cBullet_CustomImpactEffect> mvCustomImpactEffects;
	array<tID> mvGlobalIgnoredEntityIds;
	array<tID> mvGlobalIgnoredAgentIds;
	
