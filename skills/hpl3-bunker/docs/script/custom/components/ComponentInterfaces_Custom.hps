/////////////////////////////////////////
	
//---------------------------------------------------

shared interface iScrLampComponent_Interface
{
	
}

iScrLampComponent_Interface@ UserComponent_LampComponent_Create(iLuxEntity@ apEntity)
{
	return cast<iScrLampComponent_Interface>(cLux_CreateUserComponent(apEntity, 
									"LampComponent", 
									"script/custom/components/LampComponent.hps", 
									"cScrLampComponent", 
									eComponentType_Custom_LampComponent));
}

iScrLampComponent_Interface@ UserComponent_LampComponent_Get(iLuxEntity@ apEntity)
