#include "player/PlayerTypes_Custom.hps"

//---------------------------------------------------

shared enum eComponentType_Custom
{
	eComponentType_Custom_RatFoodComponent = eLuxEntityComponentType_LastEnum + 1,
	eComponentType_Custom_WoodenBreakableComponent,
	eComponentType_Custom_LampComponent,
}

//---------------------------------------------------

/////////////////////////////////////////
// Rat Food Component
/////////////////////////////////////////
	
//---------------------------------------------------

shared interface iScrRatFoodComponent_Interface
{
	void SetAttractEnabled(bool abX);
	bool GetAttractEnabled();
	void SetAttractDistance(float afDistance);
	float GetAttractDistance();
	void SetFeedingSlotsCount(int alFeedingSlotsCount);
	int GetFeedingSlotsCount();
	void SetLifetime(float afLifeTime);
	float GetLifeTime();
	void SetPriority(int alPrio);
	int GetPriority();
	void SetFoodEntity(const tString&in asEntity);
	tString GetFoodEntity();
	void SetIsArea(bool abIsArea);
	bool GetIsArea();
	void SetIsThrownMeat(bool abIsArea);
	bool GetIsThrownMeat();
	void SetIsDestroyed(bool abX);
	bool GetIsDestroyed();
}

iScrRatFoodComponent_Interface@ UserComponent_RatFoodComponent_Create(iLuxEntity@ apEntity)
{
	return cast<iScrRatFoodComponent_Interface>(cLux_CreateUserComponent(apEntity, 
									"RatFood", 
									"script/custom/components/RatFoodComponent.hps", 
									"cScrRatFoodComponent", 
									eComponentType_Custom_RatFoodComponent));
}

iScrRatFoodComponent_Interface@ UserComponent_RatFoodComponent_Get(iLuxEntity@ apEntity)
{
	return cast<iScrRatFoodComponent_Interface>(cLux_GetUserComponent(apEntity, eComponentType_Custom_RatFoodComponent));
}

//---------------------------------------------------

/////////////////////////////////////////
// Wooden Breakable
/////////////////////////////////////////
	
//---------------------------------------------------

shared interface iScrWoodenBreakableComponent_Interface
{
	void SetMainBody(iPhysicsBody@ apBody);
	void SetupAfterLoad(cWorld@ apWorld, cResourceVarsObject@ apVars, cResourceVarsObject@ apInstanceVars);
	void SetIsBreakable(bool abX);
	bool GetIsBreakable();
	bool GetIsPathBlocker();
	bool GetIsBroken();
	void ResetProperties();
	void OnHealthChange();
	void BeforeEntityDestruction();
	void OnPhysicsCollision(iPhysicsBody@ apBody, iPhysicsBody@ apCollideBody, cPhysicsContactData &in apContactData);
}

iScrWoodenBreakableComponent_Interface@ UserComponent_WoodenBreakableComponent_Create(iLuxEntity@ apEntity)
{
	return cast<iScrWoodenBreakableComponent_Interface>(cLux_CreateUserComponent(apEntity, 
									"WoodenBreakable", 
									"script/custom/components/WoodenBreakableComponent.hps", 
									"cScrWoodenBreakableComponent", 
									eComponentType_Custom_WoodenBreakableComponent));
}

iScrWoodenBreakableComponent_Interface@ UserComponent_WoodenBreakableComponent_Get(iLuxEntity@ apEntity)
{
	return cast<iScrWoodenBreakableComponent_Interface>(cLux_GetUserComponent(apEntity, eComponentType_Custom_WoodenBreakableComponent));
}

//---------------------------------------------------

