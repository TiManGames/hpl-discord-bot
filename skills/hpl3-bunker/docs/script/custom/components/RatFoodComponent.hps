#include "interfaces/UserComponent_Interface.hps"
#include "custom/components/ComponentInterfaces_Custom.hps"
#include "base/Base_Types.hps"
#include "helpers/helper_modules.hps"

//---------------------------------------------------

class cScrRatFoodComponent : iScrUserComponent, iScrUserComponent_Interface, iScrRatFoodComponent_Interface
{
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		
	}
	
	/////////////////////////////////////////
	// SETUP
	/////////////////////////////////////////
	
	//------------------------------------------------------------
		
	void OnSetupAfterLoad(cWorld@ apWorld)
	{
		
	}
	
	void OnAfterWorldLoad()
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void SetAttractEnabled(bool abX)
	{
		mbAttractEnabled = abX;
	}
	
	bool GetAttractEnabled()
	{
		return mbAttractEnabled;
	}
	
	//------------------------------------------------------------
	
	void SetAttractDistance(float afDistance)
	{
		mfAttractDistance = afDistance;
	}
	
	float GetAttractDistance()
	{
		return mfAttractDistance;
	}
	
	//------------------------------------------------------------
	
	void SetLifetime(float afLifeTime)
	{
		mfLifeTime = afLifeTime;
	}
	
	float GetLifeTime()
	{
		return mfLifeTime;
	}
	
	//------------------------------------------------------------
	
	void SetFeedingSlotsCount(int alFeedingSlotsCount)
	{
		mlFeedingSlotsCount = alFeedingSlotsCount;
	}
	
	int GetFeedingSlotsCount()
	{
		return mlFeedingSlotsCount;
	}
	
	//------------------------------------------------------------
	
	void SetPriority(int alPrio)
	{
		mlPriority = alPrio;
	}
	
	int GetPriority()
	{
		return mlPriority;
	}
	
	//------------------------------------------------------------
	
	void SetFoodEntity(const tString&in asEntity)
	{
		msFoodEntity = asEntity;
	}
	
	tString GetFoodEntity()
	{
		return msFoodEntity;
	}
	

	//------------------------------------------------------------
	
	void SetIsArea(bool abIsArea)
	{
		mbIsArea = abIsArea;
	}
	
	bool GetIsArea()
	{
		return mbIsArea;
	}

	//------------------------------------------------------------
	
	void SetIsThrownMeat(bool abIsThrownMeat)
	{
		mbIsThrownMeat = abIsThrownMeat;
	}
	
	bool GetIsThrownMeat()
	{
		return mbIsThrownMeat;
	}

	//------------------------------------------------------------
	
	void SetIsDestroyed(bool abX)
	{
		mbDestroyed = abX;
	}
	
	bool GetIsDestroyed()
	{
		return mbDestroyed;
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// GENERAL
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
	
	}
	
	//------------------------------------------------------------
	
	void UpdateAttraction(float afTimeStep)
	{
		
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////
	// DEBUG
	/////////////////////////////
	
	//------------------------------------------------------------
	
	void OnRenderSolid(cRendererCallbackFunctions@ apFunctions)
	{
		if (apFunctions is null) return;
		
		iLuxEntity@ pEnt = null;
		iLuxEntity@ pAltEnt = cLux_GetCurrentMap().GetEntityByName(msFoodEntity);
		
		@pEnt = pAltEnt is null ? mBaseObj.GetEntity() : pAltEnt;
		if (pEnt is null) return;
		
		cBoundingVolume@ pBoundingVol = null;
		
		if (mbIsArea == false)
		{
			cMeshEntity@ pMesh = pEnt.GetMeshEntity();
			if (pMesh !is null)
				@pBoundingVol = pMesh.GetBoundingVolume();
		}
		else
		{
			cLuxArea@ pArea = cLux_ToArea(mBaseObj.GetEntity());
			if (pArea is null) return;
			iPhysicsBody@ pBody = pArea.GetAreaBody();
			if (pBody is null) return;
			@pBoundingVol = pBody.GetBoundingVolume();
		}
		
		if (pBoundingVol is null) return;

		apFunctions.GetLowLevelGfx().DrawBoxMinMax(pBoundingVol.GetMin(), pBoundingVol.GetMax(), cColor_Green * 1.f);
		
		iLuxEntity@ pAttractEntity = mbIsArea ? mBaseObj.GetEntity() : pEnt;
		apFunctions.GetLowLevelGfx().DrawSphere(pAttractEntity.GetPosition(), mfAttractDistance, cColor_Blue * 1.f);
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// PROPERTIES
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	bool mbAttractEnabled = true;
	float mfAttractDistance = 5.f;
	int mlFeedingSlotsCount = 2;
	float mfLifeTime = 0.f;
	int mlPriority = 0;
	tString msFoodEntity = "";
	bool mbIsArea = false;
	bool mbIsThrownMeat = false;
	
	bool mbDestroyed = false;
	
	//------------------------------------------------------------

}