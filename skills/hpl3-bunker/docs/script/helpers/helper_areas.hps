{
	cScript_SetGlobalArgString(0, asBody);
	cScript_RunGlobalFunc(asArea, "cScrAreaSticky", "_Global_AttachBody");
}

//-------------------------------------------------

/**
 * Detaches anything attached to a sticky area.
 * 
 * @param asArea, name of sticky area.
 **/
void StickyArea_Detach(const tString &in asArea)
{
	cScript_RunGlobalFunc(asArea, "cScrAreaSticky", "DetachBody");
}

//-------------------------------------------------

/**
 * Returns the entity attached to the area.
 * 
 * @param asArea, name of sticky area.
 * 
 * @return iLuxEntity@, the attached entity of the area, or null if no entity is attached.
 **/
iLuxEntity@ StickyArea_GetProp(const tString &in asArea)
{
	cScript_RunGlobalFunc(asArea, "cScrAreaSticky", "_Global_GetAttachedEntityName");
	tString sName = cScript_GetGlobalReturnString();
	if (sName == "") return null;
	
	return cLux_GetCurrentMap().GetEntityByName(sName, eLuxEntityType_LastEnum, "");
}

//-------------------------------------------------

/**
 * Returns the name of the attached entity.
 * 
 * @param asArea, name of sticky area.
 * 
 * @return tString, name of the attached entity. An empty string if no entity is attached.
 **/
tString StickyArea_GetAttachedEntityName(const tString &in asArea)
{
	cScript_RunGlobalFunc(asArea, "cScrAreaSticky", "_Global_GetAttachedEntityName");
	return cScript_GetGlobalReturnString();
}

//-------------------------------------------------

/**
 * Returns the body attached to the area.
 * 
 * @param asArea, name of sticky area.
 * 
 * @return iPhysicsBody@, the attached body of the area, or null if no body is attached.
 **/
iPhysicsBody@ StickyArea_GetBody(const tString &in asArea)
{
	cScript_RunGlobalFunc(asArea, "cScrAreaSticky", "_Global_GetAttachedBodyName");
	tString sName = cScript_GetGlobalReturnString();
	if (sName == "") return null;
	
	return cLux_GetCurrentMap().GetPhysicsWorld().GetBody(sName);
}

