/////////////////////////////////////////
// LIQUID AREA
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Moves the specified liquid area to the current position of the target entity.
 * 
 * @param asName, name of the liquid area to move, wildcard(s) * are supported.
 * @param asTargetEntity, name of the entity to move the liquid area to.
 * @param afAcceleration, acceleration .in m/s^2
 * @param afMaxSpeed, the maximum speed of movement.
 * @param afSlowDownDist, the distance at which movement slows down.
 * @param abResetSpeed, if all static movement for the liquid area should be stopped before starting this movement.
 * @param asCallback, callback when movement is done: void asCallback(const tString& in asAreaName)
 **/
void LiquidArea_MoveLinearTo(const tString &in asName, const tString &in asTargetEntity, float afAcceleration, 
					   float afMaxSpeed, float afSlowDownDist=0.0f, bool abResetSpeed=false, const tString& in asCallback="")
{
	////////////////////////////////////////
	// Get all liquid areas
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_LiquidArea, "", vEntities);
	if(vEntities.length() == 0)
	{
		Error("Could not find any liquid areas with name '"+asName+"' for LiquidArea_MoveLinearTo.");
		return;
	}
	
	////////////////////////////////////////
	// Get target position
	iLuxEntity@ pTargetEntity = cLux_GetCurrentMap().GetEntityByName(asTargetEntity, eLuxEntityType_LastEnum, "");
	if (pTargetEntity is null)
	{
		Error("Could not find the target entity " + asTargetEntity + " for LiquidArea_MoveLinearTo.");
		return;
	}
	
	cVector3f vTargetPos = pTargetEntity.GetPosition();
		
	/////////////////////////////
	// Iterate liquid areas
	for(uint i=0; i<vEntities.length(); ++i)
	{
		cLuxLiquidArea@ pArea = cLux_ToLiquidArea(vEntities[i]);
		pArea.MoveLinearTo(vTargetPos, afAcceleration, afMaxSpeed, afSlowDownDist, abResetSpeed, asCallback);
	}
}

//-------------------------------------------------

void LiquidArea_StopMovement(const tString &in asName)
{
	////////////////////////////////////////
	// Get all liquid areas
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_LiquidArea, "", vEntities);
	if(vEntities.length() == 0)
	{
		Error("Could not find any liquid areas with name '"+asName+"' for LiquidArea_MoveLinearTo.");
		return;
	}
		
	/////////////////////////////
	// Iterate liquid areas
	for(uint i=0; i<vEntities.length(); ++i)
	{
		cLuxLiquidArea@ pArea = cLux_ToLiquidArea(vEntities[i]);
		pArea.StopMove();
	}
}

