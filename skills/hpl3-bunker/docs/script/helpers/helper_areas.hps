/////////////////////////////////////////
// AREA - GENERAL
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Moves the specified area to the current position of the target entity. 
 * !Does not work on Liquid Areas, instead use LiquidArea_MoveLinearTo!
 * 
 * @param asName, name of the area to move, wildcard(s) * are supported.
 * @param asTargetEntity, name of the entity to move the area to.
 * @param afAcceleration, acceleration .in m/s^2
 * @param afMaxSpeed, the maximum speed of movement.
 * @param afSlowDownDist, the distance at which movement slows down.
 * @param abResetSpeed, if all static movement for the area should be stopped before starting this movement.
 * @param asCallback, callback when movement is done: void asCallback(const tString& in asAreaName)
 **/
void Area_MoveLinearTo(const tString &in asName, const tString &in asTargetEntity, float afAcceleration, 
					   float afMaxSpeed, float afSlowDownDist=0.0f, bool abResetSpeed=true, const tString& in asCallback="")
{
	////////////////////////////////////////
	// Get all areas
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_Area, "", vEntities);
	if(vEntities.length() == 0)
	{
		Error("Could not find any  areas with name '"+asName+"' for Area_MoveLinearTo.");
		return;
	}
	
	////////////////////////////////////////
	// Get target position
	iLuxEntity@ pTargetEntity = cLux_GetCurrentMap().GetEntityByName(asTargetEntity, eLuxEntityType_LastEnum, "");
	if (pTargetEntity is null)
	{
		Error("Could not find the target entity " + asTargetEntity + " for Area_MoveLinearTo.");
		return;
	}
	
	cVector3f vTargetPos = pTargetEntity.GetPosition();
		
	/////////////////////////////
	// Iterate areas
	for(uint i=0; i<vEntities.length(); ++i)
	{
		cLuxArea@ pArea = cLux_ToArea(vEntities[i]);
		pArea.MoveLinearTo(vTargetPos, afAcceleration, afMaxSpeed, afSlowDownDist, abResetSpeed, asCallback);
	}
}

//-------------------------------------------------

/**
 * Places the specified area at another entity, optionally aligning its rotation with the target entity.
 * 
 * @param asAreaName, name of the area.
 * @param asTargetEntity, entity to place at
 * @param abAlignRotation, if true the entity will be given the same rotation as the target entity.
 **/
void Area_PlaceAtEntity(const tString &in asAreaName, const tString &in asTargetEntity, 
						bool abAlignRotation = false)
{
	////////////////////////////////////////
	// Get all areas
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAreaName, eLuxEntityType_Area, "", vEntities);
	if(vEntities.length() == 0)
	{
		Error("Could not find any  areas with name '"+asAreaName+"' for Area_PlaceAtEntity.");
		return;
	}
	
	iLuxEntity@ pTargetEntity = cLux_GetCurrentMap().GetEntityByName(asTargetEntity, eLuxEntityType_LastEnum, "");
	
	if (pTargetEntity is null)
	{
		Error("Could not find the target entity '"+asTargetEntity+"' for Area_PlaceAtEntity");
		return;
	}
		
	/////////////////////////////
	// Iterate areas
	for(uint i=0; i<vEntities.length(); ++i)
	{
		cLuxArea@ pArea = cLux_ToArea(vEntities[i]);
		
		if (abAlignRotation)
			pArea.SetMatrix(pTargetEntity.GetMatrix());
		else
			pArea.SetPosition(pTargetEntity.GetPosition());
	}
}

//-------------------------------------------------


/**
 * Stops an area that is already moving. 
 * !This is not for liquid areas!
 * 
 * @param asName, name of the area to stop moving, wildcard(s) * are supported.
 **/
void Area_StopMovement(const tString &in asName)
{
	////////////////////////////////////////
	// Get all areas
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asName, eLuxEntityType_Area, "", vEntities);
	if(vEntities.length() == 0)
	{
		Error("Could not find any  areas with name '"+asName+"' for Area_MoveLinearTo.");
		return;
	}
		
	/////////////////////////////
	// Iterate areas
	for(uint i=0; i<vEntities.length(); ++i)
	{
		cLuxArea@ pArea = cLux_ToArea(vEntities[i]);
		pArea.StopMove();
	}
}

//-------------------------------------------------

/** 
 * Return how far you are through the area (i.e. along the area's Z axis)
 */
float Area_GetPlayerZAxisDepth(const tString& in asName)
{
	iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asName, eLuxEntityType_Area);
	if (!pEntity.CollidesWithPlayer())
		return 0.0f;
	
	cLuxArea@ pArea = cLux_ToArea(pEntity);
			
	float fAreaDepth = pArea.GetSize().z;
	
	cVector3f vAreaForward = pArea.GetMatrix().GetTranspose().GetForward();
	vAreaForward.y=0.0f;
	vAreaForward.Normalize();
			
	cVector3f vToPlayer = cLux_GetPlayer().GetCharacterBody().GetFeetPosition()-pArea.GetPosition();
	vToPlayer.y=0.0f;
		
	float fDot = cMath_Vector3Dot(vAreaForward,vToPlayer);
	float fProgress = cMath_Clamp(fDot/fAreaDepth+0.5f,0.0f,1.0f);
	return fProgress;
}

