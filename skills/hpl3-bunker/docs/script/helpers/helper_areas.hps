 * 
 * @param asArea, name of sticky area.
 * @param asEntity, name of entity.
 * @param asBody, name of specific body on entity, if left as an emtpy string, the main body will be used.
 **/
void StickyArea_AttachEntity(const tString &in asArea, const tString &in asEntity, const tString &in asBody)
{
	cScript_SetGlobalArgString(0, asEntity);
	cScript_SetGlobalArgString(1, asBody);
	cScript_RunGlobalFunc(asArea, "cScrAreaSticky", "_Global_AttachEntity");
}

//-------------------------------------------------

/**
 * Attaches a physics body to a sticky area.
 * 
 * @param asArea, name of sticky area.
 * @param asBody, name of body to attach.
 **/
