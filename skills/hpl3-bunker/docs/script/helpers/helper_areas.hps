 * Returns true if it's possible to move from the next node in the animation to this one.
 * 
 * @param asArea, name of animation node.
 * 
 * @return bool, true if it's possible to move back to this node.
 **/
bool CameraAnimationNode_HasBackMovement(const tString &in asArea)
{
	return CameraAnimationNode_GetInteractiveMovement(asArea) && CameraAnimationNode_GetBackSpeed(asArea) > 0;
}

