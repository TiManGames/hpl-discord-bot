#include "helpers/helper_game.hps"
#include "base/InputHandler_Types.hps"

//-------------------------------------------------

/////////////////////////////////////////
// GAMEPAD
/////////////////////////////////////////

//-------------------------------------------------

eGamepadProfile Input_GetCurrentGamepadProfile()
{
	eGamepadProfile profile;
	if(Platform_IsConsole() == false)
	{
		tString sProfile = cLux_GetInputHandler().GetCurrentGamepadProfile();
		for(int i=0; i<gvGamepadProfileValues.size(); ++i)
		{
			if(sProfile!=gvGamepadProfileValues[i])
				continue;
			
			profile = eGamepadProfile(i);
			break;
		}
	}
	else
	{
		if(Platform_IsPlayStation())
		{
			profile = eGamepadProfile_PS4;
		}
		else if(Platform_IsXbox())
		{
			profile = eGamepadProfile_X360;
		}
	}
	
	return profile;
}

