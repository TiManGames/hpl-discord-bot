/////////////////////////////////////////
// INSANITY
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets the direct amount of lens distortion directly
 *
 * @param afX, The amount of the effect, positive values give fish eye, negative give opposite effect
 **/
void Effect_Insanity_SetDirect(float afAlpha, float afT, float afAmpT, float afWaveAlpha, float afZoomAlpha)
{
	iScrEffect_Insanity@ pEffect = cast<iScrEffect_Insanity>(cLux_GetEffectHandler().GetEffect(eEffect_Insanity));
	pEffect.SetDirect(afAlpha, afT, afAmpT, afWaveAlpha, afZoomAlpha);
}

//-------------------------------------------------

/////////////////////////////////////////
// FOV SHAKE
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Oscilates the FOV rapidly.
 * If several calls to FOV shake has been made the largest one is used.
 * 
 * @param float afAmount, The strength of the shake, indicating the maximum multiplier of the FOV that will be used.
 * @param float afTime, The time it shakes at full intensity (fade in and fade out are added to this).
 * @param float afFadeInTime, The time before it reaches full strenght.
 * @param float afFadeOutTime, The time, after afTime is up, that it will take for the shake to reach zero strength.
 * @param afFrequency, Times per seconds the shake will change offset. 0=every update (ie max).
 * @param abUseNoise, if noise should be used to vary the intensity of the shake
 * @param afNoiseMinRelAmount, fraction of afAmount that should be the minimum shake amount when using noise.
 **/
int Effect_FOV_Shake_Start(float afAmount, float afTime, float afFadeInTime,float afFadeOutTime, float afFrequency=0, bool abUseNoise = false, float afNoiseMinRelAmount = 0, float afNoiseSpeed = 2.0f, bool abUseRumble = true)
{
	iScrEffect_FOV_Shake@ pShake = cast<iScrEffect_FOV_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_FOV_Shake));
	
	return pShake.Start(afAmount, afTime, afFadeInTime, afFadeOutTime, afFrequency, abUseNoise, afNoiseMinRelAmount, afNoiseSpeed, abUseRumble);	
}

/**
 * Fades out one or all fov shake instances.
 * 
 * @param alID, The id of the shake (returned by Effect_FOV_Shake_Start). -1 = fade out all active shakes.
 * @param afFadeOutTime, the time it takes to fade out.
 **/
void Effect_FOV_Shake_FadeOut(int alID, float afFadeOutTime)
{
	iScrEffect_FOV_Shake@ pShake = cast<iScrEffect_FOV_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_FOV_Shake));
	
	pShake.FadeOut(alID, afFadeOutTime);	
}

/**
 * 
 * Sets an entity as the source of a FOV shake instance. The shake instance will increase in strength as the player gets closer to the entity.
 * 
 * @param alID, The id of the shake (returned by Effect_FOV_Shake_Start).
 * @param asSourceEntity, entity to be used as source.
 * @param afMinDist, distance to entity where the shake will be at its most powerful.
 * @param afMaxDist, distance where shake will have faded out completely.
 * @param aEasingType, the curve the strength of the shake will follow as you move further from the entity.
 **/
void Effect_FOV_Shake_SetSourceEntity(int alID, const tString &in asSourceEntity, float afMinDist, float afMaxDist, eEasing aEasingType = eEasing_CubicIn)
{
	iScrEffect_FOV_Shake@ pShake = cast<iScrEffect_FOV_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_FOV_Shake));

	tID sourceID = cLux_GetCurrentMap().GetEntityIDByName(asSourceEntity, eLuxEntityType_LastEnum, "");
	
	pShake.SetSourceEntity(alID, sourceID, afMinDist, afMaxDist, aEasingType);	
}

void Effect_FOV_Shake_SetAmount(int alID, float afAmount)
{
	iScrEffect_FOV_Shake@ pShake = cast<iScrEffect_FOV_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_FOV_Shake));
	
	pShake.SetAmount(alID, afAmount);	
}

//-------------------------------------------------

float Effect_FOV_Shake_GetCurrentAmount()
{
	iScrEffect_FOV_Shake@ pShake = cast<iScrEffect_FOV_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_FOV_Shake));
	return pShake.GetCurrentShakeAmount();	
}

//-------------------------------------------------

float Effect_FOV_Shake_GetCurrentRumble()
{
	iScrEffect_FOV_Shake@ pShake = cast<iScrEffect_FOV_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_FOV_Shake));
	return pShake.GetCurrentRumble();
}

//-------------------------------------------------

/////////////////////////////////////////
// ROLL SHAKE
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Oscilates the camera roll rapidly.
 * If several calls to Roll shake has been made the largest one is used.
 * 
 * @param float afAmount, The strength of the shake, indicating the maximum roll offset in degrees
 * @param float afTime, The time it shakes at full intensity (fade in and fade out are added to this).
 * @param float afFadeInTime, The time before it reaches full strenght.
 * @param float afFadeOutTime, The time, after afTime is up, that it will take for the shake to reach zero strength.
 * @param afFrequency, Times per seconds the shake will change offset. 0=every update (ie max).
 * @param abUseNoise, if noise should be used to vary the intensity of the shake
 * @param afNoiseMinRelAmount, fraction of afAmount that should be the minimum shake amount when using noise.
 **/
int Effect_Roll_Shake_Start(float afAmount, float afTime, float afFadeInTime,float afFadeOutTime, float afFrequency=0, bool abUseNoise = false, float afNoiseMinRelAmount = 0, float afNoiseSpeed = 2.0f)
{
	iScrEffect_Roll_Shake@ pShake = cast<iScrEffect_Roll_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_Roll_Shake));
	
	return pShake.Start(cMath_ToRad(afAmount), afTime, afFadeInTime, afFadeOutTime, afFrequency, abUseNoise, afNoiseMinRelAmount, afNoiseSpeed);	
}

//-------------------------------------------------

/**
 * Fades out one or all roll shake instances.
 * 
 * @param alID, The id of the shake (returned by Effect_Roll_Shake_Start). -1 = fade out all active shakes.
 * @param afFadeOutTime, the time it takes to fade out.
 **/
void Effect_Roll_Shake_FadeOut(int alID, float afFadeOutTime)
{
	iScrEffect_Roll_Shake@ pShake = cast<iScrEffect_Roll_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_Roll_Shake));
	
	pShake.FadeOut(alID, afFadeOutTime);	
}

//-------------------------------------------------

/**
 * 
 * Sets an entity as the source of a Roll shake instance. The shake instance will increase in strength as the player gets closer to the entity.
 * 
 * @param alID, The id of the shake (returned by Effect_Roll_Shake_Start).
 * @param asSourceEntity, entity to be used as source.
 * @param afMinDist, distance to entity where the shake will be at its most powerful.
 * @param afMaxDist, distance where shake will have faded out completely.
 * @param aEasingType, the curve the strength of the shake will follow as you move further from the entity.
 **/
void Effect_Roll_Shake_SetSourceEntity(int alID, const tString &in asSourceEntity, float afMinDist, float afMaxDist, eEasing aEasingType = eEasing_CubicIn)
{
	iScrEffect_Roll_Shake@ pShake = cast<iScrEffect_Roll_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_Roll_Shake));

	tID sourceID = cLux_GetCurrentMap().GetEntityIDByName(asSourceEntity, eLuxEntityType_LastEnum, "");
	
	pShake.SetSourceEntity(alID, sourceID, afMinDist, afMaxDist, aEasingType);	
}

//-------------------------------------------------

void Effect_Roll_Shake_SetAmount(int alID, float afAmount)
{
	iScrEffect_Roll_Shake@ pShake = cast<iScrEffect_Roll_Shake>(cLux_GetEffectHandler().GetEffect(eEffect_Roll_Shake));
	
	pShake.SetAmount(alID, cMath_ToRad(afAmount));	
}

