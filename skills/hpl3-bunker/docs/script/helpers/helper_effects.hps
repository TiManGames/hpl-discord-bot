// LENS DISTORTION
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets the direct amount of lens distortion directly
 *
 * @param afX, The amount of the effect, positive values give fish eye, negative give opposite effect
 **/
void Effect_LensDistortion_SetDirectAmount(float afX)
{
	iScrEffect_LensDistortion@ pEffect = cast<iScrEffect_LensDistortion>(cLux_GetEffectHandler().GetEffect(eEffect_LensDistortion));

	pEffect.SetDirectAmount(afX);
}

//-------------------------------------------------

/**
 * Starts the video distortion effect. If many have been started the max amount is used. Returns ID to this instnace.
 *
 * @param afX, The amount of the effect, positive values give fish eye, negative give zoom
 **/
int Effect_LensDistortion_Start(float afAmount)
{
	iScrEffect_LensDistortion@ pEffect = cast<iScrEffect_LensDistortion>(cLux_GetEffectHandler().GetEffect(eEffect_LensDistortion));
	
	return pEffect.Start(afAmount);
}

//-------------------------------------------------

/**
 * Starts the video distortion effect. If many have been started the max amount is used. Returns ID to this instnace.
 *
 * @param alID, id to the effect instance, returned by _Start()
 * @param afX, The amount of the effect, positive values give fish eye, negative gives zoom, 0 = disabled
 **/
bool Effect_LensDistortion_SetAmount(int alID, float afAmount)
{
	iScrEffect_LensDistortion@ pEffect = cast<iScrEffect_LensDistortion>(cLux_GetEffectHandler().GetEffect(eEffect_LensDistortion));
	
	return pEffect.Set(alID, afAmount);
}

