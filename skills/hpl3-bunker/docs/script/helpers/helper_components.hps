//-------------------------------------------------

cMatrixf HandPlacement_GetPreMatrix(const tString&in asEntity, eLuxHand aHand, int alBone)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity);
	iLuxEntityComponent @pComp = pEnt is null ? null : pEnt.GetComponentByType(eLuxEntityComponentType_HandPlacement);

	if(pComp is null)
	{
		return cMatrixf_Identity;
	}
	
	return cast<cLuxHandPlacement>(pComp).GetPreMatrix(aHand, alBone);
}


void HandPlacement_SetFade(const tString&in asEntity, eLuxHand aHand, float afFade)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity);
	iLuxEntityComponent @pComp = pEnt is null ? null : pEnt.GetComponentByType(eLuxEntityComponentType_HandPlacement);

	if(pComp is null)
		return;
	cast<cLuxHandPlacement>(pComp).SetFade(aHand, afFade);
}


