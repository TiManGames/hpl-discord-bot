//#include "xxxx"

//-------------------------------------------------

/////////////////////////////////////////
// FOOT PLACEMENT
/////////////////////////////////////////

//-------------------------------------------------

void FootPlacement_SetActive(const tString&in asEntity, bool abX)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity);
	iLuxEntityComponent @pComp = pEnt is null ? null : pEnt.GetComponentByType(eLuxEntityComponentType_FootPlacement);

	if (pComp is null)
	{
		Error("Could not find FootPlacement Component for entity with name '"+asEntity+"' for FootPlacement_SetActive");
		return;
	}

	cast<cLuxFootPlacement>(pComp).SetActive(abX);	
}

bool FootPlacement_IsActive(const tString&in asEntity)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity);
	iLuxEntityComponent @pComp = pEnt is null ? null : pEnt.GetComponentByType(eLuxEntityComponentType_FootPlacement);

	if (pComp is null)
	{
		Error("Could not find FootPlacement Component for entity with name '"+asEntity+"' for FootPlacement_IsActive");
		return false;
	}

	return cast<cLuxFootPlacement>(pComp).IsActive();	
}

