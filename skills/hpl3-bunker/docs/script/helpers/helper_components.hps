void FootPlacement_SetFootActive(const tString&in asEntity, bool abX, bool abRight, float afInactiveLength = -1.f, bool abFront = false)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity);
	iLuxEntityComponent @pComp = pEnt is null ? null : pEnt.GetComponentByType(eLuxEntityComponentType_FootPlacement);

	if (pComp is null)
	{
		Error("Could not find FootPlacement Component for entity with name '"+asEntity+"' for FootPlacement_FadeOut");
		return;
	}
	
	cast<cLuxFootPlacement>(pComp).SetFootActive(abX, abRight, afInactiveLength, abFront);
}


bool FootPlacement_GetFootActive(const tString&in asEntity, bool abRight, bool abFront = false)
{
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(asEntity);
	iLuxEntityComponent @pComp = pEnt is null ? null : pEnt.GetComponentByType(eLuxEntityComponentType_FootPlacement);

	if (pComp is null)
	{
		Error("Could not find FootPlacement Component for entity with name '"+asEntity+"' for FootPlacement_FadeOut");
		return false;
	}
	
	return cast<cLuxFootPlacement>(pComp).GetFootActive(abRight, abFront);
}

