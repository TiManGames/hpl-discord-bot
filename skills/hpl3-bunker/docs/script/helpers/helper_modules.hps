//-------------------------------------------------------

void PlayerBody_SetShowCrossHairIconsOnCutsceneEnd(bool abX)
{
	if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_CutsceneAnimation)
		return;
	
	cScript_SetGlobalArgBool(0, abX);
	cScript_RunGlobalFunc("State_CutsceneAnimation", "", "_Global_SetShowCrossHairIconsOnCutsceneEnd");
}

