//-------------------------------------------------

void PlayerBody_SetOnAfterAnimUpdateCallbackState(const tString &in asPlayerState)
{
	iScrPlayerBodyHandler_Interface@ pHandler = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
	iLuxEntity@ pEnt = cLux_GetCurrentMap().GetEntityByName(pHandler.GetEntityName(), eLuxEntityType_Prop);
	if (pEnt is null) return;
	
	cScript_SetGlobalArgString(0, asPlayerState);
	cScript_RunGlobalFunc(pEnt.GetName(), "cScrPropPlayerBody", "_Global_SetOnAfterAnimUpdateCallbackState");
}

