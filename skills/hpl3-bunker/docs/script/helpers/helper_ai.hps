void Agent_SetCutscenePosition(const tString &in asAgent, const cVector3f &in avPos)
{
	cScript_SetGlobalArgVector3f(0, avPos);
	if (cScript_RunGlobalFunc(asAgent, "cScrAgentHumanoid", "_Global_Humanoid_SetCutscenePosition") == false)
	{
	     Error("Could not run '"+asAgent+"' / _Global_Humanoid_SetCutscenePosition()");
	}
}

