/////////////////////////////////////////
// BARK MACHINE
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets if the barkmachine is active (this will only affect random sounds).
 * 
 * @param asEntityName, name of the entity with the barkmachine.
 * @param abActive, if active or not.
 **/
void BarkMachine_SetActive(const tString&in asEntityName, bool abActive)
{
	cLuxBarkMachine @pBarkMachine = cast<cLuxBarkMachine@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_BarkMachine, asEntityName));
	if(pBarkMachine is null) {
		Error("Could not find barkmachine in entity '"+asEntityName+"' for BarkMachine_SetActive");
		return;
	}
	pBarkMachine.SetActive(abActive);
}

/**
 * Resets the time until the next sound bark is played.
 * 
 * @param asEntityName, name of the entity with the barkmachine.
 **/
void BarkMachine_ResetSoundCount(const tString&in asEntityName)
{
	cLuxBarkMachine @pBarkMachine = cast<cLuxBarkMachine@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_BarkMachine, asEntityName));
	if(pBarkMachine is null) {
		Error("Could not find barkmachine in entity '"+asEntityName+"' for BarkMachine_ResetSoundCount");
		return;
	}
	pBarkMachine.ResetSoundCount();
}

/**
 * Resets the time until the next voice bark is played.
 * 
 * @param asEntityName, name of the entity with the barkmachine.
 **/
void BarkMachine_ResetVoiceCount(const tString&in asEntityName)
{
	cLuxBarkMachine @pBarkMachine = cast<cLuxBarkMachine@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_BarkMachine, asEntityName));
	if(pBarkMachine is null) {
		Error("Could not find barkmachine in entity '"+asEntityName+"' for BarkMachine_ResetVoiceCount");
		return;
	}
	pBarkMachine.ResetVoiceCount();
}

/**
 * Plays a voice subject as a bark.
 * 
 * @param asEntityName, name of the entity with the barkmachine.
 * @param asSubject, the name of the voice subject.
 * @param alPrio, the prio of the voice, if there is already one playing in the same scene prio must be higher for this to play.
 * @param afMinDistance, The distance where volume starts getting quiet. If below 0, default is used.
 * @param afMaxDistance, The maximum hearing range. If below 0, default is used.
 * @param afMaxPlayerListeningRange, The maximum that subtitles are displayed. If below 0, default is used.
 **/
void BarkMachine_PlayVoice(const tString&in asEntityName, const tString&in asSubject, int alPrio, float afMinDistance=-1, float afMaxDistance=-1, float afMaxPlayerListeningRange=-1)
{
	cLuxBarkMachine @pBarkMachine = cast<cLuxBarkMachine@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_BarkMachine, asEntityName));
	if(pBarkMachine is null) {
		Error("Could not find barkmachine in entity '"+asEntityName+"' for BarkMachine_SetActive");
		return;
	}
	pBarkMachine.PlayVoice(asSubject, alPrio, afMinDistance, afMaxDistance, afMaxPlayerListeningRange);
}

