/////////////////////////////////////////
// PATHFINDER
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Moves an entity containing a Pathfinder component to a position. The entity message eLuxEntityMessage_EndOfPath is broadcasted when complete.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * @param avPos, position to move to.
 * @param asCallbackFunc, The name of callback called when end is reach. Syntax: void Func(const tString& in asEntityName, bool abReachedEnd).
 * @param afUpdateFreq, The number of times per second that the path will be updated. O or below means never update.
 * @param abExactStopAtEnd, If the goal position should be hit exactly.
 * @param asResultCallbackFunc, The name of callback called when the pathfinding has been performed. Syntax: void Func(bool abSuccesful).
 **/
void Pathfinder_MoveTo(const tString&in asEntityName, const cVector3f &in avPos, const tString& in asCallbackFunc, float afUpdateFreq=0, bool abExactStopAtEnd=true, const tString& in asResultCallbackFunc = "")
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null)
	{
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_MoveTo");
		return;
	}
	
	pPathfinder.MoveTo(avPos, afUpdateFreq, abExactStopAtEnd, asResultCallbackFunc, true);
	pPathfinder.SetEndOfPathCallbackFunc(asCallbackFunc);
}

//-------------------------------------------------

/**
 * Moves an entity containing a Pathfinder component to a node.  The entity message eLuxEntityMessage_EndOfPath is broadcasted when complete.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * @param asNodeName, name of the node to move to.
 * @param asCallbackFunc, The name of callback called when end is reach. Syntax: void Func(const tString& in asEntityName, bool abReachedEnd).
 * @param afUpdateFreq, The number of times per second that the path will be updated. O or below means never update.
 * @param abExactStopAtEnd, If the goal node should be hit exactly.
 * @param asResultCallbackFunc, The name of callback called when the pathfinding has been performed. Syntax: void Func(const tString& in asEntityName, bool abReachedEnd).
 **/
void Pathfinder_MoveToNode(const tString&in asEntityName, const tString&in asNodeName, const tString& in asCallbackFunc="", float afUpdateFreq=0, bool abExactStopAtEnd=true, const tString& in asResultCallbackFunc = "")
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null)
	{
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_MoveToNode");
	}
	
	pPathfinder.MoveToNode(asNodeName, afUpdateFreq, abExactStopAtEnd, asResultCallbackFunc, true);
	pPathfinder.SetEndOfPathCallbackFunc(asCallbackFunc);
}

//-------------------------------------------------

/**
 * Moves an entity containing a Pathfinder component to a entity.  The entity message eLuxEntityMessage_EndOfPath is broadcasted when complete.
 * 
 * @param asPathfinderName, name of the entity with the pathfinder.
 * @param asEntityName, name of the entity to move to.
 * @param asCallbackFunc, The name of callback called when end is reach. Syntax: void Funcconst tString& in asEntityName, bool abReachedEnd).
 * @param afUpdateFreq, The number of times per second that the path will be updated. O or below means never update.
 * @param abExactStopAtEnd, If the goal entity should be hit exactly.
 * @param avGoalPosOffset, if the goal pos should be offset.
 * @param asResultCallbackFunc, The name of callback called when the pathfinding has been performed. Syntax: void Func(bool abSuccesful).
 **/
void Pathfinder_MoveToEntity(	const tString&in asPathfinderName, const tString&in asEntityName, const tString& in asCallbackFunc, 
								float afUpdateFreq=0, bool abExactStopAtEnd=true,
								const cVector3f& in avGoalPosOffset=cVector3f(0),  const tString& in asResultCallbackFunc = "")
{
	iLuxEntity @pEntity = cLux_GetCurrentMap().GetEntityByName(asEntityName);
	if(pEntity is null)
	{
		Error("Could not find entity '"+asEntityName+"' to be used as goal in Pathfinder_MoveToEntity");
		return;
	}
	
	
	Pathfinder_MoveTo(asPathfinderName, pEntity.GetPosition()+avGoalPosOffset, asCallbackFunc,afUpdateFreq,abExactStopAtEnd, asResultCallbackFunc);
}

//-------------------------------------------------

/**
 * Stops any movement.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 **/
void Pathfinder_Stop(const tString&in asEntityName)
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null)
	{
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_Stop");
		return;
	}
	
	pPathfinder.Stop();
}

//-------------------------------------------------

/**
 * Sets the callback for when the pathfinder has reached its goal.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * @param asCallbackFUnc, The name of callback called when end is reach. Syntax: void Funcconst tString& in asEntityName, bool abReachedEnd).
 **/
void Pathfinder_SetEndCallback(const tString&in asEntityName, const tString& in asCallbackFunc)
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null)
	{
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_SetEndCallback");
		return;
	}
	
	pPathfinder.SetEndOfPathCallbackFunc(asCallbackFunc);
}

//-------------------------------------------------

/**
 * Checks if the pathfinder is currently moving.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * 
 * @return bool, true if moving.
 **/
bool Pathfinder_IsMoving(const tString&in asEntityName)
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null)
	{
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_IsMoving");
		return false;
	}
	
	return pPathfinder.IsMoving();
}

//-------------------------------------------------

/**
 * Clears all track nodes and stops track.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 **/
void Pathfinder_Track_Clear(const tString&in asEntityName)
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null) {
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_Track_Clear");
		return;
	}
	
	pPathfinder.ClearTrackNodes();
}

//-------------------------------------------------

/**
 * Adds a track node to be followed.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * @param asNodeName, Name of the path node to be added.
 * @param afMinWaitTime, minimum time before the entity moves to the next node.
 * @param afMaxWaitTime, maximum time before the entity moves to the next node. If <0, then the value will be same as afMinWaitTime.
 * @param asAnimName, animation played when at node, per entity.
 * @param abLoopAnim, if the animtion should be looped, per entity.
 **/
void Pathfinder_Track_Add(const tString&in asEntityName, const tString&in asNodeName,float afMinWaitTime=0, float afMaxWaitTime=-1, const tString&in asAnimName="", bool abLoopAnim=false)
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null) {
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_Track_Add");
		return;
	}
	
	pPathfinder.AddTrackNode(asNodeName, afMinWaitTime, afMaxWaitTime>=0? afMaxWaitTime : afMinWaitTime, asAnimName, abLoopAnim);
}
	
//-------------------------------------------------

/**
 * Starts a track.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * @param abLoop, if the path should loop.
 * @param afUpdateFreq, the frequency at which the path is recculated.
 * @param asEndOfTrackCallback, Callback called when path is over. Syntax: void MyFunc(const tString& in asEntityName).
 **/
void Pathfinder_Track_Start(const tString&in asEntityName, bool abLoop=false, float afUpdateFreq=1.0f, const tString &in asEndOfTrackCallback="", bool abRandom=false)
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null) {
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_Track_Start");
		return;
	}
	pPathfinder.StartTrack(abLoop, afUpdateFreq, asEndOfTrackCallback, abRandom);
}
	
//-------------------------------------------------

/**
 * Stops the current track.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 **/
void Pathfinder_Track_Stop(const tString&in asEntityName)
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if(pPathfinder is null) {
		Error("Could not find pathfinder in entity '"+asEntityName+"' for Pathfinder_Track_Stop");
		return;
	}
	pPathfinder.StopTrack();
}

//-------------------------------------------------

/**
 * Returns a node at the specified position.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * @param avPos, the position to check.
 * @param afMinDist, min distance to the position.
 * @param afMaxDist, max distance to the position.
 * @param abClosest, if the function should get the closest node to the position.
 **/
cAINode@ Pathfinder_GetNodeAtPosition(const tString&in asEntityName, const cVector3f &in avPos, float afMinDist, float afMaxDist, bool abClosest)
{
	cLuxPathfinder @pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if (pPathfinder is null) 
	{
		Error("Could not find pathfinder in entity '" + asEntityName + "' for Pathfinder_GetNodeAtPosition");
		return null;
	}
	cAINode@ pNode = pPathfinder.GetNodeAtPos(avPos, afMinDist, afMaxDist, abClosest, true, false, null);
	return pNode;
}

//-------------------------------------------------

/**
 * Adds a physics body as a path blocker.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * @param a_idBody, the id of the body to add.
 **/
void Pathfinder_AddPathBlockerBody(const tString &in asEntityName, tID a_idBody)
{
	cLuxPathfinder@ pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if (pPathfinder is null) 
	{
		Error("Could not find pathfinder in entity '" + asEntityName + "' for Pathfinder_AddPathBlockerBody");
		return;
	}
	
	if (a_idBody != tID_Invalid)
		pPathfinder.AddPathBlockerBody(a_idBody);
}

//-------------------------------------------------

/**
 * Removes a path blocker body.
 * 
 * @param asEntityName, name of the entity with the pathfinder.
 * @param a_idBody, the id of the body to remove.
 **/
void Pathfinder_RemovePathBlockerBody(const tString &in asEntityName, tID a_idBody)
{
	cLuxPathfinder@ pPathfinder = cast<cLuxPathfinder@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_Pathfinder, asEntityName));
	if (pPathfinder is null) 
	{
		Error("Could not find pathfinder in entity '" + asEntityName + "' for Pathfinder_RemovePathBlockerBody");
		return;
	}
	
	if (a_idBody != tID_Invalid)
		pPathfinder.RemovePathBlockerBody(a_idBody);
}

