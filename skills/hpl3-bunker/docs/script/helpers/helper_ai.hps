/**
 * Checks if the agent has dected the player
 * 
 * @param asAgentName, name of the agent.
 **/
bool Agent_PlayerDetected(const tString &in asAgentName)
{
	cLuxAgent@ pAgent = cLux_ToAgent(cLux_GetCurrentMap().GetEntityByName(asAgentName,eLuxEntityType_Agent,""));
	if(pAgent is null)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_PlayerDetected");
		return false;
	}
	
	return pAgent.PlayerIsDetected();	
}

//-------------------------------------------------

/**
 * Resets the player detection state on the specified agent.
 * 
 * @param asAgentName, name of the agent.
 **/
void Agent_ResetPlayerDetectionState(const tString &in asAgentName)
{
	cLuxAgent@ pAgent = cLux_ToAgent(cLux_GetCurrentMap().GetEntityByName(asAgentName,eLuxEntityType_Agent,""));
	if(pAgent is null)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_ResetPlayerDetectionState");
		return;
	}
	
	pAgent.ResetPlayerDetectionState();
}

