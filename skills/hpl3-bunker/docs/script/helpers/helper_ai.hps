void Agent_StopCutsceneAnimation(const tString &in asAgent)
{
	if (cScript_RunGlobalFunc(asAgent, "cScrAgentHumanoid", "_Global_Humanoid_StopCutsceneAnimation") == false)
	{
	     Error("Could not run '"+asAgent+"' / _Global_Humanoid_StopCutsceneAnimation()");
	}
}

//-------------------------------------------------

