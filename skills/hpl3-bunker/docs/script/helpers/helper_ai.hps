/////////////////////////////////////////
// AGENT BASIC
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Set if the agent will collide with the environment (objects and stuff will still collide with it!)
 * 
 * @param asAgentName, name of the agent. Wildcard supported.
 * @param abX, If the character should be static and NOT move about.
 **/
void Agent_SetStaticCollider(const tString &in asAgentName, bool abX)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_SetStaticCollider");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		cLux_ToAgent(vEntities[i]).SetStaticCollider(abX);
	}
}

//-------------------------------------------------

/**
 * Set if the agent should have its senses (hearing/vision/etc) enabled. Usually implemented on a specific basis.
 * 
 * @param asAgentName, name of the agent. Wildcard supported.
 * @param abX, If the senses should be active.
 **/
void Agent_SetSensesActive(const tString &in asAgentName, bool abX)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_SetSensesActive");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		cLux_ToAgent(vEntities[i]).SetSensesActive(abX);
	}
}

//-------------------------------------------------

/**
 * Reveals the player's current position to the agent.
 * 
 * @param asAgentName, name of the agent. Wildcard supported.
 **/
void Agent_RevealPlayerPosition(const tString &in asAgentName, bool bForceRedetect=false)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asAgentName, eLuxEntityType_Agent, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find agent '" + asAgentName+"' for Agent_RevealPlayerPosition");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		if (bForceRedetect)
			cLux_ToAgent(vEntities[i]).ResetPlayerDetectionState();
		cLux_ToAgent(vEntities[i]).RevealPlayerPos();
	}
}

