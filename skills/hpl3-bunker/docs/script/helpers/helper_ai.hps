/////////////////////////////////////////
// NPC
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets the voice name for an NPC. This also automatically sets the source of the voice as the npc.
 * 
 * @param asNpcName, name of the NPC.
 * @param asVoiceName, name of the voice as defined in the voicehandler file.
 * @return bool, if the prop is being interacted with.
 **/
void NPC_SetVoiceName(const tString &in asNpcName, const tString &in asVoiceName)
{
	cScript_SetGlobalArgString(0, asVoiceName);
	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_SetVoiceName")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_SetVoiceName");
	}
}

//-------------------------------------------------

/**
 * Checks if the NPC is being talked to.
 * 
 * @param asNpcName, name of the NPC. 
 * @return bool, if the NPC is being talked with.
 **/
 bool NPC_IsTalking(const tString &in asNpcName)
{
	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_IsTalking")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_IsTalking");
		return false;
	}
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------

/**
 * Sets if the NPC can be talked to (interacted with).
 * 
 * @param asNpcName, name of the NPC. Wildcard supported.
 * @param abX, if can be talked to.
 **/
void NPC_SetCanBeTalkedTo(const tString &in asNpcName, bool abX)
{
	cScript_SetGlobalArgBool(0, abX);
	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_SetCanBeTalkedTo")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_SetCanBeTalkedTo");
	}
}


//-------------------------------------------------

/**
 * Sets and plays the main animation of the NPC. This will also turn off any movement animations.
 * 
 * @param asNpcName, name of the NPC. Wildcard supported.
 * @param asAnim, The name of the animation.
 * @param abPlayTransition, If a transition animation should be played.
 * @param asCallbackFunc, name of callback function. Only used if there is a transition animation. Syntax void Func(const tString &in asEntityName, const tString &in asAnimName).
 * @param afFadeTime, time it takes to fade to the animation.
 * @param abGlobalSpace, if the animation takes place in global space.
 **/
void NPC_SetMainAnimation(const tString &in asNpcName, const tString& in asAnim, bool abPlayTransition = true, const tString &in asCallbackFunc="", float afFadeTime=0.5, bool abGlobalSpace=false)
{
	cScript_SetGlobalArgString(0, asAnim);
	cScript_SetGlobalArgBool(1, abPlayTransition);
	cScript_SetGlobalArgString(2, asCallbackFunc);
	cScript_SetGlobalArgFloat(3, afFadeTime);
	cScript_SetGlobalArgBool(4, abGlobalSpace);
	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_SetMainAnimation")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_SetMainAnimation");
	}
}

//-------------------------------------------------

/**
 * Plays an extra animation for the NPC. Will return to main animation (see NPC_SetMainAnimation) when done.
 * 
 * @param asNpcName, name of the NPC. Wildcard supported.
 * @param asAnim, The name of the animation.
 * @param afFadeTime, The time it takes to fade in the animation.
 * @param asCallbackFunc, name of callback function. Syntax void Func(tString &in asEntityName, tString &in asAnimName).
 **/
void NPC_PlayExtraAnimation(const tString &in asNpcName, const tString& in asAnim, float afFadeTime=0.3, const tString &in asCallbackFunc="", bool abGlobalSpace=false)
{
	cScript_SetGlobalArgString(0, asAnim);
	cScript_SetGlobalArgFloat(1, afFadeTime);
	cScript_SetGlobalArgString(2, asCallbackFunc);
	cScript_SetGlobalArgBool(3, abGlobalSpace);
	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_PlayExtraAnimation")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_PlayExtraAnimation");
	}
}

//-------------------------------------------------

/**
 * Stops all animations for the NPC.
 * 
 * @param asNpcName, name of the NPC. Wildcard supported.
 * @param afFadeTime, The time it takes to fade out.
 **/
void NPC_StopAllAnimations(const tString &in asNpcName, float afFadeTime=0.0f)
{
	cScript_SetGlobalArgFloat(0, afFadeTime);
	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_StopAllAnimations")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_StopAllAnimations");
	}
}

//-------------------------------------------------

/**
 * Stops currently playing extra animation for the NPC.
 * 
 * @param asNpcName, name of the NPC. Wildcard supported.
 * @param afFadeTime, The time it takes to fade out.
 **/
void NPC_StopExtraAnimation(const tString &in asNpcName, float afFadeTime=0.0f)
{
	cScript_SetGlobalArgFloat(0, afFadeTime);
	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_StopExtraAnimation")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_StopExtraAnimation");
	}
}


//-------------------------------------------------

/**
 * Plays a face emotion for the duration.
 * 
 * @param asNpcName, name of the NPC. Wildcard supported.
 * @param asEmotion, name of the emotion, "Smile/Sad/Happy/Surprised/Wink/Wondering/Angry/Worried/Scared".
 * @param afDuration, how long the emotion should be active.
 * @param afWeight, how strong the emotion should be.
 * @param afFadeTime, fade in and out time for the emotion.
 **/
void NPC_PlayEmotion(const tString &in asNpcName, const tString& in asEmotion, float afDuration, float afWeight = 1.0f, float afFadeTime = 0.25f)
{
	cScript_SetGlobalArgString(0, "Emotion_" + asEmotion);
	cScript_SetGlobalArgFloat(1, afDuration);
	cScript_SetGlobalArgFloat(2, afWeight);
	cScript_SetGlobalArgFloat(3, afFadeTime);

	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_PlayEmotion")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_PlayEmotion");
	}
}

//-------------------------------------------------

/**
 * Moves the NPC to a path node.
 * 
 * @param asNpcName, name of the NPC. Wildcard supported.
 * @param asNodeName, The name of the path node.
 * @param asCallbackFunc, The name of callback called when end is reach. Syntax: void Func(const tString& in asEntityName, bool abReachedEnd).
 **/
void NPC_MoveToNode(const tString &in asNpcName, const tString& in asNodeName, const tString& in asCallbackFunc)
{
	cScript_SetGlobalArgString(0, asNodeName);
	cScript_SetGlobalArgString(1, asCallbackFunc);
	if(cScript_RunGlobalFunc(asNpcName, "cScrAgentHumanoidNPC", "_Global_MoveToNode")==false)
	{
		Error("Could not find prop with name '"+asNpcName+"' for NPC_MoveToNode");
		return;
	}
}

//-------------------------------------------------

/////////////////////////////////////////
// CRITTER
/////////////////////////////////////////

//-------------------------------------------------

/**
 * Sets the entity the critter should flock around.
 * 
 * @param asCritter, name of the Critter. Wildcard supported.
 * @param asGroupEntity, The name of the group entity.
 **/
void Critter_SetGroupEntity(const tString &in asCritter, const tString &in asGroupEntity)
{
	array<iLuxEntity@> vEntities;
	cLux_GetCurrentMap().GetEntityArray(asCritter, eLuxEntityType_Critter, "", vEntities);
	if (vEntities.length() == 0)
	{
		Error("Couldn't find critter '" + asCritter+"' for Critter_SetGroupEntity");
		return;
	}
	for (uint i = 0; i < vEntities.length(); i++)
	{
		cLux_ToCritter(vEntities[i]).SetGroup(asGroupEntity);
	}
}

//-------------------------------------------------

/////////////////////////////////////////
// AGENT CUTSCENE
/////////////////////////////////////////

//-------------------------------------------------

 /**
 * Plays a cutscene animation on the actor
 * 
 * @param asAgent, name of the agent
 * @param asAnim, name of the anim
 * @param afFadeTime, fade in time of the anim
 * @param abLoop, if the anim should loop
 * @param asCallback, callback function in the map script when the anim is over. Syntax: void Func(const tString &in asAgent, const tString &in asAnim)
 * @param afSpeed, speed of the animation
 * @param afRelTimePos, speed of the animation
 * @param abGlobalSpace, if anim should be played in global space at avPos and with afAngle rotation
 * @param avPos, position to play the animation at
 * @param afYaw, yaw to play the animation at
 * @param abFadeSpeed, if speed of the animation should fade in
 * @param abAlignWithRotBoneAtEnd, if the character body should align the with the rotation bone's (specified in the ModelEditor) yaw at the end of the animation
 * @param abRemainInCutsceneAfterEnd, if the agent should stay in the animation at the end of the animation.
 * 
 **/
void Agent_PlayCutsceneAnimation(const tString &in asAgent, const tString &in asAnim, float afFadeTime, bool abLoop, const tString &in asCallback="", 
									  float afSpeed = 1, float afRelTimePos = 0, bool abGlobalSpace = false, const cVector3f &in avPos = 0, float afAngle = 0, 
									  bool abFadeSpeed = false, bool abAlignWithRotBoneAtEnd = false, bool abRemainInCutsceneAfterEnd = false)
{
	cScript_SetGlobalArgString(0, asAnim);
	cScript_SetGlobalArgBool(1, abLoop);
	cScript_SetGlobalArgFloat(2, afFadeTime);
	cScript_SetGlobalArgString(3, asCallback);
	cScript_SetGlobalArgFloat(4, afSpeed);
	cScript_SetGlobalArgFloat(5, afRelTimePos);
	cScript_SetGlobalArgBool(6, abGlobalSpace);
	cScript_SetGlobalArgVector3f(7,avPos);
	cScript_SetGlobalArgFloat(8, afAngle);
	cScript_SetGlobalArgBool(9, abFadeSpeed);
	cScript_SetGlobalArgBool(10, abAlignWithRotBoneAtEnd);
	cScript_SetGlobalArgBool(11, abRemainInCutsceneAfterEnd);
	
	if (cScript_RunGlobalFunc(asAgent, "cScrAgentHumanoid", "_Global_Humanoid_PlayCutsceneAnimation") == false)
	{
	     Error("Could not run '"+asAgent+"' / _Global_Humanoid_PlayCutsceneAnimation()");
	}
}

//-------------------------------------------------

/**
 * Plays a cutscene animation on the actor
 * 
 * @param asAgent, name of the agent
 * @param asAnim, name of the anim
 * @param asEntityName, name of the target entity
 * @param afFadeTime, fade in time of the anim
 * @param abLoop, if the anim should loop
 * @param asCallback, callback function in the map script when the anim is over. Syntax: void Func(const tString &in asAgent, const tString &in asAnim)
 * @param afSpeed, speed of the animation
 * @param afRelTimePos, speed of the animation
 * @param avOffsetPos, position offset from asEntityName
 * @param afOffsetAngle, rotation offset from asEntityName
 * @param abFadeSpeed, if speed of the animation should fade in
 * @param abAlignWithRotBoneAtEnd, if the character body should align the with the rotation bone's (specified in the ModelEditor) yaw at the end of the animation
 * @param abRemainInCutsceneAfterEnd, if the agent should stay in the animation at the end of the animation.
 * 
 **/
void Agent_PlayCutsceneAtEntity(const tString &in asAgent, const tString &in asAnim, const tString &in asEntityName, float afFadeTime, bool abLoop,
								const tString &in asCallback="", float afSpeed = 1, float afRelTimePos = 0, 
								const cVector3f &in avOffsetPos = 0, float afOffsetAngle = 0, bool abOffsetLocally = true, 
								bool abFadeSpeed = false, bool abAlignWithRotBoneAtEnd = false, bool abRemainInCutsceneAfterEnd = false)
{
	iLuxEntity @pEntity = cLux_GetCurrentMap().GetEntityByName(asEntityName);
	if(pEntity is null)
	{
		Error("Could not find entity '"+asEntityName+"' for PlayerBody_PlayCutsceneAtEntity");
		return;
	}
	
	cMatrixf mtxEnt = pEntity.GetMatrix();
	cVector3f vPos = abOffsetLocally ? 
					 cMath_MatrixMul(mtxEnt, avOffsetPos) : 
					 mtxEnt.GetTranslation()+avOffsetPos;
	
	cVector3f vFwd = mtxEnt.GetTranspose().GetForward();
	float fYaw = cMath_ToRad(afOffsetAngle);
	if (abOffsetLocally) fYaw -= cMath_ATan2(vFwd.x, -vFwd.z);
	Agent_PlayCutsceneAnimation(asAgent, asAnim, afFadeTime, abLoop, asCallback, afSpeed, afRelTimePos, true, vPos, fYaw, abFadeSpeed, abAlignWithRotBoneAtEnd, abRemainInCutsceneAfterEnd);
}

//------------------------------------------------------------

/**
 * Returns true if a cutscene is currently playing on the agent
 * 
 * @param asAgent, name of the agent
 * 
 **/
bool Agent_GetCutsceneActive(const tString &in asAgent)
{
	if (cScript_RunGlobalFunc(asAgent, "cScrAgentHumanoid", "_Global_Humanoid_GetCutsceneActive") == false)
	{
	     Error("Could not run '"+asAgent+"' / _Global_Humanoid_GetCutsceneActive()");
	}
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------

/**
 * Returns the name of the current cutscene. If none, returns an empty string
 * 
 * @param asAgent, name of the agent
 * 
 **/
tString Agent_GetActiveCutscene(const tString &in asAgent)
{
	if (cScript_RunGlobalFunc(asAgent, "cScrAgentHumanoid", "_Global_Humanoid_GetActiveCutscene") == false)
	{
	     Error("Could not run '"+asAgent+"' / _Global_Humanoid_GetActiveCutscene()");
	}
	return cScript_GetGlobalReturnString();
}

//-------------------------------------------------

/**
