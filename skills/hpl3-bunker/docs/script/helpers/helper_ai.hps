/**
 * Moves the character to a entity. Note that for non-flying characters, goal position should be the feet postion.
 * 
 * @param asEntityName, name of the entity with the CharMover.
 * @param asMoveToEntityName, the entity which center will be turn towards.
 * @param avOffset, an offset for the move postion.
 **/
void CharMover_MoveToEntity(const tString&in asEntityName, const tString&in asMoveToEntityName,
							const cVector3f& in avOffset=cVector3f(0))
{
	cLuxCharMover @pCharMover = cast<cLuxCharMover@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_CharMover, asEntityName));
	if(pCharMover is null)
	{
		Error("Could not find char mover in entity '"+asEntityName+"' for CharMover_TurnToEntity");
		return;
	}
	
	iLuxEntity @pMoveToEntity = cLux_GetCurrentMap().GetEntityByName(asMoveToEntityName, eLuxEntityType_LastEnum, "");
	if(pMoveToEntity is null)
	{
		Error("Could not find turn to entity '"+asMoveToEntityName+"' for CharMover_MoveToEntity");
		return;
	}
	
	pCharMover.MoveToPos(pMoveToEntity.GetPosition()+avOffset);
}

