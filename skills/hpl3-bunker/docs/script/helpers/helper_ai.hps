/**
 * Sets the turning behavior of the charmover.
 * 
 * @param asEntityName, name of the entity with the CharMover.
 * @param afMinBreakAngle, the minimum angle at which the charmover should slow down when turning.
 * @param afBreakAngleMul, value multiplied by the angle to calculate how much the charmover should slow down when turning.
 * @param afTurnSpeedMul, value multiplied by the angle to calculate how fast the charmover should turn.
 * @param afTurnSpeedMax, the max turn speed.
 **/
void CharMover_SetTurnRate(const tString&in asEntityName, float afMinBreakAngle, float afBreakAngleMul, float afTurnSpeedMul, float afTurnSpeedMax)
{
	cLuxCharMover @pCharMover = cast<cLuxCharMover@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_CharMover, asEntityName));
	if(pCharMover is null)
	{
		Error("Could not find char mover in entity '"+asEntityName+"' for CharMover_SetTurnRate");
		return;
	}

	pCharMover.SetTurnMinBreakAngle(cMath_ToRad(afMinBreakAngle) );
	pCharMover.SetTurnBreakMul(afBreakAngleMul);
	pCharMover.SetTurnSpeedMul(afTurnSpeedMul);
	pCharMover.SetTurnMaxSpeed(afTurnSpeedMax);
}

