/**
 * Checks if the pathfinder is currently moving.
 * 
 * @param asEntityName, name of the entity with the state machine.
 * 
 * @return int, current state.
 **/
int StateMachine_GetCurrentState(const tString&in asEntityName)
{
	cLuxStateMachine @pStateMachine = cast<cLuxStateMachine@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_StateMachine, asEntityName));
	if(pStateMachine is null)
	{
		Error("Could not find state machine in entity '"+asEntityName+"' for StateMachine_GetCurrentState");
		return -1;
	}
	
	return pStateMachine.GetCurrentState();
}

/**
 * Checks if the pathfinder is currently moving.
 * 
 * @param asEntityName, name of the entity with the state machine.
 * 
 * @return int, current state.
 **/
tString StateMachine_GetCurrentStateName(const tString&in asEntityName)
{
	cLuxStateMachine @pStateMachine = cast<cLuxStateMachine@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_StateMachine, asEntityName));
	if(pStateMachine is null)
	{
		Error("Could not find state machine in entity '"+asEntityName+"' for StateMachine_GetCurrentState");
		return "";
	}
	
	return pStateMachine.GetCurrentStateName();
}

