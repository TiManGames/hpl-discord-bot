/**
 * Sets the damage of the attack damage component with type d belonging to the agent.
 * 
 * @param asAgentName, name of the agent.
 * @param alId, id of the attack damage type.
 * @param afMinDamage, min damage of the attack.
 * @param afMaxDamage, max damage of the attack.
 * @param abLethalToPlayer, if the attack can lead to death.
 **/
void AttackDamage_SetDamage(const tString &in asAgentName, int alId, float afMinDamage, float afMaxDamage, bool abLethalToPlayer)
{
	cLuxAttackDamage @pAttackDamage = cast<cLuxAttackDamage@>(cLux_GetCurrentMap().GetEntityComponent(eLuxEntityComponentType_AttackDamage, asAgentName));
	if (pAttackDamage is null)
	{
		Error("Could not find attack damage component in agent '"+asAgentName+"' for AttackDamage_SetDamage");
