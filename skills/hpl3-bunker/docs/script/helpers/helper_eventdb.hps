//-------------------------------------------------

/////////////////////////////////////////
// GENERAL
/////////////////////////////////////////

//-------------------------------------------------

cEvent@ EventDB_Query(const tString &in asOwner, const tString&in asTrigger)
{
	return cLux_GetEventDatabaseHandler().Query(asOwner, asTrigger, null);
}

cEvent@ EventDB_QueryToAll(int alOwnerFlags, const tString&in asTrigger)
{
	return cLux_GetEventDatabaseHandler().QueryToAll(alOwnerFlags, asTrigger, null);
}

//-------------------------------------------------

bool EventDB_UseStandardTriggers()
{
	return cLux_GetEventDatabaseHandler().UseStandardTriggers();
}

//-------------------------------------------------

/////////////////////////////////////////
// FACTS
/////////////////////////////////////////

//-------------------------------------------------

void EventDB_SetLocalFact(const tString&in asFact){cLux_GetEventDatabaseHandler().SetLocalFact(asFact);}
void EventDB_SetLocalFactString(const tString&in asFact, const tString&in asStr){cLux_GetEventDatabaseHandler().SetLocalFactString(asFact, asStr);}
void EventDB_SetLocalFactFloat(const tString&in asFact, float afVal){cLux_GetEventDatabaseHandler().SetLocalFactFloat(asFact, afVal);}
void EventDB_SetLocalFactInt(const tString&in asFact, int alVal){cLux_GetEventDatabaseHandler().SetLocalFactInt(asFact, alVal);}
void EventDB_RemoveLocalFact(const tString&in asFact){cLux_GetEventDatabaseHandler().RemoveLocalFact(asFact);}

//-------------------------------------------------	

void EventDB_SetGlobalFact(const tString&in asFact){cLux_GetEventDatabaseHandler().SetGlobalFact(asFact);}
void EventDB_SetGlobalFactString(const tString&in asFact, const tString&in asStr){cLux_GetEventDatabaseHandler().SetGlobalFactString(asFact, asStr);}
void EventDB_SetGlobalFactFloat(const tString&in asFact, float afVal){cLux_GetEventDatabaseHandler().SetGlobalFactFloat(asFact, afVal);}
void EventDB_SetGlobalFactInt(const tString&in asFact, int alVal){cLux_GetEventDatabaseHandler().SetGlobalFactInt(asFact, alVal);}
void EventDB_RemoveGlobalFact(const tString&in asFact){cLux_GetEventDatabaseHandler().RemoveGlobalFact(asFact);}

//-------------------------------------------------

void EventDB_SetMemoryFact(const tString&in asFact){cLux_GetEventDatabaseHandler().GetEventDataBase().GetDefaultMemory().SetFact(asFact);}
void EventDB_SetMemoryFactString(const tString&in asFact, const tString&in asStr){cLux_GetEventDatabaseHandler().GetEventDataBase().GetDefaultMemory().SetFactString(asFact, asStr);}
void EventDB_SetMemoryFactFloat(const tString&in asFact, float afVal){cLux_GetEventDatabaseHandler().GetEventDataBase().GetDefaultMemory().SetFactFloat(asFact, afVal);}
void EventDB_SetMemoryFactInt(const tString&in asFact, int alVal){cLux_GetEventDatabaseHandler().GetEventDataBase().GetDefaultMemory().SetFactInt(asFact, alVal);}
void EventDB_RemoveMemoryFact(const tString&in asFact){cLux_GetEventDatabaseHandler().GetEventDataBase().GetDefaultMemory().RemoveFact(asFact);}

