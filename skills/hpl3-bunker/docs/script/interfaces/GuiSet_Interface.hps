#include "base/Player_Types.hps"

//-------------------------------------------------------

class iScrGuiSetBase
{
	/////////////////////////////////
	//Basic Init
	cLuxGuiSet @mBaseObj;
	void SetupBaseInterface(cLuxGuiSet @aObj){@mBaseObj = aObj;}
	cLuxGuiSet @GetBase(){ return mBaseObj;}

	/////////////////////////////////
	//Functions
	cGuiSet@ GetSet()
	{
		return mBaseObj.GetSet();
	}

	cGuiGfxElement@ GetImage(const tString&in asName)
	{
		return mBaseObj.GetImage(asName);
	}

	cGuiSkinFont@ GetFont(const tString&in asName)
	{
		return mBaseObj.GetFont(asName);
	}

	void AddCallback(const tString&in asWidget, eGuiMessage aMessage, const tString&in asFunction)
	{
		mBaseObj.AddCallback(asWidget, aMessage, asFunction);
	}

	void CreatePopUp(const tWString&in asLabel,const tWString&in asText, const tWString&in asButton1,const tWString&in asButton2, const tString&in asCallback)
	{
		mBaseObj.CreatePopUp(asLabel, asText, asButton1, asButton2, asCallback);
	}

	void CreateTextViewer(const tWString&in asTextName,	const tString&in asTextCat,const tString&in asTextEntry, const tString&in asCallback, bool abFirstNoteView)
	{
		mBaseObj.CreateTextViewer(asTextName, asTextCat, asTextEntry, asCallback, abFirstNoteView);
	}
	
	void Exit()
	{
		DropFocus();
		
		mBaseObj.Exit();
	}
	
	void DropFocus()
	{
		if(mBaseObj.HasFocus())
		{
			///////////////
			// Drop the focus if the player has locked input to this gui entity
			cLux_GetPlayer().ChangeState(ePlayerState_Normal);
			mBaseObj.DropFocus();
		}
	}
}