

//---------------------------------------------------------

class iScrAchievementHandlerBase
{
	/////////////////////////////////
	//Basic Init
	iLuxAchievementHandler@ mBaseObj;
	void SetupBaseInterface(iLuxAchievementHandler @aObj){@mBaseObj = aObj;}
	iLuxAchievementHandler@ GetBase(){ return mBaseObj;}
	
	/////////////////////////////////
	//Functions
	void CreateAchievement(int alID, const tString&in asName)
	{
		mBaseObj.CreateAchievement(alID, asName);
	}

	void UnlockAchievement(int alID)
	{
		mBaseObj.UnlockAchievement(alID);
	}

	void RegisterAchievements()
	{
		mBaseObj.RegisterAchievements();
	}

	bool GetAchievementUnlocked(int alID)
	{
		return mBaseObj.GetAchievementUnlocked(alID);
	}

	tString GetAchievementDisplayName(int alID)
	{
		return mBaseObj.GetAchievementDisplayName(alID);
	}

	tString GetAchievementDescription(int alID)
	{
		return mBaseObj.GetAchievementDescription(alID);
	}

	int GetAchievementIcon(int alID)
	{
		return mBaseObj.GetAchievementIcon(alID);
	}

	tString GetAchievementName(int alID)
	{
		return mBaseObj.GetAchievementName(alID);
	}
}

//---------------------------------------------------------
