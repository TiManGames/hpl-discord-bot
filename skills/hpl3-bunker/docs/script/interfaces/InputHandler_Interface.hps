

//---------------------------------------------------------

class iScrInputHandlerBase
{
	/////////////////////////////////
	//Basic Init
	cLuxInputHandler@ mBaseObj;
	void SetupBaseInterface(cLuxInputHandler @aObj){@mBaseObj = aObj;}
	cLuxInputHandler@ GetBase(){ return mBaseObj;}
	
	/////////////////////////////////
	//Functions
	void CreateAction(const tString&in asName, int alId, bool abConfigurable, const tString&in asCat, bool abUsePhysicsUpdate = false)
	{
		mBaseObj.CreateAction(asName, alId, abConfigurable, asCat, abUsePhysicsUpdate);
	}
	
	void CreateDebugAction(const tString&in asName, int alId)
	{
		mBaseObj.CreateDebugAction(asName, alId);
	}
	
	
	void CreateAnalogAction(const tString&in asName, int alId, bool abConfigurable, const tString&in asCat, int alAxis, float afMul, int alAnalogId, bool abUsePhysicsUpdate = false)
	{
		mBaseObj.CreateAnalogAction(asName, alId, abConfigurable, asCat, alAxis, afMul, alAnalogId, abUsePhysicsUpdate);
	}
	
	void CreateActionInput(const tString&in asInputType, int alActionId)
	{
		mBaseObj.CreateActionInput(asInputType, alActionId);
	}

	void CreateAnalogGamepadActionInput(const tString&in asInputType, int alActionId)
	{
		mBaseObj.CreateAnalogGamepadActionInput(asInputType, alActionId);
	}

	void CreateAnalogGamepadAction(const tString&in asName, int alId, const tString&in asCat, int alAnalogId, float afSmoothness, int alDirectionLimit, int alMaxAccelerationPos = 0, float afPrevAccelerationPosMul = 0.f,  bool abUsePhysicsUpdate = false)
	{
		mBaseObj.CreateAnalogGamepadAction(asName, alId, asCat, alAnalogId, afSmoothness, alDirectionLimit, alMaxAccelerationPos, afPrevAccelerationPosMul, abUsePhysicsUpdate);
	}
	
	void CreateGamepadProfile(const tString &in asName, const tString &in asPrefix, array<tString> &in avButtons, array<tString> &in avAxes, array<uint> &in avDPad)
	{
		mBaseObj.CreateGamepadProfile(asName, asPrefix, avButtons, avAxes, avDPad);
	}	
	
	void AddPresetToProfile(const tString &in asProfile, const tString &in asPreset, array<int> &in avActions, array<tString> &in avPrimary, array<bool> &in avAnalog)
	{
		mBaseObj.AddPresetToProfile(asProfile, asPreset, avActions, avPrimary, avAnalog);
	}

	void AssociateGamepadTypeToProfile(eGamepadType aType, const tString &in asProfile)
	{
		mBaseObj.AssociateGamepadTypeToProfile(aType, asProfile);
	}

	void SetDefaultGamepadProfile(const tString &in asProfile)
	{
		mBaseObj.SetDefaultGamepadProfile(asProfile);
	}
	
	void SetLastPluggedGamepadProfile(const tString &in asProfile)
	{
		mBaseObj.SetLastPluggedGamepadProfile(asProfile);
	}

	tString GetDefaultGamepadProfile()
	{
		return mBaseObj.GetDefaultGamepadProfile();
	}

	tString GetLastPluggedGamepadProfile()
	{
		return mBaseObj.GetLastPluggedGamepadProfile();
	}

	tString GetGamepadProfilePrefix(const tString &in asProfile)
	{
		return mBaseObj.GetGamepadProfilePrefix(asProfile);
	}

	void GetGamepadProfilePresetNames(const tString &in asProfile, array<tString> &out avOutPresetNames)
	{
		mBaseObj.GetGamepadProfilePresetNames(asProfile, avOutPresetNames);
	}

	tString GetCurrentGamepadProfilePreset()
	{
		return mBaseObj.GetCurrentGamepadProfilePreset();
	}
	
	tString GetActionName(int alId, bool abAnalog)
	{
		return mBaseObj.GetActionName(alId, abAnalog);
	}

	void SetGamepadMapping(tString asProfile, tString asPreset)
	{
		mBaseObj.SetGamepadMapping(asProfile, asPreset); 
	}

	int GetGamepadMappingActionNum()
	{
		return mBaseObj.GetGamepadMappingActionNum();
	}

	bool GetGamepadMappingAction(int alId, int&out alAction, tString&out asBind, bool&out abAnalog)
	{
		return mBaseObj.GetGamepadMappingAction(alId, alAction, asBind, abAnalog);
	}
	
	void GetActionsAssociatedToGamepadControl(const tString &in asProfile, const tString &in asPreset, const tString &in asControl, tString &out asActions)
	{
		mBaseObj.GetActionsAssociatedToGamepadControl(asProfile, asPreset, asControl, asActions);
	}
	
	void ClearKeyboardLayout()
	{
		mBaseObj.ClearKeyboardLayout();
	}
	
	void AddKeyboardLayoutKey(eKey aKey, eLuxKeyboardLayoutType aType, const cImGuiGfx &in aGfxKey, const cImGuiLabelData &in aLabelKey)
	{
		mBaseObj.AddKeyboardLayoutKey(aKey, aType, aGfxKey, aLabelKey);
	}
	
	void AddKeyboardLayoutRange(eKey aFirstKey, eKey aLastKey, eLuxKeyboardLayoutType aType, const cImGuiGfx &in aGfxKey, const cImGuiLabelData &in aLabelKey)
	{
		mBaseObj.AddKeyboardLayoutRange(aFirstKey, aLastKey, aType, aGfxKey, aLabelKey);
	}
	
	void SetKeyboardLayoutDefaults(const cImGuiGfx &in aGfxKey, const cImGuiLabelData &in aLabelKey)
	{
		mBaseObj.SetKeyboardLayoutDefaults(aGfxKey, aLabelKey);
	}
	
	void SetMouseLayout(array<tString> &in avButtons)
	{
		mBaseObj.SetMouseLayout(avButtons);
	}
}

//---------------------------------------------------------