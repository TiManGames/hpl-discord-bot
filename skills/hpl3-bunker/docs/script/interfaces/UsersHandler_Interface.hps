

//---------------------------------------------------------

class iScrUsersHandlerBase
{
	/////////////////////////////////
	//Basic Init
	iLuxUsersHandler@ mBaseObj;
	void SetupBaseInterface(iLuxUsersHandler @aObj){@mBaseObj = aObj;}
	iLuxUsersHandler@ GetBase(){ return mBaseObj;}
	
	/////////////////////////////////
	//Functions

	bool IsCurrentUser()
	{
		return mBaseObj.IsCurrentUser();
	}

	tWString GetCurrentUser()
	{
		return mBaseObj.GetCurrentUser();
	}

	bool ChangeCurrentUser()
	{
		return mBaseObj.ChangeCurrentUser();
	}

	int GetChangeUserStatus()
	{
		return mBaseObj.GetChangeUserStatus();
	}

	void ObtainFirstUser()
	{
		mBaseObj.ObtainFirstUser();
	}

	bool IsFirstUserObtained()
	{
		return mBaseObj.IsFirstUserObtained();
	}

	int GetResetUserReason()
	{
		return mBaseObj.GetResetUserReason();
	}
}

