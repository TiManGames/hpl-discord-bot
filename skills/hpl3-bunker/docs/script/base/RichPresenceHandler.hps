#include "interface/RichPresenceHandler_Interface.hps"
#include "base/RichPresenceHandler_Types.hps"

class cScrRichPresenceHandler : iScrRichPresenceHandlerBase, iScrRichPresenceHandler_Interface
{
	//------------------------------------------------------------

	/////////////////////////////////////////
	// CREATE RICHPRESENCE
	/////////////////////////////////////////

	//------------------------------------------------------------

	void CreateRichPresences()
	{
		CreateRichPresence(eRichPresence_MainMenu, "main_menu");
		CreateRichPresence(eRichPresence_Trenches, "trenches");
		CreateRichPresence(eRichPresence_NoMansLand, "no_mans_land");
		CreateRichPresence(eRichPresence_OfficersHub, "officer_hub");
		CreateRichPresence(eRichPresence_Maintenance, "maintenance");
		CreateRichPresence(eRichPresence_Prison, "prison");
		CreateRichPresence(eRichPresence_SoldiersQuarters, "soldier_quarters");
		CreateRichPresence(eRichPresence_Tunnels, "tunnels");
		CreateRichPresence(eRichPresence_Arsenal, "arsenal");
		CreateRichPresence(eRichPresence_Arena, "arena");

		/////////////
		// Register all RichPresence on Steam/PS4
		RegisterRichPresences();
	}

	//------------------------------------------------------------
}
