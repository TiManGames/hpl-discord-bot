#include "interfaces/GuiHandler_Interface.hps"
#include "base/InputHandler_Types.hps"


class cScrGuiHandler : iScrGuiHandlerBase, iScrGuiHandler_Interface
{
	//------------------------------------------------------------
	
	void UpdateDefaultInput(cImGui @apImGui)
	{
		apImGui.SendAction(eImGuiAction_Confirm, 	cInput_IsTriggered(eAction_MenuConfirm), 
													cInput_BecameTriggered(eAction_MenuConfirm));
		apImGui.SendAction(eImGuiAction_Cancel, 	cInput_IsTriggered(eAction_MenuCancel), 
													cInput_BecameTriggered(eAction_MenuCancel));
		apImGui.SendAction(eImGuiAction_MouseLeft, 	cInput_IsTriggered(eAction_MenuLeftMouse), 
													cInput_BecameTriggered(eAction_MenuLeftMouse));
				
		apImGui.SendAction(eImGuiAction_Up, cInput_IsTriggered(eAction_MenuUp), cInput_BecameTriggered(eAction_MenuUp));
		apImGui.SendAction(eImGuiAction_Down, cInput_IsTriggered(eAction_MenuDown), cInput_BecameTriggered(eAction_MenuDown));
		apImGui.SendAction(eImGuiAction_Left, cInput_IsTriggered(eAction_MenuLeft), cInput_BecameTriggered(eAction_MenuLeft));
		apImGui.SendAction(eImGuiAction_Right, cInput_IsTriggered(eAction_MenuRight), cInput_BecameTriggered(eAction_MenuRight));

		apImGui.SendAction(eImGuiAction_ScrollUp, cInput_IsTriggered(eAction_MenuScrollUp), cInput_BecameTriggered(eAction_MenuScrollUp));
		apImGui.SendAction(eImGuiAction_ScrollDown, cInput_IsTriggered(eAction_MenuScrollDown), cInput_BecameTriggered(eAction_MenuScrollDown));
	}
	
	//------------------------------------------------------------
	
	void SetDefaultData(cImGui @apImGui)
	{
		/////////////////////////
		// General
		apImGui.SetDefaultMouse(cImGuiGfx("default/imgui_pointer_normal.tga"), cVector2f(27, 36));
		apImGui.SetDefaultFont(cImGuiFont("default_small.fnt", cVector2f(17) ));

		/////////////////////////
		// Button
		cImGuiButtonData buttonData;
		{
			buttonData.mvDefaultSize = cVector2f(100, 25);
			buttonData.mGfxBackground.SetFile("default/imgui_button_base.tga");
			buttonData.mbUseInFocusGfx = true;
			buttonData.mGfxInFocus.SetFile("default/imgui_button_infocus.tga");
			buttonData.mGfxInFocus.mColor = cColor(0.3f);
			buttonData.mGfxInFocus.mMaterial = eGuiMaterial_Additive;
			buttonData.mbUseTriggeredGfx = true;
			buttonData.mGfxTriggered.SetFile("default/imgui_button_infocus.tga");
			buttonData.mGfxTriggered.mColor = cColor(0.6f,0,0, 1.0f);
			buttonData.mGfxTriggered.mMaterial = eGuiMaterial_Additive;
			apImGui.SetDefaultButton(buttonData);
		}

		/////////////////////////
		// Slider
		cImGuiSliderData sliderData;
		{
			sliderData.mvDefaultSize =cVector2f(100,20);
			sliderData.mGfxBackground.SetFile("default/imgui_slider_base.tga");
			sliderData.mbUseBaseInFocusGfx =true;
			sliderData.mGfxBaseInFocus.SetFile("default/imgui_slider_base_infocus.tga");
			sliderData.mGfxBaseInFocus.mMaterial = eGuiMaterial_Additive;

			sliderData.mvButtonSize = cVector2f(20,20);
			sliderData.mGfxButton.SetFile("default/imgui_slider_button.tga");

			sliderData.mbUseButtonInFocusGfx = true;
			sliderData.mGfxButtonInFocus.SetFile("default/imgui_slider_button_infocus.tga");
			sliderData.mGfxButtonInFocus.mMaterial = eGuiMaterial_Additive;
			sliderData.mGfxButtonInFocus.mColor = cColor(0.4f,1);

			sliderData.mbUseButtonTriggeredGfx = true;
			sliderData.mGfxButtonTriggered.SetFile("default/imgui_slider_button_infocus.tga");
			sliderData.mGfxButtonTriggered.mMaterial = eGuiMaterial_Additive;
			sliderData.mGfxButtonTriggered.mColor = cColor(0.6f,0,0,1);
			apImGui.SetDefaultSliderHorizontal(sliderData);

			sliderData.mvDefaultSize =cVector2f(20,100);
			sliderData.mGfxBackground.SetFile("default/imgui_slider_base_vert.tga");
			sliderData.mGfxBaseInFocus.SetFile("default/imgui_slider_base_vert_infocus.tga");

			apImGui.SetDefaultSliderVertical(sliderData);
		}

		/////////////////////////
		// Check Box
		cImGuiCheckBoxData checkBoxData;
		{
			checkBoxData.mvDefaultSize =cVector2f(100,25);

			checkBoxData.mvBoxSize = cVector2f(20,20);
			checkBoxData.mGfxBox.SetFile("default/imgui_checkbox.tga");
			checkBoxData.mvCheckOverlaySize = checkBoxData.mvBoxSize;
			checkBoxData.mGfxCheckOverlay.SetFile("default/imgui_checkbox_check.tga");
			checkBoxData.mGfxCheckOverlay.mColor = cColor(1,0.5f,0.5f,1);
			checkBoxData.mbUseBoxInFocusGfx=true;
			checkBoxData.mGfxBoxInFocus.SetFile("default/imgui_checkbox_infocus.tga");
			checkBoxData.mGfxBoxInFocus.mMaterial = eGuiMaterial_Additive;
			checkBoxData.mGfxBoxInFocus.mColor = cColor(0.4f,1);

			apImGui.SetDefaultCheckBox(checkBoxData);
		}

		/////////////////////////
		// Text Frame
		cImGuiTextFrameData textFrameData;
		{
			textFrameData.mColorBase = cColor(0.6f,0.5f);

			apImGui.SetDefaultTextFrame(textFrameData);
		}

		/////////////////////////
		// Multi Select
		cImGuiMultiSelectData multiData;
		{
			multiData.mvDefaultSize = cVector2f(100,25);

			multiData.mbUseBackgroundInFocusGfx = true;
			multiData.mGfxBackgroundInFocus.SetFile("default/imgui_text_infocus.tga");
			multiData.mGfxBackgroundInFocus.mMaterial = eGuiMaterial_Additive;
			multiData.mGfxBackgroundInFocus.mColor = cColor(0.3f,1);

			multiData.mvArrowSize = cVector2f(20);
			multiData.mbUseArrowInFocusGfx = true;

			multiData.mGfxArrowRight.SetFile("default/imgui_arrow_right.tga");
			multiData.mGfxArrowRightInFocus.SetFile("default/imgui_arrow_right_infocus.tga");
			multiData.mGfxArrowRightInFocus.mMaterial = eGuiMaterial_Additive;

			multiData.mGfxArrowLeft.SetFile("default/imgui_arrow_left.tga");
			multiData.mGfxArrowLeftInFocus.SetFile("default/imgui_arrow_left_infocus.tga");
			multiData.mGfxArrowLeftInFocus.mMaterial = eGuiMaterial_Additive;

			apImGui.SetDefaultMultiSelect(multiData);
		}
	}
	
	//------------------------------------------------------------
}	