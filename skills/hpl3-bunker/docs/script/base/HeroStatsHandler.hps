#include "interfaces/HeroStatsHandler_Interface.hps"
#include "base/HeroStatsHandler_Types.hps"
#include "helpers/helper_modules_custom.hps"

class cScrHeroStatsHandler : iScrHeroStatsHandlerBase, iScrHeroStatsHandler_Interface
{
	//------------------------------------------------------------

	/////////////////////////////////////////
	// CREATE HEROSTATS
	/////////////////////////////////////////

	//------------------------------------------------------------

	void CreateHeroStats()
	{
		/////////////
		// Register all HeroStats on XBoxOne
		// This is called before the script module classes are created so we need to add these separately from the game stats.
		// Also, the game module resets the stats entries every time we start a new game. 
		CreateHeroStat(eHeroStats_TimesSaved, "TimesSaved");
		CreateHeroStat(eHeroStats_NumberOfDeaths, "NumberOfDeaths");
		CreateHeroStat(eHeroStats_RatsKilled, "RatsKilled");
		CreateHeroStat(eHeroStats_BulletsFired, "BulletsFired");
		CreateHeroStat(eHeroStats_ShotgunShellsFired, "ShotgunShellsFired");
		CreateHeroStat(eHeroStats_GrenadesThrown, "GrenadesThrown");
		CreateHeroStat(eHeroStats_GasGrenadesThrown, "GasGrenadesThrown");
		CreateHeroStat(eHeroStats_PetrolBombsThrown, "PetrolBombsThrown");
		CreateHeroStat(eHeroStats_FlaresThrown, "FlaresThrown");
		CreateHeroStat(eHeroStats_HealthItemsUsed, "HealthItemsUsed");
		CreateHeroStat(eHeroStats_GeneratorRefills, "GeneratorRefills");
		CreateHeroStat(eHeroStats_Blackouts, "Blackouts");
		CreateHeroStat(eHeroStats_TrapsTriggered, "TrapsTriggered");
		CreateHeroStat(eHeroStats_CorpsesBurnt, "CorpsesBurnt");
		CreateHeroStat(eHeroStats_FiresStarted, "FiresStarted");
		CreateHeroStat(eHeroStats_DoorsDestroyed, "DoorsDestroyed");
		CreateHeroStat(eHeroStats_TimesSpottedByStalker, "TimesSpottedByStalker");
		CreateHeroStat(eHeroStats_ItemsCrafted, "ItemsCrafted");
		CreateHeroStat(eHeroStats_StalkerHitCount, "StalkerHitCount");
		CreateHeroStat(eHeroStats_RatsScaredByTorch, "RatsScaredByTorch");
		
		//////////////////////////
		// Link hero stats
		cLux_GetHeroStatsHandler().RegisterHeroStats();
	}

	//------------------------------------------------------------
}
