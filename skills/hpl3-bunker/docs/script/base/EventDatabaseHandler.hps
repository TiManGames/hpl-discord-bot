#include "interfaces/EventDatabaseHandler_Interface.hps"
#include "player/player_types.hps"
#include "helpers/helper_audio.hps"
#include "helpers/helper_modules.hps"


class cScrEventDatabaseHandler : iScrEventDatabaseHandlerBase, iScrEventDatabaseHandler_Interface
{
	/////////////////////////////////////////
	// FUNCTIONS
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	///////////////////////////////////
	// Important Note:
	// This is only called for type 2 and above, 0 is always script callback and 1 is always voice.
	void ExecuteEventAction(const tString& in asEventName, int alOutputType, const tString& in asOutput)
	{
		switch(alOutputType)
		{
		////////////////////////
		// Description
		case 2:
			{	
				array<tString> vStrings;
				cString_GetStringVec(asOutput, vStrings, " ,");
				
				if(vStrings.size()<2)
				{
					Error("Description output '"+asOutput+"' is not valid, must contain at least lang cat and entry!\n");
					return;
				}
				
				//Description_Add(vStrings[0], vStrings[1], false);
				break;
			}
		}
	}
	
	//------------------------------------------------------------
		
}	