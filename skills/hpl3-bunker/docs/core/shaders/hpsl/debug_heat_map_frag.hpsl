////////////////////////////////////////////////////////
// Heat map a greyscale value
//
// A basic fragment with little fancy stuff.
////////////////////////////////////////////////////////

//////////////
// TEXTURES
uniform cTexture2D aComplexityMap : 0;
uniform cTexture2D aSceneMap : 1;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	float fComplexity = sample(aComplexityMap, px_vTexCoord0.xy).x;
	cVector4f vColor = sample(aSceneMap, px_vTexCoord0.xy);

	cVector4f vFinalColor = cVector4f(0,0,0,0.5);

	if(fComplexity > 1e-4f)
	{
		/////////////
		// Fade from green to red, where green is good and red is bad
		vFinalColor = mix(cVector4f(0,1,0,0), cVector4f(1, 0, 0, 0), min(1, fComplexity));

		float fLength = length(vFinalColor);
		vFinalColor /= fLength;

		vFinalColor = vFinalColor * vFinalColor;
		vFinalColor *= 1.0f;

		vFinalColor.a = 0.1 + fComplexity * 0.75f;
	}
		 
	out_vColor = mix(vColor, vFinalColor, min(0.9, vFinalColor.a));
}