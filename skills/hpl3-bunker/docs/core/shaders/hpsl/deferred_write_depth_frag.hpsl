////////////////////////////////////////////////////////
// Deferred Depth Write - Fragment Shader
//
// Write a texture into the depth buffer
////////////////////////////////////////////////////////

//---------------------------------------------------------

uniform cTexture2D depthTexture : 0;

@ifdef LinearDepth
	uniform float afNear;
	uniform float afFar;

	float ToNonLinear(float afZ)
	{
		if(afZ >= 1.0) return 1.0;
		if(afZ <= 0.0) return 0.0;
		afZ = afZ + 1e-7f;
		return (afFar * afZ - afNear) / ((afFar-afNear)*afZ);
	}
@endif

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
			out float out_fDepth)
{
	@ifdef LinearDepth
		out_fDepth = ToNonLinear(sample(depthTexture, px_vTexCoord0.xy).x);
	@else
		out_fDepth = sample(depthTexture, px_vTexCoord0.xy).x;		
	@endif
}

