////////////////////////////////////////////////////////
// Heat map a greyscale value
//
// A basic fragment with little fancy stuff.
////////////////////////////////////////////////////////

//////////////
// TEXTURES
uniform cTexture2D aTexture : 0;

uniform cVector4f avDot;
uniform cVector4f avMul;
uniform cVector4f avAdd;


@ifdef SecondTexture
	uniform cTexture2D aSecondTexture : 1;

	uniform cVector4f avSecondDot;
	uniform cVector4f avSecondDotMul;
	uniform cVector4f avSecondMul;
	uniform cVector4f avSecondAdd;
@endif


void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	cVector4f vColor = sample(aTexture, px_vTexCoord0.xy);
	float fDot = dot(vColor, avDot);
	out_vColor = avAdd + avMul * vColor + cVector4f(fDot, fDot, fDot, fDot);

@ifdef SecondTexture
	cVector4f vSecondColor = sample(aSecondTexture, px_vTexCoord0.xy);
	float fSecondDot = dot(vSecondColor, avSecondDot);
	out_vColor += avSecondAdd + avSecondMul * vSecondColor + (cVector4f(fSecondDot, fSecondDot, fSecondDot, fSecondDot) * avSecondDotMul);
@endif
}