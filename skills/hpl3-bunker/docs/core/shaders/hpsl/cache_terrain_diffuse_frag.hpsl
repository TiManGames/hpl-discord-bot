////////////////////////////////////////////////////////
// Terrain cache texture - Fragment Shader
//
//
////////////////////////////////////////////////////////
@ifdef ContainsNormalMaps
	@include helper_normal_packing.hpsl
@endif

////////////////////
// Blend map
uniform cTexture2D aBlendMap : 0;

////////////////////
// Uniform variables
uniform cVector4f avTextureCoordScale;
uniform cVector4f avOneMinusFadeStart;

////////////////////
// Material Textures
@ifdef UseDetailAmount
	uniform cVector3f avDetailTextureAmount[4];
@else
	uniform cTexture2D aDiffuseMap0 : 1;
	uniform cTexture2D aDiffuseMap1 : 2;
	uniform cTexture2D aDiffuseMap2 : 3;
	uniform cTexture2D aDiffuseMap3 : 4;
@endif

@ifdef UseBaseTexture
	uniform float afBaseTextureCoordScale;
	
	@ifdef UseDetailAmount
		uniform cVector3f avBaseDetailTextureAmount;
	@else
		uniform cTexture2D aDiffuseBase : 5;
	@endif

@endif

@ifdef UseBump
	uniform cVector4f avMul;
	uniform float afBaseMul;
	uniform float afBumpOffset;
@endif

@ifdef UseBlendMul
	uniform cVector4f avBlendMul;
@endif

/////////////////////////
// Alph textures
uniform cTexture2D aAlphaMap0 : 6;
uniform cTexture2D aAlphaMap1 : 7;
uniform cTexture2D aAlphaMap2 : 8;
uniform cTexture2D aAlphaMap3 : 9;

//------------------------------------------------

cVector4f Blend(cVector4f avA, cVector4f avB)
{
	float fFade = avB.a * (1.0 - avA.a);
	cVector4f vBlended = avA + fFade * avB;
	vBlended.a = avA.a + fFade;

	return vBlended;
}

///////////////////////////////
// Main program
void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	//////////////////////////////////
	// Get UV coords
	cVector2f vTexCoord = px_vTexCoord0.xy;
	
	//////////////////////////////////
	//Blend
	cVector4f vBlendValues = sample(aBlendMap, vTexCoord);

	@ifdef UseBlendMul
		vBlendValues *= avBlendMul;
	@endif
	
	cVector4f vTexAlpha0 = sample(aAlphaMap0, vTexCoord * avTextureCoordScale.x);
	cVector4f vTexAlpha1 = sample(aAlphaMap1, vTexCoord * avTextureCoordScale.y);
	cVector4f vTexAlpha2 = sample(aAlphaMap2, vTexCoord * avTextureCoordScale.z);
	cVector4f vTexAlpha3 = sample(aAlphaMap3, vTexCoord * avTextureCoordScale.w);
	
	
	//avOneMinusFadeStart is added in a way that is the same as dividing final blend by 1-fadestart. This makes parts of the texture opaque even if other parts ahve faded.
	cVector4f vDissolveBlend = cVector4f(vTexAlpha0.w, vTexAlpha1.w, vTexAlpha2.w, vTexAlpha3.w) * (1.0 - 1.0 / 255.0) + 1.0 / 255.0;
	vDissolveBlend = clamp( (vDissolveBlend - (cVector4f(1.0, 1.0, 1.0, 1.0) - vBlendValues) ) / (vDissolveBlend * avOneMinusFadeStart), 0.0, 1.0);
	
	//////////////////////////////////
	//Diffuse color
	@ifdef UseDetailAmount
		cVector4f vTexColor0 = cVector4f(avDetailTextureAmount[0], vDissolveBlend.x);
		cVector4f vTexColor1 = cVector4f(avDetailTextureAmount[1], vDissolveBlend.y);
		cVector4f vTexColor2 = cVector4f(avDetailTextureAmount[2], vDissolveBlend.z);
		cVector4f vTexColor3 = cVector4f(avDetailTextureAmount[3], vDissolveBlend.w);
	@elseif ContainsNormalMaps
		cVector4f vTexColor0 = cVector4f(UnpackNormalmapYW( sample(aDiffuseMap0, vTexCoord * avTextureCoordScale.x) ), vDissolveBlend.x);
		cVector4f vTexColor1 = cVector4f(UnpackNormalmapYW( sample(aDiffuseMap1, vTexCoord * avTextureCoordScale.y) ), vDissolveBlend.y);
		cVector4f vTexColor2 = cVector4f(UnpackNormalmapYW( sample(aDiffuseMap2, vTexCoord * avTextureCoordScale.z) ), vDissolveBlend.z);
		cVector4f vTexColor3 = cVector4f(UnpackNormalmapYW( sample(aDiffuseMap3, vTexCoord * avTextureCoordScale.w) ), vDissolveBlend.w);
	@elseif UseBump
		cVector4f vTexColor0 = cVector4f(sample(aDiffuseMap0, vTexCoord * avTextureCoordScale.x).aaa * avMul.x, vDissolveBlend.x);
		cVector4f vTexColor1 = cVector4f(sample(aDiffuseMap1, vTexCoord * avTextureCoordScale.y).aaa * avMul.y, vDissolveBlend.y);
		cVector4f vTexColor2 = cVector4f(sample(aDiffuseMap2, vTexCoord * avTextureCoordScale.z).aaa * avMul.z, vDissolveBlend.z);
		cVector4f vTexColor3 = cVector4f(sample(aDiffuseMap3, vTexCoord * avTextureCoordScale.w).aaa * avMul.w, vDissolveBlend.w);
	@else
		cVector4f vTexColor0 = cVector4f(sample(aDiffuseMap0, vTexCoord * avTextureCoordScale.x).xyz, vDissolveBlend.x);
		cVector4f vTexColor1 = cVector4f(sample(aDiffuseMap1, vTexCoord * avTextureCoordScale.y).xyz, vDissolveBlend.y);
		cVector4f vTexColor2 = cVector4f(sample(aDiffuseMap2, vTexCoord * avTextureCoordScale.z).xyz, vDissolveBlend.z);
		cVector4f vTexColor3 = cVector4f(sample(aDiffuseMap3, vTexCoord * avTextureCoordScale.w).xyz, vDissolveBlend.w);
	@endif	
	
	///////////
	// Inverse alpha blend
	cVector4f vDiffuseColor = vTexColor3 * vTexColor3.a; vDiffuseColor.a = vTexColor3.a;
	vDiffuseColor = Blend(vDiffuseColor, vTexColor2);
	vDiffuseColor = Blend(vDiffuseColor, vTexColor1);
	vDiffuseColor = Blend(vDiffuseColor, vTexColor0);

	@ifdef UseBaseTexture
		@ifdef UseDetailAmount
			cVector4f vColor = cVector4f(avBaseDetailTextureAmount, 1.0f);
		@elseif ContainsNormalMaps
			cVector4f vColor = cVector4f(UnpackNormalmapYW( sample(aDiffuseBase, vTexCoord * afBaseTextureCoordScale) ), 1.0f);
		@elseif UseBump
			cVector4f vColor = cVector4f(sample(aDiffuseBase, vTexCoord * afBaseTextureCoordScale).aaa * afBaseMul, 1.0f);
		@else 
			cVector4f vColor = cVector4f(sample(aDiffuseBase, vTexCoord * afBaseTextureCoordScale).xyz, 1.0f);
		@endif
		
		vDiffuseColor = Blend(vDiffuseColor, vColor);
	@else
		// Normalize here to remove double blend that would come from doing alpha blending with framebuffer
		vDiffuseColor.xyz /= vDiffuseColor.a;
	@endif
	
	//////////////////////////////////
	//Final Diffuse Output
	@ifdef ContainsNormalMaps
		vDiffuseColor.xyz = (normalize(vDiffuseColor.xyz)*0.5 + 0.5);
	@endif
	
	@ifdef UseBump
		vDiffuseColor.xyz = (vDiffuseColor.xyz + afBumpOffset);
	@endif

	out_vColor = vDiffuseColor;

	//////////////////////////////////
	//Set the combine alpha as output if this is not the base layer
	@ifdef UseBaseTexture
		out_vColor.w =  1.0;
	@endif
}		