
float FogLinear(float afCameraHeight, in cVector3f avDir, float afDist, in cVector4f avFogSettings, float afNoise)
{
	//////////////
	// Caluclate fog amount based on min and max
	float fAmount = clamp((afDist - avFogSettings.x) / avFogSettings.y + afNoise, 0.0, 1.0);

	//////////////
	// Apply falloff
	if(fAmount < 0.5) fAmount = mix(fAmount*fAmount*fAmount*(fAmount*(fAmount*6 - 15) + 10), fAmount, fAmount * 2.0);
	return pow(fAmount, avFogSettings.z);
}

float FogExponential(float afCameraHeight, in cVector3f avDir, float afDist, in cVector4f avFogSettings, float afNoise)
{
	return clamp(1.0 - exp(-max(afDist - avFogSettings.x, 0.0) * avFogSettings.z) + afNoise, 0.0, 1.0);
}

float FogHeightInt(float afHeight, in cVector4f avFogSettings)
{
	return log(1.0 + exp(-afHeight * abs(avFogSettings.w * 0.25)));
}

float FogHeight(float afCameraHeight, in cVector3f avDir, float afDist, in cVector4f avFogSettings, float afNoise)
{
	//////////////
	// Varying fog density based on height
	afCameraHeight += avFogSettings.x * avDir.y;
	float fDist = max(afDist - avFogSettings.x, 0.0);
	float fMin = FogHeightInt(afCameraHeight, avFogSettings);
	float fMax = FogHeightInt(afCameraHeight+avDir.y*fDist, avFogSettings);

	float fAmount = exp((fMax - fMin)/avDir.y);
	if(avFogSettings.w > 0.0) fAmount = 1.0 - fAmount; 

	return clamp(fAmount + afNoise, 0.0, 1.0);
}

float FogAmount(float afCameraHeight, in cVector3f avDir, float afDist, in cVector4f avFogSettings, float afNoise, int alType)
{
	if(alType == 0)
	{
		return FogLinear(afCameraHeight, avDir, afDist, avFogSettings, afNoise);
	}
	else if(alType == 1)
	{
		return FogExponential(afCameraHeight, avDir, afDist, avFogSettings, afNoise);
	}
	else if(alType == 2)
	{
		return FogHeight(afCameraHeight, avDir, afDist, avFogSettings, afNoise);
	}
	else if(alType == 3)
	{
		return clamp(FogHeight(afCameraHeight, avDir, afDist, avFogSettings, afNoise) + 
					 FogExponential(afCameraHeight, avDir, afDist, avFogSettings, 0), 0.0, 1.0);
	}

	return 0.0;
}
