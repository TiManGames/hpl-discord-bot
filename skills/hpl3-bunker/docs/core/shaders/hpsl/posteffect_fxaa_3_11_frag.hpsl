/////////////////////
// Fast approximate anti-aliasing, stolen from Nvidia
////////////////////

uniform cTexture2D tex : 0;
uniform cVector2f avInvScreenSize;

@include helper_fxaa.hpsl

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor0 : 0) 
{
	const float kfxaaQualitySubpix = 0.75f;
	const float kfxaaQualityEdgeThreshold = 0.166f;
	const float kfxaaQualityEdgeThresholdMin = 0.0833f;

	cVector4f vColor;
	@ifdef Quality_Low
		vColor = FxaaPixelShaderLow(		px_vTexCoord0.xy,
											tex,
											avInvScreenSize,
											kfxaaQualitySubpix,
											kfxaaQualityEdgeThreshold,
											kfxaaQualityEdgeThresholdMin);
	@elseif Quality_Medium
		vColor = FxaaPixelShaderMedium(		px_vTexCoord0.xy,
											tex,
											avInvScreenSize,
											kfxaaQualitySubpix,
											kfxaaQualityEdgeThreshold,
											kfxaaQualityEdgeThresholdMin);
	@elseif Quality_High
		vColor = FxaaPixelShaderHigh(		px_vTexCoord0.xy,
											tex,
											avInvScreenSize,
											kfxaaQualitySubpix,
											kfxaaQualityEdgeThreshold,
											kfxaaQualityEdgeThresholdMin);
	@elseif Quality_Ultra
		vColor = FxaaPixelShaderUltra(		px_vTexCoord0.xy,
											tex,
											avInvScreenSize,
											kfxaaQualitySubpix,
											kfxaaQualityEdgeThreshold,
											kfxaaQualityEdgeThresholdMin);
	@endif

	out_vColor0 = cVector4f(vColor.rgb, 1.0f);
}