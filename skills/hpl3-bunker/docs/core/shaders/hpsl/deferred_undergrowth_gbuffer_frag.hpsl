////////////////////////////////////////////////////////
// Undergrowth G-Buffer - Fragment Shader
//
//
////////////////////////////////////////////////////////

////////////////////
// Material Textures
uniform cTexture2D aDiffuseMap : 0;

cBuffer cUndergrowthVertexArguments : 0
{
	cMatrixf a_mtxModelViewProjection;
	cMatrixf a_mtxModelView;
	cMatrixf a_mtxNormal;

	float afInvFarPlane;
	float afT;

	cVector2f avDissolveStartSizeDepth; //This is normalized depth!

	cVector3f  avWindProperties;	//x=Freg, y=Amp, z=Speed
	cVector3f  avWindOctavesMul;
	
	cVector4f avForceFieldPos;	//W=T used for the forcefield sway
	cVector4f avForceFieldProp; //x=Fade

	cVector3f avForceFieldPos0;
	cVector3f avForceFieldPos1;
	cVector3f avForceFieldPos2;
	cVector3f avForceFieldPos3;
	
	cVector4f avForceFieldFadeStarts;
	cVector4f avForceFieldFadeLengths;
	cVector4f avForceFieldForces;
	cVector4f avForceFieldTs;
	
	float afForceFieldMaxForce;
	float afCutoffAlpha;
	cVector2f avTextureSubDivisions;
	int alInstanceOffset;
};

//------------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  in cVector3f px_vNormal,
		  in cVector4f px_vColor,
		  in float px_fLinearDepth,
		  out cVector4f out_vDiffuse : 0,			//diffuse rgb, translucency a
		  out cVector4f out_vNormal : 1,			//normal xyz
		  out cVector4f out_vSpecular_RG : 2,		//spec color rgb, spec power a
		  out cVector4f out_vSpecular_B_Pow : 3,	//spec color rgb, spec power a
		  out cVector4f out_vDepth : 4)				//depth x
{
	cVector2f vTexCoord = px_vTexCoord0.xy;
	
	//////////////////////////////////
	//Diffuse and Alpha
	cVector4f vDiffuseColor = sample(aDiffuseMap, vTexCoord);
	
	vDiffuseColor *= px_vColor;
	float fAlpha = vDiffuseColor.w;

	if(fAlpha < afCutoffAlpha) discard;

	out_vDiffuse.xyz = vDiffuseColor.xyz;
	out_vDiffuse.w =0;
	
	//////////////////////////////////
	//Normal
	cVector3f vScreenNormal = normalize(px_vNormal);
	out_vNormal.xyz = vScreenNormal * 0.5 + 0.5;
	
	//////////////////////////////////
	//Depth
	out_vDepth.x = px_fLinearDepth;
	

	//////////////////////////////////
	//Specular
	out_vSpecular_RG = cVector4f(0.0, 0.0, 0.0, 0.0);
	out_vSpecular_B_Pow = cVector4f(0.0, 0.3, 0.0, 0.0);

}	
