////////////////////////////////////////////////////////
// Deferred Base - Control Shader
//
//
////////////////////////////////////////////////////////
	
//---------------------------------------------
	
@include helper_type_arguments.hpsl

uniform cTexture2D aHeightMap : 0;
uniform cTexture2DArray aDiffuseMap : 1;
uniform cTexture2DArray aNormalMap : 2;
uniform cTexture2DArray aSpecularMap : 3;
uniform cTexture2DArray aDetailMap : 4;
uniform cTexture2DArray aBumpMap : 5;

@include helper_terrain.hpsl

///////////////////////////////
// Main program
[domain = triangle]
[spacing = integer]
[ordering = ccw]
void main(in cTessData {
@ifdef UseUv || TesselationShader
			cVector2f vHeightCoord;
@endif
@ifdef TerrainDebug	
			cVector4f vColor;
@endif
			cVector4f vWorldPos;
		} cs[],
		out cTessData {
@ifdef UseUv || TesselationShader
			cVector2f vHeightCoord;
@endif
@ifdef TerrainDebug	
			cVector4f vColor;
@endif
			cVector4f vWorldPos;
		} es[])
{	
	//////////////
	// Transfer data
	@ifdef UseUv || TesselationShader
		es[cs_lInvocationID].vHeightCoord = cs[cs_lInvocationID].vHeightCoord;
	@endif
	@ifdef TerrainDebug	
		es[cs_lInvocationID].vColor = cs[cs_lInvocationID].vColor;
	@endif

	/////////////
	// Copy position and setup tessleation factor
	es[cs_lInvocationID].vWorldPos = cs[cs_lInvocationID].vWorldPos;

}

void control(in cTessData {
@ifdef UseUv || TesselationShader
			cVector2f vHeightCoord;
@endif
@ifdef TerrainDebug	
			cVector4f vColor;
@endif
			cVector4f vWorldPos;
		} cs[])
{
	//////////////
	// Check if there is enough bump to warrent tessellation
	float fBump0 = GetTerrainBump(5, cs[0].vWorldPos.xyz); 
	float fBump1 = GetTerrainBump(5, cs[1].vWorldPos.xyz);
	float fBump2 = GetTerrainBump(5, cs[2].vWorldPos.xyz);
	 
	float fBumpLimit = (0.5f / 255.0f) * afTesselationScale;
	fBumpLimit = fBumpLimit * fBumpLimit;
	   
	//////////////
	// Distance based
	float fFactor0 = (fBump0 * fBump0) > fBumpLimit ? GetTessellationFactor(cs[0].vWorldPos.xyz, avCamera.xyz) : 1.0f;
	float fFactor1 = (fBump1 * fBump1) > fBumpLimit ? GetTessellationFactor(cs[1].vWorldPos.xyz, avCamera.xyz) : 1.0f;
	float fFactor2 = (fBump2 * fBump2) > fBumpLimit ? GetTessellationFactor(cs[2].vWorldPos.xyz, avCamera.xyz) : 1.0f;
                                
    cs_fTessLevelOuter[0] = max(fFactor1, fFactor2);  
    cs_fTessLevelOuter[1] = max(fFactor2, fFactor0);  
    cs_fTessLevelOuter[2] = max(fFactor0, fFactor1);  
    cs_fTessLevelInner[0] = max(fFactor0, max(fFactor1, fFactor2));   
}