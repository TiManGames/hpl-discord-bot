////////////////////////////////////////////////////////
// PostEffect Image Trail - Fragment Shader
//
// Just set up the texture for a dest blend
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;
uniform cTexture2D fadeMap : 1;
uniform cTexture2D colorMap : 2;
uniform cTexture2D offsetMap : 3;

uniform cVector2f avScreenSize;
uniform float afAmount;
uniform float afT;
uniform cVector2f avImageScale;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	cVector2f vScreenPos = px_vTexCoord0.xy;
	cVector3f vScreenColor = sample(diffuseMap, px_vTexCoord0.xy).xyz;
	
	cVector2f vImagePos = cVector2f(vScreenPos.x, 1.0 - vScreenPos.y) * avImageScale;
	cVector3f vFadeColor = sample(fadeMap, vImagePos).xyz;
	
	float fDist = dot(vFadeColor, cVector3f(0.333, 0.333, 0.333));
	float fAlpha = clamp((fDist - (1.0 - afAmount)) * 3.333, 0.0, 1.0);
	
	fAlpha *= 0.7 + sin(afT * 4.0 + fDist * 35.0) * 0.15;
	
	out_vColor.xyz = vScreenColor*(1-fAlpha) + cVector3f(0, 0, 0)*fAlpha;
		
	float test=1.0;
}
