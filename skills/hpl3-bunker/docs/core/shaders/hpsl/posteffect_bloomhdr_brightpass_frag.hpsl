////////////////////////////////////////////////////////
// PostEffect Bloom Blur - Fragment Shader
//
// Blur effect for the bloom post effect
////////////////////////////////////////////////////////

uniform cTexture2D diffuseMap : 0;

uniform float afBrightPass;
uniform cVector2f avInvScreenSize;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor0 : 0)
{
	cVector2f vCoord = px_vTexCoord0.xy;
	cVector4f vDiffuseColor = cVector4f(0, 0, 0, 0);

	for(int x = 0; x < 2; ++x)
	{
		for(int y = 0; y < 2; ++y)
		{
			cVector4f vSample = sample(diffuseMap, vCoord + cVector2f(x, y) * avInvScreenSize);
			vDiffuseColor += max(cVector4f(0, 0, 0, 0), vSample - cVector4f(afBrightPass, afBrightPass, afBrightPass, afBrightPass));
		}
	}

	cVector2f vNormalized = abs(vCoord * cVector2f(2.0, 2.0) - cVector2f(1.0, 1.0));
	float fWeight = 1 - max(vNormalized.x, vNormalized.y);

	float fSum = dot(vDiffuseColor, vDiffuseColor);
	if(isnan(fSum) || isinf(fSum))
		vDiffuseColor = cVector4f(0.0, 0.0, 0.0, 0.0);

	out_vColor0 = max(cVector4f(0.00000001, 0.00000001, 0.00000001, 0.00000001), vDiffuseColor / 4.0 * fWeight * 2.0);

}