////////////////////////////////////////////////////////
// Terrain  - Fragment Shader
//
//
////////////////////////////////////////////////////////

////////////////////
// Material Textures
uniform cTexture2D aDiffuseMap : 0;
uniform cTexture2D aAlphaMap : 1;

//------------------------------------------------

///////////////////////////////
// Main program
void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  in cVector4f px_vColor,
		  out cVector4f out_vColor0 : 0)
{
	//////////////////////////////////
	// Get the texture values
	cVector3f vDiffuse = sample(aDiffuseMap, px_vTexCoord0.xy).aaa;
	float fAlpha = sample(aAlphaMap, px_vTexCoord0.xy).w;
	
	//////////////////////////////////
	// Set final color
	out_vColor0.w = px_vColor.w * fAlpha;
	out_vColor0.xyz = (vDiffuse * px_vColor.yyy) + px_vColor.xxx;
}		