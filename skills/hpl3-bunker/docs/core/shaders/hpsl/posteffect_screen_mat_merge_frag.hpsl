////////////////////////////////////////////////////////
// PostEffect Fear Tentacles
// Multiplies source with dest
////////////////////////////////////////////////////////

uniform cTexture2D scene : 0;
uniform cTexture2D refraction : 1;

void main(in cVector4f px_vPosition,
          in cVector4f px_vTexCoord0,
          out cVector4f out_vColor : 0)
{
    cVector2f vUV = px_vTexCoord0.xy;
    cVector4f vRefraction = sampleLod(refraction, vUV, 0) * 0.125;
		
    ///////////
    // Apply refraction to UV
    vUV += vRefraction.xy;

    cVector4f vScene = sample(scene, vUV);
	
    ///////////
    // Mul together
    out_vColor = vScene;

}