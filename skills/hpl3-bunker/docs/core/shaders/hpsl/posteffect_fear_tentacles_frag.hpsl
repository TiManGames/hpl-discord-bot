////////////////////////////////////////////////////////
// PostEffect Fear Tentacles
// Multiplies source with dest
////////////////////////////////////////////////////////

uniform cTexture2D aTexA : 0;
uniform cTexture2D aTexB : 1;

uniform float afIntensity;
uniform float afAlpha;
uniform float afMaterialAlpha;

void main(in cVector4f px_vPosition,
          in cVector4f px_vTexCoord0,
          out cVector4f out_vColor : 0)
{
    cVector4f vColor = sample(aTexA, px_vTexCoord0.xy);
	if(afMaterialAlpha > 1e-5f) 
		vColor = mix(vColor, sample(aTexB, px_vTexCoord0.xy), afMaterialAlpha);

    out_vColor = mix(cVector4f(0.5, 0.5, 0.5, 0), vColor, vColor.a * afIntensity * afAlpha);
}