////////////////////////////////////////////////////////
// Null shader, bound when no other shader is bound - Pixel shader
////////////////////////////////////////////////////////


uniform cTexture2D aColorMap : 0;
uniform cVector2f avAlphaLimit;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vColor,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor0 : 0)
{
	cVector4f vColor = px_vColor * sample(aColorMap, px_vTexCoord0.xy);

	if(vColor.a <= avAlphaLimit.x) discard; 

	vColor.a = clamp((vColor.a - avAlphaLimit.x) / (avAlphaLimit.y - avAlphaLimit.x), 0.0, 1.0);

	@ifdef Additive
		vColor.rgb *= vColor.a;
	@elseif Modulative
		vColor.rgb = mix(cVector3f(1.0, 1.0, 1.0), vColor.rgb, vColor.a);
	@endif

	out_vColor0 = vColor;
}