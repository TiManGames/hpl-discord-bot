////////////////////////////////////////////////////////
// Deferred Depth unpack - Fragment Shader
//
// Unpacks the depth map of the gbuffer into the red channel.
////////////////////////////////////////////////////////

//---------------------------------------------------------

uniform cTexture2D depthTexture : 0;

void main(in cVector4f px_vPosition,
		  in cVector4f px_vTexCoord0,
		  out cVector4f out_vColor : 0)
{
	@ifdef UseUnpackNormal	
		out_vColor = sample(depthTexture, px_vTexCoord0.xy).wxyz;
		out_vColor.yzw = normalize(out_vColor.yzw);
	@elseif UseMaxDepthDownsample
		out_vColor   = max(sample(depthTexture, px_vTexCoord0.xy).xxxx,
					   max(sample(depthTexture, px_vTexCoord0.xy, cVector2l(1.0, 0.0)).xxxx,
					   max(sample(depthTexture, px_vTexCoord0.xy, cVector2l(0.0, 1.0)).xxxx,
					   	   sample(depthTexture, px_vTexCoord0.xy, cVector2l(1.0, 1.0)).xxxx)));						
	@else
		out_vColor = sample(depthTexture, px_vTexCoord0.xy).xxxx;
	@endif
}

