////////////////////////////////////////////////////////
// PostEffect screen mat
// Multiplies source with dest
////////////////////////////////////////////////////////

uniform cTexture2D tex : 0;

@ifdef Refraction
	@include helper_normal_packing.hpsl
@endif

#define eMaterialBlendMode_None 0
#define eMaterialBlendMode_Add 1
#define eMaterialBlendMode_Mul 2
#define eMaterialBlendMode_MulX2 3
#define eMaterialBlendMode_Alpha 4
#define eMaterialBlendMode_PremulAlpha 5

void main(in cVector4f px_vPosition,
          in cVector4f px_vTexCoord0,
		  in cVector4f px_vColor,
          out cVector4f out_vColor : 0)
{
    cVector4f vColor = sample(tex, px_vTexCoord0.xy);

	@ifdef Refraction
		//////////////
		// Apply scale to refraction and add
		cVector3f vNMapNormal = UnpackNormalmapYW(vColor); 
		out_vColor = cVector4f(vNMapNormal * px_vColor.a, 1.0);
	@else
		///////////
		// Apply alpha blending
		int lMode = int(px_vColor.r); //Store blend mode in r
		
		if(lMode == eMaterialBlendMode_Add)
		{
			vColor.xyz *= px_vColor.a * vColor.a;
			vColor.xyz *= 8.0;
		}
		else if(lMode == eMaterialBlendMode_Mul)
		{
			vColor.xyz = mix(cVector3f(1.0, 1.0, 1.0), vColor.xyz, px_vColor.a * vColor.a);
		}
		else if(lMode == eMaterialBlendMode_MulX2)
		{
			float fBlendMulAlpha = px_vColor.a * vColor.a;
			vColor.xyz = vColor.xyz*fBlendMulAlpha + cVector3f(0.5, 0.5, 0.5)*(1-min(fBlendMulAlpha, 1.0));
		}
		else if(lMode == eMaterialBlendMode_Alpha)
		{
			vColor.a *= px_vColor.a;
			vColor.xyz *= 8.0;
		}
		else if(lMode == eMaterialBlendMode_PremulAlpha)
		{
			vColor *= px_vColor.a;
			vColor.xyz *= 8.0;
		}
	
		/////////////
		// Output
		out_vColor = vColor;
	@endif

}