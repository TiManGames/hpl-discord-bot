	//-------------------------------------------------------
 
	/*Put any variables that are used in more than one scene here.*/
	
	bool mbSetup = true;	
	bool mbPlayerPushingTunnelRock = false;
	tString msCurrentMapPreset = "Inside";
	
	//-------------------------------------------------------
 
	/*Put any functions that are used in more than one scene here.*/
	
	//-------------------------------------------------------
	
	void SetupAimAssistTargets()
	{
		for (int i = 0; i < mvBreakableBridges.size(); ++i)
		{
			tString sBridge = mvBreakableBridges[i];
			Player_AddAimAssistTarget(Entity_GetID(sBridge), "", "", cVector3f(0.f, 0.25f, 0.f), 1.f, 18.f, -1.f, false, false, 1);
		}
	}
	
	//-------------------------------------------------------
	
	void SetupDefaultPresetFog()
	{
		Map_Preset_SetupFog("Inside", true, gfEnding_DefaultFogStart, gfEnding_DefaultFogEnd, 1, cColor(0.047,0.057,0.054,1), 1.f, false, false, false);
	}
	
	//-------------------------------------------------------
	
	void SetLightningActive(bool abX)
	{
		Map_RemoveTimer("Timer_StopLightning");
		Map_RemoveTimer("Timer_DoLightning");
			
		if (abX)
		{
			Map_AddTimer("Timer_DoLightning", cMath_RandRectf(0.5f, 1.f), "OnTimer_DoLightning");	
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_DoLightning(const tString &in asTimer)
	{
		msCurrentMapPreset = "Lightning";
		
		Map_Preset_Fade("Lightning", 0.2f);
		
		cColor color = cColor(0.746,1,0.949,0);
		if (mbStalkerFell)
			color = color * 1.2f;
		
		Light_FadeTo("lightning_flash_*", color, cMath_RandRectf(107.f, 112.f), cMath_RandRectf(0.08f, 1.12f));
		Light_SetFlickerActive("lightning_flash_*", true);			
		
		float fTime = mbStalkerEmerging ? 2.f : cMath_RandRectf(0.75f, 1.25f);
		Map_AddTimer("Timer_StopLightning", fTime, "OnTimer_StopLightning");
		Sound_Play("Sound_Lightning", 0.0f);
	}
		
	//-------------------------------------------------------
		
	void OnTimer_StopLightning(const tString &in asTimer)
	{
		msCurrentMapPreset = "Inside";
		
		Map_Preset_Fade("Inside", 1.f);
		
		Light_FadeTo("lightning_flash_*", cColor(0,0,0,1), cMath_RandRectf(107.f, 112.f), cMath_RandRectf(0.95f, 1.05f));
		Light_SetFlickerActive("lightning_flash_*", false);
		
		float fTime = mbStalkerEmerging ? 1.f : cMath_RandRectf(4.f, 7.f);
		if (mbStalkerFell)
			fTime = cMath_RandRectf(2.f, 4.f);
		
		Map_AddTimer("Timer_DoLightning", fTime, "OnTimer_DoLightning");
	}
	
	//-------------------------------------------------------
	
	void OnPlayerBulletHit(const tString &in asEntity, const cVector3f &in avHitPos)
	{
		if (BulletHandler_GetLastDamageBulletType() == eBulletType_Shotgun)
		{
			Map_AddTimer("Timer_PlayerUsedWeapon", 2.f, "");
		}
	}
	
	//-------------------------------------------------------
	
	void OnExplosion(const tString&in asEntity)
	{
		Map_AddTimer("Timer_PlayerUsedWeapon", 2.f, "");
	}
	
	//-------------------------------------------------------
	
	void OnAddDamageArea(const tString &in asDamageArea)
	{		
		iLuxEntity@ pDamageArea = Map_GetEntity(asDamageArea, eLuxEntityType_Prop);
		cBoundingVolume@ pDamageBounds = pDamageArea !is null ? pDamageArea.GetMainBody().GetBoundingVolume() : null;
		
		if (pDamageArea is null) return;
		if (pDamageBounds is null) return;
		
		////////////////
		// Iterate bridge triggers
		for (int i = 0; i < mvBridgeTriggerIds.size(); ++i)
		{
			iLuxEntity@ pTrigger = cLux_ID_Area(mvBridgeTriggerIds[i]);
			cBoundingVolume@ pTriggerBounds = pTrigger !is null ? pTrigger.GetMainBody().GetBoundingVolume() : null;
			
			if (pTrigger is null) continue;
			if (pTriggerBounds is null) continue;
			
			////////////////
			// Remove pathfinding edges if damage area intersects bridge			
			if (cMath_CheckAABBIntersection(pDamageBounds.GetMin(), pDamageBounds.GetMax(), pTriggerBounds.GetMin(), pTriggerBounds.GetMax()))
			{
				tString sTrigger = pTrigger.GetName();
				tString sNodeA = cString_Sub(sTrigger, 15, 1);
				tString sNodeB = cString_Sub(sTrigger, 16, 1);
				
				AddPathBlocker(pDamageArea, sNodeA, sNodeB, -1.f);
				
				////////////////
				// Allow slowdown
				SetAllowSlowdownTime(60.f);
				break;
			}
		}		
	}
	
	//-------------------------------------------------------
	
	void OnRemoveDamageArea(const tString &in asDamageArea)
	{
		iLuxEntity@ pDamageArea = Map_GetEntity(asDamageArea, eLuxEntityType_Prop);		
		RemovePathBlocker(pDamageArea);
	}
	
	//-------------------------------------------------------
	
	void VariableUpdate(float afDeltaTime)
	{		
		////////////////////
		// Stalker build up
		UpdateStalkerBuildUp(afDeltaTime);
		
		////////////////////
		// Player climb ledge
		UpdatePlayerClimbLedge(afDeltaTime);
		
		////////////////////
		// Sync lights	
		iLight@ pLightningLightA = cLux_ID_Light(m_idLightningLightA);
		iLight@ pLightningLightB = cLux_ID_Light(m_idLightningLightB);
		iLight@ pEntranceLight = cLux_ID_Light(m_idEntranceLight);
		iLight@ pStalkerEmergeLight = cLux_ID_Light(m_idStalkerEmergeLight);
		cColor lightningColor = pLightningLightA !is null ? pLightningLightA.GetDiffuseColor() : cColor_White;
		
		if (pLightningLightA !is null && 
		    pLightningLightB !is null && 
			pStalkerEmergeLight !is null &&
			pEntranceLight !is null &&
			lightningColor.a > 0.f)
		{
			pEntranceLight.SetDiffuseColor(lightningColor);
			pStalkerEmergeLight.SetDiffuseColor(lightningColor);
		}
		
		////////////////////
		// Shadow death
		if (mlShadowDeathStage >= 0)
		{
			cBillboard@ pBillboard = mBaseObj.GetWorld().GetBillboard("Billboard_ShadowDeath");
			if (pBillboard is null) return;
			
			float fShadowDeathSpeedGoal = mfShadowDeathT >= 0.75f ? 4.f : 1.f;
			mfShadowDeathSpeed = cMath_IncreaseTo(mfShadowDeathSpeed, afDeltaTime, fShadowDeathSpeedGoal);			
			mfShadowDeathT = cMath_IncreaseTo(mfShadowDeathT, afDeltaTime * 0.12f * mfShadowDeathSpeed, 1.f);
			float fT = cMath_Easing(eEasing_ExpoIn, cMath_Clamp((mfShadowDeathT - 0.1f) / (1.f - 0.1f), 0.f, 1.f));
			
			if (mlShadowDeathStage == 0 && mfShadowDeathT >= 0.1f)
			{
				mlShadowDeathStage = 1;		
				
				Effect_Shake_Start(0.1f, 20.f, 10.f, 1.f);			
				Sound_PlayGui("DW_tunnel/level/shadow_roar", 1.f, eSoundEntryType_Gui);
				
				Player_SetScared(10.f);
			}
			else if (mlShadowDeathStage == 1 && mfShadowDeathT >= 0.4f)
			{
				mlShadowDeathStage = 2;
				Effect_Blur_Start(0.5f, 5.f);						
			}
			else if (mlShadowDeathStage == 2 && mfShadowDeathT >= 0.78f)
			{
				mlShadowDeathStage = 3;
				Effect_Fade_Out(0.1f);
				Sound_PlayGui("player/foley/damage/player_shadow_hit", 1.f, eSoundEntryType_Gui);
				Sound_FadeGlobalVolume(0.f, 0.1f, eSoundEntryType_World);
			}
			else if (mlShadowDeathStage == 3 && mfShadowDeathT >= 1.f)
			{
				mlShadowDeathStage = -1;
				SequenceStates_Resume("Seq_FallInToRift");
			}
			
			cVector2f vSizeStart(0.f);
			cVector2f vSizeGoal(170.f);
			cVector2f vNewSize = vSizeStart * (1.f - fT) + vSizeGoal * fT;
			pBillboard.SetSize(vNewSize);
			
			cVector3f vPos = cLux_GetPlayer().GetCharacterBody().GetPosition() - cVector3f(11.25f, 0.f, 0.f);
			vPos.y = pBillboard.GetWorldPosition().y;
			pBillboard.SetPosition(vPos);
		}
	}
	
	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		////////////////////
		// Move player forward when pushing end rock
		if (mbPlayerPushingTunnelRock)
		{			
			iCharacterBody@ pCharBody = cLux_GetPlayer().GetCharacterBody();
			if (pCharBody !is null)
			{
				if (pCharBody.GetMoveSpeed(eCharDir_Forward) < 0.001f)
					pCharBody.AddForceVelocity(cVector3f(0.f, 0.f, 10.f) * afTimeStep);
				
				pCharBody.Move(eCharDir_Forward, 0.15f);					
				Push_SimulateMovement(cVector3f(0.f, 0.15f, 0.f));
			}
		}
	}
	 
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// PLATFORMS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
		
	array<tString> mvDrawbridges;
	array<tString> mvUnbreakableBridges;
	array<cBridgeData> mvBridgeData;
	array<int> mvDestroyedBridgeDataIds;
	array<tID> mvBridgeBlockerEntIds;
	array<tID> mvBridgeBlockerEntsToUpdate;
	array<tID> mvBridgeBlockerEntsToSkipUpdate;
	array<tString> mvHighCostBridgeEdges;
	array<tString> mvMedCostBridgeEdges;
	array<tString> mvMaxCostBridgeEdges;
	array<tID> mvBridgeTriggerIds;
	array<cBridgePathBlockerData> mvPathBlockers;
	array<tString> mvRampDownBridges = { "Bridge_EZ_2", "Bridge_FZ_2", "Bridge_HZ_2", "Bridge_AD_1", "Bridge_AC_1", "Bridge_AB_1" };
	array<tString> mvRampUpBridges = { "Bridge_AB_2", "Bridge_AC_2", "Bridge_AD_2", "Bridge_HZ_1", "Bridge_EZ_1", "Bridge_FZ_1" };
	
	cPlatformPathfinder mPlayerPathfinder;
	cPlatformPathfinder mStalkerPathfinder;
	cPlatformPathfinder mMapPathfinder;
	
	//-------------------------------------------------------
	
	void GenerateArena()
	{		
		/////////////////
		// Generate stuff
		if (gbEnding_GenerateArena)
		{
			mvDrawbridges.resize(0);
			mvUnbreakableBridges.resize(0);
			
			/////////////////
			// Get path from start to goal	
			array<cPlatformNode@> vPath = mMapPathfinder.GetPlatformNodePath("A", "Z");
			
			/////////////////
			// Get path drawbridge count
			int lMaxDrawBridges = 5;
			int lBridgeCount = vPath.size() - 1;
			int lWantedPathDrawbridges = cMath_Min(cMath_RandRectl(1, (lBridgeCount / 2) + 1), lMaxDrawBridges);
			
			array<int> vPathDrawbridgeIndices(lBridgeCount);
			
			for (int i = 0; i < vPathDrawbridgeIndices.size(); ++i)
			{
				vPathDrawbridgeIndices[i] = i + 1;
			}
				
			while (vPathDrawbridgeIndices.size() > lWantedPathDrawbridges)
			{
				vPathDrawbridgeIndices.removeAt(cMath_RandRectl(0, vPathDrawbridgeIndices.size() - 1));
			}
			
			/////////////////
			// Create path bridges
			for (int i = 0; i < vPath.size(); ++i)
			{
				cPlatformNode@ pNode = vPath[i];
				cPlatformNodeHistory@ pHistory = mMapPathfinder.GetPlatformNodeHistory(pNode.msName);
					
				if (pHistory.msPrev == "") continue;
													
				array<iLuxEntity@> vBridge = GetBridgeFromPlatformNodes(pHistory.msPrev, pHistory.msName);	
				
				if (vPathDrawbridgeIndices.find(i) != -1)
				{
					CreateDrawbridge(vBridge[0], vBridge[1]);
				}
				else
				{
					for (int j = 0; j < vBridge.size(); ++j)
					{								
						CreateUnbreakableBridge(vBridge[j]);
					}		
				}
			}
			
			/////////////////
			// Get every node that doesn't have an unbreakable bridge
			tString sBridgeBase = "Bridge_";
			tString sBridgeEnd = "_1";			
			array<tString> vNodesWithNoUnbreakableBridge;
			
			for (int i = 0; i < mMapPathfinder.mvPlatformNodeGraph.size(); ++i)
			{
				bool bHasUnbreakableBridge = false;
				
				cPlatformNode@ pNode = mMapPathfinder.mvPlatformNodeGraph[i];
				
				for (int j = 0; j < pNode.mvNeighbours.size(); ++j)
				{
					tString sNeighbour = pNode.mvNeighbours[j];
					tString sBridgeA = sBridgeBase + pNode.msName + sNeighbour + sBridgeEnd;
					tString sBridgeB = sBridgeBase + sNeighbour + pNode.msName + sBridgeEnd;
					
					if (mvDrawbridges.find(sBridgeA) != -1 ||
						mvDrawbridges.find(sBridgeB) != -1 ||
						mvUnbreakableBridges.find(sBridgeA) != -1 ||
						mvUnbreakableBridges.find(sBridgeB) != -1)
					{
						bHasUnbreakableBridge = true;
						break;
					}
				}
				
				if (bHasUnbreakableBridge == false)
				{
					vNodesWithNoUnbreakableBridge.push_back(pNode.msName);
				}
			}
			
			/////////////////
			// Create unbreakable bridges at every node
			// (Except for one!)
			int lIsolatedNodeId = cMath_RandRectl(0, vNodesWithNoUnbreakableBridge.size() - 1);
			tString sIsolatedNode = vNodesWithNoUnbreakableBridge[lIsolatedNodeId];
			
			vNodesWithNoUnbreakableBridge.removeAt(lIsolatedNodeId);
			
			while (vNodesWithNoUnbreakableBridge.size() > 0)
			{
				cPlatformNode@ pNode = mMapPathfinder.GetPlatformNode(vNodesWithNoUnbreakableBridge[0]);
				
				/////////////////
				// Get random neighbour
				// (That's not the isolated node)	
				bool bFoundNeighbour = false;
				tString sNeighbour = "";
				array<int> vNeighourIndices(pNode.mvNeighbours.size());
				
				for (int i = 0; i < vNeighourIndices.size(); ++i)
				{
					vNeighourIndices[i] = i;
				}
				
				while (vNeighourIndices.size() > 0)
				{
					int lNeighbourId = cMath_RandRectl(0, vNeighourIndices.size() - 1);
					sNeighbour = pNode.mvNeighbours[lNeighbourId];
					
					vNeighourIndices.removeAt(lNeighbourId);
					
					if (sNeighbour != sIsolatedNode)
					{
						bFoundNeighbour = true;
						break;
					}						
				}
				
				if (bFoundNeighbour == false)
					continue;
				
				/////////////////
				// Create bridge to neighbour
				array<iLuxEntity@> vBridge = GetBridgeFromPlatformNodes(pNode.msName, sNeighbour);					
				
				bool bDrawbridge = mvDrawbridges.size() < lMaxDrawBridges && cMath_RandRectl(0, 2) == 2;	
				if (bDrawbridge)
				{
					CreateDrawbridge(vBridge[0], vBridge[1]);
				}
				else
				{
					for (int i = 0; i < vBridge.size(); ++i)
					{
						CreateUnbreakableBridge(vBridge[i]);
					}
				}

				/////////////////
				// Remove nodes at new bridge from selection
				int lRemoveNodeCount = 0;
				for (int i = 0; i < vNodesWithNoUnbreakableBridge.size(); ++i)
				{
					tString sNodeRemoveCandidate = vNodesWithNoUnbreakableBridge[i];
					if (sNodeRemoveCandidate == pNode.msName ||
						sNodeRemoveCandidate == sNeighbour)
					{
						vNodesWithNoUnbreakableBridge.removeAt(i);
						--i;
						
						++lRemoveNodeCount;
						if (lRemoveNodeCount == 2)
							break;
					}						
				}
			}	
			
			/////////////////
			// Some drawbridges should be up
			int lOpenDrawbridgeCount = 0;
			int lMaxOpenDrawbridges = cMath_RandRectl(0, mvDrawbridges.size());
			
			for (int i = 0; i < mvDrawbridges.size(); ++i)
			{
				if (lOpenDrawbridgeCount >= lMaxOpenDrawbridges) break;
				if (cMath_RandRectl(0, 1) != 1) continue;
				
				///////////////
				// Skip bridges that can block the view of stalker's emerge
				tString sBridge = mvDrawbridges[i];
				tString sId = cString_Sub(sBridge, 7, 2);
				
				if (sId == "CF" ||
					sId == "EF" ||
					sId == "BC" ||
					sId == "FG" ||
					sId == "FZ")
				{
					continue;
				}
				
				///////////////
				// Open drawbridge!
				++lOpenDrawbridgeCount;				
				
				int lSuffix = cString_GetNumericSuffixInt(sBridge);			
				tString sWheel = "Wheel_" + sId + "_" + lSuffix;
				
				Wheel_SetAngle(sWheel, 90.f, true);
			}
			
			///////////////////////
			// Reset costs
			mMapPathfinder.GeneratePlatformNodeEdgeCosts(false);
		}
		
		///////////////////////
		// Set up bridge walls
		array<iLuxEntity@> vBridgeWalls;
		Map_GetEntityArray("Bridge_Wall_*", vBridgeWalls, eLuxEntityType_Prop);
		
		for (int i = 0; i < vBridgeWalls.size(); ++i)
		{
			iLuxEntity@ pEnt = vBridgeWalls[i];
			if (pEnt is null) continue;
			
			pEnt.SetActive(true); // Inactive until now, so the paths can build properly
			
			tString sBridge = pEnt.GetName();
			tString sId = cString_Sub(sBridge, 12, 2);
			tString sBridgeToFind = "Bridge_" + sId + "_1";
			
			if (mvDrawbridges.find(sBridgeToFind) != -1) continue;
			if (mvUnbreakableBridges.find(sBridgeToFind) != -1) continue;
			
			BulletHandler_AddGlobalIgnoredEntity(pEnt.GetID());
			WoodenBreakable_SetIsBreakable(pEnt.GetName(), false);
		}
		
		///////////////////////
		// Set up bridges
		{
			array<iLuxEntity@> vBridges;
			Map_GetEntityArray("Bridge_*", vBridges, eLuxEntityType_Prop);
			
			for (int i = 0; i < vBridges.size(); ++i)
			{
				iLuxEntity@ pEnt = vBridges[i];
				tString sName = pEnt !is null ? pEnt.GetName() : "";
				
				if (pEnt is null) continue;
				
				///////////////////////
				// Skip if wall
				bool bSkip = false;
				for (int j = 0; j < vBridgeWalls.size(); ++j)
				{
					if (pEnt is vBridgeWalls[j])
					{
						bSkip = true;
						break;
					}
				}
				
				if (bSkip) continue;
				
				///////////////////////
				// Calculate base pos
				cVector3f vBridgePos = pEnt.GetPosition();
				cVector3f vJointPos = pEnt.GetMainBody().GetJoint(0).GetPivotPoint();
				cVector3f vToJointPos = vJointPos - vBridgePos;
				cVector3f vBridgeDir = pEnt.GetMatrix().GetTranspose().GetForward() * -1.f;
				cVector3f vToBridgeStart = cMath_Vector3Project(vToJointPos, vBridgeDir);
				cVector3f vBridgeStart = vBridgePos + vToBridgeStart;
				cVector3f vBridgeEnd = vBridgePos + vToBridgeStart * -1.f;
				
				///////////////////////
				// Get id and platform
				tString sId = cString_Sub(sName, 7, 2);
				int lSuffix = cString_GetNumericSuffixInt(sName);
				tString sPlatform = cString_Sub(sId, lSuffix - 1, 1);
				
				///////////////////////
				// Store data
				cBridgeData data;
				data.msName = sName;
				data.msId = sId;
				data.msPlatform = sPlatform;
				data.mvStartPos = vBridgeStart;
				data.mvEndPos = vBridgeEnd;
				mvBridgeData.push_back(data);
				
				/////////////////////
				// Create path blockers		
				cMatrixf mtxOnLoad = pEnt.GetOnLoadTransform();
				cMatrixf mtxPathBlockerA = cMath_MatrixMul(cMath_MatrixTranslate(vBridgeDir * 1.5f), mtxOnLoad);
				cMatrixf mtxPathBlockerB = cMath_MatrixMul(cMath_MatrixTranslate(vBridgeDir * 4.5f), mtxOnLoad);
				mtxPathBlockerA = cMath_MatrixMul(cMath_MatrixTranslate(cVector3f(0.f, 1.f, 0.f)), mtxPathBlockerA);
				mtxPathBlockerB = cMath_MatrixMul(cMath_MatrixTranslate(cVector3f(0.f, 1.f, 0.f)), mtxPathBlockerB);
				
				tString sBlockerA = "BridgeBlocker_" + sId + "_" + lSuffix + "_A";
				tString sBlockerB = "BridgeBlocker_" + sId + "_" + lSuffix + "_B";
				
				mBaseObj.CreateEntity(sBlockerA, "path_area_blocker.ent", mtxPathBlockerA, cVector3f(3.f, 1.75f, 3.f));
				iLuxEntity@ pBlockerA = mBaseObj.GetLatestEntity();
				mBaseObj.CreateEntity(sBlockerB, "path_area_blocker.ent", mtxPathBlockerB, cVector3f(3.f, 1.75f, 3.f));
				iLuxEntity@ pBlockerB = mBaseObj.GetLatestEntity();
				
				if (pBlockerA !is null && pBlockerB !is null)
				{
					pBlockerA.SetActive(false);
					pBlockerB.SetActive(false);
					
					tID idBlockerA = pBlockerA.GetID();
					tID idBlockerB = pBlockerB.GetID();
					
					if (mvBridgeBlockerEntIds.find(idBlockerA) == -1)
						mvBridgeBlockerEntIds.push_back(idBlockerA);
					if (mvBridgeBlockerEntIds.find(idBlockerB) == -1)
						mvBridgeBlockerEntIds.push_back(idBlockerB);
						
					Stalker_AddIgnoredPathBlockerBody("Stalker_1", pBlockerA.GetMainBody().GetID());
					Stalker_AddIgnoredPathBlockerBody("Stalker_1", pBlockerB.GetMainBody().GetID());
				}
				
				///////////////////////
				// Stalker's obstacle system should ignore the bridge bodies
				Stalker_AddIgnoredPathBlockerBody("Stalker_1", pEnt.GetMainBody().GetID());
				
				///////////////////////
				// Get on start break bridge candidates
				if (mvDrawbridges.find(sName) != -1) 			continue;
				if (mvUnbreakableBridges.find(sName) != -1) 	continue;
				
				if (mvBreakableBridges.find(sName) == -1)
					mvBreakableBridges.push_back(sName);
				
				if (cString_GetFirstStringPos(sId, "A") == -1 &&
					cString_GetFirstStringPos(sId, "B") == -1 &&
					cString_GetFirstStringPos(sId, "C") == -1 &&
					cString_GetFirstStringPos(sId, "D") == -1) 
				{
					continue;
				}
				
				if (mvOnEnterBreakBridges.find(sName) == -1)
					mvOnEnterBreakBridges.push_back(sName);
			}
		}
	}
	
	//-------------------------------------------------------
	
	void OnTimer_SetupCurrentPlatforms(const tString &in asTimer)
	{	
		cLuxAgent@ pStalker = cLux_ToAgent(mBaseObj.GetEntityByName("Stalker_1", eLuxEntityType_Agent));			
		cVector3f vPlayerPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
		
		mPlayerPathfinder.msCurrentNode = GetClosestPlatformToPoint(vPlayerPos);
		mStalkerPathfinder.msCurrentNode = pStalker !is null ? GetClosestPlatformToPoint(pStalker.GetPosition()) : "Z";
	}
	
	//-------------------------------------------------------
	
	tString GetClosestPlatformToPoint(const cVector3f &in avPoint)
	{
		tString sClosest = "";
		float fMinDistSqr = 10000.f * 10000.f;
		
		for (int i = 0; i < mMapPathfinder.mvPlatformNodeGraph.length(); ++i)
		{
			tString sNode = mMapPathfinder.mvPlatformNodeGraph[i].msName;
			cVector3f vPos = GetPlatformNodePosition(sNode);	
			
			float fDistSqr = (avPoint - vPos).SqrLength();
			if (fDistSqr < fMinDistSqr)
			{
				fMinDistSqr = fDistSqr;
				sClosest = sNode;
			}
		}
				
		return sClosest;
	}
	
	//-------------------------------------------------------
	
	cVector3f GetPlatformNodePosition(const tString &in asNode)
	{
		tString sArea = "Area_Node_" + asNode;
		iLuxEntity@ pEnt = Map_GetEntity(sArea, eLuxEntityType_Area);
				
		return pEnt !is null ? pEnt.GetPosition() : cVector3f(0.f);
	}
	
	//-------------------------------------------------------
	
	array<iLuxEntity@>@ GetBridgeFromPlatformNodes(const tString &in asNodeA, const tString &in asNodeB)
	{		
		array<iLuxEntity@> vBridge;
		
		tString sBridgeBase = "Bridge_";
		tString sBridgeId = asNodeA + asNodeB;
		tString sBridgeSuffix = "_*";
		tString sBridge = sBridgeBase + sBridgeId + sBridgeSuffix;
		
		Map_GetEntityArray(sBridge, vBridge, eLuxEntityType_Prop);
		
		if (vBridge.size() == 0)
		{
			sBridgeId = asNodeB + asNodeA;
			sBridge = sBridgeBase + sBridgeId + sBridgeSuffix;
			
			Map_GetEntityArray(sBridge, vBridge, eLuxEntityType_Prop);
		}
		
		return vBridge;
	}
	
	//-------------------------------------------------------
	
	cLuxProp@ CreateUnbreakableBridge(iLuxEntity@ apBridge, bool abIsDrawbridge = false)
	{
		if (apBridge is null) return null;
		
		////////////////////////
		// Setup vars
		tString sName = apBridge.GetName();
		tString sId = cString_Sub(sName, 7, 2);
		tString sSuffix = cString_GetNumericSuffix(sName);
		tString sBridgeWall = "Bridge_Wall_" + sId + "_" + sSuffix;
		
		iLuxEntity@ pBridgeWall = mBaseObj.GetEntityByName(sBridgeWall, eLuxEntityType_Prop);
		if (pBridgeWall is null) return null;
		
		uint lBridgeCollideFlag = apBridge.GetMainBody().GetCollideFlags();
		cMatrixf mtxBridge = apBridge.GetOnLoadTransform();
		cVector3f vBridgeScale = apBridge.GetOnLoadScale();
		
		uint lBridgeWallCollideFlag = pBridgeWall.GetMainBody().GetCollideFlags();
		cMatrixf mtxBridgeWall = pBridgeWall.GetOnLoadTransform();
		cVector3f vBridgeWallScale = pBridgeWall.GetOnLoadScale();
		
		////////////////////////
		// Destroy breakable bridge
		mBaseObj.DestroyEntity(apBridge);
		mBaseObj.DestroyEntity(pBridgeWall);
		
		////////////////////////
		// Create unbreakable version
		tString sDrawbridgeEnt = "darkworld_drawbridge_01.ent";		
		if (mvRampDownBridges.find(sName) != -1)		sDrawbridgeEnt = "darkworld_drawbridge_rampdown.ent";
		else if (mvRampUpBridges.find(sName) != -1)		sDrawbridgeEnt = "darkworld_drawbridge_rampup.ent";
		
		mBaseObj.CreateEntity(sName, sDrawbridgeEnt, mtxBridge, vBridgeScale);
		cLuxProp@ pNewBridge = cLux_ToProp(mBaseObj.GetLatestEntity());
		
		mBaseObj.CreateEntity(sBridgeWall, "darkworld_drawbridge_01_sidewalls.ent", mtxBridgeWall, vBridgeWallScale);
		cLuxProp@ pNewBridgeWall = cLux_ToProp(mBaseObj.GetLatestEntity());
		
		for (int i = 0; i < pNewBridge.GetBodyNum(); ++i)
			pNewBridge.GetBody(i).SetCollideFlags(lBridgeCollideFlag);
			
		for (int i = 0; i < pNewBridgeWall.GetBodyNum(); ++i)
			pNewBridgeWall.GetBody(i).SetCollideFlags(lBridgeWallCollideFlag);
			
		pNewBridge.SetDisableBreakable(true);
		pNewBridgeWall.SetDisableBreakable(true);
		
		pNewBridgeWall.AttachToEntity(pNewBridge, pNewBridge.GetMainBody(), true, false, true);
		
		////////////////////////
		// Store as unbreakable bridge?
		if (abIsDrawbridge == false)
		{
			mvUnbreakableBridges.push_back(sName);	
		}
		
		return pNewBridge;
	}
	
	//-------------------------------------------------------
	
	void CreateDrawbridge(iLuxEntity@ apBridgeA, iLuxEntity@ apBridgeB)
	{
		if (apBridgeA is null) return;
		if (apBridgeB is null) return;
		
		//////////////////
		// Create bridge
		cLuxProp@ pBridgeA = CreateUnbreakableBridge(apBridgeA, true);
		cLuxProp@ pBridgeB = CreateUnbreakableBridge(apBridgeB, true);		
		cLuxProp@ pWheelA = CreateBridgeWheel(pBridgeA, pBridgeB);
		cLuxProp@ pWheelB = CreateBridgeWheel(pBridgeB, pBridgeA);
		
		//////////////////
		// Setup wheels
		pWheelA.AddInteractConnection(pWheelB.GetName(), pWheelB, false, eEasing_Linear);
		pWheelB.AddInteractConnection(pWheelA.GetName(), pWheelA, false, eEasing_Linear);

		//////////////////
		// Keep track of them
		mvDrawbridges.push_back(pBridgeA.GetName());
		mvDrawbridges.push_back(pBridgeB.GetName());
	}
	
	//-------------------------------------------------------
	
	cLuxProp@ CreateBridgeWheel(cLuxProp@ apBridgeA, cLuxProp@ apBridgeB)
	{
		if (apBridgeA is null) return null;
		if (apBridgeB is null) return null;
		
		//////////////////
		// Setup vars
		tString sBridge = apBridgeA.GetName();		
		int lSuffix = cString_GetNumericSuffixInt(sBridge);			
		tString sId = cString_Sub(sBridge, 7, 2);
		tString sWheel = "Wheel_" + sId + "_" + lSuffix;
		
		//////////////////
		// Create wheel
		cMatrixf mtxBridge = apBridgeA.GetOnLoadTransform();
		cVector3f vBridgeDir = cMath_Vector3Normalize(mtxBridge.GetTranspose().GetForward());
		
		cVector3f vFwd = vBridgeDir * -1.f;
		vFwd.y = 0.f;
		vFwd.Normalize();
		
		cVector3f vRight = cMath_Vector3Normalize(cMath_Vector3Cross(vFwd, cVector3f_Down));
		cVector3f vWheelPos = mtxBridge.GetTranslation() + vBridgeDir * 0.1f + vRight * -1.5f + cVector3f(0.f, 1.4f, 0.f);		
		cMatrixf mtxWheel = cMath_MatrixUnitVectors(vRight, cVector3f_Up, vFwd, vWheelPos);
		
		mBaseObj.CreateEntity(sWheel, "mechanism_wheel.ent", mtxWheel, cVector3f(0.875f));
		
		//////////////////
		// Setup wheel
		cLuxProp@ pWheel = cLux_ToProp(mBaseObj.GetLatestEntity());
		if (pWheel !is null)
		{
			Wheel_SetMinLimit(sWheel, 0.f);
			Wheel_SetMaxLimit(sWheel, 90.f);
			Wheel_SetAutoRotateMul(sWheel, 2.f);
			Wheel_SetAngle(sWheel, 0.f, false);
			
			pWheel.AddInteractConnection(apBridgeA.GetName(), apBridgeA, false, eEasing_Linear);
			pWheel.AddInteractConnection(apBridgeB.GetName(), apBridgeB, false, eEasing_Linear);		

			pWheel.SetConnectionStateChangeCallback("OnConnectionStateChange_Wheel");
			pWheel.SetPlayerInteractCallback("OnInteract_Wheel", false);
			
			uint lWheelCollideFlag = mBaseObj.GetCollideFlag("-bridge");
			for (int i = 0; i < pWheel.GetBodyNum(); ++i)
				pWheel.GetBody(i).SetCollideFlags(lWheelCollideFlag);
		}
		
		//////////////////
		// Create pedastal
		cMatrixf mtxPedastal = mtxWheel;
		cVector3f vPedastalPos = mtxPedastal.GetTranslation() + vFwd * 0.125f - cVector3f(0.f, 1.31f, 0.f);		
		mtxPedastal = cMath_MatrixMul(cMath_MatrixRotateY(cMath_Pi), mtxPedastal);
		mtxPedastal.SetTranslation(vPedastalPos);

		if (sId == "HZ")
		{
			Entity_SetActive("Statue_HZ", false);
		}
		
		mBaseObj.CreateEntity("Pedastal_" + sWheel, "mechanism_wheel_pedastal.ent", mtxPedastal, cVector3f(1.15f));
		
		return pWheel;
	}
	 
	//-------------------------------------------------------
 
	//} END PLATFORMS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// EVENTS
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
		
		/////////////////////////////////////////
		// Event *Enter the tunnels*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbDoStalkerBuildUp = false;
		int mlStalkerBuildUpPositionIndex = 0;
		float mfStalkerBuildUpSpeed = 4.f;
		cVector3f mvStalkerBuildUpPos(0.f);
		array<cVector3f> mvStalkerBuildUpPositions;
		tID m_idStalkerBuildUpPS = tID_Invalid;
		tID m_idStalkerBuildUpSound = tID_Invalid;
		
		//-------------------------------------------------------
		
		bool OnTrigger_CartCollide(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 && Map_TimeHasPassed("Timer_CrateFeedback", 0.5f))
			{
				Sound_CreateAtEntity("Sound_CrateBlocked", "physics/wood/wood_trap_door/trap_door_impact", asParent);
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_StartStalkerBuildUp(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbDoStalkerBuildUp = true;
			mvStalkerBuildUpPos = mvStalkerBuildUpPositions[0];
			
			Music_StopAll(3.f);
			return false;
		}
		
		//-------------------------------------------------------
		
		void UpdateStalkerBuildUp(float afDeltaTime)
		{
			if (mbDoStalkerBuildUp == false) return;
			
			/////////////////
			// Move
			bool bAtEnd = false;
			float fDistToNext = 0.f;
			
			if (mvStalkerBuildUpPositions.size() > 0)
			{
				if (mlStalkerBuildUpPositionIndex > 0)
					mfStalkerBuildUpSpeed = cMath_IncreaseTo(mfStalkerBuildUpSpeed, afDeltaTime, 10.f);
				
				cVector3f vDir = (mvStalkerBuildUpPositions[mlStalkerBuildUpPositionIndex] - mvStalkerBuildUpPos);		
				fDistToNext = vDir.Length();
				vDir.Normalize();
				
				float fFrameMove = cMath_Clamp(mfStalkerBuildUpSpeed * afDeltaTime, 0.f, fDistToNext);
				mvStalkerBuildUpPos += vDir * fFrameMove;
				
				/////////////////
				// At goal?
				if (fFrameMove <= 0.001f)
				{
					if (mlStalkerBuildUpPositionIndex == 1)
					{
						Sound_CreateAtEntity("Sound_StalkerBuildUp", "creatures/stalker/tunnel_bark", "Area_StalkerBuildUpSound");
						
						cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_BuildUpStart", "sand_falling_stream_small_oneshot_instant.ps", "Area_StalkerBuildUpParticles", false);
						if (pPS !is null)
							pPS.SetColor(cColor(0.376,0.325,0.251,1));
					}
					
					if (mlStalkerBuildUpPositionIndex < int(mvStalkerBuildUpPositions.size()) - 1)
					{
						++mlStalkerBuildUpPositionIndex;
					}
					else
					{
						bAtEnd = true;
					}
				}
			}
			
			//////////////////
			// Particles
			cParticleSystem@ pPS = cLux_ID_ParticleSystem(m_idStalkerBuildUpPS);
			if (pPS is null)
			{
				@pPS = mBaseObj.GetWorld().CreateParticleSystem("PS_StalkerCeilingDust", "ghoul_ceiling_dust.ps", 1.f, true, false);
				m_idStalkerBuildUpPS = pPS.GetID();
			}
			
			if (pPS !is null)
			{
				float fRayDist;
				cVector3f vRayNrm;			
				iPhysicsBody@ pHitBody = cLux_GetClosestBody(mvStalkerBuildUpPos, cVector3f_Up, 10.f, fRayDist, vRayNrm);
				
				cVector3f vParticlePos = mvStalkerBuildUpPos + cVector3f_Up * fRayDist;
				pPS.SetWorldPosition(vParticlePos);
			}
			
			/////////////////
			// Sound				
			cSoundEntity@ pSound = cLux_ID_SoundEntity(m_idStalkerBuildUpSound);
			if (pSound is null)
			{
				@pSound = mBaseObj.GetWorld().CreateSoundEntity("Sound_StalkerCeilingMove", "creatures/stalker/tunnel", true);
				m_idStalkerBuildUpSound = pSound.GetID();
			}
			
			if (pSound !is null)
			{
				pSound.SetWorldPosition(mvStalkerBuildUpPos);
			}
				
			//////////////////
			// At end?
			if (bAtEnd)
			{
				mbDoStalkerBuildUp = false;
				
				pPS.Kill();
				pSound.FadeOut(1.f);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_PlayMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			Music_Play("Bunker_Arena_Reveal.ogg", 0.4f, false, eMusicPrio_MinorEvent);
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Event *Enter the area*
		
		/////////////////////////////////////////
		// Event *Enter the area*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbAllowDoubleImpact = false;
		bool mbInteseImpacts = false;
		int mlDebrisRockId = 0;
		array<tString> mvOnEnterBreakBridges;
		array<tString> mvBreakableBridges;
		array<tID> mvCeilingDebrisAreaIds;
		array<tID> mvInteractableDebrisRockIds;

		//-------------------------------------------------------
		
		bool OnTrigger_Player_EnableRiftEffects(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1)
			{
				SetLightningActive(true);
				Light_SetBrightness("Light_EntranceFlash", 1.f);
			}
			else
			{
				if (Entity_PlayerIsInFront(asParent) == false)
				{
					SetLightningActive(false);
					Light_SetBrightness("Light_EntranceFlash", 0.f);
				}
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_BreakFirstBridge(const tString &in asParent, const tString &in asChild, int alState)
		{
			SetLightningActive(false);
			SetLightningActive(true);
			
			//////////////////
			// Get best bridge to break
			tString sBridge = "";
			cVector3f vCamPos = Player_GetCameraPosition();
			float fMinDistSqr = 100.f * 100.f;
			
			for (int i = 0; i < mvOnEnterBreakBridges.size(); ++i)
			{
				iLuxEntity@ pBridge = Map_GetEntity(mvOnEnterBreakBridges[i], eLuxEntityType_Prop);
				
				if (pBridge is null) continue;
				if (cLux_CheckLineOfSight(vCamPos, pBridge.GetPosition() + cVector3f_Up * 4.f, false, false) == false)
					continue;
				
				float fDistSqr = (pBridge.GetPosition() - vCamPos).SqrLength();
				if (fDistSqr < fMinDistSqr)
				{
					fMinDistSqr = fDistSqr;
					sBridge = pBridge.GetName();
				}
			}
			
			if (sBridge == "") return false;
			
			//////////////////
			// Spawn the rock that breaks it
			Entity_PlaceAtEntity("BreakBridgeRock_1", sBridge, cVector3f(0.f, 30.f, 0.f), true);
			Map_AddTimer(sBridge, 1.f, "OnTimer_SpawnFirstRock");
			
			ParticleSystem_CreateAtEntity("PS_Debris", "debris_falling_arena_large.ps", "BreakBridgeRock_1", false);
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_FirstRockDust", "dust_impact_large_oneshot.ps", "BreakBridgeRock_1", false);
			if (pPS !is null)
				pPS.SetColor(cColor(0.512,0.366,0.27,0.208));
			
			int lId = Effect_Shake_Start(0.03f, 1.f, 0.5f, 0.5f);
			Effect_Rumble_Start(0.35f, 2.f, 0.5f, 0.5f);
			
			Sound_CreateAtEntity("Sound_CeilingBreak", "DW_tunnel/bomb/war_bomb", "BreakBridgeRock_1", 0.f, false, 1.f, 15.f, 70.f);
			
			//////////////////
			// Start random impacts		
			Map_AddTimer("Timer_DoImpact", cMath_RandRectf(7.f, 10.f), "OnTimer_DoImpact");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SpawnFirstRock(const tString &in asTimer)
		{
			Entity_SetActive("BreakBridgeRock_1", true);
			Entity_AddImpulse("BreakBridgeRock_1", cVector3f(0.f, -12.f, 0.f), false, false);
			Entity_AddTorque("BreakBridgeRock_1", cVector3f(500.f, 0.f, 300.f), true, true);
			Prop_SetDisableBreakable("BreakBridgeRock_1", true);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_EnterEncounterSpace(const tString &in asParent, const tString &in asChild, int alState)
		{
			Entity_SetActive("BlockBox_Start_*", true);
			Light_FadeBrightnessTo("Light_EntranceFlash", 0.f, 5.f);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoImpact(const tString &in asTimer)
		{
			//////////////////////
			// Get a few random areas
			array<tString> vAreas;
			int lMaxAreas = 10;
			
			cVector3f vCamPos = Player_GetCameraPosition();	
			cVector3f vFwd = cLux_GetPlayer().GetCamera().GetForward();
			vFwd.y = 0.f;
			vFwd.Normalize();
			
			for (int i = 0; i < mvCeilingDebrisAreaIds.size(); ++i)
			{
				cLuxArea@ pArea = cLux_ID_Area(mvCeilingDebrisAreaIds[i]);
				if (pArea is null) continue;
					
				cVector3f vDelta = pArea.GetPosition() - vCamPos;				
				vDelta.y = 0.f;
					
				float fDistSqr = vDelta.SqrLength();
				if (mbInteseImpacts && fDistSqr > 25.f * 25.f)
					continue;
			
				float fDot = cMath_Vector3Dot(vFwd, vDelta);					
				if (fDot >= 0.f)
				{
					vAreas.push_back(pArea.GetName());
					
					if (vAreas.size() > lMaxAreas)
						break;
				}
			}
			
			if (vAreas.size() == 0 && mvCeilingDebrisAreaIds.size() > 0)
			{
				int lRandId = cMath_RandRectl(0, mvCeilingDebrisAreaIds.size() - 1);
				iLuxEntity@ pArea = cLux_ID_Area(mvCeilingDebrisAreaIds[lRandId]);
				if (pArea !is null)
					vAreas.push_back(pArea.GetName());
			}
			
			if (vAreas.size() == 0) return;
			
			//////////////////////
			// Do impact effects
			tString sArea = vAreas[cMath_RandRectl(0, vAreas.size() - 1)];
			iLuxEntity@ pArea = Map_GetEntity(sArea, eLuxEntityType_Area);
			
			if (pArea !is null)
			{
				cLuxProp@ pRock = SpawnRock(pArea.GetPosition(), mbInteseImpacts, "scatter_rock04_shatter.ent", mbInteseImpacts);
				if (pRock !is null)
				{
					tString sEffectEntity = mbInteseImpacts ? pRock.GetName() : sArea;
					DoImpactEffects(sEffectEntity);
				}
				else
				{
					DoImpactEffects(sArea);
				}
			}
			
			//////////////////////
			// Setup next impact
			float fTime = mbStalkerFell ? cMath_RandRectf(6.f, 10.f) : cMath_RandRectf(10.f, 17.f);
			if (mbAllowDoubleImpact && 
				mbStalkerFell == false && 
				cMath_RandRectl(0, 2) == 2)
			{
				fTime = cMath_RandRectf(3.75f, 4.f);
				mbAllowDoubleImpact = false;
			}
			else
			{
				mbAllowDoubleImpact = true;
			}
			
			if (asTimer != "NoRepeat")
				Map_AddTimer("Timer_DoImpact", fTime, "OnTimer_DoImpact");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StartQuake(const tString &in asTimer)
		{
			mbStalkerFell = true;
			
			if (Player_GetPosition().z < -8.f)
			{
				Map_AddTimer("Timer_StartQuake", 1.f, "OnTimer_StartQuake");
				return;
			}
			
			SetLightningActive(true);
	
			Map_AddTimer("Timer_DoImpact", 5.f, "OnTimer_DoImpact");
			Map_AddTimer("Timer_DoQuakeEffects", 1.f, "OnTimer_DoQuakeEffects");
			Map_AddTimer("Timer_AllowEndWallBreak", 3.f, "OnTimer_AllowEndWallBreak");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_AllowEndWallBreak(const tString &in asTimer)
		{
			Entity_SetActive("Trigger_TriggerBreakEndWall", true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoQuakeEffects(const tString &in asTimer)
		{
			//////////////////
			// Break bridges
			array<iLuxEntity@> vBridges;
			cVector3f vPlayerPos = Player_GetPosition();
			
			float fMaxDistSqr = 1000.f * 1000.f;
			for (int i = 0; i < mvBreakableBridges.size(); ++i)
			{
				iLuxEntity@ pBridge = Map_GetEntity(mvBreakableBridges[i], eLuxEntityType_Prop, "");
				if (pBridge is null) continue;
					
				float fDistSqr = (pBridge.GetPosition() - vPlayerPos).SqrLength();
				if (fDistSqr > 25.f * 25.f)
				{
					vBridges.push_back(pBridge);
				}
			}
			
			if (vBridges.size() > 0 && vPlayerPos.z < 28.f)
			{
				iLuxEntity@ pBridge = vBridges[cMath_RandRectl(0, vBridges.size() - 1)];
				if (pBridge !is null)
				{
					cLuxProp@ pRock = SpawnRock(pBridge.GetPosition() + cVector3f(0.f, 30.f, 0.f), true, "scatter_rock04.ent", false);
					
					if (pRock !is null)
						DoImpactEffects(pRock.GetName());
				}
			}
			else
			{
				if (vPlayerPos.z >= 28.f)
					mbInteseImpacts = true;
				
				OnTimer_DoImpact("NoRepeat");
			}
			
			//////////////////
			// Restart timer	
			Map_AddTimer("Timer_DoQuakeEffects", cMath_RandRectf(5.f, 7.f), "OnTimer_DoQuakeEffects");
		}
		
		//-------------------------------------------------------
		
		cLuxProp@ SpawnRock(const cVector3f &in avPos, bool abSkipGroundCheck, const tString &in asRockEnt, bool abInteractable)
		{
			float fDist;
			cVector3f vNrm;			
			
			if (abSkipGroundCheck || 
				cLux_GetClosestBody(avPos, cVector3f_Down, 50.f, fDist, vNrm) is null)
			{				
				++mlDebrisRockId;
				tString sRock = "DebrisRock_" + mlDebrisRockId;

				cVector3f vPos = avPos;
				if (abInteractable)
				{
					cVector3f vOffset = cMath_RandomSphereSurfacePoint(cMath_RandRectf(0.f, 6.f));
					vOffset.y = 0.f;
					vPos += vOffset;
				}
				
				cMatrixf mtxRock = cMath_MatrixTranslate(vPos);				
				cVector3f vScale = abInteractable ? cVector3f(1.f) : cVector3f(2.f);
				mBaseObj.CreateEntity(sRock, asRockEnt, mtxRock, vScale);
						
				cLuxProp@ pProp = cLux_ToProp(mBaseObj.GetLatestEntity());
				if (pProp !is null)
				{
					pProp.SetDisableBreakable(true);
					
					if (abInteractable == false)
						pProp.SetInteractionDisabled(true);
							
					for (int i = 0; i < pProp.GetBodyNum(); ++i)
					{
						iPhysicsBody@ pBody = pProp.GetBody(i);
						if (pBody is null) continue;
								
						pBody.AddImpulse(cVector3f(0.f, cMath_RandRectf(-2.f, -17.f), 0.f));
						pBody.AddTorque(cMath_RandomSphereSurfacePoint(500.f));
					}							
					
					if (abInteractable)
					{
						mvInteractableDebrisRockIds.push_back(pProp.GetID());
						if (mvInteractableDebrisRockIds.size() > 20)
						{
							cLuxProp@ pPropToDestroy = cLux_ID_Prop(mvInteractableDebrisRockIds[0]);
							
							if (pPropToDestroy !is null)
							{
								mBaseObj.DestroyEntity(pPropToDestroy);
								mvInteractableDebrisRockIds.removeAt(0);
							}
						}
					}
				}
				
				if (abInteractable == false)
					Map_AddTimer(sRock, 12.f, "OnTimer_DisableRock");
				
				return pProp;
			}
			
			return null;
		}
		
		//-------------------------------------------------------
		
		void DoImpactEffects(const tString &in asEntity)
		{		
			ParticleSystem_CreateAtEntity("PS_Debris_" + asEntity, "debris_falling_arena_large.ps", asEntity, false);
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_FirstRockDust", "dust_impact_large_oneshot.ps", "BreakBridgeRock_1", false);
			if (pPS !is null)
				pPS.SetColor(cColor(0.512,0.366,0.27,0.208));
				
			int lId = Effect_Shake_Start(0.05f, 1.f, 0.5f, 0.5f);
			Effect_Shake_SetSourceEntity(lId, asEntity, 10.f, 80.f);
			Effect_Rumble_Start(0.35f, 2.f, 0.5f, 0.5f);
			
			Sound_CreateAtEntity("Sound_Impact", "DW_tunnel/bomb/war_bomb", asEntity, 0.f, false, 1.f, 20.f, 80.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableRock(const tString &in asTimer)
		{
			iLuxEntity@ pRock = Map_GetEntity(asTimer, eLuxEntityType_Prop);
			if (pRock !is null)
			{
				mBaseObj.DestroyEntity(pRock);
			}
		}
		
		//-------------------------------------------------------

		//} END Event *Enter the area*
		
		/////////////////////////////////////////
		// Event *Encounter the STALKER on the BRIDGES*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbStalkerEmerging = false;
		bool mbStalkerRetreating = false;
		bool mbPlayerClimbAnimActive = false;
		bool mbStalkerFell = false;
		float mfPlayerClimbAnimAngle = 0.f;
		tString msPlayerClimbAnimHeldItemL = "";
		tString msPlayerClimbAnimHeldItemR = "";
		tID m_idLightningLightA = tID_Invalid;
		tID m_idLightningLightB = tID_Invalid;
		tID m_idStalkerEmergeLight = tID_Invalid;
		tID m_idEntranceLight = tID_Invalid;
		tID m_idStalker = tID_Invalid;
		array<tString> mvBlockedBridgeIds;
		
		//-------------------------------------------------------
		
		void OnStalkerMoveTo(int alBehaviour, const cVector3f &in avGoalPos)
		{
			UpdateStalkerBehaviour(alBehaviour, avGoalPos);
		}
		
		//-------------------------------------------------------
			
