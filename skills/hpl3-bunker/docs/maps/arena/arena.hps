const float gfEnding_DefaultFogStart = 1.f;
const float gfEnding_DefaultFogEnd = 40.f;
const float gfEnding_LightningFogStart = 20.f;
const float gfEnding_LightningFogEnd = 200.f;
const float gfEnding_PlatformNodeEdgeCostMed = 5.f;
const float gfEnding_PlatformNodeEdgeCostHigh = 10.f;
const float gfEnding_PlatformNodeEdgeCostMax = 10.f;
const float gfEnding_PlatformNodeEdgeCostDefault = 1.f;
const float gfEnding_JumpToBridgeMinDistToPlayer = 12.5f;

const bool gbEnding_GenerateArena = true;

const tString gsEnding_PlayerClimbLedgeAnim = "player_climb_ledge";

//TODO: set these up
const tString gsCreditsExitBunkerBg = "";
const tString gsCreditsExitBunkerWithStalkerBg = "";
const tString gsCreditsMusic = "Bunker_EndCredits.ogg";

