		{
			Light_FadeBrightnessTo("Light_StalkerFlash", 0.f, 1.f);
		}
		
		//-------------------------------------------------------
		
		void UpdatePlayerClimbLedge(float afDeltaTime)
		{			
			///////////////////////
			// Setup vars
			array<int> vBridgeIdsToCheck;
			cLuxPlayer@ pPlayer = cLux_GetPlayer();
			iCharacterBody@ pCharBody = pPlayer !is null ? pPlayer.GetCharacterBody() : null;
			cCamera@ pCam = pPlayer !is null ? pPlayer.GetCamera() : null;
			cPlatformNode@ pNode = mPlayerPathfinder.GetPlatformNode(mPlayerPathfinder.msCurrentNode);
			cLuxAgent@ pStalker = cLux_ID_Agent(m_idStalker);
			cAnimationState@ pAnim = PlayerBody_GetAnimationState(gsEnding_PlayerClimbLedgeAnim);

			if (pPlayer is null) return;
			if (pCharBody is null) return;
			if (pCam is null) return;
			if (pNode is null) return;
			if (pStalker is null) return;
			if (pCharBody.IsOnGround()) return;
			
			///////////////////////
			// Climbing anim active?
			if (mbPlayerClimbAnimActive)
			{
				if (pAnim is null || pAnim.IsOver())
					mbPlayerClimbAnimActive = false;
				
				return;
			}
			
			///////////////////////
			// In cutscene?
			if (pPlayer.GetCurrentStateId() == ePlayerState_CutsceneAnimation) return;
			
			///////////////////////
			// Get broken bridges to check
			for (int i = 0; i < pNode.mvNeighbours.size(); ++i)
			{
				tString sNodeA = pNode.msName;
				tString sNodeB = pNode.mvNeighbours[i];
				
				for (int j = 0; j < mvDestroyedBridgeDataIds.size(); ++j)
				{
					cBridgeData@ pData = mvBridgeData[mvDestroyedBridgeDataIds[j]];
					if (pData is null) continue;
					
					if (pData.msId == sNodeA + sNodeB ||
						pData.msId == sNodeB + sNodeA)
					{
						vBridgeIdsToCheck.push_back(mvDestroyedBridgeDataIds[j]);
					}
				}
			}
			
			///////////////////////
			// Get closest ledge data
			float fMinDistSqr = 1000.f * 1000.f;
			cVector3f vLedgePos(0.f);
			cVector3f vLedgeDir(0.f);
			cVector3f vPlayerPos = pCharBody.GetPosition();
			
			for (int i = 0; i < vBridgeIdsToCheck.size(); ++i)
			{
				cBridgeData@ pData = mvBridgeData[vBridgeIdsToCheck[i]];
				if (pData is null) continue;
				
				float fDistSqrA = (vPlayerPos - pData.mvStartPos).SqrLength();
				float fDistSqrB = (vPlayerPos - pData.mvEndPos).SqrLength();
				
				if (fDistSqrA < fDistSqrB && fDistSqrA < fMinDistSqr)
				{
					fMinDistSqr = fDistSqrA;
					vLedgePos = pData.mvStartPos;
					vLedgeDir = cMath_Vector3Normalize(pData.mvStartPos - pData.mvEndPos);
				}
				else if (fDistSqrB < fDistSqrA && fDistSqrB < fMinDistSqr)
				{
					fMinDistSqr = fDistSqrB;
					vLedgePos = pData.mvEndPos;
					vLedgeDir = cMath_Vector3Normalize(pData.mvEndPos - pData.mvStartPos);
				}
			}
			
			vLedgePos += vLedgeDir * 0.7f + cVector3f(0.f, 0.15f, 0.f);
			
			///////////////////////
			// Play anim if close enough and in front
			cVector3f vToLedge = vLedgePos - pCam.GetPosition();
			bool bInFront = cMath_Vector3Dot(pCam.GetForward(), cMath_Vector3Normalize(vToLedge)) > 0.f;
			
			if (bInFront &&
				vToLedge.SqrLength() < 1.7f * 1.7f &&
				pCharBody.GetFeetPosition().y < vLedgePos.y - 1.f)
			{
				mbPlayerClimbAnimActive = true;
				
				msPlayerClimbAnimHeldItemL = Item_GetHeldType(eItemHandlerHand_Left);
				msPlayerClimbAnimHeldItemR = Item_GetHeldType(eItemHandlerHand_Right);
				
				mfPlayerClimbAnimAngle = -cMath_ATan2(vLedgeDir.x, -vLedgeDir.z);
				
				PlayerBody_PlayCutsceneAnimation(gsEnding_PlayerClimbLedgeAnim, false, 0.2f, "OnAnimEnd_ClimbLedge", 1.f, 0.f, true, vLedgePos, mfPlayerClimbAnimAngle);
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_ClimbLedge(const tString &in asAnim)
		{
			Item_TakeOut(ItemType_GetFirstInInventory(msPlayerClimbAnimHeldItemL));
			Item_TakeOut(ItemType_GetFirstInInventory(msPlayerClimbAnimHeldItemR));
		}
		
		//-------------------------------------------------------
		
		void OnBreak_Bridge(const tString &in asEntity)
		{
			/////////////////////
			// Setup vars
			int lSuffix = cString_GetNumericSuffixInt(asEntity);			
			tString sBridgeId = cString_Sub(asEntity, 7, 2);
			tString sBridgeA = "Bridge_" + sBridgeId + "_1";
			tString sBridgeB = "Bridge_" + sBridgeId + "_2";
			tString sBridgeWall = "Bridge_Wall_" + sBridgeId + "_" + lSuffix;
			tString sBlockerA = "BridgeBlocker_" + sBridgeId + "_" + lSuffix + "_A";
			tString sBlockerB = "BridgeBlocker_" + sBridgeId + "_" + lSuffix + "_B";
			tString sArea = "Trigger_Bridge_" + sBridgeId + "_" + lSuffix;
			
			iLuxEntity@ pBridgeA = Map_GetEntity(sBridgeA, eLuxEntityType_Prop);
			iLuxEntity@ pBridgeB = Map_GetEntity(sBridgeB, eLuxEntityType_Prop);
			iLuxEntity@ pBridge = lSuffix == 1 ? pBridgeA : pBridgeB;
			iLuxEntity@ pOtherBridge  = lSuffix == 1 ? pBridgeB : pBridgeA;
			iLuxEntity@ pBlockerA = Map_GetEntity(sBlockerA, eLuxEntityType_Prop);
			iLuxEntity@ pBlockerB = Map_GetEntity(sBlockerB, eLuxEntityType_Prop);
			cLuxAgent@ pAgent = cLux_ToAgent(Map_GetEntity("Stalker_1", eLuxEntityType_Agent));
			
			tString sNodeA = cString_Sub(sBridgeId, 0, 1);
			tString sNodeB = cString_Sub(sBridgeId, 1, 1);	
			
			if (pBridge is null) return;
			if (pAgent is null) return;
			if (pBlockerA is null) return;
			if (pBlockerB is null) return;
			
			/////////////////////
			// Keep track of destroyed bridges
			int lDestroyedBridgeId = -1;
			for (int i = 0; i < mvBridgeData.size(); ++i)
			{
				cBridgeData@ pData = mvBridgeData[i];
				if (pData is null) continue;
				if (pData.msName != asEntity) continue;
				
				lDestroyedBridgeId = i;
				break;
			}
			
			if (mvDestroyedBridgeDataIds.find(lDestroyedBridgeId) == -1)
				mvDestroyedBridgeDataIds.push_back(lDestroyedBridgeId);
				
			int lBreakableBridgeId = mvBreakableBridges.find(asEntity);
			if (lBreakableBridgeId != -1)
				mvBreakableBridges.removeAt(lBreakableBridgeId);
				
			Map_AddTimer("BridgeBroke_" + sBridgeId, 1.f, "");
			
			/////////////////////
			// Deactivate walls
			WoodenBreakable_SetIsBreakable(sBridgeWall, true);
			Prop_SetHealth(sBridgeWall, 0.f);
			
			////////////////////
			// Enable blockers
			pBlockerA.SetActive(true);
			pBlockerB.SetActive(true);
			
			////////////////////
			// Jump?
			Map_RemoveTimer(sArea);
			DoStalkerJump(sBridgeId, lSuffix, true);
			
			/////////////////////
			// Update pathfinders
			{				
				/////////////////////
				// Both bridge parts gone!
				if (pOtherBridge is null)
				{
					tString sEdgeA = sNodeA + sNodeB;
					tString sEdgeB = sNodeB + sNodeA;
					cPlatformNodeEdge@ pEdgeA = mStalkerPathfinder.GetPlatformNodeEdge(sEdgeA);
					cPlatformNodeEdge@ pEdgeB = mStalkerPathfinder.GetPlatformNodeEdge(sEdgeB);
					
					if (pEdgeA !is null)
						pEdgeA.mfCost = gfEnding_PlatformNodeEdgeCostMax;
					if (pEdgeB !is null)
						pEdgeB.mfCost = gfEnding_PlatformNodeEdgeCostMax;
						
					if (mvMaxCostBridgeEdges.find(sEdgeA) == -1)
						mvMaxCostBridgeEdges.push_back(sEdgeA);
					if (mvMaxCostBridgeEdges.find(sEdgeB) == -1)
						mvMaxCostBridgeEdges.push_back(sEdgeB);
						
					for (int i = 0; i < mvMedCostBridgeEdges.size(); ++i)
					{
						tString sEdge = mvMedCostBridgeEdges[i];
						if (sEdge == sEdgeA || sEdge == sEdgeB)
						{
							mvMedCostBridgeEdges.removeAt(i);
							--i;
						}
					}
					
					for (int i = 0; i < mvHighCostBridgeEdges.size(); ++i)
					{
						tString sEdge = mvHighCostBridgeEdges[i];
						if (sEdge == sEdgeA || sEdge == sEdgeB)
						{
							mvHighCostBridgeEdges.removeAt(i);
							--i;
						}
					}
					
					/////////////////
					// Update player pathfinder					
					mPlayerPathfinder.RemovePlatformNodeEdge(sNodeA, sNodeB);
					mPlayerPathfinder.RemovePlatformNodeEdge(sNodeB, sNodeA);
				}
				
				/////////////////////
				// Part of the bridge remains!
				else
				{
					/////////////////////
					// Get bridge platform
					tString sBridgePlatform = "";				
					for (int i = 0; i < mvBridgeData.size(); ++i)
					{
						cBridgeData@ pData = mvBridgeData[i];
						if (pData.msName == pBridge.GetName())
						{
							sBridgePlatform = pData.msPlatform;
							break;
						}			
					}
					
					/////////////////////
					// Increase costs for using bridge
					// (Especially when jumping to the remaining bridge)
					tString sMedCostEdge = "";
					tString sHighCostEdge = "";	
				
					if (sBridgePlatform == sNodeA) 
					{
						sHighCostEdge = sNodeA + sNodeB;
						sMedCostEdge = sNodeB + sNodeA;
					}
					else if (sBridgePlatform == sNodeB)
					{
						sHighCostEdge = sNodeB + sNodeA;
						sMedCostEdge = sNodeA + sNodeB;
					}
					
					cPlatformNodeEdge@ pMedCostEdge = mStalkerPathfinder.GetPlatformNodeEdge(sMedCostEdge);
					cPlatformNodeEdge@ pHighCostEdge = mStalkerPathfinder.GetPlatformNodeEdge(sHighCostEdge);
							
					if (pMedCostEdge !is null)
						pMedCostEdge.mfCost = gfEnding_PlatformNodeEdgeCostMed;
					if (pHighCostEdge !is null)
						pHighCostEdge.mfCost = gfEnding_PlatformNodeEdgeCostHigh;
					
					if (mvMedCostBridgeEdges.find(sMedCostEdge) == -1)
						mvMedCostBridgeEdges.push_back(sMedCostEdge);
					if (mvHighCostBridgeEdges.find(sHighCostEdge) == -1)
						mvHighCostBridgeEdges.push_back(sHighCostEdge);
				}
			}
			
			////////////////
			// Allow slowdown?
			if (Map_TimerExists("Timer_PlayerUsedWeapon"))
			{
				SetAllowSlowdownTime(60.f);
			}			
			
			/////////////////////
			// Update blockers
			UpdateBridgePathBlockers(0.1f);
		}
		
		//-------------------------------------------------------
		
		void UpdateBridgeEdgeCost(const array<tString> &in avBridgeEdgeCosts, float afMaxCost)
		{
			cVector3f vPlayerPos = Player_GetPosition();
			array<tID> vBridgePathBlockersToUpdate;
			
			/////////////////////
			// Iterate edge costs
			for (int i = 0; i < avBridgeEdgeCosts.size(); ++i)
			{
				tString sEdge = avBridgeEdgeCosts[i];
				tString sNodeA = cString_Sub(sEdge, 0, 1);
				tString sNodeB = cString_Sub(sEdge, 1, 1);
				
				tString sId = "";
				tString sSuffix = "";
				tString sTimer = "Timer_UpdatedBrokenBridgeEdgeCost_" + sEdge;
				cVector3f vPosA = cVector3f(0.f);
				cVector3f vPosB = cVector3f(0.f);
				
				cPlatformNodeEdge@ pEdge = mStalkerPathfinder.GetPlatformNodeEdge(sEdge);
				if (pEdge is null) continue;
				
				for (int j = 0; j < mvDestroyedBridgeDataIds.size(); ++j)
				{
					cBridgeData@ pData = mvBridgeData[mvDestroyedBridgeDataIds[j]];
					if (pData is null) continue;
					
					if (pData.msId == (sNodeA + sNodeB) ||
						pData.msId == (sNodeB + sNodeA))
					{
						sId = pData.msId;
						vPosA = pData.mvStartPos;
						vPosB = pData.mvEndPos;
						sSuffix = cString_GetNumericSuffixInt(pData.msName);
						break;
					}					
				}
				
				/////////////////////
				// Increase costs if player is close!
				float fDistA = (vPlayerPos - vPosA).SqrLength();
				float fDistB = (vPlayerPos - vPosB).SqrLength();
				float fMinDist = cMath_Min(fDistA, fDistB);				
				float fPrevCost = pEdge.mfCost;
				
				if (fMinDist < gfEnding_JumpToBridgeMinDistToPlayer * gfEnding_JumpToBridgeMinDistToPlayer)
				{
					pEdge.mfCost = afMaxCost;
					
					/////////////////////
					// Cost updated? Update blockers!
					if (pEdge.mfCost != fPrevCost)
					{
						tString sBlockerA = "BridgeBlocker_" + sId + "_" + sSuffix + "_A";
						tString sBlockerB = "BridgeBlocker_" + sId + "_" + sSuffix + "_B";						
						iLuxEntity@ pBlockerA = Map_GetProp(sBlockerA);
						iLuxEntity@ pBlockerB = Map_GetProp(sBlockerB);
						
						if (pBlockerA !is null && pBlockerB !is null)
						{
							array<tID> vBlockers = { pBlockerA.GetID(), pBlockerB.GetID() };
							ActivateBridgePathBlockers(vBlockers);
							
							Map_AddTimer(sTimer, 10.f, "");
						}
					}
				}
				else
				{
					if (Map_TimerExists(sTimer) == false)
						pEdge.mfCost = gfEnding_PlatformNodeEdgeCostDefault;
				}
			}
		}
		
		//-------------------------------------------------------
		
		void AddPathBlocker(iLuxEntity@ apEnt, const tString &in asNodeA, const tString &in asNodeB, float afEdgeCost)
		{
			if (apEnt is null) return;
			
			///////////////////
			// Add data
			for (int i = 0; i < mvPathBlockers.size(); ++i)
			{
				cBridgePathBlockerData@ pData = mvPathBlockers[i];
				if (pData.m_idBlockerEnt == apEnt.GetID())
					return;
			}
			
			cBridgePathBlockerData data;
			data.mfEdgeCost = afEdgeCost;
			data.msNodeA = asNodeA;
			data.msNodeB = asNodeB;
			data.m_idBlockerEnt = apEnt.GetID();					
			mvPathBlockers.push_back(data);
						
			///////////////////
			// Remove edges?
			if (afEdgeCost < 0.f)
			{
				mStalkerPathfinder.RemovePlatformNodeEdge(asNodeA, asNodeB);
				mStalkerPathfinder.RemovePlatformNodeEdge(asNodeB, asNodeA);
				
				tString sEdgeA = asNodeA + asNodeB;
				tString sEdgeB = asNodeB + asNodeA;
				if (mvBlockedBridgeIds.find(sEdgeA) == -1) mvBlockedBridgeIds.push_back(sEdgeA);
				if (mvBlockedBridgeIds.find(sEdgeB) == -1) mvBlockedBridgeIds.push_back(sEdgeB);
			}
			
			///////////////////
			// Custom cost?
			else
			{
				cPlatformNodeEdge@ pEdgeA = mStalkerPathfinder.GetPlatformNodeEdge(asNodeA, asNodeB);
				cPlatformNodeEdge@ pEdgeB = mStalkerPathfinder.GetPlatformNodeEdge(asNodeB, asNodeA);
				
				if (pEdgeA !is null && pEdgeB !is null)
				{
					pEdgeA.mfCost = afEdgeCost;
					pEdgeB.mfCost = afEdgeCost;
				}
			}
			
			///////////////////
			// Add blocker
			tID idBlocker = apEnt.GetMainBody().GetID();
			Stalker_AddPathBlockerBody("Stalker_1", idBlocker, true);
			Stalker_AddIgnoredPathBlockerBody("Stalker_1", idBlocker);
		}
		
		//-------------------------------------------------------
		
		void RemovePathBlocker(iLuxEntity@ apBlocker)
		{
			if (apBlocker is null) return;
			
			////////////////
			// Setup vars
			int lAreaCount = 0;
			bool bExists = false;
			float fEdgeCost = -1.f;
			tString sNodeA = "";
			tString sNodeB = "";
			tID idBlocker = tID_Invalid;
			
			////////////////
			// Get affected nodes
			// (And remove current one)
			for (int i = 0; i < mvPathBlockers.size(); ++i)
			{
				 cBridgePathBlockerData@ pData = mvPathBlockers[i];
				
				if (pData is null) continue;
				if (pData.m_idBlockerEnt != apBlocker.GetID()) continue;
				
				bExists = true;
				fEdgeCost = pData.mfEdgeCost;
				sNodeA = pData.msNodeA;
				sNodeB = pData.msNodeB;
				idBlocker = pData.m_idBlockerEnt;
				mvPathBlockers.removeAt(i);
				break;
			}
			
			if (bExists == false) return;
						
			////////////////
			// Count other blockers affecting same nodes
			for (int i = 0; i < mvPathBlockers.size(); ++i)
			{
				cBridgePathBlockerData@ pData = mvPathBlockers[i];
				
				if (pData is null) continue;
				if (pData.msNodeA != sNodeA) continue;
				if (pData.msNodeB != sNodeB) continue;
				
				++lAreaCount;			
			}		
			
			////////////////
			// Restore edges if no other relevant edges affected
			// (And isn't a closed drawbridge)
			tString sEdgeA = sNodeA + sNodeB;
			tString sEdgeB = sNodeB + sNodeA;
			
			if (lAreaCount == 0)
			{
				if (fEdgeCost < 0.f)
				{
					bool bIsClosedDrawbridge = false;					
					for (int i = 0; i < mvClosedDrawbridgeIds.size(); ++i)
					{
						tString sId = mvClosedDrawbridgeIds[i];
						if (sId == sEdgeA ||
							sId == sEdgeB)
						{
							bIsClosedDrawbridge = true;
							break;
						}
					}
					
					if (bIsClosedDrawbridge == false)
					{
						mStalkerPathfinder.AddPlatformNodeEdge(sNodeA, sNodeB);
						mStalkerPathfinder.AddPlatformNodeEdge(sNodeB, sNodeA);
					}
					
					int lIdA = mvBlockedBridgeIds.find(sEdgeA);
					if (lIdA != -1) mvBlockedBridgeIds.removeAt(lIdA);
					int lIdB = mvBlockedBridgeIds.find(sEdgeB);
					if (lIdB != -1) mvBlockedBridgeIds.removeAt(lIdB);
				}
				else
				{
					cPlatformNodeEdge@ pEdgeA = mStalkerPathfinder.GetPlatformNodeEdge(sNodeA, sNodeB);
					cPlatformNodeEdge@ pEdgeB = mStalkerPathfinder.GetPlatformNodeEdge(sNodeB, sNodeA);
					
					if (pEdgeA !is null && pEdgeB !is null)
					{
						pEdgeA.mfCost = gfEnding_PlatformNodeEdgeCostDefault;
						pEdgeB.mfCost = gfEnding_PlatformNodeEdgeCostDefault;
					}
				}
			}		
			
			////////////////
			// Remove blocker
			Stalker_RemovePathBlockerBody("Stalker_1", apBlocker.GetMainBody().GetID());
		}
		
		//-------------------------------------------------------
		
		bool DoStalkerJump(const tString &in asId, int alSuffix, bool abBridgeWillBreak)
		{
			////////////////
			// Jump not allowed?
			if (Map_TimerExists("Timer_DisallowJump"))
			{
				return false;
			}
			
			//////////////////
			// Early out if jumping
			if (StateMachine_GetCurrentStateName("Stalker_1") == "Jump")
			{
				return false;
			}
				
			/////////////////////
			// Setup vars
			int lSuffixA = alSuffix;
			int lSuffixB = (alSuffix == 1 ? 2 : 1);
			
			tString sBridgeA = "Bridge_" + asId + "_" + lSuffixA;
			tString sBridgeB = "Bridge_" + asId + "_" + lSuffixB;
			tString sBlockerA_1 = "BridgeBlocker_" + asId + "_" + lSuffixA + "_A";
			tString sBlockerA_2 = "BridgeBlocker_" + asId + "_" + lSuffixA + "_A";
			tString sBlockerB_1 = "BridgeBlocker_" + asId + "_" + lSuffixB + "_A";
			tString sBlockerB_2 = "BridgeBlocker_" + asId + "_" + lSuffixB + "_B";
			tString sArea = "Trigger_Bridge_" + asId + "_" + lSuffixA;
						
			cLuxAgent@ pAgent = cLux_ToAgent(Map_GetEntity("Stalker_1", eLuxEntityType_Agent));
			iCharacterBody@ pCharBody = pAgent !is null ? pAgent.GetCharBody() : null;
			iLuxEntity@ pBridgeA = Map_GetEntity(sBridgeA, eLuxEntityType_Prop);
			iLuxEntity@ pBridgeB = Map_GetEntity(sBridgeB, eLuxEntityType_Prop);
			iLuxEntity@ pTrigger = Map_GetEntity(sArea, eLuxEntityType_Area);
			
			iLuxEntity@[] pBlockers = { Map_GetEntity(sBlockerA_1, eLuxEntityType_Prop), 
										Map_GetEntity(sBlockerA_2, eLuxEntityType_Prop), 
										Map_GetEntity(sBlockerB_1, eLuxEntityType_Prop), 
										Map_GetEntity(sBlockerB_2, eLuxEntityType_Prop) }; 
			
			if (pAgent is null) return false;
			if (pCharBody is null) return false;
			if (pTrigger is null) return false;
			
			/////////////////////
			// On ground check (unless on broken bridge)
			if (abBridgeWillBreak == false && 
				pCharBody.IsOnGround() == false)
			{
				return false;
			}
			
			/////////////////////
			// Jump if heading through a blocker!
			bool bJump = false;
			cVector3f vAgentPos = pAgent.GetPosition();
			cVector3f vAgentFwdOffset = pCharBody.GetForward() * 1.5f;
			
			for (int i = 0; i < pBlockers.size(); ++i)
			{				
				iLuxEntity@ pBlocker = pBlockers[i];
				cBoundingVolume@ pBounds = pBlocker !is null ? pBlocker.GetMainBody().GetBoundingVolume() : null;
				
				if (pBlocker is null) continue;
				if (pBlocker.IsActive() == false) continue;
				if (pBounds is null) continue;
				
				if (cMath_CheckPointInBVIntersection(vAgentPos, pBounds) ||
					cMath_CheckPointInBVIntersection(vAgentPos + vAgentFwdOffset, pBounds))
				{
					bJump = true;
					break;
				}				
			}
			
			/////////////////////
			// If bridge will break, jump if inside area!
			bool bInsideTrigger = false;
			if (abBridgeWillBreak)
			{
				cBoundingVolume@ pBounds = pTrigger.GetMainBody().GetBoundingVolume();
				if (cMath_CheckPointInBVIntersection(vAgentPos, pBounds))
				{
					bJump = true;
					bInsideTrigger = true;
					
					// Make stalker fall
					int lAggressiveness = GameDifficulty_GetSettingValueByID_Int(eGameDifficultySetting_StalkerAggressiveness);
					if (lAggressiveness < eDifficultySettingValue_StalkerAggressiveness_High &&
						StateMachine_GetCurrentStateName("Stalker_1") == "ExamineRabbit")
					{
						pAgent.GiveDamage(pAgent.GetMainBody(), pAgent.GetPosition(), pAgent.GetPosition(), eDamageType_Grenade, 
										  1.f, 1, 1.f, 1.f, mBaseObj.GetPlayerEntity().GetID(), mBaseObj.GetNewAttackInstanceID());
					}
				}
			}
			
			/////////////////////
			// Do jump
			if (bJump)
			{
				cBridgeData@ pDataA = null;
				cBridgeData@ pDataB = null;
				
				for (int i = 0; i < mvBridgeData.size(); ++i)
				{
					cBridgeData@ pData = mvBridgeData[i];
					if (pData is null) continue;
					
					if (pData.msName == sBridgeA) 		@pDataA = pData;
					else if (pData.msName == sBridgeB) 	@pDataB = pData;
					
					if (pDataA !is null && pDataB !is null)
						break;
				}
				
				cVector3f vGoalPos = cVector3f(0.f);
				bool bJumpingToBridge = false;
				bool bJumpBack = false;
									
				cVector3f vPosA = pDataA.mvStartPos;
				cVector3f vPosB = pDataB.mvStartPos;
				cVector3f vToPosB = (vPosB - vPosA);
				cVector3f vMiddle = vPosA + (vToPosB / 2.f);
				cVector3f vOffsetDir = cMath_Vector3Normalize(vPosB - vPosA);
				
				bool bInFrontA = pAgent.GetPointIsInFront(vPosA);
				bool bInFrontB = pAgent.GetPointIsInFront(vPosB);				
				float fAgentDistToA = (vPosA - vAgentPos).Length();
				float fAgentDistToMiddle = (vMiddle - vAgentPos).Length();
								
				if (bInFrontA && bInFrontB == false)
				{
					vGoalPos = vPosA;
					bJumpingToBridge = false;
				}
				else if (bInFrontB && bInFrontA == false)
				{					
					if (bInsideTrigger)
					{
						if (pBridgeB is null && 
							fAgentDistToMiddle < fAgentDistToA + 2.f)
						{
							vGoalPos = vPosB;
							vOffsetDir = vOffsetDir * -1.f;
							bJumpingToBridge = false;
						}
						else
						{
							bJumpBack = true;
							vGoalPos = vPosA;
							bJumpingToBridge = false;
						}						
					}
					else if (pBridgeB !is null)
					{
						vGoalPos = vMiddle;
						vOffsetDir = cVector3f(0.f);
						bJumpingToBridge = true;
					}
					else
					{
						vGoalPos = vPosB;
						vOffsetDir = vOffsetDir * -1.f;
						bJumpingToBridge = false;
					}
				}
				
				if (vGoalPos.SqrLength() <= 0.f)
					return false;
					
				cVector3f vGoalPosOffset = vOffsetDir * 0.3f;
				vGoalPos += vGoalPosOffset;
				
				cScript_SetGlobalArgVector3f(0, vGoalPos);
				cScript_SetGlobalArgBool(1, bJumpingToBridge == false);
				cScript_SetGlobalArgBool(2, bJumpBack);
				cScript_SetGlobalArgBool(3, Map_TimerExists("BridgeBroke_" + asId));
				cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_Jump");
								
				Map_AddTimer("Timer_DisallowJump", 0.3f, "");
				return true;
			}
			
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Bridge(const tString &in asParent, const tString &in asChild, int alState)
		{
			////////////////
			// Setup vars
			int lId = cString_GetNumericSuffixInt(asParent);
			
			tString sNode = "";
			tString sBridgeId = cString_Sub(asParent, 15, 2);
			tString sBridge = "Bridge_" + sBridgeId + "_" + lId;
			
			bool bIsDrawbridgeTrigger = mvDrawbridges.find(sBridge) != -1;
			
			if (alState == 1)
			{
				////////////////
				// Set current node		
				if (lId == 1) 		sNode = cString_Sub(sBridgeId, 0, 1);
				else 				sNode = cString_Sub(sBridgeId, 1, 1);
				
				if (asChild == "Player")
				{
					mPlayerPathfinder.msCurrentNode = sNode;
					return true;
				}
				else
				{
					mStalkerPathfinder.msCurrentNode = sNode;
				}
								
				////////////////
				// Should stalker jump?
				if (asChild == "Stalker_1" && 
					bIsDrawbridgeTrigger == false)
				{
					OnTimer_CheckShouldStalkerJump(asParent);
				}
			}
			else if (alState == -1)
			{
				////////////////
				// Stop jump check
				if (asChild == "Stalker_1" && 
					bIsDrawbridgeTrigger == false)
				{
					Map_RemoveTimer(asParent);
				}
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckShouldStalkerJump(const tString &in asTimer)
		{
			////////////////
			// Jump not allowed?
			if (Map_TimerExists("Timer_DisallowJump"))
			{
				Map_AddTimer(asTimer, 0.01f, "OnTimer_CheckShouldStalkerJump");
				return;
			}
			
			////////////////
			// Setup vars
			iLuxEntity@ pTrigger = Map_GetEntity(asTimer, eLuxEntityType_Area);
			cLuxAgent@ pAgent = cLux_ToAgent(Map_GetEntity("Stalker_1", eLuxEntityType_Agent));
			
			if (pAgent is null) return;
			if (pTrigger is null) return;
			
			int lSuffix = cString_GetNumericSuffixInt(asTimer);			
			tString sId = cString_Sub(asTimer, 15, 2);
						
			////////////////
			// Jump?		
			if (DoStalkerJump(sId, lSuffix, false))
			{
				UpdateBridgePathBlockers(1.f);
			}
			
			////////////////
			// Restart timer
			Map_AddTimer(asTimer, 0.01f, "OnTimer_CheckShouldStalkerJump");
		}
		
		//-------------------------------------------------------
		
		void UpdateBridgePathBlockers(float afDelay)
		{						
			mvBridgeBlockerEntsToUpdate = mvBridgeBlockerEntIds;			
			for (int i = 0; i < mvBridgeBlockerEntsToUpdate.size(); ++i)
			{
				for (int j = 0; j < mvBridgeBlockerEntsToSkipUpdate.size(); ++j)
				{
					if (mvBridgeBlockerEntsToUpdate[i] == mvBridgeBlockerEntsToSkipUpdate[j])
					{
						mvBridgeBlockerEntsToUpdate.removeAt(i);
						--i;
						break;
					}
				}
			}
			
			Map_RemoveTimer("Timer_UpdateBridgePathBlockers");
			Map_AddTimer("Timer_UpdateBridgePathBlockers", afDelay, "OnTimer_UpdateBridgePathBlockers");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UpdateBridgePathBlockers(const tString &in asTimer)
		{						
			//////////////////
			// Early out if jumping
			if (StateMachine_GetCurrentStateName("Stalker_1") == "Jump")
			{
				Map_AddTimer(asTimer, 0.1f, "OnTimer_UpdateBridgePathBlockers");
				return;
			}
			
			//////////////////
			// Update blockers			
			ActivateBridgePathBlockers(mvBridgeBlockerEntsToUpdate);
						
			/////////////////
			// Blockers left to update? Go again!
			if (mvBridgeBlockerEntsToUpdate.size() > 0)
			{
				Map_AddTimer(asTimer, 0.1f, "OnTimer_UpdateBridgePathBlockers");
				return;
			}
		}
		
		//-------------------------------------------------------
		
		void ActivateBridgePathBlockers(array<tID> &inout avBlockerEntIds)
		{
			//////////////////
			// Set up vars
			cLuxAgent@ pAgent = cLux_ID_Agent(m_idStalker);
			cLuxProp@ pAgentHitbox = Map_GetProp("StalkerAnimationHitbox");
			cBoundingVolume@ pAgentBounds = pAgent !is null ? pAgent.GetCharBody().GetCurrentBody().GetBoundingVolume() : null;
			cBoundingVolume@ pAgentHitboxBounds = pAgentHitbox !is null ? pAgentHitbox.GetMainBody().GetBoundingVolume() : null;
			
			if (pAgent is null) return;
			if (pAgentHitbox is null) return;
			if (pAgentBounds is null) return;
			if (pAgentHitboxBounds is null) return;
			
			//////////////////
			// Update blockers
			for (int i = 0; i < avBlockerEntIds.size(); ++i)
			{
				///////////////////
				// Setup vars
				iLuxEntity@ pBlocker = cLux_ID_Entity(avBlockerEntIds[i]);
				cBoundingVolume@ pBounds = pBlocker !is null ? pBlocker.GetMainBody().GetBoundingVolume() : null;
				tID idBlocker = pBlocker !is null ? pBlocker.GetMainBody().GetID() : tID_Invalid;
				
				if (pBlocker is null) continue;
				if (pBlocker.IsActive() == false) continue;
				if (idBlocker == tID_Invalid) continue;
				if (pBounds is null) continue;
				
				///////////////////
				// Inside blocker?				
				if (cMath_CheckAABBIntersection(pAgentBounds.GetMin(), pAgentBounds.GetMax(), pBounds.GetMin(), pBounds.GetMax()))
				{
					continue;
				}
				
				///////////////////
				// Inside hitbox?
				if (pAgentHitbox.IsActive() &&
					cMath_CheckAABBIntersection(pAgentHitboxBounds.GetMin(), pAgentHitboxBounds.GetMax(), pBounds.GetMin(), pBounds.GetMax()))
				{
					continue;
				}
				
				///////////////////
				// Add blocker	
				Stalker_AddPathBlockerBody("Stalker_1", idBlocker, true);	
				avBlockerEntIds.removeAt(i);
				--i;
			}
		}

		//-------------------------------------------------------
		
		void UpdateStalkerBehaviour(int alBehaviour, const cVector3f &in avGoalPos)
		{					
			//////////////////
			// Update edge costs
			UpdateBridgeEdgeCost(mvMedCostBridgeEdges, gfEnding_PlatformNodeEdgeCostMed);
			UpdateBridgeEdgeCost(mvHighCostBridgeEdges, gfEnding_PlatformNodeEdgeCostHigh);
			
			//////////////////
			// Get goal node
			tString sGoalNode;			
			{
				//////////////////
				// Retreat or pacing
				if (alBehaviour == 1 || alBehaviour == 2)
				{
					mbStalkerRetreating = alBehaviour == 2;
					
					float fMinDistSqr = 1000.f * 1000.f;
					for (int i = 0; i < mStalkerPathfinder.mvPlatformNodeGraph.size(); ++i)
					{
						cPlatformNode@ pNode = mStalkerPathfinder.mvPlatformNodeGraph[i];
						if (pNode is null) continue;
						
						cVector3f vPos = GetPlatformNodePosition(pNode.msName);
						float fDistSqr = (vPos - avGoalPos).SqrLength();
						
						if (fDistSqr < fMinDistSqr)
						{
							fMinDistSqr = fDistSqr;
							sGoalNode = pNode.msName;
						}
					}
				}
				
				//////////////////
				// Default
				else
				{
					mbStalkerRetreating = false;
					sGoalNode = mPlayerPathfinder.msCurrentNode;
				}
			}
			
			//////////////////
			// Get paths
			array<cPlatformNode@> vToGoal = mStalkerPathfinder.GetPlatformNodePath(mStalkerPathfinder.msCurrentNode, sGoalNode);				
			bool bPathToGoalExists = vToGoal.size() > 0;
			
			cLuxAgent@ pStalker = cLux_ID_Agent(m_idStalker);
			cVector3f vStalkerPos = pStalker !is null ? pStalker.GetPosition() : cVector3f(0.f);
			cVector3f vClosestDestroyedBridgePos(0.f);
			float fMinDistToDestroyedBridgeSqr = 1000.f * 1000.f;
			
			//////////////////
			// Remove blockers on the path!
			// (Since the path exists and is selected, the stalker needs to be able to go there!)
			if (bPathToGoalExists)
			{			
				mvBridgeBlockerEntsToSkipUpdate.resize(0);
		
				//////////////////
				// Get edges on path
				array<tString> vRemoveBlockerEdges;						
				for (int i = 1; i < vToGoal.size(); ++i)
				{
					tString sNodeA = vToGoal[i - 1].msName;
					tString sNodeB = vToGoal[i].msName;
					tString sEdge = sNodeA + sNodeB;
					
					vRemoveBlockerEdges.push_back(sEdge);
				}
				
				//////////////////
				// Remove any blockers along the edges!
				for (int i = 0; i < vRemoveBlockerEdges.size(); ++i)
				{
					tString sEdge = vRemoveBlockerEdges[i];
					tString sNodeA = cString_Sub(sEdge, 0, 1);
					tString sNodeB = cString_Sub(sEdge, 1, 1);
					
					//////////////////
					// Any path blockers at the edge?
					for (int j = 0; j < mvPathBlockers.size(); ++j)
					{
						cBridgePathBlockerData@ pData = mvPathBlockers[j];
						if (pData is null) continue;
						
						if ((pData.msNodeA == sNodeA &&
							 pData.msNodeB == sNodeB) ||
							(pData.msNodeA == sNodeB &&
							 pData.msNodeB == sNodeA))
						{
							iLuxEntity@ pEnt = cLux_ID_Entity(pData.m_idBlockerEnt);
							tID idBlocker = pEnt !is null ? pEnt.GetMainBody().GetID() : tID_Invalid;
							
							if (pEnt is null) continue;
							
							Stalker_RemovePathBlockerBody("Stalker_1", idBlocker);
							
							if (mvBridgeBlockerEntsToSkipUpdate.find(idBlocker) == -1)
								mvBridgeBlockerEntsToSkipUpdate.push_back(idBlocker);
						}
					}
					
					//////////////////
					// Any destroyed bridge at the edge? Remove blockers!
					for (int j = 0; j < mvDestroyedBridgeDataIds.size(); ++j)
					{
						cBridgeData@ pData = mvBridgeData[mvDestroyedBridgeDataIds[j]];
						if (pData is null) continue;
						
						tString sBridge = pData.msName;
						tString sId = cString_Sub(sBridge, 7, 2);
						
						if (sId != (sNodeA + sNodeB) &&
							sId != (sNodeB + sNodeA))
						{
							continue;
						}
						
						tString sSuffix = cString_GetNumericSuffix(sBridge);
						tString sBlockerA = "BridgeBlocker_" + sId + "_" + sSuffix + "_A";
						tString sBlockerB = "BridgeBlocker_" + sId + "_" + sSuffix + "_B";
						iLuxEntity@ pBlockerA = Map_GetEntity(sBlockerA, eLuxEntityType_Prop);
						iLuxEntity@ pBlockerB = Map_GetEntity(sBlockerB, eLuxEntityType_Prop);
						tID idBlockerA = pBlockerA !is null ? pBlockerA.GetMainBody().GetID() : tID_Invalid;
						tID idBlockerB = pBlockerB !is null ? pBlockerB.GetMainBody().GetID() : tID_Invalid;
						
						if (pBlockerA is null) continue;
						if (pBlockerB is null) continue;
						
						Stalker_RemovePathBlockerBody("Stalker_1", idBlockerA);
						Stalker_RemovePathBlockerBody("Stalker_1", idBlockerB);
						
						if (mvBridgeBlockerEntsToSkipUpdate.find(idBlockerA) == -1)
							mvBridgeBlockerEntsToSkipUpdate.push_back(idBlockerA);
						if (mvBridgeBlockerEntsToSkipUpdate.find(idBlockerB) == -1)
							mvBridgeBlockerEntsToSkipUpdate.push_back(idBlockerB);
						
						//////////////////
						// Get position of closest destroyed bridge						
						float fDistSqrA = (pBlockerA.GetPosition() - vStalkerPos).SqrLength();
						float fDistSqrB = (pBlockerB.GetPosition() - vStalkerPos).SqrLength();
								
						if (fDistSqrA < fDistSqrB && fDistSqrA < fMinDistToDestroyedBridgeSqr)
						{
							fMinDistToDestroyedBridgeSqr = fDistSqrA;
							vClosestDestroyedBridgePos = pBlockerA.GetPosition();
						}
						else if (fDistSqrB < fDistSqrA && fDistSqrB < fMinDistToDestroyedBridgeSqr)
						{
							fMinDistToDestroyedBridgeSqr = fDistSqrB;
							vClosestDestroyedBridgePos = pBlockerB.GetPosition();
						}
					}
				}
			}
			
			//////////////////
			// Give position of closest destroyed bridge to stalker
			cScript_SetGlobalArgVector3f(0, vClosestDestroyedBridgePos);
			cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_SetClosestJumpPos");		
			
			//////////////////
			// Update behaviour
			if (mbStalkerRetreating == false)
			{							
				int lBehaviourId = alBehaviour;
				tString sPaceNode = "";
				
				array<cPlatformNode@> vPathToPlayer = mStalkerPathfinder.GetPlatformNodePath(mStalkerPathfinder.msCurrentNode, mPlayerPathfinder.msCurrentNode);
				bool bPathToPlayerExists = vPathToPlayer.size() > 0;
							
				//////////////////
				// Should pace?
				{
					///////////////////////
					// No path to player?
					if (bPathToPlayerExists == false)
					{
						///////////////////////
						// Get closest neighour to player
						int lMinPathSize = 100;
						cPlatformNode@ pNode = mMapPathfinder.GetPlatformNode(mPlayerPathfinder.msCurrentNode);

						if (pNode !is null)
						{
							for (int i = 0; i < pNode.mvNeighbours.size(); ++i)
							{								
								tString sNeighbour = pNode.mvNeighbours[i];
								array<cPlatformNode@> vToNeighbour = mStalkerPathfinder.GetPlatformNodePath(mStalkerPathfinder.msCurrentNode, sNeighbour);
								
								int lPathSize = vToNeighbour.size();
								if (lPathSize == 0) continue;
								
								if (lPathSize < lMinPathSize)
								{
									lMinPathSize = lPathSize;
									sPaceNode = sNeighbour;
								}
							}
						}
						
						///////////////////////
						// Failsafe: go to current
						if (sPaceNode == "")
							sPaceNode = mStalkerPathfinder.msCurrentNode;
					}
					
					///////////////////////
					// Need to jump to get to player no other path available?
					// Go to closest node to player!
					else if (vPathToPlayer.size() > 1 && 
							 GetDestroyedBridgeOnPath(vPathToPlayer, true))
					{
						tString sNodeA = vPathToPlayer[vPathToPlayer.size() - 2].msName;
						tString sNodeB = vPathToPlayer[vPathToPlayer.size() - 1].msName;
							
						cPlatformPathfinder pathfinder = mStalkerPathfinder;
						pathfinder.RemovePlatformNodeEdge(sNodeA, sNodeB);
						
						array<cPlatformNode@> vAltPathToPlayer = pathfinder.GetPlatformNodePath(mStalkerPathfinder.msCurrentNode, mPlayerPathfinder.msCurrentNode);
						if (vAltPathToPlayer.size() == 0)
						{
							array<cPlatformNode@> vPacePath = mStalkerPathfinder.GetPlatformNodePath(mStalkerPathfinder.msCurrentNode, sNodeA);
							if (vPacePath.size() > 0)
								sPaceNode = sNodeA;
						}
					}
					
					///////////////////////
					// On the same platform?
					else if (vPathToPlayer.size() == 1)
					{
						cLuxPathfinder@ pPathfinder = cast<cLuxPathfinder@>(pStalker.GetComponentByType(eLuxEntityComponentType_Pathfinder));
						if (pPathfinder !is null)
						{
							cAINode@ pNode = pPathfinder.GetNodeAtPos(pStalker.GetPlayerPos(), 0.f, 5.f, true, false, false, null);
							if (pNode is null || 
								pPathfinder.BuildPathNodeArrayToPos(pNode.GetPosition()) == false)
							{
								sPaceNode = mStalkerPathfinder.msCurrentNode;
							}
						}
					}
				}
				
				//////////////////
				// Update behaviour
				if (sPaceNode != "")
				{			
					lBehaviourId = 1;
					if (alBehaviour != 1)
					{						
						cPlatformNode@ pNode = mStalkerPathfinder.GetPlatformNode(sPaceNode);
						cVector3f vPacePos = pNode !is null ? GetPlatformNodePosition(pNode.msName) : pStalker.GetPosition();
						
						cScript_SetGlobalArgVector3f(0, vPacePos);						
						cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_SetPacePosition");
					}
				}
				else
				{
					lBehaviourId = 0;
				}
				
				if (lBehaviourId != alBehaviour)
				{
					cScript_SetGlobalArgInt(0, lBehaviourId);			
					cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_UpdateBehaviour");
				}
			}
		}
		
		//-------------------------------------------------------
		
		tString GetLowPrioStalkerRetreatPositions()
		{
			tString sToReturn = "";
			array<cVector3f> vDestroyedBridgePlatformPositions;
			
			for (int i = 0; i < mvDestroyedBridgeDataIds.size(); ++i)
			{
				cBridgeData@ pData = mvBridgeData[mvDestroyedBridgeDataIds[i]];
				if (pData is null) continue;
				
				cVector3f vPos = GetPlatformNodePosition(pData.msPlatform);
				sToReturn += (";" + cString_ToString(vPos.x) + " " + cString_ToString(vPos.y) + " " + cString_ToString(vPos.z));
			}
			
			return sToReturn;
		}
		
		//-------------------------------------------------------
		
		bool GetDestroyedBridgeOnPath(const array<cPlatformNode@> &in avPath, bool abBridgeIsLastOnPath)
		{
			int lIndex = abBridgeIsLastOnPath ? avPath.size() - 1 : 1;
			for (; lIndex < avPath.size(); ++lIndex)
			{
				tString sNodeA = avPath[lIndex - 1].msName;
				tString sNodeB = avPath[lIndex].msName;
				
				for (int j = 0; j < mvDestroyedBridgeDataIds.size(); ++j)
				{
					cBridgeData@ pData = mvBridgeData[mvDestroyedBridgeDataIds[j]];
					if (pData is null) continue;
							
					tString sBridge = pData.msName;
					tString sId = cString_Sub(sBridge, 7, 2);
								
					if (sId == (sNodeA + sNodeB) ||
						sId == (sNodeB + sNodeA))
					{
						return true;
					}
				}
			}
			
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnStalkerFall()
		{
			if (mbStalkerFell) return;
			
			mbStalkerFell = true;
			Seq_StalkerFall("");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataStalkerFall;
		void Seq_StalkerFall(const tString &in asTimer)
		{
			Sequence_Begin("Seq_StalkerFall", mSeqDataStalkerFall);
			if (Sequence_DoStepAndWait(3.1f))
			{
				Sound_CreateAtEntity("Sound_StalkerFall", "DW_tunnel/level/creature_death", "Stalker_1", 0.f, false, 1.f, 1.f, 90.f);
				Music_Stop(3.f, eMusicPrio_BgAmb);
				
				SetLightningActive(false);
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{				
				OnTimer_DoLightning("");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Sound_PlayGui("DW_tunnel/level/portal_death", 1.f, eSoundEntryType_Gui);
				Effect_Shake_Start(0.02f, 1.5f, 5.f, 0.5f);
			}
			else if (Sequence_DoStepAndWait(2.f))
			{
				Sound_Play("Sound_Quake*", 0.f);
			}
			else if (Sequence_DoStepAndWait(6.f))
			{
				Light_SetBrightness("lightning_flash_*", 16.f);
				SetLightningActive(false);
				SetLightningActive(true);
				
				Map_AddTimer("Timer_StartQuake", 1.f, "OnTimer_StartQuake");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Music_Play("Bunker_Arsenal_Phase2.ogg", 0.3f, true, eMusicPrio_BgAmb);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------

		//} END Event *Encounter the STALKER on the BRIDGES*
		
		/////////////////////////////////////////
		// Event *Use the DRAWBRIDGES*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		array<tString> mvClosedDrawbridgeIds;
		
		//-------------------------------------------------------
		
		void OnConnectionStateChange_Wheel(const tString &in asEntity, int alState)
		{		
			if (mbSetup) return;
			
			//////////////////
			// Setup vars
			tString sSuffix = "_" + cString_GetNumericSuffixInt(asEntity);			
			tString sId = cString_Sub(asEntity, 6, 2);
			tString sNodeA = cString_Sub(sId, 0, 1);
			tString sNodeB = cString_Sub(sId, 1, 1);
			tString sBridge = "Bridge_" + sId + sSuffix;
			tString sBlockerA = "BridgeBlocker_" + sId + sSuffix + "_A";
			tString sBlockerB = "BridgeBlocker_" + sId + sSuffix + "_B";
			
			iLuxEntity@ pBridge = Map_GetEntity(sBridge, eLuxEntityType_Prop);
			iLuxEntity@ pBlockerA = Map_GetEntity(sBlockerA, eLuxEntityType_Prop);
			iLuxEntity@ pBlockerB = Map_GetEntity(sBlockerB, eLuxEntityType_Prop);
			
			if (pBlockerA is null) return;
			if (pBlockerB is null) return;
			
			//////////////////
			// Activate blockers
			pBlockerA.SetActive(alState != -1);
			pBlockerB.SetActive(alState != -1);
			
			//////////////////
			// Bridge open?
			if (alState == -1)
			{													
				Stalker_RemovePathBlockerBody("Stalker_1", pBlockerA.GetMainBody().GetID());
				Stalker_RemovePathBlockerBody("Stalker_1", pBlockerB.GetMainBody().GetID());
				
				if (mvBlockedBridgeIds.find(sNodeA + sNodeB) == -1)
					mStalkerPathfinder.AddPlatformNodeEdge(sNodeA, sNodeB);
				if (mvBlockedBridgeIds.find(sNodeB + sNodeA) == -1)
					mStalkerPathfinder.AddPlatformNodeEdge(sNodeB, sNodeA);
				
				UpdateBridgePathBlockers(0.1f);				
					
				int lId = mvClosedDrawbridgeIds.find(sId);
				if (lId != -1)
					mvClosedDrawbridgeIds.removeAt(lId);
			}
			
			//////////////////
			// Bridge closed?
			else if (alState == 0)
			{								
				Stalker_AddPathBlockerBody("Stalker_1", pBlockerA.GetMainBody().GetID(), true);
				Stalker_AddPathBlockerBody("Stalker_1", pBlockerB.GetMainBody().GetID(), true);
				
				mStalkerPathfinder.RemovePlatformNodeEdge(sNodeA, sNodeB);
				mStalkerPathfinder.RemovePlatformNodeEdge(sNodeB, sNodeA);
					
				UpdateBridgePathBlockers(0.1f);					
				
				if (mvClosedDrawbridgeIds.find(sId) == -1)
					mvClosedDrawbridgeIds.push_back(sId);
			}
		}
		
		//-------------------------------------------------------
		
		void OnInteract_Wheel(const tString &in asEntity)
		{
			Map_AddTimer(asEntity, 0.01f, "OnTimer_CheckAgentIsOnBridge");
			Entity_SetVarFloat(asEntity, "StartInteractAngle", Wheel_GetCurrentAngle(asEntity));
		}
		
		//-------------------------------------------------------
		
		void OnTimer_CheckAgentIsOnBridge(const tString &in asTimer)
		{
			//////////////////
			// Is agent on a bridge?
			cLuxAgent@ pAgent = cLux_ToAgent(Map_GetEntity("Stalker_1", eLuxEntityType_Agent));
			if (pAgent is null) return;
			
			bool bAgentOnBridge = false;
			
			if (pAgent.IsActive())
			{
				tString sId = cString_Sub(asTimer, 6, 2);
				tString sBridge = "Bridge_" + sId + "_*";
				
				array<iLuxEntity@> vBridges;
				Map_GetEntityArray(sBridge, vBridges, eLuxEntityType_Prop);		
				
				for (int i = 0; i < vBridges.size(); ++i)
				{
					iLuxEntity@ pBridge = vBridges[i];
					
					cBoundingVolume@ pAgentBounds = pAgent.GetCharBody().GetCurrentBody().GetBoundingVolume();
					cBoundingVolume@ pBounds = pBridge.GetMainBody().GetBoundingVolume();
					
					if (cMath_CheckAABBIntersection(pBounds.GetMin(), pBounds.GetMax(), pAgentBounds.GetMin(), pAgentBounds.GetMax()))
					{
						bAgentOnBridge = true;
						break;
					}
				}
			}
			
			//////////////////
			// Jam/unjam if agent is on bridge or not
			float fAngle = Wheel_GetCurrentAngle(asTimer);			
			if (bAgentOnBridge && Wheel_GetJammed(asTimer) == false)
			{
				Wheel_SetJammed(asTimer, true, fAngle - 1.f, fAngle + 1.f);
			}
			else if (bAgentOnBridge == false && Wheel_GetJammed(asTimer))
			{
				Wheel_SetJammed(asTimer, false, 0.f, 0.f);
			}
			
			//////////////////
			// Interacted with? Keep checking!
			if (Entity_IsInteractedWith(asTimer))
			{
				Map_AddTimer(asTimer, 0.01f, "OnTimer_CheckAgentIsOnBridge");
			}
			
			//////////////////
			// Not interacted with, auto open/close bridge!
			else
			{
				if (Wheel_GetJammed(asTimer))
					Wheel_SetJammed(asTimer, false, 0.f, 0.f);			
				
				float fStartAngle = Entity_GetVarFloat(asTimer, "StartInteractAngle");
				float fDiff = fAngle - fStartAngle;
				float fAngleGoal = fAngle >= 45.f ? 90.f : 0.f;
				
				if (fDiff >= 20.f) fAngleGoal = 90.f;
				if (fDiff <= -30.f) fAngleGoal = 0.f;
				
				Wheel_SetAngle(asTimer, fAngleGoal, true);
			}
		}
		
		//-------------------------------------------------------

		//} END Event *Use the DRAWBRIDGES*
		
		/////////////////////////////////////////
		// Event *Jump over the GATE*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbStalkerHasBeenDesperate = false;
		
		//-------------------------------------------------------
		
		void OnInteract_Crate(const tString &in asEntity)
		{
			if (mbStalkerHasBeenDesperate) return;				
			Map_AddTimer(asEntity, 0.5f, "OnTimer_SetStalkerIsDesperate");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetStalkerIsDesperate(const tString &in asTimer)
		{
			if (Entity_IsInteractedWith(asTimer) == false) 
				return;
			
			SetStalkerDesperate(true);
		}	
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_UpdateKillDistance(const tString &in asParent, const tString &in asChild, int alState)
		{
			cScript_SetGlobalArgFloat(0, alState == 1 ? 4.f : -1.f);
			cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_SetKillDistance");
			return true;
		}
	
		//-------------------------------------------------------

		//} END Event *Jump over the GATE*
	 
		/////////////////////////////////////////
		// Event *Exit the Bunker*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbExitBunkerWithStalker = false;
		int mlEndingFovId = -1;
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_TriggerBreakEndWall(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (mbStalkerFell == false) return false;
			
			ParticleSystem_CreateAtEntity("PS_Debris", "debris_falling_arena_large.ps", "BreakWallRock_1", false);
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_FirstRockDust", "dust_impact_large_oneshot.ps", "BreakWallRock_1", false);
			if (pPS !is null)
				pPS.SetColor(cColor(0.512,0.366,0.27,0.208));
			
			int lId = Effect_Shake_Start(0.03f, 1.f, 0.5f, 0.5f);
			Effect_Rumble_Start(0.35f, 2.f, 0.5f, 0.5f);
			
			Sound_CreateAtEntity("Sound_CeilingBreak", "DW_tunnel/bomb/war_bomb", "BreakWallRock_1", 0.f, false, 1.f, 15.f, 70.f);
			
			Entity_SetActive("BreakWallRock_*", true);
			
			Entity_AddImpulse("BreakWallRock_1", cVector3f(0.f, -15.f, 0.f), false, false);
			Entity_AddImpulse("BreakWallRock_2", cVector3f(0.f, -5.f, 0.f), false, false);
			Entity_AddTorque("BreakWallRock_1", cVector3f(1000.f, 0.f, 500.f), false, false);
			Entity_AddTorque("BreakWallRock_2", cVector3f(-500.f, 1000.f, 250.f), false, false);
			return false;
		}

		//-------------------------------------------------------
		
		bool OnTrigger_BreakEndWall(const tString &in asParent, const tString &in asChild, int alState)
		{
			WoodenBreakable_SetIsBreakable("ExitBlocker", true);
			Prop_SetHealth("ExitBlocker", 0.f);
			Entity_SetActive("BlockBox_Ending_*", false);
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_SetFenceBreakable(const tString &in asParent, const tString &in asChild, int alState)
		{
			WoodenBreakable_SetIsBreakable("ExitBlocker", true);
			Entity_SetActive("BlockBox_Ending_*", false);
			
			SetStalkerDesperate(true);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnBreak_ExitBlocker(const tString &in asEntity)
		{
			Map_AddTimer("Timer_UpdateExitBlockerCollision", 1.f, "OnTimer_UpdateExitBlockerCollFlag");
			Map_AddTimer(asEntity, 0.05f, "OnTimer_DoExitBlockerShake");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoExitBlockerShake(const tString &in asTimer)
		{
			int lId = Effect_Shake_Start(0.05f, 0.4f, 0.1f, 0.3f);
			Effect_Shake_SetSourceEntity(lId, asTimer + "_broken", 3.f, 15.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_UpdateExitBlockerCollFlag(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity("ExitBlocker_broken", eLuxEntityType_Prop);
			if (pEnt is null) return;
			
			uint lFlag = mBaseObj.GetCollideFlag("-agent");
			for (int i = 0; i < pEnt.GetBodyNum(); ++i)
			{
				iPhysicsBody@ pBody = pEnt.GetBody(i);
				if (pBody is null) continue;
				pBody.SetCollideFlags(lFlag);
			}
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_ActivateOutsidePreset(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) return true;
			
			bool bInFront = Entity_PlayerIsInFront(asParent);
			if (bInFront)
			{
				Map_Preset_Fade("Outside", 0.3f);
				SetLightningActive(false);
			}
			else
			{
				Map_Preset_Fade("Inside", 0.3f);
				SetLightningActive(true);
			}
			
			return true;
		}
		
		//-------------------------------------------------------
		
		void OnInteract_TunnelRock(const tString &in asEntity)
		{
			Push_SetCanLeaveState(false);
			
			mbPlayerPushingTunnelRock = true;
			
			Prop_SetStaticPhysics("TunnelRock_*", false);
			
			for (int i = 2; i < 6; ++i)
			{
				cLuxProp@ pProp = cLux_ToProp(Map_GetEntity("TunnelRock_" + i, eLuxEntityType_Prop));
				if (pProp !is null) continue;
				
				pProp.GetMainBody().SetMass(0.1f);
			}
			
			Map_AddTimer("Timer_DisableSmallRockCollision", 1.f, "OnTimer_DisableSmallRockCollision");
			Map_AddTimer("Timer_PushSmallTunnelRocks", 0.1f, "OnTimer_PushSmallTunnelRocks");
			
			if (Entity_IsActive("Stalker_1"))
			{
				mbExitBunkerWithStalker = true;
			}
			
			// Keep hearing footsteps
			Agent_PlayCutsceneAnimation("Stalker_1", "run_map_transfer", 0.f, true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DisableSmallRockCollision(const tString &in asTimer)
		{
			uint lFlag = mBaseObj.GetCollideFlag("-bigrock");
			
			for (int i = 3; i < 6; ++i)
			{
				cLuxProp@ pProp = cLux_ToProp(Map_GetEntity("TunnelRock_" + i, eLuxEntityType_Prop));
				if (pProp is null) continue;
				
				pProp.GetMainBody().SetCollideFlags(lFlag);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PushSmallTunnelRocks(const tString &in asTimer)
		{
			for (int i = 2; i < 6; ++i)
			{
				Entity_AddImpulse("TunnelRock_" + i, cVector3f(0.f, 0.f, 0.25f), false, false);
			}
			
			Map_AddTimer("Timer_PushSmallTunnelRocks", 0.1f, "OnTimer_PushSmallTunnelRocks");
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartEndingCutscene(const tString &in asParent, const tString &in asChild, int alState)
		{
			Push_SetCanLeaveState(true);
			Player_ChangeStateToNormal();
			
			mbPlayerPushingTunnelRock = false;
		
			Music_StopAll(3.0f);
		
			if (mbExitBunkerWithStalker)
				Seq_ExitBunkerWithStalker("");
			else
				Seq_ExitBunkerNoStalker("");
				
			if (GameDifficulty_GetSettingValueByID_Bool(eGameDifficultySetting_HardcoreHealthSystem))
				Player_StopBleeding();
				
			return false;
		}
		
		//-------------------------------------------------------
		
		void StartExitSequence()
		{	
			Player_SetCrouching(false, true);
			
			tString sPlayerAnim = mbExitBunkerWithStalker ? "player_end_tumble_into_trench" : "player_end_tumble_into_trench_no_stalker";
			
			PlayerBody_PlayCutsceneAtEntity(sPlayerAnim, "Area_ExitBunkerCutscene", false, 0.5f);
			Entity_SetAnimationMessageEventCallback(PlayerBody_GetEntityName(), "OnAnimMessage_Player", false);
			
			PlayerBody_SetCutsceneMaxPitch(0.f);
			PlayerBody_SetCutsceneMaxYaw(0.f);
			
			tString sArmAnim = mbExitBunkerWithStalker ? "severed_arn_end_tumble" : "severed_arn_end_tumble_no_stalker";
			Entity_SetActive("severed_arm", true);
			Entity_PlayAnimation("severed_arm", sArmAnim, 0.f);
			
			float fSplashTime = mbExitBunkerWithStalker ? 27.5f : 19.85f;
			Map_AddTimer("Timer_PlaySeveredArmSplash", fSplashTime, "OnTimer_PlaySeveredArmSplash");
			
			Map_AddTimer("Timer_DeactivateStalkerEnding", 1.f, "OnTimer_DeactivateStalkerEnding");
				
			Map_Preset_Fade("Outside", 0.1f);
			Billboard_SetVisible("billboard_exit_*", false);
			Light_SetVisible("light_exit_*", false);
				
			mBaseObj.GetWorld().GetDirectionalLight().SetCastShadows(true);
			Map_SetEnvironmentParticlesActive(true);
			
			Map_RemoveTimer("Timer_PushSmallTunnelRocks");
			Map_AddTimer("Timer_PushTunnelRock", 0.1f, "OnTimer_PushTunnelRock");
			Map_AddTimer("Timer_DeactivateTunnelRock", 5.f, "OnTimer_DeactivateTunnelRock");
			
			Map_RemoveTimer("Timer_DoImpact");
			Map_RemoveTimer("Timer_DoQuakeEffects");
			
			Sound_Stop("Sound_Quake*", 1.f);
			Sound_Stop("Sound_Energy", 1.f);
			
			Map_AddTimer("Timer_DoEndingSeqFov", 6.f, "OnTimer_DoEndingSeqFov_1");
			Map_AddTimer("Timer_SpawnEndingDust", 1.5f, "OnTimer_SpawnEndingDust");
			Map_AddTimer("Timer_SpawnEndingDust", 3.f, "OnTimer_SpawnEndingDust");
			Map_AddTimer("Timer_SpawnEndingDust", 5.f, "OnTimer_SpawnEndingDust");
			Map_AddTimer("Timer_SpawnEndingRubble", 10.f, "OnTimer_SpawnEndingRubble");
			Music_StopAll(3.f);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SpawnEndingDust(const tString &in asTimer)
		{
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_DustEnding", "dust_impact_large_oneshot.ps", "Camera", false);
			if (pPS !is null)
			{
				pPS.SetColor(cColor(0.541,0.457,0.387,1));
				pPS.SetBrightness(3.5f);
				pPS.SetFadeAtDistance(false);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SpawnEndingRubble(const tString &in asTimer)
		{
			Entity_SetActive("rock_tumble_*", true);
		}
		
		//-------------------------------------------------------
		
        bool Oncollide_Waterplane(const tString &in asParent, const tString &in asChild, int alState)
        {
		    ParticleSystem_CreateAtEntityExt("Bubbles", "bubble_splash_pit.ps", "ps_position_bubbles", false, cColor_White, 1, false, 0, 0, 0, 0);
		    ParticleSystem_CreateAtEntityExt("Splash", "splash_pit.ps", "ps_position_splash", false, cColor_White, 1, false, 0, 0, 0, 0);
	        return true;
        }
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivateStalkerEnding(const tString &in asTimer)
		{
			Entity_SetActive("Stalker_1", false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlaySeveredArmSplash(const tString &in asTimer)
		{
			ParticleSystem_CreateAtEntity("PS_ArmSplash", "water_splash_oneshot.ps", "Area_ArmSplash", false);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataExitBunkerNoStalker;
		void Seq_ExitBunkerNoStalker(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ExitBunkerNoStalker", mSeqDataExitBunkerNoStalker);
			if (Sequence_DoStepAndWait(33.7f))
			{
				StartExitSequence();
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Seq_ExitBunkerEnding("");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataExitBunkerWithStalker;
		void Seq_ExitBunkerWithStalker(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ExitBunkerWithStalker", mSeqDataExitBunkerWithStalker);
			if (Sequence_DoStepAndWait(10.333f))
			{
				StartExitSequence();
			}
			else if (Sequence_DoStepAndWait(31.2f))
			{
				Entity_SetActive("Stalker_EndingCutscene", true);
				Entity_PlayAnimation("Stalker_EndingCutscene", "stalker_ending_scene", 0.f, false, true, "OnAnimEnd_StalkerEndingCutscene");
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				Seq_ExitBunkerEnding("");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoEndingSeqFov_1(const tString &in asTimer)
		{
			mlEndingFovId = Effect_DoF_Start(0.f, 1.f, 1.f, 1.f);
			Map_AddTimer("Timer_DoEndingSeqFov", 5.5f, "OnTimer_DoEndingSeqFov_2");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoEndingSeqFov_2(const tString &in asTimer)
		{
			if (mlEndingFovId != -1)
				Effect_DoF_FadeFocus(mlEndingFovId, 5.f, 20.f, 1.f);
			
			float fTime = mbExitBunkerWithStalker ? 10.f : 2.5f;
			Map_AddTimer("Timer_DoEndingSeqFov", fTime, "OnTimer_DoEndingSeqFov_3");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoEndingSeqFov_3(const tString &in asTimer)
		{
			if (mlEndingFovId != -1)
				Effect_DoF_FadeFocus(mlEndingFovId, 0.f, 1.f, 1.f);
				
			Map_AddTimer("Timer_DoEndingSeqFov", 6.f, "OnTimer_DoEndingSeqFov_4");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoEndingSeqFov_4(const tString &in asTimer)
		{
			if (mlEndingFovId != -1)
				Effect_DoF_FadeOut(mlEndingFovId, 2.f);
			
			mlEndingFovId = -1;			
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataExitBunkerEnding;
		void Seq_ExitBunkerEnding(const tString &in asTimer)
		{
			Sequence_Begin("Seq_ExitBunkerEnding", mSeqDataExitBunkerEnding);
			if (Sequence_DoStepAndWait(2.f))
			{
			    Entity_SetActive("soldier_ending_*", true);
			    Prop_MoveLinearTo("soldier_ending_1","soldier_01_target",1,3.5f,0.5f,true);
			    Prop_MoveLinearTo("soldier_ending_2","soldier_02_target",1,3.5f,0.5f,true);
				Sound_Play("Sound_Alert*", 0.0f);
			}
			else if (Sequence_DoStepAndWait(3.7f))
			{
				Sound_Play("Sound_Spotted", 0.0f);
			}
			else if (Sequence_DoStepAndWait(0.2f))
			{
				Sound_Stop("Sound_AlertWhistle", 0.2f);
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{
				Effect_Fade_Out(0.1f);
				Sound_FadeGlobalVolume(0.f, 0.1f, eSoundEntryType_WorldAll);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Player_SetActive(false);
					
				Credits_Start("Credits.cfg","OnEndOfCredits", gsCreditsExitBunkerWithStalkerBg, cVector3f(-0.15,-0.15,1.75f), gsCreditsMusic);
				
				MainMenu_SetGameCompletedOnce(true);
				Achievement_EndGame(true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PushTunnelRock(const tString &in asTimer)
		{
			Entity_AddImpulse("TunnelRock_*", cVector3f(0.f, 0.f, 1.f), false, false);
			Map_AddTimer("Timer_PushTunnelRock", 0.1f, "OnTimer_PushTunnelRock");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DeactivateTunnelRock(const tString &in asTimer)
		{
			Map_RemoveTimer("Timer_PushTunnelRock");
			Entity_SetActive("TunnelRock_*", false);
			Entity_SetActive("TunnelRockWater", true);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_StalkerEndingCutscene(const tString &in asEntity, const tString &in asAnim)
		{
			Entity_SetActive("Stalker_EndingCutscene", false);
		}
		
		//-------------------------------------------------------
		
		void OnEndOfCredits()
		{
			if (!cLux_ScriptDebugOn())
			{
				GameStats_Save();
				GameStats_SetGuiActive(true);
				//Map_ChangeMap("main_menu.hpm","PlayerStartArea_1","","",false);
			}
		}
		
		//-------------------------------------------------------
		
		void OnAnimMessage_Player(const tString &in asEntityName, const tString &in asAnimName, int alMessageEventID)
		{
			if (alMessageEventID == 2)
				Effect_Rumble_Start(0.5, 0.8);
			if (alMessageEventID == 4)
				Effect_Rumble_Start(0.5, 0.8);
			if (alMessageEventID == 6)
				Effect_Rumble_Start(0.35, 0.8);
			else
				Effect_Rumble_Start(0.5, 0.25);
			
		}
		
		//-------------------------------------------------------

		//} END Event *Exit the Bunker*
		
		/////////////////////////////////////////
		// Event *Fall into the RIFT*
		//{//////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlShadowBlurId = -1;
		int mlShadowDeathStage = -1;
		float mfShadowDeathSpeed = 1.f;
		float mfShadowDeathT = 0.f;
		
		//-------------------------------------------------------	
		
		bool OnTrigger_FallIntoRift(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_FallInToRift("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataFallInToRift;
		void Seq_FallInToRift(const tString &in asTimer)
		{
			Sequence_Begin("Seq_FallInToRift", mSeqDataFallInToRift);
			if (Sequence_DoStepAndWait(0.3f))
			{
				Map_RemoveTimer("Timer_StopLightning");
				Map_RemoveTimer("Timer_DoLightning");
				Map_RemoveTimer("Timer_DoImpact");
				Map_RemoveTimer("NoRepeat");
				Map_RemoveTimer("Timer_StartQuake");	
				Map_RemoveTimer("Timer_DoQuakeEffects");	
				Map_RemoveTimer("Timer_SpawnStalker");
				Map_RemoveTimer("Timer_DoStalkerEmergeLightning");
				Map_RemoveTimer("Timer_PlayerStalkerEmergeSound");
				
				SequenceStates_Stop("Seq_StalkerFall");
				SequenceStates_Stop("Seq_ExitBunkerNoStalker");
				SequenceStates_Stop("Seq_ExitBunkerWithStalker");
				SequenceStates_Stop("Seq_ExitBunkerEnding");
				
				Sound_Stop("Sound_Quake*", 0.3f);
				Sound_Stop("Sound_Energy", 0.3f);
				
				Effect_Flash_Start(0.3f, 0.5f, 0.3f, 1.f);				
				Sound_PlayGui("DW_tunnel/level/portal_death", 1.f, eSoundEntryType_Gui);
				
				Music_StopAll(0.3f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{								
				cLux_GetPlayer().ChangeState(ePlayerState_Null);
				Player_SetActive(false);
				cLux_GetPlayer().GetCharacterBody().SetTestCollision(false);
				Entity_SetActive("Stalker_1", false);
				Player_PlaceAtEntity("Area_ShadowDeath", true, true);
				
				if (GameDifficulty_GetSettingValueByID_Bool(eGameDifficultySetting_HardcoreHealthSystem))
					Player_StopBleeding();
				
				Entity_SetActive("BreakBridgeRock*", false);
				Entity_SetActive("DebrisRock*", false);
			}
			else if (Sequence_DoStepAndWait(3.f))
			{
				Effect_Fade_Out(0.3f);			
			}
			else if (Sequence_DoStepAndWait(1.5f))
			{				
				Sound_PlayGui("player/foley/damage/player_fall_damage", 1.f, eSoundEntryType_Gui);
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{				
				Player_SetActive(true);
				PlayerBody_PlayCutsceneAtEntity("fall_and_get_up_slow", "Area_ShadowDeath", false, 0.f, "OnAnimEnd_FallIntoRift");
				PlayerBody_SetCutsceneMaxPitch(0.f);
				PlayerBody_SetCutsceneMaxYaw(0.f);
				
				mlShadowBlurId = Effect_Blur_Start(2.f, 0.f);
				Effect_ImageTrail_Start(2.f, 0.f, 5.f, 1.f);
			}
			else if (Sequence_DoStepAndPause(2.f))
			{				
				Effect_Fade_In(1.f);
				Effect_Blur_FadeOut(mlShadowBlurId, 5.f);
				mlShadowBlurId = -1;
			}
			else if (Sequence_DoStepAndWait(1.f))
			{				
				Death_Start("Fall");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_FallIntoRift(const tString &in asAnim)
		{
			mlShadowDeathStage = 0;
			
			Player_FadeLookSpeedMulTo(0.05f, 1.f);
			Player_FadeMoveSpeedMulTo(0.5f, 1.f);
			Player_FadeRunSpeedMulTo(0.f, 1.f);
			Player_SetCrouchDisabled(true);
			Player_SetJumpDisabled(true);
			Player_SetCanEquipItems(false);
			Player_SetLeanDisabled(true);
			Player_SetCheckHealthAllowed(false);
			Player_SetCanEquipItems(false);
			Player_ShowCrossHairIcons(false, false);
			FootPlacement_SetActive(PlayerBody_GetEntityName(), false);
			Sketchbook_SetCanOpen(false);
			
			Player_StartLookAt("Area_ShadowDeathLookAt", 1.f, 2.f, 5.f, false);
			
			Map_AddTimer("Timer_SetupAfterFallAnim", 0.01f, "OnTimer_SetupAfterFallAnim");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetupAfterFallAnim(const tString &in asTimer)
		{
			Player_ShowCrossHairIcons(false, false);
			FootPlacement_SetActive(PlayerBody_GetEntityName(), false);
		}
		
		//-------------------------------------------------------

		//} END Event *Fall into the RIFT*
	 
	//} END EVENTS
}