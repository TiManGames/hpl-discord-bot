	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("arena");
		
		SetupDefaultPresetFog();
		Map_Preset_SetupDirLight("Inside", true, cColor(0,0,0,1), 0.02f, cVector3f(-0.495, 0.867, 0.05), cColor(0.023,0.033,0.03,1), cColor(0.137,0.193,0.185,1));
		Map_Preset_SetupSkybox("Inside", cColor(0.684,0.989,1,1), 1.f);
				
		Map_Preset_SetupFog("Lightning", true, gfEnding_LightningFogStart, gfEnding_LightningFogEnd, 1.f, cColor(0.047,0.057,0.054,1), 1.f, false, false, false);
		Map_Preset_SetupDirLight("Lightning", true, cColor(0.641,0.971,1,1), 0.02f, cVector3f(-0.495, 0.867, 0.05), cColor(0.023,0.033,0.03,1), cColor(0.137,0.193,0.185,1));
		Map_Preset_SetupSkybox("Lightning", cColor(0.684,0.989,1,1), 1.f);
		
		Map_Preset_SetupFog("Outside", true, 0.f, 75.f, 0.25f, cColor(0.002,0.002,0.002,1), 1.f, false, false, false);
		Map_Preset_SetupDirLight("Outside", true, cColor(0.91,1,0.722,1), 0.4f, cVector3f(-0.383f, -0.594f, -0.707f), cColor(0.336,0.369,0.268,1), cColor(0,0,0,1));
		Map_Preset_SetupSkybox("Outside", cColor(0.684,0.989,1,1), 1.f);
		
		// Set up color grading etc.
		Light_SetFlickerActive("lightning_flash_*", false);
		Light_SetBrightness("lightning_flash_*", 10.f);
		Map_SetEnvironmentParticlesActive(false);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		///////////////
		// Preload particles
		ParticleSystem_Preload("sand_falling_stream_small_oneshot_instant.ps");
		ParticleSystem_Preload("ghoul_ceiling_dust.ps");
		ParticleSystem_Preload("splash_underwater_ending.ps");
		ParticleSystem_Preload("debris_falling_arena_large.ps");
		ParticleSystem_Preload("dust_impact_large_oneshot.ps");
		ParticleSystem_Preload("water_splash_oneshot.ps");
		
		///////////
		// Preload entity
		Entity_Preload("player_bunker.ent");
		Entity_Preload("path_area_blocker.ent");
		Entity_Preload("darkworld_drawbridge_01.ent");
		Entity_Preload("darkworld_drawbridge_rampdown.ent");
		Entity_Preload("darkworld_drawbridge_rampup.ent");
		Entity_Preload("darkworld_drawbridge_01_sidewalls.ent");
		Entity_Preload("wheel_ottoman.ent");
		Entity_Preload("scatter_rock04_shatter.ent");
		Entity_Preload("scatter_rock04.ent");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		// Any general setup of script / entities
		
		/////////////////
		// Debug
		if (cLux_ScriptDebugOn())
		{
			if (ItemType_GetCountInInventory("Gun") == 0)
			{			
				Item_SetCurrentSlotsCount(15);
				Item_AddToInventory("DynamoLantern");
				Item_AddToInventory("Gun");
				Item_AddToInventory("Shotgun");
				Item_AddManyToInventory("ShotgunAmmunition", 3);
				Item_AddToInventory("Lighter");
				Item_AddToInventory("Fuel");
				Item_AddToInventory("Grenade");
				Item_AddToInventory("Grenade");;
				Item_AddToInventory("GasGrenade");		
				Item_AddToInventory("Ammunition");
				Item_AddToInventory("Grenade");
				Item_AddToInventory("Grenade");
				Item_AddToInventory("Torch");
				Item_AddToInventory("RabbitDoll");
				
				Revolver_LoadChamber(0);
				Revolver_LoadChamber(1);
				Revolver_LoadChamber(2);
				Revolver_LoadChamber(3);
			}
		}
		
		///////////////////////
		// Setup pathfinder
		mMapPathfinder.GeneratePlatformNodeEdgeCosts(true);
		mPlayerPathfinder.GeneratePlatformNodeEdgeCosts(false);
		mStalkerPathfinder.GeneratePlatformNodeEdgeCosts(false);
		
		///////////////////////
		// Generate gameplay space
		GenerateArena();		
		
		Map_AddTimer("Timer_SetupCurrentPlatforms", 0.1f, "OnTimer_SetupCurrentPlatforms");
		mBaseObj.GetEntityArrayID("Trigger_Bridge_*", eLuxEntityType_Area, "", mvBridgeTriggerIds);
		
		//////////////////////
		// Setup environment
		Lamp_SetLit("Lamp_PowerSwitch_2_10", Generator_GetState() == eGeneratorState_On, false);
		Lamp_SetupFlicker("Lamp_PowerSwitch_2_10", 0.1f, 1.f, 0.1f, 1.f, false, "level_entity_shared/lights/light_flicker");
		Lamp_SetFlickerActive("Lamp_PowerSwitch_2_10", true);
		
		cLightMaskBox@ pLightMask = mBaseObj.GetWorld().GetLightMask("LightMaskBox_DirLight");
		if (pLightMask !is null)
		{
			pLightMask.SetExcludeLight(true);
			mBaseObj.GetWorld().GetDirectionalLight().SetMask(pLightMask);
		}
		
		iLight@ pLightningLightA = mBaseObj.GetWorld().GetLight("lightning_flash_1");
		iLight@ pLightningLightB = mBaseObj.GetWorld().GetLight("lightning_flash_2");
		m_idLightningLightA = pLightningLightA !is null ? pLightningLightA.GetID() : tID_Invalid;
		m_idLightningLightB = pLightningLightB !is null ? pLightningLightB.GetID() : tID_Invalid;
		
		iLight@ pEntranceLight = mBaseObj.GetWorld().GetLight("Light_EntranceFlash");
		m_idEntranceLight = pEntranceLight !is null ? pEntranceLight.GetID() : tID_Invalid;
		
		iLight@ pStalkerEmergeLight = mBaseObj.GetWorld().GetLight("Light_StalkerFlash");
		m_idStalkerEmergeLight = pStalkerEmergeLight !is null ? pStalkerEmergeLight.GetID() : tID_Invalid;
				
		//////////////////////
		// Setup stalker
		{
			iLuxEntity@ pStalker = Map_GetEntity("Stalker_1", eLuxEntityType_Agent);
			m_idStalker = pStalker !is null ? pStalker.GetID() : tID_Invalid;
			
			array<iLuxEntity@> vBuildUpAreas;
			Map_GetEntityArray("Area_StalkerBuildUp_*", vBuildUpAreas);
			
			for (int i = 1; i < vBuildUpAreas.size() + 1; ++i)
			{
				iLuxEntity@ pArea = Map_GetEntity("Area_StalkerBuildUp_" + i, eLuxEntityType_Area);
				if (pArea is null) continue;
				
				mvStalkerBuildUpPositions.push_back(pArea.GetPosition());
			}
			
			iLuxEntity@ pEndArea = Map_GetEntity("Area_End", eLuxEntityType_Area);
			if (pEndArea !is null)
			{
				cScript_SetGlobalArgID(0, pEndArea.GetID());
				cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_SetEndArea");
			}
			
			for (int i = 0; i < mStalkerPathfinder.mvPlatformNodeGraph.size(); ++i)
			{
				cPlatformNode@ pNode = mStalkerPathfinder.mvPlatformNodeGraph[i];
				if (pNode is null) continue;
				
				cScript_SetGlobalArgVector3f(0, GetPlatformNodePosition(pNode.msName));
				cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_AddRetreatPosition");
			}
					
			Agent_AddAnimationHitbox("Stalker_1", "StalkerAnimationHitbox", "Socket_Stomach");
			
			array<tID> vBridgeIds;
			mBaseObj.GetEntityArrayID("Bridge_*", eLuxEntityType_Prop, "", vBridgeIds);
			
			cScript_SetGlobalArgInt(0, vBridgeIds.size());
			for (int i = 0; i < vBridgeIds.size(); ++i)
				cScript_SetGlobalArgID(i + 1, vBridgeIds[i]);
			
			cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_AddBridgeEntityIds");
		}
		
		//////////////////////
		// Setup entities
		Entity_SetActive("BlockBox_Ending_*", true);
		FogArea_SetVisible("fog_outside_pit", false);
		
		mBaseObj.GetEntityArrayID("Area_CeilingDebris_*", eLuxEntityType_Area, "", mvCeilingDebrisAreaIds);
		
		//////////////////////
		// Setup done
		mbSetup = false;
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{
		cLux_GetSaveHandler().AddWaitForMap(cLux_GetCurrentMap().GetName());
		
		////////////////////////
		// Set rich presence
		RichPresence_SetCurrent(eRichPresence_Arena);
		
		///////////////
		// Bombing effect
		BombingHandler_SetActive(false);
		
		///////////////////
		// Setup save game info hint
		SaveRoom_SetSaveHintActive(false);

		///////////////////////
		// Setup player body
		if (PlayerBody_IsActive() == false)
		{
			PlayerBody_SetActive(true);
			PlayerBody_SetModel("player_bunker.ent");
		}
		
		cScript_SetGlobalVarBool("GunMuffledEffectDisabled", true);
		
		///////////////////////
		// Disable player hurt speed mul
		Player_SetHealthSpeedMulActive(false);
		
		///////////////////////////////
		// Setup low height auto-teleport
		Player_SetAutoTeleportWhenBelowAltitude(-70.f);
		
		/////////////
		// Music
		Terror_SetEnemyMusicActive(false);
		
		////////////
		// Map change
		Game_SetupAfterMapChange();

		////////////
		// Disable shadows on Xbox/PS4 for lights in ceiling
		if(Platform_IsPS4() || Platform_IsXboxOne())
		{
			Light_SetCastShadows("Light_Spot_1", false);
			Light_SetCastShadows("Light_Spot_4", false);
			Light_SetCastShadows("Light_Spot_11", false);
			Light_SetCastShadows("Light_Spot_14", false);

			Light_SetCastShadows("lightning_flash_*", false);

			Billboard_SetVisible("Billboard_UnstableRift*", false); 
		}
	}
		
	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		cScript_SetGlobalVarBool("GunMuffledEffectDisabled", false);
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if (abPressed == false) return;
				
		if (alAction == eAction_Test0)
		{
			Player_Teleport("Start_Arena", true);
			SetLightningActive(true);
		}
		
		if (alAction == eAction_Test1)
		{
			OnTrigger_Player_SpawnStalker("", "", 1);
		}
		
		if (alAction == eAction_Test2)
		{
			Player_Teleport("Start_Arena", true);
			Prop_SetHealth("Bridge_BC_2", 0.f);
		}
		
		if (alAction == eAction_Test3)
		{
			Map_Preset_Fade("Outside", 1);
		}
		
		if (alAction == eAction_Test4)
		{
			Prop_SetHealth("Bridge_HZ_2", 0.f);
			Prop_SetHealth("Bridge_HZ_1", 0.f);
		}
		
		if (alAction == eAction_Test5)
		{
			//Agent_PlayCutsceneAnimation("Stalker_1", "alert", 0.3f, true);
			//Item_AddToInventory("Grenade");
			Item_AddToInventory("MolotovCocktail");
			Item_AddToInventory("GasGrenade");
		}
		
		if (alAction == eAction_Test6)
		{						
			//cScript_SetGlobalArgInt(0, 1);			
			//cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_UpdateBehaviour");
			cLux_AddTodoMessage("A:" + mPlayerPathfinder.msCurrentNode);
			cLux_AddTodoMessage("B:" + mStalkerPathfinder.msCurrentNode);
			
			array<cPlatformNode@> vTest = mStalkerPathfinder.GetPlatformNodePath(mStalkerPathfinder.msCurrentNode, mPlayerPathfinder.msCurrentNode);
			for (int i = 0; i < vTest.size(); ++i)
			{
				cLux_AddTodoMessage(""+vTest[i].msName);
			}
		}
		
		if (alAction == eAction_Test7)
		{
		    Seq_ExitBunkerWithStalker("");
		}
		
		if (alAction == eAction_Test8)
		{
			//Map_AddTimer("Timer_DoLightning", cMath_RandRectf(0.5f, 1.f), "OnTimer_DoLightning");
			OnStalkerFall();
			Entity_SetActive("Stalker_1", false);
		}
		
		if (alAction == eAction_Test9)
		{
			cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_Debug");
		}
		
		if (alAction == eAction_TestMinus)
		{						
			Seq_ExitBunkerNoStalker("");
		}
		
		if (alAction == eAction_TestPlus)
		{
			Prop_SetHealth("Bridge_HZ_1", 0.f);
			Prop_SetHealth("Bridge_HZ_2", 0.f);
			//Prop_SetHealth("Bridge_GH_1", 0.f);
			//Prop_SetHealth("Bridge_GH_2", 0.f);
			Map_GetEntity("Stalker_1").GiveDamage(null, 0, 0, eDamageType_Grenade, 1, 1, 1, 1, tID_Invalid, mBaseObj.GetNewAttackInstanceID());
		}
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont, float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
