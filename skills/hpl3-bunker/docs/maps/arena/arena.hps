		{
			if (abX)
			{
				mbStalkerHasBeenDesperate = true;
			}
				
			cScript_SetGlobalArgBool(0, abX);
			cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_SetIsDesperate");
		}
		
