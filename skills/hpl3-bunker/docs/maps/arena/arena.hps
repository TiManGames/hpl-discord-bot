		void SetAllowSlowdownTime(float afTime)
		{
			cScript_SetGlobalArgFloat(0, afTime);
			cScript_RunGlobalFunc("Stalker_1", "cScrAgentStalker", "_Global_BossFight_SetAllowSlowdownTime");
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_SpawnStalker(const tString &in asParent, const tString &in asChild, int alState)
		{
			OnTimer_SpawnStalker("");
			Entity_SetActive("Trigger_SpawnStalker_*", false);
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SpawnStalker(const tString &in asTimer)
		{
			if (cLux_GetPlayer().GetCurrentStateId() == ePlayerState_CutsceneAnimation)
			{
				Map_AddTimer("Timer_SpawnStalker", 0.1f, "OnTimer_SpawnStalker");
				return;
			}
			
			mbStalkerEmerging = true;
			
			Sound_CreateAtEntity("Sound_CrateBreak", "level_entity_shared/item_break/crate/break", "StalkerEmergeCrate", 0.f, false, 1.f, 1.f, 100.f);
			Prop_SetHealth("StalkerEmergeCrate", 0.f);
			
			Entity_SetActive("Stalker_1", true);
			Agent_SetSensesActive("Stalker_1", false);
			Agent_PlayCutsceneAtEntity("Stalker_1", "crawl_out_of_hole_ending", "Area_StalkerEmergeAnim", 0.f, false, "OnAnimEnd_StalkerEmerge");			
			
			Map_AddTimer("Timer_DoStalkerEmergeLightning", 0.5f, "OnTimer_DoStalkerEmergeLightning");
			Map_AddTimer("Timer_PlayerStalkerEmergeSound", 0.2f, "OnTimer_PlayerStalkerEmergeSound");
			
			Music_Play("Bunker_Arena_Hunt.ogg", 0.4f, true, eMusicPrio_BgAmb);
			
			Map_RemoveTimer("Timer_DoImpact");
			Map_AddTimer("Timer_DoImpact", cMath_RandRectf(7.f, 10.f), "OnTimer_DoImpact");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoStalkerEmergeLightning(const tString &in asTimer)
		{
			SetLightningActive(false);
			Light_SetBrightness("Light_StalkerFlash", 20.f);
			Map_AddTimer("Timer_ResetStalkerFlashLight", 6.f, "OnTimer_ResetStalkerFlashLight");
			
			Map_AddTimer("Timer_DoLightning", 0.f, "OnTimer_DoLightning");	
		}
		
