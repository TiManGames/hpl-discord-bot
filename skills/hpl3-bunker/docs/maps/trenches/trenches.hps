//--------------------------------------------------
 
/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/

//--------------------------------------------------

enum eShootGermanState
{
	eShootGermanState_Hide,
	eShootGermanState_Wait,
	eShootGermanState_Shoot,
}

//--------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("trenches");
		
		// Set up color grading etc.
		  Effect_Bloom_FadeBrightPass(0.2f, 1);
                  Effect_Bloom_FadeBloomWidth(128, 0.6);
                  Effect_Bloom_FadeBloomFalloff(1.5f, 1);
                  Effect_Bloom_FadeBloomTint(1.3, 1, 1, 1);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		//////////////
		// Preload materials
		Material_Preload("player_body_soldier_body_clean_wound.mat");
		Material_Preload("player_body_soldier_body_clean.mat");
		
		//////////////
		// Preload entities
		Entity_Preload("player_bunker.ent");
		Entity_Preload("player_bunker_clean.ent");
		Entity_Preload("concrete_block.ent");
		Entity_Preload("grenade_pickup.ent");
		Entity_Preload("ammo_bullets.ent");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		/////////////////////////
		// Debug
		if(cLux_ScriptDebugOn())
		{
		}
		
		/////////////////////////
		// Add gun
		if (ItemType_GetCountInInventory("Gun") == 0)
		{
			Item_AddToInventory("Gun");
		}
		
		/////////////////////////
		// Setup hints
		Hint_Block("Hints", "HintGrabThrow");
		Hint_Block("Hints", "HintGrabRotate");
		Hint_Block("Hints", "HintGrabMove");
		Hint_Block("Hints", "HintInjuredCreatures");
		Hint_Block("Hints", "HintInjuredCreaturesAltOne");
		Hint_Block("Hints", "HintInjuredCreaturesAltTwo");
		
		///////////////////
		// Setup germans
		mBaseObj.GetEntityArrayID("ShootGerman_*", eLuxEntityType_Prop, "", mvShootGermans);
		
		for (int i = 0; i < mvShootGermans.size(); ++i)
		{
			tString sGerman = "ShootGerman_" + (i + 1);
			SetShootGermanState(sGerman, eShootGermanState_Wait);
			Entity_SetVarBool(sGerman, "DoAgentBulletImpact", true);
			
			mvAliveShootGermans.push_back(sGerman);
		}
		
		Decal_SetDynamicVisible("Decal_AmbushGermanBlood", false);
				
		///////////////////
		// Setup gas sequence
		ParticleSystem_SetActive("PS_ExtraGas_*", false);
		ParticleSystem_SetVisible("PS_ExtraGas_*", false);
				
		////////////////////
		// Setup player
		Player_SetCheckHealthAllowed(false);
		
		///////////////////
		// Intro sequence
		if (cLux_ScriptDebugOn())
		{
			mbIntroTextDone = true;
		}
		else
		{
			mbIntroTextDone = false;
			
			Effect_Fade_Out(0.f);
			Sound_FadeGlobalVolume(0.f, 0.f, eSoundEntryType_WorldAll);
			Sound_PlayGui("trenches/dream/quote_start", 1.0);
			
			Player_SetActive(false);
		}

		cLux_PreloadMap("no_mans_land.hpm");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		////////////////////////
		// Set rich presence
		RichPresence_SetCurrent(eRichPresence_Trenches);
		
		///////////////////////
		// Setup player body
		if (PlayerBody_IsActive() == false)
		{
			PlayerBody_SetActive(true);
			PlayerBody_SetModel("player_bunker_clean.ent");
		}
		
		///////////////////////////////
		// Setup low height auto-teleport
		Player_SetAutoTeleportWhenBelowAltitude(-20.f);
		
		Player_AttachHelmet("PlayerHelmet");

		/////////////////////////
		// Audio
		//Sound_Play("Sound_War*", 1.0f);
		Sound_Play("Sound_Amb*", 1.0f);	
		
		////////////////
		// Setup bombing effect
		BombingHandler_SetActive(false);
		
		///////////////////
		// Setup save game info hint
		SaveRoom_SetSaveHintActive(false);
		
		if (cLux_ScriptDebugOn()==false)
			Sketchbook_SetCanOpen(false);
			
		Sketchbook_SetInventoryEnabled(false);
		
		//if (mbIntroTextDone)
		//	SaveRoom_SaveGame(false, false);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		/////////////////////////
		// Reset player
		Player_SetHealthRegenSpeedMul(1.f);
		Player_SetJumpForceMul(1.f);
		Player_SetIgnoreGasDamage(false);
		//Player_SetFallDamageActive(true);
		Player_SetMoveSpeedMul(1.f);
		Player_SetLookSpeedMul(1.f);
		Player_SetRunSpeedMul(1.f);
		Player_SetCheckHealthAllowed(true);
		Player_SetBleedingActive(true);
		PlayerBody_ClearCustomBoneOffsets();
		Sketchbook_SetInventoryEnabled(true);
		EnvironmentalDamage_SetNoDeathDamageActive(false);
		
		/////////////////////////
		// Unblock hints
		Hint_Unblock("Hints", "HintGrabThrow");
		Hint_Unblock("Hints", "HintGrabRotate");
		Hint_Unblock("Hints", "HintGrabMove");
		Hint_Unblock("Hints", "HintInjuredCreatures");
		Hint_Unblock("Hints", "HintInjuredCreaturesAltOne");
		Hint_Unblock("Hints", "HintInjuredCreaturesAltTwo");
	}

	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if (abPressed==false) return;
		
		/////////////////////
		// Test keys
		if (alAction == eAction_Test0)
		{
			cVector3f vStart = cLux_GetViewport().GetCamera().GetPosition();
			cVector3f vDir = cLux_GetViewport().GetCamera().GetForward();
			BulletHandler_AddBullet(vStart, vDir, eBulletType_Shotgun, tID_Invalid);
		}
		
		if (alAction == eAction_Test1)
		{
			GameDifficulty_SetSettingValueIdByID(eGameDifficultySetting_HardcoreHealthSystem, 1);
		}
		
		if (alAction == eAction_Test2)
		{
			Entity_PlayAnimation("german_soldier_1", "kneel", 0.3f, true, true);
		}
		
		if (alAction == eAction_Test3)
		{			
			//Prop_SetCustomMaterial(PlayerBody_GetEntityName(), "player_body_soldier_body_clean_wound.mat", "player_body_soldier_body");
			Prop_SetCustomMaterial(PlayerBody_GetEntityName(), "player_body_soldier_body_clean.mat", "player_body_soldier_body");
		}
		
		if (alAction == eAction_Test4)
		{
			StartEndSequence();
		}
		
		if (alAction == eAction_Test5)
		{
			Seq_EnterTrenches("");
		}
		
		if (alAction == eAction_Test6)
		{
			Entity_SetActive("ShootGerman_1", true);
			Entity_PlayAnimation("ShootGerman_1", "die_fall", 0.f, false);
		}
		
		if (alAction == eAction_Test7)
		{
			cLux_AddTodoMessage(""+mvAliveShootGermans.size());
		}
		
		if (alAction == eAction_Test8)
		{
			GermanRunTo("RunGerman_5", 5.2f, "Area_RunGermanGas_Goal");
		}
		
		if (alAction == eAction_Test9)
		{
			//ThrowGasGrenade("GasGrenade_5");
			Player_PlaceAtEntity("Area_GasCutscene", true, true);
			StartEndSequence();
		}
		
		if (alAction == eAction_TestMinus)
		{
			Player_FadeDreamLights(0.f, 3.f);
		}
		
		if (alAction == eAction_TestPlus)
		{
			Effect_Fade_Out(1.f);
			Player_FadeDreamLights(1.f, 3.f);
			Player_SetupDreamLightsSound("trenches/dream/dice", "Comments", 0.8f);
			
			Sound_PlayGui("trenches/dream/dice", 1.0f);
			Voice_PlayDelayed("Dialogue_DiceGame", 2.5f);
		}
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont, float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
	
	//-------------------------------------------------------
 
	//} END MAIN CALLBACKS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
		
	//-------------------------------------------------------
	
	bool mbIntroTextDone = false;
	float mfIntroTextCount = 0.f;
	float mfIntroTextAlpha = 0.f;
	float mfTempAudioPromptAlpha = 0.f;
	
	//-------------------------------------------------------
	
	void OnGui(float afTimeStep)
	{		
		//////////////////////
		// Intro text
		if (mbIntroTextDone == false &&
			cLux_ScriptDebugOn() == false)
		{		
			float fPrevIntroTextCount = mfIntroTextCount;
			mfIntroTextCount += afTimeStep;				
			
			if (mfIntroTextCount > 3.f)
			{
				if (fPrevIntroTextCount <= 3.0f)
					Sound_AddClosedCaption("GeneralClosedCaptions", "Trenches_IntroGunfire", 10);
					
				bool bFadeOut = mfIntroTextCount > 14.f;							
				float fAlphaGoal = bFadeOut ? 0.f : 1.f;
				float fFadeSpeed = bFadeOut ? 5.f : 5.f;
					
				mfIntroTextAlpha = cMath_IncreaseTo(mfIntroTextAlpha, (1.f / fFadeSpeed) * afTimeStep, fAlphaGoal);
				
				if (fPrevIntroTextCount < 16.f && mfIntroTextCount >= 16.f)
				{
					Player_FadeDreamLights(1.f, 7.f);
					Player_SetupDreamLightsSound("trenches/dream/quote_start", "", 1.f);
				}				
				
				///////////////////
				// Start intro?
				if (bFadeOut && mfIntroTextAlpha <= 0.f)
				{
					mbIntroTextDone = true;					
					Seq_EnterTrenches("");
					Sound_PlayGui("trenches/dream/run_sweet", 0.9);
				}
					
				///////////////
				// Draw text
				ImGui_LayoutBegin(eImGuiLayout_Y, ImGui_NrmPos(0.f, 0.f, 1.f), ImGui_NrmSize(0.5f, 0.5f));
					
					cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
					textData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
					textData.mFontAlign = eFontAlign_Left;
					textData.mFont.mvSize = cVector2f(20.f);
					textData.mbUseBackgroundGfx = false;
					textData.mFont.mColor = cColor_White;

					ImGui_SetAlignment(eImGuiAlign_CenterCenter);				
					ImGui_SetModColorMul(cColor(1.f, 1.f, 1.f, mfIntroTextAlpha));				
					ImGui_SetTransCategory("BunkerTest");
					ImGui_DoTextFrameExt("IntroText", cVector2f_Zero, 0.f, 0.f, textData, ImGui_NrmPosGroup(0.25f, 0.4f, 0.1f), ImGui_NrmSizeGroup(0.5));
					ImGui_SetTransCategory("");
						
					ImGui_SetAlignment(eImGuiAlign_TopLeft);
					ImGui_ResetModifiers();
					
				ImGui_LayoutEnd();
			}
		}
	}
	
	//-------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		//////////////////////
		// Germans aim at player
		cVector3f vPlayerPos = cLux_GetPlayer().GetCharacterBody().GetPosition();
		
		for (int i = 0; i < mvShootGermans.size(); ++i)
		{
			cLuxProp@ pProp = cLux_ID_Prop(mvShootGermans[i]);
			cMeshEntity@ pMeshEnt = pProp !is null ? pProp.GetMeshEntity() : null;
			cBoneState@ pRoot = pMeshEnt !is null ? pMeshEnt.GetBoneStateFromName("j_BaseRoot") : null;
			cBoneState@ pSpine = pMeshEnt !is null ? pMeshEnt.GetBoneStateFromName("j_Spine_03") : null;
			
			if (pProp is null) continue;
			if (pMeshEnt is null) continue;
			if (pRoot is null) continue;
			if (pSpine is null) continue;
			if (pProp.GetVarBool("Dead"))
			{
				pSpine.SetUsePreTransform(false);
				continue;
			}
			
			//////////////////////
			// Get angles
			cMatrixf mtxRootTranspose = pRoot.GetWorldMatrix().GetTranspose();
			cVector3f vPos = pRoot.GetWorldPosition();
			cVector3f vFwd = cMath_Vector3Normalize(mtxRootTranspose.GetForward());
			cVector3f vRight = cMath_Vector3Normalize(mtxRootTranspose.GetRight());
			cVector3f vToPlayer = cMath_Vector3Normalize(vPlayerPos - vPos);
				
			float fAngleStartY = cMath_GetAngleFromPoints3D(0.f, vFwd).y;
			float fAngleGoalY = cMath_GetAngleFromPoints3D(0.f, vToPlayer).y;
			float fAngleY = cMath_GetAngleDistanceRad(fAngleStartY, fAngleGoalY);
			fAngleY -= cMath_ToRad(15.f);
				
			cVector3f vPlaneX = cMath_Vector3ProjectOnPlane(vToPlayer, vRight);
			float fAngleX = cMath_Vector3Angle(vFwd, vPlaneX) * cMath_Sign(vPlaneX.y) * -1.f;
			fAngleX = cMath_Clamp(fAngleX, -cMath_ToRad(10.f), cMath_ToRad(27.f));
			
			//////////////////////
			// Update bone rotation
			pSpine.SetUsePreTransform(true);
			pSpine.SetPreTransform(cMath_MatrixRotateXYZ(cVector3f(fAngleX, fAngleY, 0.f)));
		}
	}
	
	//-------------------------------------------------------
	
	void OnDamageTaken(const tString &in asSource, int alType)
	{
		/////////////////////
		// Take gas damage, start end seq
		if (alType == eDamageType_Gas && 
			mbEndSequenceStarted == false)
		{
			++mlGasDamageTakenCount;
			mlGasDamageTimeStamp = mBaseObj.GetTimeStamp();
			
			if (mlGasDamageTakenCount >= 2 && mbExtraGasAdded)
			{
				StartEndSequence();
			}
		}
		
		/////////////////////
		// Gun damage, switch to wounded player texture
		else if (alType == eDamageType_Gun && 
				 mbPlayerHurtInAmbush == false)
		{
			mbPlayerHurtInAmbush = true;
			Prop_SetCustomMaterial(PlayerBody_GetEntityName(), "player_body_soldier_body_clean_wound.mat", "player_body_soldier_body");
		}
	}
	
	//-------------------------------------------------------
	
	void OnPlayerHeal(float afAmount)
	{
		if (mbPlayerHurtInAmbush)
		{
			Prop_SetCustomMaterial(PlayerBody_GetEntityName(), "player_body_soldier_body_clean.mat", "player_body_soldier_body");
		}
	}
	
	//-------------------------------------------------------
	
	void OnGunshot()
	{
		Map_AddTimer("Timer_SpawnBullet", 1.f, "OnTimer_SpawnBullet");
	}
	
	//-------------------------------------------------------
	
	void OnExplosion(const tString&in asEntity)
	{
		Map_AddTimer("Timer_SpawnGrenade", 1.f, "OnTimer_SpawnGrenade");
	}
	
	//-------------------------------------------------------
	
	void OnPlayerBulletHit(const tString &in asEntity, const tString &in asBody)
	{
		HitGerman(asEntity, asBody);
	}
	
	//-------------------------------------------------------
	
	void OnFriendBulletHit(const tString &in asEntity, const tString &in asBody)
	{
		tString sGerman = asEntity;
		if (sGerman != "")
			HitGerman(sGerman, asBody);
	}
	
	//-------------------------------------------------------
	
	void OnGermanBulletHit(const tString &in asEntity, const tString &in asBody)
	{
		if (asEntity == "Player")
		{
			mbPlayerShotByGermans = true;
		}
	}
	
	//-------------------------------------------------------
		
	void OnGasMaskEquip()
	{
		ResumeEndSequence();
	}
	
	//-------------------------------------------------------
		
	void OnTimer_PlaySubjectLine(const tString &in asTimer)
	{
		Voice_Play(asTimer, Map_GetTimerUserVarInt(asTimer));
	}
	
