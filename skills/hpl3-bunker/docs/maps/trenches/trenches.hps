		////////////////////////////////////////////////////////////
		// Event: Start random war cries
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartRandomWarCries(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_PlayRandomWarCry", 1.f, "OnTimer_PlayRandomWarCry");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayRandomWarCry(const tString &in asTimer)
		{
			bool bPlay = true;
			
			if (Voice_AnySceneIsActive())
				bPlay = false;
			if (mbGermanAmbushActive)
				bPlay = false;
			if (mbGasRescueActive)
				bPlay = false;
			
			if (bPlay)
			{
				float fDist = cMath_RandRectf(45.f, 60.f);
				float fAngle = cMath_RandRectf(0.f, cMath_PiMul2);
				cVector3f vDir = cMath_MatrixMul(cMath_MatrixRotateY(fAngle), cVector3f_Forward);
				
				iLuxEntity@ pEnt = Map_GetEntity("Area_WarCryVoice", eLuxEntityType_Area);
				if (pEnt !is null)
				{
					pEnt.SetPosition(Player_GetPosition() + vDir * fDist);
					Voice_SetSource("FrenchSoldiers", pEnt.GetName(), 1.f, 65.f, true);
				}		
				
				Voice_Play("Dialogue_WarCries_English");
			}
			
			float fTime = cMath_RandRectf(40.f, 60.f);
			if (bPlay == false) fTime *= 0.5f;
			
			Map_AddTimer("Timer_PlayRandomWarCry", fTime, "OnTimer_PlayRandomWarCry");
		}
		
		//-------------------------------------------------------
		
		//} END Event: Start random war cries
		
		////////////////////////////////////////////////////////////
		// Event: Throw brick on GATE
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		cMatrixf m_mtxBrickOnLoad = cMatrixf_Identity;
		
		//-------------------------------------------------------
		
		void OnInteract_Brick(const tString &in asEntity)
		{
			cLuxProp@ pProp = Map_GetProp(asEntity);
			if (pProp !is null)
			{
				m_mtxBrickOnLoad = pProp.GetOnLoadTransform();
			}			
			
			Hint_ReleaseAll();
			Hint_Block("Hints", "HintGrabHowTo");
			Hint_Block("Hints", "HintGrabHowTo_Toggle");
			
			Map_AddTimer("Timer_ShowThrowHint", 0.5f, "OnTimer_ShowThrowHint");
			Map_AddTimer("Timer_RespawnBrick", 0.1f, "OnTimer_RespawnBrick");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowThrowHint(const tString &in asTimer)
		{			
			Hint_Unblock("Hints", "HintGrabThrow");
			Hint_Unblock("Hints", "HintGrabHowTo");
			Hint_Unblock("Hints", "HintGrabHowTo_Toggle");
			
			if (Hint_GetCurrentEntry() != "HintGrabThrow")
			{
				Hint_StopHint();
				Hint_ShowHint_Hold("Hints", "HintGrabThrow", true, 1.5f, false, 15.f, false, true);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_RespawnBrick(const tString &in asTimer)
		{
			/////////////////////////
			// Setup vars
			bool bRespawn = false;			
			
			cLuxProp@ pProp = Map_GetProp("Brick");
			cLuxArea@ pArea = cLux_ToArea(Map_GetEntity("Area_BrickLimits", eLuxEntityType_Area));
			cBoundingVolume@ pBounds = pArea !is null ? pArea.GetAreaBody().GetBoundingVolume() : null;			
			
			/////////////////////////
			// Out of bounds or been deactivated?
			if (pProp is null)
			{
				bRespawn = true;
			}
			else if (pProp.GetMainBody().IsActive() == false)
			{
				bRespawn = true;
			}
			else if (pBounds !is null)
			{
				cVector3f vPos = pProp.GetPosition();
				cVector3f vFwd = pArea.GetMatrix().GetTranspose().GetForward();
				cVector3f vToBrick = cMath_Vector3Normalize(vPos - pArea.GetPosition());
				
				if (vPos.y > pBounds.GetMax().y && pProp.IsSleeping())
				{
					bRespawn = true;
				}
				else if (vPos.y < pBounds.GetMin().y)
				{
					bRespawn = true;
				}
				else if (cMath_Vector3Dot(vFwd, vToBrick) > 0.f && pProp.IsSleeping())
				{
					bRespawn = true;
				}
			}
			
			/////////////////////////
			// Respawn!
			if (bRespawn)
			{
				if (pProp !is null)
				{
					mBaseObj.DestroyEntity(pProp);
				}
				
				mBaseObj.CreateEntity("Brick", "concrete_block.ent", m_mtxBrickOnLoad, cVector3f(1.f));
			}
			
			Map_RestartCurrentTimer();
		}
		
		//-------------------------------------------------------
		
		void OnBreak_Gate(const tString &in asEntity)
		{
			Map_RemoveTimer("Timer_RespawnBrick");
			
			cLuxProp@ pProp = Map_GetProp("Brick");
			if (pProp !is null)
			{
				pProp.SetDisableBreakable(false);
				pProp.Break();
			}
		}
		
		//-------------------------------------------------------
		
		//} END Event: Throw brick on GATE
		
