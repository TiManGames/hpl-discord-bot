		//-------------------------------------------------------
		
		bool OnTrigger_Player_ShowInjuredHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			Map_AddTimer("Timer_ShowInjuredHint", 0.2f, "OnTimer_ShowInjuredHint");
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowInjuredHint(const tString &in asTimer)
		{
			Player_SetCheckHealthAllowed(true);
			
			tString sHint = "HintInjured";
			if (GameDifficulty_GetSettingValueByID_Bool(eGameDifficultySetting_HardcoreHealthSystem))
				sHint = "HintInjuredAlt";
				
			if (cLux_GetUserConfig().GetInt("Accessibility", "CheckHealthMode", 0) == 1)
				sHint += "_Toggle";
				
			if (Hint_IsGiven("Hints", sHint))
				return;
			
			Hint_StopHint();
			Hint_ShowHint_Hold("Hints", sHint, true, 1.5f, true, 15.f, true, true);
			
			Hint_AddAsGiven("Hints", "HintInjured");
			Hint_AddAsGiven("Hints", "HintInjured_Toggle");
			Hint_AddAsGiven("Hints", "HintInjuredAlt");
			Hint_AddAsGiven("Hints", "HintInjuredAlt_Toggle");
		}
		
		//-------------------------------------------------------

		//} END Event: Show injured hint
		
