		////////////////////////////////////////////////////////////
		// Event: Ambushed by germans
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlTotalGermanShootCount = 0;
		int mlShotGermanCount = 0;
		int mlGermanShootMissCount = 2;
		bool mbPlayerShotByGermans = false;
		bool mbGermanRunnersStarted = false;
		bool mbGermanAmbushStarted = false;		
		bool mbForceHitPlayer = false;
		bool mbGermanAmbushActive = false;
		array<tID> mvShootGermans;
		array<tString> mvAliveShootGermans;
		
		//-------------------------------------------------------
		
		void OnLookAt_StartGermanRunners(const tString &in asEntity, int alState)
		{
			StartGermanRunners();
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartGermanRunners(const tString &in asParent, const tString &in asChild, int alState)
		{
			StartGermanRunners();
			Sound_Play("Sound_WarNear_*", 1.0f);
			return false;
		}
		
		//-------------------------------------------------------
		
		void StartGermanRunners()
		{
			if (mbGermanRunnersStarted)
				return;
				
			mbGermanRunnersStarted = true;
			
			GermanRunTo("RunGerman_1", 5.4f, "Area_RunGerman_Goal");
			GermanRunTo("RunGerman_2", 5.2f, "Area_RunGerman_Goal");
			GermanRunTo("RunGerman_3", 5.f, "Area_RunGerman_Goal");
			GermanRunTo("RunGerman_4", 5.2f, "Area_RunGerman_Goal");
			
			Voice_PlayDelayed("Dialogue_GermanSoldiersAttack_Intro", 0.2f, 0);
			Voice_SetSource("GermanSoldier_4", "RunGerman_1", 1.f, 40.f, true);
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_StartGermanAmbush(const tString &in asEntity, int alState)
		{
			StartGermanAmbush();
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartGermanAmbush(const tString &in asParent, const tString &in asChild, int alState)
		{
			mlGermanShootMissCount = 0; // Always hit player if they've entered this trigger
			StartGermanAmbush();
			return false;
		}
		
		//-------------------------------------------------------
		
		void StartGermanAmbush()
		{
			if (mbGermanAmbushStarted)
				return;

			mbGermanAmbushStarted = true;
			mbGermanAmbushActive = true;
			
			Player_SetJumpForceMul(0.8f);
			
			Map_AddTimer("ShootGerman_1", 0.8f, "OnTimer_GermanStartShoot");
			Map_AddTimer("ShootGerman_2", 0.2f, "OnTimer_GermanStartShoot");
			Map_AddTimer("ShootGerman_3", 1.4f, "OnTimer_GermanStartShoot");
			Map_AddTimer("ShootGerman_4", 0.4f, "OnTimer_GermanStartShoot");
			
			Map_AddTimer("Timer_FriendEndsAmbush", 20.f, "OnTimer_FriendEndsAmbush");
			Map_AddTimer("Timer_PlayAmbushDialogue", 10.f, "OnTimer_PlayAmbushDialogue");
			
			Voice_SetSource("GermanSoldier_1", "Area_ShootGermanVoice", 1.f, 50.f, true);
			Voice_SetSource("GermanSoldier_2", "Area_ShootGermanVoice", 1.f, 50.f, true);
			Voice_PlayDelayed("Dialogue_GermanSoldiersAttack_SpotPlayer", 0.3f, 0);	
			Voice_PlayDelayed("Dialogue_GermanSoldiersAttack_Intro", 1.7f, 1);

			for (int i = 1; i < 5; ++i)
				Player_AddAimAssistTarget(Entity_GetID("ShootGerman_" + i), "j_Spine_03", "Dead", cVector3f(0.f, 0.25f, 0.f), 1.f, 35.f, -1.f, false, true, -1);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayAmbushDialogue(const tString &in asTimer)
		{
			if (mvAliveShootGermans.size() <= 2) return;
			
			tString sDialogue;
			int lLineId;
			cVector3f vStart = Entity_GetPosition("Area_AmbushPlayerLosCheck");
			cVector3f vEnd = Player_GetCameraPosition();
			
			if (cLux_CheckLineOfSight(vStart, vEnd, false, false, null))
			{
				sDialogue = "Dialogue_GermanSoldiersAttack_SpotPlayer";
				lLineId = 1;
			}
			else
			{
				sDialogue = "Dialogue_GermanSoldiersAttack_PlayerHiding";
				lLineId = 0;
			}
			
			Voice_SetSource("GermanSoldier_2", "Area_ShootGermanVoice", 1.f, 50.f, true);
			Voice_Play(sDialogue, lLineId);
		}
		
		//-------------------------------------------------------
		
		void HitGerman(const tString &in asEntity, const tString &in asBody)
		{
			//////////////////////
			// Hit a german?
			if (Entity_IsActive(asEntity) && 
				Entity_GetVarBool(asEntity, "Dead") == false &&
				cString_GetFirstStringPos(asEntity, "ShootGerman") != -1)
			{			
				++mlShotGermanCount;				
				Map_RemoveTimer(asEntity);
				
				tString sDeathAnim;
				int lSuffix = cString_GetNumericSuffixInt(asEntity);
				
				switch (lSuffix)
				{
					case 1: sDeathAnim = "die_fall"; break;
					case 2: sDeathAnim = "die_3"; 	 break;
					case 3: sDeathAnim = "die_1"; 	 break;
					case 4: sDeathAnim = "die_2"; 	 break;
				}
				
				Entity_PlayAnimation(asEntity, sDeathAnim, 0.1f);
				Entity_SetVarBool(asEntity, "Dead", true);
				Entity_SetCollide(asEntity, false);
				
				int lId = mvAliveShootGermans.find(asEntity);
				if (lId != -1)
					mvAliveShootGermans.removeAt(lId);
					
				if (sDeathAnim == "die_fall")
					Map_AddTimer("Timer_ActivateAmbushGermanBlood", 2.f, "OnTimer_ActivateAmbushGermanBlood");
				
				Player_RemoveAimAssistTarget(Entity_GetID(asEntity));
				
				//////////////////////
				// Start friend seq?
				if (mlShotGermanCount >= 2)
				{
					StartSeqFriendEndsAmbush();
				}
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ActivateAmbushGermanBlood(const tString &in asTimer)
		{
			Decal_SetDynamicVisible("Decal_AmbushGermanBlood", true);
			Entity_SetActive("BlockBox_FallAmbushGerman", true);
		}
		
		//-------------------------------------------------------
		
		void GermanRunTo(const tString &in asGerman, float afSpeed, const tString &in asGoal)
		{
			int lAnimId = cString_GetNumericSuffixInt(asGerman) % 2 == 0 ? 1 : 2;
			tString sAnim = "run_" + lAnimId;
			
			Entity_SetActive(asGerman, true);			
			Entity_PlayAnimation(asGerman, sAnim, 0.f, true);
			Entity_SetAnimationRelativeTimePosition(asGerman, sAnim, cMath_RandRectf(0.f, 1.f));
			
			Prop_MoveLinearTo(asGerman, asGoal, 100.f, afSpeed, 0.1f, true, "OnMoveLinear_GermanMove");
		}
		
		//-------------------------------------------------------
		
		void OnMoveLinear_GermanMove(const tString &in asProp)
		{
			SetGermanSoldierActive(asProp, false);
		}
		
		//-------------------------------------------------------
		
		void SetShootGermanState(const tString &in asGerman, eShootGermanState aState)
		{		
			/////////////////
			// Setup vars
			cLuxProp@ pProp = Map_GetProp(asGerman);
			cAnimationState@ pAnim = pProp !is null ? pProp.GetCurrentAnimationState() : null;
			
			if (pProp is null) return;
			if (pProp.IsActive() == false) return;
			if (pProp.GetVarBool("Dead")) return;
			
			/////////////////
			// Hide
			if (aState == eShootGermanState_Hide ||
				aState == eShootGermanState_Wait)
			{
				Entity_PlayAnimation(asGerman, "prone", 0.1f, true);
				SetShootGermanHitboxActive(asGerman, false, 0.3f);
				
				if (aState != eShootGermanState_Wait)
					Map_AddTimer(asGerman, cMath_RandRectf(3.f, 6.f), "OnTimer_GermanStartShoot");
			}
			
			/////////////////
			// Shoot
			else if (aState == eShootGermanState_Shoot)
			{
				if (pAnim is null || 
					(pAnim.GetName() != "kneel" &&
					 pAnim.GetName() != "shoot_1" &&
					 pAnim.GetName() != "shoot_2"))
				{
					Entity_PlayAnimation(asGerman, "kneel", 0.1f, true);
					SetShootGermanHitboxActive(asGerman, true, 0.3f);
					
					if (SequenceStates_IsActive("Seq_FriendEndsAmbush"))
						return;
			
					Map_AddTimer(asGerman, cMath_RandRectf(1.f, 1.2f), "OnTimer_GermanShoot");
					Map_SetTimerUserVarInt(asGerman, 0);
				}				
			}
		}
		
		//-------------------------------------------------------
		
		void SetShootGermanHitboxActive(const tString &in asGerman, bool abX, float afDelay)
		{
			Map_AddTimer("Timer_SetShootGermanHitboxActive", afDelay, "OnTimer_SetShootGermanHitboxActive");
			Map_SetTimerUserVarString("Timer_SetShootGermanHitboxActive", asGerman);
			Map_SetTimerUserVarInt("Timer_SetShootGermanHitboxActive", abX ? 1 : 0);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SetShootGermanHitboxActive(const tString &in asTimer)
		{
			tString sGerman = Map_GetTimerUserVarString(asTimer);
			bool bCollide = Map_GetTimerUserVarInt(asTimer) == 1;
			iLuxEntity@ pGerman = Map_GetEntity(sGerman, eLuxEntityType_Prop);
			
			if (pGerman !is null)
			{
				pGerman.GetBodyFromName("Body_2").SetCollide(bCollide);
			}
		}
		
		//-------------------------------------------------------
		
		void SetGermanSoldierActive(const tString &in asEntity, bool abX)
		{
			Entity_SetActive(asEntity, abX);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_GermanStartShoot(const tString &in asTimer)
		{
			SetShootGermanState(asTimer, eShootGermanState_Shoot);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_GermanShoot(const tString &in asTimer)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asTimer, eLuxEntityType_Prop);
			cNode3D@ pSocket = pEnt !is null ? pEnt.GetMeshEntity().GetSocket("RifleSocket") : null;
			
			if (pEnt is null) 				return;
			if (pEnt.IsActive() == false) 	return;
			if (pSocket is null) 			return;
			
			///////////////////
			// Shot enough?
			int lMaxShots = cMath_RandRectl(1, 4);
			int lShotCount = Map_GetTimerUserVarInt(asTimer);
			
			if (lShotCount >= lMaxShots && mbFriendEndsAmbush == false)
			{
				SetShootGermanState(asTimer, eShootGermanState_Hide);
				return;
			}
			
			///////////////////
			// Shoot
			++mlTotalGermanShootCount;
			
			bool bMiss = mlTotalGermanShootCount < mlGermanShootMissCount;
			bool bForceHit = mbForceHitPlayer ||
							 (mbPlayerShotByGermans == false &&
							  (mlTotalGermanShootCount >= mlGermanShootMissCount || Player_GetRunning()));
			
			cVector3f vStart = pSocket.GetWorldPosition();
			
			// Offset for the one on the side, so he doesn't shoot into the sand bags
			if (asTimer == "ShootGerman_4")
			{
				cMatrixf mtxSocketTranspose = pSocket.GetWorldMatrix().GetTranspose();
				vStart += mtxSocketTranspose.GetForward() * 0.5f + mtxSocketTranspose.GetRight() * -0.5f;
			}
			
			cVector3f vGoalPos = bForceHit ? Player_GetCameraPosition() : Player_GetPosition();
			cVector3f vDir = cMath_Vector3Normalize(vGoalPos - vStart);				
				
			if (bForceHit == false)
			{	
				float fAccuracyOffsetY = cMath_ToRad(cMath_RandRectf(-8.f, 8.f));
				float fAccuracyOffsetX = cMath_ToRad(cMath_RandRectf(0.f, 8.f));
				
				if (bMiss)
					fAccuracyOffsetX = cMath_Clamp(fAccuracyOffsetX * 2.f, 8.f, 16.f);
				
				fAccuracyOffsetX *= cMath_Sign(cMath_RandRectf(-1.f, 1.f));
				
				cVector3f vAccuracyOffset = cVector3f(fAccuracyOffsetX, fAccuracyOffsetY, 0.f);					
				vDir = cMath_Vector3Normalize(cMath_MatrixMul(cMath_MatrixRotateXYZ(vAccuracyOffset), vDir));
			}
			
			int lBulletId = BulletHandler_AddBullet(vStart, vDir, eBulletType_Shotgun, tID_Invalid, "OnGermanBulletHit");
			BulletHandler_SetMinPlayerHealth(lBulletId, 0.5f);
				
			///////////////////
			// Effects
			tString sShootAnim = "shoot_" + cMath_RandRectl(1, 2);
			Entity_PlayAnimation(asTimer, sShootAnim, 0.1f, false, false, "OnAnimEnd_GermanShoot");
			
			Sound_CreateAtEntity("Sound_GermanGunfire", "trenches/enemy/fire", asTimer);
			Sound_AddClosedCaption("GeneralClosedCaptions", "Trenches_Gunfire", -1, true, vStart);
				
			cParticleSystem@ pPS = ParticleSystem_CreateAtEntity("PS_GermanGunfire", "rifle_fire.ps", pEnt.GetName(), false);			
			pPS.SetWorldMatrix(pSocket.GetWorldMatrix());
			
			///////////////////
			// Shoot again
			Map_RestartCurrentTimer(cMath_RandRectf(0.5f, 1.f));
			Map_IncTimerUserVarInt(asTimer, 1);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_GermanShoot(const tString &in asEntity, const tString &in asAnim)
		{
			Entity_PlayAnimation(asEntity, "kneel", 0.1f, true);
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_ForceHitPlayer(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1) return true;
			
			mbForceHitPlayer = Entity_PlayerIsInFront(asParent);
			
			if (mbForceHitPlayer)
			{
				for (int i = 1; i < 5; ++i)
				{
					tString sGerman = "ShootGerman_" + i;
					
					if (Entity_IsActive(sGerman))
					{
						Map_RemoveTimer(sGerman);
						SetShootGermanState(sGerman, eShootGermanState_Shoot);
						break;
					}
				}
			}
			
			return true;
		}
		
		//-------------------------------------------------------

		//} END Event: Ambushed by germans
		
		//-------------------------------------------------------
		
		////////////////////////////////////////////////////////////
		// Event: Friend ends ambush
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		int mlFriendShotCount = 5;
		bool mbFriendEndsAmbush = false;
		bool mbPlayerSawFriend = false;
		bool mbPlayerNearAmbushExit = false;
		bool mbGetPlayerAttentionDialoguePlayed = false;
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartSeqFriendEndsAmbush(const tString &in asParent, const tString &in asChild, int alState)
		{
			mbPlayerNearAmbushExit = true;
			StartSeqFriendEndsAmbush();
			return false;
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FriendEndsAmbush(const tString &in asTimer)
		{
			StartSeqFriendEndsAmbush();
		}
		
		//-------------------------------------------------------
		
		void StartSeqFriendEndsAmbush()
		{
			if (mbFriendEndsAmbush) return;
			
			mbFriendEndsAmbush = true;
			Seq_FriendEndsAmbush("");
			
			Voice_SetSource("AugustinLambert", "Friend_Ambush", 5.f, 50.f, true);
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataFriendEndsAmbush;
		void Seq_FriendEndsAmbush(const tString &in asTimer)
		{
			Sequence_Begin("Seq_FriendEndsAmbush", mSeqDataFriendEndsAmbush);
			if (Sequence_DoStepAndWait(3.5f))
			{
				Voice_SetSource("GermanSoldier_1", "Area_ShootGermanVoice", 1.f, 50.f, true);
				Voice_SetSource("GermanSoldier_2", "Area_ShootGermanVoice", 1.f, 50.f, true);
				
				Voice_Play("Dialogue_GermanSoldiersAmbushed", 0);
								
				Map_AddTimer("Miss", 0.55f, "OnTimer_FriendShoot");
				Map_AddTimer("HitGerman", 0.9f, "OnTimer_FriendShoot");
				Map_AddTimer("Miss", 1.6f, "OnTimer_FriendShoot");
				Map_AddTimer("Miss", 2.f, "OnTimer_FriendShoot");
				Map_AddTimer("HitGerman", 2.6f, "OnTimer_FriendShoot");
				Map_AddTimer("HitGerman", 2.9f, "OnTimer_FriendShoot");
				Map_AddTimer("Miss", 3.5f, "OnTimer_FriendShoot");
				Map_AddTimer("HitGerman", 3.9f, "OnTimer_FriendShoot");
				Map_AddTimer("Miss", 4.5f, "OnTimer_FriendShoot");
			}
			else if (Sequence_DoStepAndWait(3.5f))
			{
				if (mvAliveShootGermans.size() > 0)
					Voice_Play("Dialogue_GermanSoldiersAmbushed", 1);
			}
			else if (Sequence_DoStepAndPause(0.f))
			{
				Entity_SetActive("Friend_Ambush", true);		
				Entity_SetActive("FriendRifle_Ambush", true);
				Entity_AlignSocketWithParentRotation("Friend_Ambush", "RightHandSocket");
				Entity_AttachToSocket("FriendRifle_Ambush", "Friend_Ambush", "RightHandSocket", true, true);
				Entity_PlayAnimation("Friend_Ambush", "lambert_run_to_bridge", 0.f, false, false, "OnAnimEnd_FriendRunToBridge");
				
				Map_AddTimer("Timer_PlayGetAttentionDialogue", 0.75f, "OnTimer_PlayGetAttentionDialogue");
			}
			else if (Sequence_DoStepAndPause(1.5f))
			{
				Player_SetJumpForceMul(1.f);
				
				bool bWaitUntilSeen = mbPlayerNearAmbushExit == false;
				if (bWaitUntilSeen)
				{
					Entity_SetActive("Trigger_LookAtFriend", true);
					Map_AddTimer("Timer_ForceResumeFriendEndsAmbushSeq", 10.f, "OnTimer_ForceResumeFriendEndsAmbushSeq");
				}
				else
				{
					Map_AddTimer("Timer_ForceResumeFriendEndsAmbushSeq", 1.f, "OnTimer_ForceResumeFriendEndsAmbushSeq");
				}
			}
			else if (Sequence_DoStepAndPause(0.f))
			{
				int lLineId = mbGetPlayerAttentionDialoguePlayed ? 1 : -1;
				Voice_StopScenesWithCharacter("AugustinLambert");
				Voice_Play("Dialogue_FriendPostAmbushPushForward", lLineId, "OnVoiceEnd_FriendPostAmbushPushForward");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Entity_PlayAnimation("Friend_Ambush", "lambert_run_from_bridge", 0.3f, false, false, "OnAnimEnd_FriendRunFromBridge");
				mbGermanAmbushActive = false;
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FriendShoot(const tString &in asTimer)
		{
			bool bHitGerman = asTimer == "HitGerman";
			
			/////////////////////
			// Make the soldier pop up before getting shot!
			if (bHitGerman)
			{
				--mlFriendShotCount;
				
				tString sGerman = "ShootGerman_" + mlFriendShotCount;
				
				if (Entity_GetVarBool(sGerman, "Dead") == false)
				{
					Map_RemoveTimer(sGerman);
					
					SetShootGermanState(sGerman, eShootGermanState_Shoot);
					
					Map_AddTimer(sGerman, cMath_RandRectf(1.f, 1.2f), "OnTimer_GermanShoot");
					Map_SetTimerUserVarInt(sGerman, 0);
				}
			}		
			
			/////////////////////
			// Shoot
			Map_AddTimer(asTimer + "_" + mlFriendShotCount, 0.9f, "OnTimer_DoFriendBullet");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoFriendBullet(const tString &in asTimer)
		{
			int lCount = cString_GetNumericSuffixInt(asTimer);
			bool bHitGerman = cString_GetFirstStringPos(asTimer, "HitGerman") != -1;
			tString sGerman = bHitGerman ? "ShootGerman_" + lCount : "Area_FriendAmbushMissGoal";
			tString sCallback = bHitGerman ? "OnFriendBulletHit" : "";
			
			iLuxEntity@ pStartEnt = Map_GetEntity("Area_FriendBulletStart", eLuxEntityType_Area);
			iLuxEntity@ pGerman = Map_GetEntity(sGerman);
			
			if (pStartEnt is null) return;
			if (pGerman is null) return;
			
			cVector3f vStart = pStartEnt.GetPosition();			
			cVector3f vDir;	
			
			if (bHitGerman) vDir = pGerman.GetBodyFromName("Body_2").GetWorldPosition() - vStart;
			else			vDir = pGerman.GetPosition() - vStart;
			
			BulletHandler_AddBullet(vStart, vDir, eBulletType_Revolver, tID_Invalid, sCallback);
			Sound_CreateAtEntity("Sound_Bullet", "trenches/enemy/lambert_fire", "Area_FriendBulletStart");
			Sound_AddClosedCaption("GeneralClosedCaptions", "Trenches_Gunfire", -1, true, vStart);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_FriendRunToBridge(const tString &in asEntity, const tString &in asAnim)
		{
			Entity_PlayAnimation("Friend_Ambush", "lambert_bridge_idle", 0.f, true);
			SequenceStates_Resume("Seq_FriendEndsAmbush");
		}
		
		//-------------------------------------------------------
		
		void OnTimer_PlayGetAttentionDialogue(const tString &in asTimer)
		{
			mbGetPlayerAttentionDialoguePlayed = true;
			Voice_Play("Dialogue_FriendPostAmbushPushForward", 0);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ForceResumeFriendEndsAmbushSeq(const tString &in asTimer)
		{
			if (mbPlayerSawFriend == false)
			{
				SequenceStates_Resume("Seq_FriendEndsAmbush");
			}
		}
		
		//-------------------------------------------------------
		
		void OnLookAt_Friend(const tString &in asEntity, int alState)
		{
			if (alState == -1) return;
			if (SequenceStates_IsActive("Seq_FriendEndsAmbush") == false) return;
			
			mbPlayerSawFriend = true;
			Entity_SetActive(asEntity, false);
			
			Map_RemoveTimer("Timer_PlayGetAttentionDialogue");
			SequenceStates_Resume("Seq_FriendEndsAmbush");
		}
		
		//-------------------------------------------------------
		
		void OnVoiceEnd_FriendPostAmbushPushForward(const tString &in asSubject, const tString &in asScene)
		{
			SequenceStates_Resume("Seq_FriendEndsAmbush");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_FriendRunFromBridge(const tString &in asEntity, const tString &in asAnim)
		{
			Entity_SetActive("Friend_Ambush", false);
			Entity_SetActive("FriendRifle_Ambush", true);
		}
		
		//-------------------------------------------------------

		//} END Event: Friend ends ambush
		
