		//-------------------------------------------------------
		
		cSequenceStatesData mSeq_Bomb;		
		void Seq_BombHit(const tString &in asTimer)
		{
			Sequence_Begin("Seq_BombHit", mSeq_Bomb);
			if (Sequence_DoStepAndWait(1.5f))
			{
				Sound_CreateAtEntity("Sound_BombHit", "trenches/enemy/bomb_hit", "ps_area_falling_dirt_grenaderoom_01");
			}
			else if (Sequence_DoStepAndContinue())
			{
				Sound_AddClosedCaption("GeneralClosedCaptions", "Explosion");
				Entity_AddImpulse("hanging_lamp_01", cVector3f(0.f, 0.f, -1.5f), true, true);
				ParticleSystem_CreateAtEntity("falling_dirt_grenaderoom", "falling_dust_explosion_01.ps", "ps_area_falling_dirt_grenaderoom_01", false);
				Effect_Shake_Start(0.6f, 0.25f, 0.1f, 1.f, 0.2f, 64.f);
			}
			
			Sequence_End();
		}
		
