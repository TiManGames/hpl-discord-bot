		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowRunHint(const tString &in asTimer)
		{
			if (Player_GetRunning()) return;
			
			Hint_StopHint();
			
			tString sHint = "HintRun";			
			int lSprintMode = cLux_GetUserConfig().GetInt("Accessibility", "SprintMode", 0);
			if 		(lSprintMode == 1) sHint = "HintRunAlt";
			else if (lSprintMode == 2) sHint = "HintRunAlt_Toggle";
			
			Hint_ShowHint_Hold("Hints", sHint, true, 1.5f, true, 15.f, false, false);
		}
		
