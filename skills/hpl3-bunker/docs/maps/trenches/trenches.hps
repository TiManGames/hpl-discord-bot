	//-------------------------------------------------------

	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// EVENTS
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
		
		////////////////////////////////////////////////////////////
		// Event: Enter trenches
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		cVector3f mvPlayerStartPos = cVector3f(0.f);
		cVector3f mvPlayerStartCameraRot = cVector3f(0.f);
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataEnterTrenches;
		void Seq_EnterTrenches(const tString &in asTimer)
		{
			Sequence_Begin("Seq_EnterTrenches", mSeqDataEnterTrenches);
			Sequence_Wait(1.f);
			if (Sequence_DoStepAndWait(3.0f))
			{
				Sound_AddClosedCaption("GeneralClosedCaptions", "Trenches_IntroBreathing");
			}
			else if (Sequence_DoStepAndWait(0.1f))
			{
				Player_SetActive(true);
				FootPlacement_SetActive(PlayerBody_GetEntityName(), false);
				
				cVector3f vPos(-1.094f, 0.f, 16.014f);
				float fAngle = cMath_Pi;				
				PlayerBody_PlayCutsceneAnimation("enter_trenches", false, 0.f, "OnAnimEnd_EnterTrenches", 1.f, 0.f, true, vPos, fAngle, false, false);
				PlayerBody_SetCutsceneMaxPitch(5.f);
				PlayerBody_SetCutsceneMaxYaw(5.f);
				
				Sketchbook_SetCanOpen(false);
				Hint_SetCanShowHints(false);
				
				Sound_PlayGui("trenches/dream/run_start", 1.0);
				
				Player_FadeDreamLights(0.f, 0.1f);
			}
			else if (Sequence_DoStepAndWait(1.75f))
			{
				Effect_Fade_In(0.1f);
				Sound_FadeGlobalVolume(1.f, 0.1f, eSoundEntryType_WorldAll);
				
				Effect_Rumble_Start(0.5, 0.25);
				
				Map_AddTimer("Area_IntroBulletEnd_1", 0.5f, "OnTimer_DoIntroBullet");
				Map_AddTimer("Area_IntroBulletEnd_2", 0.8f, "OnTimer_DoIntroBullet");
				Map_AddTimer("Area_IntroBulletEnd_2", 1.4f, "OnTimer_DoIntroBullet");
				
				Voice_SetSource("AugustinLambert", "Area_IntroLambertVoice", 5.f, 70.f, true);
				Map_AddTimer("Dialogue_TakeCover", 1.5f, "OnTimer_PlaySubjectLine");
				Map_SetTimerUserVarInt("Dialogue_TakeCover", 0);
				
				Sound_AddClosedCaption("GeneralClosedCaptions", "Trenches_Gunfire");
			}
			else if (Sequence_DoStepAndWait(0.25f))
			{
				Map_AddTimer("Dialogue_TakeCover", 6.f, "OnTimer_PlaySubjectLine");
				Map_SetTimerUserVarInt("Dialogue_TakeCover", 1);
			}
			else if (Sequence_DoStepAndPause(0.f))
			{
				ParticleSystem_SetVisible("rifle_fire_intro", false);
				Map_AddTimer("Timer_LandingRumble", 0.7f, "OnTimer_LandingRumble");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Sketchbook_SetCanOpen(true);
				Hint_SetCanShowHints(true);
				
				mvPlayerStartPos = Player_GetPosition();
				mvPlayerStartCameraRot = Player_GetCameraYawPitchRoll();
				
				Map_AddTimer("Timer_SaveGameProgress", 1.f, "OnTimer_SaveGameProgress");
				
				Map_AddTimer("Timer_ShowLookHint", 4.f, "OnTimer_ShowLookHint");
				Map_AddTimer("Timer_ShowMoveHint", 10.f, "OnTimer_ShowMoveHint");
				
				Sound_Play("Sound_War*", 0.1f);
				
				Map_AddTimer("Timer_WarSoundStop", 10.0f, "OnTimer_StopWarSounds");
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_SaveGameProgress(const tString&in asTimer)
		{
			/////////////////
			// Save game after we take control
			SaveRoom_SaveGame(false, false);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_LandingRumble(const tString&in asTimer)
		{
			Effect_Rumble_Start(0.25, 0.5);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_DoIntroBullet(const tString &in asTimer)
		{
			cVector3f vStart = Map_GetEntity("Area_IntroBulletStart", eLuxEntityType_Area).GetPosition();
			cVector3f vDir = Entity_GetDeltaToEntity("Area_IntroBulletStart", asTimer);		
	
			BulletHandler_AddBullet(vStart, vDir, eBulletType_Revolver, tID_Invalid);
			
			Sound_CreateAtEntity("Sound_Bullet", "trenches/enemy/fire", "Area_IntroBulletStart");
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_EnterTrenches(const tString &in asTimer)
		{
			SequenceStates_Resume("Seq_EnterTrenches");
			FootPlacement_SetActive(PlayerBody_GetEntityName(), true);
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowLookHint(const tString &in asTimer)
		{
			cVector3f vDiff = Player_GetCameraYawPitchRoll() - mvPlayerStartCameraRot;
			if (vDiff.Length() < 0.05f)
			{
				Hint_StopHint();
				Hint_ShowHint_Hold("Hints", "HintLookAround", true, 1.5f, true, 15.f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_ShowMoveHint(const tString &in asTimer)
		{
			cVector3f vDiff = Player_GetPosition() - mvPlayerStartPos;
			if (vDiff.Length() < 0.05f)
			{
				Hint_StopHint();
				Hint_ShowHint_Hold("Hints", "HintMoveAround", true, 1.5f, true, 15.f);
			}
		}
		
		//-------------------------------------------------------
		
		void OnTimer_StopWarSounds(const tString &in asTimer)
		{
			Sound_Stop("Sound_Mach_WarNear_*", 5.0f);
			Sound_Stop("Sound_WarNear_*", 10.0f);
		}
		
		//-------------------------------------------------------

		//} END Event: Enter trenches
		
