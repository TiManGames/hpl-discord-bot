		////////////////////////////////////////////////////////////
		// Event: Trapped by gas grenades
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbGasRescueActive = false;
		bool mbExtraGasAdded = false;
		array<tID> mvAddedExtraGas;
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_GasGermanRunsBy(const tString &in asParent, const tString &in asChild, int alState)
		{
			Voice_SetSource("GermanSoldier_1", "RunGerman_5", 1.f, 50.f, true);
			Voice_Play("Dialogue_GermanSoldiersAttack_Grenade");
			GermanRunTo("RunGerman_5", 5.2f, "Area_RunGermanGas_Goal");
			return false;
		}
		
		//-------------------------------------------------------
		
		bool OnTrigger_Player_StartSeqTrappedInGas(const tString &in asParent, const tString &in asChild, int alState)
		{
			Seq_TrappedInGas("");
			return false;
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataTrappedInGas;
		void Seq_TrappedInGas(const tString &in asTimer)
		{
			Sequence_Begin("Seq_TrappedInGas", mSeqDataTrappedInGas);
			if (Sequence_DoStepAndWait(2.5f))
			{
				mbGasRescueActive = true;
				EnvironmentalDamage_SetNoDeathDamageActive(true); // Don't kill the player
				
				Entity_SetActive("Blocker_GasDeadEnd", true);
				
				ThrowGasGrenade("GasGrenade_3");
				GasGrenade_SetFuseTime("GasGrenade_3", 2.f);
				
				if (Player_GetHealth() <= 0.3f)
				{
					Player_SetIgnoreGasDamage(true);
					//Player_SetFallDamageActive(false);
				}
				
				if (GameDifficulty_GetSettingValueByID_Bool(eGameDifficultySetting_HardcoreHealthSystem))
				{
					Player_StopBleeding();
					Player_SetBleedingActive(false);
				}
			}
			if (Sequence_DoStepAndWait(1.f))
			{
				ThrowGasGrenade("GasGrenade_4");				
				Music_PlayExt("Bunker_Gas_Loop.ogg", true, 0.4f, 1.0f, 12.0f, 1.0f, eMusicPrio_SceneAmb, false);				
			}
			else if (Sequence_DoStepAndWait(0.75f))
			{
				ThrowGasGrenade("GasGrenade_5");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				ThrowGasGrenade("GasGrenade_2");
				
				Voice_SetSource("AugustinLambert", "Area_GasSequenceLambertVoice", 1.f, 70.f, true);
				Voice_PlayDelayed("Dialogue_FriendGasWarning", 2.f);
			}
			else if (Sequence_DoStepAndWait(9.f))
			{
				ThrowGasGrenade("GasGrenade_1");				
				Voice_PlayDelayed("Dialogue_FriendLookingForPlayer", 6.f);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				AddExtraGas();
			}
			
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void ThrowGasGrenade(const tString &in asEntity)
		{
			iLuxEntity@ pEnt = Map_GetEntity(asEntity, eLuxEntityType_Prop);
			iPhysicsBody@ pBody = pEnt !is null ? pEnt.GetMainBody() : null;
					
			if (pEnt !is null && pBody !is null)
			{
				cVector3f vTorque = cMath_RandomSphereSurfacePoint(1.f);
				cVector3f vImpulse = cVector3f_Forward * 5.5f + cVector3f_Up * 3.5f;
				vImpulse = cMath_MatrixMul(pEnt.GetMatrix().GetRotation(), vImpulse);
						
				pEnt.SetActive(true);
				pBody.AddTorque(vTorque);
				pBody.AddImpulse(vImpulse);
			}
			
			Entity_SetEffectsActive(asEntity, false, true);
			GasGrenade_SetParticleSuffix(asEntity, "_cutscene");
		}
		
		//-------------------------------------------------------
		
		void AddExtraGas()
		{
			////////////////
			// Setup vars
			mbExtraGasAdded = true;
			
			array<tID> vGasAreas = EnvironmentalDamage_GetDamageAreasOfType(eDamageType_Gas);
			array<iLuxEntity@> vExtraGasAreas;
			mBaseObj.GetEntityArray("Area_ExtraGas_*", eLuxEntityType_Area, "", vExtraGasAreas);
			
			////////////////
			// Add gas in areas not already filled
			for (int i = 0; i < vExtraGasAreas.size(); ++i)
			{
				bool bAddExtraGas = true;			
				iLuxEntity@ pExtraArea = vExtraGasAreas[i];
				cBoundingVolume@ pExtraAreaBounds = pExtraArea.GetMainBody().GetBoundingVolume();
				
				if (pExtraArea is null) continue;
				if (pExtraAreaBounds is null) continue;
				
				for (int j = 0; j < vGasAreas.size(); ++j)
				{
					iLuxEntity@ pArea = cLux_ID_Entity(vGasAreas[j]);
					cBoundingVolume@ pAreaBounds = pArea.GetMainBody().GetBoundingVolume();
					
					if (pArea is null) continue;
					if (pAreaBounds is null) continue;
									
					if (cMath_CheckPointInAABBIntersection(pExtraArea.GetPosition(), pAreaBounds.GetMin(), pAreaBounds.GetMax()))
					{
						bAddExtraGas = false;
						break;
					}
				}
				
				if (bAddExtraGas)
				{
					int lId = cString_GetNumericSuffixInt(pExtraArea.GetName());				
					cParticleSystem@ pPS = mBaseObj.GetWorld().GetParticleSystem("PS_ExtraGas_" + lId);
						
					if (pPS !is null)
					{
						pPS.SetActive(true);
						pPS.SetVisible(true);
						
						EnvironmentalDamage_AddGasArea(pPS.GetID(), pExtraAreaBounds.GetMin(), pExtraAreaBounds.GetMax(), false);
						
						mvAddedExtraGas.push_back(pPS.GetID());
					}
				}				
			}
			
			////////////////////
			// Start end sequence
			StartEndSequence();
		}
		
		//-------------------------------------------------------

		//} END Event: Trapped by gas grenades
		
		////////////////////////////////////////////////////////////
		// Event: Resuced by friend
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
		bool mbEndSequenceStarted = false;
		int mlGasDamageTakenCount = 0;
		int mlGasDamageTimeStamp = 0;
		int mlBlurId = -1;
		int mlImageTrailId = -1;
		cVector3f mvGasCutsceneStartPos(0.f);
		
		//-------------------------------------------------------
		
		void StartEndSequence()
		{
			if (mbEndSequenceStarted) return;
			
			mbEndSequenceStarted = true;
			
			Player_SetIgnoreGasDamage(true);
			//Player_SetFallDamageActive(false);
			
			float fTime = mBaseObj.GetElapsedTime(mlGasDamageTimeStamp);
			float fDelay = 3.5f - cMath_Min(fTime, 3.5f);
			
			Map_AddTimer("", fDelay, "Seq_RescuedByFriend");
		}
		
		//-------------------------------------------------------
		
		cSequenceStatesData mSeqDataRescuedByFriend;
		void Seq_RescuedByFriend(const tString &in asTimer)
		{
			Sequence_Begin("Seq_RescuedByFriend", mSeqDataRescuedByFriend);
			if (mlGasDamageTakenCount < 2 && Sequence_DoStepAndWait(3.f)) 
			{
				Player_GiveDamage(0.5f, 0.3f, eDamageType_Gas, "");
			}
			else if (Sequence_DoStepAndWait(0.3f)) 
			{
				Player_GiveDamage(0.5f, 0.3f, eDamageType_Gas, "");
				
				mlImageTrailId = Effect_ImageTrail_Start(1.5f, 3.f, 20.f, 2.f);
				mlBlurId = Effect_Blur_Start(1.f, 3.f);
				
				Effect_Bloom_SetActive(false);
			}
			else if (Sequence_DoStepAndWait(2.965))
			{
				///////////////////////
				// Play play anim
				mvGasCutsceneStartPos = Player_GetFeetPosition() + Player_GetForward() * -0.5f;
				float fAngle = cLux_GetPlayer().GetCharacterBody().GetYaw();
				
				PlayerBody_PlayCutsceneAnimation("player_intro_gas_cough", false, 0.3f, "OnAnimEnd_GasCough", 1.f, 0.f, true, mvGasCutsceneStartPos, fAngle);
				PlayerBody_SetCutsceneMaxPitch(5.f);
				PlayerBody_SetCutsceneMaxYaw(5.f);
				PlayerBody_SetShowCrossHairIconsOnCutsceneEnd(false);
				
				Map_AddTimer("Timer_FadeInHandBlood", 2.f, "OnTimer_FadeInHandBlood");
				
				///////////////////////
				// Place gas at player
				cParticleSystem@ pClosestPS = null;
				float fMinDistSqr = 1000.f * 1000.f;
				
				for (int i = 0; i < mvAddedExtraGas.size(); ++i)
				{
					cParticleSystem@ pPS = cLux_ID_ParticleSystem(mvAddedExtraGas[i]);
					if (pPS is null) continue;
					
					float fDistSqr = (pPS.GetWorldPosition() - mvGasCutsceneStartPos).SqrLength();
					if (fDistSqr < fMinDistSqr)
					{
						fMinDistSqr = fDistSqr;
						@pClosestPS = pPS;
					}
				}
				
				if (pClosestPS !is null)
				{
					pClosestPS.SetWorldPosition(mvGasCutsceneStartPos);
					pClosestPS.SetFadeAtDistance(false);
				}
			}
			else if (Sequence_DoStepAndWait(0.4f))
			{
				Effect_Fade_Out(0.25);
			}
			else if (Sequence_DoStepAndWait(1.6f))
			{		
				Effect_Fade_In(0.5);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Effect_Blur_FadeAmount(mlBlurId, 5.f, 1.f);
				Effect_ImageTrail_FadeInstanceAmount(mlImageTrailId, 3.f, 1.f);
			}
			else if (Sequence_DoStepAndWait(0.5f))
			{
				Effect_Fade_Out(0.4);
			}
			else if (Sequence_DoStepAndWait(0.3f))
			{		
				Effect_Blur_FadeOut(mlBlurId, 1.f);
				Effect_ImageTrail_FadeInstanceAmount(mlImageTrailId, 0.5f, 3.f);
				
				///////////////////
				// Get animaton position and angle
				iLuxEntity@ pArea = Map_GetEntity("Area_GasCutscene", eLuxEntityType_Area);
				iLuxEntity@ pFriend = Map_GetEntity("Friend_End", eLuxEntityType_Prop);
				
				if (pArea is null) return;
				if (pFriend is null) return;
				
				cVector3f vPos = pArea.GetPosition();
				cVector3f vFwd = pArea.GetMatrix().GetTranspose().GetForward();
				float fAngle = -cMath_ATan2(vFwd.x, -vFwd.z);
				
				///////////////////
				// Position player and friend
				PlayerBody_SetCameraAnimationPositionAndYaw(true, vPos, fAngle, 0.f);
				
				pFriend.SetActive(true);
					
				cMatrixf mtxFriend = pFriend.GetMatrix();
				mtxFriend.SetRotation(cMath_MatrixRotateY(fAngle + cMath_Pi));
				mtxFriend.SetTranslation(vPos);
				pFriend.SetMatrix(mtxFriend);									
				
				Player_SetCameraNearPlane(0.001f);
				
				///////////////////
				// Play friend anims
				Entity_SetActive("GasMaskFriend", true);
				Entity_AlignSocketWithParentRotation("Friend_End", "GasMaskSocket");
				Entity_AttachToSocket("GasMaskFriend", "Friend_End", "GasMaskSocket", true, true);
				
				Entity_SetActive("FriendRifle_GasRescue", true);				
				Entity_AlignSocketWithParentRotation("Friend_End", "RightHandSocket");
				Entity_AttachToSocket("FriendRifle_GasRescue", "Friend_End", "RightHandSocket", true, true);
				
				Entity_PlayAnimation("Friend_End", "lambert_intro_gas_give_gas_mask", 0.f, false, false, "OnAnimEnd_GiveGasMask");				
				Entity_PlayAnimation("GasMaskFriend", "gas_mask_npc_lambert_intro_gas_give_gas_mask", 0.f, false);
				
				Entity_SetActive("GasMaskEnd", true);
				Entity_AlignSocketWithParentRotation("Friend_End", "LeftHandSocket");
				Entity_AttachToSocket("GasMaskEnd", "Friend_End", "LeftHandSocket", true, true);
				Entity_PlayAnimation("GasMaskEnd", "gas_mask_intro_hand_over", 0.f, false);
				
				Music_Stop(2.0f, eMusicPrio_SceneAmb);
				Music_Play("Bunker_Gas_Rescue.ogg", 0.95f, false, eMusicPrio_MinorEvent);
				
				Voice_SetSource("AugustinLambert", "Friend_End", 1.f, 50.f, true);
				Voice_PlayDelayed("Dialogue_FriendSavesPlayer_Alt", 0.25f);
				
				///////////////////
				// Move grenades and particles to hide the jump
				cVector3f vPosDiff = vPos - mvGasCutsceneStartPos;
				
				array<iLuxEntity@> vGrenades;
				mBaseObj.GetEntityArray("GasGrenade_*", eLuxEntityType_Prop, "", vGrenades);
				
				for (int i = 0; i < vGrenades.size(); ++i)
				{
					cLuxProp@ pGrenade = cLux_ToProp(vGrenades[i]);
					if (pGrenade is null) continue;
					
					pGrenade.SetStaticPhysics(true);
					pGrenade.SetPosition(pGrenade.GetPosition() + vPosDiff);
				}
				
				for (int i = 0; i < mvAddedExtraGas.size(); ++i)
				{
					cParticleSystem@ pPS = cLux_ID_ParticleSystem(mvAddedExtraGas[i]);
					if (pPS is null) continue;
					pPS.SetWorldPosition(pPS.GetWorldPosition() + vPosDiff);
				}
			}
			else if (Sequence_DoStepAndPause(0.f))
			{
				Effect_Fade_In(0.5);
			}
			else if (Sequence_DoStepAndWait(3.3f))
			{
				Effect_ImageTrail_FadeOut(mlImageTrailId, 5.f);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{				
				Effect_Fade_Out(1.f);
				Sound_FadeGlobalVolume(0.f, 3.f, eSoundEntryType_WorldAll);
			}
			else if (Sequence_DoStepAndWait(3.7f))
			{
				PlayerBody_FadeLiquidAmountTo(0.f, 0.3f);
				
				Player_SetHealth(1.f);
				Player_SetHealthRegenSpeedMul(1.f);
				Player_RestoreClipPlane();
				Player_SetActive(false);
				
				Effect_Bloom_SetActive(true);
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				Player_UnequipGasMaskInstantly();				
				
				Player_FadeDreamLights(1.f, 3.f);
				Player_SetupDreamLightsSound("trenches/dream/dice", "Comments", 0.8f);
			}
			else if (Sequence_DoStepAndWait(6.5f))
			{
				Sound_PlayGui("trenches/dream/dice", 1.0f);
				Voice_PlayDelayed("Dialogue_DiceGame", 2.5f);
			}
			else if (Sequence_DoStepAndWait(12.0f))
			{
				Sound_AddClosedCaption("GeneralClosedCaptions", "Trenches_Dice");
			}
			else if (Sequence_DoStepAndWait(1.f))
			{
				mbGasRescueActive = false;
				
				if (cLux_ScriptDebugOn() == false)
					Map_ChangeMap("no_mans_land.hpm", "", "", "", false, true);
			}
			Sequence_End();
		}
		
		//-------------------------------------------------------
		
		void OnTimer_FadeInHandBlood(const tString &in asTimer)
		{
			PlayerBody_FadeLiquidAmountTo(0.6f, 0.3f);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_GasCough(const tString &in asAnim)
		{
			Entity_SetActive("GasMaskEnd", false);
			
			Player_SetMoveSpeedMul(0.f);
			Player_SetLookSpeedMul(0.f);
			cLux_GetPlayer().ChangeState(ePlayerState_Null);
			
			cLux_GetPlayer().GetCharacterBody().SetActive(false);
			Player_SetEquipGasMask(true);
		}
		
		//-------------------------------------------------------
		
		void OnAnimEnd_GiveGasMask(const tString &in asEntity, const tString &in asAnim)
		{
			Entity_PlayAnimation("Friend_End", "lambert_intro_gas_idle", 0.f, true);
			Entity_PlayAnimation("GasMaskFriend", "gas_mask_npc_lambert_intro_gas_idle", 0.f, false);
		}
		
		//-------------------------------------------------------
		
		void ResumeEndSequence()
		{
			PlayerBody_PlayCutsceneAnimation("player_intro_gas_look_at_and_follow_friend", false, 0.3f);
			PlayerBody_SetCutsceneMaxPitch(5.f);
			PlayerBody_SetCutsceneMaxYaw(5.f);
			
			Entity_PlayAnimation("Friend_End", "lambert_intro_gas_walk_past_and_run", 0.3f, false);
			Entity_PlayAnimation("GasMaskFriend", "gas_mask_npc_lambert_intro_gas_walk_past_and_run", 0.3f, false);
			
			SequenceStates_Resume("Seq_RescuedByFriend");
			
			Player_SetHealthRegenActive(true, true);
			Player_SetHealthRegenSpeedMul(100.f);
			//reset bloom setting to default
			Effect_Bloom_FadeBloomTint(1, 1, 1, 1);
		}
		
		//-------------------------------------------------------
		
		//} END Event: Rescued by friend
	 
	 //-------------------------------------------------------
	 
	//} END EVENTS
	
	//-------------------------------------------------------
}