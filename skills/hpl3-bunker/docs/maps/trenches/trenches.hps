		}
		
		//-------------------------------------------------------

		//} END Event: Show gun hint
		
		////////////////////////////////////////////////////////////
		// Event: Show lean hint
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
	
		bool OnTrigger_Player_ShowLeanHint(const tString &in asParent, const tString &in asChild, int alState)
		{
			Hint_StopHint();
			
			tString sHint = "HintLean";			
			int lMode = cLux_GetUserConfig().GetInt("Accessibility", "LeanMode", 0);
			if (lMode == 1) sHint += "_Toggle";
			
			Hint_ShowHint_Hold("Hints", sHint, true, 1.5f, true, 15.f, false, false);
			return false;
		}
		
		//-------------------------------------------------------
		
		//} END Event: Show lean hint
		
		////////////////////////////////////////////////////////////
		// Event: Show run hint
		//{/////////////////////////////////////////////////////////
		
		//-------------------------------------------------------
		
