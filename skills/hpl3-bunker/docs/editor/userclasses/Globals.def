	<Components>
		<Component Name="CharMover">
			<TypeVars>
				<Group Name="CharMover">
					<Var Name="CharMover_IdleAnim" Type="String" DefaultValue=""  	Description="The animation used when idle. " />
					<Var Name="CharMover_WalkAnim" Type="String" DefaultValue=""  	Description="The animation used when waling. " />
					<Var Name="CharMover_RunAnim" Type="String" DefaultValue=""  	Description="The animation used when running. " />
					<Var Name="CharMover_BackwardAnim" Type="String" DefaultValue=""  	Description="The animation used when moving backwards. " />
					<Var Name="CharMover_IdleExtraAnim" Type="String" DefaultValue=""  	Description="Animation insterted during idle. This is just the base game and the actual animations shall end with suffix '1', '2', etc." />
					<Var Name="CharMover_IdleExtraMinWait" Type="Float" DefaultValue="4"  	Description="The minimum time before an extra animation starts" />
					<Var Name="CharMover_IdleExtraMaxWait" Type="Float" DefaultValue="10"  	Description="The maximum time before an extra animation starts" />
					<Var Name="CharMover_IdleExtraPauseProcedural" Type="Bool" DefaultValue="true"  	Description="If playing an extra animation stops any procedural, like headtracking (Does not apply to lip synch!)" />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="ClimbAnimations">
			<TypeVars>
				<Group Name="ClimbAnimations">
					<Var Name="ClimbAnimations_IdleToClimb" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_ClimbLeft" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_ClimbRight" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_ClimbUpLeft" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_ClimbUpRight" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_IdleToHang" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_HangToFall" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_Fall" Type="String" DefaultValue="" Description="" />
					<Var Name="ClimbAnimations_FallToLand" Type="String" DefaultValue="" Description="" />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="HeadTracker">
			<TypeVars>
				<Group Name="HeadTracker">
					<Var Name="HeadTracker_Bones" Type="String" DefaultValue=""  	Description="A series of node names that will be used when turning head during tracking. Use $ to denote space in the names." />
					<Var Name="HeadTracker_BoneMuls" Type="String" DefaultValue=""	Description="A series of float numbers that are the amount of influence for each bone. Must be same number as bone names." />
					<Var Name="HeadTracker_ChestBone" Type="String" DefaultValue=""	Description="The bone that will be used to determine the direction of the character. If empty, mesh matrix is used." />
					<Var Name="HeadTracker_SpeedMul" Type="Float" DefaultValue="1"	Description="How fast the head will rotate relative to the angle distance of the target." />
					<Var Name="HeadTracker_MaxSpeed" Type="Float" DefaultValue="1"	Description="Max rotation speed." />
					<Var Name="HeadTracker_MaxAngle" Type="Float" DefaultValue="45"	Description="Max angle the head can move." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Headtracker">
					<Var Name="HeadTracker_TargetEntity" Type="String" DefaultValue=""	Description="The target of the head tracking. If '' then 'Player' will be used." />
					<Var Name="HeadTracker_Active" Type="Bool" DefaultValue="true"	Description="If headtracking is on or not." />
				</Group>
			</InstanceVars>
		</Component>
		<Component Name="Listener">
			<InstanceVars>
				<Group Name="Listener">
					<Var Name="Listener_Active" Type="Bool" DefaultValue="true"	Description="If this entity will react to sounds." />
				</Group>
			</InstanceVars>
		</Component>
		<Component Name="BackboneTail">
			<TypeVars>
				<Group Name="BackboneTail">
					<Var Name="Backbone_Bones" Type="String" DefaultValue="" 	Description="A list of strings with the bones that make up the back one. MUST be listed front to back. " />
					<Var Name="Backbone_AddTrailFreq"  Type="Float" DefaultValue="10" Description="How often (times per seconds) a sample of a previous transform is taken." />
					<Var Name="Backbone_Stiffness" Type="Float" DefaultValue="1"  Description="How stiff or loose the bend is." />
					<Var Name="Backbone_MaxTrailSize" Type="Int" DefaultValue="13"  Description="The number of previous transforms that are saved to calculate the bend." />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="RatFood">
			<TypeVars>
				<Group Name="RatFood">
					<Var Name="IsRatFood" Type="Bool" DefaultValue="false" Description="Checking this will make the item use the rat food component." />
					<Var Name="AttractEnabled" Type="Bool" DefaultValue="true" Description="Checking this will make the rats attracted to this entity." />
					<Var Name="AttractDistance" Type="Float" DefaultValue="5" Description="The maximum distance a rat can smell this entity." />
					<Var Name="LifeTime" Type="Float" DefaultValue="-1" Description="The amount of time in seconds that a single rat needs to eat this food entity before it dissapears. -1 = takes forever. 0 = already eaten. " />
					<Var Name="FeedingSlotsCount" Type="Int" DefaultValue="2" Description="The max number of rats that can gather around this food." />
					<Var Name="Priority" Type="Int" DefaultValue="0" Description="The higher the priority the more likely is that rats will be ettracted to this food entity." />
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="RatFood">
					<Var Name="AltFoodEntity" Type="String" DefaultValue="" Description="Assign an entity other than this, as the entity of attraction." />
				</Group>
			</InstanceVars>
		</Component>
		<Component Name="WoodenBreakable">
			<TypeVars>
				<Group Name="WoodenBreakable">
					<Var Name="WoodenBreakable_Active" Type="Bool" DefaultValue="false" Description="If the wooden breakable behaviour is active. Overriden by normal break behaviour." />
					<Var Name="WoodenBreakable_HitMinEnergy" Type="Float" DefaultValue="100" Description="The minimum energy needed to register as a hit. Energy = Object1Speed * Object1Mass + Object2Speed * Object2Mass. Speed = m/s. If Object 2 is floor or something static, its speed is always 0 and does not contribute to total energy!" />	
					<Var Name="WoodenBreakable_MaxHits" Type="Int" DefaultValue="2" Description="The amount of times the prop needs to be hit before breaking." />	
					<Var Name="WoodenBreakable_MinHitMass" Type="Float" DefaultValue="10" Description="The min mass needed on the colliding prop to be eligible as a hit." />	
					<Var Name="WoodenBreakable_DamageMesh" Type="File"  Extensions="dae msh mesh" DefaultValue="" Description="Mesh used when hit count is larger than, or equal to, half of 'WoodenBreakable_MaxHits'." />
					<Var Name="WoodenBreakable_DamageSound" Type="File"  ResType="Sound" DefaultValue="" Description="Sound made when the damage mesh is used." />
					<Var Name="WoodenBreakable_DamagePS" Type="File"  ResType="ParticleSystem"  DefaultValue="" Description="Particles created when the damage mesh is used." />
					<Var Name="WoodenBreakable_BrokenEntity" Type="File" Extensions="Ent" DefaultValue="" Description="Entity file to switch to when broken." />
					<Var Name="WoodenBreakable_BreakImpulse" Type="Float" DefaultValue="3" Description="Imuplse applied to bodies in the broken entity." />
					<Var Name="WoodenBreakable_BreakSound" Type="File"  ResType="Sound"  DefaultValue="" Description="Sound made when broken." />
					<Var Name="WoodenBreakable_BreakPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" Description="Particles created when broken." />
					<Var Name="WoodenBreakable_BreakAIEventPrio" Type="Enum"  DefaultValue="High" Description="How interesting the break event is for agents." >
						<EnumValue Name="Low" />
						<EnumValue Name="Medium" />
						<EnumValue Name="High" />
					</Var>
					<Var Name="WoodenBreakable_CanDestroyThrownEntity" Type="Bool" DefaultValue="false" Description="If throwing a heavy object at this entity can break the thrown object." />
					<Var Name="WoodenBreakable_PathBlocker" Type="Bool" DefaultValue="false" Description="If this will block pathfinding (doesn't affect the stalker as it can destroy these props)" />
					<Var Name="WoodenBreakable_DropItemOnBreak" Type="Bool" DefaultValue="false" Description="Randomly spawns a pickup item when broken." />
					<Var Name="WoodenBreakable_CustomDropItemsCount" Type="Int" DefaultValue="-1" Description="Overrides the default item drop count if > -1." />
					<Var Name="WoodenBreakable_CustomDropItemsProbability" Type="Float" DefaultValue="-1" Description="Overrides the default item drop chance if > -1. (0=0%, 1=100%)." />
					<Var Name="WoodenBreakable_CustomDropItemsList" Type="String" DefaultValue="" Description="Overrides the default item drops list with the type of the items defined here, seperated by commas."/>
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="CustomItemDropsOnBreak">
					<Var Name="WoodenBreakable_CustomDropItemsCount" Type="Int" DefaultValue="-1" Description="Overrides the default and class item drop count if > -1." />
					<Var Name="WoodenBreakable_CustomDropItemsProbability" Type="Float" DefaultValue="-1" Description="Overrides the default and class item drop chance if > -1. (0=0%, 1=100%)." />
					<Var Name="WoodenBreakable_ScaleCustomDropProbability" Type="Bool" DefaultValue="true" Description="Whether the defined probability should scale with difficulty level." />
					<Var Name="WoodenBreakable_CustomDropItemsList" Type="String" DefaultValue="" Description="Overrides the default and class item drops list with the name of the items defined here, seperated by commas."/>
				</Group>
			</InstanceVars>
		</Component>
		<Component Name="LampComponent">
			<TypeVars>
				<Group Name="LampComponent">
				</Group>
			</TypeVars>
		</Component>
		<Component Name="Fullness">
			<TypeVars>
				<Group Name="Fullness">
					<Var Name="UseFullnessAnimation" Type="Bool" DefaultValue="false" Description="Use fullness animations" />
				</Group>
			</TypeVars>
		</Component>
    <Component Name="FootPlacement">
      <TypeVars>
        <Group Name="FootPlacement">
          <Var Name="FootPlacement_AlignPelvis" Type="Bool" DefaultValue="true" Description="If the whole body should move closer to the ground. Help with floating"/>
          <Var Name="FootPlacement_MaxPelvisAlign" Type="Float" DefaultValue="0.5" Description="How much the pelvis can be moved downward" /> 
          <Var Name="FootPlacement_AlignToes" Type="Bool" DefaultValue="false" Description="Should the toes rather than the heels be used for foot placement. Useful for weird monsters"/>      
          <Var Name="FootPlacement_FootDepth" Type="Float" DefaultValue="0.05" Description="How far the feet can be placed below the animation pose"/>
          <Var Name="FootPlacement_MaxFootHeight" Type="Float" DefaultValue="0.25" Description="How far below the hips the max placement of the feet is"/>
          <Var Name="FootPlacement_FadeSpeed" Type="Float" DefaultValue="8.0" Description="How fast to fade in and out footplacement"/>
          <Var Name="FootPlacement_LeftFoot" Type="String" DefaultValue=""  	Description="Bone name for the left foot. Select the bone that connects to the knee. It is possible to add a more detailed heirarchy by adding more bones with space in between. Foot -> Knee -> Hip" />
          <Var Name="FootPlacement_RightFoot" Type="String" DefaultValue=""  	Description="Bone name for the right foot. Select the bone that connects to the knee. It is possible to add a more detailed heirarchy by adding more bones with space in between. Foot -> Knee -> Hip " />
          <Var Name="FootPlacement_FrontLeftFoot" Type="String" DefaultValue=""  	Description="Bone name for the front left foot. Only use this for quadped actors. It is possible to add a more detailed heirarchy by adding more bones with space in between. Foot -> Knee -> Hip " />
          <Var Name="FootPlacement_FrontRightFoot" Type="String" DefaultValue=""  	Description="Bone name for the front right foot. Only use this for quadped actors. It is possible to add a more detailed heirarchy by adding more bones with space in between. Foot -> Knee -> Hip" />  
		  <Var Name="FootPlacement_FootOffset" Type="Vector3" DefaultValue="0 0 0" Description="Offset from foot bone"/>
    </Group>
      </TypeVars>
    </Component>
    <Component Name="HandPlacement">
      <TypeVars>
        <Group Name="HandPlacement">
          <Var Name="HandPlacement_FadeSpeed" Type="Float" DefaultValue="4.0" Description="How fast to fade in and out placement"/>
          <Var Name="HandPlacement_MaxAngleToTarget" Type="Float" DefaultValue="180.0" Description="Maxmimum angle between the target and the whole body"/>
          <Var Name="HandPlacement_LeftHand" Type="String" DefaultValue=""  	Description="Bone name for the left wrist. Select the bone that connects to the elbow. It is possible to add a more detailed heirarchy by adding more bones with space in between. Wrist -> Elbow -> Shoulder" />
          <Var Name="HandPlacement_LeftHandOffset" Type="Vector3" DefaultValue="0 0 0"  	Description="Offset from the hand bone to the middle of the palm" />
          <Var Name="HandPlacement_LeftHandRotation" Type="Vector3" DefaultValue="0 0 0"  	Description="Rotation of the hand from (0, 1, 0)" />
          <Var Name="HandPlacement_LeftHandTwist" Type="Vector3" DefaultValue="0 0 0"  	Description="Twist of the hand form (0, 1, 0)" />
          <Var Name="HandPlacement_LeftHandTest" Type="Vector3" DefaultValue="0 0 0"  	Description="" />
		  
		  <Var Name="HandPlacement_RightHand" Type="String" DefaultValue=""  	Description="Bone name for the right wrist. Select the bone that connects to the elbow. It is possible to add a more detailed heirarchy by adding more bones with space in between. Wrist -> Elbow -> Shoulder " />
          <Var Name="HandPlacement_RightHandOffset" Type="Vector3" DefaultValue="0 0 0"  	Description="Offset from the hand bone to the middle of the palm" />
          <Var Name="HandPlacement_RightHandRotation" Type="Vector3" DefaultValue="0 0 0"  	Description="Rotation of the hand from (0, 1, 0)" />
          <Var Name="HandPlacement_RightHandTwist" Type="Vector3" DefaultValue="0 0 0"  	Description="Twist of the hand form (0, 1, 0)" />
		  <Var Name="HandPlacement_RightHandTest" Type="Vector3" DefaultValue="0 0 0"  	Description="" />
      </Group>
      </TypeVars>
    </Component>
		<Component Name="_Temp_Burn">
			<TypeVars>
				<Group Name="_Temp_Burn">
					<Var Name="BurnPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 		Description="The burn components particle system." />
				</Group>
			</TypeVars>
		</Component>
		<Component Name="_Temp_Fire">
			<TypeVars>
				<Group Name="Fire">
					<Var Name="FireParticleSystem" Type="String" DefaultValue="fire_object.ps" Description="Name of the particle system to be used."/>
				</Group>
			</TypeVars>
			<InstanceVars>
				<Group Name="Fire">
					<Var Name="TurnOnWhenInteracting" Type="Bool" DefaultValue="false" Description="If true, it will only burst in flames if interacted with."/>
					<Var Name="StartOn" Type="Bool" DefaultValue="true" Description="If true, it will start with on when interacting mode is not on."/>
				</Group>
			</InstanceVars>
		</Component>
	</Components>
</Globals>