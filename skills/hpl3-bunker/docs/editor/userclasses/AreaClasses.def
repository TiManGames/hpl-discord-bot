<UserClassDefinition>
	<Classes>
	
		<BaseClass Name="BasicArea" >
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Type="Bool" Name="BlocksLineOfSight"  DefaultValue="false" 		Description="If the area blocks line of sight. Only really used for checks to see if stuff is in line of sight, and if this is true, the area can be picked."/>
					<Var Type="String" Name="EventInstanceTag" DefaultValue="" 		Description="A tag string used that is mainly used by the event system to group certain type of objects." />
					<Var Name="UserVar" Type="String" DefaultValue="" 		Description="Value of a variable. Accessed with  Entity_GetVar[Type](&quot;&quot;) (an empty string as argument). Can be of any type (determined when you choose to access)." />
					<Var Name="Static" Type="Bool" DefaultValue="false" 		Description="If updating and saving should be skipped for this entity. Saves a lot of performance" />
					<Var Name="QuickSave" Type="Bool" DefaultValue="false" 		Description="Only save the transform of this area" />
					<Var Name="FullGameSave" Type="Bool" DefaultValue="false" 			Description="If the all things in the entity should be saved when exiting the level. Only use on few entities!" />
				</Group>
				<Group Name="Collide Callbacks">
					<Var Type="String" Name="CC_Entities"  DefaultValue="" 		Description="The entities that have a callback to this entity, sepperate each with space and/or comma. May use wildcards (*). Having 'player' as entity means that current entity will be attached on player." />
					<Var Type="Function" Name="CC_Funcs" ReturnType="bool" Params="const tString &amp;in asParent, const tString &amp;in asChild, int alState" 		Description=" The callback functions for all the entities. Syntax: bool Func(const tString &in asParent, const tString &in asChild, int alState). If false is returned callback is removev. states: 1=enter, -1=leave If using several sepperate with comma and/or spaces. If only one function, all entity collision will use, else they are connected following the order. If there are more entities than functions, the last function will be used for the remaining entities." />
				</Group>
				<Group Name="Attachment">
					<Var Type="String" Name="ParentAttachEntity"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Type="Bool" Name="ParentAttachUseRotation"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Type="String" Name="ParentAttachBody"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
					<Var Name="ParentAttachLocked" Type="Bool"  DefaultValue="false" 		Description="Will lock the prop to the parent and disable any local movements. Greatly increases precision but doesnt work on dynamic bodies" />
				</Group>
			</Vars>
		</BaseClass>
		
		<Class Name="Trigger"  InheritsFrom="BasicArea">
			<EditorSetupVars>
				<Var Name="Color" Value="1 0 0 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Basic Callbacks">
					<Var Type="Function" Name="PlayerLookAtCallback" ReturnType="void" Params="const tString &amp;in asEntity, int alState" Suffix="_OnPlayerLookAt"		Description="Callback called when player looks at entity syntax: MyFunc(tString &in entity, int alState) state: 1=looking, -1=not looking" />
					<Var Type="Bool" Name="PlayerLookAtCallbackAutoRemove" 	DefaultValue="true" 	Description="if look at callback should be removed when player looks."/>
					<Var Type="Bool" Name="PlayerLookAtCheckCenterOfScreen" DefaultValue="true" 	Description="If the entity counts as looked at only when at the center of the screen."/>
					<Var Type="Bool" Name="PlayerLookAtCheckRayIntersection" 	DefaultValue="true" 	Description="If the entity counts as looked at only if there is a clear line of sight to it. Note that this can return false negatives, especially when not checking center of screen."/>
					<Var Type="Float" Name="PlayerLookAtMaxDistance" DefaultValue="-1" 	Description="How far away the entity can be and still be counted as looked at. If less than 0, the maximum possible value will be used."/>
					<Var Type="Float" Name="PlayerLookAtCallbackDelay" DefaultValue="0" 	Description="How long after looking at or away from the entity the callback should trigger."/>
					<Var Type="Function" Name="PlayerInteractCallback" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteract"		Description="Callback called when player interacts with entity. Syntax: void Func(tString &in entity)" />
					<Var Type="Bool" Name="PlayerInteractCallbackAutoRemove"  DefaultValue="false" 	Description="Should interact callback be removed when entity is interacted with and callback called." />
				</Group>
				<Group Name="Interaction">
					<Var Type="Bool" Name="CanInteractWithoutCallback"  DefaultValue="false" 	Description="Allows interaction with area even if no callback is specified. Used to trigger events." />
					<Var Type="Float" Name="MaxFocusDistance"   DefaultValue="-1" 			Description="The max focus distance. If -1 then default (from game.cfg) is used."/>
					<Var Name="CustomInteractIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="Default" Description="Icon shown when the prop has a interact callback." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="AmbientLight">
			<EditorSetupVars>
				<Var Name="Color" Value="0.65, 0.15, 0.28, 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
					<Var Name="ParentAttachSnap" Type="Bool"  DefaultValue="false" 		Description="If the area should get the same position as the parent." />
					<Var Name="ParentAttachLocked" Type="Bool"  DefaultValue="false" 		Description="Will lock the area to the parent and disable any local movements. Greatly increases precision but doesnt work on dynamic bodies" />
				</Group>
				<Group Name="General">
					<Var Name="Type" Type="Enum"  DefaultValue="Indoors" 		Description="Set the ambient light that is around the player." >
						<EnumValue Name="None" />
						<EnumValue Name="Indoors" />
						<EnumValue Name="Outdoors" />
					</Var>
				</Group>
			</Vars>
		</Class>
		
		<Class Name="CameraAnimation" ShortName="CamAnim">
			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="1 0.5 1 1" />
				<Var Name="DefaultSize" Value="0.25 0.25 0.5" />
				<Var Name="AllowScale" Value="false" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Looking">
					<Var Type="Float" Name="MaxYaw"  DefaultValue="45" 					Description="Maximum yaw offset from center." />
					<Var Type="Float" Name="MaxPitch"  DefaultValue="45" 				Description="Maximum pitch offset from center." />
					<Var Type="Float" Name="LookSpeedMultiplier"  DefaultValue="1" 		Description="Look speed multiplier. 1 = default speed." />
				</Group>
				<Group Name="Movement">
					<Var Type="Float" Name="ForwardTime"  DefaultValue="1" 				Description="Time to move from this node to the next." />
					<Var Type="Float" Name="BackwardTime"  DefaultValue="1" 			Description="Time to move from the next node to this one." />
					<Var Type="Float" Name="AutoMovement"  DefaultValue="0" 			Description="Automatic movement when no input is given. 1 means forward movement at full speed, -0.5 means backwards movement at half speed etc." />
					<Var Type="Float" Name="LookMoveDistance"  DefaultValue="0" 		Description="Distance the player can move by looking towards the next node." />
					<Var Type="Float" Name="LookMoveMaxAngle"  DefaultValue="0" 		Description="If LookMoveDistance > 0, this limits how far away from the next node the player can look and still move forward." />
					<Var Type="Bool" Name="InteractiveMovement"  DefaultValue="true" 	Description="If false, movement input is ignored." />
					<Var Type="Bool" Name="UseSpeedFading"  DefaultValue="true" 		Description="If true, movement speed will interpolate between this one's and the next. Note that this means the forward and back times will not be exact." />
				</Group>
				<Group Name="Misc">
					<Var Type="Bool" Name="CrouchOnExit"  DefaultValue="false" 			Description="If the player should crouch when exiting from this node." />
					<Var Type="Bool" Name="InitToCamera"  DefaultValue="false" 			Description="If true, the node is moved and rotated to match the orientation of the player camera when the animation starts. Useful for the first and final node in an animation." />
					<Var Type="Bool" Name="UsePlayerEyeline" DefaultValue="false"		Description="If the node's Y-pos should be at the player's normal eyeline."/>
				</Group>
				<Group Name="Callbacks">
					<Var Type="Function" Name="CallbackFunc" ReturnType="bool" Params="const tString &amp;in asEntity, int alDirection" Suffix="_CameraNodePassed"	Description="Function called when this node is passed. Syntax is bool FuncName(const tString &in asEntity, int alDirection). If the function returns false, the callback is removed." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="Climb">
			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="1 1 0.2 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Type="Bool" Name="Crouch" DefaultValue="false"  		Description="If the player will be crouching when having climbed up." />
					<Var Type="String" Name="FeetPosition" DefaultValue=""  		Description="Entity where players feet will be after climbing." />
					<Var Type="Bool" Name="CanBeClimbed" DefaultValue="true"  		Description="Whether the ledge can be climbed or not." />
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="ParkourLedge">
			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="0.1 0.65 1 1" />
				<Var Name="DefaultSize" Value="1.1 1.2 0.45" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Parkour">
					<Var Type="String" Name="FeetPosition" DefaultValue="" 		Description="Area where the player's feet will end up after the stock ledge climb." />
					<Var Type="Bool" Name="CrouchOnFinish" DefaultValue="false" 	Description="If the player should be crouching after the climb finishes." />
					<Var Type="Bool" Name="CanGrab" DefaultValue="true" 		Description="Whether this ledge can currently be grabbed." />
					<Var Type="Float" Name="GrabRadius" DefaultValue="1.2" 		Description="Maximum distance from this ledge area center where a falling player can snap to it." />
					<Var Type="Float" Name="RequiredFacingDot" DefaultValue="0.35" Description="How directly the player must face into the ledge. 0 is permissive, 1 is strict." />
					<Var Type="Float" Name="MinFallSpeed" DefaultValue="0.5" 	Description="Minimum downward force velocity required before this ledge can grab the player." />
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="ParkourPoleSwing">
			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="1 0.55 0.1 1" />
				<Var Name="DefaultSize" Value="1.4 1.0 1.4" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Parkour">
					<Var Type="Bool" Name="CanSwing" DefaultValue="true" 		Description="Whether this pole swing can currently be grabbed." />
					<Var Type="String" Name="LaunchTarget" DefaultValue="" 	Description="Optional area used to tune the release direction for reliable gap clearance." />
					<Var Type="Float" Name="PoleLength" DefaultValue="1.8" 	Description="Distance from the pole pivot to the player during the swing." />
					<Var Type="Float" Name="GrabRadius" DefaultValue="1.0" 	Description="Maximum distance from this pole area center where the player can auto-grab." />
					<Var Type="Float" Name="MinApproachSpeed" DefaultValue="1.6" Description="Minimum horizontal speed required to grab this pole." />
					<Var Type="Float" Name="MinVerticalSpeed" DefaultValue="-8.0" Description="Minimum vertical force velocity allowed. Very fast downward falls below this value will not grab." />
					<Var Type="Float" Name="SwingDuration" DefaultValue="1.15" Description="Time in seconds from grab to the end of the scripted swing." />
					<Var Type="Float" Name="PeakStart" DefaultValue="0.62" Description="Normalized time where the strong release window starts." />
					<Var Type="Float" Name="PeakEnd" DefaultValue="0.82" Description="Normalized time where the strong release window ends." />
					<Var Type="Float" Name="LaunchSpeed" DefaultValue="5.2" Description="Horizontal release speed at a good timing." />
					<Var Type="Float" Name="LaunchUpSpeed" DefaultValue="2.6" Description="Vertical release speed at a good timing." />
					<Var Type="Float" Name="FlowLaunchBonus" DefaultValue="0.25" Description="Extra launch multiplier at full parkour flow." />
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="ParkourPoleClimb">
			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="0.25 0.95 0.55 1" />
				<Var Name="DefaultSize" Value="0.9 3.0 0.9" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Parkour">
					<Var Type="Bool" Name="CanClimb" DefaultValue="true" 	Description="Whether this pole climb can currently be grabbed." />
					<Var Type="String" Name="TopExit" DefaultValue="" 	Description="Optional area where the player's feet end up after climbing out at the top." />
					<Var Type="Bool" Name="TopExitCrouch" DefaultValue="false" Description="If the player should crouch after top exit finishes." />
					<Var Type="Float" Name="GrabRadius" DefaultValue="0.9" Description="Maximum horizontal distance from the pole center where the player can auto-grab." />
					<Var Type="Float" Name="MinApproachSpeed" DefaultValue="0.35" Description="Minimum horizontal speed required to grab this pole climb." />
					<Var Type="Float" Name="MinVerticalSpeed" DefaultValue="-9.0" Description="Minimum vertical force velocity allowed. Very fast downward falls below this value will not grab." />
					<Var Type="Float" Name="AttachRadius" DefaultValue="0.42" Description="Distance from the pole center where the player's feet are held while climbing." />
					<Var Type="Float" Name="ClimbSpeed" DefaultValue="0.85" Description="Vertical speed while climbing up." />
					<Var Type="Float" Name="SlideSpeed" DefaultValue="1.85" Description="Vertical speed while sliding down." />
					<Var Type="Float" Name="TopOutTime" DefaultValue="0.58" Description="Time in seconds for the top exit movement." />
					<Var Type="Float" Name="JumpTurnAngle" DefaultValue="130" Description="Maximum yaw angle in degrees used for lean and mouse-directed jump-outs." />
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="ParkourZipline">
			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="0.9 0.95 0.15 1" />
				<Var Name="DefaultSize" Value="1.2 1.2 1.2" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Parkour">
					<Var Type="Bool" Name="CanRide" DefaultValue="true" Description="Whether this zipline can currently be grabbed." />
					<Var Type="String" Name="EndArea" DefaultValue="" Description="Area at the far end of the zipline. Empty defaults to this area name plus _End." />
					<Var Type="Float" Name="GrabRadius" DefaultValue="0.85" Description="Maximum distance from the cable where the player can auto-grab." />
					<Var Type="Float" Name="MinApproachSpeed" DefaultValue="0.65" Description="Minimum horizontal speed required to grab this zipline." />
					<Var Type="Float" Name="MinVerticalSpeed" DefaultValue="-10.0" Description="Minimum vertical force velocity allowed. Very fast downward falls below this value will not grab." />
					<Var Type="Float" Name="HangOffset" DefaultValue="1.15" Description="Vertical distance from the trolley point to the player's feet while riding." />
					<Var Type="Float" Name="StartSpeed" DefaultValue="2.6" Description="Minimum speed when the player first attaches." />
					<Var Type="Float" Name="MinSpeed" DefaultValue="1.8" Description="Lowest allowed ride speed." />
					<Var Type="Float" Name="MaxSpeed" DefaultValue="9.0" Description="Highest allowed ride speed." />
					<Var Type="Float" Name="GravityAccelMul" DefaultValue="1.0" Description="Multiplier for downhill acceleration along the cable." />
					<Var Type="Float" Name="LinearDamping" DefaultValue="0.08" Description="Velocity damping applied while sliding." />
					<Var Type="Float" Name="DetachExitSpeedMul" DefaultValue="1.0" Description="Velocity multiplier when leaving the zipline." />
					<Var Type="Float" Name="EndExitUpSpeed" DefaultValue="0.35" Description="Minimum vertical exit speed when reaching the end." />
					<Var Type="Float" Name="CrouchDropDownSpeed" DefaultValue="-0.25" Description="Maximum vertical speed when crouch-dropping from the zipline." />
					<Var Type="String" Name="RopeMaterial" DefaultValue="entities/arabic_fort/rope/ab_interior_tileable_rope_01.mat" Description="Material used for the generated rope graphics." />
					<Var Type="Float" Name="RopeRadius" DefaultValue="0.05" Description="Rendered rope radius." />
					<Var Type="Float" Name="RopeSegmentLength" DefaultValue="0.5" Description="Physics segment length used when creating the rope." />
					<Var Type="Float" Name="RopeDamping" DefaultValue="0.05" Description="Physics damping used when creating the rope." />
					<Var Type="Float" Name="RopeStrength" DefaultValue="100" Description="Physics strength used when creating the rope." />
					<Var Type="Float" Name="RopeStiffness" DefaultValue="0.1" Description="Physics stiffness used when creating the rope." />
					<Var Type="Bool" Name="RopeCollideWorld" DefaultValue="false" Description="Whether the rope collides with world geometry." />
					<Var Type="Bool" Name="RopeCollideCharacter" DefaultValue="false" Description="Whether the rope collides with character bodies." />
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
			</Vars>
		</Class>

		<Class Name="ParkourBeamWalk">
			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="0.55 0.85 1 1" />
				<Var Name="DefaultSize" Value="0.7 1.0 6.0" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Parkour">
					<Var Type="Bool" Name="CanWalk" DefaultValue="true" Description="Whether this beam walk can currently be entered." />
					<Var Type="Float" Name="WalkSpeed" DefaultValue="1.35" Description="Movement speed while holding forward along the active beam direction." />
					<Var Type="Float" Name="AutoDrift" DefaultValue="0.85" Description="Strength of automatic balance drift." />
					<Var Type="Float" Name="CorrectionStrength" DefaultValue="1.35" Description="Strength of A/D or analog strafe balance correction." />
					<Var Type="Float" Name="BalanceDamping" DefaultValue="1.10" Description="Damping applied to balance velocity." />
					<Var Type="Float" Name="FallGrace" DefaultValue="0.18" Description="Time beyond the balance limit before the player falls." />
					<Var Type="Float" Name="MaxCameraRoll" DefaultValue="16" Description="Maximum camera roll in degrees at the balance limit." />
					<Var Type="Float" Name="FallSideSpeed" DefaultValue="1.8" Description="Sideways velocity applied when balance fails." />
					<Var Type="Float" Name="FallDownSpeed" DefaultValue="-0.75" Description="Downward velocity applied when balance fails." />
					<Var Type="Float" Name="ExitSpeed" DefaultValue="1.25" Description="Forward velocity applied after a clean beam exit." />
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
			</Vars>
		</Class>

		<Class Name="Crawl">
			<EditorSetupVars>
				<Var Name="Color" Value="0.15, 0.95, 0.35, 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="General">
                    <Var Type="Bool" Name="Crouch" DefaultValue="false"     Description="If the player should crouch instead of crawl when inside the area." />
					<Var Type="Bool" Name="AllowJump" DefaultValue="false"     Description="If the player should be allowed to jump when inside the area." />
					<Var Type="Bool" Name="AllowJumpAfterExit" DefaultValue="true"     Description="If the players ability to jump should be restored after leaving this area." />
				</Group>
			</Vars>
		</Class>
	
		<Class Name="Description" ShortName="Desc" InheritsFrom="BasicArea">
			<EditorSetupVars>
				<Var Name="Color" Value="0 1 0 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Description">
					<Var Type="String" Name="TextData" DefaultValue=""  		Description="Category and entry of text shown. sepperate by space and/or comma."/>
					<Var Type="Float" Name="TimeVisibleMul" DefaultValue="1"  		Description="Multiplier for the text length the text is shown. 1 = normal, 2 = double the time and so on"/>
					<Var Type="Int" Name="NumOfSentences" DefaultValue="1"  		Description="The number of Sentences to be shown. If more than 1, each text entry gets 01, 02, etc added at the end."/>
					<Var Type="Function" Name="ShowTextCallback" ReturnType="bool" Params="const tString &amp;in asArea" Suffix="_OnPreShowText" 		Description="Syntax: bool MyFunc(const tString&in asAreaName). Called BEFORE the text is shown, thus no matter if a message is shown or no. Return false to force the message to not display, this makes the area active set to false unless busy type = wait." />
					<Var Type="Bool" Name="OnlyShowOnce" DefaultValue="false"  		Description="If true, the description will only be shown the first time it's triggered." />
					<Var Type="Bool" Name="SkipForLatinCharLang" DefaultValue="false"  		Description="If true, the text will not show up when language is set to one with latin characters. Used for names mostly as those are the same in all translations." />
				</Group>
				<Group Name="Triggering">
					<Var Type="Enum" Name="TriggerType" DefaultValue="0" 				Description="If the description should be shown by collision or looking">
						<EnumValue Name="look" />
						<EnumValue Name="collide" />
					</Var>	
					<Var Type="Float" Name="MaxLookDistance" DefaultValue="2.5"  		Description="The max distance from the area that the description (when in look mode) will be displayed."/>
					<Var Type="Enum" Name="BusyType" DefaultValue="0" Description="What happens if it is triggered and there is already a description displaying">
						<EnumValue Name="wait"/>
						<EnumValue Name="skip"/>
						<EnumValue Name="enqueue"/>
					</Var>
				</Group>
				<Group Name="Appearance">
					<Var Type="Enum" Name="Effect" DefaultValue="0" 				Description="The type of effect on the text">
						<EnumValue Name="none" />
						<EnumValue Name="shake" />
					</Var>
					<Var Type="Float" Name="EffectAmount" DefaultValue="1"  		Description="The strength of the effect. Depends on what the effect is chosen."/>
					<Var Type="Color" Name="Color" DefaultValue="1 1 1 1"  		Description="The color of the effect"/>
					<Var Type="Bool" Name="OffsetVertically" DefaultValue="false"  		Description="Check this to avoid overlap with icons near the center of the screen, specifically for locker item icons."/>
				</Group>
			</Vars>
		</Class>
		
		<Class Name="DoorwayTrigger"  InheritsFrom="BasicArea">
			<EditorSetupVars>
				<Var Name="Color" Value="0.6 0 0.8 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="DoorwayTrigger">
					<Var Type="String" Name="DoorwayEntity"  DefaultValue="" 		Description="The entity that is affected by this door way. Many entities (sepperated by space/comma) or wild cards are supported" />
					<Var Type="String" Name="DoorwayGroup"  DefaultValue="" 		Description="If many doorways share the same group, it will never call an enter/exit calback without having exited first." />
					<Var Type="Function" Name="DoorwayCallback" ReturnType="bool" Params="const tString &amp;in asArea,const tString &amp;in asEntity, int alState" Suffix="_DoorWay"		Description="Callback for when player goes through the area emerge on either side. syntax: MyFunc(tString &in entity, int alState) state: 1=inside (pos Z), -1=outside (neg z)" />
					<Var Type="Bool" Name="DoorwayCheckCenterOnly"  DefaultValue="true" 		Description="If only the center of the entities should be checked for collision with the doorway area." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="Hide">
			<EditorSetupVars>
				<Var Name="Color" Value="0.25, 0.45, 0.75, 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
				<Group Name="General">
					<Var Name="Prio" Type="Int"  DefaultValue="0" 		Description="If player is in more than one area, the one with highest prio will be used." />
					<Var Name="RequiresCrouch" Type="Bool"  DefaultValue="true" 		Description="If the player must be crouching for this area to come into effect" />
					<Var Name="ConnectedProp" Type="String" DefaultValue=""			Description="If the prop specified is deactivated/destroyed, so will this area."/>
					<Var Name="KillAnimDir" Type="Enum" EnumType="Axis3D" DefaultValue="Z"			Description="The direction of the area that the stalker can reach and kill the player from. Uses both the positive and negative direction."/>
				</Group>
			</Vars>
		</Class>
		
		<Class Name="InteractAux" ShortName="InterAux">
			<EditorSetupVars>
				<Var Name="Color" Value="0.15, 0.95, 0.65, 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="General">
					<Var Name="InteractParent" Type="String"  DefaultValue="" 					Description="The entity that this is connected to and will act as an auxillary for." />
					<Var Name="UseParentMainBody" Type="Bool"  DefaultValue="true" 				Description="Pass the parent's main body instead of the area's to the interact methods." />
					<Var Name="OverrideParentMainBody" Type="Bool"  DefaultValue="false" 		Description="Allows to use this area even if the interaction on the parent body is disabled." />
					<Var Name="MaxFocusDistance" Type="Float"  DefaultValue="-1" 				Description="Custom distance from the area where it can be interacted with. -1 uses the default value." />
					<Var Name="UseCustomInteractIcon" Type="Bool" DefaultValue="False" 			Description="If the selected CustomInteractIcon should be used or not. Will otherwise use the icon of the InteractParent." />
					<Var Name="CustomInteractIcon" Type="Enum" EnumType="CustomInteractIcon" DefaultValue="Default" Description="Icon shown when the prop has a interact callback." />
					<Var Name="DeactivateOnInteract" Type="Bool"  DefaultValue="false" 			Description="If the Aux area should be deactivated after interaction." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="Ladder">
			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="0.5 1 0 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Type="Enum" Name="Material" DefaultValue="metal" Description="The type of sounds the player will make climbing the lader">
						<EnumValue Name="stone" />
						<EnumValue Name="wood" />
						<EnumValue Name="rope" />
					</Var>
					<Var Name="Exit_Top" Type="String" DefaultValue="" Description="The area where the players feet will end up when exiting from the top. (if blank, he will just drop down)"/>
					<Var Name="Exit_TopCrouching" Type="Bool" DefaultValue="False" Description="If the player should crouch at when at the top exit area."/>
					<Var Name="Exit_TopPlayDetachAnim" Type="Bool" DefaultValue="True" Description="If the detach top animation should play or not."/>
					<Var Name="Exit_Bottom" Type="String" DefaultValue="" Description="The area where the players feet will end up when exiting at the bottom. (if blank, he will just drop down)"/>
					<Var Name="Exit_BottomCrouching" Type="Bool" DefaultValue="False" Description="If the player should crouch at when at the bottom exit area."/>
					<Var Name="Exit_Middle" Type="String" DefaultValue="" Description="The area where the players feet will end up when exiting in the middle. (if blank, can't exit at middle)"/>
					<Var Name="Exit_MiddleCrouching" Type="Bool" DefaultValue="False" Description="If the player should crouch at when at the middle exit area."/>
					<Var Name="CanExitByJumping" Type="Bool" DefaultValue="True" Description="If the player can stop climbing by jumping."/>
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
				<Group Name="Basic Callbacks">
					<Var Type="Function" Name="PlayerInteractCallback" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteract"		Description="Callback called when player interacts with the ladder. Syntax: void Func(tString &in entity)" />
					<Var Type="Function" Name="ExitCallback" ReturnType="void" Params="int alState" Suffix="_OnExit"		Description="Callback called when player exits the ladder. Syntax: void Func(tString &in entity)" />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="Liquid" InheritsFrom="BasicArea">
			<EditorSetupVars>
				<Var Name="Color" Value="0 0 1 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Physics">
					<Var Type="Float" Name="Density"  DefaultValue="100" 				Description="Density of the water. The higher the heavier things float." />
					<Var Type="Float" Name="LinearViscosity"   DefaultValue="1" 			Description="The higher, the more slowed down things will be in linear transformations (changing position)" />
					<Var Type="Float" Name="AngularViscosity"   DefaultValue="1" 			Description="The higher, the more slowed down things will be in angular transformations (changing rotation)"/>
					<Var Type="Enum" Name="PhysicsMaterial"   DefaultValue="0" 			Description="Material of water." >
						<EnumValue Name="water" />
						<EnumValue Name="oil" />
					</Var>	
					<Var Type="Float" Name="PlayerSpeedMul"  DefaultValue="0.8" 			Description="Player speed is multiplied by this when in water." />
					<Var Type="Bool" Name="BuoyancyOnPlayerOnly"   DefaultValue="false" 				Description="If all objects should be able to float on water or just the player."/>
				</Group>
				<Group Name="Waves">
					<Var Type="Bool" Name="HasWaves"   DefaultValue="true" 				Description="If object will go up and down in a wavelike manner."/>
					<Var Type="Float" Name="WaveAmp"   DefaultValue="0.04" 				Description="Height of waves." />
					<Var Type="Float" Name="WaveFreq"   DefaultValue="3" 				Description="How fast the waves will go up and down." />
					<Var Type="Float" Name="MaxWaveDistance"   DefaultValue="25" 			Description="Max distance from player that objects get waves. This is an optimization thingie." />
				</Group>
				<Group Name="Appearance">				
					<Var Type="File"  ResType="Material" Name="UpperMaterial"  DefaultValue="" 			Description="The material of upper water surface." />
					<Var Type="File"  ResType="Material" Name="LowerMaterial"  DefaultValue="" 			Description="The material of lower water surface." />
					<Var Type="Float" Name="GridSize"  DefaultValue="0" 			Description="Size of the grid tiles. 0 = no grid" />
					<Var Type="Float" Name="TextureTileSize"  DefaultValue="1" 			Description="Size that a full texture takes up." />
					<Var Type="Bool" Name="StaticMesh"  DefaultValue="true" 			Description="If the area is never to move, it is best to have it as static! (renders faster)" />
					<Var Type="String" Name="EnvParticlesToClip" DefaultValue="" Description="Name of the environment particle layers that should be constrained to this area. Wildcard accepted, use space to seperate multiple" />
					<Var Name="ReflectionColor" Type="Color" DefaultValue="1 1 1 1" 		Description="Color mul for the reflection" />
					<Var Name="ReflectionBrightness" Type="Float" DefaultValue="1" Min="0" Max="20" Slider="true" UseLogScale="true"	Description="Brightness of the reflection" />
				</Group>
				<Group Name="Fog">
					<Var Type="Bool" Name="UseFog"  DefaultValue="true" 			Description="If there should be fog under the water." />
					<Var Type="Color" Name="FogColor"  DefaultValue="1 1 1 1" 			Description="Color of the fog" />
					<Var Type="Float" Name="FogStart"  DefaultValue="0" 			Description="Start of fog" />
					<Var Type="Float" Name="FogEnd"  DefaultValue="2" 			Description="End of fog." />
					<Var Type="Float" Name="FogFalloffExp"  DefaultValue="2" 			Description="The fall off of the fog." />
					<Var Type="Float" Name="FogBrightness"  DefaultValue="1" 			Description="The HDR brightness" />
					<Var Type="Bool" Name="FogExponential"  DefaultValue="false" 			Description="If the fog should be physically based" />
					<Var Type="Float" Name="FogDensity"  DefaultValue="0.25" 			Description="Thickness of the fog" />
					<Var Type="Bool" Name="FogHeightBased"  DefaultValue="false" 			Description="If the fog should use height based fog" />
					<Var Type="Float" Name="FogHeightDensity"  DefaultValue="0.25" 			Description="Thickness based on height" />
					<Var Type="Float" Name="FogHeightHorizon"  DefaultValue="1" 			Description="Y value where the height fog should start to fade out" />
					<Var Type="Bool" Name="FogUnderwater" DefaultValue="false" Description="If the fog color should be multipled in adition to be alpha blended with geometry" />
					<Var Type="Bool" Name="FogSkybox" DefaultValue="false" Description="Should the fog color come from the skybox" />
				</Group>
				<Group Name="Camera Interactions">
					<Var Type="Bool" Name="EffectOnExit" 	DefaultValue="true"	Description="If effects should be used as the camera breaches the surface of the water." />
					<Var Type="Function" Name="CameraCollideCallback" ReturnType="void" Params="int alState" Suffix="_OnCameraCollide"		Description="Callback for when the camera enters the liquid area. Syntax: void Func(int alState). alState: -1=camera left, 1=camera entered" />
					<Var Type="String" Name="CameraEnterEffectPreset" DefaultValue="" Description="MapEffectsHandler preset to use when the camera is inside the area" />
					<Var Type="String" Name="CameraExitEffectPreset" DefaultValue="" Description="MapEffectsHandler preset to use when the camera leaves the area" />
					<Var Type="Color" Name="UnderwaterLightColor" DefaultValue="0.181 0.224 0.264 1" Description="Color of the light attached to the camera while underwater." />
				</Group>
			</Vars>
		</Class>

