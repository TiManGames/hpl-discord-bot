			<EditorSetupVars>
				<Var Name="ShowOrientation" Value="true" />
				<Var Name="Color" Value="1, 0.4, 0.01, 1" />
				<Var Name="AllowScale" Value="false" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Type="Float" Name="MaxYaw"  DefaultValue="80" 					Description="Maximum yaw offset from center." />
					<Var Type="Float" Name="MaxPitch"  DefaultValue="50" 				Description="Maximum pitch offset from center." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="Soundscape">
			<EditorSetupVars>
				<Var Name="Color" Value="0.5 0.7 0.2 1" />
				<Var Name="Icon" Value="AreaSoundscape" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Reverb">
					<Var Name="UseReverb" Type="Bool"  DefaultValue="true" 		Description="If reverb should changed when entering this area." />
					<Var Name="ReverbType" Type="Enum" DefaultValue="Off" Description="The type of reverb to be used in this area">
						<EnumValue Name="Off" />
						<EnumValue Name="Generic" />
						<EnumValue Name="PaddedCell" />
						<EnumValue Name="Room" />
						<EnumValue Name="BathRoom" />
						<EnumValue Name="LivingRoom" />
						<EnumValue Name="StoneRoom" />
						<EnumValue Name="Auditorium" />
						<EnumValue Name="ConcertHall" />
						<EnumValue Name="Cave" />
						<EnumValue Name="Arena" />
						<EnumValue Name="Hangar" />
						<EnumValue Name="CarpettedHallway" />
						<EnumValue Name="Hallway" />
						<EnumValue Name="StoneCorridor" />
						<EnumValue Name="Alley" />
						<EnumValue Name="Forest" />
						<EnumValue Name="City" />
						<EnumValue Name="Mountains" />
						<EnumValue Name="Quarry" />
						<EnumValue Name="Plain" />
						<EnumValue Name="ParkingLot" />
						<EnumValue Name="SewerPipe" />
						<EnumValue Name="Underwater" />
						<EnumValue Name="Warehouse" />
						<EnumValue Name="ExtraRoomSmall" />
						<EnumValue Name="ExtraRoomMedium" />
						<EnumValue Name="ExtraRoomLarge" />
						<EnumValue Name="ExtraMarbleLarge" />
						<EnumValue Name="ExtraOpenAreas" />
						<EnumValue Name="ExtraSewersBunkers" />
						<EnumValue Name="ExtraDeath" />
						<EnumValue Name="ExtraBridge" />
						<EnumValue Name="ExtraTunnelLarge" />
						<EnumValue Name="ExtraTunnelMedium" />
						<EnumValue Name="ExtraTunnelSmall" />
						<EnumValue Name="ExtraAlley" />
						<EnumValue Name="ExtraCarparks" />
						<EnumValue Name="ExtraReflectiveInt" />
						<EnumValue Name="ExtraWarehouse" />
						<EnumValue Name="ExtraWarehouseMassive" />
						<EnumValue Name="ExtraCarpark" />
					</Var>
					<Var Name="ReverbPrio" Type="Int" DefaultValue="0" Description="If two areas overlap the one with the highest prio will be used."/>
					<Var Name="ReverbAmount" Type="Float" DefaultValue="1" Description="The amount of the reverb used. Values over 1 are OK."/>
					<Var Name="ReverbFadeTime" Type="Float" DefaultValue="1" Description="The amount of time this reverb effect takes to fade in."/>
				</Group>
				<Group Name="General Sound">
					<Var Name="Prio" Type="Int" DefaultValue="0" Description="If player is in many areas of same level, prio determine which will be used."/>
					<Var Name="Level" Type="Enum" DefaultValue="2: Room" Description="The level of this sound. Only ONE sound per level is ever played.">
						<EnumValue Name="0: Global" />
						<EnumValue Name="1: Area" />
						<EnumValue Name="2: Room" />
						<EnumValue Name="3: SubRoom" />
					</Var>
				</Group>
				<Group Name="BackgroundSound">
					<Var Name="BG_Sound" Type="File"  ResType="Sound" DefaultValue="" Description="The sound to be played as background when inside the area."/>
					<Var Name="BG_Volume" Type="Float" DefaultValue="1" Description="The volume of the background sound"/>
					<Var Name="BG_FadeInTime" Type="Float" DefaultValue="1" Description="Time it takes to fade in the sound."/>
					<Var Name="BG_FadeOutTime" Type="Float" DefaultValue="1" Description="Time it takes to fade out the sound"/>
					<Var Name="BG_FadeTransitionSpeed" Type="Float" DefaultValue="1" Description="Speed (not time!) that sound fades because of change in combined parent vol mul."/>
					<Var Name="BG_ParentVolMul" Type="Float" DefaultValue="1" Description="The multiplier for any parent background sounds that are currently active. This is recurisve, so for lower levels several multipliers are applied"/>
				</Group>
				<Group Name="Connected Sound Entities">
					<Var Name="SoundEnt_InNames" Type="String" DefaultValue="" Description="Name of the sound entities that will play when INSIDE the area. Separate names by space or comma, wild cards allowed."/>
					<Var Name="SoundEnt_OutNames" Type="String" DefaultValue="" Description="Name of the sound entities that will playe when OUTSIDE the area. Separate names by space or comma, wild cards allowed."/>
					<Var Name="SoundEnt_FadeInTime" Type="Float" DefaultValue="1" Description="Time it takes for the connected ound entities to fade in."/>
					<Var Name="SoundEnt_FadeOutTime" Type="Float" DefaultValue="1" Description="Time it takes for the connected sound entities to fade out."/>
				</Group>
				<Group Name="SoundPrefix">
					<Var Name="SoundPrefixPrio" Type="Int" DefaultValue="0" Description="If several areas overlap, the prefix with largest prio will be used."/>
					<Var Name="SoundPrefix" Type="Enum" DefaultValue="[None]" Description="This is a prefix that will be added to some sound file/event names, for instance foot steps. [None] means that no suffix is added.">
						<EnumValue Name="[None]" />
						<EnumValue Name="wardrobe" />
						<EnumValue Name="small_room" />
						<EnumValue Name="medium_room" />
						<EnumValue Name="large_room" />
						<EnumValue Name="exterior" />
						<EnumValue Name="underwater" />
					</Var>
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>	
			</Vars>
		</Class>
		
		<Class Name="Sticky">
			<EditorSetupVars>
				<Var Name="Color" Value="0 1 1 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="Base">
					<Var Name="MoveBody" Type="Bool"  DefaultValue="true" 			Description="If body is moved into postion when placed" />
					<Var Name="RotateBody" Type="Bool"  DefaultValue="true" 		Description="If body is rotated according to area." />
					<Var Name="AttachableBodyName" Type="String"  DefaultValue="" 		Description="If not empty then this determines if a body can be attached or not. If the string exsits in a body name then it is attached. " />
					<Var Name="PoseTime" Type="Float"  DefaultValue="1" 			Description="The time it takes to get moved and rotated into postion." />
					<Var Name="CheckCenterInArea" Type="Bool"  DefaultValue="true" 		Description="If body center must be in area for it to be attached." />
					<Var Name="CanDetach" Type="Bool"  DefaultValue="true"			Description="If the body can be detached." />
					<Var Name="RequiresInteraction" Type="Bool"  DefaultValue="true" Description="If the entity needs to be interacted with to attach." />
					<Var Name="UseEntityOrigin" Type="Bool"  DefaultValue="false"			Description="If the entity's origin should be used to position the body" />
					<Var Name="UseCustomRotation" Type="Bool"  DefaultValue="false"			Description="If body should be rotated to the CustomRotation instead of matching the area's rotation." />
					<Var Name="CustomRotation" Type="Vector3" DefaultValue="0 0 0" 			Description="Custom world rotation of the body" />
				</Group>
				<Group Name="Callbacks">
					<Var Name="AttachFunction" Type="Function" ReturnType="bool" Params="const tString &amp;in asStickyArea, const tString &amp;in asBodyName" Suffix="_Attach"  		Description="Called at attach. Return true with if attachment should work (if AttachableBodyName succeeded then no need to call) ! Syntax: bool Func(const tString &amp;in asStickyArea, const tString &in asBodyName)" />
					<Var Name="DetachFunction" Type="Function" ReturnType="void" Params="const tString &amp;in asStickyArea, const tString &amp;in asBodyName" Suffix="_Detach"  		Description="Called at detach Syntax: void Func(const tString &amp;in asStickyArea, const tString &amp;&in asBodyName)"/>
				</Group>
				<Group Name="Effects">
					<Var Name="AttachSound" Type="File"  ResType="Sound"  DefaultValue="" 			Description="Sound played when attaching body." />
					<Var Name="DetachSound" Type="File"  ResType="Sound"  DefaultValue="" 			Description="Sound played when detaching body." />
					<Var Name="AttachPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 			Description="Particles created when attaching body." />
					<Var Name="DetachPS" Type="File"  ResType="ParticleSystem"  DefaultValue="" 			Description="Particles created when detaching body." />
				</Group>
				<Group Name="Attachment">
					<Var Name="ParentAttachEntity" Type="String"  DefaultValue="" 		Description="Name of an entity that this area is attached to." />
					<Var Name="ParentAttachUseRotation" Type="Bool"  DefaultValue="true" 		Description="If rotation should be used with attached parent." />
					<Var Name="ParentAttachBody" Type="String"  DefaultValue="" 		Description="Name of body in entity that it should be attached to. '' means main body is used." />
				</Group>
				<Group Name="Springy">
					<Var Name="Springy_Active" Type="Bool"  DefaultValue="false" 		Description="If spriny behavior is active." />
					<Var Name="Springy_DetachDistanceMul" Type="Float"  DefaultValue="1" 		Description="Multiplier for the amount it must be from the area center before it detaches." />
					<Var Name="Springy_ForceMul" Type="Float"  DefaultValue="1" 		Description="Multiplier for amount of force added (which depends on distance)." />
					<Var Name="Springy_ReleaseTime" Type="Float"  DefaultValue="0.5" 		Description="Time it will take, given it is at DetachDistance, to detach the object." />
					<Var Name="Springy_DetachLoopSound" Type="String"  DefaultValue="" 		Description="Looping sound played when detaching." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="AgentRepel">
			<EditorSetupVars>
				<Var Name="Color" Value="0, 0.5, 0.4, 1" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Group Name="AgentRepel">
					<Var Name="ExitArea" Type="String"  DefaultValue="" 		Description="Name of an area that the agent will try to go to when they enter this area." />
				</Group>
			</Vars>
		</Class>
    
		<Class Name="VisibilityArea" ShortName="VisArea">
		  <EditorSetupVars>
			<Var Name="Color" Value="0.25 0.25 0.5 1" />
			<Var Name="Icon" Value="AreaVisibility" />
		  </EditorSetupVars>
		  <Vars>
			<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
			<Group Name="Settings">
			  <Var Type="Bool" Name="AddPartialIntersectingObjects" DefaultValue="false"  		Description="Add objects that are not fully inside the area. Caution: This can lead to false positivies and occlude the visible objects"/>
			  <Var Type="Int" Name="MinObjectsPerNode" DefaultValue="-1"  		Description="Nodes will merge if the number of objects per node is less. This is based on the average and not enforced per node"/>
			  <Var Type="Int" Name="MaxObjectsPerNode" DefaultValue="-1"  		Description="Nodes will be split if the number or objects per node is greater. This is based on the average and not enforced per node"/>
			</Group>
		  </Vars>
		</Class>
		
		<Class Name="VisibilityPortal" ShortName="VisPortal">
		  <EditorSetupVars>
			<Var Name="Color" Value="0.0 0.0 0.5 1" />
			<Var Name="Icon" Value="AreaPortal" />
		  </EditorSetupVars>
		  <Vars>
			<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
			<Group Name="Settings">
			  <Var Type="String" Name="ConnectedAreas1" DefaultValue="" Description="Visiblity areas that are connected to this portal. Seperate multiple areas with ';, '"/>
			  <Var Type="String" Name="ConnectedAreas2" DefaultValue="" Description="Visiblity areas that are connected to this portal. Seperate multiple areas with ';, '"/>
			  <Var Type="String" Name="ConnectedAreas3" DefaultValue="" Description="Visiblity areas that are connected to this portal. Seperate multiple areas with ';, '"/>
			</Group>
		  </Vars>
		</Class>
		
		<Class Name="Zoom"  InheritsFrom="BasicArea">
			<EditorSetupVars>
				<Var Name="Color" Value="0.5 0.7 1 1" />
				<Var Name="ShowOrientation" Value="true" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Basic Callbacks">
					<Var Type="Function" Name="PlayerLookAtCallback" ReturnType="void" Params="const tString &amp;in asEntity, int alState" Suffix="_OnPlayerLookAt"		Description="Callback called when player looks at entity syntax: MyFunc(tString &in entity, int alState) state: 1=looking, -1=not looking" />
					<Var Type="Bool" Name="PlayerLookAtCallbackAutoRemove" 	DefaultValue="true" 	Description="if look at callback should be removed when player looks."/>
					<Var Type="Bool" Name="PlayerLookAtCheckCenterOfScreen" DefaultValue="true" 	Description="If the entity counts as looked at only when at the center of the screen."/>
					<Var Type="Bool" Name="PlayerLookAtCheckRayIntersection" 	DefaultValue="true" 	Description="If the entity counts as looked at only if there is a clear line of sight to it. Note that this can return false negatives, especially when not checking center of screen."/>
					<Var Type="Float" Name="PlayerLookAtMaxDistance" DefaultValue="-1" 	Description="How far away the entity can be and still be counted as looked at. If less than 0, the maximum possible value will be used."/>
					<Var Type="Float" Name="PlayerLookAtCallbackDelay" DefaultValue="0" 	Description="How long after looking at or away from the entity the callback should trigger."/>
					<Var Type="Function" Name="PlayerInteractCallback" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteract"		Description="Callback called when player interacts with entity. Syntax: void Func(tString &in entity)" />
					<Var Type="Bool" Name="PlayerInteractCallbackAutoRemove"  DefaultValue="false" 	Description="Should interact callback be removed when entity is interacted with and callback called." />
				</Group>
				<Group Name="ZoomText">
					<Var Name="TextCategory" Type="String" DefaultValue="" 			Description="Category for text contents." />
					<Var Name="TextEntry" Type="String" DefaultValue="" 			Description="Entry for the text displayed when interacting with the area." />
					<Var Name="ZoomDistance" Type="float" DefaultValue="0"		Description="Distance from the centre point of the readable." />
					<Var Name="OnGuiFunction" Type="Function" DefaultValue="" ReturnType="void" Params="float afTimeStep, float afAlpha" Suffix="_OnGui" Description="Callback function where all the drawing of the gui will take place. This replaces the default TextCategory/Entry implementation. Syntax. void Func(const tString&amp;in asEntityName, float afTimeStep)" />
					<Var Type="Function" Name="ZoomedInCallback" ReturnType="void" Params="int alState" Suffix="_OnAreaZoomedIn" Description="Called when an area is zoomed in. Syntax: void MyFunc(int alState) state: 1=zoomed in, -1=zoomed out" />
					<Var Type="Bool" Name="AllowExtraZoom" 	DefaultValue="false" 	Description="If the player should be able to zoom in an additional step and move the camera around."/>
				</Group>
				<Group Name="Appearance">
					<Var Name="VerticalFOV" Type="Float" DefaultValue="70"  Description="Vertical Field of View to use when interacting with the area. In degrees" />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="GhoulHole">
			<EditorSetupVars>
				<Var Name="Color" Value="1.0, 1.0, 0.0, 1" />
				<Var Name="DefaultSize" Value="1 2 1" />
				<Var Name="ShowOrientation" Value="true" />
			</EditorSetupVars>
			<Vars>
			</Vars>
		</Class>
		
		<Class Name="RatFeed" UsesComponents="RatFood">
			<EditorSetupVars>
				<Var Name="Color" Value="1.0, 1.0, 1.0, 1" />
				<Var Name="DefaultSize" Value="1 1 1" />
				<Var Name="ShowOrientation" Value="false" />
			</EditorSetupVars>
			<Vars>
				<Group Name="RatFood">
					<Var Name="AttractEnabled" Type="Bool" DefaultValue="true" Description="Checking this will make the rats attracted to this entity." />
					<Var Name="AttractDistance" Type="Float" DefaultValue="5" Description="The maximum distance a rat can smell this entity." />
					<Var Name="LifeTime" Type="Float" DefaultValue="-1" Description="The amount of time in seconds that a single rat needs to eat this food entity before it dissapears. -1 = takes forever. 0 = already eaten. " />
					<Var Name="FeedingSlotsCount" Type="Int" DefaultValue="2" Description="The max number of rats that can gather around this food." />
					<Var Name="Priority" Type="Int" DefaultValue="0" Description="The higher the priority the more likely is that rats will be ettracted to this food entity." />
					<Var Name="FoodEntity" Type="String" DefaultValue="" Description="Assign an entity other than this, as the entity of attraction." />
					<Var Name="BurnableEntity" Type="String" DefaultValue="" Description="Entity that will be replaced by a burnt entity after the food area is burnt. Wildcards are supported." />
					<Var Name="BurntEntity" Type="String" DefaultValue="" Description="Entity that will replace the burnable entity after the food area is burnt. Wildcards are supported." />
				</Group>
			</Vars>
		</Class>
		
		<Class Name="SoundOcclusion" ShortName="OccArea">
			<EditorSetupVars>
				<Var Name="Color" Value="1 0.5 0.25 1" />
				<Var Name="DefaultSize" Value="1 1 0.5" />
				<Var Name="ShowOrientation" Value="false" />
				<Var Name="Icon" Value="AreaSoundOcclusion" />
			</EditorSetupVars>
			<Vars>
				<Group Name="SoundOcclusion">
					<Var Name="Prio" Type="Int" DefaultValue="0" Description="If many areas are overlapping, prio determines which will be used."/>
				</Group>
			</Vars>
		</Class>

		<Class Name="SoundOcclusionConnection" ShortName="OccCon">
		  <EditorSetupVars>
			<Var Name="Color" Value="1 0.5 0.25 1" />
			<Var Name="DefaultSize" Value="1 1 0.5" />
			<Var Name="ShowOrientation" Value="false" />
			<Var Name="Icon" Value="AreaSoundOcclusion" />
		  </EditorSetupVars>
		  <Vars>
			<Group Name="SoundOcclusion">
				<Var Name="ConnectedAreas_1" Type="String" DefaultValue="" Description="Sound occlusion areas connected by this area. Seperate multiple areas with ',' ';' or ' '" />
				<Var Name="ConnectedAreas_2" Type="String" DefaultValue="" Description="Sound occlusion areas connected by this area. Seperate multiple areas with ',' ';' or ' '" />
				<Var Name="ConnectedAreas_3" Type="String" DefaultValue="" Description="Sound occlusion areas connected by this area. Seperate multiple areas with ',' ';' or ' '" />
				<Var Name="ConnectionDoor" Type="String" DefaultValue="" Description="The door entity that will control if the connection is open or not (connection is always open if none specified)." />
			</Group>
		  </Vars>
		</Class>

		<Class Name="FuelHatch">
			<EditorSetupVars>
				<Var Name="Color" Value="1 0.5 0.25 1" />
				<Var Name="DefaultSize" Value="1 1 1" />
				<Var Name="ShowOrientation" Value="false" />
		  	</EditorSetupVars>
			<Vars>
				<Group Name="Basic Callbacks">
					<Var Type="Function" Name="PlayerLookAtCallback" ReturnType="void" Params="const tString &amp;in asEntity, int alState" Suffix="_OnPlayerLookAt"		Description="Callback called when player looks at entity syntax: MyFunc(tString &in entity, int alState) state: 1=looking, -1=not looking" />
					<Var Type="Bool" Name="PlayerLookAtCallbackAutoRemove" 	DefaultValue="true" 	Description="if look at callback should be removed when player looks."/>
					<Var Type="Bool" Name="PlayerLookAtCheckCenterOfScreen" DefaultValue="true" 	Description="If the entity counts as looked at only when at the center of the screen."/>
					<Var Type="Bool" Name="PlayerLookAtCheckRayIntersection" 	DefaultValue="true" 	Description="If the entity counts as looked at only if there is a clear line of sight to it. Note that this can return false negatives, especially when not checking center of screen."/>
					<Var Type="Float" Name="PlayerLookAtMaxDistance" DefaultValue="-1" 	Description="How far away the entity can be and still be counted as looked at. If less than 0, the maximum possible value will be used."/>
					<Var Type="Float" Name="PlayerLookAtCallbackDelay" DefaultValue="0" 	Description="How long after looking at or away from the entity the callback should trigger."/>
					<Var Type="Function" Name="PlayerInteractCallback" ReturnType="void" Params="const tString &amp;in asEntity" Suffix="_OnPlayerInteract"		Description="Callback called when player interacts with entity. Syntax: void Func(tString &in entity)" />
					<Var Type="Bool" Name="PlayerInteractCallbackAutoRemove"  DefaultValue="false" 	Description="Should interact callback be removed when entity is interacted with and callback called." />
					<Var Type="Float" Name="MaxFocusDistance"   DefaultValue="-1" 			Description="The max focus distance. If -1 then default (from game.cfg) is used."/>
				</Group>
			</Vars>
		</Class>

		<Class Name="EnvironmentParticleClip">
			<EditorSetupVars>
				<Var Name="Color" Value="1 0.75 0.75 1" />
				<Var Name="DefaultSize" Value="1 1 1" />
				<Var Name="ShowOrientation" Value="false" />
			</EditorSetupVars>
			<Vars>
				<Group Name="EnvironmentParticleClip">
					<Var Name="Addative" Type="Bool" DefaultValue="false" Description="If this subtracts or add to the particle emitter."/>
					<Var Name="Target" Type="String" DefaultValue="" Description="The environment particle system that this targets, empty means all systems."/>
				</Group>
			</Vars>
		</Class>
		
  </Classes>
</UserClassDefinition>
