		<Class Name="Rope">
			<EditorSetupVars>
				<Var Name="Color" Value="1 1 0 1" />
				<Var Name="Sphere" Value="true" />
				<Var Name="DefaultSize" Value="0.5 0.5 0.5" />
				<Var Name="AllowRotate" Value="false" />
				<Var Name="AllowScale" Value="false" />
			</EditorSetupVars>
			<Vars>
				<Group Name="Notes">
					<Var Name="Note" Type="String" DefaultValue="" 		Description="A note that will show up when debugging" />
				</Group>
				<Var Type="String" Name="EndPosNode"   DefaultValue="" 	Description="A PosNode area that sets the end of the rope" />
				<Var Type="String" Name="StartBody"   DefaultValue="" 	Description="The body at the start of the rope. Game first looks for Body with name, and then for entity. Can be empty" />
				<Var Type="String" Name="EndBody"   DefaultValue="" 	Description="The body at the end of the rope. Game first looks for Body with name, and then for entity." />
			
				<Var Type="Float" Name="MinTotalLength"   DefaultValue="0.5" 	Description="The minimum length of the rope." />
				<Var Type="Float" Name="MaxTotalLength"   DefaultValue="10" 	Description="The maximum length for the rope" />
				
				<Var Type="Bool" Name="AutoMove"   DefaultValue="false" 		Description="If the rope automoves." />
				<Var Type="Float" Name="AutoMoveAcc"   DefaultValue="5" 		Description="Acceleration of automovement." />
				<Var Type="Float" Name="AutoMoveMaxSpeed"   DefaultValue="3" 	Description="The maximum speed for automovement." />
				
				<Var Type="File" Name="RopeFile"   Extensions="rope" DefaultValue=""	Description="If set, it overrides all of the settings below."/>
				
				<Var Type="Float" Name="SegmentLength" 	  DefaultValue="0.3" 	Description="Length of each segment." />
				<Var Type="Float" Name="Damping" 			  DefaultValue="0.1" 		Description="The amount of air resitance. The higher the faster it slows down" />
				<Var Type="Float" Name="Strength" 			  DefaultValue="200" 		Description="How much the rope pulls on the connected bodies" />
				<Var Type="Float" Name="Stiffness" 		  DefaultValue="3" 		Description="How much slacking is allowed in the rope. The higher the less slacking." />
				<Var Type="File" Name="Material" 			 ResType="Material" DefaultValue="textures/ropes/default.mat"	Description="The material used" />
				<Var Type="Float" Name="Radius" 			  DefaultValue="0.025" 		Description="Radius of each segment" />
				<Var Type="Float" Name="LengthTileAmount" 	  DefaultValue="1" 	Description="How many times each material is tiled in a segment" />
				<Var Type="Float" Name="LengthTileSize" 	  DefaultValue="0.5" 	Description="Only used is SegmentLength=0. The length (in m) where material repeats." />
				<Var Type="File" Name="Sound" 				 ResType="Sound" DefaultValue="" 	Description="Sound played when moving" />
				<Var Type="Float" Name="SoundStartSpeed" 	  DefaultValue="0.49" 	Description="Speed when sound starts playing." />
				<Var Type="Float" Name="SoundStopSpeed" 	  DefaultValue="0.45" 	Description="Speed when sound stops playing." />
			</Vars>
		</Class>
		
