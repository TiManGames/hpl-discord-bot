# Required — SAP AI Core credentials.
# MUST be a SINGLE-LINE JSON blob. The @sap-ai-sdk reads ONLY this variable —
# the individual AICORE_CLIENT_ID / _SECRET / _AUTH_URL / _BASE_URL vars are NOT read.
# Keep it on one line: dotenv only reads the first line of a value.
AICORE_SERVICE_KEY={"clientid":"your-client-id","clientsecret":"your-client-secret","url":"https://your-subdomain.authentication.eu10.hana.ondemand.com","serviceurls":{"AI_API_URL":"https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com/v2"}}

# Required — Discord bot token
DISCORD_TOKEN=your_discord_bot_token_here

# Required — SAP AI Core resource group. Use your OWN provisioned group (the one
# your Cline uses), NOT "default" — the default group is a shared, heavily
# rate-limited bucket. Sent as the AI-Resource-Group header.
AICORE_RESOURCE_GROUP=your_resource_group_here

# Required — deployment id of the anthropic--claude-4.5-haiku foundation-models
# deployment. Pins model resolution (resource-group-only resolution fails for
# Claude). Run `npm run list-deployments` to find it.
AICORE_DEPLOYMENT_ID=your_deployment_id_here

# Optional — JSON object mapping channel names (or IDs) to game identifiers.
# Supported game identifiers: hpl2, hpl3-soma, hpl3-rebirth, hpl3-bunker
CHANNEL_MAP={"hpl2":"hpl2","hpl3-soma":"hpl3-soma","hpl3-rebirth":"hpl3-rebirth","hpl3-bunker":"hpl3-bunker"}

# Optional — rate-limit window in minutes once a user hits the penalty limit (5).
# Measured from the moment they reach the limit; count resets to 0 when it expires.
RATE_LIMIT_MINUTES=1

# Optional — path to the NeDB penalty datastore file (default data/penalties.db).
PENALTY_DB_PATH=data/penalties.db

# Optional — model id for the moderation classifier. Falls back to AICORE_MODEL.
MODERATION_MODEL=anthropic--claude-4.6-sonnet
